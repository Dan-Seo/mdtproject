{
  "description": "Kijun 프로젝트 훅 — TDD 가드, 위험 명령 차단, 턴 종료 검증.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/tdd-guard.sh\"",
            "commandWindows": "bash -c \"bash \\\"$(git rev-parse --show-toplevel)/scripts/hooks/tdd-guard.sh\\\"\"",
            "statusMessage": "TDD 가드 확인 중"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/dangerous-command-guard.sh\"",
            "commandWindows": "bash -c \"bash \\\"$(git rev-parse --show-toplevel)/scripts/hooks/dangerous-command-guard.sh\\\"\"",
            "statusMessage": "위험 명령 확인 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/stop-verify.sh\"",
            "commandWindows": "bash -c \"bash \\\"$(git rev-parse --show-toplevel)/scripts/hooks/stop-verify.sh\\\"\"",
            "timeout": 900,
            "statusMessage": "lint · build · test 실행 중"
          }
        ]
      }
    ]
  }
}
