 COLUMN_TOLERANCE_PT * 4\r\n  45: /** 怨꾩뿴???댁뼱吏?붿? 蹂대뒗 異뺤쿃 ?몄감. 鴉뤷쎋 ?뚯꽌? 媛숈? 媛믪씠??*/\r\n  46: const SCALE_TOLERANCE_RATIO = 0.03\r\n  47: /** ?쇰꺼??遺숈? ?덈꺼???대낫???곸쑝硫?怨꾩뿴濡?蹂댁? ?딅뒗????遺遺?移섏닔 ?닿낵???좎씪??援щ텇 */\r\n  48: const MINIMUM_LABELLED_LEVELS = 2\r\n  49: /**\r\n  50:  * 吏㏃? 援ш컙? 移섏닔 ?쒓린媛 援ш컙 以묒젏?먯꽌 踰쀬뼱?섍린 ?쎈떎. 湲곗〈 ?곗뇙媛 異⑸텇??湲멸퀬,\r\n  51:  * ?ㅼ쓬 移섏닔媛 ?욎꽑 媛믩뱾??以묒븰媛믩낫????鍮꾩쑉蹂대떎 ?묒쑝硫?洹?移섏닔瑜??곗뇙??蹂댁〈?쒕떎.\r\n  52:  * ?대뒗 洹쒖?媛믪씠 ?꾨땲??PDF ?띿뒪??諛곗튂 ?먯젙?대떎.\r\n  53:  */\r\n  54: const SHORT_DIMENSION_RATIO = 0.25\r\n  55: /**\r\n  56:  * 吏㏃? 移섏닔 ?ㅼ쓽 ?ㅼ쓬 ?レ옄????씠 ?ㅻⅨ 移섏닔 ?댁뿉 ?볦씪 ???덈떎. 湲곗〈 ?덈꺼 ?쇰꺼\r\n  57:  * 李쎌뿉???좊룄??踰붿쐞 ?덉뿉?쒕쭔 ???대룞???덉슜?쒕떎 ???뚯씪紐낅퀎 x 醫뚰몴瑜??곗? ?딅뒗??\r\n  58:  */\r\n  59: const SHORT_TAIL_COLUMN_WINDOW_PT = LABEL_WINDOW_PT / 4\r\n  60: /** 吏㏃? 移섏닔???띿뒪???꾩튂 ?몄감瑜??덉슜?섎릺, 媛源뚯슫 ?≪쓬 移섏닔??嫄곗젅?쒕떎. */\r\n  61: /**\r\n  62:  * ?ㅼ젣 吏㏃? 瑗щ━ ?ㅼ감??tsu 1170mm媛 0.4879329, hirosaki 2310mm媛 0.0005626?대떎.\r\n  63:  * 理쒕?媛믪쓣 ?ы븿?섎릺 50% 李쎈낫??醫곹엳湲??꾪빐 0.49瑜??대떎.\r\n  64:  */\r\n  65: const SHORT_TAIL_SCALE_TOLERANCE_RATIO = 0.49\r\n  66: /**\r\n  67:  * 怨꾩뿴???섎젮硫?移섏닔媛 ?대쭔???덉뼱???쒕떎.\r\n  68:  *\r\n  69:  * **?섎줈??諛섏쬆?????쒕떎.** 移섏닔 ??媛쒕뒗 異뺤쿃???섎굹 ?좊룄?섎뒗?? ?좊룄??媛믪씠\r\n  70:  * ?먭린 ?먯떊怨??닿툔???섎뒗 ?놁쑝誘濡?異뺤쿃 ?쇨???寃?ш? 怨듯쉶?꾪븳?? 洹몃윭硫??⑤뒗\r\n  71:  * 利앷굅???쇰꺼 ?쇱튂肉먯씤?? 湲?먭? 鍮쎈뭣???꾨㈃?먯꽌??洹멸쾬??**?곗뿰??* 留욌뒗???? * ?ㅻЪ kani p40?먯꽌 ?꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔(5,535 ?? 75 ??媛 ???대줈\r\n  72:  * ?댁뼱??異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???덈꺼 ?먮━??留덉묠 湲?먭? ?덉뼱\r\n  73:  * ??踰????듦낵?덈떎.\r\n  74:  *\r\n  75:  * ?뗭씠硫?異뺤쿃?????좊룄?섏뼱 ?쒕줈瑜?諛섏쬆?????덇퀬, 洹?寃?ш? ????寃쎌슦瑜? * 紐⑤몢 ?〓뒗?? ?媛濡?移섏닔媛 ?섎퓧??邕며탡??3?덈꺼)???쎌? ?딅뒗????吏?대궡?? * 寃껊낫???ル떎 (R10).\r\n  76:  */\r\n  77: const MINIMUM_CHAIN_DIMENSIONS = 3\r\n  78: \r\n  79: interface Token {\r\n  80:   text: string\r\n  81:   x: number\r\n  82:   y: number\r\n  83:   leftX: number\r\n  84:   rightX: number\r\n  85: }\r\n  86: \r\n  87: interface DimensionToken extends Token {\r\n  88:   valueMm: number\r\n  89: }\r\n  90: \r\n  91: function tokens(page: TextPage): Token[] {\r\n  92:   const collected: Token[] = []\r\n  93:   for (const row of recoverRows(page.items)) {\r\n  94:     for (const segment of row.segments) {\r\n  95:       collected.push({\r\n  96:         text: segment.compact,\r\n  97:         x: segment.centerX,\r\n  98:         y: segment.centerY,\r\n  99:         leftX: segment.x,\r\n 100:         rightX: segment.endX,\r\n 101:       })\r\n 102:     }\r\n 103:   }\r\n 104:   for (const run of verticalRuns(page.items)) {\r\n 105:     collected.push({\r\n 106:       text: run.text,\r\n 107:       x: run.x,\r\n 108:       y: run.y,\r\n 109:       leftX: run.x,\r\n 110:       rightX: run.x,\r\n 111:     })\r\n 112:   }\r\n 113:   return collected\r\n 114: }\r\n 115: \r\n 116: function median(values: number[]): number {\r\n 117:   return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\r\n 118: }\r\n 119: \r\n 120: function dimensionScale(left: DimensionToken, right: DimensionToken): number {\r\n 121:   return (\r\n 122:     (2 * (right.y - left.y)) /\r\n 123:     (left.valueMm + right.valueMm)\r\n 124:   )\r\n 125: }\r\n 126: \r\n 127: function chainScales(chain: DimensionToken[]): number[] {\r\n 128:   return chain.slice(1).map((dimension, i) =>\r\n 129:     dimensionScale(chain[i], dimension),\r\n 130:   )\r\n 131: }\r\n 132: \r\n 133: function isShortDimension(\r\n 134:   dimension: DimensionToken,\r\n 135:   previous: DimensionToken[],\r\n 136: ): boolean {\r\n 137:   return (\r\n 138:     previous.length >= MINIMUM_CHAIN_DIMENSIONS &&\r\n 139:     dimension.valueMm < median(previous.map((entry) => entry.valueMm)) *\r\n 140:       SHORT_DIMENSION_RATIO\r\n 141:   )\r\n 142: }\r\n 143: \r\n 144: /** 移섏닔瑜?x媛 怨㏐쾶 ???대줈 臾띕뒗??*/\r\n 145: function dimensionColumns(dimensions: DimensionToken[]): DimensionToken[][] {\r\n 146:   const sorted = [...dimensions].sort((a, b) => a.x - b.x || a.y - b.y)\r\n 147:   const columns: DimensionToken[][] = []\r\n 148: \r\n 149:   for (const token of sorted) {\r\n 150:     const column = columns.at(-1)\r\n 151:     if (column && Math.abs(column[0].x - token.x) <= COLUMN_TOLERANCE_PT) {\r\n 152:       column.push(token)\r\n 153:     } else {\r\n 154:       columns.push([token])\r\n 155:     }\r\n 156:   }\r\n 157: \r\n 158:   return columns.map((column) => [...column].sort((a, b) => a.y - b.y))\r\n 159: }\r\n 160: \r\n 161: function horizontalDistance(token: Token, x: number): number {\r\n 162:   if (token.rightX < x) return x - token.rightX\r\n 163:   if (token.leftX > x) return token.leftX - x\r\n 164:   return 0\r\n 165: }\r\n 166: \r\n 167: function labelText(token: Token): string | undefined {\r\n 168:   const text = token.text.replace(/^[?썩뼰?꿎뼹]+/, '')\r\n 169:   return text.length > 0 ? text : undefined\r\n 170: }\r\n 171: \r\n 172: function isLevelLabel(text: string): boolean {\r\n 173:   return /(?:FL|GL|RCL|(?:鸚⑴ク|訝뗧ク|訝딁ク)$)/.test(text)\r\n 174: }\r\n 175: \r\n 176: function labelColumns(labels: Token[], axisX: number): Token[][] {\r\n 177:   const candidates = labels\r\n 178:     .filter((label) => horizontalDistance(label, axisX) <= LABEL_WINDOW_PT)\r\n 179:     .sort(\r\n 180:       (left, right) =>\r\n 181:         left.leftX - right.leftX ||\r\n 182:         left.y - right.y ||\r\n 183:         left.rightX - right.rightX,\r\n 184:     )\r\n 185:   const columns: Token[][] = []\r\n 186: \r\n 187:   for (const candidate of candidates) {\r\n 188:     const column = columns.at(-1)\r\n 189:     const columnRight = column?.reduce(\r\n 190:       (right, token) => Math.max(right, token.rightX),\r\n 191:       Number.NEGATIVE_INFINITY,\r\n 192:     )\r\n 193:     if (\r\n 194:       column &&\r\n 195:       candidate.leftX - columnRight! <= LABEL_COLUMN_GAP_PT\r\n 196:     ) {\r\n 197:       column.push(candidate)\r\n 198:     } else {\r\n 199:       columns.push([candidate])\r\n 200:     }\r\n 201:   }\r\n 202: \r\n 203:   return columns\r\n 204: }\r\n 205: \r\n 206: function nearestLevelIndex(\r\n 207:   levels: ElevationLevel[],\r\n 208:   y: number,\r\n 209: ): { index: number; distance: number } {\r\n 210:   let index = -1\r\n 211:   let distance = Number.POSITIVE_INFINITY\r\n 212:   for (let i = 0; i < levels.length; i++) {\r\n 213:     const candidateDistance = Math.abs(levels[i].positionPt - y)\r\n 214:     if (candidateDistance < distance) {\r\n 215:       index = i\r\n 216:       distance = candidateDistance\r\n 217:     }\r\n 218:   }\r\n 219:   return { index, distance }\r\n 220: }\r\n 221: \r\n 222: function selectLabelColumn(\r\n 223:   labels: Token[],\r\n 224:   levels: ElevationLevel[],\r\n 225:   axisX: number,\r\n 226: ): Token[] {\r\n 227:   const ranked = labelColumns(labels, axisX)\r\n 228:     .map((column) => {\r\n 229:       const usable = column.filter((token) => {\r\n 230:         const text = labelText(token)\r\n 231:         return text !== undefined && isLevelLabel(text)\r\n 232:       })\r\n 233:       const labelledLevels = new Set(\r\n 234:         usable\r\n 235:           .map((token) => nearestLevelIndex(levels, token.y))\r\n 236:           .filter(({ distance }) => distance <= LEVEL_TOLERANCE_PT)\r\n 237:           .map(({ index }) => index),\r\n 238:       )\r\n 239:       const distance = Math.min(\r\n 240:         ...column.map((token) => horizontalDistance(token, axisX)),\r\n 241:       )\r\n 242:       return { column, labelledLevels, usable, distance }\r\n 243:     })\r\n 244:     .sort(\r\n 245:       (left, right) =>\r\n 246:         right.labelledLevels.size - left.labelledLevels.size ||\r\n 247:         right.usable.length - left.usable.length ||\r\n 248:         left.distance - right.distance,\r\n 249:     )\r\n 250: \r\n 251:   const selected = ranked[0]?.column ?? []\r\n 252:   const selectedSet = new Set(selected)\r\n 253:   const displaced = ranked.flatMap(({ column }) =>\r\n 254:     column.filter((token) => {\r\n 255:       if (selectedSet.has(token)) return false\r\n 256:       const text = labelText(token)\r\n 257: 