{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -Raw C:\\\\Users\\\\emper\\\\step5_verify.mts\"","aggregated_output":"import { readFileSync } from 'node:fs'\nimport { resolve } from 'node:path'\n\nimport { parseFrameElevations } from 'C:/Users/emper/mdtproject/src/lib/import/framing-plan/elevation.ts'\nimport { parseFramingPlan } from 'C:/Users/emper/mdtproject/src/lib/import/framing-plan/parse.ts'\nimport { compact } from 'C:/Users/emper/mdtproject/src/lib/import/runs.ts'\nimport type { TextPage } from 'C:/Users/emper/mdtproject/src/lib/import/section-list/types.ts'\n\nconst root = 'C:/Users/emper/mdtproject'\nconst files = JSON.parse(readFileSync(resolve(root, 'phases/36-corpus-widen-2/step0-report.json'), 'utf8')).fixtures.map((entry: { file: string }) => entry.file) as string[]\n\nfunction page(file: string): TextPage {\n  const fixture = JSON.parse(readFileSync(resolve(root, 'tests/fixtures/section-import/textitems', file), 'utf8')) as TextPage\n  return fixture\n}\n\nfunction gridSummary(file: string) {\n  const parsed = parseFramingPlan(page(file))\n  return {\n    file,\n    grids: parsed.grids.map((grid) => ({\n      direction: grid.direction,\n      labels: grid.axes.map((axis) => axis.label),\n      positions: grid.axes.map((axis) => Number(axis.positionPt.toFixed(6))),\n      spansMm: grid.spansMm,\n    })),\n    issues: parsed.issues,\n  }\n}\n\nfunction elevationSummary(file: string) {\n  const parsed = parseFrameElevations(page(file))\n  return {\n    file,\n    elevations: parsed.elevations.map((elevation) => ({\n      titles: elevation.titles,\n      heightsMm: elevation.heightsMm,\n      labels: elevation.levels.map((level) => level.labels),\n    })),\n    issues: parsed.issues,\n  }\n}\n\nfunction rawLabelEvidence(file: string) {\n  const input = page(file)\n  const parsed = parseFramingPlan(input)\n  return parsed.grids.map((grid) => {\n    const raw = input.items\n      .filter((item) => {\n        const value = compact(item.str)\n        return value.length > 0 && (grid.direction === 'X' ? item.y < input.page.heightPt / 2 : item.x < input.page.widthPt / 2)\n      })\n      .map((item) => ({ value: compact(item.str), x: item.x + item.w / 2, y: item.y + item.h / 2 }))\n    return {\n      direction: grid.direction,\n      axes: grid.axes.map((axis) => {\n        const coordinate = grid.direction === 'X' ? axis.positionPt : axis.positionPt\n        const candidates = raw.filter((item) => {\n          const along = grid.direction === 'X' ? item.x : item.y\n          return Math.abs(along - coordinate) <= 2\n        })\n        return { label: axis.label, positionPt: Number(coordinate.toFixed(3)), raw: candidates.slice(0, 8).map((item) => `${item.value}@${item.x.toFixed(1)},${item.y.toFixed(1)}`) }\n      }),\n    }\n  })\n}\n\nconst mode = process.argv[2]\nif (mode === 'grid') {\n  console.log(JSON.stringify(files.map(gridSummary), null, 2))\n} else if (mode === 'elevation') {\n  console.log(JSON.stringify(['hirosaki-p25.json', 'karatsu-jikugumi1-p1.json', 'tsu-p21.json', 'yokohama-p8.json', 'yokohama-p9.json', 'kani-p40.json', 'kani-p41.json'].map(elevationSummary), null, 2))\n} else if (mode === 'raw-labels') {\n  const target = process.argv[3] ? [process.argv[3]] : files\n  console.log(JSON.stringify(target.flatMap(rawLabelEvidence), null, 2))\n} else {\n  throw new Error(`unknown mode: ${mode}`)\n}\n\r\n","exit_code":0,"status":"completed"}}
