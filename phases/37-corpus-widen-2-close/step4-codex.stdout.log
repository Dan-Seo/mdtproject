n\r\n    expect(g1.girderMain).toBeUndefined()\r\n    // 訝듾툔 ?대뒓 ?됱씠 ?묓삍?붿?源뚯? ?④릿?????먮룄?먯꽌 李얠븘蹂?怨녹씠 ?ㅻⅤ??\r\n    expect(g1.raw['訝딁춮(?섋퓭??']).toBe('2-D22')\r\n    expect(g1.issues).toContain('訝사춮?섋퓭??)\r\n    // ?묓옒怨?臾닿?????씊쨌?귙겙?됬춮? ?뺤긽 ?뺤젙\r\n    expect(g1.b).toBe(400)\r\n    expect(g1.depth).toBe(600)\r\n    expect(g1.stirrup).toEqual({ size: 'D10', pitchMm: 200 })\r\n  })\r\n\r\n  it('rejects a pitch cell where an adjacent segment was glued onto the number', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\r\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\r\n        { str: '躍?춮', x: 10, y: 44, w: 20, h: 8 },\r\n        // ?똃13@100?????띻? 援щ텇???놁씠 遺숈? ?붿옱 ??pitchMm=1002濡??뺤젙?섎㈃ 臾쇰웾 ?ㅻ쪟\r\n        { str: 'D13@1002', x: 100, y: 44, w: 48, h: 8 },\r\n      ],\r\n    })\r\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\r\n\r\n    expect(c1.hoop).toBeUndefined()\r\n    expect(c1.raw['躍?춮']).toBe('D13@1002')\r\n    expect(c1.issues).toContain('躍?춮鰲ｉ뇠訝띹꺗')\r\n  })\r\n\r\n  it('rejects a metric-notation dimension instead of confirming digits around the dot', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\r\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\r\n        { str: '??씊', x: 10, y: 44, w: 20, h: 8 },\r\n        // 誘명꽣 ?쒓린 ????횞0?띾쭔 留ㅼ튂??b=8쨌d=0?쇰줈 ?뺤젙?섎㈃ 議곗슜???由??⑤㈃???쒕떎\r\n        { str: '0.8횞0.8', x: 110, y: 44, w: 44, h: 8 },\r\n      ],\r\n    })\r\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\r\n\r\n    expect(c1.b).toBeUndefined()\r\n    expect(c1.d).toBeUndefined()\r\n    expect(c1.raw['??씊']).toBe('0.8횞0.8')\r\n    expect(c1.issues).toContain('??씊?⒴숱訝띷닇塋?)\r\n  })\r\n\r\n  it('reads a 訝사춮 cell written with the U+2015 dash', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\r\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\r\n        { str: '訝사춮', x: 10, y: 44, w: 20, h: 8 },\r\n        // CP932 0x815C(?②쭜??껁궥????U+2014? U+2015濡?媛덈젮 ?ㅼ뼱?⑤떎. ?욎쓽 寃껊쭔\r\n        // ?묒쑝硫???????뚰빐??遺덈뒫?띿쑝濡??⑥뼱??媛믪씠 ?덈뒗?곕룄 鍮덉뭏???쒕떎\r\n        { str: '16?뷗25', x: 100, y: 44, w: 36, h: 8 },\r\n      ],\r\n    })\r\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\r\n\r\n    expect(c1.main).toEqual({ count: 16, size: 'D25' })\r\n    expect(c1.issues).toHaveLength(0)\r\n  })\r\n\r\n  it('keeps ?룬윹寧?intact in the raw fallback instead of folding it to a hyphen', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\r\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\r\n        { str: '??씊', x: 10, y: 44, w: 20, h: 8 },\r\n        // ??U+30FC)???섏씠?덉씠 ?꾨땲??媛??湲?먮떎 ???섏씠?덈쪟???ｌ뼱 ?묒쑝硫?\r\n        // ?뚣궠?녈궚???덀띻? ?섏뼱, ?뺤젙?섏? 紐삵븳 ???遺숈씠???먮Ц 李멸퀬 ?쒖떆媛 留앷?吏꾨떎\r\n        { str: '?녈꺍??꺁?쇈깉?볠붂??, x: 110, y: 44, w: 72, h: 8 },\r\n      ],\r\n    })\r\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\r\n\r\n    expect(c1.raw['??씊']).toBe('?녈꺍??꺁?쇈깉?볠붂??)\r\n    expect(c1.issues).toContain('??씊?⒴숱訝띷닇塋?)\r\n  })\r\n\r\n  it('keeps a dash-only cell visible in the raw fallback', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [