ult, dimension, false, verticalValues.get(mark))\r\n      const topFold = topContinuations.get(mark)\r\n      const bottomFold = bottomContinuations.get(mark)\r\n      if (topFold !== undefined || bottomFold !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????以꾨뱾???먮Ц 李멸퀬濡??④릿??\r\n        if (topLabel) {\r\n          for (const cell of topCells) {\r\n            result.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        if (bottomLabel) {\r\n          for (const cell of bottomCells) {\r\n            result.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        // 訝듾툔瑜????ㅼ뿉 紐곕㈃ ?묒そ???묓엺 ?쒖뿉??訝뗧춮 以꾩씠 訝딁춮 以꾩쓣 ??뒗??\r\n        // 躍?춮쨌ST? 媛숈? ?쇰꺼 洹쒖빟?????대뒓 ?됱씠 ?묓삍?붿????④릿??\r\n        // ??釉붾줉怨?媛숈? ?댁쑀濡?泥?以꾩씠 ?녿뒗 履쎌? ?묓옒?대씪 遺瑜댁? ?딅뒗??\r\n        if (topFold !== undefined) {\r\n          const folded = topCells.length > 0\r\n          result.raw[\r\n            `${topLabel ?? '訝딁춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(topFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n        if (bottomFold !== undefined) {\r\n          const folded = bottomCells.length > 0\r\n--- parse.ts exports/types ---\r\n22:  ParsedSectionList,\r\n2588:): ParsedSectionList | undefined {\r\n2731:export function parseSectionLists(page: TextPage): ParsedSectionList[] {\r\n2735:  const parsed: ParsedSectionList[] = []\r\n--- unit tests beginning ---\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseSectionLists } from './parse'\r\nimport type { ParsedSectionList, SectionCandidate } from './types'\r\n\r\n// ?ㅻЪ ?꾨㈃ ?쎌뒪泥??議곕뒗 tests/section-import/parse.test.ts???덈떎.\r\n// ?ш린???⑹꽦 TextPage濡??뚯꽌??寃쎄퀎 洹쒖튃留?怨좎젙?쒕떎.\r\n\r\nfunction list(\r\n  parsed: ParsedSectionList[],\r\n  listKind: string,\r\n): ParsedSectionList {\r\n  const foun