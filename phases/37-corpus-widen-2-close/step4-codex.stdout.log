filter(({ listKind }) => listKind !== '屋内階段・屋外階段 配筋図')\r\n      .map(({ listKind }) => listKind)\r\n      .sort()\r\n    expect(parsed.map(({ listKind }) => listKind).sort()).toEqual(expectedListKinds)\r\n    for (const listSpec of doc.lists.filter(\r\n      ({ listKind }) => listKind !== '屋内階段・屋外階段 配筋図',\r\n    )) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      const expectedMarks = [\r\n        ...(listSpec.entries ?? []).map(({ mark }) => mark),\r\n        ...(listSpec.outOfScopeMarks ?? []),\r\n        ...(listSpec.marks ?? []),\r\n      ].sort()\r\n      expect(parsedList.candidates.map(({ mark }) => mark).sort()).toEqual(expectedMarks)\r\n    }\r\n    const wallEntries = doc.lists.find(({ listKind }) => listKind === '壁リスト')!\r\n      .entries as ExpectedWallEntry[]\r\n    const slabEntries = doc.lists.find(({ listKind }) => listKind === 'スラブリスト')!\r\n      .entries as ExpectedSlabEntry[]\r\n\r\n    const counts = { wallThickness: 0, wallVertical: 0, wallHorizontal: 0, slabThickness: 0, slabBars: 0 }\r\n    for (const entry of wallEntries) {\r\n      const c = candidate(walls, entry.mark)\r\n      expect(c.kind, entry.mark).toBe('耐震壁')\r\n      if (entry.thickness !== undefined) {\r\n        expect(c.thickness, entry.mark).toBe(entry.thickness)\r\n        counts.wallThickness += 1\r\n      } else {\r\n        expect(c.thickness, entry.mark).toBeUndefined()\r\n        expect(c.raw['断面'], entry.mark).toBe(entry['断面raw'])\r\n      }\r\n      for (const [role, expected] of [['vertical', entry.縦筋], ['horizontal', entry.横筋]] as const) {\r\n        const parsedBar = c[role]\r\n        const match = expected.match(/^(D\\d+)@([0-9]+)\\((.+)\\)$/)\r\n        if (match) {\r\n          expect(parsedBar, `${entry.mark} ${role}`).toEqual({\r\n            size: match[1],\r\n            pitchMm: Number(match[2]),\r\n          })\r\n          expect(c.layers, `${entry.mark} ${role}`).toBe(\r\n            /ダブル|ﾀﾞﾌﾞﾙ|ダブルチドリ/.test(match[3]) ? 2 : 1,\r\n          )\r\n          counts[role === 'vertical' ? 'wallVertical' : 'wallHorizontal'] += 1\r\n        } else {\r\n          expect(parsedBar, `${entry.mark} ${role}`).toBeUndefined()\r\n          expect(c.raw[role === 'vertical' ? '縦筋' : '横筋'], `${entry.mark} ${role}`).toBe(expected)\r\n        }\r\n      }\r\n    }\r\n    expect(counts).toEqual({\r\n      wallThickness: 4,\r\n      wallVertical: 5,\r\n      wallHorizontal: 5,\r\n      slabThickness: 0,\r\n      slabBars: 0,\r\n    })\r\n\r\n    for (const entry of slabEntries) {\r\n      const c = candidate(slabs, entry.mark)\r\n      expect(c.kind, entry.mark).toBe('床板')\r\n      expect(c.thickness, entry.mark).toBe(entry.thickness)\r\n      counts.slabThickness += 1\r\n      const top = entry.上端筋 ?? entry.上筋!\r\n      const bottom = entry.下端筋 ?? entry.下筋!\r\n      for (const [face, values] of [['top', top], ['bottom', bottom] as const] as const) {\r\n        for (const [axis, expected] of Object.entries(values)) {\r\n          const key = axis === '短辺方向' ? 'shortSide' : 'longSide'\r\n          const parsedBar = c[key]?.[face]\r\n          const match = expected.match(/^(D\\d+)-?@([0-9]+)$/)\r\n          if (match) {\r\n            expect(parsedBar, `${entry.mark} ${axis} ${face}`).toEqual({\r\n              size: match[1],\r\n              pitchMm: Number(match[2]),\r\n            })\r\n            counts.slabBars += 1\r\n          } else {\r\n            expect(parsedBar, `${entry.mark} ${axis} ${face}`).toBeUndefined()\r\n            expect(\r\n              c.raw[`${axis}(${face})`],\r\n              `${entry.mark} ${axis} ${face}`,\r\n            ).toBe(expected)\r\n          }\r\n        }\r\n      }\r\n    }\r\n    expect(counts.slabThickness).toBe(6)\r\n    expect(counts.slabBars).toBe(15)\r\n    expectMarksInclude(slabs, ['FS1', 'FS2', 'FS3', 'FS4'])\r\n    for (const mark of doc.lists.find(({ listKind }) => listKind === 'スラブリスト')!.outOfScopeMarks!) {\r\n      expect(candidate(slabs, mark).kind, mark).toBe('対象外')\r\n    }\r\n\r\n    for (const listSpec of doc.lists.filter(\r\n      ({ scope, listKind }) =>\r\n        scope === '対象外' &&\r\n        ['小梁リスト', '片持梁リスト'].includes(listKind),\r\n    )) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      expect(parsedList.candidates.every(({ kind }) => kind === '対象外')).toBe(true)\r\n      for (const mark of listSpec.marks ?? []) expectMarksInclude(parsedList, [mark])\r\n    }\r\n  })\r\n\r\n  it('ojkk 小梁·片持梁リスト — 対象外 셀의 断面寸法·配筋을 전 셀 대조한다', () => {\r\n    type ExpectedOutOfScopeEntry = {\r\n      mark: string\r\n      b?: number\r\n      depth?: number\r\n      上端筋: string | Record<string, string>\r\n      下端筋: string | Record<string, string>\r\n      あばら筋: string\r\n      腹筋?: string\r\n      腹筋raw?: string\r\n      expected?: {\r\n        b: null\r\n        depth: null\r\n        issues: string[]\r\n        '断面raw_contains': string[]\r\n      }\r\n    }\r\n\r\n    const doc = readExpected<ExpectedWallSlabDoc>(\r\n      'ojkk-akamichi-p4-walls-slabs.json',\r\n    )\r\n    const parsed = parseSectionLists(readPage('ojkk-p4.json'))\r\n    const scopeOutLists = doc.lists.filter(({ listKind }) =>\r\n      ['小梁リスト', '片持梁リスト'].includes(listKind),\r\n    )\r\n    let entriesChecked = 0\r\n\r\n    for (const listSpec of scopeOutLists) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      const entries = (listSpec.entries ?? []) as unknown as ExpectedOutOfScopeEntry[]\r\n      expect(parsedList.candidates.map(({ mark }) => mark).sort(), listSpec.listKind).toEqual(\r\n        entries.map(({ mark }) => mark).sort(),\r\n      )\r\n\r\n      for (const entry of entries) {\r\n        entriesChecked += 1\r\n        const c = candidate(parsedList, entry.mark)\r\n        expect(c.kind, entry.mark).toBe('対象外')\r\n\r\n        if (entry.expected) {\r\n          expect({ b: c.b, depth: c.depth }, entry.mark).toEqual({\r\n            b: undefined,\r\n            depth: undefined,\r\n          })\r\n          expect(c.issues, entry.mark).toContain('断面矩形不成立')\r\n          const rawDimension = c.raw['断面']?.normalize('NFKC') ?? ''\r\n          for (const rawPart of entry.expected['断面raw_contains']) {\r\n            expect(rawDimension, `${entry.mark} 断面`).toContain(\r\n              rawPart.normalize('NFKC'),\r\n            )\r\n          }\r\n        } else {\r\n          expect({ b: c.b, depth: c.depth }, entry.mark).toEqual({\r\n            b: entry.b,\r\n            depth: entry.depth,\r\n          })\r\n        }\r\n\r\n        const top = entry.上端筋\r\n        const bottom = entry.下端筋\r\n        if (typeof top === 'string' && typeof bottom === 'string') {\r\n          expect(c.girderMain, `${entry.mark} 主筋`).toBeDefined()\r\n          expect(\r\n            c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`,\r\n            `${entry.mark} 上端筋`,\r\n          ).toBe(top)\r\n          expect(\r\n            c.girderMain && `${c.girderMain.bottomCount}-${c.girderMain.size}`,\r\n            `${entry.mark} 下端筋`,\r\n          ).toBe(bottom)\r\n        } else {\r\n          expect(typeof top, `${entry.mark} 上端筋`).toBe('object')\r\n          expect(typeof bottom, `${entry.mark} 下端筋`).toBe('object')\r\n          expect(c.girderMain, `${entry.mark} 主筋`).toBeDefined()\r\n          const main = c.girderMain!\r\n          const topByPosition = top as Record<string, string>\r\n          const bottomByPosition = bottom as Record<string, string>\r\n          expect(\r\n            `${main.topCount}-${main.size}`,\r\n            `${entry.mark} 上端筋 中央`,\r\n          ).toBe(topByPosition.中央)\r\n          expect(\r\n            `${main.bottomCount}-${main.size}`,\r\n            `${entry.mark} 下端筋 中央`,\r\n          ).toBe(bottomByPosition.中央)\r\n          if ('端部' in topByPosition && '端部' in bottomByPosition) {\r\n            expect(\r\n              `${main.endTopCount}-${main.size}`,\r\n              `${entry.mark} 上端筋 端部`,\r\n            ).toBe(topByPosition.端部)\r\n            expect(\r\n              `${main.endBottomCount}-${main.size}`,\r\n              `${entry.mark} 下端筋 端部`,\r\n            ).toBe(bottomByPosition.端部)\r\n          }\r\n        }\r\n\r\n        expect(\r\n          c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`,\r\n          `${entry.mark} あばら筋`,\r\n        ).toBe(normPitch(entry.あばら筋))\r\n\r\n        if (entry.腹筋) {\r\n          const match = entry.腹筋.match(/^(\\d+)-(D\\d+)$/)\r\n          expect(match, `${entry.mark} 腹筋`).not.toBeNull()\r\n          expect(c.sideBar, `${entry.mark} 腹筋`).toEqual({\r\n            count: Number(match?.[1]),\r\n            size: match?.[2],\r\n          })\r\n        } else {\r\n          expect(c.sideBar, `${entry.mark} 腹筋`).toBeUndefined()\r\n        }\r\n      }\r\n    }\r\n\r\n    expect(entriesChecked).toBe(12)\r\n  })\r\n\r\n  it('yokohama スラブリスト — 上筋/下筋 별칭과 床板 실패 경로를 대조한다', () => {\r\n    const doc = readExpected<ExpectedWallSlabDoc>(\r\n      'yokohama-kanazawa-p15-slabs-walls.json',\r\n    )\r\n    const parsed = parseSectionLists(readPage('yokohama-p15.json'))\r\n    const slabs = list(parsed, 'スラブリスト')\r\n    expect(parsed.map(({ listKind }) => listKind).sort()).toEqual(\r\n      doc.lists.map(({ listKind }) => listKind).sort(),\r\n    )\r\n    for (const listSpec of doc.lists) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      const expectedMarks =\r\n        listSpec.scope === '形式対象外'\r\n          ? []\r\n          : [\r\n              ...(listSpec.entries ?? []).map(({ mark }) => mark),\r\n              ...(listSpec.marks ?? []),\r\n            ].sort()\r\n      expect(parsedList.candidates.map(({ mark }) => mark).sort()).toEqual(expectedMarks)\r\n    }\r\n    const entries = doc.lists.find(({ listKind }) => listKind === 'スラブリスト')!\r\n      .entries as ExpectedSlabEntry[]\r\n    let thickness = 0\r\n    let bars = 0\r\n    for (const entry of entries) {\r\n      const c = candidate(slabs, entry.mark)\r\n      expect(c.kind).toBe('床板')\r\n      expect(c.thickness).toBe(entry.thickness)\r\n      thickness += 1\r\n      const top = entry.上筋!\r\n--- fixture shape ---\r\n{\r\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 도면 페이지를 300dpi로 렌더링해 눈으로 읽고, 원시 TextItem 행 재구성과 교차 대조했다. 파서 출력에서 유도하지 않았다. 반각/전각(･·ﾀﾞﾌﾞﾙﾁﾄﾞﾘ 등)은 raw 그대로 적었다.\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-ojkk-zumen6.pdf\",\r\n    \"sha256\": \"dcb9504a50d8661a76bbd96c412a20f468cfff7495167cd055ca0bb2289e1343\",\r\n    \"issuer\": \"沖縄県住宅供給公社\",\r\n    \"project\": \"(仮称)公社赤道都市再生住宅整備工事（建築）\",\r\n    \"sheet\": \"S-17 小梁・スラブ・壁・階段リスト A1=1:30\",\r\n    \"page\": 4,\r\n    \"transcribedAt\": \"2026-08-26\"\r\n  },\r\n  \"lists\": [\r\n    {\r\n      \"listKind\": \"壁リスト\",\r\n      \"orientation\": \"horizontal\",\r\n      \"notes\": [\r\n        \"열이 符号이고 행이 항목(断面·縦筋·横筋·開口補強·備考)인 가로형 표다\",\r\n        \"첫 열은 符号 「W10，W15」에 断面 두께 「100，150」 — 符号 2개·두께 2개가 순서 대응한다 (W10→100, W15→150). 배근은 두 符号이 같다\",\r\n        \"둘째 열은 符号 「EW15」 하나에 断面 두께 표기가 「100，150」 둘 — 어느 쪽인지 도면이 말하지 않는다. 두께는 결정 불가이고 원문만 남는다\",\r\n        \"縦筋·横筋 셀은 「D10@150(シングル)」꼴로 배근 층수가 괄호에 붙는다. シングル→1층, ダブル·ﾀﾞﾌﾞﾙﾁﾄﾞﾘ→2층\",\r\n        \"開口補強(タテ筋·ヨコ筋·斜メ筋)은 開口補強筋이라 제품 스코프 밖이다 (ADR-029 — 「設計図書により計測・計算する」). 전사만 남긴다\",\r\n        \"備考의 雑壁·階段은 부재 구분이 아니라 쓰임새 메모다 — 후보 분류에 쓰지 않는다\"\r\n      ],\r\n      \"entries\": [\r\n        {\r\n          \"mark\": \"W10\",\r\n          \"thickness\": 100,\r\n          \"縦筋\": \"D10@150(シングル)\",\r\n          \"横筋\": \"D10@150(シングル)\",\r\n          \"開口補強\": { \"タテ筋\": \"2-D13\", \"ヨコ筋\": \"2-D13\", \"斜メ筋\": \"2-D13\" },\r\n          \"備考\": \"PS廻り･雑壁･外壁\"\r\n        },\r\n        {\r\n          \"mark\": \"W15\",\r\n          \"thickness\": 150,\r\n          \"縦筋\": \"D10@150(シングル)\",\r\n          \"横筋\": \"D10@150(シングル)\",\r\n          \"開口補強\": { \"タテ筋\": \"2-D13\", \"ヨコ筋\": \"2-D13\", \"斜メ筋\": \"2-D13\" },\r\n          \"備考\": \"PS廻り･雑壁･外壁\"\r\n        },\r\n        {\r\n          \"mark\": \"EW15\",\r\n          \"断面raw\": \"100，150\",\r\n          \"縦筋\": \"D10@150(シングル)\",\r\n          \"横筋\": \"D10@150(シングル)\",\r\n          \"開口補強\": { \"タテ筋\": \"2-D16\", \"ヨコ筋\": \"3-D16\", \"斜メ筋\": \"2-D16\" },\r\n          \"備考\": \"PS廻り･雑壁･外壁\"\r\n        },\r\n        {\r\n          \"mark\": \"EW15A\",\r\n          \"thickness\": 150,\r\n          \"縦筋\": \"D13@100(ﾀﾞﾌﾞﾙﾁﾄﾞﾘ)\",\r\n          \"横筋\": \"D10@200(ﾀﾞﾌﾞﾙﾁﾄﾞﾘ)\",\r\n          \"開口補強\": { \"タテ筋\": \"-\", \"ヨコ筋\": \"-\", \"斜メ筋\": \"-\" },\r\n          \"備考\": \"屋内階段\"\r\n        },\r\n        {\r\n          \"mark\": \"W20\",\r\n          \"thickness\": 200,\r\n          \"縦筋\": \"D13@150(ダブル)\",\r\n          \"横筋\": \"D10@200(ダブル)\",\r\n          \"開口補強\": { \"タテ筋\": \"2-D13\", \"ヨコ筋\": \"2-D13\", \"斜メ筋\": \"1-D13\" },\r\n          \"備考\": \"屋外階段\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"listKind\": \"スラブリスト\",\r\n      \"orientation\": \"vertical\",\r\n      \"notes\": [\r\n        \"행이 符号이고 각 符号이 上端筋·下端筋 2행을 갖는 세로형 표다. 값 열은 短辺方向·長辺方向\",\r\n        \"표제 특기: 「※ 特記の無い限り短辺方向を主筋とする。」\",\r\n        \"「D10･D13@200」(반각 ･)은 D10과 D13을 교互로 놓는 배근이다 — SlabBarRow(단일 径)로 표현할 수 없으므로 확정하면 지어내기다. 원문만 남는다\",\r\n        \"CS1~CS6은 備考 「片持ちスラブ」 — 片持床板은 제품 스코프 밖이다 (ADR-028). 対象外로 구분하고 값은 전사 생략\",\r\n        \"CS 행은 床厚가 基端·先端 두 값이다 — 스코프 밖이라 전사하지 않지만, 두께 열 구조가 S·FS 행과 다르다는 것 자체가 파서가 넘어져선 안 되는 지점이다\"\r\n      ],\r\n      \"entries\": [\r\n        {\r\n          \"mark\": \"S1\",\r\n          \"thickness\": 150,\r\n          \"上端筋\": { \"短辺方向\": \"D10･D13@200\", \"長辺方向\": \"D10@200\" },\r\n          \"下端筋\": { \"短辺方向\": \"D10@200\", \"長辺方向\": \"D10@200\" }\r\n        },\r\n        {\r\n          \"mark\": \"S2\",\r\n          \"thickness\": 150,\r\n          \"上端筋\": { \"短辺方向\": \"D10･D13@200\", \"長辺方向\": \"D10･D13@200\" },\r\n          \"下端筋\": { \"短辺方向\": \"D10･D13@200\", \"長辺方向\": \"D10･D13@200\" }\r\n        },\r\n        {\r\n          \"mark\": \"FS1\",\r\n          \"thickness\": 150,\r\n          \"上端筋\": { \"短辺方向\": \"D10･D13@200\", \"長辺方向\": \"D10･D13@200\" },\r\n          \"下端筋\": { \"短辺方向\": \"D10@200\", \"長辺方向\": \"D10@200\" }\r\n        },\r\n        {\r\n          \"mark\": \"FS2\",\r\n          \"thickness\": 170,\r\n          \"上端筋\": { \"短辺方向\": \"D10･D13@150\", \"長辺方向\": \"D10･D13@150\" },\r\n          \"下端筋\": { \"短辺方向\": \"D10@150\", \"長辺方向\": \"D10@150\" }\r\n        },\r\n        {\r\n          \"mark\": \"FS3\",\r\n          \"thickness\": 200,\r\n          \"上端筋\": { \"短辺方向\": \"D13@200\", \"長辺方向\": \"D13@200\" },\r\n          \"下端筋\": { \"短辺方向\": \"D13@200\", \"長辺方向\": \"D13@200\" }\r\n        },\r\n        {\r\n          \"mark\": \"FS4\",\r\n          \"thickness\": 150,\r\n          \"上端筋\": { \"短辺方向\": \"D13@100\", \"長辺方向\": \"D13@150\" },\r\n          \"下端筋\": { \"短辺方向\": \"D10@100\", \"長辺方向\": \"D10@150\" }\r\n        }\r\n      ],\r\n      \"outOfScopeMarks\": [\"CS1\", \"CS2\", \"CS3\", \"CS4\", \"CS5\", \"CS6\"]\r\n    },\r\n    {\r\n      \"listKind\": \"小梁リスト\",\r\n      \"scope\": \"対象外\",\r\n      \"notes\": [\r\n        \"小梁은 스코프 밖 부재다 — 파서는 파싱하되 후보를 対象外로 구분해야 한다 (p13 小梁断面リスト와 같은 취급)\",\r\n        \"2026-09-03 추기(phase 36 교차검증, Claude 전사): 표에 명시 「断面寸法」 행이 있다(y≈182: 350x600 550x700 200x500 450x900 400x800 450x1500 300x400 350x600 200x850). 스케치의 가로·세로 숫자는 이 행의 재표기이므로 b×depth의 근거는 断面寸法 행이다. entries는 원시 TextItem 행(符号 y≈58·断面寸法 y≈182·上端筋 y≈188·下端筋 y≈196·あばら筋 y≈204·腹筋 y≈210)을 x 열로 대응해 전사했고 파서 출력에서 유도하지 않았다(렌더링 대조는 하지 않았다)\",\r\n        \"B2는 位置 열이 端部·中央 둘이다 — 上端筋 6-D25/6-D25, 下端筋 端部 6-D25·中央 9-D25. あばら筋 셀은 「-D13-@200」꼴(양끝 하이픈)\",\r\n        \"B3는 腹筋 셀이 비어 있고 FB4는 「-」다 — 둘 다 없음으로 전사한다(기본값을 채우지 않는다)\"\r\n      ],\r\n      \"entries\": [\r\n        { \"mark\": \"B1\", \"b\": 350, \"depth\": 600, \"上端筋\": \"4-D22\", \"下端筋\": \"4-D22\", \"あばら筋\": \"D10@150\", \"腹筋\": \"2-D10\" },\r\n        { \"mark\": \"B2\", \"b\": 550, \"depth\": 700, \"位置\": [\"端部\", \"中央\"], \"上端筋\": { \"端部\": \"6-D25\", \"中央\": \"6-D25\" }, \"下端筋\": { \"端部\": \"6-D25\", \"中央\": \"9-D25\" }, \"あばら筋\": \"D13@200\", \"腹筋\": \"2-D10\" },\r\n        { \"mark\": \"B3\", \"b\": 200, \"depth\": 500, \"上端筋\": \"1-D22\", \"下端筋\": \"1-D22\", \"あばら筋\": \"D10@200\" },\r\n        { \"mark\": \"FB1\", \"b\": 450, \"depth\": 900, \"上端筋\": \"4-D22\", \"下端筋\": \"4-D22\", \"あばら筋\": \"D10@150\", \"腹筋\": \"4-D10\" },\r\n        { \"mark\": \"FB2\", \"b\": 400, \"depth\": 800, \"上端筋\": \"3-D22\", \"下端筋\": \"3-D22\", \"あばら筋\": \"D10@150\", \"腹筋\": \"4-D10\" },\r\n        { \"mark\": \"FB3\", \"b\": 450, \"depth\": 1500, \"上端筋\": \"4-D22\", \"下端筋\": \"4-D22\", \"あばら筋\": \"D10@150\", \"腹筋\": \"8-D10\" },\r\n        { \"mark\": \"FB4\", \"b\": 300, \"depth\": 400, \"上端筋\": \"3-D22\", \"下端筋\": \"3-D22\", \"あばら筋\": \"D10@200\", \"腹筋raw\": \"-\" },\r\n        { \"mark\": \"FB5\", \"b\": 350, \"depth\": 600, \"上端筋\": \"3-D22\", \"下端筋\": \"3-D22\", \"あばら筋\": \"D10@200\", \"腹筋\": \"2-D10\" },\r\n        { \"mark\": \"BW20\", \"b\": 200, \"depth\": 850, \"上端筋\": \"2-D16\", \"下端筋\": \"2-D16\", \"あばら筋\": \"D10@200\", \"腹筋\": \"4-D10\" }\r\n      ]\r\n    },\r\n    {\r\n      \"listKind\": \"片持梁リスト\",\r\n      \"scope\": \"対象外\",\r\n      \"notes\": [\r\n        \"片持梁도 스코프 밖 부재다\",\r\n        \"2026-09-03 추기(phase 36 교차검증, Claude 전사): 명시 「断面寸法」 행(y≈438: 400x700 450x2750 200x550 200x400)과 上端筋 y≈444·下端筋 y≈452·あばら筋 y≈458·腹筋 y≈466 행에서 전사. FCG1의 depth 2750은 원문 그대로다(腹筋 8-D10이 깊이를 뒷받침한다)\",\r\n        \"CB1은 位置 열이 中央·先端 둘이고 断面寸法도 둘(中央 200x550·先端 200x400)이다 — 후보 스키마에 위치별 断面이 없으므로 b·depth를 확정하지 않고 raw＋断面矩形不成立으로 남기는 것이 맞다. 두 값 중 하나를 고르면 지어내기다\"\r\n      ],\r\n      \"entries\": [\r\n        { \"mark\": \"CG1\", \"b\": 400, \"depth\": 700, \"上端筋\": \"5-D25\", \"下端筋\": \"3-D25\", \"あばら筋\": \"D13@200\", \"腹筋\": \"2-D10\" },\r\n        { \"mark\": \"FCG1\", \"b\": 450, \"depth\": 2750, \"上端筋\": \"3-D25\", \"下端筋\": \"3-D25\", \"あばら筋\": \"D13@200\", \"腹筋\": \"8-D10\" },\r\n        { \"mark\": \"CB1\", \"位置\": [\"中央\", \"先端\"], \"断面寸法\": { \"中央\": \"200x550\", \"先端\": \"200x400\" }, \"上端筋\": { \"中央\": \"2-D25\", \"先端\": \"2-D25\" }, \"下端筋\": { \"中央\": \"1-D25\", \"先端\": \"1-D25\" }, \"あばら筋\": \"D10@200\", \"expected\": { \"b\": null, \"depth\": null, \"issues\": [\"断面矩形不成立\"], \"断面raw_contains\": [\"200x550\", \"200x400\"] } }\r\n      ]\r\n    },\r\n    {\r\n      \"listKind\": \"屋内階段・屋外階段 配筋図\",\r\n      \"scope\": \"対象外\",\r\n      \"notes\": [\"リスト 표가 아니라 配筋図다 — 후보를 내지 않아야 한다. 段鼻筋·イナズマ筋 등의 항목 표가 딸려 있으나 부재 리스트가 아니다\"]\r\n    }\r\n  ]\r\n}\r\n","exit_code":0,"status":"completed"}}
