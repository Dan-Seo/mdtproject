rseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\r\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\r\n        { str: '訝사춮', x: 10, y: 44, w: 20, h: 8 },\r\n        { str: '4-D25+2-D22', x: 100, y: 44, w: 60, h: 8 },\r\n        { str: '躍?춮', x: 10, y: 56, w: 20, h: 8 },\r\n        { str: 'D13-@100/D10-@200', x: 100, y: 56, w: 80, h: 8 },\r\n      ],\r\n    })\r\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\r\n\r\n    // 2餘든춮쨌蹂듭닔 ?쒓린??泥?留ㅼ튂濡??뺤젙?섏? ?딅뒗????鍮덉뭏+?먮Ц ?꾩껜 蹂댁〈\r\n    expect(c1.main).toBeUndefined()\r\n    expect(c1.raw['訝사춮']).toBe('4-D25+2-D22')\r\n    expect(c1.hoop).toBeUndefined()\r\n    expect(c1.raw['躍?춮']).toBe('D13-@100/D10-@200')\r\n    expect(c1.issues).not.toHaveLength(0)\r\n  })\r\n\r\n  it('rejects a 訝사춮 cell with stray characters around the token', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 200,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\r\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\r\n        { str: '訝사춮', x: 10, y: 44, w: 20, h: 8 },\r\n        // ?몄젒 移섏닔???レ옄媛 ???遺숈? 寃쎌슦 ??留ㅼ튂 1媛쒕씪??? ?꾩껜媛 ?꾨땲硫?嫄곕?\r\n        { str: '70016-D25', x: 96, y: 44, w: 54, h: 8 },\r\n      ],\r\n    })\r\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\r\n\r\n    expect(c1.main).toBeUndefined()\r\n    expect(c1.raw['訝사춮']).toBe('70016-D25')\r\n    expect(c1.issues).not.toHaveLength(0)\r\n  })\r\n\r\n  it('does not confirm a 訝사춮 cell folded onto a second unlabeled line', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 400,\r\n      heightPt: 240,\r\n      items: [\r\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\r\n  