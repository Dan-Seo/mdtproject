{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"npx tsx -e \\\"import { readFileSync } from 'node:fs'; import { recoverRows, verticalRuns } from './src/lib/import/runs.ts'; const dim=/\"'^(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]{2,})$/; for(const [file, target] of [['\"'hirosaki-p25.json',3400],['tsu-p21.json',600]]) { const f=JSON.parse(readFileSync('tests/fixtures/section-import/textitems/'+file,'utf8')); const toks=[]; for(const row of recoverRows(f.items)) for(const s of row.segments) toks.push({text:s.compact,x:s.centerX,y:s.centerY}); for(const v of verticalRuns(f.items)) toks.push({text:v.text,x:v.x,y:v.y}); const ds=toks.filter(t=>dim.test(t.text)).map(t=>({...t,value:Number(t.text.replaceAll(',',''))})); const cols=[]; for(const t of [...ds].sort((a,b)=>a.x-b.x||a.y-b.y)) { let c=cols.at(-1); if(c&&Math.abs(c[0].x-t.x)<=4)c.push(t);else cols.push([t]); } console.log('\\\\\\\\n'+file); for(const c of cols) if(c.some(t=>t.value===target)) console.log('x',c[0].x,c.map(t=>t.text+'@'+t.y.toFixed(4)).join(' | ')); }\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
