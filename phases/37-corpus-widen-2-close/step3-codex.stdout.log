{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$OutputEncoding = [Console]::OutputEncoding = [Text.Encoding]::UTF8\nWrite-Output '\"'--- corpus2-elevation.test.ts ---'\nGet-Content -Encoding UTF8 'tests/plan-import/corpus2-elevation.test.ts'\nWrite-Output '--- expected files ---'\nGet-Content -Raw -Encoding UTF8 'tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json'\nGet-Content -Raw -Encoding UTF8 'tests/fixtures/plan-import/expected/karatsu-jikugumi1-p1-elevation.json'\nGet-Content -Raw -Encoding UTF8 'tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json'\nWrite-Output '--- elevation source (focused with line numbers) ---'\n\"'$i=0; Get-Content -Encoding UTF8 '\"'src/lib/import/framing-plan/elevation.ts' | ForEach-Object { \"'$i++; if (($i -le 130) -or ($i -ge 250 -and $i -le 430)) { '\"'{0,4}: {1}' -f \"'$i,$_ } }\nWrite-Output '\"'--- types ---'\nGet-Content -Raw -Encoding UTF8 'src/lib/import/framing-plan/types.ts'\"","aggregated_output":"--- corpus2-elevation.test.ts ---\r\nimport { readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\ntype ElevationFixture = {\r\n  heightsMm?: number[]\r\n  elevations: Array<{\r\n    levels?: string[]\r\n    levelsBottom?: string[]\r\n    heightsMm?: number[]\r\n    heightsBottomMm?: number[]\r\n  }>\r\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readGolden(file: string): ElevationFixture {\r\n  return JSON.parse(\r\n    readFileSync(\r\n      resolve(process.cwd(), 'tests/fixtures/plan-import/expected', file),\r\n      'utf8',\r\n    ),\r\n  ) as ElevationFixture\r\n}\r\n\r\nfunction labelsFrom(\r\n  parsed: ReturnType<typeof parseFrameElevations>,\r\n  wanted: string[],\r\n): string[][] {\r\n  const wantedSet = new Set(wanted)\r\n  return parsed.elevations.map((elevation) =>\r\n    elevation.levels.flatMap((level) =>\r\n      level.labels.filter((label) => wantedSet.has(label)),\r\n    ),\r\n  )\r\n}\r\n\r\ndescribe('階高 corpus 2 골든', () => {\r\n  it('karatsu: 짧은 150mm 구간과 원문 레벨 라벨을 모든 공유 계열에서 보존한다', () => {\r\n    const golden = readGolden('karatsu-jikugumi1-p1-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('karatsu-jikugumi1-p1.json'))\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(2)\r\n    expect(parsed.elevations.map((entry) => entry.heightsMm)).toEqual(\r\n      parsed.elevations.map(() => golden.heightsMm),\r\n    )\r\n    expect(labelsFrom(parsed, ['RFL水上', '2FL', '1FL', 'GL'])).toEqual([\r\n      ['RFL水上', '2FL', '1FL', 'GL'],\r\n      ['RFL水上', '2FL', '1FL', 'GL'],\r\n    ])\r\n  })\r\n\r\n  it('tsu: 아래쪽 확정 구간 3500·150·1170을 연쇄 끝에서 보존한다', () => {\r\n    const golden = readGolden('tsu-kanritou-p21-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('tsu-p21.json'))\r\n    const expectedHeights = golden.elevations[0]?.heightsBottomMm\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(2)\r\n    expect(\r\n      parsed.elevations.map((entry) => entry.heightsMm.slice(-3)),\r\n    ).toEqual([expectedHeights, expectedHeights])\r\n    expect(labelsFrom(parsed, ['2FL', '1FL', '設計GL', '基礎下端'])).toEqual([\r\n      ['2FL', '1FL', '設計GL', '基礎下端'],\r\n      ['2FL', '1FL', '設計GL', '基礎下端'],\r\n    ])\r\n  })\r\n\r\n  it('hirosaki: 100mm 레벨과 그 아래 2310mm 구간을 각 계열에 보존한다', () => {\r\n    const golden = readGolden('hirosaki-kikyono-p25-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('hirosaki-p25.json'))\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(3)\r\n    expect(parsed.elevations.map((entry) => entry.heightsMm)).toEqual([\r\n      golden.elevations[0]?.heightsMm,\r\n      golden.elevations[0]?.heightsMm,\r\n      golden.elevations[1]?.heightsMm,\r\n    ])\r\n    expect(\r\n      labelsFrom(parsed, [\r\n        'RFL',\r\n        'PHFL',\r\n        '3FL',\r\n        '2FL',\r\n        '1FL',\r\n        '設計GL',\r\n        '△基礎下端',\r\n      ]),\r\n    ).toEqual([\r\n      ['RFL', 'PHFL', '3FL', '2FL', '1FL', '設計GL', '△基礎下端'],\r\n      ['RFL', 'PHFL', '3FL', '2FL', '1FL', '設計GL', '△基礎下端'],\r\n      ['PHFL', '3FL', '2FL', '1FL', '設計GL', '△基礎下端'],\r\n    ])\r\n  })\r\n})\r\n--- expected files ---\r\n{\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래.\",\n  \"source\": {\n    \"cacheFile\": \"dwg-hirosaki-kikyono.pdf\",\n    \"sha256\": \"f4dfcfab190970d8df305ce53319b98efb17873b81e77462b112a89978135fa8\",\n    \"issuer\": \"青森県弘前市\",\n    \"project\": \"令和7年度 桔梗野小学校等複合施設新築工事(建築工事) 構造図1\",\n    \"sheet\": \"S-023 軸組図(1)\",\n    \"page\": 25,\n    \"transcribedAt\": \"2026-09-03\"\n  },\n  \"elevations\": [\n    {\n      \"title\": \"X1通り\",\n      \"levels\": [\n        \"RFL\",\n        \"PHFL\",\n        \"3FL\",\n        \"2FL\",\n        \"1FL\",\n        \"設計GL\",\n        \"基礎下端\"\n      ],\n      \"heightsMm\": [\n        3400,\n        4000,\n        4000,\n        4500,\n        100,\n        2310\n      ],\n      \"axis\": {\n        \"labels\": [\n          \"Y1\",\n          \"Y2\",\n          \"Y3\",\n          \"Y4\",\n          \"Y5\",\n          \"Y6\",\n          \"Y7\"\n        ],\n        \"spansMm\": [\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          11000\n        ],\n        \"totalMm\": 51000\n      }\n    },\n    {\n      \"title\": \"X2通り\",\n      \"levels\": [\n        \"RFL\",\n        \"PHFL\",\n        \"3FL\",\n        \"2FL\",\n        \"1FL\",\n        \"設計GL\",\n        \"基礎下端\"\n      ],\n      \"heightsMm\": [\n        3400,\n        4000,\n        4000,\n        4500,\n        100,\n        2310\n      ],\n      \"axis\": {\n        \"labels\": [\n          \"Y1\",\n          \"Y2\",\n          \"Y3\",\n          \"Y4\",\n          \"Y5\",\n          \"Y6\",\n          \"Y7\",\n          \"Y8\",\n          \"Y9\",\n          \"Y10\"\n        ],\n        \"spansMm\": [\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          11000,\n          8000,\n          8000,\n          8000\n        ],\n        \"totalMm\": 75000\n      },\n      \"note\": \"2026-09-03 수정(Claude, phase 37): 초판(150dpi)은 X2通り의 RFL을 놓쳤다. 원시 TextItem에 RFL@(94,289)·PHFL@(96,321)이 있고 그 간격 32pt는 X1通り의 RFL→PHFL 32pt(3,400mm)와 같다. 그래서 X2도 RFL부터 6구간이다. X3通り는 PHFL@(96,557) 위에 RFL이 없다.\"\n    },\n    {\n      \"title\": \"X3通り\",\n      \"levels\": [\n        \"PHFL\",\n        \"3FL\",\n        \"2FL\",\n        \"1FL\",\n        \"設計GL\",\n        \"基礎下端\"\n      ],\n      \"heightsMm\": [\n        4000,\n        4000,\n        4500,\n        100,\n        2310\n      ],\n      \"axis\": {\n        \"labels\": [\n          \"Y1\",\n          \"Y2\",\n          \"Y3\",\n          \"Y4\",\n          \"Y5\",\n          \"Y6\",\n          \"Y7\",\n          \"Y8\",\n          \"Y9\",\n          \"Y10\"\n        ],\n        \"spansMm\": [\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          11000,\n          8000,\n          8000,\n          8000\n        ],\n        \"totalMm\": 75000\n      }\n    }\n  ],\n  \"notes\": [\n    \"GL→RFL 합계 16,000(X1通り), GL→PHFL 12,600(X2通り)가 별도로 적혀 있다\",\n    \"1FL은 設計GL의 100 위 — 1/100에서 2.8pt\",\n    \"Y10 바깥 2000·5,765 치수는 스팬이 아니다\"\n  ]\n}\n\r\n{\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래 순서의 인접 레벨 사이 mm다.\",\n  \"source\": {\n    \"cacheFile\": \"dwg-karatsu-jikugumi1.pdf\",\n    \"sha256\": \"88cc5a750569d6c4e2e3517b3553c25ad123fe4647504f9417a0ea72b9e87ac9\",\n    \"issuer\": \"一般社団法人唐津東松浦薬剤師会\",\n    \"project\": \"（仮称）救急・夜間対応会営薬局新築工事\",\n    \"sheet\": \"S-9 軸組図(1)\",\n    \"page\": 1,\n    \"transcribedAt\": \"2026-09-03\"\n  },\n  \"levels\": [\n    \"RFL\",\n    \"2FL\",\n    \"1FL\",\n    \"GL\"\n  ],\n  \"heightsMm\": [\n    3500,\n    3500,\n    150\n  ],\n  \"elevations\": [\n    {\n      \"title\": \"X2通り\",\n      \"axis\": {\n        \"labels\": [\n          \"Y0\",\n          \"Y1\",\n          \"Y2\",\n          \"Y3\"\n        ],\n        \"spansMm\": [\n          1900,\n          2265,\n          6000\n        ],\n        \"totalMm\": null\n      }\n    },\n    {\n      \"title\": \"X3通り\",\n      \"axis\": {\n        \"labels\": [\n          \"Y0\",\n          \"Y1\",\n          \"Y2\",\n          \"Y3\",\n          \"Y6\"\n        ],\n        \"spansMm\": [\n          1900,\n          2265,\n          6000,\n          8079\n        ],\n        \"totalMm\": null\n      }\n    },\n    {\n      \"title\": \"X4通り\",\n      \"axis\": {\n        \"labels\": [\n          \"Y0\",\n          \"Y1\",\n          \"Y2\",\n          \"Y3\",\n          \"Y5\"\n        ],\n        \"spansMm\": [\n          1900,\n          2265,\n          6000,\n          5875\n        ],\n        \"totalMm\": null\n      }\n    }\n  ],\n  \"notes\": [\n    \"네 블록 중 첫 블록(X1·D通り)은 Y축과 A/B/C축이 섞여 있어 미전사\",\n    \"1FL은 GL의 150 위다(基礎詳細図 S-4에도 같은 150) — 1/100 축척에서 4.25pt라 같은 자리로 읽힐 수 있다. 치수 열에 150이 적혀 있으므로 별 레벨이다\",\n    \"Y3→Y6 8,079 = 4,069+1,806+2,204, Y3→Y5 5,875 = 4,069+1,806 (基礎伏図와 정합)\",\n    \"제목의 정확한 원문 표기(「X2通り軸組図」 등)는 확정하지 못했다 — 通り 이름만 적었다. 페이지 /Rotate 90\"\n  ],\n  \"levelTexts\": [\n    \"RFL水上\",\n    \"2FL\",\n    \"1FL\",\n    \"GL\"\n  ],\n  \"levelNote\": \"2026-09-03 추기(Claude, phase 37): 도면의 지붕 레벨 문자열은 「RFL水上」(수상 = 물매 높은 쪽)이고 levels의 「RFL」은 그 레벨명이다. 테스트는 levelTexts로 원문 문자열을 엄격 대조한다. 원시 TextItem의 레벨 라벨 열은 셋 — x≈86〜100(y 84〜249, 4레벨), x≈111〜125(y 417〜582, 4레벨), x≈748(y 154〜249, 2FL·1FL·GL 3레벨 — 같은 X2通り 블록의 오른쪽 물매 낮은 쪽으로 보이며 RFL水下 문자열은 텍스트에 없다). X4通り(제목 (900,664)) 옆에는 레벨 라벨 열이 텍스트에 없다 — 파서가 X4 계열을 못 내면 골든 어긋남으로 보고해야지 골든을 두 계열로 읽어선 안 된다.\"\n}\n\r\n{\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래. 이 페이지는 아래쪽 레벨만 확정했다.\",\n  \"source\": {\n    \"cacheFile\": \"dwg-tsu-kanritou.pdf\",\n    \"sha256\": \"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\",\n    \"issuer\": \"三重県津市\",\n    \"project\": \"旧津市民プール跡地テニスコート整備工事 管理棟\",\n    \"sheet\": \"S-21 軸組図(1)\",\n    \"page\": 21,\n    \"transcribedAt\": \"2026-09-03\"\n  },\n  \"elevations\": [\n    {\n      \"title\": \"Y3通り軸組図 S=1/100\",\n      \"levelsBottom\": [\n        \"2FL\",\n        \"1FL\",\n        \"設計GL\",\n        \"基礎下端\"\n      ],\n      \"heightsBottomMm\": [\n        3500,\n        150,\n        1170\n      ],\n      \"axis\": {\n        \"labels\": [\n          \"X1\",\n          \"X2\",\n          \"X3\",\n          \"X4\"\n        ],\n        \"spansMm\": [\n          5850,\n          5150,\n          7175,\n          3825\n        ],\n        \"totalMm\": 22000\n      }\n    }\n  ],\n  \"notes\": [\n    \"2FL 위로 3,5xx 구간과 7,750 합계 치수가 더 있으나 최상단 레벨 라벨을 확정하지 못해 미전사 — 파서 결과의 아래 세 구간(3500·150·1170)만 대조한다\",\n    \"같은 열에 보조 레벨이 있다: 梁天端(水下) = 2FL−270, 1SL = 1FL와 같은 높이, 基礎梁天端·B.PL下端은 1FL 아래 20〜250\",\n    \"X1 왼쪽에 胴縁芯↔柱面 80 치수가 있다 — 스팬이 아니다. 용지 A1 /Rotate 90\"\n  ]\n}\n\r\n--- elevation source (focused with line numbers) ---\r\n   1: import { recoverRows, verticalRuns } from '../runs'\r\n   2: import type { TextPage } from '../section-list/types'\r\n   3: \r\n   4: import type {\r\n   5:   ElevationCandidate,\r\n   6:   ElevationIssue,\r\n   7:   ElevationLevel,\r\n   8:   ParsedFrameElevations,\r\n   9: } from './types'\r\n  10: \r\n  11: /**\r\n  12:  * 軸組図의 높이 방향을 텍스트 레이어만으로 복원한다 (ADR-030).\r\n  13:  *\r\n  14:  * 伏図와 달리 라벨 밴드를 앵커로 쓸 수 없다 — 실물 yokohama p8의 레벨 라벨은\r\n  15:  * 좌단 x가 108~198로 흩어지고 중심 x도 123~221로 흩어진다(글자 수에 따라\r\n  16:  * 들여쓰기가 달라진다). 대신 치수 열은 x가 한 값으로 곧게 선다.\r\n  17:  *\r\n  18:  * 그래서 앵커는 치수 열이고, 「치수는 자기가 재는 구간의 중점에 놓인다」는\r\n  19:  * 관계로 축척과 레벨 위치를 함께 푼다. 인접 두 치수 v0·v1의 간격은\r\n  20:  * (v0+v1)/2 × 축척이므로, 축척은 도면 표기를 믿지 않고 여기서 유도된다.\r\n  21:  */\r\n  22: \r\n  23: const DIMENSION_PATTERN = /^(?:\\d{1,3}(?:,\\d{3})+|\\d{2,})$/\r\n  24: const ELEVATION_TITLE_PATTERN = /軸組/\r\n  25: /** 치수 열로 보는 x 허용오차(pt). 실물 p8의 열은 x가 한 값으로 곧다 */\r\n  26: const COLUMN_TOLERANCE_PT = 4\r\n  27: /** 레벨 라벨과 푼 레벨 위치의 어긋남 허용(pt). 실물 최대 4.1pt */\r\n  28: const LEVEL_TOLERANCE_PT = 15\r\n  29: /**\r\n  30:  * 레벨 라벨을 찾는 가로 창(pt) — 치수 열 중심에서의 거리.\r\n  31:  *\r\n  32:  * **이 창이 계열의 검증 장치다.** 치수 두 개만으로는 축척을 유도할 수는 있어도\r\n  33:  * 대조할 수가 없다(유도한 축척이 자기 자신과 어긋날 수는 없다). 계열이 옳다는\r\n  34:  * 증거는 「푼 레벨 위치에 실제로 라벨이 서 있다」는 독립된 사실 하나뿐이고,\r\n  35:  * 창이 넓으면 그 증거가 가짜가 된다.\r\n  36:  *\r\n  37:  * 실물 kani p40에서 그 일이 일어났다 — 위·아래 두 軸組図의 **전체 치수**\r\n  38:  * 5,535 둘이 한 열로 이어져 축척이 3배로 나왔는데, 창이 150pt이던 동안에는\r\n  39:  * 128pt 떨어진 **通り芯 라벨 `Y1`**을 레벨 라벨로 주워 검증을 통과했다.\r\n  40:  *\r\n  41:  * 실측된 라벨 거리는 yokohama p8이 최대 62pt, kani p40이 최대 67pt다. 80은\r\n  42:  * 그 위이고 128 아래다. 더 벌어지는 도면은 빈 후보로 실패한다 (R10).\r\n  43:  */\r\n  44: const LABEL_WINDOW_PT = 80\r\n  45: /** 계열이 이어지는지 보는 축척 편차. 伏図 파서와 같은 값이다 */\r\n  46: const SCALE_TOLERANCE_RATIO = 0.03\r\n  47: /** 라벨이 붙은 레벨이 이보다 적으면 계열로 보지 않는다 — 부분 치수 열과의 유일한 구분 */\r\n  48: const MINIMUM_LABELLED_LEVELS = 2\r\n  49: /**\r\n  50:  * 짧은 구간은 치수 표기가 구간 중점에서 벗어나기 쉽다. 기존 연쇄가 충분히 길고,\r\n  51:  * 다음 치수가 앞선 값들의 중앙값보다 이 비율보다 작으면 그 치수를 연쇄에 보존한다.\r\n  52:  * 이는 규준값이 아니라 PDF 텍스트 배치 판정이다.\r\n  53:  */\r\n  54: const SHORT_DIMENSION_RATIO = 0.25\r\n  55: /**\r\n  56:  * 짧은 치수 뒤의 다음 숫자는 폭이 다른 치수 열에 놓일 수 있다. 기존 레벨 라벨\r\n  57:  * 창에서 유도한 범위 안에서만 열 이동을 허용한다 — 파일명별 x 좌표를 쓰지 않는다.\r\n  58:  */\r\n  59: const SHORT_TAIL_COLUMN_WINDOW_PT = LABEL_WINDOW_PT / 4\r\n  60: /** 짧은 치수의 텍스트 위치 편차를 허용하되, 가까운 잡음 치수는 거절한다. */\r\n  61: const SHORT_TAIL_SCALE_TOLERANCE_RATIO = 0.5\r\n  62: /**\r\n  63:  * 계열이 되려면 치수가 이만큼 있어야 한다.\r\n  64:  *\r\n  65:  * **둘로는 반증이 안 된다.** 치수 두 개는 축척을 하나 유도하는데, 유도한 값이\r\n  66:  * 자기 자신과 어긋날 수는 없으므로 축척 일관성 검사가 공회전한다. 그러면 남는\r\n  67:  * 증거는 라벨 일치뿐인데, 글자가 빽빽한 도면에서는 그것이 **우연히** 맞는다 —\r\n  68:  * 실물 kani p40에서 위·아래 두 軸組図의 같은 치수(5,535 둘, 75 둘)가 한 열로\r\n  69:  * 이어져 축척이 3배·220배로 나왔는데도 계산된 레벨 자리에 마침 글자가 있어\r\n  70:  * 두 번 다 통과했다.\r\n  71:  *\r\n  72:  * 셋이면 축척이 둘 유도되어 서로를 반증할 수 있고, 그 검사가 위 두 경우를\r\n  73:  * 모두 잡는다. 대가로 치수가 둘뿐인 軸組図(3레벨)는 읽지 않는다 — 지어내는\r\n  74:  * 것보다 낫다 (R10).\r\n  75:  */\r\n  76: const MINIMUM_CHAIN_DIMENSIONS = 3\r\n  77: \r\n  78: interface Token {\r\n  79:   text: string\r\n  80:   x: number\r\n  81:   y: number\r\n  82: }\r\n  83: \r\n  84: interface DimensionToken extends Token {\r\n  85:   valueMm: number\r\n  86: }\r\n  87: \r\n  88: function tokens(page: TextPage): Token[] {\r\n  89:   const collected: Token[] = []\r\n  90:   for (const row of recoverRows(page.items)) {\r\n  91:     for (const segment of row.segments) {\r\n  92:       collected.push({\r\n  93:         text: segment.compact,\r\n  94:         x: segment.centerX,\r\n  95:         y: segment.centerY,\r\n  96:       })\r\n  97:     }\r\n  98:   }\r\n  99:   for (const run of verticalRuns(page.items)) {\r\n 100:     collected.push({ text: run.text, x: run.x, y: run.y })\r\n 101:   }\r\n 102:   return collected\r\n 103: }\r\n 104: \r\n 105: function median(values: number[]): number {\r\n 106:   return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\r\n 107: }\r\n 108: \r\n 109: function dimensionScale(left: DimensionToken, right: DimensionToken): number {\r\n 110:   return (\r\n 111:     (2 * (right.y - left.y)) /\r\n 112:     (left.valueMm + right.valueMm)\r\n 113:   )\r\n 114: }\r\n 115: \r\n 116: function chainScales(chain: DimensionToken[]): number[] {\r\n 117:   return chain.slice(1).map((dimension, i) =>\r\n 118:     dimensionScale(chain[i], dimension),\r\n 119:   )\r\n 120: }\r\n 121: \r\n 122: function isShortDimension(\r\n 123:   dimension: DimensionToken,\r\n 124:   previous: DimensionToken[],\r\n 125: ): boolean {\r\n 126:   return (\r\n 127:     previous.length >= MINIMUM_CHAIN_DIMENSIONS &&\r\n 128:     dimension.valueMm < median(previous.map((entry) => entry.valueMm)) *\r\n 129:       SHORT_DIMENSION_RATIO\r\n 130:   )\r\n 250: ): Array<{ positionPt: number }> {\r\n 251:   const first = chain[0].y - (chain[0].valueMm * scale) / 2\r\n 252:   const positions = [first]\r\n 253:   for (const dimension of chain) {\r\n 254:     positions.push(positions[positions.length - 1] + dimension.valueMm * scale)\r\n 255:   }\r\n 256:   return positions.map((positionPt) => ({ positionPt }))\r\n 257: }\r\n 258: \r\n 259: function verticalExtent(elevation: ElevationCandidate): {\r\n 260:   top: number\r\n 261:   bottom: number\r\n 262: } {\r\n 263:   return {\r\n 264:     top: elevation.levels[0].positionPt,\r\n 265:     bottom: elevation.levels[elevation.levels.length - 1].positionPt,\r\n 266:   }\r\n 267: }\r\n 268: \r\n 269: /**\r\n 270:  * 세로 범위가 겹치는 계열은 **같은 구간의 서로 다른 읽기**다 — 실물 p8에서는\r\n 271:  * 階高 열(1400·4100·4480·2690) 옆에 部分 치수 열(190·150·2350)이 나란히 서고,\r\n 272:  * 그 부분 열도 근처 라벨 둘을 주워 계열의 조건을 만족한다. 둘 다 내면 사용자에게\r\n 273:  * 서로 어긋나는 階高가 동시에 보인다.\r\n 274:  *\r\n 275:  * 가장 넓게 읽은 것 하나만 남긴다. 階高 열은 軸組図의 높이 전체를 재고\r\n 276:  * 부분 열은 국소적이라, 세로 범위가 그 둘을 가장 크게 갈라 놓는다(실물에서\r\n 277:  * 359pt 대 38·52pt). 도면 형식이 이 전제를 깨면 계열이 하나 사라지고,\r\n 278:  * 값을 지어내는 대신 사용자가 손으로 넣는다 (R10).\r\n 279:  */\r\n 280: function withoutOverlaps(\r\n 281:   elevations: ElevationCandidate[],\r\n 282: ): ElevationCandidate[] {\r\n 283:   const ranked = [...elevations].sort((a, b) => {\r\n 284:     const left = verticalExtent(a)\r\n 285:     const right = verticalExtent(b)\r\n 286:     return (\r\n 287:       right.bottom - right.top - (left.bottom - left.top) ||\r\n 288:       b.levels.length - a.levels.length\r\n 289:     )\r\n 290:   })\r\n 291: \r\n 292:   const kept: ElevationCandidate[] = []\r\n 293:   for (const elevation of ranked) {\r\n 294:     const range = verticalExtent(elevation)\r\n 295:     const overlaps = kept.some((accepted) => {\r\n 296:       const other = verticalExtent(accepted)\r\n 297:       return range.top <= other.bottom && other.top <= range.bottom\r\n 298:     })\r\n 299:     if (!overlaps) kept.push(elevation)\r\n 300:   }\r\n 301: \r\n 302:   return kept\r\n 303: }\r\n 304: \r\n 305: export function parseFrameElevations(page: TextPage): ParsedFrameElevations {\r\n 306:   const collected = tokens(page)\r\n 307: \r\n 308:   const dimensions: DimensionToken[] = []\r\n 309:   const labels: Token[] = []\r\n 310:   const titles: Token[] = []\r\n 311:   for (const token of collected) {\r\n 312:     if (DIMENSION_PATTERN.test(token.text)) {\r\n 313:       dimensions.push({\r\n 314:         ...token,\r\n 315:         valueMm: Number.parseInt(token.text.replaceAll(',', ''), 10),\r\n 316:       })\r\n 317:       continue\r\n 318:     }\r\n 319:     if (ELEVATION_TITLE_PATTERN.test(token.text)) {\r\n 320:       titles.push(token)\r\n 321:       continue\r\n 322:     }\r\n 323:     labels.push(token)\r\n 324:   }\r\n 325: \r\n 326:   const elevations: ElevationCandidate[] = []\r\n 327:   for (const column of dimensionColumns(dimensions)) {\r\n 328:     for (const baseChain of chains(column)) {\r\n 329:       const chain = extendShortTail(baseChain, dimensions)\r\n 330:       const scales = chainScales(chain)\r\n 331:       const scale = median(scales)\r\n 332:       const positions = levelsOf(chain, scale)\r\n 333: \r\n 334:       // 라벨은 가장 가까운 레벨 하나에만 붙는다 — 층이 얕으면 허용 범위가\r\n 335:       // 겹치는데, 겹치는 만큼 양쪽에 싣으면 없는 라벨이 생긴다\r\n 336:       const levels: ElevationLevel[] = positions.map(({ positionPt }) => ({\r\n 337:         labels: [],\r\n 338:         positionPt,\r\n 339:       }))\r\n 340:       const labelsAtLevels: Token[][] = levels.map(() => [])\r\n 341:       for (const label of labels) {\r\n 342:         if (Math.abs(label.x - chain[0].x) > LABEL_WINDOW_PT) continue\r\n 343:         let nearest = -1\r\n 344:         let nearestDistance = Number.POSITIVE_INFINITY\r\n 345:         for (let i = 0; i < levels.length; i++) {\r\n 346:           const distance = Math.abs(levels[i].positionPt - label.y)\r\n 347:           if (distance < nearestDistance) {\r\n 348:             nearest = i\r\n 349:             nearestDistance = distance\r\n 350:           }\r\n 351:         }\r\n 352:         if (nearest < 0 || nearestDistance > LEVEL_TOLERANCE_PT) continue\r\n 353:         labelsAtLevels[nearest].push(label)\r\n 354:       }\r\n 355: \r\n 356:       // 짧은 치수가 실제로 적혀 있으면, 그 사이의 두 레벨을 같은 위치로 접지\r\n 357:       // 않는다. 치수 표기가 좁은 구간의 한쪽에 몰려 두 라벨이 앞 레벨에 함께\r\n 358:       // 붙는 경우에는, 도면의 위→아래 라벨 순서로 다음 레벨에 하나를 보낸다.\r\n 359:       for (let i = 0; i + 1 < chain.length; i++) {\r\n 360:         if (!isShortDimension(chain[i], chain.slice(0, i))) continue\r\n 361:         if (\r\n 362:           labelsAtLevels[i]?.length !== 2 ||\r\n 363:           labelsAtLevels[i + 1]?.length !== 0\r\n 364:         ) {\r\n 365:           continue\r\n 366:         }\r\n 367:         const ordered = [...(labelsAtLevels[i] ?? [])].sort(\r\n 368:           (left, right) => left.y - right.y || left.x - right.x,\r\n 369:         )\r\n 370:         const moved = ordered.pop()\r\n 371:         if (!moved) continue\r\n 372:         labelsAtLevels[i] = ordered\r\n 373:         labelsAtLevels[i + 1] = [moved]\r\n 374:       }\r\n 375: \r\n 376:       for (let i = 0; i < levels.length; i++) {\r\n 377:         levels[i].labels = (labelsAtLevels[i] ?? [])\r\n 378:           .sort((left, right) => left.y - right.y || left.x - right.x)\r\n 379:           .map((label) => label.text)\r\n 380:       }\r\n 381: \r\n 382:       const labelled = levels.filter((level) => level.labels.length > 0).length\r\n 383:       if (labelled < MINIMUM_LABELLED_LEVELS) continue\r\n 384: \r\n 385:       elevations.push({\r\n 386:         titles: [],\r\n 387:         levels,\r\n 388:         heightsMm: chain.map((dimension) => dimension.valueMm),\r\n 389:         scalePtPerMm: scale,\r\n 390:       })\r\n 391:     }\r\n 392:   }\r\n 393: \r\n 394:   const overlapFree = withoutOverlaps(elevations)\r\n 395:   overlapFree.sort((a, b) => a.levels[0].positionPt - b.levels[0].positionPt)\r\n 396: \r\n 397:   // 제목은 계열에 붙인다 — 한 계열이 여러 通り의 軸組図에 공통으로 걸리므로\r\n 398:   // (실물 p8은 좌단 치수 열 하나에 bY1·bY2·bY3 세 장) 1:1이 아니다.\r\n 399:   //\r\n 400:   // 단순 최근접이 아니라 **제목 위에 있는 계열을 우선한다.** 軸組図의 캡션은\r\n 401:   // 그림 아래에 적히는데(실물 p8의 6장 전부), 위 그림의 캡션은 위 그림의 하단과\r\n 402:   // 아래 그림의 상단에서 거의 같은 거리에 놓인다(p8 실측 170.4pt 대 167.7pt) —\r\n 403:   // 단순 최근접은 이 칼끝에서 갈리고, 실제로 VerticalRun.y 규약 정정(−w/2)이\r\n 404:   // 그 판정을 뒤집어 위 계열이 제목 0장으로 사라졌다. 위에 계열이 하나도 없을\r\n 405:   // 때만(캡션이 그림 위에 있는 형식) 아래에서 최근접을 찾는다.\r\n 406:   for (const title of titles) {\r\n 407:     let above: ElevationCandidate | undefined\r\n 408:     let aboveDistance = Number.POSITIVE_INFINITY\r\n 409:     let below: ElevationCandidate | undefined\r\n 410:     let belowDistance = Number.POSITIVE_INFINITY\r\n 411:     for (const elevation of overlapFree) {\r\n 412:       const top = elevation.levels[0].positionPt\r\n 413:       const bottom = elevation.levels[elevation.levels.length - 1].positionPt\r\n 414:       if (title.y >= top) {\r\n 415:         const distance = title.y > bottom ? title.y - bottom : 0\r\n 416:         if (distance < aboveDistance) {\r\n 417:           above = elevation\r\n 418:           aboveDistance = distance\r\n 419:         }\r\n 420:       } else {\r\n 421:         const distance = top - title.y\r\n 422:         if (distance < belowDistance) {\r\n 423:           below = elevation\r\n 424:           belowDistance = distance\r\n 425:         }\r\n 426:       }\r\n 427:     }\r\n 428:     ;(above ?? below)?.titles.push(title.text)\r\n 429:   }\r\n 430: \r\n--- types ---\r\n/**\r\n * 셀을 빈칸으로 남긴 사유 코드 (section-list의 CANDIDATE_ISSUES 패턴).\r\n * 파서는 코드만 싣고 표시부가 번역한다.\r\n */\r\nexport const PLAN_GRID_ISSUES = [\r\n  '通り芯ラベル未検出',\r\n  '寸法欠落',\r\n  '縮尺不整合',\r\n  '合計不一致',\n  '寸法列曖昧',\n  'ラベル文字混在',\n  '通り芯対応不明',\r\n] as const\r\n\r\nexport type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\n\r\n/** 伏図에서 읽은 通り芯 한 본. positionPt는 도면 좌표(pt) — 부재 스냅의 기준. */\r\nexport interface AxisCandidate {\r\n  label: string\r\n  positionPt: number\r\n}\r\n\r\n/** 한 방향(X 또는 Y)의 通り芯 열 후보. 승인 전에는 형상이 되지 않는다 (ADR-030). */\r\nexport interface PlanGridCandidate {\r\n  /** 라벨의 축 문자 — 밴드의 기하 방향이 아니라 도면이 붙인 이름을 따른다 */\r\n  direction: 'X' | 'Y'\r\n  /** 위치 오름차순 */\r\n  axes: AxisCandidate[]\r\n  /** 인접 축 사이 치수(mm). 길이는 axes.length - 1 */\r\n  spansMm: number[]\r\n  /** 실측 축척(pt/mm) — 전 스팬 실측의 중앙값. 표기 축척은 용지 의존이라 믿지 않는다 */\r\n  scalePtPerMm: number\r\n  /** 도면에 전체 치수가 명기돼 있고 스팬 합과 일치했다 */\r\n  totalConfirmed: boolean\r\n}\r\n\r\n/**\r\n * 부호가 그리드의 어디에 놓였는가 — 도면에서 잰 **기하**만 말한다.\r\n *\r\n * 「C면 柱」처럼 부호 접두로 부재 종별을 정하지 않는다. 종별은 断面リスト가\r\n * 이미 갖고 있으므로(ADR-018), 취입이 그 종별과 이 기하를 맞춰 본다 —\r\n * 어긋나면 사람이 판단할 일이지 파서가 고를 일이 아니다.\r\n */\r\nexport const PLAN_PLACEMENT_ROLES = ['格子点', '辺', 'ベイ'] as const\r\n\r\nexport type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\r\n\r\nexport type MemberPlacement =\r\n  | { mark: string; role: '格子点' | 'ベイ'; ix: number; iy: number }\r\n  | {\r\n      mark: string\r\n      role: '辺'\r\n      /** 부재가 시작하는 격자점 */\r\n      ix: number\r\n      iy: number\r\n      /** 부재가 뻗는 방향 (GirderPosition.axis와 같은 뜻) */\r\n      axis: 'X' | 'Y'\r\n    }\r\n\r\n/**\r\n * 도면 위의 伏図 한 장. 한 페이지에 여러 장이 실리므로(실물 yokohama p7은\r\n * 2階床伏図와 R階床伏図 두 장) 通り芯 정의가 같아도 **위치가 다르다** —\r\n * 그리드 정의는 접히지만 블록은 접히지 않는다.\r\n */\r\nexport interface PlanBlock {\r\n  /** 블록 제목 원문(「2階床伏図1/100」). 어느 Story인지는 사람이 정한다 */\r\n  title?: string\r\n  /** 이 블록과 짝지어진 X·Y 通り芯 정의. 취입은 반드시 이 둘을 쓴다 */\r\n  xGrid: PlanGridCandidate\r\n  yGrid: PlanGridCandidate\r\n  placements: MemberPlacement[]\r\n  /** 블록 안에 있으나 스냅하지 못한 부호(중복 없음, 원문 순) — 지어내지 않는다 */\r\n  unplacedMarks: string[]\r\n}\r\n\r\nexport interface ParsedFramingPlan {\r\n  /** 通り芯 정의 — 같은 그리드가 여러 블록에 반복되면 하나로 접힌다 */\r\n  grids: PlanGridCandidate[]\r\n  blocks: PlanBlock[]\r\n  /** 후보를 못 낸 사유 — 첫 등장 순, 중복 없음 */\r\n  issues: PlanGridIssue[]\r\n}\r\n\r\n/** 軸組図에서 계열을 못 낸 사유. 파서는 코드만 싣고 표시부가 번역한다 */\r\nexport const ELEVATION_ISSUES = ['寸法列未検出'] as const\r\n\r\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\r\n\r\nexport interface ElevationLevel {\r\n  /** 그 높이에 적힌 라벨 원문 전부. 없으면 빈 배열 — 지어내지 않는다 */\r\n  labels: string[]\r\n  positionPt: number\r\n}\r\n\r\n/**\r\n * 軸組図 한 계열의 높이 방향 읽기. 「어느 레벨이 Story의 경계인가」는 정하지\r\n * 않는다 — 원문에는 FL·GL·基礎下端·RCL이 섞여 있고, 그중 무엇이 階인지는\r\n * 조문이 아니라 설계 의도라 사람이 읽을 일이다 (ADR-030).\r\n *\r\n * 通り芯과 달리 라벨의 좌우 정렬이 일정하지 않아(실물 p8의 좌단 x는 108~198로\r\n * 흩어진다) 라벨 밴드를 앵커로 쓸 수 없다. 앵커는 **치수 열**이고, 치수가 자기\r\n * 구간의 중점에 놓인다는 관계로 축척과 레벨 위치를 함께 푼다.\r\n */\r\nexport interface ElevationCandidate {\r\n  /** 이 계열이 걸리는 軸組図 제목들(원문). 한 계열이 여러 通り에 공통으로 걸린다 */\r\n  titles: string[]\r\n  /** 도면 좌표 순 — 위에서 아래로 */\r\n  levels: ElevationLevel[]\r\n  /** 인접 레벨 사이 치수(mm). 길이는 levels.length - 1 */\r\n  heightsMm: number[]\r\n  scalePtPerMm: number\r\n}\r\n\r\nexport interface ParsedFrameElevations {\r\n  elevations: ElevationCandidate[]\r\n  issues: ElevationIssue[]\r\n}\r\n\r\n/** 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\nexport const PLAN_APPLY_REFUSALS = [\r\n  '階未指定',\r\n  '他階部材あり通り芯変更不可',\r\n] as const\r\n\r\nexport type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\r\n\r\n/** 부호 하나를 넣지 못한 사유. 지어내는 대신 이 코드로 남긴다 */\r\nexport const PLAN_APPLY_SKIPS = [\r\n  '断面未登録',\r\n  '部材種別相違',\r\n  '格子外',\r\n  '断面複数該当',\r\n] as const\r\n\r\nexport type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\r\n\r\n/** 階高 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\nexport const ELEVATION_APPLY_REFUSALS = [\r\n  '階範囲不正',\r\n  '部材あり階置換不可',\r\n] as const\r\n\r\nexport type ElevationApplyRefusal =\r\n  (typeof ELEVATION_APPLY_REFUSALS)[number]\r\n\r\n","exit_code":0,"status":"completed"}}
