d(3)),y:Number(item.y.toFixed(3))}))\n  }));\n}\nconst ojkkRows = rows('tests/fixtures/section-import/textitems/ojkk-p4.json');\nconsole.log('ojkk rows near targets:');\nconsole.log(JSON.stringify(ojkkRows.filter((row) => [58,182,188,196,204,210,256,438,444,452,458,466].some((y) => Math.abs(row.y-y)<=2)), null, 2));\nconst expected = read('tests/fixtures/section-import/expected/ojkk-akamichi-p4-walls-slabs.json');\nconsole.log('expected target lists:');\nconsole.log(JSON.stringify(expected.lists.filter((list) => ['小梁リスト','片持梁リスト'].includes(list.listKind)), null, 2));\n'@ | node\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
