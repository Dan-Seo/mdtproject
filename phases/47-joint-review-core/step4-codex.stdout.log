ason: StaleReason): void {\r\n  if (reasons.some(({ kind, memberId }) => kind === reason.kind && memberId === reason.memberId)) return\r\n  reasons.push(reason)\r\n}\r\n\r\nexport function fingerprintReasons(\r\n  before: ReviewFingerprints,\r\n  after: ReviewFingerprints,\r\n  memberIds: string[],\r\n  finding: boolean,\r\n): StaleReason[] {\r\n  const reasons: StaleReason[] = []\r\n  const targetIds = unique(memberIds)\r\n  const comparedIds = new Set(targetIds)\r\n\r\n  for (const memberId of comparedIds) {\r\n    const oldMember = before.members[memberId]\r\n    const newMember = after.members[memberId]\r\n    if (!oldMember || !newMember) {\r\n      addReason(reasons, { kind: '野얕괌鸚됪쎍', memberId, detail: `野얕괌?ⓩ쓲 ${memberId} ???恙쒌걣鸚됪쎍?뺛굦?╉걚?얇걲` })\r\n      continue\r\n    }\r\n    if (oldMember.input !== newMember.input) {\r\n      addReason(reasons, { kind: '?ε뒟鸚됪쎍', memberId, detail: `?ε뒟?뚦쨯?담걬?뚣겍?꾠겲?? ${memberId}` })\r\n    }\r\n    if (oldMember.result !== newMember.result) {\r\n      addReason(reasons, { kind: '永먩옖鸚됪쎍', memberId, detail: `嶸쀥눣永먩옖?뚦쨯?담걬?뚣겍?꾠겲?? ${memberId}` })\r\n    }\r\n    if ((oldMember.result === null) !== (newMember.result === null)) {\r\n      addReason(reasons, { kind: '野얍퓶?뜻뀑鸚됪쎍', memberId, detail: `野얍퓶?뜻뀑?뚦쨯?담걬?뚣겍?꾠겲?? ${memberId}` })\r\n    }\r\n  }\r\n  if (targetIds.length === 0) {\r\n    addReason(reasons, { kind: '野얕괌?ゃ걮', detail: '濾쒑쮱野얕괌??깿?먦걣?귙굤?얇걵?? })\r\n  }\r\n  if (before.rulepack !== after.rulepack && targetIds.length > 0) {\r\n    addReason(reasons, { kind: '?방떊鸚됪쎍', detail: '?ャ꺖?ャ깙?껁궚?뚦쨯?담걬?뚣겍?꾠겲?? })\r\n  }\r\n  if (finding && before.checkVersion !== after.checkVersion) {\r\n    addReason(reasons, { kind: '濾쒏읅?덂쨯??, detail: '濾쒏읅?덀걣鸚됪쎍?뺛굦?╉걚?얇걲' })\r\n  }\r\n  if (finding && before.checkConditions !== after.checkConditions) {\r\n    addReason(reasons, { kind: '濾쒏읅?▽뻑鸚됪쎍', detail: '濾쒏읅?▽뻑?뚦쨯?담걬?뚣겍?꾠겲?? })\r\n  }\r\n  return reasons\r\n}\r\n\r\nexport function itemValidity(item: ReviewItem, current: CurrentModel): ReviewValidity {\r\n  const targets = itemTargetMemberIds(item, current.project)\r\n  const reasons: StaleReason[] = []\r\n  const targetIds = [...Object.keys(item.snapshot.fingerprints.members), ...targets.memberIds]\r\n  if (targets.missing.length > 0 || targets.unresolved.length > 0) {\r\n    addReason(reasons, {\r\n      kind: '野얕괌?ゃ걮',\r\n      detail: `野얕괌?믦㎗黎뷩겎?띲겲?쎼굯: ${[...targets.missing, ...targets.unresolved].map((ref) => ref.kind).join('??)}`,\r\n    })\r\n  }\r\n  for (const reason of fingerprintReasons(\r\n    item.snapshot.fingerprints,\r\n    current.fingerprints,\r\n    targetIds,\r\n    item.finding !== undefined,\r\n  )) addReason(reasons, reason)\r\n\r\n  if (current.impact !== null) {\r\n    for (const memberId of targets.memberIds) {\r\n      const impact = current.impact.members.find(({ memberId: id }) => id === memberId)\r\n      if (impact?.path.includes('id 鸚됪쎍??룾?썸???野얍퓶誤곭▶沃?)) {\r\n        addReason(reasons, {\r\n          kind: '野얍퓶誤곭▶沃?,\r\n          memberId,\r\n          detail: `id 鸚됪쎍??룾?썸???野얍퓶誤곭▶沃? ${memberId}`,\r\n        })\r\n      }\r\n    }\r\n  }\r\n  if (targets.memberIds.length === 0) {\r\n    addReason(reasons, { kind: '野얕괌?ゃ걮', detail: '濾쒑쮱野얕괌??깿?먦걣?귙굤?얇걵?? })\r\n  }\r\n\r\n  return reasons.length === 0 ? { state: '?됧듅' } : { state: '?띷쩂鼇롥퓚誤?, reasons }\r\n}\r\n\r\nexport type EffectiveItemStatus = ReviewHumanStatus | '?띷쩂鼇롥퓚誤?\r\n\r\nexport function effectiveItemStatus(item: ReviewItem, validity: ReviewValidity): EffectiveItemStatus {\r\n  return validity.state === '?띷쩂鼇롥퓚誤? ? validity.state : item.status\r\n}\r\n\r\nexport function itemsNeedingRecheck(items: ReviewItem[], current: CurrentModel): ReviewItem[] {\r\n  return items.filter((item) => itemValidity(item, current).state === '?띷쩂鼇롥퓚誤?)\r\n}\r\nimport type { Project } from '../model/project'\r\nimport { canonicalJson } from './fingerprint'\r\nimport {\r\n  elementRefTargets,\r\n  fingerprintReasons,\r\n  itemValidity,\r\n  type CurrentModel,\r\n} from './validity'\r\nimport type {\r\n  ChecklistEntry,\r\n  ElementRef,\r\n  ReviewItem,\r\n  WorkPackage,\r\n} from './types'\r\n\r\nexport type ReadinessState = '繹뽩굺?ゅ츑' | '繹뽩굺若뚥틙' | '繹뽩굺若뚥틙竊덁풃鸚뽧걗?딉펹'\r\nexport type BlockerKind = '?띲깴?뉎꺂??쩂鼇롢걣餘뗣겂?╉걚?? | '恙낂젅??㈂榮경깄?긱걣?ゅ뀯?? | '閻븃첀鼇섌뙯?뚣겒?? | '??ｉ쟿??걣?ょ▶沃? | '??ｃ걲?뗦쩂鼇롩쟿??걣?ゃ걚' | '?ゅ뀯?? | '?ㅶ뼪訝띶룾' | '?녺뵳??겒?꾡퓷?? | '?끻퐪?끾쑋?ε뒟' | '野얕괌?ⓩ쓲?ゃ걮'\r\n\r\nexport interface Blocker {\r\n  entryId: string | null\r\n  kind: BlockerKind\r\n  detail: string\r\n}\r\n\r\nexport interface Exception {\r\n  entryId: string\r\n  kind: '岳앯븰' | '?ㅵ쨼'\r\n  reason: string\r\n}\r\n\r\nexport interface PackageReadiness {\r\n  state: ReadinessState\r\n  blockers: Blocker[]\r\n  exceptions: Exception[]\r\n  memberIds: string[]\r\n  missingTargets: ElementRef[]\r\n}\r\n\r\nfunction addMissing(targets: ElementRef[], additions: ElementRef[]): void {\r\n  for (const target of additions) {\r\n    if (!targets.some((candidate) => canonicalJson(candidate) === canonicalJson(target))) targets.push(target)\r\n  }\r\n}\r\n\r\nfunction addBlocker(blockers: Blocker[], blocker: Blocker): void {\r\n  if (!blockers.some(({ entryId, kind, detail }) => entryId === blocker.entryId && kind === blocker.kind && detail === blocker.detail)) blockers.push(blocker)\r\n}\r\n\r\nfunction confirmationIsCurrent(\r\n  entry: ChecklistEntry,\r\n  pkg: WorkPackage,\r\n  project: Project,\r\n  current: CurrentModel,\r\n): boolean {\r\n  if (!entry.confirmation) return false\r\n  const targets = elementRefTargets(pkg.targets, project)\r\n  if (targets.memberIds.length === 0 || targets.missing.length > 0 || targets.unresolved.length > 0) return false\r\n  return fingerprintReasons(\r\n    entry.confirmation.fingerprints,\r\n    current.fingerprints,\r\n    targets.memberIds,\r\n    false,\r\n  ).length === 0 && targets.memberIds.every((memberId) => {\r\n    const before = entry.confirmation!.fingerprints.members[memberId]\r\n    const after = current.fingerprints.members[memberId]\r\n    return before !== undefined && after !== undefined && canonicalJson(before) === canonicalJson(after)\r\n  })\r\n}\r\n\r\nexport function packageReadiness(\r\n  pkg: WorkPackage,\r\n  items: ReviewItem[],\r\n  current: CurrentModel,\r\n): PackageReadiness {\r\n  const blockers: Blocker[] = []\r\n  const exceptions: Exception[] = []\r\n  const memberIds: string[] = []\r\n  const missingTargets: ElementRef[] = []\r\n  const itemById = new Map(items.map((item) => [item.id, item]))\r\n\r\n  const packageTargets = elementRefTargets(pkg.targets, current.project)\r\n  memberIds.push(...packageTargets.memberIds)\r\n  addMissing(missingTargets, [...packageTargets.missing, ...packageTargets.unresolved])\r\n  if (missingTargets.length > 0) {\r\n    addBlocker(blockers, { entryId: null, kind: '野얕괌?ⓩ쓲?ゃ걮', detail: '?묆긿?긱꺖?멥겗野얕괌?ⓩ쓲?뚣걗?듽겲?쎼굯' })\r\n  }\r\n  if (pkg.assignee.trim() === '') addBlocker(blockers, { entryId: null, kind: '?끻퐪?끾쑋?ε뒟', detail: '?끻퐪?끹굮?ε뒟?쀣겍?뤵걽?뺛걚' })\r\n\r\n  for (const entry of pkg.checklist) {\r\n    if (!entry.required) continue\r\n    if (entry.status === '?ゅ뀯?? || entry.status === '?ょ▶沃?) {\r\n      addBlocker(blockers, { entryId: entry.id, kind: '?ゅ뀯??, detail: `${entry.label} ?뚧쑋?ε뒟?㎯걲` })\r\n      continue\r\n    }\r\n    if (entry.status === '岳앯븰' || entry.status === '?ㅵ쨼') {\r\n      if (entry.reason && entry.reason.trim() !== '') {\r\n        exceptions.push({ entryId: entry.id, kind: entry.status, reason: entry.reason })\r\n      } else {\r\n        addBlocker(blockers, { entryId: entry.id, kind: '?녺뵳??겒?꾡퓷??, detail: `${entry.label} ??퓷?쇻꺕?ㅵ쨼?녺뵳?뚣걗?듽겲?쎼굯` })\r\n      }\r\n      continue\r\n    }\r\n    if (entry.status !== '閻븃첀歷?) continue\r\n\r\n    if (entry.reviewItemIds.length > 0) {\r\n      for (const reviewItemId of entry.reviewItemIds) {\r\n        const item = itemById.get(reviewItemId)\r\n        if (!item) {\r\n          addBlocker(blockers, { entryId: entry.id, kind: '??ｃ걲?뗦쩂鼇롩쟿??걣?ゃ걚', detail: `${entry.label}: ${reviewItemId} ?뚣걗?듽겲?쎼굯` })\r\n          continue\r\n        }\r\n        if (itemValidity(item, current).state === '?띷쩂鼇롥퓚誤?) {\r\n          addBlocker(blockers, { entryId: entry.id, kind: '?띲깴?뉎꺂??쩂鼇롢걣餘뗣겂?╉걚??, detail: `${entry.label}: ${reviewItemId} ?믣냽濾쒑쮱?쀣겍?뤵걽?뺛걚` })\r\n        }\r\n        if (item.status === '?ょ▶沃? || item.status === '岳앯븰') {\r\n          addBlocker(blockers, { entryId: entry.id, kind: '??ｉ쟿??걣?ょ▶沃?, detail: `${entry.label}: ${reviewItemId} ?뚧쑋閻븃첀?㎯걲` })\r\n        }\r\n        if (item.status === '?ㅶ뼪訝띶룾') {\r\n          addBlocker(blockers, { entryId: entry.id, kind: '恙낂젅??㈂榮경깄?긱걣?ゅ뀯??, detail: `${entry.label}: ${reviewItemId} ??㈂榮경깄?긱걣恙낁쫨?㎯걲` })\r\n        }\r\n      }\r\n    } else if (!entry.confirmation) {\r\n      addBlocker(blockers, { entryId: entry.id, kind: '閻븃첀鼇섌뙯?뚣겒??, detail: `${entry.label} ??▶沃띹쮼?꿔걣?귙굤?얇걵?? })\r\n    } else if (!confirmationIsCurrent(entry, pkg, current.project, current)) {\r\n      addBlocker(blockers, { entryId: entry.id, kind: '?띲깴?뉎꺂??쩂鼇롢걣餘뗣겂?╉걚??, detail: `${entry.label} ??▶沃띶풄?ャ깴?뉎꺂?뚦쨯?담걬?뚣겍?꾠겲?? })\r\n    }\r\n  }\r\n\r\n  const state: ReadinessState = blockers.length > 0\r\n    ? '繹뽩굺?ゅ츑'\r\n    : exceptions.length > 0\r\n      ? '繹뽩굺若뚥틙竊덁풃鸚뽧걗?딉펹'\r\n      : '繹뽩굺若뚥틙'\r\n  return { state, blockers, exceptions, memberIds: [...new Set(memberIds)], missingTargets }\r\n}\r\n","exit_code":0,"status":"completed"}}
