.members)\r\n 289:   for (const member of current.members) {\r\n 290:     const old = before.get(member.id)\r\n 291:     if (old && canonicalJson(memberGridSpans(baseline, old)) !== canonicalJson(memberGridSpans(current, member))) {\r\n 292:       ids.add(member.id)\r\n 293:     }\r\n 294:   }\r\n 295:   return ids\r\n 296: }\r\n 297: \r\n 298: export function assessImpact(baseline: TakeoffSnapshot, current: TakeoffSnapshot): ImpactReport {\r\n 299:   const entities: EntityChange[] = []\r\n 300:   const baselineMembers = mapById(baseline.project.members)\r\n 301:   const currentMembers = mapById(current.project.members)\r\n 302:   const replacementPairs = new Map<string, string>()\r\n 303:   const usedCurrentIds = new Set<string>()\r\n 304:   const addedIds = [...currentMembers.keys()].filter((id) => !baselineMembers.has(id))\r\n 305:   const removedIds = [...baselineMembers.keys()].filter((id) => !currentMembers.has(id))\r\n 306: \r\n 307:   for (const removedId of removedIds) {\r\n 308:     const oldMember = baselineMembers.get(removedId)!\r\n 309:     const candidates = addedIds.filter((addedId) => {\r\n 310:       if (usedCurrentIds.has(addedId)) return false\r\n 311:       return samePosition(oldMember, currentMembers.get(addedId)!)\r\n 312:     })\r\n 313:     if (candidates.length === 1) {\r\n 314:       replacementPairs.set(removedId, candidates[0])\r\n 315:       usedCurrentIds.add(candidates[0])\r\n 316:     }\r\n 317:   }\r\n 318: \r\n 319:   for (const [id, member] of currentMembers) {\r\n 320:     const old = baselineMembers.get(id)\r\n 321:     if (!old) {\r\n 322:       if ([...replacementPairs.values()].includes(id)) {\r\n 323:         entities.push({ kind: 'member', change: '対応要確認', memberId: id, detail: `${id} id 変更の可能性` })\r\n 324:       } else {\r\n 325:         entities.push({ kind: 'member', change: '追加', memberId: id, detail: `${id} 追加` })\r\n 326:       }\r\n 327:       continue\r\n 328:     }\r\n 329:     const changed = changedFields(old, member, MEMBER_FIELDS)\r\n 330:     if (changed.length > 0) {\r\n 331:       entities.push({ kind: 'member', change: '変更', memberId: id, fields: changed, detail: `${id} ${changed.join('・')} 변경` })\r\n 332:     }\r\n 333:   }\r\n 334:   for (const id of baselineMembers.keys()) {\r\n 335:     if (currentMembers.has(id)) continue\r\n 336:     if (replacementPairs.has(id)) {\r\n 337:       entities.push({ kind: 'member', change: '対応要確認', memberId: id, detail: `${id} id 変更の可能性` })\r\n 338:     } else {\r\n 339:       entities.push({ kind: 'member', change: '削除', memberId: id, detail: `${id} 削除` })\r\n 340:     }\r\n 341:   }\r\n 342: \r\n 343:   const sectionFields = ['kind', 'mark', 'storyLabel', 'shape', 'b', 'd', 'depth', 'thickness', 'fc', 'grade', 'exposure', 'finish', 'spliceMethod', 'main', 'hoop', 'stirrup', 'widthTie', 'sideBar', 'layers', 'vertical', 'horizontal', 'x', 'y']\r\n 344:   const storyFields = ['name', 'height']\r\n 345:   entities.push(...changedRecordEntities('section', baseline.project.sections, current.project.sections, sectionFields))\r\n   1: import { describe, expect, it } from 'vitest'\r\n   2: \r\n   3: import { assessImpact } from './impact'\r\n   4: import {\r\n   5:   cloneProject,\r\n   6:   reviewSnapshot,\r\n   7:   sampleProject,\r\n   8: } from '../../../tests/fixtures/review/snapshot'\r\n   9: \r\n  10: function changeSectionB() {\r\n  11:   const project = cloneProject(sampleProject())\r\n  12:   project.sections = project.sections.map((section) =>\r\n  13:     section.id === 'section-C1' && section.kind === '柱'\r\n  14:       ? { ...section, b: 900 }\r\n  15:       : section,\r\n  16:   )\r\n  17:   return project\r\n  18: }\r\n  19: \r\n  20: function changeG2Pitch() {\r\n  21:   const project = cloneProject(sampleProject())\r\n  22:   project.sections = project.sections.map((section) =>\r\n  23:     section.id === 'section-G2' && section.kind === '大梁'\r\n  24:       ? { ...section, stirrup: { ...section.stirrup, pitch: 200 } }\r\n  25:       : section,\r\n  26:   )\r\n  27:   return project\r\n  28: }\r\n  29: \r\n  30: describe('review impact', () => {\r\n  31:   it('propagates a support-column shape change through the read field only', () => {\r\n  32:     const baseline = reviewSnapshot(sampleProject())\r\n  33:     const current = reviewSnapshot(changeSectionB())\r\n  34:     const report = assessImpact(baseline, current)\r\n  35:     const impacted = new Map(report.members.map((member) => [member.memberId, member]))\r\n  36: \r\n  37:     expect(report.entities).toContainEqual(expect.objectContaining({\r\n  38:       kind: 'section',\r\n  39:       change: '変更',\r\n  40:       sectionId: 'section-C1',\r\n  41:       fields: expect.arrayContaining(['b']),\r\n  42:     }))\r\n  43:     expect(impacted.get('1F-X1Y1')?.categories).toContain('入力')\r\n  44:     expect(impacted.get('1F-G1-X1Y1-X')?.path.join(' ')).toContain('支持柱')\r\n  45:     expect(impacted.get('1F-G1-X1Y1-X')?.categories).toEqual(\r\n  46:       expect.arrayContaining(['入力', '形状', '数量']),\r\n  47:     )\r\n  48:     expect(impacted.get('1F-X1Y1')?.support).toEqual({ before: '対応', after: '対応' })\r\n  49:     expect(impacted.has('1F-S1-X1Y1')).toBe(false)\r\n  50:   })\r\n  51: \r\n  52:   it('does not propagate a girder stirrup pitch change to columns or other girders', () => {\r\n  53:     const report = assessImpact(\r\n  54:       reviewSnapshot(sampleProject()),\r\n  55:       reviewSnapshot(changeG2Pitch()),\r\n  56:     )\r\n  57:     const impacted = new Set(report.members.map(({ memberId }) => memberId))\r\n  58: \r\n  59:     expect(impacted).toContain('1F-G2-X1Y2-X')\r\n  60:     expect(impacted).not.toContain('1F-G1-X1Y1-X')\r\n  61:     expect(impacted).not.toContain('1F-X1Y1')\r\n  62:     expect(impacted).not.toContain('2F-X1Y1')\r\n  63:   })\r\n  64: \r\n  65:   it('keeps display-only changes out of model and quantity impact', () => {\r\n  66:     const current = cloneProject(sampleProject())\r\n  67:     current.name = '案件名変更'\r\n  68:     current.notes = { 'line-1': '備考変更' }\r\n  69:     current.grid = {\r\n  70:       ...current.grid,\r\n  71:       xLabels: ['X1', 'X2'],\r\n  72:       yLabels: ['Y1', 'Y2', 'Y3'],\r\n  73:     }\r\n  74: \r\n  75:     const report = assessImpact(reviewSnapshot(sampleProject()), reviewSnapshot(current))\r\n  76:     expect(report.members).toEqual([])\r\n  77:     expect(report.lines).toEqual([])\r\n  78:     expect(report.displayOnly).toHaveLength(3)\r\n  79:     expect(report.displayOnly.map((entry) => entry.kind)).toEqual([\r\n  80:       'displayOnly',\r\n  81:       'displayOnly',\r\n  82:       'displayOnly',\r\n  83:     ])\r\n  84:   })\r\n  85: \r\n  86:   it('reports unit-mass null to calculated as a state transition, never zero', () => {\r\n  87:     const current = cloneProject(sampleProject())\r\n  88:     current.unitMass = { D13: 0.995 }\r\n  89:     const report = assessImpact(reviewSnapshot(sampleProject()), reviewSnapshot(current))\r\n  90:     const changedMass = report.lines.find((line) => line.mass?.beforeKg === null)\r\n  91: \r\n  92:     expect(report.members).toEqual([])\r\n  93:     expect(report.entities).toContainEqual(expect.objectContaining({\r\n  94:       kind: 'unitMass',\r\n  95:       sizes: ['D13'],\r\n  96:     }))\r\n  97:     expect(changedMass?.mass).toEqual(expect.objectContaining({\r\n  98:       before: '単位質量未入力',\r\n  99:       after: '算出',\r\n 100:       beforeKg: null,\r\n 101:       afterKg: expect.any(Number),\r\n 102:     }))\r\n 103:     expect(changedMass?.mass?.beforeKg).not.toBe(0)\r\n 104:   })\r\n 105: \r\n 106:   it('uses対応要確認 for an id replacement at the same location', () => {\r\n 107:     const baselineProject = sampleProject()\r\n 108:     const currentProject = cloneProject(baselineProject)\r\n 109:     currentProject.members = currentProject.members.map((member) =>\r\n 110:       member.id === '1F-X1Y1' ? { ...member, id: '1F-X1Y1-renamed' } : member,\r\n 111:     )\r\n 112: \r\n 113:     const report = assessImpact(\r\n 114:       reviewSnapshot(baselineProject),\r\n 115:       reviewSnapshot(currentProject),\r\n 116:     )\r\n 117:     const replacement = report.entities.filter(\r\n 118:       (entry) => entry.kind === 'member' && entry.change === '対応要確認',\r\n 119:     )\r\n 120: \r\n 121:     expect(replacement.map((entry) => entry.kind === 'member' ? entry.memberId : '')).toEqual(\r\n 122:       expect.arrayContaining(['1F-X1Y1', '1F-X1Y1-renamed']),\r\n 123:     )\r\n 124:     expect(replacement).toHaveLength(2)\r\n 125:     expect(report.members.find(({ memberId }) => memberId === '1F-X1Y1-renamed')?.path).toContain(\r\n 126:       'id 変更の可能性 — 対応要確認',\r\n 127:     )\r\n 128:   })\r\n 129: \r\n 130:   it('records unsupported-to-supported transitions as対応状態', () => {\r\n 131:     const baselineProject = cloneProject(sampleProject())\r\n 132:     baselineProject.members = baselineProject.members.filter(\r\n 133:       ({ id }) => id !== '1F-X2Y1',\r\n 134:     )\r\n 135:     const report = assessImpact(\r\n 136:       reviewSnapshot(baselineProject),\r\n 137:       reviewSnapshot(sampleProject()),\r\n 138:     )\r\n 139:     const column = report.members.find(({ memberId }) => memberId === '1F-G1-X1Y1-X')\r\n 140: \r\n 141:     expect(column?.categories).toContain('対応状態')\r\n 142:     expect(column?.support).toEqual({ before: '未対応', after: '対応' })\r\n 143:   })\r\n 144: \r\n 145:   it('puts a rulepack change on every current member', () => {\r\n 146:     const baseline = reviewSnapshot(sampleProject())\r\n 147:     const current = reviewSnapshot(sampleProject())\r\n 148:     current.fingerprints = { ...current.fingerprints, rulepack: 'changed-rulepack' }\r\n 149:     const report = assessImpact(baseline, current)\r\n 150: \r\n 151:     expect(report.rulepackChanged).toBe(true)\r\n 152:     expect(report.members).toHaveLength(current.project.members.length)\r\n 153:     expect(report.members.every(({ categories }) => categories.includes('根拠'))).toBe(true)\r\n 154:   })\r\n 155: \r\n 156:   it('marks untracked wall result changes without inventing an input dependency path', () => {\r\n 157:     const current = cloneProject(sampleProject())\r\n 158:     current.sections = current.sections.map((section) =>\r\n 159:       section.id === 'section-W1' && section.kind === '耐震壁'\r\n 160:         ? { ...section, layers: 1 }\r\n 161:         : section,\r\n 162:     )\r\n 163:     const report = assessImpact(reviewSnapshot(sampleProject()), reviewSnapshot(current))\r\n 164:     const wall = report.members.find(({ memberId }) => memberId === '1F-W1-X1Y1-Y')\r\n 165: \r\n 166:     expect(wall?.categories).toEqual(expect.arrayContaining(['形状', '数量']))\r\n 167:     expect(wall?.path).toContain('依存経路未追跡 — 結果差分で検出')\r\n 168:   })\r\n 169: \r\n 170:   it('ends a propagated input-only path with結果は不変', () => {\r\n 171:     const current = cloneProject(sampleProject())\r\n 172:     current.sections = current.sections.map((section) =>\r\n 173:       section.id === 'section-C1' && section.kind === '柱'\r\n 174:         ? { ...section, storyLabel: '1階' }\r\n 175:         : section,\r\n 176:     )\r\n 177:     const report = assessImpact(reviewSnapshot(sampleProject()), reviewSnapshot(current))\r\n 178:     const column = report.members.find(({ memberId }) => memberId === '1F-X1Y1')\r\n 179: \r\n 180:     expect(column?.categories).toEqual(['入力'])\r\n 181:     expect(column?.path).toContain('結果は不変')\r\n 182:   })\r\n 183: })\r\n","exit_code":0,"status":"completed"}}
