{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/lib/hooks/useProjectPersistence.ts -Raw'","aggregated_output":"'use client'\r\n\r\nimport { useEffect, useState } from 'react'\r\n\r\nimport {\r\n  createAutosave,\r\n  loadStoredProject,\r\n} from '@/lib/persist/indexeddb'\r\nimport { useAppStore } from '@/lib/store'\r\n\r\nexport interface ProjectPersistence {\r\n  /** 孃⒴뀇??닩若싥걣歷덀굯?졼걢?귝툑??얇겎?ゅ땿岳앭춼??쭓?곥겒?꾠?*/\r\n  restored: boolean\r\n}\r\n\r\n/**\r\n * ?띹Ø永뚩러 (docs/UX.md 짠4 餘들쉸5)?귛뎺?욁겗旅덁뻑??IndexedDB ?뗣굢?삠걮?곦빳孃뚣겗\r\n * 渶③썓?믦눎?뺜퓷耶섅걲?뗣귚퓷耶섅겘?뽧꺀?╉궣??릎?졼걨?㎯곥궢?쇈깘?멥겘?뷩겒??(ADR-006)??\n */\r\nexport function useProjectPersistence(): ProjectPersistence {\r\n  const [restored, setRestored] = useState(false)\r\n\r\n  useEffect(() => {\r\n    let cancelled = false\r\n    let unsubscribe: (() => void) | null = null\r\n    let flushOnLeave: (() => void) | null = null\r\n    let flushOnHide: (() => void) | null = null\r\n\r\n    void loadStoredProject().then((stored) => {\r\n      if (cancelled) return\r\n\r\n      // 沃?겳渦쇈겳??씆?뚧쐿?졼귙걹??뼋?ユ돀?잆굦?잆궩?ャ굮孃⒴뀇?뚥툓?멥걤?쇻굥?ⓦ?\n      // ?⑴뵪?끹걢?됭쫳?뚣겙?ε뒟?뚧텋?덀굥?귝뎸?ㅳ걢?싥겗?ⓦ걤?졼걨藥?걮?욍걟?뗣?\n      const untouched =\r\n        useAppStore.getState().project === useAppStore.getInitialState().project\r\n      try {\r\n        if (stored !== null && untouched) {\r\n          useAppStore.getState().loadProject(stored)\r\n        }\r\n      } catch {\r\n        // ?귞뀱?뉎굦??deserializeProject ?뚦늾??(?볝걪?ャ겘?γ겒???귝츐?뗣겗??\n        // loadProject ?や퐪?뚧뒘?믡굥?닷릦?졼걨?????얇걝??겘?곩쑴?껁겗鸚길븮??\n        // ?ゅ땿岳앭춼?믧걪?ｃ굦?ャ걲?뗣겏餓ε풄??랬?녴걣容쇻겂?╊퓷耶섅걬?뚣겒?뤵겒?뗣걢?됥겎??\n        // ?뚦숱??싥겂?잆걣訝?벴?뚦즸?뚣걼鼇섌뙯?띲굮閭㏂굙?뗣겗??걪?볝겎??겒?꾠?\n      }\r\n\r\n      const autosave = createAutosave()\r\n      unsubscribe = useAppStore.subscribe(({ project }, previous) => {\r\n        if (project !== previous.project) autosave(project)\r\n      })\r\n      // 沃?겳渦쇈겳?믣푷?ㅹ뼋?ユ돀?잆굦?잏랬?녴겘蘊쇠き?덀굤?띲겒??겎?곦?佯╉걽?묆겒??\n      // ?멥걢?뚣겒?꾠겲?얏텋?덀굥?붻낵沃?겘?뚦쨯?뽧띲겎?쀣걢?븀겓?쀣겒?꾠귙걪?볝겎?얇걝??\n      if (!untouched) autosave(useAppStore.getState().project)\r\n      // ?볝걾永귙굩?ｃ겍 500ms 餓ε냵?ラ뻾?섅굢?뚣굥?ⓨ푷艅잋릎??쎑?띹씔?욍걣易덀걟?뗣?\n      // ?잆걽??flush ??IndexedDB ?믧뼀?띸쎍?쇻겗?㎯걈agehide ?얇겎孃끹겇??\n      // ?곥걣鶯듽걬?뚣굥永뚩러?㎯겘 open ??transaction ?귞탞?뤵굢?ゃ걚 ???얇걽\r\n      // ?욃릪?잆걣鼇긱걬?뚣굥 visibilitychange(hidden) ?㎩뀍?ュ눣?쇻굋agehide ??\n      // bfcache ?ュ뀯?뗦셽?귝씎?뗣겗?㎯곲슑?뚣걼孃뚣겗訝?볝굮?얇걝岳앶쇇?졼?\n      flushOnLeave = () => autosave.flush()\r\n      flushOnHide = () => {\r\n        if (document.visibilityState === 'hidden') autosave.flush()\r\n      }\r\n      window.addEventListener('pagehide', flushOnLeave)\r\n      document.addEventListener('visibilitychange', flushOnHide)\r\n      setRestored(true)\r\n    })\r\n\r\n    return () => {\r\n      cancelled = true\r\n      unsubscribe?.()\r\n      if (flushOnLeave) window.removeEventListener('pagehide', flushOnLeave)\r\n      if (flushOnHide) {\r\n        document.removeEventListener('visibilitychange', flushOnHide)\r\n      }\r\n    }\r\n  }, [])\r\n\r\n  return { restored }\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
