{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/lib/store.ts -Raw'","aggregated_output":"'use client'\r\n\r\nimport { create } from 'zustand'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport {\r\n  memberGroupKey,\r\n  type Project,\r\n} from '@/domain/model/project'\r\n\r\nexport interface Selection {\r\n  group: string | null\r\n  memberId: string | null\r\n}\r\n\r\nexport type Locale = 'ja' | 'ko'\r\n\r\n/** 3D ?섏씤???섏씤-濡쒖뺄 ??(DESIGN.md 짠7): ?ⓩ쓲 = ?좏깮 遺??1媛? 兩븀돥 = ??遺??*/\r\nexport type ViewerMode = 'member' | 'building'\r\n\r\nexport type ViewerLayer = 'main' | 'hoop' | 'concrete'\r\n\r\nexport interface AppState {\r\n  project: Project\r\n  sel: Selection\r\n  hoverRowId: string | null\r\n  locale: Locale\r\n  activeStoryId: string\r\n  viewerMode: ViewerMode\r\n  viewerLayers: Record<ViewerLayer, boolean>\r\n  selectMember(memberId: string): void\r\n  selectGroup(groupId: string, memberId: string): void\r\n  setHoverRow(rowId: string | null): void\r\n  setLocale(locale: Locale): void\r\n  setActiveStory(storyId: string): void\r\n  setViewerMode(mode: ViewerMode): void\r\n  toggleViewerLayer(layer: ViewerLayer): void\r\n  updateProject(updater: (project: Project) => Project): void\r\n  loadProject(project: Project): void\r\n}\r\n\r\nfunction findMember(project: Project, memberId: string) {\r\n  const member = project.members.find(({ id }) => id === memberId)\r\n\r\n  if (!member) {\r\n    throw new Error(`Member not found: ${memberId}`)\r\n  }\r\n\r\n  return member\r\n}\r\n\r\nconst initialProject = createSampleProject()\r\n\r\n/**\r\n * 泥??붾㈃?먯꽌 3D ?섏씤??鍮꾩뼱 ?덉? ?딅룄濡?????깅? 誘몃━ ?좏깮?쒕떎 (docs/UX.md 짠4.1).\r\n */\r\nfunction initialSelection(project: Project): Selection {\r\n  const member = project.members.find(({ kind }) => kind === '??)\r\n  if (!member) return { group: null, memberId: null }\r\n\r\n  return { group: memberGroupKey(project, member), memberId: member.id }\r\n}\r\n\r\nconst initialSel = initialSelection(initialProject)\r\n\r\n/** ?멩뒢?뚧뙁?숅깿?먦겗?롢귝뙁?숅깿?먦걣?▲걨?뚣겙??앫겗?롢겓?삠걲??*/\r\nfunction storyOf(project: Project, selection: Selection): string {\r\n  return (\r\n    project.members.find(({ id }) => id === selection.memberId)?.storyId ??\r\n    project.stories[0].id\r\n  )\r\n}\r\n\r\nexport const useAppStore = create<AppState>((set) => ({\r\n  project: initialProject,\r\n  sel: initialSel,\r\n  hoverRowId: null,\r\n  locale: 'ja',\r\n  activeStoryId: storyOf(initialProject, initialSel),\r\n  viewerMode: 'member',\r\n  viewerLayers: { main: true, hoop: true, concrete: true },\r\n  selectMember(memberId) {\r\n    set(({ project }) => {\r\n      const member = findMember(project, memberId)\r\n      return {\r\n        sel: {\r\n          group: memberGroupKey(project, member),\r\n          memberId: member.id,\r\n        },\r\n        activeStoryId: member.storyId,\r\n      }\r\n    })\r\n  },\r\n  selectGroup(groupId, memberId) {\r\n    set(({ project }) => {\r\n      const member = findMember(project, memberId)\r\n      return {\r\n        sel: { group: groupId, memberId: member.id },\r\n        activeStoryId: member.storyId,\r\n      }\r\n    })\r\n  },\r\n  setHoverRow(rowId) {\r\n    set({ hoverRowId: rowId })\r\n  },\r\n  setLocale(locale) {\r\n    set({ locale })\r\n  },\r\n  setActiveStory(storyId) {\r\n    set({ activeStoryId: storyId })\r\n  },\r\n  setViewerMode(mode) {\r\n    set({ viewerMode: mode })\r\n  },\r\n  toggleViewerLayer(layer) {\r\n    set(({ viewerLayers }) => ({\r\n      viewerLayers: {\r\n        ...viewerLayers,\r\n        [layer]: !viewerLayers[layer],\r\n      },\r\n    }))\r\n  },\r\n  updateProject(updater) {\r\n    set(({ project }) => ({ project: updater(project) }))\r\n  },\r\n  /**\r\n   * 旅덁뻑?얇굥?붵겏??량?쀦쎘?덌펷?ゅ땿岳앭춼?뗣굢??쑴?껁꺕JSON ?뽧굤渦쇈겳竊됥?\n   * updateProject ?③걬?ｃ겍?멩뒢?믤똻?↑텏?쎼겒?????뽧굤渦쇈굯?졿죭餓뜰겓?띲겗旅덁뻑??\n   * ?ⓩ쓲 id ??꽒?뤵??싥궎?녈걣耶섇쑉?쀣겒?꾦깿?먦굮?뉎걮?잆겲?얇겓?ゃ굥??\n   */\r\n  loadProject(project) {\r\n    const sel = initialSelection(project)\r\n\r\n    set({\r\n      project,\r\n      sel,\r\n      hoverRowId: null,\r\n      activeStoryId: storyOf(project, sel),\r\n    })\r\n  },\r\n}))\r\n\r\n// R4 ?깅뒫 痢≪젙 ?섎꽕??dev-browser)媛 ?ㅽ넗?댁뿉 ??⑸웾 Project瑜?二쇱엯??諛⑸쾿??\n// ?꾩슂?섎떎. ?꾨㈃ ?곗씠?곌? ???꾩껜 ?곹깭???꾨줈?뺤뀡 鍮뚮뱶?먮뒗 ?몄텧?섏? ?딅뒗??\r\nif (typeof window !== 'undefined' && process.env.NODE_ENV !== 'production') {\r\n  ;(window as Window & { __kijunStore?: typeof useAppStore }).__kijunStore =\r\n    useAppStore\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/components/ProjectActions.tsx -Raw; Get-Content src/lib/persist/file.test.ts -Raw; Get-Content src/lib/persist/indexeddb.test.ts -Raw'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/components/ProjectActions.tsx -Raw; Get-Content src/lib/persist/file.test.ts -Raw; Get-Content src/lib/persist/indexeddb.test.ts -Raw'","aggregated_output":"'use client'\r\n\r\nimport { useId, useState, type ChangeEvent } from 'react'\r\n\r\nimport { t } from '@/lib/i18n'\r\nimport { downloadProjectJson, readProjectFile } from '@/lib/persist/file'\r\nimport { useAppStore } from '@/lib/store'\r\nimport { capture, captureException } from '@/lib/telemetry'\r\n\r\nimport styles from './ProjectActions.module.css'\r\n\r\n/**\r\n * 旅덁뻑??퓷耶섅꺕沃?겳渦쇈겳 (docs/UX.md 짠4 餘들쉸5)?귟눎?뺜퓷耶?(useProjectPersistence)\r\n * ??깣?⒲궑?뜰굮瓮ⓦ걩?ゃ걚??겎?곦퍟??ク?ャ겦歷▲걲?볝걣?볝걪?ャ겒?뗣귙깢?▲궎?ャ겘?⑴뵪?끹겗\r\n * ?뗥뀇?졼걨?㎬き?욘쎑?띲걮?곥궢?쇈깘?멥겘?뷩겒??(ADR-006)??\n */\r\nexport function ProjectActions() {\r\n  const project = useAppStore(({ project }) => project)\r\n  const loadProject = useAppStore(({ loadProject }) => loadProject)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const [failed, setFailed] = useState(false)\r\n  const inputId = useId()\r\n\r\n  const chooseFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n    const file = event.target.files?.[0]\r\n    // ?뚣걯?뺛궊?ㅳ꺂?믧겦?녕쎍?쀣겍??change ?뚦눣?뗣굠?녴겓?ㅳ굮令뷩겓?삠걲??\n    event.target.value = ''\r\n    if (!file) return\r\n\r\n    try {\r\n      loadProject(await readProjectFile(file))\r\n      setFailed(false)\r\n      capture('project_imported', { locale })\r\n    } catch (error) {\r\n      // 容쇻겂??ㅁ?쀣걲?뗣겏?뚩き?욤씔?볝걽??겓鵝뺛굚鸚됥굩?됥겒?꾠띲겏?쀣걢誤뗣걟?ゃ걚??\n      // 餓딃뼀?꾠겍?꾠굥旅덁뻑??걹??겲?얏츐?쇻?\n      setFailed(true)\r\n      captureException(error, { stage: 'project_import' })\r\n      capture('project_import_failed', { locale })\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.projectActions}>\r\n      <button\r\n        type=\"button\"\r\n        className={styles.actionButton}\r\n        onClick={() => {\r\n          downloadProjectJson(project)\r\n          capture('project_exported', { locale })\r\n        }}\r\n      >\r\n        {t(locale, 'project.save')}\r\n      </button>\r\n      <label className={styles.actionButton} htmlFor={inputId}>\r\n        {t(locale, 'project.load')}\r\n      </label>\r\n      <input\r\n        id={inputId}\r\n        type=\"file\"\r\n        accept=\"application/json,.json\"\r\n        className={styles.fileInput}\r\n        onChange={chooseFile}\r\n      />\r\n      {failed ? (\r\n        <span role=\"alert\" className={styles.failure}>\r\n          {t(locale, 'project.loadFailed')}\r\n        </span>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n\r\nimport { describe, expect, it, vi } from 'vitest'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport {\r\n  PROJECT_SCHEMA_VERSION,\r\n  serializeProject,\r\n  type Project,\r\n} from '@/domain/model/project'\r\n\r\nimport { downloadProjectJson, projectFileName, readProjectFile } from './file'\r\n\r\nfunction projectFile(contents: string, name = 'x.json'): File {\r\n  return new File([contents], name, { type: 'application/json' })\r\n}\r\n\r\ndescribe('projectFileName', () => {\r\n  it('names the file after the 旅덁뻑', () => {\r\n    expect(projectFileName('壅ㅹ걪弱뤷????밭칹')).toBe('壅ㅹ걪弱뤷????밭칹.json')\r\n  })\r\n\r\n  it('strips characters the OS refuses in a filename', () => {\r\n    // 旅덁뻑?띲겘?ょ뵳?ε뒟?졼? ??: ?뚣걹??겲?얍뀯?뗣겏岳앭춼?ュㅁ?쀣걲?뗣걢??\n    // ?뽧꺀?╉궣?뚦떇?뗣겓?ε릫?믢퍡?묆겍?⑴뵪?끹겗餓섅걨?잌릫?띲걣易덀걟?뗣?\n    expect(projectFileName('A/B:C*D?E\"F<G>H|I')).toBe('ABCDEFGHI.json')\r\n  })\r\n\r\n  it('does not leave the gap where a stripped character was', () => {\r\n    // ?듐꺍?쀣꺂旅덁뻑?띲겗???띲걣?앫겗?얇겲?쒌걨?뗣겏?똀  B?띲겏令븀쇋?뚥틠?ㅶ츐?뗣?\n    expect(projectFileName('?듐꺍?쀣꺂旅덁뻑 / RC 2?롥뻠??)).toBe(\r\n      '?듐꺍?쀣꺂旅덁뻑 RC 2?롥뻠??json',\r\n    )\r\n  })\r\n\r\n  it('falls back when nothing usable is left', () => {\r\n    expect(projectFileName('   ')).toBe('kijun-project.json')\r\n    expect(projectFileName('///')).toBe('kijun-project.json')\r\n  })\r\n})\r\n\r\ndescribe('readProjectFile', () => {\r\n  it('reads back a project written by the exporter', async () => {\r\n    const project = { ...createSampleProject(), name: '孃孃⒲깇?밤깉' }\r\n\r\n    await expect(\r\n      readProjectFile(projectFile(serializeProject(project))),\r\n    ).resolves.toEqual(project)\r\n  })\r\n\r\n  it('rejects a file saved under an older schema', async () => {\r\n    const stale = serializeProject({\r\n      ...createSampleProject(),\r\n      schemaVersion: PROJECT_SCHEMA_VERSION - 1,\r\n    } as Project)\r\n\r\n    await expect(readProjectFile(projectFile(stale))).rejects.toThrow(\r\n      /schemaVersion/,\r\n    )\r\n  })\r\n\r\n  it('rejects a file that is not JSON at all', async () => {\r\n    // ?뽧굤渦쇈겳??닶?②끹걣?멥굯?졼깢?▲궎?ャ겎冶뗣겲?뗣귟き?곥겒?꾠굚??굮容쇻겂??\n    // ?쀣걨?γ굦?뗣겏?곥궢?녈깤?ユ죭餓뜰걣易덀걟?잆굠?녴겓?쀣걢誤뗣걟?ゃ걚??\n    await expect(readProjectFile(projectFile('not json'))).rejects.toThrow()\r\n  })\r\n})\r\n\r\ndescribe('downloadProjectJson', () => {\r\n  it('hands the browser a JSON blob named after the 旅덁뻑', async () => {\r\n    const project = { ...createSampleProject(), name: '岳앭춼?녴궧?? }\r\n    let blob: Blob | undefined\r\n    let filename: string | undefined\r\n    const createObjectURL = vi.fn((value: Blob) => {\r\n      blob = value\r\n      return 'blob:kijun-test'\r\n    })\r\n\r\n    Object.defineProperty(URL, 'createObjectURL', {\r\n      configurable: true,\r\n      value: createObjectURL,\r\n    })\r\n    Object.defineProperty(URL, 'revokeObjectURL', {\r\n      configurable: true,\r\n      value: vi.fn(),\r\n    })\r\n    const click = vi\r\n      .spyOn(HTMLAnchorElement.prototype, 'click')\r\n      .mockImplementation(function (this: HTMLAnchorElement) {\r\n        filename = this.download\r\n      })\r\n\r\n    try {\r\n      downloadProjectJson(project)\r\n    } finally {\r\n      click.mockRestore()\r\n      Reflect.deleteProperty(URL, 'createObjectURL')\r\n      Reflect.deleteProperty(URL, 'revokeObjectURL')\r\n    }\r\n\r\n    expect(filename).toBe('岳앭춼?녴궧??json')\r\n    expect(blob?.type).toBe('application/json')\r\n    await expect(readProjectFile(projectFile(await blob!.text()))).resolves.toEqual(\r\n      project,\r\n    )\r\n  })\r\n})\r\n\r\nimport 'fake-indexeddb/auto'\r\n\r\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport { PROJECT_SCHEMA_VERSION, type Project } from '@/domain/model/project'\r\n\r\nimport {\r\n  AUTOSAVE_DEBOUNCE_MS,\r\n  clearStoredProject,\r\n  createAutosave,\r\n  loadStoredProject,\r\n  saveProject,\r\n} from './indexeddb'\r\n\r\nasync function reset(): Promise<void> {\r\n  await clearStoredProject()\r\n}\r\n\r\nfunction deleteStore(): Promise<void> {\r\n  return new Promise((resolve) => {\r\n    const request = indexedDB.deleteDatabase('kijun')\r\n    request.onsuccess = () => resolve()\r\n    request.onerror = () => resolve()\r\n    request.onblocked = () => resolve()\r\n  })\r\n}\r\n\r\nbeforeEach(reset)\r\nafterEach(reset)\r\n\r\ndescribe('IndexedDB ?멥겗?ゅ땿岳앭춼', () => {\r\n  it('restores the project that was saved last', async () => {\r\n    const project = { ...createSampleProject(), name: '?띹Ø?녴궧?? }\r\n\r\n    await saveProject(project)\r\n\r\n    expect(await loadStoredProject()).toEqual(project)\r\n  })\r\n\r\n  it('has nothing to restore on a first visit', async () => {\r\n    expect(await loadStoredProject()).toBeNull()\r\n  })\r\n\r\n  it('drops a project stored under an older schema instead of loading it', async () => {\r\n    // ?㎫뎵??JSON ?믡걹??겲?얕き??ⓦ곭꽒?꾢퓚?덀깢?ｃ꺖?ャ깋??undefined ??겲??\n    // 鼇덄츞?ユ륫?쇻걪?ⓦ겓?ゃ굥?귙궢?녈깤?ユ죭餓뜰겎壅룟땿?쀧쎍?숁뼶?뚦츎?ⓦ걽??\n    const project = createSampleProject()\r\n    await saveProject({\r\n      ...project,\r\n      schemaVersion: PROJECT_SCHEMA_VERSION - 1,\r\n    } as Project)\r\n\r\n    expect(await loadStoredProject()).toBeNull()\r\n  })\r\n\r\n  it('closes the connection when the transaction cannot be created', async () => {\r\n    // ?밤깉?㏂겗?▲걚 v1 DB ??onupgradeneeded ?믢퍡?묆걳?ラ뼀?꾠걼?녈꺖?됥걣鵝쒌굥\r\n    // (tests/e2e ??춮?멥걤?뚣걪??숱?㏝뼀???괺atabase.transaction() ??걹?볝겎\r\n    // ?뚧쐿?ユ뒘?믡굥??\n    await deleteStore()\r\n    await new Promise<void>((resolve, reject) => {\r\n      const request = indexedDB.open('kijun', 1)\r\n      request.onerror = () => reject(request.error)\r\n      request.onsuccess = () => {\r\n        request.result.close()\r\n        resolve()\r\n      }\r\n    })\r\n\r\n    const close = vi.spyOn(IDBDatabase.prototype, 'close')\r\n    try {\r\n      await expect(saveProject(createSampleProject())).rejects.toThrow()\r\n      // ?됥걯?싥겓 reject ?쇻굥?ⓦ곥걹??렏泳싥걣?쇈겞?뷩걮??빊?졼걨餘뗣굥 ??\n      // 餓ε풄??눎?뺜퓷耶섅겘麗면걽?ュㅁ?쀣걮?곭뎵?믢툓?믡굥?ⓦ걤 onblocked ?㎪??얇굥??\n      expect(close).toHaveBeenCalled()\r\n    } finally {\r\n      close.mockRestore()\r\n      await deleteStore()\r\n    }\r\n  })\r\n\r\n  it('survives a corrupted record without throwing at start-up', async () => {\r\n    // 岳앭춼訝?겓?욍깣?뚩맼?▲굦?곈붶릎?얇겎?멥걢?뚣걼?뉐춻?쀣걣餘뗣굤?녴굥?귟돈?뺟탪瓮?겎\r\n    // ?뺛걩?뗣겏?곫텋?숁뎸塋뗣겍??겒?꾠겲?양뵽?㏂걣?잆겂?썬겓?ゃ굥??\n    await saveProject(createSampleProject())\r\n    const corrupted = new Promise<void>((resolve, reject) => {\r\n      const request = indexedDB.open('kijun', 1)\r\n      request.onerror = () => reject(request.error)\r\n      request.onsuccess = () => {\r\n        const transaction = request.result.transaction('project', 'readwrite')\r\n        transaction.objectStore('project').put('{ not json', 'current')\r\n        transaction.oncomplete = () => {\r\n          request.result.close()\r\n          resolve()\r\n        }\r\n        transaction.onerror = () => reject(transaction.error)\r\n      }\r\n    })\r\n    await corrupted\r\n\r\n    expect(await loadStoredProject()).toBeNull()\r\n  })\r\n})\r\n\r\ndescribe('createAutosave', () => {\r\n  beforeEach(() => {\r\n    vi.useFakeTimers()\r\n  })\r\n\r\n  afterEach(() => {\r\n    vi.useRealTimers()\r\n  })\r\n\r\n  it('writes once for a burst of edits', async () => {\r\n    // ??씊訝誤㎯겘?삠꺂?믤돀?ㅳ걼?녈겓 Project ?믣량?쀦쎘?덀굥???볣뜷1?멥걤渦쇈겳?졼겏\r\n    // ?ε뒟訝?걳?ｃ겏 IndexedDB ?믣룴?띸텥?묆굥?볝겏?ャ겒?뗣?\n    const written: Project[] = []\r\n    const autosave = createAutosave(async (project) => {\r\n      written.push(project)\r\n    })\r\n    const project = createSampleProject()\r\n\r\n    autosave({ ...project, name: 'a' })\r\n    autosave({ ...project, name: 'ab' })\r\n    autosave({ ...project, name: 'abc' })\r\n\r\n    expect(written).toEqual([])\r\n\r\n    await vi.advanceTimersByTimeAsync(AUTOSAVE_DEBOUNCE_MS)\r\n\r\n    expect(written.map(({ name }) => name)).toEqual(['abc'])\r\n  })\r\n\r\n  it('flushes the pending write instead of losing it when the page goes away', async () => {\r\n    // ?볝걾永귙굩?ｃ겍 500ms 餓ε냵?ラ뻾?섅굢?뚣굥?ⓦ곥뚦뎺?욁겗泳싥걤?띲굮?삠걲\r\n    // 艅잒꺗?뚧?孃뚣겗訝?볝굮?썬겏?쇻?\n    const written: Project[] = []\r\n    const autosave = createAutosave(async (project) => {\r\n      written.push(project)\r\n    })\r\n\r\n    autosave({ ...createSampleProject(), name: '?孃뚣겗訝?? })\r\n    expect(written).toEqual([])\r\n\r\n    autosave.flush()\r\n    await Promise.resolve()\r\n\r\n    expect(written.map(({ name }) => name)).toEqual(['?孃뚣겗訝??])\r\n\r\n    // 役곥걮?잌풄?ャ궭?ㅳ깯?쇈걣?귙걝訝佯?쇇?ャ걮?╊틠?띲겓?멥걢?ゃ걚??\n    await vi.advanceTimersByTimeAsync(AUTOSAVE_DEBOUNCE_MS)\r\n\r\n    expect(written).toHaveLength(1)\r\n  })\r\n\r\n  it('keeps the order when a slow write overlaps the next one', async () => {\r\n    // ?멥걤渦쇈겳??뫜?녑눣?쀣걫?ⓦ겓?η텥?믧뼀?띸쎍?쇻겗?㎯곲뇥?ゃ굥??commit ??젂??\n    // ?γ굦?욍굩?????끹굦?잌룮?꾣죭餓뜰걣?孃뚣겓餘뗣굤?곭쎍?띲겗訝?볝걣易덀걟??쫳?덀굥??\n    const written: string[] = []\r\n    const gate: (() => void)[] = []\r\n    let calls = 0\r\n    const autosave = createAutosave(async (project) => {\r\n      calls += 1\r\n      if (calls === 1) {\r\n        await new Promise<void>((resolve) => gate.push(resolve))\r\n      }\r\n      written.push(project.name)\r\n    })\r\n    const project = createSampleProject()\r\n    const settle = async () => {\r\n      for (let tick = 0; tick < 10; tick += 1) await Promise.resolve()\r\n    }\r\n\r\n    autosave({ ...project, name: '?? })\r\n    autosave.flush()\r\n    autosave({ ...project, name: '孃? })\r\n    autosave.flush()\r\n    await settle()\r\n\r\n    // ?덀걣屋겹겲?ｃ겍?꾠굥?볝겘孃뚣굚?뷩걬?ゃ걚?귟옙?꾥텏?쎼겙?ㅳ걚?밤걣?孃뚣겓餘뗣굥??\n    expect(written).toEqual([])\r\n\r\n    gate[0]()\r\n    await settle()\r\n\r\n    expect(written).toEqual(['??, '孃?])\r\n  })\r\n\r\n  it('drops the version overtaken while a slow write is in flight', async () => {\r\n    // 孃끹걾?믧럷?ョ찉??ⓦ곲쟻?믧썴?뚣굥?귙겗 flush ?뚨찉?얇굦?잌늽??풄?띲겓?욁굤??\n    // open ?쇻굢?븃죱?㎯걤?ゃ걚?얇겲?뉑쎑?뚦즸?뺛굦?뗣귟죱?쀣겘訝?ㅳ걤?듽겓?쀣겍??\n    // 瓦썬걚擁듽걬?뚣걼訝?뼋?덀겘?썬겏????旅덁뻑??칿?욁겲?뗣걫?ⓩ쎑?띸쎍?쇻걢?됥걽??\n    const written: string[] = []\r\n    const gate: (() => void)[] = []\r\n    let calls = 0\r\n    const autosave = createAutosave(async (project) => {\r\n      calls += 1\r\n      if (calls === 1) {\r\n        await new Promise<void>((resolve) => gate.push(resolve))\r\n      }\r\n      written.push(project.name)\r\n    })\r\n    const project = createSampleProject()\r\n    const settle = async () => {\r\n      for (let tick = 0; tick < 10; tick += 1) await Promise.resolve()\r\n    }\r\n\r\n    for (const name of ['??, '訝?, '孃?]) {\r\n      autosave({ ...project, name })\r\n      autosave.flush()\r\n    }\r\n    await settle()\r\n    gate[0]()\r\n    await settle()\r\n\r\n    expect(written).toEqual(['??, '孃?])\r\n  })\r\n\r\n  it('does nothing when flushed with no pending edit', () => {\r\n    const written: Project[] = []\r\n    const autosave = createAutosave(async (project) => {\r\n      written.push(project)\r\n    })\r\n\r\n    autosave.flush()\r\n\r\n    expect(written).toEqual([])\r\n  })\r\n\r\n  it('keeps saving after the burst settles', async () => {\r\n    const written: Project[] = []\r\n    const autosave = createAutosave(async (project) => {\r\n      written.push(project)\r\n    })\r\n    const project = createSampleProject()\r\n\r\n    autosave({ ...project, name: 'first' })\r\n    await vi.advanceTimersByTimeAsync(AUTOSAVE_DEBOUNCE_MS)\r\n    autosave({ ...project, name: 'second' })\r\n    await vi.advanceTimersByTimeAsync(AUTOSAVE_DEBOUNCE_MS)\r\n\r\n    expect(written.map(({ name }) => name)).toEqual(['first', 'second'])\r\n  })\r\n\r\n  it('keeps a failed write from reaching the caller', async () => {\r\n    // 岳앭춼?㎯걤?ゃ걚?볝겏?や퐪??퐳璵?굮閭㏂굙?뗧릤?긱겓?ゃ굢?ゃ걚 ???삯씊??쮫嶸쀣겘\r\n    // ?뽧꺀?╉궣?끹겎若뚨탳?쀣겍?꾠굥?귝뒘?믡굥?ⓦ궭?ㅳ깯?쇈겗訝?겒??겎沃겹굚?뺛겲?덀굢?뚣겒?꾠?\n    const autosave = createAutosave(async () => {\r\n      throw new Error('QuotaExceededError')\r\n    })\r\n\r\n    autosave(createSampleProject())\r\n\r\n    await expect(\r\n      vi.advanceTimersByTimeAsync(AUTOSAVE_DEBOUNCE_MS),\r\n    ).resolves.not.toThrow()\r\n  })\r\n})\r\n\r\n","exit_code":0,"status":"completed"}}
