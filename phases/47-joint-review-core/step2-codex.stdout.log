})\r\n\r\n  it('does not overwrite an edit made while the stored 旅덁뻑 was still loading', async () => {\r\n    // 沃?겳渦쇈겳??씆?뚧쐿?졼귙걹??뼋?ユ돀?잆굦?잆궩?ャ굮孃⒴뀇?뚥툓?멥걤?쇻굥?ⓦ?\r\n    // ?⑴뵪?끹걢?됭쫳?뚣겙?ε뒟?뚧텋?덀굥??\r\n    await saveProject({ ...createSampleProject(), name: '?띶썮??텥?? })\r\n    const edited = { ...createSampleProject(), name: '?ε뒟訝? }\r\n    useAppStore.setState({ project: edited })\r\n\r\n    const { result } = renderHook(() => useProjectPersistence())\r\n\r\n    await waitFor(() => expect(result.current.restored).toBe(true))\r\n    expect(useAppStore.getState().project.name).toBe('?ε뒟訝?)\r\n  })\r\n\r\n  it('saves the edited 旅덁뻑 so the next visit starts there', async () => {\r\n    const { result } = renderHook(() => useProjectPersistence())\r\n    await waitFor(() => expect(result.current.restored).toBe(true))\r\n\r\n    act(() => {\r\n      useAppStore\r\n        .getState()\r\n        .updateProject((project) => ({ ...project, name: '渶③썓孃? }))\r\n    })\r\n\r\n    await waitFor(\r\n      async () => {\r\n        expect((await loadStoredProject())?.name).toBe('渶③썓孃?)\r\n      },\r\n      { timeout: AUTOSAVE_DEBOUNCE_MS * 6 },\r\n    )\r\n  })\r\n\r\n  it('writes the pending edit when the tab hides, not only on pagehide', async () => {\r\n    // flush ??IndexedDB ?믧뼀?띸쎍?쇻굋agehide ??풄??쟻?뚦즸?뺛굦??open ??\r\n    // 永귙굩?됥겒?꾠겗?㎯곥겲?좈씆?뚧쐿?뚩㉠?뺛굦??hidden ?㎩눣?쇿퓚誤곥걣?귙굥??\r\n    const { result } = renderHook(() => useProjectPersistence())\r\n    await waitFor(() => expect(result.current.restored).toBe(true))\r\n\r\n    const visibility = Object.getOwnPropertyDescriptor(\r\n      Document.prototype,\r\n      'visibilityState',\r\n    )\r\n    Object.defineProperty(document, 'visibilityState', {\r\n      configurable: true,\r\n      get: () => 'hidden',\r\n    })\r\n    // 孃끾찣訝?겗 setTimeout ?믣겱?⒲겓?쀣걼?얇겲若잍셽鼇덀겦?삠걲?ⓦ곥걹??틛榮꾠겘?ⓦ겍?됥굦??\r\n    // ???멥걨?잆겒??debounce ???雅녴겎??겒??flush 永뚨뵳?졼곥겏鼇?꾢늾?뚣굥??\r\n    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] })\r\n    try {\r\n      act(() => {\r\n        useAppStore\r\n          .getState()\r\n          .updateProject((project) => ({ ...project, name: '?졼굦?뗥뎺' }))\r\n      })\r\n      act(() => {\r\n        document.dispatchEvent(new Event('visibilitychange'))\r\n      })\r\n    } finally {\r\n      vi.useRealTimers()\r\n      if (visibility) {\r\n        Object.defineProperty(document, 'visibilityState', visibility)\r\n      }\r\n    }\r\n\r\n    await waitFor(async () => {\r\n      expect((await loadStoredProject())?.name).toBe('?졼굦?뗥뎺')\r\n    })\r\n  })\r\n\r\n  it('stops saving once the pane unmounts', async () => {\r\n    const { result, unmount } = renderHook(() => useProjectPersistence())\r\n    await waitFor(() => expect(result.current.restored).toBe(true))\r\n    act(() => {\r\n      useAppStore\r\n        .getState()\r\n        .updateProject((project) => ({ ...project, name: '蘊쇠き訝? }))\r\n    })\r\n    await waitFor(\r\n      async () => {\r\n        expect((await loadStoredProject())?.name).toBe('蘊쇠き訝?)\r\n      },\r\n      { timeout: AUTOSAVE_DEBOUNCE_MS * 6 },\r\n    )\r\n\r\n    unmount()\r\n    act(() => {\r\n      useAppStore\r\n        .getState()\r\n        .updateProject((project) => ({ ...project, name: '鰲ｉ솮孃? }))\r\n    })\r\n    await new Promise((resolve) =>\r\n      setTimeout(resolve, AUTOSAVE_DEBOUNCE_MS * 4),\r\n    )\r\n\r\n    expect((await loadStoredProject())?.name).toBe('蘊쇠き訝?)\r\n  })\r\n\r\n  it('keeps the app usable when IndexedDB is unavailable', async () => {\r\n    // ?쀣꺀?ㅳ깧?쇈깉?╉궍?녈깋?╉굜若백뇧擁낂걥??open ?や퐪?뚦ㅁ?쀣걮?녴굥?귚퓷耶섅겎?띲겒??\r\n    // ?볝겏??쮫嶸쀣굮閭㏂굙?뗧릤?긱겓?ゃ굢?ゃ걚 ??鼇덄츞??깣?⒲궑?뜹냵?㎩츑永먦걮?╉걚?뗣?\r\n    const open = vi\r\n      .spyOn(indexedDB, 'open')\r\n      .mockImplementation(() => {\r\n        throw new DOMException('denied', 'SecurityError')\r\n      })\r\n\r\n    try {\r\n      const { result } = renderHook(() => useProjectPersistence())\r\n\r\n      await waitFor(() => expect(result.current.restored).toBe(true))\r\n      expect(useAppStore.getState().project).toBeDefined()\r\n    } finally {\r\n      open.mockRestore()\r\n    }\r\n  })\r\n})\r\nimport { beforeEach, describe, expect, it } from 'vitest'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport { createStressProject } from '@/domain/model/stress-project'\r\n\r\nimport { useAppStore } from './store'\r\n\r\ndescribe('useAppStore dev instrumentation', () => {\r\n  // R4 ?깅뒫 痢≪젙 ?섎꽕?ㅺ? 釉뚮씪?곗??먯꽌 ??⑸웾 Project瑜?二쇱엯??諛⑸쾿???꾩슂?섎떎 ??\r\n  // ???몄텧???놁쑝硫?dev-browser ?ㅽ겕由쏀듃媛 ?ㅽ넗?댁뿉 ?우쓣 湲몄씠 ?녿떎.\r\n  it('exposes the store on window for the stress-scale measurement harness', () => {\r\n    expect((window as unknown as { __kijunStore?: unknown }).__kijunStore).toBe(\r\n      useAppStore,\r\n    )\r\n  })\r\n})\r\n\r\ndescribe('useAppStore initial state', () => {\r\n  it('lands with a ??already selected so the 3D pane is not empty', () => {\r\n    const { sel, activeStoryId, project } = useAppStore.getInitialState()\r\n\r\n    expect(sel.memberId).not.toBeNull()\r\n    expect(sel.group).not.toBeNull()\r\n\r\n    const member = project.members.find(({ id }) => id === sel.memberId)\r\n    expect(member?.kind).toBe('??)\r\n    expect(member?.storyId).toBe(activeStoryId)\r\n  })\r\n})\r\n\r\ndescribe('useAppStore', () => {\r\n  beforeEach(() => {\r\n    useAppStore.setState({\r\n      project: createSampleProject(),\r\n      sel: { group: null, memberId: null },\r\n      hoverRowId: null,\r\n      locale: 'ja',\r\n      activeStoryId: '1F',\r\n      viewerMode: 'member',\r\n      viewerLayers: { main: true, hoop: true, concrete: true },\r\n    })\r\n  })\r\n\r\n  it('starts in the member view and toggles to the building view', () => {\r\n    expect(useAppStore.getInitialState().viewerMode).toBe('member')\r\n\r\n    useAppStore.getState().setViewerMode('building')\r\n\r\n    expect(useAppStore.getState().viewerMode).toBe('building')\r\n  })\r\n\r\n  it('starts with every viewer layer visible and toggles layers independently', () => {\r\n    expect(useAppStore.getInitialState().viewerLayers).toEqual({\r\n      main: true,\r\n      hoop: true,\r\n      concrete: true,\r\n    })\r\n\r\n    useAppStore.getState().toggleViewerLayer('hoop')\r\n\r\n    expect(useAppStore.getState().viewerLayers).toEqual({\r\n      main: true,\r\n      hoop: false,\r\n      concrete: true,\r\n    })\r\n  })\r\n\r\n  it('selectMember updates sel and switches to the member story', () => {\r\n    useAppStore.getState().selectMember('2F-X2Y2')\r\n\r\n    expect(useAppStore.getState().sel).toEqual({\r\n      group: '2??C|C1',\r\n      memberId: '2F-X2Y2',\r\n    })\r\n    expect(useAppStore.getState().activeStoryId).toBe('2F')\r\n  })\r\n\r\n  it('selectGroup also switches to the representative member story', () => {\r\n    useAppStore\r\n      .getState()\r\n      .selectGroup('2??C|C1', '2F-X1Y1')\r\n\r\n    expect(useAppStore.getState().sel).toEqual({\r\n      group: '2??C|C1',\r\n      memberId: '2F-X1Y1',\r\n    })\r\n    expect(useAppStore.getState().activeStoryId).toBe('2F')\r\n  })\r\n\r\n  it('setHoverRow does not modify the independent member selection axis', () => {\r\n    useAppStore.getState().selectMember('1F-X2Y2')\r\n    const selection = useAppStore.getState().sel\r\n\r\n    useAppStore.getState().setHoverRow('1??C|C1|訝사춮')\r\n\r\n    expect(useAppStore.getState().hoverRowId).toBe('1??C|C1|訝사춮')\r\n    expect(useAppStore.getState().sel).toEqual(selection)\r\n  })\r\n\r\n  it('does not store derived rebars or quantity lines', () => {\r\n    const state = useAppStore.getState()\r\n\r\n    expect(state).not.toHaveProperty('rebars')\r\n    expect(state).not.toHaveProperty('quantityLines')\r\n  })\r\n})\r\n\r\ndescribe('loadProject', () => {\r\n  it('re-points the selection at the loaded 旅덁뻑', () => {\r\n    // ?뽧굤渦쇈굯?졿죭餓뜰겓?곩뎺??죭餓뜰겎?멥겙?뚣겍?꾠걼?ⓩ쓲 id ??꽒?꾠귡겦?욁굮\r\n    // ?앫겗?얇겲?ャ걲?뗣겏3?싥궎?녈걣耶섇쑉?쀣겒?꾦깿?먦굮?뉎걮?잆겲?얇겓?ゃ굥??\r\n    useAppStore.setState({\r\n      project: createSampleProject(),\r\n      sel: { group: 'stale-group', memberId: 'stale-member' },\r\n      activeStoryId: 'stale-story',\r\n    })\r\n    const loaded = createStressProject({\r\n      xSpanCount: 1,\r\n      ySpanCount: 1,\r\n      storyCount: 1,\r\n    })\r\n\r\n    useAppStore.getState().loadProject(loaded)\r\n\r\n    const { project, sel, activeStoryId } = useAppStore.getState()\r\n    expect(project).toBe(loaded)\r\n\r\n    const member = project.members.find(({ id }) => id === sel.memberId)\r\n    expect(member).toBeDefined()\r\n    expect(member?.kind).toBe('??)\r\n    expect(sel.group).not.toBe('stale-group')\r\n    expect(activeStoryId).toBe(member?.storyId)\r\n  })\r\n\r\n  it('clears the hovered row, which belonged to the previous 旅덁뻑', () => {\r\n    useAppStore.setState({ hoverRowId: '1??C|C1|訝사춮' })\r\n\r\n    useAppStore.getState().loadProject(createSampleProject())\r\n\r\n    expect(useAppStore.getState().hoverRowId).toBeNull()\r\n  })\r\n})\r\nimport { fireEvent, render, screen, waitFor } from '@testing-library/react'\r\nimport { beforeEach, describe, expect, it, vi } from 'vitest'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport {\r\n  PROJECT_SCHEMA_VERSION,\r\n  serializeProject,\r\n  type Project,\r\n} from '@/domain/model/project'\r\nimport { useAppStore } from '@/lib/store'\r\n\r\nimport { ProjectActions } from './ProjectActions'\r\n\r\nfunction choose(contents: string): void {\r\n  const input = screen.getByLabelText('旅덁뻑?믦き?욤씔??)\r\n  const file = new File([contents], '旅덁뻑.json', { type: 'application/json' })\r\n\r\n  fireEvent.change(input, { target: { files: [file] } })\r\n}\r\n\r\nbeforeEach(() => {\r\n  useAppStore.setState(useAppStore.getInitialState(), true)\r\n})\r\n\r\ndescribe('ProjectActions', () => {\r\n  it('hands the browser the current 旅덁뻑 as JSON', async () => {\r\n    let blob: Blob | undefined\r\n    let filename: string | undefined\r\n    Object.defineProperty(URL, 'createObjectURL', {\r\n      configurable: true,\r\n      value: vi.fn((value: Blob) => {\r\n        blob = value\r\n        return 'blob:kijun-test'\r\n      }),\r\n    })\r\n    Object.defineProperty(URL, 'revokeObjectURL', {\r\n      configurable: true,\r\n      value: vi.fn(),\r\n    })\r\n    const click = vi\r\n      .spyOn(HTMLAnchorElement.prototype, 'click')\r\n      .mockImplementation(function (this: HTMLAnchorElement) {\r\n        filename = this.download\r\n      })\r\n\r\n    render(<ProjectActions />)\r\n    try {\r\n      fireEvent.click(screen.getByRole('button', { name: '旅덁뻑?믢퓷耶? }))\r\n    } finally {\r\n      click.mockRestore()\r\n      Reflect.deleteProperty(URL, 'createObjectURL')\r\n      Reflect.deleteProperty(URL, 'revokeObjectURL')\r\n    }\r\n\r\n    expect(filename).toBe('?듐꺍?쀣꺂旅덁뻑 RC 2?롥뻠??json')\r\n    expect(await blob!.text()).toBe(\r\n      serializeProject(useAppStore.getState().project),\r\n    )\r\n  })\r\n\r\n  it('replaces the 旅덁뻑 with the chosen file', async () => {\r\n    const loaded: Project = { ...createSampleProject(), name: '?뽧굤渦쇈굯?졿죭餓? }\r\n    render(<ProjectActions />)\r\n\r\n    choose(serializeProject(loaded))\r\n\r\n    await waitFor(() => {\r\n      expect(useAppStore.getState().project.name).toBe('?뽧굤渦쇈굯?졿죭餓?)\r\n    })\r\n  })\r\n\r\n  it('keeps the current 旅덁뻑 and says so when the file cannot be read', async () => {\r\n    // 容쇻겂??ㅁ?쀣걲?뗣겏?곩닶?②끹겓??뚩き?욤씔?볝걽??겓鵝뺛굚鸚됥굩?됥겒?꾠띲겏?쀣걢\r\n    // 誤뗣걟?ゃ걚?귚퍓?뗣걚?╉걚?뗦죭餓뜰겘餘뗣걲??\r\n    const before = useAppStore.getState().project\r\n    render(<ProjectActions />)\r\n\r\n    choose('{ not json')\r\n\r\n    expect(await screen.findByRole('alert')).toHaveTextContent(\r\n      '沃?겳渦쇈굙?얇걵?볝겎?쀣걼',\r\n    )\r\n    expect(useAppStore.getState().project).toBe(before)\r\n  })\r\n\r\n  it('refuses a file saved under an older schema', async () => {\r\n    const stale = serializeProject({\r\n      ...createSampleProject(),\r\n      schemaVersion: PROJECT_SCHEMA_VERSION - 1,\r\n    } as Project)\r\n    const before = useAppStore.getState().project\r\n    render(<ProjectActions />)\r\n\r\n    choose(stale)\r\n\r\n    expect(await screen.findByRole('alert')).toBeInTheDocument()\r\n    expect(useAppStore.getState().project).toBe(before)\r\n  })\r\n\r\n  it('clears the failure once a valid file is chosen', async () => {\r\n    render(<ProjectActions />)\r\n\r\n    choose('{ not json')\r\n    expect(await screen.findByRole('alert')).toBeInTheDocument()\r\n\r\n    choose(serializeProject({ ...createSampleProject(), name: '?띷뙌?? }))\r\n\r\n    await waitFor(() => {\r\n      expect(screen.queryByRole('alert')).not.toBeInTheDocument()\r\n    })\r\n    expect(useAppStore.getState().project.name).toBe('?띷뙌??)\r\n  })\r\n})\r\nimport {\r\n  deserializeProject,\r\n  serializeProject,\r\n  type Project,\r\n} from '@/domain/model/project'\r\n\r\n/**\r\n * Windows?팵acOS ?뚣깢?▲궎?ュ릫?ヨ㉠?뺛겒?꾣뻼耶쀣귝죭餓뜹릫??눎?긷뀯?쎼겒??겎??\r\n * ?앫겗?얇겲歷▲걲?ⓧ퓷耶섅겓鸚길븮?쇻굥?뗣곥깣?⒲궑?뜰걣?앮뎸?ュ닪?띲굮餓섅걨??닶?②끹겗\r\n * 餓섅걨?잌릫?띲걣易덀걟?뗣?\r\n */\r\nconst ILLEGAL_FILENAME_CHARS = /[<>:\"/\\\\|?*\\u0000-\\u001f]/g\r\n\r\nexport function projectFileName(projectName: string): string {\r\n  const safe = projectName\r\n    .replace(ILLEGAL_FILENAME_CHARS, '')\r\n    // ?뽧굤?ㅳ걚?잍뻼耶쀣겗瓮▲걣令븀쇋??ｃ겒?듽겏?쀣겍餘뗣굥竊덀똀 / B?띯넂?똀  B?랃펹??\r\n    .replace(/\\s+/g, ' ')\r\n    .trim()\r\n\r\n  return safe.length === 0 ? 'kijun-project.json' : `${safe}.json`\r\n}\r\n\r\nexport function downloadProjectJson(project: Project): void {\r\n  const blob = new Blob([serializeProject(project)], {\r\n    type: 'application/json',\r\n  })\r\n  const url = URL.createObjectURL(blob)\r\n  const anchor = document.createElement('a')\r\n  anchor.href = url\r\n  anchor.download = projectFileName(project.name)\r\n  anchor.style.display = 'none'\r\n  document.body.appendChild(anchor)\r\n  anchor.click()\r\n  anchor.remove()\r\n  URL.revokeObjectURL(url)\r\n}\r\n\r\n/**\r\n * ?뽧굤渦쇈겳??닶?②끹걣?멥굯?졼깢?▲궎?ャ겎冶뗣겲?뗣귟き?곥겒?꾠굚??겘?뺛걩????\r\n * ?ゅ땿岳앭춼??쑴??loadStoredProject)?③걬?ｃ겍?곥걪?볝겓??뚪퍢?ｃ겍?ⓦ겍?뗣띲겗\r\n * ?멩뎸?밤걣?꾠굥?귛닶?②끹겘餓듽걹??깢?▲궎?ャ굮?멥굯?졼겗?졼걢?됥곲쭊??겒?됭??녴?\r\n */\r\nexport async function readProjectFile(file: File): Promise<Project> {\r\n  return deserializeProject(await file.text())\r\n}\r\nimport {\r\n  deserializeProject,\r\n  serializeProject,\r\n  type Project,\r\n} from '@/domain/model/project'\r\n\r\nconst DATABASE_NAME = 'kijun'\r\nconst DATABASE_VERSION = 1\r\nconst STORE_NAME = 'project'\r\n/** 岳앭춼?쇻굥旅덁뻑??만?ヤ??ㅳ귝죭餓뜸?誤㎯겘?얇걽?▲걚??*/\r\nconst RECORD_KEY = 'current'\r\n\r\n/**\r\n * ??씊訝誤㎯겘?삠꺂?믤돀?ㅳ걼?녈겓 Project ?믣량?쀦쎘?덀굥??겎???볣뜷1?멥걤渦쇈겳?졼겏\r\n * ?ε뒟訝?걳?ｃ겏 IndexedDB ?믣룴?뤵귝돀?←탞?뤵겂?╉걢?됪쎑?뤵?\r\n */\r\nexport const AUTOSAVE_DEBOUNCE_MS = 500\r\n\r\nfunction openDatabase(): Promise<IDBDatabase> {\r\n  return new Promise((resolve, reject) => {\r\n    const request = indexedDB.open(DATABASE_NAME, DATABASE_VERSION)\r\n\r\n    request.onupgradeneeded = () => {\r\n      if (!request.result.objectStoreNames.contains(STORE_NAME)) {\r\n        request.result.createObjectStore(STORE_NAME)\r\n      }\r\n    }\r\n    request.onsuccess = () => resolve(request.result)\r\n    request.onerror = () => reject(request.error)\r\n    request.onblocked = () => reject(new Error('IndexedDB open blocked'))\r\n  })\r\n}\r\n\r\nfunction run<T>(\r\n  mode: IDBTransactionMode,\r\n  operation: (store: IDBObjectStore) => IDBRequest<T>,\r\n): Promise<T> {\r\n  return openDatabase().then(\r\n    (database) =>\r\n      new Promise<T>((resolve, reject) => {\r\n        // transaction ??퐳?먦겘?뚧쐿?ユ뒘?믡굥 (?밤깉?㏂겗?▲걚 DB ?ゃ굢\r\n        // NotFoundError)?귛풄冶뗦쑌?뚣궎?쇻꺍?덀깗?녈깋?⒲겗訝?겓?쀣걢?▲걚?ⓦ?\r\n        // ?앫겗?η텥?뚪뼀?꾠걼?얇겲?쇈겞?뷩걮??빊?졼걨餘뗣굥?붶빳孃뚣겗?ゅ땿岳앭춼??\r\n        // 麗면걽?ュㅁ?쀣걮?곭뎵?믢툓?믡굥?ⓦ걤 onblocked ?㎪??얇굥??\r\n        let transaction: IDBTransaction\r\n        let request: IDBRequest<T>\r\n        try {\r\n          transaction = database.transaction(STORE_NAME, mode)\r\n          request = operation(transaction.objectStore(STORE_NAME))\r\n        } catch (error) {\r\n          database.close()\r\n          reject(error)\r\n          return\r\n        }\r\n\r\n        transaction.oncomplete = () => {\r\n          database.close()\r\n          resolve(request.result)\r\n        }\r\n        transaction.onerror = () => {\r\n          database.close()\r\n          reject(transaction.error)\r\n        }\r\n        transaction.onabort = () => {\r\n          database.close()\r\n          reject(transaction.error)\r\n        }\r\n      }),\r\n  )\r\n}\r\n\r\nexport async function saveProject(project: Project): Promise<void> {\r\n  await run('readwrite', (store) =>\r\n    store.put(serializeProject(project), RECORD_KEY),\r\n  )\r\n}\r\n\r\n/**\r\n * 孃⒴뀇?㎯걤?ゃ걚?귙겗??퍢?ｃ겍?ⓦ겍??null ?믦퓭????壅룟땿永뚩러?ゃ겗?㎯곥걪?볝겎?뺛걩?뗣겏\r\n * 易덀걲?뗧쳦?╉겗?ゃ걚?얇겲?삯씊?뚨쇋?뤵겒?뗣귝뿧 schemaVersion ?귛즸?뚣걼?뉐춻?쀣굚?뚣걯\r\n * ?긱걚?? ?⒲걾?됥굚?뚣걪??쮼?꿔겎??돈?뺛겎?띲겒?꾠띴빳訝듽겗?볝겏?믣닶?②끹겓鼇?덀겒?꾠?\r\n */\r\nexport async function loadStoredProject(): Promise<Project | null> {\r\n  try {\r\n    const stored = await run<string | undefined>('readonly', (store) =>\r\n      store.get(RECORD_KEY),\r\n    )\r\n    if (typeof stored !== 'string') return null\r\n\r\n    return deserializeProject(stored)\r\n  } catch {\r\n    return null\r\n  }\r\n}\r\n\r\nexport async function clearStoredProject(): Promise<void> {\r\n  try {\r\n    await run('readwrite', (store) => store.delete(RECORD_KEY))\r\n  } catch {\r\n    // 易덀걵?ゃ걚?볝겏?믣닶?②끹겓鴉앫걟?╉굚?볝겇?뗣걣?▲걚??\r\n  }\r\n}\r\n\r\nexport interface Autosave {\r\n  (project: Project): void\r\n  /**\r\n   * 孃끹겂?╉걚?뗦쎑?띹씔?욍굮餓듽걲?먨눣?쇻귡쟻?믧썴?뚣굥?귙겓?쇈겤 ???볝걾永귙굩?ｃ겍\r\n   * 500ms 餓ε냵?ラ뻾?섅굢?뚣굥?ⓦ곥뚦뎺?욁겗泳싥걤?띲굮?삠걲艅잒꺗?뚧?孃뚣겗訝?볝굮?썬겏?쇻?\r\n   */\r\n  flush(): void\r\n}\r\n\r\nexport function createAutosave(\r\n  write: (project: Project) => Promise<void> = saveProject,\r\n): Autosave {\r\n  let timer: ReturnType<typeof setTimeout> | null = null\r\n  let pending: Project | null = null\r\n  // ?멥걤渦쇈겳??뫜?녑눣?쀣걫?ⓦ겓?η텥?믧뼀?띸쎍?쇻겗?㎯곲뇥?ゃ굥??commit ??젂??\r\n  // ?γ굦?욍굩?듽걝?????끹굦?잌룮?꾣죭餓뜰걣?孃뚣겓餘뗣굥?귡젂?ヤ??ㅳ걳?ㅵ눣?쇻?\r\n  //\r\n  // 孃끹걾烏뚦닓????ㅳ걤?듽걽?귡럷?ョ찉??ⓦ곲쟻?믧썴?뚣굥?귙겗 flush ?뚨찉?얇굦?잌늽??\r\n  // 孃뚣굧?ュ썮?듽걇pen ?쇻굢?븃죱?㎯걤?ゃ걚?얇겲?뉑쎑?뚦즸?뺛굦????flushOnLeave ??\r\n  // 掠끹굥??겘?얇걬?ャ걹??졃?덀걽?귝죭餓뜰겘驪롥썮?얇굥?붵겏?멥걤?담걲??겎?곩푷?ㅹ뼋??\r\n  // 瓦썬걚擁듽걬?뚣걼?ㅳ걚?덀겘?썬겏?쀣겍?덀걚??\r\n  let inFlight: Promise<void> | null = null\r\n  let queued: Project | null = null\r\n\r\n  const drain = () => {\r\n    if (inFlight !== null || queued === null) return\r\n\r\n    const target = queued\r\n    queued = null\r\n    // 岳앭춼?㎯걤?ゃ걚?볝겏?や퐪??퐳璵?굮閭㏂굙?뗧릤?긱겓?ゃ굢?ゃ걚 ??鼇덄츞??깣?⒲궑?뜹냵??\r\n    // 若뚨탳?쀣겍?꾠굥?귙궭?ㅳ깯?쇈겗訝?겒??겎?곫뒘?믡겍?귟ぐ?귝뜒?얇걟?됥굦?ゃ걚??\r\n    inFlight = write(target)\r\n      .catch(() => {})\r\n      .then(() => {\r\n        inFlight = null\r\n        drain()\r\n      })\r\n  }\r\n\r\n  const flush = () => {\r\n    if (timer !== null) {\r\n      clearTimeout(timer)\r\n      timer = null\r\n    }\r\n\r\n    const target = pending\r\n    pending = null\r\n    if (target === null) return\r\n\r\n    queued = target\r\n    drain()\r\n  }\r\n\r\n  const autosave = (project: Project) => {\r\n    pending = project\r\n    if (timer !== null) clearTimeout(timer)\r\n    timer = setTimeout(flush, AUTOSAVE_DEBOUNCE_MS)\r\n  }\r\n\r\n  autosave.flush = flush\r\n  return autosave\r\n}\r\n'use client'\r\n\r\nimport { useEffect, useState } from 'react'\r\n\r\nimport {\r\n  createAutosave,\r\n  loadStoredProject,\r\n} from '@/lib/persist/indexeddb'\r\nimport { useAppStore } from '@/lib/store'\r\n\r\nexport interface ProjectPersistence {\r\n  /** 孃⒴뀇??닩若싥걣歷덀굯?졼걢?귝툑??얇겎?ゅ땿岳앭춼??쭓?곥겒?꾠?*/\r\n  restored: boolean\r\n}\r\n\r\n/**\r\n * ?띹Ø永뚩러 (docs/UX.md 짠4 餘들쉸5)?귛뎺?욁겗旅덁뻑??IndexedDB ?뗣굢?삠걮?곦빳孃뚣겗\r\n * 渶③썓?믦눎?뺜퓷耶섅걲?뗣귚퓷耶섅겘?뽧꺀?╉궣??릎?졼걨?㎯곥궢?쇈깘?멥겘?뷩겒??(ADR-006)??\r\n */\r\nexport function useProjectPersistence(): ProjectPersistence {\r\n  const [restored, setRestored] = useState(false)\r\n\r\n  useEffect(() => {\r\n    let cancelled = false\r\n    let unsubscribe: (() => void) | null = null\r\n    let flushOnLeave: (() => void) | null = null\r\n    let flushOnHide: (() => void) | null = null\r\n\r\n    void loadStoredProject().then((stored) => {\r\n      if (cancelled) return\r\n\r\n      // 沃?겳渦쇈겳??씆?뚧쐿?졼귙걹??뼋?ユ돀?잆굦?잆궩?ャ굮孃⒴뀇?뚥툓?멥걤?쇻굥?ⓦ?\r\n      // ?⑴뵪?끹걢?됭쫳?뚣겙?ε뒟?뚧텋?덀굥?귝뎸?ㅳ걢?싥겗?ⓦ걤?졼걨藥?걮?욍걟?뗣?\r\n      const untouched =\r\n        useAppStore.getState().project === useAppStore.getInitialState().project\r\n      try {\r\n        if (stored !== null && untouched) {\r\n          useAppStore.getState().loadProject(stored)\r\n        }\r\n      } catch {\r\n        // ?귞뀱?뉎굦??deserializeProject ?뚦늾??(?볝걪?ャ겘?γ겒???귝츐?뗣겗??\r\n        // loadProject ?や퐪?뚧뒘?믡굥?닷릦?졼걨?????얇걝??겘?곩쑴?껁겗鸚길븮??\r\n        // ?ゅ땿岳앭춼?믧걪?ｃ굦?ャ걲?뗣겏餓ε풄??랬?녴걣容쇻겂?╊퓷耶섅걬?뚣겒?뤵겒?뗣걢?됥겎??\r\n        // ?뚦숱??싥겂?잆걣訝?벴?뚦즸?뚣걼鼇섌뙯?띲굮閭㏂굙?뗣겗??걪?볝겎??겒?꾠?\r\n      }\r\n\r\n      const autosave = createAutosave()\r\n      unsubscribe = useAppStore.subscribe(({ project }, previous) => {\r\n        if (project !== previous.project) autosave(project)\r\n      })\r\n      // 沃?겳渦쇈겳?믣푷?ㅹ뼋?ユ돀?잆굦?잏랬?녴겘蘊쇠き?덀굤?띲겒??겎?곦?佯╉걽?묆겒??\r\n      // ?멥걢?뚣겒?꾠겲?얏텋?덀굥?붻낵沃?겘?뚦쨯?뽧띲겎?쀣걢?븀겓?쀣겒?꾠귙걪?볝겎?얇걝??\r\n      if (!untouched) autosave(useAppStore.getState().project)\r\n      // ?볝걾永귙굩?ｃ겍 500ms 餓ε냵?ラ뻾?섅굢?뚣굥?ⓨ푷艅잋릎??쎑?띹씔?욍걣易덀걟?뗣?\r\n      // ?잆걽??flush ??IndexedDB ?믧뼀?띸쎍?쇻겗?㎯걈agehide ?얇겎孃끹겇??\r\n      // ?곥걣鶯듽걬?뚣굥永뚩러?㎯겘 open ??transaction ?귞탞?뤵굢?ゃ걚 ???얇걽\r\n      // ?욃릪?잆걣鼇긱걬?뚣굥 visibilitychange(hidden) ?㎩뀍?ュ눣?쇻굋agehide ??\r\n      // bfcache ?ュ뀯?뗦셽?귝씎?뗣겗?㎯곲슑?뚣걼孃뚣겗訝?볝굮?얇걝岳앶쇇?졼?\r\n      flushOnLeave = () => autosave.flush()\r\n      flushOnHide = () => {\r\n        if (document.visibilityState === 'hidden') autosave.flush()\r\n      }\r\n      window.addEventListener('pagehide', flushOnLeave)\r\n      document.addEventListener('visibilitychange', flushOnHide)\r\n      setRestored(true)\r\n    })\r\n\r\n    return () => {\r\n      cancelled = true\r\n      unsubscribe?.()\r\n      if (flushOnLeave) window.removeEventListener('pagehide', flushOnLeave)\r\n      if (flushOnHide) {\r\n        document.removeEventListener('visibilitychange', flushOnHide)\r\n      }\r\n    }\r\n  }, [])\r\n\r\n  return { restored }\r\n}\r\n'use client'\r\n\r\nimport { create } from 'zustand'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport {\r\n  memberGroupKey,\r\n  type Project,\r\n} from '@/domain/model/project'\r\n\r\nexport interface Selection {\r\n  group: string | null\r\n  memberId: string | null\r\n}\r\n\r\nexport type Locale = 'ja' | 'ko'\r\n\r\n/** 3D ?섏씤???섏씤-濡쒖뺄 ??(DESIGN.md 짠7): ?ⓩ쓲 = ?좏깮 遺??1媛? 兩븀돥 = ??遺??*/\r\nexport type ViewerMode = 'member' | 'building'\r\n\r\nexport type ViewerLayer = 'main' | 'hoop' | 'concrete'\r\n\r\nexport interface AppState {\r\n  project: Project\r\n  sel: Selection\r\n  hoverRowId: string | null\r\n  locale: Locale\r\n  activeStoryId: string\r\n  viewerMode: ViewerMode\r\n  viewerLayers: Record<ViewerLayer, boolean>\r\n  selectMember(memberId: string): void\r\n  selectGroup(groupId: string, memberId: string): void\r\n  setHoverRow(rowId: string | null): void\r\n  setLocale(locale: Locale): void\r\n  setActiveStory(storyId: string): void\r\n  setViewerMode(mode: ViewerMode): void\r\n  toggleViewerLayer(layer: ViewerLayer): void\r\n  updateProject(updater: (project: Project) => Project): void\r\n  loadProject(project: Project): void\r\n}\r\n\r\nfunction findMember(project: Project, memberId: string) {\r\n  const member = project.members.find(({ id }) => id === memberId)\r\n\r\n  if (!member) {\r\n    throw new Error(`Member not found: ${memberId}`)\r\n  }\r\n\r\n  return member\r\n}\r\n\r\nconst initialProject = createSampleProject()\r\n\r\n/**\r\n * 泥??붾㈃?먯꽌 3D ?섏씤??鍮꾩뼱 ?덉? ?딅룄濡?????깅? 誘몃━ ?좏깮?쒕떎 (docs/UX.md 짠4.1).\r\n */\r\nfunction initialSelection(project: Project): Selection {\r\n  const member = project.members.find(({ kind }) => kind === '??)\r\n  if (!member) return { group: null, memberId: null }\r\n\r\n  return { group: memberGroupKey(project, member), memberId: member.id }\r\n}\r\n\r\nconst initialSel = initialSelection(initialProject)\r\n\r\n/** ?멩뒢?뚧뙁?숅깿?먦겗?롢귝뙁?숅깿?먦걣?▲걨?뚣겙??앫겗?롢겓?삠걲??*/\r\nfunction storyOf(project: Project, selection: Selection): string {\r\n  return (\r\n    project.members.find(({ id }) => id === selection.memberId)?.storyId ??\r\n    project.stories[0].id\r\n  )\r\n}\r\n\r\nexport const useAppStore = create<AppState>((set) => ({\r\n  project: initialProject,\r\n  sel: initialSel,\r\n  hoverRowId: null,\r\n  locale: 'ja',\r\n  activeStoryId: storyOf(initialProject, initialSel),\r\n  viewerMode: 'member',\r\n  viewerLayers: { main: true, hoop: true, concrete: true },\r\n  selectMember(memberId) {\r\n    set(({ project }) => {\r\n      const member = findMember(project, memberId)\r\n      return {\r\n        sel: {\r\n          group: memberGroupKey(project, member),\r\n          memberId: member.id,\r\n        },\r\n        activeStoryId: member.storyId,\r\n      }\r\n    })\r\n  },\r\n  selectGroup(groupId, memberId) {\r\n    set(({ project }) => {\r\n      const member = findMember(project, memberId)\r\n      return {\r\n        sel: { group: groupId, memberId: member.id },\r\n        activeStoryId: member.storyId,\r\n      }\r\n    })\r\n  },\r\n  setHoverRow(rowId) {\r\n    set({ hoverRowId: rowId })\r\n  },\r\n  setLocale(locale) {\r\n    set({ locale })\r\n  },\r\n  setActiveStory(storyId) {\r\n    set({ activeStoryId: storyId })\r\n  },\r\n  setViewerMode(mode) {\r\n    set({ viewerMode: mode })\r\n  },\r\n  toggleViewerLayer(layer) {\r\n    set(({ viewerLayers }) => ({\r\n      viewerLayers: {\r\n        ...viewerLayers,\r\n        [layer]: !viewerLayers[layer],\r\n      },\r\n    }))\r\n  },\r\n  updateProject(updater) {\r\n    set(({ project }) => ({ project: updater(project) }))\r\n  },\r\n  /**\r\n   * 旅덁뻑?얇굥?붵겏??량?쀦쎘?덌펷?ゅ땿岳앭춼?뗣굢??쑴?껁꺕JSON ?뽧굤渦쇈겳竊됥?\r\n   * updateProject ?③걬?ｃ겍?멩뒢?믤똻?↑텏?쎼겒?????뽧굤渦쇈굯?졿죭餓뜰겓?띲겗旅덁뻑??\r\n   * ?ⓩ쓲 id ??꽒?뤵??싥궎?녈걣耶섇쑉?쀣겒?꾦깿?먦굮?뉎걮?잆겲?얇겓?ゃ굥??\r\n   */\r\n  loadProject(project) {\r\n    const sel = initialSelection(project)\r\n\r\n    set({\r\n      project,\r\n      sel,\r\n      hoverRowId: null,\r\n      activeStoryId: storyOf(project, sel),\r\n    })\r\n  },\r\n}))\r\n\r\n// R4 ?깅뒫 痢≪젙 ?섎꽕??dev-browser)媛 ?ㅽ넗?댁뿉 ??⑸웾 Project瑜?二쇱엯??諛⑸쾿??\r\n// ?꾩슂?섎떎. ?꾨㈃ ?곗씠?곌? ???꾩껜 ?곹깭???꾨줈?뺤뀡 鍮뚮뱶?먮뒗 ?몄텧?섏? ?딅뒗??\r\nif (typeof window !== 'undefined' && process.env.NODE_ENV !== 'production') {\r\n  ;(window as Window & { __kijunStore?: typeof useAppStore }).__kijunStore =\r\n    useAppStore\r\n}\r\n'use client'\r\n\r\nimport { useId, useState, type ChangeEvent } from 'react'\r\n\r\nimport { t } from '@/lib/i18n'\r\nimport { downloadProjectJson, readProjectFile } from '@/lib/persist/file'\r\nimport { useAppStore } from '@/lib/store'\r\nimport { capture, captureException } from '@/lib/telemetry'\r\n\r\nimport styles from './ProjectActions.module.css'\r\n\r\n/**\r\n * 旅덁뻑??퓷耶섅꺕沃?겳渦쇈겳 (docs/UX.md 짠4 餘들쉸5)?귟눎?뺜퓷耶?(useProjectPersistence)\r\n * ??깣?⒲궑?뜰굮瓮ⓦ걩?ゃ걚??겎?곦퍟??ク?ャ겦歷▲걲?볝걣?볝걪?ャ겒?뗣귙깢?▲궎?ャ겘?⑴뵪?끹겗\r\n * ?뗥뀇?졼걨?㎬き?욘쎑?띲걮?곥궢?쇈깘?멥겘?뷩겒??(ADR-006)??\r\n */\r\nexport function ProjectActions() {\r\n  const project = useAppStore(({ project }) => project)\r\n  const loadProject = useAppStore(({ loadProject }) => loadProject)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const [failed, setFailed] = useState(false)\r\n  const inputId = useId()\r\n\r\n  const chooseFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n    const file = event.target.files?.[0]\r\n    // ?뚣걯?뺛궊?ㅳ꺂?믧겦?녕쎍?쀣겍??change ?뚦눣?뗣굠?녴겓?ㅳ굮令뷩겓?삠걲??\r\n    event.target.value = ''\r\n    if (!file) return\r\n\r\n    try {\r\n      loadProject(await readProjectFile(file))\r\n      setFailed(false)\r\n      capture('project_imported', { locale })\r\n    } catch (error) {\r\n      // 容쇻겂??ㅁ?쀣걲?뗣겏?뚩き?욤씔?볝걽??겓鵝뺛굚鸚됥굩?됥겒?꾠띲겏?쀣걢誤뗣걟?ゃ걚??\r\n      // 餓딃뼀?꾠겍?꾠굥旅덁뻑??걹??겲?얏츐?쇻?\r\n      setFailed(true)\r\n      captureException(error, { stage: 'project_import' })\r\n      capture('project_import_failed', { locale })\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.projectActions}>\r\n      <button\r\n        type=\"button\"\r\n        className={styles.actionButton}\r\n        onClick={() => {\r\n          downloadProjectJson(project)\r\n          capture('project_exported', { locale })\r\n        }}\r\n      >\r\n        {t(locale, 'project.save')}\r\n      </button>\r\n      <label className={styles.actionButton} htmlFor={inputId}>\r\n        {t(locale, 'project.load')}\r\n      </label>\r\n      <input\r\n        id={inputId}\r\n        type=\"file\"\r\n        accept=\"application/json,.json\"\r\n        className={styles.fileInput}\r\n        onChange={chooseFile}\r\n      />\r\n      {failed ? (\r\n        <span role=\"alert\" className={styles.failure}>\r\n          {t(locale, 'project.loadFailed')}\r\n        </span>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n","exit_code":0,"status":"completed"}}
