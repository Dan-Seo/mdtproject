{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/lib/persist/indexeddb.ts -Raw'","aggregated_output":"import {\r\n  deserializeProject,\r\n  serializeProject,\r\n  type Project,\r\n} from '@/domain/model/project'\r\n\r\nconst DATABASE_NAME = 'kijun'\r\nconst DATABASE_VERSION = 1\r\nconst STORE_NAME = 'project'\r\n/** 岳앭춼?쇻굥旅덁뻑??만?ヤ??ㅳ귝죭餓뜸?誤㎯겘?얇걽?▲걚??*/\r\nconst RECORD_KEY = 'current'\r\n\r\n/**\r\n * ??씊訝誤㎯겘?삠꺂?믤돀?ㅳ걼?녈겓 Project ?믣량?쀦쎘?덀굥??겎???볣뜷1?멥걤渦쇈겳?졼겏\r\n * ?ε뒟訝?걳?ｃ겏 IndexedDB ?믣룴?뤵귝돀?←탞?뤵겂?╉걢?됪쎑?뤵?\n */\r\nexport const AUTOSAVE_DEBOUNCE_MS = 500\r\n\r\nfunction openDatabase(): Promise<IDBDatabase> {\r\n  return new Promise((resolve, reject) => {\r\n    const request = indexedDB.open(DATABASE_NAME, DATABASE_VERSION)\r\n\r\n    request.onupgradeneeded = () => {\r\n      if (!request.result.objectStoreNames.contains(STORE_NAME)) {\r\n        request.result.createObjectStore(STORE_NAME)\r\n      }\r\n    }\r\n    request.onsuccess = () => resolve(request.result)\r\n    request.onerror = () => reject(request.error)\r\n    request.onblocked = () => reject(new Error('IndexedDB open blocked'))\r\n  })\r\n}\r\n\r\nfunction run<T>(\r\n  mode: IDBTransactionMode,\r\n  operation: (store: IDBObjectStore) => IDBRequest<T>,\r\n): Promise<T> {\r\n  return openDatabase().then(\r\n    (database) =>\r\n      new Promise<T>((resolve, reject) => {\r\n        // transaction ??퐳?먦겘?뚧쐿?ユ뒘?믡굥 (?밤깉?㏂겗?▲걚 DB ?ゃ굢\r\n        // NotFoundError)?귛풄冶뗦쑌?뚣궎?쇻꺍?덀깗?녈깋?⒲겗訝?겓?쀣걢?▲걚?ⓦ?\n        // ?앫겗?η텥?뚪뼀?꾠걼?얇겲?쇈겞?뷩걮??빊?졼걨餘뗣굥?붶빳孃뚣겗?ゅ땿岳앭춼??\n        // 麗면걽?ュㅁ?쀣걮?곭뎵?믢툓?믡굥?ⓦ걤 onblocked ?㎪??얇굥??\n        let transaction: IDBTransaction\r\n        let request: IDBRequest<T>\r\n        try {\r\n          transaction = database.transaction(STORE_NAME, mode)\r\n          request = operation(transaction.objectStore(STORE_NAME))\r\n        } catch (error) {\r\n          database.close()\r\n          reject(error)\r\n          return\r\n        }\r\n\r\n        transaction.oncomplete = () => {\r\n          database.close()\r\n          resolve(request.result)\r\n        }\r\n        transaction.onerror = () => {\r\n          database.close()\r\n          reject(transaction.error)\r\n        }\r\n        transaction.onabort = () => {\r\n          database.close()\r\n          reject(transaction.error)\r\n        }\r\n      }),\r\n  )\r\n}\r\n\r\nexport async function saveProject(project: Project): Promise<void> {\r\n  await run('readwrite', (store) =>\r\n    store.put(serializeProject(project), RECORD_KEY),\r\n  )\r\n}\r\n\r\n/**\r\n * 孃⒴뀇?㎯걤?ゃ걚?귙겗??퍢?ｃ겍?ⓦ겍??null ?믦퓭????壅룟땿永뚩러?ゃ겗?㎯곥걪?볝겎?뺛걩?뗣겏\r\n * 易덀걲?뗧쳦?╉겗?ゃ걚?얇겲?삯씊?뚨쇋?뤵겒?뗣귝뿧 schemaVersion ?귛즸?뚣걼?뉐춻?쀣굚?뚣걯\r\n * ?긱걚?? ?⒲걾?됥굚?뚣걪??쮼?꿔겎??돈?뺛겎?띲겒?꾠띴빳訝듽겗?볝겏?믣닶?②끹겓鼇?덀겒?꾠?\n */\r\nexport async function loadStoredProject(): Promise<Project | null> {\r\n  try {\r\n    const stored = await run<string | undefined>('readonly', (store) =>\r\n      store.get(RECORD_KEY),\r\n    )\r\n    if (typeof stored !== 'string') return null\r\n\r\n    return deserializeProject(stored)\r\n  } catch {\r\n    return null\r\n  }\r\n}\r\n\r\nexport async function clearStoredProject(): Promise<void> {\r\n  try {\r\n    await run('readwrite', (store) => store.delete(RECORD_KEY))\r\n  } catch {\r\n    // 易덀걵?ゃ걚?볝겏?믣닶?②끹겓鴉앫걟?╉굚?볝겇?뗣걣?▲걚??\n  }\r\n}\r\n\r\nexport interface Autosave {\r\n  (project: Project): void\r\n  /**\r\n   * 孃끹겂?╉걚?뗦쎑?띹씔?욍굮餓듽걲?먨눣?쇻귡쟻?믧썴?뚣굥?귙겓?쇈겤 ???볝걾永귙굩?ｃ겍\r\n   * 500ms 餓ε냵?ラ뻾?섅굢?뚣굥?ⓦ곥뚦뎺?욁겗泳싥걤?띲굮?삠걲艅잒꺗?뚧?孃뚣겗訝?볝굮?썬겏?쇻?\n   */\r\n  flush(): void\r\n}\r\n\r\nexport function createAutosave(\r\n  write: (project: Project) => Promise<void> = saveProject,\r\n): Autosave {\r\n  let timer: ReturnType<typeof setTimeout> | null = null\r\n  let pending: Project | null = null\r\n  // ?멥걤渦쇈겳??뫜?녑눣?쀣걫?ⓦ겓?η텥?믧뼀?띸쎍?쇻겗?㎯곲뇥?ゃ굥??commit ??젂??\n  // ?γ굦?욍굩?듽걝?????끹굦?잌룮?꾣죭餓뜰걣?孃뚣겓餘뗣굥?귡젂?ヤ??ㅳ걳?ㅵ눣?쇻?\n  //\r\n  // 孃끹걾烏뚦닓????ㅳ걤?듽걽?귡럷?ョ찉??ⓦ곲쟻?믧썴?뚣굥?귙겗 flush ?뚨찉?얇굦?잌늽??\n  // 孃뚣굧?ュ썮?듽걇pen ?쇻굢?븃죱?㎯걤?ゃ걚?얇겲?뉑쎑?뚦즸?뺛굦????flushOnLeave ??\n  // 掠끹굥??겘?얇걬?ャ걹??졃?덀걽?귝죭餓뜰겘驪롥썮?얇굥?붵겏?멥걤?담걲??겎?곩푷?ㅹ뼋??\n  // 瓦썬걚擁듽걬?뚣걼?ㅳ걚?덀겘?썬겏?쀣겍?덀걚??\n  let inFlight: Promise<void> | null = null\r\n  let queued: Project | null = null\r\n\r\n  const drain = () => {\r\n    if (inFlight !== null || queued === null) return\r\n\r\n    const target = queued\r\n    queued = null\r\n    // 岳앭춼?㎯걤?ゃ걚?볝겏?や퐪??퐳璵?굮閭㏂굙?뗧릤?긱겓?ゃ굢?ゃ걚 ??鼇덄츞??깣?⒲궑?뜹냵??\n    // 若뚨탳?쀣겍?꾠굥?귙궭?ㅳ깯?쇈겗訝?겒??겎?곫뒘?믡겍?귟ぐ?귝뜒?얇걟?됥굦?ゃ걚??\n    inFlight = write(target)\r\n      .catch(() => {})\r\n      .then(() => {\r\n        inFlight = null\r\n        drain()\r\n      })\r\n  }\r\n\r\n  const flush = () => {\r\n    if (timer !== null) {\r\n      clearTimeout(timer)\r\n      timer = null\r\n    }\r\n\r\n    const target = pending\r\n    pending = null\r\n    if (target === null) return\r\n\r\n    queued = target\r\n    drain()\r\n  }\r\n\r\n  const autosave = (project: Project) => {\r\n    pending = project\r\n    if (timer !== null) clearTimeout(timer)\r\n    timer = setTimeout(flush, AUTOSAVE_DEBOUNCE_MS)\r\n  }\r\n\r\n  autosave.flush = flush\r\n  return autosave\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
