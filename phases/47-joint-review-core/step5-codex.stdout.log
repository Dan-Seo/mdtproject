es,\\r\\n  carveBox,\\r\\n  rebarRadius,\\r\\n  rebarSegments,\\r\\n  roleToLayer,\\r\\n  type Bounds,\\r\\n  type Point3,\\r\\n  type RadiusOf,\\r\\n  type RebarLayer,\\r\\n} from './geometry'\\r\\n\\r\\nexport interface ConcreteBox {\\r\\n  memberId: string\\r\\n  kind: MemberKind\\r\\n  /** 諛뺤뒪 以묒떖 (mm) */\\r\\n  center: Point3\\r\\n  /** 諛뺤뒪 ?ш린 [x, y, z] (mm) */\\r\\n  size: Point3\\r\\n  /**\\r\\n   * ?녶숱?긱걽?묊쳦鵝볝걣鸚됥굩?뗣굎ize ??쨼?ε?力뺛겗?얇겲?ゃ겗?㎫쎍孃꾠겘 size[0] ?㎯걗?듽?\\n   * 鸚㎪쥈??냵力뺛굚?멩뒢??퐪?잆굤?ㅵ츣?귛쨼?ε?力뺛겎黎뷩겲?ｃ걼?얇겲?뺛걦 (ADR-027)??\\n   */\\r\\n  shape?: ColumnShape\\r\\n}\\r\\n\\r\\nexport interface RebarInstance {\\n  memberId: string\\n  rebarId: string\\n  barIndex: number\\n  segmentIndex: number\\n  from: Point3\\n  to: Point3\\r\\n  /** buildingLayout ?ユ륫?쀣걼 radiusOf ?뚦눣?쀣걼?듿푶 (mm)?귝뿢若싥겘烏①ㅊ?ㅳ걽??*/\\r\\n  radius: number\\r\\n  /** ?쇈겞?띲귝쎑?띶눣?숁Æ?뗣겘烏①ㅊ?듿푶?㎯겘?ゃ걦閭ㅵ눇?뗣굢若잌??믣눣?쇻?*/\\r\\n  size: ShearBarSize\\r\\n  /**\\r\\n   * 壤밧돯?앫겗?얇겲 (?귙겙?됬춮?삭끃嶺뗢??굃ayer ??말嶺?躍?춮???ㅳ겓?녈굯?좄〃鹽뷴뙷?녴겎??\\n   * ?멥걤?뷩걲與▼엹?㎯걹?뚣굮?띶뎺?ヤ슴?녴겏 ?귙겙?됬춮 ?뚣뚦릭嶺뗣띲겏?쀣겍?멩뎸?ユ륫?뗣?\\n   */\\r\\n  role: RebarRole\\r\\n  layer: RebarLayer\\r\\n}\\r\\n\\r\\nexport interface BuildingLayout {\\r\\n  boxes: ConcreteBox[]\\r\\n  rebar: RebarInstance[]\\r\\n  bounds: Bounds\\r\\n}\\r\\n\\r\\ninterface CantileverSlabGeometry {\\r\\n  originX: number\\r\\n  originY: number\\r\\n  width: number\\r\\n  height: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * 亮녜씊?㎯겗?⒴숱??3D ??렅?밤꺕野멩퀡?ョ쎍?쇻걽?묆걽?귞윪壤㏂걹??굚??겘\\r\\n * `cantileverSlabRect` ?뚧똻????亮녜씊?싥궎?녈겏?뚣걯訝?ㅳ겗?뷸??㎯걗?뗣?\\n */\\r\\nfunction cantileverSlabGeometry(\\r\\n  project: Project,\\r\\n  member: Member,\\r\\n): CantileverSlabGeometry {\\r\\n  const rect = cantileverSlabRect(project, member)\\r\\n\\r\\n  return {\\r\\n    originX: rect.minX,\\r\\n    originY: rect.minY,\\r\\n    width: rect.maxX - rect.minX,\\r\\n    height: rect.maxY - rect.minY,\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction emptyBounds(): Bounds {\\r\\n  return {\\r\\n    min: [Infinity, Infinity, Infinity],\\r\\n    max: [-Infinity, -Infinity, -Infinity],\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction expandBounds(bounds: Bounds, point: Point3, margin = 0): void {\\r\\n  for (let axis = 0; axis < 3; axis += 1) {\\r\\n    bounds.min[axis] = Math.min(bounds.min[axis], point[axis] - margin)\\r\\n    bounds.max[axis] = Math.max(bounds.max[axis], point[axis] + margin)\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction translate(point: Point3, offset: Point3): Point3 {\\n  return [point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]]\\n}\\n\\nexport function memberWorldPoint(\\n  project: Project,\\n  member: Member,\\n): (point: Point3) => Point3 {\\n  const section = findSection(project, member.sectionId)\\n\\n  if (member.kind === '??) {\\n    if (section.kind !== '?? || 'axis' in member.position) {\\n      throw new Error(`??member references a non-??section: ${member.id}`)\\n    }\\n    const { x, y } = gridPoint(project.grid, member.position.ix, member.position.iy)\\n    const offset: Point3 = [\\n      x - section.b / 2,\\n      storyElevation(project.stories, member.storyId),\\n      y - section.d / 2,\\n    ]\\n    return (point) => translate(point, offset)\\n  }\\n\\n  if (member.kind === '鸚㎪쥈') {\\n    if (section.kind !== '鸚㎪쥈' || !('axis' in member.position)) {\\n      throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${member.id}`)\\n    }\\n    const story = project.stories.find(({ id }) => id === member.storyId)\\n    if (!story) throw storyNotFound(member.storyId)\\n    const start = gridPoint(project.grid, member.position.ix, member.position.iy)\\n    const span = girderSpan(project, member)\\n    const base = storyElevation(project.stories, member.storyId) + story.height - section.depth\\n\\n    return member.position.axis === 'X'\\n      ? ([x, y, z]) => [\\n          start.x + span.startFaceOffsetMm + x,\\n          base + y,\\n          start.y - section.b / 2 + z,\\n        ]\\n      : ([x, y, z]) => [\\n          start.x - section.b / 2 + z,\\n          base + y,\\n          start.y + span.startFaceOffsetMm + x,\\n        ]\\n  }\\n\\n  if (member.kind === '佯딀씮') {\\n    if (section.kind !== '佯딀씮') {\\n      throw new Error(`佯딀씮 member references a non-佯딀씮 section: ${member.id}`)\\n    }\\n    const story = project.stories.find(({ id }) => id === member.storyId)\\n    if (!story) throw storyNotFound(member.storyId)\\n    const base = storyElevation(project.stories, member.storyId) + story.height - section.thickness\\n\\n    if (isCantileverSlabMember(member)) {\\n      const geometry = cantileverSlabGeometry(project, member)\\n      return ([x, y, z]) => [geometry.originX + x, base + z, geometry.originY + y]\\n    }\\n\\n    if ('axis' in member.position) {\\n      throw new Error(`佯딀씮 position is invalid: ${member.id}`)\\n    }\\n    const origin = gridPoint(project.grid, member.position.ix, member.position.iy)\\n    const bay = slabBay(project, member)\\n    return ([x, y, z]) => [\\n      origin.x + bay.startFaceOffsetXMm + x,\\n      base + z,\\n      origin.y + bay.startFaceOffsetYMm + y,\\n    ]\\n  }\\n\\n  if (section.kind !== '?먬쐡鶯? || !('axis' in member.position)) {\\n    throw new Error(`?먬쐡鶯?member references a non-?먬쐡鶯?section: ${member.id}`)\\n  }\\n  const start = gridPoint(project.grid, member.position.ix, member.position.iy)\\n  const span = wallSpan(project, member)\\n  const rangeOrigin = span.originOffsetMm ?? { along: 0, height: 0 }\\n  const base = storyElevation(project.stories, member.storyId)\\n\\n  return member.position.axis === 'X'\\n    ? ([x, y, z]) => [\\n        start.x + span.startFaceOffsetMm + rangeOrigin.along + x,\\n        base + rangeOrigin.height + y,\\n        start.y - section.thickness / 2 + z,\\n      ]\\n    : ([x, y, z]) => [\\n        start.x - section.thickness / 2 + z,\\n        base + rangeOrigin.height + y,\\n        start.y + span.startFaceOffsetMm + rangeOrigin.along + x,\\n      ]\\n}\\n\\n/**\\n * 兩븀돥 酉곗쓽 ?쒖닔 ?덉씠?꾩썐 (DESIGN.md 짠7). ??遺?ъ쓽 肄섑겕由ы듃 ?명삎怨?\\n * 吏??遺?ъ쓽 諛곌렐 ?몄뒪?댁뒪瑜?mm 醫뚰몴濡??꾧컻?쒕떎. ?깅뒗 洹몃━??援먯젏??\\n * ?⑤㈃ 以묒떖???뺣젹?섍퀬, 鸚㎪쥈??醫뚯륫 ?깅㈃쨌諛묐㈃쨌??紐⑥꽌由щ? 濡쒖뺄 ?먯젏?쇰줈 ?대떎.\\r\\n * 誘몄???鸚㎪쥈??肄섑겕由ы듃 諛뺤뒪留??④린怨?泥좉렐???꾧컻?섏? ?딅뒗??(R7 ??.\\r\\n */\\r\\nexport function buildingLayout(\\r\\n  project: Project,\\r\\n  rebars: Rebar[],\\r\\n  unsupportedMemberIds: ReadonlySet<string>,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n): BuildingLayout {\\r\\n  const boxes: ConcreteBox[] = []\\r\\n  const instances: RebarInstance[] = []\\r\\n  const bounds = emptyBounds()\\r\\n\\r\\n  for (const member of project.members) {\\r\\n    const story = project.stories.find(({ id }) => id === member.storyId)\\r\\n    if (!story) {\\r\\n      throw storyNotFound(member.storyId)\\r\\n    }\\r\\n    const elevation = storyElevation(project.stories, member.storyId)\\r\\n    const section = findSection(project, member.sectionId)\\r\\n\\r\\n    let box: ConcreteBox\\r\\n    // ?뗥룭?ⓦ겎?뤵굤?쒌걚?잏졃?뉎귛즯?삣틞?욍걽?묆걣?곥겇 (1?싧뎴8))\\r\\n    let pieces: ConcreteBox[] | null = null\\r\\n    if (member.kind === '??) {\\r\\n      if (section.kind !== '?? || 'axis' in member.position) {\\r\\n        throw new Error(`??member references a non-??section: ${member.id}`)\\r\\n      }\\r\\n      const { x, y } = gridPoint(\\r\\n        project.grid,\\r\\n        member.position.ix,\\r\\n        member.position.iy,\\r\\n      )\\r\\n      box = {\\r\\n        memberId: member.id,\\r\\n        kind: '??,\\r\\n        center: [x, elevation + story.height / 2, y],\\r\\n        size: [section.b, story.height, section.d],\\r\\n        shape: section.shape,\\r\\n      }\\r\\n    } else if (member.kind === '鸚㎪쥈') {\\r\\n      if (section.kind !== '鸚㎪쥈' || !('axis' in member.position)) {\\r\\n        throw new Error(\\r\\n          `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${member.id}`,\\r\\n        )\\r\\n      }\\r\\n      const position = member.position\\r\\n      const start = gridPoint(project.grid, position.ix, position.iy)\\r\\n      const end =\\r\\n        position.axis === 'X'\\r\\n          ? gridPoint(project.grid, position.ix + 1, position.iy)\\r\\n          : gridPoint(project.grid, position.ix, position.iy + 1)\\r\\n      // 鸚㎪쥈 ?곷떒??痢?泥쒖옣??留욎텣??\\r\\n      const centerY = elevation + story.height - section.depth / 2\\r\\n      box =\\r\\n        position.axis === 'X'\\r\\n          ? {\\r\\n              memberId: member.id,\\r\\n              kind: '鸚㎪쥈',\\r\\n              center: [(start.x + end.x) / 2, centerY, start.y],\\r\\n              size: [end.x - start.x, section.depth, section.b],\\r\\n            }\\r\\n          : {\\r\\n              memberId: member.id,\\r\\n              kind: '鸚㎪쥈',\\r\\n              center: [start.x, centerY, (start.y + end.y) / 2],\\r\\n              size: [section.b, section.depth, end.y - start.y],\\r\\n            }\\r\\n    } else if (member.kind === '佯딀씮') {\\r\\n      if (section.kind !== '佯딀씮') {\\r\\n        throw new Error(`佯딀씮 member references a non-佯딀씮 section: ${member.id}`)\\r\\n      }\\r\\n      // 佯딀씮?귛냵力뺡깿?녴걹??굚??걽竊덅변鵝볝겗?뷴늽竊덌폇竊됥뚧윶?곫쥈嶺됥겓?γ걲?뗦객亮녔쓲??\\n      // ?끾퀡?ⓨ늽?랃펹?귡싥굤??뼋?㎪룒?뤵겏鸚㎪쥈?③뇥?ゃ겂?잍씮?ャ겒?뗣?\\n      const topY = elevation + story.height\\r\\n      if (isCantileverSlabMember(member)) {\\r\\n        const geometry = cantileverSlabGeometry(project, member)\\r\\n        box = {\\r\\n          memberId: member.id,\\r\\n          kind: '佯딀씮',\\r\\n          center: [\\r\\n            geometry.originX + geometry.width / 2,\\r\\n            topY - section.thickness / 2,\\r\\n            geometry.originY + geometry.height / 2,\\r\\n          ],\\r\\n          size: [geometry.width, section.thickness, geometry.height],\\r\\n        }\\r\\n        pieces = carveBox(\\r\\n          box,\\r\\n          [0, 2],\\r\\n          boxHoles(member.openings ?? [], geometry.originX, geometry.originY),\\r\\n        )\\r\\n      } else {\\r\\n        if ('axis' in member.position) {\\r\\n          throw new Error(`佯딀씮 position is invalid: ${member.id}`)\\r\\n        }\\r\\n        // 佯딀씮???? x ??툟?뚣겗 x竊덅뻗0竊됥곩?? y ??툟?뚣겗 z竊덅뻗2竊됥걽?귡뼀?ｉ깿??\\n        // ?뤵굤?쒌걦 ???곈뇧?뚧쵟?ㅳ걮?╉걚?뗣겗?ユ씮?뚦줊?뚣겂?╉걚?╉겘沃ф삇?뚥퍡?뗣겒?꾠?\\n        const origin = gridPoint(\\r\\n          project.grid,\\r\\n          member.position.ix,\\r\\n          member.position.iy,\\r\\n        )\\r\\n        const bay = slabBay(project, member)\\r\\n        const slabOriginX = origin.x + bay.startFaceOffsetXMm\\r\\n        const slabOriginZ = origin.y + bay.startFaceOffsetYMm\\r\\n        box = {\\r\\n          memberId: member.id,\\r\\n          kind: '佯딀씮',\\r\\n          center: [\\r\\n            slabOriginX + bay.clearXMm / 2,\\r\\n            topY - section.thickness / 2,\\r\\n            slabOriginZ + bay.clearYMm / 2,\\r\\n          ],\\r\\n          size: [bay.clearXMm, section.thickness, bay.clearYMm],\\r\\n        }\\r\\n        pieces = carveBox(\\r\\n          box,\\r\\n          [0, 2],\\r\\n          boxHoles(member.openings ?? [], slabOriginX, slabOriginZ),\\r\\n        )\\r\\n      }\\r\\n    } else {\\r\\n      if (section.kind !== '?먬쐡鶯? || !('axis' in member.position)) {\\r\\n        throw new Error(\\r\\n          `?먬쐡鶯?member references a non-?먬쐡鶯?section: ${member.id}`,\\r\\n        )\\r\\n      }\\r\\n      // 鶯곥겘翁?퐪??뙷?놅펷寧?渶①К1塋좂К2影竊덌폊竊됧즯竊됥겎?뚧윶?곫쥈?곩틞?욜춬?ユ렏?쇻굥\\r\\n      // ?귞쎍?먦겗?끾퀡?ⓨ늽?띲겒??겎?곭??귛냵力뺛겎?뤵걦 ??訝?퓘?볝겎?뤵걦?ⓩ윶?삣ㄷ歟곥겏\\r\\n      // ?띲겒?ｃ걼塋뗤퐪?ャ겒?듽곫빊?륅펷?끾퀡竊됥겏誤뗣걼??걣繇잆걚?뺛걝??\\n      const position = member.position\\r\\n      const start = gridPoint(project.grid, position.ix, position.iy)\\r\\n      const span = wallSpan(project, member)\\r\\n      const rangeOrigin = span.originOffsetMm ?? { along: 0, height: 0 }\\r\\n      const alongCenter =\\r\\n        span.startFaceOffsetMm + rangeOrigin.along + span.clearLengthMm / 2\\r\\n      const centerY = elevation + rangeOrigin.height + span.clearHeightMm / 2\\r\\n      // 鶯곥겗掠? x ??싥굤??겗?묆걤竊늌?싥굤?ゃ굢訝뽫븣??x 竊?邕??갳?싥굤?ゃ굢\\r\\n      // 訝뽫븣??z 竊?邕?竊됥곩?? y ??쳵??竊?邕? ?㎯걗?뗣?\\n      const alongOrigin =\\r\\n        (position.axis === 'X' ? start.x : start.y) +\\r\\n        span.startFaceOffsetMm +\\r\\n        rangeOrigin.along\\r\\n      const holes = boxHoles(\\r\\n        member.openings ?? [],\\r\\n        alongOrigin,\\r\\n        elevation + rangeOrigin.height,\\r\\n      )\\r\\n      box =\\r\\n        position.axis === 'X'\\r\\n          ? {\\r\\n              memberId: member.id,\\r\\n              kind: '?먬쐡鶯?,\\r\\n              center: [start.x + alongCenter, centerY, start.y],\\r\\n              size: [span.clearLengthMm, span.clearHeightMm, section.thickness],\\r\\n            }\\r\\n          : {\\r\\n              memberId: member.id,\\r\\n              kind: '?먬쐡鶯?,\\r\\n              center: [start.x, centerY, start.y + alongCenter],\\r\\n              size: [section.thickness, span.clearHeightMm, span.clearLengthMm],\\r\\n            }\\r\\n      pieces = carveBox(box, position.axis === 'X' ? [0, 1] : [2, 1], holes)\\r\\n    }\\r\\n\\r\\n    // ?뤵걦??겘?뤵굤?쒌걚?잏졃?뉎걽?뚣곫옞??틕?뚣굤??뀇????㎪릍?????뗥룭?㎩쨼壤㏂걣\\r\\n    // 鸚됥굩?뗣굩?묆겎??겒?꾠걮?곩뀲?㏂걣?뗥룭??깿?먦겘?됥깳?ㅳ꺍?뚦뀍?ヨ맼?ⓦ걮?╉걚?뗣?\\n    boxes.push(...(pieces ?? [box]))\\r\\n    expandBounds(bounds, [\\r\\n      box.center[0] - box.size[0] / 2,\\r\\n      box.center[1] - box.size[1] / 2,\\r\\n      box.center[2] - box.size[2] / 2,\\r\\n    ])\\r\\n    expandBounds(bounds, [\\r\\n      box.center[0] + box.size[0] / 2,\\r\\n      box.center[1] + box.size[1] / 2,\\r\\n      box.center[2] + box.size[2] / 2,\\r\\n    ])\\r\\n  }\\r\\n\\r\\n  for (const rebar of rebars) {\\r\\n    const member = project.members.find(({ id }) => id === rebar.memberId)\\r\\n    if (!member) {\\r\\n      throw new Error(`Member not found: ${rebar.memberId}`)\\r\\n    }\\r\\n    if (unsupportedMemberIds.has(member.id)) continue\\r\\n\\r\\n    const section = findSection(project, member.sectionId)\\r\\n    const worldPoint = memberWorldPoint(project, member)\\n    // ?뗥룭?ⓦ겘?꾤춮????佯㎪쮽楹삠겎?뉎굥 (1?싧뎴8))?귛즯??깿?먨???앫겗?얇겲?곩틞?욍겘\\r\\n    // ?꾤춮?뚣꺀?녈겎歷с굢?뚣겍?꾠굥??겎?⒲꺍佯㎪쮽??굚??굮鵝욍걝??\\n    let openings: Opening[] = []\\r\\n\\r\\n    if (member.kind === '佯딀씮') {\\n      openings = slabRun(\\n        project,\\n        member,\\n        rebar.role.startsWith('X?밧릲') ? 'X' : 'Y',\\n      ).openings\\n    } else if (member.kind === '?먬쐡鶯?) {\\n      openings = member.openings ?? []\\n    }\\n\\r\\n    const layer = roleToLayer(rebar.role)\\n    const segmentIndices = new Map<number, number>()\\n\\r\\n    for (const segment of rebarSegments(rebar, section, radiusOf, openings)) {\\r\\n      const from = worldPoint(segment.from)\\n      const to = worldPoint(segment.to)\\n      const barIndex = segment.barIndex ?? 0\\n      const segmentIndex = segmentIndices.get(barIndex) ?? 0\\n      segmentIndices.set(barIndex, segmentIndex + 1)\\n      instances.push({\\n        memberId: member.id,\\n        rebarId: rebar.id,\\n        barIndex,\\n        segmentIndex,\\n        from,\\r\\n        to,\\r\\n        radius: segment.radius,\\r\\n        size: rebar.size,\\r\\n        role: rebar.role,\\r\\n        layer,\\r\\n      })\\r\\n      expandBounds(bounds, from, segment.radius)\\r\\n      expandBounds(bounds, to, segment.radius)\\r\\n    }\\r\\n  }\\r\\n\\r\\n  if (boxes.length === 0 && instances.length === 0) {\\r\\n    return { boxes, rebar: instances, bounds: { min: [0, 0, 0], max: [0, 0, 0] } }\\r\\n  }\\r\\n\\r\\n  return { boxes, rebar: instances, bounds }\\r\\n}\\r\\n\\r\\n/** InstancedMesh???꾩옱 ?덉씠???좉? 寃쎄퀎??留욎떠 ?쒖떆 ?덉씠?는룸컲寃쎈퀎 ?섎굹?? */\\r\\nexport function groupInstancesByLayerAndRadius(\\r\\n  instances: RebarInstance[],\\r\\n): Map<string, RebarInstance[]> {\\r\\n  const groups = new Map<string, RebarInstance[]>()\\r\\n\\r\\n  for (const instance of instances) {\\r\\n    const key = `${instance.radius}|${instance.layer}`\\r\\n    const group = groups.get(key)\\r\\n    if (group === undefined) groups.set(key, [instance])\\r\\n    else group.push(instance)\\r\\n  }\\r\\n\\r\\n  return groups\\r\\n}\\r\\n\\r\\nimport {\\r\\n  decomposeGirderMainRow,\\r\\n  type ColumnSection,\\r\\n  type GirderMainRow,\\r\\n  type GirderSection,\\r\\n  type Opening,\\r\\n  type Section,\\r\\n  type ShearBarSize,\\r\\n  type SlabBarRow,\\r\\n  type SlabSection,\\r\\n  type WallSection,\\r\\n} from '@/domain/model/member'\\r\\nimport type {\\r\\n  Rebar,\\r\\n  RebarPlacement,\\r\\n  RebarRole,\\r\\n  RebarZone,\\r\\n} from '@/domain/model/rebar'\\r\\nimport { stirrupPositions } from '@/domain/rebar/stirrup-layout'\\r\\n\\r\\nexport type Point3 = [number, number, number]\\r\\n\\r\\nexport interface Segment {\\n  from: Point3\\n  to: Point3\\n  radius: number\\n  barIndex?: number\\n  hookTail?: boolean\\n}\\r\\n\\r\\nexport interface Bounds {\\r\\n  min: Point3\\r\\n  max: Point3\\r\\n}\\r\\n\\r\\nexport type ClipAxis = 'x' | 'y' | 'z'\\r\\n\\r\\n/**\\r\\n * mm 醫뚰몴怨꾩쓽 ?덈떒 ?꾩튂瑜?THREE.Plane怨?媛숈? normal/constant ?뺥깭濡?留뚮뱺??\\r\\n * +異?normal??constant = ?뭦osition?대?濡??⑤뒗 ?곸뿭? [position, max]????\\n * ratio媛 而ㅼ쭏?섎줉 醫곸븘吏怨?ratio=1?대㈃ ?꾨? ?섎┛??\\r\\n * scene ?⑥쐞 蹂?섏? ?뚮뜑??寃쎄퀎?먯꽌留??섑뻾?쒕떎.\\r\\n */\\r\\nexport function clipPlaneForMm(\\r\\n  bounds: { min: Point3; max: Point3 },\\r\\n  axis: ClipAxis,\\r\\n  ratio: number,\\r\\n): { normal: Point3; constantMm: number } {\\r\\n  assertBounds(bounds)\\r\\n  if (!Number.isFinite(ratio) || ratio < 0 || ratio > 1) {\\r\\n    throw new Error(`Invalid clip ratio: ${ratio}`)\\r\\n  }\\r\\n\\r\\n  const axisIndex = axis === 'x' ? 0 : axis === 'y' ? 1 : 2\\r\\n  const positionMm =\\r\\n    bounds.min[axisIndex] +\\r\\n    (bounds.max[axisIndex] - bounds.min[axisIndex]) * ratio\\r\\n  const normal: Point3 = [0, 0, 0]\\r\\n  normal[axisIndex] = 1\\r\\n\\r\\n  return { normal, constantMm: -positionMm }\\r\\n}\\r\\n\\r\\nexport interface CameraFit {\\r\\n  position: Point3\\r\\n  target: Point3\\r\\n}\\r\\n\\r\\nexport const CAMERA_FOV_DEGREES = 38\\r\\nexport const CAMERA_FRAME_MARGIN = 1.08\\r\\nexport const CAMERA_DIRECTION: Point3 = [0.72, 0.34, 0.86]\\r\\n\\r\\nconst MINIMUM_DISPLAY_DIAMETER = 14\\r\\nconst DISPLAY_DIAMETER_SCALE = 1.6\\r\\n\\r\\nexport type RebarLayer = 'main' | 'hoop' | 'hidden'\\r\\n\\r\\nexport function roleToLayer(role: RebarRole): RebarLayer {\\r\\n  switch (role) {\\r\\n    case '訝사춮':\\r\\n    case '訝딁ク嶺?:\\r\\n    case '訝뗧ク嶺?:\\r\\n    case '訝딁ク?ャ긿?덀궕?뺟춮':\\r\\n    case '訝뗧ク?ャ긿?덀궕?뺟춮':\\r\\n      return 'main'\\r\\n    case '躍?춮':\\r\\n    case '?귙겙?됬춮':\\r\\n    // 亮끾??곭춮? ?귙겙?됬춮??寃곗냽?섎뒗 媛濡?諛⑺뼢 蹂댁“洹쇱씠??媛숈? ?덉씠?댁뿉 ?붾떎.\\r\\n    case '亮끾??곭춮':\\r\\n      return 'hoop'\\r\\n    // ?밭춮? ?ㅽ뙩 諛⑺뼢?쇰줈 ?먮Ⅴ???몃줈洹쇱씠??訝사춮怨?媛숈? ?덉씠?대떎.\\r\\n    case '?밭춮':\\r\\n    // ?먬쐡鶯곸쓽 潁?춮? 遺?ъ텞???곕씪 ?먮Ⅴ???몃줈洹쇱씠??訝사춮怨?媛숇떎.\\r\\n    case '潁?춮':\\r\\n      return 'main'\\r\\n    // 與ょ춮? 洹??몃줈洹쇱쓣 媛濡쒖?瑜대뒗 諛곕젰洹쇱씠??躍?춮쨌?귙겙?됬춮怨?媛숈? ?덉씠?대떎.\\r\\n    case '與ょ춮':\\r\\n      return 'hoop'\\r\\n    // 佯딀씮??말嶺뗣걣2?밧릲?ヨ뎔?뗣걽?묆겎?⒲굦?귚말嶺뗣걽 ??訝듾툔??씊?믡꺃?ㅳ깶?쇈겎\\r\\n    // ?녴걨?ゃ걚?귛늽?묆굥?ⓦ뚥말嶺뗰폀躍?춮?띲겏?꾠걝?덀궛?ャ겗?뤷뫑?뚪깿?먦걫?ⓦ겓鸚됥굩?뗣?\\n    case 'X?밧릲訝딁ク嶺?:\\r\\n    case 'X?밧릲訝뗧ク嶺?:\\r\\n    case 'Y?밧릲訝딁ク嶺?:\\r\\n    case 'Y?밧릲訝뗧ク嶺?:\\r\\n      return 'main'\\r\\n    // ?뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑邕?쮼??빊?뤷뀯?쎼겎?귙굤??D壤®듁??퐳?녈걮?ゃ걚 (ADR-034)??\\n    case '?뗥룭獒쒎섭嶺?:\\r\\n      return 'hidden'\\r\\n    default: {\\r\\n      const unsupported: never = role\\r\\n      throw new Error(`Unsupported RebarRole: ${unsupported}`)\\r\\n    }\\r\\n  }\\r\\n}\\r\\n\\r\\n// ?쇈겞?띲겗?긷춻?믦맼?ⓦ걲?ⓨ뫜?녑푶?뚧츐????D13 ?귡쳵凉룟벧?쎼굯??짒凉루춮??K13?팗13 ??\\n// ?뚣걯誤뤹큵?㎯걗?ｃ겍?곥걪?볝겓?겹걮?꾣빊?ㅳ겘罌쀣걟?ゃ걚 (ADR-026)??\\nexport function barDiameter(size: ShearBarSize): number {\\r\\n  const diameter = Number(size.replace(/^[A-Z]+/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid bar size: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nexport function rebarRadius(size: ShearBarSize): number {\\r\\n  return (\\r\\n    Math.max(barDiameter(size), MINIMUM_DISPLAY_DIAMETER) *\\r\\n    DISPLAY_DIAMETER_SCALE\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?쇈겞?띲걢?됧뜇孃?(mm) ?믣눣?쇻귞뵽?㏂겘沃?겳?꾠걲?뺛겗?잆굙??〃鹽뷴?\\n * (`rebarRadius`)?믡곫쎑?띶눣?숁Æ?뗣겘若잌??믤륫?쇻?\\n *\\r\\n * ?듿푶??ㄺ?뺛걽?묆겎?ゃ걦**鵝띸쉰**?믤군?곥굥 ??躍?춮?믡걲?딀뒠?묆겒?꾠굠??\\n * 訝사춮?믣냵?담겦?γ굦?뗥늽?뚣걪?뚣걽?귛츪野멥겗與▼엹?ヨ〃鹽뷴ㅳ굮鵝욍걝?ⓦ?\\n * D13 躍?춮?틾25 訝사춮??84.8mm ?γ굥?붷츪?쎼겘 25.5mm ????訝사춮?뚩Þ鼇덀굠??\\n * 曆긱걦?뗣겲?ｃ걼與▼엹?믤륫?쇻걪?ⓦ겓?ゃ굥??\\n */\\r\\nexport type RadiusOf = (size: ShearBarSize) => number\\r\\n\\r\\n/**\\r\\n * `Rebar`???뚮???1蹂?+ ?ф빊?띾줈 紐⑤뜽留곷맂?????섎웾? 洹멸쾬?쇰줈 異⑸텇?섏?留?\\n * 3D???ㅼ젣 ?ф빊留뚰겮 洹몃젮???쒕떎. 諛곗튂??洹쒏틬?ㅺ? ?꾨땲???묐룄 洹쒖튃?대?濡?\\n * 猷고뙥???吏 ?딄퀬 ?⑤㈃ 移섏닔? ???諛곌렐 ?꾩튂?먯꽌留??좊룄?쒕떎.\\r\\n *\\r\\n * domain??points???뗣겤?딅㈃ 湲곗? 以묒떖?좎씠吏留? ?쒖떆 諛섍꼍(rebarRadius)??\\n * 怨쇱옣???덉쑝誘濡??쒖떆 怨듦컙?먯꽌??洹몃?濡?洹몃━硫?躍?춮怨?訝사춮??愿?듯븳??\\r\\n * 躍?춮? ?쒖떆 諛섍꼍留뚰겮, 訝사춮? 躍?춮 ?쒖떆 吏由?+ 訝사춮 ?쒖떆 諛섍꼍留뚰겮 ?덉そ?쇰줈\\r\\n * ?ｌ뼱 躍?춮 諛붽묑硫댁씠 ?뗣겤?딅㈃?? 訝사춮 ?쒕㈃??躍?춮 ?덉そ硫댁뿉 ?묓븯寃??쒕떎.\\r\\n */\\r\\nfunction columnRebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: ColumnSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  if (rebar.shape === 'hoop') {\\r\\n    return columnHoopPlacements(rebar)\\r\\n  }\\r\\n\\r\\n  const [insetX, , insetZ] = rebar.points[0]\\r\\n  const inward = 2 * radiusOf(section.hoop.size) + radiusOf(rebar.size)\\r\\n\\r\\n  // ?녶숱?? 躍?춮 ?덉そ **??*???깃컙寃⑹쑝濡??덈떎. ???諛곌렐???쒖옉 媛곷룄??\\r\\n  if (section.shape === '?녶숱') {\\r\\n    const centre = section.b / 2\\r\\n    const coverRadius = centre - insetX\\r\\n    const radius = Math.max(0, coverRadius - inward)\\r\\n    // 餓ｈ〃?띸춮???뗣겤?듿냶??-X ?담겗?밤겒??겎?곥걹?볝굮鰲믣벧??읃繹뽧겓?쇻굥??\\n    const start = Math.PI\\r\\n\\r\\n    return Array.from({ length: rebar.count }, (_, index): Point3 => {\\r\\n      const angle = start + (2 * Math.PI * index) / rebar.count\\r\\n      return [\\r\\n        centre + radius * Math.cos(angle) - insetX,\\r\\n        0,\\r\\n        centre + radius * Math.sin(angle) - insetZ,\\r\\n      ]\\r\\n    })\\r\\n  }\\r\\n\\r\\n  // ?⒴숱?? 躍?춮 ?덉そ ?ш컖???섎젅瑜??깃컙寃⑹쑝濡??덈떎. ???諛곌렐???쒖옉 紐⑥꽌由щ떎.\\r\\n  const width = Math.max(0, section.b - 2 * (insetX + inward))\\r\\n  const depth = Math.max(0, section.d - 2 * (insetZ + inward))\\r\\n  const perimeter = 2 * (width + depth)\\r\\n\\r\\n  return Array.from({ length: rebar.count }, (_, index): Point3 => {\\r\\n    const walked = (index * perimeter) / rebar.count\\r\\n\\r\\n    if (walked <= width) return [inward + walked, 0, inward]\\r\\n    if (walked <= width + depth) {\\r\\n      return [inward + width, 0, inward + walked - width]\\r\\n    }\\r\\n    if (walked <= 2 * width + depth) {\\r\\n      return [inward + width - (walked - width - depth), 0, inward + depth]\\r\\n    }\\r\\n    return [inward, 0, inward + depth - (walked - 2 * width - depth)]\\r\\n  })\\r\\n}\\r\\n\\r\\n/** 訝사춮 1餘듐겗?졾돯?듽귡싥걮嶺뗣겏?ャ긿?덀궕?뺟춮?뚦릪?섉??믣늽?묈릦?녴?*/\\r\\nfunction girderMainRowOf(\\r\\n  role: RebarRole,\\r\\n  section: GirderSection,\\r\\n): { row: GirderMainRow; upper: boolean; cutoff: boolean } {\\r\\n  switch (role) {\\r\\n    case '訝딁ク嶺?:\\r\\n      return { row: section.main.top, upper: true, cutoff: false }\\r\\n    case '訝딁ク?ャ긿?덀궕?뺟춮':\\r\\n      return { row: section.main.top, upper: true, cutoff: true }\\r\\n    case '訝뗧ク嶺?:\\r\\n      return { row: section.main.bottom, upper: false, cutoff: false }\\r\\n    case '訝뗧ク?ャ긿?덀궕?뺟춮':\\r\\n      return { row: section.main.bottom, upper: false, cutoff: true }\\r\\n    default:\\r\\n      throw new Error(`Unsupported 鸚㎪쥈 main role: ${role}`)\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction girderMainPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: GirderSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  const { row, upper, cutoff } = girderMainRowOf(rebar.role, section)\\r\\n  const decomposition = decomposeGirderMainRow(row)\\r\\n  // 餘듐겗渶뤸쑍?겹겘冶뗧ク?삡릎鸚?꺕永귞ク???鸚㎩ㅳ걽?귡싥걮嶺뗣걣?뗥뎺??옞?믣룚?듽?\\n  // nesting ?녻㎗?㎪군?얇겂?잌릢?ャ긿?덀궕?뺟춮?뚧츐?듽겗?졼굮?뽧굥 ??烏뚣걫?ⓦ겓?ⓨ퉭??\\n  // 佯껁걩?뗣겏?뚣걯?졼겓雅뚪뇥?ユ룒?뗣굦?뗣?\\n  const slots = Math.max(\\r\\n    row.startCount ?? row.endCount,\\r\\n    row.centerCount,\\r\\n    row.endCount,\\r\\n  )\\r\\n  const [, , insetZ] = rebar.points[0]\\r\\n  const inward = 2 * radiusOf(section.stirrup.size) + radiusOf(rebar.size)\\r\\n  const width = Math.max(0, section.b - 2 * (insetZ + inward))\\r\\n  const y = upper ? -inward : inward\\r\\n  // ?곈뇧??count ????뗦??귙걼?딀쑍??횞 鵝띸쉰?겹띲겒??겎?곫옞??빊??퐤營?겎?꿔굥??\\n  const offsets = rebar.axisOffsetsMm ?? [0]\\r\\n  const perPlacement = rebar.count / offsets.length\\r\\n  const firstSlot = cutoff\\r\\n    ? rebar.axisSlotStart ?? decomposition.throughCount\\r\\n    : 0\\r\\n\\r\\n  return offsets.flatMap((offsetMm) =>\\r\\n    Array.from({ length: perPlacement }, (_, index): Point3 => {\\r\\n      const slot = firstSlot + index\\r\\n      const z =\\r\\n        slots === 1\\r\\n          ? inward + width / 2\\r\\n          : inward + (slot * width) / (slots - 1)\\r\\n\\r\\n      return [offsetMm, y, z]\\r\\n    }),\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * 躍?춮 ?꾧컻???꾨찓??`stirrupPositions`媛 ?좎씪??異쒖쿂?? index횞pitch濡??섑??댄븯硫?\\n * ?끾퀡???쇱튂濡??섎늻?대뼥?댁?吏 ?딆쓣 ??留덉?留??ъ씠 ?끾퀡 諛뽰뿉 洹몃젮吏꾨떎.\\r\\n */\\r\\nfunction columnHoopPlacements(rebar: Rebar): Point3[] {\\r\\n  if (rebar.placement?.axis !== 'y') {\\r\\n    throw new Error(`躍?춮 y-axis placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = stirrupPositions(\\r\\n    rebar.placement.clearMm,\\r\\n    rebar.placement.pitchMm,\\r\\n    rebar.placement.startOffsetMm,\\r\\n  ).positionsMm\\r\\n\\r\\n  // ?議??곷???`count`(?곈뇧令띸츞?뷸틬??鼇?쮫?ф빊)媛 ?꾨땲??`positionCount`????\\n  // ?섏? ?뺣떦?섍쾶 ?ㅻⅤ??(ADR-019). ?꾨찓?몄씠 諛곗튂 ?몄옄? ?ㅻⅨ 媛쒖닔瑜??ㅼ뿀???뚮쭔 ?≫엺??\\r\\n  if (positions.length !== rebar.placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `躍?춮 placement count mismatch: ${positions.length} !== ` +\\r\\n        `${rebar.placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return positions.map((y): Point3 => [0, y, 0])\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?끾퀡 諛⑺뼢?쇰줈 ?섑??대릺??鸚㎪쥈 泥좉렐(?귙겙?됬춮쨌亮끾??곭춮)???꾧컻. ?꾨찓??\\n * `stirrupPositions`媛 ?좎씪??異쒖쿂??寃껋? ??躍?춮怨?媛숇떎.\\r\\n */\\r\\nfunction girderRepeatedPlacements(rebar: Rebar): Point3[] {\\r\\n  if (rebar.placement?.axis !== 'x') {\\r\\n    throw new Error(`${rebar.role} x-axis placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = stirrupPositions(\\r\\n    rebar.placement.clearMm,\\r\\n    rebar.placement.pitchMm,\\r\\n    rebar.placement.startOffsetMm,\\r\\n  ).positionsMm\\r\\n\\r\\n  if (positions.length !== rebar.placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `${rebar.role} placement count mismatch: ${positions.length} !== ` +\\r\\n        `${rebar.placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return positions.map((x): Point3 => [x, 0, 0])\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?밭춮? 醫뚯슦 ???닻씊???섎돇??遺숇뒗?? 餘득빊 竊??덃쑍??첨 2???닿퀬, ??섎㈃ 留덉?留?\\n * ??蹂몄씠 ?쒖そ 硫댁뿉留??⑤뒗?? 餘듭쓽 ?믪씠??訝딁ク嶺떷룝툔塋?춮 ?ъ씠瑜?洹좊벑 遺꾪븷??媛믪씠??\\n * ??誤뤸틬?ㅺ? ?꾨땲???묐룄 洹쒖튃?대ŉ, ?곈뇧? ??諛곗튂瑜??곗? ?딅뒗??(ADR-019).\\r\\n */\\r\\nfunction girderSideBarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: GirderSection,\\r\\n): Point3[] {\\r\\n  const [, midDepthMm, nearFaceZ] = rebar.points[0]\\r\\n  const farFaceZ = section.b - nearFaceZ\\r\\n  const tiers = Math.ceil(rebar.count / 2)\\r\\n\\r\\n  return Array.from({ length: rebar.count }, (_, index): Point3 => {\\r\\n    const tier = Math.floor(index / 2)\\r\\n    // 訝딁ク嶺뗣꺕訝뗧ク嶺뗣겗?뚪뼋?띲굮?뉒춬?ュ돯?뗣굏iers-1 ?㎩돯?뗣겏??앫겗餘듐걣訝뗧ク嶺뗣겗\\r\\n    // 鵝띸쉰?ャ곫?孃뚣겗餘듐걣訝딁ク嶺뗣겗鵝띸쉰?ョ쳦?ｃ겍?쀣겲?꾠?-D10 ??굠?녴겒?귙굤?듐굦??\\n    // ?ε뒟?㎬끃嶺뗣걣訝사춮??닓?ラ뇥?ゃ굥?귛뙷?볝굮 tiers+1 ?ュ돯?ｃ겍?끻겢??궧?졼걨鵝욍걝??\\n    const spanMm = section.depth - 2 * nearFaceZ\\r\\n    const y = nearFaceZ + ((tier + 1) * spanMm) / (tiers + 1) - midDepthMm\\r\\n    const z = index % 2 === 0 ? 0 : farFaceZ - nearFaceZ\\r\\n\\r\\n    return [0, y, z]\\r\\n  })\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鶯곭춮???쒖떆 諛섍꼍. `rebarRadius`??蹂댁씠?쇨퀬 ?ㅼ젣 吏由꾩쓣 怨쇱옣?섎?濡? ?뉗? 踰쎌뿉?쒕뒗\\r\\n * 潁?춮쨌與ょ춮 2寃뱀씠 鶯곩럻???ㅼ뼱媛吏 ?딅뒗????踰?諛뽰쑝濡??먯졇?섏삤??痢듬겮由??뚭퀬?ㅻ뱺\\r\\n * ??以??섎굹媛 ?쒕떎. ?ㅼ뼱媛???ш린源뚯? ?쇰쪧濡?以꾩씤??\\r\\n */\\r\\nfunction wallDisplayRadius(\\r\\n  size: ShearBarSize,\\r\\n  section: WallSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): number {\\r\\n  const pair =\\r\\n    radiusOf(section.vertical.size) + radiusOf(section.horizontal.size)\\r\\n  // ??뽧꺂? ??硫대떦 潁?춮竊뗦Ø嶺뗭씠??鶯곩럻??1/4, ?룔꺍?겹꺂? 1議곕퓧?대씪 1/2???대뒗??\\r\\n  const limit = section.thickness / (section.layers === 1 ? 2 : 4)\\r\\n\\r\\n  return radiusOf(size) * (pair > limit ? limit / pair : 1)\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鶯곩럻 諛⑺뼢?쇰줈 洹?壤밧돯???쒕뒗 硫?(mm). ?꾨찓??`points`??潁?춮??與ょ춮???뗣겤?딅㈃??\\n * ?먯?留??깆쓽 訝사춮쨌躍?춮怨?媛숇떎), 洹몃?濡?洹몃━硫?援먯감?먮쭏???쒕줈瑜?愿?듯븳?? ?깆?\\r\\n * 媛숈? ?쎌냽?쇰줈 烏①ㅊ 諛섍꼍留뚰겮 ?덉そ?쇰줈 諛??潁?춮??諛붽묑硫댁씠 ?뗣겤?딅㈃?? 與ょ춮??\\n * 洹??덉そ硫댁뿉 ?묓븯寃??쒕떎.\\r\\n *\\r\\n * 潁?춮???뗣겤?딅㈃ 履쎌뿉 ?먮뒗 ?곗뿉 洹쇨굅???녿떎 ??**???먮Ц ?대뵒?먮룄 ?뺥븿???녿떎.**\\r\\n * 與숁틬餓뺞쭣??5塋좎뿉???뚨를嶺뗣띉룔뚧Ø嶺뗣띿씠?쇰뒗 留??먯껜媛 ?녾퀬(?섏삤??寃껋? 永꾤찉藥δ틟\\r\\n * ?μ씠??, ?곈뇧令띸츞?뷸틬 2竊덌폊竊됧즯???끻쨼瑜?留먰븯吏 ?딅뒗?? ?곈뇧?먮뒗 ?곹뼢???놁쑝誘濡?\\n * (ADR-019) ?꾨㈃???붾뱾由ъ? ?딄쾶 鵝쒎쎋誤뤷뎴?쇰줈 怨좎젙?쒕떎 ???밭춮??餘드돯?딆? 媛숇떎.\\r\\n */\\r\\nfunction wallBarDepths(\\r\\n  role: RebarRole,\\r\\n  section: WallSection,\\r\\n  coverZ: number,\\r\\n  radiusOf: RadiusOf,\\r\\n): number[] {\\r\\n  const verticalRadius = wallDisplayRadius(\\r\\n    section.vertical.size,\\r\\n    section,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const horizontalRadius = wallDisplayRadius(\\r\\n    section.horizontal.size,\\r\\n    section,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const atFace = role === '潁?춮'\\r\\n\\r\\n  if (section.layers === 1) {\\r\\n    // ?룔꺍?겹꺂? ?뗣겤?딅㈃???꾨땲??鶯곩럻 以묒븰???ъ씠???먭퀬 ?깆쓣 留욌똾??\\r\\n    return [\\r\\n      section.thickness / 2 + (atFace ? -horizontalRadius : verticalRadius),\\r\\n    ]\\r\\n  }\\r\\n\\r\\n  // 烏①ㅊ 諛섍꼍留뚰겮 ?먭볼?뚯쭊 2痢듭씠 以묒븰?먯꽌 寃뱀튂吏 ?딅룄濡??뗣겤?딅? 二덈떎.\\r\\n  const cover = Math.min(\\r\\n    coverZ,\\r\\n    section.thickness / 2 - 2 * (verticalRadius + horizontalRadius),\\r\\n  )\\r\\n  const near =\\r\\n    cover + (atFace ? verticalRadius : 2 * verticalRadius + horizontalRadius)\\r\\n\\r\\n  return [near, section.thickness - near]\\r\\n}\\r\\n\\r\\n/**\\r\\n * 濚겹굤瓦붵걮?띸쉰??퐤營?(mm)?귙겣?졼굯??뼪?㏘?誤㎯겗?앮쐿?ゃ깢?삠긿?덀걢??`stirrupPositions`\\r\\n * ?뚥퐳?뗣걣?곲뼀?ｉ깿??걗?뗥즯?삣틞?욍겎??깋?▲궎?녈걣鵝띸쉰?앫겗?귙겗?믤륫?쀣겍?뤵굥 ??\\n * 轝좈솮???ㅳ겗壤밧돯?뚩쨭?겹겗?낁㉢烏뚣겓?녴걢?뚣굥??겎?곮죱?붵겏?ャ뚣겑??퐤營?겗?с걢?띲굮\\r\\n * 黎뷩굙?╉걡?뗣겒?꾠겏?뚣걯?닸??멧틠佯?룒?뤵걪?ⓦ겓?ゃ굥 (ADR-029)??\\n */\\r\\nfunction repeatPositions(placement: RebarPlacement): number[] {\\r\\n  return (\\r\\n    placement.positionsMm ??\\r\\n    stirrupPositions(\\r\\n      placement.clearMm,\\r\\n      placement.pitchMm,\\r\\n      placement.startOffsetMm,\\r\\n    ).positionsMm\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?먬쐡鶯곸쓽 潁?춮쨌與ょ춮 ?꾧컻. ?섑???異뺤? ?꾨찓??`placement`媛, 鶯곩럻 諛⑺뼢?\\r\\n * `wallBarDepths`媛 以?????쒖떆遺媛 ?뗣겤?딅? ?ㅼ떆 議고쉶?섎㈃ 猷고뙥 議고쉶媛 ??怨녹뿉\\r\\n * 諛뺥엳誘濡? ??쒖젏??z(竊앫걢?뜰굤硫?留?諛쏆븘??嫄곌린???좊룄?쒕떎.\\r\\n */\\r\\nfunction wallRebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: WallSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  const placement = rebar.placement\\r\\n  if (!placement) {\\r\\n    throw new Error(`${rebar.role} placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = repeatPositions(placement)\\r\\n\\r\\n  if (positions.length !== placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `${rebar.role} placement count mismatch: ${positions.length} !== ` +\\r\\n        `${placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const coverZ = rebar.points[0][2]\\r\\n\\r\\n  return wallBarDepths(rebar.role, section, coverZ, radiusOf).flatMap((z) =>\\r\\n    positions.map((value): Point3 =>\\r\\n      placement.axis === 'x'\\r\\n        ? [value, 0, z - coverZ]\\r\\n        : [0, value, z - coverZ],\\r\\n    ),\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?볝겗?꾤춮??걢?뜰굤?㏂겗遙섅걬 (mm)?귝뒛?뚧쎊?뚣겂?잋툓塋?춮??툔?멱맼?▲굥?밤굚?곥겇??겎??\\n * ?당퇉?⑨펷??귡쳵?꾤궧竊됥겎餓ｈ〃?뺛걵?뗣귚툔塋?춮??뒛?뚣겒?꾠겗?㎩뀲?밤걣?뚣걯遙섅걬?㎯걗?뗣?\\n */\\r\\nfunction slabCoverZ(rebar: Rebar): number {\\r\\n  return Math.max(...rebar.points.map(([, , z]) => z))\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮嶺뗣겗烏①ㅊ?듿푶??rebarRadius` ??쫳?쎼굥?잆굙?ュ츪?쎼겗孃꾠굮沃뉐섧?쇻굥??겎?곫씮??\\n * 200?삠걢?뜰굤 30 ??솹?싥겗?밤꺀?뽧겎??2?밧릲횞2?㏂겗4掠ㅳ걣?γ굢?ゃ걚 ???욍겗鸚뽧겦\\r\\n * 囹곥걤?뷩걲?뗥광?⒲걝?쀣걣繇잆걚渦쇈??귛뀯?뗥ㄷ?띲걬?얇겎訝孃뗣겓潁?굙?뗰펷鶯곥겗\\r\\n * `wallDisplayRadius` ?ⓨ릪?섉돮?꾬펹??\\n *\\r\\n * ?뗣겤?듽겗?끻겢?ユ츐??`?싥걬 ???뗣겤?듑?` ??掠ㅳ겎?녴걨?뗣겗?㎯곭를與?永꾠겗?듿푶??뭽??\\n * ?앫겗1/4?ュ룑?얇굦?겹굠?꾠?\\n */\\r\\nfunction slabDisplayRadius(\\r\\n  size: ShearBarSize,\\r\\n  section: SlabSection,\\r\\n  coverMm: number,\\r\\n  radiusOf: RadiusOf,\\r\\n): number {\\r\\n  const pair =\\r\\n    radiusOf(slabRowFor(section, 'X', '訝뗧ク').size) +\\r\\n    radiusOf(slabRowFor(section, 'Y', '訝뗧ク').size)\\r\\n  const limit = Math.max(0, (section.thickness - 2 * coverMm) / 4)\\r\\n\\r\\n  return radiusOf(size) * (pair > limit ? limit / pair : 1)\\r\\n}\\r\\n\\r\\n/** ?뗣겤?딃씊?뗣굢歷с겂?잆걢?뜰굤?싥걬 ??訝딁ク嶺뗣겘?욍겗訝듽걢?됪릍?뗣?*/\\r\\nfunction slabCoverMm(coverZ: number, section: SlabSection): number {\\r\\n  return Math.min(coverZ, section.thickness - coverZ)\\r\\n}\\r\\n\\r\\nfunction slabRowFor(\\r\\n  section: SlabSection,\\r\\n  axis: 'X' | 'Y',\\r\\n  face: '訝딁ク' | '訝뗧ク',\\r\\n): SlabBarRow {\\r\\n  return (axis === 'X' ? section.x : section.y)[\\r\\n    face === '訝딁ク' ? 'top' : 'bottom'\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction slabRoleParts(role: RebarRole): {\\r\\n  axis: 'X' | 'Y'\\r\\n  face: '訝딁ク' | '訝뗧ク'\\r\\n} {\\r\\n  switch (role) {\\r\\n    case 'X?밧릲訝딁ク嶺?:\\r\\n      return { axis: 'X', face: '訝딁ク' }\\r\\n    case 'X?밧릲訝뗧ク嶺?:\\r\\n      return { axis: 'X', face: '訝뗧ク' }\\r\\n    case 'Y?밧릲訝딁ク嶺?:\\r\\n      return { axis: 'Y', face: '訝딁ク' }\\r\\n    case 'Y?밧릲訝뗧ク嶺?:\\r\\n      return { axis: 'Y', face: '訝뗧ク' }\\r\\n    default:\\r\\n      throw new Error(`Unsupported 佯딀씮 role: ${role}`)\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮嶺뗣걣?욕럻??겑?볝겓塋뗣겇??(mm)?귙깋?▲궎?녈겗 `points` ??툓塋?춮?귚툔塋?춮??\\n * ?뗣겤?딃씊?ョ쉰?륅펷?긱겗訝사춮?삣릭嶺뗣겏?뚣걯竊됥걣?곥걹??겲?얏룒?뤵겏雅ㅷ궧?붵겏??2?밧릲??\\n * 雅믡걚?믦껀?싥걲?뗣귟〃鹽뷴뜇孃꾠겗?뜰굯?졼걨?끻겢?멩듉?쀣갲?밧릲??쨼?㏂걣?뗣겤?딃씊?ャ?\\n * Y?밧릲?뚣걹??냵?닻씊?ユ렏?쇻굥?덀걝?ャ걲?뗣?\\n *\\r\\n * X?밧릲?믡걢?뜰굤?℡겢?ョ쉰?뤵걪?ⓦ겓?방떊??겒????**訝▼렅?뉎겗?⒲걪?ャ굚若싥굙?뚣겒?꾠?*\\r\\n * ?곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞????뼶?묆굮?뷴닪?쎼걳?뚥말嶺뗣띲겏?쇈겤?졼걨?㎯곫쮽繹뽨퍞礪섉쎑5塋?\\n * ?ャ굚訝듾툔??뇥?ゃ굤?녴겗鼇섋염??겒?꾠귝빊?뤵겓??쉽?욍걮?ゃ걚??겎 (ADR-019)?곩쎋?㏂걣\\r\\n * ?뷩굦?ゃ걚?덀걝?ヤ퐳?녘쫸?뉎겏?쀣겍?뷴츣?쇻굥 ??鶯곥겗潁?춮?삥Ø嶺뗣겏?뚣걯?ㅶ뼪?㎯걗?뗣?\\n */\\r\\nfunction slabBarDepthMm(\\r\\n  role: RebarRole,\\r\\n  section: SlabSection,\\r\\n  coverZ: number,\\r\\n  radiusOf: RadiusOf,\\r\\n): number {\\r\\n  const { axis, face } = slabRoleParts(role)\\r\\n  const coverMm = slabCoverMm(coverZ, section)\\r\\n  const outer = slabDisplayRadius(\\r\\n    slabRowFor(section, 'X', face).size,\\r\\n    section,\\r\\n    coverMm,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const inner = slabDisplayRadius(\\r\\n    slabRowFor(section, 'Y', face).size,\\r\\n    section,\\r\\n    coverMm,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const depth = axis === 'X' ? outer : 2 * outer + inner\\r\\n\\r\\n  return face === '訝딁ク' ? coverZ - depth : coverZ + depth\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮嶺뗣겗掠뺡뼀?귡씊?끹겗濚겹굤瓦붵걮邕멥겘?됥깳?ㅳ꺍??`placement` ?뚣곫씮?싨뼶?묆겘\\r\\n * `slabBarDepthMm` ?뚥툗?덀굥?괱?밧릲??뎱嶺뗣겘掠? x ?ヤ섯?녈겍 y ?멥갳?밧릲??\\n * ?앫겗?녴겓訝╉겤??\\n */\\r\\nfunction slabRebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: SlabSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  const placement = rebar.placement\\r\\n  if (!placement) {\\r\\n    throw new Error(`${rebar.role} placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = repeatPositions(placement)\\r\\n\\r\\n  if (positions.length !== placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `${rebar.role} placement count mismatch: ${positions.length} !== ` +\\r\\n        `${placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const coverZ = slabCoverZ(rebar)\\r\\n  const shiftZ = slabBarDepthMm(rebar.role, section, coverZ, radiusOf) - coverZ\\r\\n\\r\\n  return positions.map((value): Point3 =>\\r\\n    placement.axis === 'x' ? [value, 0, shiftZ] : [0, value, shiftZ],\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function rebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: Section,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n): Point3[] {\\r\\n  if (section.kind === '??) {\\r\\n    return columnRebarPlacements(rebar, section, radiusOf)\\r\\n  }\\r\\n  if (section.kind === '?먬쐡鶯?) {\\r\\n    return wallRebarPlacements(rebar, section, radiusOf)\\r\\n  }\\r\\n  if (section.kind === '佯딀씮') {\\r\\n    return slabRebarPlacements(rebar, section, radiusOf)\\r\\n  }\\r\\n  if (rebar.role === '?귙겙?됬춮' || rebar.role === '亮끾??곭춮') {\\r\\n    return girderRepeatedPlacements(rebar)\\r\\n  }\\r\\n  if (rebar.role === '?밭춮') {\\r\\n    return girderSideBarPlacements(rebar, section)\\r\\n  }\\r\\n\\r\\n  return girderMainPlacements(rebar, section, radiusOf)\\r\\n}\\r\\n\\r\\nfunction insetCoordinate(\\r\\n  value: number,\\r\\n  minimum: number,\\r\\n  maximum: number,\\r\\n  radius: number,\\r\\n): number {\\r\\n  const inset = Math.min(radius, (maximum - minimum) / 2)\\r\\n  return Math.min(Math.max(value, minimum + inset), maximum - inset)\\r\\n}\\r\\n\\r\\n// hoop 以묒떖?좎쓣 ?뗣겤?딅㈃?먯꽌 ?쒖떆 諛섍꼍留뚰겮 ?덉そ?쇰줈 ?ｋ뒗?? ?됰㈃? 遺??kind濡?\\n// 紐낆떆?곸쑝濡?怨좊Ⅸ?? ?깅뒗 X?밵, 鸚㎪쥈? Y?밵. 醫뚰몴 蹂?붾줈 ?됰㈃??異붾줎?섏? ?딅뒗??\\r\\nfunction hoopDisplayPoint(\\r\\n  point: Point3,\\r\\n  framePoints: Point3[],\\r\\n  radius: number,\\r\\n  section: Section,\\r\\n): Point3 {\\r\\n  if (section.kind === '?? && section.shape === '?녶숱') {\\r\\n    // ?녴겘渦뷩걫?ⓦ겓屋겹굙?됥굦?ゃ걚 ??訝?퓘?뗣굢??퇌?㏂굮烏①ㅊ?듿푶?졼걨潁?굙?뗣?\\n    const centre = section.b / 2\\r\\n    const [x, y, z] = point\\r\\n    const distance = Math.hypot(x - centre, z - centre)\\r\\n    if (distance === 0) return point\\r\\n    const scale = Math.max(0, distance - radius) / distance\\r\\n\\r\\n    return [centre + (x - centre) * scale, y, centre + (z - centre) * scale]\\r\\n  }\\r\\n\\r\\n  if (section.kind === '??) {\\r\\n    const xs = framePoints.map((candidate) => candidate[0])\\r\\n    const zs = framePoints.map((candidate) => candidate[2])\\r\\n    const minX = Math.min(...xs)\\r\\n    const maxX = Math.max(...xs)\\r\\n    const minZ = Math.min(...zs)\\r\\n    const maxZ = Math.max(...zs)\\r\\n\\r\\n    return [\\r\\n      insetCoordinate(point[0], minX, maxX, radius),\\r\\n      point[1],\\r\\n      insetCoordinate(point[2], minZ, maxZ, radius),\\r\\n    ]\\r\\n  }\\r\\n\\r\\n  const ys = framePoints.map((candidate) => candidate[1])\\r\\n  const zs = framePoints.map((candidate) => candidate[2])\\r\\n  const minY = Math.min(...ys)\\r\\n  const maxY = Math.max(...ys)\\r\\n  const minZ = Math.min(...zs)\\r\\n  const maxZ = Math.max(...zs)\\r\\n\\r\\n  return [\\r\\n    point[0],\\r\\n    insetCoordinate(point[1], minY, maxY, radius),\\r\\n    insetCoordinate(point[2], minZ, maxZ, radius),\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction translate(point: Point3, offset: Point3): Point3 {\\r\\n  return [point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]]\\r\\n}\\r\\n\\r\\ninterface PathSegment {\\r\\n  from: Point3\\r\\n  to: Point3\\r\\n  /** 135째?뺛긿??퐰????烏①ㅊ?㎯겘 clamp ?쎼걳?곩쭓?밤겗 inset ?뜰굯??뭄烏뚨㎉?뺛겎?뤵걦 */\\r\\n  hookTail?: boolean\\r\\n}\\r\\n\\r\\ninterface PathRun {\\r\\n  zone: RebarZone['kind'] | null\\r\\n  segments: PathSegment[]\\r\\n}\\r\\n\\r\\ninterface SegmentRun {\\r\\n  zone: RebarZone['kind'] | null\\r\\n  segments: Segment[]\\r\\n}\\r\\n\\r\\nfunction pointDistance(from: Point3, to: Point3): number {\\r\\n  return Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2])\\r\\n}\\r\\n\\r\\nfunction interpolate(from: Point3, to: Point3, ratio: number): Point3 {\\r\\n  return [\\r\\n    from[0] + (to[0] - from[0]) * ratio,\\r\\n    from[1] + (to[1] - from[1]) * ratio,\\r\\n    from[2] + (to[2] - from[2]) * ratio,\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction zoneAt(\\r\\n  zones: RebarZone[],\\r\\n  pathDistanceMm: number,\\r\\n): RebarZone['kind'] | null {\\r\\n  return (\\r\\n    zones.find(\\r\\n      ({ pathFromMm, pathToMm }) =>\\r\\n        pathDistanceMm >= pathFromMm && pathDistanceMm <= pathToMm,\\r\\n    )?.kind ?? null\\r\\n  )\\r\\n}\\r\\n\\r\\n/** ?꾩쟻 domain 寃쎈줈嫄곕━?먯꽌 癒쇱? ?먮Ⅸ?? ?쒖떆 ?몄뀑쨌諛곗튂????寃곌낵?먮쭔 ?곸슜?쒕떎. */\\r\\nfunction pathRuns(rebar: Rebar): PathRun[] {\\r\\n  const edges: PathSegment[] = rebar.points.slice(1).map((to, index) => ({\\r\\n    from: rebar.points[index],\\r\\n    to,\\r\\n  }))\\r\\n\\r\\n  if (rebar.closed && rebar.points.length > 1) {\\r\\n    edges.push({\\r\\n      from: rebar.points[rebar.points.length - 1],\\r\\n      to: rebar.points[0],\\r\\n    })\\r\\n  }\\r\\n\\r\\n  if (rebar.hookTails !== undefined && rebar.points.length > 0) {\\r\\n    for (const tail of rebar.hookTails) {\\r\\n      edges.push({ from: rebar.points[0], to: tail, hookTail: true })\\r\\n    }\\r\\n  }\\r\\n\\r\\n  const zones = rebar.zones ?? []\\r\\n  const boundaries = zones.flatMap(({ pathFromMm, pathToMm }) => [\\r\\n    pathFromMm,\\r\\n    pathToMm,\\r\\n  ])\\r\\n  const runs: PathRun[] = []\\r\\n  let walked = 0\\r\\n\\r\\n  for (const edge of edges) {\\r\\n    const length = pointDistance(edge.from, edge.to)\\r\\n    if (length === 0) continue\\r\\n\\r\\n    const edgeEnd = walked + length\\r\\n    const cuts = [\\r\\n      walked,\\r\\n      ...boundaries.filter(\\r\\n        (boundary) => boundary > walked && boundary < edgeEnd,\\r\\n      ),\\r\\n      edgeEnd,\\r\\n    ].sort((left, right) => left - right)\\r\\n\\r\\n    for (let index = 1; index < cuts.length; index += 1) {\\r\\n      const pathFrom = cuts[index - 1]\\r\\n      const pathTo = cuts[index]\\r\\n      if (pathTo <= pathFrom) continue\\r\\n\\r\\n      const segment: PathSegment = {\\r\\n        from: interpolate(edge.from, edge.to, (pathFrom - walked) / length),\\r\\n        to: interpolate(edge.from, edge.to, (pathTo - walked) / length),\\r\\n      }\\r\\n      if (edge.hookTail) segment.hookTail = true\\r\\n      const zone = zoneAt(zones, (pathFrom + pathTo) / 2)\\r\\n      const current = runs[runs.length - 1]\\r\\n\\r\\n      if (current?.zone === zone) current.segments.push(segment)\\r\\n      else runs.push({ zone, segments: [segment] })\\r\\n    }\\r\\n\\r\\n    walked = edgeEnd\\r\\n  }\\r\\n\\r\\n  return runs\\r\\n}\\r\\n\\r\\nexport interface AxisAlignedBox {\\r\\n  center: Point3\\r\\n  size: Point3\\r\\n}\\r\\n\\r\\n/** 嶸긱겗2邕멥겓?쇻걮?잓뼀?ｉ깿??윪壤㏂귟뻗???恙쒌겘?쇈겤?담걣黎뷩굙?뗰펷?ⓩ쓲?붵겏?ラ걬?놅펹 */\\r\\nexport interface BoxHole {\\r\\n  minA: number\\r\\n  maxA: number\\r\\n  minB: number\\r\\n  maxB: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뗥룭?ⓦ겎?녈꺍??꺁?쇈깉????믡걦?딀뒠??(?곈뇧令띸츞?뷸틬 1?싧뎴8))??\\n *\\r\\n * ?뗥룭??깿?먦겗?싥걬?믦껀?뤵겗?㎯곮쫳?뗣겗??`axes` ?뚧뙁??邕멥걽?묆걽???ㅳ겗?뗥룭?????\\n * ?鸚??ㅳ겓?꿔굥竊덃뎸?띲꺕也γ꺕訝뗣꺕訝딉펹?귟쨭?겹걗?뚣겙?꿔겂?잏??믡걬?됥겓?꿔굥 ???쀩빓??\\n * ?녶돯?뚦눣?뗣걪?ⓦ겘?귙굥?뚣곲뇥?ゃ겂?잓뼀?ｃ겎?귝쵟?묆걣閭ｃ걮?뤸츐?뗣?\\n *\\r\\n * ?뤵굤?쒌걤??〃鹽뷩걽?묆겗屋긱겎?귙굥?귝빊?뤵겗轝좈솮??`openingDeduction` ?뚪뎱嶺뗣겓?ㅳ걚??\\n * ?겹걟?뗣굚??겎?곥궠?녈궚?ゃ꺖?덀꺕?뗦옞??빊?뤵겘?앫굚?앫굚獒썲뱚?뚦눣?뺛겒??(ADR-005)??\\n */\\r\\nexport function carveBox<T extends AxisAlignedBox>(\\r\\n  box: T,\\r\\n  axes: [number, number],\\r\\n  holes: BoxHole[],\\r\\n): T[] {\\r\\n  return holes.reduce<T[]>(\\r\\n    (boxes, hole) => boxes.flatMap((one) => carveOne(one, axes, hole)),\\r\\n    [box],\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction carveOne<T extends AxisAlignedBox>(\\r\\n  box: T,\\r\\n  [axisA, axisB]: [number, number],\\r\\n  hole: BoxHole,\\r\\n): T[] {\\r\\n  const minA = box.center[axisA] - box.size[axisA] / 2\\r\\n  const maxA = box.center[axisA] + box.size[axisA] / 2\\r\\n  const minB = box.center[axisB] - box.size[axisB] / 2\\r\\n  const maxB = box.center[axisB] + box.size[axisB] / 2\\r\\n\\r\\n  const cutMinA = Math.max(minA, hole.minA)\\r\\n  const cutMaxA = Math.min(maxA, hole.maxA)\\r\\n  const cutMinB = Math.max(minB, hole.minB)\\r\\n  const cutMaxB = Math.min(maxB, hole.maxB)\\r\\n\\r\\n  if (cutMinA >= cutMaxA || cutMinB >= cutMaxB) return [box]\\r\\n\\r\\n  const piece = (\\r\\n    fromA: number,\\r\\n    toA: number,\\r\\n    fromB: number,\\r\\n    toB: number,\\r\\n  ): T => {\\r\\n    const center = [...box.center] as Point3\\r\\n    const size = [...box.size] as Point3\\r\\n    center[axisA] = (fromA + toA) / 2\\r\\n    size[axisA] = toA - fromA\\r\\n    center[axisB] = (fromB + toB) / 2\\r\\n    size[axisB] = toB - fromB\\r\\n    return { ...box, center, size }\\r\\n  }\\r\\n\\r\\n  const pieces: T[] = []\\r\\n  if (minA < cutMinA) pieces.push(piece(minA, cutMinA, minB, maxB))\\r\\n  if (cutMaxA < maxA) pieces.push(piece(cutMaxA, maxA, minB, maxB))\\r\\n  if (minB < cutMinB) pieces.push(piece(cutMinA, cutMaxA, minB, cutMinB))\\r\\n  if (cutMaxB < maxB) pieces.push(piece(cutMinA, cutMaxA, cutMaxB, maxB))\\r\\n\\r\\n  return pieces\\r\\n}\\r\\n\\r\\n/** ?ⓩ쓲掠???뼀?ｃ굮?곭???邕멥겓?듽걨?뗧독野얍벨與쇻겗?⒴숱?ュ넍?쇻?*/\\r\\nexport function boxHoles(\\r\\n  openings: Opening[],\\r\\n  originA: number,\\r\\n  originB: number,\\r\\n): BoxHole[] {\\r\\n  return openings.map((opening) => ({\\r\\n    minA: originA + opening.xMm,\\r\\n    maxA: originA + opening.xMm + opening.widthMm,\\r\\n    minB: originB + opening.yMm,\\r\\n    maxB: originB + opening.yMm + opening.heightMm,\\r\\n  }))\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뗥룭?ⓦ걣?꾤춮?믤뼪?ㅵ뙷??(?곈뇧令띸츞?뷸틬 1?싧뎴8))??\\n *\\r\\n * ?뗥룭??깿?먦겗?싥걬?믦껀?뤵겗?㎯곩닩若싥겘掠? x?퍈 ??邕멥걽?묆겎擁녈굤?뗣귛쥊?뚣겓?▲굟?녴겑\\r\\n * 雍됥굥?꾤춮??뼪?잆겒?????곈뇧?담겗轝좈솮?ㅵ츣?ⓨ릪?섊큵?잆겎?곲뼀?ｃ겗鸚뽧겗?꾤춮?믤쵟?뗣걵?ゃ걚\\r\\n * ?잆굙?㎯걗??(`openingDeduction`)??\\n *\\r\\n * ?곈뇧?뚣뚥퐬?с걣鵝븁m轝졼걨?뗣걢?띲굮鼇?녴겗?ュ??쀣곥걪?볝걣黎뷩굙?뗣겗??뚣겑?볝겎?뉎굦??\\n * 誤뗣걟?뗣걢?띲걽?귝쵟?묆굥鵝띸쉰??쑍?붵겏?ラ걬?녴겗??`Rebar.points` ?ャ겘?γ굦?됥굦?ゃ걚 ??\\n * 餓ｈ〃1?с겗?섅굦渶싥겘?뗥룭?믥윥?됥겒?꾢뀲?룔겗永뚩러?㎯걗??(ADR-029)??\\n */\\r\\nfunction openingCut(\\r\\n  from: Point3,\\r\\n  to: Point3,\\r\\n  opening: Opening,\\r\\n): [number, number] | null {\\r\\n  let enter = 0\\r\\n  let leave = 1\\r\\n\\r\\n  for (const axis of [0, 1] as const) {\\r\\n    const minimum = axis === 0 ? opening.xMm : opening.yMm\\r\\n    const maximum =\\r\\n      minimum + (axis === 0 ? opening.widthMm : opening.heightMm)\\r\\n    const start = from[axis]\\r\\n    const delta = to[axis] - start\\r\\n\\r\\n    if (Math.abs(delta) < 1e-9) {\\r\\n      // ?볝겗邕멥겓?뺛걢?ゃ걚?꾤춮??곲뼀?ｃ겗?끻겢?ャ걚?뗣걢鸚뽧겓?꾠굥?뗣겗?⒲걾?됥걢?졼?\\n      if (start <= minimum || start >= maximum) return null\\r\\n      continue\\r\\n    }\\r\\n\\r\\n    const first = (minimum - start) / delta\\r\\n    const second = (maximum - start) / delta\\r\\n    enter = Math.max(enter, Math.min(first, second))\\r\\n    leave = Math.min(leave, Math.max(first, second))\\r\\n  }\\r\\n\\r\\n  return leave > enter ? [enter, leave] : null\\r\\n}\\r\\n\\r\\nfunction lerpPoint(from: Point3, to: Point3, t: number): Point3 {\\r\\n  return [\\r\\n    from[0] + (to[0] - from[0]) * t,\\r\\n    from[1] + (to[1] - from[1]) * t,\\r\\n    from[2] + (to[2] - from[2]) * t,\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction clipSegment(segment: Segment, openings: Opening[]): Segment[] {\\r\\n  const cuts = openings\\r\\n    .map((opening) => openingCut(segment.from, segment.to, opening))\\r\\n    .filter((cut): cut is [number, number] => cut !== null)\\r\\n    .sort(([left], [right]) => left - right)\\r\\n\\r\\n  if (cuts.length === 0) return [segment]\\r\\n\\r\\n  const pieces: Segment[] = []\\r\\n  let walked = 0\\r\\n\\r\\n  for (const [enter, leave] of cuts) {\\r\\n    if (enter > walked) {\\r\\n      pieces.push({\\n        from: lerpPoint(segment.from, segment.to, walked),\\n        to: lerpPoint(segment.from, segment.to, enter),\\n        radius: segment.radius,\\n        ...(segment.barIndex === undefined ? {} : { barIndex: segment.barIndex }),\\n        ...(segment.hookTail ? { hookTail: true } : {}),\\n      })\\r\\n    }\\r\\n    walked = Math.max(walked, leave)\\r\\n  }\\r\\n\\r\\n  if (walked < 1) {\\r\\n    pieces.push({\\n      from: lerpPoint(segment.from, segment.to, walked),\\n      to: segment.to,\\n      radius: segment.radius,\\n      ...(segment.barIndex === undefined ? {} : { barIndex: segment.barIndex }),\\n      ...(segment.hookTail ? { hookTail: true } : {}),\\n    })\\r\\n  }\\r\\n\\r\\n  // 塋?걣?뗥룭??툈?ャ걾?뉎걝?⑵펹?뗣겏?룔걬0??졃?뉎걣?뷩굥?귝룒?꾠겍?귟쫳?덀겒?꾠걝?덀?\\n  // three.js ??냶?긱궦?ゃ깳?덀꺁?뚦릲?띲굮黎뷩굙?됥굦?ゃ걚??\\n  return pieces.filter(\\r\\n    ({ from, to }) =>\\r\\n      Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2]) > 1e-6,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function clipSegments(\\r\\n  segments: Segment[],\\r\\n  openings: Opening[],\\r\\n): Segment[] {\\r\\n  if (openings.length === 0) return segments\\r\\n  return segments.flatMap((segment) => clipSegment(segment, openings))\\r\\n}\\r\\n\\r\\nfunction rebarSegmentRuns(\\r\\n  rebar: Rebar,\\r\\n  section: Section,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n  openings: Opening[] = [],\\r\\n): SegmentRun[] {\\r\\n  if (roleToLayer(rebar.role) === 'hidden') return []\\r\\n\\r\\n  // 鶯곥겏佯딀씮?졼걨烏①ㅊ?듿푶?뚪깿?먨럻?ョ툤?됥굦?뗣귡뀓營?겏?뤹뵽?㎩닪?끹겗?듿푶?믢슴?녴겏??\\n  // 屋겹굙?잆겘?싥겗掠ㅳ걣?뤵걦?ⓦ걤?ャ겲?잌ㄺ?ｃ겍繇잆걚渦쇈???\\n  const radius =\\r\\n    section.kind === '?먬쐡鶯?\\r\\n      ? wallDisplayRadius(rebar.size, section, radiusOf)\\r\\n      : section.kind === '佯딀씮'\\r\\n        ? slabDisplayRadius(\\r\\n            rebar.size,\\r\\n            section,\\r\\n            slabCoverMm(slabCoverZ(rebar), section),\\r\\n            radiusOf,\\r\\n          )\\r\\n        : radiusOf(rebar.size)\\r\\n  const displayPoint = (point: Point3): Point3 =>\\r\\n    rebar.shape === 'hoop'\\r\\n      ? hoopDisplayPoint(point, rebar.points, radius, section)\\r\\n      : point\\r\\n  // 135째?뺛긿??퐰?룔굮塋?궧?붵겏??clamp ?쇻굥?ⓦ곮쭜??쭓?밤걽?묈냵?담겦野꾠겂??\\n  // ?묆걤?삯빓?뺛걣若⒲굦?곮챺凉듣〃鹽뷴뜇孃꾠겗渦뷩긽?γ꺖?뽧겓?뗣굚?뚣굥?귛쭓?밤걣?쀣걨??\\n  // inset ?ⓨ릪?섇뭄烏뚨㎉?뺛굮弱얍뀲鵝볝겓?뗣걨?곩뒥藥ε숱?뜰겗?묆걤?삯빓?뺛굮岳앫겇??\\n  const hookTailPoint = (point: Point3): Point3 => {\\r\\n    const origin = rebar.points[0]\\r\\n    const displayed = displayPoint(origin)\\r\\n    return [\\r\\n      point[0] + displayed[0] - origin[0],\\r\\n      point[1] + displayed[1] - origin[1],\\r\\n      point[2] + displayed[2] - origin[2],\\r\\n    ]\\r\\n  }\\r\\n  const placements = rebarPlacements(rebar, section, radiusOf)\\r\\n\\r\\n  return pathRuns(rebar).map(({ zone, segments }) => ({\\r\\n    zone,\\r\\n    // ?뗥룭?ⓦ겘 3D ?㎯걽?묌뎱嶺뗣굮??겇?귝빊?뤵겘 `Rebar.length` ?뚦닪?ユ똻?ｃ겍?꾠굥\\r\\n    // ??겎?곥걪?볝겎?뉎겂?╉굚?ф빊?삭나?뤵겘?뺛걢?ゃ걚 (ADR-029)??\\n    segments: clipSegments(\\r\\n      placements.flatMap((offset, barIndex) =>\\n        segments.map(({ from, to, hookTail }) => ({\\n          from: translate(hookTail ? hookTailPoint(from) : displayPoint(from), offset),\\n          to: translate(hookTail ? hookTailPoint(to) : displayPoint(to), offset),\\n          radius,\\n          barIndex,\\n          ...(hookTail ? { hookTail: true } : {}),\\n        })),\\r\\n      ),\\r\\n      openings,\\r\\n    ),\\r\\n  }))\\r\\n}\\r\\n\\r\\nexport function rebarSegments(\\r\\n  rebar: Rebar,\\r\\n  section: Section,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n  openings: Opening[] = [],\\r\\n): Segment[] {\\r\\n  return rebarSegmentRuns(rebar, section, radiusOf, openings).flatMap(\\r\\n    ({ segments }) => segments,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport interface RebarBatch {\\r\\n  rowId: string\\r\\n  layer: RebarLayer\\r\\n  zone: RebarZone['kind'] | null\\r\\n  segments: Segment[]\\r\\n}\\r\\n\\r\\n/**\\r\\n * 3D??媛뺤“ ?⑥쐞???댁뿭??**??*?대떎(DESIGN.md 짠3.2). zone ?됱쓣 蹂댁〈?섍린 ?꾪빐\\r\\n * ???덉뿉?쒕뒗 ?곗냽 寃쎈줈 run留덈떎 ?섎늻吏留? ?멸렇癒쇳듃留덈떎 硫붿떆瑜?留뚮뱾吏???딅뒗??\\r\\n * 媛숈? rowId瑜??좎??섎?濡??щ윭 zone 諛곗튂???섎굹???됱쑝濡??④퍡 媛뺤“?????덈떎.\\r\\n */\\r\\nfunction shiftAlongAxis(segments: Segment[], offsetMm: number): Segment[] {\\r\\n  if (offsetMm === 0) return segments\\r\\n\\r\\n  return segments.map(({ from, to, radius }) => ({\\r\\n    from: [from[0] + offsetMm, from[1], from[2]] as Point3,\\r\\n    to: [to[0] + offsetMm, to[1], to[2]] as Point3,\\r\\n    radius,\\r\\n  }))\\r\\n}\\r\\n\\r\\nexport function rebarBatches(\\r\\n  entries: {\\r\\n    rowId: string\\r\\n    rebar: Rebar\\r\\n    originOffsetMm?: number\\r\\n    /** ?볝겗?꾤춮????佯㎪쮽楹삠겓?담걮?잓뼀?ｉ깿 (1?싧뎴8))??D ?졼걨?뚣걪?뚣굮誤뗣굥 */\\r\\n    openings?: Opening[]\\r\\n  }[],\\r\\n  section: Section,\\r\\n): RebarBatch[] {\\r\\n  const batches = new Map<string, RebarBatch>()\\r\\n\\r\\n  for (const { rowId, rebar, originOffsetMm = 0, openings = [] } of entries) {\\r\\n    const layer = roleToLayer(rebar.role)\\r\\n\\r\\n    rebarSegmentRuns(rebar, section, rebarRadius, openings).forEach(\\r\\n      ({ zone, segments }, runIndex) => {\\r\\n      // 媛숈? row?????泥좉렐???щ윭 媛쒕㈃ ?숈씪 寃쎈줈 run?쇰━ ?⑹튂?? ?묐떒??媛숈?\\r\\n      // kind??zone???덉뼱???쒕줈 ?ㅻⅨ ?곗냽 援ш컙?대?濡?runIndex濡?遺꾨━?쒕떎.\\r\\n        const key = JSON.stringify([rowId, layer, runIndex, zone])\\r\\n        // ?ㅽ봽?뗭? **蹂묓빀 ?꾩뿉** 嫄대떎. ?ｇ텥?밤깙?녹뿉?????ㅽ뙩???귙겙?됬춮? 湲몄씠쨌?ф빊媛\\r\\n        // 媛숈븘 媛숈? rowId濡??⑹퀜吏誘濡? 諛곗튂 ?⑥쐞濡???린硫??쒖そ ?ㅽ봽?뗭씠 ?щ씪吏꾨떎.\\r\\n        const shifted = shiftAlongAxis(segments, originOffsetMm)\\r\\n        const batch = batches.get(key)\\r\\n\\r\\n        if (batch) batch.segments.push(...shifted)\\r\\n        else batches.set(key, { rowId, layer, zone, segments: shifted })\\r\\n      },\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return [...batches.values()]\\r\\n}\\r\\n\\r\\nfunction subtract(left: Point3, right: Point3): Point3 {\\r\\n  return [left[0] - right[0], left[1] - right[1], left[2] - right[2]]\\r\\n}\\r\\n\\r\\nfunction dot(left: Point3, right: Point3): number {\\r\\n  return left[0] * right[0] + left[1] * right[1] + left[2] * right[2]\\r\\n}\\r\\n\\r\\nfunction cross(left: Point3, right: Point3): Point3 {\\r\\n  return [\\r\\n    left[1] * right[2] - left[2] * right[1],\\r\\n    left[2] * right[0] - left[0] * right[2],\\r\\n    left[0] * right[1] - left[1] * right[0],\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction normalize(vector: Point3): Point3 {\\r\\n  const length = Math.hypot(vector[0], vector[1], vector[2])\\r\\n\\r\\n  if (!Number.isFinite(length) || length === 0) {\\r\\n    throw new Error('Cannot normalize an invalid camera vector')\\r\\n  }\\r\\n\\r\\n  return [vector[0] / length, vector[1] / length, vector[2] / length]\\r\\n}\\r\\n\\r\\nfunction boundsCorners({ min, max }: Bounds): Point3[] {\\r\\n  return [min[0], max[0]].flatMap((x) =>\\r\\n    [min[1], max[1]].flatMap((y) =>\\r\\n      [min[2], max[2]].map((z): Point3 => [x, y, z]),\\r\\n    ),\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction assertBounds(bounds: Bounds): void {\\r\\n  for (let axis = 0; axis < bounds.min.length; axis += 1) {\\r\\n    const min = bounds.min[axis]\\r\\n    const max = bounds.max[axis]\\r\\n\\r\\n    if (!Number.isFinite(min) || !Number.isFinite(max) || min > max) {\\r\\n      throw new Error(`Invalid bounds on axis ${axis}: ${min}..${max}`)\\r\\n    }\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function easeOutCubic(t: number): number {\\r\\n  const clamped = Math.min(Math.max(t, 0), 1)\\r\\n  return 1 - (1 - clamped) ** 3\\r\\n}\\r\\n\\r\\nexport function lerpCameraFit(\\r\\n  from: CameraFit,\\r\\n  to: CameraFit,\\r\\n  t: number,\\r\\n): CameraFit {\\r\\n  const mix = (left: Point3, right: Point3): Point3 => [\\r\\n    left[0] + (right[0] - left[0]) * t,\\r\\n    left[1] + (right[1] - left[1]) * t,\\r\\n    left[2] + (right[2] - left[2]) * t,\\r\\n  ]\\r\\n\\r\\n  return {\\r\\n    position: mix(from.position, to.position),\\r\\n    target: mix(from.target, to.target),\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뚮씪?댁씤 ?쒖옉 ?ъ쫰: ?먮룞 ?꾨젅?대컢 ?ъ쫰瑜??源?以묒떖?쇰줈 yaw ?뚯쟾?쒗궎怨?\\n * 嫄곕━瑜?諛곗쑉留뚰겮 踰뚮┛?? 泥?濡쒕뱶 ?곗텧??異쒕컻?먯씠??\\r\\n */\\r\\nexport function flyInStartPose(\\r\\n  fit: CameraFit,\\r\\n  yawRadians: number,\\r\\n  distanceScale: number,\\r\\n): CameraFit {\\r\\n  const offset = subtract(fit.position, fit.target)\\r\\n  const cos = Math.cos(yawRadians)\\r\\n  const sin = Math.sin(yawRadians)\\r\\n  const rotated: Point3 = [\\r\\n    offset[0] * cos + offset[2] * sin,\\r\\n    offset[1],\\r\\n    -offset[0] * sin + offset[2] * cos,\\r\\n  ]\\r\\n\\r\\n  return {\\r\\n    position: [\\r\\n      fit.target[0] + rotated[0] * distanceScale,\\r\\n      fit.target[1] + rotated[1] * distanceScale,\\r\\n      fit.target[2] + rotated[2] * distanceScale,\\r\\n    ],\\r\\n    target: fit.target,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function fitCamera(bounds: Bounds): CameraFit {\\r\\n  assertBounds(bounds)\\r\\n\\r\\n  const target: Point3 = [\\r\\n    (bounds.min[0] + bounds.max[0]) / 2,\\r\\n    (bounds.min[1] + bounds.max[1]) / 2,\\r\\n    (bounds.min[2] + bounds.max[2]) / 2,\\r\\n  ]\\r\\n  const cameraZ = normalize(CAMERA_DIRECTION)\\r\\n  const cameraX = normalize(cross([0, 1, 0], cameraZ))\\r\\n  const cameraY = cross(cameraZ, cameraX)\\r\\n  const tangent = Math.tan((CAMERA_FOV_DEGREES * Math.PI) / 360)\\r\\n  const distance = Math.max(\\r\\n    Number.EPSILON,\\r\\n    ...boundsCorners(bounds).map((corner) => {\\r\\n      const relative = subtract(corner, target)\\r\\n      const projectedRadius = Math.max(\\r\\n        Math.abs(dot(relative, cameraX)),\\r\\n        Math.abs(dot(relative, cameraY)),\\r\\n      )\\r\\n\\r\\n      return (\\r\\n        dot(relative, cameraZ) +\\r\\n        (CAMERA_FRAME_MARGIN * projectedRadius) / tangent\\r\\n      )\\r\\n    }),\\r\\n  )\\r\\n  const position: Point3 = [\\r\\n    target[0] + cameraZ[0] * distance,\\r\\n    target[1] + cameraZ[1] * distance,\\r\\n    target[2] + cameraZ[2] * distance,\\r\\n  ]\\r\\n\\r\\n  return { position, target }\\r\\n}\\r\\n\\r\\nimport * as THREE from 'three'\\r\\n\\r\\nimport type { ShearBarSize } from '@/domain/model/member'\\r\\nimport type { Project } from '@/domain/model/project'\\r\\nimport type { Rebar } from '@/domain/model/rebar'\\r\\nimport {\\r\\n  buildingLayout,\\r\\n  type ConcreteBox,\\r\\n  type RebarInstance,\\r\\n} from '@/lib/viewer/building'\\r\\nimport { barDiameter } from '@/lib/viewer/geometry'\\r\\n\\r\\nimport { modelNotices } from '@/lib/export'\\r\\nimport { projectFileName } from '@/lib/persist/file'\\r\\nimport type { Locale } from '@/lib/store'\\r\\n\\r\\n/** glTF ??m ?㎪릍?뗨쫸榮꾠귟＝?곥겗佯㎪쮽??mm ?ゃ겗?㎯곫쎑?띶눣?쇿쥊??겎訝佯╉걽?묈돯?뗣?*/\\r\\nconst MILLIMETRES_TO_METRES = 0.001\\r\\n/** ?삯씊?덀굤暎쀣걚??訝뉑쑍誤뤸Æ?㏝씊?겹걣?앫겗?얇겲?뺛궊?ㅳ꺂若백뇧?ャ겒?뗣?*/\\r\\nconst CYLINDER_RADIAL_SEGMENTS = 8\\r\\nconst Y_AXIS = new THREE.Vector3(0, 1, 0)\\r\\n\\r\\nexport interface RebarModelInput {\\r\\n  project: Project\\r\\n  rebars: Rebar[]\\r\\n  /** 力②쮼???沃욁귛눣?멥꺕?밧쨯烏①ㅊ??Æ?뗣겓?귟펹??(PDL1.0)??*/\\r\\n  locale: Locale\\r\\n  /** ?띸춮?믣콝?뗣겎?띲겒?뗣겂?잓깿?먦귙궠?녈궚?ゃ꺖?덂쨼壤㏂걽?묉츐?쀣곲뎱嶺뗣겘?뤵걢?ゃ걚??*/\\r\\n  unsupportedMemberIds?: ReadonlySet<string>\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?쇈겞?띲걹??겲?얇겗若잌뜇孃?(mm)?귞뵽?㏂겗 rebarRadius ??き?욍굜?쇻걬??걼?곥겓\\r\\n * ?弱??14??.6?띲겓鸚ゃ굢?쎼걼**烏①ㅊ??*?㎯곫륫?숁Æ?뗣겎?앫굦?믢슴?녴겏 D25 ??\\n * ?40 ??짂?ⓦ걮??쮫?됥굦?뗣귝쎑?띶눣?쀣겘若잌??㎩눣?쇻?\\n *\\r\\n * 鸚ゃ걬?졼걨?㎯겘擁녈굤?ゃ걚 ??躍?춮?믡걲?딀뒠?묆겒?꾠굠?녵말嶺뗣굮?끻겢?멨뀯?뚣굥?녴굚?볝겗\\r\\n * ?듿푶?뗣굢?뷩굥??겎?갶uildingLayout ?ャ굚?뚣걯?€빊?믤륫?쇻귞뎴?밤걽?묈츪野멥겓?쇻굥?ⓦ?\\n * 鸚ゃ걬????쀣걚??겓鵝띸쉰?뚩Þ鼇덀굠?딀빊??mm ?끻겢?ュ칱?ｃ걼與▼엹?뚦눣?뗣?\\n *\\r\\n * ?쇈겞?띲겗沃?겳?밤걹??굚??겘?멥걤?쇻걬?ゃ걚 ??誤뤷뎴?뚦쨯?뤵겂?잆겏??3D ??츪野멥걽?묆걣\\r\\n * 容쇻겂??룮?꾠겲?얇겓?ゃ굥?귛폊?뤵겗??〃鹽뷴겢??barDiameter ?졼괺omain ??릪?띺뼟?겹겘\\r\\n * ?ャ꺖?ャ깙?껁궚?믣푶?㎩폊?뤻뎱嶺?(BarSize) ?쀣걢?쀣걨?싥곩ㄷ?ｈ첀若싧뱚??K13?팗13 ??\\n * 凉얇걦 ???앫굦??츣??삯뇥??텤?뗣굮若덀굥?잆굙??떗?뺛겎 (ADR-026)?곫Æ?뗣겘躍?춮??\\n * ?뤵걦??겎?볝걪?㎯겘鵝욍걟?ゃ걚??\\n */\\r\\nfunction trueRadiusMm(size: ShearBarSize): number {\\r\\n  return barDiameter(size) / 2\\r\\n}\\r\\n\\r\\nfunction trueRadiusMetres(size: ShearBarSize): number {\\r\\n  return trueRadiusMm(size) * MILLIMETRES_TO_METRES\\r\\n}\\r\\n\\r\\nfunction metres([x, y, z]: readonly number[]): THREE.Vector3 {\\r\\n  return new THREE.Vector3(x, y, z).multiplyScalar(MILLIMETRES_TO_METRES)\\r\\n}\\r\\n\\r\\n/**\\r\\n * 1?с걳?ㅳ깳?껁궥?γ겓?쇻굥?ⓦ?訝뉑쑍誤뤸Æ?㎬き?곥겒?꾢ㄷ?띲걬??깢?▲궎?ャ겓?ゃ굥??\\n * ?삯씊??뻠?⒲깛?γ꺖?ⓨ릪?섅걦?곩냶?긱겛?ⓦ겇竊뗥쨯?쏂죱?쀣겎?뷩걲\\r\\n * (glTF ??EXT_mesh_gpu_instancing)??\\n */\\r\\nfunction instancedRebar(\\r\\n  key: string,\\r\\n  instances: RebarInstance[],\\r\\n  material: THREE.Material,\\r\\n): THREE.InstancedMesh {\\r\\n  const { size, role } = instances[0]\\r\\n  const radius = trueRadiusMetres(size)\\r\\n  const geometry = new THREE.CylinderGeometry(\\r\\n    radius,\\r\\n    radius,\\r\\n    1,\\r\\n    CYLINDER_RADIAL_SEGMENTS,\\r\\n  )\\r\\n  const mesh = new THREE.InstancedMesh(geometry, material, instances.length)\\r\\n  mesh.name = `${role} ${size}`\\r\\n  mesh.userData.groupKey = key\\r\\n\\r\\n  // ?룔걬0??뙷?볝겘?γ겒????pathRuns ?뚦릪?섊궧??텥?띲굮?븅뼋?ャ걮?ゃ걚?뗣굢??\\n  // (geometry.test.ts ?뚦쎓若싥걮?╉걚???귝씎?뚣겙逆겹굦?잌냶??(scale 0) ?ャ겒?듽?\\n  // EXT_mesh_gpu_instancing ??쎑?띶눣?쀣겎 Matrix4.decompose ??1/0 ?믤럾?묆겍\\r\\n  // ?욆빪??NaN ??겲??file ?ヨ펹?뗣귙걪?볝겎?녈굯?㏝슑?쇻굠?듽곦툓役곥겗訝띶쨯?믧졏?뗣?\\n  instances.forEach((instance, index) => {\\r\\n    const from = metres(instance.from)\\r\\n    const to = metres(instance.to)\\r\\n    const direction = to.clone().sub(from)\\r\\n    const matrix = new THREE.Matrix4()\\r\\n\\r\\n    matrix\\r\\n      .makeRotationFromQuaternion(\\r\\n        new THREE.Quaternion().setFromUnitVectors(\\r\\n          Y_AXIS,\\r\\n          direction.clone().normalize(),\\r\\n        ),\\r\\n      )\\r\\n      .scale(new THREE.Vector3(1, direction.length(), 1))\\r\\n      .setPosition(from.clone().add(to).multiplyScalar(0.5))\\r\\n\\r\\n    mesh.setMatrixAt(index, matrix)\\r\\n  })\\r\\n\\r\\n  mesh.instanceMatrix.needsUpdate = true\\r\\n  return mesh\\r\\n}\\r\\n\\r\\nfunction concreteMesh(box: ConcreteBox, material: THREE.Material): THREE.Mesh {\\r\\n  const [width, height, depth] = box.size\\r\\n  const mesh = new THREE.Mesh(\\r\\n    new THREE.BoxGeometry(\\r\\n      width * MILLIMETRES_TO_METRES,\\r\\n      height * MILLIMETRES_TO_METRES,\\r\\n      depth * MILLIMETRES_TO_METRES,\\r\\n    ),\\r\\n    material,\\r\\n  )\\r\\n  mesh.name = `${box.kind} ${box.memberId}`\\r\\n  mesh.position.copy(metres(box.center))\\r\\n  return mesh\\r\\n}\\r\\n\\r\\n/**\\r\\n * 壤밧돯?ⓨ뫜?녑릫?㎩늽?묆굥?귛릪???13 ?㎯굚 ?귙겙?됬춮 ??亮끾??곭춮 ??닪??깕?쇈깋?ャ걲????\\n * ?쀣걨?뽧겂?잌겢?뚦쎋?㏂겏?뚣걯鼇?됥겎?얇걟?뗣굠?녴겓?쇻굥?잆굙??(ADR-008)??\\n */\\r\\nfunction groupForExport(\\r\\n  instances: RebarInstance[],\\r\\n): Map<string, RebarInstance[]> {\\r\\n  const groups = new Map<string, RebarInstance[]>()\\r\\n\\r\\n  for (const instance of instances) {\\r\\n    const key = `${instance.role}|${instance.size}`\\r\\n    const group = groups.get(key)\\r\\n    if (group === undefined) groups.set(key, [instance])\\r\\n    else group.push(instance)\\r\\n  }\\r\\n\\r\\n  return groups\\r\\n}\\r\\n\\r\\n/**\\r\\n * 旅덁뻑?얇굥?붵겏??3D 與▼엹 (PRD 짠4)?귞뵽?㏂겗?겹꺁?껁깋?삣쑑?㏂꺕壤긱겘?γ굦?ゃ걚 ??\\n * 誤뗣걵?뗣걼?곥겗?볟끁?㎯걗?ｃ겍與▼엹????ⓦ겎??겒?꾠?\\n */\\r\\nexport function buildRebarScene(input: RebarModelInput): THREE.Scene {\\r\\n  const layout = buildingLayout(\\r\\n    input.project,\\r\\n    input.rebars,\\r\\n    input.unsupportedMemberIds ?? new Set<string>(),\\r\\n    trueRadiusMm,\\r\\n  )\\r\\n  const scene = new THREE.Scene()\\r\\n  scene.name = input.project.name\\r\\n  // GLTFExporter ??userData ??extras ?ⓦ걮??쎑?띶눣?쇻괾lTF ?ヨ〃??죱??꽒?꾠겗?㎯?\\n  // xlsx ??뤵걢?쀨죱?사츞?뷸졊?졼깣??긿??겓壤볝걼?뗣굚??굮?볝걪?ョ쉰?????뷴끂烏①ㅊ?ⓩ뵻鸚?\\n  // 烏①ㅊ??뀓躍껆돥?ヤ퍡?뤹쑴?쇻겎?귙겂?╉곫쎑?띶눣?쀣겗永뚩러?붵겏?ュ뀓?뚣굥?귙겗?㎯겘?ゃ걚??\\n  //\\r\\n  // 歷▲걲??겘?꾤춮??ruleHits ?졼걨?졼굕lsx ??QuantityLine.rules ?믦쫳?뗣겗??\\n  // ?꿨쥥?뉎걣訝烏뚦쥥?덀굥?뚣갾lb ?뚪걢?뜰겗??숱?뜰겎?귙겂??빊?뤵겎??겒?????앫겗?ㅳ굮\\r\\n  // ?ャ겲?ゃ걚?띶툋?⒲겗?뷴끂?ャ곫빊?뤵걽?묆겗?방떊?믥쳦?╉겒?꾠귝뻼?멥겏?쀣겍??눣?멥겘\\r\\n  // 若잍릍??xlsx ?ⓨ릪訝??(?꿨쥥?뉎겗?뷴끂 `?곈뇧令띸츞?뷸틬` ??곫릍?딀뼶??졊?졼겏?쀣겍\\r\\n  // 壤®듁?담겓?귝뿢?ヨ펹?ｃ겍?꾠굥)??\\n  scene.userData = modelNotices(\\r\\n    input.rebars.flatMap(({ ruleHits }) => ruleHits),\\r\\n    input.locale,\\r\\n  )\\r\\n\\r\\n  const rebarGroup = new THREE.Group()\\r\\n  rebarGroup.name = '?꾤춮'\\r\\n  const rebarMaterial = new THREE.MeshStandardMaterial({\\r\\n    color: 0x9aa0a6,\\r\\n    metalness: 0.6,\\r\\n    roughness: 0.45,\\r\\n  })\\r\\n  rebarMaterial.name = '?꾤춮'\\r\\n  for (const [key, instances] of groupForExport(layout.rebar)) {\\r\\n    rebarGroup.add(instancedRebar(key, instances, rebarMaterial))\\r\\n  }\\r\\n\\r\\n  const concreteGroup = new THREE.Group()\\r\\n  concreteGroup.name = '?녈꺍??꺁?쇈깉'\\r\\n  const concreteMaterial = new THREE.MeshStandardMaterial({\\r\\n    color: 0xd6d3cb,\\r\\n    transparent: true,\\r\\n    opacity: 0.25,\\r\\n    roughness: 0.9,\\r\\n  })\\r\\n  concreteMaterial.name = '?녈꺍??꺁?쇈깉'\\r\\n  for (const box of layout.boxes) {\\r\\n    concreteGroup.add(concreteMesh(box, concreteMaterial))\\r\\n  }\\r\\n\\r\\n  scene.add(rebarGroup, concreteGroup)\\r\\n  return scene\\r\\n}\\r\\n\\r\\nfunction disposeScene(scene: THREE.Scene): void {\\r\\n  const materials = new Set<THREE.Material>()\\r\\n\\r\\n  scene.traverse((object) => {\\r\\n    const mesh = object as THREE.Mesh\\r\\n    if (!mesh.isMesh) return\\r\\n\\r\\n    mesh.geometry.dispose()\\r\\n    for (const material of [mesh.material].flat()) materials.add(material)\\r\\n    if ((object as THREE.InstancedMesh).isInstancedMesh) {\\r\\n      ;(object as THREE.InstancedMesh).dispose()\\r\\n    }\\r\\n  })\\r\\n\\r\\n  for (const material of materials) material.dispose()\\r\\n}\\r\\n\\r\\nexport function rebarModelFileName(projectName: string): string {\\r\\n  return projectFileName(projectName).replace(/\\\\.json$/, '.glb')\\r\\n}\\r\\n\\r\\nexport async function exportRebarGlb(input: RebarModelInput): Promise<void> {\\r\\n  const scene = buildRebarScene(input)\\r\\n\\r\\n  try {\\r\\n    // ?뺟쉪 import ??try ??릎?ョ쉰?뤵귙걪??눇?뚧꺍若싥걮?╉걚?뗥ㅁ?쀣겘?얇걬??\\n    // ?똳hree ??죯?뚦룚?뚣겒?꾠띲걪?ⓦ겎?곩쨼?ョ쉰?뤵겏1訝뉑쑍?뜰굯??\\n    // CylinderGeometry ?믤렣?볝걽?얇겲?ⓦ겍?뗣걪?ⓦ겓?ゃ굥??\\n    const { GLTFExporter } = await import(\\r\\n      'three/examples/jsm/exporters/GLTFExporter.js'\\r\\n    )\\r\\n    const output = await new GLTFExporter().parseAsync(scene, { binary: true })\\r\\n    const blob = new Blob([output as ArrayBuffer], {\\r\\n      type: 'model/gltf-binary',\\r\\n    })\\r\\n    const url = URL.createObjectURL(blob)\\r\\n    const anchor = document.createElement('a')\\r\\n    anchor.href = url\\r\\n    anchor.download = rebarModelFileName(input.project.name)\\r\\n    anchor.style.display = 'none'\\r\\n    document.body.appendChild(anchor)\\r\\n    anchor.click()\\r\\n    anchor.remove()\\r\\n    URL.revokeObjectURL(url)\\r\\n  } finally {\\r\\n    // 1訝뉑쑍誤뤸Æ??냶?긱굮 GPU ?ユ츐?쀣걼?얇겲?ャ걮?ゃ걚??\\n    disposeScene(scene)\\r\\n  }\\r\\n}\\r\\n\\r\\nimport {\\r\\n  decomposeGirderMainRow,\\r\\n  type GirderSection,\\r\\n  type Member,\\r\\n} from '../model/member'\\r\\nimport type { GirderRun, GirderSpan } from '../model/project'\\r\\nimport type { Rebar, RebarZone, Vec3 } from '../model/rebar'\\r\\nimport { MemberUnsupportedError } from '../model/unsupported'\\r\\nimport {\\r\\n  coverConditions,\\r\\n  lookupRule,\\r\\n  lookupRuleSeries,\\r\\n} from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\nimport {\\r\\n  barDiameter,\\r\\n  resolveGirderEnd,\\r\\n  type GirderEndDetail,\\r\\n} from './girder-ends'\\r\\nimport {\\r\\n  bandedSpliceRule,\\r\\n  distributionCount,\\r\\n  hoopDesignLengthMm,\\r\\n  intervalSpliceCount,\\r\\n  spliceCount,\\r\\n  spliceLengthMm,\\r\\n  widthTieDesignLengthMm,\\r\\n  type SpliceBand,\\r\\n} from './measurement'\\r\\nimport {\\r\\n  stirrupPositions,\\r\\n  symmetricInwardDirections,\\r\\n} from './stirrup-layout'\\r\\n\\r\\nexport interface GirderRebarInput {\\r\\n  run: GirderRun\\r\\n  section: GirderSection\\r\\n}\\r\\n\\r\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\r\\n  if (rule.unit === 'mm') return rule.value\\r\\n  if (rule.unit === 'd' && diameter !== undefined) {\\r\\n    return rule.value * diameter\\r\\n  }\\r\\n\\r\\n  throw new Error(\\r\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction shearBarDiameter(size: GirderSection['stirrup']['size']): number {\\r\\n  const diameter = Number(size.replace(/^[A-Z]+/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid ShearBarSize: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nfunction hookTailLengthMm(rule: RuleHit, size: GirderSection['stirrup']['size']): number {\\r\\n  return millimetres(rule, shearBarDiameter(size))\\r\\n}\\r\\n\\r\\nfunction twoInwardTails(\\r\\n  origin: Vec3,\\r\\n  lengthMm: number,\\r\\n  directions: [[number, number], [number, number]],\\r\\n): [Vec3, Vec3] {\\r\\n  return directions.map(([first, second]) => {\\r\\n    const magnitude = Math.hypot(first, second)\\r\\n    return [\\r\\n      origin[0],\\r\\n      origin[1] + (lengthMm * first) / magnitude,\\r\\n      origin[2] + (lengthMm * second) / magnitude,\\r\\n    ]\\r\\n  }) as [Vec3, Vec3]\\r\\n}\\r\\n\\r\\nfunction uniqueRuleHits(hits: RuleHit[]): RuleHit[] {\\r\\n  return [...new Set(hits)]\\r\\n}\\r\\n\\r\\nfunction endFormula(label: string, detail: GirderEndDetail): string {\\r\\n  if (detail.kind === '?당퇉若싩?') {\\r\\n    return `${label} ?당퇉若싩? L1 ${detail.lengthMm}`\\r\\n  }\\r\\n\\r\\n  // lengthMm쨌projectionMm ? 理쒖냼移섏???max 寃곌낵????L1쨌La 濡??쒓린?섎㈃ 烏?.3.4쨌\\r\\n  // 烏?.3.5 ? ?議고븯??寃?좎옄?먭쾶 洹쇨굅媛 ?由?寃껋쑝濡?蹂댁씤?? 吏諛고븳 ??쓣 諛앺엺??\\r\\n  // max 媛 嫄몃━????곸? ?뚦엩?답퐰?룔띿씠 ?꾨땲??**?③빓**?대떎 ??5.3.4(5)(節?(a) 媛\\r\\n  // ?③빓?? (b) 媛 鵝숅빓???섑븳??二쇰?濡?(b) 瑜??③빓 ?섑븳?쇰줈 ?섏궛??鍮꾧탳?쒕떎.\\r\\n  const verticalTailMm = detail.lengthMm - detail.projectionMm\\r\\n  return (\\r\\n    `${label} ?섉쎊?믣츣? ?③빓 ${detail.lengthMm}` +\\r\\n    `竊?a) ?당퇉若싩? L1 ${detail.straightMinimumMm} ??` +\\r\\n    `(b) ?뺝쉽竊뗤퐰?룝툔??${detail.tailMinimumMm} ??ㄷ竊? +\\r\\n    `竊덂냵鼇?竊??뺝쉽 ${detail.projectionMm}竊?c) La ${detail.laMm} ??` +\\r\\n    `?긱걵?꽸쀦뒘壤긴툔??${detail.projectionMinimumMm} ??ㄷ竊?竊??귞쎍鵝숅빓 ${verticalTailMm}竊?\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction runCoreFormula(run: GirderRun): string {\\r\\n  const clearTerms = run.spans.map(({ clear }) => clear).join('竊?)\\r\\n  const intermediateSupportTerms = run.spans\\r\\n    .slice(0, -1)\\r\\n    .map(({ endSupportLengthAlongAxisMm }) => endSupportLengthAlongAxisMm)\\r\\n    .join('竊?)\\r\\n\\r\\n  return intermediateSupportTerms === ''\\r\\n    ? `?끾퀡?룔걬 ${clearTerms}`\\r\\n    : `?끾퀡?룔걬 ${clearTerms} 竊?訝?뼋?긱걵??${intermediateSupportTerms}`\\r\\n}\\r\\n\\r\\nfunction mainPoints(\\r\\n  clearMm: number,\\r\\n  y: number,\\r\\n  z: number,\\r\\n  start: GirderEndDetail,\\r\\n  end: GirderEndDetail,\\r\\n): Rebar['points'] {\\r\\n  const points: Rebar['points'] = []\\r\\n\\r\\n  if (start.kind === '?당퇉若싩?') {\\r\\n    points.push([-start.lengthMm, y, z])\\r\\n  } else {\\r\\n    const verticalTailMm = start.lengthMm - start.projectionMm\\r\\n    const direction = start.direction === '訝? ? 1 : -1\\r\\n    points.push(\\r\\n      [\\r\\n        -start.projectionMm,\\r\\n        y + direction * verticalTailMm,\\r\\n        z,\\r\\n      ],\\r\\n      [-start.projectionMm, y, z],\\r\\n    )\\r\\n  }\\r\\n\\r\\n  if (end.kind === '?당퇉若싩?') {\\r\\n    points.push([clearMm + end.lengthMm, y, z])\\r\\n  } else {\\r\\n    const verticalTailMm = end.lengthMm - end.projectionMm\\r\\n    const direction = end.direction === '訝? ? 1 : -1\\r\\n    points.push(\\r\\n      [clearMm + end.projectionMm, y, z],\\r\\n      [\\r\\n        clearMm + end.projectionMm,\\r\\n        y + direction * verticalTailMm,\\r\\n        z,\\r\\n      ],\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return points\\r\\n}\\r\\n\\r\\n/**\\r\\n * 竊덌폆竊됪쥈2) ??뙷?녻〃?귚퐬?뷴늽?귙굥?뗣겘?ャ꺖?ャ깙?껁궚?뚧군?곥굥??겎?곮죱?믡걹??겲?얕き???\\n * 訝딃솏?믤똻?잆겒?꾥죱?뚧?孃뚣겗?뷴늽?ャ겒?????ㅵ츣??bandedSpliceRule ?뚣굜?뗣?\\n */\\r\\nfunction continuousGirderBands(pack: RulePack): SpliceBand[] {\\r\\n  const counts = lookupRuleSeries(\\r\\n    pack,\\r\\n    'measure.splice.girder.continuous',\\r\\n    'band',\\r\\n  )\\r\\n  const upperBounds = new Map(\\r\\n    lookupRuleSeries(\\r\\n      pack,\\r\\n      'measure.splice.girder.continuous.band.upper',\\r\\n      'band',\\r\\n    ).map((rule) => [rule.conditions.band, rule]),\\r\\n  )\\r\\n\\r\\n  return counts.map((countRule) => ({\\r\\n    countRule,\\r\\n    upperBoundRule: upperBounds.get(countRule.conditions.band) ?? null,\\r\\n  }))\\r\\n}\\r\\n\\r\\ninterface GirderSplice {\\r\\n  countPerBar: number\\r\\n  lengthMm: number\\r\\n  rules: RuleHit[]\\r\\n  basis: string\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?싥걮嶺뗣겗泳숁뎸 (?곈뇧令띸츞?뷸틬)??\\n *\\r\\n * ?⒲꺍???밤깙?념빳訝듽겒?됥뚪ｇ텥?쇻굥歟곥겗?③빓?ャ굩?잆굥訝사춮?띲겒??겎 竊덌폆竊됪쥈2) ??\\n * ?뷴늽烏ⓦ걣 1?싧뎴4) ?믢툓?멥걤?쇻굥???밤깙?녈겗?⒲꺍??뜕?ф쥈?ゃ겗?㎩릪?▲걼?졼걮?멥걤??\\n * 1?싧뎴4) ?ユ댗?듽곩푶?붵겏??빓?뺛겗?섆퐤?㎪빊?덀굥??\\n */\\r\\nfunction spliceFrom(\\r\\n  countRule: RuleHit,\\r\\n  countPerBar: number,\\r\\n  basis: string,\\r\\n  section: GirderSection,\\r\\n  lapRule: RuleHit,\\r\\n  lapLengthMm: number,\\r\\n  pack: RulePack,\\r\\n): GirderSplice {\\r\\n  const factorRule = lookupRule(pack, 'measure.splice.length.factor', {\\r\\n    method: section.spliceMethod,\\r\\n  })\\r\\n  const lengthMm = spliceLengthMm(countPerBar, lapLengthMm, factorRule)\\r\\n  const rules = [countRule, factorRule]\\r\\n\\r\\n  if (lengthMm > 0) rules.push(lapRule)\\r\\n\\r\\n  return { countPerBar, lengthMm, rules, basis }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 1?싧뎴4) ??孃꾠걫?ⓦ겗?룔걬??뜕鵝띲겎?겹걟?뗣귙뚧쥈??뀲?룔겓?뤵걼?뗤말嶺뗣띲겎?ゃ걚?꾤춮\\r\\n * 竊덂뜕?ф쥈??싥걮嶺뗣꺕?ャ긿?덀궕?뺟춮竊됥겘?볝걪?ユ댗?뗰펷竊덌폆竊됪쥈2) ?잆걽?쀦쎑?랃펹??\\n */\\r\\nfunction intervalSplice(\\r\\n  label: string,\\r\\n  section: GirderSection,\\r\\n  designLengthBeforeSpliceMm: number,\\r\\n  lapRule: RuleHit,\\r\\n  lapLengthMm: number,\\r\\n  pack: RulePack,\\r\\n): GirderSplice {\\r\\n  const countRule = lookupRule(pack, 'measure.splice.interval', {\\r\\n    size: section.main.size,\\r\\n  })\\r\\n\\r\\n  return spliceFrom(\\r\\n    countRule,\\r\\n    intervalSpliceCount(designLengthBeforeSpliceMm, countRule),\\r\\n    `${label} ?꾤춮??빓??${designLengthBeforeSpliceMm} 첨 ${countRule.value}mm ?붵겏竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴4)竊?,\\r\\n    section,\\r\\n    lapRule,\\r\\n    lapLengthMm,\\r\\n    pack,\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction resolveSplice(\\r\\n  run: GirderRun,\\r\\n  section: GirderSection,\\r\\n  designLengthBeforeSpliceMm: number,\\r\\n  lapRule: RuleHit,\\r\\n  lapLengthMm: number,\\r\\n  pack: RulePack,\\r\\n): GirderSplice {\\r\\n  if (run.members.length === 1) {\\r\\n    return intervalSplice(\\r\\n      '?섊떖歟?,\\r\\n      section,\\r\\n      designLengthBeforeSpliceMm,\\r\\n      lapRule,\\r\\n      lapLengthMm,\\r\\n      pack,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const countRule = bandedSpliceRule(\\r\\n    run.coreLengthMm,\\r\\n    continuousGirderBands(pack),\\r\\n  )\\r\\n\\r\\n  return spliceFrom(\\r\\n    countRule,\\r\\n    spliceCount(countRule),\\r\\n    `?ｇ텥歟?歟곥겗?룔걬 ${run.coreLengthMm}竊덃빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈2)竊?,\\r\\n    section,\\r\\n    lapRule,\\r\\n    lapLengthMm,\\r\\n    pack,\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction generateMain(\\r\\n  input: GirderRebarInput,\\r\\n  pack: RulePack,\\r\\n  coverRule: RuleHit,\\r\\n  fabricationCoverAdditionRule: RuleHit,\\r\\n  fabricationCoverMm: number,\\r\\n  row: {\\r\\n    id: 'top' | 'bottom'\\r\\n    role: '訝딁ク嶺? | '訝뗧ク嶺?\\r\\n    count: number\\r\\n    y: number\\r\\n    bendDirection: '訝? | '訝?\\r\\n  },\\r\\n): Rebar {\\r\\n  const { run, section } = input\\r\\n  const startSpan = run.spans[0]\\r\\n  const endSpan = run.spans.at(-1)\\r\\n  if (startSpan === undefined || endSpan === undefined) {\\r\\n    throw new Error('GirderRun must contain at least one span')\\r\\n  }\\r\\n  const endInput = {\\r\\n    barSize: section.main.size,\\r\\n    fc: section.fc,\\r\\n    grade: section.grade,\\r\\n    bendDirection: row.bendDirection,\\r\\n  }\\r\\n  const start = resolveGirderEnd(\\r\\n    {\\r\\n      ...endInput,\\r\\n      supportLengthMm: startSpan.startSupportLengthAlongAxisMm,\\r\\n      supportCover: startSpan.startSupportCover,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  const end = resolveGirderEnd(\\r\\n    {\\r\\n      ...endInput,\\r\\n      supportLengthMm: endSpan.endSupportLengthAlongAxisMm,\\r\\n      supportCover: endSpan.endSupportCover,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  // 3D ?ユ룒?뗣굦?뗩빓?뺛귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?싥곮Þ鼇덆빓?뺛겓?졼걨?γ굥??\\n  const drawnLength = run.coreLengthMm + start.lengthMm + end.lengthMm\\r\\n  const lapRule = lookupRule(pack, 'lap.L1', {\\r\\n    fc: section.fc,\\r\\n    grade: section.grade,\\r\\n    hook: false,\\r\\n  })\\r\\n  const lapLengthMm = millimetres(lapRule, barDiameter(section.main.size))\\r\\n  const splice = resolveSplice(\\r\\n    run,\\r\\n    section,\\r\\n    drawnLength,\\r\\n    lapRule,\\r\\n    lapLengthMm,\\r\\n    pack,\\r\\n  )\\r\\n  const length = drawnLength + splice.lengthMm\\r\\n  const zones: RebarZone[] = [\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: start.lengthRule,\\r\\n      pathFromMm: 0,\\r\\n      pathToMm: start.lengthMm,\\r\\n    },\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: end.lengthRule,\\r\\n      pathFromMm: drawnLength - end.lengthMm,\\r\\n      pathToMm: drawnLength,\\r\\n    },\\r\\n  ]\\r\\n  // 0?뗦??㏝빓?뺛걣罌쀣걟?ゃ걚??겘嶸뉑??겹겗?쎼걚?㎯곫뼶凉뤵겗?쎼걚?㎯겘?ゃ걚??\\n  // 訝?ㅳ겗?녶쾺?ャ겲?ⓦ굙?뗣겏 0?뗦???뜕?ф쥈?얇겎?뚣걹??뼶凉뤵겘?룔걬?뚦쨯?뤵굢?ゃ걚?띲겏\\r\\n  // 沃ф삇?쀣곩릪?섋죱?뚦눣?멥겓?쇻걩??measure.splice.length.factor ?③짘?꾦걬?녴?\\n  const spliceLengthTerm =\\r\\n    splice.countPerBar === 0\\r\\n      ? `0?뗦? 竊?0`\\r\\n      : splice.lengthMm > 0\\r\\n        ? `${splice.countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 L1 ${lapRule.value}d(${lapLengthMm}) 竊?${splice.lengthMm}`\\r\\n        : `${splice.countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\\r\\n  const fabricationCoverFormula =\\r\\n    `?졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊?` +\\r\\n    `?좂츞 ${fabricationCoverAdditionRule.value} 竊?${fabricationCoverMm}竊?\\r\\n\\r\\n  return {\\r\\n    id: `${run.ownerId}|${row.id}`,\\r\\n    memberId: run.ownerId,\\r\\n    role: row.role,\\r\\n    size: section.main.size,\\r\\n    shape:\\r\\n      start.kind === '?섉쎊?믣츣?' || end.kind === '?섉쎊?믣츣?'\\r\\n        ? 'hook90'\\r\\n        : 'straight',\\r\\n    points: mainPoints(\\r\\n      run.coreLengthMm,\\r\\n      row.y,\\r\\n      fabricationCoverMm,\\r\\n      start,\\r\\n      end,\\r\\n    ),\\r\\n    closed: false,\\r\\n    length,\\r\\n    count: row.count,\\r\\n    zones,\\r\\n    splice: {\\r\\n      method: section.spliceMethod,\\r\\n      countPerBar: splice.countPerBar,\\r\\n      lengthMm: splice.lengthMm,\\r\\n      rules: splice.rules,\\r\\n      formula:\\r\\n        `泳숁뎸嶸뉑???竊?${row.role}1?с걗?잆굤 ${splice.countPerBar}?뗦?` +\\r\\n        `竊?{splice.basis}竊?竊?` +\\r\\n        `?밧폀 竊?${section.spliceMethod} 竊?` +\\r\\n        `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm} 竊?` +\\r\\n        `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\\r\\n    },\\r\\n    ruleHits: uniqueRuleHits([\\r\\n      coverRule,\\r\\n      fabricationCoverAdditionRule,\\r\\n      ...start.usedRules,\\r\\n      ...end.usedRules,\\r\\n      ...splice.rules,\\r\\n    ]),\\r\\n    formula:\\r\\n      `鼇?쮫?룔걬 竊?${runCoreFormula(run)} 竊?${endFormula('冶뗧ク', start)} ` +\\r\\n      `竊?${endFormula('永귞ク', end)} 竊?泳숁뎸 ${spliceLengthTerm} 竊?${length} 竊?` +\\r\\n      `?띸쉰?뷸틬 竊?${fabricationCoverFormula} 竊?` +\\r\\n      `?ф빊 竊???씊訝誤㎯겗${row.role}?ф빊 ${row.count} 竊?` +\\r\\n      `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚` +\\r\\n      `竊덃룒?뗣굦?뗥뒥藥ι빓 ${drawnLength} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹`,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?ャ긿?덀궕?뺟춮竊덃쥈??뀲?룔겓?뤵걼?됥겒?꾡말嶺뗰펹1?с걣塋뗣겇鵝띸쉰??\\n *\\r\\n * ?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1) ?뚣뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑\\r\\n * ?ャ굠?뗣띲겏冶붵겖?뗣겗?㎯곩늾?딀??곦퐤營?겘??씊訝誤㎯겗?ε뒟?㎯걗?뗣귙걪?볝걣永꾠겳塋뗣겍?뗣겗??\\n * ?앫겗?ε뒟?ⓩ뵱?밧?力뺛꺕若싩??룔걬?뗣굢??빓?뺛걽?묆겎?곮쫸繹뽩ㅳ겘若싩??쀣걢鵝욍굩?ゃ걚??\\n */\\r\\ninterface CutoffPosition {\\r\\n  /** 洹??遺?????곈뇧???잆겖 ?⑥쐞媛 ?쒕떎 */\\r\\n  memberId: string\\r\\n  /** ?앫겗鵝띸쉰?ョ쳦???뗦??귙걼?듽겗?ф빊 */\\r\\n  count: number\\r\\n  /** ?뚥?餘듐겗?좂빁?룔겎?곥걪??죱?뚦뜝?곥굥??앫겗鵝띸쉰 */\\r\\n  slotStart: number\\r\\n  /** 遺??濡쒖뺄 x?먯꽌 洹몃━湲??쒖옉?섎뒗 ?꾩튂 (mm) */\\r\\n  fromMm: number\\r\\n  /** 3D??洹몃━??湲몄씠 (mm) */\\r\\n  drawnMm: number\\r\\n  /** 泳숁뎸 ?곗엯 ?꾩쓽 鼇?쮫?룔걬 (mm) */\\r\\n  designMm: number\\r\\n  /** ???꾩튂??湲몄씠瑜??뺥븳 猷???(?몄륫 吏?먯쓽 若싩?) */\\r\\n  rules: RuleHit[]\\r\\n  basis: string\\r\\n}\\r\\n\\r\\ninterface CutoffRow {\\r\\n  role: '訝딁ク?ャ긿?덀궕?뺟춮' | '訝뗧ク?ャ긿?덀궕?뺟춮'\\r\\n  /** 1?뗦??귙걼?듽겗?ф빊 */\\r\\n  count: number\\r\\n  at: '塋?깿' | '冶뗧ク?밤궭?? | '永귞ク?밤궭?? | '冶뗧ク' | '永귞ク' | '訝?ㄾ'\\r\\n  slotStart: number\\r\\n  y: number\\r\\n  bendDirection: '訝? | '訝?\\r\\n}\\r\\n\\r\\nfunction cutoffPositions(\\r\\n  input: GirderRebarInput,\\r\\n  pack: RulePack,\\r\\n  row: CutoffRow,\\r\\n): CutoffPosition[] {\\r\\n  const { run, section } = input\\r\\n  const cutoffMm = section.main.cutoffFromSupportFaceMm\\r\\n\\r\\n  if (cutoffMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '?ャ긿?덀궕?뺜퐤營?툖?먪쳦',\\r\\n      `?ャ긿?덀궕?뺜퐤營?must be positive when 塋?깿?ⓧ릎鸚?겗?ф빊?뚪걬?? ` +\\r\\n        `${run.ownerId} (${row.role} ${row.count}??`,\\r\\n    )\\r\\n  }\\r\\n  // 訝←ク?뗣굢鴉멥겞?뗣궖?껁깉?ゃ깢嶺뗣걣?뷰폏?녽빓?뺛겎??곥걹??쑍?겹겘訝?ㄾ?ャ굚塋뗣겂??\\n  // ?꾠굥?볝겏?ャ겒?듽뚥퐤營?닪?ユ쑍?겹걣?뺛걝?띲겏?꾠걝?ε뒟?や퐪?뚧닇?딁쳦?잆겒?꾠?\\n  const tooShort = run.spans.find(({ clear }) => clear <= 2 * cutoffMm)\\r\\n  if (tooShort) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '?ャ긿?덀궕?뺜퐤營?툖?먪쳦',\\r\\n      `?끾퀡?룔걬 must exceed 2횞?ャ긿?덀궕?뺜퐤營? ${run.ownerId} ` +\\r\\n        `(?끾퀡 ${tooShort.clear} ??2횞${cutoffMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  if (row.at === '訝?ㄾ') {\\r\\n    return run.members.map((member, index) => {\\r\\n      const { clear } = run.spans[index]\\r\\n      const designMm = clear - 2 * cutoffMm\\r\\n\\r\\n      return {\\r\\n        memberId: member.id,\\r\\n        count: row.count,\\r\\n        slotStart: row.slotStart,\\r\\n        fromMm: cutoffMm,\\r\\n        drawnMm: designMm,\\r\\n        designMm,\\r\\n        rules: [],\\r\\n        basis:\\r\\n          `?끾퀡?룔걬 ${clear} ???ャ긿?덀궕?뺜퐤營?${cutoffMm} 횞2 竊?${designMm}` +\\r\\n          `竊덁륫?담겗??궧?뗥뎺?㎩늾?딀??얇굥??겎若싩???겒?꾬펹`,\\r\\n      }\\r\\n    })\\r\\n  }\\r\\n\\r\\n  const endInput = {\\r\\n    barSize: section.main.size,\\r\\n    fc: section.fc,\\r\\n    grade: section.grade,\\r\\n    bendDirection: row.bendDirection,\\r\\n  }\\r\\n  const startSpan = run.spans[0]\\r\\n  const endSpan = run.spans[run.spans.length - 1]\\r\\n  const start = resolveGirderEnd(\\r\\n    {\\r\\n      ...endInput,\\r\\n      supportLengthMm: startSpan.startSupportLengthAlongAxisMm,\\r\\n      supportCover: startSpan.startSupportCover,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  const end = resolveGirderEnd(\\r\\n    {\\r\\n      ...endInput,\\r\\n      supportLengthMm: endSpan.endSupportLengthAlongAxisMm,\\r\\n      supportCover: endSpan.endSupportCover,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n\\r\\n  if (row.at === '冶뗧ク' || row.at === '永귞ク') {\\r\\n    if (run.spans.length !== 1) {\\r\\n      throw new MemberUnsupportedError(\\r\\n        '?ャ긿?덀궕?뺜퐤營?툖?먪쳦',\\r\\n        `鸚뽫ク/?끿ク?뚣꺀?녈겗?⒲겗??궧?뗥츣?곥굢?뚣겒?? ${run.ownerId}`,\\r\\n      )\\r\\n    }\\r\\n\\r\\n    const span = run.spans[0]\\r\\n    const detail = row.at === '冶뗧ク' ? start : end\\r\\n    const drawnMm = span.clear - cutoffMm\\r\\n    const label = row.at === '冶뗧ク' ? '冶뗧ク??궧' : '永귞ク??궧'\\r\\n\\r\\n    return [\\r\\n      {\\r\\n        memberId: run.ownerId,\\r\\n        count: row.count,\\r\\n        slotStart: row.slotStart,\\r\\n        fromMm: row.at === '冶뗧ク' ? 0 : cutoffMm,\\r\\n        drawnMm,\\r\\n        designMm: drawnMm + detail.lengthMm,\\r\\n        rules: detail.usedRules,\\r\\n        basis:\\r\\n          `${endFormula(label, detail)} 竊??끾퀡?룔걬 ${span.clear} ??` +\\r\\n          `?ャ긿?덀궕?뺜퐤營?${cutoffMm} 竊?${drawnMm} 竊?${detail.lengthMm} 竊?` +\\r\\n          `${drawnMm + detail.lengthMm}`,\\r\\n      },\\r\\n    ]\\r\\n  }\\r\\n\\r\\n  if (row.at === '冶뗧ク?밤궭?? || row.at === '永귞ク?밤궭??) {\\r\\n    const detail = row.at === '冶뗧ク?밤궭?? ? start : end\\r\\n    const label = row.at === '冶뗧ク?밤궭?? ? '冶뗧ク??궧' : '永귞ク??궧'\\r\\n\\r\\n    return [\\r\\n      {\\r\\n        memberId: run.ownerId,\\r\\n        count: row.count,\\r\\n        slotStart: row.slotStart,\\r\\n        fromMm:\\r\\n          row.at === '冶뗧ク?밤궭?? ? 0 : run.coreLengthMm - cutoffMm,\\r\\n        drawnMm: cutoffMm,\\r\\n        designMm: detail.lengthMm + cutoffMm,\\r\\n        rules: detail.usedRules,\\r\\n        basis:\\r\\n          `${endFormula(label, detail)} 竊??ャ긿?덀궕?뺜퐤營?${cutoffMm} 竊?` +\\r\\n          `${detail.lengthMm + cutoffMm}`,\\r\\n      },\\r\\n    ]\\r\\n  }\\r\\n\\r\\n  // 冶뗧ク?사탞塋?굮?띲겎?녴걨?ゃ걚 ??訝←ク??츣??뚦릪?섅겒?됧읃鹽롥폀?귛릪?섉뻼耶쀥닓?ャ겒?듽?\\n  // 1烏뚣겓?잆겖?잆겏?띲겓?뚣걯鼇덄츞?뚥틠佯╊를?겹겒?꾠귡걬?덀겙鼇?쮫?룔걬?귡걬?녴겗?㎩닪烏뚣겓?ゃ굥??\\n  const outer = (\\r\\n    detail: GirderEndDetail,\\r\\n    fromMm: number,\\r\\n  ): CutoffPosition => ({\\r\\n    memberId: run.ownerId,\\r\\n    count: row.count,\\r\\n    slotStart: row.slotStart,\\r\\n    fromMm,\\r\\n    drawnMm: cutoffMm,\\r\\n    designMm: detail.lengthMm + cutoffMm,\\r\\n    rules: detail.usedRules,\\r\\n    basis:\\r\\n      `${endFormula('鸚뽩겢??궧', detail)} 竊??ャ긿?덀궕?뺜퐤營?${cutoffMm} 竊?` +\\r\\n      `${detail.lengthMm + cutoffMm}`,\\r\\n  })\\r\\n  // 訝?뼋??궧??싥걮嶺뗣겏?뚣걯?뤺껀?싥걲????若싩???겇?뗣걳?곦륫?ｃ겗?밤깙?녈겦\\r\\n  // ?ャ긿?덀궕?뺜퐤營?겤?볝걳?ㅴ섯?녈굥??\\n  const interior = run.spans.slice(0, -1).map((_span, index): CutoffPosition => {\\r\\n    const supportStartMm = run.memberOffsetsMm[index] + run.spans[index].clear\\r\\n    const supportMm = run.memberOffsetsMm[index + 1] - supportStartMm\\r\\n    const designMm = 2 * cutoffMm + supportMm\\r\\n\\r\\n    return {\\r\\n      memberId: run.ownerId,\\r\\n      count: row.count,\\r\\n      slotStart: row.slotStart,\\r\\n      fromMm: supportStartMm - cutoffMm,\\r\\n      drawnMm: designMm,\\r\\n      designMm,\\r\\n      rules: [],\\r\\n      basis:\\r\\n        `?ャ긿?덀궕?뺜퐤營?${cutoffMm} 횞2 竊?訝?뼋?긱걵??${supportMm} 竊?${designMm}` +\\r\\n        `竊덁릎?볠뵱?밤굮?싥걲??겎若싩???겒?꾬펹`,\\r\\n    }\\r\\n  })\\r\\n\\r\\n  return [\\r\\n    outer(start, 0),\\r\\n    ...interior,\\r\\n    outer(end, run.coreLengthMm - cutoffMm),\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction generateCutoff(\\r\\n  input: GirderRebarInput,\\r\\n  pack: RulePack,\\r\\n  coverRule: RuleHit,\\r\\n  fabricationCoverAdditionRule: RuleHit,\\r\\n  fabricationCoverMm: number,\\r\\n  rows: CutoffRow[],\\r\\n): Rebar[] {\\r\\n  const { section } = input\\r\\n  const firstRow = rows[0]\\r\\n  if (firstRow === undefined) return []\\r\\n  const lapRule = lookupRule(pack, 'lap.L1', {\\r\\n    fc: section.fc,\\r\\n    grade: section.grade,\\r\\n    hook: false,\\r\\n  })\\r\\n  const lapLengthMm = millimetres(lapRule, barDiameter(section.main.size))\\r\\n  // ?잆겖?뗩뜷??Þ鼇덆빓?뺛겏?뤹뵽?룔걬??륫?밤걽 ??令띸츞?뷸틬 ?띷뻼?뚣뚩쫸?쇈곩숱?뜰곩?力뺟춬\\r\\n  // ?붵겏?ャ띲겏若싥굙?뗣겗?㎯곩?力?鼇?쮫?룔걬)?뚧룂?ｃ걼?졼걨?㎯겘擁녈굤?싧숱?뜰굚?껁걝恙낁쫨??\\n  // ?귙굥?귟Þ鼇덆빓?뺛걣?뚣걯?㎪룒?삯빓?뺛걣?뺛걝鵝띸쉰??츪?쎼겓壅룔걪?뗰펷若싩? 竊??ャ긿?덀궕??\\n  // 鵝띸쉰 竊?訝?뼋?긱걵????겏?랃펹???잆겖?뗣겏 Rebar ??뒛?뚨퇉???с걮?뗦똻?╉겒?꾠겗?㎯?\\n  // 訝?뼋??궧?믦껀?뤻뎱嶺뗣걣鸚뽩겢??궧??윮?꾣룒?삯빓?뺛겎?뤵걢?뚣겍?쀣겲??(ADR-019)??\\n  const groups = new Map<string, CutoffPosition[]>()\\r\\n\\r\\n  for (const row of rows) {\\r\\n    for (const position of cutoffPositions(input, pack, row)) {\\r\\n      const key =\\r\\n        `${position.memberId}|${position.designMm}|${position.drawnMm}|` +\\r\\n        `${position.count}|${position.slotStart}`\\r\\n      const group = groups.get(key)\\r\\n      if (group) group.push(position)\\r\\n      else groups.set(key, [position])\\r\\n    }\\r\\n  }\\r\\n\\r\\n  return [...groups.values()].map((positions, index): Rebar => {\\r\\n    const [first] = positions\\r\\n    const count = first.count * positions.length\\r\\n    const splice = intervalSplice(\\r\\n      '?ャ긿?덀궕?뺟춮',\\r\\n      section,\\r\\n      first.designMm,\\r\\n      lapRule,\\r\\n      lapLengthMm,\\r\\n      pack,\\r\\n    )\\r\\n    const length = first.designMm + splice.lengthMm\\r\\n    const spliceLengthTerm =\\r\\n      splice.countPerBar === 0\\r\\n        ? `0?뗦? 竊?0`\\r\\n        : splice.lengthMm > 0\\r\\n          ? `${splice.countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 L1 ${lapRule.value}d(${lapLengthMm}) 竊?${splice.lengthMm}`\\r\\n          : `${splice.countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\\r\\n    const basis = [...new Set(positions.map(({ basis }) => basis))].join(' 竊?')\\r\\n\\r\\n    return {\\r\\n      id: `${first.memberId}|cutoff-${firstRow.role}-${index}`,\\r\\n      memberId: first.memberId,\\r\\n      role: firstRow.role,\\r\\n      size: section.main.size,\\r\\n      shape: 'straight',\\r\\n      points: [\\r\\n        [0, firstRow.y, fabricationCoverMm],\\r\\n        [first.drawnMm, firstRow.y, fabricationCoverMm],\\r\\n      ],\\r\\n      closed: false,\\r\\n      length,\\r\\n      count,\\r\\n      axisOffsetsMm: positions.map(({ fromMm }) => fromMm),\\r\\n      axisSlotStart: first.slotStart,\\r\\n      splice: {\\r\\n        method: section.spliceMethod,\\r\\n        countPerBar: splice.countPerBar,\\r\\n        lengthMm: splice.lengthMm,\\r\\n        rules: splice.rules,\\r\\n        formula:\\r\\n          `泳숁뎸嶸뉑???竊?${firstRow.role}1?с걗?잆굤 ${splice.countPerBar}?뗦?` +\\r\\n          `竊?{splice.basis}竊?竊?` +\\r\\n          `?밧폀 竊?${section.spliceMethod} 竊?` +\\r\\n          `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm} 竊?` +\\r\\n          `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\\r\\n      },\\r\\n      ruleHits: uniqueRuleHits([\\r\\n        coverRule,\\r\\n        fabricationCoverAdditionRule,\\r\\n        ...positions.flatMap(({ rules }) => rules),\\r\\n        ...splice.rules,\\r\\n      ]),\\r\\n      formula:\\r\\n        `鼇?쮫?룔걬 竊?${basis} 竊?泳숁뎸 ${spliceLengthTerm} 竊?${length} 竊?` +\\r\\n        `?ф빊 竊?1?뗦??귙걼??${first.count}竊덃뼪?㏘?誤㎯겗塋?깿?삡릎鸚?겗藥???` +\\r\\n        `?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1)?뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑` +\\r\\n        `?ャ굠?뗣랃펹 횞 ${positions.length}?뗦? 竊?${count} 竊?` +\\r\\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬 ${fabricationCoverMm} 竊?` +\\r\\n        `3D 壤®듁 竊??깁씊?뗣굢?끻겢?졼걨?믤룒?륅펷若싩???릲?띲걣塋?겎?띹빪?쇻굥??겎?뤵걢?싥? +\\r\\n        `鼇?쮫?룔걬?ャ걽?묊츞?γ걲?뗣꺕?뤵걢?뚣굥?룔걬 ${first.drawnMm} ??빊?뤵겓??뵪?꾠겒?꾬펹`,\\r\\n    }\\r\\n  })\\r\\n}\\r\\n\\r\\nfunction generateStirrup(\\r\\n  member: Member,\\r\\n  span: GirderSpan,\\r\\n  section: GirderSection,\\r\\n  coverRule: RuleHit,\\r\\n  fabricationCoverAdditionRule: RuleHit,\\r\\n  fabricationCoverMm: number,\\r\\n  hoopLengthAdditionRule: RuleHit,\\r\\n  distributionAdditionRule: RuleHit,\\r\\n  hook135Rule: RuleHit,\\r\\n): Rebar {\\r\\n  // 誤뤸틬??媛믪씠 ?녿뒗 諛곗튂媛믪씠??????씊訝誤㏃쓽 ?낅젰??洹몃?濡??대떎 (ADR-012)\\r\\n  const startOffsetMm = section.stirrup.startOffsetMm\\r\\n  const stirrupWidthMm = section.b - 2 * fabricationCoverMm\\r\\n  const stirrupDepthMm = section.depth - 2 * fabricationCoverMm\\r\\n\\r\\n  if (stirrupWidthMm <= 0 || stirrupDepthMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?귙겙?됬춮 ?졾램野멩퀡 must be positive: ${member.id} ` +\\r\\n        `(${section.b}횞${section.depth} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCoverMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  if (span.clear <= 2 * startOffsetMm) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?귙겙?됬춮 ?띸쉰?븅뼋 must be positive: ${member.id} ` +\\r\\n        `(?끾퀡 ${span.clear} ??2횞?앮쐿?ゃ깢?삠긿??${startOffsetMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const layout = stirrupPositions(\\r\\n    span.clear,\\r\\n    section.stirrup.pitch,\\r\\n    startOffsetMm,\\r\\n  )\\r\\n  // ?곈뇧??찉嶸쀥읃繹?1?싧뎴2) ????씊??Þ鼇덂?力뺛겓?덀굥?③빓?곥깢?껁궚??쮫訝듽걮?ゃ걚??\\n  // ?뗣겤?듽굮?㏝솮?쀣걼 stirrupWidthMm쨌stirrupDepthMm ??3D 壤®듁 (points) 弱귞뵪??\\n  const stirrupLengthMm = hoopDesignLengthMm(\\r\\n    section.b,\\r\\n    section.depth,\\r\\n    hoopLengthAdditionRule,\\r\\n  )\\r\\n  // ??竊덌폆竊됪쥈3)竊??싧뎴7) ???꾣쥈?붵겏?ャ곥걹??깿?녴겗?룔걬첨?볣슂?귙뚦ㄷ歟곥띲겘翁?퐪??\\n  // ?뷴늽?㎪윶?ユ렏?쇻굥?끾퀡?ⓨ늽?ゃ겗?㎯곩돯?뗣겗??냵力뺡빓?뺛귛닜?잆궕?뺛궩?껁깉??뼟訝롢걮?ゃ걚??\\n  const stirrupCount = distributionCount(\\r\\n    span.clear,\\r\\n    section.stirrup.pitch,\\r\\n    distributionAdditionRule,\\r\\n  )\\r\\n  const points: Vec3[] = [\\r\\n    [0, fabricationCoverMm, fabricationCoverMm],\\r\\n    [0, section.depth - fabricationCoverMm, fabricationCoverMm],\\r\\n    [\\r\\n      0,\\r\\n      section.depth - fabricationCoverMm,\\r\\n      section.b - fabricationCoverMm,\\r\\n    ],\\r\\n    [0, fabricationCoverMm, section.b - fabricationCoverMm],\\r\\n  ]\\r\\n  const hookTailLength = hookTailLengthMm(\\r\\n    hook135Rule,\\r\\n    section.stirrup.size,\\r\\n  )\\r\\n  const hookTails = twoInwardTails(\\r\\n    points[0],\\r\\n    hookTailLength,\\r\\n    symmetricInwardDirections(Math.PI / 4),\\r\\n  )\\r\\n  return {\\r\\n    id: `${member.id}|stirrup`,\\r\\n    memberId: member.id,\\r\\n    role: '?귙겙?됬춮',\\r\\n    size: section.stirrup.size,\\r\\n    shape: 'hoop',\\r\\n    points,\\r\\n    closed: true,\\r\\n    hookTails,\\r\\n    length: stirrupLengthMm,\\r\\n    count: stirrupCount,\\r\\n    placement: {\\r\\n      axis: 'x',\\r\\n      clearMm: span.clear,\\r\\n      pitchMm: section.stirrup.pitch,\\r\\n      startOffsetMm,\\r\\n      lastGapMm: layout.lastGapMm,\\r\\n      positionCount: layout.positionsMm.length,\\r\\n    },\\r\\n    // 鼇?쮫?룔걬?삭Þ鼇덃쑍?겹굮黎뷩굙?잆겗??걪???↓쟿?졼걨?졼귙걢?뜰굤??3D 壤®듁\\r\\n    // (points) ?ャ걮?뗥듅?뗣겒?꾠겗?㎯곮펹?쎼굥?①츞?뷴폀?ョ뤎?뚣겒?꾥죱?믤졊?졼겏?쀣겍\\r\\n    // 鹽뷩걲?볝겏?ャ겒?????앫겗歟곥겗?뗣겤?듿눣?멥겘訝딁ク嶺뗣꺕訝뗧ク嶺뗣겗烏뚣걣?곥겇??\\n    ruleHits: [hoopLengthAdditionRule, distributionAdditionRule],\\r\\n    // ?낁㉢烏뚣겘?뚣걯寧?뤇??쥈?믤씇??굥?귛냵力뺡빓?뺛걣?뺛겂?╉굚?꿜퍡?ф빊?뚦릪?섅겒??\\n    // 訝烏뚣겓?ゃ굥??겎?곩냵力뺡빓?뺛겘餓ｈ〃?ㅳ걽?ⓩ뼪?뗣귡깿?먦걫?ⓦ겓?뺛걝 3D ?띸쉰??쟿??\\n    // ?잆겖?됥굦?잋퍟??쥈?ャ겇?꾠겍雅뗥츪?㎯겒?뤵겒?뗣걼?곥곥걪?볝겓??펹?쎼겒?꾠?\\n    formula:\\r\\n      `鼇?쮫?룔걬 竊???씊??Þ鼇덂?力뺛겓?덀굥?③빓 2횞(${section.b}竊?{section.depth}) ` +\\r\\n      `竊?${stirrupLengthMm}` +\\r\\n      `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴2) ???뗣겤?듽굮?㏝솮?쎼걳?뺛긿??굚鼇덁툓?쀣겒?꾬펹 竊?` +\\r\\n      `鼇?쮫?ф빊 竊??덂냵力뺡빓??${span.clear} 첨 ?붵긿??` +\\r\\n      `${section.stirrup.pitch}??竊?1 竊?${stirrupCount}` +\\r\\n      `竊덂릪 竊덌폆竊됪쥈3)???싧뎴7) ???꾣쥈?붵겏?곩냵力뺡빓?뺛겘餓ｈ〃?ㅿ펹 竊?` +\\r\\n      `3D 壤®듁 竊?若잓뀓嶺뗰펷?뗣겤?듽굮?㏝솮?쀥닜?잆궕?뺛궩?껁깉?믦쫳渦쇈??잆굙?? +\\r\\n      `烏①ㅊ?뺛굦?뗩빓?뺛꺕?ф빊??Þ鼇덂ㅳ겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹 竊?` +\\r\\n      `135째?뺛긿??퐰??竊?${hook135Rule.expr} 횞 ${section.stirrup.size} 竊?` +\\r\\n      `${hookTailLength}mm竊?{hook135Rule.note}竊됥? +\\r\\n      `points[0] ?뗣굢??씊?끻릲?띲겗?밧릲?믢릎恙껁겓?? +\\r\\n      `?뚣걯鰲믣벧?㎩랩?녑?燁겹겗雅뚧뼶?묆겦?녴걨??룒??,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 亮끾??곭춮 (?곈뇧令띸츞?뷸틬 1?싧뎴3)??竊덌폆竊됪쥈3))??\\n *\\r\\n * 鼇?쮫?룔걬??뼪?㏂겗鼇?쮫亮끹걹??굚??곮Þ鼇덃쑍?겹겘?꾣쥈?붵겏??돯餓섅겎?귙굥?귡슔??\\n * 1?싧뎴2)竊덀깢?쇈깤?삠궧?욍꺀?껁깤竊앭뫅?뤄펹?ⓨ룚?딃걬?덀겒?꾠굠?녴곲빓?뺛겘弱귞뵪??\\n * `widthTieDesignLengthMm` ?믧싥걲??\\n */\\r\\nfunction generateWidthTie(\\r\\n  member: Member,\\r\\n  span: GirderSpan,\\r\\n  section: GirderSection,\\r\\n  widthTie: NonNullable<GirderSection['widthTie']>,\\r\\n  fabricationCoverMm: number,\\r\\n  widthTieLengthAdditionRule: RuleHit,\\r\\n  distributionAdditionRule: RuleHit,\\r\\n): Rebar {\\r\\n  // 亮끾??곭춮??걗?겹굢嶺뗣겓永먩씇?쇻굥??겎?곭К1?с겗鵝띸쉰??걗?겹굢嶺뗣겏?뚣걯?㏂걢?됪릍?뗣?\\n  // ?볝굦??3D ??퐳?녘쫸?뉎겓?쇻걥?ゃ걚 ??鼇?쮫?ф빊??1?싧뎴7) ?㎪빊?덀굥??겎?앮쐿\\r\\n  // ?ゃ깢?삠긿?덀겓藥?뤂?뺛굦?ゃ걚 (ADR-019)??\\n  const startOffsetMm = section.stirrup.startOffsetMm\\r\\n  const tieWidthMm = section.b - 2 * fabricationCoverMm\\r\\n\\r\\n  if (tieWidthMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `亮끾??곭춮 ?졾램野멩퀡 must be positive: ${member.id} ` +\\r\\n        `(亮?${section.b} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCoverMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  // 0 竊??ゅ뀯?쎼귟쫸繹뽧겓亮끾??곭춮??깞?껁긽??겒?꾠겗?㏝걪?룔걣餓ｃ굩?듽겓黎뷩굙?뗣걪?ⓦ겘\\r\\n  // ?㎯걤?ゃ걚 ??容쇻겂?╊퐬?뗣굮?뗣굙?싥곭쎍?쀣겑?볝굧?믣릫?뉎걮?쀣겍?썬겏??(ADR-012)??\\n  if (widthTie.pitch <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `亮끾??곭춮 ?붵긿??must be positive: ${member.id} ` +\\r\\n        `(${widthTie.pitch} ????씊訝誤㎯겎?ゅ뀯??`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const layout = stirrupPositions(span.clear, widthTie.pitch, startOffsetMm)\\r\\n  const lengthMm = widthTieDesignLengthMm(\\r\\n    section.b,\\r\\n    widthTieLengthAdditionRule,\\r\\n  )\\r\\n  const count = distributionCount(\\r\\n    span.clear,\\r\\n    widthTie.pitch,\\r\\n    distributionAdditionRule,\\r\\n  )\\r\\n  const midDepthMm = section.depth / 2\\r\\n\\r\\n  return {\\r\\n    id: `${member.id}|width-tie`,\\r\\n    memberId: member.id,\\r\\n    role: '亮끾??곭춮',\\r\\n    size: widthTie.size,\\r\\n    shape: 'straight',\\r\\n    points: [\\r\\n      [0, midDepthMm, fabricationCoverMm],\\r\\n      [0, midDepthMm, section.b - fabricationCoverMm],\\r\\n    ],\\r\\n    closed: false,\\r\\n    length: lengthMm,\\r\\n    count,\\r\\n    placement: {\\r\\n      axis: 'x',\\r\\n      clearMm: span.clear,\\r\\n      pitchMm: widthTie.pitch,\\r\\n      startOffsetMm,\\r\\n      lastGapMm: layout.lastGapMm,\\r\\n      positionCount: layout.positionsMm.length,\\r\\n    },\\r\\n    ruleHits: [widthTieLengthAdditionRule, distributionAdditionRule],\\r\\n    formula:\\r\\n      `鼇?쮫?룔걬 竊??녈꺍??꺁?쇈깉??Þ鼇덂퉭 ${section.b} 竊?${lengthMm}` +\\r\\n      `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴3) ???뺛긿??굮鼇덁툓?쀣겒?꾬펹 竊?` +\\r\\n      `鼇?쮫?ф빊 竊??덂냵力뺡빓??${span.clear} 첨 ?붵긿??${widthTie.pitch}??竊?1 ` +\\r\\n      `竊?${count}竊덂릪 竊덌폆竊됪쥈3)???싧뎴7) ???꾣쥈?붵겏?곩냵力뺡빓?뺛겘餓ｈ〃?ㅿ펹 竊?` +\\r\\n      `3D 壤®듁 竊?若잓뀓嶺뗰펷?뗣겤?듽굮?㏝솮?쀣걗?겹굢嶺뗣겏?뚣걯?앮쐿?ゃ깢?삠긿?덀겓?덀굩?쎼굥` +\\r\\n      `?잆굙?곮〃鹽뷩걬?뚣굥?룔걬?삥쑍?겹겘鼇?쮫?ㅳ겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹`,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?밭춮 (?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈3))??\\n *\\r\\n * ?볝겗?↓쟿?뚦츣?곥굥??겘?뚥퐰?룔겘 1?싧뎴6) ?ャ굠?뗣띲겗訝?밤걽?묆겎?곩릪?끹겘鼇?쮫?녔쎑??\\n * 鼇섋펹?뚣겒?묆굦??JASS 5 繹뽫뵪?ⓦ걲?뗣괟ASS 5 ??쐣?숃쫸?쇈겎?ょ▶岳앫곫쮽繹뽨퍞礪섉쎑5塋졼겓\\r\\n * ?밭춮??쮼瓦겹겘訝?뉎겒?꾬펷R7 ??30?곥겎0餓띰펹??겎誤뤸틬?ㅳ걣?뽧굦?ゃ걚 ??鵝숅빓?귝쑍?겹굚\\r\\n * ??씊訝誤㎯겗?ε뒟?믡걹??겲?얌슴?꾠곥꺂?쇈꺂?묆긿??굮凉뺛걢?ゃ걚 (ADR-012?갧9????\\n * ?졼걢??`ruleHits` ??㈉?㎯걗?뗣귛눣?멥겗?ゃ걚?겼ㅳ겓?뷴끂?믦꼈?됥겒?꾠?\\n */\\r\\nfunction generateSideBar(\\r\\n  member: Member,\\r\\n  span: GirderSpan,\\r\\n  section: GirderSection,\\r\\n  sideBar: NonNullable<GirderSection['sideBar']>,\\r\\n  fabricationCoverMm: number,\\r\\n): Rebar {\\r\\n  if (sideBar.extraLengthMm < 0 || !Number.isFinite(sideBar.extraLengthMm)) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?밭춮 鵝숅빓 must be non-negative and finite: ${member.id} ` +\\r\\n        `(${sideBar.extraLengthMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const lengthMm = span.clear + 2 * sideBar.extraLengthMm\\r\\n  const midDepthMm = section.depth / 2\\r\\n\\r\\n  return {\\r\\n    id: `${member.id}|side-bar`,\\r\\n    memberId: member.id,\\r\\n    role: '?밭춮',\\r\\n    size: sideBar.size,\\r\\n    shape: 'straight',\\r\\n    points: [\\r\\n      [-sideBar.extraLengthMm, midDepthMm, fabricationCoverMm],\\r\\n      [span.clear + sideBar.extraLengthMm, midDepthMm, fabricationCoverMm],\\r\\n    ],\\r\\n    closed: false,\\r\\n    length: lengthMm,\\r\\n    count: sideBar.count,\\r\\n    ruleHits: [],\\r\\n    formula:\\r\\n      `鼇?쮫?룔걬 竊??끾퀡?룔걬 ${span.clear} 竊?鵝숅빓 ${sideBar.extraLengthMm} 횞 2 ` +\\r\\n      `竊?${lengthMm}竊덃빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈3) ??퐰?룔굮 1?싧뎴6) ?ュ쭟??곩릪?끹겘` +\\r\\n      `鼇?쮫?녔쎑?ヨ쮼雍됥걣?ゃ걨?뚣겙 JASS 5 繹뽫뵪?ⓨ츣?곥굥?괟ASS 5 ??쑋閻뷰퓷?? +\\r\\n      `與숁틬餓뺞쭣??塋졼겓?밭춮??쮼瓦겹겒????鵝숅빓??뼪?㏘?誤㎯겗?ε뒟?㎯걗?뗰폀R9?∽펹 竊?` +\\r\\n      `鼇?쮫?ф빊 竊???씊訝誤㎯겗?밭춮?ф빊 ${sideBar.count}` +\\r\\n      `竊덂쎋?㏂겓鼇섋펹?뺛굦?잍쑍?겹겒??겎 1?싧뎴7) ??돯餓섅겎??겒?꾬펹 竊?` +\\r\\n      `3D 壤®듁 竊?訝▼겢?㏂겓??굤?녴걨??룒?륅펷??굤?녴걨??퐳?녘쫸?뉛펹`,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function generateGirderRebar(\\r\\n  input: GirderRebarInput,\\r\\n  pack: RulePack,\\r\\n): Rebar[] {\\r\\n  const { run, section } = input\\r\\n  if (run.members.length !== run.spans.length || run.members.length === 0) {\\r\\n    throw new Error('GirderRun members and spans must have the same non-zero length')\\r\\n  }\\r\\n\\r\\n  const coverRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.minimum',\\r\\n    coverConditions(section),\\r\\n  )\\r\\n  const fabricationCoverAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.fabrication.addition',\\r\\n    {},\\r\\n  )\\r\\n  const minimumCoverMm = millimetres(coverRule)\\r\\n  const fabricationCoverAdditionMm = millimetres(\\r\\n    fabricationCoverAdditionRule,\\r\\n  )\\r\\n  const fabricationCoverMm =\\r\\n    minimumCoverMm + fabricationCoverAdditionMm\\r\\n\\r\\n  // 鵝띸쉰?ζ쑍?겹굮?싥걮嶺뗣꺕stub?삡릎鸚?춮?사뎴?당춮?멨늽?묆굥?귝빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈1) ??\\n  // ?룔걬?믣츣?곥굥??겘?뚧쥈??뀲?룔겓?뤵걼?뗤말嶺뗣띲걽?묆겎?곩량??늽??Þ鼇덂쎋?멥겓?덀굥??\\n  const rows = [\\r\\n    {\\r\\n      id: 'top' as const,\\r\\n      role: '訝딁ク嶺? as const,\\r\\n      cutoffRole: '訝딁ク?ャ긿?덀궕?뺟춮' as const,\\r\\n      source: section.main.top,\\r\\n      decomposition: decomposeGirderMainRow(section.main.top),\\r\\n      y: section.depth - fabricationCoverMm,\\r\\n      bendDirection: '訝? as const,\\r\\n    },\\r\\n    {\\r\\n      id: 'bottom' as const,\\r\\n      role: '訝뗧ク嶺? as const,\\r\\n      cutoffRole: '訝뗧ク?ャ긿?덀궕?뺟춮' as const,\\r\\n      source: section.main.bottom,\\r\\n      decomposition: decomposeGirderMainRow(section.main.bottom),\\r\\n      y: fabricationCoverMm,\\r\\n      bendDirection: '訝? as const,\\r\\n    },\\r\\n  ]\\r\\n\\r\\n  if (\\r\\n    run.spans.length > 1 &&\\r\\n    rows.some(\\r\\n      ({ source }) =>\\r\\n        (source.startCount ?? source.endCount) !== source.endCount,\\r\\n    )\\r\\n  ) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '?ャ긿?덀궕?뺜퐤營?툖?먪쳦',\\r\\n      `鸚뽫ク/?끿ク?뚣꺀?녈겗?⒲겗??궧?뗥츣?곥굢?뚣겒?? ${run.ownerId}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const through = rows.map((row) =>\\r\\n    generateMain(\\r\\n      input,\\r\\n      pack,\\r\\n      coverRule,\\r\\n      fabricationCoverAdditionRule,\\r\\n      fabricationCoverMm,\\r\\n      {\\r\\n        id: row.id,\\r\\n        role: row.role,\\r\\n        count: row.decomposition.throughCount,\\r\\n        y: row.y,\\r\\n        bendDirection: row.bendDirection,\\r\\n      },\\r\\n    ),\\r\\n  )\\r\\n  const cutoffs = rows.flatMap((row) =>\\r\\n    (() => {\\r\\n      const { decomposition } = row\\r\\n      const asymmetric =\\r\\n        (row.source.startCount ?? row.source.endCount) !== row.source.endCount\\r\\n      const cutoffRows: CutoffRow[] = []\\r\\n\\r\\n      if (asymmetric) {\\r\\n        if (decomposition.startStubCount > 0) {\\r\\n          cutoffRows.push({\\r\\n            role: row.cutoffRole,\\r\\n            count: decomposition.startStubCount,\\r\\n            at: '冶뗧ク?밤궭??,\\r\\n            slotStart: decomposition.throughCount,\\r\\n            y: row.y,\\r\\n            bendDirection: row.bendDirection,\\r\\n          })\\r\\n        }\\r\\n        if (decomposition.endStubCount > 0) {\\r\\n          cutoffRows.push({\\r\\n            role: row.cutoffRole,\\r\\n            count: decomposition.endStubCount,\\r\\n            at: '永귞ク?밤궭??,\\r\\n            slotStart: decomposition.throughCount,\\r\\n            y: row.y,\\r\\n            bendDirection: row.bendDirection,\\r\\n          })\\r\\n        }\\r\\n        if (decomposition.centerOnlyCount > 0) {\\r\\n          cutoffRows.push({\\r\\n            role: row.cutoffRole,\\r\\n            count: decomposition.centerOnlyCount,\\r\\n            at: '訝?ㄾ',\\r\\n            slotStart: decomposition.throughCount,\\r\\n            y: row.y,\\r\\n            bendDirection: row.bendDirection,\\r\\n          })\\r\\n        }\\r\\n        if (\\r\\n          decomposition.oneSidedCount > 0 &&\\r\\n          decomposition.oneSidedAnchor !== undefined\\r\\n        ) {\\r\\n          // ??궧?담궧?욍깣竊덀걹??겢??쑍??> 訝?ㄾ?ф빊竊됥겏訝?ㄾ嶺뗰펷訝?ㄾ?ф빊 >\\r\\n          // 訝▼겢??쑍?곤펹??릪?귙겓閭ｃ겓?ゃ굢?ゃ걚?귙걮?잆걣?ｃ겍?뉐겢嶺뗣겘?싥걮嶺뗣꺕\\r\\n          // 訝?ㄾ嶺뗣꺕?㏂꺍?ャ꺖?담궧?욍깣??풄?띲겓營?걨?겹곥겑??쑍?곈뼟岳귙겎?귝옞?뚪뇥?ゃ굢?ゃ걚??\\n          cutoffRows.push({\\r\\n            role: row.cutoffRole,\\r\\n            count: decomposition.oneSidedCount,\\r\\n            at: decomposition.oneSidedAnchor,\\r\\n            slotStart:\\r\\n              decomposition.throughCount +\\r\\n              decomposition.centerOnlyCount +\\r\\n              (decomposition.oneSidedAnchor === '冶뗧ク'\\r\\n                ? decomposition.startStubCount\\r\\n                : decomposition.endStubCount),\\r\\n            y: row.y,\\r\\n            bendDirection: row.bendDirection,\\r\\n          })\\r\\n        }\\r\\n      } else {\\r\\n        if (decomposition.startStubCount > 0) {\\r\\n          cutoffRows.push({\\r\\n            role: row.cutoffRole,\\r\\n            count: decomposition.startStubCount,\\r\\n            at: '塋?깿',\\r\\n            slotStart: decomposition.throughCount,\\r\\n            y: row.y,\\r\\n            bendDirection: row.bendDirection,\\r\\n          })\\r\\n        }\\r\\n        if (decomposition.centerOnlyCount > 0) {\\r\\n          cutoffRows.push({\\r\\n            role: row.cutoffRole,\\r\\n            count: decomposition.centerOnlyCount,\\r\\n            at: '訝?ㄾ',\\r\\n            slotStart: decomposition.throughCount,\\r\\n            y: row.y,\\r\\n            bendDirection: row.bendDirection,\\r\\n          })\\r\\n        }\\r\\n      }\\r\\n\\r\\n      return cutoffRows.length === 0\\r\\n        ? []\\r\\n        : generateCutoff(\\r\\n          input,\\r\\n          pack,\\r\\n          coverRule,\\r\\n          fabricationCoverAdditionRule,\\r\\n          fabricationCoverMm,\\r\\n          cutoffRows,\\r\\n        )\\r\\n    })(),\\r\\n  )\\r\\n  // bend.hook135 ?믣폊?뗣겒?꾠겗??찉嶸쀥읃繹?1?싧뎴2) ?뚣뚣깢?껁궚??겒?꾠굚??겏?쇻굥?띲겏\\r\\n  // 若싥굙?뗣걢?됥겎?곥걹??틟若잒눎鵝볝굮 measure.hoop.length.addition ?뚦눣?멧퍡?띲겎?곥겇??\\n  const hoopLengthAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'measure.hoop.length.addition',\\r\\n    {},\\r\\n  )\\r\\n  const distributionAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'measure.distribution.addition',\\r\\n    {},\\r\\n  )\\r\\n  const hook135Rule = lookupRule(pack, 'bend.hook135', {})\\r\\n  const stirrups = run.members.map((member, index) =>\\r\\n    generateStirrup(\\r\\n      member,\\r\\n      run.spans[index],\\r\\n      section,\\r\\n      coverRule,\\r\\n      fabricationCoverAdditionRule,\\r\\n      fabricationCoverMm,\\r\\n      hoopLengthAdditionRule,\\r\\n      distributionAdditionRule,\\r\\n      hook135Rule,\\r\\n    ),\\r\\n  )\\r\\n  // 亮끾??곭춮?삭끃嶺뗣겘??씊訝誤㎯겓?귙굥歟곥겓?졼걨餓섅걦?귞꽒?꾣쥈?ヨ＝?곥걣擁녈걬?ゃ걚 (ADR-012)??\\n  const { widthTie, sideBar } = section\\r\\n  const widthTies =\\r\\n    widthTie === undefined\\r\\n      ? []\\r\\n      : run.members.map((member, index) =>\\r\\n          generateWidthTie(\\r\\n            member,\\r\\n            run.spans[index],\\r\\n            section,\\r\\n            widthTie,\\r\\n            fabricationCoverMm,\\r\\n            lookupRule(pack, 'measure.width-tie.length.addition', {}),\\r\\n            distributionAdditionRule,\\r\\n          ),\\r\\n        )\\r\\n  const sideBars =\\r\\n    sideBar === undefined\\r\\n      ? []\\r\\n      : run.members.map((member, index) =>\\r\\n          generateSideBar(\\r\\n            member,\\r\\n            run.spans[index],\\r\\n            section,\\r\\n            sideBar,\\r\\n            fabricationCoverMm,\\r\\n          ),\\r\\n        )\\r\\n\\r\\n  return [...through, ...cutoffs, ...stirrups, ...widthTies, ...sideBars]\\r\\n}\\r\\n\\r\\nimport type { BarSize, SteelGrade } from '../model/member'\\r\\nimport { MemberUnsupportedError } from '../model/unsupported'\\r\\nimport { lookupRule } from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\n\\r\\n/** ?먯젙???ㅼ젣濡???猷?????吏???깆쓽 ?뗣겤?딆쿂??鸚㎪쥈 議곌굔?쇰줈???섏쭦?????녿떎 */\\r\\ninterface UsedRules {\\r\\n  usedRules: RuleHit[]\\r\\n}\\r\\n\\r\\nexport type GirderEndDetail =\\r\\n  | ({\\r\\n      kind: '?당퇉若싩?'\\r\\n      lengthRule: 'anchorage.L1'\\r\\n      lengthMm: number\\r\\n    } & UsedRules)\\r\\n  | ({\\r\\n      kind: '?섉쎊?믣츣?'\\r\\n      /**\\r\\n       * ?졾램?룹쓣 ?ㅼ젣濡??뺥븳 ?? `max(L1, ?뺝쉽竊뗤퐰?룝툔??`?대?濡?鵝숅빓訝뗩솏??\\n       * 吏諛고븯硫?洹?湲몄씠??烏?.3.4???녿뒗 媛믪씠????L1濡??쒖떆?섎㈃ 洹쇨굅媛 嫄곗쭞???쒕떎.\\r\\n       */\\r\\n      lengthRule: 'anchorage.L1' | 'anchorage.bent.tail.minimum'\\r\\n      /** ?뺝쉽?룸룄 `max(La, ?긱걵?꽸?/4)` ??洹쇨굅???닿릿 ??뿉 遺숇뒗??*/\\r\\n      projectionRule: 'anchorage.La' | 'anchorage.bent.projection.minimum'\\r\\n      /** max(L1, ?뺝쉽竊뗤퐰?룝툔?? ??嶸쀥눣凉륁씠 ?대뒓 ??씠 吏諛고뻽?붿? 諛앺옄 ???덇쾶 ?먰빆???ｋ뒗??*/\\r\\n      lengthMm: number\\r\\n      /** 5.3.4(5)(節?(a)?뚦뀲?룔겘?곮〃5.3.4 ??쎍渶싧츣???빓?뺜빳訝듽겏?쇻굥?띿쓽 洹?L1 */\\r\\n      straightMinimumMm: number\\r\\n      tailMinimumMm: number\\r\\n      /** max(La, ?긱걵?꽸쀦뒘壤긴툔?? */\\r\\n      projectionMm: number\\r\\n      laMm: number\\r\\n      projectionMinimumMm: number\\r\\n      direction: '訝? | '訝?\\r\\n    } & UsedRules)\\r\\n\\r\\nexport interface GirderEndInput {\\r\\n  /** 吏???깆쓽 異뺣갑???꾩껜 移섏닔 (GirderSpan??*SupportLengthAlongAxisMm) */\\r\\n  supportLengthMm: number\\r\\n  /** 吏???깆쓽 ?뗣겤??議고쉶 議곌굔 (GirderSpan??*SupportCover) ??鸚㎪쥈??寃껋씠 ?꾨땲??*/\\r\\n  supportCover: Record<string, string | boolean>\\r\\n  barSize: BarSize\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  /** 訝딁ク嶺뗭씠硫?'訝?(?꾨옒濡??덇끝), 訝뗧ク嶺뗭씠硫?'訝? */\\r\\n  bendDirection: '訝? | '訝?\\r\\n}\\r\\n\\r\\nexport function barDiameter(size: BarSize): number {\\r\\n  const diameter = Number(size.replace(/^D/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid BarSize: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\r\\n  if (rule.unit === 'mm') return rule.value\\r\\n  if (rule.unit === 'd' && diameter !== undefined) {\\r\\n    return rule.value * diameter\\r\\n  }\\r\\n\\r\\n  throw new Error(\\r\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction ratio(rule: RuleHit): number {\\r\\n  if (rule.unit !== 'ratio') {\\r\\n    throw new Error(`Rule ${rule.key} must use ratio`)\\r\\n  }\\r\\n\\r\\n  return rule.value\\r\\n}\\r\\n\\r\\nexport function resolveGirderEnd(\\r\\n  input: GirderEndInput,\\r\\n  pack: RulePack,\\r\\n): GirderEndDetail {\\r\\n  const diameter = barDiameter(input.barSize)\\r\\n  const straightRule = lookupRule(pack, 'anchorage.L1', {\\r\\n    fc: input.fc,\\r\\n    grade: input.grade,\\r\\n    hook: false,\\r\\n  })\\r\\n  const minimumCoverRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.minimum',\\r\\n    input.supportCover,\\r\\n  )\\r\\n  const fabricationCoverAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.fabrication.addition',\\r\\n    {},\\r\\n  )\\r\\n  const fabricationCoverMm =\\r\\n    millimetres(minimumCoverRule) +\\r\\n    millimetres(fabricationCoverAdditionRule)\\r\\n  const availableProjectionMm = input.supportLengthMm - fabricationCoverMm\\r\\n  const straightLengthMm = millimetres(straightRule, diameter)\\r\\n\\r\\n  const coverRules = [minimumCoverRule, fabricationCoverAdditionRule]\\r\\n\\r\\n  if (straightLengthMm <= availableProjectionMm) {\\r\\n    return {\\r\\n      kind: '?당퇉若싩?',\\r\\n      lengthRule: 'anchorage.L1',\\r\\n      lengthMm: straightLengthMm,\\r\\n      usedRules: [straightRule, ...coverRules],\\r\\n    }\\r\\n  }\\r\\n\\r\\n  // anchorage.L1h ???ш린??議고쉶?섏? ?딅뒗????5.3.4(5)(節? ?먯꽌 L1h ????議고빆??\\n  // ?곸슜?섎뒗 **議곌굔**(?뚣깢?껁궚?귙굤??츣???빓?뺛굮閻뷰퓷?㎯걤?ゃ걚?닷릦????肉먯씠怨?\\r\\n  // (a)(b)(c) 以??대뒓 媛믩룄 ?뺥븯吏 ?딅뒗?? 議고쉶?대몢硫??뷴끂 移⑹뿉 ?곗텧?앹뿉 ??踰덈룄\\r\\n  // ?섏삤吏 ?딅뒗 ?됱씠 ?ㅻ┛??\\r\\n  const projectionRule = lookupRule(pack, 'anchorage.La', {\\r\\n    fc: input.fc,\\r\\n    grade: input.grade,\\r\\n  })\\r\\n  const tailMinimumRule = lookupRule(\\r\\n    pack,\\r\\n    'anchorage.bent.tail.minimum',\\r\\n    {},\\r\\n  )\\r\\n  const projectionMinimumRule = lookupRule(\\r\\n    pack,\\r\\n    'anchorage.bent.projection.minimum',\\r\\n    { detail: '歟곦말嶺뗣겗?긷냵若싩?' },\\r\\n  )\\r\\n  const laMm = millimetres(projectionRule, diameter)\\r\\n  const projectionMinimumMm =\\r\\n    input.supportLengthMm * ratio(projectionMinimumRule)\\r\\n  const projectionMm = Math.max(laMm, projectionMinimumMm)\\r\\n\\r\\n  if (projectionMm > availableProjectionMm) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '若싩?訝띷닇塋?,\\r\\n      `?섉쎊?믣츣??뚧뵱?방윶?ュ룑?얇굢?ゃ걚: ` +\\r\\n        `恙낁쫨?뺝쉽 ${projectionMm} mm > 鵝욜뵪??꺗 ${availableProjectionMm} mm`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  // 5.3.4(5)(節? ??(a) ?③빓 ??烏?.3.4 ??*?당퇉**若싩???빓?뺛?b) 鵝숅빓 ??8d ??\\n  // ?ⓦ굚?ヨげ?쇻귙깢?껁궚?귙굤??L1h ??릪?▲겗**?⑴뵪?▽뻑**竊덀뚣깢?껁궚?귙굤??츣???빓?뺛굮\\r\\n  // 閻뷰퓷?㎯걤?ゃ걚?닷릦?랃펹?㎯걗?ｃ겍?③빓??툔?먦겎??겒????訝뗩솏??L1h ?믥쉰?뤵겏 L1 > L1h\\r\\n  // ??늽?졼걨?③빓?뚧씉?뉎굠?딁윮?뤵겒?듽곩냵鼇녈걣?롥컦鼇덁툓?ャ겒?뗣?\\n  const tailMinimumMm = projectionMm + millimetres(tailMinimumRule, diameter)\\r\\n  const lengthMm = Math.max(straightLengthMm, tailMinimumMm)\\r\\n\\r\\n  return {\\r\\n    kind: '?섉쎊?믣츣?',\\r\\n    lengthRule:\\r\\n      straightLengthMm >= tailMinimumMm\\r\\n        ? 'anchorage.L1'\\r\\n        : 'anchorage.bent.tail.minimum',\\r\\n    projectionRule:\\r\\n      laMm >= projectionMinimumMm\\r\\n        ? 'anchorage.La'\\r\\n        : 'anchorage.bent.projection.minimum',\\r\\n    lengthMm,\\r\\n    straightMinimumMm: straightLengthMm,\\r\\n    tailMinimumMm,\\r\\n    projectionMm,\\r\\n    laMm,\\r\\n    projectionMinimumMm,\\r\\n    direction: input.bendDirection,\\r\\n    // L1 ? ?섉쎊??梨꾪깮 ?먯젙??鍮꾧탳?먯씠??(a)???③빓 訝뗩솏?대떎.\\r\\n    // L1h(anchorage.L1h)???대뼡 媛믩룄 ?뺥븯吏 ?딆쑝誘濡??뷴끂???ｌ? ?딅뒗??\\r\\n    usedRules: [\\r\\n      straightRule,\\r\\n      projectionRule,\\r\\n      tailMinimumRule,\\r\\n      projectionMinimumRule,\\r\\n      ...coverRules,\\r\\n    ],\\r\\n  }\\r\\n}\\r\\n\\r\\n\\r\\n\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command \\\"git diff -- phases/47-joint-review-core/index.json\\n Get-Content phases/47-joint-review-core/index.json -Raw\\n Get-Content phases/47-joint-review-core/step5-codex.stderr.log -Tail 80\\n Get-Content phases/47-joint-review-core/step5-codex.stdout.log -Tail 80\\n rg --files src/lib/review tests | Sort-Object\\n rg -n \\\\\\\"jointRebarMemberIds|buildingLayout|rebarPlacements|roleToLayer|hashString|fingerprint|type RebarRole|interface Rebar|type BarSize|CheckExclusion|ReviewFingerprints|interface Joint\\\\\\\" src tests phases/47-joint-review-core -g '*.ts' -g '*.tsx' -g '*.md' -g '*.json'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\r\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command \\\"git diff -- phases/47-joint-review-core/index.json\\n Get-Content phases/47-joint-review-core/index.json -Raw\\n Get-Content phases/47-joint-review-core/step5-codex.stderr.log -Tail 80\\n Get-Content phases/47-joint-review-core/step5-codex.stdout.log -Tail 80\\n rg --files src/lib/review tests | Sort-Object\\n rg -n \\\\\\\"jointRebarMemberIds|buildingLayout|rebarPlacements|roleToLayer|hashString|fingerprint|type RebarRole|interface Rebar|type BarSize|CheckExclusion|ReviewFingerprints|interface Joint\\\\\\\" src tests phases/47-joint-review-core -g '*.ts' -g '*.tsx' -g '*.md' -g '*.json'\\\"\",\"