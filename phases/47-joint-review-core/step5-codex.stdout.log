\\\r\\\\n    pack,\\\\r\\\\n  )\\\\r\\\\n  const length = drawnLength + splice.lengthMm\\\\r\\\\n  const zones: RebarZone[] = [\\\\r\\\\n    {\\\\r\\\\n      kind: '畑댁떓?',\\\\r\\\\n      ruleKey: start.lengthRule,\\\\r\\\\n      pathFromMm: 0,\\\\r\\\\n      pathToMm: start.lengthMm,\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      kind: '畑댁떓?',\\\\r\\\\n      ruleKey: end.lengthRule,\\\\r\\\\n      pathFromMm: drawnLength - end.lengthMm,\\\\r\\\\n      pathToMm: drawnLength,\\\\r\\\\n    },\\\\r\\\\n  ]\\\\r\\\\n  // 0?????앸퉻?類쏄괏營뚯ｊ콫??껉콢??寃섇떳???寃밴쿁??쇨콢???怨ル섬畑밸ㅅ寃??쇨콢???쿂??껉콢??\\\\n  // 鼇씲??녠쿁??띠씌??ｊ께???탽??ｊ쾹 0????????伊??뉕쾸??ｊ국??堉띰Ⅹ琉듦쿂?猷붽괵???Ŋ?琉듦덩??껉콢??꿸쾹\\\\r\\\\n  // 亦꺫꾩굟??Ｂ怨⑸┴??뗭１???닧?硫κ쾽??산괬??measure.splice.length.factor ???쭣?袁?괵??는?\\\\n  const spliceLengthTerm =\\\\r\\\\n    splice.countPerBar === 0\\\\r\\\\n      ? `0??? 塋?0`\\\\r\\\\n      : splice.lengthMm > 0\\\\r\\\\n        ? `${splice.countPerBar}??? ????꿸쿀力녹늸??猷붽괵 L1 ${lapRule.value}d(${lapLengthMm}) 塋?${splice.lengthMm}`\\\\r\\\\n        : `${splice.countPerBar}??? ??${section.spliceMethod}??鍮?類쏄쿁勇싲맕???껉괼 0`\\\\r\\\\n  const fabricationCoverFormula =\\\\r\\\\n    `?議얜옩???괍??곌덮??κ괵塋딅뛽?凉깅ㅅ嫄??곌덮 ${coverRule.value} 塋?` +\\\\r\\\\n    `?醫귥툧 ${fabricationCoverAdditionRule.value} 塋?${fabricationCoverMm}塋?\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    id: `${run.ownerId}|${row.id}`,\\\\r\\\\n    memberId: run.ownerId,\\\\r\\\\n    role: row.role,\\\\r\\\\n    size: section.main.size,\\\\r\\\\n    shape:\\\\r\\\\n      start.kind === '??됱럧?誘ｌ르??' || end.kind === '??됱럧?誘ｌ르??'\\\\r\\\\n        ? 'hook90'\\\\r\\\\n        : 'straight',\\\\r\\\\n    points: mainPoints(\\\\r\\\\n      run.coreLengthMm,\\\\r\\\\n      row.y,\\\\r\\\\n      fabricationCoverMm,\\\\r\\\\n      start,\\\\r\\\\n      end,\\\\r\\\\n    ),\\\\r\\\\n    closed: false,\\\\r\\\\n    length,\\\\r\\\\n    count: row.count,\\\\r\\\\n    zones,\\\\r\\\\n    splice: {\\\\r\\\\n      method: section.spliceMethod,\\\\r\\\\n      countPerBar: splice.co