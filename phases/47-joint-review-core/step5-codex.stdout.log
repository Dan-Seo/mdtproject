: CutoffPosition => {\\\\r\\\\n    const supportStartMm = run.memberOffsetsMm[index] + run.spans[index].clear\\\\r\\\\n    const supportMm = run.memberOffsetsMm[index + 1] - supportStartMm\\\\r\\\\n    const designMm = 2 * cutoffMm + supportMm\\\\r\\\\n\\\\r\\\\n    return {\\\\r\\\\n      memberId: run.ownerId,\\\\r\\\\n      count: row.count,\\\\r\\\\n      slotStart: row.slotStart,\\\\r\\\\n      fromMm: supportStartMm - cutoffMm,\\\\r\\\\n      drawnMm: designMm,\\\\r\\\\n      designMm,\\\\r\\\\n      rules: [],\\\\r\\\\n      basis:\\\\r\\\\n        `??ｊ맙??沅?類쒗맍??${cutoffMm} ?? 塋?鼇?堉?湲깃굘??${supportMm} 塋?${designMm}` +\\\\r\\\\n        `塋딅뛻由?蹂좊뎠?諛ㅺ뎌??κ굉??寃롳Ⅴ????寃?袁ы렫`,\\\\r\\\\n    }\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  return [\\\\r\\\\n    outer(start, 0),\\\\r\\\\n    ...interior,\\\\r\\\\n    outer(end, run.coreLengthMm - cutoffMm),\\\\r\\\\n  ]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction generateCutoff(\\\\r\\\\n  input: GirderRebarInput,\\\\r\\\\n  pack: RulePack,\\\\r\\\\n  coverRule: RuleHit,\\\\r\\\\n  fabricationCoverAdditionRule: RuleHit,\\\\r\\\\n  fabricationCoverMm: number,\\\\r\\\\n  rows: CutoffRow[],\\\\r\\\\n): Rebar[] {\\\\r\\\\n  const { section } = input\\\\r\\\\n  const firstRow = rows[0]\\\\r\\\\n  if (firstRow === undefined) return []\\\\r\\\\n  const lapRule = lookupRule(pack, 'lap.L1', {\\\\r\\\\n    fc: section.fc,\\\\r\\\\n    grade: section.grade,\\\\r\\\\n    hook: false,\\\\r\\\\n  })\\\\r\\\\n  const lapLengthMm = millimetres(lapRule, barDiameter(section.main.size))\\\\r\\\\n  // ??녾쿀??⑸쑘??횧庸뉖뜂鍮?類쏄쾹?琉밸돕?猷붽괵??瑜?諛ㅺ굵 ??癲⑤씤痢?酉명떖 ??룸뻤??Ｂ?⑹ジ??댟怨⑹댇??걔怨?癲딅틹異?r\\\\n  // ?遺듦쾹??Ｂ?꿸쾹畑댁떏援??ｊ쿁???怨?癲?庸?怡?猷붽괵)??㏓즰?節껉굴?議쇨괩???쿂?곷뀍援??㏃댇??곌탾?猿곴콨?숇굙已??\\\\n  // ?洹숆데?洹읙욇펶?녿퉻?類쏄괏??ｊ굄??る짂???퉻?類쏄괏?類쏄콨俑앸씤???痢??쇨쾽鶯낅짅嫄??고렩畑댁떓? 塋???ｊ맙??沅??\\\\n  // 俑앸씤??塋?鼇?堉?湲깃굘????寃??껎렫????녾쿀??ｊ쾹 Rebar ?????⑦뇡????嫄???샍??됯쾼?袁좉쿁????\\\\n  // 鼇?堉??沅?誘???琉삳렠癲ル뿣嫄ｉ툣戮⑷깻??沅????袁ｋ짂???퉻?類쏄쾸?琉듦괍??ｊ쾷??ｊ께??(ADR-019)??\\\\n  const groups = new Map<string, CutoffPosition[]>()\\\\r\\\\n\