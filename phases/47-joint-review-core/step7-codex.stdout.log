rs\\emper\\mdtproject\\phases\\47-joint-review-core\\step6-report.json\r\n{\n  \"changed_files\": [\n    \"src/lib/review/xray.ts\",\n    \"src/lib/review/xray.test.ts\",\n    \"phases/47-joint-review-core/index.json\",\n    \"phases/47-joint-review-core/step6-report.json\"\n  ],\n  \"tests_added\": [\n    \"src/lib/review/xray.test.ts\"\n  ],\n  \"mutations\": [\n    {\n      \"mutation\": \"omit hookTails from drawnLengthMm\",\n      \"command\": \"npx vitest run src/lib/review/xray.test.ts -t \\\"closed edges\\\"\",\n      \"result\": \"failed as expected\"\n    },\n    {\n      \"mutation\": \"remove conditions comparison from rebarsUsingRule\",\n      \"command\": \"npx vitest run src/lib/review/xray.test.ts -t \\\"exact rule identity\\\"\",\n      \"result\": \"failed as expected\"\n    },\n    {\n      \"mutation\": \"fall back to the first rule when a zone rule is missing\",\n      \"command\": \"npx vitest run src/lib/review/xray.test.ts -t \\\"rejects a zone\\\"\",\n      \"result\": \"failed as expected\"\n    }\n  ],\n  \"paths_verified\": [\n    \"src/lib/review/xray.ts\"\n  ]\n}\n\r\nimport 'fake-indexeddb/auto'\n\nimport { describe, expect, it, vi } from 'vitest'\n\nimport { createSampleProject } from '@/domain/model/sample-project'\nimport type { Rebar } from '@/domain/model/rebar'\nimport type { Project } from '@/domain/model/project'\nimport { emptyReviewState, parseReviewState } from '@/domain/review/state'\nimport {\n  checkConditionsFingerprint,\n  memberResultFingerprint,\n  projectFingerprints,\n  rulepackFingerprint,\n} from '@/domain/review/fingerprint'\nimport { assessImpact } from '@/domain/review/impact'\nimport { elementRefTargets, itemValidity } from '@/domain/review/validity'\nimport { packageReadiness } from '@/domain/review/readiness'\nimport {\n  jointRebarMemberIds,\n  resolveJoint,\n} from '@/domain/review/joint'\nimport type {\n  ElementRef,\n  RecordedFinding,\n  ReviewItem,\n  WorkPackage,\n} from '@/domain/review/types'\nimport { createStressProject } from '@/domain/model/stress-project'\nimport { buildTakeoff } from '@/lib/hooks/useTakeoff'\nimport {\n  defaultExclusions,\n  exclusionMatches,\n  runGeometryCheck,\n} from '@/lib/review/geometry-check'\nimport { capsuleClearanceMm } from '@/lib/review/segment-distance'\nimport { xrayForRebar } from '@/lib/review/xray'\nimport { serializeProjectFile, readProjectFile } from '@/lib/persist/file'\nimport { saveBundle } from '@/lib/persist/indexeddb'\nimport { buildingLayout } from '@/lib/viewer/building'\nimport { barDiameter, rebarRadius } from '@/lib/viewer/geometry'\nimport { cloneProject, reviewSnapshot, reviewViewerSnapshot } from './fixtures/review/snapshot'\nimport { jpMlitRulePack } from '@/rulepack'\n\nconst CLASH = '\\u5E72\\u6E09\\u5019\\u88DC'\nconst CLEARANCE = '\\u3042\\u304D\\u4E0D\\u8DB3\\u5019\\u88DC'\nconst CONTACT = '\\u63A5\\u89E6'\nconst UPPER = '\\u4E0A\\u7AEF\\u7B4B'\nconst LOWER = '\\u4E0B\\u7AEF\\u7B4B'\nconst CONFIRMED = '\\u78BA\\u8A8D\\u6E08'\n\nfunction changeG2Pitch(project = createSampleProject()): Project {\n  const next = cloneProject(project)\n  next.sections = next.sections.map((section) =>\n    section.id === 'section-G2' && section.kind === '\\u5927\\u6881'\n      ? { ...section, stirrup: { ...section.stirrup, pitch: 200 } }\n      : section,\n  )\n  return next\n}\n\nfunction changeC1(project = createSampleProject()): Project {\n  const next = cloneProject(project)\n  next.sections = next.sections.map((section) =>\n    section.id === 'section-C1' && section.kind === '\\u67F1'\n      ? { ...section, b: 900 }\n      : section,\n  )\n  return next\n}\n\nfunction checkInput(\n  project = createSampleProject(),\n  jointId = '1F-X2Y1',\n  clearance: number | null = null,\n  exclusions = [],\n) {\n  const takeoff = buildTakeoff(project)\n  const resolution = resolveJoint(project, jointId)\n  if (resolution.status !== 'joint') throw new Error('joint fixture expected')\n  const unsupportedMemberIds = new Set(takeoff.unsupportedMembers.map(({ memberId }) => memberId))\n  const snapshot = reviewSnapshot(project)\n  return {\n    project,\n    rebars: takeoff.rebars,\n    takeoff,\n    unsupportedMemberIds,\n    joint: resolution.joint,\n    settings: {\n      clearance: clearance === null\n        ? null\n        : {\n            valueMm: clearance,\n            source: '\\u5229\\u7528\\u8005\\u5165\\u529B' as const,\n            scope: 'counterexample',\n            enteredAt: '2026-09-17T00:00:00Z',\n            note: 'temporary verification input',\n          },\n    },\n    exclusions,\n    fingerprints: snapshot.fingerprints,\n  }\n}\n\nfunction item(project: Project, target: ElementRef, finding?: RecordedFinding): ReviewItem {\n  const snapshot = reviewSnapshot(project)\n  const memberIds = elementRefTargets([target], project).memberIds\n  snapshot.fingerprints = {\n    ...snapshot.fingerprints,\n    members: Object.fromEntries(memberIds.map((memberId) => [memberId, snapshot.fingerprints.members[memberId]])),\n  }\n  return {\n    id: 'item-1',\n    createdAt: '2026-09-17T10:00:00+09:00',\n    updatedAt: '2026-09-17T10:00:00+09:00',\n    targets: [target],\n    title: 'review',\n    body: 'body',\n    status: CONFIRMED,\n    confirmations: [],\n    snapshot: reviewViewerSnapshot(snapshot.fingerprints),\n    ...(finding ? { finding } : {}),\n  }\n}\n\nfunction workPackage(entry: WorkPackage['checklist'][number]): WorkPackage {\n  return {\n    id: 'package-1',\n    name: 'package',\n    targets: [{ kind: 'member', memberId: '1F-X1Y1' }],\n    assignee: 'reviewer',\n    dueDate: null,\n    checklist: [entry],\n    createdAt: '2026-09-17T10:00:00+09:00',\n    updatedAt: '2026-09-17T10:00:00+09:00',\n  }\n}\n\ndescribe('phase 47 core counterexamples', () => {\n  it('finds the upper G1/G2 clash inside the support-column plan region', () => {\n    const result = runGeometryCheck(checkInput())\n    const finding = result.findings.find((entry) =>\n      entry.kind === CLASH\n      && entry.a.role === UPPER\n      && entry.b.role === UPPER\n      && entry.a.memberId !== entry.b.memberId,\n    )\n    expect(finding).toBeDefined()\n    expect(finding?.clearanceMm).toBeCloseTo(-22, 6)\n    expect(finding?.a.memberId).not.toBe(finding?.b.memberId)\n    expect(finding?.a.memberId).toMatch(/G[12]/)\n    expect(finding?.b.memberId).toMatch(/G[12]/)\n    for (const point of finding?.closestPoints ?? []) {\n      expect(point[0]).toBeGreaterThanOrEqual(result.scope.regionMm.x[0])\n      expect(point[0]).toBeLessThanOrEqual(result.scope.regionMm.x[1])\n      expect(point[2]).toBeGreaterThanOrEqual(result.scope.regionMm.z[0])\n      expect(point[2]).toBeLessThanOrEqual(result.scope.regionMm.z[1])\n    }\n  })\n\n  it('keeps the 25 mm lower gap at thresholds 24 and 26, including the separated-height pair', () => {\n    const below = runGeometryCheck(checkInput(undefined, undefined, 24))\n    const above = runGeometryCheck(checkInput(undefined, undefined, 26))\n    expect(below.findings.some(({ kind, clearanceMm }) => kind === CLEARANCE && Math.abs(clearanceMm - 25) < 1e-6)).toBe(false)\n    expect(above.findings.some(({ kind, clearanceMm }) => kind === CLEARANCE && Math.abs(clearanceMm - 25) < 1e-6)).toBe(true)\n\n    const project = createSampleProject()\n    const takeoff = buildTakeoff(project)\n    const g1 = takeoff.rebars.find((rebar) => rebar.memberId === '1F-G1-X1Y1-X' && rebar.role === LOWER)\n    const g2 = takeoff.rebars.find((rebar) => rebar.memberId === '1F-G2-X2Y1-Y' && rebar.role === LOWER)\n    if (!g1 || !g2) throw new Error('lower-main fixtures expected')\n    const simplify = (rebar: Rebar): Rebar => ({\n      ...rebar,\n      points: [rebar.points[0], rebar.points[rebar.points.length - 1]],\n      closed: false,\n      hookTails: undefined,\n    })\n    const first = buildingLayout(project, [simplify(g1), simplify(g2)], new Set(), (size) => barDiameter(size) / 2)\n    const a = first.rebar.find(({ rebarId }) => rebarId === g1.id)\n    const b = first.rebar.find(({ rebarId }) => rebarId === g2.id)\n    if (!a || !b) throw new Error('synthetic layout fixtures expected')\n    const delta = a.from[1] + 48.5 - b.from[1]\n    const shifted = {\n      ...simplify(g2),\n      points: simplify(g2).points.map(([x, y, z]) => [x, y + delta, z] as [number, number, number]),\n    }\n    const input = checkInput()\n    const result = runGeometryCheck({\n      ...input,\n      rebars: [simplify(g1), shifted],\n      settings: { clearance: { valueMm: 26, source: '\\u5229\\u7528\\u8005\\u5165\\u529B', scope: 'synthetic', enteredAt: '2026-09-17', note: '' } },\n    })\n    const synthetic = result.findings.find(({ clearanceMm }) => Math.abs(clearanceMm - 25) < 1e-6)\n    expect(capsuleClearanceMm(\n      { from: [0, 0, 0], to: [100, 0, 0], radius: 12.5 },\n      { from: [0, 48.5, 0], to: [100, 48.5, 0], radius: 11 },\n    ).clearanceMm).toBeCloseTo(25, 6)\n    expect(synthetic).toBeDefined()\n    expect(synthetic?.a.size).toBe('D22')\n    expect(synthetic?.b.size).toBe('D25')\n  })\n\n  it('retains unchecked items, has no global pass verdict, and reports no target for columns only', () => {\n    const input = checkInput()\n    const result = runGeometryCheck(input)\n    expect(result.unchecked.map(({ what }) => what)).toEqual(expect.arrayContaining(['\\u7D99\\u624B\\u4F4D\\u7F6E', '\\u30D1\\u30CD\\u30EB\\u30BE\\u30FC\\u30F3\\u5E2F\\u7B4B']))\n    expect(result.verdict).not.toHaveProperty('overall')\n    expect(JSON.stringify(result)).not.toContain('\\u5408\\u683C')\n    const allTargetIds = new Set(jointRebarMemberIds(input.project, input.joint))\n    const noTarget = runGeometryCheck({ ...input, unsupportedMemberIds: allTargetIds })\n    expect(noTarget.verdict.clash).toBe('\\u691C\\u67FB\\u5BFE\\u8C61\\u306A\\u3057')\n    expect(noTarget.verdict.clearance).toBe('\\u691C\\u67FB\\u5BFE\\u8C61\\u306A\\u3057')\n    expect(noTarget.verdict.contact).toBe('\\u691C\\u67FB\\u5BFE\\u8C61\\u306A\\u3057')\n  })\n\n  it('keeps girder clashes while excluding intended same-member contacts only', () => {\n    const input = checkInput(undefined, undefined, null, [])\n    const raw = runGeometryCheck(input)\n    const excluded = runGeometryCheck({ ...input, exclusions: defaultExclusions('2026-09-17T00:00:00Z') })\n    expect(raw.findings.some(({ kind }) => kind === CLASH)).toBe(true)\n    expect(raw.findings.some(({ kind }) => kind === CONTACT)).toBe(true)\n    expect(excluded.verdict.excludedCounts[CONTACT]).toBeGreaterThan(0)\n    expect(excluded.findings.some(({ kind, excludedBy }) => kind === CONTACT && excludedBy !== null)).toBe(true)\n    expect(excluded.findings.some(({ kind }) => kind === CLASH)).toBe(true)\n    const [exclusion] = defaultExclusions('now')\n    const contactA = { memberId: 'm1', rebarId: 'a', role: '\\u5E2F\\u7B4B', size: 'D13' as const, barIndex: 0, segmentIndex: 0 }\n    const contactB = { memberId: 'm1', rebarId: 'b', role: '\\u4E3B\\u7B4B', size: 'D13' as const, barIndex: 0, segmentIndex: 0 }\n    expect(exclusionMatches(exclusion, CONTACT, contactA, contactB)).toBe(true)\n    expect(exclusionMatches({ ...exclusion, scope: { ...exclusion.scope, kinds: [CLASH] } }, CONTACT, contactA, contactB)).toBe(false)\n  })\n\n  it('rechecks only the G2-dependent joint after a G2 pitch edit', () => {\n    const baseline = createSampleProject()\n    const changed = changeG2Pitch(baseline)\n    const current = reviewSnapshot(changed)\n    const currentModel = { project: changed, fingerprints: current.fingerprints, impact: assessImpact(reviewSnapshot(baseline), current) }\n    expect(itemValidity(item(baseline, { kind: 'joint', columnMemberId: '1F-X1Y1' }), currentModel)).not.toHaveProperty('reasons')\n    expect(itemValidity(item(baseline, { kind: 'joint', columnMemberId: '1F-X2Y1' }), currentModel)).toHaveProperty('reasons')\n    expect(itemValidity(item(baseline, { kind: 'member', memberId: '1F-G2-X2Y1-Y' }), currentModel)).toHaveProperty('reasons')\n\n    const displayChanged = cloneProject(baseline)\n    displayChanged.name = 'other'\n    displayChanged.notes = { note: 'changed' }\n    displayChanged.grid = { ...displayChanged.grid, xLabels: ['X1', 'X2'], yLabels: ['Y1', 'Y2', 'Y3'] }\n    expect(itemValidity(item(baseline, { kind: 'member', memberId: '1F-X1Y1' }), { project: displayChanged, fingerprints: reviewSnapshot(baseline).fingerprints, impact: null })).not.toHaveProperty('reasons')\n\n    const settings = { clearance: { valueMm: 26, source: '\\u5229\\u7528\\u8005\\u5165\\u529B' as const, scope: 'same', enteredAt: '2026-09-17', note: 'a' } }\n    expect(checkConditionsFingerprint(settings, [])).toBe(checkConditionsFingerprint({ clearance: { ...settings.clearance, enteredAt: 'later', note: 'b' } }, []))\n  })\n\n  it('invalidates finding items on condition changes and marks deleted targets as changed', () => {\n    const baseline = createSampleProject()\n    const snapshot = reviewSnapshot(baseline)\n    const finding: RecordedFinding = {\n      checkId: 'check',\n      findingId: 'finding',\n      kind: CLEARANCE,\n      clearanceMm: 25,\n      a: { memberId: '1F-G1-X1Y1-X', rebarId: 'a', role: LOWER, barIndex: 0, segmentIndex: 0 },\n      b: { memberId: '1F-G2-X2Y1-Y', rebarId: 'b', role: LOWER, barIndex: 0, segmentIndex: 0 },\n      closestPoints: [[0, 0, 0], [0, 0, 0]],\n      basis: 'basis',\n    }\n    const changedChecks = { ...snapshot.fingerprints, checkConditions: 'changed' }\n    const findingValidity = itemValidity(item(baseline, { kind: 'member', memberId: '1F-G1-X1Y1-X' }, finding), { project: baseline, fingerprints: changedChecks, impact: null })\n    expect(findingValidity).toHaveProperty('reasons')\n    expect(JSON.stringify(findingValidity)).toContain('\\u691C\\u67FB\\u6761\\u4EF6\\u5909\\u66F4')\n    const noFindingValidity = itemValidity(item(baseline, { kind: 'member', memberId: '1F-G1-X1Y1-X' }), { project: baseline, fingerprints: changedChecks, impact: null })\n    expect(JSON.stringify(noFindingValidity)).not.toContain('\\u691C\\u67FB\\u6761\\u4EF6\\u5909\\u66F4')\n\n    const deleted = cloneProject(baseline)\n    deleted.members = deleted.members.filter(({ id }) => id !== '1F-G1-X1Y1-X')\n    const current = reviewSnapshot(deleted)\n    const deletedValidity = itemValidity(item(baseline, { kind: 'member', memberId: '1F-G1-X1Y1-X' }), { project: deleted, fingerprints: current.fingerprints, impact: assessImpact(snapshot, current) })\n    expect(JSON.stringify(deletedValidity)).toContain('\\u5BFE\\u8C61\\u5909\\u66F4')\n  })\n\n  it('keeps X-Ray design quantity separate from shape, including shape-less roles', () => {\n    const project = createSampleProject()\n    const { rebars, lines } = buildTakeoff(project)\n    const main = rebars.find(({ role }) => role === '\\u4E3B\\u7B4B')\n    if (!main) throw new Error('main rebar expected')\n    const view = xrayForRebar(main, project, lines)\n    expect(view.quantity.designCount).toBe(main.count)\n    expect(view.quantity.designLengthMm).toBe(main.length)\n    expect(view.shape).toHaveProperty('drawn')\n    expect(view.shape.drawn).toBe(true)\n    const hidden = {\n      ...main,\n      id: `${main.id}-opening`,\n      role: '\\u958B\\u53E3\\u88DC\\u5F37\\u7B4B' as const,\n      points: [[0, 0, 0], [100, 0, 0]] as [number, number, number][],\n      closed: false,\n      hookTails: undefined,\n      length: 1234,\n      count: 2,\n      placement: undefined,\n      splice: undefined,\n      zones: [],\n    }\n    const hiddenView = xrayForRebar(hidden, project, [])\n    expect(hiddenView.shape).toMatchObject({ drawn: false })\n    expect(hiddenView.quantity.designLengthMm).toBe(1234)\n    expect(hiddenView.quantity.designCount).toBe(2)\n  })\n\n  it('keeps missing unit mass nonzero-safe and distinguishes unsupported from empty results', () => {\n    const base = reviewSnapshot(createSampleProject())\n    const currentProject = cloneProject(base.project)\n    currentProject.unitMass = { D13: 0.995 }\n    const impact = assessImpact(base, reviewSnapshot(currentProject))\n    const mass = impact.lines.find((line) => line.mass?.beforeKg === null)?.mass\n    expect(mass?.beforeKg).toBeNull()\n    expect(mass?.before).toBe('\\u5358\\u4F4D\\u8CEA\\u91CF\\u672A\\u5165\\u529B')\n    expect(mass?.beforeKg).not.toBe(0)\n    const unsupported = reviewSnapshot(cloneProject(base.project))\n    unsupported.fingerprints = projectFingerprints(unsupported.project, unsupported.rebars, new Set(['1F-X1Y1']), jpMlitRulePack, 1, null)\n    expect(unsupported.fingerprints.members['1F-X1Y1'].result).toBeNull()\n    expect(memberResultFingerprint('not-present', [])).not.toBeNull()\n  })\n\n  it('round-trips review targets, fingerprints, packages and writes the bundle in one transaction', async () => {\n    const project = createSampleProject()\n    const snapshot = reviewSnapshot(project)\n    const review = {\n      ...emptyReviewState(),\n      baseline: { label: 'baseline', capturedAt: '2026-09-17', project, fingerprints: snapshot.fingerprints },\n      items: [item(project, { kind: 'member', memberId: '1F-X1Y1' })],\n      packages: [workPackage({ id: 'check', label: 'joint', required: true, reviewItemIds: ['item-1'], status: CONFIRMED })],\n    }\n    const parsed = await readProjectFile(new File([serializeProjectFile(project, review)], 'review.json'))\n    expect(parsed.review.items[0].targets).toEqual(review.items[0].targets)\n    expect(parsed.review.baseline?.fingerprints).toEqual(review.baseline?.fingerprints)\n    expect(parsed.review.packages).toEqual(review.packages)\n    expect(serializeProjectFile(project, emptyReviewState())).toBe(JSON.stringify(project))\n\n    const transaction = vi.spyOn(IDBDatabase.prototype, 'transaction')\n    try {\n      await saveBundle({ project, review: emptyReviewState() })\n      console.log(JSON.stringify(transaction.mock.calls))\n      expect(transaction.mock.calls.filter(([, mode]) => mode === 'readwrite')).toHaveLength(1)\n      expect(transaction.mock.calls.find(([, mode]) => mode === 'readwrite')).toEqual(['project', 'readwrite'])\n    } finally {\n      transaction.mockRestore()\n    }\n  })\n\n  it('does not keep a confirmed package ready after linked or unlinked target changes', () => {\n    const baseline = createSampleProject()\n    const baselineSnapshot = reviewSnapshot(baseline)\n    const confirmed = item(baseline, { kind: 'member', memberId: '1F-X1Y1' })\n    const entry = { id: 'check', label: 'joint', required: true, reviewItemIds: ['item-1'], status: CONFIRMED as const }\n    const ready = packageReadiness(workPackage(entry), [confirmed], { project: baseline, fingerprints: baselineSnapshot.fingerprints, impact: null })\n    expect(ready.blockers).toEqual([])\n    const changed = changeC1(baseline)\n    const changedSnapshot = reviewSnapshot(changed)\n    const changedModel = { project: changed, fingerprints: changedSnapshot.fingerprints, impact: assessImpact(baselineSnapshot, changedSnapshot) }\n    expect(packageReadiness(workPackage(entry), [confirmed], changedModel).blockers.length).toBeGreaterThan(0)\n\n    const unlinkedEntry = { id: 'check', label: 'joint', required: true, reviewItemIds: [], status: CONFIRMED as const, confirmation: { by: 'reviewer', at: '2026-09-17', note: '', fingerprints: baselineSnapshot.fingerprints } }\n    expect(packageReadiness(workPackage(unlinkedEntry), [], changedModel).blockers.length).toBeGreaterThan(0)\n    const unconfirmed = { ...confirmed, status: '\\u672A\\u78BA\\u8A8D' as const }\n    expect(packageReadiness(workPackage(entry), [unconfirmed], { project: baseline, fingerprints: baselineSnapshot.fingerprints, impact: null }).blockers.length).toBeGreaterThan(0)\n  })\n\n  it('marks member replacement for confirmation, rejects review schema 2, and fingerprints source URL changes', () => {\n    const baseline = createSampleProject()\n    const changed = cloneProject(baseline)\n    changed.members = changed.members.map((member) => member.id === '1F-X1Y1' ? { ...member, id: '1F-X1Y1-renamed' } : member)\n    const impact = assessImpact(reviewSnapshot(baseline), reviewSnapshot(changed))\n    expect(JSON.stringify(impact)).toContain('\\u5BFE\\u5FDC\\u8981\\u78BA\\u8A8D')\n    expect(() => parseReviewState({ ...emptyReviewState(), reviewSchemaVersion: 2 })).toThrow(/reviewSchemaVersion/)\n    const modified = JSON.parse(JSON.stringify(jpMlitRulePack)) as typeof jpMlitRulePack\n    modified.entries[0] = { ...modified.entries[0], source: { ...modified.entries[0].source, url: `${modified.entries[0].source.url ?? ''}#changed` } }\n    expect(rulepackFingerprint(modified)).not.toBe(rulepackFingerprint(jpMlitRulePack))\n  })\n\n  it('is deterministic and agrees with an un-narrowed capsule oracle on the sample', () => {\n    const input = checkInput()\n    const first = runGeometryCheck(input)\n    const second = runGeometryCheck(input)\n    expect(second).toEqual(first)\n    expect(first.scope.pairsTested).toBeLessThan(first.scope.segmentCount * (first.scope.segmentCount - 1) / 2)\n    const layout = buildingLayout(input.project, input.rebars, input.unsupportedMemberIds, (size) => barDiameter(size) / 2)\n    const targetIds = new Set(jointRebarMemberIds(input.project, input.joint))\n    const instances = layout.rebar.filter(({ memberId }) => targetIds.has(memberId))\n    const oracle = new Set<string>()\n    const pairKey = (kind: string, left: { rebarId: string; barIndex: number; segmentIndex: number }, right: { rebarId: string; barIndex: number; segmentIndex: number }) => {\n      const refs = [\n        `${left.rebarId}:${left.barIndex}:${left.segmentIndex}`,\n        `${right.rebarId}:${right.barIndex}:${right.segmentIndex}`,\n      ].sort()\n      return `${kind}:${refs[0]}:${refs[1]}`\n    }\n    for (let leftIndex = 0; leftIndex < instances.length; leftIndex += 1) {\n      for (let rightIndex = leftIndex + 1; rightIndex < instances.length; rightIndex += 1) {\n        const left = instances[leftIndex]\n        const right = instances[rightIndex]\n        if (left.rebarId === right.rebarId && left.barIndex === right.barIndex) continue\n        const result = capsuleClearanceMm({ from: left.from, to: left.to, radius: left.radius }, { from: right.from, to: right.to, radius: right.radius })\n        const point = [(result.pa[0] + result.pb[0]) / 2, (result.pa[1] + result.pb[1]) / 2, (result.pa[2] + result.pb[2]) / 2] as [number, number, number]\n        if (point[0] < first.scope.regionMm.x[0] || point[0] > first.scope.regionMm.x[1] || point[2] < first.scope.regionMm.z[0] || point[2] > first.scope.regionMm.z[1]) continue\n        const kind = result.clearanceMm < -1e-6 ? CLASH : Math.abs(result.clearanceMm) <= 1e-6 ? CONTACT : null\n        if (kind !== null) oracle.add(pairKey(kind, left, right))\n      }\n    }\n    const actual = new Set(first.findings.filter(({ kind }) => kind === CLASH || kind === CONTACT).map(({ kind, a, b }) => pairKey(kind, a, b)))\n    expect(actual).toEqual(oracle)\n    const real = layout.rebar.find(({ memberId }) => targetIds.has(memberId))\n    const display = buildingLayout(input.project, input.rebars, input.unsupportedMemberIds, rebarRadius).rebar.find(({ rebarId, barIndex, segmentIndex }) => real && rebarId === real.rebarId && barIndex === real.barIndex && segmentIndex === real.segmentIndex)\n    expect(real).toBeDefined()\n    expect(display?.radius).not.toBe(real?.radius)\n  })\n\n  it('uses the stress fixture for the requested two-story quantity shape', () => {\n    const project = createStressProject({ xSpanCount: 4, ySpanCount: 3, storyCount: 2 })\n    const result = buildTakeoff(project)\n    expect(result.lines.length).toBeGreaterThan(0)\n    expect(result.rebars.length).toBeGreaterThan(0)\n  })\n})\n\r\nimport { describe, it } from 'vitest'\nimport { createHash } from 'node:crypto'\nimport { createSampleProject } from '@/domain/model/sample-project'\nimport { createStressProject } from '@/domain/model/stress-project'\nimport { buildTakeoff } from '@/lib/hooks/useTakeoff'\n\ndescribe('phase 47 quantity digest', () => {\n  it('prints the stable line digests', () => {\n    for (const [name, project] of [\n      ['sample', createSampleProject()],\n      ['stress', createStressProject({ xSpanCount: 4, ySpanCount: 3, storyCount: 2 })],\n    ] as const) {\n      const lines = buildTakeoff(project).lines\n      const digest = createHash('sha256').update(JSON.stringify(lines)).digest('hex').slice(0, 16)\n      console.log(`digest ${name} ${digest} lines=${lines.length}`)\n    }\n  })\n})\n\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
