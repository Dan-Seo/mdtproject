*\\r\\n   * ?ャ긿?덀궕?뺟춮泥섎읆 **???댁뿭 ?됱씠 ?⑥뼱吏??щ윭 怨녹뿉 ?쒕뒗** 泥좉렐???꾪븳 媛믪씠??\\r\\n   * ?곈뇧? `count`媛 ?꾨? ?댁쑝誘濡?鵝띸쉰 ??횞 1?꾩튂???ф빊) ??媛믪? 3D ?꾧컻 ?꾩슜?닿퀬,\\r\\n   * ?놁쑝硫?`points`媛 ?대? 遺??濡쒖뺄 醫뚰몴?쇰뒗 ?살씠??\\r\\n   */\\r\\n  axisOffsetsMm?: number[]\\r\\n  /**\\r\\n   * 鸚㎪쥈訝사춮??릪訝餘듐겎?곥걪??죱?뚦뜝?곥굥??앫겗?좂빁?룔귚퐤營?닪?ф빊??nesting\\r\\n   * ?녻㎗?쀣걼?ⓦ걤?곭뎴?당춮??stub ??풄?띲겗?졼겓?γ굥 ??points ??axisOffsetsMm\\r\\n   * ?졼걨?㎯겘?앫겗餘드냵??옞?믣쑴?껁겎?띲겒?꾠걼?곥곩컣?븀탳?쒌겏?쀣겍?곥걼?쎼굥??\\n   */\\r\\n  axisSlotStart?: number\\r\\n  /** 泳숁뎸?믤똻?잆겒?꾦뎱嶺뗰펷?뺛꺖?쀣꺕?밤궭?⒲긿?쀯펹?ャ겘?ゃ걚 */\\r\\n  splice?: RebarSplice\\r\\n  zones?: RebarZone[]\\r\\n  /** ??泥좉렐???곗젙?섎ŉ ?ㅼ젣濡?議고쉶??猷???洹몃?濡????ㅻ쭔 ?④린硫?議고쉶 議곌굔???껊뒗??*/\\r\\n  ruleHits: RuleHit[]\\r\\n  formula: string\\r\\n}\\r\\n\\r\\nimport {\\r\\n  BAR_SIZES,\\r\\n  type Member,\\r\\n  type MemberKind,\\r\\n  type Section,\\r\\n  type ShearBarSize,\\r\\n  type SpliceMethod,\\r\\n} from '../model/member'\\r\\nimport {\\r\\n  findSection,\\r\\n  memberGroupKey,\\r\\n  storyNotFound,\\r\\n  type Project,\\r\\n} from '../model/project'\\r\\nimport type { Rebar, RebarRole, RebarShape } from '../model/rebar'\\r\\nimport { lookupMarkup } from '../rules/lookup'\\r\\nimport {\\r\\n  CONFIDENCE_ORDER,\\r\\n  type RuleConfidence,\\r\\n  type RuleHit,\\r\\n  type RulePack,\\r\\n} from '../rules/types'\\r\\n\\r\\n/**\\r\\n * ?낁㉢?멥겗?섆퐤?귡뎱嶺뗣걹??굚??겘蘊ら뇧?㎯곭텤?뗣겘嶸뉑??㎪빊?덀굥 ???곈뇧令띸츞?뷸틬??\\n * 1?싧뎴4)?삼펷竊믭펹??)?삼펷竊볩펹歟?) ?㎯뚨텤?뗧츋??겹띲굮黎귙굙?뺛걵?뗣걢?됥걽??\\n * 訝↑끹겘擁녈걵?ゃ걚??겎烏뚣겗?뗣걫?ⓨ늽?묆굥??\\n */\\r\\nexport type QuantityUnit = 'kg' | '嶸뉑?'\\r\\n\\r\\ninterface QuantityLineBase {\\r\\n  id: string\\r\\n  groupId: string\\r\\n  storyName: string\\r\\n  memberKind: MemberKind\\r\\n  mark: string\\r\\n  sectionLabel: string\\r\\n  role: RebarRole\\r\\n  size: ShearBarSize\\r\\n  /** ?볝겗烏뚣걣?잆겖?잓깿?먦겗??*/\\r\\n  places: number\\r\\n  rules: RuleHit[]\\r\\n  /**\\r\\n   * ???됱씠 湲곕똾 洹쇨굅 以?**媛???쏀븳** ?깃툒. ???됱씠?쇰룄 ?쏀븳 洹쇨굅瑜??곕㈃\\r\\n   * 洹????꾩껜媛 洹몃쭔?쇰쭔 ?뺤떎?섎떎 ??媛뺥븳 履쎌쑝濡?諛섏삱由쇳븯吏 ?딅뒗??\\r\\n   */\\r\\n  confidence: RuleConfidence\\r\\n  formula: string\\r\\n}\\r\\n\\r\\n/**\\r\\n * 蘊ら뇧???쀣겘?뚣겲?졾늽?뗣굢?ゃ걚?띲굮?곥겇?귞찉嶸쀥읃繹?1?싧뎴 ?띷뻼??나?뤵굮\\r\\n * ?뚩Þ鼇덆빓??횞 JIS G 3112 ??뜕鵝띹나?뤵띲겏若싥굙?뗣걣?곩ㅳ걹??굚??겘 JIS ?ュ쭟??굥??\\n * ?앫겗 JIS ?믥▶岳앫겎?띲겍?꾠겒?꾠겗?㎯곩닶?②끹걣?섆퐤蘊ら뇧?믣뀯?뚣굥?얇겎 kg ??눣?ゃ걚 ??\\n * 0 ?믣뀯?뚣굥?ⓨ냵鼇녔쎑?㎩릦鼇덀걬?뚣곮나?뤵걣?롥컦?ヨ쫳?덀굥??\\n */\\r\\nexport interface MassQuantityLine extends QuantityLineBase {\\r\\n  unit: 'kg'\\r\\n  shape: RebarShape\\r\\n  lengthMm: number\\r\\n  countPerMember: number\\r\\n  totalLengthMm: number\\r\\n  unitMassKgPerM: number | null\\r\\n  designKg: number | null\\r\\n  requiredKg: number | null\\r\\n}\\r\\n\\r\\nexport interface SpliceQuantityLine extends QuantityLineBase {\\r\\n  unit: '嶸뉑?'\\r\\n  method: SpliceMethod\\r\\n  /** 1?ⓩ쓲?귙걼?듽겗泳숁뎸嶸뉑???竊?1?с걗?잆굤嶸뉑???횞 ?ф빊 */\\r\\n  countPerMember: number\\r\\n  /** 嶸뉑??겹겗?덅쮫 竊?countPerMember 횞 places */\\r\\n  totalCount: number\\r\\n}\\r\\n\\r\\nexport type QuantityLine = MassQuantityLine | SpliceQuantityLine\\r\\n\\r\\nexport function isMassLine(line: QuantityLine): line is MassQuantityLine {\\r\\n  return line.unit === 'kg'\\r\\n}\\r\\n\\r\\nexport function isSpliceLine(line: QuantityLine): line is SpliceQuantityLine {\\r\\n  return line.unit === '嶸뉑?'\\r\\n}\\r\\n\\r\\nexport function massLines(lines: QuantityLine[]): MassQuantityLine[] {\\r\\n  return lines.filter(isMassLine)\\r\\n}\\r\\n\\r\\nexport function spliceLines(lines: QuantityLine[]): SpliceQuantityLine[] {\\r\\n  return lines.filter(isSpliceLine)\\r\\n}\\r\\n\\r\\n/** ?섆퐤蘊ら뇧?뚥??ㅳ겎?귝쵟?묆걼?됧컦鼇덀꺕?덅쮫?귛눣?ゃ걚 ???γ겂?잌푶?졼걨??뭽??릦鼇덀겎??겒?꾠?*/\\r\\nexport interface StorySubtotal {\\r\\n  storyName: string\\r\\n  designKg: number | null\\r\\n  requiredKg: number | null\\r\\n}\\r\\n\\r\\n/**\\r\\n * 孃꾢닪??나?뤵귞쇇力ⓦ겘孃꾠걫?ⓦ겓?뷩걲??겎?곲쉸?귡깿?먦굚瓮ⓦ걚?㏛??с겓?얇겏?곥굥??\\n * ?롥컦鼇덀겏?뺛겂??**孃꾠걫?ⓦ겓?х쳦?쀣겍** null ?ャ겒?????볝겗烏ⓦ겗?③붵겘\\r\\n * ?뚣겑??푶?뚣겲?좂쇇力ⓦ겎?띲겒?꾠걢?띲굮誤뗣걵?뗣걪?ⓦ겒??겎?곫쵟?묆걼孃꾠걣餓뽧겗孃꾠겲??\\n * 藥삠걤渦쇈??ⓦ곥걹??깄?긱걣易덀걟?뗣?\\n */\\r\\nexport interface SizeSubtotal {\\r\\n  size: ShearBarSize\\r\\n  designKg: number | null\\r\\n  requiredKg: number | null\\r\\n}\\r\\n\\r\\nexport interface QuantityTotal {\\r\\n  designKg: number | null\\r\\n  requiredKg: number | null\\r\\n}\\r\\n\\r\\nexport interface SpliceTotal {\\r\\n  method: SpliceMethod\\r\\n  totalCount: number\\r\\n}\\r\\n\\r\\ntype GroupedLine =\\r\\n  | { kind: 'kg'; line: MassQuantityLine; memberIds: Set<string>; markupRate: number }\\r\\n  | { kind: '嶸뉑?'; line: SpliceQuantityLine; memberIds: Set<string> }\\r\\n\\r\\nfunction storyName(project: Project, member: Member): string {\\r\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\r\\n  if (!story) {\\r\\n    throw storyNotFound(member.storyId)\\r\\n  }\\r\\n  return story.name\\r\\n}\\r\\n\\r\\nfunction sectionLabel(section: Section): string {\\r\\n  // ?녶숱?긱겘?녜씊?ⓨ릪?섅?00??띲겎?멥걦?괷횞d ?ⓩ쎑?뤵겏?녜씊?ャ겒?꾤윪壤€뼪?㏂겓誤뗣걟?뗣?\\n  if (section.kind === '??) {\\r\\n    return section.shape === '?녶숱'\\r\\n      ? `${section.b}?`\\r\\n      : `${section.b}횞${section.d}`\\r\\n  }\\r\\n  if (section.kind === '鸚㎪쥈') return `${section.b}횞${section.depth}`\\r\\n\\r\\n  // 鶯곥굚佯딀씮?귝뼪?㏂걣?싥걬1?ㅳ겒??겎?녜씊?ⓨ릪?섅똳180?띲겗?멥걤?밤겓?쇻굥??\\n  // ?⒲걾?됥겗?ⓩ쓲?뗣겘?겹꺂?쇈깤誤뗥눣?쀣겗?ⓩ쓲葉?닪?뚩??녴?\\n  return `t${section.thickness}`\\r\\n}\\r\\n\\r\\nexport function ruleIdentity(rule: RuleHit): string {\\n  const conditions = Object.entries(rule.conditions).sort(\\r\\n    ([left], [right]) => left.localeCompare(right),\\r\\n  )\\r\\n  return `${rule.key}\\\\u0000${JSON.stringify(conditions)}`\\r\\n}\\r\\n\\r\\nfunction uniqueRules(rules: RuleHit[]): RuleHit[] {\\r\\n  const seen = new Set<string>()\\r\\n  return rules.filter((rule) => {\\r\\n    const identity = ruleIdentity(rule)\\r\\n    if (seen.has(identity)) return false\\r\\n    seen.add(identity)\\r\\n    return true\\r\\n  })\\r\\n}\\r\\n\\r\\nfunction contributingRules(\\r\\n  pack: RulePack,\\r\\n  member: Member,\\r\\n  rebar: Rebar,\\r\\n): { rules: RuleHit[]; markup: RuleHit } {\\r\\n  // ?곗젙遺媛 ?ㅼ젣濡?議고쉶???됱쓣 洹몃?濡??대떎 ???ㅼ뿉??議고쉶 議곌굔???섏쭦?쇰㈃\\r\\n  // ?섏쭦?????녿뒗 議고쉶(吏???깆쓽 ?뗣겤??媛 洹쇨굅?먯꽌 ?щ씪吏꾨떎.\\r\\n  const rebarRules = rebar.ruleHits\\r\\n  const markup = lookupMarkup(pack, member.memberClass)\\r\\n\\r\\n  if (markup.unit !== 'ratio') {\\r\\n    throw new Error(`Rule ${markup.key} must use ratio`)\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    rules: uniqueRules([...rebarRules, markup]),\\r\\n    markup,\\r\\n  }\\r\\n}\\r\\n\\r\\n// ?뚣걯寧?뤇?㎯굚?롩쳵?꾢냵力뺡빓?뺛걣?뺛걟?계Þ鼇덆빓?뺛꺕鼇?쮫?ф빊?뚦쨯?뤵굥竊덄찉嶸쀥읃繹?\\n// 1?싧뎴2)??)竊됥귚륫?밤굮烏뚣궘?쇈겓?ャ굙?곩냵鼇녔쎑??닪烏뚣겏?쀣겍?녴걨?뗣?\\n//\\r\\n// 泳숁뎸嶸뉑??겹굚?듐겓?γ굦?뗣귡빓?뺛걣罌쀣걟?ゃ걚?밧폀竊덀궗?밧쑇?γ꺕艅잍ː凉뤵꺕繹뜻렏??\\n// measure.splice.length.factor ??竊됥걽?①츋??겹걣?뺛겂?╉굚?룔걬?뚦릪?섅겓?ゃ굤??\\n// 鵝드릦?뺛굦?잒죱??츞?뷴폀?삣눣?멥걣?뉑뼶?ャ겇?꾠겍?쀣걢雅뗥츪?㎯겒?뤵겒?뗣?\\nexport function quantityLineId(groupId: string, rebar: Rebar): string {\\r\\n  const spliceKey = rebar.splice ? `|泳숁뎸${rebar.splice.countPerBar}` : ''\\r\\n  // ?띷뻼??뚩쫸?쇈곩숱?뜰곩?力뺟춬?붵겏?ャ띲겒??겎?곩?力?鼇?쮫?룔걬)?졼걨?㎯겒?뤷뒥藥ε숱?뜰굚\\r\\n  // ?듐겓?γ굦????鼇?쮫?룔걬?뚦릪?섅겎?귝뒛?뚨퇉?뚪걬?덀겙?γ겗?꾤춮??(ADR-019)?귛릪?섋죱??\\n  // ?썬겏?쇻겏 places ??깿?먩빊?㎪빊?덀굥?잆굙?곩릪?섌깿?먦걢?됪씎?잏뎴?밤겗?ф빊?뚣겲?뗣걫??\\n  // ?곈뇧?뗣굢易덀걟?뗰펷?ャ긿?덀궕?뺟춮?㎩츪?쎼겓壅룔걪????girder.ts ??씇??뜷?믦쫳?덌펹??\\n  // Within a role, generators distinguish straight/hook90 by the point sequence;\\r\\n  // hoops have their own roles. Size is the remaining specification discriminator.\\r\\n  const shapeKey = rebar.points.map((point) => point.join(',')).join(';')\\r\\n\\r\\n  return `${groupId}|${rebar.role}|${rebar.length}|${rebar.count}${spliceKey}|壤®듁${shapeKey}|孃?{rebar.size}`\\r\\n}\\r\\n\\r\\n/**\\r\\n * 泳숁뎸??뼶凉뤵겏嶸뉑??겹겎?섆쐴?뚦쨯?뤵굥??겎?곮나?뤺죱?ⓦ겘?γ겗烏뚣궘?쇈겎?잆겖?뗣?\\n * ?룔걬?귡뜷?ュ뀯?뚣굥 ???뚣걯嶸뉑??겹겎?귡빓?뺛걣?뺛걟?곁츞?뷴폀?뚩첑?뗦졊?졼걣?뺛걝??\\n */\\r\\nexport function spliceLineId(groupId: string, rebar: Rebar): string {\\r\\n  const splice = rebar.splice\\r\\n  if (!splice) {\\r\\n    throw new Error(`Rebar has no splice to key: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  return `${groupId}|${rebar.role}|泳숁뎸|${splice.method}|${splice.countPerBar}|${rebar.count}|${rebar.length}|孃?{rebar.size}`\\r\\n}\\r\\n\\r\\nfunction recalculate(grouped: GroupedLine): void {\\r\\n  const { line, memberIds } = grouped\\r\\n  line.places = memberIds.size\\r\\n  line.confidence = weakestConfidence(line.rules)\\r\\n\\r\\n  if (grouped.kind === '嶸뉑?') {\\r\\n    grouped.line.totalCount =\\r\\n      grouped.line.countPerMember * grouped.line.places\\r\\n    return\\r\\n  }\\r\\n\\r\\n  const massLine = grouped.line\\r\\n  massLine.totalLengthMm =\\r\\n    massLine.lengthMm * massLine.countPerMember * massLine.places\\r\\n\\r\\n  if (massLine.unitMassKgPerM === null) {\\r\\n    massLine.designKg = null\\r\\n    massLine.requiredKg = null\\r\\n    return\\r\\n  }\\r\\n\\r\\n  massLine.designKg = (massLine.totalLengthMm / 1000) * massLine.unitMassKgPerM\\r\\n  massLine.requiredKg = massLine.designKg * (1 + grouped.markupRate)\\r\\n}\\r\\n\\r\\nexport function aggregateQuantity(\\r\\n  project: Project,\\r\\n  rebars: Rebar[],\\r\\n  pack: RulePack,\\r\\n): QuantityLine[] {\\r\\n  const members = new Map(project.members.map((member) => [member.id, member]))\\r\\n  const grouped = new Map<string, GroupedLine>()\\r\\n\\r\\n  for (const rebar of rebars) {\\r\\n    const member = members.get(rebar.memberId)\\r\\n    if (!member) {\\r\\n      throw new Error(`Member not found for Rebar: ${rebar.memberId}`)\\r\\n    }\\r\\n\\r\\n    const section = findSection(project, member.sectionId)\\r\\n    if (section.kind !== member.kind) {\\r\\n      throw new Error(\\r\\n        `Member and section kinds do not match: ${member.id} ` +\\r\\n          `(${member.kind}/${section.kind})`,\\r\\n      )\\r\\n    }\\r\\n\\r\\n    const groupId = memberGroupKey(project, member)\\r\\n    const id = quantityLineId(groupId, rebar)\\r\\n    const contributions = contributingRules(pack, member, rebar)\\r\\n    const existing = grouped.get(id)\\r\\n    const common = {\\r\\n      groupId,\\r\\n      storyName: storyName(project, member),\\r\\n      memberKind: member.kind,\\r\\n      mark: section.mark,\\r\\n      sectionLabel: sectionLabel(section),\\r\\n      role: rebar.role,\\r\\n      size: rebar.size,\\r\\n      places: 0,\\r\\n      // recalculate() 媛 ?됱쓽 洹쇨굅 ?꾨?瑜?蹂닿퀬 ?ㅼ떆 ?뺥븳?????ш린 媛믪? ?먮━?쒕떎.\\r\\n      confidence: 'stated' as RuleConfidence,\\r\\n    }\\r\\n\\r\\n    if (existing) {\\r\\n      if (existing.kind !== 'kg') {\\r\\n        throw new Error(`Quantity line ${id} is not measured in kg`)\\r\\n      }\\r\\n      if (existing.markupRate !== contributions.markup.value) {\\r\\n        throw new Error(`Inconsistent quantity rules in group ${id}`)\\r\\n      }\\r\\n      existing.memberIds.add(member.id)\\r\\n      existing.line.rules = uniqueRules([\\r\\n        ...existing.line.rules,\\r\\n        ...contributions.rules,\\r\\n      ])\\r\\n      recalculate(existing)\\r\\n    } else {\\r\\n      const created: GroupedLine = {\\r\\n        kind: 'kg',\\r\\n        line: {\\r\\n          ...common,\\r\\n          id,\\r\\n          unit: 'kg',\\r\\n          shape: rebar.shape,\\r\\n          lengthMm: rebar.length,\\r\\n          countPerMember: rebar.count,\\r\\n          totalLengthMm: 0,\\r\\n          // 孃꾠겎凉뺛걚??쑋?ε뒟?ゃ굢 null?귛릪?섋죱?ラ썓?얇굥?꾤춮??푶?뚦릪?섅겒??겎\\r\\n          // 竊덁툓??size 濾쒏읅竊됥곮죱??릎?㎩ㅳ걣繇잆걚?뺛걝?볝겏??겒?꾠?\\n          unitMassKgPerM: project.unitMass?.[rebar.size] ?? null,\\r\\n          designKg: null,\\r\\n          requiredKg: null,\\r\\n          rules: contributions.rules,\\r\\n          formula: rebar.formula,\\r\\n        },\\r\\n        memberIds: new Set([member.id]),\\r\\n        markupRate: contributions.markup.value,\\r\\n      }\\r\\n      recalculate(created)\\r\\n      grouped.set(id, created)\\r\\n    }\\r\\n\\r\\n    // 泳숁뎸??겒?꾦뎱嶺뗰펷?뺛꺖?쀣꺕?밤궭?⒲긿?쀯펹?ⓦ곫씉?끹걣 0 ?뗦??ⓩ빊?덀걼?꾤춮??\\n    // 烏뚣굮鵝쒌굢?ゃ걚 ??0 ??죱??냵鼇녔쎑?믣윀?곥굥?졼걨?㏛퐬?귚폓?덀겒?꾠?\\n    const splice = rebar.splice\\r\\n    if (!splice || splice.countPerBar === 0) continue\\r\\n\\r\\n    const spliceId = spliceLineId(groupId, rebar)\\r\\n    const existingSplice = grouped.get(spliceId)\\r\\n\\r\\n    if (existingSplice) {\\r\\n      if (existingSplice.kind !== '嶸뉑?') {\\r\\n        throw new Error(`Quantity line ${spliceId} is not measured in 嶸뉑?`)\\r\\n      }\\r\\n      existingSplice.memberIds.add(member.id)\\r\\n      existingSplice.line.rules = uniqueRules([\\r\\n        ...existingSplice.line.rules,\\r\\n        ...splice.rules,\\r\\n      ])\\r\\n      recalculate(existingSplice)\\r\\n      continue\\r\\n    }\\r\\n\\r\\n    const createdSplice: GroupedLine = {\\r\\n      kind: '嶸뉑?',\\r\\n      line: {\\r\\n        ...common,\\r\\n        id: spliceId,\\r\\n        unit: '嶸뉑?',\\r\\n        method: splice.method,\\r\\n        countPerMember: splice.countPerBar * rebar.count,\\r\\n        totalCount: 0,\\r\\n        rules: splice.rules,\\r\\n        formula: splice.formula,\\r\\n      },\\r\\n      memberIds: new Set([member.id]),\\r\\n    }\\r\\n    recalculate(createdSplice)\\r\\n    grouped.set(spliceId, createdSplice)\\r\\n  }\\r\\n\\r\\n  return [...grouped.values()].map(({ line }) => line)\\r\\n}\\r\\n\\r\\n/** 泳숁뎸??뼶凉뤵걫?ⓦ겓?섆쐴?뚪걬?녴겗?㎯곩릦鼇덀굚?밧폀?붵겏?ュ눣?쇻?*/\\r\\nexport function spliceTotals(lines: QuantityLine[]): SpliceTotal[] {\\r\\n  const totals = new Map<SpliceMethod, SpliceTotal>()\\r\\n\\r\\n  for (const line of spliceLines(lines)) {\\r\\n    const total = totals.get(line.method)\\r\\n    if (total) {\\r\\n      total.totalCount += line.totalCount\\r\\n      continue\\r\\n    }\\r\\n\\r\\n    totals.set(line.method, {\\r\\n      method: line.method,\\r\\n      totalCount: line.totalCount,\\r\\n    })\\r\\n  }\\r\\n\\r\\n  return [...totals.values()]\\r\\n}\\r\\n\\r\\n/** ?щ윭 洹쇨굅瑜?臾띠쓣 ?뚯쓽 ????깃툒 ??媛???쏀븳 寃? 洹쇨굅媛 ?놁쑝硫?`stated`. */\\r\\nexport function weakestConfidence(rules: RuleHit[]): RuleConfidence {\\r\\n  return rules.reduce<RuleConfidence>(\\r\\n    (weakest, { confidence }) =>\\r\\n      CONFIDENCE_ORDER.indexOf(confidence) < CONFIDENCE_ORDER.indexOf(weakest)\\r\\n        ? confidence\\r\\n        : weakest,\\r\\n    'stated',\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?х쳦濾쒑쮱媛 ?앸굹吏 ?딆? 洹쇨굅媛 ?섎굹?쇰룄 ?덈뒗媛 ??利?`stated` 媛 ?꾨땶 ?됱씠 ?덈뒗媛.\\r\\n * `transcribed`(?먮Ц 紐낆떆쨌寃???湲????ш린 ?ㅼ뼱媛꾨떎. 寃쎄퀬瑜??대┫吏 ?먮떒?섎뒗 媛믪씠誘濡?\\n * ?뚯썝臾몄뿉 媛믪씠 ?녿떎??inferred)留??몃㈃ 寃???湲곕텇??議곗슜???듦낵?쒕떎 (ADR-015).\\r\\n */\\r\\nexport function hasUnverified(lines: QuantityLine[]): boolean {\\r\\n  return hasUnverifiedRules(lines)\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뚣걯?ㅵ츣??RuleHit ??닓?ャ괾lTF ??죱?믤똻?잆걳 ruleHits ?믥쎍?ユ똻?ㅳ겗?㎯?\\n * ?묆걪?녴겎?멥걤?담걲??ADR-023 ??춬榮싥걣鸚됥굩?ｃ걼?ⓦ걤 xlsx?삣뜲?룔겏 glb ??\\n * 鈺?몜??쐣?▲걣繇잆걚?뺛걝??\\n */\\r\\nexport function hasUnverifiedRules(\\r\\n  entries: { confidence: RuleConfidence }[],\\r\\n): boolean {\\r\\n  return entries.some(({ confidence }) => confidence !== 'stated')\\r\\n}\\r\\n\\r\\nexport function unverifiedRules(lines: QuantityLine[]): RuleHit[] {\\r\\n  return uniqueRules(\\r\\n    lines.flatMap(({ rules }) =>\\r\\n      rules.filter(({ confidence }) => confidence !== 'stated'),\\r\\n    ),\\r\\n  )\\r\\n}\\r\\n\\r\\n/** ?먮Ц??媛믪씠 ?꾩삁 ?녿뒗 洹쇨굅留? ?붾젅硫뷀듃由ъ쓽 `inferred_rules` 媛 ?닿쾬?대떎. */\\r\\nexport function inferredRules(lines: QuantityLine[]): RuleHit[] {\\r\\n  return uniqueRules(\\r\\n    lines.flatMap(({ rules }) =>\\r\\n      rules.filter(({ confidence }) => confidence === 'inferred'),\\r\\n    ),\\r\\n  )\\r\\n}\\r\\n\\r\\n/** 訝?ㅳ겎?귛늽?뗣굢?ゃ걨?뚣겙?뚣굚?녴걢?됥겒?????γ겂?잌늽?졼걨擁녈걲?ⓧ툖擁녈걣?졼굦?뗣?*/\\r\\nfunction addMass(sum: number | null, value: number | null): number | null {\\r\\n  if (sum === null || value === null) return null\\r\\n  return sum + value\\r\\n}\\r\\n\\r\\nexport function storySubtotals(lines: QuantityLine[]): StorySubtotal[] {\\r\\n  const subtotals = new Map<string, StorySubtotal>()\\r\\n\\r\\n  // ?롢겘烏뚣걣?귙굦?곁쳦?╉굥?뚣곮떨?쇻겗??나?뤵걽?묆걽?귞츋???나?뤵겓擁녈걵?싥곩돯罌?\\n  // 竊??싧뎴9)竊됥굚?뚩Þ鼇덃빊?뤵겗4%?랃폓蘊ら뇧?ュ??쇻굥誤뤷츣?ゃ겗?㎫텤?뗨죱?ャ겘?쎼걢?됥겒?꾠?\\n  for (const line of lines) {\\r\\n    const subtotal = subtotals.get(line.storyName) ?? {\\r\\n      storyName: line.storyName,\\r\\n      designKg: 0,\\r\\n      requiredKg: 0,\\r\\n    }\\r\\n\\r\\n    if (isMassLine(line)) {\\r\\n      subtotal.designKg = addMass(subtotal.designKg, line.designKg)\\r\\n      subtotal.requiredKg = addMass(subtotal.requiredKg, line.requiredKg)\\r\\n    }\\r\\n\\r\\n    subtotals.set(line.storyName, subtotal)\\r\\n  }\\r\\n\\r\\n  return [...subtotals.values()]\\r\\n}\\r\\n\\r\\nexport function sizeSubtotals(lines: QuantityLine[]): SizeSubtotal[] {\\r\\n  const subtotals = new Map<ShearBarSize, SizeSubtotal>()\\r\\n\\r\\n  // 泳숁뎸烏뚣겘嶸뉑??ゃ겗?㎩뀯?됥겒????蘊ら뇧?ヨ떨?쎼겒?꾠?\\n  for (const line of massLines(lines)) {\\r\\n    const subtotal = subtotals.get(line.size) ?? {\\r\\n      size: line.size,\\r\\n      designKg: 0,\\r\\n      requiredKg: 0,\\r\\n    }\\r\\n\\r\\n    subtotal.designKg = addMass(subtotal.designKg, line.designKg)\\r\\n    subtotal.requiredKg = addMass(subtotal.requiredKg, line.requiredKg)\\r\\n    subtotals.set(line.size, subtotal)\\r\\n  }\\r\\n\\r\\n  // ?븀뤎?녴겎??겒??BAR_SIZES ??를?녜젂?㎬퓭?쇻귛냵鼇녔쎑??푶?쀣겘孃꾠겗弱뤵걬?꾦젂??\\n  // 沃???귙겗?졼걮?곮죱??눣?얗젂??깿?먦겗訝╉겧?밤겏?꾠걝?볝겗烏ⓦ겏?↓뼟岳귙겒雅뗦깄?㎩쨯?뤵굥??\\n  const ordered: ShearBarSize[] = BAR_SIZES.filter((size) =>\\r\\n    subtotals.has(size),\\r\\n  )\\r\\n  // ??뙯?ョ꽒?꾢푶??풄?띲겓餓섅걨?뗣귟맼?ⓦ걲?ⓦ곥걪??〃??죱??뭽?뚦릪?섅궥?쇈깉??툔??\\n  // ?뷩굥?덅쮫?ⓨ릦?뤵겒?뤵겒?????뷸낏烏ⓦ겏?쀣겍??곦를?녜젂?덀굤?덀겓?앫걪?뚦즸?뚣굥??\\n  // 遙섇섭佯╉걵?볠뼪獒쒎섭嶺?(K13?팗13) ?뚣걪?볝겓?γ굥 ??BAR_SIZES ??JIS ??뫜?녑릫??\\n  // ??뙯?㎯곩ㄷ?ｈ첀若싧뱚??걹?볝겓雍됥굢?ゃ걚?뗣굢??(ADR-026)??\\n  const unlisted = [...subtotals.keys()].filter(\\r\\n    (size) => !ordered.includes(size),\\r\\n  )\\r\\n\\r\\n  return [...ordered, ...unlisted].map((size) => subtotals.get(size)!)\\r\\n}\\r\\n\\r\\nexport function grandTotal(lines: QuantityLine[]): QuantityTotal {\\r\\n  return massLines(lines).reduce<QuantityTotal>(\\r\\n    (total, line) => ({\\r\\n      designKg: addMass(total.designKg, line.designKg),\\r\\n      requiredKg: addMass(total.requiredKg, line.requiredKg),\\r\\n    }),\\r\\n    { designKg: 0, requiredKg: 0 },\\r\\n  )\\r\\n}\\r\\n\\r\\nimport {\\r\\n  decomposeGirderMainRow,\\r\\n  type ColumnSection,\\r\\n  type GirderMainRow,\\r\\n  type GirderSection,\\r\\n  type Opening,\\r\\n  type Section,\\r\\n  type ShearBarSize,\\r\\n  type SlabBarRow,\\r\\n  type SlabSection,\\r\\n  type WallSection,\\r\\n} from '@/domain/model/member'\\r\\nimport type {\\r\\n  Rebar,\\r\\n  RebarPlacement,\\r\\n  RebarRole,\\r\\n  RebarZone,\\r\\n} from '@/domain/model/rebar'\\r\\nimport { stirrupPositions } from '@/domain/rebar/stirrup-layout'\\r\\n\\r\\nexport type Point3 = [number, number, number]\\r\\n\\r\\nexport interface Segment {\\n  from: Point3\\n  to: Point3\\n  radius: number\\n  barIndex?: number\\n  hookTail?: boolean\\n}\\r\\n\\r\\nexport interface Bounds {\\r\\n  min: Point3\\r\\n  max: Point3\\r\\n}\\r\\n\\r\\nexport type ClipAxis = 'x' | 'y' | 'z'\\r\\n\\r\\n/**\\r\\n * mm 醫뚰몴怨꾩쓽 ?덈떒 ?꾩튂瑜?THREE.Plane怨?媛숈? normal/constant ?뺥깭濡?留뚮뱺??\\r\\n * +異?normal??constant = ?뭦osition?대?濡??⑤뒗 ?곸뿭? [position, max]????\\n * ratio媛 而ㅼ쭏?섎줉 醫곸븘吏怨?ratio=1?대㈃ ?꾨? ?섎┛??\\r\\n * scene ?⑥쐞 蹂?섏? ?뚮뜑??寃쎄퀎?먯꽌留??섑뻾?쒕떎.\\r\\n */\\r\\nexport function clipPlaneForMm(\\r\\n  bounds: { min: Point3; max: Point3 },\\r\\n  axis: ClipAxis,\\r\\n  ratio: number,\\r\\n): { normal: Point3; constantMm: number } {\\r\\n  assertBounds(bounds)\\r\\n  if (!Number.isFinite(ratio) || ratio < 0 || ratio > 1) {\\r\\n    throw new Error(`Invalid clip ratio: ${ratio}`)\\r\\n  }\\r\\n\\r\\n  const axisIndex = axis === 'x' ? 0 : axis === 'y' ? 1 : 2\\r\\n  const positionMm =\\r\\n    bounds.min[axisIndex] +\\r\\n    (bounds.max[axisIndex] - bounds.min[axisIndex]) * ratio\\r\\n  const normal: Point3 = [0, 0, 0]\\r\\n  normal[axisIndex] = 1\\r\\n\\r\\n  return { normal, constantMm: -positionMm }\\r\\n}\\r\\n\\r\\nexport interface CameraFit {\\r\\n  position: Point3\\r\\n  target: Point3\\r\\n}\\r\\n\\r\\nexport const CAMERA_FOV_DEGREES = 38\\r\\nexport const CAMERA_FRAME_MARGIN = 1.08\\r\\nexport const CAMERA_DIRECTION: Point3 = [0.72, 0.34, 0.86]\\r\\n\\r\\nconst MINIMUM_DISPLAY_DIAMETER = 14\\r\\nconst DISPLAY_DIAMETER_SCALE = 1.6\\r\\n\\r\\nexport type RebarLayer = 'main' | 'hoop' | 'hidden'\\r\\n\\r\\nexport function roleToLayer(role: RebarRole): RebarLayer {\\r\\n  switch (role) {\\r\\n    case '訝사춮':\\r\\n    case '訝딁ク嶺?:\\r\\n    case '訝뗧ク嶺?:\\r\\n    case '訝딁ク?ャ긿?덀궕?뺟춮':\\r\\n    case '訝뗧ク?ャ긿?덀궕?뺟춮':\\r\\n      return 'main'\\r\\n    case '躍?춮':\\r\\n    case '?귙겙?됬춮':\\r\\n    // 亮끾??곭춮? ?귙겙?됬춮??寃곗냽?섎뒗 媛濡?諛⑺뼢 蹂댁“洹쇱씠??媛숈? ?덉씠?댁뿉 ?붾떎.\\r\\n    case '亮끾??곭춮':\\r\\n      return 'hoop'\\r\\n    // ?밭춮? ?ㅽ뙩 諛⑺뼢?쇰줈 ?먮Ⅴ???몃줈洹쇱씠??訝사춮怨?媛숈? ?덉씠?대떎.\\r\\n    case '?밭춮':\\r\\n    // ?먬쐡鶯곸쓽 潁?춮? 遺?ъ텞???곕씪 ?먮Ⅴ???몃줈洹쇱씠??訝사춮怨?媛숇떎.\\r\\n    case '潁?춮':\\r\\n      return 'main'\\r\\n    // 與ょ춮? 洹??몃줈洹쇱쓣 媛濡쒖?瑜대뒗 諛곕젰洹쇱씠??躍?춮쨌?귙겙?됬춮怨?媛숈? ?덉씠?대떎.\\r\\n    case '與ょ춮':\\r\\n      return 'hoop'\\r\\n    // 佯딀씮??말嶺뗣걣2?밧릲?ヨ뎔?뗣걽?묆겎?⒲굦?귚말嶺뗣걽 ??訝듾툔??씊?믡꺃?ㅳ깶?쇈겎\\r\\n    // ?녴걨?ゃ걚?귛늽?묆굥?ⓦ뚥말嶺뗰폀躍?춮?띲겏?꾠걝?덀궛?ャ겗?뤷뫑?뚪깿?먦걫?ⓦ겓鸚됥굩?뗣?\\n    case 'X?밧릲訝딁ク嶺?:\\r\\n    case 'X?밧릲訝뗧ク嶺?:\\r\\n    case 'Y?밧릲訝딁ク嶺?:\\r\\n    case 'Y?밧릲訝뗧ク嶺?:\\r\\n      return 'main'\\r\\n    // ?뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑邕?쮼??빊?뤷뀯?쎼겎?귙굤??D壤®듁??퐳?녈걮?ゃ걚 (ADR-034)??\\n    case '?뗥룭獒쒎섭嶺?:\\r\\n      return 'hidden'\\r\\n    default: {\\r\\n      const unsupported: never = role\\r\\n      throw new Error(`Unsupported RebarRole: ${unsupported}`)\\r\\n    }\\r\\n  }\\r\\n}\\r\\n\\r\\n// ?쇈겞?띲겗?긷춻?믦맼?ⓦ걲?ⓨ뫜?녑푶?뚧츐????D13 ?귡쳵凉룟벧?쎼굯??짒凉루춮??K13?팗13 ??\\n// ?뚣걯誤뤹큵?㎯걗?ｃ겍?곥걪?볝겓?겹걮?꾣빊?ㅳ겘罌쀣걟?ゃ걚 (ADR-026)??\\nexport function barDiameter(size: ShearBarSize): number {\\r\\n  const diameter = Number(size.replace(/^[A-Z]+/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid bar size: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nexport function rebarRadius(size: ShearBarSize): number {\\r\\n  return (\\r\\n    Math.max(barDiameter(size), MINIMUM_DISPLAY_DIAMETER) *\\r\\n    DISPLAY_DIAMETER_SCALE\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?쇈겞?띲걢?됧뜇孃?(mm) ?믣눣?쇻귞뵽?㏂겘沃?겳?꾠걲?뺛겗?잆굙??〃鹽뷴?\\n * (`rebarRadius`)?믡곫쎑?띶눣?숁Æ?뗣겘若잌??믤륫?쇻?\\n *\\r\\n * ?듿푶??ㄺ?뺛걽?묆겎?ゃ걦**鵝띸쉰**?믤군?곥굥 ??躍?춮?믡걲?딀뒠?묆겒?꾠굠??\\n * 訝사춮?믣냵?담겦?γ굦?뗥늽?뚣걪?뚣걽?귛츪野멥겗與▼엹?ヨ〃鹽뷴ㅳ굮鵝욍걝?ⓦ?\\n * D13 躍?춮?틾25 訝사춮??84.8mm ?γ굥?붷츪?쎼겘 25.5mm ????訝사춮?뚩Þ鼇덀굠??\\n * 曆긱걦?뗣겲?ｃ걼與▼엹?믤륫?쇻걪?ⓦ겓?ゃ굥??\\n */\\r\\nexport type RadiusOf = (size: ShearBarSize) => number\\r\\n\\r\\n/**\\r\\n * `Rebar`???뚮???1蹂?+ ?ф빊?띾줈 紐⑤뜽留곷맂?????섎웾? 洹멸쾬?쇰줈 異⑸텇?섏?留?\\n * 3D???ㅼ젣 ?ф빊留뚰겮 洹몃젮???쒕떎. 諛곗튂??洹쒏틬?ㅺ? ?꾨땲???묐룄 洹쒖튃?대?濡?\\n * 猷고뙥???吏 ?딄퀬 ?⑤㈃ 移섏닔? ???諛곌렐 ?꾩튂?먯꽌留??좊룄?쒕떎.\\r\\n *\\r\\n * domain??points???뗣겤?딅㈃ 湲곗? 以묒떖?좎씠吏留? ?쒖떆 諛섍꼍(rebarRadius)??\\n * 怨쇱옣???덉쑝誘濡??쒖떆 怨듦컙?먯꽌??洹몃?濡?洹몃━硫?躍?춮怨?訝사춮??愿?듯븳??\\r\\n * 躍?춮? ?쒖떆 諛섍꼍留뚰겮, 訝사춮? 躍?춮 ?쒖떆 吏由?+ 訝사춮 ?쒖떆 諛섍꼍留뚰겮 ?덉そ?쇰줈\\r\\n * ?ｌ뼱 躍?춮 諛붽묑硫댁씠 ?뗣겤?딅㈃?? 訝사춮 ?쒕㈃??躍?춮 ?덉そ硫댁뿉 ?묓븯寃??쒕떎.\\r\\n */\\r\\nfunction columnRebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: ColumnSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  if (rebar.shape === 'hoop') {\\r\\n    return columnHoopPlacements(rebar)\\r\\n  }\\r\\n\\r\\n  const [insetX, , insetZ] = rebar.points[0]\\r\\n  const inward = 2 * radiusOf(section.hoop.size) + radiusOf(rebar.size)\\r\\n\\r\\n  // ?녶숱?? 躍?춮 ?덉そ **??*???깃컙寃⑹쑝濡??덈떎. ???諛곌렐???쒖옉 媛곷룄??\\r\\n  if (section.shape === '?녶숱') {\\r\\n    const centre = section.b / 2\\r\\n    const coverRadius = centre - insetX\\r\\n    const radius = Math.max(0, coverRadius - inward)\\r\\n    // 餓ｈ〃?띸춮???뗣겤?듿냶??-X ?담겗?밤겒??겎?곥걹?볝굮鰲믣벧??읃繹뽧겓?쇻굥??\\n    const start = Math.PI\\r\\n\\r\\n    return Array.from({ length: rebar.count }, (_, index): Point3 => {\\r\\n      const angle = start + (2 * Math.PI * index) / rebar.count\\r\\n      return [\\r\\n        centre + radius * Math.cos(angle) - insetX,\\r\\n        0,\\r\\n        centre + radius * Math.sin(angle) - insetZ,\\r\\n      ]\\r\\n    })\\r\\n  }\\r\\n\\r\\n  // ?⒴숱?? 躍?춮 ?덉そ ?ш컖???섎젅瑜??깃컙寃⑹쑝濡??덈떎. ???諛곌렐???쒖옉 紐⑥꽌由щ떎.\\r\\n  const width = Math.max(0, section.b - 2 * (insetX + inward))\\r\\n  const depth = Math.max(0, section.d - 2 * (insetZ + inward))\\r\\n  const perimeter = 2 * (width + depth)\\r\\n\\r\\n  return Array.from({ length: rebar.count }, (_, index): Point3 => {\\r\\n    const walked = (index * perimeter) / rebar.count\\r\\n\\r\\n    if (walked <= width) return [inward + walked, 0, inward]\\r\\n    if (walked <= width + depth) {\\r\\n      return [inward + width, 0, inward + walked - width]\\r\\n    }\\r\\n    if (walked <= 2 * width + depth) {\\r\\n      return [inward + width - (walked - width - depth), 0, inward + depth]\\r\\n    }\\r\\n    return [inward, 0, inward + depth - (walked - 2 * width - depth)]\\r\\n  })\\r\\n}\\r\\n\\r\\n/** 訝사춮 1餘듐겗?졾돯?듽귡싥걮嶺뗣겏?ャ긿?덀궕?뺟춮?뚦릪?섉??믣늽?묈릦?녴?*/\\r\\nfunction girderMainRowOf(\\r\\n  role: RebarRole,\\r\\n  section: GirderSection,\\r\\n): { row: GirderMainRow; upper: boolean; cutoff: boolean } {\\r\\n  switch (role) {\\r\\n    case '訝딁ク嶺?:\\r\\n      return { row: section.main.top, upper: true, cutoff: false }\\r\\n    case '訝딁ク?ャ긿?덀궕?뺟춮':\\r\\n      return { row: section.main.top, upper: true, cutoff: true }\\r\\n    case '訝뗧ク嶺?:\\r\\n      return { row: section.main.bottom, upper: false, cutoff: false }\\r\\n    case '訝뗧ク?ャ긿?덀궕?뺟춮':\\r\\n      return { row: section.main.bottom, upper: false, cutoff: true }\\r\\n    default:\\r\\n      throw new Error(`Unsupported 鸚㎪쥈 main role: ${role}`)\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction girderMainPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: GirderSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  const { row, upper, cutoff } = girderMainRowOf(rebar.role, section)\\r\\n  const decomposition = decomposeGirderMainRow(row)\\r\\n  // 餘듐겗渶뤸쑍?겹겘冶뗧ク?삡릎鸚?꺕永귞ク???鸚㎩ㅳ걽?귡싥걮嶺뗣걣?뗥뎺??옞?믣룚?듽?\\n  // nesting ?녻㎗?㎪군?얇겂?잌릢?ャ긿?덀궕?뺟춮?뚧츐?듽겗?졼굮?뽧굥 ??烏뚣걫?ⓦ겓?ⓨ퉭??\\n  // 佯껁걩?뗣겏?뚣걯?졼겓雅뚪뇥?ユ룒?뗣굦?뗣?\\n  const slots = Math.max(\\r\\n    row.startCount ?? row.endCount,\\r\\n    row.centerCount,\\r\\n    row.endCount,\\r\\n  )\\r\\n  const [, , insetZ] = rebar.points[0]\\r\\n  const inward = 2 * radiusOf(section.stirrup.size) + radiusOf(rebar.size)\\r\\n  const width = Math.max(0, section.b - 2 * (insetZ + inward))\\r\\n  const y = upper ? -inward : inward\\r\\n  // ?곈뇧??count ????뗦??귙걼?딀쑍??횞 鵝띸쉰?겹띲겒??겎?곫옞??빊??퐤營?겎?꿔굥??\\n  const offsets = rebar.axisOffsetsMm ?? [0]\\r\\n  const perPlacement = rebar.count / offsets.length\\r\\n  const firstSlot = cutoff\\r\\n    ? rebar.axisSlotStart ?? decomposition.throughCount\\r\\n    : 0\\r\\n\\r\\n  return offsets.flatMap((offsetMm) =>\\r\\n    Array.from({ length: perPlacement }, (_, index): Point3 => {\\r\\n      const slot = firstSlot + index\\r\\n      const z =\\r\\n        slots === 1\\r\\n          ? inward + width / 2\\r\\n          : inward + (slot * width) / (slots - 1)\\r\\n\\r\\n      return [offsetMm, y, z]\\r\\n    }),\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * 躍?춮 ?꾧컻???꾨찓??`stirrupPositions`媛 ?좎씪??異쒖쿂?? index횞pitch濡??섑??댄븯硫?\\n * ?끾퀡???쇱튂濡??섎늻?대뼥?댁?吏 ?딆쓣 ??留덉?留??ъ씠 ?끾퀡 諛뽰뿉 洹몃젮吏꾨떎.\\r\\n */\\r\\nfunction columnHoopPlacements(rebar: Rebar): Point3[] {\\r\\n  if (rebar.placement?.axis !== 'y') {\\r\\n    throw new Error(`躍?춮 y-axis placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = stirrupPositions(\\r\\n    rebar.placement.clearMm,\\r\\n    rebar.placement.pitchMm,\\r\\n    rebar.placement.startOffsetMm,\\r\\n  ).positionsMm\\r\\n\\r\\n  // ?議??곷???`count`(?곈뇧令띸츞?뷸틬??鼇?쮫?ф빊)媛 ?꾨땲??`positionCount`????\\n  // ?섏? ?뺣떦?섍쾶 ?ㅻⅤ??(ADR-019). ?꾨찓?몄씠 諛곗튂 ?몄옄? ?ㅻⅨ 媛쒖닔瑜??ㅼ뿀???뚮쭔 ?≫엺??\\r\\n  if (positions.length !== rebar.placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `躍?춮 placement count mismatch: ${positions.length} !== ` +\\r\\n        `${rebar.placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return positions.map((y): Point3 => [0, y, 0])\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?끾퀡 諛⑺뼢?쇰줈 ?섑??대릺??鸚㎪쥈 泥좉렐(?귙겙?됬춮쨌亮끾??곭춮)???꾧컻. ?꾨찓??\\n * `stirrupPositions`媛 ?좎씪??異쒖쿂??寃껋? ??躍?춮怨?媛숇떎.\\r\\n */\\r\\nfunction girderRepeatedPlacements(rebar: Rebar): Point3[] {\\r\\n  if (rebar.placement?.axis !== 'x') {\\r\\n    throw new Error(`${rebar.role} x-axis placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = stirrupPositions(\\r\\n    rebar.placement.clearMm,\\r\\n    rebar.placement.pitchMm,\\r\\n    rebar.placement.startOffsetMm,\\r\\n  ).positionsMm\\r\\n\\r\\n  if (positions.length !== rebar.placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `${rebar.role} placement count mismatch: ${positions.length} !== ` +\\r\\n        `${rebar.placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return positions.map((x): Point3 => [x, 0, 0])\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?밭춮? 醫뚯슦 ???닻씊???섎돇??遺숇뒗?? 餘득빊 竊??덃쑍??첨 2???닿퀬, ??섎㈃ 留덉?留?\\n * ??蹂몄씠 ?쒖そ 硫댁뿉留??⑤뒗?? 餘듭쓽 ?믪씠??訝딁ク嶺떷룝툔塋?춮 ?ъ씠瑜?洹좊벑 遺꾪븷??媛믪씠??\\n * ??誤뤸틬?ㅺ? ?꾨땲???묐룄 洹쒖튃?대ŉ, ?곈뇧? ??諛곗튂瑜??곗? ?딅뒗??(ADR-019).\\r\\n */\\r\\nfunction girderSideBarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: GirderSection,\\r\\n): Point3[] {\\r\\n  const [, midDepthMm, nearFaceZ] = rebar.points[0]\\r\\n  const farFaceZ = section.b - nearFaceZ\\r\\n  const tiers = Math.ceil(rebar.count / 2)\\r\\n\\r\\n  return Array.from({ length: rebar.count }, (_, index): Point3 => {\\r\\n    const tier = Math.floor(index / 2)\\r\\n    // 訝딁ク嶺뗣꺕訝뗧ク嶺뗣겗?뚪뼋?띲굮?뉒춬?ュ돯?뗣굏iers-1 ?㎩돯?뗣겏??앫겗餘듐걣訝뗧ク嶺뗣겗\\r\\n    // 鵝띸쉰?ャ곫?孃뚣겗餘듐걣訝딁ク嶺뗣겗鵝띸쉰?ョ쳦?ｃ겍?쀣겲?꾠?-D10 ??굠?녴겒?귙굤?듐굦??\\n    // ?ε뒟?㎬끃嶺뗣걣訝사춮??닓?ラ뇥?ゃ굥?귛뙷?볝굮 tiers+1 ?ュ돯?ｃ겍?끻겢??궧?졼걨鵝욍걝??\\n    const spanMm = section.depth - 2 * nearFaceZ\\r\\n    const y = nearFaceZ + ((tier + 1) * spanMm) / (tiers + 1) - midDepthMm\\r\\n    const z = index % 2 === 0 ? 0 : farFaceZ - nearFaceZ\\r\\n\\r\\n    return [0, y, z]\\r\\n  })\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鶯곭춮???쒖떆 諛섍꼍. `rebarRadius`??蹂댁씠?쇨퀬 ?ㅼ젣 吏由꾩쓣 怨쇱옣?섎?濡? ?뉗? 踰쎌뿉?쒕뒗\\r\\n * 潁?춮쨌與ょ춮 2寃뱀씠 鶯곩럻???ㅼ뼱媛吏 ?딅뒗????踰?諛뽰쑝濡??먯졇?섏삤??痢듬겮由??뚭퀬?ㅻ뱺\\r\\n * ??以??섎굹媛 ?쒕떎. ?ㅼ뼱媛???ш린源뚯? ?쇰쪧濡?以꾩씤??\\r\\n */\\r\\nfunction wallDisplayRadius(\\r\\n  size: ShearBarSize,\\r\\n  section: WallSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): number {\\r\\n  const pair =\\r\\n    radiusOf(section.vertical.size) + radiusOf(section.horizontal.size)\\r\\n  // ??뽧꺂? ??硫대떦 潁?춮竊뗦Ø嶺뗭씠??鶯곩럻??1/4, ?룔꺍?겹꺂? 1議곕퓧?대씪 1/2???대뒗??\\r\\n  const limit = section.thickness / (section.layers === 1 ? 2 : 4)\\r\\n\\r\\n  return radiusOf(size) * (pair > limit ? limit / pair : 1)\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鶯곩럻 諛⑺뼢?쇰줈 洹?壤밧돯???쒕뒗 硫?(mm). ?꾨찓??`points`??潁?춮??與ょ춮???뗣겤?딅㈃??\\n * ?먯?留??깆쓽 訝사춮쨌躍?춮怨?媛숇떎), 洹몃?濡?洹몃━硫?援먯감?먮쭏???쒕줈瑜?愿?듯븳?? ?깆?\\r\\n * 媛숈? ?쎌냽?쇰줈 烏①ㅊ 諛섍꼍留뚰겮 ?덉そ?쇰줈 諛??潁?춮??諛붽묑硫댁씠 ?뗣겤?딅㈃?? 與ょ춮??\\n * 洹??덉そ硫댁뿉 ?묓븯寃??쒕떎.\\r\\n *\\r\\n * 潁?춮???뗣겤?딅㈃ 履쎌뿉 ?먮뒗 ?곗뿉 洹쇨굅???녿떎 ??**???먮Ц ?대뵒?먮룄 ?뺥븿???녿떎.**\\r\\n * 與숁틬餓뺞쭣??5塋좎뿉???뚨를嶺뗣띉룔뚧Ø嶺뗣띿씠?쇰뒗 留??먯껜媛 ?녾퀬(?섏삤??寃껋? 永꾤찉藥δ틟\\r\\n * ?μ씠??, ?곈뇧令띸츞?뷸틬 2竊덌폊竊됧즯???끻쨼瑜?留먰븯吏 ?딅뒗?? ?곈뇧?먮뒗 ?곹뼢???놁쑝誘濡?\\n * (ADR-019) ?꾨㈃???붾뱾由ъ? ?딄쾶 鵝쒎쎋誤뤷뎴?쇰줈 怨좎젙?쒕떎 ???밭춮??餘드돯?딆? 媛숇떎.\\r\\n */\\r\\nfunction wallBarDepths(\\r\\n  role: RebarRole,\\r\\n  section: WallSection,\\r\\n  coverZ: number,\\r\\n  radiusOf: RadiusOf,\\r\\n): number[] {\\r\\n  const verticalRadius = wallDisplayRadius(\\r\\n    section.vertical.size,\\r\\n    section,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const horizontalRadius = wallDisplayRadius(\\r\\n    section.horizontal.size,\\r\\n    section,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const atFace = role === '潁?춮'\\r\\n\\r\\n  if (section.layers === 1) {\\r\\n    // ?룔꺍?겹꺂? ?뗣겤?딅㈃???꾨땲??鶯곩럻 以묒븰???ъ씠???먭퀬 ?깆쓣 留욌똾??\\r\\n    return [\\r\\n      section.thickness / 2 + (atFace ? -horizontalRadius : verticalRadius),\\r\\n    ]\\r\\n  }\\r\\n\\r\\n  // 烏①ㅊ 諛섍꼍留뚰겮 ?먭볼?뚯쭊 2痢듭씠 以묒븰?먯꽌 寃뱀튂吏 ?딅룄濡??뗣겤?딅? 二덈떎.\\r\\n  const cover = Math.min(\\r\\n    coverZ,\\r\\n    section.thickness / 2 - 2 * (verticalRadius + horizontalRadius),\\r\\n  )\\r\\n  const near =\\r\\n    cover + (atFace ? verticalRadius : 2 * verticalRadius + horizontalRadius)\\r\\n\\r\\n  return [near, section.thickness - near]\\r\\n}\\r\\n\\r\\n/**\\r\\n * 濚겹굤瓦붵걮?띸쉰??퐤營?(mm)?귙겣?졼굯??뼪?㏘?誤㎯겗?앮쐿?ゃ깢?삠긿?덀걢??`stirrupPositions`\\r\\n * ?뚥퐳?뗣걣?곲뼀?ｉ깿??걗?뗥즯?삣틞?욍겎??깋?▲궎?녈걣鵝띸쉰?앫겗?귙겗?믤륫?쀣겍?뤵굥 ??\\n * 轝좈솮???ㅳ겗壤밧돯?뚩쨭?겹겗?낁㉢烏뚣겓?녴걢?뚣굥??겎?곮죱?붵겏?ャ뚣겑??퐤營?겗?с걢?띲굮\\r\\n * 黎뷩굙?╉걡?뗣겒?꾠겏?뚣걯?닸??멧틠佯?룒?뤵걪?ⓦ겓?ゃ굥 (ADR-029)??\\n */\\r\\nfunction repeatPositions(placement: RebarPlacement): number[] {\\r\\n  return (\\r\\n    placement.positionsMm ??\\r\\n    stirrupPositions(\\r\\n      placement.clearMm,\\r\\n      placement.pitchMm,\\r\\n      placement.startOffsetMm,\\r\\n    ).positionsMm\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?먬쐡鶯곸쓽 潁?춮쨌與ょ춮 ?꾧컻. ?섑???異뺤? ?꾨찓??`placement`媛, 鶯곩럻 諛⑺뼢?\\r\\n * `wallBarDepths`媛 以?????쒖떆遺媛 ?뗣겤?딅? ?ㅼ떆 議고쉶?섎㈃ 猷고뙥 議고쉶媛 ??怨녹뿉\\r\\n * 諛뺥엳誘濡? ??쒖젏??z(竊앫걢?뜰굤硫?留?諛쏆븘??嫄곌린???좊룄?쒕떎.\\r\\n */\\r\\nfunction wallRebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: WallSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  const placement = rebar.placement\\r\\n  if (!placement) {\\r\\n    throw new Error(`${rebar.role} placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = repeatPositions(placement)\\r\\n\\r\\n  if (positions.length !== placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `${rebar.role} placement count mismatch: ${positions.length} !== ` +\\r\\n        `${placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const coverZ = rebar.points[0][2]\\r\\n\\r\\n  return wallBarDepths(rebar.role, section, coverZ, radiusOf).flatMap((z) =>\\r\\n    positions.map((value): Point3 =>\\r\\n      placement.axis === 'x'\\r\\n        ? [value, 0, z - coverZ]\\r\\n        : [0, value, z - coverZ],\\r\\n    ),\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?볝겗?꾤춮??걢?뜰굤?㏂겗遙섅걬 (mm)?귝뒛?뚧쎊?뚣겂?잋툓塋?춮??툔?멱맼?▲굥?밤굚?곥겇??겎??\\n * ?당퇉?⑨펷??귡쳵?꾤궧竊됥겎餓ｈ〃?뺛걵?뗣귚툔塋?춮??뒛?뚣겒?꾠겗?㎩뀲?밤걣?뚣걯遙섅걬?㎯걗?뗣?\\n */\\r\\nfunction slabCoverZ(rebar: Rebar): number {\\r\\n  return Math.max(...rebar.points.map(([, , z]) => z))\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮嶺뗣겗烏①ㅊ?듿푶??rebarRadius` ??쫳?쎼굥?잆굙?ュ츪?쎼겗孃꾠굮沃뉐섧?쇻굥??겎?곫씮??\\n * 200?삠걢?뜰굤 30 ??솹?싥겗?밤꺀?뽧겎??2?밧릲횞2?㏂겗4掠ㅳ걣?γ굢?ゃ걚 ???욍겗鸚뽧겦\\r\\n * 囹곥걤?뷩걲?뗥광?⒲걝?쀣걣繇잆걚渦쇈??귛뀯?뗥ㄷ?띲걬?얇겎訝孃뗣겓潁?굙?뗰펷鶯곥겗\\r\\n * `wallDisplayRadius` ?ⓨ릪?섉돮?꾬펹??\\n *\\r\\n * ?뗣겤?듽겗?끻겢?ユ츐??`?싥걬 ???뗣겤?듑?` ??掠ㅳ겎?녴걨?뗣겗?㎯곭를與?永꾠겗?듿푶??뭽??\\n * ?앫겗1/4?ュ룑?얇굦?겹굠?꾠?\\n */\\r\\nfunction slabDisplayRadius(\\r\\n  size: ShearBarSize,\\r\\n  section: SlabSection,\\r\\n  coverMm: number,\\r\\n  radiusOf: RadiusOf,\\r\\n): number {\\r\\n  const pair =\\r\\n    radiusOf(slabRowFor(section, 'X', '訝뗧ク').size) +\\r\\n    radiusOf(slabRowFor(section, 'Y', '訝뗧ク').size)\\r\\n  const limit = Math.max(0, (section.thickness - 2 * coverMm) / 4)\\r\\n\\r\\n  return radiusOf(size) * (pair > limit ? limit / pair : 1)\\r\\n}\\r\\n\\r\\n/** ?뗣겤?딃씊?뗣굢歷с겂?잆걢?뜰굤?싥걬 ??訝딁ク嶺뗣겘?욍겗訝듽걢?됪릍?뗣?*/\\r\\nfunction slabCoverMm(coverZ: number, section: SlabSection): number {\\r\\n  return Math.min(coverZ, section.thickness - coverZ)\\r\\n}\\r\\n\\r\\nfunction slabRowFor(\\r\\n  section: SlabSection,\\r\\n  axis: 'X' | 'Y',\\r\\n  face: '訝딁ク' | '訝뗧ク',\\r\\n): SlabBarRow {\\r\\n  return (axis === 'X' ? section.x : section.y)[\\r\\n    face === '訝딁ク' ? 'top' : 'bottom'\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction slabRoleParts(role: RebarRole): {\\r\\n  axis: 'X' | 'Y'\\r\\n  face: '訝딁ク' | '訝뗧ク'\\r\\n} {\\r\\n  switch (role) {\\r\\n    case 'X?밧릲訝딁ク嶺?:\\r\\n      return { axis: 'X', face: '訝딁ク' }\\r\\n    case 'X?밧릲訝뗧ク嶺?:\\r\\n      return { axis: 'X', face: '訝뗧ク' }\\r\\n    case 'Y?밧릲訝딁ク嶺?:\\r\\n      return { axis: 'Y', face: '訝딁ク' }\\r\\n    case 'Y?밧릲訝뗧ク嶺?:\\r\\n      return { axis: 'Y', face: '訝뗧ク' }\\r\\n    default:\\r\\n      throw new Error(`Unsupported 佯딀씮 role: ${role}`)\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮嶺뗣걣?욕럻??겑?볝겓塋뗣겇??(mm)?귙깋?▲궎?녈겗 `points` ??툓塋?춮?귚툔塋?춮??\\n * ?뗣겤?딃씊?ョ쉰?륅펷?긱겗訝사춮?삣릭嶺뗣겏?뚣걯竊됥걣?곥걹??겲?얏룒?뤵겏雅ㅷ궧?붵겏??2?밧릲??\\n * 雅믡걚?믦껀?싥걲?뗣귟〃鹽뷴뜇孃꾠겗?뜰굯?졼걨?끻겢?멩듉?쀣갲?밧릲??쨼?㏂걣?뗣겤?딃씊?ャ?\\n * Y?밧릲?뚣걹??냵?닻씊?ユ렏?쇻굥?덀걝?ャ걲?뗣?\\n *\\r\\n * X?밧릲?믡걢?뜰굤?℡겢?ョ쉰?뤵걪?ⓦ겓?방떊??겒????**訝▼렅?뉎겗?⒲걪?ャ굚若싥굙?뚣겒?꾠?*\\r\\n * ?곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞????뼶?묆굮?뷴닪?쎼걳?뚥말嶺뗣띲겏?쇈겤?졼걨?㎯곫쮽繹뽨퍞礪섉쎑5塋?\\n * ?ャ굚訝듾툔??뇥?ゃ굤?녴겗鼇섋염??겒?꾠귝빊?뤵겓??쉽?욍걮?ゃ걚??겎 (ADR-019)?곩쎋?㏂걣\\r\\n * ?뷩굦?ゃ걚?덀걝?ヤ퐳?녘쫸?뉎겏?쀣겍?뷴츣?쇻굥 ??鶯곥겗潁?춮?삥Ø嶺뗣겏?뚣걯?ㅶ뼪?㎯걗?뗣?\\n */\\r\\nfunction slabBarDepthMm(\\r\\n  role: RebarRole,\\r\\n  section: SlabSection,\\r\\n  coverZ: number,\\r\\n  radiusOf: RadiusOf,\\r\\n): number {\\r\\n  const { axis, face } = slabRoleParts(role)\\r\\n  const coverMm = slabCoverMm(coverZ, section)\\r\\n  const outer = slabDisplayRadius(\\r\\n    slabRowFor(section, 'X', face).size,\\r\\n    section,\\r\\n    coverMm,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const inner = slabDisplayRadius(\\r\\n    slabRowFor(section, 'Y', face).size,\\r\\n    section,\\r\\n    coverMm,\\r\\n    radiusOf,\\r\\n  )\\r\\n  const depth = axis === 'X' ? outer : 2 * outer + inner\\r\\n\\r\\n  return face === '訝딁ク' ? coverZ - depth : coverZ + depth\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮嶺뗣겗掠뺡뼀?귡씊?끹겗濚겹굤瓦붵걮邕멥겘?됥깳?ㅳ꺍??`placement` ?뚣곫씮?싨뼶?묆겘\\r\\n * `slabBarDepthMm` ?뚥툗?덀굥?괱?밧릲??뎱嶺뗣겘掠? x ?ヤ섯?녈겍 y ?멥갳?밧릲??\\n * ?앫겗?녴겓訝╉겤??\\n */\\r\\nfunction slabRebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: SlabSection,\\r\\n  radiusOf: RadiusOf,\\r\\n): Point3[] {\\r\\n  const placement = rebar.placement\\r\\n  if (!placement) {\\r\\n    throw new Error(`${rebar.role} placement is missing: ${rebar.id}`)\\r\\n  }\\r\\n\\r\\n  const positions = repeatPositions(placement)\\r\\n\\r\\n  if (positions.length !== placement.positionCount) {\\r\\n    throw new Error(\\r\\n      `${rebar.role} placement count mismatch: ${positions.length} !== ` +\\r\\n        `${placement.positionCount}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const coverZ = slabCoverZ(rebar)\\r\\n  const shiftZ = slabBarDepthMm(rebar.role, section, coverZ, radiusOf) - coverZ\\r\\n\\r\\n  return positions.map((value): Point3 =>\\r\\n    placement.axis === 'x' ? [value, 0, shiftZ] : [0, value, shiftZ],\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function rebarPlacements(\\r\\n  rebar: Rebar,\\r\\n  section: Section,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n): Point3[] {\\r\\n  if (section.kind === '??) {\\r\\n    return columnRebarPlacements(rebar, section, radiusOf)\\r\\n  }\\r\\n  if (section.kind === '?먬쐡鶯?) {\\r\\n    return wallRebarPlacements(rebar, section, radiusOf)\\r\\n  }\\r\\n  if (section.kind === '佯딀씮') {\\r\\n    return slabRebarPlacements(rebar, section, radiusOf)\\r\\n  }\\r\\n  if (rebar.role === '?귙겙?됬춮' || rebar.role === '亮끾??곭춮') {\\r\\n    return girderRepeatedPlacements(rebar)\\r\\n  }\\r\\n  if (rebar.role === '?밭춮') {\\r\\n    return girderSideBarPlacements(rebar, section)\\r\\n  }\\r\\n\\r\\n  return girderMainPlacements(rebar, section, radiusOf)\\r\\n}\\r\\n\\r\\nfunction insetCoordinate(\\r\\n  value: number,\\r\\n  minimum: number,\\r\\n  maximum: number,\\r\\n  radius: number,\\r\\n): number {\\r\\n  const inset = Math.min(radius, (maximum - minimum) / 2)\\r\\n  return Math.min(Math.max(value, minimum + inset), maximum - inset)\\r\\n}\\r\\n\\r\\n// hoop 以묒떖?좎쓣 ?뗣겤?딅㈃?먯꽌 ?쒖떆 諛섍꼍留뚰겮 ?덉そ?쇰줈 ?ｋ뒗?? ?됰㈃? 遺??kind濡?\\n// 紐낆떆?곸쑝濡?怨좊Ⅸ?? ?깅뒗 X?밵, 鸚㎪쥈? Y?밵. 醫뚰몴 蹂?붾줈 ?됰㈃??異붾줎?섏? ?딅뒗??\\r\\nfunction hoopDisplayPoint(\\r\\n  point: Point3,\\r\\n  framePoints: Point3[],\\r\\n  radius: number,\\r\\n  section: Section,\\r\\n): Point3 {\\r\\n  if (section.kind === '?? && section.shape === '?녶숱') {\\r\\n    // ?녴겘渦뷩걫?ⓦ겓屋겹굙?됥굦?ゃ걚 ??訝?퓘?뗣굢??퇌?㏂굮烏①ㅊ?듿푶?졼걨潁?굙?뗣?\\n    const centre = section.b / 2\\r\\n    const [x, y, z] = point\\r\\n    const distance = Math.hypot(x - centre, z - centre)\\r\\n    if (distance === 0) return point\\r\\n    const scale = Math.max(0, distance - radius) / distance\\r\\n\\r\\n    return [centre + (x - centre) * scale, y, centre + (z - centre) * scale]\\r\\n  }\\r\\n\\r\\n  if (section.kind === '??) {\\r\\n    const xs = framePoints.map((candidate) => candidate[0])\\r\\n    const zs = framePoints.map((candidate) => candidate[2])\\r\\n    const minX = Math.min(...xs)\\r\\n    const maxX = Math.max(...xs)\\r\\n    const minZ = Math.min(...zs)\\r\\n    const maxZ = Math.max(...zs)\\r\\n\\r\\n    return [\\r\\n      insetCoordinate(point[0], minX, maxX, radius),\\r\\n      point[1],\\r\\n      insetCoordinate(point[2], minZ, maxZ, radius),\\r\\n    ]\\r\\n  }\\r\\n\\r\\n  const ys = framePoints.map((candidate) => candidate[1])\\r\\n  const zs = framePoints.map((candidate) => candidate[2])\\r\\n  const minY = Math.min(...ys)\\r\\n  const maxY = Math.max(...ys)\\r\\n  const minZ = Math.min(...zs)\\r\\n  const maxZ = Math.max(...zs)\\r\\n\\r\\n  return [\\r\\n    point[0],\\r\\n    insetCoordinate(point[1], minY, maxY, radius),\\r\\n    insetCoordinate(point[2], minZ, maxZ, radius),\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction translate(point: Point3, offset: Point3): Point3 {\\r\\n  return [point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]]\\r\\n}\\r\\n\\r\\ninterface PathSegment {\\r\\n  from: Point3\\r\\n  to: Point3\\r\\n  /** 135째?뺛긿??퐰????烏①ㅊ?㎯겘 clamp ?쎼걳?곩쭓?밤겗 inset ?뜰굯??뭄烏뚨㎉?뺛겎?뤵걦 */\\r\\n  hookTail?: boolean\\r\\n}\\r\\n\\r\\ninterface PathRun {\\r\\n  zone: RebarZone['kind'] | null\\r\\n  segments: PathSegment[]\\r\\n}\\r\\n\\r\\ninterface SegmentRun {\\r\\n  zone: RebarZone['kind'] | null\\r\\n  segments: Segment[]\\r\\n}\\r\\n\\r\\nfunction pointDistance(from: Point3, to: Point3): number {\\r\\n  return Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2])\\r\\n}\\r\\n\\r\\nfunction interpolate(from: Point3, to: Point3, ratio: number): Point3 {\\r\\n  return [\\r\\n    from[0] + (to[0] - from[0]) * ratio,\\r\\n    from[1] + (to[1] - from[1]) * ratio,\\r\\n    from[2] + (to[2] - from[2]) * ratio,\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction zoneAt(\\r\\n  zones: RebarZone[],\\r\\n  pathDistanceMm: number,\\r\\n): RebarZone['kind'] | null {\\r\\n  return (\\r\\n    zones.find(\\r\\n      ({ pathFromMm, pathToMm }) =>\\r\\n        pathDistanceMm >= pathFromMm && pathDistanceMm <= pathToMm,\\r\\n    )?.kind ?? null\\r\\n  )\\r\\n}\\r\\n\\r\\n/** ?꾩쟻 domain 寃쎈줈嫄곕━?먯꽌 癒쇱? ?먮Ⅸ?? ?쒖떆 ?몄뀑쨌諛곗튂????寃곌낵?먮쭔 ?곸슜?쒕떎. */\\r\\nfunction pathRuns(rebar: Rebar): PathRun[] {\\r\\n  const edges: PathSegment[] = rebar.points.slice(1).map((to, index) => ({\\r\\n    from: rebar.points[index],\\r\\n    to,\\r\\n  }))\\r\\n\\r\\n  if (rebar.closed && rebar.points.length > 1) {\\r\\n    edges.push({\\r\\n      from: rebar.points[rebar.points.length - 1],\\r\\n      to: rebar.points[0],\\r\\n    })\\r\\n  }\\r\\n\\r\\n  if (rebar.hookTails !== undefined && rebar.points.length > 0) {\\r\\n    for (const tail of rebar.hookTails) {\\r\\n      edges.push({ from: rebar.points[0], to: tail, hookTail: true })\\r\\n    }\\r\\n  }\\r\\n\\r\\n  const zones = rebar.zones ?? []\\r\\n  const boundaries = zones.flatMap(({ pathFromMm, pathToMm }) => [\\r\\n    pathFromMm,\\r\\n    pathToMm,\\r\\n  ])\\r\\n  const runs: PathRun[] = []\\r\\n  let walked = 0\\r\\n\\r\\n  for (const edge of edges) {\\r\\n    const length = pointDistance(edge.from, edge.to)\\r\\n    if (length === 0) continue\\r\\n\\r\\n    const edgeEnd = walked + length\\r\\n    const cuts = [\\r\\n      walked,\\r\\n      ...boundaries.filter(\\r\\n        (boundary) => boundary > walked && boundary < edgeEnd,\\r\\n      ),\\r\\n      edgeEnd,\\r\\n    ].sort((left, right) => left - right)\\r\\n\\r\\n    for (let index = 1; index < cuts.length; index += 1) {\\r\\n      const pathFrom = cuts[index - 1]\\r\\n      const pathTo = cuts[index]\\r\\n      if (pathTo <= pathFrom) continue\\r\\n\\r\\n      const segment: PathSegment = {\\r\\n        from: interpolate(edge.from, edge.to, (pathFrom - walked) / length),\\r\\n        to: interpolate(edge.from, edge.to, (pathTo - walked) / length),\\r\\n      }\\r\\n      if (edge.hookTail) segment.hookTail = true\\r\\n      const zone = zoneAt(zones, (pathFrom + pathTo) / 2)\\r\\n      const current = runs[runs.length - 1]\\r\\n\\r\\n      if (current?.zone === zone) current.segments.push(segment)\\r\\n      else runs.push({ zone, segments: [segment] })\\r\\n    }\\r\\n\\r\\n    walked = edgeEnd\\r\\n  }\\r\\n\\r\\n  return runs\\r\\n}\\r\\n\\r\\nexport interface AxisAlignedBox {\\r\\n  center: Point3\\r\\n  size: Point3\\r\\n}\\r\\n\\r\\n/** 嶸긱겗2邕멥겓?쇻걮?잓뼀?ｉ깿??윪壤㏂귟뻗???恙쒌겘?쇈겤?담걣黎뷩굙?뗰펷?ⓩ쓲?붵겏?ラ걬?놅펹 */\\r\\nexport interface BoxHole {\\r\\n  minA: number\\r\\n  maxA: number\\r\\n  minB: number\\r\\n  maxB: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뗥룭?ⓦ겎?녈꺍??꺁?쇈깉????믡걦?딀뒠??(?곈뇧令띸츞?뷸틬 1?싧뎴8))??\\n *\\r\\n * ?뗥룭??깿?먦겗?싥걬?믦껀?뤵겗?㎯곮쫳?뗣겗??`axes` ?뚧뙁??邕멥걽?묆걽???ㅳ겗?뗥룭?????\\n * ?鸚??ㅳ겓?꿔굥竊덃뎸?띲꺕也γ꺕訝뗣꺕訝딉펹?귟쨭?겹걗?뚣겙?꿔겂?잏??믡걬?됥겓?꿔굥 ???쀩빓??\\n * ?녶돯?뚦눣?뗣걪?ⓦ겘?귙굥?뚣곲뇥?ゃ겂?잓뼀?ｃ겎?귝쵟?묆걣閭ｃ걮?뤸츐?뗣?\\n *\\r\\n * ?뤵굤?쒌걤??〃鹽뷩걽?묆겗屋긱겎?귙굥?귝빊?뤵겗轝좈솮??`openingDeduction` ?뚪뎱嶺뗣겓?ㅳ걚??\\n * ?겹걟?뗣굚??겎?곥궠?녈궚?ゃ꺖?덀꺕?뗦옞??빊?뤵겘?앫굚?앫굚獒썲뱚?뚦눣?뺛겒??(ADR-005)??\\n */\\r\\nexport function carveBox<T extends AxisAlignedBox>(\\r\\n  box: T,\\r\\n  axes: [number, number],\\r\\n  holes: BoxHole[],\\r\\n): T[] {\\r\\n  return holes.reduce<T[]>(\\r\\n    (boxes, hole) => boxes.flatMap((one) => carveOne(one, axes, hole)),\\r\\n    [box],\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction carveOne<T extends AxisAlignedBox>(\\r\\n  box: T,\\r\\n  [axisA, axisB]: [number, number],\\r\\n  hole: BoxHole,\\r\\n): T[] {\\r\\n  const minA = box.center[axisA] - box.size[axisA] / 2\\r\\n  const maxA = box.center[axisA] + box.size[axisA] / 2\\r\\n  const minB = box.center[axisB] - box.size[axisB] / 2\\r\\n  const maxB = box.center[axisB] + box.size[axisB] / 2\\r\\n\\r\\n  const cutMinA = Math.max(minA, hole.minA)\\r\\n  const cutMaxA = Math.min(maxA, hole.maxA)\\r\\n  const cutMinB = Math.max(minB, hole.minB)\\r\\n  const cutMaxB = Math.min(maxB, hole.maxB)\\r\\n\\r\\n  if (cutMinA >= cutMaxA || cutMinB >= cutMaxB) return [box]\\r\\n\\r\\n  const piece = (\\r\\n    fromA: number,\\r\\n    toA: number,\\r\\n    fromB: number,\\r\\n    toB: number,\\r\\n  ): T => {\\r\\n    const center = [...box.center] as Point3\\r\\n    const size = [...box.size] as Point3\\r\\n    center[axisA] = (fromA + toA) / 2\\r\\n    size[axisA] = toA - fromA\\r\\n    center[axisB] = (fromB + toB) / 2\\r\\n    size[axisB] = toB - fromB\\r\\n    return { ...box, center, size }\\r\\n  }\\r\\n\\r\\n  const pieces: T[] = []\\r\\n  if (minA < cutMinA) pieces.push(piece(minA, cutMinA, minB, maxB))\\r\\n  if (cutMaxA < maxA) pieces.push(piece(cutMaxA, maxA, minB, maxB))\\r\\n  if (minB < cutMinB) pieces.push(piece(cutMinA, cutMaxA, minB, cutMinB))\\r\\n  if (cutMaxB < maxB) pieces.push(piece(cutMinA, cutMaxA, cutMaxB, maxB))\\r\\n\\r\\n  return pieces\\r\\n}\\r\\n\\r\\n/** ?ⓩ쓲掠???뼀?ｃ굮?곭???邕멥겓?듽걨?뗧독野얍벨與쇻겗?⒴숱?ュ넍?쇻?*/\\r\\nexport function boxHoles(\\r\\n  openings: Opening[],\\r\\n  originA: number,\\r\\n  originB: number,\\r\\n): BoxHole[] {\\r\\n  return openings.map((opening) => ({\\r\\n    minA: originA + opening.xMm,\\r\\n    maxA: originA + opening.xMm + opening.widthMm,\\r\\n    minB: originB + opening.yMm,\\r\\n    maxB: originB + opening.yMm + opening.heightMm,\\r\\n  }))\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뗥룭?ⓦ걣?꾤춮?믤뼪?ㅵ뙷??(?곈뇧令띸츞?뷸틬 1?싧뎴8))??\\n *\\r\\n * ?뗥룭??깿?먦겗?싥걬?믦껀?뤵겗?㎯곩닩若싥겘掠? x?퍈 ??邕멥걽?묆겎擁녈굤?뗣귛쥊?뚣겓?▲굟?녴겑\\r\\n * 雍됥굥?꾤춮??뼪?잆겒?????곈뇧?담겗轝좈솮?ㅵ츣?ⓨ릪?섊큵?잆겎?곲뼀?ｃ겗鸚뽧겗?꾤춮?믤쵟?뗣걵?ゃ걚\\r\\n * ?잆굙?㎯걗??(`openingDeduction`)??\\n *\\r\\n * ?곈뇧?뚣뚥퐬?с걣鵝븁m轝졼걨?뗣걢?띲굮鼇?녴겗?ュ??쀣곥걪?볝걣黎뷩굙?뗣겗??뚣겑?볝겎?뉎굦??\\n * 誤뗣걟?뗣걢?띲걽?귝쵟?묆굥鵝띸쉰??쑍?붵겏?ラ걬?녴겗??`Rebar.points` ?ャ겘?γ굦?됥굦?ゃ걚 ??\\n * 餓ｈ〃1?с겗?섅굦渶싥겘?뗥룭?믥윥?됥겒?꾢뀲?룔겗永뚩러?㎯걗??(ADR-029)??\\n */\\r\\nfunction openingCut(\\r\\n  from: Point3,\\r\\n  to: Point3,\\r\\n  opening: Opening,\\r\\n): [number, number] | null {\\r\\n  let enter = 0\\r\\n  let leave = 1\\r\\n\\r\\n  for (const axis of [0, 1] as const) {\\r\\n    const minimum = axis === 0 ? opening.xMm : opening.yMm\\r\\n    const maximum =\\r\\n      minimum + (axis === 0 ? opening.widthMm : opening.heightMm)\\r\\n    const start = from[axis]\\r\\n    const delta = to[axis] - start\\r\\n\\r\\n    if (Math.abs(delta) < 1e-9) {\\r\\n      // ?볝겗邕멥겓?뺛걢?ゃ걚?꾤춮??곲뼀?ｃ겗?끻겢?ャ걚?뗣걢鸚뽧겓?꾠굥?뗣겗?⒲걾?됥걢?졼?\\n      if (start <= minimum || start >= maximum) return null\\r\\n      continue\\r\\n    }\\r\\n\\r\\n    const first = (minimum - start) / delta\\r\\n    const second = (maximum - start) / delta\\r\\n    enter = Math.max(enter, Math.min(first, second))\\r\\n    leave = Math.min(leave, Math.max(first, second))\\r\\n  }\\r\\n\\r\\n  return leave > enter ? [enter, leave] : null\\r\\n}\\r\\n\\r\\nfunction lerpPoint(from: Point3, to: Point3, t: number): Point3 {\\r\\n  return [\\r\\n    from[0] + (to[0] - from[0]) * t,\\r\\n    from[1] + (to[1] - from[1]) * t,\\r\\n    from[2] + (to[2] - from[2]) * t,\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction clipSegment(segment: Segment, openings: Opening[]): Segment[] {\\r\\n  const cuts = openings\\r\\n    .map((opening) => openingCut(segment.from, segment.to, opening))\\r\\n    .filter((cut): cut is [number, number] => cut !== null)\\r\\n    .sort(([left], [right]) => left - right)\\r\\n\\r\\n  if (cuts.length === 0) return [segment]\\r\\n\\r\\n  const pieces: Segment[] = []\\r\\n  let walked = 0\\r\\n\\r\\n  for (const [enter, leave] of cuts) {\\r\\n    if (enter > walked) {\\r\\n      pieces.push({\\n        from: lerpPoint(segment.from, segment.to, walked),\\n        to: lerpPoint(segment.from, segment.to, enter),\\n        radius: segment.radius,\\n        ...(segment.barIndex === undefined ? {} : { barIndex: segment.barIndex }),\\n        ...(segment.hookTail ? { hookTail: true } : {}),\\n      })\\r\\n    }\\r\\n    walked = Math.max(walked, leave)\\r\\n  }\\r\\n\\r\\n  if (walked < 1) {\\r\\n    pieces.push({\\n      from: lerpPoint(segment.from, segment.to, walked),\\n      to: segment.to,\\n      radius: segment.radius,\\n      ...(segment.barIndex === undefined ? {} : { barIndex: segment.barIndex }),\\n      ...(segment.hookTail ? { hookTail: true } : {}),\\n    })\\r\\n  }\\r\\n\\r\\n  // 塋?걣?뗥룭??툈?ャ걾?뉎걝?⑵펹?뗣겏?룔걬0??졃?뉎걣?뷩굥?귝룒?꾠겍?귟쫳?덀겒?꾠걝?덀?\\n  // three.js ??냶?긱궦?ゃ깳?덀꺁?뚦릲?띲굮黎뷩굙?됥굦?ゃ걚??\\n  return pieces.filter(\\r\\n    ({ from, to }) =>\\r\\n      Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2]) > 1e-6,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function clipSegments(\\r\\n  segments: Segment[],\\r\\n  openings: Opening[],\\r\\n): Segment[] {\\r\\n  if (openings.length === 0) return segments\\r\\n  return segments.flatMap((segment) => clipSegment(segment, openings))\\r\\n}\\r\\n\\r\\nfunction rebarSegmentRuns(\\r\\n  rebar: Rebar,\\r\\n  section: Section,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n  openings: Opening[] = [],\\r\\n): SegmentRun[] {\\r\\n  if (roleToLayer(rebar.role) === 'hidden') return []\\r\\n\\r\\n  // 鶯곥겏佯딀씮?졼걨烏①ㅊ?듿푶?뚪깿?먨럻?ョ툤?됥굦?뗣귡뀓營?겏?뤹뵽?㎩닪?끹겗?듿푶?믢슴?녴겏??\\n  // 屋겹굙?잆겘?싥겗掠ㅳ걣?뤵걦?ⓦ걤?ャ겲?잌ㄺ?ｃ겍繇잆걚渦쇈???\\n  const radius =\\r\\n    section.kind === '?먬쐡鶯?\\r\\n      ? wallDisplayRadius(rebar.size, section, radiusOf)\\r\\n      : section.kind === '佯딀씮'\\r\\n        ? slabDisplayRadius(\\r\\n            rebar.size,\\r\\n            section,\\r\\n            slabCoverMm(slabCoverZ(rebar), section),\\r\\n            radiusOf,\\r\\n          )\\r\\n        : radiusOf(rebar.size)\\r\\n  const displayPoint = (point: Point3): Point3 =>\\r\\n    rebar.shape === 'hoop'\\r\\n      ? hoopDisplayPoint(point, rebar.points, radius, section)\\r\\n      : point\\r\\n  // 135째?뺛긿??퐰?룔굮塋?궧?붵겏??clamp ?쇻굥?ⓦ곮쭜??쭓?밤걽?묈냵?담겦野꾠겂??\\n  // ?묆걤?삯빓?뺛걣若⒲굦?곮챺凉듣〃鹽뷴뜇孃꾠겗渦뷩긽?γ꺖?뽧겓?뗣굚?뚣굥?귛쭓?밤걣?쀣걨??\\n  // inset ?ⓨ릪?섇뭄烏뚨㎉?뺛굮弱얍뀲鵝볝겓?뗣걨?곩뒥藥ε숱?뜰겗?묆걤?삯빓?뺛굮岳앫겇??\\n  const hookTailPoint = (point: Point3): Point3 => {\\r\\n    const origin = rebar.points[0]\\r\\n    const displayed = displayPoint(origin)\\r\\n    return [\\r\\n      point[0] + displayed[0] - origin[0],\\r\\n      point[1] + displayed[1] - origin[1],\\r\\n      point[2] + displayed[2] - origin[2],\\r\\n    ]\\r\\n  }\\r\\n  const placements = rebarPlacements(rebar, section, radiusOf)\\r\\n\\r\\n  return pathRuns(rebar).map(({ zone, segments }) => ({\\r\\n    zone,\\r\\n    // ?뗥룭?ⓦ겘 3D ?㎯걽?묌뎱嶺뗣굮??겇?귝빊?뤵겘 `Rebar.length` ?뚦닪?ユ똻?ｃ겍?꾠굥\\r\\n    // ??겎?곥걪?볝겎?뉎겂?╉굚?ф빊?삭나?뤵겘?뺛걢?ゃ걚 (ADR-029)??\\n    segments: clipSegments(\\r\\n      placements.flatMap((offset, barIndex) =>\\n        segments.map(({ from, to, hookTail }) => ({\\n          from: translate(hookTail ? hookTailPoint(from) : displayPoint(from), offset),\\n          to: translate(hookTail ? hookTailPoint(to) : displayPoint(to), offset),\\n          radius,\\n          barIndex,\\n          ...(hookTail ? { hookTail: true } : {}),\\n        })),\\r\\n      ),\\r\\n      openings,\\r\\n    ),\\r\\n  }))\\r\\n}\\r\\n\\r\\nexport function rebarSegments(\\r\\n  rebar: Rebar,\\r\\n  section: Section,\\r\\n  radiusOf: RadiusOf = rebarRadius,\\r\\n  openings: Opening[] = [],\\r\\n): Segment[] {\\r\\n  return rebarSegmentRuns(rebar, section, radiusOf, openings).flatMap(\\r\\n    ({ segments }) => segments,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport interface RebarBatch {\\r\\n  rowId: string\\r\\n  layer: RebarLayer\\r\\n  zone: RebarZone['kind'] | null\\r\\n  segments: Segment[]\\r\\n}\\r\\n\\r\\n/**\\r\\n * 3D??媛뺤“ ?⑥쐞???댁뿭??**??*?대떎(DESIGN.md 짠3.2). zone ?됱쓣 蹂댁〈?섍린 ?꾪빐\\r\\n * ???덉뿉?쒕뒗 ?곗냽 寃쎈줈 run留덈떎 ?섎늻吏留? ?멸렇癒쇳듃留덈떎 硫붿떆瑜?留뚮뱾吏???딅뒗??\\r\\n * 媛숈? rowId瑜??좎??섎?濡??щ윭 zone 諛곗튂???섎굹???됱쑝濡??④퍡 媛뺤“?????덈떎.\\r\\n */\\r\\nfunction shiftAlongAxis(segments: Segment[], offsetMm: number): Segment[] {\\r\\n  if (offsetMm === 0) return segments\\r\\n\\r\\n  return segments.map(({ from, to, radius }) => ({\\r\\n    from: [from[0] + offsetMm, from[1], from[2]] as Point3,\\r\\n    to: [to[0] + offsetMm, to[1], to[2]] as Point3,\\r\\n    radius,\\r\\n  }))\\r\\n}\\r\\n\\r\\nexport function rebarBatches(\\r\\n  entries: {\\r\\n    rowId: string\\r\\n    rebar: Rebar\\r\\n    originOffsetMm?: number\\r\\n    /** ?볝겗?꾤춮????佯㎪쮽楹삠겓?담걮?잓뼀?ｉ깿 (1?싧뎴8))??D ?졼걨?뚣걪?뚣굮誤뗣굥 */\\r\\n    openings?: Opening[]\\r\\n  }[],\\r\\n  section: Section,\\r\\n): RebarBatch[] {\\r\\n  const batches = new Map<string, RebarBatch>()\\r\\n\\r\\n  for (const { rowId, rebar, originOffsetMm = 0, openings = [] } of entries) {\\r\\n    const layer = roleToLayer(rebar.role)\\r\\n\\r\\n    rebarSegmentRuns(rebar, section, rebarRadius, openings).forEach(\\r\\n      ({ zone, segments }, runIndex) => {\\r\\n      // 媛숈? row?????泥좉렐???щ윭 媛쒕㈃ ?숈씪 寃쎈줈 run?쇰━ ?⑹튂?? ?묐떒??媛숈?\\r\\n      // kind??zone???덉뼱???쒕줈 ?ㅻⅨ ?곗냽 援ш컙?대?濡?runIndex濡?遺꾨━?쒕떎.\\r\\n        const key = JSON.stringify([rowId, layer, runIndex, zone])\\r\\n        // ?ㅽ봽?뗭? **蹂묓빀 ?꾩뿉** 嫄대떎. ?ｇ텥?밤깙?녹뿉?????ㅽ뙩???귙겙?됬춮? 湲몄씠쨌?ф빊媛\\r\\n        // 媛숈븘 媛숈? rowId濡??⑹퀜吏誘濡? 諛곗튂 ?⑥쐞濡???린硫??쒖そ ?ㅽ봽?뗭씠 ?щ씪吏꾨떎.\\r\\n        const shifted = shiftAlongAxis(segments, originOffsetMm)\\r\\n        const batch = batches.get(key)\\r\\n\\r\\n        if (batch) batch.segments.push(...shifted)\\r\\n        else batches.set(key, { rowId, layer, zone, segments: shifted })\\r\\n      },\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return [...batches.values()]\\r\\n}\\r\\n\\r\\nfunction subtract(left: Point3, right: Point3): Point3 {\\r\\n  return [left[0] - right[0], left[1] - right[1], left[2] - right[2]]\\r\\n}\\r\\n\\r\\nfunction dot(left: Point3, right: Point3): number {\\r\\n  return left[0] * right[0] + left[1] * right[1] + left[2] * right[2]\\r\\n}\\r\\n\\r\\nfunction cross(left: Point3, right: Point3): Point3 {\\r\\n  return [\\r\\n    left[1] * right[2] - left[2] * right[1],\\r\\n    left[2] * right[0] - left[0] * right[2],\\r\\n    left[0] * right[1] - left[1] * right[0],\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction normalize(vector: Point3): Point3 {\\r\\n  const length = Math.hypot(vector[0], vector[1], vector[2])\\r\\n\\r\\n  if (!Number.isFinite(length) || length === 0) {\\r\\n    throw new Error('Cannot normalize an invalid camera vector')\\r\\n  }\\r\\n\\r\\n  return [vector[0] / length, vector[1] / length, vector[2] / length]\\r\\n}\\r\\n\\r\\nfunction boundsCorners({ min, max }: Bounds): Point3[] {\\r\\n  return [min[0], max[0]].flatMap((x) =>\\r\\n    [min[1], max[1]].flatMap((y) =>\\r\\n      [min[2], max[2]].map((z): Point3 => [x, y, z]),\\r\\n    ),\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction assertBounds(bounds: Bounds): void {\\r\\n  for (let axis = 0; axis < bounds.min.length; axis += 1) {\\r\\n    const min = bounds.min[axis]\\r\\n    const max = bounds.max[axis]\\r\\n\\r\\n    if (!Number.isFinite(min) || !Number.isFinite(max) || min > max) {\\r\\n      throw new Error(`Invalid bounds on axis ${axis}: ${min}..${max}`)\\r\\n    }\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function easeOutCubic(t: number): number {\\r\\n  const clamped = Math.min(Math.max(t, 0), 1)\\r\\n  return 1 - (1 - clamped) ** 3\\r\\n}\\r\\n\\r\\nexport function lerpCameraFit(\\r\\n  from: CameraFit,\\r\\n  to: CameraFit,\\r\\n  t: number,\\r\\n): CameraFit {\\r\\n  const mix = (left: Point3, right: Point3): Point3 => [\\r\\n    left[0] + (right[0] - left[0]) * t,\\r\\n    left[1] + (right[1] - left[1]) * t,\\r\\n    left[2] + (right[2] - left[2]) * t,\\r\\n  ]\\r\\n\\r\\n  return {\\r\\n    position: mix(from.position, to.position),\\r\\n    target: mix(from.target, to.target),\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뚮씪?댁씤 ?쒖옉 ?ъ쫰: ?먮룞 ?꾨젅?대컢 ?ъ쫰瑜??源?以묒떖?쇰줈 yaw ?뚯쟾?쒗궎怨?\\n * 嫄곕━瑜?諛곗쑉留뚰겮 踰뚮┛?? 泥?濡쒕뱶 ?곗텧??異쒕컻?먯씠??\\r\\n */\\r\\nexport function flyInStartPose(\\r\\n  fit: CameraFit,\\r\\n  yawRadians: number,\\r\\n  distanceScale: number,\\r\\n): CameraFit {\\r\\n  const offset = subtract(fit.position, fit.target)\\r\\n  const cos = Math.cos(yawRadians)\\r\\n  const sin = Math.sin(yawRadians)\\r\\n  const rotated: Point3 = [\\r\\n    offset[0] * cos + offset[2] * sin,\\r\\n    offset[1],\\r\\n    -offset[0] * sin + offset[2] * cos,\\r\\n  ]\\r\\n\\r\\n  return {\\r\\n    position: [\\r\\n      fit.target[0] + rotated[0] * distanceScale,\\r\\n      fit.target[1] + rotated[1] * distanceScale,\\r\\n      fit.target[2] + rotated[2] * distanceScale,\\r\\n    ],\\r\\n    target: fit.target,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function fitCamera(bounds: Bounds): CameraFit {\\r\\n  assertBounds(bounds)\\r\\n\\r\\n  const target: Point3 = [\\r\\n    (bounds.min[0] + bounds.max[0]) / 2,\\r\\n    (bounds.min[1] + bounds.max[1]) / 2,\\r\\n    (bounds.min[2] + bounds.max[2]) / 2,\\r\\n  ]\\r\\n  const cameraZ = normalize(CAMERA_DIRECTION)\\r\\n  const cameraX = normalize(cross([0, 1, 0], cameraZ))\\r\\n  const cameraY = cross(cameraZ, cameraX)\\r\\n  const tangent = Math.tan((CAMERA_FOV_DEGREES * Math.PI) / 360)\\r\\n  const distance = Math.max(\\r\\n    Number.EPSILON,\\r\\n    ...boundsCorners(bounds).map((corner) => {\\r\\n      const relative = subtract(corner, target)\\r\\n      const projectedRadius = Math.max(\\r\\n        Math.abs(dot(relative, cameraX)),\\r\\n        Math.abs(dot(relative, cameraY)),\\r\\n      )\\r\\n\\r\\n      return (\\r\\n        dot(relative, cameraZ) +\\r\\n        (CAMERA_FRAME_MARGIN * projectedRadius) / tangent\\r\\n      )\\r\\n    }),\\r\\n  )\\r\\n  const position: Point3 = [\\r\\n    target[0] + cameraZ[0] * distance,\\r\\n    target[1] + cameraZ[1] * distance,\\r\\n    target[2] + cameraZ[2] * distance,\\r\\n  ]\\r\\n\\r\\n  return { position, target }\\r\\n}\\r\\n\\r\\nimport type { Rebar, RebarZone } from '@/domain/model/rebar'\\r\\nimport type { RuleHit } from '@/domain/rules/types'\\r\\n\\r\\nexport interface LegendEntry {\\r\\n  kind: RebarZone['kind']\\r\\n  lengthMm: number\\r\\n  ruleKey: string\\r\\n  /** ??湲몄씠瑜??뺥븳 猷? ?뷴끂 ?쒖떆媛 踰뺤쟻 ?섎Т?대?濡??섏튂? ?④퍡 ?섎Ⅸ?? */\\r\\n  rule: RuleHit\\r\\n}\\r\\n\\r\\n/**\\r\\n * 踰붾????곗젙遺媛 zone???ㅼ뼱 蹂대궦 猷??ㅻ? 洹몃?濡??쒖떆?쒕떎 ???뺤긽쨌湲몄씠?먯꽌\\r\\n * ?대뒓 猷곗씠 吏諛고뻽?붿? ?섏쭦?쇰㈃ ?꾨찓?멸낵 ?닿툔?????덈뒗 ??踰덉㎏ ?먯젙???쒕떎.\\r\\n */\\r\\nexport function legendEntries(rebars: Rebar[]): LegendEntry[] {\\r\\n  const entries = new Map<string, LegendEntry>()\\r\\n\\r\\n  for (const rebar of rebars) {\\r\\n    for (const zone of rebar.zones ?? []) {\\r\\n      const lengthMm = zone.pathToMm - zone.pathFromMm\\r\\n      const key = JSON.stringify([zone.kind, zone.ruleKey, lengthMm])\\r\\n\\r\\n      if (entries.has(key)) continue\\r\\n\\r\\n      const rule = rebar.ruleHits.find(({ key }) => key === zone.ruleKey)\\r\\n\\r\\n      if (rule === undefined) {\\r\\n        // ?앹꽦湲곕뒗 zone??留뚮뱺 猷곗쓣 諛섎뱶??ruleHits?먮룄 ?ｋ뒗?? ?녿떎硫?寃고븿?대ŉ,\\r\\n        // ?뷴끂 ?녿뒗 ?섏튂瑜?議곗슜???꾩슦??????ㅽ뙣?쒗궓??\\r\\n        throw new Error(\\r\\n          `Legend rule missing from ruleHits: ${rebar.id} ${zone.ruleKey}`,\\r\\n        )\\r\\n      }\\r\\n\\r\\n      entries.set(key, { kind: zone.kind, lengthMm, ruleKey: zone.ruleKey, rule })\\r\\n    }\\r\\n  }\\r\\n\\r\\n  return [...entries.values()]\\r\\n}\\r\\n\\r\\nimport type { RuleHit } from '@/domain/rules/types'\\r\\n\\r\\n/**\\r\\n * 異쒖쿂 ?쒖떆??PDL1.0 以嫄곗쓽 踰뺤쟻 ?섎Т??(CLAUDE.md). 猷??좊옒 ?섏튂瑜?蹂댁뿬二쇰뒗\\r\\n * ?붾㈃???щ읉?대?濡??쒓린 ?뺤떇???ш린 ?섎굹濡??붾떎 ???붾㈃留덈떎 ?곕줈 ?곸쑝硫?\\n * 媛숈? 洹쇨굅媛 ?붾㈃留덈떎 ?ㅻⅤ寃?蹂댁씤??\\r\\n */\\r\\nexport function sourceLabel(rule: RuleHit): string {\\r\\n  return [rule.source.short, rule.source.section].filter(Boolean).join(' ')\\r\\n}\\r\\n\\r\\nexport function sourceTooltip(rule: RuleHit): string {\\r\\n  const edition = rule.source.edition ? `竊?{rule.source.edition}竊? : ''\\r\\n  const location = [\\r\\n    `${rule.source.doc}${edition}`,\\r\\n    rule.source.section,\\r\\n    rule.source.page === null ? null : `${rule.source.page}??,\\r\\n  ]\\r\\n    .filter(Boolean)\\r\\n    .join(' ')\\r\\n  const note = rule.source.url\\r\\n    ? rule.note\\r\\n    : `?잍뻼URL?ょ▶岳???${rule.note}`\\r\\n\\r\\n  return [\\r\\n    `${rule.label} 竊?${rule.expr}`,\\r\\n    location,\\r\\n    // ?깃툒留덈떎 ?ㅻⅨ 留먯씠 遺숈뼱???쒕떎 ???뚯썝臾몄뿉 ?녿떎?띿? ?뚯썝臾몄뿉 ?덈뒗??\\n    // 寃?좉? 1?몄씠?ㅳ띾? 媛숈? 臾멸뎄濡???쑝硫??깃툒???섎늿 ?섎?媛 ?녿떎.\\r\\n    rule.confidence === 'inferred'\\r\\n      ? '???잍뻼?ュㅳ겒?쀯펷?②쳳竊됤?\\r\\n      : rule.confidence === 'transcribed'\\r\\n        ? '???잍뻼?롧ㅊ?사떖塋뗦쩂鼇롥푷?∽펷R6竊됤?\\r\\n        : null,\\r\\n    note,\\r\\n  ]\\r\\n    .filter(Boolean)\\r\\n    .join('\\\\n')\\r\\n}\\r\\n\\r\\nphases/47-joint-review-core\\\\step2-invoke.json:3:  \\\"name\\\": \\\"review-persistence\\\",\\r\\nphases/47-joint-review-core\\\\step2-invoke.json:7:  \\\"stdout_log\\\": \\\"phases\\\\\\\\47-joint-review-core\\\\\\\\step2-codex.stdout.log\\\",\\r\\nphases/47-joint-review-core\\\\step2-invoke.jso