0] - from[0]) * ratio,\\\\\\\\r\\\\\\\\n    from[1] + (to[1] - from[1]) * ratio,\\\\\\\\r\\\\\\\\n    from[2] + (to[2] - from[2]) * ratio,\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction zoneAt(\\\\\\\\r\\\\\\\\n  zones: RebarZone[],\\\\\\\\r\\\\\\\\n  pathDistanceMm: number,\\\\\\\\r\\\\\\\\n): RebarZone['kind'] | null {\\\\\\\\r\\\\\\\\n  return (\\\\\\\\r\\\\\\\\n    zones.find(\\\\\\\\r\\\\\\\\n      ({ pathFromMm, pathToMm }) =>\\\\\\\\r\\\\\\\\n        pathDistanceMm >= pathFromMm && pathDistanceMm <= pathToMm,\\\\\\\\r\\\\\\\\n    )?.kind ?? null\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/** ?袁⑹읅 domain 野껋럥以덂쳞怨뺚봺?癒?퐣 ?믪눘? ?癒?뀲?? ??뽯뻻 ?紐꾨묒쮯獄쏄퀣?????野껉퀗??癒?춸 ?怨몄뒠??뺣뼄. */\\\\\\\\r\\\\\\\\nfunction pathRuns(rebar: Rebar): PathRun[] {\\\\\\\\r\\\\\\\\n  const edges: PathSegment[] = rebar.points.slice(1).map((to, index) => ({\\\\\\\\r\\\\\\\\n    from: rebar.points[index],\\\\\\\\r\\\\\\\\n    to,\\\\\\\\r\\\\\\\\n  }))\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (rebar.closed && rebar.points.length > 1) {\\\\\\\\r\\\\\\\\n    edges.push({\\\\\\\\r\\\\\\\\n      from: rebar.points[rebar.points.length - 1],\\\\\\\\r\\\\\\\\n      to: rebar.points[0],\\\\\\\\r\\\\\\\\n    })\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (rebar.hookTails !== undefined && rebar.points.length > 0) {\\\\\\\\r\\\\\\\\n    for (const tail of rebar.hookTails) {\\\\\\\\r\\\\\\\\n      edges.push({ from: rebar.points[0], to: tail, hookTail: true })\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const zones = rebar.zones ?? []\\\\\\\\r\\\\\\\\n  const boundaries = zones.flatMap(({ pathFromMm, pathToMm }) => [\\\\\\\\r\\\\\\\\n    pathFromMm,\\\\\\\\r\\\\\\\\n    pathToMm,\\\\\\\\r\\\\\\\\n  ])\\\\\\\\r\\\\\\\\n  const runs: PathRun[] = []\\\\\\\\r\\\\\\\\n  let walked = 0\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  for (const edge of edges) {\\\\\\\\r\\\\\\\\n    const length = pointDistance(edge.from, edge.to)\\\\\\\\r\\\\\\\\n    if (length === 0) continue\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    const edgeEnd = walked + length\\\\\\\\r\\\\\\\\n    const cuts = [\\\\\\\\r\\\\\\\\n      walked,\\\\\\\\r\\\\\\\\n      ...boundaries.filter(\\\\\\\\r\\\\\\\\n        (boundary) => boundary > walked && boundary < edgeEnd,\\\\\\\\r\\\\\\\\n      ),\\\\\\\\r\\\\\\\\n      edgeEnd,\\\\\\\\r\\\\\\\\n    ].sort((left, right) => left - right)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    for (let index = 1; index < cuts.length; index += 1) {\\\\\\\\r\\\\\\\\n      const pathFrom = cuts[index - 1]\\\\\\\\r\\\\\\\\n      const pathTo = cuts[index]\\\\\\\\r\\\\\\\\n      if (pathTo <= pathFrom) continue\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n      const segment: PathSegment = {\\\\\\\\r\\\\\\\\n        from: interpolate(edge.from, edge.to, (pathFrom - walked) / length),\\\\\\\\r\\\\\\\\n        to: interpolate(edge.from, edge.to, (pathTo - walked) / length),\\\\\\\\r\\\\\\\\n      }\\\\\\\\r\\\\\\\\n      if (edge.hookTail) segment.hookTail = true\\\\\\\\r\\\\\\\\n      const zone = zoneAt(zones, (pathFrom + pathTo) / 2)\\\\\\\\r\\\\\\\\n      const current = runs[runs.length - 1]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n      if (current?.zone === zone) current.segments.push(segment)\\\\\\\\r\\\\\\\\n      else runs.push({ zone, segments: [segment] })\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    walked = edgeEnd\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return runs\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport interface AxisAlignedBox {\\\\\\\\r\\\\\\\\n  center: Point3\\\\\\\\r\\\\\\\\n  size: Point3\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/** 蒻멸릴寃??뺣ı寃??산괼??볥??節됯뮈???ゅ＄?궰洹잙퍠????숈뭽寃??덇깽??닿괏癲됰랭援??고렩??⑹벒?遺듦쾹??⑷괵??낇렫 */\\\\\\\\r\\\\\\\\nexport interface BoxHole {\\\\\\\\r\\\\\\\\n  minA: number\\\\\\\\r\\\\\\\\n  maxA: number\\\\\\\\r\\\\\\\\n  minB: number\\\\\\\\r\\\\\\\\n  maxB: number\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ??λ－???쾸??덇틡??爰??덇퉱????誘↔괜?????(?怨덈눉癲⑤씤痢?酉명떖 1??㏓렣8))??\\\\\\\\n *\\\\\\\\r\\\\\\\\n * ??λ－??源?癒?쿁??κ괵?誘???琉듦쿁???怨?コ??ｊ쿁??`axes` ??㏓셼???뺣ı嫄?臾녾굵????녠쿁??λ－?????\\\\\\\\n * ??勇???녠쾽?轅붽데塋딅뛽???꿸틫阿읦녠틫鼇앸뿣爰뺠쯁?됲렫?洹잛Þ?寃밴콟??ｊ쿃?轅붽쾫????誘↔괵??κ쾽?轅붽데 ????⑸퉻??\\\\\\\\n * ??띕룾???닧??ｊ괭???쿂?洹숆데??Ｂ怨뀀눆??껉쾫??볥??節껉쾸?洹앹턃?臾녾괏癲놅퐙嫄?琉몄툙??Ｂ?\\\\\\\\n *\\\\\\\\r\\\\\\\\n * ?琉듦덮??뚭광???껈뭣酉⑷굵?臾녾쿁掠뗪릴寃?洹숆데?洹앸퉲?琉듦쿁饔앹쥏???`openingDeduction` ??る렠癲ル뿣寃??녠콢??\\\\\\\\n * ?寃밴콫??ｊ탾??寃?怨κ텭??덇텥??껉틬??爰???삛??鍮?琉듦쿂??リ탾??リ탾?믪뜴諭???닧?類쏄쾼??(ADR-005)??\\\\\\\\n */\\\\\\\\r\\\\\\\\nexport function carveBox<T extends AxisAlignedBox>(\\\\\\\\r\\\\\\\\n  box: T,\\\\\\\\r\\\\\\\\n  axes: [number, number],\\\\\\\\r\\\\\\\\n  holes: BoxHole[],\\\\\\\\r\\\\\\\\n): T[] {\\\\\\\\r\\\\\\\\n  return holes.reduce<T[]>(\\\\\\\\r\\\\\\\\n    (boxes, hole) => boxes.flatMap((one) => carveOne(one, axes, hole)),\\\\\\\\r\\\\\\\\n    [box],\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction carveOne<T extends AxisAlignedBox>(\\\\\\\\r\\\\\\\\n  box: T,\\\\\\\\r\\\\\\\\n  [axisA, axisB]: [number, number],\\\\\\\\r\\\\\\\\n  hole: BoxHole,\\\\\\\\r\\\\\\\\n): T[] {\\\\\\\\r\\\\\\\\n  const minA = box.center[axisA] - box.size[axisA] / 2\\\\\\\\r\\\\\\\\n  const maxA = box.center[axisA] + box.size[axisA] / 2\\\\\\\\r\\\\\\\\n  const minB = box.center[axisB] - box.size[axisB] / 2\\\\\\\\r\\\\\\\\n  const maxB = box.center[axisB] + box.size[axisB] / 2\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const cutMinA = Math.max(minA, hole.minA)\\\\\\\\r\\\\\\\\n  const cutMaxA = Math.min(maxA, hole.maxA)\\\\\\\\r\\\\\\\\n  const cutMinB = Math.max(minB, hole.minB)\\\\\\\\r\\\\\\\\n  const cutMaxB = Math.min(maxB, hole.maxB)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (cutMinA >= cutMaxA || cutMinB >= cutMaxB) return [box]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const piece = (\\\\\\\\r\\\\\\\\n    fromA: number,\\\\\\\\r\\\\\\\\n    toA: number,\\\\\\\\r\\\\\\\\n    fromB: number,\\\\\\\\r\\\\\\\\n    toB: number,\\\\\\\\r\\\\\\\\n  ): T => {\\\\\\\\r\\\\\\\\n    const center = [...box.center] as Point3\\\\\\\\r\\\\\\\\n    const size = [...box.size] as Point3\\\\\\\\r\\\\\\\\n    center[axisA] = (fromA + toA) / 2\\\\\\\\r\\\\\\\\n    size[axisA] = toA - fromA\\\\\\\\r\\\\\\\\n    center[axisB] = (fromB + toB) / 2\\\\\\\\r\\\\\\\\n    size[axisB] = toB - fromB\\\\\\\\r\\\\\\\\n    return { ...box, center, size }\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const pieces: T[] = []\\\\\\\\r\\\\\\\\n  if (minA < cutMinA) pieces.push(piece(minA, cutMinA, minB, maxB))\\\\\\\\r\\\\\\\\n  if (cutMaxA < maxA) pieces.push(piece(cutMaxA, maxA, minB, maxB))\\\\\\\\r\\\\\\\\n  if (minB < cutMinB) pieces.push(piece(cutMinA, cutMaxA, minB, cutMinB))\\\\\\\\r\\\\\\\\n  if (cutMaxB < maxB) pieces.push(piece(cutMinA, cutMaxA, cutMaxB, maxB))\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return pieces\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/** ??⑹벒畑돠????堉?節껉뎌?怨????뺣ı寃??쎄괩??㏓룆?롮뼃踰②늾?산쿁??댁댇??λ꼵??뼘?*/\\\\\\\\r\\\\\\\\nexport function boxHoles(\\\\\\\\r\\\\\\\\n  openings: Opening[],\\\\\\\\r\\\\\\\\n  originA: number,\\\\\\\\r\\\\\\\\n  originB: number,\\\\\\\\r\\\\\\\\n): BoxHole[] {\\\\\\\\r\\\\\\\\n  return openings.map((opening) => ({\\\\\\\\r\\\\\\\\n    minA: originA + opening.xMm,\\\\\\\\r\\\\\\\\n    maxA: originA + opening.xMm + opening.widthMm,\\\\\\\\r\\\\\\\\n    minB: originB + opening.yMm,\\\\\\\\r\\\\\\\\n    maxB: originB + opening.yMm + opening.heightMm,\\\\\\\\r\\\\\\\\n  }))\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ??λ－???괏?袁ㅼ땠?誘ㅻ섈??듬쇃??(?怨덈눉癲⑤씤痢?酉명떖 1??㏓렣8))??\\\\\\\\n *\\\\\\\\r\\\\\\\\n * ??λ－??源?癒?쿁??κ괵?誘???琉듦쿁???怨⑸떓畑댁떏寃섓Ⅵ??? x??????뺣ı嫄?臾녾쾸?곷뀍援??Ｂ洹쏆쪐??ｊ쾽??꿸턃??닿쾻\\\\\\\\r\\\\\\\\n * ?띾맓援?袁ㅼ땠??堉??녾쾼?????怨덈눉??닿쿁饔앹쥏???듭르??⑤┴??딇겣??녾쾸?怨뀀??節껉쿁勇싲쉑寃?袁ㅼ땠?誘ㅼ턃??ｊ굘??껉콢\\\\\\\\r\\\\\\\\n * ??녾탽???콟??(`openingDeduction`)??\\\\\\\\n *\\\\\\\\r\\\\\\\\n * ?怨덈눉??Ｂ?ν맟??嫄ｉ턁釉걅饔앹【嫄??ｊ괍??꿸뎌庸눫??닿쿁?????Ｂ怨κ괭?蹂앷괏癲됰랭援??ｊ쿁????ｊ쾻?蹂앷쾸??롪덱??\\\\\\\\n * 沃ㅻ뿣嫄??ｊ괍??꿸굵?洹앹턃?臾녾데俑앸씤?????遺듦쾹??⑷괵??닿쿁??`Rebar.points` ??ｊ쿂?款援??κ덱??껉콢 ??\\\\\\\\n * 繞볩퐟????寃??낃덱歷띠떏寃??λ－?誘μ쑅??κ쾼?袁??猷붽쿁麗몃슜????콟??(ADR-029)??\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction openingCut(\\\\\\\\r\\\\\\\\n  from: Point3,\\\\\\\\r\\\\\\\\n  to: Point3,\\\\\\\\r\\\\\\\\n  opening: Opening,\\\\\\\\r\\\\\\\\n): [number, number] | null {\\\\\\\\r\\\\\\\\n  let enter = 0\\\\\\\\r\\\\\\\\n  let leave = 1\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  for (const axis of [0, 1] as const) {\\\\\\\\r\\\\\\\\n    const minimum = axis === 0 ? opening.xMm : opening.yMm\\\\\\\\r\\\\\\\\n    const maximum =\\\\\\\\r\\\\\\\\n      minimum + (axis === 0 ? opening.widthMm : opening.heightMm)\\\\\\\\r\\\\\\\\n    const start = from[axis]\\\\\\\\r\\\\\\\\n    const delta = to[axis] - start\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    if (Math.abs(delta) < 1e-9) {\\\\\\\\r\\\\\\\\n      // ?蹂앷쿁?뺣ı寃?類쏄괍??껉콢?袁ㅼ땠???怨뀀??節껉쿁??산깻??ｊ콢??ｊ괍勇싲쉑寃?袁좉데??ｊ쿁??꿸굶??κ괍?議셋?\\\\\\\\n      if (start <= minimum || start >= maximum) return null\\\\\\\\r\\\\\\\\n      continue\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    const first = (minimum - start) / delta\\\\\\\\r\\\\\\\\n    const second = (maximum - start) / delta\\\\\\\\r\\\\\\\\n    enter = Math.max(enter, Math.min(first, second))\\\\\\\\r\\\\\\\\n    leave = Math.min(leave, Math.max(first, second))\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return leave > enter ? [enter, leave] : null\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction lerpPoint(from: Point3, to: Point3, t: number): Point3 {\\\\\\\\r\\\\\\\\n  return [\\\\\\\\r\\\\\\\\n    from[0] + (to[0] - from[0]) * t,\\\\\\\\r\\\\\\\\n    from[1] + (to[1] - from[1]) * t,\\\\\\\\r\\\\\\\\n    from[2] + (to[2] - from[2]) * t,\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction clipSegment(segment: Segment, openings: Opening[]): Segment[] {\\\\\\\\r\\\\\\\\n  const cuts = openings\\\\\\\\r\\\\\\\\n    .map((opening) => openingCut(segment.from, segment.to, opening))\\\\\\\\r\\\\\\\\n    .filter((cut): cut is [number, number] => cut !== null)\\\\\\\\r\\\\\\\\n    .sort(([left], [right]) => left - right)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (cuts.length === 0) return [segment]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const pieces: Segment[] = []\\\\\\\\r\\\\\\\\n  let walked = 0\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  for (const [enter, leave] of cuts) {\\\\\\\\r\\\\\\\\n    if (enter > walked) {\\\\\\\\r\\\\\\\\n      pieces.push({\\\\\\\\n        from: lerpPoint(segment.from, segment.to, walked),\\\\\\\\n        to: lerpPoint(segment.from, segment.to, enter),\\\\\\\\n        radius: segment.radius,\\\\\\\\n        ...(segment.barIndex === undefined ? {} : { barIndex: segment.barIndex }),\\\\\\\\n        ...(segment.hookTail ? { hookTail: true } : {}),\\\\\\\\n      })\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n    walked = Math.max(walked, leave)\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (walked < 1) {\\\\\\\\r\\\\\\\\n    pieces.push({\\\\\\\\n      from: lerpPoint(segment.from, segment.to, walked),\\\\\\\\n      to: segment.to,\\\\\\\\n      radius: segment.radius,\\\\\\\\n      ...(segment.barIndex === undefined ? {} : { barIndex: segment.barIndex }),\\\\\\\\n      ...(segment.hookTail ? { hookTail: true } : {}),\\\\\\\\n    })\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  // 櫻?嫄??λ－?????ｊ굶??롪콨??듯렫??ｊ쾹?猷붽괵0??議??롪괏?酉⑷데?洹앸짂?袁좉쾷?洹잛コ??寃?袁좉콨????\\\\\\\\n  // three.js ????湲깃땋??껉뭄??爰???┣??꿸뎌癲됰랭援??κ덱??껉콢??\\\\\\\\n  return pieces.filter(\\\\\\\\r\\\\\\\\n    ({ from, to }) =>\\\\\\\\r\\\\\\\\n      Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2]) > 1e-6,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function clipSegments(\\\\\\\\r\\\\\\\\n  segments: Segment[],\\\\\\\\r\\\\\\\\n  openings: Opening[],\\\\\\\\r\\\\\\\\n): Segment[] {\\\\\\\\r\\\\\\\\n  if (openings.length === 0) return segments\\\\\\\\r\\\\\\\\n  return segments.flatMap((segment) => clipSegment(segment, openings))\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction rebarSegmentRuns(\\\\\\\\r\\\\\\\\n  rebar: Rebar,\\\\\\\\r\\\\\\\\n  section: Section,\\\\\\\\r\\\\\\\\n  radiusOf: RadiusOf = rebarRadius,\\\\\\\\r\\\\\\\\n  openings: Opening[] = [],\\\\\\\\r\\\\\\\\n): SegmentRun[] {\\\\\\\\r\\\\\\\\n  if (roleToLayer(rebar.role) === 'hidden') return []\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  // 傭?낄寃뤶쉴???議쇨괩?뤴몺???욱뫔??り뮈?癒⑤읅??㏉닩??κ덱??Ｂ洹〓볡뇾?寃?琉밸돕??⑸떔??밴쿁??욱뫔?誘?뒾??닿쾹??\\\\\\\\n  // 掠뗪껸援??녾쿂??κ쿁畑듐뀽嫄?琉듦괜???광??ｊ께??뚣꽯?節껉쾷濚뉗엱嫄싨를????\\\\\\\\n  const radius =\\\\\\\\r\\\\\\\\n    section.kind === '?癒ъ맇傭?\\\\\\\\r\\\\\\\\n      ? wallDisplayRadius(rebar.size, section, radiusOf)\\\\\\\\r\\\\\\\\n      : section.kind === '鵝????\\\\\\\\r\\\\\\\\n        ? slabDisplayRadius(\\\\\\\\r\\\\\\\\n            rebar.size,\\\\\\\\r\\\\\\\\n            section,\\\\\\\\r\\\\\\\\n            slabCoverMm(slabCoverZ(rebar), section),\\\\\\\\r\\\\\\\\n            radiusOf,\\\\\\\\r\\\\\\\\n          )\\\\\\\\r\\\\\\\\n        : radiusOf(rebar.size)\\\\\\\\r\\\\\\\\n  const displayPoint = (point: Point3): Point3 =>\\\\\\\\r\\\\\\\\n    rebar.shape === 'hoop'\\\\\\\\r\\\\\\\\n      ? hoopDisplayPoint(point, rebar.points, radius, section)\\\\\\\\r\\\\\\\\n      : point\\\\\\\\r\\\\\\\\n  // 135吏?類쏄맙????猷붽뎌櫻?沅?遺듦쾹??clamp ??산데??┑怨?췀??彛?諛ㅺ굵?臾덈꺏??닿꺅?롪풝寃??\\\\\\\\n  // ?臾녾광???퉻?類쏄괏?β뮧援?怨?군畑밸뱽?껈뭣酉대쐡耶껉풝寃쀦를酉⑷맒?款爰?戮㏐쾽??ｊ탾??ｊ데?洹쏆춷?諛ㅺ괏??ｊ괩??\\\\\\\\n  // inset ??⑤┴??뉖춣?뤿슚??類쏄뎌凉깆뼃?꿴턁蹂앷쾽??ｊ괩?怨⑸뮙?Ξ듭댇??곌쿁?臾녾광???퉻?類쏄뎌略녹빂寃??\\\\\\\\n  const hookTailPoint = (point: Point3): Point3 => {\\\\\\\\r\\\\\\\\n    const origin = rebar.points[0]\\\\\\\\r\\\\\\\\n    const displayed = displayPoint(origin)\\\\\\\\r\\\\\\\\n    return [\\\\\\\\r\\\\\\\\n      point[0] + displayed[0] - origin[0],\\\\\\\\r\\\\\\\\n      point[1] + displayed[1] - origin[1],\\\\\\\\r\\\\\\\\n      point[2] + displayed[2] - origin[2],\\\\\\\\r\\\\\\\\n    ]\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n  const placements = rebarPlacements(rebar, section, radiusOf)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return pathRuns(rebar).map(({ zone, segments }) => ({\\\\\\\\r\\\\\\\\n    zone,\\\\\\\\r\\\\\\\\n    // ??λ－???쿂 3D ???굵?臾뚮렠癲ル뿣援??寃?洹앸퉲?琉듦쿂 `Rebar.length` ???떔???샍?節껉쾷?袁좉데\\\\\\\\r\\\\\\\\n    // ??寃?怨κ괭?蹂앷쾸??롪쾫??됯탾??鍮???굹?琉듦쿂?類쏄괍??껉콢 (ADR-029)??\\\\\\\\n    segments: clipSegments(\\\\\\\\r\\\\\\\\n      placements.flatMap((offset, barIndex) =>\\\\\\\\n        segments.map(({ from, to, hookTail }) => ({\\\\\\\\n          from: translate(hookTail ? hookTailPoint(from) : displayPoint(from), offset),\\\\\\\\n          to: translate(hookTail ? hookTailPoint(to) : displayPoint(to), offset),\\\\\\\\n          radius,\\\\\\\\n          barIndex,\\\\\\\\n          ...(hookTail ? { hookTail: true } : {}),\\\\\\\\n        })),\\\\\\\\r\\\\\\\\n      ),\\\\\\\\r\\\\\\\\n      openings,\\\\\\\\r\\\\\\\\n    ),\\\\\\\\r\\\\\\\\n  }))\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function rebarSegments(\\\\\\\\r\\\\\\\\n  rebar: Rebar,\\\\\\\\r\\\\\\\\n  section: Section,\\\\\\\\r\\\\\\\\n  radiusOf: RadiusOf = rebarRadius,\\\\\\\\r\\\\\\\\n  openings: Opening[] = [],\\\\\\\\r\\\\\\\\n): Segment[] {\\\\\\\\r\\\\\\\\n  return rebarSegmentRuns(rebar, section, radiusOf, openings).flatMap(\\\\\\\\r\\\\\\\\n    ({ segments }) => segments,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport interface RebarBatch {\\\\\\\\r\\\\\\\\n  rowId: string\\\\\\\\r\\\\\\\\n  layer: RebarLayer\\\\\\\\r\\\\\\\\n  zone: RebarZone['kind'] | null\\\\\\\\r\\\\\\\\n  segments: Segment[]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * 3D??揶쏅벡????μ맄????곷열??**??*????DESIGN.md 吏?.2). zone ??깆뱽 癰귣똻???띾┛ ?袁る퉸\\\\\\\\r\\\\\\\\n * ????됰퓠??뺣뮉 ?怨쀫꺗 野껋럥以?run筌띾뜄????롫듇筌왖筌? ?硫몃젃?믪눛?껓쭕?덈뼄 筌롫뗄?녺몴?筌띾슢諭억쭪?????낅뮉??\\\\\\\\r\\\\\\\\n * 揶쏆늿? rowId???醫????嚥?????zone 獄쏄퀣?????롪돌????깆몵嚥???ｍ뜞 揶쏅벡???????덈뼄.\\\\\\\\r\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction shiftAlongAxis(segments: Segment[], offsetMm: number): Segment[] {\\\\\\\\r\\\\\\\\n  if (offsetMm === 0) return segments\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return segments.map(({ from, to, radius }) => ({\\\\\\\\r\\\\\\\\n    from: [from[0] + offsetMm, from[1], from[2]] as Point3,\\\\\\\\r\\\\\\\\n    to: [to[0] + offsetMm, to[1], to[2]] as Point3,\\\\\\\\r\\\\\\\\n    radius,\\\\\\\\r\\\\\\\\n  }))\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function rebarBatches(\\\\\\\\r\\\\\\\\n  entries: {\\\\\\\\r\\\\\\\\n    rowId: string\\\\\\\\r\\\\\\\\n    rebar: Rebar\\\\\\\\r\\\\\\\\n    originOffsetMm?: number\\\\\\\\r\\\\\\\\n    /** ?蹂앷쿁?袁ㅼ땠?????鵝?렕怡썸Ⅹ?좉쾽??닿괼??볥??節됯뮈 (1??㏓렣8))??D ?議쇨괩??ｊ괭??ｊ뎌沃ㅻ뿣援?*/\\\\\\\\r\\\\\\\\n    openings?: Opening[]\\\\\\\\r\\\\\\\\n  }[],\\\\\\\\r\\\\\\\\n  section: Section,\\\\\\\\r\\\\\\\\n): RebarBatch[] {\\\\\\\\r\\\\\\\\n  const batches = new Map<string, RebarBatch>()\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  for (const { rowId, rebar, originOffsetMm = 0, openings = [] } of entries) {\\\\\\\\r\\\\\\\\n    const layer = roleToLayer(rebar.role)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    rebarSegmentRuns(rebar, section, rebarRadius, openings).forEach(\\\\\\\\r\\\\\\\\n      ({ zone, segments }, runIndex) => {\\\\\\\\r\\\\\\\\n      // 揶쏆늿? row??????筌ｌ쥒???????揶쏆뮆????덉뵬 野껋럥以?run??겸봺 ??뱁뒄?? ?臾먮뼊??揶쏆늿?\\\\\\\\r\\\\\\\\n      // kind??zone????됰선????뺤쨮 ??삘뀲 ?怨쀫꺗 ?닌덉퍢???嚥?runIndex嚥??브쑬???뺣뼄.\\\\\\\\r\\\\\\\\n        const key = JSON.stringify([rowId, layer, runIndex, zone])\\\\\\\\r\\\\\\\\n        // ??쎈늄??? **癰귣쵑鍮 ?袁⑸퓠** 椰꾨??? ?節뉙뀯?諛ㅺ튃??밸퓠??????쎈솴???洹숆쿃??ъ땠?? 疫뀀챷?좎쮯??鍮듿첎?\\\\\\\\r\\\\\\\\n        // 揶쏆늿釉?揶쏆늿? rowId嚥???뱁쒙쭪?沃샕嚥? 獄쏄퀣????μ맄嚥???由곤쭖???뽧걹 ??쎈늄???뵠 ???わ쭪袁⑤뼄.\\\\\\\\r\\\\\\\\n        const shifted = shiftAlongAxis(segments, originOffsetMm)\\\\\\\\r\\\\\\\\n        const batch = batches.get(key)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n        if (batch) batch.segments.push(...shifted)\\\\\\\\r\\\\\\\\n        else batches.set(key, { rowId, layer, zone, segments: shifted })\\\\\\\\r\\\\\\\\n      },\\\\\\\\r\\\\\\\\n    )\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return [...batches.values()]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction subtract(left: Point3, right: Point3): Point3 {\\\\\\\\r\\\\\\\\n  return [left[0] - right[0], left[1] - right[1], left[2] - right[2]]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction dot(left: Point3, right: Point3): number {\\\\\\\\r\\\\\\\\n  return left[0] * right[0] + left[1] * right[1] + left[2] * right[2]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction cross(left: Point3, right: Point3): Point3 {\\\\\\\\r\\\\\\\\n  return [\\\\\\\\r\\\\\\\\n    left[1] * right[2] - left[2] * right[1],\\\\\\\\r\\\\\\\\n    left[2] * right[0] - left[0] * right[2],\\\\\\\\r\\\\\\\\n    left[0] * right[1] - left[1] * right[0],\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction normalize(vector: Point3): Point3 {\\\\\\\\r\\\\\\\\n  const length = Math.hypot(vector[0], vector[1], vector[2])\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (!Number.isFinite(length) || length === 0) {\\\\\\\\r\\\\\\\\n    throw new Error('Cannot normalize an invalid camera vector')\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return [vector[0] / length, vector[1] / length, vector[2] / length]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction boundsCorners({ min, max }: Bounds): Point3[] {\\\\\\\\r\\\\\\\\n  return [min[0], max[0]].flatMap((x) =>\\\\\\\\r\\\\\\\\n    [min[1], max[1]].flatMap((y) =>\\\\\\\\r\\\\\\\\n      [min[2], max[2]].map((z): Point3 => [x, y, z]),\\\\\\\\r\\\\\\\\n    ),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction assertBounds(bounds: Bounds): void {\\\\\\\\r\\\\\\\\n  for (let axis = 0; axis < bounds.min.length; axis += 1) {\\\\\\\\r\\\\\\\\n    const min = bounds.min[axis]\\\\\\\\r\\\\\\\\n    const max = bounds.max[axis]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    if (!Number.isFinite(min) || !Number.isFinite(max) || min > max) {\\\\\\\\r\\\\\\\\n      throw new Error(`Invalid bounds on axis ${axis}: ${min}..${max}`)\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function easeOutCubic(t: number): number {\\\\\\\\r\\\\\\\\n  const clamped = Math.min(Math.max(t, 0), 1)\\\\\\\\r\\\\\\\\n  return 1 - (1 - clamped) ** 3\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function lerpCameraFit(\\\\\\\\r\\\\\\\\n  from: CameraFit,\\\\\\\\r\\\\\\\\n  to: CameraFit,\\\\\\\\r\\\\\\\\n  t: number,\\\\\\\\r\\\\\\\\n): CameraFit {\\\\\\\\r\\\\\\\\n  const mix = (left: Point3, right: Point3): Point3 => [\\\\\\\\r\\\\\\\\n    left[0] + (right[0] - left[0]) * t,\\\\\\\\r\\\\\\\\n    left[1] + (right[1] - left[1]) * t,\\\\\\\\r\\\\\\\\n    left[2] + (right[2] - left[2]) * t,\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return {\\\\\\\\r\\\\\\\\n    position: mix(from.position, to.position),\\\\\\\\r\\\\\\\\n    target: mix(from.target, to.target),\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ???뵬??곸뵥 ??뽰삂 ??已? ?癒?짗 ?袁⑥쟿??而???已곁몴???繹?餓λ쵐???곗쨮 yaw ???읈??쀪텕??\\\\\\\\n * 椰꾧퀡?곭몴?獄쏄퀣?됵쭕?곌껍 甕곕슢??? 筌?嚥≪뮆諭??怨쀭뀱???곗뮆而?癒?뵠??\\\\\\\\r\\\\\\\\n */\\\\\\\\r\\\\\\\\nexport function flyInStartPose(\\\\\\\\r\\\\\\\\n  fit: CameraFit,\\\\\\\\r\\\\\\\\n  yawRadians: number,\\\\\\\\r\\\\\\\\n  distanceScale: number,\\\\\\\\r\\\\\\\\n): CameraFit {\\\\\\\\r\\\\\\\\n  const offset = subtract(fit.position, fit.target)\\\\\\\\r\\\\\\\\n  const cos = Math.cos(yawRadians)\\\\\\\\r\\\\\\\\n  const sin = Math.sin(yawRadians)\\\\\\\\r\\\\\\\\n  const rotated: Point3 = [\\\\\\\\r\\\\\\\\n    offset[0] * cos + offset[2] * sin,\\\\\\\\r\\\\\\\\n    offset[1],\\\\\\\\r\\\\\\\\n    -offset[0] * sin + offset[2] * cos,\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return {\\\\\\\\r\\\\\\\\n    position: [\\\\\\\\r\\\\\\\\n      fit.target[0] + rotated[0] * distanceScale,\\\\\\\\r\\\\\\\\n      fit.target[1] + rotated[1] * distanceScale,\\\\\\\\r\\\\\\\\n      fit.target[2] + rotated[2] * distanceScale,\\\\\\\\r\\\\\\\\n    ],\\\\\\\\r\\\\\\\\n    target: fit.target,\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function fitCamera(bounds: Bounds): CameraFit {\\\\\\\\r\\\\\\\\n  assertBounds(bounds)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const target: Point3 = [\\\\\\\\r\\\\\\\\n    (bounds.min[0] + bounds.max[0]) / 2,\\\\\\\\r\\\\\\\\n    (bounds.min[1] + bounds.max[1]) / 2,\\\\\\\\r\\\\\\\\n    (bounds.min[2] + bounds.max[2]) / 2,\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n  const cameraZ = normalize(CAMERA_DIRECTION)\\\\\\\\r\\\\\\\\n  const cameraX = normalize(cross([0, 1, 0], cameraZ))\\\\\\\\r\\\\\\\\n  const cameraY = cross(cameraZ, cameraX)\\\\\\\\r\\\\\\\\n  const tangent = Math.tan((CAMERA_FOV_DEGREES * Math.PI) / 360)\\\\\\\\r\\\\\\\\n  const distance = Math.max(\\\\\\\\r\\\\\\\\n    Number.EPSILON,\\\\\\\\r\\\\\\\\n    ...boundsCorners(bounds).map((corner) => {\\\\\\\\r\\\\\\\\n      const relative = subtract(corner, target)\\\\\\\\r\\\\\\\\n      const projectedRadius = Math.max(\\\\\\\\r\\\\\\\\n        Math.abs(dot(relative, cameraX)),\\\\\\\\r\\\\\\\\n        Math.abs(dot(relative, cameraY)),\\\\\\\\r\\\\\\\\n      )\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n      return (\\\\\\\\r\\\\\\\\n        dot(relative, cameraZ) +\\\\\\\\r\\\\\\\\n        (CAMERA_FRAME_MARGIN * projectedRadius) / tangent\\\\\\\\r\\\\\\\\n      )\\\\\\\\r\\\\\\\\n    }),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  const position: Point3 = [\\\\\\\\r\\\\\\\\n    target[0] + cameraZ[0] * distance,\\\\\\\\r\\\\\\\\n    target[1] + cameraZ[1] * distance,\\\\\\\\r\\\\\\\\n    target[2] + cameraZ[2] * distance,\\\\\\\\r\\\\\\\\n  ]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return { position, target }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport * as THREE from 'three'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport type { ShearBarSize } from '@/domain/model/member'\\\\\\\\r\\\\\\\\nimport type { Project } from '@/domain/model/project'\\\\\\\\r\\\\\\\\nimport type { Rebar } from '@/domain/model/rebar'\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  buildingLayout,\\\\\\\\r\\\\\\\\n  type ConcreteBox,\\\\\\\\r\\\\\\\\n  type RebarInstance,\\\\\\\\r\\\\\\\\n} from '@/lib/viewer/building'\\\\\\\\r\\\\\\\\nimport { barDiameter } from '@/lib/viewer/geometry'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport { modelNotices } from '@/lib/export'\\\\\\\\r\\\\\\\\nimport { projectFileName } from '@/lib/persist/file'\\\\\\\\r\\\\\\\\nimport type { Locale } from '@/lib/store'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/** glTF ??m ??る쫶??⑥ジ礖?풝?洹잞폓?怨κ쿁鵝?렕怡??mm ??껉쿁???怨レ럱??띕닧??우쪐??寃롨쯁?鵝?븠嫄?臾덈룾??Ｂ?*/\\\\\\\\r\\\\\\\\nconst MILLIMETRES_TO_METRES = 0.001\\\\\\\\r\\\\\\\\n/** ???뵄??援ㅶ쉸?ｊ콢??鼇앸뎾?띹い琉맡??앹뵄?寃밴괏??リ쿁??뉕께?類쏄텏??녠틓畑대갚???ｊ쾼??Ｂ?*/\\\\\\\\r\\\\\\\\nconst CYLINDER_RADIAL_SEGMENTS = 8\\\\\\\\r\\\\\\\\nconst Y_AXIS = new THREE.Vector3(0, 1, 0)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport interface RebarModelInput {\\\\\\\\r\\\\\\\\n  project: Project\\\\\\\\r\\\\\\\\n  rebars: Rebar[]\\\\\\\\r\\\\\\\\n  /** 癲듼몼怡???亦껋쉧?洹쏅닧?硫κ틫?諛㏃Ŋ?뤴몺???횈??ｊ쾽?洹잜렫??(PDL1.0)??*/\\\\\\\\r\\\\\\\\n  locale: Locale\\\\\\\\r\\\\\\\\n  /** ??몄땠?誘ｌ퐴??ｊ쾸??꿸쾼??ｊ쾫??볤뮈?癒┑洹숆텭??덇텥??껉틬??귥㉫鶯ㅳ뢿嫄?臾됱툙??Ｂ怨뀀렠癲ル뿣寃?琉듦괍??껉콢??*/\\\\\\\\r\\\\\\\\n  unsupportedMemberIds?: ReadonlySet<string>\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ??덇쿉??꿸국??寃??뉕쿁畑댁엺?뉐춢?(mm)?洹욌돕??귢쿁 rebarRadius ?????띻턀??산괵??嫄?怨κ쾽\\\\\\\\r\\\\\\\\n * ??凉???14??.6??꿸쾽勇싥굛援??쇨굴**?뤴몺???*???怨ル???겷??ｊ쾸??リ덱?誘?뒾??닿쾹 D25 ??\\\\\\\\n * ??40 ??吏???괼??怡??κ덱??Ｂ洹앹럱??띕닧??ｊ쿂畑댁엺???⑸닧??뼘?\\\\\\\\n *\\\\\\\\r\\\\\\\\n * 勇싥굛嫄?議쇨괩???쿂?곷뀍援??껉콢 ??翁?異?誘↔굉????臾녾쾼?袁좉턄??듬쭚癲ル뿣援??산깻?硫⑤??ｊ데??닿탾?蹂앷쿁\\\\\\\\r\\\\\\\\n * ??욱뫔??ｊ덩?酉⑷데??寃?媛턷ildingLayout ??ｊ탾??ｊ굄??щ퉲?誘ㅻ???뼘洹욌렣?諛ㅺ굵?臾덉릉?롫ı寃??산데??┑?\\\\\\\\n * 勇싥굛嫄?????ｊ콢??寃볣턁?몄돭??㈒욇펶?援??鍮??mm ??산깻??μ묽?節껉굴?뉍뼹????닧??Ｂ?\\\\\\\\n *\\\\\\\\r\\\\\\\\n * ??덇쿉??꿸쿁亦?寃?諛ㅺ국??援??寃?硫κ광??산괵??껉콢 ??沃ㅻㅇ????Ŋ?琉듦쾫??녾쾹??3D ??痢ら뇦硫κ굵?臾녾괏\\\\\\\\r\\\\\\\\n * 若뱀눤寃??猷?袁좉께??뉕쾽??껉데?洹쏇룋?琉듦쿁???껈뭣酉닿깻??barDiameter ?議셋愿틃main ??由??븍폕?寃밴쿂\\\\\\\\r\\\\\\\\n * ??ｊ틬??ｊ튃?猿곴텥?誘ｍ뫔??⑺룋?琉삳렠癲?(BarSize) ??ｊ괍??ｊ괩??Β怨⒲꽬?節덉?畑댁떑諭??K13???3 ??\\\\\\\\n * 畑뱀뻼嫄?????リ덱??痢?????눆?????ｊ뎌畑대?援??녾탽????類쏄쾸 (ADR-026)?怨ッ??ｊ쿂翁?異??\\\\\\\\n * ?琉듦괜??寃?蹂앷괭???쿂俑앹쉷嫄??껉콢??\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction trueRadiusMm(size: ShearBarSize): number {\\\\\\\\r\\\\\\\\n  return barDiameter(size) / 2\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction trueRadiusMetres(size: ShearBarSize): number {\\\\\\\\r\\\\\\\\n  return trueRadiusMm(size) * MILLIMETRES_TO_METRES\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction metres([x, y, z]: readonly number[]): THREE.Vector3 {\\\\\\\\r\\\\\\\\n  return new THREE.Vector3(x, y, z).multiplyScalar(MILLIMETRES_TO_METRES)\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * 1??嫄??녠뭄?猿곴땅?款寃??산데??┑?鼇앸뎾?띹い琉맡??с걤?怨κ쾼?袁㏂꽬??꿸괵??源??꿸텕??ｊ쾽??껉데??\\\\\\\\n * ???뵄??六??꿸튆?款爰??⑤┴??낃괜?怨⑸꺐?湲깃쿆???쾱塋딅뿥夷??귥１??ｊ쾸?酉⑷굉\\\\\\\\r\\\\\\\\n * (glTF ??EXT_mesh_gpu_instancing)??\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction instancedRebar(\\\\\\\\r\\\\\\\\n  key: string,\\\\\\\\r\\\\\\\\n  instances: RebarInstance[],\\\\\\\\r\\\\\\\\n  material: THREE.Material,\\\\\\\\r\\\\\\\\n): THREE.InstancedMesh {\\\\\\\\r\\\\\\\\n  const { size, role } = instances[0]\\\\\\\\r\\\\\\\\n  const radius = trueRadiusMetres(size)\\\\\\\\r\\\\\\\\n  const geometry = new THREE.CylinderGeometry(\\\\\\\\r\\\\\\\\n    radius,\\\\\\\\r\\\\\\\\n    radius,\\\\\\\\r\\\\\\\\n    1,\\\\\\\\r\\\\\\\\n    CYLINDER_RADIAL_SEGMENTS,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  const mesh = new THREE.InstancedMesh(geometry, material, instances.length)\\\\\\\\r\\\\\\\\n  mesh.name = `${role} ${size}`\\\\\\\\r\\\\\\\\n  mesh.userData.groupKey = key\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  // ?猷붽괵0????蹂앷쿂?款寃????pathRuns ???┴??딄때?????꿸뎌?釉낅펻??ｊ괼??껉콢??ｊ덩??\\\\\\\\n  // (geometry.test.ts ???럳畑댁떏嫄??됯콢???洹앹뵊??ｊ쿃?녾껸援??뚮꺐??(scale 0) ??ｊ쾼??승?\\\\\\\\n  // EXT_mesh_gpu_instancing ?????띕닧??ｊ쾸 Matrix4.decompose ??1/0 ?誘ㅻ읈?臾녾쾷\\\\\\\\r\\\\\\\\n  // ??녿묫??NaN ??寃??file ??⑦렫??Ｂ洹숆괭?蹂앷쾸??덇뎐??앹뒔??산턄??승怨?닍壤밴낄寃쀨쯁?띠Ŋ?誘㏃죴??Ｂ?\\\\\\\\n  instances.forEach((instance, index) => {\\\\\\\\r\\\\\\\\n    const from = metres(instance.from)\\\\\\\\r\\\\\\\\n    const to = metres(instance.to)\\\\\\\\r\\\\\\\\n    const direction = to.clone().sub(from)\\\\\\\\r\\\\\\\\n    const matrix = new THREE.Matrix4()\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    matrix\\\\\\\\r\\\\\\\\n      .makeRotationFromQuaternion(\\\\\\\\r\\\\\\\\n        new THREE.Quaternion().setFromUnitVectors(\\\\\\\\r\\\\\\\\n          Y_AXIS,\\\\\\\\r\\\\\\\\n          direction.clone().normalize(),\\\\\\\\r\\\\\\\\n        ),\\\\\\\\r\\\\\\\\n      )\\\\\\\\r\\\\\\\\n      .scale(new THREE.Vector3(1, direction.length(), 1))\\\\\\\\r\\\\\\\\n      .setPosition(from.clone().add(to).multiplyScalar(0.5))\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    mesh.setMatrixAt(index, matrix)\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  mesh.instanceMatrix.needsUpdate = true\\\\\\\\r\\\\\\\\n  return mesh\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction concreteMesh(box: ConcreteBox, material: THREE.Material): THREE.Mesh {\\\\\\\\r\\\\\\\\n  const [width, height, depth] = box.size\\\\\\\\r\\\\\\\\n  const mesh = new THREE.Mesh(\\\\\\\\r\\\\\\\\n    new THREE.BoxGeometry(\\\\\\\\r\\\\\\\\n      width * MILLIMETRES_TO_METRES,\\\\\\\\r\\\\\\\\n      height * MILLIMETRES_TO_METRES,\\\\\\\\r\\\\\\\\n      depth * MILLIMETRES_TO_METRES,\\\\\\\\r\\\\\\\\n    ),\\\\\\\\r\\\\\\\\n    material,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  mesh.name = `${box.kind} ${box.memberId}`\\\\\\\\r\\\\\\\\n  mesh.position.copy(metres(box.center))\\\\\\\\r\\\\\\\\n  return mesh\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * 鶯ㅻ갊???⑤쳹??묐┼??⑸듊?臾녾데?洹쏅┴????13 ???탾 ?洹숆쿃??ъ땠 ??畑룸겲??怨?땠 ?????源??덇퉳??ｊ굉????\\\\\\\\n * ??ｊ괩?戮㏐쾫??뚭깻???럨??귢쾹??ｊ굄庸눫??κ쾸??뉕콫??ｊ턄??닿쾽??산데??녾탽??(ADR-008)??\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction groupForExport(\\\\\\\\r\\\\\\\\n  instances: RebarInstance[],\\\\\\\\r\\\\\\\\n): Map<string, RebarInstance[]> {\\\\\\\\r\\\\\\\\n  const groups = new Map<string, RebarInstance[]>()\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  for (const instance of instances) {\\\\\\\\r\\\\\\\\n    const key = `${instance.role}|${instance.size}`\\\\\\\\r\\\\\\\\n    const group = groups.get(key)\\\\\\\\r\\\\\\\\n    if (group === undefined) groups.set(key, [instance])\\\\\\\\r\\\\\\\\n    else group.push(instance)\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return groups\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * 癲껊뛻六??뉕데?遺듦쾹??3D ?뉍뼹??(PRD 吏?)?洹욌돕??귢쿁?寃밴틒?猿곴퉳??ｌ몣??귢틫鶯ㅺ릴寃?款援??껉콢 ??\\\\\\\\n * 沃ㅻ뿣嫄??ｊ굴?怨κ쿁?蹂잙걖???콟?節껉쾷?뉍뼹???????쾸??寃?袁졖?\\\\\\\\n */\\\\\\\\r\\\\\\\\nexport function buildRebarScene(input: RebarModelInput): THREE.Scene {\\\\\\\\r\\\\\\\\n  const layout = buildingLayout(\\\\\\\\r\\\\\\\\n    input.project,\\\\\\\\r\\\\\\\\n    input.rebars,\\\\\\\\r\\\\\\\\n    input.unsupportedMemberIds ?? new Set<string>(),\\\\\\\\r\\\\\\\\n    trueRadiusMm,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  const scene = new THREE.Scene()\\\\\\\\r\\\\\\\\n  scene.name = input.project.name\\\\\\\\r\\\\\\\\n  // GLTFExporter ??userData ??extras ???괼?????띕닧??뼘愿푡TF ??ⓦ??二??苑?袁좉쿁????\\\\\\\\n  // xlsx ???琉듦괍??⑥１??ъ툧?酉몄죯?議쇨묍??湲??寃볟＄蹂앷굴??ｊ탾??援?蹂앷괭??㏃돭?????酉대걗?뤴몺???⑸돐勇?\\\\\\\\n  // ?뤴몺????볢틡猿녿룯??ㅽ뜞?琉뱀뫒??산쾸?洹숆쾫??됀怨レ럱??띕닧??ｊ쿁麗몃슜??遺듦쾹??λ??ｊ데?洹숆쿁???쿂??껉콢??\\\\\\\\n  //\\\\\\\\r\\\\\\\\n  // 癲뚢뼯嫄??寃?袁ㅼ땠??ruleHits ?議쇨괩?議셋援뷿sx ??QuantityLine.rules ?誘?コ??ｊ쿁??\\\\\\\\n  // ?轅⑥ⅴ??롪괏鼇씲?뤿슗伊??援??Ｂ媛푡b ??り괍??곌쿁?????곌쾸?洹숆쾫??鍮?琉듦쾸??寃??????リ쿁??녠뎌\\\\\\\\r\\\\\\\\n  // ??ｊ께??껉콢??띤닂??꿸쿁?酉대걗??Ｂ怨ル퉲?琉듦굵?臾녾쿁?諛⑸뻿?誘μ낌??됯쾼?袁졖洹앸뻤?硫κ쾹??ｊ쾷????硫κ쿂\\\\\\\\r\\\\\\\\n  // 畑댁엻由??xlsx ??⑤┴鼇씲??(?轅⑥ⅴ??롪쿁?酉대걗 `?怨덈눉癲⑤씤痢?酉명떖` ???怨ル쫶??堉??議?議쇨쾹??ｊ쾷\\\\\\\\r\\\\\\\\n  // 鶯ㅒ?뱚??닿쾽?洹앸엑??⑦렫?節껉쾷?袁좉데)??\\\\\\\\n  scene.userData = modelNotices(\\\\\\\\r\\\\\\\\n    input.rebars.flatMap(({ ruleHits }) => ruleHits),\\\\\\\\r\\\\\\\\n    input.locale,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const rebarGroup = new THREE.Group()\\\\\\\\r\\\\\\\\n  rebarGroup.name = '?袁ㅼ땠'\\\\\\\\r\\\\\\\\n  const rebarMaterial = new THREE.MeshStandardMaterial({\\\\\\\\r\\\\\\\\n    color: 0x9aa0a6,\\\\\\\\r\\\\\\\\n    metalness: 0.6,\\\\\\\\r\\\\\\\\n    roughness: 0.45,\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n  rebarMaterial.name = '?袁ㅼ땠'\\\\\\\\r\\\\\\\\n  for (const [key, instances] of groupForExport(layout.rebar)) {\\\\\\\\r\\\\\\\\n    rebarGroup.add(instancedRebar(key, instances, rebarMaterial))\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const concreteGroup = new THREE.Group()\\\\\\\\r\\\\\\\\n  concreteGroup.name = '??덇틡??爰??덇퉱'\\\\\\\\r\\\\\\\\n  const concreteMaterial = new THREE.MeshStandardMaterial({\\\\\\\\r\\\\\\\\n    color: 0xd6d3cb,\\\\\\\\r\\\\\\\\n    transparent: true,\\\\\\\\r\\\\\\\\n    opacity: 0.25,\\\\\\\\r\\\\\\\\n    roughness: 0.9,\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n  concreteMaterial.name = '??덇틡??爰??덇퉱'\\\\\\\\r\\\\\\\\n  for (const box of layout.boxes) {\\\\\\\\r\\\\\\\\n    concreteGroup.add(concreteMesh(box, concreteMaterial))\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  scene.add(rebarGroup, concreteGroup)\\\\\\\\r\\\\\\\\n  return scene\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction disposeScene(scene: THREE.Scene): void {\\\\\\\\r\\\\\\\\n  const materials = new Set<THREE.Material>()\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  scene.traverse((object) => {\\\\\\\\r\\\\\\\\n    const mesh = object as THREE.Mesh\\\\\\\\r\\\\\\\\n    if (!mesh.isMesh) return\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    mesh.geometry.dispose()\\\\\\\\r\\\\\\\\n    for (const material of [mesh.material].flat()) materials.add(material)\\\\\\\\r\\\\\\\\n    if ((object as THREE.InstancedMesh).isInstancedMesh) {\\\\\\\\r\\\\\\\\n      ;(object as THREE.InstancedMesh).dispose()\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  for (const material of materials) material.dispose()\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function rebarModelFileName(projectName: string): string {\\\\\\\\r\\\\\\\\n  return projectFileName(projectName).replace(/\\\\\\\\\\\\\\\\.json$/, '.glb')\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport async function exportRebarGlb(input: RebarModelInput): Promise<void> {\\\\\\\\r\\\\\\\\n  const scene = buildRebarScene(input)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  try {\\\\\\\\r\\\\\\\\n    // ?類잛돦 import ??try ??由??㏃돭?琉돠洹숆괭?????㏐틡畑댁떏嫄??됯콢??γ뀅??ｊ쿂??뉕괵??\\\\\\\\n    // ??쿴ree ??二???짎??ｊ쾼?袁졖?꿸괭???쾸?怨⑹㉫??㏃돭?琉듦쾹1鼇앸뎾???곌뎐??\\\\\\\\n    // CylinderGeometry ?誘ㅻ젫?蹂앷굵??뉕께???쾷??ｊ괭???쾽??껉데??\\\\\\\\n    const { GLTFExporter } = await import(\\\\\\\\r\\\\\\\\n      'three/examples/jsm/exporters/GLTFExporter.js'\\\\\\\\r\\\\\\\\n    )\\\\\\\\r\\\\\\\\n    const output = await new GLTFExporter().parseAsync(scene, { binary: true })\\\\\\\\r\\\\\\\\n    const blob = new Blob([output as ArrayBuffer], {\\\\\\\\r\\\\\\\\n      type: 'model/gltf-binary',\\\\\\\\r\\\\\\\\n    })\\\\\\\\r\\\\\\\\n    const url = URL.createObjectURL(blob)\\\\\\\\r\\\\\\\\n    const anchor = document.createElement('a')\\\\\\\\r\\\\\\\\n    anchor.href = url\\\\\\\\r\\\\\\\\n    anchor.download = rebarModelFileName(input.project.name)\\\\\\\\r\\\\\\\\n    anchor.style.display = 'none'\\\\\\\\r\\\\\\\\n    document.body.appendChild(anchor)\\\\\\\\r\\\\\\\\n    anchor.click()\\\\\\\\r\\\\\\\\n    anchor.remove()\\\\\\\\r\\\\\\\\n    URL.revokeObjectURL(url)\\\\\\\\r\\\\\\\\n  } finally {\\\\\\\\r\\\\\\\\n    // 1鼇앸뎾?띹い琉맡????湲깃뎌 GPU ???툙??ｊ굴??뉕께??ｊ괼??껉콢??\\\\\\\\n    disposeScene(scene)\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  decomposeGirderMainRow,\\\\\\\\r\\\\\\\\n  type GirderSection,\\\\\\\\r\\\\\\\\n  type Member,\\\\\\\\r\\\\\\\\n} from '../model/member'\\\\\\\\r\\\\\\\\nimport type { GirderRun, GirderSpan } from '../model/project'\\\\\\\\r\\\\\\\\nimport type { Rebar, RebarZone, Vec3 } from '../model/rebar'\\\\\\\\r\\\\\\\\nimport { MemberUnsupportedError } from '../model/unsupported'\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  coverConditions,\\\\\\\\r\\\\\\\\n  lookupRule,\\\\\\\\r\\\\\\\\n  lookupRuleSeries,\\\\\\\\r\\\\\\\\n} from '../rules/lookup'\\\\\\\\r\\\\\\\\nimport type { RuleHit, RulePack } from '../rules/types'\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  barDiameter,\\\\\\\\r\\\\\\\\n  resolveGirderEnd,\\\\\\\\r\\\\\\\\n  type GirderEndDetail,\\\\\\\\r\\\\\\\\n} from './girder-ends'\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  bandedSpliceRule,\\\\\\\\r\\\\\\\\n  distributionCount,\\\\\\\\r\\\\\\\\n  hoopDesignLengthMm,\\\\\\\\r\\\\\\\\n  intervalSpliceCount,\\\\\\\\r\\\\\\\\n  spliceCount,\\\\\\\\r\\\\\\\\n  spliceLengthMm,\\\\\\\\r\\\\\\\\n  widthTieDesignLengthMm,\\\\\\\\r\\\\\\\\n  type SpliceBand,\\\\\\\\r\\\\\\\\n} from './measurement'\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  stirrupPositions,\\\\\\\\r\\\\\\\\n  symmetricInwardDirections,\\\\\\\\r\\\\\\\\n} from './stirrup-layout'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport interface GirderRebarInput {\\\\\\\\r\\\\\\\\n  run: GirderRun\\\\\\\\r\\\\\\\\n  section: GirderSection\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\\\\\\\r\\\\\\\\n  if (rule.unit === 'mm') return rule.value\\\\\\\\r\\\\\\\\n  if (rule.unit === 'd' && diameter !== undefined) {\\\\\\\\r\\\\\\\\n    return rule.value * diameter\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  throw new Error(\\\\\\\\r\\\\\\\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction shearBarDiameter(size: GirderSection['stirrup']['size']): number {\\\\\\\\r\\\\\\\\n  const diameter = Number(size.replace(/^[A-Z]+/, ''))\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\\\\\\\r\\\\\\\\n    throw new Error(`Invalid ShearBarSize: ${size}`)\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return diameter\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction hookTailLengthMm(rule: RuleHit, size: GirderSection['stirrup']['size']): number {\\\\\\\\r\\\\\\\\n  return millimetres(rule, shearBarDiameter(size))\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction twoInwardTails(\\\\\\\\r\\\\\\\\n  origin: Vec3,\\\\\\\\r\\\\\\\\n  lengthMm: number,\\\\\\\\r\\\\\\\\n  directions: [[number, number], [number, number]],\\\\\\\\r\\\\\\\\n): [Vec3, Vec3] {\\\\\\\\r\\\\\\\\n  return directions.map(([first, second]) => {\\\\\\\\r\\\\\\\\n    const magnitude = Math.hypot(first, second)\\\\\\\\r\\\\\\\\n    return [\\\\\\\\r\\\\\\\\n      origin[0],\\\\\\\\r\\\\\\\\n      origin[1] + (lengthMm * first) / magnitude,\\\\\\\\r\\\\\\\\n      origin[2] + (lengthMm * second) / magnitude,\\\\\\\\r\\\\\\\\n    ]\\\\\\\\r\\\\\\\\n  }) as [Vec3, Vec3]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction uniqueRuleHits(hits: RuleHit[]): RuleHit[] {\\\\\\\\r\\\\\\\\n  return [...new Set(hits)]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction endFormula(label: string, detail: GirderEndDetail): string {\\\\\\\\r\\\\\\\\n  if (detail.kind === '??뱁뇡畑댁떓?') {\\\\\\\\r\\\\\\\\n    return `${label} ??뱁뇡畑댁떓? L1 ${detail.lengthMm}`\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  // lengthMm夷똯rojectionMm ?? 筌ㅼ뮇?쇘㎉????max 野껉퀗?????L1夷똋a 嚥???볥┛??롢늺 ??.3.4夷?r\\\\\\\\n  // ??.3.5 ?? ??鈺곌퀬釉??野꺜?醫롮쁽?癒?쓺 域뱀눊援끻첎? ????野껉퍔?앮에?癰귣똻??? 筌왖獄쏄퀬釉?????獄쏆빜???\\\\\\\\r\\\\\\\\n  // max 揶쎛 椰꾨챶??????怨? ???뿩??듯맧?猷붋?우뵠 ?袁⑤빍??**???퉻**??????5.3.4(5)(影?(a) 揶쎛\\\\\\\\r\\\\\\\\n  // ???퉻?? (b) 揶쎛 俑앹늼鍮????묐립??雅뚯눖?嚥?(b) ?????퉻 ??묐립??곗쨮 ??뤾텦????쑨???뺣뼄.\\\\\\\\r\\\\\\\\n  const verticalTailMm = detail.lengthMm - detail.projectionMm\\\\\\\\r\\\\\\\\n  return (\\\\\\\\r\\\\\\\\n    `${label} ??됱럧?誘ｌ르?? ???퉻 ${detail.lengthMm}` +\\\\\\\\r\\\\\\\\n    `塋?a) ??뱁뇡畑댁떓? L1 ${detail.straightMinimumMm} ??` +\\\\\\\\r\\\\\\\\n    `(b) ?類앹돺塋딅뿤??猷앺닎??${detail.tailMinimumMm} ???루쳥? +\\\\\\\\r\\\\\\\\n    `塋딅뛼?들펶?塋??類앹돺 ${detail.projectionMm}塋?c) La ${detail.laMm} ??` +\\\\\\\\r\\\\\\\\n    `?湲깃굘?苑몄?뮊鶯ㅺ릿???${detail.projectionMinimumMm} ???루쳥?塋??洹욎럪俑앹늼鍮?${verticalTailMm}塋?\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction runCoreFormula(run: GirderRun): string {\\\\\\\\r\\\\\\\\n  const clearTerms = run.spans.map(({ clear }) => clear).join('塋?)\\\\\\\\r\\\\\\\\n  const intermediateSupportTerms = run.spans\\\\\\\\r\\\\\\\\n    .slice(0, -1)\\\\\\\\r\\\\\\\\n    .map(({ endSupportLengthAlongAxisMm }) => endSupportLengthAlongAxisMm)\\\\\\\\r\\\\\\\\n    .join('塋?)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return intermediateSupportTerms === ''\\\\\\\\r\\\\\\\\n    ? `??얩?猷붽괵 ${clearTerms}`\\\\\\\\r\\\\\\\\n    : `??얩?猷붽괵 ${clearTerms} 塋?鼇?堉?湲깃굘??${intermediateSupportTerms}`\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction mainPoints(\\\\\\\\r\\\\\\\\n  clearMm: number,\\\\\\\\r\\\\\\\\n  y: number,\\\\\\\\r\\\\\\\\n  z: number,\\\\\\\\r\\\\\\\\n  start: GirderEndDetail,\\\\\\\\r\\\\\\\\n  end: GirderEndDetail,\\\\\\\\r\\\\\\\\n): Rebar['points'] {\\\\\\\\r\\\\\\\\n  const points: Rebar['points'] = []\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (start.kind === '??뱁뇡畑댁떓?') {\\\\\\\\r\\\\\\\\n    points.push([-start.lengthMm, y, z])\\\\\\\\r\\\\\\\\n  } else {\\\\\\\\r\\\\\\\\n    const verticalTailMm = start.lengthMm - start.projectionMm\\\\\\\\r\\\\\\\\n    const direction = start.direction === '鼇? ? 1 : -1\\\\\\\\r\\\\\\\\n    points.push(\\\\\\\\r\\\\\\\\n      [\\\\\\\\r\\\\\\\\n        -start.projectionMm,\\\\\\\\r\\\\\\\\n        y + direction * verticalTailMm,\\\\\\\\r\\\\\\\\n        z,\\\\\\\\r\\\\\\\\n      ],\\\\\\\\r\\\\\\\\n      [-start.projectionMm, y, z],\\\\\\\\r\\\\\\\\n    )\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (end.kind === '??뱁뇡畑댁떓?') {\\\\\\\\r\\\\\\\\n    points.push([clearMm + end.lengthMm, y, z])\\\\\\\\r\\\\\\\\n  } else {\\\\\\\\r\\\\\\\\n    const verticalTailMm = end.lengthMm - end.projectionMm\\\\\\\\r\\\\\\\\n    const direction = end.direction === '鼇? ? 1 : -1\\\\\\\\r\\\\\\\\n    points.push(\\\\\\\\r\\\\\\\\n      [clearMm + end.projectionMm, y, z],\\\\\\\\r\\\\\\\\n      [\\\\\\\\r\\\\\\\\n        clearMm + end.projectionMm,\\\\\\\\r\\\\\\\\n        y + direction * verticalTailMm,\\\\\\\\r\\\\\\\\n        z,\\\\\\\\r\\\\\\\\n      ],\\\\\\\\r\\\\\\\\n    )\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return points\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * 塋딅뜉?녺쳥?れ쪎2) ?????삠?洹싴맟?酉대듊?洹숆데??ｊ쿂??ｊ틬??ｊ튃?猿곴텥??㏐뎔?怨κ데??寃?怨?１?誘↔국??寃??뺛걤????\\\\\\\\n * 鼇앸봼??誘ㅻ샍??녾쾼?袁μ１???耶껊슔寃?酉대듊??ｊ쾼??????듭르??bandedSpliceRule ??ｊ턀??Ｂ?\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction continuousGirderBands(pack: RulePack): SpliceBand[] {\\\\\\\\r\\\\\\\\n  const counts = lookupRuleSeries(\\\\\\\\r\\\\\\\\n    pack,\\\\\\\\r\\\\\\\\n    'measure.splice.girder.continuous',\\\\\\\\r\\\\\\\\n    'band',\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  const upperBounds = new Map(\\\\\\\\r\\\\\\\\n    lookupRuleSeries(\\\\\\\\r\\\\\\\\n      pack,\\\\\\\\r\\\\\\\\n      'measure.splice.girder.continuous.band.upper',\\\\\\\\r\\\\\\\\n      'band',\\\\\\\\r\\\\\\\\n    ).map((rule) => [rule.conditions.band, rule]),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return counts.map((countRule) => ({\\\\\\\\r\\\\\\\\n    countRule,\\\\\\\\r\\\\\\\\n    upperBoundRule: upperBounds.get(countRule.conditions.band) ?? null,\\\\\\\\r\\\\\\\\n  }))\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\ninterface GirderSplice {\\\\\\\\r\\\\\\\\n  countPerBar: number\\\\\\\\r\\\\\\\\n  lengthMm: number\\\\\\\\r\\\\\\\\n  rules: RuleHit[]\\\\\\\\r\\\\\\\\n  basis: string\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ??κ괼癲ル뿣寃쀦납?곷렪 (?怨덈눉癲⑤씤痢?酉명떖)??\\\\\\\\n *\\\\\\\\r\\\\\\\\n * ??꿸틡???諛ㅺ튃??먮뭄鼇앸벥寃??Β?ぢ節뉙뀯??산데閭잕낄寃???퉻??ｊ뎀??녾데鼇앹궗異??꿸쾼??寃?塋딅뜉?녺쳥?れ쪎2) ??\\\\\\\\n * ?酉대듊?뤴벀嫄?1??㏓렣4) ?誘?닍?硫κ광??산데???諛ㅺ튃??덇쿁??꿸틡?????伊??껉쿁??⑸┴??꿸굴?議쇨괼?硫κ광??\\\\\\\\n * 1??㏓렣4) ???뙒??승怨⑺뫔?遺듦쾹??鍮?類쏄쿁??놃맍??る퉲??援??\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction spliceFrom(\\\\\\\\r\\\\\\\\n  countRule: RuleHit,\\\\\\\\r\\\\\\\\n  countPerBar: number,\\\\\\\\r\\\\\\\\n  basis: string,\\\\\\\\r\\\\\\\\n  section: GirderSection,\\\\\\\\r\\\\\\\\n  lapRule: RuleHit,\\\\\\\\r\\\\\\\\n  lapLengthMm: number,\\\\\\\\r\\\\\\\\n  pack: RulePack,\\\\\\\\r\\\\\\\\n): GirderSplice {\\\\\\\\r\\\\\\\\n  const factorRule = lookupRule(pack, 'measure.splice.length.factor', {\\\\\\\\r\\\\\\\\n    method: section.spliceMethod,\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n  const lengthMm = spliceLengthMm(countPerBar, lapLengthMm, factorRule)\\\\\\\\r\\\\\\\\n  const rules = [countRule, factorRule]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (lengthMm > 0) rules.push(lapRule)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return { countPerBar, lengthMm, rules, basis }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * 1??㏓렣4) ??耶껉풝嫄???쿁?猷붽괵???뺡턁?꿸쾸?寃밴콫??Ｂ洹쇑?㏃쪎????猷붽쾽?琉듦굴??ㅻ쭚癲ル뿣??꿸쾸??껉콢?袁ㅼ땠\\\\\\\\r\\\\\\\\n * 塋딅뛼???伊????κ괼癲ル뿣爰??ｊ맙??沅?類잛땠塋딅맓寃?蹂앷괭???뙒??고렩塋딅뜉?녺쳥?れ쪎2) ??녾굵???럱??껎렫??\\\\\\\\n */\\\\\\\\r\\\\\\\\nfunction intervalSplice(\\\\\\\\r\\\\\\\\n  label: string,\\\\\\\\r\\\\\\\\n  section: GirderSection,\\\\\\\\r\\\\\\\\n  designLengthBeforeSpliceMm: number,\\\\\\\\r\\\\\\\\n  lapRule: RuleHit,\\\\\\\\r\\\\\\\\n  lapLengthMm: number,\\\\\\\\r\\\\\\\\n  pack: RulePack,\\\\\\\\r\\\\\\\\n): GirderSplice {\\\\\\\\r\\\\\\\\n  const countRule = lookupRule(pack, 'measure.splice.interval', {\\\\\\\\r\\\\\\\\n    size: section.main.size,\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return spliceFrom(\\\\\\\\r\\\\\\\\n    countRule,\\\\\\\\r\\\\\\\\n    intervalSpliceCount(designLengthBeforeSpliceMm, countRule),\\\\\\\\r\\\\\\\\n    `${label} ?袁ㅼ땠??鍮??${designLengthBeforeSpliceMm} 泥?${countRule.value}mm ?遺듦쾹塋딅뛽鍮?琉뱀컞蒻몄μ쓢濚?1??㏓렣4)塋?,\\\\\\\\r\\\\\\\\n    section,\\\\\\\\r\\\\\\\\n    lapRule,\\\\\\\\r\\\\\\\\n    lapLengthMm,\\\\\\\\r\\\\\\\\n    pack,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction resolveSplice(\\\\\\\\r\\\\\\\\n  run: GirderRun,\\\\\\\\r\\\\\\\\n  section: GirderSection,\\\\\\\\r\\\\\\\\n  designLengthBeforeSpliceMm: number,\\\\\\\\r\\\\\\\\n  lapRule: RuleHit,\\\\\\\\r\\\\\\\\n  lapLengthMm: number,\\\\\\\\r\\\\\\\\n  pack: RulePack,\\\\\\\\r\\\\\\\\n): GirderSplice {\\\\\\\\r\\\\\\\\n  if (run.members.length === 1) {\\\\\\\\r\\\\\\\\n    return intervalSplice(\\\\\\\\r\\\\\\\\n      '??딅뼎閭?,\\\\\\\\r\\\\\\\\n      section,\\\\\\\\r\\\\\\\\n      designLengthBeforeSpliceMm,\\\\\\\\r\\\\\\\\n      lapRule,\\\\\\\\r\\\\\\\\n      lapLengthMm,\\\\\\\\r\\\\\\\\n      pack,\\\\\\\\r\\\\\\\\n    )\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const countRule = bandedSpliceRule(\\\\\\\\r\\\\\\\\n    run.coreLengthMm,\\\\\\\\r\\\\\\\\n    continuousGirderBands(pack),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return spliceFrom(\\\\\\\\r\\\\\\\\n    countRule,\\\\\\\\r\\\\\\\\n    spliceCount(countRule),\\\\\\\\r\\\\\\\\n    `?節뉙뀯閭?閭잕낄寃?猷붽괵 ${run.coreLengthMm}塋딅뛽鍮?琉뱀컞蒻몄μ쓢濚?2塋딅뜉?녺쳥?れ쪎2)塋?,\\\\\\\\r\\\\\\\\n    section,\\\\\\\\r\\\\\\\\n    lapRule,\\\\\\\\r\\\\\\\\n    lapLengthMm,\\\\\\\\r\\\\\\\\n    pack,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction generateMain(\\\\\\\\r\\\\\\\\n  input: GirderRebarInput,\\\\\\\\r\\\\\\\\n  pack: RulePack,\\\\\\\\r\\\\\\\\n  coverRule: RuleHit,\\\\\\\\r\\\