E0B\\\\u7AEF\\\\u7B4B'\\nconst CONFIRMED = '\\\\u78BA\\\\u8A8D\\\\u6E08\r\n'\\n\\nfunction changeG2Pitch(project = createSampleProject()): Project {\\n  const next = cloneProject(project)\\n  next.s\r\nections = next.sections.map((section) =>\\n    section.id === 'section-G2' && section.kind === '\\\\u5927\\\\u6881'\\n      ?\r\n { ...section, stirrup: { ...section.stirrup, pitch: 200 } }\\n      : section,\\n  )\\n  return next\\n}\\n\\nfunction chang\r\neC1(project = createSampleProject()): Project {\\n  const next = cloneProject(project)\\n  next.sections = next.sections.\r\nmap((section) =>\\n    section.id === 'section-C1' && section.kind === '\\\\u67F1'\\n      ? { ...section, b: 900 }\\n      \r\n: section,\\n  )\\n  return next\\n}\\n\\nfunction checkInput(\\n  project = createSampleProject(),\\n  jointId = '1F-X2Y1',\\n\r\n  clearance: number | null = null,\\n  exclusions = [],\\n) {\\n  const takeoff = buildTakeoff(project)\\n  const resolutio\r\nn = resolveJoint(project, jointId)\\n  if (resolution.status !== 'joint') throw new Error('joint fixture expected')\\n  c\r\nonst unsupportedMemberIds = new Set(takeoff.unsupportedMembers.map(({ memberId }) => memberId))\\n  const snapshot = rev\r\niewSnapshot(project)\\n  return {\\n    project,\\n    rebars: takeoff.rebars,\\n    takeoff,\\n    unsupportedMemberIds,\\n \r\n   joint: resolution.joint,\\n    settings: {\\n      clearance: clearance === null\\n        ? null\\n        : {\\n       \r\n     valueMm: clearance,\\n            source: '\\\\u5229\\\\u7528\\\\u8005\\\\u5165\\\\u529B' as const,\\n            scope: 'coun\r\nterexample',\\n            enteredAt: '2026-09-17T00:00:00Z',\\n            note: 'temporary verification input',\\n      \r\n    },\\n    },\\n    exclusions,\\n    fingerprints: snapshot.fingerprints,\\n  }\\n}\\n\\nfunction item(project: Project, ta\r\nrget: ElementRef, finding?: RecordedFinding): ReviewItem {\\n  const snapshot = reviewSnapshot(project)\\n  const memberI\r\nds = elementRefTargets([target], project).memberIds\\n  snapshot.fingerprints = {\\n    ...snapshot.fingerprints,\\n    me\r\nmbers: Object.fromEntries(memberIds.map((memberId) => [memberId, snapshot.fingerprints.members[memberId]])),\\n  }\\n  re\r\nturn {\\n    id: 'item-1',\\n    createdAt: '2026-09-17T10:00:00+09:00',\\n    updatedAt: '2026-09-17T10:00:00+09:00',\\n  \r\n  targets: [target],\\n    title: 'review',\\n    body: 'body',\\n    status: CONFIRMED,\\n    confirmations: [],\\n    snap\r\nshot: reviewViewerSnapshot(snapshot.fingerprints),\\n    ...(finding ? { finding } : {}),\\n  }\\n}\\n\\nfunction workPackag\r\ne(entry: WorkPackage['checklist'][number]): WorkPackage {\\n  return {\\n    id: 'package-1',\\n    name: 'package',\\n    \r\ntargets: [{ kind: 'member', memberId: '1F-X1Y1' }],\\n    assignee: 'reviewer',\\n    dueDate: null,\\n    checklist: [ent\r\nry],\\n    createdAt: '2026-09-17T10:00:00+09:00',\\n    updatedAt: '2026-09-17T10:00:00+09:00',\\n  }\\n}\\n\\ndescribe('pha\r\nse 47 core counterexamples', () => {\\n  it('finds the upper G1/G2 clash inside the support-column plan region', () => {\r\n\\n    const result = runGeometryCheck(checkInput())\\n    const finding = result.findings.find((entry) =>\\n      entry.k\r\nind === CLASH\\n      && entry.a.role === UPPER\\n      && entry.b.role === UPPER\\n      && entry.a.memberId !== entry.b.\r\nmemberId,\\n    )\\n    expect(finding).toBeDefined()\\n    expect(finding?.clearanceMm).toBeCloseTo(-22, 6)\\n    expect(f\r\ninding?.a.memberId).not.toBe(finding?.b.memberId)\\n    expect(finding?.a.memberId).toMatch(/G[12]/)\\n    expect(finding\r\n?.b.memberId).toMatch(/G[12]/)\\n    for (const point of finding?.closestPoints ?? []) {\\n      expect(point[0]).toBeGre\r\naterThanOrEqual(result.scope.regionMm.x[0])\\n      expect(point[0]).toBeLessThanOrEqual(result.scope.regionMm.x[1])\\n  \r\n    expect(point[2]).toBeGreaterThanOrEqual(result.scope.regionMm.z[0])\\n      expect(point[2]).toBeLessThanOrEqual(res\r\nult.scope.regionMm.z[1])\\n    }\\n  })\\n\\n  it('keeps the 25 mm lower gap at thresholds 24 and 26, including the separat\r\ned-height pair', () => {\\n    const below = runGeometryCheck(checkInput(undefined, undefined, 24))\\n    const above = r\r\nunGeometryCheck(checkInput(undefined, undefined, 26))\\n    expect(below.findings.some(({ kind, clearanceMm }) => kind =\r\n== CLEARANCE && Math.abs(clearanceMm - 25) < 1e-6)).toBe(false)\\n    expect(above.findings.some(({ kind, clearanceMm })\r\n => kind === CLEARANCE && Math.abs(clearanceMm - 25) < 1e-6)).toBe(true)\\n\\n    const project = createSampleProject()\\n\r\n    const takeoff = buildTakeoff(project)\\n    const g1 = takeoff.rebars.find((rebar) => rebar.memberId === '1F-G1-X1Y1\r\n-X' && rebar.role === LOWER)\\n    const g2 = takeoff.rebars.find((rebar) => rebar.memberId === '1F-G2-X2Y1-Y' && rebar.\r\nrole === LOWER)\\n    if (!g1 || !g2) throw new Error('lower-main fixtures expected')\\n    const simplify = (rebar: Reba\r\nr): Rebar => ({\\n      ...rebar,\\n      points: [rebar.points[0], rebar.points[rebar.points.length - 1]],\\n      closed\r\n: false,\\n      hookTails: undefined,\\n    })\\n    const first = buildingLayout(project, [simplify(g1), simplify(g2)], \r\nnew Set(), (size) => barDiameter(size) / 2)\\n    const a = first.rebar.find(({ rebarId }) => rebarId === g1.id)\\n    co\r\nnst b = first.rebar.find(({ rebarId }) => rebarId === g2.id)\\n    if (!a || !b) throw new Error('synthetic layout fixtu\r\nres expected')\\n    const delta = a.from[1] + 48.5 - b.from[1]\\n    const shifted = {\\n      ...simplify(g2),\\n      po\r\nints: simplify(g2).points.map(([x, y, z]) => [x, y + delta, z] as [number, number, number]),\\n    }\\n    const input = \r\ncheckInput()\\n    const result = runGeometryCheck({\\n      ...input,\\n      rebars: [simplify(g1), shifted],\\n      set\r\ntings: { clearance: { valueMm: 26, source: '\\\\u5229\\\\u7528\\\\u8005\\\\u5165\\\\u529B', scope: 'synthetic', enteredAt: '2026-\r\n09-17', note: '' } },\\n    })\\n    const synthetic = result.findings.find(({ clearanceMm }) => Math.abs(clearanceMm - 2\r\n5) < 1e-6)\\n    expect(capsuleClearanceMm(\\n      { from: [0, 0, 0], to: [100, 0, 0], radius: 12.5 },\\n      { from: [0\r\n, 48.5, 0], to: [100, 48.5, 0], radius: 11 },\\n    ).clearanceMm).toBeCloseTo(25, 6)\\n    expect(synthetic).toBeDefined\r\n()\\n    expect(synthetic?.a.size).toBe('D22')\\n    expect(synthetic?.b.size).toBe('D25')\\n  })\\n\\n  it('retains uncheck\r\ned items, has no global pass verdict, and reports no target for columns only', () => {\\n    const input = checkInput()\\\r\nn    const result = runGeometryCheck(input)\\n    expect(result.unchecked.map(({ what }) => what)).toEqual(expect.arrayC\r\nontaining(['\\\\u7D99\\\\u624B\\\\u4F4D\\\\u7F6E', '\\\\u30D1\\\\u30CD\\\\u30EB\\\\u30BE\\\\u30FC\\\\u30F3\\\\u5E2F\\\\u7B4B']))\\n    expect(re\r\nsult.verdict).not.toHaveProperty('overall')\\n    expect(JSON.stringify(result)).not.toContain('\\\\u5408\\\\u683C')\\n    co\r\nnst allTargetIds = new Set(jointRebarMemberIds(input.project, input.joint))\\n    const noTarget = runGeometryCheck({ ..\r\n.input, unsupportedMemberIds: allTargetIds })\\n    expect(noTarget.verdict.clash).toBe('\\\\u691C\\\\u67FB\\\\u5BFE\\\\u8C61\\\\u\r\n306A\\\\u3057')\\n    expect(noTarget.verdict.clearance).toBe('\\\\u691C\\\\u67FB\\\\u5BFE\\\\u8C61\\\\u306A\\\\u3057')\\n    expect(no\r\nTarget.verdict.contact).toBe('\\\\u691C\\\\u67FB\\\\u5BFE\\\\u8C61\\\\u306A\\\\u3057')\\n  })\\n\\n  it('keeps girder clashes while ex\r\ncluding intended same-member contacts only', () => {\\n    const input = checkInput(undefined, undefined, null, [])\\n   \r\n const raw = runGeometryCheck(input)\\n    const excluded = runGeometryCheck({ ...input, exclusions: defaultExclusions('\r\n2026-09-17T00:00:00Z') })\\n    expect(raw.findings.some(({ kind }) => kind === CLASH)).toBe(true)\\n    expect(raw.findi\r\nngs.some(({ kind }) => kind === CONTACT)).toBe(true)\\n    expect(excluded.verdict.excludedCounts[CONTACT]).toBeGreaterT\r\nhan(0)\\n    expect(excluded.findings.some(({ kind, excludedBy }) => kind === CONTACT && excludedBy !== null)).toBe(true\r\n)\\n    expect(excluded.findings.some(({ kind }) => kind === CLASH)).toBe(true)\\n    const [exclusion] = defaultExclusio\r\nns('now')\\n    const contactA = { memberId: 'm1', rebarId: 'a', role: '\\\\u5E2F\\\\u7B4B', size: 'D13' as const, barIndex:\r\n 0, segmentIndex: 0 }\\n    const contactB = { memberId: 'm1', rebarId: 'b', role: '\\\\u4E3B\\\\u7B4B', size: 'D13' as cons\r\nt, barIndex: 0, segmentIndex: 0 }\\n    expect(exclusionMatches(exclusion, CONTACT, contactA, contactB)).toBe(true)\\n   \r\n expect(exclusionMatches({ ...exclusion, scope: { ...exclusion.scope, kinds: [CLASH] } }, CONTACT, contactA, contactB))\r\n.toBe(false)\\n  })\\n\\n  it('rechecks only the G2-dependent joint after a G2 pitch edit', () => {\\n    const baseline = \r\ncreateSampleProject()\\n    const changed = changeG2Pitch(baseline)\\n    const current = reviewSnapshot(changed)\\n    co\r\nnst currentModel = { project: changed, fingerprints: current.fingerprints, impact: assessImpact(reviewSnapshot(baseline\r\n), current) }\\n    expect(itemValidity(item(baseline, { kind: 'joint', columnMemberId: '1F-X1Y1' }), currentModel)).not\r\n.toHaveProperty('reasons')\\n    expect(itemValidity(item(baseline, { kind: 'joint', columnMemberId: '1F-X2Y1' }), curre\r\nntModel)).toHaveProperty('reasons')\\n    expect(itemValidity(item(baseline, { kind: 'member', memberId: '1F-G2-X2Y1-Y' \r\n}), currentModel)).toHaveProperty('reasons')\\n\\n    const displayChanged = cloneProject(baseline)\\n    displayChanged.n\r\name = 'other'\\n    displayChanged.notes = { note: 'changed' }\\n    displayChanged.grid = { ...displayChanged.grid, xLab\r\nels: ['X1', 'X2'], yLabels: ['Y1', 'Y2', 'Y3'] }\\n    expect(itemValidity(item(baseline, { kind: 'member', memberId: '1\r\nF-X1Y1' }), { project: displayChanged, fingerprints: reviewSnapshot(baseline).fingerprints, impact: null })).not.toHave\r\nProperty('reasons')\\n\\n    const settings = { clearance: { valueMm: 26, source: '\\\\u5229\\\\u7528\\\\u8005\\\\u5165\\\\u529B' a\r\ns const, scope: 'same', enteredAt: '2026-09-17', note: 'a' } }\\n    expect(checkConditionsFingerprint(settings, [])).to\r\nBe(checkConditionsFingerprint({ clearance: { ...settings.clearance, enteredAt: 'later', note: 'b' } }, []))\\n  })\\n\\n  \r\nit('invalidates finding items on condition changes and marks deleted targets as changed', () => {\\n    const baseline =\r\n createSampleProject()\\n    const snapshot = reviewSnapshot(baseline)\\n    const finding: RecordedFinding = {\\n      ch\r\neckId: 'check',\\n      findingId: 'finding',\\n      kind: CLEARANCE,\\n      clearanceMm: 25,\\n      a: { memberId: '1F-\r\nG1-X1Y1-X', rebarId: 'a', role: LOWER, barIndex: 0, segmentIndex: 0 },\\n      b: { memberId: '1F-G2-X2Y1-Y', rebarId: '\r\nb', role: LOWER, barIndex: 0, segmentIndex: 0 },\\n      closestPoints: [[0, 0, 0], [0, 0, 0]],\\n      basis: 'basis',\\n\r\n    }\\n    const changedChecks = { ...snapshot.fingerprints, checkConditions: 'changed' }\\n    const findingValidity = \r\nitemValidity(item(baseline, { kind: 'member', memberId: '1F-G1-X1Y1-X' }, finding), { project: baseline, fingerprints: \r\nchangedChecks, impact: null })\\n    expect(findingValidity).toHaveProperty('reasons')\\n    expect(JSON.stringify(findin\r\ngValidity)).toContain('\\\\u691C\\\\u67FB\\\\u6761\\\\u4EF6\\\\u5909\\\\u66F4')\\n    const noFindingValidity = itemValidity(item(ba\r\nseline, { kind: 'member', memberId: '1F-G1-X1Y1-X' }), { project: baseline, fingerprints: changedChecks, impact: null }\r\n)\\n    expect(JSON.stringify(noFindingValidity)).not.toContain('\\\\u691C\\\\u67FB\\\\u6761\\\\u4EF6\\\\u5909\\\\u66F4')\\n\\n    con\r\nst deleted = cloneProject(baseline)\\n    deleted.members = deleted.members.filter(({ id }) => id !== '1F-G1-X1Y1-X')\\n \r\n   const current = reviewSnapshot(deleted)\\n    const deletedValidity = itemValidity(item(baseline, { kind: 'member', m\r\nemberId: '1F-G1-X1Y1-X' }), { project: deleted, fingerprints: current.fingerprints, impact: assessImpact(snapshot, curr\r\nent) })\\n    expect(JSON.stringify(deletedValidity)).toContain('\\\\u5BFE\\\\u8C61\\\\u5909\\\\u66F4')\\n  })\\n\\n  it('keeps X-R\r\nay design quantity separate from shape, including shape-less roles', () => {\\n    const project = createSampleProject()\r\n\\n    const { rebars, lines } = buildTakeoff(project)\\n    const main = rebars.find(({ role }) => role === '\\\\u4E3B\\\\u7\r\nB4B')\\n    if (!main) throw new Error('main rebar expected')\\n    const view = xrayForRebar(main, project, lines)\\n    \r\nexpect(view.quantity.designCount).toBe(main.count)\\n    expect(view.quantity.designLengthMm).toBe(main.length)\\n    exp\r\nect(view.shape).toHaveProperty('drawn')\\n    expect(view.shape.drawn).toBe(true)\\n    const hidden = {\\n      ...main,\\\r\nn      id: `${main.id}-opening`,\\n      role: '\\\\u958B\\\\u53E3\\\\u88DC\\\\u5F37\\\\u7B4B' as const,\\n      points: [[0, 0, 0]\r\n, [100, 0, 0]] as [number, number, number][],\\n      closed: false,\\n      hookTails: undefined,\\n      length: 1234,\\n\r\n      count: 2,\\n      placement: undefined,\\n      splice: undefined,\\n      zones: [],\\n    }\\n    const hiddenView =\r\n xrayForRebar(hidden, project, [])\\n    expect(hiddenView.shape).toMatchObject({ drawn: false })\\n    expect(hiddenView\r\n.quantity.designLengthMm).toBe(1234)\\n    expect(hiddenView.quantity.designCount).toBe(2)\\n  })\\n\\n  it('keeps missing \r\nunit mass nonzero-safe and distinguishes unsupported from empty results', () => {\\n    const base = reviewSnapshot(crea\r\nteSampleProject())\\n    const currentProject = cloneProject(base.project)\\n    currentProject.unitMass = { D13: 0.995 }\r\n\\n    const impact = assessImpact(base, reviewSnapshot(currentProject))\\n    const mass = impact.lines.find((line) => l\r\nine.mass?.beforeKg === null)?.mass\\n    expect(mass?.beforeKg).toBeNull()\\n    expect(mass?.before).toBe('\\\\u5358\\\\u4F4\r\nD\\\\u8CEA\\\\u91CF\\\\u672A\\\\u5165\\\\u529B')\\n    expect(mass?.beforeKg).not.toBe(0)\\n    const unsupported = reviewSnapshot(\r\ncloneProject(base.project))\\n    unsupported.fingerprints = projectFingerprints(unsupported.project, unsupported.rebars\r\n, new Set(['1F-X1Y1']), jpMlitRulePack, 1, null)\\n    expect(unsupported.fingerprints.members['1F-X1Y1'].result).toBeNu\r\nll()\\n    expect(memberResultFingerprint('not-present', [])).not.toBeNull()\\n  })\\n\\n  it('round-trips review targets, \r\nfingerprints, packages and writes the bundle in one transaction', async () => {\\n    const project = createSampleProjec\r\nt()\\n    const snapshot = reviewSnapshot(project)\\n    const review = {\\n      ...emptyReviewState(),\\n      baseline: \r\n{ label: 'baseline', capturedAt: '2026-09-17', project, fingerprints: snapshot.fingerprints },\\n      items: [item(proj\r\nect, { kind: 'member', memberId: '1F-X1Y1' })],\\n      packages: [workPackage({ id: 'check', label: 'joint', required: \r\ntrue, reviewItemIds: ['item-1'], status: CONFIRMED })],\\n    }\\n    const parsed = await readProjectFile(new File([seri\r\nalizeProjectFile(project, review)], 'review.json'))\\n    expect(parsed.review.items[0].targets).toEqual(review.items[0]\r\n.targets)\\n    expect(parsed.review.baseline?.fingerprints).toEqual(review.baseline?.fingerprints)\\n    expect(parsed.r\r\neview.packages).toEqual(review.packages)\\n    expect(serializeProjectFile(project, emptyReviewState())).toBe(JSON.strin\r\ngify(project))\\n\\n    const transaction = vi.spyOn(IDBDatabase.prototype, 'transaction')\\n    try {\\n      await saveBu\r\nndle({ project, review: emptyReviewState() })\\n      console.log(JSON.stringify(transaction.mock.calls))\\n      expect(\r\ntransaction.mock.calls.filter(([, mode]) => mode === 'readwrite')).toHaveLength(1)\\n      expect(transaction.mock.calls\r\n.find(([, mode]) => mode === 'readwrite')).toEqual(['project', 'readwrite'])\\n    } finally {\\n      transaction.mockRe\r\nstore()\\n    }\\n  })\\n\\n  it('does not keep a confirmed package ready after linked or unlinked target changes', () => {\r\n\\n    const baseline = createSampleProject()\\n    const baselineSnapshot = reviewSnapshot(baseline)\\n    const confirme\r\nd = item(baseline, { kind: 'member', memberId: '1F-X1Y1' })\\n    const entry = { id: 'check', label: 'joint', required:\r\n true, reviewItemIds: ['item-1'], status: CONFIRMED as const }\\n    const ready = packageReadiness(workPackage(entry), \r\n[confirmed], { project: baseline, fingerprints: baselineSnapshot.fingerprints, impact: null })\\n    expect(ready.blocke\r\nrs).toEqual([])\\n    const changed = changeC1(baseline)\\n    const changedSnapshot = reviewSnapshot(changed)\\n    const\r\n changedModel = { project: changed, fingerprints: changedSnapshot.fingerprints, impact: assessImpact(baselineSnapshot, \r\nchangedSnapshot) }\\n    expect(packageReadiness(workPackage(entry), [confirmed], changedModel).blockers.length).toBeGre\r\naterThan(0)\\n\\n    const unlinkedEntry = { id: 'check', label: 'joint', required: true, reviewItemIds: [], status: CONF\r\nIRMED as const, confirmation: { by: 'reviewer', at: '2026-09-17', note: '', fingerprints: baselineSnapshot.fingerprints\r\n } }\\n    expect(packageReadiness(workPackage(unlinkedEntry), [], changedModel).blockers.length).toBeGreaterThan(0)\\n  \r\n  const unconfirmed = { ...confirmed, status: '\\\\u672A\\\\u78BA\\\\u8A8D' as const }\\n    expect(packageReadiness(workPacka\r\nge(entry), [unconfirmed], { project: baseline, fingerprints: baselineSnapshot.fingerprints, impact: null }).blockers.le\r\nngth).toBeGreaterThan(0)\\n  })\\n\\n  it('marks member replacement for confirmation, rejects review schema 2, and fingerp\r\nrints source URL changes', () => {\\n    const baseline = createSampleProject()\\n    const changed = cloneProject(baseli\r\nne)\\n    changed.members = changed.members.map((member) => member.id === '1F-X1Y1' ? { ...member, id: '1F-X1Y1-renamed'\r\n } : member)\\n    const impact = assessImpact(reviewSnapshot(baseline), reviewSnapshot(changed))\\n    expect(JSON.strin\r\ngify(impact)).toContain('\\\\u5BFE\\\\u5FDC\\\\u8981\\\\u78BA\\\\u8A8D')\\n    expect(() => parseReviewState({ ...emptyReviewState\r\n(), reviewSchemaVersion: 2 })).toThrow(/reviewSchemaVersion/)\\n    const modified = JSON.parse(JSON.stringify(jpMlitRul\r\nePack)) as typeof jpMlitRulePack\\n    modified.entries[0] = { ...modified.entries[0], source: { ...modified.entries[0].\r\nsource, url: `${modified.entries[0].source.url ?? ''}#changed` } }\\n    expect(rulepackFingerprint(modified)).not.toBe(\r\nrulepackFingerprint(jpMlitRulePack))\\n  })\\n\\n  it('is deterministic and agrees with an un-narrowed capsule oracle on t\r\nhe sample', () => {\\n    const input = checkInput()\\n    const first = runGeometryCheck(input)\\n    const second = runG\r\neometryCheck(input)\\n    expect(second).toEqual(first)\\n    expect(first.scope.pairsTested).toBeLessThan(first.scope.se\r\ngmentCount * (first.scope.segmentCount - 1) / 2)\\n    const layout = buildingLayout(input.project, input.rebars, input.\r\nunsupportedMemberIds, (size) => barDiameter(size) / 2)\\n    const targetIds = new Set(jointRebarMemberIds(input.project\r\n, input.joint))\\n    const instances = layout.rebar.filter(({ memberId }) => targetIds.has(memberId))\\n    const oracle\r\n = new Set<string>()\\n    const pairKey = (kind: string, left: { rebarId: string; barIndex: number; segmentIndex: numbe\r\nr }, right: { rebarId: string; barIndex: number; segmentIndex: number }) => {\\n      const refs = [\\n        `${left.re\r\nbarId}:${left.barIndex}:${left.segmentIndex}`,\\n        `${right.rebarId}:${right.barIndex}:${right.segmentIndex}`,\\n  \r\n    ].sort()\\n      return `${kind}:${refs[0]}:${refs[1]}`\\n    }\\n    for (let leftIndex = 0; leftIndex < instances.le\r\nngth; leftIndex += 1) {\\n      for (let rightIndex = leftIndex + 1; rightIndex < instances.length; rightIndex += 1) {\\n\r\n        const left = instances[leftIndex]\\n        const right = instances[rightIndex]\\n        if (left.rebarId === ri\r\nght.rebarId && left.barIndex === right.barIndex) continue\\n        const result = capsuleClearanceMm({ from: left.from,\r\n to: left.to, radius: left.radius }, { from: right.from, to: right.to, radius: right.radius })\\n        const point = [\r\n(result.pa[0] + result.pb[0]) / 2, (result.pa[1] + result.pb[1]) / 2, (result.pa[2] + result.pb[2]) / 2] as [number, nu\r\nmber, number]\\n        if (point[0] < first.scope.regionMm.x[0] || point[0] > first.scope.regionMm.x[1] || point[2] < f\r\nirst.scope.regionMm.z[0] || point[2] > first.scope.regionMm.z[1]) continue\\n        const kind = result.clearanceMm < -\r\n1e-6 ? CLASH : Math.abs(result.clearanceMm) <= 1e-6 ? CONTACT : null\\n        if (kind !== null) oracle.add(pairKey(kin\r\nd, left, right))\\n      }\\n    }\\n    const actual = new Set(first.findings.filter(({ kind }) => kind === CLASH || kind\r\n === CONTACT).map(({ kind, a, b }) => pairKey(kind, a, b)))\\n    expect(actual).toEqual(oracle)\\n    const real = layou\r\nt.rebar.find(({ memberId }) => targetIds.has(memberId))\\n    const display = buildingLayout(input.project, input.rebars\r\n, input.unsupportedMemberIds, rebarRadius).rebar.find(({ rebarId, barIndex, segmentIndex }) => real && rebarId === real\r\n.rebarId && barIndex === real.barIndex && segmentIndex === real.segmentIndex)\\n    expect(real).toBeDefined()\\n    expe\r\nct(display?.radius).not.toBe(real?.radius)\\n  })\\n\\n  it('uses the stress fixture for the requested two-story quantity \r\nshape', () => {\\n    const project = createStressProject({ xSpanCount: 4, ySpanCount: 3, storyCount: 2 })\\n    const re\r\nsult = buildTakeoff(project)\\n    expect(result.lines.length).toBeGreaterThan(0)\\n    expect(result.rebars.length).toBe\r\nGreaterThan(0)\\n  })\\n})\\n\\r\\nimport { describe, it } from 'vitest'\\nimport { createHash } from 'node:crypto'\\nimport {\r\n createSampleProject } from '@/domain/model/sample-project'\\nimport { createStressProject } from '@/domain/model/stress\r\n-project'\\nimport { buildTakeoff } from '@/lib/hooks/useTakeoff'\\n\\ndescribe('phase 47 quantity digest', () => {\\n  it(\r\n'prints the stable line digests', () => {\\n    for (const [name, project] of [\\n      ['sample', createSampleProject()]\r\n,\\n      ['stress', createStressProject({ xSpanCount: 4, ySpanCount: 3, storyCount: 2 })],\\n    ] as const) {\\n      co\r\nnst lines = buildTakeoff(project).lines\\n      const digest = createHash('sha256').update(JSON.stringify(lines)).digest\r\n('hex').slice(0, 16)\\n      console.log(`digest ${name} ${digest} lines=${lines.length}`)\\n    }\\n  })\\n})\\n\\r\\n\\r\\n\\r\\\r\nn\",\"exit_code\":0,\"status\":\"completed\"}}\r\n  phases\\47-joint-review-core\\step7-codex.stdout.log:12:{\"type\":\"item.started\",\"item\":{\"id\":\"item_7\",\"type\":\"command_ex\r\necution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command '$base = git \r\nmerge-base main HEAD; Write-Output \\\"base=$base\\\"; Write-Output '\\\"'--- diff stat ---'; git diff --stat \\\\\\\"\\\"'$base...\r\nHEAD\\\"; Write-Output '\\\"'--- changed paths ---'; git diff --name-status \\\\\\\"\\\"'$base...HEAD\\\"; Write-Output '\\\"'--- bas\r\ne worktree head/status ---'; if (Test-Path '.tmp-phase47-base/.git') { git -C '.tmp-phase47-base' rev-parse HEAD; git -\r\nC '.tmp-phase47-base' status --short } else { Write-Output 'no .git marker' }; Write-Output '--- temp files ---'; Get-C\r\nhildItem '.tmp-phase47-base/tests' -Filter '*phase47*' -ErrorAction SilentlyContinue | Select-Object FullName,Length; W\r\nrite-Output '--- step specs headings/forbidden ---'; rg -n \\\\\\\"\\\"'^(#|##|###)|금지사항|Acceptance 