 'x',\\r\\n            kind: '鸚㎪쥈',\\r\\n            mark: 'G1',\\r\\n            b: 400,\\r\\n            depth: 800,\\r\\n            main: { size: 'D25', cutoffFromSupportFaceMm: 1000 },\\r\\n            stirrup: { size: 'D13', pitch: 200, startOffsetMm: 50 },\\r\\n          },\\r\\n        ],\\r\\n      },\\r\\n    ],\\r\\n    // position ?뚨꽒?묆굦??buildingLayout ??`'axis' in member.position` ?뚩맼?▲굥??\\r\\n    [\\r\\n      '?ⓩ쓲?ヤ퐤營?걣?▲걚',\\r\\n      { members: [{ id: 'm', kind: '??, sectionId: 's', storyId: '1F' }] },\\r\\n    ],\\r\\n    // 邕멥굮渶⒲걦?뽧굥?ⓧ툒?끾폇嶸쀥춴??Y ?ヨ맼?▲곩쎋?㏂겓?▲걚?묆걤??ㄷ歟곥걣?㎯걤?뗣?\\r\\n    [\\r\\n      '鸚㎪쥈??뻗??X?팢 ?㎯겒??,\\r\\n      {\\r\\n        members: [\\r\\n          {\\r\\n            id: 'm',\\r\\n            kind: '鸚㎪쥈',\\r\\n            sectionId: 's',\\r\\n            storyId: '1F',\\r\\n            position: { axis: 'Z', ix: 0, iy: 0 },\\r\\n          },\\r\\n        ],\\r\\n      },\\r\\n    ],\\r\\n    ['?ⓩ쓲??kind ?뚨꽒??, { members: [{ id: 'm', sectionId: 's', storyId: '1F' }] }],\\r\\n    ['?ⓩ쓲??쉸 id ?뚨꽒??, { members: [{ id: 'm', kind: '??, sectionId: 's' }] }],\\r\\n    ['?숃껁겗?ㅳ걣?뉐춻?쀣겎?ゃ걚', { notes: { row: 3 } }],\\r\\n    ['?섆퐤蘊ら뇧?뚧빊?㎯겒??, { unitMass: { D13: '0.995' } }],\\r\\n  ])('rejects a project whose shape is broken: %s', (_label, broken) => {\\r\\n    const project = createProject()\\r\\n\\r\\n    expect(() =>\\r\\n      deserializeProject(JSON.stringify({ ...project, ...broken })),\\r\\n    ).toThrow()\\r\\n  })\\r\\n\\r\\n  // 壤㏂걽?묌싥겂??뢿?㎯걣?뉎굦?╉걚?뗨쮼?꿔겘?곫룒?삠겗?붶릎?㎩닜?곥겍?썬걾????\\r\\n  // ?앫겗?껁겓??굚??store ?ュ뀯?ｃ겍?꾠굥??겎?곥뚣궢?녈깤?ャ겓?삠굥?띲걣?밤걢?ゃ걚??\\r\\n  it.each([\\r\\n    ['?ⓩ쓲?뚦츪?ⓦ걮?ゃ걚??씊?믤뙁??, 'sectionId'],\\r\\n    ['?ⓩ쓲?뚦츪?ⓦ걮?ゃ걚?롢굮?뉎걲', 'storyId'],\\r\\n  ])('rejects a project whose references are broken: %s', (_label, field) => {\\r\\n    const project = createProject()\\r\\n    const broken = {\\r\\n      ...project,\\r\\n      members: project.members.map((member, index) =>\\r\\n        index === project.members.length - 1\\r\\n          ? { ...member, [field]: 'nowhere' }\\r\\n          : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(broken))).toThrow()\\r\\n  })\\r\\n\\r\\n  it.each([\\r\\n    ['?긱걣?겹꺁?껁깋??쨼?믤뙁??, { ix: 99, iy: 0 }],\\r\\n    ['?겹꺁?껁깋曆삣춻?뚧빐?겹겎?ゃ걚', { ix: 0.5, iy: 0 }],\\r\\n    ['?겹꺁?껁깋曆삣춻?뚩쿋', { ix: -1, iy: 0 }],\\r\\n  ])('rejects a project whose grid index is out of range: %s', (_l, position) => {\\r\\n    // gridPoint ??RangeError ?믤뒘?믡곩뀲?싥궎?녈걣?썬걾?뗣귙걮?뗣굚?앫겗旅덁뻑??\\r\\n    // ?ゅ땿岳앭춼?뚧쎑?뤵겗?㎯곫А??Ø?뤵겎?귛릪?섉??㎬맼?▲굥??\\r\\n    const project = createProject()\\r\\n    const broken = {\\r\\n      ...project,\\r\\n      members: project.members.map((member, index) =>\\r\\n        index === 0 ? { ...member, position } : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(broken))).toThrow()\\r\\n  })\\r\\n\\r\\n  it('rejects a 鸚㎪쥈 that starts on the last ?겹꺁?껁깋 line of its axis', () => {\\r\\n    // 鸚㎪쥈??슔??벡?밤겲?㏛섯?녈굥??겎?곥걹??뻗?졼걨訝?ㅶ뎸?띲겲?㎯걽??\\r\\n    const project = createSampleProject()\\r\\n    const girder = project.members.find(\\r\\n      (member) => member.kind === '鸚㎪쥈' && 'axis' in member.position,\\r\\n    )\\r\\n    expect(girder).toBeDefined()\\r\\n    const { nx } = gridPointCount(project.grid)\\r\\n\\r\\n    const broken = {\\r\\n      ...project,\\r\\n      members: project.members.map((member) =>\\r\\n        member.id === girder!.id\\r\\n          ? { ...member, position: { axis: 'X', ix: nx - 1, iy: 0 } }\\r\\n          : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(broken))).toThrow()\\r\\n  })\\r\\n\\r\\n  it('rejects a 鸚㎪쥈 that points at a ????씊', () => {\\r\\n    // 葉?닪?뺛걚??buildingLayout ?뚧뒘?믡굥 ??壤㏂겗濾쒏읅?㎪??곥굥?밤걣?⒲걚??\\r\\n    const project = createSampleProject()\\r\\n    const column = project.sections.find(({ kind }) => kind === '??)\\r\\n    const girder = project.members.find(({ kind }) => kind === '鸚㎪쥈')\\r\\n    expect(column).toBeDefined()\\r\\n    expect(girder).toBeDefined()\\r\\n\\r\\n    const crossed = {\\r\\n      ...project,\\r\\n      members: project.members.map((member) =>\\r\\n        member.id === girder!.id\\r\\n          ? { ...member, sectionId: column!.id }\\r\\n          : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(crossed))).toThrow()\\r\\n  })\\r\\n\\r\\n  it('accepts a project without the optional ?숃껁꺕?섆퐤蘊ら뇧', () => {\\r\\n    const project = createProject()\\r\\n\\r\\n    expect(() =>\\r\\n      deserializeProject(JSON.stringify(project)),\\r\\n    ).not.toThrow()\\r\\n  })\\r\\n\\r\\n  it('round-trips ?숃?notes', () => {\\r\\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\\r\\n\\r\\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('Member.cantilever serialization compatibility', () => {\\r\\n  it('round-trips a cantilever slab without changing schemaVersion', () => {\\r\\n    const project = createCantileverProject()\\r\\n\\r\\n    expect(project.schemaVersion).toBe(PROJECT_SCHEMA_VERSION)\\r\\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\\r\\n  })\\r\\n\\r\\n  it('keeps a legacy bay-position slab without cantilever metadata valid', () => {\\r\\n    const project = createCantileverProject(null, { ix: 0, iy: 0 })\\r\\n\\r\\n    expect(project.schemaVersion).toBe(PROJECT_SCHEMA_VERSION)\\r\\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\\r\\n  })\\r\\n\\r\\n  // 鸚뽩뫅??씌?볝걹?뉑똻佯딀씮?뚥퍡?뤷졃??졼귙걪?볝굮凉얇걦?ⓩ죭餓뜰걹??굚??걣沃?굙?ゃ걦?ゃ굥\\r\\n  // ???ⓩ쓲?뚣뚧쑋野얍퓶?띲겓?썬걾?뗣겗?㎯겘?ゃ걦?곩뀲?싥궎?녈걣令뷩겓?ゃ굥??\\r\\n  it('keeps a cantilever hung off the outer edge girder loadable', () => {\\r\\n    const project = createCantileverProject(\\r\\n      { side: '閭?, projectionMm: 1800 },\\r\\n      { axis: 'X', ix: 0, iy: 2 },\\r\\n    )\\r\\n\\r\\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\\r\\n  })\\r\\n\\r\\n  // ?녴겓?곫뵱?곮씌?앫겗?귙겗?뚣궛?ゃ긿?됥겗鸚뽧겦?뷩굥?귙겗??센??????똻渦뷩겘 (ix, iy) ?뗣굢\\r\\n  // (ix+1, iy) ?얇겎鴉멥겞?뗣겗?㎯곥걹??뻗????ㅶ뎸?띲겲?㎯겎?귙굥??\\r\\n  it('rejects a cantilever whose support edge runs past the grid', () => {\\r\\n    const project = createCantileverProject(\\r\\n      { side: '閭?, projectionMm: 1800 },\\r\\n      { axis: 'X', ix: 2, iy: 0 },\\r\\n    )\\r\\n\\r\\n    expect(() => deserializeProject(serializeProject(project))).toThrow(\\r\\n      'Project shape mismatch',\\r\\n    )\\r\\n  })\\r\\n\\r\\n  it.each([\\r\\n    ['cantilever on a non-slab member', () => {\\r\\n      const project = createCantileverProject()\\r\\n      return {\\r\\n        ...project,\\r\\n        members: project.members.map((member) =>\\r\\n          member.kind === '??\\r\\n            ? {\\r\\n                ...member,\\r\\n                cantilever: { side: '閭? as const, projectionMm: 1800 },\\r\\n              }\\r\\n            : member,\\r\\n        ),\\r\\n      } as Project\\r\\n    }],\\r\\n    ['cantilever with a bay position', () =>\\r\\n      createCantileverProject({ side: '閭?, projectionMm: 1800 }, { ix: 0, iy: 0 })],\\r\\n    ['slab girder position without cantilever', () =>\\r\\n      createCantileverProject(null, { axis: 'X', ix: 0, iy: 0 })],\\r\\n    ['zero projection', () =>\\r\\n      createCantileverProject({ side: '閭?, projectionMm: 0 })],\\r\\n    ['negative projection', () =>\\r\\n      createCantileverProject({ side: '縕?, projectionMm: -1 })],\\r\\n    ['invalid side', () =>\\r\\n      createCantileverProject({ side: 'middle' as never, projectionMm: 1800 })],\\r\\n  ])('rejects %s', (_label, makeProject) => {\\r\\n    expect(() => deserializeProject(serializeProject(makeProject()))).toThrow(\\r\\n      'Project shape mismatch',\\r\\n    )\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('?뉑똻佯딀씮 geometry', () => {\\r\\n  it('uses the support edge and endpoint ??for the clear width', () => {\\r\\n    const project = createCantileve