er) =>\r\n        member.id === girder!.id\r\n          ? { ...member, sectionId: column!.id }\r\n          : member,\r\n      ),\r\n    }\r\n\r\n    expect(() => deserializeProject(JSON.stringify(crossed))).toThrow()\r\n  })\r\n\r\n  it('accepts a project without the optional ?숃껁꺕?섆퐤蘊ら뇧', () => {\r\n    const project = createProject()\r\n\r\n    expect(() =>\r\n      deserializeProject(JSON.stringify(project)),\r\n    ).not.toThrow()\r\n  })\r\n\r\n  it('round-trips ?숃?notes', () => {\r\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\r\n\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n})\r\n\r\ndescribe('Member.cantilever serialization compatibility', () => {\r\n  it('round-trips a cantilever slab without changing schemaVersion', () => {\r\n    const project = createCantileverProject()\r\n\r\n    expect(project.schemaVersion).toBe(PROJECT_SCHEMA_VERSION)\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n\r\n  it('keeps a legacy bay-position slab without cantilever metadata valid', () => {\r\n    const project = createCantileverProject(null, { ix: 0, iy: 0 })\r\n\r\n    expect(project.schemaVersion).toBe(PROJECT_SCHEMA_VERSION)\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n\r\n  // 鸚뽩뫅??씌?볝걹?뉑똻佯딀씮?뚥퍡?뤷졃??졼귙걪?볝굮凉얇걦?ⓩ죭餓뜰걹??굚??걣沃?굙?ゃ걦?ゃ굥\r\n  // ???ⓩ쓲?뚣뚧쑋野얍퓶?띲겓?썬걾?뗣겗?㎯겘?ゃ걦?곩뀲?싥궎?녈걣令뷩겓?ゃ굥??\r\n  it('keeps a cantilever hung off the outer edge girder loadable', () => {\r\n    const project = createCantileverProject(\r\n      { side: '閭?, projectionMm: 1800 },\r\n      { axis: 'X', ix: 0, iy: 2 },\r\n    )\r\n\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n\r\n  // ?녴겓?곫뵱?곮씌?앫겗?귙겗?뚣궛?ゃ긿?됥겗鸚뽧겦?뷩굥?귙겗??센??????똻渦뷩겘 (ix, iy) ?뗣굢\r\n  // (ix+1, iy) ?얇겎鴉멥겞?뗣겗?㎯곥걹??뻗????ㅶ뎸?띲겲?㎯겎?귙굥??\r\n  it('rejects a cantilever whose support edge runs past the grid', () => {\r\n    const project = createCantileverProject(\r\n      { side: '閭?, projectionMm: 1800 },\r\n      { axis: 'X', ix: 2, iy: 0 },\r\n    )\r\n\r\n    expect(() => deserializeProject(serializeProject(project))).toThrow(\r\n      'Project shape mismatch',\r\n    )\r\n  })\r\n\r\n  it.each([\r\n    ['cantilever on a non-slab member', () => {\r\n      const project = createCantileverProject()\r\n      return {\r\n        ...project,\r\n        members: project.members.map((member) =>\r\n          member.kind === '??\r\n            ? {\r\n                ...member,\r\n                cantilever: { side: '閭? as const, projectionMm: 1800 },\r\n              }\r\n            : member,\r\n        ),\r\n      } as Project\r\n    }],\r\n    ['cantilever with a bay position', () =>\r\n      createCantileverProject({ side: '閭?, projectionMm: 1800 }, { ix: 0, iy: 0 })],\r\n    ['slab girder position without cantilever', () =>\r\n      createCantileverProject(null, { axis: 'X', ix: 0, iy: 0 })],\r\n    ['zero projection', () =>\r\n      createCantileverProject({ side: '閭?, projectionMm: 0 })],\r\n    ['negative projection', () =>\r\n      createCantileverProject({ side: '縕?, projectionMm: -1 })],\r\n    ['invalid side', () =>\r\n      createCantileverProject({ side: 'middle' as never, projectionMm: 1800 })],\r\n  ])('rejects %s', (_label, makeProject) => {\r\n    expect(() => deserializeProject(serializeProject(makeProject()))).toThrow(\r\n      'Project shape mismatch',\r\n    )\r\n  })\r\n})\r\n\r\ndescribe('?뉑똻佯딀씮 geometry', () => {\r\n  it('uses the support edge and endpoint ??for the clear width', () => {\r\n    const project = createCantileverProject()\r\n    const slab = project.members.find((member) => member.kind === '佯딀씮')!\r\n\r\n    const projectionRun = slabRun(project, slab, 'Y')\r\n\r\n    expect(projectionRun.coreLengthMm).toBe(1800)\r\n    expect(projectionRun.distributionClearMm).toBe(5200)\r\n    expect(projectionRun.cantilever?.support.memberId).toBe(\r\n      '1F-G1-X1Y1-X',\r\n    )\r\n  })\r\n\r\n  it.each([\r\n    ['missing support girder', '1F-G1-X1Y1-X', '野멩퀡訝띷닇塋?],\r\n    ['missing support endpoint ??, '1F-X2Y1', '??똻?긱겒??],\r\n  ])('rejects a cantilever without %s', (_label, removedId, reason) => {\r\n    const project = createCantileverProject()\r\n    const slab = project.members.find((member) => member.kind === '佯딀씮')!\r\n    const missingSupport = {\r\n      ...project,\r\n      members: project.members.filter(({ id }) => id !== removedId),\r\n    }\r\n\r\n    try {\r\n      slabRun(missingSupport, slab, 'Y')\r\n      throw new Error('expected cantilever geometry to be rejected')\r\n    } catch (error) {\r\n      expect(error).toBeInstanceOf(MemberUnsupportedError)\r\n      expect((error as MemberUnsupportedError).reason).toBe(reason)\r\n    }\r\n  })\r\n\r\n  it('does not let a cantilever enter the two-support slabBay path', () => {\r\n    const project = createCantileverProject()\r\n    const slab = project.members.find((member) => member.kind === '佯딀씮')!\r\n\r\n    expect(() => slabBay(project, slab)).toThrow(MemberUnsupportedError)\r\n    try {\r\n      slabBay(project, slab)\r\n    } catch (error) {\r\n      expect((error as MemberUnsupportedError).reason).toBe('野멩퀡訝띷닇塋?)\r\n    }\r\n  })\r\n})\r\n\r\ndescribe('columnEnds', () => {\r\n  function stackColumn(storyId: string, ix: number, iy: number): Member {\r\n    return {\r\n      id: `${storyId}-X${ix + 1}Y${iy + 1}`,\r\n      kind: '??,\r\n      memberClass: '翁?퐪',\r\n      sectionId: 'section-C1',\r\n      storyId,\r\n      position: { ix, iy },\r\n    }\r\n  }\r\n\r\n  function stackProject(members: Member[]): Project {\r\n    return {\r\n      ...createProject(members),\r\n      stories: [\r\n        { id: '1F', name: '1??, height: 4200 },\r\n        { id: '2F', name: '2??, height: 3600 },\r\n      ],\r\n    }\r\n  }\r\n\r\n  const twoStories = [\r\n    stackColumn('1F', 1, 1),\r\n    stackColumn('2F', 1, 1),\r\n  ]\r\n\r\n  it('anchors into the foundation at the lowest story and passes through the joint', () => {\r\n    const project = stackProject(twoStories)\r\n\r\n    expect(columnEnds(project, twoStories[0])).toEqual({\r\n      bottom: '若싩?',\r\n      top: '?ゃ걮',\r\n    })\r\n  })\r\n\r\n  it('leaves the joint bare on the upper column and stops at the roof without anchoring (R9??', () => {\r\n    // ?묓빀遺?먮뒗 若싩???遺숈? ?딅뒗?? 洹??먮━??泳숁뎸??塋?깿?▽뻑???꾨땲??\r\n    // 令띸츞?뷸틬 2竊덌폃竊됪윶2)???뚦릢?롢걫?ⓦ겓1?뗦??띻? ?뺥븳?? 掠뗤툓(?꾩뿉 ?깃? ?놁쓬)??\r\n    // 若싩???遺숈씠吏 ?딅뒗????1?싧뎴1)竊뗰펷竊믭펹??) 鵝녷쎑媛 ?訝딃쉸?긴말嶺뗭쓣 ?뚦뀍塋?겎\r\n    // 閭㏂겲?뗩뎱嶺뗣띿쑝濡??ㅻ쨪 ?녈꺍??꺁?쇈깉??Þ鼇덂?力뺢퉴吏留?媛꾨떎.\r\n    const project = stackProject(twoStories)\r\n\r\n    expect(columnEnds(project, twoStories[1])).toEqual({\r\n      bottom: '?ゃ걮',\r\n      top: '?덄ク',\r\n    })\r\n  })\r\n\r\n  it('anchors only the base and stops at the roof (?덄ク) when the column stands alone in its stack', () => {\r\n    const project = stackProject([twoStories[0]])\r\n\r\n    expect(columnEnds(project, twoStories[0])).toEqual({\r\n      bottom: '若싩?',\r\n      top: '?덄ク',\r\n    })\r\n  })\r\n\r\n  it('ignores a column that sits on a different grid point', () => {\r\n    const project = stackProject([\r\n      stackColumn('1F', 1, 1),\r\n      stackColumn('2F', 0, 0),\r\n    ])\r\n\r\n    expect(columnEnds(project, stackColumn('1F', 1, 1))).toEqual({\r\n      bottom: '若싩?',\r\n      top: '?덄ク',\r\n    })\r\n  })\r\n\r\n  it('reads the stack order from the stories array', () => {\r\n    const reversed: Project = {\r\n      ...stackProject(twoStories),\r\n      stories: [\r\n        { id: '2F', name: '2??, height: 3600 },\r\n        { id: '1F', name: '1??, height: 4200 },\r\n      ],\r\n    }\r\n\r\n    // 諛곗뿴???ㅼ쭛?덈㈃ 2F媛 理쒗븯痢듭쑝濡??댁꽍?쒕떎 ???쒖꽌媛 怨??ㅽ깮?대떎.\r\n    expect(columnEnds(reversed, twoStories[1]).bottom).toBe('若싩?')\r\n    expect(columnEnds(reversed, twoStories[0]).bottom).toBe('?ゃ걮')\r\n  })\r\n\r\n  it('rejects a member that is not a ??, () => {\r\n    const beam: Member = {\r\n      id: '1F-G1-X1Y1-X',\r\n      kind: '鸚㎪쥈',\r\n      memberClass: '翁?퐪',\r\n      sectionId: shallowGirderSection.id,\r\n      storyId: '1F',\r\n      position: { axis: 'X', ix: 0, iy: 0 },\r\n    }\r\n\r\n    expect(() => columnEnds(stackProject(twoStories), beam)).toThrow()\r\n  })\r\n})\r\n\r\ndescribe('setNote', () => {\r\n  it('stores a note without mutating the original Project', () => {\r\n    const project = createProject()\r\n    const next = setNote(project, '1??C|C1|訝사춮', '誤곭▶沃?)\r\n\r\n    expect(next.notes).toEqual({ '1??C|C1|訝사춮': '誤곭▶沃? })\r\n    expect(project.notes).toBeUndefined()\r\n  })\r\n\r\n  it('replaces an existing note for the same line', () => {\r\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\r\n    const next = setNote(project, '1??C|C1|訝사춮', '閻븃첀歷?)\r\n\r\n    expect(next.notes).toEqual({ '1??C|C1|訝사춮': '閻븃첀歷? })\r\n  })\r\n\r\n  it('drops the key when the note is cleared so empty strings do not pile up', () => {\r\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\r\n    const next = setNote(project, '1??C|C1|訝사춮', '')\r\n\r\n    expect(next.notes).toEqual({})\r\n  })\r\n\r\n  it('keeps notes for other lines untouched', () => {\r\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\r\n    const next = setNote(project, '1??C|C1|躍?춮', '?붵긿?곭▶沃?)\r\n\r\n    expect(next.notes).toEqual({\r\n      '1??C|C1|訝사춮': '誤곭▶沃?,\r\n      '1??C|C1|躍?춮': '?붵긿?곭▶沃?,\r\n    })\r\n  })\r\n})\r\n\r\n\r\ndescribe('legacy quantity notes', () => {\r\n  const oldId = '1??C|C1|訝사춮|1000|12|壤®듁0,0,0;0,1000,0'\r\n  const newId = `${oldId}|孃껪25`\r\n  it('removes only the trailing size segment', () => {\r\n    expect(legacyQuantityLineId(newId)).toBe(oldId)\r\n    expect(legacyQuantityLineId(oldId)).toBe(oldId)\r\n    expect(legacyQuantityLineId('group|孃껪13|訝사춮')).toBe('group|孃껪13|訝사춮')\r\n    expect(legacyQuantityLineId(`${oldId}|孃껳13`)).toBe(oldId)\r\n  })\r\n  it('reads saved legacy notes, prefers the new key including empty values, and defaults to empty', () => {\r\n    const project = { ...createProject(), notes: { [oldId]: '誤곭▶沃? } }\r\n    const restored = deserializeProject(serializeProject(project))\r\n    expect(noteFor(restored, newId)).toBe('誤곭▶沃?)\r\n    expect(noteFor({ ...project, notes: { ...project.notes, [newId]: '歷? } }, newId)).toBe('歷?)\r\n    expect(noteFor({ ...project, notes: { ...project.notes, [newId]: '' } }, newId)).toBe('')\r\n    expect(noteFor(createProject(), newId)).toBe('')\r\n    const next = setNote(restored, newId, '歷?)\r\n    expect(next.notes).toEqual({ [newId]: '歷? })\r\n    expect(project.notes).toEqual({ [oldId]: '誤곭▶沃? })\r\n  })\r\n  it('editing one size retires the shared legacy note for the other size', () => {\r\n    const project = { ...createProject(), notes: { [oldId]: '誤곭▶沃?, unrelated: 'keep' } }\r\n    const otherId = `${oldId}|孃껪13`\r\n    expect(noteFor(project, otherId)).toBe('誤곭▶沃?)\r\n    const next = setNote(project, newId, '歷?)\r\n    expect(next.notes).toEqual({ [newId]: '歷?, unrelated: 'keep' })\r\n    expect(noteFor(next, otherId)).toBe('')\r\n    expect(noteFor(next, newId)).toBe('歷?)\r\n  })\r\n  it('clearing a new key deletes both new and legacy entries', () => {\r\n    const project = { ...createProject(), notes: { [oldId]: 'old', [newId]: 'new', unrelated: 'keep' } }\r\n    expect(setNote(project, newId, '').notes).toEqual({ unrelated: 'keep' })\r\n  })\r\n})\r\n","exit_code":0,"status":"completed"}}
