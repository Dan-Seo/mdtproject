inity, Infinity],\r\n 102:     max: [-Infinity, -Infinity, -Infinity],\r\n 103:   }\r\n 104: }\r\n 105: \r\n 106: function expandBounds(bounds: Bounds, point: Point3, margin = 0): void {\r\n 107:   for (let axis = 0; axis < 3; axis += 1) {\r\n 108:     bounds.min[axis] = Math.min(bounds.min[axis], point[axis] - margin)\r\n 109:     bounds.max[axis] = Math.max(bounds.max[axis], point[axis] + margin)\r\n 110:   }\r\n 111: }\r\n 112: \r\n 113: function translate(point: Point3, offset: Point3): Point3 {\r\n 114:   return [point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]]\r\n 115: }\r\n 116: \r\n 117: export function memberWorldPoint(\r\n 118:   project: Project,\r\n 119:   member: Member,\r\n 120: ): (point: Point3) => Point3 {\r\n 121:   const section = findSection(project, member.sectionId)\r\n 122: \r\n 123:   if (member.kind === '柱') {\r\n 124:     if (section.kind !== '柱' || 'axis' in member.position) {\r\n 125:       throw new Error(`柱 member references a non-柱 section: ${member.id}`)\r\n 126:     }\r\n 127:     const { x, y } = gridPoint(project.grid, member.position.ix, member.position.iy)\r\n 128:     const offset: Point3 = [\r\n 129:       x - section.b / 2,\r\n 130:       storyElevation(project.stories, member.storyId),\r\n 131:       y - section.d / 2,\r\n 132:     ]\r\n 133:     return (point) => translate(point, offset)\r\n 134:   }\r\n 135: \r\n 136:   if (member.kind === '大梁') {\r\n 137:     if (section.kind !== '大梁' || !('axis' in member.position)) {\r\n 138:       throw new Error(`大梁 member references a non-大梁 section: ${member.id}`)\r\n 139:     }\r\n 140:     const story = project.stories.find(({ id }) => id === member.storyId)\r\n 141:     if (!story) throw storyNotFound(member.storyId)\r\n 142:     const start = gridPoint(project.grid, member.position.ix, member.position.iy)\r\n 143:     const span = girderSpan(project, member)\r\n 144:     const base = storyElevation(project.stories, member.storyId) + story.height - section.depth\r