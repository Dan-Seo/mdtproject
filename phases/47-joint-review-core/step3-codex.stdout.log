\n 336:       // 壁は躯体の区分（第4編第1章第2節（５）壁）で「柱、梁、床板等に接する\r\n 337:       // 垂直材の内法部分」なので、箱も内法で描く — 中心間で描くと柱・大梁と\r\n 338:       // 重なった立体になり、数量（内法）と見た目が食い違う。\r\n 339:       const position = member.position\r\n 340:       const start = gridPoint(project.grid, position.ix, position.iy)\r\n 341:       const span = wallSpan(project, member)\r\n 342:       const rangeOrigin = span.originOffsetMm ?? { along: 0, height: 0 }\r\n 343:       const alongCenter =\r\n 344:         span.startFaceOffsetMm + rangeOrigin.along + span.clearLengthMm / 2\r\n 345:       const centerY = elevation + rangeOrigin.height + span.clearHeightMm / 2\r\n 346:       // 壁の局所 x は通り芯の向き（X通りなら世界の x ＝ 軸0、Y通りなら\r\n 347:       // 世界の z ＝ 軸2）、局所 y は高さ ＝ 軸1 である。\r\n 348:       const alongOrigin =\r\n 349:         (position.axis === 'X' ? start.x : start.y) +\r\n 350:         span.startFaceOffsetMm +\r\n 351:         rangeOrigin.along\r\n 352:       const holes = boxHoles(\r\n 353:         member.openings ?? [],\r\n 354:         alongOrigin,\r\n 355:         elevation + rangeOrigin.height,\r\n 356:       )\r\n 357:       box =\r\n 358:         position.axis === 'X'\r\n 359:           ? {\r\n 360:               memberId: member.id,\r\n 361:               kind: '耐震壁',\r\n 362:               center: [start.x + alongCenter, centerY, start.y],\r\n 363:               size: [span.clearLengthMm, span.clearHeightMm, section.thickness],\r\n 364:             }\r\n 365:           : {\r\n 366:               memberId: member.id,\r\n 367:               kind: '耐震壁',\r\n 368:               center: [start.x, centerY, start.y + alongCenter],\r\n 369:               size: [section.thickness, span.clearHeightMm, span.clearLengthMm],\r\n 370:             }\r\n 371:       pieces = carveBox(box, position.axis === 'X' ? [0, 1] : [2, 1], holes)\r\n 372:     }\r\n 373: \r\n 374:     // 描くのはくり抜いた破片だが、枠の広がりは元の箱で測る — 開口で外形が\r\n 375:     // 変わるわけではないし、全面が開口の部材はドメインが先に落としている。\r\n 376:     boxes.push(...(pieces ?? [box]))\r\n 377:     expandBound