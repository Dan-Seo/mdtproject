    expect(columnEnds(project, twoStories[1])).toEqual({\r\nsrc/domain/model/project.test.ts:1456:    expect(columnEnds(project, twoStories[0])).toEqual({\r\nsrc/domain/model/project.test.ts:1468:    expect(columnEnds(project, stackColumn('1F', 1, 1))).toEqual({\r\nsrc/domain/model/project.test.ts:1484:    expect(columnEnds(reversed, twoStories[1]).bottom).toBe('定着')\r\nsrc/domain/model/project.test.ts:1485:    expect(columnEnds(reversed, twoStories[0]).bottom).toBe('なし')\r\nsrc/domain/model/project.test.ts:1498:    expect(() => columnEnds(stackProject(twoStories), beam)).toThrow()\r\nsrc/domain/rebar\\column.test.ts:46:    beamDepthAbove: 750,\r\nsrc/domain/rebar\\column.test.ts:96:      story.height - input().beamDepthAbove,\r\nsrc/domain/rebar\\column.test.ts:119:        clearMm: story.height - input().beamDepthAbove,\r\nsrc/domain/rebar\\column.test.ts:360:        input({ beamDepthAbove: story.height }),\r\nsrc/domain/rebar\\column.test.ts:366:  it('uses the supplied beamDepthAbove instead of a global constant', () => {\r\nsrc/domain/rebar\\column.test.ts:372:      generateColumnRebar(input({ beamDepthAbove: 800 }), jpMlitRulePack),\r\nsrc/domain/rebar\\column.test.ts:448:      beamDepthAbove: input().beamDepthAbove,\r\nsrc/domain/rebar\\column.test.ts:453:      beamDepthAbove: 4200,\r\nsrc/domain/rebar\\column.test.ts:458:      beamDepthAbove: input().beamDepthAbove,\r\nsrc/domain/rebar\\column.test.ts:462:    ({ section: columnSection, beamDepthAbove }) => {\r\nsrc/domain/rebar\\column.test.ts:467:          { ...input(), section: columnSection, beamDepthAbove },\r\nsrc/domain/rebar\\column.ts:28:  beamDepthAbove: number\r\nsrc/domain/rebar\\column.ts:29:  /** 스택 안에서의 단부 조건. `columnEnds()`가 판정한다 (R7). */\r\nsrc/domain/rebar\\column.ts:101:  const { member, section, story, beamDepthAbove, ends } = input\r\nsrc/domain/rebar\\column.ts:265:  const hoopSpan = story.height - beamDepthAbove\r\nsrc/domain/rebar\\column.ts:270:        `(階高 ${story.height} − 上部大梁せい ${be