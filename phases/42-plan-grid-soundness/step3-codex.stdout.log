{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'git diff 7a12578 -- src/lib/import/framing-plan/parse.test.ts; Get-Content -Encoding utf8 src/lib/import/framing-plan/types.ts; Get-Content -Encoding utf8 package.json; Get-Content -Encoding utf8 docs/ADR.md | Select-Object -Skip 480 -First 48'","aggregated_output":"diff --git a/src/lib/import/framing-plan/parse.test.ts b/src/lib/import/framing-plan/parse.test.ts\nindex 3138a73..fd4c552 100644\n--- a/src/lib/import/framing-plan/parse.test.ts\n+++ b/src/lib/import/framing-plan/parse.test.ts\n@@ -27,6 +27,58 @@ function page(items: TextItem[]): TextPage {\n }\n \n describe('parseFramingPlan — 通り芯グリッド', () => {\n+  it('P1: coincident adjacent axes have no span geometry', () => {\n+    const parsed = parseFramingPlan(\n+      page([h('X1', 100, 50), h('X2', 100, 50), h('6000', 100, 80)]),\n+    )\n+    expect(parsed.issues).toContain('通り芯座標重複')\n+    expect(parsed.grids).toEqual([])\n+    expect(parsed.blocks).toEqual([])\n+\n+    const separated = parseFramingPlan(\n+      page([h('X1', 100, 50), h('X2', 300, 50), h('6000', 200, 80)]),\n+    )\n+    expect(separated.grids).toHaveLength(1)\n+    expect(separated.issues).not.toContain('通り芯座標重複')\n+  })\n+\n+  it('P2: measured scale must fit the plan range even with a confirmed total', () => {\n+    // Integer dimensions and independent point coordinates, not parser constants.\n+    // Both 1 pt/mm and 0.002 pt/mm are outside the supported 1:10–1:1000 range.\n+    for (const spanMm of [200, 100000]) {\n+      for (const withTotal of [false, true]) {\n+        const parsed = parseFramingPlan(\n+          page([\n+            h('1', 100, 50),\n+            h('2', 300, 50),\n+            h(String(spanMm), 200, 80),\n+            ...(withTotal\n+              ? [\n+                  h('3', 500, 50),\n+                  h(String(spanMm), 400, 80),\n+                  h(String(spanMm * 2), 300, 110),\n+                ]\n+              : []),\n+          ]),\n+        )\n+        expect(parsed.issues).toContain('縮尺範囲外')\n+        expect(parsed.grids).toEqual([])\n+        expect(parsed.blocks).toEqual([])\n+      }\n+    }\n+\n+    // One inch on paper (72 pt): 254 mm at 1:10, 25400 mm at 1:1000.\n+    // The endpoints are included, and simple numeric labels keep their issues.\n+    for (const spanMm of [254, 25400]) {\n+      const parsed = parseFramingPlan(\n+        page([h('1', 100, 50), h('2', 172, 50), h(String(spanMm), 136, 80)]),\n+      )\n+      expect(parsed.grids).toHaveLength(1)\n+      expect(parsed.grids[0]?.spansMm).toEqual([spanMm])\n+      expect(parsed.issues).not.toContain('縮尺範囲外')\n+    }\n+  })\n+\n   it('라벨이 하나도 없으면 通り芯ラベル未検出', () => {\n     const parsed = parseFramingPlan(page([h('8700', 200, 80)]))\n     expect(parsed.grids).toEqual([])\n/**\r\n * 셀을 빈칸으로 남긴 사유 코드 (section-list의 CANDIDATE_ISSUES 패턴).\r\n * 파서는 코드만 싣고 표시부가 번역한다.\r\n */\r\nexport const PLAN_GRID_ISSUES = [\r\n  '通り芯ラベル未検出',\r\n  '寸法欠落',\r\n  '縮尺不整合',\r\n  '通り芯座標重複',\r\n  '縮尺範囲外',\r\n  '合計不一致',\r\n  '寸法列曖昧',\r\n  'ラベル文字混在',\r\n  '通り芯対応不明',\r\n] as const\r\n\r\nexport type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\n\r\n/** 伏図에서 읽은 通り芯 한 본. positionPt는 도면 좌표(pt) — 부재 스냅의 기준. */\r\nexport interface AxisCandidate {\r\n  label: string\r\n  positionPt: number\r\n}\r\n\r\n/** 한 방향(X 또는 Y)의 通り芯 열 후보. 승인 전에는 형상이 되지 않는다 (ADR-030). */\r\nexport interface PlanGridCandidate {\r\n  /** 라벨의 축 문자 — 밴드의 기하 방향이 아니라 도면이 붙인 이름을 따른다 */\r\n  direction: 'X' | 'Y'\r\n  /** 위치 오름차순 */\r\n  axes: AxisCandidate[]\r\n  /** 인접 축 사이 치수(mm). 길이는 axes.length - 1 */\r\n  spansMm: number[]\r\n  /** 실측 축척(pt/mm) — 전 스팬 실측의 중앙값. 표기 축척은 용지 의존이라 믿지 않는다 */\r\n  scalePtPerMm: number\r\n  /** 도면에 전체 치수가 명기돼 있고 스팬 합과 일치했다 */\r\n  totalConfirmed: boolean\r\n}\r\n\r\n/**\r\n * 부호가 그리드의 어디에 놓였는가 — 도면에서 잰 **기하**만 말한다.\r\n *\r\n * 「C면 柱」처럼 부호 접두로 부재 종별을 정하지 않는다. 종별은 断面リスト가\r\n * 이미 갖고 있으므로(ADR-018), 취입이 그 종별과 이 기하를 맞춰 본다 —\r\n * 어긋나면 사람이 판단할 일이지 파서가 고를 일이 아니다.\r\n */\r\nexport const PLAN_PLACEMENT_ROLES = ['格子点', '辺', 'ベイ'] as const\r\n\r\nexport type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\r\n\r\nexport type MemberPlacement =\r\n  | { mark: string; role: '格子点' | 'ベイ'; ix: number; iy: number }\r\n  | {\r\n      mark: string\r\n      role: '辺'\r\n      /** 부재가 시작하는 격자점 */\r\n      ix: number\r\n      iy: number\r\n      /** 부재가 뻗는 방향 (GirderPosition.axis와 같은 뜻) */\r\n      axis: 'X' | 'Y'\r\n    }\r\n\r\n/**\r\n * 도면 위의 伏図 한 장. 한 페이지에 여러 장이 실리므로(실물 yokohama p7은\r\n * 2階床伏図와 R階床伏図 두 장) 通り芯 정의가 같아도 **위치가 다르다** —\r\n * 그리드 정의는 접히지만 블록은 접히지 않는다.\r\n */\r\nexport interface PlanBlock {\r\n  /** 블록 제목 원문(「2階床伏図1/100」). 어느 Story인지는 사람이 정한다 */\r\n  title?: string\r\n  /** 이 블록과 짝지어진 X·Y 通り芯 정의. 취입은 반드시 이 둘을 쓴다 */\r\n  xGrid: PlanGridCandidate\r\n  yGrid: PlanGridCandidate\r\n  placements: MemberPlacement[]\r\n  /** 블록 안에 있으나 스냅하지 못한 부호(중복 없음, 원문 순) — 지어내지 않는다 */\r\n  unplacedMarks: string[]\r\n}\r\n\r\nexport interface ParsedFramingPlan {\r\n  /** 通り芯 정의 — 같은 그리드가 여러 블록에 반복되면 하나로 접힌다 */\r\n  grids: PlanGridCandidate[]\r\n  blocks: PlanBlock[]\r\n  /** 후보를 못 낸 사유 — 첫 등장 순, 중복 없음 */\r\n  issues: PlanGridIssue[]\r\n}\r\n\r\n/** 軸組図에서 계열을 못 낸 사유. 파서는 코드만 싣고 표시부가 번역한다 */\r\nexport const ELEVATION_ISSUES = ['寸法列未検出'] as const\r\n\r\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\r\n\r\nexport interface ElevationLevel {\r\n  /** 그 높이에 적힌 라벨 원문 전부. 없으면 빈 배열 — 지어내지 않는다 */\r\n  labels: string[]\r\n  positionPt: number\r\n}\r\n\r\n/**\r\n * 軸組図 한 계열의 높이 방향 읽기. 「어느 레벨이 Story의 경계인가」는 정하지\r\n * 않는다 — 원문에는 FL·GL·基礎下端·RCL이 섞여 있고, 그중 무엇이 階인지는\r\n * 조문이 아니라 설계 의도라 사람이 읽을 일이다 (ADR-030).\r\n *\r\n * 通り芯과 달리 라벨의 좌우 정렬이 일정하지 않아(실물 p8의 좌단 x는 108~198로\r\n * 흩어진다) 라벨 밴드를 앵커로 쓸 수 없다. 앵커는 **치수 열**이고, 치수가 자기\r\n * 구간의 중점에 놓인다는 관계로 축척과 레벨 위치를 함께 푼다.\r\n */\r\nexport interface ElevationCandidate {\r\n  /** 이 계열이 걸리는 軸組図 제목들(원문). 한 계열이 여러 通り에 공통으로 걸린다 */\r\n  titles: string[]\r\n  /** 도면 좌표 순 — 위에서 아래로 */\r\n  levels: ElevationLevel[]\r\n  /** 인접 레벨 사이 치수(mm). 길이는 levels.length - 1 */\r\n  heightsMm: number[]\r\n  scalePtPerMm: number\r\n}\r\n\r\nexport interface ParsedFrameElevations {\r\n  elevations: ElevationCandidate[]\r\n  issues: ElevationIssue[]\r\n}\r\n\r\n/** 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\nexport const PLAN_APPLY_REFUSALS = [\r\n  '階未指定',\r\n  '他階部材あり通り芯変更不可',\r\n] as const\r\n\r\nexport type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\r\n\r\n/** 부호 하나를 넣지 못한 사유. 지어내는 대신 이 코드로 남긴다 */\r\nexport const PLAN_APPLY_SKIPS = [\r\n  '断面未登録',\r\n  '部材種別相違',\r\n  '格子外',\r\n  '断面複数該当',\r\n] as const\r\n\r\nexport type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\r\n\r\n/** 階高 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\nexport const ELEVATION_APPLY_REFUSALS = [\r\n  '階範囲不正',\r\n  '部材あり階置換不可',\r\n] as const\r\n\r\nexport type ElevationApplyRefusal =\r\n  (typeof ELEVATION_APPLY_REFUSALS)[number]\r\n{\r\n  \"name\": \"kijun\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"predev\": \"node scripts/copy-pdfjs-assets.mjs\",\r\n    \"dev\": \"next dev\",\r\n    \"prebuild\": \"node scripts/copy-pdfjs-assets.mjs\",\r\n    \"build\": \"next build\",\r\n    \"lint\": \"eslint .\",\r\n    \"typecheck\": \"tsc --noEmit\",\r\n    \"test\": \"vitest run\",\r\n    \"test:golden\": \"vitest run tests/golden\",\r\n    \"rulepack:review-sheet\": \"tsx scripts/rulepack/review-sheet.ts\",\r\n    \"lighthouse\": \"lhci autorun --config=lighthouserc.cjs\",\r\n    \"perf:measure\": \"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\",\r\n    \"eval\": \"tsx --env-file-if-exists=.env evals/harness/run.ts\",\r\n    \"test:hooks\": \"bash scripts/hooks/tdd-guard.spec.sh\",\r\n    \"hooks:install\": \"git config core.hooksPath scripts/githooks\",\r\n    \"test:ci-scripts\": \"bash scripts/ci/scrub-secrets.spec.sh && bash scripts/ci/review-scope.spec.sh && bash scripts/ci/review-carryforward.spec.sh && bash scripts/ci/review-verdict.spec.sh && bash scripts/ci/distill-failure-log.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts/perf/blocking-graph.test.mjs\"\r\n  },\r\n  \"dependencies\": {\r\n    \"exceljs\": \"^4.4.0\",\r\n    \"js-yaml\": \"^5.2.3\",\r\n    \"next\": \"^15.5.23\",\r\n    \"pdfjs-dist\": \"6.2.108\",\r\n    \"posthog-js\": \"1.417.4\",\r\n    \"react\": \"^19.2.8\",\r\n    \"react-dom\": \"^19.2.8\",\r\n    \"three\": \"^0.185.1\",\r\n    \"zustand\": \"^5.0.14\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@anthropic-ai/sdk\": \"^0.116.0\",\r\n    \"@lhci/cli\": \"0.15.1\",\r\n    \"@testing-library/jest-dom\": \"^7.0.0\",\r\n    \"@testing-library/react\": \"^16.3.2\",\r\n    \"@types/js-yaml\": \"^4.0.9\",\r\n    \"@types/node\": \"^26.2.0\",\r\n    \"@types/react\": \"^19.2.18\",\r\n    \"@types/react-dom\": \"^19.2.4\",\r\n    \"@types/three\": \"^0.185.4\",\r\n    \"@vitejs/plugin-react\": \"^6.0.5\",\r\n    \"autoprefixer\": \"^10.5.4\",\r\n    \"eslint\": \"^8.57.1\",\r\n    \"eslint-config-next\": \"^15.5.23\",\r\n    \"fake-indexeddb\": \"6.2.5\",\r\n    \"jsdom\": \"^30.0.1\",\r\n    \"postcss\": \"^8.5.26\",\r\n    \"raw-loader\": \"^4.0.2\",\r\n    \"tailwindcss\": \"^3.4.17\",\r\n    \"tsx\": \"^4.23.12\",\r\n    \"typescript\": \"^5.9.3\",\r\n    \"vitest\": \"^4.1.10\"\r\n  },\r\n  \"overrides\": {\r\n    \"posthog-js\": \"1.417.4\"\r\n  }\r\n}\r\n\r\n- **스텁형** — G51 R階 上筋 外端8／中央8／内端13, 下筋 8／8／11: 中央이 한쪽 端과 같고 다른쪽 端만 많다. 差分은 그쪽 支点에만 서는 짧은 カットオフ筋이다.\r\n- **혼합형** — G55 R階 上筋 Y2端4／中央5／Y3端8, 下筋 4／5／5: 中央이 한쪽 端보다 많고 다른쪽 端보다 적다. 「한쪽 支点에만 定着하고 반대쪽 支点 앞에서 끊기는」 **편측근**이 필요하다 — 현행 3형(通し・端部스텁・中央筋)으로는 표현 불가.\r\n\r\n**결정**:\r\n\r\n1. `GirderMainRow`에 optional `startCount?: number`를 더한다. 없으면 대칭(始端=終端=endCount) — **기존 직렬화 그대로 읽히고 기존 案件의 数量이 변하지 않으므로 schemaVersion은 올리지 않는다**(版 기준: 「같은 案件의 数量이 달라지는가」).\r\n2. 始端/終端은 런 로컬이다 — `GirderRun.memberOffsetsMm`의 0 쪽이 始端.\r\n3. **분해는 nesting 해석으로 한다**: 위치별 本数는 누적 집합이다 — i번째 本은 「本数 ≥ i」인 모든 위치에 선다. s = startCount ?? endCount, e = endCount, c = centerCount로:\r\n   - 通し筋 ＝ min(s, c, e)\r\n   - 始端스텁 ＝ max(0, s − c)、終端스텁 ＝ max(0, e − c) — 그쪽 支点에 定着하고 柱面에서 カットオフ位置까지\r\n   - 中央筋 ＝ max(0, c − max(s, e)) — 양쪽 支点 앞 カットオフ位置에서 끊는다\r\n   - 편측근(始端定着) ＝ max(0, min(s, c) − e)、편측근(終端定着) ＝ max(0, min(c, e) − s) — 한쪽 支点에 定着하고 반대쪽 支点 앞 カットオフ位置에서 끊는다. 둘은 동시에 양수일 수 없다(전자는 e<s, 후자는 s<e를 요구).\r\n   - **불변식(각 지점 단면의 본수 보존)**: s ＝ 通し＋始端스텁＋편측(始) ／ c ＝ 通し＋中央＋편측(始)＋편측(終) ／ e ＝ 通し＋終端스텁＋편측(終).\r\n   - s＝e이면 현행 `splitGirderMainRow`와 동치다(스텁 양측 ＝ 기존 端部 카ットオフ, 中央筋 ＝ 기존 中央 카ットオフ, 편측근 0).\r\n4. **길이는 전부 기존 규칙의 재사용이다** — 스텁 ＝ 定着＋カットオフ位置, 中央筋 ＝ 内法−2×位置, 편측근 ＝ (内法−位置)＋定着. 定着은 resolveGirderEnd(룰팩), 継手는 1通則4) 간격 계상(intervalSplice) 그대로. 새 규준 수치는 없다. カットオフ位置(`cutoffFromSupportFaceMm`)는 断面 하나에 하나 — 실물 G51도 값이 内端 [2500] 하나뿐이고, 좌우 다른 값이 실물에 나타나면 그때 넓힌다.\r\n5. **다스팬 런 × 비대칭은 불성립으로 끊는다.** 리스트의 外端/内端이 다스팬 런의 어느 支点인지 조문·모델로 정할 수 없고, 정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004 원리). `MemberUnsupportedError`로 정직하게 실패한다. 대칭 다스팬은 현행 그대로.\r\n6. nesting 해석 자체는 조문이 아니라 판단이다 — 積算基準 2（３）梁1)은 全長にわたる主筋 외의 길이를 設計図書에 위임할 뿐, 位置別 本数를 본 단위로 잇는 규칙은 주지 않는다. R2 꼬리표(inferred)를 단다. 현행 min/差 분해도 같은 해석을 암묵으로 쓰고 있었다 — 이 ADR은 그것을 명시하고 일반화한다.\r\n7. 이 ADR의 범위는 모델·산정·数量·3D까지다. **입력 경로는 별건이다** — 断面一覧 편집 UI와 断面リスト 취입(8칸)의 「도면 라벨(外端/Y2端)↔始端/終端 대응」은 다음 phase이고, R13은 그때 닫힌다.\r\n\r\n### ADR-033: 断面リスト 취입의 「도면 라벨↔始端/終端」 대응 — 정확 일치 자동, 그 외는 사용자 선택\r\n\r\n**맥락**: ADR-032가 大梁 主筋의 좌우 비대칭을 모델·산정에 담았다. 남은 입력 경로는 둘 — 断面一覧 편집과 断面リスト 취입이다. 취입에는 결정이 하나 있다: 도면의 位置 라벨(「外端／内端」·「Y2端／Y3端」)을 런 로컬 始端/終端으로 잇는 **방향 결정**. 슬래브 短辺=X/Y(phase 19)와 같은 구조의 문제다 — 자동으로 한쪽을 고르면 도면에 없는 방향을 제품이 만든다 (ADR-004).\r\n\r\n**결정**:\r\n\r\n1. **파서는 해석하지 않는다.** 비대칭 칸은 위치별 본수와 **도면 원문 라벨 그대로**를 후보에 담는다. 端部/中央 재해석·좌우 정규화를 하지 않는다.\r\n2. **대응은 두 갈래다**:\r\n   - **通り芯형 자동**: 두 端 라벨이 「〈軸名〉端」 꼴이고 그 軸名 둘이 프로젝트 `Grid`의 **같은 축** 라벨(`xLabels`/`yLabels`)에 정확히 존재하면, 축 순서로 결정한다 — **始端 ＝ 축 인덱스가 낮은 쪽**. 근거는 코드 사실이다: `girderRun`이 부재를 축 인덱스 오름차순으로 정렬하므로 런의 始端은 항상 인덱스 낮은 支点이다. 伏図의 `Grid` 라벨과 断面リスト의 位置 라벨은 **같은 `compact()` 정규화**(NFKC·공백 제거, `src/lib/import/runs.ts`)를 거치므로, 이 대응은 동일 정규화를 지난 도면 문자열끼리의 정확 일치이지 추정이 아니다.\r\n   - **그 외는 사용자 선택**: 「外端／内端」처럼 축 이름이 아닌 라벨, 軸名이 Grid에 없거나 부분 일치인 경우는 취입 화면에서 사용자가 「〈라벨〉=始端 / 〈라벨〉=終端」을 고른다. **기본은 미선택·미선택이면 반영 불가.** 建物의 外/内로 추정하는 자동은 만들지 않는다.\r\n3. 자동 결정한 행은 **근거를 화면에 밝힌다**(어느 축 라벨 순서로 정했는지). 사용자가 수동으로 뒤집을 수 있어야 한다.\r\n4. **カットオフ 치수는 한 값이다** (ADR-032 §4). 도면이 한쪽 端에만 치수를 주면 그 값을 `cutoffFromSupportFaceMm` 후보로 담고, 좌우가 다른 치수를 주면 결정하지 않는다 — 빈칸+원문.\r\n\r\n**정정 (2026-08-26, phase 21 step 0 반증)**: 초판 §2는 「`Grid` 라벨은 伏図 취입이 도면 원문을 그대로 실은 것」이라고 썼으나, 伏図 파서가 라벨 후보를 `compact()`로 정규화한다는 반례(raw 「X 1」→라벨 「X1」)로 반증됐다. 대응의 성립 조건은 원문 무변형이 아니라 **비교 양변이 같은 정규화를 지나는 것**이므로 §2를 위와 같이 고쳤다 — 구현은 軸名 후보와 Grid 라벨을 같은 `compact` 정규화로 비교해야 한다. 반증 기록은 `phases/21-asym-import/step0-report.json`.\r\n\r\n### ADR-034: 開口補強筋은 設計図書 전사 입력으로 계상한다 — R14 잔여 해소\r\n\r\n**맥락**: `数量積算基準` 1通則8)은 開口部 欠除를 정한 뒤 「なお、開口補強筋は設計図書により計測・計算する」로 補強筋을 設計図書에 위임한다 — 조문에 형상·본수·길이가 없어 제품이 지어낼 수 없다(2（３）梁1)·2（４）床板1)의 「補強筋等は設計図書による」와 같은 취급). ADR-029가 欠除를 구현하며 補強筋 미계상 상시 고지를 세웠고(R14 잔여 — 개구 있는 부재는 과소 계상), 닫으려면 도면에서 읽은 값을 그대로 옮겨 적는 입력이 필요하다고 적었다. 선례는 腹筋이다 — 규준값이 없는 값은 룰팩이 아니라 입력으로 받고, 算出式에 그 사실을 적는다 (ADR-021·M3c).\r\n\r\n**결정**:\r\n1. **입력은 開口 단위의 전사다**: `Opening.reinforcements?: Array<{ size: BarSize, count: number, lengthMm: number }>`. `lengthMm`은 **設計長さ 그 자체**다 — 「計測・計算する」의 주체는 조문상 設計図書를 읽는 쪽(사용자)이고, 제품은 定着·折曲げ·余長을 더하지도 빼지도 않는다. 입력 자리는 開口와 같은 平面 페인이다 (ADR-029).\r\n2. **数量**: role `開口補強筋`의 `Rebar`로 낸다 — 質量 ＝ 設計長さ × 単位質量(사용자 입력, JIS 미확보) × 본수, 割増은 1通則9) 4%(躯体). 継手 계상 없음(전사값을 제품이 나눌 근거가 없다), 加工長 대상 아님. ruleHits는 腹筋과 같은 방식으로 규준 행을 걸지 않고, 算出式에 「設計図書 전사(1通則8))」임을 적는다.\r\n3. **3D에 그리지 않는다** — 위치·형상을 전사받지 않으므로 그리려면 제품이 지어내야 한다(パネルゾーン帯筋을 만들지 않은 사유와 같다, ADR-022). `points`는 直線 `[0,0,0]→[lengthMm,0,0]`으로 형상 그룹핑(内訳 행 분리)에만 쓰고, 뷰어는 이 role을 건너뛴다.\r\n4. **방향·명칭(縦·横·斜め)은 받지 않는다** — 数量에 영향이 없고, 위치를 전사받지 않는 이상 이름만 유지하는 표시 계층이 더 크다. 필요가 실증되면 그때 더한다.\r\n5. **고지는 지우지 않고 문면을 뒤집는다** (ADR-029 선례): 補強筋은 전사 입력으로 계상하며, **전사하지 않은 開口는 그만큼 과소 계상**이라는 사실을 계속 고지한다 — 제품은 전사의 완전성을 알 수 없다.\r\n6. **schemaVersion은 올리지 않는다** — optional 추가라 기존 案件의 数量이 변하지 않는다(판단 기준: 같은 案件의 数量이 달라지는가). 빈 배열은 키를 지워 저장하지 않는다(`openings` 선례) — 「補強筋 없음」과 「미전사」의 구분은 조문이 요구하지 않고, 미전사 위험은 고지가 상시 안내한다.\r\n\r\n**정정 (2026-08-26, phase 22 step 0 반증)**: 초판 §1은 開口가 耐震壁·床板에만 있다는 것을 모델·검증기의 사실처럼 딛고 썼으나, 반례(柱 member에 `openings`를 넣은 JSON이 `deserializeProject`를 통과)로 반증됐다 — `Member.openings`는 공통 인터페이스의 필드고 검증기는 모양만 본다. 壁·床板 제한은 **산정 경로(壁·床板 생성기만 openings를 소비한다)와 입력 UI(平面 페인이 壁·床板에만 開口 편집을 낸다)**의 사실이다. `reinforcements`는 openings에 실리므로 이 격리를 그대로 상속한다 — 손으로 柱·大梁에 넣은 openings가 지금도 조용히 무시되듯 그 안의 補強筋도 무시된다. 이 무시는 이 ADR이 만든 것이 아니라 기존 동작이며, 검증기의 부재 종별 제한은 범위 밖으로 남긴다. 또한 step 0이 확인한 대로 뷰어 `roleToLayer`가 `RebarRole` 전수 매핑이므로, role 추가와 「그리지 않는다」(§3)는 **같은 스텝**에서 함께 들어가야 컴파일이 성립한다 — phase 22 step 1 §6이 그것이다. 반증 기록은 `phases/22-opening-reinforcement/step0-report.json`.\r\n","exit_code":0,"status":"completed"}}
