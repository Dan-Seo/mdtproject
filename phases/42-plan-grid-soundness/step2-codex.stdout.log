extitems/kani-p39.json\",\n    \"tests/fixtures/section-import/textitems/kani-p40.json\",\n    \"tests/fixtures/section-import/textitems/kani-p41.json\",\n    \"tests/fixtures/section-import/textitems/karatsu-fukuzu-p1.json\",\n    \"tests/fixtures/section-import/textitems/karatsu-hashirashin-p1.json\",\n    \"tests/fixtures/section-import/textitems/karatsu-jikugumi1-p1.json\",\n    \"tests/fixtures/section-import/textitems/karatsu-jikugumi2-p1.json\",\n    \"tests/fixtures/section-import/textitems/karatsu-shousai-p1.json\",\n    \"tests/fixtures/section-import/textitems/ojkk-p2.json\",\n    \"tests/fixtures/section-import/textitems/ojkk-p3.json\",\n    \"tests/fixtures/section-import/textitems/ojkk-p4.json\",\n    \"tests/fixtures/section-import/textitems/saiki-p1.json\",\n    \"tests/fixtures/section-import/textitems/saiki-p2.json\",\n    \"tests/fixtures/section-import/textitems/shibata-p1.json\",\n    \"tests/fixtures/section-import/textitems/shibata-p13.json\",\n    \"tests/fixtures/section-import/textitems/shibata-p7.json\",\n    \"tests/fixtures/section-import/textitems/tsu-p16.json\",\n    \"tests/fixtures/section-import/textitems/tsu-p20.json\",\n    \"tests/fixtures/section-import/textitems/tsu-p21.json\",\n    \"tests/fixtures/section-import/textitems/tsu-p22.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p13.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p14.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p15.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p6.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p7.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p8.json\",\n    \"tests/fixtures/section-import/textitems/yokohama-p9.json\",\n    \"tests/plan-import/corpus2-elevation.test.ts\",\n    \"tests/plan-import/corpus2.test.ts\",\n    \"tests/plan-import/elevation.test.ts\",\n    \"tests/plan-import/key-coverage.test.ts\",\n    \"tests/plan-import/parse.test.ts\",\n    \"vitest.config.ts\"\n  ],\n  \"paths_expected_absent\": [\n    \"tmp/phase42-step0/run.ts\",\n    \"tmp/phase42-step0/measure.py\",\n    \"tmp/phase42-step0/instrumentation.ts.txt\",\n    \"tmp/phase42-step0/report.py\",\n    \"tmp/phase42-step0\"\n  ]\n}\n\r\n{\r\n  \"phase\": \"42-plan-grid-soundness\",\r\n  \"step\": 1,\r\n  \"name\": \"grid-geometry-soundness\",\r\n  \"status\": \"completed\",\r\n  \"summary\": \"P1·P2와 양 로케일 사유 코드 추가: 36면 격자 55→53, 나머지 53후보와 19블록 전체 객체 불변; 변조 2건 검출·SHA-256 복원, 1811테스트·lint·tsc 통과.\",\r\n  \"baseline\": {\r\n    \"commit\": \"9b2c50ff8e2fe3bf5ac1de575cc7bdfbb44109ca\",\r\n    \"parser_path\": \"src/lib/import/framing-plan/parse.ts\",\r\n    \"parser_git_blob_sha256\": \"0a892671382a68e72da6eeb7b5ec08b376f7887a635d55e1d8a00694db16886b\",\r\n    \"parser_worktree_sha256\": \"faf57b026d60620ed8114ab465617b536c2e0af38c079445d772ad0c5654738b\",\r\n    \"method\": \"구현 전 깨끗한 파서로 재계측. census.ts가 git show HEAD:parse.ts와 작업 파일의 LF 정규화 텍스트 일치를 assert했다. CRLF 체크아웃 차이만 허용했다. 이전 step 보고서의 출력을 복사하지 않았다.\",\r\n    \"before_command\": \"npx tsx tmp/phase42-step1/census.ts before\",\r\n    \"after_command\": \"npx tsx tmp/phase42-step1/census.ts after\",\r\n    \"after_census_parser_sha256\": \"93b0738a3af7ce18989f74a49c3c6e3615dc2c0f9f13c0b6fac50e939c8690cb\",\r\n    \"final_parser_sha256\": \"c14dd44887a56e073f9457d6a25e3d2e4164a839e3c88b6fa032aa50a28aada3\",\r\n    \"post_census_change\": \"주석의 정상 53후보를 나머지 53후보로 정정했다. 이들은 축척 검사를 통과한 후보이지 실제 伏図임이 보증된 후보가 아니다. 동작 변경은 없다.\"\r\n  },\r\n  \"scale_policy\": {\r\n    \"support_range_inclusive\": {\r\n      \"minimum\": \"1:1000\",\r\n      \"maximum\": \"1:10\"\r\n    },\r\n    \"min_pt_per_mm\": 0.0028346456692913387,\r\n    \"max_pt_per_mm\": 0.2834645669291339,\r\n    \"conversion\": \"1 inch = 72 pt = 25.4 mm; scalePtPerMm = (72 / 25.4) / scale denominator.\",\r\n    \"reference\": {\r\n      \"document\": \"建築工事設計図書作成基準（令和2年改定）\",\r\n      \"url\": \"https://www.mlit.go.jp/common/001157950.pdf\",\r\n      \"printed_page\": 9,\r\n      \"pdf_page\": 10,\r\n      \"section\": \"4.2, rows 25–27\",\r\n      \"verified_fact\": \"基礎伏図・各階床伏図・軸組図의 기본 축척은 1/100 또는 1/200이며 1/10・1/20・1/30・1/50도 허용한다.\"\r\n    },\r\n    \"decision\": \"명시된 1:10 확대 伏図까지 포함한다. 축소 PDF의 실측 축척을 허용하도록 1:200의 선형 5배 축소(1:1000)를 하한으로 정한다. A0→A4의 선형 약 4배 축소(1:800)보다 1.25배 여유다. 하한 1:1000 자체가 원문에 정해져 있다는 뜻은 아니며, 일반 도면 축척과 용지 축소에서 정한 제품의 후보 인식 한계다.\",\r\n    \"independent_of_corpus\": \"53개 후보의 min/max에 오차율을 붙여 경계를 만들지 않았다. 도면 축척과 축소를 근거로 정한 범위 안에 관측값이 충분한 여유로 들어가는지만 대조한다.\",\r\n    \"retained_count\": 53,\r\n    \"observed_min_pt_per_mm\": 0.00944781125,\r\n    \"observed_max_pt_per_mm\": 0.02835011034482758,\r\n    \"lower_margin_multiplier\": 3.332977857638889,\r\n    \"upper_margin_multiplier\": 9.99871123890886,\r\n    \"saiki_scale_over_retained_max\": 34.78746981626244,\r\n    \"saiki_scale_over_upper_limit\": 3.4791953667879625,\r\n    \"limitations\": \"이 범위는 건축도면 전체의 물리적 가능성 판정이나 배근 규준이 아니다. 1:1000보다 더 축소되거나 1:10보다 확대된 실제 伏図도 거부할 수 있다. 범위 안의 부분 격자·블록 오탐은 별도로 남는다. 零距離는 P1으로 먼저 거부한다.\"\r\n  },\r\n  \"implementation\": {\r\n    \"source\": \"src/lib/import/framing-plan/parse.ts\",\r\n    \"P1\": \"치수 선택 후 반환될 열의 인접 axes.positionPt가 정확히 같으면 通り芯座標重複으로 거부한다. 축을 합치거나 빼지 않는다.\",\r\n    \"P2\": \"같은 시점에 열의 scalePtPerMm이 유한하고 포함 경계 안인지 검사한다. full total·partial total·total 없음 반환 경로 모두가 이 관문을 지난다. 더 그럴듯한 치수로 재선택하지 않는다.\",\r\n    \"simple_labels\": \"기존 접두 없는 라벨 실패의 일반화 규약을 유지하되 새 두 기하 코드는 보존한다. 따라서 후보가 모두 사라진 fuji·saiki에서도 구체적 사유를 볼 수 있다.\",\r\n    \"locale_messages\": {\r\n      \"ja\": {\r\n        \"通り芯座標重複\": \"隣り合う通り芯が同じ座標にあるため、グリッド候補にできません\",\r\n        \"縮尺範囲外\": \"実測縮尺が対応範囲（1:1000〜1:10）外のため、グリッド候補にできません\"\r\n      },\r\n      \"ko\": {\r\n        \"通り芯座標重複\": \"인접한 通り芯의 좌표가 같아 격자 후보로 읽을 수 없습니다\",\r\n        \"縮尺範囲外\": \"실측 축척이 지원 범위(1:1000〜1:10) 밖이라 격자 후보로 읽을 수 없습니다\"\r\n      }\r\n    }\r\n  },\r\n  \"census\": {\r\n    \"pages_count\": 36,\r\n    \"grids_before\": 55,\r\n    