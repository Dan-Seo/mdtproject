6e\\uc5b4 \\ud654\\uba74\\uc774 \\ud1b5\\uc9f8\\ub85c \\uc548 \\ub72c\\ub2e4 \\u2014 \\uadf8\\ub7f0\\ub370 **`curl`\\uc740 200\\uc744 \\ub3cc\\ub824\\uc900\\ub2e4**(HTML \\uc178\\uc740 \\ub098\\uac00\\uace0 \\uccad\\ud06c\\ub9cc 404\\ub2e4). \\uadf8\\ub798\\uc11c \\u300c\\uc11c\\ubc84\\ub294 \\uc0b4\\uc544 \\uc788\\ub294\\ub370 e2e\\ub9cc \\uc2e4\\ud328\\u300d\\ub85c \\ubcf4\\uc5ec \\uc6d0\\uc778\\uc744 \\ucf54\\ub4dc\\uc5d0\\uc11c \\ucc3e\\uac8c \\ub41c\\ub2e4. \\uc21c\\uc11c\\ub294 **build \\u2192 dev \\uae30\\ub3d9 \\u2192 e2e**\\ub2e4. \\uc774\\ubbf8 \\ubc1f\\uc558\\uc73c\\uba74 dev \\uc11c\\ubc84\\ub97c \\uc8fd\\uc774\\uace0 `rm -rf .next && npm run build` \\ud6c4 \\ub2e4\\uc2dc \\ub744\\uc6b4\\ub2e4. (2026-08-23 phase 7 \\uc791\\uc5c5 \\uc911 \\uc2e4\\uc81c \\ubc1c\\uc0dd. `tests/e2e/README.md`\\uc5d0\\ub3c4 \\uc801\\ud600 \\uc788\\uc73c\\ub098 \\uadf8 \\ud30c\\uc77c\\uc740 \\ud558\\ub124\\uc2a4 \\uac00\\ub4dc\\ub808\\uc77c \\uc8fc\\uc785 \\ub300\\uc0c1\\uc774 \\uc544\\ub2c8\\ub77c codex\\ub294 \\ubabb \\ubcf8\\ub2e4 \\u2014 \\uac00\\ub4dc\\ub808\\uc77c\\uc740 `AGENTS.md`\\uc640 `docs/*.md`\\ubfd0\\uc774\\ub2e4)\\n\\n## \\ub9c8\\uc77c\\uc2a4\\ud1a4 \\ud604\\ud669\\n\\uacbd\\uc704\\u00b7\\uc218\\uce58\\u00b7\\uc644\\ub8cc \\ub0b4\\uc5ed\\uc740 **`docs/MILESTONES.md`**\\uc5d0 \\uc788\\ub2e4. \\uc544\\ub798\\ub294 \\uc0c1\\ud0dc \\ub300\\uc7a5\\uc774\\ub2e4 \\u2014 \\uac12\\uc744 \\uc778\\uc6a9\\ud558\\ub824\\uba74 \\uadf8 \\ubb38\\uc11c\\ub97c \\uc77d\\uace0, \\uadf8 \\ubb38\\uc11c\\ub3c4 \\uc190\\uac31\\uc2e0\\uc774\\ubbc0\\ub85c \\ucf54\\ub4dc\\ub85c \\ub300\\uc870\\ud560 \\uac83.\\n\\n| | \\uc0c1\\ud0dc | \\ub0a8\\uc740 \\uac83 |\\n|---|---|---|\\n| M0 \\uc2a4\\ud30c\\uc774\\ud06c | \\uc644\\ub8cc | \\u2014 |\\n| M1 \\uc6cc\\ud0b9 \\uc2a4\\ucf08\\ub808\\ud1a4 | \\uc644\\ub8cc | \\u2014 |\\n| M2 \\ub8f0\\ud329 | **\\uc9c4\\ud589 \\uc911** | \\u6a19\\u6e96\\u4ed5\\u69d8\\u66f8 5\\u7ae0\\u00b7\\u6570\\u91cf\\u7a4d\\u7b97\\u57fa\\u6e96\\uc758 `stated` \\uc2b9\\ua