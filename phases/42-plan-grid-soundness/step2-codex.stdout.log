uc720\\ub3c4\\ud55c\\ub2e4. \\u2462 \\ubd80\\uc7ac \\ubc30\\uce58 \\u2014 **\\uae30\\ud558\\ub9cc** \\uc77d\\uace0 \\uc885\\ubcc4\\uc740 \\uc815\\ud558\\uc9c0 \\uc54a\\ub294\\ub2e4(\\u300cC\\uba74 \\u67f1\\u300d\\ub85c \\uc811\\ub450\\ub97c \\uc77d\\uc9c0 \\uc54a\\ub294\\ub2e4; \\uc885\\ubcc4\\uc740 \\u65ad\\u9762\\u30ea\\u30b9\\u30c8\\uac00 \\uac16\\uace0 \\uc788\\ub2e4). \\uc2a4\\ub0c5 \\ud5c8\\uc6a9\\uc740 **\\uc911\\uc559\\uac12 \\uc2a4\\ud32c\\uc758 1/4**\\uc774\\ub2e4(\\uc778\\uc811 \\uae30\\uc900\\uc774\\uba74 1200mm \\ub760\\uc5d0\\uc11c 8pt\\ub85c \\uc881\\uc544\\uc838 \\u5f15\\u51fa\\u7dda\\uc73c\\ub85c \\ube44\\ucf1c \\uc801\\ud78c \\ubd80\\ud638\\uac00 \\ub5a8\\uc5b4\\uc9c4\\ub2e4). \\ud55c \\ud398\\uc774\\uc9c0\\uc758 \\u4f0f\\u56f3 \\uc5ec\\ub7ec \\uc7a5\\uc740 \\ube14\\ub85d\\uc73c\\ub85c \\ub098\\ub208\\ub2e4 \\u2014 \\uadf8\\ub9ac\\ub4dc **\\uc815\\uc758**\\ub294 \\uc811\\ud600\\ub3c4 \\uc88c\\ud45c\\ub294 \\uc548 \\uc811\\ud78c\\ub2e4. \\u2463 \\u968e\\u9ad8 \\u2014 \\u8ef8\\u7d44\\u56f3\\ub294 \\ub77c\\ubca8 \\uc815\\ub82c\\uc774 \\uc77c\\uc815\\ud558\\uc9c0 \\uc54a\\uc544(\\uc88c\\ub2e8 x\\uac00 108~198\\ub85c \\ud769\\uc5b4\\uc9c4\\ub2e4) \\uc575\\ucee4\\uac00 **\\uce58\\uc218 \\uc5f4**\\uc774\\uace0, \\u300c\\uce58\\uc218\\ub294 \\uc790\\uae30 \\uad6c\\uac04\\uc758 \\uc911\\uc810\\uc5d0 \\ub193\\uc778\\ub2e4\\u300d\\ub294 \\uad00\\uacc4\\ub85c \\ucd95\\ucc99\\uacfc \\ub808\\ubca8\\uc744 \\ud568\\uaed8 \\ud47c\\ub2e4. \\uc5b4\\ub290 \\ub808\\ubca8\\uc774 \\u968e\\uc758 \\uacbd\\uacc4\\uc778\\uc9c0\\ub294 \\uc815\\ud558\\uc9c0 \\uc54a\\uace0(FL\\u00b7GL\\u00b7\\u57fa\\u790e\\u4e0b\\u7aef\\u00b7RCL\\uc774 \\uc11e\\uc5ec \\uc788\\ub2e4) \\uac19\\uc740 \\ub192\\uc774\\uc758 \\ub77c\\ubca8 \\ub458\\uc740 \\ub458 \\ub2e4 \\ub0a8\\uae34\\ub2e4. \\u2464 \\ucde8\\uc785 \\ud654\\uba74 \\u2014 \\u65ad\\u9762\\u30ea\\u30b9\\u30c8\\uc640 \\uac19\\uc740 \\uc2b9\\uc778 \\uaddc\\uc57d\\uc774\\ub418 **\\uac00\\ub4dc\\uac00 \\ud558\\ub098 \\ub354** \\uc788\\ub2e4: \\uaca9\\uc790 index\\uac00 \\uc2a4\\ud32c \\ubc30\\uc5f4\\uc5d0 \\ub9e4\\uc5ec \\uc788\\uc5b4 \\u901a\\u308a\\u82af\\uc744 \\ubc14\\uafb8\\uba74 \\uc190\\ub300\\uc9c0 \\uc54a\\uc740 \\uce35\\uc758 \\ubd80\\uc7ac\\uac00 \\uc870\\uc6a9\\ud788 \\uc62e\\uaca8\\uac00\\ubbc0\\ub85c, \\ub2e4\\ub978 \\uce35\\uc5d0 \\ubd80\\uc7ac\\uac00 \\uc788\\uc73c\\uba74 \\ud1b5\\uc9f8\\ub85c \\uac70\\ubd80\\ud558\\uace0 \\uac70\\ubd80\\ub97c \\ubcf8 \\ub4a4\\uc5d0\\ub9cc \\u300c\\ub2e4\\ub978 \\uce35\\uc744 \\ubc84\\ub9b0\\ub2e4\\u300d \\ub3d9\\uc758 \\uce78\\uc744 \\ub0b8\\ub2e4. \\ud53d\\uc2a4\\ucc98\\ub294 yokohama p7(\\u4f0f\\u56f3)\\u00b7p8(\\u8ef8\\u7d44\\u56f3) \\uc2e0\\uaddc 2\\ubd80. \\uc2e4\\uac80\\uc99d `tests/e2e/uc22-plan-import.js`. **\\ub0a8\\uc740 \\uac83**: \\uc2e4\\uce21\\uc774 \\ubc1c\\uc8fc\\ucc98 2\\ubd80\\ub77c R10\\uc774 \\ud615\\uc0c1\\uc5d0\\ub3c4 \\uac78\\ub9b0\\ub2e4 \\u2014 kani p40(\\u8ef8\\u7d44\\u56f3)\\uc740 \\ud53d\\uc2a4\\ucc98\\ub85c \\ub4e4\\uc5b4\\uc654\\uc73c\\ub098 **\\uc77d\\uc9c0 \\ubabb\\ud55c\\ub2e4**: \\u968e\\u9ad8 \\uc5f4\\uc758 450\\uacfc 150\\uc774 \\uae00\\uc790 \\uac04\\uaca9 5.6pt\\ub85c \\ubd99\\uc5b4(\\uc22b\\uc790 \\uc548\\ucabd 4.3pt) \\u300c150450\\u300d \\ud55c \\ub369\\uc774\\uac00 \\ub418\\uace0, \\uadf8 1.3pt\\ub85c \\uac00\\ub974\\uba74 \\ub3c4\\uba74 \\ud558\\ub098\\uc5d0 \\ub9de\\ucd98 \\uac83\\uc774 \\ub418\\ubbc0\\ub85c \\uac00\\ub974\\uc9c0 \\uc54a\\ub294\\ub2e4. \\u300c\\uc77d\\uc9c0 \\ubabb\\ud55c\\ub2e4\\u300d\\ub97c \\ud14c\\uc2a4\\ud2b8\\ub85c \\uace0\\uc815\\ud574 \\ub450\\uc5c8\\ub2e4, \\u672a\\u914d\\u7f6e \\ubd80\\ud638\\uc758 \\ub300\\ubd80\\ubd84\\uc740 \\u5c0f\\u6881\\uc73c\\ub85c \\uc798\\uac8c \\ub098\\ub25c \\uce78 \\uc548\\uc758 \\uac83\\uc774\\ub77c \\uc81c\\ud488\\uc774 \\u5c0f\\u6881\\uc744 \\ubaa8\\ub378\\ub9c1\\ud558\\uae30 \\uc804\\uc5d0\\ub294 \\ubd99\\uc77c \\uc790\\ub9ac\\uac00 \\uc5c6\\ub2e4(ADR-005), \\ubd80\\ud638 \\u679d\\u756a(`bX2A`)\\u00b7\\uc88c\\uc6b0 \\ube44\\ub300\\uce6d \\uadf8\\ub9