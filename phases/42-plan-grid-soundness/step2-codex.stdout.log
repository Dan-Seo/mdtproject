distance_pt\": 15.577503333333226,\n      \"total_confirmed\": true,\n      \"sequence_index\": 2,\n      \"span_index\": 1,\n      \"page\": \"hirosaki-p25.json\"\n    },\n    \"tolerance_pt\": 15,\n    \"holds\": false\n  },\n  \"margin_interpretation\": [\n    \"36면에서 실제 반환되는 grids와 blocks의 축 열을 합집합으로 잡아 208개 채택 스팬을 측정했다. 채택은 현재 파서의 선택을 뜻하며 도면상 정답의 인증이 아니다. A가 나온 saiki-p2는 リスト 면의 부분 격자다.\",\n    \"B는 축 열에서 스팬으로 소비하지 않은 토큰이다. 인접 축의 axisAcrossOptions 중 하나에서 across 거리 <= 60pt인 토큰을 조사하며 along 거리 상한은 계측에 적용하지 않는다. 최솟값 자체가 15pt 안에 있어 상한을 적용해도 같은 B다. 다른 스팬에서 이미 선택한 토큰은 제외하되 合計 토큰은 스팬 미채택이므로 포함한다.\",\n    \"전체 B의 24000은 Y7~Y10 세 스팬의 合計이며 Y8~Y9의 채택값은 8000이다. 중점에 더 가까운 合計가 있어도 파서가 그 토큰을 스팬으로 선택했다는 뜻은 아니다. 다른 검증과 선택 규칙이 있으므로 거리 여백 불성립만으로 모든 격자가 틀렸다고 주장하지 않는다.\",\n    \"옛 주석과 같은 合計 미확인 축만 따로 보아도 B=6.18pt로 15보다 작다. 이 결과는 R15의 후속 문서 갱신 근거이며 이번 step에서는 R15 문서나 허용오차 값을 바꾸지 않는다.\"\n  ],\n  \"unconfirmed_margin\": {\n    \"accepted_span_measurements\": 101,\n    \"accepted_max\": {\n      \"value_pt\": 10.379845548060018,\n      \"direction\": \"X\",\n      \"along_key\": \"x\",\n      \"axis_labels\": [\n        \"2\",\n        \"1\"\n      ],\n      \"dimension_text\": \"700\",\n      \"dimension_value_mm\": 700,\n      \"dimension_token_index\": 43,\n      \"dimension_center_pt\": {\n        \"x\": 377.9678488128,\n        \"y\": 124.13994942900038\n      },\n      \"axis_positions_pt\": [\n        43.16768159292046,\n        733.5277071287996\n      ],\n      \"midpoint_pt\": 388.34769436086003,\n      \"across_options_pt\": [\n        131.37812926690913,\n        126.239949504\n      ],\n      \"across_distance_pt\": 2.1000000749996133,\n      \"total_confirmed\": false,\n      \"sequence_index\": 0,\n      \"span_index\": 0,\n      \"page\": \"saiki-p2.json\"\n    },\n    \"competing_min\": {\n      \"value_pt\": 6.17999999999995,\n      \"direction\": \"Y\",\n      \"along_key\": \"y\",\n      \"axis_labels\": [\n        \"Y1\",\n        \"Y0\"\n      ],\n      \"dimension_