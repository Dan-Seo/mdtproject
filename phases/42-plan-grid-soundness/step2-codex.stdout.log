labels, dimensions, marks, titles } = collectTokens(page)\r\n1457:      !Number.isFinite(result.scalePtPerMm) ||\n1458:      result.scalePtPerMm < MIN_PLAN_SCALE_PT_PER_MM ||\n1459:      result.scalePtPerMm > MAX_PLAN_SCALE_PT_PER_MM\n1471:    // Section-list pages can contain two numeric values in a band that look\r\n1531:    titles,\r\n/**\r\n * 셀을 빈칸으로 남긴 사유 코드 (section-list의 CANDIDATE_ISSUES 패턴).\r\n * 파서는 코드만 싣고 표시부가 번역한다.\r\n */\r\nexport const PLAN_GRID_ISSUES = [\r\n  '通り芯ラベル未検出',\r\n  '寸法欠落',\r\n  '縮尺不整合',\n  '通り芯座標重複',\n  '縮尺範囲外',\n  '合計不一致',\r\n  '寸法列曖昧',\r\n  'ラベル文字混在',\r\n  '通り芯対応不明',\r\n] as const\r\n\r\nexport type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\n\r\n/** 伏図에서 읽은 通り芯 한 본. positionPt는 도면 좌표(pt) — 부재 스냅의 기준. */\r\nexport interface AxisCandidate {\r\n  label: string\r\n  positionPt: number\r\n}\r\n\r\n/** 한 방향(X 또는 Y)의 通り芯 열 후보. 승인 전에는 형상이 되지 않는다 (ADR-030). */\r\nexport interface PlanGridCandidate {\r\n  /** 라벨의 축 문자 — 밴드의 기하 방향이 아니라 도면이 붙인 이름을 따른다 */\r\n  direction: 'X' | 'Y'\r\n  /** 위치 오름차순 */\r\n  axes: AxisCandidate[]\r\n  /** 인접 축 사이 치수(mm). 길이는 axes.length - 1 */\r\n  spansMm: number[]\r\n  /** 실측 축척(pt/mm) — 전 스팬 실측의 중앙값. 표기 축척은 용지 의존이라 믿지 않는다 */\r\n  scalePtPerMm: number\r\n  /** 도면에 전체 치수가 명기돼 있고 스팬 합과 일치했다 */\r\n  totalConfirmed: boolean\r\n}\r\n\r\n/**\r\n * 부호가 그리드의 어디에 놓였는가 — 도면에서 잰 **기하**만 말한다.\r\n *\r\n * 「C면 柱」처럼 부호 접두로 부재 종별을 정하지 않는다. 종별은 断面リスト가\r\n * 이미 갖고 있으므로(ADR-018), 취입이 그 종별과 이 기하를 맞춰 본다 —\r\n * 어긋나면 사람이 판단할 일이지 파서가 고를 일이 아니다.\r\n */\r\nexport const PLAN_PLACEMENT_ROLES = ['格子点', '辺', 'ベイ'] as const\r\n\r\nexport type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\r\n\r\nexport type MemberPlacement =\r\n  | { mark: string; role: '格子点' | 'ベイ'; ix: number; iy: number }\r\n  | {\r\n      mark: string\r\n      role: '辺'\r\n      /** 부재가 시작하는 격자점 */\r\n      ix: number\r\n      iy: number\r\n      /** 부재가 뻗는 방향 (GirderPosition.axis와 같은 뜻) */\r\n      axis: 'X' | 'Y'\r\n    }\r\n\r\n/**\r\n * 도면 위의 伏図 한 장. 한 페이지에 여러 장이 실리므로(실물 yokohama p7은\r\n * 2階床伏図와 R階床伏図 두 장) 通り芯 정의가 같아도 **위치가 다르다** —\r\n * 그리드 정의는 접히지만 블록은 접히지 않는다.\r\n */\r\nexport interface PlanBlock {\r\n  /** 블록 제목 원문(「2階床伏図1/100」). 어느 Story인지는 사람이 정한다 */\r\n  title?: string\r\n  /** 이 블록과 짝지어진 X·Y 通り芯 정의. 취입은 반드시 이 둘을 쓴다 */\r\n  xGrid: PlanGridCandidate\r\n  yGrid: PlanGridCandidate\r\n  placements: MemberPlacement[]\r\n  /** 블록 안에 있으나 스냅하지 못한 부호(중복 없음, 원문 순) — 지어내지 않는다 */\r\n  unplacedMarks: string[]\r\n}\r\n\r\nexport interface ParsedFramingPlan {\r\n  /** 通り芯 정의 — 같은 그리드가 여러 블록에 반복되면 하나로 접힌다 */\r\n  grids: PlanGridCandidate[]\r\n  blocks: PlanBlock[]\r\n  /** 후보를 못 낸 사유 — 첫 등장 순, 중복 없음 */\r\n  issues: PlanGridIssue[]\r\n}\r\n\r\n/** 軸組図에서 계열을 못 낸 사유. 파서는 코드만 싣고 표시부가 번역한다 */\r\nexport const ELEVATION_ISSUES = ['寸法列未検出'] as const\r\n\r\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\r\n\r\nexport interface ElevationLevel {\r\n  /** 그 높이에 적힌 라벨 원문 전부. 없으면 빈 배열 — 지어내지 않는다 */\r\n  labels: string[]\r\n  positionPt: number\r\n}\r\n\r\n/**\r\n * 軸組図 한 계열의 높이 방향 읽기. 「어느 레벨이 Story의 경계인가」는 정하지\r\n * 않는다 — 원문에는 FL·GL·基礎下端·RCL이 섞여 있고, 그중 무엇이 階인지는\r\n * 조문이 아니라 설계 의도라 사람이 읽을 일이다 (ADR-030).\r\n *\r\n * 通り芯과 달리 라벨의 좌우 정렬이 일정하지 않아(실물 p8의 좌단 x는 108~198로\r\n * 흩어진다) 라벨 밴드를 앵커로 쓸 수 없다. 앵커는 **치수 열**이고, 치수가 자기\r\n * 구간의 중점에 놓인다는 관계로 축척과 레벨 위치를 함께 푼다.\r\n */\r\nexport interface ElevationCandidate {\r\n  /** 이 계열이 걸리는 軸組図 제목들(원문). 한 계열이 여러 通り에 공통으로 걸린다 */\r\n  titles: string[]\r\n  /** 도면 좌표 순 — 위에서 아래로 */\r\n  levels: ElevationLevel[]\r\n  /** 인접 레벨 사이 치수(mm). 길이는 levels.length - 1 */\r\n  heightsMm: number[]\r\n  scalePtPerMm: number\r\n}\r\n\r\nexport interface ParsedFrameElevations {\r\n  elevations: ElevationCandidate[]\r\n  issues: ElevationIssue[]\r\n}\r\n\r\n/** 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\nexport const PLAN_APPLY_REFUSALS = [\r\n  '階未指定',\r\n  '他階部材あり通り芯変更不可',\r\n] as const\r\n\r\nexport type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\r\n\r\n/** 부호 하나를 넣지 못한 사유. 지어내는 대신 이 코드로 남긴다 */\r\nexport const PLAN_APPLY_SKIPS = [\r\n  '断面未登録',\r\n  '部材種別相違',\r\n  '格子外',\r\n  '断面複数該当',\r\n] as const\r\n\r\nexport type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\r\n\r\n/** 階高 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\nexport const ELEVATION_APPLY_REFUSALS = [\r\n  '階範囲不正',\r\n  '部材あり階置換不可',\r\n] as const\r\n\r\nexport type ElevationApplyRefusal =\r\n  (typeof ELEVATION_APPLY_REFUSALS)[number]\r\n\r\n#!/usr/bin/env python3\r\n\"\"\"Check sources and declared paths; report args/globs use cwd, claims use repo root.\"\"\"\r\n\r\nimport argparse\r\nimport glob\r\nimport json\r\nimport re\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\ndef sources(value):\r\n    if isinstance(value, dict):\r\n        for key, child in value.items():\r\n            if key == \"source\" and isinstance(child, str):\r\n                yield child\r\n            yield from sources(child)\r\n    elif isinstance(value, list):\r\n        for child in value:\r\n            yield from sources(child)\r\n\r\n\r\ndef path_claims(value):\r\n    if isinstance(value, dict):\r\n        for key, child in value.items():\r\n            if key in (\"paths_verified\", \"paths_expected_absent\", \"fabricated_paths\") and isinstance(child, list):\r\n                for item in child:\r\n                    file = item.get(\"path\") if isinstance(item, dict) else item\r\n                    exists = not isinstance(item, dict) or item.get(\"exists\") is not False\r\n                    yield key, file, key == \"paths_verified\" and exists\r\n            yield from path_claims(child)\r\n    elif isinstance(value, list):\r\n        for child in value:\r\n            yield from path_claims(child)\r\n\r\n\r\ndef require_file(path):\r\n    if not path.is_file():\r\n        raise ValueError(\"file_missing: no regular file\")\r\n\r\n\r\ndef read_json(path):\r\n    require_file(path)\r\n    try:\r\n        return json.loads(path.read_text(encoding=\"utf-8-sig\"))\r\n    except (json.JSONDecodeError, UnicodeError) as error:\r\n        raise ValueError(f\"json_parse_error: {error}\") from error\r\n\r\n\r\ndef resolve(value, pointer):\r\n    if pointer == \"\":\r\n        return\r\n    if not pointer.startswith(\"/\") or re.search(r\"~(?![01])\", pointer):\r\n        raise ValueError(\"invalid_pointer: expected / tokens with ~0 or ~1 escapes\")\r\n    for raw in pointer[1:].split(\"/\"):\r\n        token = raw.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\r\n        if isinstance(value, dict):\r\n            if token not in value:\r\n                raise ValueError(f\"missing_key: {token!r}\")\r\n            value = value[token]\r\n        elif isinstance(value, list):\r\n            if (not re.fullmatch(r\"0|[1-9][0-9]*\", token)\r\n                    or len(token) > len(str(len(value))) or int(token) >= len(value)):\r\n                raise ValueError(f\"array_index: {token!r} invalid for length {len(value)}\")\r\n            value = value[int(token)]\r\n        else:\r\n            raise ValueError(f\"pointer_type: cannot traverse {type(value).__name__}\")\r\n\r\n\r\ndef failure(report, file, pointer, error):\r\n    reason = f\"file_read_error: {error}\" if isinstance(error, OSError) else str(error)\r\n    print(json.dumps({\"report\": str(report), \"file\": file, \"pointer\": pointer, \"reason\": reason}))\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=__doc__)\r\n    parser.add_argument(\"reports\", nargs=\"+\")\r\n    args = parser.parse_args()\r\n    failed = False\r\n    for pattern in args.reports:\r\n        reports = [pattern] if Path(pattern).is_file() else sorted(glob.glob(pattern)) or [pattern]\r\n        for report in reports:\r\n            try:\r\n                data = read_json(Path(report))\r\n            except (ValueError, OSError) as error:\r\n                failure(report, report, None, error)\r\n                failed = True\r\n                continue\r\n            for citation in sources(data):\r\n                file, separator, pointer = citation.partition(\"#\")\r\n                try:\r\n                    path = ROOT / file\r\n                    require_file(path)\r\n                    if separator:\r\n                        resolve(read_json(path), pointer)\r\n                except (ValueError, OSError) as error:\r\n                    failure(report, file, pointer if separator else None, error)\r\n                    failed = True\r\n            for field, file, expected in path_claims(data):\r\n                try:\r\n                    if not isinstance(file, str) or not file:\r\n                        raise ValueError(f\"path_claim_invalid: {field} requires a path\")\r\n                    if (ROOT / file).exists() != expected:\r\n                        reason = \"path_claim_missing\" if expected else \"path_claim_unexpected\"\r\n                        raise ValueError(f\"{reason}: {field} requires exists={expected}\")\r\n                except (ValueError, OSError) as error:\r\n                    failure(report, file, None, error)\r\n                    failed = True\r\n    return int(failed)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"rg -n 'R10|R15|부분 격자|도면 인식' AGENTS.md CLAUDE.md docs/RISKS.md docs/MILESTONES.md; Get-Content -Encoding UTF8 src/lib/import/framing-plan/parse.ts -TotalCount 180; Get-Content -Raw -Encoding UTF8 package.json\"","aggregated_output":"docs/RISKS.md:21:- **R10 (열림 — 2차 코퍼스 포맷 과적합)** 2차 코퍼스(22면·발주처 7곳)를 더한 결과, 독립 전사 골든은 격자 7/7면·階高 3/3면·リスト 5/5면이 통과했다. 남은 것은(phase 37 종료 HEAD로 36면 재실행, Claude 실측 2026-09-03 18:30) 골든이 없는 伏図 면의 `寸法列曖昧`·`通り芯対応不明`(fuji-p15·tsu-p20)·`ラベル文字混在`(karatsu-jikugumi2), 골든 면에서도 블록 밖에 남는 잉여 격자와 `寸法欠落`(shibata-p1·tsu-p16), リスト·軸組図 면에 생기는 부분 격자 오탐 `寸法欠落`(fuji-p20·ina-p7·saiki-p2·shibata-p13), 그리고 壁·スラブ·shibata 大梁·柱リスト(p7) 미전사다. 2段筋 본수, 頭注의 特記 기본값, 스케치 주기형 柱リスト도 미지원이다. phase 36 step 5가 `refuted`로 끝났으나, 회전 글리프를 잇지 못한 반증 방법과 ojkk-p4 対象外 12칸의 원문 일치 개선을 재대조했고 phase 37 step 0이 이를 다시 반증해 불성립으로 판정했다. R3(일본 사용자 접점 0) 때문에 실패 도면 수집은 사용자 동의가 필요하며, 닫지 않는다 (판정서 `phases/36-corpus-widen-2/step5-adjudication.json`, `phases/37-corpus-widen-2-close/step0-report.json`)\r\ndocs/RISKS.md:23:  **phase 38·39 보충**: tsu-p21·p22의 階高는 각각 6레벨·5구간으로 확정했고 두 면의 모든 제목 블록이 전체 높이·라벨 대조를 통과한다(`phases/38-elevation-close/step0-report.json#/claims/C4`, `phases/38-elevation-close/step3-report.json#/implementation/golden`, `tests/plan-import/corpus2-elevation.test.ts`). 레벨 라벨 화이트리스트는 `2FL` 같은 레벨 표기를 통과시키며(`phases/38-elevation-close/step4-report.json#/survey/acceptedTrueLevelLabels/2/text`), `1FL`을 포함한 `・基礎梁天端から1FLまでは打増しとする。` 같은 문장도 통과시킨다(`phases/38-elevation-close/step4-report.json#/survey/acceptedSentences/0/text`). 36면 조사에서는 이 문장들이 가로 창·레벨 위치 허용 범위 밖이라 결과에 닿지 않았으며, 현재 코퍼스로 효과를 반증할 수 없는 문장 배제 규칙은 만들지 않았다(`phases/38-elevation-close/step4-report.json#/survey`). 보고서에 제외 문자열로 기록된 `1SL`(`phases/38-elevation-close/step4-report.json#/survey/rejectedLevelLikeStrings/0/text`)·`2SL`(`phases/38-elevation-close/step4-report.json#/survey/rejectedLevelLikeStrings/1/text`)·`SL+756.70`(`phases/38-elevation-close/step4-report.json#/survey/rejectedLevelLikeStrings/3/text`) 등 SL 계열은 의도적으로 제외한다. SL 계열 자체의 골든을 확보하기 전에는 지원하지 않는다. **軸組図 골든의 `axis`는 通り芯 라벨·스팬의 전사 상호검증용 기준 데이터다.** 軸組図 파서에 격자 생성을 요구하는 기대값이 아니며, 軸組図 면에서 생기는 부분 격자는 R15의 오탐이다. 전사한 axis는 같은 건물의 伏図 격자 골든과 대조한다. tsu p21의 `elevations[1]`과 p22의 `elevations[0]`·`elevations[1]`에 axis 전사를 완료했다(`phases/40-citation-integrity/step0-report.json#/claims/5/evidence/items/7`, `phases/40-citation-integrity/step0-report.json#/claims/5/evidence/items/8`, `phases/40-citation-integrity/step0-report.json#/claims/5/evidence/items/9`). p21의 모든 軸組図 블록은 같은 X축을, p22의 모든 블록은 같은 Y축을 쓰므로 제목 공유 항목도 axis를 확정할 수 있다(`phases/40-citation-integrity/step0-report.json#/claims/2/evidence/conclusion`). **미전사 axis는 0개**이며, `axis` 없는 elevation 항목이 없음을 `tests/plan-import/corpus2-elevation.test.ts`가 고정한다(`phases/40-citation-integrity/step0-report.json#/claims/5/evidence/missing_axis_count`). 레벨 전사의 개선과 axis 대조 보강으로 코퍼스 대표성 문제까지 닫지는 않는다.\r\ndocs/RISKS.md:27:- **R15 (열림 — 合計 없는 축의 문턱 안정성)** phase 37 step 5의 sweep에서 T=4는 36면·`gridPages=23`이고 기존 `kani-p38`·`kani-p39`·`yokohama-p6`·`yokohama-p7`의 `寸法欠落`을 재현했다. T=6은 같은 `gridPages=23`에서 요구한 4면을 복원했고, T=15는 `gridPages=26`, T=30도 `gridPages=26`, T=40도 `gridPages=26`이었으나 `fuji-p17`에서만 `寸法列曖昧` 오탐이 추가됐다. T=6→15 사이에 늘어난 3면은 `fuji-p20`(断面リスト)·`saiki-p2`(柱・壁・スラブリスト)·`shibata-p13`(軸組図)으로, 伏図가 아닌 면의 부분 격자 오탐이다. 伏図 골든 7면과 기존 14면은 T=6에서 동일했다. 이번에는 `alongDistance` 최댓값과 경쟁 치수 최솟값을 미측정했다. 伏図를 가진 발주처는 SOURCES.md 기준 2곳에서 8곳으로 늘었지만, R15를 닫지는 않는다 (판정서 `phases/36-corpus-widen-2/step5-adjudication.json`·`phases/37-corpus-widen-2-close/step5-report.json`).\r\ndocs/RISKS.md:29:  **階高 한 면 상수 항목은 해소**: `SHORT_DIMENSION_SCALE_TOLERANCE_RATIO = 1.0`을 짧은 치수 공통 허용비로 쓴다. 뜻은 「밀림이 기대 간격 자체를 넘지 않는다」다. `phases/38-elevation-close/step3-report.json`의 `short_dimension_sweep`은 36면의 편차를 기록하고, `counterexamples.ratio_0_45`는 0.45에서 tsu 꼬리가 빠짐을, `corpus_sweep`은 0.49 대비 1.0에서 tsu-p21·p22만 바뀜을 확인했다. `counterexamples.ratio_5_0`에서는 hirosaki 경쟁 꼬리의 후보 자격이 달라져도 5.0의 최종 출력이 1.0과 같았다. 따라서 최종 출력만으로 허용비를 구별하지 못하는 무차별성이 있지만, 보고서가 측정하지 않은 연속구간의 양 끝값까지 확정하지 않는다. 채택값은 관측된 동일 출력의 선택지 가운데 기하적 의미가 있는 값이며, 실측 편차에 붙인 상수가 아니다. `phases/39-axis-claim/step2-report.json`의 `f1_comment_verification`도 이 근거 범위를 확인한다. **伏図 문턱과 부분 격자 오탐은 그대로 남아 R15 자체는 열림이다.**\r\ndocs/MILESTONES.md:16:- [x] **M3c** — 완료 (2026-08-28, ADR-022). 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **완료 판정**: 남은 것은 두 원문 0건이거나 제품이 형상·本数를 지어내야 하는 `パネルゾーン帯筋`·`溶接閉鎖フープ`뿐이며, 후자는 1通則2)에 따라 제작방식과 무관하게 断面周長으로 산정되어 수량도 변하지 않으므로 만들지 않기로 했다.\r\ndocs/MILESTONES.md:17:- [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `girderMainAsymmetric` 후보로 보존하고 phase 21에서 Grid 축 순서 자동 또는 사용자 선택으로 始端/終端에 반영한다. 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 좌우 상이 8칸은 방향 미선택을 기본으로 유지한 비대칭 후보로 반영 단계에 넘겼다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 고강도 전단보강근·円形柱 표현, `カットオフ` 값 반영 — 位置 열이 있는 3란 표는 phase 21에서 취입까지 닫혔고, 위치 없는 반폭 표기는 원문 `raw` 보존까지. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\r\ndocs/MILESTONES.md:18:   - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — 断面リスト 취입에서 좌우 비대칭 主筋의 始端/終端 대응에 사용한다. ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조). **끝난 것**(2026-08-26, ADR-035·phase 23): 階 라벨↔`Story` 대응 — 伏図 제목과 `Story`/断面의 정확 일치 자동 선택, 미일치 시 사용자 선택, stale `storyId` 리셋을 고정했다.\r\ndocs/MILESTONES.md:20:   - **phase 38·39 결과**: tsu-p21·p22 階高의 6레벨·5구간을 모든 제목 블록에서 대조하고, 레벨 라벨은 순서 대응으로, 짧은 치수는 `SHORT_DIMENSION_SCALE_TOLERANCE_RATIO = 1.0`의 공통 규칙으로 정리했다. 36면 실측에서 확인된 허용비의 효과와 최종 출력 동일성까지만 근거로 남긴다(`phases/38-elevation-close/step3-report.json`). 문장도 통과하는 레벨 화이트리스트와 SL 계열 제외는 유지한다(`phases/38-elevation-close/step4-report.json`). axis 기대값을 흔들어도 통과하던 반증을 계기로 tsu의 `X5` 누락을 바로잡고, 軸組図 axis와 같은 건물 伏図 격자의 정·역방향 부분열·스팬 합 대조를 추가했다. phase 39 종료 시점에 미전사 axis가 3개 골든 항목이었고(`phases/39-axis-claim/step1-report.json#/skipped_axis_count`), phase 40에서 tsu p21 `elevations[1]`과 p22 두 항목을 전사해 **미전사 axis는 0개**다(`phases/40-citation-integrity/step0-report.json#/claims/5/evidence/missing_axis_count`). 한 면의 모든 軸組図 블록이 같은 축을 쓰므로 제목 공유 항목도 axis 값이 일의로 정해진다(`phases/40-citation-integrity/step0-report.json#/claims/2/evidence/conclusion`). 키 커버리지 가드는 전체 32개 경로 중 18개를 실제 대조 테스트, 14개를 출처·주석 등 참고 전용으로 등록한다. 혼합 제목 `blocks[].title`의 대조는 구조를 구별한 뒤로 유보했다(`phases/39-axis-claim/step2-report.json`). 階高의 한 면 상수 문제는 해소했으며, 코퍼스 한계와 伏図 문턱 때문에 R10·R15는 열림을 유지한다.\r\nCLAUDE.md:33:- 마일스톤 순서를 건너뛰지 말 것. M0(스파이크) → M1(워킹 스켈레톤) → M2(룰팩) → M3a(단일 스팬 大梁·뷰어) → M3b(다스팬·継手) → M3c(고유 상세) → M4(확장) → M5(UX 리뷰). 도면 인식(로컬)은 M3a 이후 병행 가능한 별도 트랙 — 입력 파이프라인이라 산정 로직 마일스톤과 코드 영역이 겹치지 않는다 (ADR-018)\nCLAUDE.md:57:| 도면 인식(로컬) | **진행 중** | tsu-p21·p22 階高 골든의 6레벨·5구간을 전 블록에서 대조하고 짧은 치수 허용비 1.0을 공통 규칙으로 정리했다. 軸組図 axis는 伏図 골든과 전사 상호검증하며 미전사 axis는 0개다. 잔여: 伏図 문턱·부분 격자 오탐, 레벨 문장·SL 계열 한계, 壁·スラブ·shibata 大梁 미전사, 2段筋·特記 기본값·스케치 주기형 柱リスト 미지원. R10·R15 열림 — 근거는 docs/RISKS.md의 해당 항과 docs/ADR.md의 ADR-030 보충 |\nCLAUDE.md:64:마일스톤 순서를 건너뛰지 말 것. 도면 인식은 M3a 이후 병행 가능한 별도 트랙이다 (ADR-018).\nCLAUDE.md:81:| R10 | 열림 | tsu-p21·p22 階高 6레벨·5구간의 전 블록 대조 완료. 軸組図 axis는 伏図 골든과 상호검증하는 기준 데이터이며 미전사 axis는 0개다. 레벨 화이트리스트의 문장 통과·SL 계열 제외, 伏図 오탐과 リスト 미전사·2段筋·特記 기본값·스케치 주기형 柱リスト 한계는 계속 열림. 근거: docs/RISKS.md R10 |\nCLAUDE.md:86:| R15 | 열림 | 伏図 문턱 안정성과 부분 격자 오탐은 계속 열림. 階高의 한 면 상수 문제는 해소: SHORT_DIMENSION_SCALE_TOLERANCE_RATIO = 1.0, 36면 편차 조사와 보고된 동일 출력의 선택지에 근거한 공통 규칙이다. 미측정 연속구간 경계는 주장하지 않는다. 근거: docs/RISKS.md R15 |\nAGENTS.md:36:- 마일스톤 순서를 건너뛰지 말 것. M0(스파이크) → M1(워킹 스켈레톤) → M2(룰팩) → M3a(단일 스팬 大梁·뷰어) → M3b(다스팬·継手) → M3c(고유 상세) → M4(확장) → M5(UX 리뷰). 도면 인식(로컬)은 M3a 이후 병행 가능한 별도 트랙 — 입력 파이프라인이라 산정 로직 마일스톤과 코드 영역이 겹치지 않는다 (ADR-018)\nAGENTS.md:60:| 도면 