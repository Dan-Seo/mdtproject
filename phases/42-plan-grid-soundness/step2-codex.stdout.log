tproject/node_modules/@vitest/runner/dist/chunk-artifact.js:1903:26\\n    at file:///C:/Users/emper/mdtproject/node_modules/@vitest/runner/dist/chunk-artifact.js:2326:20\\n    at new Promise (<anonymous>)\\n    at runWithCancel (file:///C:/Users/emper/mdtproject/node_modules/@vitest/runner/dist/chunk-artifact.js:2323:10)\\n    at file:///C:/Users/emper/mdtproject/node_modules/@vitest/runner/dist/chunk-artifact.js:2305:20\"\r\n            ],\r\n            \"meta\": {},\r\n            \"tags\": []\r\n          }\r\n        ],\r\n        \"num_passed_tests\": 28,\r\n        \"removed_check\": \"    if (\\n      !Number.isFinite(result.scalePtPerMm) ||\\n      result.scalePtPerMm < MIN_PLAN_SCALE_PT_PER_MM ||\\n      result.scalePtPerMm > MAX_PLAN_SCALE_PT_PER_MM\\n    ) {\\n      issue('縮尺範囲外')\\n      return []\\n    }\\n\",\r\n        \"before_sha256\": \"c14dd44887a56e073f9457d6a25e3d2e4164a839e3c88b6fa032aa50a28aada3\",\r\n        \"mutated_sha256\": \"77e05715063d7903fcacf10a5201931e8fda0c82e64ba975ee355b4a51a35631\",\r\n        \"restored_sha256\": \"c14dd44887a56e073f9457d6a25e3d2e4164a839e3c88b6fa032aa50a28aada3\",\r\n        \"byte_identical\": true\r\n      }\r\n    ],\r\n    \"mutation_limit\": \"P1 제거 시 P2가 영축척 후보를 여전히 거부할 수 있다. P1 테스트는 특정 사유 코드의 소실을 검출한다. P2 테스트는 하한·상한 밖 입력과 合計 유무, 정상 포함 경계를 검사한다.\",\r\n    \"full\": {\r\n      \"command\": \"npx vitest run --reporter=json --outputFile=tmp/phase42-step1/full-test.json\",\r\n      \"exit_code\": 0,\r\n      \"passed\": 1811,\r\n      \"failed\": 0,\r\n      \"pending\": 0,\r\n      \"success\": true\r\n    },\r\n    \"lint\": {\r\n      \"command\": \"npm run lint\",\r\n      \"exit_code\": 0,\r\n      \"errors\": 0,\r\n      \"warnings\": 1,\r\n      \"warning\": \"기존 src/app/api/oncall/alert/route.test.ts:161:23 _omitted unused 경고. 이 step의 변경 파일이 아니다.\"\r\n    },\r\n    \"typecheck\": {\r\n      \"command\": \"npx tsc --noEmit\",\r\n      \"exit_code\": 0\r\n    },\r\n    \"validation_timing\": \"전체 테스트·lint·tsc 완료 후 parse.ts의 주석 한 단어만 정정했다. 정정 후 두 변조를 다시 실행하고 최종 파일의 바이트 복원을 확인했다.\",\r\n    \"citations\": {\r\n      \"command\": \"python scripts/check-citations.py phases/42-plan-grid-soundness/step1-report.json\",\r\n      \"exit_code\": 0\r\n    },\r\n    \"diff_check\": {\r\n      \"command\": \"git diff --check\",\r\n      \"exit_code\": 0\r\n    }\r\n  },\r\n  \"scope_checks\": {\r\n    \"fixtures_and_goldens_unchanged\": true,\r\n    \"compared_fixture_files\": 61,\r\n    \"fixture_comparison\": \"git show 직전 커밋과 모든 추적 파일의 LF 정규화 바이트를 대조했다. 36면 JSON은 전후 실바이트 SHA-256도 동일하다.\",\r\n    \"existing_test_bytes_unchanged_after_removing_added_tests\": true,\r\n    \"midpoint_tolerance_unchanged\": 15,\r\n    \"no_page_or_issuer_filter\": true,\r\n    \"no_new_title_filter\": true,\r\n    \"no_block_logic_changes\": true,\r\n    \"rulepack_unchanged\": true,\r\n    \"harness_not_executed_or_terminated\": true\r\n  },\r\n  \"reproduction\": {\r\n    \"baseline_commit\": \"9b2c50ff8e2fe3bf5ac1de575cc7bdfbb44109ca\",\r\n    \"instructions\": [\r\n      \"직전 커밋의 파서를 사용하는 체크아웃에서 census.ts를 before로 실행한다.\",\r\n      \"최종 파서에서 같은 36면을 after로 실행한다.\",\r\n      \"census pages의 grids 전체를 비교하되 fuji-p20 X와 saiki-p2 X만 탈락했는지 assert한다. blocks는 36면 모두 전체 객체 equality를 assert한다.\",\r\n      \"mutate.py는 각 if 검사 블록을 한 번씩 지우고 파일 단위 Vitest를 실행해 JSON 결과를 검사한다. finally에서 원본 바이트를 쓰고 SHA-256을 대조한다.\",\r\n      \"census.ts·mutate.py는 아래 문자열을 임시 경로에 그대로 기록해 재현할 수 있다. 임시 파일은 제품·fixture 산출물이 아니다.\"\r\n    ],\r\n    \"scripts\": {\r\n      \"census.ts\": \"import { createHash } from 'node:crypto'\\nimport { execFileSync } from 'node:child_process'\\nimport { readFileSync, readdirSync, writeFileSync } from 'node:fs'\\nimport { parseFramingPlan } from '../../src/lib/import/framing-plan/parse'\\nimport { compact, recoverRows } from '../../src/lib/import/runs'\\n\\nconst parserPath = 'src/lib/import/framing-plan/parse.ts'\\nconst sha = (value: string | Buffer) => createHash('sha256').update(value).digest('hex')\\nif (process.argv[2] === 'before') {\\n  const committed = execFileSync('git', ['show', `HEAD:${parserPath}`])\\n  const working = readFileSync(parserPath)\\n  if (committed.toString().replace(/\\\\r\\\\n/g, '\\\\n') !== working.toString().replace(/\\\\r\\\\n/g, '\\\\n')) throw Error('Parser differs from HEAD')\\n}\\nconst directory = 'tests/fixtures/section-import/textitems'\\nconst files = readdirSync(directory).filter(file => file.endsWith('.json')).sort()\\nif (files.length !== 36) throw Error(`Unexpected page count: ${files.length}`)\\nconst pages = files.map(file => {\\n  const bytes = readFileSync(`${directory}/${file}`)\\n  const fixture = JSON.parse(bytes.toString())\\n  const output = parseFramingPlan({ ...fixture.page, items: fixture.items })\\n  return {\\n    file, fixture_sha256: sha(bytes), output,\\n    title_tokens: recoverRows(fixture.items).flatMap(row => row.segments.map(segment => compact(segment.text))).filter(text => /伏図|柱芯線図|リスト/.test(text)),\\n  }\\n})\\nconst result = {\\n  head: execFileSync('git', ['rev-parse', 'HEAD'], {encoding:'utf8'}).trim(),\\n  parser_sha256: sha(readFileSync(parserPath)), pages,\\n}\\nwriteFileSync(`tmp/phase42-step1/${process.argv[2]}.json`, JSON.stringify(result, null, 2) + '\\\\n')\\nconsole.log(JSON.stringify({pages:pages.length, grids:pages.reduce((sum, p)=>sum+p.output.grids.length,0), blocks:pages.reduce((sum,p)=>sum+p.output.blocks.length,0), outliers:pages.flatMap(p=>p.output.grids.filter(g=>g.scalePtPerMm<0.005||g.scalePtPerMm>0.1).map(g=>({file:p.file,...g}))), karatsu:pages.find(p=>p.file==='karatsu-fukuzu-p1.json')}))\\n\",\r\n      \"mutate.py\": \"import hashlib\\nimport json\\nfrom pathlib import Path\\nimport subprocess\\n\\nroot = Path.cwd()\\nwork = root / 'tmp/phase42-step1'\\nparser = root / 'src/lib/import/framing-plan/parse.ts'\\noriginal = parser.read_bytes()\\ntext = original.decode('utf-8')\\nsha = lambda content: hashlib.sha256(content).hexdigest()\\nmutants = {\\n    'P1': \\\"    if (\\\\n      result.axes.some(\\\\n        (axis, index) =>\\\\n          index > 0 && axis.positionPt === result.axes[index - 1].positionPt,\\\\n      )\\\\n    ) {\\\\n      issue('通り芯座標重複')\\\\n      return []\\\\n    }\\\\n\\\",\\n    'P2': \\\"    if (\\\\n      !Number.isFinite(result.scalePtPerMm) ||\\\\n      result.scalePtPerMm < MIN_PLAN_SCALE_PT_PER_MM ||\\\\n      result.scalePtPerMm > MAX_PLAN_SCALE_PT_PER_MM\\\\n    ) {\\\\n      issue('縮尺範囲外')\\\\n      return []\\\\n    }\\\\n\\\",\\n}\\nresults = []\\nfor name, block in mutants.items():\\n    normalized = text.replace('\\\\r\\\\n', '\\\\n')\\n    assert normalized.count(block) == 1\\n    try:\\n        parser.write_text(normalized.replace(block, ''), encoding='utf-8', newline='')\\n        changed_sha = sha(parser.read_bytes())\\n        command = ['npx.cmd', 'vitest', 'run', 'src/lib/import/framing-plan/parse.test.ts', '--reporter=json', f'--outputFile=tmp/phase42-step1/mutant-{name}.json']\\n        run = subprocess.run(command, capture_output=True, text=True, encoding='utf-8')\\n        report = json.loads((work / f'mutant-{name}.json').read_text(encoding='utf-8'))\\n        failed = [a for suite in report['testResults'] for a in suite['assertionResults'] if a['status'] == 'failed']\\n        assert run.returncode == 1 and len(failed) == 1\\n        assert failed[0]['title'].startswith(name + ':')\\n    finally:\\n        parser.write_bytes(original)\\n        assert parser.read_bytes() == original\\n    results.append({'property': name, 'command': command, 'exit_code': run.returncode, 'failed_tests': failed, 'num_passed_tests': report['numPassedTests'], 'removed_check': block, 'before_sha256':sha(original), 'mutated_sha256':changed_sha, 'restored_sha256':sha(parser.read_bytes()), 'byte_identical':True})\\n(work / 'mutations.json').write_text(json.dumps(results, ensure_ascii=False, indent=2) + '\\\\n', encoding='utf-8')\\nprint(json.dumps([{'property': r['property'], 'exit_code':r['exit_code'], 'failed_test':r['failed_tests'][0]['title'], 'before_sha256':r['before_sha256'], 'restored_sha256':r['restored_sha256']} for r in results]))\\n\"\r\n    }\r\n  },\r\n  \"paths_verified\": [\r\n    \"AGENTS.md\",\r\n    \"docs/ADR.md\",\r\n    \"package.json\",\r\n    \"phases/42-plan-grid-soundness/index.json\",\r\n    \"phases/42-plan-grid-soundness/step0-report.json\",\r\n    \"phases/42-plan-grid-soundness/step1-report.json\",\r\n    \"phases/42-plan-grid-soundness/step1.md\",\r\n    \"scripts/check-citations.py\",\r\n    \"src/app/api/oncall/alert/route.test.ts\",\r\n    \"src/lib/import/framing-plan/parse.test.ts\",\r\n    \"src/lib/import/framing-plan/parse.ts\",\r\n    \"src/lib/import/framing-plan/types.ts\",\r\n    \"src/lib/import/runs.ts\",\r\n    \"src/lib/import/section-list/types.ts\",\r\n    \"src/lib/import/types.ts\",\r\n    \"src/locales/ja.json\",\r\n    \"src/locales/ko.json\",\r\n    \"tests/fixtures/plan-import/expected/fuji-kanritou-p17-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/hirosaki-kikyono-p21-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json\",\r\n    \"tests/fixtures/plan-import/expected/ina-pump-p6-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/karatsu-fukuzu-p1-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/karatsu-hashirashin-p1-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/karatsu-jikugumi1-p1-elevation.json\",\r\n    \"tests/fixtures/plan-import/expected/shibata-fire-p1-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/tsu-kanritou-p16-grid.json\",\r\n    \"tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json\",\r\n    \"tests/fixtures/plan-import/expected/tsu-kanritou-p22-elevation.json\",\r\n    \"tests/fixtures/section-import/SOURCES.md\",\r\n    \"tests/fixtures/section-import/expected/fuji-kanritou-p20-lists.json\",\r\n    \"tests/fixtures/section-import/expected/ina-pump-p7-lists.json\",\r\n    \"tests/fixtures/section-import/expected/kani-sakuragaoka-p38-foundation-girder.json\",\r\n    \"tests/fixtures/section-import/expected/karatsu-karayaku-s4-foundation-girders.json\",\r\n    \"tests/fixtures/section-import/expected/ojkk-akamichi-p2-columns.json\",\r\n    \"tests/fixtures/section-import/expected/ojkk-akamichi-p3-girders.json\",\r\n    \"tests/fixtures/section-import/expected/ojkk-akamichi-p4-walls-slabs.json\",\r\n    \"tests/fixtures/section-import/expected/saiki-fire-p1-girders.json\",\r\n    \"tests/fixtures/section-import/expected/saiki-fire-p2-columns.json\",\r\n    \"tests/fixtures/section-import/expected/yokohama-kanazawa-p13-columns.json\",\r\n    \"tests/fixtures/section-import/expected/yokohama-kanazawa-p14-girders.json\",\r\n    \"tests/fixtures/section-import/expected/yokohama-kanazawa-p15-slabs-walls.json\",\r\n    \"tests/fixtures/section-import/textitems/fuji-p15.json\",\r\n    \"tests/fixtures/section-import/textitems/fuji-p17.json\",\r\n    \"tests/fixtures/section-import/textitems/fuji-p18.json\",\r\n    \"tests/fixtures/section-import/textitems/fuji-p20.json\",\r\n    \"tests/fixtures/section-import/textitems/hirosaki-p21.json\",\r\n    \"tests/fixtures/section-import/textitems/hirosaki-p25.json\",\r\n    \"tests/fixtures/section-import/textitems/ina-p6.json\",\r\n    \"tests/fixtures/section-import/textitems/ina-p7.json\",\r\n    \"tests/fixtures/section-import/textitems/kani-p38.json\",\r\n    \"tests/fixtures/section-import/textitems/kani-p39.json\",\r\n    \"tests/fixtures/section-import/textitems/kani-p40.json\",\r\n    \"tests/fixtures/section-import/textitems/kani-p41.json\",\r\n    \"tests/fixtures/section-import/textitems/karatsu-fukuzu-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/karatsu-hashirashin-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/karatsu-jikugumi1-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/karatsu-jikugumi2-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/karatsu-shousai-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/ojkk-p2.json\",\r\n    \"tests/fixtures/section-import/textitems/ojkk-p3.json\",\r\n    \"tests/fixtures/section-import/textitems/ojkk-p4.json\",\r\n    \"tests/fixtures/section-import/textitems/saiki-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/saiki-p2.json\",\r\n    \"tests/fixtures/section-import/textitems/shibata-p1.json\",\r\n    \"tests/fixtures/section-import/textitems/shibata-p13.json\",\r\n    \"tests/fixtures/section-import/textitems/shibata-p7.json\",\r\n    \"tests/fixtures/section-import/textitems/tsu-p16.json\",\r\n    \"tests/fixtures/section-import/textitems/tsu-p20.json\",\r\n    \"tests/fixtures/section-import/textitems/tsu-p21.json\",\r\n    \"tests/fixtures/section-import/textitems/tsu-p22.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p13.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p14.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p15.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p6.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p7.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p8.json\",\r\n    \"tests/fixtures/section-import/textitems/yokohama-p9.json\",\r\n    \"tests/fixtures/section-import/title-block-exclusions.json\",\r\n    \"tests/plan-import/parse.test.ts\",\r\n    \"vitest.config.ts\"\r\n  ],\r\n  \"paths_expected_absent\": []\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"rg --files -g AGENTS.md -g CLAUDE.md -g '*42*' -g '*sweep*' -g '*soundness*'; Get-Content -Encoding UTF8 docs/ADR.md -Tail 45\"","aggregated_output":"CLAUDE.md\nAGENTS.md\n6. **ADR-035 §6과의 관계**: §6은 「階 라벨을 근거로 한 Story 신규 생성·개명·정렬은 하지 않는다」인데, .stb의 `StbStory@height`는 **라벨 근거의 추정이 아니라 명시적 레벨 데이터**이므로 §6의 사정 밖이다. 다만 이 항이 여는 것은 후보 생성까지이고, `Project.stories`를 만드는 것은 이 항의 범위가 아니다.\r\n7. **마일스톤 위치**: ST-Bridge 취입은 断面リスト(ADR-018)·伏図(ADR-030) 트랙과 코드 영역이 겹치지 않는(공용층 `textitems`·`runs`·`pdf-text`를 하나도 쓰지 않는) 또 하나의 입력 파이프라인 트랙이며, M2·M3c의 잔여와 병행한다.\r\n8. **하지 않는 것**: 断面(`StbSec*`)·배근·부재 배치·開口·かぶり·定着을 읽지 않는다 / 芯(중심선) 모델을 볼륨으로 해석하지 않는다(`StbMemberOffsetList` 미대응) / `kind_structure=\"LOAD\"`(壁式構造の壁)는 ADR-025·ADR-042대로 후보를 내지 않고 미대응으로 표시한다 / 버전 어댑터·요소 매핑 테이블·룰 DSL을 만들지 않는다(ADR-002) / .stb 원본과 XSD를 커밋하지 않고 런타임에 받지도 않는다 / 基礎·小梁·雑壁·杭 코드를 만들지 않는다(ADR-005) / .stb 쓰기(export)를 하지 않는다 / 재취입·차분 갱신을 하지 않는다(`Member.id`가 (階,符号,격자자리)뿐이라 매칭 키가 없다) / XML 파서·인코딩 변환 라이브러리를 추가하지 않는다.\r\n\r\n**판정 장치**: 이 취입의 출력이 맞았는지는 **제3자 MIT 실물 .stb 4건의 通り芯·階를 파서와 무관한 수단(python 정규식)으로 재계산한 값과 CI가 상시 대조하는 것**이 판정한다. 기대값은 파서 출력이 아니라 `phases/33-stbridge-skeleton-import/step0-report.json`의 실측에서 유도한다.\r\n\r\n**트레이드오프**: 확보한 코퍼스가 오픈소스 프로젝트의 테스트 픽스처이고 **사용자에게서 온 파일이 0건**이다 — ADR-018이 열린 근거(실도면 3부 확보)보다 약하다. 그리고 실물 2건이 S造라 RC 배근을 담은 파일은 ver 2.0.1 하나뿐이므로, **断面 트랙을 여는 것은 이 항의 근거로 정당화되지 않는다.** 이 한계는 `tests/fixtures/stb-import/SOURCES.md`의 「이 코퍼스가 대표하지 못하는 것」 절에 실측으로 남긴다. 또 .stb로 만든 案件은 開口 정보가 없어 欠除이 반영되지 않고 과대 계상된다(ADR-029의 상시 고지가 그대로 적용된다).\r\n\r\n**전제 검증 결과 (2026-08-28, phase 33 step 0·4)**: 전제 7건이 전부 `upheld`였다 — ADR-004 이유·트레이드오프절의 IFC 0회, RC 범위의 길이형 정착 속성 0개, 골격 요소의 네 버전 동일, `Grid`·`Story`가 회전각·`kind`·절대 표고를 담지 못함, node/jsdom의 `DOMParser` 분리, `TextDecoder('shift_jis')` 가용. **정정 1건**: 위 실측 4의 코드검색 수치는 초안에서 「둘 다 0건」이라고 적었으나 실측은 9건/0건이었다(결론은 유지 — 9건이 전부 토이 파일과 생성기다). step 4가 오라클의 공허함을 반증 시도해 뮤테이션 6곳이 서로 다른 테스트를 깨뜨렸고, 후보가 `Project`에 닿는 경로가 0건임을 확인했다. 코퍼스의 한계는 `tests/fixtures/stb-import/SOURCES.md`의 「이 코퍼스가 대표하지 못하는 것」에 실측으로 남겼다.\r\n\r\n### ADR-044: ST-Bridge 골격 후보의 반영은 伏図·軸組図와 같은 승인 규약을 따른다 (ADR-043 결정 6의 유보를 푼다)\r\n\r\n**맥락**: ADR-043은 후보 생성까지만 열고 「이 항이 여는 것은 후보 생성까지이고, `Project.stories`를 만드는 것은 이 항의 범위가 아니다」(결정 6 후단)로 반영을 유보했다. phase 33이 후보를 냈으므로 그 유보를 여기서 푼다. 지금 상태는 코드가 값을 내는데 화면에서 닿을 수 없는 것이며, 그것은 완성이 아니라 미완이다. 이 항은 ADR-043 결정 2(「후보는 사람 승인을 거쳐야만 입력이 된다」)를 뒤집지 않고 **그 승인이 무엇을 하는지**를 정한다.\r\n\r\n**실측** (2026-08-28, 코드 대조)\r\n\r\n1. **선례가 이미 있다.** `applyElevation`(`src/lib/import/framing-plan/apply.ts:243`)이 軸組図 후보로 `project.stories`를 통짜 교체하고 `members`를 비운다. 부재가 있으면 `discardMembers` 없이는 `部材あり階置換不可`로 거부한다. ADR-035 §6이 막은 것은 「階 라벨을 근거로 한 추정」이고 `StbStory@height`는 명시 레벨이므로 §6의 사정 밖이다 (ADR-043 결정 6 전단).\r\n2. **값의 단위가 맞는다.** `StbSkeletonCandidate.stories[].heightMm`는 인접 레벨의 차분(`src/lib/import/stb/candidates.ts:250`)이라 `Story.height`(階高)와 같은 뜻이고, 오름차순이라 `Project.stories`의 아래→위 순서와도 같다. 최상단 레벨은 지붕으로 소비돼 레벨 n개가 階 n−1개가 된다 — `applyElevation`과 같은 셈법이다.\r\n3. **그리드도 맞는다.** `StbGridCandidate.axes.length === spansMm.length + 1`이고 `Grid.xLabels`의 길이 규약(`isGridLabels`)도 `spans.length + 1`이다. `direction`은 距離가 재어지는 축이므로 `X`→`xSpans`, `Y`→`ySpans`다.\r\n4. **그런데 `applyFramingPlan`을 재사용할 수 없다.** 그것은 부재 배치까지 든 `PlanBlock`을 받아 部材를 놓는데, .stb 후보에는 배치가 없다(ADR-043 「하지 않는 것」). 같은 규약을 따르는 것과 같은 함수를 부르는 것은 다르다.\r\n\r\n**결정**\r\n\r\n1. **`src/lib/import/stb/apply.ts`를 새로 만든다.** 순수 TS이고 `Project`를 받아 새 `Project`를 돌려준다. `applyFramingPlan`·`applyElevation`을 부르지 않고 그 코드를 옮기지도 않는다 — 입력 타입이 다르다.\r\n2. **승인 단위는 「通り芯 그리드」와 「階 스택」 둘이고 서로 독립이다.** ADR-043 결정 2의 「블록」은 .stb에 블록이 하나뿐이므로 이 둘로 내려온다. 한쪽만 승인할 수 있다.\r\n3. **부재가 있으면 거부한다.** 그리드 교체와 階 교체 둘 다, 부재가 하나라도 있으면 사용자가 명시적으로 「버리고 진행」을 고르기 전에는 거부한다 — `applyElevation`의 `部材あり階置換不可`와 같은 규약이고, 조용한 기본값을 두지 않는다. 화면은 거부를 한 번 보여준 뒤에만 그 선택지를 낸다 (`PlanImport`와 같다).\r\n4. **`issues`가 비어 있지 않아도 승인은 막지 않는다. 다만 화면이 그것을 지우지 않는다.** 사유 코드와 `unsupported` 목록은 승인 뒤에도 화면에 남는다 — 「.stb에서 못 읽은 것이 있다」는 사실이 승인으로 사라지면 ADR-015의 승인이 형해화한다. 반대로 후보가 비어 있으면(`grids`·`stories`가 `[]`) 승인 자체를 낼 수 없다.\r\n5. **하지 않는 것**: 案件名을 `projectName`으로 덮어쓰지 않는다(사용자가 지은 이름이다) / 후보를 자동 승인하지 않는다 / 부분 승인(축 하나·階 하나)을 만들지 않는다 — 스팬 배열의 일부만 받으면 나머지 스팬이 근거 없이 남는다 / 재취입·차분 갱신을 하지 않는다(ADR-043) / 반영을 계기로 断面·부재·開口를 읽지 않는다 / `Grid`에 회전각·원점 필드를 더하지 않는다(ADR-043 실측 8의 결손은 거부로 다루고 근사하지 않는다).\r\n\r\n**판정 장치**: 실물 코퍼스 4건의 기대 후보(`tests/fixtures/stb-import/expected/`)를 그대로 반영해 나온 `Project`의 `grid`·`stories`를 픽스처로 고정하고, 반영 함수를 흔들면 그 픽스처가 깨진다. 즉 판정의 뿌리는 여전히 파서가 아니라 step0의 파서 무관 실측이다.\r\n\r\n**트레이드오프**: 그리드를 갈면 부재를 버려야 하므로 「.stb로 골격을 넣고 그 위에 손으로 부재를 놓는」 순서만 성립한다. 반대 순서(부재를 놓은 뒤 .stb로 골격을 보정)는 이 항이 열지 않는다 — 매칭 키가 없다(ADR-043 「하지 않는 것」). 그리고 이 항이 열어도 .stb 案件은 여전히 開口 정보가 없어 欠除이 반영되지 않는다(ADR-029의 상시 고지가 그대로 적용된다).\r\n\r\n### ADR-045: 2段筋과 빈 셀은 값을 지어내지 않고 원문 상태를 보존한다\r\n\r\n**배경**: phase 36·37의 2차 코퍼스에서 `2段筋` 표기와 リスト의 빈 셀이 확인됐다. 둘 다 현재 스키마와 규칙만으로는 제품이 본수나 배근값을 확정할 수 없는 자리다. 특히 빈 셀은 頭注의 「特記なき限り」가 있어도 해당 행의 값이 비어 있다는 사실을 바꾸지 않는다. 반면 phase 8의 幅止め筋은 셀이 없는 항목을 표제의 별도 特記 문장으로 읽은 것이므로, 빈 셀을 기본값으로 채우는 문제와 다르다.\r\n\r\n**결정**:\r\n\r\n1. **`2段筋` 슬래시 표기는 본수를 내지 않는다.** 원문 표기를 `raw`로 보존하고 `2段筋未対応`으로 남긴다. 스키마에 2段을 표현할지는 별도 결정으로 둔다.\r\n2. **リスト의 빈 셀은 頭注의 「特記なき限り」 기본값으로 채우지 않는다.** 값이 없는 후보로 남겨 원문 상태를 보존하며, 제품이 배근값을 만들어내지 않는다. phase 8의 幅止め筋 표제 읽기는 셀이 없는 항목의 명시 문장을 읽은 것이므로 이 결정의 예외가 아니다.\r\n\r\n**근거**: `phases/36-corpus-widen-2/step3-report.json`의 `two_layer_cells`와 `phases/36-corpus-widen-2/step4-report.json`의 `deferred_decisions`는 각각 2段筋과 빈 STP·腹筋을 확정하지 않은 상태로 기록한다. `phases/36-corpus-widen-2/step5-adjudication.json`은 2段筋 본수 0과 ina의 빈 STP 기본값 미반영을 재대조했고, 이는 ADR-012의 입력 경계와 ADR-004의 「지어내지 않는다」 원칙에 맞는다.\r\n\r\n**결과**: 스키마를 성급히 넓히지 않고 2段筋은 raw＋사유 코드로 남으며, 빈 셀은 특기 기본값으로 오염되지 않는다. 향후 스키마나 계약도서 우선 규칙을 별도 결정할 때까지 이 두 상태는 후보·내역 산정에 확정값으로 기여하지 않는다.\r\n","exit_code":0,"status":"completed"}}
