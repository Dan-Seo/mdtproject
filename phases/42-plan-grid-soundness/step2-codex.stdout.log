4\\ud06c\\uac00 \\ub4a4\\uc9d1\\uc5c8\\ub2e4. \\uc218\\ub3d9 \\uc785\\ub825\\uc740 \\uc5c6\\uc5b4\\uc9c0\\uc9c0 \\uc54a\\ub294\\ub2e4 \\u2014 \\ub798\\uc2a4\\ud130\\u00b7\\ubbf8\\uc9c0 \\ud615\\uc2dd\\uc5d0\\uc11c\\ub294 \\uadf8\\uac83\\uc774 \\uc720\\uc77c\\ud55c \\uae38\\uc774\\ub2e4. **\\ub05d\\ub09c \\uac83**(2026-08-13): TextItem \\ud53d\\uc2a4\\ucc98 5\\ubd80(\\ubc1c\\uc8fc\\ucc98 \\uc0c1\\uc774 3\\ubd80)\\u00b7PDF\\u2192TextItem\\uacfc TextItem\\u2192\\ud6c4\\ubcf4\\uc758 2\\ub2e8 \\ud30c\\uc11c\\u00b7\\ubd80\\uc7ac \\ud589 \\ub2e8\\uc704 \\u53cd\\u6620/\\u7121\\u8996 \\ucde8\\uc785 \\ud328\\ub110. \\uc2e4\\uac80\\uc99d `tests/e2e/uc12-section-import.js`. **\\ub05d\\ub09c \\uac83**(2026-08-14): \\u65ad\\u9762 \\ub77c\\ubca8 \\ud589\\uc774 \\uc5c6\\ub294 \\ud45c\\uc758 b\\u00d7D. \\uadfc\\uac70\\ub294 \\uc2a4\\ucf00\\uce58\\uc758 \\uac00\\ub85c\\u00b7\\uc138\\ub85c \\uce58\\uc218 \\ub458\\uc778\\ub370 \\uc138\\ub85c\\uac00 \\ud68c\\uc804 \\ubb38\\uc790\\uc5f4(rot=-90)\\uc774\\ub77c `recoverRows`\\uac00 \\ubc84\\ub9ac\\uace0 \\uc788\\uc5c8\\ub2e4 \\u2014 `verticalRuns`\\ub85c \\ub530\\ub85c \\ubcf5\\uc6d0\\ud574 \\uc9dd\\uc9c0\\uc5b4 \\u67f1 19/19\\u00b7\\u5927\\u6881 32/32\\uc744 \\uc804\\uc0ac\\uc640 \\ub300\\uc870 \\ud655\\uc815(ojkk). \\uc5f4 \\ubc30\\uc815 \\uc575\\ucee4\\ub294 \\u7b26\\u53f7 \\uc911\\uc2ec\\uc774 \\uc544\\ub2c8\\ub77c **\\u4f4d\\u7f6e \\uc5f4**\\uc774\\ub2e4(\\uce78 \\ud3ed\\uc774 \\ubd80\\uc7ac\\ub9c8\\ub2e4 \\ub2ec\\ub77c \\uc911\\uc2ec \\uc0ac\\uc774 \\uc911\\uc810\\uc774 \\uc2e4\\uc81c \\uce78 \\uacbd\\uacc4\\uc640 \\uc5b4\\uae0b\\ub09c\\ub2e4). **\\ub05d\\ub09c \\uac83**(2026-08-14): \\ud45c\\uc81c\\ub780\\uc758 \\u56f3\\u9762\\u540d\\u79f0 \\uce78\\uc774 \\ub9ac\\uc2a4\\ud2b8 \\ud0c0\\uc774\\ud2c0\\ub85c \\uc7a1\\ud600 \\uc2e4\\ubb3c PDF\\uc5d0\\uc11c \\ub9c8\\uc9c0\\ub9c9 \\uce35 \\ube14\\ub85d\\uc774 \\uc798\\ub9ac\\ub358 \\uac83(ojkk p3 25\\u219232\\uce78)\\uacfc \\uc720\\ub839 \\ub9ac\\uc2a4\\ud2b8 3\\uac74. \\ud53d\\uc2a4\\ucc9