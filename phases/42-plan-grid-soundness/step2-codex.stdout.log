 \\uc544\\ub2c8\\ub77c \\uc785\\ub825\\uc774\\ub77c \\uadfc\\uac70 \\uc5c6\\ub294 \\uc0c1\\ud55c\\uc744 \\uc9c0\\uc5b4\\ub0bc \\uc218 \\uc5c6\\ub2e4(\\uadf8\\ub798\\uc11c \\ud45c\\uc81c\\uac00 \\uc22b\\uc790\\ub85c \\ub05d\\ub098\\uba74 \\uadf8 \\uc22b\\uc790\\ub97c \\uadf8\\ub300\\ub85c \\uc77d\\ub294\\ub2e4). \\uc774 \\uacb0\\ud568\\uc740 phase 7\\uc758 \\uc804 AC\\ub97c \\ud1b5\\uacfc\\ud55c \\ucc44\\ub85c \\ub0a8\\uc544 \\uc788\\uc5c8\\uace0 \\uad50\\ucc28\\uac80\\uc99d\\uc774 \\uc7a1\\uc558\\ub2e4. **\\ub05d\\ub09c \\uac83**(2026-08-23, phase 7-section-fields): `\\u8179\\u7b4b: 2-D10`\\uacfc \\ud45c\\uc81c \\ud2b9\\uae30\\uc758 `\\u203b\\u5e45\\u6b62\\u7b4b\\u306fD10@1000`\\uc744 \\ud6c4\\ubcf4\\ub85c \\uc77d\\uace0, \\ubd80\\uc7ac \\ud589 \\uc2b9\\uc778 \\ub54c `GirderSection.sideBar`\\u00b7`widthTie`\\uc5d0 \\ubc18\\uc601\\ud55c\\ub2e4. \\ud6c4\\ubcf4\\uc758 `undefined`\\ub294 \\uae30\\uc874 \\uc218\\uae30\\uac12\\uc744 \\uc720\\uc9c0\\ud558\\uace0, \\u8179\\u7b4b \\u4f59\\u9577\\uc740 \\uae30\\uc874\\uac12 \\uc720\\uc9c0\\u00b7\\uc2e0\\uaddc 0(\\uaddc\\uc900\\uac12\\uc774 \\uc544\\ub2c8\\ub77c JASS 5 \\ubbf8\\ud655\\ubcf4\\uc5d0 \\ub530\\ub978 \\ubbf8\\uc785\\ub825)\\uc774\\ub2e4. **\\ub0a8\\uc740 \\uac83**: \\ud45c \\ud615\\uc2dd \\ucee4\\ubc84\\ub9ac\\uc9c0 \\ud655\\ub300(\\uc218\\uc9d1 \\uacc4\\uc18d), \\uace0\\uac15\\ub3c4 \\uc804\\ub2e8\\ubcf4\\uac15\\uadfc\\u00b7\\u5186\\u5f62\\u67f1 \\ud45c\\ud604, `\\u30ab\\u30c3\\u30c8\\u30aa\\u30d5` \\uac12 \\ubc18\\uc601 \\u2014 \\u4f4d\\u7f6e \\uc5f4\\uc774 \\uc788\\ub294 3\\ub780 \\ud45c\\ub294 phase 21\\uc5d0\\uc11c \\ucde8\\uc785\\uae4c\\uc9c0 \\ub2eb\\ud614\\uace0, \\uc704\\uce58 \\uc5c6\\ub294 \\ubc18\\ud3ed \\ud45c\\uae30\\ub294 \\uc6d0\\ubb38 `raw` \\ubcf4\\uc874\\uae4c\\uc9c0. `\\u7d99\\u624b\\u65b9\\u5f0f`\\uc740 \\uc804\\uc0ac \\ud53d\\uc2a4\\ucc98 4\\ubd80\\uc5d0 `\\u5727\\u63a5`\\u00b7`\\u6a5f\\u68b0\\u5f0f`\\u00b7`\\u7d99\\u624b` \\ubb38\\uc790\\uc5f4\\uc774 0\\uac74\\uc774\\ub77c \\uc774\\ubc88 phas