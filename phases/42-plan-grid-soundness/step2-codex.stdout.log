{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"rg -n 'function |export |interface |TITLE|title|band|rectangle|scalePtPerMm' src/lib/import/framing-plan/parse.ts; Get-Content -Raw -Encoding UTF8 src/lib/import/framing-plan/types.ts; Get-Content -Raw -Encoding UTF8 scripts/check-citations.py\"","aggregated_output":"43:export const DIMENSION_PATTERN = /^(?:\\d{1,3}(?:,\\d{3})+|\\d{2,})$/\r\n50:const BLOCK_TITLE_PATTERN = /伏図|柱芯線図/\r\n99:interface LabelToken {\r\n110:interface PositionedToken {\r\n116:interface DimensionToken {\r\n122:interface AxisSequence {\r\n139:interface ValidatedSequence extends AxisSequence {\r\n142:  scalePtPerMm: number\r\n159:function splitAxisLabels(\r\n260:interface CollectedTokens {\r\n264:  titles: PositionedToken[]\r\n274:function mergeVerticalFragments(items: TextItem[]): VerticalRun[] {\r\n330:function collectTokens(page: TextPage): CollectedTokens {\r\n334:  const titles: PositionedToken[] = []\r\n353:    if (BLOCK_TITLE_PATTERN.test(normalizedText)) {\r\n354:      titles.push({ text: normalizedText, x, y })\r\n382:  return { labels, dimensions, marks, titles }\r\n390:function axisSequences(\r\n396:  const bands: LabelToken[][] = []\r\n399:    const band = bands.at(-1)\r\n400:    const previous = band?.at(-1)\r\n402:      band &&\r\n406:      band.push(token)\r\n408:      bands.push([token])\r\n413:  for (const band of bands) {\r\n414:    if (band.length < 2) continue\r\n415:    const ordered = [...band].sort((a, b) => a[along] - b[along])\r\n481:function mergeAxisSequences(sequences: AxisSequence[]): AxisSequence[] {\r\n635:function dimensionCandidatesAt(\r\n641:  bandAcross: number,\r\n649:        Math.abs(token[across] - bandAcross) <= DIMENSION_WINDOW_PT\r\n658:function median(values: number[]): number {\r\n662:interface DimensionSolution {\r\n664:  scalePtPerMm: number\r\n675:function dimensionSolutions(\r\