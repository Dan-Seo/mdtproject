n\\rebar\\slab-ends.test.ts-8-// かぶりで決まるので、床板側の仕上げではなくこちらを渡す。\r\nsrc/domain\\rebar\\slab-ends.test.ts-9-const girderCover = {\r\nsrc/domain\\rebar\\slab-ends.test.ts:10:  memberKind: '大梁',\r\nsrc/domain\\rebar\\slab-ends.test.ts-11-  soilContact: false,\r\nsrc/domain\\rebar\\slab-ends.test.ts-12-  exposure: '屋外',\r\nsrc/domain\\rebar\\slab-ends.test.ts-13-  finish: '仕上げなし',\r\nsrc/domain\\rebar\\slab-ends.test.ts-14-}\r\nsrc/domain\\rebar\\slab-ends.test.ts-15-\r\n--\nsrc/domain\\rebar\\slab-ends.test.ts-106-    if (detail.kind !== '折曲げ定着') throw new Error('折曲げ定着 expected')\r\nsrc/domain\\rebar\\slab-ends.test.ts-107-    expect(detail.projectionMm).toBe(15 * 13)\r\nsrc/domain\\rebar\\slab-ends.test.ts-108-    expect(detail.usedRules.map(({ key }) => key)).not.toContain(\r\nsrc/domain\\rebar\\slab-ends.test.ts-109-      'anchorage.bent.projection.minimum',\r\nsrc/domain\\rebar\\slab-ends.test.ts-110-    )\r\nsrc/domain\\rebar\\slab-ends.test.ts:111:    expect(detail.usedRules.map(({ key }) => key)).not.toContain('anchorage.La')\r\nsrc/domain\\rebar\\slab-ends.test.ts-112-  })\r\nsrc/domain\\rebar\\slab-ends.test.ts-113-\r\nsrc/domain\\rebar\\slab-ends.test.ts-114-  it('は投影すら入らなければ不成立で落とす — 黙って短くしない', () => {\r\nsrc/domain\\rebar\\slab-ends.test.ts-115-    // 幅 240 の大梁なら使用可能 190 < Lb 195\r\nsrc/domain\\rebar\\slab-ends.test.ts-116-    expect(() => end({ face: '上端', supportWidthMm: 240 })).toThrow(\r\n--\nsrc/domain\\rebar\\slab.test.ts-143-\r\nsrc/domain\\rebar\\slab.test.ts-144-  it('は表5.3.6 の「スラブ、耐力壁以外の壁」行でかぶりを取る', () => {\r\nsrc/domain\\rebar\\slab.test.ts-145-    const bottom = byRole(generate('X'), 'X方向下端筋')\r\nsrc/domain\\rebar\\slab.test.ts-146-    const cover = bottom.ruleHits.find(\r\nsrc/domain\\rebar\\slab.test.ts-147-      ({ key, conditions }) =>\r\nsrc/domain\\rebar\\slab.test.ts:148:        key === 'cover.minimum' && conditions.memberKind === '床板',\r\nsrc/domain\\rebar\\slab.test.ts-149-    )\r\nsrc/domain\\rebar\\slab.test.ts-150-\r\nsrc/domain\\rebar\\slab.test.ts-151-    expect(cover?.value).toBe(20) // 仕上げあり — 柱・大梁の 30/40 とは別の行\r\nsrc/domain\\rebar\\slab.test.ts-152-    // 加工用かぶり ＝ 20 ＋ 10 ＝ 30。下端筋は板の下からその高さに立つ。\r\nsrc/domain\\rebar\\slab.test.ts-153-    expect(bottom.points[0][2]).toBe(30)\r\n--\nsrc/domain\\rebar\\wall.ts-84-  const coverQuery =\r\nsrc/domain\\rebar\\wall.ts-85-    section.wallClass === '耐力壁以外'\r\nsrc/domain\\rebar\\wall.ts-86-      ? {\r\nsrc/domain\\rebar\\wall.ts-87-          // 表5.3.6 の「スラブ、耐力壁以外の壁」行は exposure を持たない。\r\nsrc/domain\\rebar\\wall.ts-88-          // 雑壁は別の MemberKind ではなく、WallSection の区分としてこの行を選ぶ。\r\nsrc/domain\\rebar\\wall.ts:89:          memberKind: '雑壁',\r\nsrc/domain\\rebar\\wall.ts-90-          soilContact: false,\r\nsrc/domain\\rebar\\wall.ts-91-          finish: section.finish,\r\nsrc/domain\\rebar\\wall.ts-92-        }\r\nsrc/domain\\rebar\\wall.ts-93-      : coverConditions(section)\r\nsrc/domain\\rebar\\wall.ts-94-  const coverRule = lookupRule(pack, 'cover.minimum', coverQuery)\r\nName                  Length\r\n----                  ------\r\n001178206.pdf        1870828\r\n001888816.pdf       15374718\r\ndwg-kani-kids.pdf    7354614\r\ndwg-ojkk-zumen6.pdf  4325964\r\ndwg-yokohama.pdf     1260304\r\npdf-page-33.png       341524\r\npdf-page-34.png       162193\r\npdf-page-36.png       252915\r\npdf-page-37.png       267140\r\npdf-page-39.png       366827\r\ntable-5-3-1.png       427377\r\ntable-5-3-2.png       199740\r\ntable-5-3-4.png       308671\r\ntable-5-3-5.png       325477\r\ntable-5-3-6.png       466409\r\n--- slab model/rebar ---\r\nimport type { BarSize, SlabSection } from '../model/member'\r\nimport type { SlabRun } from '../model/project'\r\nimport type { Rebar, RebarRole, RebarZone } from '../model/rebar'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { coverConditions, lookupRule, lookupRuleSeries } from '../rules/lookup'\r\nimport type { RuleHit, RulePack } from '../rules/types'\r\nimport {\r\n  bandedSpliceRule,\r\n  distributionCount,\r\n  intervalSpliceCount,\r\n  spliceCount,\r\n  spliceLengthMm,\r\n  type SpliceBand,\r\n} from './measurement'\r\nimport { openingDeduction } from './opening'\r\nimport { resolveSlabEnd, type SlabEndDetail } from './slab-ends'\r\nimport { stirrupPositions } from './stirrup-layout'\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됥겗?띸춮?귝빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞???㎪릍??(ADR-028)??\r\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲??\r\n * 麗닷뭄?먦겗?끾퀡?ⓨ늽?띲겏若싥굙?뗣겗?㎯곲빓?뺛겘?싥굤??뼋?㎯겘?ゃ걦訝▼겢??ㄷ歟곥겗?끻겢?㏂겗?볝겓\r\n * ?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\r\n *\r\n * 1?욁겗?쇈겞?뷩걮?뚦룛?묉똻?ㅳ겗??*1?ㅳ겗?⒲꺍???밧릲**?㎯곦툓塋?춮?ⓧ툔塋?춮???с굮瓦붵걲??\r\n * 佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥??겎?갲?밧릲?쮇?밧릲?㎩닪?끹겓?쇈겤??\r\n *\r\n * ??꺖?ャ꺂佯㎪쮽??x 竊?X?싥굤?밧릲?걓 竊?Y?싥굤?밧릲?걕 竊??쏁쎍竊덃씮??툔塋?걣 0竊됥?\r\n * ?졼걢??X?밧릲??뎱嶺뗣겘 x ?ヤ섯?녈겍 y ?멧를?녈갳?밧릲??뎱嶺뗣겘 y ?ヤ섯?녈겍 x ?멧를?뜰?\r\n *\r\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲?뗣귛틞?욍겗?뗥룭??쉸餘듐꺕鼇?굺??굚??겎?곭첆?ⓨ릪?섅걦?볝겗?끹겗\r\n * 野얕괌?????뚪쟿??깿?먦굮?먦겂?╉걚?ゃ걚?귡뼀?ｃ겘?쇻궎?붵겏?ュ뀯?쎼걬?뚣굥?뚪뎱嶺뗣겘?⒲꺍??\r\n * 歷с굥??겎??SlabRun.openings` ?뚣꺀?녑벨與쇻겓?담걮?잆굚??굮誤뗣굥?귞텤?뗣겘鶯곥겏?뺛겂??\r\n * 鵝녷쎑?뚣겒????2竊덌폇竊됧틞??) ??뙷?녴겘?뚦틞?욍겗?룔걬?띲겎凉뺛걦??겎?곲뼀?ｃ걣?귙겂?╉굚\r\n * ?ｇ텥佯딀씮??츋??겹겘鸚됥굩?됥겒?꾬펷?섊떖佯딀씮??1?싧뎴4) ?ゃ겗?㎪쵟?ㅵ풄??빓?뺛겎?겹걟?뗰펹??\r\n * ?뗥룭獒쒎섭嶺뗣겘?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겗?㎬＝?곥겘鵝쒌굢?ゃ걚 (ADR-029?팕14)??\r\n */\r\nexport interface SlabRebarInput {\r\n  run: SlabRun\r\n  section: SlabSection\r\n}\r\n\r\nfunction barDiameter(size: BarSize): number {\r\n  const diameter = Number(size.replace(/^D/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid BarSize: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\nfunction millimetres(rule: RuleHit, diameter?: number): number {\r\n  if (rule.unit === 'mm') return rule.value\r\n  if (rule.unit === 'd' && diameter !== undefined) {\r\n    return rule.value * diameter\r\n  }\r\n\r\n  throw new Error(\r\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\r\n  )\r\n}\r\n\r\nfunction uniqueRuleHits(rules: RuleHit[]): RuleHit[] {\r\n  return [...new Set(rules)]\r\n}\r\n\r\n/**\r\n * 2竊덌폇竊됧틞??) ??뙷?녻〃?귚퐬?뷴늽?귙굥?뗣겘?ャ꺖?ャ깙?껁궚?뚧군?곥굥??겎烏뚣굮?앫겗?얇겲沃????\r\n * 歟곥겗烏ⓦ겏?뺛걚訝딃솏?ゃ걮??뙷?녴걣?ゃ걚 ??13.5m 餓δ툓??렅?뉎겓若싥굙?뚣겒?뤵?\r\n * bandedSpliceRule ??MemberUnsupportedError ?㎬맼?ⓦ걲??\r\n */\r\nfunction continuousSlabBands(pack: RulePack): SpliceBand[] {\r\n  const counts = lookupRuleSeries(pack, 'measure.splice.slab.continuous', 'band')\r\n  const upperBounds = new Map(\r\n    lookupRuleSeries(\r\n      pack,\r\n      'measure.splice.slab.continuous.band.upper',\r\n      'band',\r\n    ).map((rule) => [rule.conditions.band, rule]),\r\n  )\r\n\r\n  return counts.map((countRule) => ({\r\n    countRule,\r\n    upperBoundRule: upperBounds.get(countRule.conditions.band) ?? null,\r\n  }))\r\n}\r\n\r\nexport function generateSlabRebar(\r\n  input: SlabRebarInput,\r\n  pack: RulePack,\r\n): Rebar[] {\r\n  const { run, section } = input\r\n  const coverRule = lookupRule(pack, 'cover.minimum', coverConditions(section))\r\n  const fabricationCoverAdditionRule = lookupRule(\r\n    pack,\r\n    'cover.fabrication.addition',\r\n    {},\r\n  )\r\n  const distributionAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.distribution.addition',\r\n    {},\r\n  )\r\n  const fabricationCoverMm =\r\n    millimetres(coverRule) + millimetres(fabricationCoverAdditionRule)\r\n\r\n  // ?졾램?ⓦ걢?뜰굤횞2 ?뚧씮?싥굮擁끹걟?뗣겏訝딁ク嶺뗣겏訝뗧ク嶺뗣걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂??\r\n  // ?욍겓?ゃ굥?귡퍢?ｃ겍訝?ㄾ?ュ칱?쎼걳?곥걹??틞?욍걽?묋맼?ⓦ걲竊덅먬쐡鶯곥겗??뽧꺂?띸춮??\r\n  // 野멩퀡?с꺖?됥겏?뚣걯?긱걚竊됥?\r\n  if (section.thickness <= 2 * fabricationCoverMm) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `佯딀씮??툓塋?춮?ⓧ툔塋?춮?뚧씮?싥겓?γ굢?ゃ걚: ${run.ownerId} ` +\r\n        `(?욕럻 ${section.thickness} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCoverMm})`,\r\n    )\r\n  }\r\n\r\n  const shared = {\r\n    run,\r\n    section,\r\n    pack,\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n    distributionAdditionRule,\r\n    fabricationCoverMm,\r\n  }\r\n\r\n  // 訝뗧ク嶺뗣굮?덀겓?뷩걲?귝씮??툔?뗣굢?녴겓令띲??녶틣?뚣걹??겲?얍냵鼇녈겗訝╉겞?ャ겒?뗣?\r\n  return [\r\n    ...buildSlabBars({ ...shared, face: '訝뗧ク' }),\r\n    ...buildSlabBars({ ...shared, face: '訝딁ク' }),\r\n    ...openingReinforcementRebars(run),\r\n  ]\r\n}\r\n\r\nfunction openingReinforcementRebars(run: SlabRun): Rebar[] {\r\n  return run.openings.flatMap((opening) =>\r\n    (opening.reinforcements ?? []).flatMap((reinforcement, index) => {\r\n      // A zero length is the UI's persisted ?よ빪鼇?state. Do not expose it as\r\n      // a zero-quantity Rebar, which would make the row look transcribed.\r\n      if (reinforcement.lengthMm === 0) return []\r\n\r\n      return [{\r\n        id: `${run.ownerId}|opening-${opening.id}|reinforcement-${index}`,\r\n        memberId: run.ownerId,\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: reinforcement.size,\r\n        count: reinforcement.count,\r\n        length: reinforcement.lengthMm,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [reinforcement.lengthMm, 0, 0],\r\n        ],\r\n        closed: false,\r\n        formula:\r\n          `鼇?쮫?룔걬 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.lengthMm}mm 竊?` +\r\n          `?ф빊 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.count}??竊?孃?竊?${reinforcement.size} ` +\r\n          `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ?ゃ걡?멥걤 ???뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑?ャ굠?딂쮫歷с꺕鼇덄츞竊?,\r\n        ruleHits: [],\r\n      }]\r\n    }),\r\n  )\r\n}\r\n\r\ninterface SlabBarInput {\r\n  run: SlabRun\r\n  section: SlabSection\r\n  pack: RulePack\r\n  coverRule: RuleHit\r\n  fabricationCoverAdditionRule: RuleHit\r\n  distributionAdditionRule: RuleHit\r\n  fabricationCoverMm: number\r\n  face: '訝딁ク' | '訝뗧ク'\r\n}\r\n\r\nfunction roleOf(axis: 'X' | 'Y', face: '訝딁ク' | '訝뗧ク'): RebarRole {\r\n  if (axis === 'X') return face === '訝딁ク' ? 'X?밧릲訝딁ク嶺? : 'X?밧릲訝뗧ク嶺?\r\n  return face === '訝딁ク' ? 'Y?밧릲訝딁ク嶺? : 'Y?밧릲訝뗧ク嶺?\r\n}\r\n\r\nfunction buildSlabBars(input: SlabBarInput): Rebar[] {\r\n  const {\r\n    run,\r\n    section,\r\n    pack,\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n    distributionAdditionRule,\r\n    fabricationCoverMm,\r\n    face,\r\n  } = input\r\n\r\n  const row = (run.axis === 'X' ? section.x : section.y)[\r\n    face === '訝딁ク' ? 'top' : 'bottom'\r\n  ]\r\n  const diameter = barDiameter(row.size)\r\n  const endInput = {\r\n    barSize: row.size,\r\n    fc: section.fc,\r\n    grade: section.grade,\r\n    face,\r\n  }\r\n  const start = resolveSlabEnd(\r\n    {\r\n      ...endInput,\r\n      supportWidthMm: run.startSupport.widthMm,\r\n      supportCover: run.startSupport.cover,\r\n    },\r\n    pack,\r\n  )\r\n  const end = resolveSlabEnd(\r\n    {\r\n      ...endInput,\r\n      supportWidthMm: run.endSupport.widthMm,\r\n      supportCover: run.endSupport.cover,\r\n    },\r\n    pack,\r\n  )\r\n\r\n  // 3D ?ユ룒?뗣굦?뗩빓?뺛귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?싥곮Þ鼇덆빓?뺛겓?졼걨?γ굥??\r\n  // ?뗥룭??쵟?묆굚?볝걪?ャ겘?얇굦?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝??겎?곮〃鹽븅깿??\r\n  // `SlabRun.openings` ?㎩늾??(ADR-029)??\r\n  const drawnLengthMm = run.coreLengthMm + start.lengthMm + end.lengthMm\r\n  const lapRule = lookupRule(pack, 'lap.L1', {\r\n    fc: section.fc,\r\n    grade: section.grade,\r\n    hook: false,\r\n  })\r\n  const lapLengthMm = millimetres(lapRule, diameter)\r\n\r\n  const count = distributionCount(\r\n    run.distributionClearMm,\r\n    row.pitch,\r\n    distributionAdditionRule,\r\n  )\r\n  const layout = stirrupPositions(\r\n    run.distributionClearMm,\r\n    row.pitch,\r\n    row.startOffsetMm,\r\n  )\r\n\r\n  // 1?싧뎴8) ???뗥룭?믤Ø?뉎굥?с걽?묆걣?뗥룭??냵力뺝?力뺛걽?묊윮?뤵겒?뗣괱?밧릲??뎱嶺뗣겘\r\n  // x ?ヨ뎔?뗣겗?㏝뼀?ｃ겗 x 野멩퀡?믤쵟?띲갳?밧릲??걹??녴겎?귙굥??\r\n  const deduction = openingDeduction(\r\n    {\r\n      openings: run.openings,\r\n      clearXMm:\r\n        run.axis === 'X' ? run.coreLengthMm : run.distributionClearMm,\r\n      clearYMm:\r\n        run.axis === 'X' ? run.distributionClearMm : run.coreLengthMm,\r\n      barAxis: run.axis === 'X' ? 'x' : 'y',\r\n      pitchMm: row.pitch,\r\n      totalCount: count,\r\n    },\r\n    pack,\r\n  )\r\n  const openingLayout = deduction.layout\r\n  const ignoredTerm =\r\n    deduction.ignored.length === 0\r\n      ? ''\r\n      : ` 竊?轝좈솮?쀣겒?꾦뼀??${deduction.ignored\r\n          .map(({ widthMm, heightMm }) => `${widthMm}횞${heightMm}`)\r\n          .join('??)}竊??싧뎴8) 鵝녷쎑 ??1?뗦?壤볝걼?듿냵力뺡씊令?.5?▽빳訝뗰펹`\r\n\r\n  // ?욕럻??겑?볝겓塋뗣겇?뗣귚툔塋?춮??씮??툔?뗣굢?곦툓塋?춮??씮??툓?뗣굢?졾램?ⓦ걢?뜰굤??\r\n  const barZ =\r\n    face === '訝딁ク' ? section.thickness - fabricationCoverMm : fabricationCoverMm\r\n\r\n  const zones: RebarZone[] = [\r\n    {\r\n      kind: '若싩?',\r\n      ruleKey: start.lengthRule,\r\n      pathFromMm: 0,\r\n      pathToMm: start.lengthMm,\r\n    },\r\n    {\r\n      kind: '若싩?',\r\n      ruleKey: end.lengthRule,\r\n      pathFromMm: drawnLengthMm - end.lengthMm,\r\n      pathToMm: drawnLengthMm,\r\n    },\r\n  ]\r\n\r\n  const bent = start.kind === '?섉쎊?믣츣?' || end.kind === '?섉쎊?믣츣?'\r\n  const points = slabPoints(run.axis, run.coreLengthMm, barZ, start, end)\r\n  const faceKey = face === '訝딁ク' ? 'top' : 'bottom'\r\n\r\n  return deduction.groups.map(({ deductionMm, count: groupCount }) => {\r\n    // 1?싧뎴4) ?뚨텤?뗧츋??겹굮黎귙굙?뗣뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띲겘轝좈솮孃뚣겗?룔걬?졼?\r\n    // ?ｇ텥佯딀씮??뙷?녻〃??뚦틞?욍겗?룔걬?띲겎凉뺛걦??겎轝좈솮??쉽?욍굮?쀣걨?ゃ걚??\r\n    const measuredLengthMm = drawnLengthMm - deductionMm\r\n    const splice = resolveSplice({\r\n      run,\r\n      section,\r\n      size: row.size,\r\n      measuredLengthMm,\r\n      lapRule,\r\n      lapLengthMm,\r\n      pack,\r\n    })\r\n    const lengthMm = measuredLengthMm + splice.lengthMm\r\n    const positionsMm = openingLayout\r\n      ? openingLayout.positionsMm.filter(\r\n          (_, index) => openingLayout.deductionsMm[index] === deductionMm,\r\n        )\r\n      : null\r\n\r\n    const deductionTerm =\r\n      deductionMm === 0\r\n        ? ''\r\n        : ` ???뗥룭?ⓦ겗轝좈솮 ${deductionMm}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??兩뷴끁窈욅춬` +\r\n          `?뗥룭?ⓦ겗?끾퀡野멩퀡?ャ굠?뗰펹`\r\n    const splitTerm =\r\n      deduction.groups.length === 1\r\n        ? ''\r\n        : ` ??걝??{\r\n            deductionMm === 0 ? '?뗥룭?믤Ø?뉎굢?ゃ걚' : `${deductionMm}?믤쵟??\r\n          } ${groupCount}??\r\n\r\n    return {\r\n      id:\r\n        `${run.ownerId}|slab-${run.axis}-${faceKey}` +\r\n        `${deductionMm === 0 ? '' : `|轝좈솮${deductionMm}`}`,\r\n      memberId: run.ownerId,\r\n      role: roleOf(run.axis, face),\r\n      size: row.size,\r\n      shape: (bent ? 'hook90' : 'straight') as Rebar['shape'],\r\n      points,\r\n      closed: false,\r\n      length: lengthMm,\r\n      count: groupCount,\r\n      // X?밧릲??뎱嶺뗣겘 x ?ヤ섯?녈굥??겎 y ?멧를?녈갳?밧릲??걹??녴겎?귙굥??\r\n      placement: {\r\n        axis: (run.axis === 'X' ? 'y' : 'x') as 'x' | 'y',\r\n        clearMm: run.distributionClearMm,\r\n        pitchMm: row.pitch,\r\n        startOffsetMm: row.startOffsetMm,\r\n        lastGapMm: layout.lastGapMm,\r\n        positionCount: positionsMm\r\n          ? positionsMm.length\r\n          : layout.positionsMm.length,\r\n        ...(positionsMm ? { positionsMm } : {}),\r\n      },\r\n      splice: {\r\n        method: section.spliceMethod,\r\n        countPerBar: splice.countPerBar,\r\n        lengthMm: splice.lengthMm,\r\n        rules: splice.rules,\r\n        formula:\r\n          `泳숁뎸嶸뉑???竊?${face}嶺??с걗?잆굤 ${splice.countPerBar}?뗦?` +\r\n          `竊?{splice.basis}竊?竊??밧폀 竊?${section.spliceMethod} 竊?` +\r\n          `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm(splice, section, lapRule, lapLengthMm)} 竊?` +\r\n          `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\r\n      },\r\n      zones,\r\n      ruleHits: uniqueRuleHits([\r\n        coverRule,\r\n        fabricationCoverAdditionRule,\r\n        distributionAdditionRule,\r\n        ...start.usedRules,\r\n        ...end.usedRules,\r\n        ...deduction.rules,\r\n        ...splice.rules,\r\n      ]),\r\n      formula:\r\n        `鼇?쮫?룔걬 竊?${runCoreFormula(run)}${deductionTerm} 竊?${endFormula('冶뗧ク', start)} ` +\r\n        `竊?${endFormula('永귞ク', end)} 竊?泳숁뎸 ` +\r\n        `${spliceLengthTerm(splice, section, lapRule, lapLengthMm)} 竊?${lengthMm} 竊?` +\r\n        `?ф빊 竊??덂돯餓섉뼶?묆겗?끾퀡?룔걬 ${run.distributionClearMm} 첨 ?붵긿??` +\r\n        `${row.pitch}??竊?${distributionAdditionRule.value}` +\r\n        `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴7)竊됵폓 ${count}${splitTerm} 竊?` +\r\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊??좂츞 ` +\r\n        `${fabricationCoverAdditionRule.value} 竊?${fabricationCoverMm}?? +\r\n        `烏?.3.6?뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥랃펹 竊?` +\r\n        `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚竊덃룒?뗣굦?뗥뒥藥ι빓 ` +\r\n        `${drawnLengthMm} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹${ignoredTerm}`,\r\n    }\r\n  })\r\n}\r\n\r\nfunction runCoreFormula(run: SlabRun): string {\r\n  const clearTerms = run.bays\r\n    .map((bay) => (run.axis === 'X' ? bay.clearXMm : bay.clearYMm))\r\n    .join('竊?)\r\n  const intermediateTerms = run.bays\r\n    .slice(1)\r\n    .map(\r\n      (bay) =>\r\n        (run.axis === 'X' ? bay.supports.minX : bay.supports.minY).widthMm,\r\n    )\r\n    .join('竊?)\r\n\r\n  return intermediateTerms === ''\r\n    ? `?끾퀡?룔걬 ${clearTerms}`\r\n    : `?끾퀡?룔걬 ${clearTerms} 竊?訝?뼋鸚㎪쥈??퉭 ${intermediateTerms}` +\r\n        `竊?竊덌폇竊됧틞??) ??亮끹겗1/2 ?뚥륫?담걢?됪씎???у늽?ャ겒?뗰펹`\r\n}\r\n\r\nfunction endFormula(label: string, detail: SlabEndDetail): string {\r\n  if (detail.kind === '?당퇉若싩?') {\r\n    const term =\r\n      detail.lengthRule === 'anchorage.L1'\r\n        ? '訝?у?L1'\r\n        : detail.lengthRule === 'anchorage.L3'\r\n          ? 'L3 10d'\r\n          : 'L3 ??툔??150mm'\r\n    return `${label} ?당퇉若싩? ${term} ${detail.lengthMm}`\r\n  }\r\n\r\n  const tailMm = detail.lengthMm - detail.projectionMm\r\n  return (\r\n    `${label} ?섉쎊?믣츣? ?③빓 ${detail.lengthMm}` +\r\n    `竊?a) ?당퇉若싩? L1 ${detail.straightMinimumMm} ??` +\r\n    `(b) ?뺝쉽竊뗤퐰?룝툔??${detail.tailMinimumMm} ??ㄷ竊? +\r\n    `竊덂냵鼇?竊??뺝쉽 ${detail.projectionMm}竊?c) 烏?.3.5 Lb竊?竊??귞쎍鵝숅빓 ${tailMm}竊?\r\n  )\r\n}\r\n\r\nfunction spliceLengthTerm(\r\n  splice: SlabSplice,\r\n  section: SlabSection,\r\n  lapRule: RuleHit,\r\n  lapLengthMm: number,\r\n): string {\r\n  // 0?뗦??㏝빓?뺛걣罌쀣걟?ゃ걚??겘嶸뉑??겹겗?쎼걚?㎪뼶凉뤵겗?쎼걚?㎯겘?ゃ걚 ??鸚㎪쥈?ⓨ릪?섊릤?긱겎\r\n  // ?녶쾺?믣늽?묆굥?귙겲?ⓦ굙?뗣겏 0?뗦???뜕?у틞?욍겲?㎯뚣걹??뼶凉뤵겘?룔걬?뚦쨯?뤵굢?ゃ걚?띲겏\r\n  // 沃ф삇?쀣곩눣?멥겓?쇻걩??measure.splice.length.factor ?③짘?꾦걬?녴?\r\n  if (splice.countPerBar === 0) return '0?뗦? 竊?0'\r\n  if (splice.lengthMm > 0) {\r\n    return (\r\n      `${splice.countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 L1 ` +\r\n      `${lapRule.value}d(${lapLengthMm}) 竊?${splice.lengthMm}`\r\n    )\r\n  }\r\n  return `${splice.countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\r\n}\r\n\r\ninterface SlabSplice {\r\n  countPerBar: number\r\n  lengthMm: number\r\n  rules: RuleHit[]\r\n  basis: string\r\n}\r\n\r\ninterface SlabSpliceInput {\r\n  run: SlabRun\r\n  section: SlabSection\r\n  size: BarSize\r\n  /** 1?싧뎴4) ?뚩??녴뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띯??뗥룭?ⓦ겗轝좈솮?믣폊?꾠걼孃뚣겎?귙굥 */\r\n  measuredLengthMm: number\r\n  lapRule: RuleHit\r\n  lapLengthMm: number\r\n  pack: RulePack\r\n}\r\n\r\n/**\r\n * 2竊덌폇竊됧틞??) ???⒲꺍???쇻궎餓δ툓?ゃ굢?뚪ｇ텥?쇻굥佯딀씮?띲겎?뷴늽烏ⓦ걣 1?싧뎴4) ??\r\n * 訝딀쎑?띲걲?뗣??쇻궎??꺀?녈겘?뚦뜕?у틞?욍띲겒??겎?뚧씉?잆걽?쀦쎑?띲겎 1?싧뎴4) ?ユ댗?듽?\r\n * 孃꾠걫?ⓦ겗?룔걬??뜕鵝띲겎?겹걟?뗣귛ㄷ歟곥겗 resolveSplice ?ⓨ릪?섇숱?졼?\r\n */\r\nfunction resolveSplice(input: SlabSpliceInput): SlabSplice {\r\n  const { run, section, size, measuredLengthMm, lapRule, lapLengthMm, pack } =\r\n    input\r\n\r\n  let countRule: RuleHit\r\n  let countPerBar: number\r\n  let basis: string\r\n\r\n  if (run.members.length === 1) {\r\n    countRule = lookupRule(pack, 'measure.splice.interval', { size })\r\n    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\r\n    basis =\r\n      `?섊떖佯딀씮 ?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏` +\r\n      `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴4) ??2竊덌폇竊됧틞??) ?잆걽?쀦쎑?랃펹`\r\n  } else {\r\n    countRule = bandedSpliceRule(run.coreLengthMm, continuousSlabBands(pack))\r\n    countPerBar = spliceCount(countRule)\r\n    basis = `?ｇ텥佯딀씮 佯딀씮??빓??${run.coreLengthMm}竊덃빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞??)竊?\r\n  }\r\n\r\n  const factorRule = lookupRule(pack, 'measure.splice.length.factor', {\r\n    method: section.spliceMethod,\r\n  })\r\n  const lengthMm = spliceLengthMm(countPerBar, lapLengthMm, factorRule)\r\n  const rules = [countRule, factorRule]\r\n  if (lengthMm > 0) rules.push(lapRule)\r\n\r\n  return { countPerBar, lengthMm, rules, basis }\r\n}\r\n\r\n/**\r\n * ?졾램壤®듁?귚툓塋?춮?뚦ㄷ歟곥겗訝?겎訝뗣겦?섅굦?꿔걣?????욍겗訝?걢?됪쥈??릎?멱맼?▲굥??겎??\r\n * ?섅굦?잌뀍??z ??씮??툔塋?펷0竊됥굠?듾툔?ャ겒?뗣걪?ⓦ걣?귙굥?귙걹?뚣걣若잓슋??㎰?㎯걗?뗣?\r\n * 訝뗧ク嶺뗣겘?섅굦?ゃ걚竊덅〃5.3.5 Lb ??툓塋?춮??닓?곮〃5.3.4 L3h ??궧?⒲깣轝꾠겘?뚢??랃펹??\r\n */\r\nfunction slabPoints(\r\n  axis: 'X' | 'Y',\r\n  coreLengthMm: number,\r\n  barZ: number,\r\n  start: SlabEndDetail,\r\n  end: SlabEndDetail,\r\n): Rebar['points'] {\r\n  const at = (along: number, z: number): [number, number, number] =>\r\n    axis === 'X' ? [along, 0, z] : [0, along, z]\r\n  const points: Rebar['points'] = []\r\n\r\n  if (start.kind === '?당퇉若싩?') {\r\n    points.push(at(-start.lengthMm, barZ))\r\n  } else {\r\n    const tailMm = start.lengthMm - start.projectionMm\r\n    points.push(\r\n      at(-start.projectionMm, barZ - tailMm),\r\n      at(-start.projectionMm, barZ),\r\n    )\r\n  }\r\n\r\n  if (end.kind === '?당퇉若싩?') {\r\n    points.push(at(coreLengthMm + end.lengthMm, barZ))\r\n  } else {\r\n    const tailMm = end.lengthMm - end.projectionMm\r\n    points.push(\r\n      at(coreLengthMm + end.projectionMm, barZ),\r\n      at(coreLengthMm + end.projectionMm, barZ - tailMm),\r\n    )\r\n  }\r\n\r\n  return points\r\n}\r\nimport type { BarSize, SteelGrade } from '../model/member'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { lookupRule } from '../rules/lookup'\r\nimport type { RuleHit, RulePack } from '../rules/types'\r\n\r\n/**\r\n * 佯딀씮訝사춮?뚦ㄷ歟곥겗訝?겎?⒲걝若싩??쇻굥??(ADR-028)??\r\n *\r\n * 鸚㎪쥈??`resolveGirderEnd` ?ⓨ릪?섇숱?졼걣?곩폊?뤷닓?뚪걬?녴?\r\n *   訝뗧ク嶺???烏?.3.4 ??**L3竊덀궧?⒲깣轝꾬펹**??0d ?뗣겇150mm餓δ툓??力?)\r\n *   訝딁ク嶺???烏?.3.4 ????у?**L1**(力?)?귛뀯?됥겒?묆굦??5.3.4(5)(節? ??뒛?꿔걩若싩??㎯?\r\n *            ?뺝쉽??〃5.3.5 ??**Lb**?뚦컦歟곩룋?녈궧?⒲깣??툓塋?춮??쥈?끾뒛?꿔걩若싩???力?)\r\n *\r\n * 歟곦말嶺뗣겏?뺛걚?곫뒘壤긱겓?뚧윶?쎼걚??/4 ?띴빳訝듽띲겗訝뗩솏??럾?뗣굢?ゃ걚 ??5.3.4(5)(節?(c)\r\n * ??걹??퐜?멥겘?뚧쥈訝사춮??윶?끻츣??ャ걡?꾠겍??띲겏野얕괌?믧솏?ｃ겍?꾠굥??\r\n *\r\n * 訝뗧ク嶺뗣겓??뒛?꿔걩??껁걩?볝걣?ゃ걚?귟〃5.3.5 ??Lb ??툓塋?춮??닓?㎯걗?듽곮〃5.3.4 ??\r\n * L3h ??궧?⒲깣轝꾠걣?잍뻼?㎯뚢??띲걽?귝뵱?밤겓?γ굢?ゃ걨?뚣겙?꿔걩?밤굮獒썲뱚?뚥퐳?됥걳?썬겏?쇻?\r\n */\r\ninterface UsedRules {\r\n  usedRules: RuleHit[]\r\n}\r\n\r\nexport type SlabEndDetail =\r\n  | ({\r\n      kind: '?당퇉若싩?'\r\n      /**\r\n       * ?룔걬?믣츪?쎼겓黎뷩굙?잒죱?귚툔塋?춮??L3 ???0d ?뗣겇150mm餓δ툓?띲겒??겎??\r\n       * 榮겹걚孃꾠겎??툔?먦걣?앫겇 ??L3 ?②〃鹽뷩걲?뗣겏?방떊?뚥틟若잆겎?ゃ걦?ゃ굥??\r\n       */\r\n      lengthRule: 'anchorage.L1' | 'anchorage.L3' | 'anchorage.L3.minimum'\r\n      lengthMm: number\r\n    } & UsedRules)\r\n  | ({\r\n      kind: '?섉쎊?믣츣?'\r\n      /** max(L1, ?뺝쉽竊뗤퐰?룝툔?? ???앫겂?잓쟿?ユ졊?졼걣餓섅걦 */\r\n      lengthRule: 'anchorage.L1' | 'anchorage.bent.tail.minimum'\r\n      /** 佯딀씮??뒘壤긱겘烏?.3.5 Lb ?앫겗?귙겗?귞ザ?녵툔?먦걣?ゃ걚 */\r\n      projectionRule: 'anchorage.Lb'\r\n      lengthMm: number\r\n      /** 5.3.4(5)(節?(a)?뚦뀲?룔겘?곮〃5.3.4 ??쎍渶싧츣???빓?뺜빳訝듽겏?쇻굥?띲겗 L1 */\r\n      straightMinimumMm: number\r\n      /** ??b)?뚥퐰?룔겘??d 餓δ툓?띲굮?③빓??툔?먦겓?쏁츞?쀣걼?귙겗 */\r\n      tailMinimumMm: number\r\n      /** ??c) ?뺝쉽若싩??룔걬 竊?烏?.3.5 Lb */\r\n      projectionMm: number\r\n    } & UsedRules)\r\n\r\nexport interface SlabEndInput {\r\n  /** 若싩??덀겗鸚㎪쥈??퉭 b (mm) ??佯딀씮嶺뗣겘?볝겗訝?겦?γ겂?╉걚??*/\r\n  supportWidthMm: number\r\n  /** 若싩??덀겗鸚㎪쥈??걢?뜰굤?㏛폏?▽뻑?귛틞?욍겗?귙겗?㎯겘?ゃ걚 */\r\n  supportCover: Record<string, string | boolean>\r\n  barSize: BarSize\r\n  fc: number\r\n  grade: SteelGrade\r\n  face: '訝딁ク' | '訝뗧ク'\r\n}\r\n\r\nfunction barDiameter(size: BarSize): number {\r\n  const diameter = Number(size.replace(/^D/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid BarSize: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\nfunction millimetres(rule: RuleHit, diameter?: number): number {\r\n  if (rule.unit === 'mm') return rule.value\r\n  if (rule.unit === 'd' && diameter !== undefined) {\r\n    return rule.value * diameter\r\n  }\r\n\r\n  throw new Error(\r\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\r\n  )\r\n}\r\n\r\nexport function resolveSlabEnd(\r\n  input: SlabEndInput,\r\n  pack: RulePack,\r\n): SlabEndDetail {\r\n  const diameter = barDiameter(input.barSize)\r\n  const minimumCoverRule = lookupRule(pack, 'cover.minimum', input.supportCover)\r\n  const fabricationCoverAdditionRule = lookupRule(\r\n    pack,\r\n    'cover.fabrication.addition',\r\n    {},\r\n  )\r\n  const coverRules = [minimumCoverRule, fabricationCoverAdditionRule]\r\n  const availableMm =\r\n    input.supportWidthMm -\r\n    (millimetres(minimumCoverRule) +\r\n      millimetres(fabricationCoverAdditionRule))\r\n\r\n  if (input.face === '訝뗧ク') {\r\n    return resolveBottom(input, pack, diameter, availableMm, coverRules)\r\n  }\r\n\r\n  return resolveTop(input, pack, diameter, availableMm, coverRules)\r\n}\r\n\r\n/**\r\n * 訝뗧ク嶺???烏?.3.4 力? ??L3?귙?0d ?뗣겇150mm餓δ툓?띲겒??겎雅뚣겇??죱??ㄷ?띲걚?밤걽??\r\n * 鸚㎯걤?꾣뼶?믣룚?뗨쮫嶸쀣걣?볝걪?ャ걗?듽곥꺂?쇈꺂?묆긿??겘 10d ??150mm ?믣닪?끹겓?곥겇\r\n * (ADR-002 ???먨뒟鶯곥겗?띲겖泳숁뎸訝뗩솏?ⓨ릪?섇숱)??\r\n */\r\nfunction resolveBottom(\r\n  input: SlabEndInput,\r\n  pack: RulePack,\r\n  diameter: number,\r\n  availableMm: number,\r\n  coverRules: RuleHit[],\r\n): SlabEndDetail {\r\n  const perDiameterRule = lookupRule(pack, 'anchorage.L3', { member: '?밤꺀?? })\r\n  const floorRule = lookupRule(pack, 'anchorage.L3.minimum', {\r\n    member: '?밤꺀??,\r\n  })\r\n  const perDiameterMm = millimetres(perDiameterRule, diameter)\r\n  const floorMm = millimetres(floorRule)\r\n  const lengthMm = Math.max(perDiameterMm, floorMm)\r\n\r\n  if (lengthMm > availableMm) {\r\n    throw new MemberUnsupportedError(\r\n      '若싩?訝띷닇塋?,\r\n      `佯딀씮訝뗧ク嶺뗣겗?당퇉若싩??뚦ㄷ歟곥겓?롢겲?됥겒?? ` +\r\n        `恙낁쫨 ${lengthMm} mm > 鵝욜뵪??꺗 ${availableMm} mm`,\r\n    )\r\n  }\r\n\r\n  return {\r\n    kind: '?당퇉若싩?',\r\n    lengthRule:\r\n      perDiameterMm >= floorMm ? 'anchorage.L3' : 'anchorage.L3.minimum',\r\n    lengthMm,\r\n    usedRules: [perDiameterRule, floorRule, ...coverRules],\r\n  }\r\n}\r\n\r\n/**\r\n * 訝딁ク嶺???訝?у?L1(力?)?괢2 ??뚦돯獒귞졃鶯듽겗?듽걹?뚣겗?ゃ걚嶸뉑??띺솏若싥겎?곥걹??\r\n * ?ㅵ츣?먩뼑?믦＝?곥걣?곥걼?ゃ걚 (R7)?귞쎍渶싥걣?γ굢?ゃ걨?뚣겙 5.3.4(5)(節? ??(a)(b)(c)??\r\n */\r\nfunction resolveTop(\r\n  input: SlabEndInput,\r\n  pack: RulePack,\r\n  diameter: number,\r\n  availableMm: number,\r\n  coverRules: RuleHit[],\r\n): SlabEndDetail {\r\n  const straightRule = lookupRule(pack, 'anchorage.L1', {\r\n    fc: input.fc,\r\n    grade: input.grade,\r\n    hook: false,\r\n  })\r\n  const straightLengthMm = millimetres(straightRule, diameter)\r\n\r\n  if (straightLengthMm <= availableMm) {\r\n    return {\r\n      kind: '?당퇉若싩?',\r\n      lengthRule: 'anchorage.L1',\r\n      lengthMm: straightLengthMm,\r\n      usedRules: [straightRule, ...coverRules],\r\n    }\r\n  }\r\n\r\n  // anchorage.L1h ??폊?뗣겒????5.3.4(5)(節? ??L1h ??*?⑴뵪?▽뻑**?㎯걗?ｃ겍\r\n  // (a)(b)(c) ??겑??ㅳ굚黎뷩굙?ゃ걚 (鸚㎪쥈??resolveGirderEnd ?ⓨ릪?섊릤????\r\n  const projectionRule = lookupRule(pack, 'anchorage.Lb', {\r\n    fc: input.fc,\r\n    grade: input.grade,\r\n  })\r\n  const tailMinimumRule = lookupRule(pack, 'anchorage.bent.tail.minimum', {})\r\n  const projectionMm = millimetres(projectionRule, diameter)\r\n\r\n  if (projectionMm > availableMm) {\r\n    throw new MemberUnsupportedError(\r\n      '若싩?訝띷닇塋?,\r\n      `佯딀씮訝딁ク嶺뗣겗?섉쎊?믣츣??뚦ㄷ歟곥겓?롢겲?됥겒?? ` +\r\n        `恙낁쫨?뺝쉽 ${projectionMm} mm > 鵝욜뵪??꺗 ${availableMm} mm`,\r\n    )\r\n  }\r\n\r\n  const tailMinimumMm = projectionMm + millimetres(tailMinimumRule, diameter)\r\n  const lengthMm = Math.max(straightLengthMm, tailMinimumMm)\r\n\r\n  return {\r\n    kind: '?섉쎊?믣츣?',\r\n    lengthRule:\r\n      straightLengthMm >= tailMinimumMm\r\n        ? 'anchorage.L1'\r\n        : 'anchorage.bent.tail.minimum',\r\n    projectionRule: 'anchorage.Lb',\r\n    lengthMm,\r\n    straightMinimumMm: straightLengthMm,\r\n    tailMinimumMm,\r\n    projectionMm,\r\n    usedRules: [\r\n      straightRule,\r\n      projectionRule,\r\n      tailMinimumRule,\r\n      ...coverRules,\r\n    ],\r\n  }\r\n}\r\n/** BAR_SIZES ?ⓨ릪?섅걦?곩츪烏뚧셽?ユ쩂?곥굢?뚣굥?덀걝?띶닓?뗣굢?뗣굮壅룔걪?쇻?*/\r\nexport const MEMBER_KINDS = ['??, '鸚㎪쥈', '?먬쐡鶯?, '佯딀씮'] as const\r\n\r\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\r\n\r\nexport type MemberClass = '翁?퐪'\r\n\r\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\r\nexport const BAR_SIZES = [\r\n  'D10',\r\n  'D13',\r\n  'D16',\r\n  'D19',\r\n  'D22',\r\n  'D25',\r\n  'D29',\r\n  'D32',\r\n] as const\r\n\r\nexport type BarSize = (typeof BAR_SIZES)[number]\r\n\r\n/**\r\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\r\n *\r\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\r\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\r\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\r\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\r\n *\r\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\r\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\r\n *\r\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\r\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\r\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\r\n */\r\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\r\n\r\nexport type HighStrengthShearBarSize =\r\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\r\n\r\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\r\nexport const SHEAR_BAR_SIZES = [\r\n  ...BAR_SIZES,\r\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\r\n] as const\r\n\r\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\r\n\r\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\r\n\r\n/**\r\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯겗?ε뒟?㎯걗?ｃ겍獒썲뱚?뚧군?곥겒??(ADR-012)??\r\n *\r\n * ?곈뇧令띸츞?뷸틬 1?싧뎴4)??) ?뚦릫?뉎걲??겘?띲겖泳숁뎸?ⓦ궗?밧쑇?η텤?뗣걽?묆겒??겎??\r\n * 艅잍ː凉뤵꺕繹뜻렏??돮?꾠겘?ャ꺖?ャ깙?껁궚?담겎 `inferred` ??죱?ャ겒?????멥겧?뗣걣\r\n * ?ょ▶沃띲겏?쀣겍鈺?몜?뚥퍡??(ADR-015)??\r\n */\r\nexport const SPLICE_METHODS = [\r\n  '?띲겖泳숁뎸',\r\n  '?с궧?㎪렏',\r\n  '艅잍ː凉?,\r\n  '繹뜻렏',\r\n] as const\r\n\r\nexport type SpliceMethod = (typeof SPLICE_METHODS)[number]\r\n\r\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\r\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\r\n\r\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\r\n\r\n/**\r\n * ?긱겗??씊壤®듁??\r\n *\r\n * ?녶숱?긱겘 b?팪 ?믡겏?귙겓?닷푶?ャ걲?뗣귛ㄷ歟곥겗?끾퀡?룔걬??3D ??윶?㏂굚 b?팪 ?뗣굢\r\n * 黎뷩겲?뗣겗?㎯곩쨼?ε?力뺛겏?쀣겍?뚣걯?ㅳ굮營?걨?겼숱?뜰겗瓦썲뒥?뚩쮫歷ц쫸?뉎굮?뷩굢?뺛겒?꾠?\r\n * ?곈뇧?㎩숱?뜰굮誤뗣굥??겘 1?싧뎴2)?뚧뼪?㏂겗鼇?쮫野멩퀡?ャ굠?뗥뫅?룔띲걼?졽?嶸뉑??㎯?\r\n * ?녶숱??씊?㎯겘?앫겗?③빓?뚦냶?ⓦ겓?ゃ굥 ??獒썲뱚?뚧뼭?쀣걚?ㅳ굮鵝쒌굥?뤵걨?㎯겘?ゃ걚 (ADR-027)??\r\n *\r\n * ?밤깙?ㅳ꺀?ョ춮??돮?뤵겒?꾠귝쮽繹뽨퍞礪섉쎑 5.3.4(6)(節? ?뚣뚣궧?묆궎?⒲꺂嶺뗣겗泳숁뎸?듽겞若싩???\r\n * ??.3.5 ?ャ굠?뗣띲겏?녈겓冶붵겖?╉걡?듽곥걹??쎋??렅?뉎겎?삣깗??(烏?.3.3 ?ⓨ릪????\r\n * ??씊?ゃ궧?덀걣?똇OOP D13@100?띲겏?멥걚?╉걚?뚣겙?앫굦??깢?쇈깤?㎯걗?ｃ겍?곮＝?곥걣\r\n * ?밤깙?ㅳ꺀?ャ겏沃?겳?욍걟?뗣걪?ⓦ겘?쀣겒??(ADR-012)??\r\n */\r\nexport type ColumnShape = '?⒴숱' | '?녶숱'\r\n\r\nexport interface ColumnSection {\r\n  id: string\r\n  kind: '??\r\n  mark: string\r\n  /**\r\n   * ??씊?ゃ궧?덉뿉??痍⑥엯?????대뒓 ???됱뿉???붾뒗吏. 寧?뤇(mark)??遺숈씠硫??꾨㈃???녿뒗\r\n   * 寧?뤇???낁㉢?몄뿉 洹몃?濡??섍?怨??낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n   * ?쒗뭹??Story???鴉뤷쎋 痍⑥엯 ?붾㈃?먯꽌 ?뺥솗 ?쇱튂 ?먮룞 ?좏깮?쇰줈 ?뉖뒗??(ADR-035).\r\n   */\r\n  storyLabel?: string\r\n  /** ??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗?뗣?*/\r\n  shape: ColumnShape\r\n  b: number\r\n  d: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉???泳숁뎸嶸뉑??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 (令띸츞?뷸틬 1?싧뎴4)??)) */\r\n  spliceMethod: SpliceMethod\r\n  main: {\r\n    size: BarSize\r\n    count: number\r\n  }\r\n  hoop: {\r\n    size: ShearBarSize\r\n    pitch: number\r\n    /**\r\n     * ?띸쉰?븅뼋?????앸㈃?먯꽌 寧?쨌?永귛릭嶺뗭쓣 ?쇰쭏???꾩슦?붿?. 誤뤸틬??媛믪씠 ?녾퀬\r\n     * ?ф빊瑜?醫뚯슦?섎?濡??쒗뭹???뺥븯吏 ?딅뒗??????씊訝誤㏃쓽 ?낅젰?대떎 (ADR-012).\r\n     */\r\n    startOffsetMm: number\r\n  }\r\n}\r\n\r\n/** 鸚㎪쥈 訝사춮 1餘듸펷訝딁ク?얇걼??툔塋?펹??퐤營?닪?ф빊?귝뼪?㏂꺁?밤깉??ク?ⓦ꺕訝?ㄾ烏뚣겓野얍퓶?쇻굥??*/\r\nexport interface GirderMainRow {\r\n  /** 塋?깿竊덃뵱?밧겢竊됥겗?ф빊 */\r\n  endCount: number\r\n  /** 訝?ㄾ??쑍??*/\r\n  centerCount: number\r\n  /**\r\n   * 冶뗧ク?담겗?ф빊 ??藥?뤂?㏝걬?녴겏?띲걽?묉똻?ㅳ귞꽒?묆굦??endCount ?ⓨ릪?섓펷野양㎞竊됥?\r\n   * 冶뗧ク??꺀?녈꺆?쇈궖?ワ펷GirderRun.memberOffsetsMm ??0 ?댐펹??\r\n   */\r\n  startCount?: number\r\n}\r\n\r\n/**\r\n * 鸚㎪쥈訝사춮??퐤營?닪?ф빊?믡곲뇥?ゃ굤?믢퓷?ㅳ궛?ャ꺖?쀣겦?녻㎗?쇻굥??\r\n *\r\n * ?ф빊??눕令띺썓?덀겏?쀣겍鰲ｉ뇠?쇻굥?귡싥걮嶺뗣꺕冶뗧ク/永귞ク stub?삡릎鸚?춮?ュ뒥?덀겍??\r\n * 訝?밤겗??궧?졼걨?㎩츣??쇻굥 ?몄륫洹쇈굮瓦붵걲?귛쭓塋?겏永귞ク??륫?밤겓若싩??쇻굥 ?몄륫洹쇈겘\r\n * ?뚧셽?ユ닇塋뗣걮?ゃ걚?잆굙??oneSidedAnchor` ????밤걽?묆굮?곥겇 (ADR-032)??\r\n */\r\nexport interface GirderMainDecomposition {\r\n  throughCount: number\r\n  startStubCount: number\r\n  endStubCount: number\r\n  centerOnlyCount: number\r\n  oneSidedCount: number\r\n  oneSidedAnchor?: '冶뗧ク' | '永귞ク'\r\n}\r\n\r\nexport function decomposeGirderMainRow(\r\n  row: GirderMainRow,\r\n): GirderMainDecomposition {\r\n  const startCount = row.startCount ?? row.endCount\r\n  const throughCount = Math.min(startCount, row.centerCount, row.endCount)\r\n  const startStubCount = Math.max(0, startCount - row.centerCount)\r\n  const endStubCount = Math.max(0, row.endCount - row.centerCount)\r\n  const centerOnlyCount = Math.max(\r\n    0,\r\n    row.centerCount - Math.max(startCount, row.endCount),\r\n  )\r\n  const oneSidedStartCount = Math.max(\r\n    0,\r\n    Math.min(startCount, row.centerCount) - row.endCount,\r\n  )\r\n  const oneSidedEndCount = Math.max(\r\n    0,\r\n    Math.min(row.centerCount, row.endCount) - startCount,\r\n  )\r\n\r\n  if (oneSidedStartCount > 0) {\r\n    return {\r\n      throughCount,\r\n      startStubCount,\r\n      endStubCount,\r\n      centerOnlyCount,\r\n      oneSidedCount: oneSidedStartCount,\r\n      oneSidedAnchor: '冶뗧ク',\r\n    }\r\n  }\r\n\r\n  if (oneSidedEndCount > 0) {\r\n    return {\r\n      throughCount,\r\n      startStubCount,\r\n      endStubCount,\r\n      centerOnlyCount,\r\n      oneSidedCount: oneSidedEndCount,\r\n      oneSidedAnchor: '永귞ク',\r\n    }\r\n  }\r\n\r\n  return {\r\n    throughCount,\r\n    startStubCount,\r\n    endStubCount,\r\n    centerOnlyCount,\r\n    oneSidedCount: 0,\r\n  }\r\n}\r\n\r\nexport interface GirderSection {\r\n  id: string\r\n  kind: '鸚㎪쥈'\r\n  mark: string\r\n  /** ColumnSection.storyLabel怨?媛숇떎. */\r\n  storyLabel?: string\r\n  b: number\r\n  depth: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** ColumnSection.spliceMethod ?ⓨ릪?섅귡싥걮嶺뗣겗泳숁뎸嶸뉑??겹겓?밤걦 */\r\n  spliceMethod: SpliceMethod\r\n  main: {\r\n    size: BarSize\r\n    /** 訝딁ク嶺뗣겗鵝띸쉰?ζ쑍??????씊?ゃ궧?덀겗塋?깿?삡릎鸚?죱?뚣걹??겲?얍뀯??*/\r\n    top: GirderMainRow\r\n    /** 訝뗧ク嶺뗣겗鵝띸쉰?ζ쑍??*/\r\n    bottom: GirderMainRow\r\n    /**\r\n     * ?ャ긿?덀궕?뺟춮?믤윶?㏂걢?됪쥈??냵?담겦鵝?mm ?㎩늾?딀??곥굥?뗣?\r\n     *\r\n     * ?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1) ?뚣뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑\r\n     * ?ャ굠?뗣띲겏冶붵겖?뗣겗?㎬쫸繹뽩겢?ュㅳ걣?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012)??\r\n     * 塋?깿?ⓧ릎鸚?걣?뚧빊竊덀궖?껁깉?ゃ깢嶺뗣걣?ゃ걚竊됪뼪?㏂겎??슴?뤵굦?ゃ걚??\r\n     */\r\n    cutoffFromSupportFaceMm: number\r\n  }\r\n  stirrup: {\r\n    size: ShearBarSize\r\n    pitch: number\r\n    /** 訝←ク??윶?㏂걢?됬К1?삥?永귙걗?겹굢嶺뗣굮?⒲굦?졼걨?㏂걲?뗣귟쫸繹뽧겓?ㅳ겘?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012) */\r\n    startOffsetMm: number\r\n  }\r\n  /**\r\n   * 亮끾??곭춮?귝뼪?㏘?誤㎯겓鼇섋펹??겒?꾣쥈?ャ겘?▲걚?띸춮?ゃ겗?㏛뻣?뤻쟿??겏?쀣?\r\n   * `undefined` ??뚪뀓嶺뗣겒?쀣띲굮?뤷뫑?쇻굥 ??獒썲뱚?뚦떇?뗣겓擁녈걬?ゃ걚 (ADR-012)??\r\n   * 鼇?쮫?룔걬??빊?뤹찉嶸쀥읃繹?1?싧뎴3) ?뚧뼪?㏂겗鼇?쮫亮끹겏若싥굙?뗣겗?㎩뀯?쎼겘孃꾠겏?붵긿?곥걽?묆?\r\n   */\r\n  widthTie?: {\r\n    size: BarSize\r\n    pitch: number\r\n  }\r\n  /**\r\n   * ?밭춮??undefined` ??뚪뀓嶺뗣겒?쀣띲귝쑍?겹겘?녜씊?뚣?-D10?띲겏鼇섋펹?쇻굥?겹걹??굚??\r\n   * ?ゃ겗??1?싧뎴7) ??돯餓섅겎??겒?꾠?\r\n   */\r\n  sideBar?: {\r\n    size: BarSize\r\n    count: number\r\n    /**\r\n     * 歟곥겗訝←ク?㎩냵力뺛굮擁듽걟?╊섯?녈굥鵝숅빓 (mm)?귝빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈3) ??\r\n     * ?볝굦??1?싧뎴6) ?ュ쭟??곩릪?끹겘鼇?쮫?녔쎑?ヨ쮼雍됥걣?ゃ걨?뚣겙 JASS 5 繹뽫뵪??\r\n     * ?쇻굥?괟ASS 5 ??쐣?숃쫸?쇈겎?ょ▶岳앫곫쮽繹뽨퍞礪섉쎑5塋졼겓??끃嶺뗣겗鼇섋염?뚥???\r\n     * ?ゃ걚?잆굙誤뤸틬?ㅳ굮?뽧굦?ゃ걚 ??鼇?쮫?녔쎑??ㅳ굮?ε뒟?ⓦ걮??룛?묈룚??(R9????\r\n     */\r\n    extraLengthMm: number\r\n  }\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯????⒲꺖?▲꺍礪뗩졼겗鶯곥겎?귙굥?귛즯凉뤸쭓?졼겗鶯곥겎??겒?꾠?\r\n *\r\n * ?곈뇧令띸츞?뷸틬 2竊덌폊竊됧즯 ??1)?뚦즯凉뤸쭓?졽빳鸚뽧띲겏 2)?뚦즯凉뤸쭓?졼띲굮?ζ씉?뉎겎?긱걚??\r\n * 孃뚩끹겘塋?깿嶺뗣꺕潁?춮?삣즯歟곭춮?삥Ø嶺뗣꺕獒쒎섭嶺뗣겗5?뷴늽?ュ늽?뗣굦??씉?뉎겗?뤵걣?얇굥?㏝걬?녴?\r\n * ?볝걪?뚦츪獒끹걲?뗣겗??1) ?졼걨?㎯곩즯凉뤸쭓?졼겘?긱굩?ゃ걚??\r\n *\r\n * 亮끾?嶺뗣굮?곥걼?ゃ걚??겘?뤷쎋?꾠걽???싧뎴3) ??빓?뺧펷竊앭즯?싷펹?믣즯?ャ굚訝롢걟?뗣걣??\r\n * ?ф빊?믣츣?곥굥?→뻼??2竊덌폆竊됪쥈3) ?㎪쥈?쀣걢?띷뙁?쀣겍?듽굢?싥?竊덌폊竊됧즯 ?ュ퉭閭®춮??\r\n * 鼇섋염????뉎겒?꾠귝쑍?겹굮獒썲뱚?뚥퐳?됥겒?꾠겏鼇덁툓?㎯걤?ゃ걚 ??鵝쒌굢?ゃ걚 (ADR-022 ??끃嶺뗣겏?뚣걯?ㅶ뼪)??\r\n */\r\nexport interface WallSection {\r\n  id: string\r\n  kind: '?먬쐡鶯?\r\n  mark: string\r\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\r\n  storyLabel?: string\r\n  /**\r\n   * 鼇?쮫?녔쎑?㎩닩??걮?잌즯??뙷?녴귡썞鶯곥겘?γ겗 MemberKind ?㎯겘?ゃ걦?곩즯??\r\n   * ?뗣겤?듽겏?띲겖泳숁뎸訝뗩솏?졼걨?믣늽?묆굥?귞쐛?γ겘?℡춼旅덁뻑?ⓦ겗雅믤룢??걼??\r\n   * ?먨뒟鶯곥겏?쀣겍?긱걝 (ADR-036)??\r\n   */\r\n  wallClass?: '?먨뒟鶯? | '?먨뒟鶯곦빳鸚?\r\n  /** 鶯곩럻 (mm) */\r\n  thickness: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** 潁?춮?삥Ø嶺뗣겗泳숁뎸?밧폀?귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\r\n  spliceMethod: SpliceMethod\r\n  /**\r\n   * ?띸춮??광?????룔꺍?겹꺂(1) ????뽧꺂(2) ?뗣귝쑍?겹걣?앫겗?얇겲?띺걬?녴걣??\r\n   * ?볝굦?믤군?곥굥?→뻼??쫸繹뽧겓?ゃ걚?귛즯?ゃ궧?덀겗?똃13@200 ??뽧꺂?띲겏?꾠걝鼇섋펹\r\n   * ?앫겗?귙겗?㎯걗?듽곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)??\r\n   */\r\n  layers: 1 | 2\r\n  /** 潁?춮 ??訝듾툔??쥈?삣틞?욍겦若싩??쇻굥 */\r\n  vertical: {\r\n    size: BarSize\r\n    pitch: number\r\n    /**\r\n     * ?끾퀡塋?걢?됬К1?삥?永귙겗潁?춮?믡겑?뚣걽?묌썴?쇻걢?귝윶??hoop?삣ㄷ歟곥겗 stirrup ??\r\n     * ?뚣걯?녺뵳?㎬쫸繹뽧겓?ㅳ걣?ゃ걦?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)???싧뎴7) ??\r\n     * ?앮쐿?ゃ깢?삠긿?덀굮誤뗣겒?꾠겗?㎪빊?뤵겓??듅?뗣겒????3D 壤®듁?졼걨??ㅳ겎?귙굥??\r\n     */\r\n    startOffsetMm: number\r\n  }\r\n  /** 與ょ춮 ??訝▼겢??윶?멨츣??쇻굥 */\r\n  horizontal: {\r\n    size: BarSize\r\n    pitch: number\r\n    /** 潁?춮??startOffsetMm ?ⓨ릪?섅귙걪?▲굢??냵力뺡쳵?뺛겗訝뗧ク?뗣굢??퇌?㏂겎?귙굥??*/\r\n    startOffsetMm: number\r\n  }\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됥겗1?밧릲???㏂겗訝사춮??\r\n *\r\n * 孃꾠굚?붵긿?곥굚??씊?ゃ궧?덀겗?ε뒟?㎯걗?뗣귝빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞??) ?뚣뚣깉?껁깤嶺뗣?\r\n * ?뤵꺍?곲깿?녴겗訝사춮?곮짒凉루춮嶺됥겘鼇?쮫?녔쎑?ャ굠?뗣띲겏冶붵겖?곮쫸繹뽩겢?ユ쑍?겹굮若싥굙??\r\n * ?→뻼?뚣겒??(ADR-012)?귙걪?볝걣誤뤸틬?뗣굢凉뺛걦??겘若싩??룔걬?졼걨?졼?\r\n */\r\nexport interface SlabBarRow {\r\n  size: BarSize\r\n  pitch: number\r\n  /**\r\n   * ?끾퀡塋?걢?됬К1?삥?永귙겗?꾤춮?믡겑?뚣걽?묌썴?쇻걢?귝윶??릭嶺뗣꺕鸚㎪쥈??걗?겹굢嶺뗣겏\r\n   * ?뚣걯?녺뵳?㎬쫸繹뽧겓?ㅳ걣?ゃ걦?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)???싧뎴7) ??\r\n   * ?앮쐿?ゃ깢?삠긿?덀굮誤뗣겒?꾠겗?㎪빊?뤵겓??듅?뗣겒????3D 壤®듁?졼걨??ㅳ겎?귙굥??\r\n   */\r\n  startOffsetMm: number\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됤??곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞???㎪릍?뗣?\r\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓\r\n * ?γ걲?뗦객亮녔쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲빓?뺛겘?싥굤??뼋?㎯겘?ゃ걦訝▼겢??ㄷ歟곥겗\r\n * ?끻겢?㏂겗?볝겎?귙굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠??(ADR-028)??\r\n *\r\n * `exposure` ?믤똻?잆겒?꾠겗??〃5.3.6 ??쭓?졼걹??굚??걽?귛릪烏ⓦ겗?뚣궧?⒲깣?곮먨뒟鶯?\r\n * 餓ε쨼??즯?띹죱??퍞訝듽걩??쐣?▲걽?묆겎?녴걢?뚣곩콏?끹꺕掠뗥쨼??뙷?γ굮**?곥걼?ゃ걚** ??\r\n * ?뚧윶?곫쥈?곮먨뒟鶯곥띹죱?③걬?녴귛뀯?쎼겓營?걦?①뵽?㏂겓?밤걢?ゃ걚?ㅳ겲?욍걣訝╉겤??\r\n *\r\n * 亮끾?嶺뗣굮?곥걼?ゃ걚??겘?먬쐡鶯곥겏?뚣걯?녺뵳?㎯걗?뗣??싧뎴3) ?뚪빓?뺛굮訝롢걟?뗩깿?먦겗\r\n * ?쀦뙔??뚦읃鹽롦쥈?곫쥈?곩즯歟곥곩즯?띲겎佯딀씮?뚣겒?뤵곫쑍?겹굮若싥굙?뗦씉?뉎굚?ゃ걚??\r\n */\r\nexport interface SlabSection {\r\n  id: string\r\n  kind: '佯딀씮'\r\n  mark: string\r\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\r\n  storyLabel?: string\r\n  /** ?욕럻 (mm) */\r\n  thickness: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉뤵귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\r\n  spliceMethod: SpliceMethod\r\n  /** X?싥굤?밧릲竊늌邕멥겓亦욍겂?╊섯?녈굥竊됥겗訝사춮 */\r\n  x: { top: SlabBarRow; bottom: SlabBarRow }\r\n  /** Y?싥굤?밧릲??말嶺?*/\r\n  y: { top: SlabBarRow; bottom: SlabBarRow }\r\n}\r\n\r\nexport type Section =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\n/**\r\n * ?붾㈃ ?쒖떆쨌aria-label???대쫫. 媛숈? 寧?뤇???롫퀎濡??щ윭 ??씊???????덉쑝誘濡?\r\n * ?롫? ?ш린??遺숈씤??????λ릺??`mark`???꾨㈃??寧?뤇 洹몃?濡??붾떎.\r\n */\r\nexport function sectionMarkLabel(section: Section): string {\r\n  return section.storyLabel\r\n    ? `${section.mark}(${section.storyLabel})`\r\n    : section.mark\r\n}\r\n\r\nexport interface ColumnPosition {\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\nexport interface GirderPosition {\r\n  axis: 'X' | 'Y'\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗鵝띸쉰?귛ㄷ歟곥겏?뚣걯?뤻싥굤??겗1?밤깙?녑늽??씌?믣뜝?곥굥??겎壤㏂굚?뚣걯?㎯걗?뗣?\r\n *\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?곩닪?띲굮鵝쒌겂?╉굚?뗣겏?쀣겍??GirderPosition ??\r\n * ?뷴닪?뺛굦?ゃ걚 ???⒲걾?됥겎?귙굥?뗣굮黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼귚퐤營?걽?묆굮\r\n * 誤뗣겍?ⓩ쓲葉?닪?믣닩若싥걲?뗣궠?쇈깋?믤쎑?뗣겒?꾠걪?ⓦ?\r\n */\r\nexport type WallPosition = GirderPosition\r\n\r\n/**\r\n * 佯딀씮??퐤營????싥굤??겎?꿔겲?뚣걼1?쇻궎?믣뜝?곥굥??ix, iy) ??걹??깧?ㅳ겗?잏궧??\r\n * 竊늌?팢 ?ⓦ굚弱뤵걬?꾢겢竊됥겗?쇔춴?밤겎?곥깧?ㅳ겘 (ix, iy)??ix+1, iy+1) ?㎯걗?뗣?\r\n *\r\n * ?긱겗 ColumnPosition ?ⓨ숱??릪?섅걽?뚧뙁?쇻굚??걣?뺛걝竊덃졏耶먪궧?뗣깧?ㅳ걢竊됥?\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?뗣겎??뙷?γ걬?뚣겒?????⒲걾?됥겎?귙굥?뗣굮\r\n * 黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼?\r\n */\r\nexport type SlabPosition = ColumnPosition\r\n\r\n/**\r\n * ?묈즯竊덅뀺鶯곥꺕訝뗣굤鶯곥꺕熬뽩즯竊됥겗?끾퀡影꾢쎊?귟Þ鼇덂쎋?멥걢?됥겗?ⓩ쓲?섆퐤??빪鼇섅겎?귙굤??\r\n * ?곭븼?쀣걼邕멥겘?ⓨ냵力뺛굮?뤷뫑?쇻굥?귞칱?꿔굮??씊?ョ쉰?뗣겒?꾠겗??곩릪?섊Е?룔겎?귡깿?먦걫??\r\n * ?ラ쳵?뺛꺕?룔걬?뚪걬?꾢풓?뗣걼?곥겎?귙굥 (ADR-037)??\r\n */\r\nexport interface WallExtent {\r\n  vertical?: {\r\n    anchor: '訝뗧ク' | '訝딁ク'\r\n    heightMm: number\r\n  }\r\n  horizontal?: {\r\n    anchor: '冶뗧ク' | '永귞ク'\r\n    lengthMm: number\r\n  }\r\n}\r\n\r\n/**\r\n * ?뗥룭??1?뗦? (?곈뇧令띸츞?뷸틬 1?싧뎴8))??\r\n *\r\n * ??씊?㎯겘?ゃ걦 **?ⓩ쓲** ?ヤ퍡?뤵귛릪?섊Е?룔겗鶯곥걣鵝뺞옔?귛뻠?ㅳ겗?ャ곭첆??걹???싥겓\r\n * ?뗣걚?╉걚?뗣걢?됥걽 ????씊?ユ똻?잆걵?뗣겏?녜씊?ャ겒?꾦뼀?ｃ굮獒썲뱚?뚥퍟??즯?ャ굚鵝쒌굥\r\n * ?볝겏?ャ겒??(ADR-004)??\r\n *\r\n * 佯㎪쮽??깿?먦겗掠?楹삠겎?곩렅?밤겘**?끾퀡?잆겗?잏궧**?㎯걗?뗣귟먬쐡鶯곥겒?됧쭓塋?겗?긱겗\r\n * ?끻겢?㏂꺕訝딃깿鸚㎪쥈??툔?㏂걢?됪릍?ｃ걼訝뗧ク?곩틞?욍겒?됥꺀?녈겗冶뗧ク??ㄷ歟곩냵?닻씊??\r\n * 掠? x?퍈 ??릲?띲겘?띸춮竊?Rebar.points`竊됥겏?뚣걯?ゃ겗?㎯곩즯?㎯겘 x ?뚦즯??빓?뺛?\r\n * y ?뚦즯??쳵?뺛곩틞?욍겎??x?퍈 ?뚣걹?뚣걻??X?싥굤?팢?싥굤?밧릲?ャ겒?뗣?\r\n *\r\n * 野멩퀡??뚦뻠?룬줊嶺됮뼀?ｉ깿??*?끾퀡野멩퀡**?띯??뚪쟿?뚣걹?녶츣?곥굥??\r\n */\r\nexport interface OpeningReinforcement {\r\n  size: BarSize\r\n  count: number\r\n  lengthMm: number\r\n}\r\n\r\nexport interface Opening {\r\n  id: string\r\n  /** ?끾퀡?잆겗?잏궧?뗣굢?뗥룭?얇겎???? x (mm) */\r\n  xMm: number\r\n  /** ?뚣걯?뤷?? y (mm) */\r\n  yMm: number\r\n  /** 掠? x ?밧릲??냵力뺝?力?(mm) */\r\n  widthMm: number\r\n  /** 掠? y ?밧릲??냵力뺝?力?(mm) */\r\n  heightMm: number\r\n  /** 1?싧뎴8) ?ゃ걡?멥걤?ュ읃?γ걦鼇?쮫?녔쎑邕?쮼??뼀?ｈ짒凉루춮 */\r\n  reinforcements?: OpeningReinforcement[]\r\n}\r\n\r\nexport interface Member {\r\n  id: string\r\n  kind: MemberKind\r\n  mem