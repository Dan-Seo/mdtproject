04:      clearAlong(bay) +\r\n1105:      (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\r\n1106:  }\r\n1107:  const coreLengthMm =\r\n1108:    memberOffsetsMm[memberOffsetsMm.length - 1] +\r\n1109:    clearAlong(bays[bays.length - 1])\r\n1110:\r\n1111:  const first = bays[0]\r\n1112:  const last = bays[bays.length - 1]\r\n1113:\r\n1114:  // ?쇻궎掠???뼀?ｃ굮?⒲꺍佯㎪쮽?며㎉?쇻귟뎔?뗥릲?띲겓?졼걨?쇻궎??궕?뺛궩?껁깉?뚥퉿????\r\n1115:  // ?답벡?밧릲??냵力뺛겘?⒲꺍?끹겎?깁싥겒??겎竊덁툓?㎯걹?뚣굮濾쒏읅?쀣겍?꾠굥竊됥걹??겲?얇걽??\r\n1116:  const openings = members.flatMap((candidate, index) =>\r\n1117:    (candidate.openings ?? []).map((opening) => ({\r\n1118:      ...opening,\r\n1119:      xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\r\n1120:      yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\r\n1121:    })),\r\n1122:  )\r\n1123:\r\n1124:  return {\r\n1125:    axis,\r\n1126:    members,\r\n1127:    ownerId: members[0].id,\r\n1128:    bays,\r\n1129:    memberOffsetsMm,\r\n1130:    coreLengthMm,\r\n1131:    distributionClearMm,\r\n1132:    startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\r\n1133:    endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\r\n1134:    openings,\r\n1135:  }\r\n1136:}\r\n1137:\r\n1138:export interface GirderRun {\r\n--- phase 27 base diff / tests ---\r\ncommit 682355e7543a16f3e976b34a9dc2f8ab2a773812\nAuthor: Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\nDate:   Wed Aug 26 23:18:08 2026 +0900\n\n    spec(27-cantilever-slab): 片持床板을 만든다 — ADR-028의 0건 전제를 고친다\n    \n    ADR-039. 원문을 다시 세어 보니 「두 원문 0건」인 것은 配力筋뿐이고 「片持」는\n    積算基準 6건·標準仕様書 8건이다. 定義（４）·2（４）床板2) 但書·表5.3.4 L3의\n    「（片持スラブの場合は25d）」·表5.3.5 注1·2(La 포함·Lb 제외)가 근거다.\n    支持辺 하나만 접속하므로 나머지 세 변은 자유단이고 定着이 없다.\n    \n    Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>\n\ndiff --git a/docs/ADR.md b/docs/ADR.md\nindex 70241ac..0027e91 100644\n--- a/docs/ADR.md\n+++ b/docs/ADR.md\n@@ -553,3 +553,23 @@ python -c \"import fitz,sys; d=fitz.open(sys.argv[1]); [print(t, [i+1 for i,p in\n 4. **부재 id는 伏図 취입과 같은 규약을 쓴다** — `${storyId}-${mark}-${ix}-${iy}[-${axis}]`. 같은 id가 이미 있으면 놓지 않는다(같은 자리에 같은 符号을 두 번 놓는 것이 그 경우다). 서로 다른 符号이 같은 辺에 서는 것은 막지 않는다 — 겹침 검사는 만들지 않는다(ADR-037 §7).\n 5. **지우면 그 부재의 開口·범위도 함께 사라진다** — 둘 다 부재에 붙어 있다. 되돌리기는 만들지 않는다(제품에 undo가 없고, 이 결정으로 만들지 않는다).\n 6. **하지 않는 것**: 柱·大梁 배치·삭제, 격자(通り芯) 편집(이미 `SpanEditor`가 있다), 겹침·중복 배치 검사, 되돌리기, 3D 뷰에서의 배치.\n+\n+### ADR-039: 片持床板을 만든다 — ADR-028의 「두 원문 0건」 전제는 틀렸다\n+\n+**맥락**: ADR-028은 `片持床板`과 `配力筋`을 「두 원문 0건」으로 묶어 둘 다 만들지 않았고, 그 서술이 `CLAUDE.md`·`docs/MILESTONES.md`에 그대로 실려 있다. 원문을 다시 세어 보니 **0건인 것은 `配力筋`뿐이다** — 「片持」는 `数量積算基準`에 6건(PDF p15·16·21·22×2·25), `標準仕様書`에 8건(p33·36×2·37×4·60) 있고 그중 넷은 片持床板에 직접 걸린다. 근거를 갖고 있으면서 만들지 않은 것이므로 전제를 고치고 만든다.\n+\n+**근거 조문(전사 확인)**:\n+- `数量積算基準` 第4編第1章第2節（４）床板 — 「片持床板等もこれらに準ずる。」 즉 片持도 「柱、梁等に接する水平材の内法部分」이다.\n+- 같은 기준 2（４）床板2) 但書 — 「単独床板及び片持床板の主筋の継手は、1通則4)による。」 連続床板의 区分表가 아니라 길이 기반이다.\n+- `標準仕様書` 表5.3.4 L3 スラブ欄 — 「10d かつ150mm以上（**片持スラブの場合は25d**）」. 下端筋 直線定着이 갈린다.\n+- 같은 표 5.3.5 注1·2 — La는 「基礎梁、片持梁及び**片持スラブを含む**」, Lb는 「片持小梁及び**片持スラブを除く**」. 上端筋 折曲げ定着의 投影 열이 Lb가 아니라 **La**다.\n+- 같은 표 5.3.1 注1 — 「**片持ちスラブ先端**、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」 원문이 片持의 先端과 壁의 自由端을 같은 자리에서 다룬다 — ADR-037이 벽에 세운 자유단 판단을 원문이 지지한다.\n+\n+**결정**:\n+1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로이고 片持床板은 `kind: '床板'`이다. 갈리는 것은 **지지 조건**이지 부재가 아니다(ADR-036이 雑壁을 区分으로 담은 것과 같은 형태).\n+2. **위치는 지지하는 辺이고, 내미는 치수는 設計図書 전사다** — 片持床板의 `position`은 ベイ가 아니라 支持辺(`GirderPosition` 형태)이고, `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`가 내미는 쪽과 치수를 받는다(`正` ＝ 支持辺의 축에 직교하는 通り芯 index가 커지는 쪽). 조문은 内法 준용만 말하고 내미는 치수를 정하지 않으므로 전사 입력이다 — ADR-037과 같은 이유·같은 형태. `kind: '床板'`이면서 `axis`를 가진 position이 곧 片持이다. 스키마 버전은 올리지 않는다(optional 추가, 기존 案件 数量 불변).\n+3. **잰다** — 長さ 방향(내미는 방향)은 `projectionMm`, 폭 방향은 支持辺의 内法長さ(柱면~柱면)다. 부분 폭은 만들지 않는다 — 조문에 근거가 없고 필요해지면 그때 넓힌다.\n+4. **자유단에는 定着이 없다** — 네 변 중 접속하는 것은 支持辺 하나뿐이다. 내미는 방향의 철근은 支持辺 쪽에만 定着하고 先端은 1通則1)「先端で止まる鉄筋はコンクリートの設計寸法」으로 加算이 없다(`measure.tip.length.addition`, ADR-025의 柱 최상단과 같은 행). 支持辺과 나란한 방향의 철근은 **양 끝이 다 자유단이라 定着이 0회**다 — 2（４）床板1)의 「接続する梁、壁等」이 없기 때문이고, ADR-037 §3과 같은 읽기다(R2).\n+5. **定着 값이 갈리는 두 곳** — 下端筋의 L3은 `片持スラブ` 조건으로 25d(＋같은 칸의 150mm 하한을 그대로 딸린다), 上端筋 折曲げ의 投影은 `Lb`가 아니라 `La`다. 5.3.4(5)(ｲ)(c)의 「柱せいの3/4以上」은 **끌어오지 않는다** — 그 하한이 재는 것은 柱せい인데 片持床板은 柱에 정착하지 않는다(제품의 읽기, R2). 룰팩 신규는 L3의 片持 행뿐이고 La는 기존 행을 그대로 조회한다.\n+6. **継手는 1通則4)다** — 2（４）床板2) 但書가 片持를 連続床板 区分表에서 빼므로, 13.5m 상한의 `継手箇所数不明`(ADR-028)에 걸리지 않는다.\n+7. **하지 않는 것**: 断面リスト 파서의 片持スラブリスト 대응(전사 픽스처가 「値は転写省略」이라 골든이 설 자리가 없다 — 재전사가 선결이다), 先端筋·開口補強筋 이외의 補強筋(2（４）床板1)이 設計図書에 위임), 부분 폭 片持, 片持梁·片持小梁(小梁은 ADR-005로 만들지 않는다), 表5.3.1 注1의 4d 余長(加工 형상이고 数量은 1通則1)로 정해진다 — R12와 같은 자리에 둔다).\ndiff --git a/phases/27-cantilever-slab/step1.md b/phases/27-cantilever-slab/step1.md\nnew file mode 100644\nindex 0000000..57ae63d\n--- /dev/null\n+++ b/phases/27-cantilever-slab/step1.md\n@@ -0,0 +1,65 @@\n+# Step 1: 片持床板 — 모델·룰팩·산정, 골든 먼저\n+\n+**전제**: step 0이 `completed`(전제 유지)로 끝났을 때만 진행하라. `refuted`면\n+`blocked`로 멈추고 반증 요지를 적어라 — 저자의 ADR 정정을 기다린다.\n+\n+## 배경\n+\n+`docs/ADR.md`의 ADR-005·028·029·037·**039**를 읽어라. 片持床板은 부재가 아니라\n+**지지 조건이 하나뿐인 床板**이다. 갈리는 것은 넷 — 위치·치수(支持辺＋\n+projection), 자유단의 定着(없음), L3의 25d, 投影의 La.\n+\n+## 할 일 (골든 먼저 — TDD)\n+\n+1. **골든** — `tests/golden/fixtures/quantity-r5-ch3.json`에 片持床板 케이스를\n+   더하라(최소 2건).\n+   - **내미는 방향의 主筋**: 設計長さ ＝ projection ＋ 支持辺 쪽 定着 **1회**,\n+     先端은 1通則1)로 加算 0. 上端筋은 折曲げ면 投影 **La**, 下端筋은 L3\n+     **25d**(＋150mm 하한, step 0 §3의 판단대로). 割付은 支持辺의 内法長さ.\n+   - **支持辺과 나란한 방향**: 定着 **0회**, 割付은 projection.\n+   - 継手는 1通則4)(길이 기반)이고 連続床板 区分表에 걸리지 않는 것을 핀하라.\n+   `handDerivation`에 손 유도(定着 회수·割付 本数·設計長さ·질량)와 출처\n+   조항을 적어라. **기존 케이스의 기대값 수정 금지** — 바꿔야 통과하면 `blocked`.\n+2. **모델** — `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`\n+   (ADR-039 §2, 주석에 「支持辺의 축에 직교하는 通り芯 index가 커지는 쪽이 正」).\n+   `kind: '床板'`이면서 position이 `GirderPosition` 형태면 片持다.\n+   `project.ts` 검증: optional·두 값·양수 유한, 床板 이외가 들면 거부,\n+   `cantilever`가 있는데 position이 ベイ이거나 그 반대면 거부. 왕복·기존\n+   레코드 호환을 테스트로 고정하라. **schemaVersion을 올리지 마라.**\n+3. **룰팩** — 表5.3.4 L3 スラブ欄의 「（片持スラブの場合は25d）」를\n+   `src/rulepack/jp-mlit/anchorage.yaml`에 `片持スラブ` 조건으로 실어라.\n+   150mm 하한의 재사용 여부는 step 0 §3의 판단을 따르고, 재사용이 안 되면\n+   같은 조건의 행을 하나 더 만들어라. `source`는 기존 L3 행과 같은 자리\n+   (表5.3.4, printedPage 동일), `confidence: transcribed`, `note`도 기존\n+   형식을 따르라. `spec-r7-ch5.json`의 해당 항목에서 「片持スラブを作らないので\n+   取らない」 취지의 `reason`을 지우고 **entries로 옮겨라** — spec-tables\n+   테스트가 룰팩과의 동시 수정을 강제한다. `La`·`measure.tip.length.addition`은\n+   **신규 행 없이 기존 행을 조회**하라. 다른 룰팩 행 신규·수정 금지.\n+4. **기하** — 片持床板의 内法(폭 ＝ 支持辺 内法長さ, 길이 ＝ projection)을 내는\n+   경로를 만들어라. step 0의 `twoSupportSites` 목록이 무대다. 양쪽 지지를\n+   전제한 코드가 한쪽 지지에서 조용히 잘못된 값을 내지 않게 하라 —\n+   불가능한 형상은 `MemberUnsupportedError('寸法不成立')`다(plain Error 금지,\n+   ADR-038 §3). 支持辺에 大梁·양 끝 柱가 없으면 그렇게 떨어진다.\n+5. **산정** — 자유단 定着 0회(ADR-039 §4), L3 25d, 投影 La, 継手 1通則4).\n+   算出式에 자유단과 근거 조항을 적어라. 連続床板 런에 片持가 섞여 들어가지\n+   않게 하라 — 片持는 언제나 단독이다.\n+6. **다른 부재의 골든이 변하면 반칙이다** — `blocked`로 멈춰라.\n+\n+## 하지 말 것\n+\n+- `src/components/**`·`src/lib/viewer/**`·`src/lib/import/**` 수정 금지.\n+- `MemberKind` 추가 금지. 부분 폭 片持·片持梁·小梁 금지 (ADR-039 §7).\n+- 5.3.4(5)(ｲ)(c)의 「柱せいの3/4」를 끌어오지 마라 (ADR-039 §5).\n+- 배근 규준 수치를 코드에 쓰지 마라.\n+- **`phases/**/step*-codex.*.log`·`step*-invoke.json`을 지우지 마라.**\n+- **검증 스크립트를 `src/` 아래에 만들지 마라** — phase 디렉터리 안에 둬라.\n+- `scripts/execute.py` 금지 — 재귀다.\n+\n+## AC\n+\n+- `npm run test`·`npx tsc --noEmit`·`npm run lint` 전체 통과.\n+\n+## 산출물\n+\n+`phases/27-cantilever-slab/step1-report.json`:\n+골든 케이스의 handDerivation 요지, 룰팩 신규 행, 변경 파일, 게이트 결과.\ndiff --git a/phases/27-cantilever-slab/step2.md b/phases/27-cantilever-slab/step2.md\nnew file mode 100644\nindex 0000000..ee6f726\n--- /dev/null\n+++ b/phases/27-cantilever-slab/step2.md\n@@ -0,0 +1,36 @@\n+# Step 2: 3D·平面 표시와 배치 입력\n+\n+**전제**: step 1이 `completed`. 진행 중 새 반증 사유가 나오면 `blocked`.\n+\n+## 할 일\n+\n+1. **3D** — 片持床板의 콘크리트 판과 배근을 支持辺에서 `side` 쪽으로\n+   `projectionMm`만큼 내밀어 그려라(建物 뷰·部材 뷰). 격자 **밖**으로 나가는\n+   부재라 뷰의 경계 계산이 그것을 포함해야 한다 — 잘리면 고쳐라.\n+2. **平面** — `PlanEditor`가 片持床板을 격자 밖에 그리고 선택할 수 있게 하라.\n+   `drawingTransform`의 범위에 내민 부분이 들어가야 한다.\n+3. **배치 입력** — phase 26(ADR-038)의 배치 UI에 片持床板을 더하라: 支持辺을\n+   고르고 `side`와 `projectionMm`를 받는다. 지지 조건(大梁·양 끝 柱)이 없는\n+   辺은 후보로 내지 마라 — 판정은 step 1의 기하 경로와 같은 근거여야 한다.\n+   삭제는 기존 床板 삭제 경로를 그대로 쓴다.\n+4. **테스트** — 뷰어 기하 단위 테스트와 `PlanEditor.test.tsx`에 최소 고정:\n+   내민 판이 격자 밖에 서고, 후보 판정이 지지 조건을 따르며, 배치·삭제가\n+   `Member`를 규약대로 만든다·지운다.\n+5. **e2e** — 신규 금지. 기존 `uc20-slab.js`가 깨지면 갱신하되 dev 서버를\n+   띄우지 마라(실행 검증은 리뷰어가 한다).\n+\n+## 하지 말 것\n+\n+- `src/domain/**` 수정 금지 — 필요해지면 `blocked`.\n+- 断面リスト 파서 수정 금지 (ADR-039 §7). 배근 규준 수치 금지.\n+- **`phases/**/step*-codex.*.log`·`step*-invoke.json`을 지우지 마라.**\n+- **검증 스크립트를 `src/` 아래에 만들지 마라** — phase 디렉터리 안에 둬라.\n+- `scripts/execute.py` 금지 — 재귀다.\n+\n+## AC\n+\n+- `npm run test`·`npx tsc --noEmit`·`npm run lint` 전체 통과.\n+\n+## 산출물\n+\n+`phases/27-cantilever-slab/step2-report.json`: 변경 요지, 고정한 테스트, 게이트 결과.\ndiff --git a/phases/27-cantilever-slab/step3.md b/phases/27-cantilever-slab/step3.md\nnew file mode 100644\nindex 0000000..48a4705\n--- /dev/null\n+++ b/phases/27-cantilever-slab/step3.md\n@@ -0,0 +1,39 @@\n+# Step 3: 대장 정정 — 「두 원문 0건」 오기와 ADR-037 보충\n+\n+**전제**: step 2가 `completed`. 진행 중 새 반증 사유가 나오면 `blocked`.\n+\n+## 할 일 (문서만 — 코드 수정 금지)\n+\n+1. **오기 정정** — 「片持床板·配力筋(두 원문 0건)」은 틀렸다. 0건인 것은\n+   `配力筋`뿐이다(step 0이 쪽수로 확인했다). 다음을 고쳐라 —\n+   - `CLAUDE.md`·`AGENTS.md`의 부재 절: 片持床板이 phase 27(ADR-039)로\n+     들어왔음을, `配力筋`만 0건으로 남는다는 것을 적어라.\n+   - `docs/MILESTONES.md` 부재 확장 절: 「남은 것」에서 片持床板을 지우고\n+     완료 내역에 근거 조문(定義（４）·2（４）床板2) 但書·表5.3.4 L3·表5.3.5\n+     注1·2)을 적어라. **잔여가 비면 그 절의 상태 표시도 갱신하라.**\n+   - `docs/ADR.md`의 **ADR-028**에 날짜를 붙인 정정을 덧붙여라 — 원문을\n+     지우지 말고 「2026-08-26 정정: 「0건」은 配力筋에만 해당한다. 片持床板은\n+     ADR-039로 들어왔다」 취지. ADR-035의 정정 형식을 본떠라.\n+2. **ADR-037 보충** — 表5.3.1 注1이 「片持ちスラブ先端、**壁筋の自由端側の先端**」\n+   을 같은 자리에서 다룬다. ADR-037 §3의 자유단 판단을 원문이 지지한다는\n+   사실을 날짜를 붙여 보충하라(§3을 고치지 말고 덧붙여라). 4d 余長은 加工\n+   형상이라 数量에 들어가지 않는다는 것(1通則1)·R12와 같은 자리)도 적어라.\n+3. **R2 갱신** — `docs/RISKS.md` R2에 ADR-039의 두 읽기를 한 줄로 더하라:\n+   支持辺과 나란한 철근의 定着 0회, 5.3.4(5)(ｲ)(c)의 「柱せいの3/4」 미적용.\n+\n+## 하지 말 것\n+\n+- `src/**`·`tests/**` 수정 금지 — 이 스텝은 문서다. 필요해지면 `blocked`.\n+- 원문 조문을 요약하지 말고 인용하라. 있지도 않은 쪽수를 적지 마라.\n+- **`phases/**/step*-codex.*.log`·`step*-invoke.json`을 지우지 마라.**\n+- **검증 스크립트를 `src/` 아래에 만들지 마라** — phase 디렉터리 안에 둬라.\n+- `scripts/execute.py` 금지 — 재귀다.\n+\n+## AC\n+\n+- `npm run test`·`npx tsc --noEmit`·`npm run lint` 전체 통과(문서 변경이라\n+  게이트는 회귀 확인이다).\n+\n+## 산출물\n+\n+`phases/27-cantilever-slab/step3-report.json`: 고친 문서와 문장, 게이트 결과.\n--- current slab tests setup ---\r\n   1:import { describe, expect, it } from 'vitest'\r\n   2:\r\n   3:import { jpMlitRulePack } from '../../rulepack'\r\n   4:import { MemberUnsupportedError } from '../model/unsupported'\r\n   5:import { resolveSlabEnd } from './slab-ends'\r\n   6:\r\n   7:// ?듐꺍?쀣꺂旅덁뻑??ㄷ歟?G1 ?ⓨ릪?섅걢?뜰굤?삠꺂?귛츣??뚨킀?얇굥?뗣겘??궧竊덂ㄷ歟곻펹??\r\n   8:// ?뗣겤?듽겎黎뷩겲?뗣겗?㎯곩틞?욕겢??퍞訝듽걩?㎯겘?ゃ걦?볝걾?됥굮歷▲걲??\r\n   9:const girderCover = {\r\n  10:  memberKind: '鸚㎪쥈',\r\n  11:  soilContact: false,\r\n  12:  exposure: '掠뗥쨼',\r\n  13:  finish: '餓뺜툓?믡겒??,\r\n  14:}\r\n  15:\r\n  16:// 掠뗥쨼?삡퍞訝듽걩?ゃ걮 竊??弱뤵걢?뜰굤 40 竊??졾램??10?귛퉭 400 ??ㄷ歟곥겒?됪뒘壤긱겓\r\n  17:// 鵝욍걟?뗣겗??350mm ?㎯걗?뗣?\r\n  18:const fabricationCoverMm = 50\r\n  19:\r\n  20:function end(\r\n  21:  overrides: Partial<Parameters<typeof resolveSlabEnd>[0]> = {},\r\n  22:) {\r\n  23:  return resolveSlabEnd(\r\n  24:    {\r\n  25:      supportWidthMm: 400,\r\n  26:      supportCover: girderCover,\r\n  27:      barSize: 'D13',\r\n  28:      fc: 24,\r\n  29:      grade: 'SD345',\r\n  30:      face: '訝뗧ク',\r\n  31:      ...overrides,\r\n  32:    },\r\n  33:    jpMlitRulePack,\r\n  34:  )\r\n  35:}\r\n  36:\r\n  37:describe('佯딀씮訝뗧ク嶺뗣겗若싩? ??烏?.3.4 ??L3竊덀궧?⒲깣轝꾬펹', () => {\r\n  38:  it('???0d ?뗣겇150mm餓δ툓?띲겗鸚㎯걤?꾣뼶?믣룚????D13 ?㎯겘訝뗩솏?뚦떇??, () => {\r\n  39:    const detai