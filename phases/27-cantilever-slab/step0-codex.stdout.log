in.x\n964:  const centerSpanYMm = far.y - origin.y\n965:  const startFaceOffsetXMm = supports.minX.widthMm / 2\n966:  const startFaceOffsetYMm = supports.minY.widthMm / 2\n967:  const clearXMm =\n968:    centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\n969:  const clearYMm =\n970:    centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\n971:\n972:  if (clearXMm <= 0 || clearYMm <= 0) {\n973:    throw new MemberUnsupportedError(\n974:      '寸法不成立',\n975:      `床板 内法長さ must be positive: ${member.id} ` +\n976:        `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\n977:    )\n978:  }\n979:\n980:  return {\n981:    centerSpanXMm,\n982:    centerSpanYMm,\n983:    clearXMm,\n984:    clearYMm,\n985:    startFaceOffsetXMm,\n986:    startFaceOffsetYMm,\n987:    supports,\n988:  }\n989:}\n990:\n991:/**\n992: * 同一断面の床板が大梁を通して連なる範囲 — 数量積算基準 2（４）床板1) の\n993: * 「同一の径の主筋が梁、壁等を通して連続する場合」がこれである。\n994: *\n995: * 大梁のラン (girderRun) と同じ形だ。1ベイなら長さ1のランで「単独床板」、\n996: * 2ベイ以上なら「連続する床板」になり、継手箇所数の条文が 2（４）床板2) に\n997: * 切り替わる。X方向とY方向で別のランを持つ — 床板は2方向に主筋が走るからだ。\n998: */\n999:export interface SlabRun {\n1000:  axis: 'X' | 'Y'\n1001:  /** 軸方向の昇順。単独床板なら長さ1 */\n1002:  members: Member[]\n1003:  /** 通し筋を帰属させる部材 ＝ members[0].id */\n1004:  ownerId: string\n1005:  /** members と同じ順序 */\n1006:  bays: SlabBay[]\n1007:  /**\n1008:   * ラン原点（始端の大梁の内側面）から各ベイの内法域の始まりまでの距離 (mm)。\n1009:   * bays と同じ順序で [0] は 0 である。3D がランを1つの枠に描くとき、\n1010:   * 各ベイの箱をここに置く — 描画側で足し直すと配筋とずれる。\n1011:   */\n1012:  memberOffsetsMm: number[]\n1013:  /** ラン芯長 (mm) ＝ Σ内法長さ ＋ Σ中間大梁の幅 */\n1014:  coreLengthMm: number\n1015:  /** 割付方向（主筋と直交する向き）の内法長さ (mm) — ラン内で共通である */\n1016:  distributionClearMm: number\n1017:  /** 始端で定着していく大梁 */\n1018:  startSupport: SlabEdgeSupport\n1019:  /** 終端で定着していく大梁 */\n1020:  endSupport: SlabEdgeSupport\n1021:  /**\n1022:   * ランに開いている開口部 (1通則8))、**ラン原点からの座標**に直したもの。\n1023:   *\n1024:   * 開口はベイ（＝部材）ごとに入力されるが、床板の鉄筋はランで測るので、\n1025:   * 欠除も3Dの切り欠きもラン座標で見る。ここで一度だけ直しておかないと、\n1026:   * 数量と表示が別々にベイのオフセットを足し直して食い違う (ADR-029)。\n1027:   */\n1028:  openings: Opening[]\n1029:}\n1030:\n1031:export function slabRun(\n1032:  project: Project,\n1033:  member: Member,\n1034:  axis: 'X' | 'Y',\n1035:): SlabRun {\n1036:  if (member.kind !== '床板' || !isSlabPosition(member.position)) {\n1037:    throw new Error(`slabRun requires a 床板: ${member.id}`)\n1038:  }\n1039:\n1040:  const { ix, iy } = member.position\n1041:  const slabAt = (\n1042:    candidateIx: number,\n1043:    candidateIy: number,\n1044:  ): Member | undefined =>\n1045:    project.members.find(\n1046:      (candidate) =>\n1047:        candidate.kind === '床板' &&\n1048:        candidate.storyId === member.storyId &&\n1049:        // 同一断面であることを連続の条件にする。条文は「同一の径の主筋が」と\n1050:        // 言うが、径が同じでもピッチが違えば全部の鉄筋が通るわけではない —\n1051:        // 断面が同じことはその十分条件であって、図面にない連続を作らない。\n1052:        candidate.sectionId === member.sectionId &&\n1053:        isSlabPosition(candidate.position) &&\n1054:        candidate.position.ix === candidateIx &&\n1055:        candidate.position.iy === candidateIy,\n1056:    )\n1057:\n1058:  const step = (offset: number): [number, number] =>\n1059:    axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\n1060:\n1061:  const members: Member[] = [member]\n1062:  for (let offset = -1; ; offset -= 1) {\n1063:    const previous = slabAt(...step(offset))\n1064:    if (!previous) break\n1065:    members.unshift(previous)\n1066:  }\n1067:  for (let offset = 1; ; offset += 1) {\n1068:    const next = slabAt(...step(offset))\n1069:    if (!next) break\n1070:    members.push(next)\n1071:  }\n1072:\n1073:  const bays = members.map((candidate) => slabBay(project, candidate))\n1074:  const clearAlong = (bay: SlabBay): number =>\n1075:    axis === 'X' ? bay.clearXMm : bay.clearYMm\n1076:  const clearAcross = (bay: SlabBay): number =>\n1077:    axis === 'X' ? bay.clearYMm : bay.clearXMm\n1078:\n1079:  // 割付本数は 1通則7) が「その部分の長さ」を鉄筋の間隔で除して求める1つの数だ。\n1080:  // ランの途中で直交方向の内法が変われば、その1つの数がどちらのベイでも正しく\n1081:  // ならない — 一部だけ通る鉄筋を製品が表現できないので、作らずに落とす。\n1082:  const distributionClearMm = clearAcross(bays[0])\n1083:  const uneven = bays.findIndex(\n1084:    (bay) => clearAcross(bay) !== distributionClearMm,\n1085:  )\n1086:  if (uneven > 0) {\n1087:    throw new MemberUnsupportedError(\n1088:      '寸法不成立',\n1089:      `床板ラン内で割付方向の内法長さが揃わない: ${members[0].id} ` +\n1090:        `(${distributionClearMm} mm) と ${members[uneven].id} ` +\n1091:        `(${clearAcross(bays[uneven])} mm)`,\n1092:    )\n1093:  }\n1094:\n1095:  // 中間大梁の幅は「幅の1/2」が両側から来て1本分になる — 2（４）床板1) の\n1096:  // 但書がそう定める。大梁のラン芯長が中間柱せいを足すのと同じ形だ。\n1097:  // ベイの始まりを一度だけ累積し、最後のベイの始まり ＋ その内法を芯長とする —\n1098:  // 二つを別々に数えるとすぐ食い違う（大梁のランと同じ約束）。\n1099:  const memberOffsetsMm: number[] = []\n1100:  let offsetMm = 0\n1101:  for (const bay of bays) {\n1102:    memberOffsetsMm.push(offsetMm)\n1103:    offsetMm +=\n1104:      clearAlong(bay) +\n1105:      (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\n1106:  }\n1107:  const coreLengthMm =\n1108:    memberOffsetsMm[memberOffsetsMm.length - 1] +\n1109:    clearAlong(bays[bays.length - 1])\n1110:\n1111:  const first = bays[0]\n1112:  const last = bays[bays.length - 1]\n1113:\n1114:  // ベイ局所の開口をラン座標へ移す。走る向きにだけベイのオフセットが乗る —\n1115:  // 直交方向の内法はラン内で共通なので（上でそれを検査している）そのままだ。\n1116:  const openings = members.flatMap((candidate, index) =>\n1117:    (candidate.openings ?? []).map((opening) => ({\n1118:      ...opening,\n1119:      xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\n1120:      yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\n1121:    })),\n1122:  )\n1123:\n1124:  return {\n1125:    axis,\n1126:    members,\n1127:    ownerId: members[0].id,\n1128:    bays,\n1129:    memberOffsetsMm,\n1130:    coreLengthMm,\n1131:    distributionClearMm,\n1132:    startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\n1133:    endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\n1134:    openings,\n1135:  }\n--- src/domain/rebar/slab.ts ---\n196:  const row = (run.axis === 'X' ? section.x : section.y)[\n197:    face === '上端' ? 'top' : 'bottom'\n198:  ]\n199:  const diameter = barDiameter(row.size)\n200:  const endInput = {\n201:    barSize: row.size,\n202:    fc: section.fc,\n203:    grade: section.grade,\n204:    face,\n205:  }\n206:  const start = resolveSlabEnd(\n207:    {\n208:      ...endInput,\n209:      supportWidthMm: run.startSupport.widthMm,\n210:      supportCover: run.startSupport.cover,\n211:    },\n212:    pack,\n213:  )\n214:  const end = resolveSlabEnd(\n215:    {\n216:      ...endInput,\n217:      supportWidthMm: run.endSupport.widthMm,\n218:      supportCover: run.endSupport.cover,\n219:    },\n220:    pack,\n221:  )\n222:\n--- src/domain/rebar/slab-ends.ts ---\n81:export function resolveSlabEnd(\n82:  input: SlabEndInput,\n83:  pack: RulePack,\n84:): SlabEndDetail {\n85:  const diameter = barDiameter(input.barSize)\n86:  const minimumCoverRule = lookupRule(pack, 'cover.minimum', input.supportCover)\n87:  const fabricationCoverAdditionRule = lookupRule(\n88:    pack,\n89:    'cover.fabrication.addition',\n90:    {},\n91:  )\n92:  const coverRules = [minimumCoverRule, fabricationCoverAdditionRule]\n93:  const availableMm =\n94:    input.supportWidthMm -\n95:    (millimetres(minimumCoverRule) +\n96:      millimetres(fabricationCoverAdditionRule))\n97:\n98:  if (input.face === '下端') {\n99:    return resolveBottom(input, pack, diameter, availableMm, coverRules)\n100:  }\n101:\n102:  return resolveTop(input, pack, diameter, availableMm, coverRules)\n103:}\n104:\n105:/**\n106: * 下端筋 — 表5.3.4 注3 の L3。「10d かつ150mm以上」なので二つの行の大きい方だ。\n107: * 大きい方を取る計算がここにあり、ルールパックは 10d と 150mm を別々に持つ\n108: * (ADR-002 — 耐力壁の重ね継手下限と同じ形)。\n109: */\n110:function resolveBottom(\n111:  input: SlabEndInput,\n112:  pack: RulePack,\n113:  diameter: number,\n114:  availableMm: number,\n115:  coverRules: RuleHit[],\n116:): SlabEndDetail {\n117:  const perDiameterRule = lookupRule(pack, 'anchorage.L3', { member: 'スラブ' })\n118:  const floorRule = lookupRule(pack, 'anchorage.L3.minimum', {\n119:    member: 'スラブ',\n120:  })\n121:  const perDiameterMm = millimetres(perDiameterRule, diameter)\n122:  const floorMm = millimetres(floorRule)\n123:  const lengthMm = Math.max(perDiameterMm, floorMm)\n124:\n125:  if (lengthMm > availableMm) {\n126:    throw new MemberUnsupportedError(\n127:      '定着不成立',\n128:      `床板下端筋の直線定着が大梁に収まらない: ` +\n129:        `必要 ${lengthMm} mm > 使用可能 ${availableMm} mm`,\n130:    )\n131:  }\n132:\n133:  return {\n134:    kind: '直線定着',\n135:    lengthRule:\n136:      perDiameterMm >= floorMm ? 'anchorage.L3' : 'anchorage.L3.minimum',\n137:    lengthMm,\n138:    usedRules: [perDiameterRule, floorRule, ...coverRules],\n139:  }\n140:}\n141:\n142:/**\n143: * 上端筋 — 一般値 L1(注1)。L2 は「割裂破壊のおそれのない箇所」限定で、その\n144: * 判定材料を製品が持たない (R7)。直線が入らなければ 5.3.4(5)(ｲ) の (a)(b)(c)。\n145: */\n146:function resolveTop(\n147:  input: SlabEndInput,\n148:  pack: RulePack,\n149:  diameter: number,\n150:  availableMm: number,\n151:  coverRules: RuleHit[],\n152:): SlabEndDetail {\n153:  const straightRule = lookupRule(pack, 'anchorage.L1', {\n154:    fc: input.fc,\n155:    grade: input.grade,\n156:    hook: false,\n157:  })\n158:  const straightLengthMm = millimetres(straightRule, diameter)\n159:\n160:  if (straightLengthMm <= availableMm) {\n161:    return {\n162:      kind: '直線定着',\n163:      lengthRule: 'anchorage.L1',\n164:      lengthMm: straightLengthMm,\n165:      usedRules: [straightRule, ...coverRules],\n166:    }\n167:  }\n168:\n169:  // anchorage.L1h は引かない — 5.3.4(5)(ｲ) で L1h は**適用条件**であって\n170:  // (a)(b)(c) のどの値も決めない (大梁の resolveGirderEnd と同じ理由)。\n171:  const projectionRule = lookupRule(pack, 'anchorage.Lb', {\n172:    fc: input.fc,\n173:    grade: input.grade,\n174:  })\n175:  const tailMinimumRule = lookupRule(pack, 'anchorage.bent.tail.minimum', {})\n176:  const projectionMm = millimetres(projectionRule, diameter)\n177:\n178:  if (projectionMm > availableMm) {\n179:    throw new MemberUnsupportedError(\n180:      '定着不成立',\n181:      `床板上端筋の折曲げ定着が大梁に収まらない: ` +\n182:        `必要投影 ${projectionMm} mm > 使用可能 ${availableMm} mm`,\n183:    )\n184:  }\n185:\n186:  const tailMinimumMm = projectionMm + millimetres(tailMinimumRule, diameter)\n187:  const lengthMm = Math.max(straightLengthMm, tailMinimumMm)\n188:\n189:  return {\n190:    kind: '折曲げ定着',\n191:    lengthRule:\n192:      straightLengthMm >= tailMinimumMm\n193:        ? 'anchorage.L1'\n194:        : 'anchorage.bent.tail.minimum',\n195:    projectionRule: 'anchorage.Lb',\n196:    lengthMm,\n197:    straightMinimumMm: straightLengthMm,\n198:    tailMinimumMm,\n199:    projectionMm,\n200:    usedRules: [\n201:      straightRule,\n202:      projectionRule,\n203:      tailMinimumRule,\n204:      ...coverRules,\n205:    ],\n","exit_code":0,"status":"completed"}}
