,\r\n    \"@types/react-dom\": \"^19.2.4\",\r\n    \"@types/three\": \"^0.185.4\",\r\n    \"@vitejs/plugin-react\": \"^6.0.5\",\r\n    \"autoprefixer\": \"^10.5.4\",\r\n    \"eslint\": \"^8.57.1\",\r\n    \"eslint-config-next\": \"^15.5.23\",\r\n    \"fake-indexeddb\": \"6.2.5\",\r\n    \"jsdom\": \"^30.0.1\",\r\n    \"postcss\": \"^8.5.26\",\r\n    \"raw-loader\": \"^4.0.2\",\r\n    \"tailwindcss\": \"^3.4.17\",\r\n    \"tsx\": \"^4.23.12\",\r\n    \"typescript\": \"^5.9.3\",\r\n    \"vitest\": \"^4.1.10\"\r\n  },\r\n  \"overrides\": {\r\n    \"posthog-js\": \"1.417.4\"\r\n  }\r\n}\r\n","exit_code":0,"status":"completed"}}
