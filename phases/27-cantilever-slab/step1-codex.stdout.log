\r\n 1086:   if (startColumn === undefined || endColumn === undefined) {\r\n 1087:     throw cantileverError(member, '支持辺の両端に柱がない')\r\n 1088:   }\r\n 1089: \r\n 1090:   const startSection = findSection(project, startColumn.sectionId)\r\n 1091:   const endSection = findSection(project, endColumn.sectionId)\r\n 1092:   if (startSection.kind !== '柱' || endSection.kind !== '柱') {\r\n 1093:     throw cantileverError(member, '支持辺の両端が柱断面ではない')\r\n 1094:   }\r\n 1095: \r\n 1096:   const startPoint = gridPoint(project.grid, position.ix, position.iy)\r\n 1097:   const endPoint = gridPoint(project.grid, endIx, endIy)\r\n 1098:   const centerSpan =\r\n 1099:     position.axis === 'X'\r\n 1100:       ? endPoint.x - startPoint.x\r\n 1101:       : endPoint.y - startPoint.y\r\n 1102:   const startColumnLength =\r\n 1103:     position.axis === 'X' ? startSection.b : startSection.d\r\n 1104:   const endColumnLength = position.axis === 'X' ? endSection.b : endSection.d\r\n 1105:   const supportClearMm =\r\n 1106:     centerSpan - startColumnLength / 2 - endColumnLength / 2\r\n 1107:   const projectionMm = member.cantilever.projectionMm\r\n 1108: \r\n 1109:   if (\r\n 1110:     !Number.isFinite(projectionMm) ||\r\n 1111:     projectionMm <= 0 ||\r\n 1112:     !Number.isFinite(supportClearMm) ||\r\n 1113:     supportClearMm <= 0\r\n 1114:   ) {\r\n 1115:     throw cantileverError(\r\n 1116:       member,\r\n 1117:       `支持辺の内法 ${supportClearMm} mm または projection ${projectionMm} mm が正でない`,\r\n 1118:     )\r\n 1119:   }\r\n 1120: \r\n 1121:   const slabSupport: SlabEdgeSupport = {\r\n 1122:     memberId: support.member.id,\r\n 1123:     widthMm: support.section.b,\r\n 1124:     cover: coverConditions(support.section),\r\n 1125:   }\r\n 1126:   const projectionAxis = position.axis === 'X' ? 'Y' : 'X'\r\n 1127:   const supportAt =\r\n 1128:     axis === position.axis\r\n 1129:       ? 'none'\r\n 1130:       : member.cantilever.side === '正'\r\n 1131:         ? 'start'\r\n 1132:         : 'end'\r\n 1133:   const coreLengthMm = axis === projectionAxis ? projectionMm : supportClearMm\r\n 1134:   const distributionClearMm =\r\n 1135:     axis === projectionAxis ? supportClearMm : projectionMm\r\n 1136: \r\n 1137:   return {\r\n 1138:     axis,\r\n 1139:     members: [member],\r\n 1140:     ownerId: member.id,\r\n 1141:     bays: [],\r\n 1142:     memberOffsetsMm: [0],\r\n 1143:     coreLengthMm,\r\n 1144:     distributionClearMm,\r\n 1145:     startSupport: supportAt === 'start' ? slabSupport : null,\r\n 1146:     endSupport: supportAt === 'end' ? slabSupport : null,\r\n 1147:     cantilever: {\r\n 1148:       supportAxis: position.axis,\r\n 1149:       side: member.cantilever.side,\r\n 1150:       supportAt,\r\n 1151:       support: slabSupport,\r\n 1152:       supportClearMm,\r\n 1153:       projectionMm,\r\n 1154:     },\r\n 1155:     openings: member.openings ?? [],\r\n 1156:   }\r\n 1157: }\r\n 1158: \r\n 1159: export function slabRun(\r\n 1160:   project: Project,\r\n 1161:   member: Member,\r\n 1162:   axis: 'X' | 'Y',\r\n 1163: ): SlabRun {\r\n 1164:   if (member.kind !== '床板') {\r\n 1165:     throw new Error(`slabRun requires a 床板: ${member.id}`)\r\n 1166:   }\r\n 1167: \r\n 1168:   if (member.cantilever !== undefined && !isCantileverSlabMember(member)) {\r\n 1169:     throw new MemberUnsupportedError(\r\n 1170:       '寸法不成立',\r\n 1171:       `片持床板の position がベイではない、または条件が不正: ${member.id}`,\r\n 1172:     )\r\n 1173:   }\r\n 1174: \r\n 1175:   if (isCantileverSlabMember(member)) {\r\n 1176:     return slabCantileverRun(project, member, axis)\r\n 1177:   }\r\n 1178: \r\n 1179:   if (!isSlabPosition(member.position)) {\r\n 1180:     throw new MemberUnsupportedError(\r\n 1181:       '寸法不成立',\r\n 1182:       `片持条件のない床板はベイ位置でなければならない: ${member.id}`,\r\n 1183:     )\r\n 1184:   }\r\n 1185: \r\n 1186:   const { ix, iy } = member.position\r\n 1187:   const slabAt = (\r\n 1188:     candidateIx: number,\r\n 1189:     candidateIy: number,\r\n 1190:   ): Member | undefined =>\r\n 1191:     project.members.find(\r\n 1192:       (candidate) =>\r\n 1193:         candidate.kind === '床板' &&\r\n 1194:         candidate.storyId === member.storyId &&\r\n 1195:         // 同一断面であることを連続の条件にする。条文は「同一の径の主筋が」と\r\n 1196:         // 言うが、径が同じでもピッチが違えば全部の鉄筋が通るわけではない —\r\n 1197:         // 断面が同じことはその十分条件であって、図面にない連続を作らない。\r\n 1198:         candidate.sectionId === member.sectionId &&\r\n 1199:         isSlabPosition(candidate.position) &&\r\n 1200:         candidate.position.ix === candidateIx &&\r\n 1201:         candidate.position.iy === candidateIy,\r\n 1202:     )\r\n 1203: \r\n 1204:   const step = (offset: number): [number, number] =>\r\n 1205:     axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\r\n 1206: \r\n 1207:   const members: Member[] = [member]\r\n 1208:   for (let offset = -1; ; offset -= 1) {\r\n 1209:     const previous = slabAt(...step(offset))\r\n 1210:     if (!previous) break\r\n 1211:     members.unshift(previous)\r\n 1212:   }\r\n 1213:   for (let offset = 1; ; offset += 1) {\r\n 1214:     const next = slabAt(...step(offset))\r\n 1215:     if (!next) break\r\n 1216:     members.push(next)\r\n 1217:   }\r\n 1218: \r\n 1219:   const bays = members.map((candidate) => slabBay(project, candidate))\r\n 1220:   const clearAlong = (bay: SlabBay): number =>\r\n 1221:     axis === 'X' ? bay.clearXMm : bay.clearYMm\r\n 1222:   const clearAcross = (bay: SlabBay): number =>\r\n 1223:     axis === 'X' ? bay.clearYMm : bay.clearXMm\r\n 1224: \r\n 1225:   // 割付本数は 1通則7) が「その部分の長さ」を鉄筋の間隔で除して求める1つの数だ。\r\n 1226:   // ランの途中で直交方向の内法が変われば、その1つの数がどちらのベイでも正しく\r\n 1227:   // ならない — 一部だけ通る鉄筋を製品が表現できないので、作らずに落とす。\r\n 1228:   const distributionClearMm = clearAcross(bays[0])\r\n 1229:   const uneven = bays.findIndex(\r\n 1230:     (bay) => clearAcross(bay) !== distributionClearMm,\r\n 1231:   )\r\n 1232:   if (uneven > 0) {\r\n 1233:     throw new MemberUnsupportedError(\r\n 1234:       '寸法不成立',\r\n 1235:       `床板ラン内で割付方向の内法長さが揃わない: ${members[0].id} ` +\r\n 1236:         `(${distributionClearMm} mm) と ${members[uneven].id} ` +\r\n 1237:         `(${clearAcross(bays[uneven])} mm)`,\r\n 1238:     )\r\n 1239:   }\r\n 1240: \r\n 1241:   // 中間大梁の幅は「幅の1/2」が両側から来て1本分になる — 2（４）床板1) の\r\n 1242:   // 但書がそう定める。大梁のラン芯長が中間柱せいを足すのと同じ形だ。\r\n 1243:   // ベイの始まりを一度だけ累積し、最後のベイの始まり ＋ その内法を芯長とする —\r\n 1244:   // 二つを別々に数えるとすぐ食い違う（大梁のランと同じ約束）。\r\n 1245:   const memberOffsetsMm: number[] = []\r\n 1246:   let offsetMm = 0\r\n 1247:   for (const bay of bays) {\r\n 1248:     memberOffsetsMm.push(offsetMm)\r\n 1249:     offsetMm +=\r\n 1250:       clearAlong(bay) +\r\n 1251:       (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\r\n 1252:   }\r\n 1253:   const coreLengthMm =\r\n 1254:     memberOffsetsMm[memberOffsetsMm.length - 1] +\r\n 1255:     clearAlong(bays[bays.length - 1])\r\n 1256: \r\n 1257:   const first = bays[0]\r\n 1258:   const last = bays[bays.length - 1]\r\n 1259: \r\n 1260:   // ベイ局所の開口をラン座標へ移す。走る向きにだけベイのオフセットが乗る —\r\n 1261:   // 直交方向の内法はラン内で共通なので（上でそれを検査している）そのままだ。\r\n 1262:   const openings = members.flatMap((candidate, index) =>\r\n 1263:     (candidate.openings ?? []).map((opening) => ({\r\n 1264:       ...opening,\r\n 1265:       xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\r\n 1266:       yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\r\n 1267:     })),\r\n 1268:   )\r\n 1269: \r\n 1270:   return {\r\n 1271:     axis,\r\n 1272:     members,\r\n 1273:     ownerId: members[0].id,\r\n 1274:     bays,\r\n 1275:     memberOffsetsMm,\r\n 1276:     coreLengthMm,\r\n 1277:     distributionClearMm,\r\n 1278:     startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\r\n 1279:     endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\r\n 1280:     openings,\r\n 1281:   }\r\n 1282: }\r\n 1283: \r\n 1284: export interface GirderRun {\r\n 1285:   axis: 'X' | 'Y'\r\n 1286:   /** 축방향 오름차순. 단일 스팬이면 길이 1 */\r\n 1287:   members: Member[]\r\n 1288:   /** 通し筋을 귀속시킬 부재 = members[0].id */\r\n 1289:   ownerId: string\r\n 1290:   /** members와 같은 순서 */\r\n 1291:   spans: GirderSpan[]\r\n 1292:   /**\r\n 1293:    * 런 원점(시작 柱の内側面)에서 각 스팬 시작면까지의 거리 (mm). members와 같은\r\n 1294:    * 순서이고 [0]은 0이다.\r\n 1295:    *\r\n 1296:    * 通し筋은 런 전체를 한 프레임에 덮지만 あばら筋은 각 부재 자기 스팬 로컬(0 기준)\r\n 1297:    * 이다. 런을 한 프레임에 그리는 쪽이 이 오프셋을 모르면 2번째 이후 스팬의\r\n 1298:    * あばら筋이 1번째 스팬 위에 겹친다.\r\n 1299:    */\r\n 1300:   memberOffsetsMm: number[]\r\n--- project validation region ---\r\n 1481:   note: string,\r\n 1482: ): Project {\r\n 1483:   const notes = { ...project.notes }\r\n 1484: \r\n 1485:   if (note === '') delete notes[lineId]\r\n 1486:   else notes[lineId] = note\r\n 1487: \r\n 1488:   return { ...project, notes }\r\n 1489: }\r\n 1490: \r\n 1491: /** 빈 입력은 키를 지운다 — 0 kg/m는 입력이 아니라 없는 값이다. */\r\n 1492: export function setUnitMass(\r\n 1493:   project: Project,\r\n 1494:   size: ShearBarSize,\r\n 1495:   value: number | null,\r\n 1496: ): Project {\r\n 1497:   const unitMass = { ...project.unitMass }\r\n 1498: \r\n 1499:   if (value === null) delete unitMass[size]\r\n 1500:   else unitMass[size] = value\r\n 1501: \r\n 1502:   return { ...project, unitMass }\r\n 1503: }\r\n 1504: \r\n 1505: export function serializeProject(project: Project): string {\r\n 1506:   return JSON.stringify(project)\r\n 1507: }\r\n 1508: \r\n 1509: const isString = (value: unknown): boolean => typeof value === 'string'\r\n 1510: \r\n 1511: const isFiniteNumber = (value: unknown): boolean =>\r\n 1512:   typeof value === 'number' && Number.isFinite(value)\r\n 1513: \r\n 1514: const isPositiveFiniteNumber = (value: unknown): boolean =>\r\n 1515:   isFiniteNumber(value) && (value as number) > 0\r\n 1516: \r\n 1517: function isRecord(value: unknown): value is Record<string, unknown> {\r\n 1518:   return typeof value === 'object' && value !== null && !Array.isArray(value)\r\n 1519: }\r\n 1520: \r\n 1521: function hasShape(\r\n 1522:   value: unknown,\r\n 1523:   fields: Record<string, (field: unknown) => boolean>,\r\n 1524: ): boolean {\r\n 1525:   return (\r\n 1526:     isRecord(value) &&\r\n 1527:     Object.entries(fields).every(([key, check]) => check(value[key]))\r\n 1528:   )\r\n 1529: }\r\n 1530: \r\n 1531: const isNumberArray = (value: unknown): boolean =>\r\n 1532:   Array.isArray(value) && value.every(isFiniteNumber)\r\n 1533: \r\n 1534: /** 呼び名＋本数のような小さな組を検める。 */\r\n 1535: const shapedAs =\r\n 1536:   (fields: Record<string, (field: unknown) => boolean>) =>\r\n 1537:   (value: unknown): boolean =>\r\n 1538:     hasShape(value, fields)\r\n 1539: \r\n 1540: const isMainRow = (value: unknown): boolean => {\r\n 1541:   if (\r\n 1542:     !hasShape(value, {\r\n 1543:       endCount: isFiniteNumber,\r\n 1544:       centerCount: isFiniteNumber,\r\n 1545:     })\r\n 1546:   ) {\r\n 1547:     return false\r\n 1548:   }\r\n 1549: \r\n 1550:   const row = value as Record<string, unknown>\r\n 1551:   return row.startCount === undefined || isFiniteNumber(row.startCount)\r\n 1552: }\r\n 1553: \r\n 1554: const isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\r\n 1555: \r\n 1556: /**\r\n 1557:  * 種別ごとに、**取り込んだ直後の計算が見守りなしに参照する**場だけを並べる。\r\n 1558:  *\r\n 1559:  * ここに無い場 (fc・grade・exposure・spliceMethod など) は、欠けてもルールパック\r\n 1560:  * 引きが名前のある例外で止める — どこで何が足りないかが画面に出る。\r\n 1561:  * 選んであるのは TypeError になる場 — それだけが「何が起きたか言えない落ち方」をする。\r\n 1562:  */\r\n 1563: const isBarRow = shapedAs({\r\n 1564:   size: isString,\r\n 1565:   pitch: isFiniteNumber,\r\n 1566:   startOffsetMm: isFiniteNumber,\r\n 1567: })\r\n 1568: \r\n 1569: /**\r\n 1570:  * 寸法の鍵は種別で違う。柱・大梁は b とせいだが、耐震壁・床板は thickness 一つ\r\n 1571:  * だ — 躯体の区分が壁を「内法部分」、床板を「内法部分」と定めるので、長さは\r\n 1572:  * 位置と隣の部材から出て断面には無い (ADR-025・ADR-028)。共通の場所で b を\r\n 1573:  * 求めると、正しい壁の記録が形違いとして弾かれる。\r\n 1574:  */\r\n 1575: const SECTION_FIELDS: Record<\r\n 1576:   MemberKind,\r\n 1577:   Record<string, (field: unknown) => boolean>\r\n 1578: > = {\r\n 1579:   柱: {\r\n 1580:     b: isFiniteNumber,\r\n 1581:     d: isFiniteNumber,\r\n 1582:     main: shapedAs({ size: isString, count: isFiniteNumber }),\r\n 1583:     hoop: isBarRow,\r\n 1584:   },\r\n 1585:   大梁: {\r\n 1586:     b: isFiniteNumber,\r\n 1587:     depth: isFiniteNumber,\r\n 1588:     main: shapedAs({\r\n 1589:       size: isString,\r\n 1590:       top: isMainRow,\r\n 1591:       bottom: isMainRow,\r\n 1592:       cutoffFromSupportFaceMm: isFiniteNumber,\r\n 1593:     }),\r\n 1594:     stirrup: isBarRow,\r\n 1595:   },\r\n 1596:   耐震壁: {\r\n 1597:     thickness: isFiniteNumber,\r\n 1598:     // 雑壁 여부는 설계도서에서 사용자가 전사한 구분이다. optional은 기존\r\n 1599:     // 레코드의 생략을 耐力壁로 해석하기 위한 것이며, 다른 값을 조용히\r\n 1600:     // 통과시키면 cover/lap 분기가 정의되지 않은 채 계산된다 (ADR-036).\r\n 1601:     wallClass: (value) =>\r\n 1602:       value === undefined || value === '耐力壁' || value === '耐力壁以外',\r\n 1603:     // 層数はそのまま本数の倍率だ。欠けると縦筋・横筋の本数が NaN になる。\r\n 1604:     layers: isFiniteNumber,\r\n 1605:     vertical: isBarRow,\r\n 1606:     horizontal: isBarRow,\r\n 1607:   },\r\n 1608:   床板: {\r\n 1609:     thickness: isFiniteNumber,\r\n 1610:     x: shapedAs({ top: isBarRow, bottom: isBarRow }),\r\n 1611:     y: shapedAs({ top: isBarRow, bottom: isBarRow }),\r\n 1612:   },\r\n 1613: }\r\n 1614: \r\n 1615: /**\r\n 1616:  * 位置の形も種別で違う。床板は格子点ではなく**ベイ**を指すので (ix, iy) と\r\n 1617:  * (ix+1, iy+1) の両方を引く — 形は柱と同じでも意味が違う。\r\n 1618:  */\r\n 1619: const POSITION_FIELDS: Record<\r\n 1620:   MemberKind,\r\n 1621:   Record<string, (field: unknown) => boolean>\r\n 1622: > = {\r\n 1623:   柱: { ix: isFiniteNumber, iy: isFiniteNumber },\r\n 1624:   大梁: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\r\n 1625:   耐震壁: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\r\n 1626:   床板: {\r\n 1627:     ix: isFiniteNumber,\r\n 1628:     iy: isFiniteNumber,\r\n 1629:     // 通常の床板はベイ、片持床板は支持辺の GirderPosition を取る。\r\n 1630:     axis: (value) => value === undefined || isAxis(value),\r\n 1631:   },\r\n 1632: }\r\n 1633: \r\n 1634: const isOpening = shapedAs({\r\n 1635:   id: isString,\r\n 1636:   xMm: isFiniteNumber,\r\n 1637:   yMm: isFiniteNumber,\r\n 1638:   widthMm: isFiniteNumber,\r\n 1639:   heightMm: isFiniteNumber,\r\n 1640: })\r\n 1641: \r\n 1642: const isBarSize = (value: unknown): value is BarSize =>\r\n 1643:   BAR_SIZES.includes(value as BarSize)\r\n 1644: \r\n 1645: const isPositiveInteger = (value: unknown): boolean =>\r\n 1646:   typeof value === 'number' && Number.isInteger(value) && value > 0\r\n 1647: \r\n 1648: const isNonNegativeFiniteNumber = (value: unknown): boolean =>\r\n 1649:   typeof value === 'number' && Number.isFinite(value) && value >= 0\r\n 1650: \r\n 1651: const isOpeningReinforcement = shapedAs({\r\n 1652:   size: isBarSize,\r\n 1653:   count: isPositiveInteger,\r\n 1654:   // 0 is the persisted 未転記 state. The rebar generators omit it until the\r\n 1655:   // design-document transcription supplies a length.\r\n 1656:   lengthMm: isNonNegativeFiniteNumber,\r\n 1657: })\r\n 1658: \r\n 1659: const isOpeningWithReinforcements = (value: unknown): boolean => {\r\n 1660:   if (!isOpening(value)) return false\r\n 1661: \r\n 1662:   const reinforcements = (value as { reinforcements?: unknown }).reinforcements\r\n 1663:   return (\r\n 1664:     reinforcements === undefined ||\r\n 1665:     (Array.isArray(reinforcements) &&\r\n 1666:       reinforcements.every(isOpeningReinforcement))\r\n 1667:   )\r\n 1668: }\r\n 1669: \r\n 1670: const isWallExtent = (value: unknown): value is WallExtent =>\r\n 1671:   isRecord(value) &&\r\n 1672:   (value.vertical === undefined ||\r\n 1673:     hasShape(value.vertical, {\r\n 1674:       anchor: (anchor) => anchor === '下端' || anchor === '上端',\r\n 1675:       heightMm: isPositiveFiniteNumber,\r\n 1676:     })) &&\r\n 1677:   (value.horizontal === undefined ||\r\n 1678:     hasShape(value.horizontal, {\r\n 1679:       anchor: (anchor) => anchor === '始端' || anchor === '終端',\r\n 1680:       lengthMm: isPositiveFiniteNumber,\r\n 1681:     }))\r\n 1682: \r\n 1683: const isValidMemberWallExtent = (member: unknown): boolean => {\r\n 1684:   if (!isRecord(member)) return false\r\n 1685: \r\n 1686:   const extent = member.wallExtent\r\n 1687:   if (extent === undefined) return true\r\n 1688: \r\n 1689:   return member.kind === '耐震壁' && isWallExtent(extent)\r\n 1690: }\r\n 1691: \r\n 1692: const isValidMemberCantilever = (member: unknown): boolean => {\r\n 1693:   if (!isRecord(member)) return false\r\n 1694: \r\n 1695:   const position = member.position\r\n 1696:   const hasGirderPosition = isRecord(position) && isAxis(position.axis)\r\n 1697:   const cantilever = member.cantilever\r\n 1698: \r\n 1699:   if (cantilever === undefined) {\r\n 1700:     // 床板の辺位置は片持条件がないと意味を持たない。ほかの部材の\r\n 1701:     // position はこの下の POSITION_FIELDS で別途検める。\r\n 1702:     return member.kind !== '床板' || !hasGirderPosition\r\n 1703:   }\r\n 1704: \r\n 1705:   return (\r\n 1706:     member.kind === '床板' &&\r\n 1707:     hasGirderPosition &&\r\n 1708:     isRecord(cantilever) &&\r\n 1709:     (cantilever.side === '正' || cantilever.side === '負') &&\r\n 1710:     isPositiveFiniteNumber(cantilever.projectionMm)\r\n 1711:   )\r\n 1712: }\r\n 1713: \r\n 1714: const isMemberKind = (value: unknown): boolean =>\r\n 1715:   MEMBER_KINDS.includes(value as MemberKind)\r\n 1716: \r\n 1717: /**\r\n 1718:  * 骨格だけを検める。取り込む案件は他人が作った文字列で、schemaVersion しか\r\n 1719:  * 見ずに通すと形の違う JSON が Project として奥まで入る — 数量が NaN になるか\r\n 1720:  * 画面が落ちるかで、どちらも「読み込めなかった」より悪い。\r\n 1721:  *\r\n 1722:  * 検めるのは製品がすぐ添字を引く場所 (stories・members・sections・grid) と、\r\n 1723:  * 内訳書のセルにそのまま出る文字列だけだ。値の妥当性 (径が実在するか、\r\n 1724:  * 本数が正か) はここでは見ない — それは断面一覧の入力検査の持ち場で、\r\n 1725:  * ここで二重に持つと規準が二か所に分かれる。\r\n 1726:  */\r\n 1727: /**\r\n 1728:  * 形だけ通って中身の参照が切れている記録を切る。\r\n 1729:  *\r\n 1730:  * ここで見ないと、後から描画の途中で落ちる — useProjectPersistence の\r\n 1731:  * catch は loadProject が触った所 (最初の柱) しか見ないので、大梁の断面が\r\n 1732:  * 欠けている記録はそこを素通りして PaneBoundary に出る。\r\n 1733:  */\r\n 1734: interface ReferencedPosition {\r\n 1735:   axis?: 'X' | 'Y'\r\n 1736:   ix: number\r\n 1737:   iy: number\r\n 1738: }\r\n 1739: \r\n 1740: function hasIntactReferences(\r\n 1741:   grid: Grid,\r\n 1742:   sections: { id: string; kind: MemberKind }[],\r\n 1743:   stories: { id: string }[],\r\n 1744:   members: {\r\n 1745:     kind: MemberKind\r\n 1746:     sectionId: string\r\n 1747:     storyId: string\r\n 1748:     position: ReferencedPosition\r\n 1749:     cantilever?: { projectionMm: number }\r\n 1750:   }[],\r\n 1751: ): boolean {\r\n 1752:   const sectionKinds = new Map(sections.map(({ id, kind }) => [id, kind]))\r\n 1753:   const storyIds = new Set(stories.map(({ id }) => id))\r\n 1754:   const { nx, ny } = gridPointCount(grid)\r\n 1755: \r\n 1756:   // 大梁・耐震壁は隣の交点まで伸びるので、その軸だけ一つ手前までだ。床板は\r\n 1757:   // ベイなので両軸とも一つ手前 — slabBay が (ix+1, iy+1) を引く。\r\n 1758:   const inGrid = (member: {\r\n 1759:     kind: MemberKind\r\n 1760:     position: ReferencedPosition\r\n 1761:     cantilever?: { projectionMm: number }\r\n 1762:   }): boolean => {\r\n 1763:     const { kind, position } = member\r\n 1764:     const { axis, ix, iy } = position\r\n 1765:     const isCantilever = kind === '床板' && member.cantilever !== undefined\r\n 1766:     const spansX = isCantilever ? axis === 'Y' : kind === '床板' || axis === 'X'\r\n 1767:     const spansY = isCantilever ? axis === 'X' : kind === '床板' || axis === 'Y'\r\n 1768: \r\n 1769:     return (\r\n 1770:       Number.isInteger(ix) &&\r\n 1771:       Number.isInteger(iy) &&\r\n 1772:       ix >= 0 &&\r\n 1773:       iy >= 0 &&\r\n 1774:       ix < nx - (spansX ? 1 : 0) &&\r\n 1775:       iy < ny - (spansY ? 1 : 0)\r\n 1776:     )\r\n 1777:   }\r\n 1778: \r\n 1779:   return members.every(\r\n 1780:     (member) =>\r\n 1781:       // 種別違いも切る。大梁が柱の断面を指すと buildingLayout が投げる。\r\n 1782:       sectionKinds.get(member.sectionId) === member.kind &&\r\n 1783:       storyIds.has(member.storyId) &&\r\n 1784:       // グリッドの外を指す位置は gridPoint が RangeError で投げ、全ペインが落ちる。\r\n 1785:       // その案件を自動保存が書くので、次の訪問でも同じ所で落ちる。\r\n 1786:       inGrid(member),\r\n 1787:   )\r\n 1788: }\r\n 1789: \r\n 1790: function hasGridLabels(grid: unknown): boolean {\r\n 1791:   if (!isRecord(grid)) return false\r\n 1792:   const { xSpans, ySpans, xLabels, yLabels } = grid\r\n 1793:   if (!Array.isArray(xSpans) || !Array.isArray(ySpans)) return false\r\n 1794: \r\n 1795:   return (\r\n 1796:     (xLabels === undefined || isGridLabels(xLabels, xSpans.length)) &&\r\n 1797:     (yLabels === undefined || isGridLabels(yLabels, ySpans.length))\r\n 1798:   )\r\n 1799: }\r\n 1800: \r\n 1801: function isProjectShape(value: unknown): boolean {\r\n 1802:   if (!isRecord(value)) return false\r\n 1803: \r\n 1804:   const { stories, sections, members, notes, unitMass } = value\r\n 1805: \r\n 1806:   return (\r\n 1807:     isString(value.name) &&\r\n 1808:     hasShape(value.grid, { xSpans: isNumberArray, ySpans: isNumberArray }) &&\r\n 1809:     // 라벨은 없어도 되지만, 있으면 축의 본수와 맞아야 한다 — 어긋난 배열은\r\n 1810:     // 「어느 通り芯의 이름인가」를 잃은 기록이고, 그대로 두면 화면이 엉뚱한\r\n 1811:     // 축에 이름을 붙인다\r\n 1812:     hasGridLabels(value.grid) &&\r\n 1813:     // 空の stories は「階が無い案件」ではなく壊れた記録だ。製品は至る所で\r\n 1814:     // stories[0] を既定値に使う。\r\n 1815:     Array.isArray(stories) &&\r\n 1816:     stories.length > 0 &&\r\n 1817:     stories.every((story) =>\r\n 1818:       hasShape(story, { id: isString, name: isString, height: isFiniteNumber }),\r\n 1819:     ) &&\r\n 1820:     Array.isArray(sections) &&\r\n 1821:     sections.every(\r\n 1822:       (section) =>\r\n 1823:         hasShape(section, {\r\n 1824:           id: isString,\r\n 1825:           // 判別子は特別だ。ここが union の外の値だと、形は通ったまま\r\n 1826:           // 断面の枝分かれが選べず、算定の途中で落ちる。\r\n 1827:           kind: isMemberKind,\r\n 1828:           mark: isString,\r\n 1829:         }) &&\r\n 1830:         // せいも配筋の入力も種別で鍵が違う。共通の場所だけで済ませると、\r\n 1831:         // せい の欠けた断面が通って帯筋の加工寸法が NaN のまま内訳書の合計まで\r\n 1832:         // 流れ、main/hoop/stirrup の欠けた断面は generateColumnRebar 