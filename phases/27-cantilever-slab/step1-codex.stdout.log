MemberKind, PlanPlacementRole> = {\\\\n  ?? '?쇔춴??,\\\\n  鸚㎪쥈: '渦?,\\\\n  ?먬쐡鶯? '渦?,\\\\n  佯딀씮: '?쇻궎',\\\\n}\\\\n\\\\nexport interface PlanApplyOptions {\\\\n  block: PlanBlock\\\\n  storyId: string\\\\n  /**\\\\n   * ?싥굤??씠 諛붾????ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━怨?吏꾪뻾?쒕떎. 湲곕낯? false?닿퀬,\\\\n   * ?붾㈃? 嫄곕?瑜???踰?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 ??議곗슜??湲곕낯媛믪쑝濡?   * ?먮㈃ ?ъ슜?먭? 紐⑤Ⅴ???ъ씠???ㅻⅨ 痢듭씠 ?щ씪吏꾨떎\\\\n   */\\\\n  discardOtherStories?: boolean\\\\n}\\\\n\\\\nexport interface PlanApplyResult {\\\\n  project: Project\\\\n  /** 諛섏쁺??遺????*/\\\\n  applied: number\\\\n  /** 諛섏쁺?섏? 紐삵븳 遺?몄? ?ъ쑀 ???먮Ц ?? 媛숈? 遺?멸? ?щ윭 踰?嫄몃━硫??щ윭 踰?*/\\\\n  skipped: Array<{ mark: string; reason: PlanApplySkip }>\\\\n  /** ?듭㎏濡?嫄곕????ъ쑀. ?덉쑝硫?project???먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\\\\n  refusal?: PlanApplyRefusal\\\\n}\\\\n\\\\nfunction gridOf(block: PlanBlock): Grid {\\\\n  const { xGrid, yGrid } = block\\\\n  return {\\\\n    xSpans: [...xGrid.spansMm],\\\\n    ySpans: [...yGrid.spansMm],\\\\n    // ?싥굤??쓽 ?대쫫? ?꾨㈃???덈뒗 寃껋씠怨? ?닿쾬???덉뼱???똜3塋?폀Y4塋?띿쿂??    // 醫뚯슦媛 ?ㅻⅨ ??씊?ゃ궧?덈? ?곗쓽 ?ㅼ젣 諛⑺뼢怨?留욎텧 ???덈떎 (R13???좉껐 議곌굔)\\\\n    xLabels: xGrid.axes.map((axis) => axis.label),\\\\n    yLabels: yGrid.axes.map((axis) => axis.label),\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * ?ㅽ뙩留?蹂몃떎 ???쇰꺼? ?곈뇧??寃⑹옄 index??諛붽씀吏 ?딆쑝誘濡? ?대쫫留??щ씪吏? * 洹몃━?쒕? ?뚮컮?뚯뿀?ㅳ띾줈 蹂대㈃ ?ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━?쇰뒗 臾쇱쓬???댁쑀 ?놁씠 ?щ떎.\\\\n */\\\\nfunction sameGrid(left: Grid, right: Grid): boolean {\\\\n  return (\\\\n    left.xSpans.length === right.xSpans.length &&\\\\n    left.ySpans.length === right.ySpans.length &&\\\\n    left.xSpans.every((span, i) => span === right.xSpans[i]) &&\\\\n    left.ySpans.every((span, i) => span === right.ySpans[i])\\\\n  )\\\\n}\\\\n\\\\nfunction positionOf(placement: MemberPlacement) {\\\\n  return placement.role === '渦?\\\\n    ? { axis: placement.axis ?? 'X', ix: placement.ix, iy: placement.iy }\\\\n    : { ix: placement.ix, iy: placement.iy }\\\\n}\\\\n\\\\n/**\\\\n * 諛곗튂媛 寃⑹옄 ?덉쓣 媛由ы궎?붽?. 渦븐? 遺?ш? 六쀫뒗 履쎌쑝濡???移????꾩슂?섍퀬,\\\\n * ?쇻궎???먯젏 履?寃⑹옄?먯씠誘濡??묒そ?쇰줈 ??移몄뵫 ?⑥븘???쒕떎.\\\\n */\\\\nfunction withinGrid(placement: MemberPlacement, grid: Grid): boolean {\\\\n  const nx = grid.xSpans.length + 1\\\\n  const ny = grid.ySpans.length + 1\\\\n  const lastIx =\\\\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'X')\\\\n      ? nx - 2\\\\n      : nx - 1\\\\n  const lastIy =\\\\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'Y')\\\\n      ? ny - 2\\\\n      : ny - 1\\\\n\\\\n  return (\\\\n    placement.ix >= 0 &&\\\\n    placement.ix <= lastIx &&\\\\n    placement.iy >= 0 &&\\\\n    placement.iy <= lastIy\\\\n  )\\\\n}\\\\n\\\\nexport function applyFramingPlan(\\\\n  project: Project,\\\\n  { block, storyId, discardOtherStories = false }: PlanApplyOptions,\\\\n): PlanApplyResult {\\\\n  if (!project.stories.some((story) => story.id === storyId)) {\\\\n    return { project, applied: 0, skipped: [], refusal: '?롦쑋?뉐츣' }\\\\n  }\\\\n\\\\n  const grid = gridOf(block)\\\\n  const changesGrid = !sameGrid(project.grid, grid)\\\\n  const otherStoryMembers = project.members.some(\\\\n    (member) => member.storyId !== storyId,\\\\n  )\\\\n  // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽 遺?ш?\\\\n  // 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫??뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠\\\\n  // ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?대뒓 履쎌쓣 踰꾨┫吏???ъ슜?먭? ?뺥븳??  if (changesGrid && otherStoryMembers && !discardOtherStories) {\\\\n    return {\\\\n      project,\\\\n      applied: 0,\\\\n      skipped: [],\\\\n      refusal: '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\\\\n    }\\\\n  }\\\\n\\\\n  const sections = new Map<string, Section>()\\\\n  for (const section of project.sections) {\\\\n    if (!sections.has(section.mark)) sections.set(section.mark, section)\\\\n  }\\\\n\\\\n  const members: Member[] = []\\\\n  const skipped: PlanApplyResult['skipped'] = []\\\\n  for (const placement of block.placements) {\\\\n    const section = sections.get(placement.mark)\\\\n    if (!section) {\\\\n      skipped.push({ mark: placement.mark, reason: '??씊?ょ쇉?? })\\\\n      continue\\\\n    }\\\\n    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\\\\n      skipped.push({ mark: placement.mark, reason: '?ⓩ쓲葉?닪?면걬' })\\\\n      continue\\\\n    }\\\\n    if (!withinGrid(placement, grid)) {\\\\n      skipped.push({ mark: placement.mark, reason: '?쇔춴鸚? })\\\\n      continue\\\\n    }\\\\n\\\\n    members.push({\\\\n      // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎. 媛숈? ?먮━??媛숈? 寧?뤇??      // ??踰?諛섏쁺?대룄 ?섎굹濡??묓엳?꾨줉 ?먮━瑜?id???ｋ뒗??      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}`,\\\\n      kind: section.kind,\\\\n      memberClass: '翁?퐪',\\\\n      sectionId: section.id,\\\\n      storyId,\\\\n      position: positionOf(placement),\\\\n    } as Member)\\\\n  }\\\\n\\\\n  const deduped = new Map<string, Member>()\\\\n  for (const member of members) deduped.set(member.id, member)\\\\n\\\\n  return {\\\\n    project: {\\\\n      ...project,\\\\n      grid,\\\\n      // 痍⑥엯?섎뒗 痢듭? 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딆븘???섍퀬, ?꾨㈃?먯꽌\\\\n      // ?щ씪吏?遺?ш? 旅덁뻑???⑥븘 ?덉쑝硫?洹멸쾬???뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠??      members: [\\\\n        // ?듐굤??씠 諛붾뚮㈃ ?⑥? 遺?ъ쓽 index媛 ?ㅻⅨ ?먮━瑜?媛由ы궎寃??섎?濡?\\\\n        // ?숈쓽瑜?諛쏆븯???뚮뒗 ?④린吏 ?딄퀬 ?꾨? 踰꾨┛????諛섏? ??꺼 ?볥뒓??鍮꾩슫??        ...(changesGrid && discardOtherStories\\\\n          ? []\\\\n          : project.members.filter((member) => member.storyId !== storyId)),\\\\n        ...deduped.values(),\\\\n      ],\\\\n    },\\\\n    applied: deduped.size,\\\\n    skipped,\\\\n  }\\\\n}\\\\n\\\\nexport interface ElevationApplyOptions {\\\\n  candidate: ElevationCandidate\\\\n  /**\\\\n   * ?롮쓽 寃쎄퀎濡????덈꺼??踰붿쐞. index??**?꾨㈃ ?쒖꽌**(?꾩뿉???꾨옒)??\\\\n   * ????top)??理쒖긽?롮쓽 泥쒖옣, ?꾨옒 ??bottom)??理쒗븯?롮쓽 諛붾떏???쒕떎 ??   * ?묆꺀?싥긿??泥쒕떒?대굹 ?븀쨴訝뗧ク泥섎읆 ?롪? ?꾨땶 ?덈꺼? 踰붿쐞 諛뽰뿉 ?붾떎.\\\\n   */\\\\n  topLevelIndex: number\\\\n  bottomLevelIndex: number\\\\n  /** ?롫? 媛덈㈃ 遺?ш? 媛?怨녹쓣 ?껊뒗?? ?붾㈃? 嫄곕?瑜?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 */\\\\n  discardMembers?: boolean\\\\n}\\\\n\\\\nexport interface ElevationApplyResult {\\\\n  project: Project\\\\n  /** 留뚮뱺 ????*/\\\\n  applied: number\\\\n  refusal?: ElevationApplyRefusal\\\\n}\\\\n\\\\n/**\\\\n * 邕며탡?녹뿉???쎌? ?믪씠瑜?旅덁뻑???롫줈 諛섏쁺?쒕떎 (ADR-030).\\\\n *\\\\n * ?뚯뼱???덈꺼???롮쓽 寃쎄퀎?멸??띾뒗 ?뚯꽌媛 ?뺥븯吏 ?딆쑝誘濡?FL쨌GL쨌?븀쨴訝뗧ク쨌RCL?? * ?욎뿬 ?덈떎) ?ш린???ъ슜?먯쓽 ?좏깮??諛쏅뒗?? ?롮쓽 ?대쫫??吏?대궡吏 ?딄퀬 洹??롮쓽\\\\n * **諛붾떏???섎뒗 ?덈꺼???먮Ц**??洹몃?濡??대떎 ??媛숈? ?믪씠???쇰꺼???섏씠硫????? * ?④릿???ㅻЪ???뚥릎鸚?짘1FL?띻낵 ?뚦읃繹뺾L?띿씠 洹몃젃??.\\\\n */\\\\nexport function applyElevation(\\\\n  project: Project,\\\\n  {\\\\n    candidate,\\\\n    topLevelIndex,\\\\n    bottomLevelIndex,\\\\n    discardMembers = false,\\\\n  }: ElevationApplyOptions,\\\\n): ElevationApplyResult {\\\\n  const valid =\\\\n    Number.isInteger(topLevelIndex) &&\\\\n    Number.isInteger(bottomLevelIndex) &&\\\\n    topLevelIndex >= 0 &&\\\\n    bottomLevelIndex > topLevelIndex &&\\\\n    bottomLevelIndex < candidate.levels.length\\\\n  if (!valid) {\\\\n    return { project, applied: 0, refusal: '?롧칱?꿜툖閭? }\\\\n  }\\\\n\\\\n  // ?롫? 媛덈㈃ 遺?ъ쓽 storyId媛 媛由ы궎???롪? ?щ씪吏꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫?  // ?뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠 ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?ъ슜?먭? ?뺥븳??  if (project.members.length > 0 && !discardMembers) {\\\\n    return { project, applied: 0, refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖?? }\\\\n  }\\\\n\\\\n  const stories: Story[] = []\\\\n  // ?꾨㈃? ?꾩뿉???꾨옒, `Project.stories`???꾨옒?먯꽌 ?꾨떎 (columnEnds媛\\\\n  // stories[level - 1]???뚯븘???롢띾줈 ?쎈뒗??\\\\n  for (let i = bottomLevelIndex - 1; i >= topLevelIndex; i--) {\\\\n    const floor = candidate.levels[i + 1]\\\\n    const name =\\\\n      floor.labels.length > 0\\\\n        ? floor.labels.join('竊?)\\\\n        : `${bottomLevelIndex - i}`\\\\n    stories.push({\\\\n      id: `story-${bottomLevelIndex - i}`,\\\\n      name,\\\\n      height: candidate.heightsMm[i],\\\\n    })\\\\n  }\\\\n\\\\n  return {\\\\n    project: { ...project, stories, members: [] },\\\\n    applied: stories.length,\\\\n  }\\\\n}\\\\n\\\\r\\\\nimport { describe, expect, it } from 'vitest'\\\\n\\\\nimport type { Section } from '@/domain/model/member'\\\\nimport type { Project } from '@/domain/model/project'\\\\nimport { createSampleProject } from '@/domain/model/sample-project'\\\\n\\\\nimport type { TextItem, TextPage } from '../section-list/types'\\\\n\\\\nimport { applyElevation, applyFramingPlan } from './apply'\\\\nimport { parseFramingPlan } from './parse'\\\\nimport type {\\\\n  ElevationCandidate,\\\\n  PlanBlock,\\\\n  PlanGridCandidate,\\\\n} from './types'\\\\n\\\\n// ??씊? ?먯쑝濡?吏볦? ?딄퀬 ?섑뵆 旅덁뻑?먯꽌 鍮뚮┛?????먯쑝濡?吏?쇰㈃ ?ㅽ궎留덇? ?먮씪????// ???뚯뒪?몃쭔 ??紐⑥뼇?쇰줈 ?④퀬, 洹??ъ떎??vitest???뚮젮二쇱? ?딅뒗??(tsc媛 ?〓뒗??\\\\nconst sample = createSampleProject()\\\\n\\\\nfunction sectionOf(kind: Section['kind'], mark: string): Section {\\\\n  const source = sample.sections.find((section) => section.kind === kind)\\\\n  if (!source) throw new Error(`sample has no ${kind} section`)\\\\n  return { ...source, id: `sec-${mark}`, mark }\\\\n}\\\\n\\\\nconst columnSection = (mark: string) => sectionOf('??, mark)\\\\nconst girderSection = (mark: string) => sectionOf('鸚㎪쥈', mark)\\\\n\\\\nfunction h(str: string, x: number, y: number): TextItem {\\\\n  return { str, x, y, w: 0, h: 8 }\\\\n}\\\\n\\\\nfunction v(str: string, x: number, y: number): TextItem {\\\\n  return { str, x, y, w: 8, h: 0, rot: -90 }\\\\n}\\\\n\\\\nfunction framingPage(spanMm: number): TextPage {\\\\n  return {\\\\n    widthPt: 1000,\\\\n    heightPt: 1000,\\\\n    items: [\\\\n      h('X1', 0, -40),\\\\n      h('X2', 200, -40),\\\\n      h(String(spanMm), 100, -20),\\\\n      h('Y1', -40, 0),\\\\n      h('Y2', -40, 200),\\\\n      v(String(spanMm), -20, 100),\\\\n    ],\\\\n  }\\\\n}\\\\n\\\\nfunction project(overrides: Partial<Project> = {}): Project {\\\\n  return {\\\\n    schemaVersion: 11,\\\\n    name: 'test',\\\\n    grid: { xSpans: [6000], ySpans: [6000] },\\\\n    stories: [{ id: 'story-1', name: '1F', height: 4000 }],\\\\n    sections: [],\\\\n    members: [],\\\\n    ...overrides,\\\\n  }\\\\n}\\\\n\\\\nconst xGrid: PlanGridCandidate = {\\\\n  direction: 'X',\\\\n  axes: [\\\\n    { label: 'X1', positionPt: 0 },\\\\n    { label: 'X2', positionPt: 200 },\\\\n    { label: 'X3', positionPt: 400 },\\\\n  ],\\\\n  spansMm: [7000, 7000],\\\\n  scalePtPerMm: 200 / 7000,\\\\n  totalConfirmed: false,\\\\n}\\\\n\\\\nconst yGrid: PlanGridCandidate = {\\\\n  direction: 'Y',\\\\n  axes: [\\\\n    { label: 'Y1', positionPt: 0 },\\\\n    { label: 'Y2', positionPt: 200 },\\\\n  ],\\\\n  spansMm: [5000],\\\\n  scalePtPerMm: 200 / 5000,\\\\n  totalConfirmed: false,\\\\n}\\\\n\\\\nfunction block(overrides: Partial<PlanBlock> = {}): PlanBlock {\\\\n  return {\\\\n    xGrid,\\\\n    yGrid,\\\\n    xAxes: xGrid.axes,\\\\n    yAxes: yGrid.axes,\\\\n    placements: [],\\\\n    unplacedMarks: [],\\\\n    ...overrides,\\\\n  }\\\\n}\\\\n\\\\ndescribe('applyFramingPlan', () => {\\\\n  it('?щ윭 鴉뤷쎋 以???踰덉㎏ 釉붾줉? ??踰덉㎏ ?꾨㈃???싥굤??쓣 痍⑥엯?쒕떎', () => {\\\\n    const plans = [framingPage(6000), framingPage(8000)].map(parseFramingPlan)\\\\n    const blocks = plans.flatMap((plan) => plan.blocks)\\\\n    if (!blocks[1]) {\\\\n      throw new Error('synthetic framing plans were not parsed')\\\\n    }\\\\n\\\\n    const result = applyFramingPlan(project(), {\\\\n      block: blocks[1],\\\\n      storyId: 'story-1',\\\\n    })\\\\n\\\\n    expect(result.project.grid.xSpans).toEqual([8000])\\\\n    expect(result.project.grid.ySpans).toEqual([8000])\\\\n    expect(result.refusal).toBeUndefined()\\\\n    expect(result.skipped).toEqual([])\\\\n  })\\\\n\\\\n  it('?싥굤??쓣 ?꾨㈃???ㅽ뙩?쇰줈 諛붽씔??, () => {\\\\n    const result = applyFramingPlan(project(), {\\\\n      block: block(),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.grid).toEqual({\\\\n      xSpans: [7000, 7000],\\\\n      ySpans: [5000],\\\\n      xLabels: ['X1', 'X2', 'X3'],\\\\n      yLabels: ['Y1', 'Y2'],\\\\n    })\\\\n    expect(result.refusal).toBeUndefined()\\\\n  })\\\\n\\\\n  it('?싥굤??쓽 ?대쫫???꾨㈃?먯꽌 ?쎌? ?먮Ц 洹몃?濡??ｋ뒗??, () => {\\\\n    // ?닿쾬??R13(塋?깿 醫뚯슦 鍮꾨?移????좉껐 議곌굔?대떎 ???대쫫???덉뼱???꾨㈃??    // ?똜3塋?폀Y4塋?띿쓣 ?곗쓽 ?ㅼ젣 諛⑺뼢怨?留욎텧 ???덈떎\\\\n    const result = applyFramingPlan(project(), {\\\\n      block: block(),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\\\\n    expect(result.project.grid.yLabels).toEqual(['Y1', 'Y2'])\\\\n  })\\\\n\\\\n  it('?대쫫留??ㅻⅨ 洹몃━?쒕뒗 ?뚮컮?뚯뿀?ㅳ띾줈 蹂댁? ?딅뒗??, () => {\\\\n    // ?쇰꺼? ?곈뇧??寃⑹옄 index??諛붽씀吏 ?딅뒗?????대쫫 ?뚮Ц???ㅻⅨ 痢듭쓣 踰꾨━?쇰뒗\\\\n    // 臾쇱쓬???⑤㈃ ?ъ슜?먮뒗 ?댁쑀瑜??????녿떎\\\\n    const base = project({\\\\n      grid: { xSpans: [7000, 7000], ySpans: [5000] },\\\\n      sections: [columnSection('C1')],\\\\n      members: [\\\\n        {\\\\n          id: 'm1',\\\\n          kind: '??,\\\\n          memberClass: '翁?퐪',\\\\n          sectionId: 'sec-C1',\\\\n          storyId: 'story-2',\\\\n          position: { ix: 1, iy: 1 },\\\\n        },\\\\n      ],\\\\n      stories: [\\\\n        { id: 'story-1', name: '1F', height: 4000 },\\\\n        { id: 'story-2', name: '2F', height: 4000 },\\\\n      ],\\\\n    })\\\\n\\\\n    const result = applyFramingPlan(base, {\\\\n      block: block(),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.refusal).toBeUndefined()\\\\n    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\\\\n    expect(result.project.members).toHaveLength(1)\\\\n  })\\\\n\\\\n  it('?ㅻⅨ 痢듭뿉 遺?ш? ?덈뒗???싥굤??씠 諛붾뚮㈃ ?듭㎏濡?嫄곕??쒕떎', () => {\\\\n    // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽\\\\n    // 遺?ш? 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. ???쒗뭹??紐?寃щ뵒???ㅽ뙣??    const existing = project({\\\\n      sections: [columnSection('C1')],\\\\n      members: [\\\\n        {\\\\n          id: 'm1',\\\\n          kind: '??,\\\\n          memberClass: '翁?퐪',\\\\n          sectionId: 'sec-C1',\\\\n          storyId: 'story-2',\\\\n          position: { ix: 1, iy: 1 },\\\\n        },\\\\n      ],\\\\n      stories: [\\\\n        { id: 'story-1', name: '1F', height: 4000 },\\\\n        { id: 'story-2', name: '2F', height: 4000 },\\\\n      ],\\\\n    })\\\\n\\\\n    const result = applyFramingPlan(existing, {\\\\n      block: block(),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.refusal).toBe('餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??)\\\\n    expect(result.project).toBe(existing)\\\\n  })\\\\n\\\\n  it('痍⑥엯?섎뒗 痢듭쓽 遺?щ뒗 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딅뒗??, () => {\\\\n    const base = project({ sections: [columnSection('C1')] })\\\\n    const options = {\\\\n      block: block({\\\\n        placements: [{ mark: 'C1', role: '?쇔춴?? as const, ix: 1, iy: 1 }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    }\\\\n\\\\n    const once = applyFramingPlan(base, options)\\\\n    const twice = applyFramingPlan(once.project, options)\\\\n    expect(once.project.members).toHaveLength(1)\\\\n    expect(twice.project.members).toHaveLength(1)\\\\n    expect(once.applied).toBe(1)\\\\n  })\\\\n\\\\n  it('?쇔춴?뱀쓽 ?깅? ColumnPosition?쇰줈 ?ｋ뒗??, () => {\\\\n    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\\\\n      block: block({\\\\n        placements: [{ mark: 'C1', role: '?쇔춴??, ix: 2, iy: 1 }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.members).toEqual([\\\\n      {\\\\n        id: 'story-1-C1-2-1',\\\\n        kind: '??,\\\\n        memberClass: '翁?퐪',\\\\n        sectionId: 'sec-C1',\\\\n        storyId: 'story-1',\\\\n        position: { ix: 2, iy: 1 },\\\\n      },\\\\n    ])\\\\n  })\\\\n\\\\n  it('渦븐쓽 鸚㎪쥈瑜?GirderPosition?쇰줈 ?ｋ뒗????axis瑜?洹몃?濡???릿??, () => {\\\\n    const result = applyFramingPlan(project({ sections: [girderSection('G1')] }), {\\\\n      block: block({\\\\n        placements: [{ mark: 'G1', role: '渦?, ix: 0, iy: 1, axis: 'X' }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.members[0]?.position).toEqual({\\\\n      axis: 'X',\\\\n      ix: 0,\\\\n      iy: 1,\\\\n    })\\\\n  })\\\\n\\\\n  it('??씊訝誤㏃뿉 ?녿뒗 寧?뤇? ?ｌ? ?딄퀬 ?ъ쑀? ?④퍡 ?④릿??, () => {\\\\n    const result = applyFramingPlan(project(), {\\\\n      block: block({\\\\n        placements: [{ mark: 'C9', role: '?쇔춴??, ix: 0, iy: 0 }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.members).toEqual([])\\\\n    expect(result.skipped).toEqual([{ mark: 'C9', reason: '??씊?ょ쇉?? }])\\\\n  })\\\\n\\\\n  it('葉?닪怨??먮━媛 ?닿툔?섎㈃ ?ｌ? ?딅뒗?????깅? 渦븐뿉 ?볦? ?딅뒗??, () => {\\\\n    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\\\\n      block: block({\\\\n        placements: [{ mark: 'C1', role: '渦?, ix: 0, iy: 0, axis: 'X' }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.members).toEqual([])\\\\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '?ⓩ쓲葉?닪?면걬' }])\\\\n  })\\\\n\\\\n  it('寃⑹옄 諛뽰쓣 媛由ы궎??諛곗튂???ｌ? ?딅뒗??, () => {\\\\n    // ?꾨㈃???싥굤???섏? 痍⑥엯?섎뒗 洹몃━?쒓? ?닿툔??寃쎌슦 ??吏?대궡吏 ?딅뒗??    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\\\\n      block: block({\\\\n        placements: [{ mark: 'C1', role: '?쇔춴??, ix: 3, iy: 0 }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.project.members).toEqual([])\\\\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '?쇔춴鸚? }])\\\\n  })\\\\n\\\\n  it('?녿뒗 痢듭쓣 媛由ы궎硫??듭㎏濡?嫄곕??쒕떎', () => {\\\\n    const base = project()\\\\n    const result = applyFramingPlan(base, {\\\\n      block: block(),\\\\n      storyId: 'story-9',\\\\n    })\\\\n    expect(result.refusal).toBe('?롦쑋?뉐츣')\\\\n    expect(result.project).toBe(base)\\\\n  })\\\\n})\\\\n\\\\ndescribe('applyFramingPlan ???ㅻⅨ 痢듭쓣 踰꾨━???숈쓽', () => {\\\\n  const existing = () =>\\\\n    project({\\\\n      sections: [columnSection('C1')],\\\\n      members: [\\\\n        {\\\\n          id: 'm1',\\\\n          kind: '??,\\\\n          memberClass: '翁?퐪',\\\\n          sectionId: 'sec-C1',\\\\n          storyId: 'story-2',\\\\n          position: { ix: 1, iy: 1 },\\\\n        },\\\\n      ],\\\\n      stories: [\\\\n        { id: 'story-1', name: '1F', height: 4000 },\\\\n        { id: 'story-2', name: '2F', height: 4000 },\\\\n      ],\\\\n    })\\\\n\\\\n  it('?숈쓽?섎㈃ ?ㅻⅨ 痢?遺?щ? ?④린吏 ?딄퀬 ?듭㎏濡?踰꾨┛??, () => {\\\\n    const result = applyFramingPlan(existing(), {\\\\n      block: block({\\\\n        placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\\\\n      }),\\\\n      storyId: 'story-1',\\\\n      discardOtherStories: true,\\\\n    })\\\\n    expect(result.refusal).toBeUndefined()\\\\n    // 諛섏? ??꺼 ?볥뒓??鍮꾩슫?????④린硫?index媛 ?ㅻⅨ ?먮━瑜?媛由ы궓??    expect(result.project.members.map((member) => member.storyId)).toEqual([\\\\n      'story-1',\\\\n    ])\\\\n  })\\\\n\\\\n  it('?싥굤??씠 洹몃?濡쒕㈃ ?숈쓽 ?놁씠???ㅻⅨ 痢듭쓣 嫄대뱶由ъ? ?딅뒗??, () => {\\\\n    const base = existing()\\\\n    const result = applyFramingPlan(base, {\\\\n      block: block({\\\\n        xGrid: { ...xGrid, spansMm: base.grid.xSpans },\\\\n        yGrid: { ...yGrid, spansMm: base.grid.ySpans },\\\\n      }),\\\\n      storyId: 'story-1',\\\\n    })\\\\n    expect(result.refusal).toBeUndefined()\\\\n    expect(result.project.members).toHaveLength(1)\\\\n  })\\\\n})\\\\n\\\\ndescribe('applyElevation', () => {\\\\n  // ?꾨㈃ ?쒖꽌???꾩뿉???꾨옒?? ?ㅻЪ yokohama p8????紐⑥뼇?대떎 ??  // 留??꾨뒗 ?쇰꺼???녿뒗 ?묆꺀?싥긿??泥쒕떒?닿퀬, 洹??꾨옒濡?RCL쨌2FL쨌1FL쨌?븀쨴訝뗧ク?대떎.\\\\n  const candidate: ElevationCandidate = {\\\\n    titles: ['bY1?싥굤邕며탡??/100'],\\\\n    levels: [\\\\n      { labels: [], positionPt: 159 },\\\\n      { labels: ['訝?ㄾ汝웂CL(麗답툔)'], positionPt: 199 },\\\\n      { labels: ['2FL'], positionPt: 315 },\\\\n      { labels: ['訝?ㄾ汝?FL', '?뷸틬GL'], positionPt: 442 },\\\\n      { labels: ['?븀쨴訝뗧ク'], positionPt: 518 },\\\\n    ],\\\\n    heightsMm: [1400, 4100, 4480, 2690],\\\\n    scalePtPerMm: 0.02835,\\\\n  }\\\\n\\\\n  it('怨좊Ⅸ 踰붿쐞??媛꾧꺽留??롪? ?섍퀬, ?꾨옒?먯꽌 ?꾨줈 ?볦씤??, () => {\\\\n    // 1FL(3)?먯꽌 RCL(1)源뚯? ??1??4480)? 2??4100). ?묆꺀?싥긿??1400)?\\\\n    // ?븀쨴(2690)???롪? ?꾨땲誘濡?踰붿쐞 諛뽰씠??    const result = applyElevation(project(), {\\\\n      candidate,\\\\n      topLevelIndex: 1,\\\\n      bottomLevelIndex: 3,\\\\n    })\\\\n    expect(result.refusal).toBeUndefined()\\\\n    expect(result.project.stories.map((story) => story.height)).toEqual([\\\\n      4480, 4100,\\\\n    ])\\\\n  })\\\\n\\\\n  it('?롮쓽 ?대쫫? 洹??롮쓽 諛붾떏???섎뒗 ?덈꺼???먮Ц?대떎', () => {\\\\n    const result = applyElevation(project(), {\\\\n      candidate,\\\\n      topLevelIndex: 1,\\\\n      bottomLevelIndex: 3,\\\\n    })\\\\n    // 媛숈? ?믪씠???쇰꺼???섏씠硫??????④릿?????섎굹瑜?怨좊Ⅴ吏 ?딅뒗??    expect(result.project.stories.map((story) => story.name)).toEqual([\\\\n      '訝?ㄾ汝?FL竊뤷읃繹뺾L',\\\\n      '2FL',\\\\n    ])\\\\n  })\\\\n\\\\n  it('?쇰꺼???녿뒗 ?덈꺼??諛붾떏?대㈃ ?대쫫??吏?대궡吏 ?딄퀬 踰덊샇濡??붾떎', () => {\\\\n    const result = applyElevation(project(), {\\\\n      candidate,\\\\n      topLevelIndex: 0,\\\\n      bottomLevelIndex: 1,\\\\n    })\\\\n    expect(result.project.stories.map((story) => story.name)).toEqual([\\\\n      '訝?ㄾ汝웂CL(麗답툔)',\\\\n    ])\\\\n  })\\\\n\\\\n  it('踰붿쐞媛 ??移몃룄 ?놁쑝硫?嫄곕??쒕떎', () => {\\\\n    const base = project()\\\\n    const result = applyElevation(base, {\\\\n      candidate,\\\\n      topLevelIndex: 2,\\\\n      bottomLevelIndex: 2,\\\\n    })\\\\n    expect(result.refusal).toBe('?롧칱?꿜툖閭?)\\\\n    expect(result.project).toBe(base)\\\\n  })\\\\n\\\\n  it('遺?ш? ?덉쑝硫??듭㎏濡?嫄곕??쒕떎 ???롫? 媛덈㈃ 遺?ш? 媛?怨녹쓣 ?껊뒗??, () => {\\\\n    const base = project({\\\\n      sections: [columnSection('C1')],\\\\n      members: [\\\\n        {\\\\n          id: 'm1',\\\\n          kind: '??,\\\\n          memberClass: '翁?퐪',\\\\n          sectionId: 'sec-C1',\\\\n          storyId: 'story-1',\\\\n          position: { ix: 0, iy: 0 },\\\\n        },\\\\n      ],\\\\n    })\\\\n    const result = applyElevation(base, {\\\\n      candidate,\\\\n      topLevelIndex: 1,\\\\n      bottomLevelIndex: 3,\\\\n    })\\\\n    expect(result.refusal).toBe('?ⓩ쓲?귙굤?롧쉰?쎽툖??)\\\\n    expect(result.project).toBe(base)\\\\n  })\\\\n\\\\n  it('?숈쓽?섎㈃ 遺?щ? 踰꾨━怨??롫? 媛덉븘 ?쇱슫??, () => {\\\\n    const base = project({\\\\n      sections: [columnSection('C1')],\\\\n      members: [\\\\n        {\\\\n          id: 'm1',\\\\n          kind: '??,\\\\n          memberClass: '翁?퐪',\\\\n          sectionId: 'sec-C1',\\\\n          storyId: 'story-1',\\\\n          position: { ix: 0, iy: 0 },\\\\n        },\\\\n      ],\\\\n    })\\\\n    const result = applyElevation(base, {\\\\n      candidate,\\\\n      topLevelIndex: 1,\\\\n      bottomLevelIndex: 3,\\\\n      discardMembers: true,\\\\n    })\\\\n    expect(result.refusal).toBeUndefined()\\\\n    expect(result.project.members).toEqual([])\\\\n    expect(result.project.stories).toHaveLength(2)\\\\n  })\\\\n})\\\\n\\\\r\\\\n{\\\\r\\\\n  \\\\\\\"project\\\\\\\": \\\\\\\"Kijun\\\\\\\",\\\\r\\\\n  \\\\\\\"phase\\\\\\\": \\\\\\\"10-plan-import-fixes\\\\\\\",\\\\r\\\\n  \\\\\\\"steps\\\\\\\": [\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"step\\\\\\\": 0,\\\\r\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"block-owns-grid\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"completed\\\\\\\",\\\\r\\\\n      \\\\\\\"started_at\\\\\\\": \\\\\\\"2026-08-24T01:32:28+0900\\\\\\\",\\\\r\\\\n      \\\\\\\"summary\\\\\\\": \\\\\\\"PlanBlock??吏앹??댁쭊 X쨌Y ?싥굤??쓣 ?뚯쑀?섍퀬 痍⑥엯쨌?꾨낫 UI媛 釉붾줉蹂?洹몃━?쒕쭔 ?ъ슜?섎룄濡?怨좎퀜 ?ㅼ쨷 鴉뤷쎋 ?ㅼ랬?낆쓣 李⑤떒?덈떎.\\\\\\\",\\\\r\\\\n      \\\\\\\"completed_at\\\\\\\": \\\\\\\"2026-08-24T01:42:50+0900\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"step\\\\\\\": 1,\\\\r\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"girder-axis-id\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\r\\\\n      \\\\\\\"started_at\\\\\\\": \\\\\\\"2026-08-24T01:42:51+0900\\\\\\\"\\\\r\\\\n    }\\\\r\\\\n  ],\\\\r\\\\n  \\\\\\\"created_at\\\\\\\": \\\\\\\"2026-08-24T01:45:00+0900\\\\\\\"\\\\r\\\\n}\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"실제 HEAD는 Step 0 커밋 위이고, worktree의 유일한 기존 변경은 하네스가 Step 1을 `pending`으로 시작 기록한 `index.json`입니다. 이 변경은 보존합니다. 관련 리뷰 근거도 `axis` 누락으로 X/Y 大梁 중 하나가 `Map`에서 덮이는 재현과 `as Member` 제거 시 typecheck 통과를 확인하고 있습니다. 이제 테스트 두 개만 먼저 추가해 현재 구현의 실패를 확인하겠습니다.\\\"}}\\n{\\\"type\\\":\\\"item.updated\\\",\\\"item\\\":{\\\"id\\\":\\\"item_3\\\",\\\"type\\\":\\\"todo_list\\\",\\\"items\\\":[{\\\"text\\\":\\\"실제 HEAD·worktree와 Step 0 결과 및 관련 코드/근거 확인\\\",\\\"completed\\\":true},{\\\"text\\\":\\\"회귀·중복 접기 테스트를 먼저 추가하고 현재 구현에서 실패 확인\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"id에 axis 반영 및 죽은 캐스트 제거\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"대상 테스트와 axis 제거 감도 확인\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"전체 AC를 순서대로 실행하고 e2e 검증\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"phase 상태 갱신, 변경 검토 및 conventional commit\\\",\\\"completed\\\":false}]}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\\\\n$OutputEncoding = [System.Text.Encoding]::UTF8\\\\ngit diff -- phases/10-plan-import-fixes/index.json\\\\nGet-Content -Encoding utf8 src/lib/import/framing-plan/apply.ts | Select-Object -Skip 135 -First 45\\\\nGet-Content -Encoding utf8 src/lib/import/framing-plan/apply.test.ts | Select-Object -Skip 130 -First 105\\\\nGet-Content -Encoding utf8 src/lib/import/framing-plan/parse.ts | Select-Object -Skip 420 -First 42'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\\\\n$OutputEncoding = [System.Text.Encoding]::UTF8\\\\ngit diff -- phases/10-plan-import-fixes/index.json\\\\nGet-Content -Encoding utf8 src/lib/import/framing-plan/apply.ts | Select-Object -Skip 135 -First 45\\\\nGet-Content -Encoding utf8 src/lib/import/framing-plan/apply.test.ts | Select-Object -Skip 130 -First 105\\\\nGet-Content -Encoding utf8 src/lib/import/framing-plan/parse.ts | Select-Object -Skip 420 -First 42'\\\",\\\"aggregated_output\\\":\\\"diff --git a/phases/10-plan-import-fixes/index.json b/phases/10-plan-import-fixes/index.json\\\\nindex 59b56b9..cc9f825 100644\\\\n--- a/phases/10-plan-import-fixes/index.json\\\\n+++ b/phases/10-plan-import-fixes/index.json\\\\n@@ -13,7 +13,8 @@\\\\n     {\\\\n       \\\\\\\"step\\\\\\\": 1,\\\\n       \\\\\\\"name\\\\\\\": \\\\\\\"girder-axis-id\\\\\\\",\\\\n-      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\"\\\\n+      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\n+      \\\\\\\"started_at\\\\\\\": \\\\\\\"2026-08-24T01:42:51+0900\\\\\\\"\\\\n     }\\\\n   ],\\\\n   \\\\\\\"created_at\\\\\\\": \\\\\\\"2026-08-24T01:45:00+0900\\\\\\\"\\\\n  const skipped: PlanApplyResult['skipped'] = []\\\\r\\\\n  for (const placement of block.placements) {\\\\r\\\\n    const section = sections.get(placement.mark)\\\\r\\\\n    if (!section) {\\\\r\\\\n      skipped.push({ mark: placement.mark, reason: '断面未登録' })\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\\\\r\\\\n      skipped.push({ mark: placement.mark, reason: '部材種別相違' })\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n    if (!withinGrid(placement, grid)) {\\\\r\\\\n      skipped.push({ mark: placement.mark, reason: '格子外' })\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    members.push({\\\\r\\\\n      // id는 사람이 읽는 값이 아니라 충돌만 피하면 된다. 같은 자리에 같은 符号을\\\\r\\\\n      // 두 번 반영해도 하나로 접히도록 자리를 id에 넣는다\\\\r\\\\n      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}`,\\\\r\\\\n      kind: section.kind,\\\\r\\\\n      memberClass: '躯体',\\\\r\\\\n      sectionId: section.id,\\\\r\\\\n      storyId,\\\\r\\\\n      position: positionOf(placement),\\\\r\\\\n    } as Member)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const deduped = new Map<string, Member>()\\\\r\\\\n  for (const member of members) deduped.set(member.id, member)\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    project: {\\\\r\\\\n      ...project,\\\\r\\\\n      grid,\\\\r\\\\n      // 취입하는 층은 갈아 끼운다 — 두 번 눌러도 겹치지 않아야 하고, 도면에서\\\\r\\\\n      // 사라진 부재가 案件에 남아 있으면 그것도 「틀린 채로 완성된 것」이다\\\\r\\\\n      members: [\\\\r\\\\n        // 통り芯이 바뀌면 남은 부재의 index가 다른 자리를 가리키게 되므로,\\\\r\\\\n        // 동의를 받았을 때는 남기지 않고 전부 버린다 — 반쯤 옮겨 놓느니 비운다\\\\r\\\\n        ...(changesGrid && discardOtherStories\\\\r\\\\n          ? []\\\\r\\\\n          : project.members.filter((member) => member.storyId !== storyId)),\\\\r\\\\n        ...deduped.values(),\\\\r\\\\n      ],\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('通り芯의 이름을 도면에서 읽은 원문 그대로 싣는다', () => {\\\\r\\\\n    // 이것이 R13(端部 좌우 비대칭)의 선결 조건이다 — 이름이 있어야 도면의\\\\r\\\\n    // 「Y3端／Y4端」을 런의 실제 방향과 맞출 수 있다\\\\r\\\\n    const result = applyFramingPlan(project(), {\\\\r\\\\n      block: block(),\\\\r\\\\n      storyId: 'story-1',\\\\r\\\\n    })\\\\r\\\\n    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\\\\r\\\\n    expect(result.project.grid.yLabels).toEqual(['Y1', 'Y2'])\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('이름만 다른 그리드는 「바뀌었다」로 보지 않는다', () => {\\\\r\\\\n    // 라벨은 数量도 격자 index도 바꾸지 않는다 — 이름 때문에 다른 층을 버리라는\\\\r\\\\n    // 물음이 뜨면 사용자는 이유를 알 수 없다\\\\r\\\\n    const base = project({\\\\r\\\\n      grid: { xSpans: [7000, 7000], ySpans: [5000] },\\\\r\\\\n      sections: [columnSection('C1')],\\\\r\\\\n      members: [\\\\r\\\\n        {\\\\r\\\\n          id: 'm1',\\\\r\\\\n          kind: '柱',\\\\r\\\\n          memberClass: '躯体',\\\\r\\\\n          sectionId: 'sec-C1',\\\\r\\\\n          storyId: 'story-2',\\\\r\\\\n          position: { ix: 1, iy: 1 },\\\\r\\\\n        },\\\\r\\\\n      ],\\\\r\\\\n      stories: [\\\\r\\\\n        { id: 'story-1', name: '1F', height: 4000 },\\\\r\\\\n        { id: 'story-2', name: '2F', height: 4000 },\\\\r\\\\n      ],\\\\r\\\\n    })\\\\r\\\\n\\\\r\\\\n    const result = applyFramingPlan(base, {\\\\r\\\\n      block: block(),\\\\r\\\\n      storyId: 'story-1',\\\\r\\\\n    })\\\\r\\\\n    expect(result.refusal).toBeUndefined()\\\\r\\\\n    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\\\\r\\\\n    expect(result.project.members).toHaveLength(1)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('다른 층에 부재가 있는데 通り芯이 바뀌면 통째로 거부한다', () => {\\\\r\\\\n    // 격자 index는 스팬 배열에 매여 있다 — 스팬을 바꾸면 손대지 않은 층의\\\\r\\\\n    // 부재가 조용히 다른 자리로 옮겨간다. 이 제품이 못 견디는 실패다\\\\r\\\\n    const existing = project({\\\\r\\\\n      sections: [columnSection('C1')],\\\\r\\\\n      members: [\\\\r\\\\n        {\\\\r\\\\n          id: 'm1',\\\\r\\\\n          kind: '柱',\\\\r\\\\n          memberClass: '躯体',\\\\r\\\\n          sectionId: 'sec-C1',\\\\r\\\\n          storyId: 'story-2',\\\\r\\\\n          position: { ix: 1, iy: 1 },\\\\r\\\\n        },\\\\r\\\\n      ],\\\\r\\\\n      stories: [\\\\r\\\\n        { id: 'story-1', name: '1F', height: 4000 },\\\\r\\\\n        { id: 'story-2', name: '2F', height: 4000 },\\\\r\\\\n      ],\\\\r\\\\n    })\\\\r\\\\n\\\\r\\\\n    const result = applyFramingPlan(existing, {\\\\r\\\\n      block: block(),\\\\r\\\\n      storyId: 'story-1',\\\\r\\\\n    })\\\\r\\\\n    expect(result.refusal).toBe('他階部材あり通り芯変更不可')\\\\r\\\\n    expect(result.project).toBe(existing)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('취입하는 층의 부재는 갈아 끼운다 — 두 번 눌러도 겹치지 않는다', () => {\\\\r\\\\n    const base = project({ sections: [columnSection('C1')] })\\\\r\\\\n    const options = {\\\\r\\\\n      block: block({\\\\r\\\\n        placements: [{ mark: 'C1', role: '格子点' as const, ix: 1, iy: 1 }],\\\\r\\\\n      }),\\\\r\\\\n      storyId: 'story-1',\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    const once = applyFramingPlan(base, options)\\\\r\\\\n    const twice = applyFramingPlan(once.project, options)\\\\r\\\\n    expect(once.project.members).toHaveLength(1)\\\\r\\\\n    expect(twice.project.members).toHaveLength(1)\\\\r\\\\n    expect(once.applied).toBe(1)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('格子点의 柱를 ColumnPosition으로 넣는다', () => {\\\\r\\\\n    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\\\\r\\\\n      block: block({\\\\r\\\\n        placements: [{ mark: 'C1', role: '格子点', ix: 2, iy: 1 }],\\\\r\\\\n      }),\\\\r\\\\n      storyId: 'story-1',\\\\r\\\\n    })\\\\r\\\\n    expect(result.project.members).toEqual([\\\\r\\\\n      {\\\\r\\\\n        id: 'story-1-C1-2-1',\\\\r\\\\n        kind: '柱',\\\\r\\\\n        memberClass: '躯体',\\\\r\\\\n        sectionId: 'sec-C1',\\\\r\\\\n        storyId: 'story-1',\\\\r\\\\n        position: { ix: 2, iy: 1 },\\\\r\\\\n      },\\\\r\\\\n  let best = -1\\\\r\\\\n  let bestDistance = Number.POSITIVE_INFINITY\\\\r\\\\n  for (let i = 0; i < targets.length; i++) {\\\\r\\\\n    const distance = Math.abs(targets[i] - value)\\\\r\\\\n    if (distance < bestDistance) {\\\\r\\\\n      best = i\\\\r\\\\n      bestDistance = distance\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n  if (best < 0 || bestDistance > limit) return undefined\\\\r\\\\n  return { index: best >> 1, onNode: best % 2 === 0 }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction placementFor(\\\\r\\\\n  mark: string,\\\\r\\\\n  x: Snap,\\\\r\\\\n  y: Snap,\\\\r\\\\n): MemberPlacement | undefined {\\\\r\\\\n  if (x.onNode && y.onNode) {\\\\r\\\\n    return { mark, role: '格子点', ix: x.index, iy: y.index }\\\\r\\\\n  }\\\\r\\\\n  if (!x.onNode && y.onNode) {\\\\r\\\\n    return { mark, role: '辺', ix: x.index, iy: y.index, axis: 'X' }\\\\r\\\\n  }\\\\r\\\\n  if (x.onNode && !y.onNode) {\\\\r\\\\n    return { mark, role: '辺', ix: x.index, iy: y.index, axis: 'Y' }\\\\r\\\\n  }\\\\r\\\\n  return 