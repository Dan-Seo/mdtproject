{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'\n\"'$lines = Get-Content -LiteralPath src/domain/model/project.ts -Encoding utf8\nfor ($i=100; $i -lt 250; $i++) { '\"'{0,5}: {1}' -f (\"'$i+1), $lines[$i] }\nfor ($i=360; $i -lt 510; $i++) { '\"'{0,5}: {1}' -f (\"'$i+1), $lines[$i] }\nfor ($i=885; $i -lt 1015; $i++) { '\"'{0,5}: {1}' -f (\"'$i+1), $lines[$i] }'","aggregated_output":"  101:   schemaVersion: number\r\n  102:   name: string\r\n  103:   grid: Grid\r\n  104:   stories: Story[]\r\n  105:   sections: Section[]\r\n  106:   members: Member[]\r\n  107:   /** 내역서 備考. QuantityLine.id를 키로 쓴다. 값이 없는 행은 키 자체가 없다. */\r\n  108:   notes?: Record<string, string>\r\n  109:   /**\r\n  110:    * 径별 単位質量 (kg/m) — 利用者入力. 미입력 径은 키가 없다.\r\n  111:    * 규준이 JIS에 위임한 값이라 룰팩이 아니라 프로젝트가 들고 있다.\r\n  112:    */\r\n  113:   unitMass?: Partial<Record<ShearBarSize, number>>\r\n  114: }\r\n  115: \r\n  116: export function gridPointCount(grid: Grid): { nx: number; ny: number } {\r\n  117:   return {\r\n  118:     nx: grid.xSpans.length + 1,\r\n  119:     ny: grid.ySpans.length + 1,\r\n  120:   }\r\n  121: }\r\n  122: \r\n  123: export function gridPoint(\r\n  124:   grid: Grid,\r\n  125:   ix: number,\r\n  126:   iy: number,\r\n  127: ): { x: number; y: number } {\r\n  128:   const { nx, ny } = gridPointCount(grid)\r\n  129: \r\n  130:   if (\r\n  131:     !Number.isInteger(ix) ||\r\n  132:     !Number.isInteger(iy) ||\r\n  133:     ix < 0 ||\r\n  134:     ix >= nx ||\r\n  135:     iy < 0 ||\r\n  136:     iy >= ny\r\n  137:   ) {\r\n  138:     throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\r\n  139:   }\r\n  140: \r\n  141:   return {\r\n  142:     x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\r\n  143:     y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\r\n  144:   }\r\n  145: }\r\n  146: \r\n  147: /**\r\n  148:  * storyId는 \"1F\" 같은 letter+digit 라벨이라 룰팩 상수(D25 등)와 값의\r\n  149:  * 모양만으로 구분되지 않는다 — telemetry.ts의 스크러버는 letter+digit\r\n  150:  * 토큰을 통째로 남기므로, 그냥 보간하면 階 라벨이 그대로 새어 나간다(9차\r\n  151:  * 리뷰 critical). JSON 블록으로 감싸면 스크러버의 `{...}` 규칙에 걸린다.\r\n  152:  * 이 포맷을 함수 하나로 고정해 다음 호출부가 규약을 손으로 다시 베끼지\r\n  153:  * 않게 한다(9차 리뷰 minor).\r\n  154:  */\r\n  155: export function storyNotFound(storyId: string): Error {\r\n  156:   return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\r\n  157: }\r\n  158: \r\n  159: /** 층 바닥의 누적 표고(mm). stories 배열 순서대로 아래층 height를 누적한다. */\r\n  160: export function storyElevation(stories: Story[], storyId: string): number {\r\n  161:   const index = stories.findIndex(({ id }) => id === storyId)\r\n  162: \r\n  163:   if (index < 0) {\r\n  164:     throw storyNotFound(storyId)\r\n  165:   }\r\n  166: \r\n  167:   return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\r\n  168: }\r\n  169: \r\n  170: export function findSection(project: Project, sectionId: string): Section {\r\n  171:   const section = project.sections.find(({ id }) => id === sectionId)\r\n  172: \r\n  173:   if (!section) {\r\n  174:     throw new Error(`Section not found: ${sectionId}`)\r\n  175:   }\r\n  176: \r\n  177:   return section\r\n  178: }\r\n  179: \r\n  180: export function memberGroupKey(project: Project, member: Member): string {\r\n  181:   const story = project.stories.find(({ id }) => id === member.storyId)\r\n  182:   if (!story) {\r\n  183:     throw storyNotFound(member.storyId)\r\n  184:   }\r\n  185: \r\n  186:   const section = findSection(project, member.sectionId)\r\n  187:   if (section.kind !== member.kind) {\r\n  188:     throw new Error(\r\n  189:       `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\r\n  190:     )\r\n  191:   }\r\n  192: \r\n  193:   const memberCode = MEMBER_GROUP_CODE[member.kind]\r\n  194:   return `${story.name}|${memberCode}|${section.mark}`\r\n  195: }\r\n  196: \r\n  197: /** 内訳書のグループ鍵に使う部材コード。符号(mark)と階の間に挟まる一文字。 */\r\n  198: const MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\r\n  199:   柱: 'C',\r\n  200:   大梁: 'G',\r\n  201:   耐震壁: 'W',\r\n  202:   床板: 'S',\r\n  203: }\r\n  204: \r\n  205: function isColumnPosition(\r\n  206:   position: ColumnPosition | GirderPosition,\r\n  207: ): position is ColumnPosition {\r\n  208:   return !('axis' in position)\r\n  209: }\r\n  210: \r\n  211: function isGirderPosition(\r\n  212:   position: ColumnPosition | GirderPosition,\r\n  213: ): position is GirderPosition {\r\n  214:   return 'axis' in position\r\n  215: }\r\n  216: \r\n  217: function isGridEdgePosition(\r\n  218:   grid: Grid,\r\n  219:   position: GirderPosition,\r\n  220: ): boolean {\r\n  221:   const { nx, ny } = gridPointCount(grid)\r\n  222: \r\n  223:   if (position.axis !== 'X' && position.axis !== 'Y') return false\r\n  224: \r\n  225:   return (\r\n  226:     Number.isInteger(position.ix) &&\r\n  227:     Number.isInteger(position.iy) &&\r\n  228:     position.ix >= 0 &&\r\n  229:     position.iy >= 0 &&\r\n  230:     (position.axis === 'X'\r\n  231:       ? position.ix < nx - 1 && position.iy < ny\r\n  232:       : position.ix < nx && position.iy < ny - 1)\r\n  233:   )\r\n  234: }\r\n  235: \r\n  236: function columnAt(\r\n  237:   project: Project,\r\n  238:   storyId: string,\r\n  239:   ix: number,\r\n  240:   iy: number,\r\n  241: ): Member | undefined {\r\n  242:   return project.members.find(\r\n  243:     (candidate) =>\r\n  244:       candidate.kind === '柱' &&\r\n  245:       candidate.storyId === storyId &&\r\n  246:       isColumnPosition(candidate.position) &&\r\n  247:       candidate.position.ix === ix &&\r\n  248:       candidate.position.iy === iy,\r\n  249:   )\r\n  250: }\r\n  361:         const position = { axis, ix, iy }\r\n  362:         if (canPlaceWall(project, storyId, position)) {\r\n  363:           positions.push(position)\r\n  364:         }\r\n  365:       }\r\n  366:     }\r\n  367:   }\r\n  368: \r\n  369:   return positions\r\n  370: }\r\n  371: \r\n  372: function slabSupports(\r\n  373:   project: Project,\r\n  374:   storyId: string,\r\n  375:   position: SlabPosition,\r\n  376: ): {\r\n  377:   minX: Member\r\n  378:   maxX: Member\r\n  379:   minY: Member\r\n  380:   maxY: Member\r\n  381: } | undefined {\r\n  382:   const supports = {\r\n  383:     minX: girderAt(project, storyId, {\r\n  384:       axis: 'Y',\r\n  385:       ix: position.ix,\r\n  386:       iy: position.iy,\r\n  387:     }),\r\n  388:     maxX: girderAt(project, storyId, {\r\n  389:       axis: 'Y',\r\n  390:       ix: position.ix + 1,\r\n  391:       iy: position.iy,\r\n  392:     }),\r\n  393:     minY: girderAt(project, storyId, {\r\n  394:       axis: 'X',\r\n  395:       ix: position.ix,\r\n  396:       iy: position.iy,\r\n  397:     }),\r\n  398:     maxY: girderAt(project, storyId, {\r\n  399:       axis: 'X',\r\n  400:       ix: position.ix,\r\n  401:       iy: position.iy + 1,\r\n  402:     }),\r\n  403:   }\r\n  404: \r\n  405:   if (\r\n  406:     supports.minX === undefined ||\r\n  407:     supports.maxX === undefined ||\r\n  408:     supports.minY === undefined ||\r\n  409:     supports.maxY === undefined ||\r\n  410:     !sectionHasKind(project, supports.minX, '大梁') ||\r\n  411:     !sectionHasKind(project, supports.maxX, '大梁') ||\r\n  412:     !sectionHasKind(project, supports.minY, '大梁') ||\r\n  413:     !sectionHasKind(project, supports.maxY, '大梁')\r\n  414:   ) {\r\n  415:     return undefined\r\n  416:   }\r\n  417: \r\n  418:   return {\r\n  419:     minX: supports.minX,\r\n  420:     maxX: supports.maxX,\r\n  421:     minY: supports.minY,\r\n  422:     maxY: supports.maxY,\r\n  423:   }\r\n  424: }\r\n  425: \r\n  426: /**\r\n  427:  * 床板을 놓았을 때 slabBay가 네 변의 내법을 계산할 수 있는지 판정한다.\r\n  428:  * 개별 符号에서 유도되는 id 중복은 이 기하 판정의 대상이 아니다 (ADR-038).\r\n  429:  */\r\n  430: export function canPlaceSlab(\r\n  431:   project: Project,\r\n  432:   storyId: string,\r\n  433:   position: SlabPosition,\r\n  434: ): boolean {\r\n  435:   const { nx, ny } = gridPointCount(project.grid)\r\n  436:   if (!project.stories.some(({ id }) => id === storyId)) return false\r\n  437:   if (isGirderPosition(position)) return false\r\n  438: \r\n  439:   if (\r\n  440:     !Number.isInteger(position.ix) ||\r\n  441:     !Number.isInteger(position.iy) ||\r\n  442:     position.ix < 0 ||\r\n  443:     position.iy < 0 ||\r\n  444:     position.ix >= nx - 1 ||\r\n  445:     position.iy >= ny - 1\r\n  446:   ) {\r\n  447:     return false\r\n  448:   }\r\n  449: \r\n  450:   const supports = slabSupports(project, storyId, position)\r\n  451:   if (supports === undefined) return false\r\n  452: \r\n  453:   const supportSections = {\r\n  454:     minX: project.sections.find(\r\n  455:       (section) => section.id === supports.minX.sectionId,\r\n  456:     ),\r\n  457:     maxX: project.sections.find(\r\n  458:       (section) => section.id === supports.maxX.sectionId,\r\n  459:     ),\r\n  460:     minY: project.sections.find(\r\n  461:       (section) => section.id === supports.minY.sectionId,\r\n  462:     ),\r\n  463:     maxY: project.sections.find(\r\n  464:       (section) => section.id === supports.maxY.sectionId,\r\n  465:     ),\r\n  466:   }\r\n  467:   if (\r\n  468:     supportSections.minX?.kind !== '大梁' ||\r\n  469:     supportSections.maxX?.kind !== '大梁' ||\r\n  470:     supportSections.minY?.kind !== '大梁' ||\r\n  471:     supportSections.maxY?.kind !== '大梁'\r\n  472:   ) {\r\n  473:     return false\r\n  474:   }\r\n  475: \r\n  476:   const origin = gridPoint(project.grid, position.ix, position.iy)\r\n  477:   const far = gridPoint(project.grid, position.ix + 1, position.iy + 1)\r\n  478:   const clearX =\r\n  479:     far.x -\r\n  480:     origin.x -\r\n  481:     supportSections.minX.b / 2 -\r\n  482:     supportSections.maxX.b / 2\r\n  483:   const clearY =\r\n  484:     far.y -\r\n  485:     origin.y -\r\n  486:     supportSections.minY.b / 2 -\r\n  487:     supportSections.maxY.b / 2\r\n  488: \r\n  489:   return clearX > 0 && clearY > 0\r\n  490: }\r\n  491: \r\n  492: /** 지정한 階에서 네 변의 大梁가 모두 있는 床板 ベイ 후보를 반환한다. */\r\n  493: export function placeableSlabPositions(\r\n  494:   project: Project,\r\n  495:   storyId: string,\r\n  496: ): SlabPosition[] {\r\n  497:   const { nx, ny } = gridPointCount(project.grid)\r\n  498:   const positions: SlabPosition[] = []\r\n  499: \r\n  500:   for (let iy = 0; iy < ny - 1; iy += 1) {\r\n  501:     for (let ix = 0; ix < nx - 1; ix += 1) {\r\n  502:       const position = { ix, iy }\r\n  503:       if (canPlaceSlab(project, storyId, position)) {\r\n  504:         positions.push(position)\r\n  505:       }\r\n  506:     }\r\n  507:   }\r\n  508: \r\n  509:   return positions\r\n  510: }\r\n  886:   support: SlabEdgeSupport\r\n  887:   supportClearMm: number\r\n  888:   projectionMm: number\r\n  889: }\r\n  890: \r\n  891: function isSlabPosition(\r\n  892:   position: ColumnPosition | GirderPosition,\r\n  893: ): position is SlabPosition {\r\n  894:   return !('axis' in position)\r\n  895: }\r\n  896: \r\n  897: function girderSectionAt(\r\n  898:   project: Project,\r\n  899:   storyId: string,\r\n  900:   axis: 'X' | 'Y',\r\n  901:   ix: number,\r\n  902:   iy: number,\r\n  903:   requestedBy: Member,\r\n  904: ): { member: Member; section: GirderSection } {\r\n  905:   const girder = project.members.find(\r\n  906:     (candidate) =>\r\n  907:       candidate.kind === '大梁' &&\r\n  908:       candidate.storyId === storyId &&\r\n  909:       isGirderPosition(candidate.position) &&\r\n  910:       candidate.position.axis === axis &&\r\n  911:       candidate.position.ix === ix &&\r\n  912:       candidate.position.iy === iy,\r\n  913:   )\r\n  914: \r\n  915:   // 四辺のどれかが欠けると内法が決まらない。通り芯間で代用すれば大梁と重なった\r\n  916:   // 床板を計上してしまうので、黙って埋めない — 壁の上部大梁と同じ扱いである。\r\n  917:   if (!girder) {\r\n  918:     throw new MemberUnsupportedError(\r\n  919:       '寸法不成立',\r\n  920:       `Missing ${axis}通り大梁 beside 床板: ${requestedBy.id} (${ix}, ${iy})`,\r\n  921:     )\r\n  922:   }\r\n  923: \r\n  924:   const section = findSection(project, girder.sectionId)\r\n  925:   if (section.kind !== '大梁') {\r\n  926:     throw new MemberUnsupportedError(\r\n  927:       '寸法不成立',\r\n  928:       `大梁 member references a non-大梁 section: ${girder.id}`,\r\n  929:     )\r\n  930:   }\r\n  931: \r\n  932:   return { member: girder, section }\r\n  933: }\r\n  934: \r\n  935: export function slabBay(project: Project, member: Member): SlabBay {\r\n  936:   if (member.kind !== '床板' || !isSlabPosition(member.position)) {\r\n  937:     throw new Error(`slabBay requires a 床板: ${member.id}`)\r\n  938:   }\r\n  939: \r\n  940:   const { ix, iy } = member.position\r\n  941:   const origin = gridPoint(project.grid, ix, iy)\r\n  942:   const far = gridPoint(project.grid, ix + 1, iy + 1)\r\n  943: \r\n  944:   const edge = (\r\n  945:     axis: 'X' | 'Y',\r\n  946:     edgeIx: number,\r\n  947:     edgeIy: number,\r\n  948:   ): SlabEdgeSupport => {\r\n  949:     const { member: girder, section } = girderSectionAt(\r\n  950:       project,\r\n  951:       member.storyId,\r\n  952:       axis,\r\n  953:       edgeIx,\r\n  954:       edgeIy,\r\n  955:       member,\r\n  956:     )\r\n  957:     return {\r\n  958:       memberId: girder.id,\r\n  959:       widthMm: section.b,\r\n  960:       cover: coverConditions(section),\r\n  961:     }\r\n  962:   }\r\n  963: \r\n  964:   // X方向の内法を決めるのは Y通り（縦に走る）大梁の幅である — 走る向きと\r\n  965:   // 幅を測る向きが直交するので、ここを取り違えると内法が入れ替わる。\r\n  966:   const supports = {\r\n  967:     minX: edge('Y', ix, iy),\r\n  968:     maxX: edge('Y', ix + 1, iy),\r\n  969:     minY: edge('X', ix, iy),\r\n  970:     maxY: edge('X', ix, iy + 1),\r\n  971:   }\r\n  972: \r\n  973:   const centerSpanXMm = far.x - origin.x\r\n  974:   const centerSpanYMm = far.y - origin.y\r\n  975:   const startFaceOffsetXMm = supports.minX.widthMm / 2\r\n  976:   const startFaceOffsetYMm = supports.minY.widthMm / 2\r\n  977:   const clearXMm =\r\n  978:     centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\r\n  979:   const clearYMm =\r\n  980:     centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\r\n  981: \r\n  982:   if (clearXMm <= 0 || clearYMm <= 0) {\r\n  983:     throw new MemberUnsupportedError(\r\n  984:       '寸法不成立',\r\n  985:       `床板 内法長さ must be positive: ${member.id} ` +\r\n  986:         `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\r\n  987:     )\r\n  988:   }\r\n  989: \r\n  990:   return {\r\n  991:     centerSpanXMm,\r\n  992:     centerSpanYMm,\r\n  993:     clearXMm,\r\n  994:     clearYMm,\r\n  995:     startFaceOffsetXMm,\r\n  996:     startFaceOffsetYMm,\r\n  997:     supports,\r\n  998:   }\r\n  999: }\r\n 1000: \r\n 1001: /**\r\n 1002:  * 同一断面の床板が大梁を通して連なる範囲 — 数量積算基準 2（４）床板1) の\r\n 1003:  * 「同一の径の主筋が梁、壁等を通して連続する場合」がこれである。\r\n 1004:  *\r\n 1005:  * 大梁のラン (girderRun) と同じ形だ。1ベイなら長さ1のランで「単独床板」、\r\n 1006:  * 2ベイ以上なら「連続する床板」になり、継手箇所数の条文が 2（４）床板2) に\r\n 1007:  * 切り替わる。X方向とY方向で別のランを持つ — 床板は2方向に主筋が走るからだ。\r\n 1008:  */\r\n 1009: export interface SlabRun {\r\n 1010:   axis: 'X' | 'Y'\r\n 1011:   /** 軸方向の昇順。単独床板なら長さ1 */\r\n 1012:   members: Member[]\r\n 1013:   /** 通し筋を帰属させる部材 ＝ members[0].id */\r\n 1014:   ownerId: string\r\n 1015:   /** members と同じ順序 */\r\n","exit_code":0,"status":"completed"}}
