ct.sections.find(\r\n  315:     (section) => section.id === endColumn.sectionId,\r\n  316:   )\r\n  317:   const upperSection = project.sections.find(\r\n  318:     (section) => section.id === upperGirder.sectionId,\r\n  319:   )\r\n  320:   if (\r\n  321:     startSection?.kind !== '柱' ||\r\n  322:     endSection?.kind !== '柱' ||\r\n  323:     upperSection?.kind !== '大梁'\r\n  324:   ) {\r\n  325:     return false\r\n  326:   }\r\n  327: \r\n  328:   const startPoint = gridPoint(project.grid, position.ix, position.iy)\r\n  329:   const endPoint = gridPoint(project.grid, endIx, endIy)\r\n  330:   const centerSpan =\r\n  331:     position.axis === 'X'\r\n  332:       ? endPoint.x - startPoint.x\r\n  333:       : endPoint.y - startPoint.y\r\n  334:   const startSupportLength =\r\n  335:     position.axis === 'X' ? startSection.b : startSection.d\r\n  336:   const endSupportLength =\r\n  337:     position.axis === 'X' ? endSection.b : endSection.d\r\n  338:   const clearLength =\r\n  339:     centerSpan - startSupportLength / 2 - endSupportLength / 2\r\n  340:   const clearHeight = story.height - upperSection.depth\r\n  341: \r\n  342:   return clearLength > 0 && clearHeight > 0\r\n  343: }\r\n  344: \r\n  345: /**\r\n  346:  * 지정한 階에서 실제 내법을 계산할 수 있는 벽 辺 후보를 반환한다.\r\n  347:  * 반환값은 기하 후보이며, 같은 符号로 만든 id 중복은 이 함수에서 판정하지 않는다.\r\n  348:  */\r\n  349: export function placeableWallPositions(\r\n  350:   project: Project,\r\n  351:   storyId: string,\r\n  352: ): GirderPosition[] {\r\n  353:   const { nx, ny } = gridPointCount(project.grid)\r\n  354:   const positions: GirderPosition[] = []\r\n  355: \r\n  356:   for (const axis of ['X', 'Y'] as const) {\r\n  357:     const ixLimit = axis === 'X' ? nx - 1 : nx\r\n  358:     const iyLimit = axis === 'Y' ? ny - 1 : ny\r\n  359:     for (let iy = 0; iy < iyLimit; iy += 1) {\r\n  360:       for (let ix = 0; ix < ixLimit; ix += 1) {\r\n  361:         const position = { axis, ix, iy }\r\n  362:         if (canPlaceWall(project, storyId, position)) {\r\n  363:           positions.push(position)\r\n  364:         }\r\n  365:       }\r\n  366:     }\r\n  367:   }\r\n  368: \r\n  369:   return positions\r\n  370: }\r\n  371: \r\n  372: function slabSupports(\r\n  373:   project: Project,\r\n  374:   storyId: string,\r\n  375:   position: SlabPosition,\r\n  376: ): {\r\n  377:   minX: Member\r\n  378:   maxX: Member\r\n  379:   minY: Member\r\n  380:   maxY: Member\r\n  381: } | undefined {\r\n  431:   project: Project,\r\n  432:   storyId: string,\r\n  433:   position: SlabPosition,\r\n  434: ): boolean {\r\n  435:   const { nx, ny } = gridPointCount(project.grid)\r\n  436:   if (!project.stories.some(({ id }) => id === storyId)) return false\r\n  437:   if (isGirderPosition(position)) return false\r\n  438: \r\n  439:   if (\r\n  440:     !Number.isInteger(position.ix) ||\r\n  441:     !Number.isInteger(position.iy) ||\r\n  442:     position.ix < 0 ||\r\n  443:     position.iy < 0 ||\r\n  444:     position.ix >= nx - 1 ||\r\n  445:     position.iy >= ny - 1\r\n  446:   ) {\r\n  447:     return false\r\n  448:   }\r\n  449: \r\n  450:   const supports = slabSupports(project, storyId, position)\r\n  451:   if (supports === undefined) return false\r\n  452: \r\n  453:   const supportSections = {\r\n  454:     minX: project.sections.find(\r\n  455:       (section) => section.id === supports.minX.sectionId,\r\n  456:     ),\r\n  457:     maxX: project.sections.find(\r\n  458:       (section) => section.id === supports.maxX.sectionId,\r\n  459:     ),\r\n  460:     minY: project.sections.find(\r\n  461:       (section) => section.id === supports.minY.sectionId,\r\n  462:     ),\r\n  463:     maxY: project.sections.find(\r\n  464:       (section) => section.id === supports.maxY.sectionId,\r\n  465:     ),\r\n  466:   }\r\n  467:   if (\r\n  468:     supportSections.minX?.kind !== '大梁' ||\r\n  469:     supportSections.maxX?.kind !== '大梁' ||\r\n  470:     supportSections.minY?.kind !== '大梁' ||\r\n  471:     supportSections.maxY?.kind !== '大梁'\r\n  472:   ) {\r\n  473:     return false\r\n  474:   }\r\n  475: \r\n  476:   const origin = gridPoint(project.grid, position.ix, position.iy)\r\n  477:   const far = gridPoint(project.grid, position.ix + 1, position.iy + 1)\r\n  478:   const clearX =\r\n  479:     far.x -\r\n  480:     origin.x -\r\n  481:     supportSections.minX.b / 2 -\r\n  482:     supportSections.maxX.b / 2\r\n  483:   const clearY =\r\n  484:     far.y -\r\n  485:     origin.y -\r\n  486:     supportSections.minY.b / 2 -\r\n  487:     supportSections.maxY.b / 2\r\n  488: \r\n  489:   return clearX > 0 && clearY > 0\r\n  490: }\r\n  491: \r\n  492: /** 지정한 階에서 네 변의 大梁가 모두 있는 床板 ベイ 후보를 반환한다. */\r\n  493: export function placeableSlabPositions(\r\n  494:   project: Project,\r\n  495:   storyId: string,\r\n  496: ): SlabPosition[] {\r\n  497:   const { nx, ny } = gridPointCount(project.grid)\r\n  498:   const positions: SlabPosition[] = []\r\n  499: \r\n  500:   for (let iy = 0; iy < ny - 1; iy += 1) {\r\n  501:     for (let ix = 0; ix < nx - 1; ix += 1) {\r\n  502:       const position = { ix, iy }\r\n  503:       if (canPlaceSlab(project, storyId, position)) {\r\n  504:         positions.push(position)\r\n  505:       }\r\n  506:     }\r\n  507:   }\r\n  508: \r\n  509:   return positions\r\n  510: }\r\n  511: \r\n  512: function touchesColumn(\r\n  513:   girder: GirderPosition,\r\n  514:   column: ColumnPosition,\r\n  515: ): boolean {\r\n  516:   if (girder.axis === 'X') {\r\n  517:     return (\r\n  518:       girder.iy === column.iy &&\r\n  519:       (girder.ix === column.ix || girder.ix + 1 === column.ix)\r\n  520:     )\r\n  521:   }\r\n  522: \r\n  523:   return (\r\n  524:     girder.ix === column.ix &&\r\n  525:     (girder.iy === column.iy || girder.iy + 1 === column.iy)\r\n  526:   )\r\n  527: }\r\n  528: \r\n  529: export interface GirderSpan {\r\n  530:   axis: 'X' | 'Y'\r\n  531:   /** 그리드 교점 간 중심 스팬 (mm) */\r\n  532:   centerSpan: number\r\n  533:   /** 内法長さ (mm) — 양단 柱面 사이 */\r\n  534:   clear: number\r\n  535:   /** 시작 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n  536:   startFaceOffsetMm: number\r\n  537:   /** 끝 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n  538:   endFaceOffsetMm: number\r\n  539:   /** 정착 수용성 검사용 — 시작 柱의 축방향 전체 치수 (mm) */\r\n  540:   startSupportLengthAlongAxisMm: number\r\n  541:   /** 정착 수용성 검사용 — 끝 柱의 축방향 전체 치수 (mm) */\r\n  542:   endSupportLengthAlongAxisMm: number\r\n  543:   /** 지점 柱의 かぶり 조회 조건 — 端部条件은 大梁이 아니라 柱의 かぶり로 판정한다 */\r\n  544:   startSupportCover: Record<string, string | boolean>\r\n  545:   endSupportCover: Record<string, string | boolean>\r\n  546: }\r\n  547: \r\n  548: export function girderSupportSections(\r\n  549:   project: Project,\r\n  550:   member: Member,\r\n  551: ): { start: ColumnSection; end: ColumnSection } {\r\n  552:   if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\r\n  553:     throw new Error(`girderSupportSections requires a 大梁: ${member.id}`)\r\n  554:   }\r\n  555: \r\n  556:   const { axis, ix, iy } = member.position\r\n  557:   const endIx = axis === 'X' ? ix + 1 : ix\r\n  558:   const endIy = axis === 'Y' ? iy + 1 : iy\r\n  559: \r\n  560:   return {\r\n  561:     start: supportColumnSection(project, member, ix, iy, 'start'),\r\n  562:     end: supportColumnSection(project, member, endIx, endIy, 'end'),\r\n  563:   }\r\n  564: }\r\n  565: \r\n  566: function supportColumnSection(\r\n  567:   project: Project,\r\n  568:   supported: Member,\r\n  569:   ix: number,\r\n  570:   iy: number,\r\n  571:   end: 'start' | 'end',\r\n  572:   unsupported = false,\r\n  573: ): ColumnSection {\r\n  574:   const reject = (message: string): never => {\r\n  575:     if (unsupported) {\r\n  576:       throw new MemberUnsupportedError('寸法不成立', message)\r\n  577:     }\r\n  578:     throw new Error(message)\r\n  579:   }\r\n  580: \r\n  581:   const support = project.members.find(\r\n  582:     (candidate) =>\r\n  583:       candidate.kind === '柱' &&\r\n  584:       candidate.storyId === supported.storyId &&\r\n  585:       isColumnPosition(candidate.position) &&\r\n  586:       candidate.position.ix === ix &&\r\n  587:       candidate.position.iy === iy,\r\n  588:   )\r\n  589: \r\n  590:   if (!support) {\r\n  591:     return reject(\r\n  592:       `Missing ${end} support 柱 for ${supported.kind}: ${supported.id}`,\r\n  593:     )\r\n  594:   }\r\n  595: \r\n  596:   const section = findSection(project, support.sectionId)\r\n  597:   if (section.kind !== '柱') {\r\n  598:     return reject(`柱 member references a non-柱 section: ${support.id}`)\r\n  599:   }\r\n  600: \r\n  601:   return section\r\n  602: }\r\n  603: \r\n  604: export function girderSpan(project: Project, member: Member): GirderSpan {\r\n  605:   if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\r\n  606:     throw new Error(`girderSpan requires a 大梁: ${member.id}`)\r\n  607:   }\r\n  608: \r\n  609:   const { axis, ix, iy } = member.position\r\n  610:   const endIx = axis === 'X' ? ix + 1 : ix\r\n  611:   const endIy = axis === 'Y' ? iy + 1 : iy\r\n  612:   const startPoint = gridPoint(project.grid, ix, iy)\r\n  613:   const endPoint = gridPoint(project.grid, endIx, endIy)\r\n  614:   const { start: startSection, end: endSection } = girderSupportSections(\r\n  615:     project,\r\n  616:     member,\r\n  617:   )\r\n  618:   const centerSpan =\r\n  619:     axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\r\n  620:   const startSupportLengthAlongAxisMm =\r\n  621:     axis === 'X' ? startSection.b : startSection.d\r\n  622:   const endSupportLengthAlongAxisMm =\r\n  623:     axis === 'X' ? endSection.b : endSection.d\r\n  624:   const startFaceOffsetMm = startSupportLengthAlongAxisMm / 2\r\n  625:   const endFaceOffsetMm = endSupportLengthAlongAxisMm / 2\r\n  626:   const clear = centerSpan - startFaceOffsetMm - endFaceOffsetMm\r\n  627: \r\n  628:   if (clear <= 0) {\r\n  629:     throw new MemberUnsupportedError(\r\n  630:       '寸法不成立',\r\n  631:       `大梁 内法長さ must be positive: ${member.id} (${clear} mm)`,\r\n  632:     )\r\n  633:   }\r\n  634: \r\n  635:   return {\r\n  636:     axis,\r\n  637:     centerSpan,\r\n  638:     clear,\r\n  639:     startFaceOffsetMm,\r\n  640:     endFaceOffsetMm,\r\n  641:     startSupportLengthAlongAxisMm,\r\n  642:     endSupportLengthAlongAxisMm,\r\n  643:     startSupportCover: coverConditions(startSection),\r\n  644:     endSupportCover: coverConditions(endSection),\r\n  645:   }\r\n  646: }\r\n  647: \r\n  648: /**\r\n  649:  * 耐震壁の内法寸法。躯体の区分（第4編第1章第2節（５）壁）が壁を「柱、梁、床板等に\r\n  650:  * 接する垂直材の内法部分」と定めるので、壁の高さも長さも中心間ではなく内法である。\r\n  651:  * 柱・大梁と二重計上しないのはこの定義そのもので、大梁が内法長さなのと同じ形だ。\r\n  652:  */\r\n  653: export interface WallSpan {\r\n  654:   axis: 'X' | 'Y'\r\n  655:   /** 内法長さ (mm) — 両側の柱の内側面の間 */\r\n  656:   clearLengthMm: number\r\n  657:   /** 内法高さ (mm) — 階高 − 上部大梁せい */\r\n  658:   clearHeightMm: number\r\n  659:   /** 始端の柱中心 → 壁端（柱内側面）までのオフセット (mm) */\r\n  660:   startFaceOffsetMm: number\r\n  661:   /** 終端の柱中心 → 壁端（柱内側面）までのオフセット (mm) */\r\n  662:   endFaceOffsetMm: number\r\n  663:   /** 内法高さを決めた上部大梁のせい (mm) */\r\n  664:   girderDepthAboveMm: number\r\n  665:   /** 範囲を指定したときの自由端。省略軸は両端が接続側である。 */\r\n  666:   freeEnds?: {\r\n  667:     vertical?: '上端' | '下端'\r\n  668:     horizontal?: '始端' | '終端'\r\n  669:   }\r\n  670:   /** 内法域の原点から、範囲の原点までのローカルオフセット (mm)。 */\r\n  671:   originOffsetMm?: {\r\n  672:     along: number\r\n  673:     height: number\r\n  674:   }\r\n  675: }\r\n  676: \r\n  677: /**\r\n  678:  * 壁の上に載る大梁のせい。壁と同じ辺（同じ通り芯・同じスパン）の大梁を見る —\r\n  679:  * 耐震壁は2本の柱の間に立ち、その上の大梁で頭を止められるからである。\r\n  680:  *\r\n  681:  * 見つからなければ入力の不整合なので黙って階高を使わない。大梁のない辺に壁を\r\n  682:  * 置くと内法高さが決まらず、階高で代用すれば大梁と重なった壁を計上してしまう。\r\n  683:  */\r\n  684: function girderDepthAboveWall(project: Project, wall: Member): number {\r\n  685:   const position = wall.position\r\n  686:   if (!isGirderPosition(position)) {\r\n  687:     throw new MemberUnsupportedError(\r\n  688:       '寸法不成立',\r\n  689:       `girderDepthAboveWall requires an edge position: ${wall.id}`,\r\n  690:     )\r\n  691:   }\r\n  692: \r\n  693:   const girder = project.members.find(\r\n  694:     (candidate) =>\r\n  695:       candidate.kind === '大梁' &&\r\n  696:       candidate.storyId === wall.storyId &&\r\n  697:       isGirderPosition(candidate.position) &&\r\n  698:       candidate.position.axis === position.axis &&\r\n  699:       candidate.position.ix === position.ix &&\r\n  700:       candidate.position.iy === position.iy,\r\n  701:   )\r\n  701:   )\r\n  702: \r\n  703:   if (!girder) {\r\n  704:     throw new MemberUnsupportedError(\r\n  705:       '寸法不成立',\r\n  706:       `Missing 大梁 above 耐震壁: ${wall.id}`,\r\n  707:     )\r\n  708:   }\r\n  709: \r\n  710:   const section = findSection(project, girder.sectionId)\r\n  711:   if (section.kind !== '大梁') {\r\n  712:     throw new MemberUnsupportedError(\r\n  713:       '寸法不成立',\r\n  714:       `大梁 member references a non-大梁 section: ${girder.id}`,\r\n  715:     )\r\n  716:   }\r\n  717: \r\n  718:   return section.depth\r\n  719: }\r\n  720: \r\n  721: export function wallSpan(project: Project, member: Member): WallSpan {\r\n  722:   if (member.kind !== '耐震壁' || !isGirderPosition(member.position)) {\r\n  723:     throw new Error(`wallSpan requires a 耐震壁: ${member.id}`)\r\n  724:   }\r\n  725: \r\n  726:   const story = project.stories.find(({ id }) => id === member.storyId)\r\n  727:   if (!story) {\r\n  728:     throw storyNotFound(member.storyId)\r\n  729:   }\r\n  730: \r\n  731:   const { axis, ix, iy } = member.position\r\n  732:   const endIx = axis === 'X' ? ix + 1 : ix\r\n  733:   const endIy = axis === 'Y' ? iy + 1 : iy\r\n  734:   const startPoint = gridPoint(project.grid, ix, iy)\r\n  735:   const endPoint = gridPoint(project.grid, endIx, endIy)\r\n  736:   const startSection = supportColumnSection(\r\n  737:     project,\r\n  738:     member,\r\n  739:     ix,\r\n  740:     iy,\r\n  741:     'start',\r\n  742:     true,\r\n  743:   )\r\n  744:   const endSection = supportColumnSection(\r\n  745:     project,\r\n  746:     member,\r\n  747:     endIx,\r\n  748:     endIy,\r\n  749:     'end',\r\n  750:     true,\r\n  751:   )\r\n  752: \r\n  753:   const centerSpan =\r\n  754:     axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\r\n  755:   const startFaceOffsetMm =\r\n  756:     (axis === 'X' ? startSection.b : startSection.d) / 2\r\n  757:   const endFaceOffsetMm = (axis === 'X' ? endSection.b : endSection.d) / 2\r\n  758:   const clearLengthMm = centerSpan - startFaceOffsetMm - endFaceOffsetMm\r\n  759: \r\n  760:   if (clearLengthMm <= 0) {\r\n  761:     throw new MemberUnsupportedError(\r\n  762:       '寸法不成立',\r\n  763:       `耐震壁 内法長さ must be positive: ${member.id} (${clearLengthMm} mm)`,\r\n  764:     )\r\n  765:   }\r\n  766: \r\n  767:   const girderDepthAboveMm = girderDepthAboveWall(project, member)\r\n  768:   const fullClearHeightMm = story.height - girderDepthAboveMm\r\n  769: \r\n  770:   if (fullClearHeightMm <= 0) {\r\n  771:     throw new MemberUnsupportedError(\r\n  772:       '寸法不成立',\r\n  773:       `耐震壁 内法高さ must be positive: ${member.id} ` +\r\n  774:         `(階高 ${story.height} − 上部大梁せい ${girderDepthAboveMm})`,\r\n  775:     )\r\n  776:   }\r\n  777: \r\n  778:   const extent = member.wallExtent\r\n  779:   let actualLengthMm = clearLengthMm\r\n  780:   let actualHeightMm = fullClearHeightMm\r\n  781:   let alongOriginMm = 0\r\n","exit_code":0,"status":"completed"}}
