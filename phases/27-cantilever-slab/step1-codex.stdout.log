}`).toBeLessThan(l1)\n+        expect(l3?.value, `${grade} Fc${fc}`).toBeLessThan(l1)\n       }\n     }\n   })\n@@ -188,11 +191,19 @@ describe('スラブ下端筋の定着は一般値より短い', () => {\n     // 「10d かつ 150mm 以上」の 150mm は、細い径でこそ効く下限だ。10d を\n     // 下回る値を書いてしまうと行があっても一度も効かず、転写ミスに気づけない。\n     const floor = rows('anchorage.L3.minimum')\n-    const perDiameter = rows('anchorage.L3')\n+    const perDiameter = rows('anchorage.L3').find(\n+      (entry) => entry.conditions.member === 'スラブ',\n+    )\n \n     expect(floor).toHaveLength(1)\n     expect(floor[0].unit).toBe('mm')\n-    expect(floor[0].value).toBeGreaterThan(perDiameter[0].value * 13)\n+    expect(perDiameter).toBeDefined()\n+    expect(floor[0].value).toBeGreaterThan(perDiameter!.value * 13)\n+    expect(\n+      rows('anchorage.L3.minimum').some(\n+        (entry) => entry.conditions.member === '片持スラブ',\n+      ),\n+    ).toBe(false)\n   })\n })\n \ndiff --git a/tests/golden/spec-fixture.test.ts b/tests/golden/spec-fixture.test.ts\nindex 22489c9..cdc7264 100644\n--- a/tests/golden/spec-fixture.test.ts\n+++ b/tests/golden/spec-fixture.test.ts\n@@ -73,10 +73,28 @@ describe('公共建築工事標準仕様書 令和7年版 5章 fixture', () => {\n     // 11マスに展開して転写していたら、原文にない格子を作ったことになる。\n     const l3 = entriesFor('anchorage.L3', 'anchorage.L3.minimum')\n \n-    expect(l3).toHaveLength(2)\n-    for (const entry of l3) {\n-      expect(entry.conditions).toEqual({ member: 'スラブ' })\n-    }\n+    expect(l3).toHaveLength(3)\n+    expect(l3.filter((entry) => entry.kind === 'anchorage.L3')).toHaveLength(2)\n+    expect(\n+      l3.find((entry) => entry.kind === 'anchorage.L3.minimum')?.conditions,\n+    ).toEqual({ member: 'スラブ' })\n+    expect(\n+      l3.find(\n+        (entry) => entry.conditions.member === 'スラブ' && entry.kind === 'anchorage.L3',\n+      )?.value,\n+    ).toBe(10)\n+    expect(\n+      l3.find(\n+        (entry) => entry.conditions.member === '片持スラブ' && entry.kind === 'anchorage.L3',\n+      )?.value,\n+    ).toBe(25)\n+    expect(\n+      l3.some(\n+        (entry) =>\n+          entry.kind === 'anchorage.L3.minimum' &&\n+          entry.conditions.member === '片持スラブ',\n+      ),\n+    ).toBe(false)\n   })\n \n   it('carries explicit expansion values for every band', () => {\ndiff --git a/tests/golden/spec-tables.test.ts b/tests/golden/spec-tables.test.ts\nindex 4237a92..69277b0 100644\n--- a/tests/golden/spec-tables.test.ts\n+++ b/tests/golden/spec-tables.test.ts\n@@ -55,6 +55,16 @@ interface BentConditionEntry {\n   imageRead: boolean\n }\n \n+interface SlabAnchorageEntry {\n+  table: string\n+  printedPage: number\n+  kind: 'anchorage.L3' | 'anchorage.L3.minimum'\n+  conditions: { member: string }\n+  value: number\n+  unit: string\n+  imageRead: boolean\n+}\n+\n interface CoverEntry {\n   table: string\n   printedPage: number\n@@ -198,7 +208,7 @@ const bentConditionEntries = (\n // 表5.3.4 の L3（スラブ欄）は縦に結合されたセルで、鉄筋の種類・Fc の格子を\n // 持たない。Fc 帯を展開する経路に流すと fcValues が無くて落ちるので別に扱う。\n const slabAnchorageEntries = (\n-  fixture.entries as unknown as BentConditionEntry[]\n+  fixture.entries as unknown as SlabAnchorageEntry[]\n ).filter(({ kind }) => ['anchorage.L3', 'anchorage.L3.minimum'].includes(kind))\n \n describe('公共建築工事標準仕様書 令和7年版 定着・重ね継手 tables', () => {\n@@ -323,6 +333,22 @@ describe('公共建築工事標準仕様書 令和7年版 折曲げ・かぶり\n     expect(perDiameter.source.section).toBe(floor.source.section)\n   })\n \n+  it('reads the cantilever L3 exception as 25d without a 150mm floor', () => {\n+    const cantilever = lookupRule(jpMlitRulePack, 'anchorage.L3', {\n+      member: '片持スラブ',\n+    })\n+\n+    expect(cantilever.value).toBe(25)\n+    expect(cantilever.unit).toBe('d')\n+    expect(cantilever.source.section).toBe('表5.3.4')\n+    expect(cantilever.source.page).toBe(30)\n+    expect(() =>\n+      lookupRule(jpMlitRulePack, 'anchorage.L3.minimum', {\n+        member: '片持スラブ',\n+      }),\n+    ).toThrow(/not found/i)\n+  })\n+\n   it('matches the 耐力壁 重ね継手 lower bound as its own rule', () => {\n     // 表5.3.2 の格子ではなく 5.3.4(3)(ｱ) の本文にある単独の下限だ。「大きい方を\n     // 取る」計算は TS 側にあり、ここが固定するのは 40d という値と出典である。\nFullName                              Length\r\n--------                              ------\r\nC:\\Users\\emper\\mdtproject\\docs\\ADR.md 138512\r\n--- ADR matches ---\r\n309:### ADR-028: 부재 범위에 `床板（スラブ）`을 넣는다 — 조문이 가장 잘 갖춰진 나머지 하나 (ADR-005 추가 대체)\r\n356:### ADR-029: 開口部를 部材 입력으로 받아 1通則8)로 欠除한다 — R14의 「틀린 채로 완성된 것」을 닫는다\r\n358:**맥락**: `耐震壁`(ADR-025)과 `床板`(ADR-028)을 내면서 두 번 다 같은 자리에 구멍을 남겼다 — 開口部다. 두 부재 모두 개구가 있어도 縦筋·横筋·2방향 主筋을 통째로 계상했으므로, 창이나 계단이 뚫린 벽·바닥은 **과대 계상**됐다. 이 프로젝트가 못 견디는 실패는 「빠진 것」이 아니라 「틀린 채로 완성된 것」이고, R14가 그 첫 자리였다. 빈칸으로 두지 않고 内訳書에 상시 고지를 세워 두었지만 고지는 사실을 알릴 뿐 값을 고치지 못한다.\r\n493:**맥락**: `数量積算基準` 1通則8)은 開口部 欠除를 정한 뒤 「なお、開口補強筋は設計図書により計測・計算する」로 補強筋을 設計図書에 위임한다 — 조문에 형상·본수·길이가 없어 제품이 지어낼 수 없다(2（３）梁1)·2（４）床板1)의 「補強筋等は設計図書による」와 같은 취급). ADR-029가 欠除를 구현하며 補強筋 미계상 상시 고지를 세웠고(R14 잔여 — 개구 있는 부재는 과소 계상), 닫으려면 도면에서 읽은 값을 그대로 옮겨 적는 입력이 필요하다고 적었다. 선례는 腹筋이다 — 규준값이 없는 값은 룰팩이 아니라 입력으로 받고, 算出式에 그 사실을 적는다 (ADR-021·M3c).\r\n496:1. **입력은 開口 단위의 전사다**: `Opening.reinforcements?: Array<{ size: BarSize, count: number, lengthMm: number }>`. `lengthMm`은 **設計長さ 그 자체**다 — 「計測・計算する」의 주체는 조문상 設計図書를 읽는 쪽(사용자)이고, 제품은 定着·折曲げ·余長을 더하지도 빼지도 않는다. 입력 자리는 開口와 같은 平面 페인이다 (ADR-029).\r\n500:5. **고지는 지우지 않고 문면을 뒤집는다** (ADR-029 선례): 補強筋은 전사 입력으로 계상하며, **전사하지 않은 開口는 그만큼 과소 계상**이라는 사실을 계속 고지한다 — 제품은 전사의 완전성을 알 수 없다.\r\n528:3. **かぶり** — 룰팩에 表5.3.6 「スラブ、耐力壁以外の壁」행을 `memberKind: 雑壁` 2행(仕上げあり20·仕上げなし30, soilContact:false, exposure 조건 없음 — 원문 구조)으로 싣는다. 값은 ADR-028이 床板용으로 이미 전사한 fixture 행에 있고, 이 행은 부재가 아니라 구분을 가르므로 제품 어휘 토큰 `雑壁`을 조건에 쓴다 — 기존 耐震壁 행과 조건이 배타라 조회 동점(ambiguous)을 만들지 않는다. かぶり는 設計長さ(kg)에 영향이 없고 3D 배치와 ダブル 성립 가드에만 미친다 — 지금 `寸法不成立`으로 떨어지는 얇은 벽이 계상되기 시작할 수 있고, 그것이 옳은 방향이다.\r\n529:4. **40d 하한은 雑壁에 적용하지 않는다 — 제품의 읽기다.** 5.3.4(3)(ｱ)는 耐力壁 한정이고 耐力壁以外의 하한을 정한 조문은 없으므로, 일반 규정(表5.3.2의 L1)만 남는다고 읽는다. ADR-029의 開口部腰壁 판정과 같은 성격으로 기록한다(R2). `wallClass: 耐力壁以外`이면 `lap.wall.minimum`을 조회하지 않고 ruleHits에도 싣지 않으며, 算出式에 그 사실을 적는다. **kg가 달라지는 유일한 지점이다** (L1 ＜ 40d인 조합에서만).\r\n530:5. **하지 않는 것**: 부분 높이·부분 길이 형상(腰壁·垂れ壁의 고유 높이, 袖壁)은 이 결정의 범위 밖이다 — 조문은 内法 준용만 말하고 경계 치수를 정하지 않아 형상 입력 신설이 따로 필요하다(후속 검토). 全高 벽＋開口 우회(ADR-029)는 현행 유지. 手すり壁은 정의절 열거(「袖壁、下り壁、腰壁等」)에 없고 ②의 但書에만 나온다 — 부재화하지 않는다. 幅止め筋 본수 조문 부재(ADR-025)도 그대로다. 内訳書 그룹은 `W` 그대로 두고 부호(mark)로 가른다.\r\n532:### ADR-037: 雑壁의 부분 높이·부분 길이는 部材 단위 内法 범위 전사 입력이다 — 자유단에는 定着이 없다\r\n534:**맥락**: ADR-036 §5가 남긴 것이다. `数量積算基準` 第4編第1章第2節（５）의 정의는 「袖壁、下り壁、腰壁等もこれらに準ずる」로 이들을 「柱、梁、床板等に接する垂直材の内法部分」에 준하게 하지만, **그 内法의 경계 치수는 조문에 없다** — 腰壁이 어디서 끝나는지는 設計図書에만 있다. 현행 제품의 벽은 언제나 全内法(柱면~柱면 × 階高−上部大梁せい)이고, 부분 벽은 全高 벽＋開口 우회(ADR-029)로만 근사된다. 그 우회에는 두 결함이 있다. ① `buildWallBars`는 범위와 무관하게 **항상 양단에 定着을 더한다** — 袖壁의 자유단(벽이 끝나고 아무것도 접속하지 않는 가장자리)에도 定着이 붙어 근거 없이 kg가 올라간다. 2（５）壁1)①은 「接続する他の部分に定着するものとし」라 접속하지 않는 가장자리에는 定着이 없다. ② 경계에 접한 「開口」는 建具類等의 開口部가 아니라 그냥 벽이 없는 부분인데, 그것을 開口로 적으면 1通則8)의 0.5㎡ 하한·②의 継手 但書·開口補強筋 고지가 함께 따라온다. 즉 開口 우회는 **다른 조문을 잘못 발화시킨다**.\r\n537:1. **범위는 部材 단위 전사 입력이다** — `Member.wallExtent?: { vertical?: { anchor: '下端' | '上端'; heightMm: number }, horizontal?: { anchor: '始端' | '終端'; lengthMm: number } }`. 단면이 아니라 부재에 붙는 이유는 ADR-029의 `openings`와 같다 — 같은 符号의 벽이 여러 장 서는데 형상은 장마다 다르다. 축마다 optional이고 미지정은 「그 축은 全内法」이다. **schemaVersion을 올리지 않는다** — optional 추가이고 기본값이 현행과 같아 같은 案件의 数量이 변하지 않는다(ADR-034·036과 같은 판단 기준).\r\n541:5. **부분 높이 벽의 縦筋 継手는 0か所로 읽는다 — 제품의 읽기다.** 2（５）壁1)②는 「縦筋の継手は原則として各階に１か所あるものとし、開口部腰壁、手すり壁等の継手はないものとする」인데, 但書가 이름으로 든 것은 開口部腰壁·手すり壁이고 下り壁은 이름이 없다. 그러나 원칙(各階1か所)은 縦筋이 階를 관통하는 것을 전제로 하고 부분 높이 벽의 縦筋은 관통하지 않으므로, **높이 범위가 지정된 벽**은 但書 쪽으로 읽는다. ADR-029·036과 같은 성격으로 R2에 적는다. 룰팩 신규는 **0행** — 이미 있는 `measure.splice.wall.opening`(0か所, ADR-029)을 그대로 조회한다. 부분 길이만인 벽(袖壁)은 縦筋이 관통하므로 현행대로 各階1か所이고, 横筋 継手는 어느 경우든 1通則4)라 길이가 짧아지면 저절로 줄어든다.\r\n542:6. **開口의 국소 좌표는 그 벽의 범위 원점을 쓴다** — `Opening.xMm/yMm`는 内法域의 원점 기준이고(ADR-029), 범위가 지정되면 内法域이 그 범위다. 부분 벽에도 開口는 뚫릴 수 있고 欠除은 같은 규약으로 계상된다. 3D의 콘크리트 상자·배근 원점도 같은 원점으로 옮긴다.\r\n547:**맥락**: 지금 부재를 만드는 길은 셋뿐이다 — 샘플 案件, 伏図 취입(`apply.ts`), 그리고 없다. 平面 페인은 표시와 開口·범위 입력만 한다(ADR-029·037). 그래서 도면이 없는 사용자는 벽 하나를 더할 수도, 잘못 들어온 床板 하나를 지울 수도 없다. 한편 벽·床板의 内法은 다른 부재가 정한다 — 벽의 内法高さ는 그 辺의 大梁가(`girderDepthAboveWall`), 内法長さ는 양 끝 柱가(`supportColumnSection`), 床板의 内法은 네 변의 大梁가 정한다. 이 중 `girderDepthAboveWall`은 **`MemberUnsupportedError`가 아니라 plain `Error`**를 던지고 `useTakeoff`는 前者만 잡으므로(`src/lib/hooks/useTakeoff.ts:120`), 大梁 없는 辺의 벽은 부재 하나가 떨어지는 것이 아니라 **화면이 통째로 죽는다**.\r\n553:4. **부재 id는 伏図 취입과 같은 규약을 쓴다** — `${storyId}-${mark}-${ix}-${iy}[-${axis}]`. 같은 id가 이미 있으면 놓지 않는다(같은 자리에 같은 符号을 두 번 놓는 것이 그 경우다). 서로 다른 符号이 같은 辺에 서는 것은 막지 않는다 — 겹침 검사는 만들지 않는다(ADR-037 §7).\r\n557:### ADR-039: 片持床板을 만든다 — ADR-028의 「두 원문 0건」 전제는 틀렸다\r\n559:**맥락**: ADR-028은 `片持床板`과 `配力筋`을 「두 원문 0건」으로 묶어 둘 다 만들지 않았고, 그 서술이 `CLAUDE.md`·`docs/MILESTONES.md`에 그대로 실려 있다. 원문을 다시 세어 보니 **0건인 것은 `配力筋`뿐이다** — 「片持」는 `数量積算基準`에 6건(PDF p15·16·21·22×2·25), `標準仕様書`에 8건(p33·36×2·37×4·60) 있고 그중 넷은 片持床板에 직접 걸린다. 근거를 갖고 있으면서 만들지 않은 것이므로 전제를 고치고 만든다.\r\n566:- 같은 표 5.3.1 注1 — 「**片持ちスラブ先端**、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」 원문이 片持의 先端과 壁의 自由端을 같은 자리에서 다룬다 — ADR-037이 벽에 세운 자유단 판단을 원문이 지지한다.\r\n570:2. **위치는 지지하는 辺이고, 내미는 치수는 設計図書 전사다** — 片持床板의 `position`은 ベイ가 아니라 支持辺(`GirderPosition` 형태)이고, `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`가 내미는 쪽과 치수를 받는다(`正` ＝ 支持辺의 축에 직교하는 通り芯 index가 커지는 쪽). 조문은 内法 준용만 말하고 내미는 치수를 정하지 않으므로 전사 입력이다 — ADR-037과 같은 이유·같은 형태. `kind: '床板'`이면서 `axis`를 가진 position이 곧 片持이다. 스키마 버전은 올리지 않는다(optional 추가, 기존 案件 数量 불변).\r\n572:4. **자유단에는 定着이 없다** — 네 변 중 접속하는 것은 支持辺 하나뿐이다. 내미는 방향의 철근은 支持辺 쪽에만 定着하고 先端은 1通則1)「先端で止まる鉄筋はコンクリートの設計寸法」으로 加算이 없다(`measure.tip.length.addition`, ADR-025의 柱 최상단과 같은 행). 支持辺과 나란한 방향의 철근은 **양 끝이 다 자유단이라 定着이 0회**다 — 2（４）床板1)의 「接続する梁、壁等」이 없기 때문이고, ADR-037 §3과 같은 읽기다(R2).\r\n574:6. **継手는 1通則4)다** — 2（４）床板2) 但書가 片持를 連続床板 区分表에서 빼므로, 13.5m 상한의 `継手箇所数不明`(ADR-028)에 걸리지 않는다.\r\n--- diff stat ---\r\n--- diff names ---\r\n--- key diff ---\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
