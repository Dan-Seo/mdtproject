 => {\r\n 413:       useAppStore.getState().selectMember(wall.id)\r\n 414:     })\r\n 415:     return wall\r\n 416:   }\r\n 417: \r\n 418:   it('tells the user to pick a ?먬쐡鶯?or 佯딀씮 first', () => {\r\n 419:     render(<PlanEditor />)\r\n 420: \r\n 421:     expect(screen.getByTestId('opening-editor-hint')).toBeInTheDocument()\r\n 422:     expect(screen.queryByTestId('opening-editor')).not.toBeInTheDocument()\r\n 423:   })\r\n 424: \r\n 425:   it('does not offer openings for ????1?싧뎴8) names 囹볝꺕?뷴뀯??, () => {\r\n 426:     render(<PlanEditor />)\r\n 427:     fireEvent.click(screen.getByRole('button', { name: 'C1 1F-X2Y2' }))\r\n 428: \r\n 429:     expect(screen.queryByTestId('opening-editor')).not.toBeInTheDocument()\r\n 430:   })\r\n 431: \r\n 432:   it('adds an opening that fits inside the ?끾퀡 of the selected wall', () => {\r\n 433:     const wall = selectWall()\r\n 434:     render(<PlanEditor />)\r\n 435: \r\n 436:     fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n 437: \r\n 438:     const stored = useAppStore\r\n 439:       .getState()\r\n 440:       .project.members.find(({ id }) => id === wall.id)!.openings!\r\n 441:     expect(stored).toHaveLength(1)\r\n 442:     // ?끾퀡 5200횞3450 ??릎鸚?겓 1/3 ??ㄷ?띲걬 ??營?걚?잏옱?볝겓??겳?뷩걬?ゃ걚??\r\n 443:     const [opening] = stored\r\n 444:     expect(opening.xMm).toBeGreaterThanOrEqual(0)\r\n 445:     expect(opening.yMm).toBeGreaterThanOrEqual(0)\r\n 446:     expect(opening.xMm + opening.widthMm).toBeLessThanOrEqual(5200)\r\n 447:     expect(opening.yMm + opening.heightMm).toBeLessThanOrEqual(3450)\r\n 448:     expect(capture).toHaveBeenCalledWith('opening_edited', {\r\n 449:       memberKind: '?먬쐡鶯?,\r\n 450:     })\r\n 451:   })\r\n 452: \r\n 453:   it('edits an opening dimension through updateProject', () => {\r\n 454:     const wall = selectWall()\r\n 455:     render(<PlanEditor />)\r\n 456:     fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n 457: \r\n 458:     const width = screen.get