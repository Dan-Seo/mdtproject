withoutWalls = {\r\n 316:       ...project,\r\n 317:       members: project.members.filter(({ kind }) => kind !== '?먬쐡鶯?),\r\n 318:     }\r\n 319:     const first = placePlanMember(withoutWalls, '1F', 'section-W1', {\r\n 320:       axis: 'X',\r\n 321:       ix: 0,\r\n 322:       iy: 0,\r\n 323:     })\r\n 324:     expect(first.member).toBeDefined()\r\n 325: \r\n 326:     const second = placePlanMember(first.project, '1F', 'section-W1', {\r\n 327:       axis: 'X',\r\n 328:       ix: 0,\r\n 329:       iy: 0,\r\n 330:     })\r\n 331:     expect(second.reason).toBe('duplicate')\r\n 332:     expect(second.project.members).toHaveLength(first.project.members.length)\r\n 333:   })\r\n 334: \r\n 335:   it('deletes the selected wall, including its openings and wallExtent, without changing other members', () => {\r\n 336:     const project = createSampleProject()\r\n 337:     const wall = project.members.find(({ kind }) => kind === '?먬쐡鶯?)!\r\n 338:     const withDetails = {\r\n 339:       ...project,\r\n 340:       members: project.members.map((member) =>\r\n 341:         member.id === wall.id\r\n 342:           ? {\r\n 343:               ...member,\r\n 344:               openings: [\r\n 345:                 {\r\n 346:                   id: 'opening-to-delete',\r\n 347:                   xMm: 100,\r\n 348:                   yMm: 100,\r\n 349:                   widthMm: 800,\r\n 350:                   heightMm: 800,\r\n 351:                 },\r\n 352:               ],\r\n 353:               wallExtent: {\r\n 354:                 vertical: { anchor: '訝뗧ク' as const, heightMm: 900 },\r\n 355:               },\r\n 356:             }\r\n 357:           : member,\r\n 358:       ),\r\n 359:     }\r\n 360:     setProject(withDetails)\r\n 361:     act(() => useAppStore.getState().selectMember(wall.id))\r\n 362:     render(<PlanEditor />)\r\n 363: \r\n 364:     const otherIds = withDetails.members\r\n 365:       .filter(({ id }) => id !== wall.id)\r\n 366:       .map(({ id }) => id)\r\