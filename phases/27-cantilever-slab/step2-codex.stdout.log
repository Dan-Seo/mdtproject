Project', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n\r\n    const width = screen.getByLabelText(`W1 ${wall.id} 1 ?끾퀡亮?)\r\n    fireEvent.change(width, { target: { value: '1800' } })\r\n\r\n    expect(\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .widthMm,\r\n    ).toBe(1800)\r\n  })\r\n\r\n  it('edits an ?뗥룭獒쒎섭嶺?transcription through updateProject', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n\r\n    fireEvent.change(\r\n      screen.getByLabelText(\r\n        `W1 ${wall.id} 1 ?뗥룭獒쒎섭嶺뗰펷鼇?쮫?녔쎑?뗣굢邕?쮼竊?1 孃?,\r\n      ),\r\n      { target: { value: 'D16' } },\r\n    )\r\n    fireEvent.change(\r\n      screen.getByLabelText(\r\n        `W1 ${wall.id} 1 ?뗥룭獒쒎섭嶺뗰펷鼇?쮫?녔쎑?뗣굢邕?쮼竊?1 ?ф빊`,\r\n      ),\r\n      { target: { value: '4' } },\r\n    )\r\n    fireEvent.change(\r\n      screen.getByLabelText(\r\n        `W1 ${wall.id} 1 ?뗥룭獒쒎섭嶺뗰펷鼇?쮫?녔쎑?뗣굢邕?쮼竊?1 鼇?쮫?룔걬 (mm)`,\r\n      ),\r\n      { target: { value: '1800' } },\r\n    )\r\n\r\n    const reinforcement =\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .reinforcements![0]\r\n    expect(reinforcement).toEqual({ size: 'D16', count: 4, lengthMm: 1800 })\r\n  })\r\n\r\n  it('marks a newly added zero-length row as untranscribed', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n\r\n    expect(\r\n      screen.getByTestId('opening-reinforcement-untranscribed'),\r\n    ).toHaveTextContent('?よ빪鼇?)\r\n    expect(\r\n      screen.getByTestId('opening-reinforcement-untranscribed'),\r\n    ).toHaveTextContent('?곈뇧?ヨ쮫訝듽걬?뚣겲?쎼굯')\r\n    expect(wall.id).toBeTruthy()\r\n  })\r\n\r\n  it('deletes only the selected ?뗥룭獒쒎섭嶺?row', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n\r\n    const removeButtons = screen.getAllByRole('button', {\r\n      name: /獒쒎섭嶺뗣굮?딃솮$/,\r\n    })\r\n    expect(removeButtons).toHaveLength(2)\r\n    fireEvent.click(removeButtons[0])\r\n\r\n    const stored =\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .reinforcements!\r\n    expect(stored).toHaveLength(1)\r\n  })\r\n\r\n  it('drops the reinforcements key when the last transcription row is removed', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: /獒쒎섭嶺뗣굮?딃솮$/ }),\r\n    )\r\n\r\n    const stored =\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n    expect(stored).not.toHaveProperty('reinforcements')\r\n    expect(planes).toHaveLength(4)\r\n    for (const { radius } of planes) {\r\n      expect(radius).toBeLessThan(rebarRadius(wallSection.vertical.size))\r\n    }\r\n    expectNoOverlap(planes, thin.thickness)\r\n  })\r\n\r\n  it('leaves the in-plane distribution to the domain layout', () => {\r\n    const [vertical] = generateWallRebar(\r\n      { member: wallMember, section: wallSection, span },\r\n      jpMlitRulePack,\r\n    )\r\n    const layout = stirrupPositions(\r\n      span.clearLengthMm,\r\n      wallSection.vertical.pitch,\r\n      wallSection.vertical.startOffsetMm,\r\n    )\r\n    const placements = rebarPlacements(vertical, wallSection)\r\n\r\n    // ?싥걬?밧릲?믣늽?묆겍?귛돯餓섅겘?뺛걢?ゃ걚 ???뷸???깋?▲궎?녈겗 layout ?졼걨?㎯걗?뗣?\r\n    expect(placements.map(([x]) => x)).toEqual([\r\n      ...layout.positionsMm,\r\n      ...layout.positionsMm,\r\n    ])\r\n  })\r\n})\r\n\r\ndescribe('佯딀씮??D ??2?밧릲횞2?㏂걣?욕럻?ュ룑?얇굥 (ADR-028)', () => {\r\n  const project = createSampleProject()\r\n  const slabMember = project.members.find(({ kind }) => kind === '佯딀씮')!\r\n\r\n  function slabRebars(section = slabSection): Rebar[] {\r\n    return (['X', 'Y'] as const).flatMap((axis) =>\r\n      generateSlabRebar(\r\n        { run: slabRun(project, slabMember, axis), section },\r\n        jpMlitRulePack,\r\n      ),\r\n    )\r\n  }\r\n\r\n  /** ?욕럻?밧릲?ョ쳦?ㅹ씊?믡곩츪?쎼겓?뤵걢?뚣굥?듿푶?ㅳ걤?㏛툔?뗣굢訝╉겧?뗣?*/\r\n  function barPlanes(\r\n    section = slabSection,\r\n  ): { z: number; radius: number; role: RebarRole }[] {\r\n    return slabRebars(section)\r\n      .map((rebar) => {\r\n        // ?당퇉?ⓦ겗遙섅걬?㏛빰烏ⓦ걬?쎼굥 ??訝딁ク嶺뗣겘?섅굦?꿔걣?ｃ겍訝뗣겦?썬걾?뗧궧?귝똻?ㅳ?\r\n        const segments = rebarSegments(rebar, section)\r\n        const z = Math.max(...segments.flatMap(({ from, to }) => [from[2], to[2]]))\r\n        return { z, radius: segments[0].radius, role: rebar.role }\r\n      })\r\n      .sort((left, right) => left.z - right.z)\r\n  }\r\n\r\n  it('stacks 訝뗧ク???밧릲?삡툓塋?겗2?밧릲 without letting them intersect', () => {\r\n    const planes = barPlanes()\r\n\r\n    expect(planes.map(({ role }) => role)).toEqual([\r\n      'X?밧릲訝뗧ク嶺?,\r\n      'Y?밧릲訝뗧ク嶺?,\r\n      'Y?밧릲訝딁ク嶺?,\r\n      'X?밧릲訝딁ク嶺?,\r\n    ])\r\n\r\n    // ?뗣겤?딃씊?ユ렏?쇻굥??겘 X?밧릲 ??鵝쒎쎋誤뤷뎴?㎯걗?ｃ겍誤뤸틬?ㅳ겎??겒??(ADR-019)??\r\n    // ?ｃ굤?덀걝?꾤춮?⒲걝?쀣걣繇잆걚渦쇈겲?ゃ걚?볝겏?졼걨?믦쫳?뗣?\r\n    for (let index = 1; index < planes.length; index += 1) {\r\n      const gap = planes[index].z - planes[index - 1].z\r\n      expect(gap + 1e-6).toBeGreaterThanOrEqual(\r\n        planes[index].radius + planes[index - 1].radius,\r\n      )\r\n    }\r\n  })\r\n\r\n  it('keeps every bar inside the slab thickness', () => {\r\n    for (const { z, radius } of barPlanes()) {\r\n      expect(z - radius).toBeGreaterThanOrEqual(-1e-6)\r\n      expect(z + radius).toBeLessThanOrEqual(slabSection.thickness + 1e-6)\r\n    }\r\n  })\r\n\r\n  it('shrinks the display radius when the slab is too thin for 4 layers', () => {\r\n    // 烏①ㅊ?듿푶??쫳?쎼굥?잆굙?ヨ챺凉듐걮?╉걗?뗣겗?㎯곮뻹?꾣씮?㎯겘 4掠ㅳ걣?욕럻?ュ뀯?됥겒?꾠?\r\n    // ?욍겗鸚뽧겦囹곥걤?뷩걲?뗥광?⒲걝?쀣걣繇잆걚渦쇈??뗣겗?⒲걾?됥걢?ャ겒?뗣겗?㎯곩뀯?뗥ㄷ?띲걬?얇겎\r\n    // 訝孃뗣겓潁?굙????鶯곥겎?꾠겂?╉걚?뗣겗?ⓨ릪?섉돮?꾠겎?귙굥??\r\n    const thin = { ...slabSection, thickness: 120 }\r\n    const planes = barPlanes(thin)\r\n\r\n    expect(planes).toHaveLength(4)\r\n    for (const { radius } of planes) {\r\n      expect(radius).toBeLessThan(rebarRadius(slabSection.x.bottom.size))\r\n      expect(radius).toBeGreaterThan(0)\r\n    }\r\n    for (const { z, radius } of planes) {\r\n      expect(z - radius).toBeGreaterThanOrEqual(-1e-6)\r\n      expect(z + radius).toBeLessThanOrEqual(thin.thickness + 1e-6)\r\n    }\r\n  })\r\n\r\n  it('leaves the in-plane distribution to the domain layout', () => {\r\n    const [bottom] = generateSlabRebar(\r\n      { run: slabRun(project, slabMember, 'X'), section: slabSection },\r\n      jpMlitRulePack,\r\n    )\r\n    const layout = stirrupPositions(\r\n      bottom.placement!.clearMm,\r\n      bottom.placement!.pitchMm,\r\n      bottom.placement!.startOffsetMm,\r\n    )\r\n\r\n    // X?밧릲??뎱嶺뗣겘 y ?멧를?뜰귛럻?뺞뼶?묆굮?녴걨?╉굚?꿜퍡??땿?뗣겒?꾠?\r\n    expect(rebarPlacements(bottom, slabSection).map(([, y]) => y)).toEqual(\r\n      layout.positionsMm,\r\n    )\r\n  })\r\n})\r\n\r\ndescribe('?뗥룭?ⓦ겗3D ???꾤춮?믤뼪?▲곥궠?녈궚?ゃ꺖?덀굮?뤵굤?쒌걦 (ADR-029)', () => {\r\n  const opening: Opening = {\r\n    id: 'op1',\r\n    xMm: 2000,\r\n    yMm: 900,\r\n    widthMm: 1800,\r\n    heightMm: 1200,\r\n  }\r\n\r\n  // ?끾퀡 5200횞3450?갆13@200 ??뽧꺂?귞를嶺?27?с겗?녴걾 8?с걣?뗥룭?믤Ø?뉎굥??\r\n  const span: WallSpan = {\r\n    axis: 'X',\r\n    clearLengthMm: 5200,\r\n    clearHeightMm: 3450,\r\n    startFaceOffsetMm: 400,\r\n    endFaceOffsetMm: 400,\r\n    girderDepthAboveMm: 750,\r\n  }\r\n  const holedWall: Member = {\r\n    id: '1F-W1-X1Y1-X',\r\n    kind: '?먬쐡鶯?,\r\n    memberClass: '翁?퐪',\r\n    sectionId: wallSection.id,\r\n    storyId: '1F',\r\n","exit_code":0,"status":"completed"}}
