id === supports.maxX.sectionId,\\r\\n 458:    ),\\r\\n 459:    minY: project.sections.find(\\r\\n 460:      (section) => section.id === supports.minY.sectionId,\\r\\n 461:    ),\\r\\n 462:    maxY: project.sections.find(\\r\\n 463:      (section) => section.id === supports.maxY.sectionId,\\r\\n 464:    ),\\r\\n 465:  }\\r\\n 466:  if (\\r\\n 467:    supportSections.minX?.kind !== '鸚㎪쥈' ||\\r\\n 468:    supportSections.maxX?.kind !== '鸚㎪쥈' ||\\r\\n 469:    supportSections.minY?.kind !== '鸚㎪쥈' ||\\r\\n 470:    supportSections.maxY?.kind !== '鸚㎪쥈'\\r\\n 471:  ) {\\r\\n 472:    return false\\r\\n 473:  }\\r\\n 474:\\r\\n 475:  const origin = gridPoint(project.grid, position.ix, position.iy)\\r\\n 476:  const far = gridPoint(project.grid, position.ix + 1, position.iy + 1)\\r\\n 477:  const clearX =\\r\\n 478:    far.x -\\r\\n 479:    origin.x -\\r\\n 480:    supportSections.minX.b / 2 -\\r\\n 481:    supportSections.maxX.b / 2\\r\\n 482:  const clearY =\\r\\n 483:    far.y -\\r\\n 484:    origin.y -\\r\\n 485:    supportSections.minY.b / 2 -\\r\\n 486:    supportSections.maxY.b / 2\\r\\n 487:\\r\\n 488:  return clearX > 0 && clearY > 0\\r\\n 489:}\\r\\n 490:\\r\\n 491:/** 吏?뺥븳 ?롮뿉????蹂??鸚㎪쥈媛 紐⑤몢 ?덈뒗 佯딀씮 ?쇻궎 ?꾨낫瑜?諛섑솚?쒕떎. */\\r\\n 492:export function placeableSlabPositions(\\r\\n 493:  project: Project,\\r\\n 494:  storyId: string,\\r\\n 495:): SlabPosition[] {\\r\\n 496:  const { nx, ny } = gridPointCount(project.grid)\\r\\n 497:  const positions: SlabPosition[] = []\\r\\n 498:\\r\\n 499:  for (let iy = 0; iy < ny - 1; iy += 1) {\\r\\n 500:    for (let ix = 0; ix < nx - 1; ix += 1) {\\r\\n 501:      const position = { ix, iy }\\r\\n 502:      if (canPlaceSlab(project, storyId, position)) {\\r\\n 503:        positions.push(position)\\r\\n 504:      }\\r\\n 505:    }\\r\\n 506:  }\\r\\n 507:\\r\\n 508:  return positions\\r\\n 509:}\\r\\n 510:\\r\\n 925:export function slabBay(project: Project, member: Member): SlabBay {\\r\\n 926:  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\\r\\n 927:    throw new Error(`slabBay requires a 佯딀씮: ${member.id}`)\\r\\n 928:  }\\r\\n 929:\\r\\n 930:  const { ix, iy } = member.position\\r\\n 931:  const origin = gridPoint(project.grid, ix, iy)\\r\\n 932:  const far = gridPoint(project.grid, ix + 1, iy + 1)\\r\\n 933:\\r\\n 934:  const edge = (\\r\\n 935:    axis: 'X' | 'Y',\\r\\n 936:    edgeIx: number,\\r\\n 937:    edgeIy: number,\\r\\n 938:  ): SlabEdgeSupport => {\\r\\n 939:    const { member: girder, section } = girderSectionAt(\\r\\n 940:      project,\\r\\n 941:      member.storyId,\\r\\n 942:      axis,\\r\\n 943:      edgeIx,\\r\\n 944:      edgeIy,\\r\\n 945:      member,\\r\\n 946:    )\\r\\n 947:    return {\\r\\n 948:      memberId: girder.id,\\r\\n 949:      widthMm: section.b,\\r\\n 950:      cover: coverConditions(section),\\r\\n 951:    }\\r\\n 952:  }\\r\\n 953:\\r\\n 954:  // X?밧릲??냵力뺛굮黎뷩굙?뗣겗??Y?싥굤竊덄를?ヨ뎔?뗰펹鸚㎪쥈??퉭?㎯걗????壅겹굥?묆걤??\\r\\n 955:  // 亮끹굮歷с굥?묆걤?뚨쎍雅ㅳ걲?뗣겗?㎯곥걪?볝굮?뽧굤?뺛걟?뗣겏?끾퀡?뚦뀯?뚧쎘?뤵굥??\\r\\n 956:  const supports = {\\r\\n 957:    minX: edge('Y', ix, iy),\\r\\n 958:    maxX: edge('Y', ix + 1, iy),\\r\\n 959:    minY: edge('X', ix, iy),\\r\\n 960:    maxY: edge('X', ix, iy + 1),\\r\\n 961:  }\\r\\n 962:\\r\\n 963:  const centerSpanXMm = far.x - origin.x\\r\\n 964:  const centerSpanYMm = far.y - origin.y\\r\\n 965:  const startFaceOffsetXMm = supports.minX.widthMm / 2\\r\\n 966:  const startFaceOffsetYMm = supports.minY.widthMm / 2\\r\\n 967:  const clearXMm =\\r\\n 968:    centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\\r\\n 969:  const clearYMm =\\r\\n 970:    centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\\r\\n 971:\\r\\n 972:  if (clearXMm <= 0 || clearYMm <= 0) {\\r\\n 973:    throw new MemberUnsupportedError(\\r\\n 974:      '野멩퀡訝띷닇塋?,\\r\\n 975:      `佯딀씮 ?끾퀡?룔걬 must be positive: ${member.id} ` +\\r\\n 976:        `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\\r\\n 977:    )\\r\\n 978:  }\\r\\n 979:\\r\\n 980:  return {\\r\\n 981:    centerSpanXMm,\\r\\n 982:    centerSpanYMm,\\r\\n 983:    clearXMm,\\r\\n 984:    clearYMm,\\r\\n 985:    startFaceOffsetXMm,\\r\\n 986:    startFaceOffsetYMm,\\r\\n 987:    supports,\\r\\n 988:  }\\r\\n 989:}\\r\\n 990:\\r\\n 991:/**\\r\\n 992: * ?뚥???씊??틞?욍걣鸚㎪쥈?믧싥걮??ｃ겒?뗧칱?????곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞??) ??\\r\\n 993: * ?뚦릪訝??푶??말嶺뗣걣歟곥곩즯嶺됥굮?싥걮??ｇ텥?쇻굥?닷릦?띲걣?볝굦?㎯걗?뗣?\\r\\n 994: *\\r\\n 995: * 鸚㎪쥈??꺀??(girderRun) ?ⓨ릪?섇숱?졼??쇻궎?ゃ굢?룔걬1??꺀?녈겎?뚦뜕?у틞?욍띲?\\r\\n 996: * 2?쇻궎餓δ툓?ゃ굢?뚪ｇ텥?쇻굥佯딀씮?띲겓?ゃ굤?곭텤?뗧츋??겹겗?→뻼??2竊덌폇竊됧틞??) ??\\r\\n 997: * ?뉎굤?욍굩?뗣괱?밧릲?쮇?밧릲?㎩닪??꺀?녈굮?곥겇 ??佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥?뗣굢?졼?\\r\\n 998: */\\r\\n 999:export interface SlabRun {\\r\\n1000:  axis: 'X' | 'Y'\\r\\n1001:  /** 邕멩뼶?묆겗?뉔젂?귛뜕?у틞?욍겒?됮빓?? */\\r\\n1002:  members: Member[]\\r\\n1003:  /** ?싥걮嶺뗣굮躍겼콪?뺛걵?뗩깿??竊?members[0].id */\\r\\n1004:  ownerId: string\\r\\n1005:  /** members ?ⓨ릪?섌젂佯?*/\\r\\n1006:  bays: SlabBay[]\\r\\n1007:  /**\\r\\n1008:   * ?⒲꺍?잏궧竊덂쭓塋?겗鸚㎪쥈??냵?닻씊竊됥걢?됧릢?쇻궎??냵力뺝윜??쭓?얇굤?얇겎??퇌??(mm)??\\r\\n1009:   * bays ?ⓨ릪?섌젂佯뤵겎 [0] ??0 ?㎯걗?뗣?D ?뚣꺀?녈굮1?ㅳ겗?졼겓?뤵걦?ⓦ걤??\\r\\n1010:   * ?꾠깧?ㅳ겗嶸긱굮?볝걪?ョ쉰?????뤹뵽?담겎擁녈걮?담걲?③뀓嶺뗣겏?싥굦?뗣?\\r\\n1011:   */\\r\\n1012:  memberOffsetsMm: number[]\\r\\n1013:  /** ?⒲꺍??빓 (mm) 竊?誇?끾퀡?룔걬 竊?誇訝?뼋鸚㎪쥈??퉭 */\\r\\n1014:  coreLengthMm: number\\r\\n1015:  /** ?꿜퍡?밧릲竊덁말嶺뗣겏?답벡?쇻굥?묆걤竊됥겗?끾퀡?룔걬 (mm) ???⒲꺍?끹겎?깁싥겎?귙굥 */\\r\\n1016:  distributionClearMm: number\\r\\n1017:  /** 冶뗧ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\\r\\n1018:  startSupport: SlabEdgeSupport\\r\\n1019:  /** 永귞ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\\r\\n1020:  endSupport: SlabEdgeSupport\\r\\n1021:  /**\\r\\n1022:   * ?⒲꺍?ラ뼀?꾠겍?꾠굥?뗥룭??(1?싧뎴8))??*?⒲꺍?잏궧?뗣굢??벨與?*?ョ쎍?쀣걼?귙겗??\\r\\n1023:   *\\r\\n1024:   * ?뗥룭??깧?ㅿ펷竊앶깿?먲펹?붵겏?ュ뀯?쎼걬?뚣굥?뚣곩틞?욍겗?꾤춮??꺀?녈겎歷с굥??겎??\\r\\n1025:   * 轝좈솮??D??늾?딀쵟?띲굚?⒲꺍佯㎪쮽?㎬쫳?뗣귙걪?볝겎訝佯╉걽?묊쎍?쀣겍?듽걢?ゃ걚?ⓦ?\\r\\n1026:   * ?곈뇧?②〃鹽뷩걣?γ끹겓?쇻궎??궕?뺛궩?껁깉?믦떨?쀧쎍?쀣겍繇잆걚?뺛걝 (ADR-029)??\\r\\n1027:   */\\r\\n1028:  openings: Opening[]\\r\\n1029:}\\r\\n1030:\\r\\n1031:export function slabRun(\\r\\n1032:  project: Project,\\r\\n1033:  member: Member,\\r\\n1034:  axis: 'X' | 'Y',\\r\\n1035:): SlabRun {\\r\\n1036:  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\\r\\n1037:    throw new Error(`slabRun requires a 佯딀씮: ${member.id}`)\\r\\n1038:  }\\r\\n1039:\\r\\n1040:  const { ix, iy } = member.position\\r\\n1041:  const slabAt = (\\r\\n1042:    candidateIx: number,\\r\\n1043:    candidateIy: number,\\r\\n1044:  ): Member | undefined =>\\r\\n1045:    project.members.find(\\r\\n1046:      (candidate) =>\\r\\n1047:        candidate.kind === '佯딀씮' &&\\r\\n1048:        candidate.storyId === member.storyId &&\\r\\n1049:        // ?뚥???씊?㎯걗?뗣걪?ⓦ굮?ｇ텥??씉餓뜰겓?쇻굥?귝씉?뉎겘?뚦릪訝??푶??말嶺뗣걣?띲겏\\r\\n1050:        // 鼇?녴걣?곩푶?뚦릪?섅겎?귙깞?껁긽?뚪걬?덀겙?③깿??뎱嶺뗣걣?싥굥?뤵걨?㎯겘?ゃ걚 ??\\r\\n1051:        // ??씊?뚦릪?섅걪?ⓦ겘?앫겗?곩늽?▽뻑?㎯걗?ｃ겍?곩쎋?㏂겓?ゃ걚?ｇ텥?믢퐳?됥겒?꾠?\\r\\n1052:        candidate.sectionId === member.sectionId &&\\r\\n1053:        isSlabPosition(candidate.position) &&\\r\\n1054:        candidate.position.ix === candidateIx &&\\r\\n1055:        candidate.position.iy === candidateIy,\\r\\n1056:    )\\r\\n1057:\\r\\n1058:  const step = (offset: number): [number, number] =>\\r\\n1059:    axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\\r\\n1060:\\r\\n1061:  const members: Member[] = [member]\\r\\n1062:  for (let offset = -1; ; offset -= 1) {\\r\\n1063:    const previous = slabAt(...step(offset))\\r\\n1064:    if (!previous) break\\r\\n1065:    members.unshift(previous)\\r\\n1066:  }\\r\\n1067:  for (let offset = 1; ; offset += 1) {\\r\\n1068:    const next = slabAt(...step(offset))\\r\\n1069:    if (!next) break\\r\\n1070:    members.push(next)\\r\\n1071:  }\\r\\n1072:\\r\\n1073:  const bays = members.map((candidate) => slabBay(project, candidate))\\r\\n1074:  const clearAlong = (bay: SlabBay): number =>\\r\\n1075:    axis === 'X' ? bay.clearXMm : bay.clearYMm\\r\\n1076:  const clearAcross = (bay: SlabBay): number =>\\r\\n1077:    axis === 'X' ? bay.clearYMm : bay.clearXMm\\r\\n1078:\\r\\n1079:  // ?꿜퍡?ф빊??1?싧뎴7) ?뚣뚣걹??깿?녴겗?룔걬?띲굮?꾤춮??뼋?붵겎?ㅳ걮??콆?곥굥1?ㅳ겗?겹걽??\\r\\n1080:  // ?⒲꺍??붶릎?㎫쎍雅ㅶ뼶?묆겗?끾퀡?뚦쨯?뤵굦?겹곥걹???ㅳ겗?겹걣?⒲걾?됥겗?쇻궎?㎯굚閭ｃ걮??\\r\\n1081:  // ?ゃ굢?ゃ걚 ??訝?ⓦ걽?묌싥굥?꾤춮?믦＝?곥걣烏①뤎?㎯걤?ゃ걚??겎?곦퐳?됥걳?ヨ맼?ⓦ걲??\\r\\n1082:  const distributionClearMm = clearAcross(bays[0])\\r\\n1083:  const uneven = bays.findIndex(\\r\\n1084:    (bay) => clearAcross(bay) !== distributionClearMm,\\r\\n1085:  )\\r\\n1086:  if (uneven > 0) {\\r\\n1087:    throw new MemberUnsupportedError(\\r\\n1088:      '野멩퀡訝띷닇塋?,\\r\\n1089:      `佯딀씮?⒲꺍?끹겎?꿜퍡?밧릲??냵力뺡빓?뺛걣?껁굩?ゃ걚: ${members[0].id} ` +\\r\\n1090:        `(${distributionClearMm} mm) ??${members[uneven].id} ` +\\r\\n1091:        `(${clearAcross(bays[uneven])} mm)`,\\r\\n1092:    )\\r\\n1093:  }\\r\\n1094:\\r\\n1095:  // 訝?뼋鸚㎪쥈??퉭??뚦퉭??/2?띲걣訝▼겢?뗣굢?γ겍1?у늽?ャ겒????2竊덌폇竊됧틞??) ??\\r\\n1096:  // 鵝녷쎑?뚣걹?녶츣?곥굥?귛ㄷ歟곥겗?⒲꺍??빓?뚥릎?볠윶?쎼걚?믦떨?쇻겗?ⓨ릪?섇숱?졼?\\r\\n1097:  // ?쇻궎??쭓?얇굤?믢?佯╉걽?묊눕令띲걮?곫?孃뚣겗?쇻궎??쭓?얇굤 竊??앫겗?끾퀡?믦뒸?룔겏?쇻굥 ??\\r\\n1098:  // 雅뚣겇?믣닪?끹겓?겹걟?뗣겏?쇻걧繇잆걚?뺛걝竊덂ㄷ歟곥겗?⒲꺍?ⓨ릪?섊큵?잞펹??\\r\\n1099:  const memberOffsetsMm: number[] = []\\r\\n1100:  let offsetMm = 0\\r\\n1101:  for (const bay of bays) {\\r\\n1102:    memberOffsetsMm.push(offsetMm)\\r\\n1103:    offsetMm +=\\r\\n1104:      clearAlong(bay) +\\r\\n1105:      (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\\r\\n1106:  }\\r\\n1107:  const coreLengthMm =\\r\\n1108:    memberOffsetsMm[memberOffsetsMm.length - 1] +\\r\\n1109:    clearAlong(bays[bays.length - 1])\\r\\n1110:\\r\\n1111:  const first = bays[0]\\r\\n1112:  const last = bays[bays.length - 1]\\r\\n1113:\\r\\n1114:  // ?쇻궎掠???뼀?ｃ굮?⒲꺍佯㎪쮽?며㎉?쇻귟뎔?뗥릲?띲겓?졼걨?쇻궎??궕?뺛궩?껁깉?뚥퉿????\\r\\n1115:  // ?답벡?밧릲??냵力뺛겘?⒲꺍?끹겎?깁싥겒??겎竊덁툓?㎯걹?뚣굮濾쒏읅?쀣겍?꾠굥竊됥걹??겲?얇걽??\\r\\n1116:  const openings = members.flatMap((candidate, index) =>\\r\\n1117:    (candidate.openings ?? []).map((opening) => ({\\r\\n1118:      ...opening,\\r\\n1119:      xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\\r\\n1120:      yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\\r\\n1121:    })),\\r\\n1122:  )\\r\\n1123:\\r\\n1124:  return {\\r\\n1125:    axis,\\r\\n1126:    members,\\r\\n1127:    ownerId: members[0].id,\\r\\n1128:    bays,\\r\\n1129:    memberOffsetsMm,\\r\\n1130:    coreLengthMm,\\r\\n1131:    distributionClearMm,\\r\\n1132:    startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\\r\\n1133:    endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\\r\\n1134:    openings,\\r\\n1135:  }\\r\\n1136:}\\r\\n1137:\\r\\n1138:export interface GirderRun {\\r\\n--- phase 27 base diff / tests ---\\r\\ncommit 682355e7543a16f3e976b34a9dc2f8ab2a773812\\nAuthor: Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\\nDate:   Wed Aug 26 23:18:08 2026 +0900\\n\\n    spec(27-cantilever-slab): 片持床板을 만든다 — ADR-028의 0건 전제를 고친다\\n    \\n    ADR-039. 원문을 다시 세어 보니 「두 원문 0건」인 것은 配力筋뿐이고 「片持」는\\n    積算基準 6건·標準仕様書 8건이다. 定義（４）·2（４）床板2) 但書·表5.3.4 L3의\\n    「（片持スラブの場合は25d）」·表5.3.5 注1·2(La 포함·Lb 제외)가 근거다.\\n    支持辺 하나만 접속하므로 나머지 세 변은 자유단이고 定着이 없다.\\n    \\n    Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>\\n\\ndiff --git a/docs/ADR.md b/docs/ADR.md\\nindex 70241ac..0027e91 100644\\n--- a/docs/ADR.md\\n+++ b/docs/ADR.md\\n@@ -553,3 +553,23 @@ python -c \\\"import fitz,sys; d=fitz.open(sys.argv[1]); [print(t, [i+1 for i,p in\\n 4. **부재 id는 伏図 취입과 같은 규약을 쓴다** — `${storyId}-${mark}-${ix}-${iy}[-${axis}]`. 같은 id가 이미 있으면 놓지 않는다(같은 자리에 같은 符号을 두 번 놓는 것이 그 경우다). 서로 다른 符号이 같은 辺에 서는 것은 막지 않는다 — 겹침 검사는 만들지 않는다(ADR-037 §7).\\n 5. **지우면 그 부재의 開口·범위도 함께 사라진다** — 둘 다 부재에 붙어 있다. 되돌리기는 만들지 않는다(제품에 undo가 없고, 이 결정으로 만들지 않는다).\\n 6. **하지 않는 것**: 柱·大梁 배치·삭제, 격자(通り芯) 편집(이미 `SpanEditor`가 있다), 겹침·중복 배치 검사, 되돌리기, 3D 뷰에서의 배치.\\n+\\n+### ADR-039: 片持床板을 만든다 — ADR-028의 「두 원문 0건」 전제는 틀렸다\\n+\\n+**맥락**: ADR-028은 `片持床板`과 `配力筋`을 「두 원문 0건」으로 묶어 둘 다 만들지 않았고, 그 서술이 `CLAUDE.md`·`docs/MILESTONES.md`에 그대로 실려 있다. 원문을 다시 세어 보니 **0건인 것은 `配力筋`뿐이다** — 「片持」는 `数量積算基準`에 6건(PDF p15·16·21·22×2·25), `標準仕様書`에 8건(p33·36×2·37×4·60) 있고 그중 넷은 片持床板에 직접 걸린다. 근거를 갖고 있으면서 만들지 않은 것이므로 전제를 고치고 만든다.\\n+\\n+**근거 조문(전사 확인)**:\\n+- `数量積算基準` 第4編第1章第2節（４）床板 — 「片持床板等もこれらに準ずる。」 즉 片持도 「柱、梁等に接する水平材の内法部分」이다.\\n+- 같은 기준 2（４）床板2) 但書 — 「単独床板及び片持床板の主筋の継手は、1通則4)による。」 連続床板의 区分表가 아니라 길이 기반이다.\\n+- `標準仕様書` 表5.3.4 L3 スラブ欄 — 「10d かつ150mm以上（**片持スラブの場合は25d**）」. 下端筋 直線定着이 갈린다.\\n+- 같은 표 5.3.5 注1·2 — La는 「基礎梁、片持梁及び**片持スラブを含む**」, Lb는 「片持小梁及び**片持スラブを除く**」. 上端筋 折曲げ定着의 投影 열이 Lb가 아니라 **La**다.\\n+- 같은 표 5.3.1 注1 — 「**片持ちスラブ先端**、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」 원문이 片持의 先端과 壁의 自由端을 같은 자리에서 다룬다 — ADR-037이 벽에 세운 자유단 판단을 원문이 지지한다.\\n+\\n+**결정**:\\n+1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로이고 片持床板은 `kind: '床板'`이다. 갈리는 것은 **지지 조건**이지 부재가 아니다(ADR-036이 雑壁을 区分으로 담은 것과 같은 형태).\\n+2. **위치는 지지하는 辺이고, 내미는 치수는 設計図書 전사다** — 片持床板의 `position`은 ベイ가 아니라 支持辺(`GirderPosition` 형태)이고, `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`가 내미는 쪽과 치수를 받는다(`正` ＝ 支持辺의 축에 직교하는 通り芯 index가 커지는 쪽). 조문은 内法 준용만 말하고 내미는 치수를 정하지 않으므로 전사 입력이다 — ADR-037과 같은 이유·같은 형태. `kind: '床板'`이면서 `axis`를 가진 position이 곧 片持이다. 스키마 버전은 올리지 않는다(optional 추가, 기존 案件 数量 불변).\\n+3. **잰다** — 長さ 방향(내미는 방향)은 `projectionMm`, 폭 방향은 支持辺의 内法長さ(柱면~柱면)다. 부분 폭은 만들지 않는다 — 조문에 근거가 없고 필요해지면 그때 넓힌다.\\n+4. **자유단에는 定着이 없다** — 네 변 중 접속하는 것은 支持辺 하나뿐이다. 내미는 방향의 철근은 支持辺 쪽에만 定着하고 先端은 1通則1)「先端で止まる鉄筋はコンクリートの設計寸法」으로 加算이 없다(`measure.tip.length.addition`, ADR-025의 柱 최상단과 같은 행). 支持辺과 나란한 방향의 철근은 **양 끝이 다 자유단이라 定着이 0회**다 — 2（４）床板1)의 「接続する梁、壁等」이 없기 때문이고, ADR-037 §3과 같은 읽기다(R2).\\n+5. **定着 값이 갈리는 두 곳** — 下端筋의 L3은 `片持スラブ` 조건으로 25d(＋같은 칸의 150mm 하한을 그대로 딸린다), 上端筋 折曲げ의 投影은 `Lb`가 아니라 `La`다. 5.3.4(5)(ｲ)(c)의 「柱せいの3/4以上」은 **끌어오지 않는다** — 그 하한이 재는 것은 柱せい인데 片持床板은 柱에 정착하지 않는다(제품의 읽기, R2). 룰팩 신규는 L3의 片持 행뿐이고 La는 기존 행을 그대로 조회한다.\\n+6. **継手는 1通則4)다** — 2（４）床板2) 但書가 片持를 連続床板 区分表에서 빼므로, 13.5m 상한의 `継手箇所数不明`(ADR-028)에 걸리지 않는다.\\n+7. **하지 않는 것**: 断面リスト 파서의 片持スラブリスト 대응(전사 픽스처가 「値は転写省略」이라 골든이 설 자리가 없다 — 재전사가 선결이다), 先端筋·開口補強筋 이외의 補強筋(2（４）床板1)이 設計図書에 위임), 부분 폭 片持, 片持梁·片持小梁(小梁은 ADR-005로 만들지 않는다), 表5.3.1 注1의 4d 余長(加工 형상이고 数量은 1通則1)로 정해진다 — R12와 같은 자리에 둔다).\\ndiff --git a/phases/27-cantilever-slab/step1.md b/phases/27-cantilever-slab/step1.md\\nnew file mode 100644\\nindex 0000000..57ae63d\\n--- /dev/null\\n+++ b/phases/27-cantilever-slab/step1.md\\n@@ -0,0 +1,65 @@\\n+# Step 1: 片持床板 — 모델·룰팩·산정, 골든 먼저\\n+\\n+**전제**: step 0이 `completed`(전제 유지)로 끝났을 때만 진행하라. `refuted`면\\n+`blocked`로 멈추고 반증 요지를 적어라 — 저자의 ADR 정정을 기다린다.\\n+\\n+## 배경\\n+\\n+`docs/ADR.md`의 ADR-005·028·029·037·**039**를 읽어라. 片持床板은 부재가 아니라\\n+**지지 조건이 하나뿐인 床板**이다. 갈리는 것은 넷 — 위치·치수(支持辺＋\\n+projection), 자유단의 定着(없음), L3의 25d, 投影의 La.\\n+\\n+## 할 일 (골든 먼저 — TDD)\\n+\\n+1. **골든** — `tests/golden/fixtures/quantity-r5-ch3.json`에 片持床板 케이스를\\n+   더하라(최소 2건).\\n+   - **내미는 방향의 主筋**: 設計長さ ＝ projection ＋ 支持辺 쪽 定着 **1회**,\\n+     先端은 1通則1)로 加算 0. 上端筋은 折曲げ면 投影 **La**, 下端筋은 L3\\n+     **25d**(＋150mm 하한, step 0 §3의 판단대로). 割付은 支持辺의 内法長さ.\\n+   - **支持辺과 나란한 방향**: 定着 **0회**, 割付은 projection.\\n+   - 継手는 1通則4)(길이 기반)이고 連続床板 区分表에 걸리지 않는 것을 핀하라.\\n+   `handDerivation`에 손 유도(定着 회수·割付 本数·設計長さ·질량)와 출처\\n+   조항을 적어라. **기존 케이스의 기대값 수정 금지** — 바꿔야 통과하면 `blocked`.\\n+2. **모델** — `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`\\n+   (ADR-039 §2, 주석에 「支持辺의 축에 직교하는 通り芯 index가 커지는 쪽이 正」).\\n+   `kind: '床板'`이면서 position이 `GirderPosition` 형태면 片持다.\\n+   `project.ts` 검증: optional·두 값·양수 유한, 床板 이외가 들면 거부,\\n+   `cantilever`가 있는데 position이 ベイ이거나 그 반대면 거부. 왕복·기존\\n+   레코드 호환을 테스트로 고정하라. **schemaVersion을 올리지 마라.**\\n+3. **룰팩** — 表5.3.4 L3 スラブ欄의 「（片持スラブの場合は25d）」를\\n+   `src/rulepack/jp-mlit/anchorage.yaml`에 `片持スラブ` 조건으로 실어라.\\n+   150mm 하한의 재사용 여부는 step 0 §3의 판단을 따르고, 재사용이 안 되면\\n+   같은 조건의 행을 하나 더 만들어라. `source`는 기존 L3 행과 같은 자리\\n+   (表5.3.4, printedPage 동일), `confidence: transcribed`, `note`도 기존\\n+   형식을 따르라. `spec-r7-ch5.json`의 해당 항목에서 「片持スラブを作らないので\\n+   取らない」 취지의 `reason`을 지우고 **entries로 옮겨라** — spec-tables\\n+   테스트가 룰팩과의 동시 수정을 강제한다. `La`·`measure.tip.length.addition`은\\n+   **신규 행 없이 기존 행을 조회**하라. 다른 룰팩 행 신규·수정 금지.\\n+4. **기하** — 片持床板의 内法(폭 ＝ 支持辺 内法長さ, 길이 ＝ projection)을 내는\\n+   경로를 만들어라. step 0의 `twoSupportSites` 목록이 무대다. 양쪽 지지를\\n+   전제한 코드가 한쪽 지지에서 조용히 잘못된 값을 내지 않게 하라 —\\n+   불가능한 형상은 `MemberUnsupportedError('寸法不成立')`다(plain Error 금지,\\n+   ADR-038 §3). 支持辺에 大梁·양 끝 柱가 없으면 그렇게 떨어진다.\\n+5. **산정** — 자유단 定着 0회(ADR-039 §4), L3 25d, 投影 La, 継手 1通則4).\\n+   算出式에 자유단과 근거 조항을 적어라. 連続床板 런에 片持가 섞여 들어가지\\n+   않게 하라 — 片持는 언제나 단독이다.\\n+6. **다른 부재의 골든이 변하면 반칙이다** — `blocked`로 멈춰라.\\n+\\n+## 하지 말 것\\n+\\n+- `src/components/**`·`src/lib/viewer/**`·`src/lib/import/**` 수정 금지.\\n+- `MemberKind` 추가 금지. 부분 폭 片持·片持梁·小梁 금지 (ADR-039 §7).\\n+- 5.3.4(5)(ｲ)(c)의 「柱せいの3/4」를 끌어오지 마라 (ADR-039 §5).\\n+- 배근 규준 수치를 코드에 쓰지 마라.\\n+- **`phases/**/step*-codex.*.log`·`step*-invoke.json`을 지우지 마라.**\\n+- **검증 스크립트를 `src/` 아래에 만들지 마라** — phase 디렉터리 안에 둬라.\\n+- `scripts/execute.py` 금지 — 재귀다.\\n+\\n+## AC\\n+\\n+- `npm run test`·`npx tsc --noEmit`·`npm run lint` 전체 통과.\\n+\\n+## 산출물\\n+\\n+`phases/27-cantilever-slab/step1-report.json`:\\n+골든 케이스의 handDerivation 요지, 룰팩 신규 행, 변경 파일, 게이트 결과.\\ndiff --git a/phases/27-cantilever-slab/step2.md b/phases/27-cantilever-slab/step2.md\\nnew file mode 100644\\nindex 0000000..ee6f726\\n--- /dev/null\\n+++ b/phases/27-cantilever-slab/step2.md\\n@@ -0,0 +1,36 @@\\n+# Step 2: 3D·平面 표시와 배치 입력\\n+\\n+**전제**: step 1이 `completed`. 진행 중 새 반증 사유가 나오면 `blocked`.\\n+\\n+## 할 일\\n+\\n+1. **3D** — 片持床板의 콘크리트 판과 배근을 支持辺에서 `side` 쪽으로\\n+   `projectionMm`만큼 내밀어 그려라(建物 뷰·部材 뷰). 격자 **밖**으로 나가는\\n+   부재라 뷰의 경계 계산이 그것을 포함해야 한다 — 잘리면 고쳐라.\\n+2. **平面** — `PlanEditor`가 片持床板을 격자 밖에 그리고 선택할 수 있게 하라.\\n+   `drawingTransform`의 범위에 내민 부분이 들어가야 한다.\\n+3. **배치 입력** — phase 26(ADR-038)의 배치 UI에 片持床板을 더하라: 支持辺을\\n+   고르고 `side`와 `projectionMm`를 받는다. 지지 조건(大梁·양 끝 柱)이 없는\\n+   辺은 후보로 내지 마라 — 판정은 step 1의 기하 경로와 같은 근거여야 한다.\\n+   삭제는 기존 床板 삭제 경로를 그대로 쓴다.\\n+4. **테스트** — 뷰어 기하 단위 테스트와 `PlanEditor.test.tsx`에 최소 고정:\\n+   내민 판이 격자 밖에 서고, 후보 판정이 지지 조건을 따르며, 배치·삭제가\\n+   `Member`를 규약대로 만든다·지운다.\\n+5. **e2e** — 신규 금지. 기존 `uc20-slab.js`가 깨지면 갱신하되 dev 서버를\\n+   띄우지 마라(실행 검증은 리뷰어가 한다).\\n+\\n+## 하지 말 것\\n+\\n+- `src/domain/**` 수정 금지 — 필요해지면 `blocked`.\\n+- 断面リスト 파서 수정 금지 (ADR-039 §7). 배근 규준 수치 금지.\\n+- **`phases/**/step*-codex.*.log`·`step*-invoke.json`을 지우지 마라.**\\n+- **검증 스크립트를 `src/` 아래에 만들지 마라** — phase 디렉터리 안에 둬라.\\n+- `scripts/execute.py` 금지 — 재귀다.\\n+\\n+## AC\\n+\\n+- `npm run test`·`npx tsc --noEmit`·`npm run lint` 전체 통과.\\n+\\n+## 산출물\\n+\\n+`phases/27-cantilever-slab/step2-report.json`: 변경 요지, 고정한 테스트, 게이트 결과.\\ndiff --git a/phases/27-cantilever-slab/step3.md b/phases/27-cantilever-slab/step3.md\\nnew file mode 100644\\nindex 0000000..48a4705\\n--- /dev/null\\n+++ b/phases/27-cantilever-slab/step3.md\\n@@ -0,0 +1,39 @@\\n+# Step 3: 대장 정정 — 「두 원문 0건」 오기와 ADR-037 보충\\n+\\n+**전제**: step 2가 `completed`. 진행 중 새 반증 사유가 나오면 `blocked`.\\n+\\n+## 할 일 (문서만 — 코드 수정 금지)\\n+\\n+1. **오기 정정** — 「片持床板·配力筋(두 원문 0건)」은 틀렸다. 0건인 것은\\n+   `配力筋`뿐이다(step 0이 쪽수로 확인했다). 다음을 고쳐라 —\\n+   - `CLAUDE.md`·`AGENTS.md`의 부재 절: 片持床板이 phase 27(ADR-039)로\\n+     들어왔음을, `配力筋`만 0건으로 남는다는 것을 적어라.\\n+   - `docs/MILESTONES.md` 부재 확장 절: 「남은 것」에서 片持床板을 지우고\\n+     완료 내역에 근거 조문(定義（４）·2（４）床板2) 但書·表5.3.4 L3·表5.3.5\\n+     注1·2)을 적어라. **잔여가 비면 그 절의 상태 표시도 갱신하라.**\\n+   - `docs/ADR.md`의 **ADR-028**에 날짜를 붙인 정정을 덧붙여라 — 원문을\\n+     지우지 말고 「2026-08-26 정정: 「0건」은 配力筋에만 해당한다. 片持床板은\\n+     ADR-039로 들어왔다」 취지. ADR-035의 정정 형식을 본떠라.\\n+2. **ADR-037 보충** — 表5.3.1 注1이 「片持ちスラブ先端、**壁筋の自由端側の先端**」\\n+   을 같은 자리에서 다룬다. ADR-037 §3의 자유단 판단을 원문이 지지한다는\\n+   사실을 날짜를 붙여 보충하라(§3을 고치지 말고 덧붙여라). 4d 余長은 加工\\n+   형상이라 数量에 들어가지 않는다는 것(1通則1)·R12와 같은 자리)도 적어라.\\n+3. **R2 갱신** — `docs/RISKS.md` R2에 ADR-039의 두 읽기를 한 줄로 더하라:\\n+   支持辺과 나란한 철근의 定着 0회, 5.3.4(5)(ｲ)(c)의 「柱せいの3/4」 미적용.\\n+\\n+## 하지 말 것\\n+\\n+- `src/**`·`tests/**` 수정 금지 — 이 스텝은 문서다. 필요해지면 `blocked`.\\n+- 원문 조문을 요약하지 말고 인용하라. 있지도 않은 쪽수를 적지 마라.\\n+- **`phases/**/step*-codex.*.log`·`step*-invoke.json`을 지우지 마라.**\\n+- **검증 스크립트를 `src/` 아래에 만들지 마라** — phase 디렉터리 안에 둬라.\\n+- `scripts/execute.py` 금지 — 재귀다.\\n+\\n+## AC\\n+\\n+- `npm run test`·`npx tsc --noEmit`·`npm run lint` 전체 통과(문서 변경이라\\n+  게이