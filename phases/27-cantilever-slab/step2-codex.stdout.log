 with a supplied bar diameter`,\\r\\n  62:  )\\r\\n  63:}\\r\\n  64:\\r\\n  65:function uniqueRuleHits(rules: RuleHit[]): RuleHit[] {\\r\\n  66:  return [...new Set(rules)]\\r\\n  67:}\\r\\n  68:\\r\\n  69:/**\\r\\n  70: * 2竊덌폇竊됧틞??) ??뙷?녻〃?귚퐬?뷴늽?귙굥?뗣겘?ャ꺖?ャ깙?껁궚?뚧군?곥굥??겎烏뚣굮?앫겗?얇겲沃????\\r\\n  71: * 歟곥겗烏ⓦ겏?뺛걚訝딃솏?ゃ걮??뙷?녴걣?ゃ걚 ??13.5m 餓δ툓??렅?뉎겓若싥굙?뚣겒?뤵?\\r\\n  72: * bandedSpliceRule ??MemberUnsupportedError ?㎬맼?ⓦ걲??\\r\\n  73: */\\r\\n  74:function continuousSlabBands(pack: RulePack): SpliceBand[] {\\r\\n  75:  const counts = lookupRuleSeries(pack, 'measure.splice.slab.continuous', 'band')\\r\\n  76:  const upperBounds = new Map(\\r\\n  77:    lookupRuleSeries(\\r\\n  78:      pack,\\r\\n  79:      'measure.splice.slab.continuous.band.upper',\\r\\n  80:      'band',\\r\\n  81:    ).map((rule) => [rule.conditions.band, rule]),\\r\\n  82:  )\\r\\n  83:\\r\\n  84:  return counts.map((countRule) => ({\\r\\n  85:    countRule,\\r\\n  86:    upperBoundRule: upperBounds.get(countRule.conditions.band) ?? null,\\r\\n  87:  }))\\r\\n  88:}\\r\\n  89:\\r\\n  90:export function generateSlabRebar(\\r\\n  91:  input: SlabRebarInput,\\r\\n  92:  pack: RulePack,\\r\\n  93:): Rebar[] {\\r\\n  94:  const { run, section } = input\\r\\n  95:  const coverRule = lookupRule(pack, 'cover.minimum', coverConditions(section))\\r\\n  96:  const fabricationCoverAdditionRule = lookupRule(\\r\\n  97:    pack,\\r\\n  98:    'cover.fabrication.addition',\\r\\n  99:    {},\\r\\n 100:  )\\r\\n 101:  const distributionAdditionRule = lookupRule(\\r\\n 102:    pack,\\r\\n 103:    'measure.distribution.addition',\\r\\n 104:    {},\\r\\n 105:  )\\r\\n 106:  const fabricationCoverMm =\\r\\n 107:    millimetres(coverRule) + millimetres(fabricationCoverAdditionRule)\\r\\n 108:\\r\\n 109:  // ?졾램?ⓦ걢?뜰굤횞2 ?뚧씮?싥굮擁끹걟?뗣겏訝딁ク嶺뗣겏訝뗧ク嶺뗣걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂??\\r\\n 110:  // ?욍겓?ゃ굥?귡퍢?ｃ겍訝?ㄾ?ュ칱?쎼걳?곥걹??틞?욍걽?묋맼?ⓦ걲竊덅먬쐡鶯곥겗??뽧꺂?띸춮??\\r\\n 111:  // 野멩퀡?с꺖?됥겏?뚣걯?긱걚竊됥?\\r\\n 112:  if (section.thickness <= 2 * fabricationCoverMm) {\