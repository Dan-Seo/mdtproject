대쫫??吏?대궡吏 ?딅뒗??(ADR-030)\r\n 463:   const labels = axis === 'x' ? project.grid.xLabels : project.grid.yLabels\r\n 464:   const spanName = (index: number) =>\r\n 465:     labels === undefined\r\n 466:       ? `${axisLabel}?밤깙??${index + 1}`\r\n 467:       : `${labels[index]}-${labels[index + 1]}`\r\n 468:   const axisLabel = axis.toUpperCase()\r\n 469:   const editReported = useRef(false)\r\n 470: \r\n 471:   const commit = (nextSpans: number[]) => {\r\n 472:     updateProject((current) =>\r\n 473:       updateProjectSpans(current, axis, nextSpans),\r\n 474:     )\r\n 475: \r\n 476:     // number input??onChange??\"6000\"??移섎㈃ ??踰??ㅼ뼱?⑤떎. 異뺣쭏????踰덉쑝濡??⑹퀜\r\n 477:     // ?대깽?멸? ??댄븨 ?띾룄媛 ?꾨땲???몄쭛 ?щ?瑜??멸쾶 ?쒕떎.\r\n 478:     if (editReported.current) return\r\n 479:     editReported.current = true\r\n 480:     capture('grid_edited', { axis })\r\n 481:   }\r\n 482: \r\n 483:   return (\r\n 484:     <fieldset className={styles.spanFieldset}>\r\n 485:       <legend className={styles.spanLegend}>{axisLabel} ?밤깙??/legend>\r\n 486:       <div className={styles.spanList}>\r\n 487:         {spans.map((span, index) => (\r\n 488:           <div className={styles.spanItem} key={`${axis}-${index}`}>\r\n 489:             <input\r\n 490:               className={styles.spanInput}\r\n 491:               type=\"number\"\r\n 492:               min=\"1\"\r\n 493:               step=\"1\"\r\n 494:               value={span}\r\n 495:               // ?대쫫? ?꾨㈃?먯꽌 ?ㅻ㈃ 諛붾먮떎 ???먮룞 寃利앹씠 媛믪쓣 吏묐뒗 ?먮━??\r\n 496:               // ?대쫫???꾨땲??異뺢낵 ?쒕쾲?댁뼱???쒕떎\r\n 497:               data-testid={`span-${axis}-${index}`}\r\n 498:               aria-label={spanName(index)}\r\n 499:               onChange={(event) => {\r\n 500:                 const value = Number(event.currentTarget.value)\r\n 501:                 if (!Number.isFinite(value) || value <= 0) return\r\n 502:                 commit(\r\n 503:                   spans.map((current, spanIndex) =>\r\n 504:                     spanIndex === index ? value : current,\r\n 505:                   ),\r\n 506:                 )\r\n 507:               }}\r\n 508:             />\r\n 509:             <span className={styles.unit}>mm</span>\r\n 510:             <button\r\n 511:               type=\"button\"\r\n 512:               className={styles.removeButton}\r\n 513:               aria-label={`${spanName(index)}${t(\r\n 514:                 locale,\r\n 515:                 'plan.removeSpan',\r\n 516:               )}`}\r\n 517:               disabled={spans.length === 1}\r\n 518:               onClick={() =>\r\n 519:                 commit(spans.filter((_, spanIndex) => spanIndex !== index))\r\n 520:               }\r\n--- placement area ---\r\n 520:               }\r\n 521:             >\r\n 522:               ??\r\n 523:             </button>\r\n 524:           </div>\r\n 525:         ))}\r\n 526:       </div>\r\n 527:       <button\r\n 528:         type=\"button\"\r\n 529:         className={styles.addButton}\r\n 530:         onClick={() => commit([...spans, spans[spans.length - 1]])}\r\n 531:       >\r\n 532:         {axisLabel}\r\n 533:         {t(locale, 'plan.addSpan')}\r\n 534:       </button>\r\n 535:     </fieldset>\r\n 536:   )\r\n 537: }\r\n 538: \r\n 539: type PlacementPosition = GirderPosition | SlabPosition\r\n 540: type PlacementFailure = 'section' | 'unavailable' | 'duplicate'\r\n 541: \r\n 542: export interface PlanPlacementResult {\r\n 543:   project: Project\r\n 544:   member?: Member\r\n 545:   reason?: PlacementFailure\r\n 546: }\r\n 547: \r\n 548: function placementMemberId(\r\n 549:   storyId: string,\r\n 550:   mark: string,\r\n 551:   position: PlacementPosition,\r\n 552: ): string {\r\n 553:   const axis = 'axis' in position ? `-${position.axis}` : ''\r\n 554:   return `${storyId}-${mark}-${position.ix}-${position.iy}${axis}`\r\n 555: }\r\n 556: \r\n 557: function samePlacementPosition(\r\n 558:   member: Member,\r\n 559:   storyId: string,\r\n 560:   kind: '?먬쐡鶯? | '佯딀씮',\r\n 561:   position: PlacementPosition,\r\n 562: ): boolean {\r\n 563:   if (member.storyId !== storyId || member.kind !== kind) return false\r\n 564: \r\n 565:   if (kind === '?먬쐡鶯?) {\r\n 566:     if (!('axis' in member.position) || !('axis' in position)) return false\r\n 567:     return (\r\n 568:       member.position.axis === position.axis &&\r\n 569:       member.position.ix === position.ix &&\r\n 570:       member.position.iy === position.iy\r\n 571:     )\r\n 572:   }\r\n 573: \r\n 574:   if ('axis' in member.position || 'axis' in position) return false\r\n 575:   return (\r\n 576:     member.position.ix === position.ix && member.position.iy === position.iy\r\n 577:   )\r\n 578: }\r\n 579: \r\n 580: function hasMemberAtPlacement(\r\n 581:   project: Project,\r\n 582:   storyId: string,\r\n 583:   kind: '?먬쐡鶯? | '佯딀씮',\r\n 584:   position: PlacementPosition,\r\n 585: ): boolean {\r\n 586:   return project.members.some((member) =>\r\n 587:     samePlacementPosition(member, storyId, kind, position),\r\n 588:   )\r\n 589: }\r\n 590: \r\n 591: /**\r\n 592:  * UI媛 ?꾨? ???덈뒗 諛곗튂 ??嫄댁쓣 Project濡?蹂?섑븳??\r\n 593:  *\r\n 594:  * 湲고븯???깅┰ ?щ???step 1???꾨찓???먯젙留??ъ슜?섍퀬, ?ш린?쒕뒗 UI媛\r\n 595:  * ?좏깮????씊怨?遺??id瑜?議고빀?쒕떎. duplicate 寃?щ뒗 ?대깽?멸? ?곗냽?쇰줈\r\n 596:  * ?ㅼ뼱?ㅺ굅???대? 痍⑥엯??旅덁뻑???몄쭛?섎뒗 寃쎌슦?먮룄 媛숈? id媛 ?섏? ?딄쾶\r\n 597:  * ?섎뒗 留덉?留?諛⑹뼱??\r\n 598:  */\r\n 599: export function placePlanMember(\r\n 600:   project: Project,\r\n 601:   storyId: string,\r\n 602:   sectionId: string,\r\n 603:   position: PlacementPosition,\r\n 604: ): PlanPlacementResult {\r\n 605:   const section = project.sections.find(({ id }) => id === sectionId)\r\n 606:   if (section === undefined) return { project, reason: 'section' }\r\n 607: \r\n 608:   const kind = section.kind\r\n 609:   if (kind !== '?먬쐡鶯? && kind !== '佯딀씮') {\r\n 610:     return { project, reason: 'section' }\r\n 611:   }\r\n 612: \r\n 613:   const id = placementMemberId(storyId, section.mark, position)\r\n 614:   if (project.members.some((member) => member.id === id)) {\r\n 615:     return { project, reason: 'duplicate' }\r\n 616:   }\r\n 617: \r\n 618:   const placeable =\r\n 619:     kind === '?먬쐡鶯?\r\n 620:       ? 'axis' in position &&\r\n 621:         placeableWallPositions(project, storyId).some(\r\n 622:           (candidate) =>\r\n 623:             candidate.axis === position.axis &&\r\n 624:             candidate.ix === position.ix &&\r\n 625:             candidate.iy === position.iy,\r\n 626:         )\r\n 627:       : !('axis' in position) &&\r\n 628:         placeableSlabPositions(project, storyId).some(\r\n 629:           (candidate) =>\r\n 630:             candidate.ix === position.ix && candidate.iy === position.iy,\r\n 631:         )\r\n 632: \r\n 633:   if (!placeable) return { project, reason: 'unavailable' }\r\n 634: \r\n 635:   const member: Member = {\r\n 636:     id,\r\n 637:     kind,\r\n 638:     memberClass: '翁?퐪',\r\n 639:     sectionId: section.id,\r\n 640:     storyId,\r\n 641:     position,\r\n 642:   }\r\n 643: \r\n 644:   return {\r\n 645:     project: { ...project, members: [...project.members, member] },\r\n 646:     member,\r\n 647:   }\r\n 648: }\r\n 649: \r\n 650: function placementAxisLabel(\r\n 651:   project: Project,\r\n 652:   axis: 'X' | 'Y',\r\n 653:   index: number,\r\n 654: ): string {\r\n 655:   const labels = axis === 'X' ? project.grid.xLabels : project.grid.yLabels\r\n 656:   return labels?.[index] ?? `${axis}${index + 1}`\r\n 657: }\r\n 658: \r\n 659: function placementLabel(\r\n 660:   project: Project,\r\n 661:   position: PlacementPosition,\r\n 662: ): string {\r\n 663:   if ('axis' in position) {\r\n 664:     if (position.axis === 'Y') {\r\n 665:       return `${placementAxisLabel(project, 'X', position.ix)} / ${placementAxisLabel(project, 'Y', position.iy)}-${placementAxisLabel(project, 'Y', position.iy + 1)}`\r\n 666:     }\r\n 667:     return `${placementAxisLabel(project, 'X', position.ix)}-${placementAxisLabel(project, 'X', position.ix + 1)} / ${placementAxisLabel(project, 'Y', position.iy)}`\r\n 668:   }\r\n 669: \r\n 670:   return `${placementAxisLabel(project, 'X', position.ix)}-${placementAxisLabel(project, 'X', position.ix + 1)} / ${placementAxisLabel(project, 'Y', position.iy)}-${placementAxisLabel(project, 'Y', position.iy + 1)}`\r\n 671: }\r\n 672: \r\n 673: function removePlanMember(project: Project, memberId: string): Project {\r\n 674:   return {\r\n 675:     ...project,\r\n 676:     members: project.members.filter(({ id }) => id !== memberId),\r\n 677:   }\r\n 678: }\r\n 679: \r\n 680: function PlacementEditor() {\r\n 681:   const project = useAppStore(({ project }) => project)\r\n 682:   const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\r\n 683:   const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\r\n 684:   const locale = useAppStore(({ locale }) => locale)\r\n 685:   const [wallSectionSelection, setWallSectionSelection] = useState<string>()\r\n 686:   const [slabSectionSelection, setSlabSectionSelection] = useState<string>()\r\n 687:   const [placementError, setPlacementError] = useState<PlacementFailure>()\r\n 688: \r\n 689:   const wallSections = project.sections.filter(\r\n 690:     (section): section is Extract<Section, { kind: '?먬쐡鶯? }> =>\r\n 691:       section.kind === '?먬쐡鶯?,\r\n 692:   )\r\n 693:   const slabSections = project.sections.filter(\r\n 694:     (section): section is Extract<Section, { kind: '佯딀씮' }> =>\r\n 695:       section.kind === '佯딀씮',\r\n 696:   )\r\n 697:   const wallSectionId = wallSections.some(\r\n 698:     ({ id }) => id === wallSectionSelection,\r\n 699:   )\r\n 700:     ? wallSectionSelection\r\n 701:     : wallSections[0]?.id\r\n 702:   const slabSectionId = slabSections.some(\r\n 703:     ({ id }) => id === slabSectionSelection,\r\n 704:   )\r\n 705:     ? slabSectionSelection\r\n 706:     : slabSections[0]?.id\r\n 707:   const wallPositions =\r\n 708:     wallSectionId === undefined\r\n 709:       ? []\r\n 710:       : placeableWallPositions(project, activeStoryId).filter(\r\n 711:           (position) =>\r\n 712:             !hasMemberAtPlacement(project, activeStoryId, '?먬쐡鶯?, position),\r\n 713:         )\r\n 714:   const slabPositions =\r\n 715:     slabSectionId === undefined\r\n 716:       ? []\r\n 717:       : placeableSlabPositions(project, activeStoryId).filter(\r\n 718:           (position) =>\r\n 719:             !hasMemberAtPlacement(project, activeStoryId, '佯딀씮', position),\r\n 720:         )\r\n 721: \r\n 722:   const place = (sectionId: string | undefined, position: PlacementPosition) => {\r\n 723:     if (sectionId === undefined) return\r\n 724: \r\n 725:     let result: PlanPlacementResult | undefined\r\n 726:     useAppStore.setState((state) => {\r\n 727:       result = placePlanMember(state.project, activeStoryId, sectionId, position)\r\n 728:       return result.member === undefined ? {} : { project: result.project }\r\n 729:     })\r\n 730: \r\n 731:     if (result?.member === undefined) {\r\n 732:       setPlacementError(result?.reason)\r\n 733:       return\r\n 734:     }\r\n 735: \r\n 736:     setPlacementError(undefined)\r\n 737:     useAppStore.getState().selectMember(result.member.id)\r\n 738:   }\r\n 739: \r\n 740:   const selectedMember = project.members.find(\r\n 741:     ({ id }) => id === selectedMemberId,\r\n 742:   )\r\n 743:   const canDelete =\r\n 744:     selectedMember?.kind === '?먬쐡鶯? || selectedMember?.kind === '佯딀씮'\r\n 745:   const selectedSection =\r\n 746:     selectedMember === undefined\r\n 747:       ? undefined\r\n 748:       : project.sections.find(({ id }) => id === selectedMember.sectionId)\r\n 749: \r\n 750:   const deleteSelected = () => {\r\n 751:     if (!selectedMember || !canDelete) return\r\n 752:     useAppStore.setState((state) => ({\r\n 753:       project: removePlanMember(state.project, selectedMember.id),\r\n 754:       sel: { group: null, memberId: null },\r\n 755:     }))\r\n 756:     setPlacementError(undefined)\r\n 757:   }\r\n 758: \r\n 759:   const failureMessage =\r\n 760:     placementError === 'duplicate'\r\n 761:       ? t(locale, 'plan.placement.duplicate')\r\n 762:       : placementError === 'unavailable'\r\n 763:         ? t(locale, 'plan.placement.unavailable')\r\n 764:         : placementError === 'section'\r\n 765:           ? t(locale, 'plan.placement.sectionMissing')\r\n 766:           : null\r\n 767: \r\n 768:   return (\r\n 769:     <section className={styles.placementEditor} data-testid=\"placement-editor\">\r\n 770:       <div className={styles.placementGroups}>\r\n 771:         <fieldset className={styles.placementGroup}>\r\n 772:           <legend className={styles.spanLegend}>\r\n 773:             {t(locale, 'plan.placement.wall.title')}\r\n 774:           </legend>\r\n 775:           {wallSections.length === 0 ? (\r\n 776:             <p\r\n 777:               className={styles.openingHint}\r\n 778:               data-testid=\"placement-wall-no-section\"\r\n 779:             >\r\n 780:               {t(locale, 'plan.placement.wall.sectionMissing')}\r\n 781:             </p>\r\n 782:           ) : (\r\n 783:             <>\r\n 784:               <label className={styles.placementLabel}>\r\n 785:                 <span>{t(locale, 'plan.placement.section')}</span>\r\n 786:                 <select\r\n 787:                   className={styles.placementSelect}\r\n 788:                   data-testid=\"placement-wall-section\"\r\n 789:                   value={wallSectionId ?? ''}\r\n 790:                   onChange={(event) =>\r\n 791:                     setWallSectionSelection(event.currentTarget.value)\r\n 792:                   }\r\n 793:                 >\r\n 794:                   {wallSections.map((section) => (\r\n 795:                     <option key={section.id} value={section.id}>\r\n 796:                       {section.mark}\r\n 797:                     </option>\r\n 798:                   ))}\r\n 799:                 </select>\r\n 800:               </label>\r\n 801:               <div className={styles.placementCandidates}>\r\n 802:                 {wallPositions.length === 0 ? (\r\n 803:                   <p className={styles.openingHint}>\r\n 804:                     {t(locale, 'plan.placement.empty')}\r\n 805:                   </p>\r\n 806:                 ) : (\r\n 807:                   wallPositions.map((position) => (\r\n 808:                     <button\r\n 809:                       key={`wall-${position.axis}-${position.ix}-${position.iy}`}\r\n 810:                       type=\"button\"\r\n 811:                       className={styles.placementCandidate}\r\n 812:                       data-testid={`placement-wall-${position.axis}-${position.ix}-${position.iy}`}\r\n 813:                       onClick={() => place(wallSectionId, position)}\r\n 814:                     >\r\n 815:                       {placementLabel(project, position)}\r\n 816:                     </button>\r\n 817:                   ))\r\n 818:                 )}\r\n 819:               </div>\r\n 820:             </>\r\n--- viewer selected/concrete ---\r\n 140:   kind: '鸚㎪쥈'\r\n 141:   /** ?????遺?? ???덉쓽 ?대뒓 ?ㅽ뙩??怨⑤씪??媛숈? 遺??酉곕? 留뚮뱺?? */\r\n 142:   member: Member\r\n 143:   section: GirderSection\r\n 144:   story: Story\r\n 145:   run: GirderRun\r\n 146:   /** ??異뺣갑???쒖꽌??吏?????⑤㈃. 湲몄씠??run.members.length + 1. */\r\n 147:   supportSections: ColumnSection[]\r\n 148:   rebars: Rebar[]\r\n 149:   rowIds: Map<Rebar['id'], QuantityLine['id']>\r\n 150: }\r\n 151: \r\n 152: interface SelectedWallView {\r\n 153:   kind: '?먬쐡鶯?\r\n 154:   member: Member\r\n 155:   section: WallSection\r\n 156:   story: Story\r\n 157:   /** ?끾퀡野멩퀡?귛즯??변鵝볝겗?뷴늽?㎩냵力뺡깿?녴겒??겎?곭??귡뀓嶺뗣굚?볝굦?㎪군?얇굥??*/\r\n 158:   span: WallSpan\r\n 159:   rebars: Rebar[]\r\n 160:   rowIds: Map<Rebar['id'], QuantityLine['id']>\r\n 161: }\r\n 162: \r\n 163: /**\r\n 164:  * 佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굤?곫뼶?묆걫?ⓦ겓?γ겗?⒲꺍?믤똻?ㅳ귡깿?먦깛?γ꺖??겦?볝걽?쇻궎??\r\n 165:  * ?끾퀡?잏궧?믤옞??렅?밤겓?쀣겍?곥걹??깧?ㅳ걣掠욁걲??X?밧릲?팢?