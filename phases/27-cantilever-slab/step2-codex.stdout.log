:     const { axis, ix, iy } = member.position\r\n 355:     const start = gridPoint(project.grid, ix, iy)\r\n 356:     const end = gridPoint(\r\n 357:       project.grid,\r\n 358:       axis === 'X' ? ix + 1 : ix,\r\n 359:       axis === 'Y' ? iy + 1 : iy,\r\n 360:     )\r\n 361:     const x1 = transform.x(start.x)\r\n 362:     const y1 = transform.y(start.y)\r\n 363:     const x2 = transform.x(end.x)\r\n 364:     const y2 = transform.y(end.y)\r\n 365: \r\n 366:     return (\r\n 367:       <g\r\n 368:         className={`${styles.member} ${\r\n 369:           selected ? styles.memberSelected : ''\r\n 370:         }`}\r\n 371:         role=\"button\"\r\n 372:         tabIndex={0}\r\n 373:         aria-label={`${section.mark} ${member.id}`}\r\n 374:         aria-pressed={selected}\r\n 375:         onClick={select}\r\n 376:         onKeyDown={(event) => activateMember(event, select)}\r\n 377:       >\r\n 378:         <line\r\n 379:           className={styles.girderHitArea}\r\n 380:           x1={x1}\r\n 381:           y1={y1}\r\n 382:           x2={x2}\r\n 383:           y2={y2}\r\n 384:         />\r\n 385:         <line\r\n 386:           className={styles.girder}\r\n 387:           x1={x1}\r\n 388:           y1={y1}\r\n 389:           x2={x2}\r\n 390:           y2={y2}\r\n 391:         />\r\n 392:         <text\r\n 393:           className={styles.memberLabel}\r\n 394:           x={(x1 + x2) / 2}\r\n 395:           y={(y1 + y2) / 2 - 6}\r\n 396:           textAnchor=\"middle\"\r\n 397:         >\r\n 398:           {section.mark}\r\n 399:         </text>\r\n 400:       </g>\r\n 401:     )\r\n 402:   }\r\n 403: \r\n 404:   return null\r\n 405: }\r\n 406: \r\n 407: /**\r\n 408:  * 佯딀씮??뼀?ｉ깿?믣뭄?㏂겗 px ?ュ넍??(?곈뇧令띸츞?뷸틬 1?싧뎴8))?귛벨與쇻겘?쇻궎掠??ゃ겗?㎯?\r\n 409:  * ?끾퀡?잆겗?잏궧竊덂룛?묆굥鸚㎪쥈??냵?닻씊竊됥굮?싥굤??걢?됥겗若잌??㎬떨?쀣겍?뗣굢?쇻걲 ??\r\n 410:  * 櫻쀣굤??`slabEdgeInset` ??ㄷ歟곥꺕鶯곥굮?담굙?뗣굠?녴겓?쇻굥?잆굙??쫳?잏쎅??껁걩?㎯걗?ｃ겍\r\n 411:  * ?끾퀡?㎯겘?ゃ걚??겎?곥걹?뚣굮?뷸틬?ャ걲?뗣겏?뗥룭?뚦츪野멥걢?됥걳?뚣굥??\r\n 412:  *\r\n 413:  * ?끾퀡?뚧군?