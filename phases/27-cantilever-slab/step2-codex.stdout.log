n matches(\\r\\n  27:  ruleConditions: Record<string, string | number | boolean>,\\r\\n  28:  queryConditions: Record<string, unknown>,\\r\\n  29:): boolean {\\r\\n  30:  return Object.entries(ruleConditions).every(\\r\\n  31:    ([name, value]) => queryConditions[name] === value,\\r\\n  32:  )\\r\\n  33:}\\r\\n  34:\\r\\n  35:export function lookupRule(\\r\\n  36:  pack: RulePack,\\r\\n  37:  key: string,\\r\\n  38:  conditions: Record<string, unknown>,\\r\\n  39:): RuleHit {\\r\\n  40:  const candidates = pack.entries.filter(\\r\\n  41:    (entry) => entry.key === key && matches(entry.conditions, conditions),\\r\\n  42:  )\\r\\n  43:\\r\\n  44:  if (candidates.length === 0) {\\r\\n  45:    throw new Error(\\r\\n  46:      `Rule not found: ${key} for ${JSON.stringify(conditions)}`,\\r\\n  47:    )\\r\\n  48:  }\\r\\n  49:\\r\\n  50:  const specificity = Math.max(\\r\\n  51:    ...candidates.map((entry) => Object.keys(entry.conditions).length),\\r\\n  52:  )\\r\\n  53:  const mostSpecific = candidates.filter(\\r\\n  54:    (entry) => Object.keys(entry.conditions).length === specificity,\\r\\n  55:  )\\r\\n  56:\\r\\n  57:  if (mostSpecific.length !== 1) {\\r\\n  58:    throw new Error(\\r\\n  59:      `Rule lookup is ambiguous: ${key} for ${JSON.stringify(conditions)}`,\\r\\n  60:    )\\r\\n  61:  }\\r\\n  62:\\r\\n  63:  return mostSpecific[0]\\r\\n  64:}\\r\\n  65:\\r\\n  66:/**\\r\\n  67: * 媛숈? key?????꾨?瑜?`orderBy` 議곌굔媛믪쓽 ?ㅻ쫫李⑥닚?쇰줈 ?뚮젮以??\\r\\n  68: *\\r\\n  69: * ?뷴늽烏?竊덌폆竊됪쥈2))泥섎읆 **?됱쓽 媛쒖닔? ?쒖꽌 ?먯껜媛 洹쒖?**??猷곗뿉 ?대떎. 肄붾뱶媛\\r\\n  70: * ?뚦뙷?놁? 3媛쒌띾씪怨??뚮㈃ 猷고뙥??諛붽퓭??肄붾뱶媛 ?곕씪?ㅼ? ?딆쑝誘濡? 議고쉶 履쎌씠\\r\\n  71: * ???꾩껜瑜??쎈뒗??\\r\\n  72: */\\r\\n  73:export function lookupRuleSeries(\\r\\n  74:  pack: RulePack,\\r\\n  75:  key: string,\\r\\n  76:  orderBy: string,\\r\\n  77:): RuleHit[] {\\r\\n  78:  const rows = pack.entries.filter((entry) => entry.key === key)\\r\\n  79:\\r\\n  80:  if (rows.length === 0) {\\r\\n  81:    throw new Error(`Rule series not found: ${key}`)\\r\\n  82:  }\\r\\n  83:\\r\\n  84:  return [...rows]\\r\\n  85:    .map((entry) => {\\r\\n  86:      const order = entry.conditions[orderBy]\\r\\n  87:      if (typeof order !== 'number') {\\r\\n  88:        throw new Error(\\r\\n  89:          `Rule ${key} must carry a numeric ${orderBy} condition to be ordered`,\\r\\n  90:        )\\r\\n  91:      }\\r\\n  92:      return { entry, order }\\r\\n  93:    })\\r\\n  94:    .sort((left, right) => left.order - right.order)\\r\\n  95:    .map(({ entry }) => entry)\\r\\n  96:}\\r\\n  97:\\r\\n  98:export function lookupMarkup(\\r\\n  99:  pack: RulePack,\\r\\n 100:  memberClass: MemberClass | string,\\r\\n 101:): RuleHit {\\r\\n 102:  return lookupRule(pack, 'markup.rate', { memberClass })\\r\\n 103:}\\r\\n   1:export interface ResolvedSource {\\r\\n   2:  short: string\\r\\n   3:  doc: string\\r\\n   4:  edition: string | null\\r\\n   5:  publisher: string\\r\\n   6:  url: string | null\\r\\n   7:  section: string | null\\r\\n   8:  page: number | null\\r\\n   9:}\\r\\n  10:\\r\\n  11:/**\\r\\n  12: * 媛믪쓽 洹쇨굅媛 ?대뵒源뚯? ?뺤씤?먮뒗吏. ??異뺤쓽 ?쒖꽌?????꾨줈 媛덉닔濡?媛뺥븯??\\r\\n  13: *\\r\\n  14: * - `stated`      ?먮Ц??紐낆떆???덇퀬 **?낅┰ 寃?좉퉴吏 ?앸궗??*.\\r\\n  15: * - `transcribed` ?먮Ц??紐낆떆???덉쑝??**?꾩궗?먯? ?뱀씤?먭? 媛숇떎** (R6).\\r\\n  16: *                 湲곌퀎 ?議?怨⑤뱺 ?쎌뒪泥샕룰뎄議?遺덈??????듦낵???곹깭??\\r\\n  17: * - `inferred`    ?먮Ц??洹?媛믪씠 ?녿떎. 諛섎??댁꽍?닿굅?? ?먮Ц ?먯껜媛 誘명솗蹂대떎.\\r\\n  18: *\\r\\n  19: * `transcribed` 瑜??곕줈 ???댁쑀: ?덉쟾?먮뒗 ?뚯썝臾?紐낆떆?몃뜲 寃?좉? 1?멥띻낵\\r\\n  20: * ?뚯썝臾몄뿉 ?꾩삁 ?놁뼱??吏?대궦 媛믡띿씠 ????`inferred` ??? ?ъ슜?먮뒗 ?섏쓣\\r\\n  21: * 援щ퀎?????놁뿀怨? 若싩??룔걬 40d 媛숈? ?먮Ц 紐낆떆媛믪씠 ?뚯텛濡졼띿쑝濡??쒖떆?먮떎.\\r\\n  22: */\\r\\n  23:export type RuleConfidence = 'stated' | 'transcribed' | 'inferred'\\r\\n  24:\\r\\n  25:/** ?깃툒 ?쒖꽌 ????쓣?섎줉 ?쏀븯?? ??臾띠쓬????쒓컪? 媛???쏀븳 寃껋씠?? */\\r\\n  26:export const CONFIDENCE_ORDER: readonly RuleConfidence[] = [\\r\\n  27:  'inferred',\\r\\n  28:  'transcribed',\\r\\n  29:  'stated',\\r\\n  30:]\\r\\n  31:\\r\\n  32:export in