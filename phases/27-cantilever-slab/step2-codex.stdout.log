r\\n  ]\\r\\n\\r\\n  const bent = start.kind === '?섉쎊?믣츣?' || end.kind === '?섉쎊?믣츣?'\\r\\n  const points = slabPoints(run.axis, run.coreLengthMm, barZ, start, end)\\r\\n  const faceKey = face === '訝딁ク' ? 'top' : 'bottom'\\r\\n\\r\\n  return deduction.groups.map(({ deductionMm, count: groupCount }) => {\\r\\n    // 1?싧뎴4) ?뚨텤?뗧츋??겹굮黎귙굙?뗣뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띲겘轝좈솮孃뚣겗?룔걬?졼?\\r\\n    // ?ｇ텥佯딀씮??뙷?녻〃??뚦틞?욍겗?룔걬?띲겎凉뺛걦??겎轝좈솮??쉽?욍굮?쀣걨?ゃ걚??\\r\\n    const measuredLengthMm = drawnLengthMm - deductionMm\\r\\n    const splice = resolveSplice({\\r\\n      run,\\r\\n      section,\\r\\n      size: row.size,\\r\\n      measuredLengthMm,\\r\\n      lapRule,\\r\\n      lapLengthMm,\\r\\n      pack,\\r\\n    })\\r\\n    const lengthMm = measuredLengthMm + splice.lengthMm\\r\\n    const positionsMm = openingLayout\\r\\n      ? openingLayout.positionsMm.filter(\\r\\n          (_, index) => openingLayout.deductionsMm[index] === deductionMm,\\r\\n        )\\r\\n      : null\\r\\n\\r\\n    const deductionTerm =\\r\\n      deductionMm === 0\\r\\n        ? ''\\r\\n        : ` ???뗥룭?ⓦ겗轝좈솮 ${deductionMm}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??兩뷴끁窈욅춬` +\\r\\n          `?뗥룭?ⓦ겗?끾퀡野멩퀡?ャ굠?뗰펹`\\r\\n    const splitTerm =\\r\\n      deduction.groups.length === 1\\r\\n        ? ''\\r\\n        : ` ??걝??{\\r\\n            deductionMm === 0 ? '?뗥룭?믤Ø?뉎굢?ゃ걚' : `${deductionMm}?믤쵟??\\r\\n          } ${groupCount}??\\r\\n\\r\\n    return {\\r\\n      id:\\r\\n        `${run.ownerId}|slab-${run.axis}-${faceKey}` +\\r\\n        `${deductionMm === 0 ? '' : `|轝좈솮${deductionMm}`}`,\\r\\n      memberId: run.ownerId,\\r\\n      role: roleOf(run.axis, face),\\r\\n      size: row.size,\\r\\n      shape: (bent ? 'hook90' : 'straight') as Rebar['shape'],\\r\\n      points,\\r\\n      closed: false,\\r\\n      length: lengthMm,\\r\\n      count: groupCount,\\r\\n      // X?밧릲??뎱嶺뗣겘 x ?ヤ섯?녈굥??겎 y ?멧를?녈갳?밧릲??걹??녴겎?귙굥??\\r\\n      placement: {\\r\\n        axis: (run.axis === 'X' ? 'y' : 'x') as 'x' | 'y',\\r\\n        clearMm: run.distributionClearMm,\\r\\n        pitchMm: row.pitch,\\r\\n        startOffsetMm: row.startOffsetMm,\\r\\n        lastGapMm: layout.lastGapMm,\\r\\n        positionCount: positionsMm\\r\\n          ? positionsMm.length\\r\\n          : layout.positionsMm.length,\\r\\n        ...(positionsMm ? { positionsMm } : {}),\\r\\n      },\\r\\n      splice: {\\r\\n        method: section.spliceMethod,\\r\\n        countPerBar: splice.countPerBar,\\r\\n        lengthMm: splice.lengthMm,\\r\\n        rules: splice.rules,\\r\\n        formula:\\r\\n          `泳숁뎸嶸뉑???竊?${face}嶺??с걗?잆굤 ${splice.countPerBar}?뗦?` +\\r\\n          `竊?{splice.basis}竊?竊??밧폀 竊?${section.spliceMethod} 竊?` +\\r\\n          `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm(splice, section, lapRule, lapLengthMm)} 竊?` +\\r\\n          `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\\r\\n      },\\r\\n      zones,\\r\\n      ruleHits: uniqueRuleHits([\\r\\n        coverRule,\\r\\n        fabricationCoverAdditionRule,\\r\\n        distributionAdditionRule,\\r\\n        ...start.usedRules,\\r\\n        ...end.usedRules,\\r\\n        ...deduction.rules,\\r\\n        ...splice.rules,\\r\\n      ]),\\r\\n      formula:\\r\\n        `鼇?쮫?룔걬 竊?${runCoreFormula(run)}${deductionTerm} 竊?${endFormula('冶뗧ク', start)} ` +\\r\\n        `竊?${endFormula('永귞ク', end)} 竊?泳숁뎸 ` +\\r\\n        `${spliceLengthTerm(splice, section, lapRule, lapLengthMm)} 竊?${lengthMm} 竊?` +\\r\\n        `?ф빊 竊??덂돯餓섉뼶?묆겗?끾퀡?룔걬 ${run.distributionClearMm} 첨 ?붵긿??` +\\r\\n        `${row.pitch}??竊?${distributionAdditionRule.value}` +\\r\\n        `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴7)竊됵폓 ${count}${splitTerm} 竊?` +\\r\\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊??좂츞 ` +\\r\\n        `${fabricationCoverAdditionRule.value} 竊?${fabricationCoverMm}?? +\\r\\n        `烏?.3.6?뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥랃펹 竊?` +\\r\\n        `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚竊덃룒?뗣굦?뗥뒥藥ι빓 ` +\\r\\n        `${drawnLengthMm} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹${ignoredTerm}`,\\r\\n    }\\r\\n  })\\r\\n}\\r\\n\\r\\nfunction runCoreFormula(run: SlabRun): string {\\r\\n  const clearTerms = run.bays\\r\\n    .map((bay) => (run.axis === 'X' ? bay.clearXMm : bay.clearYMm))\\r\\n    .join('竊?)\\r\\n  const intermediateTerms = run.bays\\r\\n    .slice(1)\\r\\n    .map(\\r\\n      (bay) =>\\r\\n        (run.axis === 'X' ? bay.supports.minX : bay.supports.minY).widthMm,\\r\\n    )\\r\\n    .join('竊?)\\r\\n\\r\\n  return intermediateTerms === ''\\r\\n    ? `?끾퀡?룔걬 ${clearTerms}`\\r\\n    : `?끾퀡?룔걬 ${clearTerms} 竊?訝?뼋鸚㎪쥈??퉭 ${intermediateTerms}` +\\r\\n        `竊?竊덌폇竊됧틞??) ??亮끹겗1/2 ?뚥륫?담걢?됪씎???у늽?ャ겒?뗰펹`\\r\\n}\\r\\n\\r\\nfunction endFormula(label: string, detail: SlabEndDetail): string {\\r\\n  if (detail.kind === '?당퇉若싩?') {\\r\\n    const term =\\r\\n      detail.lengthRule === 'anchorage.L1'\\r\\n        ? '訝?у?L1'\\r\\n        : detail.lengthRule === 'anchorage.L3'\\r\\n          ? 'L3 10d'\\r\\n          : 'L3 ??툔??150mm'\\r\\n    return `${label} ?당퇉若싩? ${term} ${detail.lengthMm}`\\r\\n  }\\r\\n\\r\\n  const tailMm = detail.lengthMm - detail.projectionMm\\r\\n  return (\\r\\n    `${label} ?섉쎊?믣츣? ?③빓 ${detail.lengthMm}` +\\r\\n    `竊?a) ?당퇉若싩? L1 ${detail.straightMinimumMm} ??` +\\r\\n    `(b) ?뺝쉽竊뗤퐰?룝툔??${detail.tailMinimumMm} ??ㄷ竊? +\\r\\n    `竊덂냵鼇?竊??뺝쉽 ${detail.projectionMm}竊?c) 烏?.3.5 Lb竊?竊??귞쎍鵝숅빓 ${tailMm}竊?\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction spliceLengthTerm(\\r\\n  splice: SlabSplice,\\r\\n  section: SlabSection,\\r\\n  lapRule: RuleHit,\\r\\n  lapLengthMm: number,\\r\\n): string {\\r\\n  // 0?뗦??㏝빓?뺛걣罌쀣걟?ゃ걚??겘嶸뉑??겹겗?쎼걚?㎪뼶凉뤵겗?쎼걚?㎯겘?ゃ걚 ??鸚㎪쥈?ⓨ릪?섊릤?긱겎\\r\\n  // ?녶쾺?믣늽?묆굥?귙겲?ⓦ굙?뗣겏 0?뗦???뜕?у틞?욍겲?㎯뚣걹??뼶凉뤵겘?룔걬?뚦쨯?뤵굢?ゃ걚?띲겏\\r\\n  // 沃ф삇?쀣곩눣?멥겓?쇻걩??measure.splice.length.factor ?③짘?꾦걬?녴?\\r\\n  if (splice.countPerBar === 0) return '0?뗦? 竊?0'\\r\\n  if (splice.lengthMm > 0) {\\r\\n    return (\\r\\n      `${splice.countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 L1 ` +\\r\\n      `${lapRule.value}d(${lapLengthMm}) 竊?${splice.lengthMm}`\\r\\n    )\\r\\n  }\\r\\n  return `${splice.countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\\r\\n}\\r\\n\\r\\ninterface SlabSplice {\\r\\n  countPerBar: number\\r\\n  lengthMm: number\\r\\n  rules: RuleHit[]\\r\\n  basis: string\\r\\n}\\r\\n\\r\\ninterface SlabSpliceInput {\\r\\n  run: SlabRun\\r\\n  section: SlabSection\\r\\n  size: BarSize\\r\\n  /** 1?싧뎴4) ?뚩??녴뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띯??뗥룭?ⓦ겗轝좈솮?믣폊?꾠걼孃뚣겎?귙굥 */\\r\\n  measuredLengthMm: number\\r\\n  lapRule: RuleHit\\r\\n  lapLengthMm: number\\r\\n  pack: RulePack\\r\\n}\\r\\n\\r\\n/**\\r\\n * 2竊덌폇竊됧틞??) ???⒲꺍???쇻궎餓δ툓?ゃ굢?뚪ｇ텥?쇻굥佯딀씮?띲겎?뷴늽烏ⓦ걣 1?싧뎴4) ??\\r\\n * 訝딀쎑?띲걲?뗣??쇻궎??꺀?녈겘?뚦뜕?у틞?욍띲겒??겎?뚧씉?잆걽?쀦쎑?띲겎 1?싧뎴4) ?ユ댗?듽?\\r\\n * 孃꾠걫?ⓦ겗?룔걬??뜕鵝띲겎?겹걟?뗣귛ㄷ歟곥겗 resolveSplice ?ⓨ릪?섇숱?졼?\\r\\n */\\r\\nfunction resolveSplice(input: SlabSpliceInput): SlabSplice {\\r\\n  const { run, section, size, measuredLengthMm, lapRule, lapLengthMm, pack } =\\r\\n    input\\r\\n\\r\\n  let countRule: RuleHit\\r\\n  let countPerBar: number\\r\\n  let basis: string\\r\\n\\r\\n  if (run.members.length === 1) {\\r\\n    countRule = lookupRule(pack, 'measure.splice.interval', { size })\\r\\n    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\\r\\n    basis =\\r\\n      `?섊떖佯딀씮 ?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏` +\\r\\n      `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴4) ??2竊덌폇竊됧틞??) ?잆걽?쀦쎑?랃펹`\\r\\n  } else {\\r\\n    countRule = bandedSpliceRule(run.coreLengthMm, continuousSlabBands(pack))\\r\\n    countPerBar = spliceCount(countRule)\\r\\n    basis = `?ｇ텥佯딀씮 佯딀씮??빓??${run.coreLengthMm}竊덃빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞??)竊?\\r\\n  }\\r\\n\\r\\n  const factorRule = lookupRule(pack, 'measure.splice.length.factor', {\\r\\n    method: section.spliceMethod,\\r\\n  })\\r\\n  const lengthMm = spliceLengthMm(countPerBar, lapLengthMm, factorRule)\\r\\n  const rules = [countRule, factorRule]\\r\\n  if (lengthMm > 0) rules.push(lapRule)\\r\\n\\r\\n  return { countPerBar, lengthMm, rules, basis }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?졾램壤®듁?귚툓塋?춮?뚦ㄷ歟곥겗訝?겎訝뗣겦?섅굦?꿔걣?????욍겗訝?걢?됪쥈??릎?멱맼?▲굥??겎??\\r\\n * ?섅굦?잌뀍??z ??씮??툔塋?펷0竊됥굠?듾툔?ャ겒?뗣걪?ⓦ걣?귙굥?귙걹?뚣걣若잓슋??㎰?㎯걗?뗣?\\r\\n * 訝뗧ク嶺뗣겘?섅굦?ゃ걚竊덅〃5.3.5 Lb ??툓塋?춮??닓?곮〃5.3.4 L3h ??궧?⒲깣轝꾠겘?뚢??랃펹??\\r\\n */\\r\\nfunction slabPoints(\\r\\n  axis: 'X' | 'Y',\\r\\n  coreLengthMm: number,\\r\\n  barZ: number,\\r\\n  start: SlabEndDetail,\\r\\n  end: SlabEndDetail,\\r\\n): Rebar['points'] {\\r\\n  const at = (along: number, z: number): [number, number, number] =>\\r\\n    axis === 'X' ? [along, 0, z] : [0, along, z]\\r\\n  const points: Rebar['points'] = []\\r\\n\\r\\n  if (start.kind === '?당퇉若싩?') {\\r\\n    points.push(at(-start.lengthMm, barZ))\\r\\n  } else {\\r\\n    const tailMm = start.lengthMm - start.projectionMm\\r\\n    points.push(\\r\\n      at(-start.projectionMm, barZ - tailMm),\\r\\n      at(-start.projectionMm, barZ),\\r\\n    )\\r\\n  }\\r\\n\\r\\n  if (end.kind === '?당퇉若싩?') {\\r\\n    points.push(at(coreLengthMm + end.lengthMm, barZ))\\r\\n  } else {\\r\\n    const tailMm = end.lengthMm - end.projectionMm\\r\\n    points.push(\\r\\n      at(coreLengthMm + end.projectionMm, barZ),\\r\\n      at(coreLengthMm + end.projectionMm, barZ - tailMm),\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return points\\r\\n}\\r\\nimport type { BarSize, SteelGrade } from '../model/member'\\r\\nimport { MemberUnsupportedError } from '../model/unsupported'\\r\\nimport { lookupRule } from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\n\\r\\n/**\\r\\n * 佯딀씮訝사춮?뚦ㄷ歟곥겗訝?겎?⒲걝若싩??쇻굥??(ADR-028)??\\r\\n *\\r\\n * 鸚㎪쥈??`resolveGirderEnd` ?ⓨ릪?섇숱?졼걣?곩폊?뤷닓?뚪걬?녴?\\r\\n *   訝뗧ク嶺???烏?.3.4 ??**L3竊덀궧?⒲깣轝꾬펹**??0d ?뗣겇150mm餓δ툓??力?)\\r\\n *   訝딁ク嶺???烏?.3.4 ????у?**L1**(力?)?귛뀯?됥겒?묆굦??5.3.4(5)(節? ??뒛?꿔걩若싩??㎯?\\r\\n *            ?뺝쉽??〃5.3.5 ??**Lb**?뚦컦歟곩룋?녈궧?⒲깣??툓塋?춮??쥈?끾뒛?꿔걩若싩???力?)\\r\\n *\\r\\n * 歟곦말嶺뗣겏?뺛걚?곫뒘壤긱겓?뚧윶?쎼걚??/4 ?띴빳訝듽띲겗訝뗩솏??럾?뗣굢?ゃ걚 ??5.3.4(5)(節?(c)\\r\\n * ??걹??퐜?멥겘?뚧쥈訝사춮??윶?끻츣??ャ걡?꾠겍??띲겏野얕괌?믧솏?ｃ겍?꾠굥??\\r\\n *\\r\\n * 訝뗧ク嶺뗣겓??뒛?꿔걩??껁걩?볝걣?ゃ걚?귟〃5.3.5 ??Lb ??툓塋?춮??닓?㎯걗?듽곮〃5.3.4 ??\\r\\n * L3h ??궧?⒲깣轝꾠걣?잍뻼?㎯뚢??띲걽?귝뵱?밤겓?γ굢?ゃ걨?뚣겙?꿔걩?밤굮獒썲뱚?뚥퐳?됥걳?썬겏?쇻?\\r\\n */\\r\\ninterface UsedRules {\\r\\n  usedRules: RuleHit[]\\r\\n}\\r\\n\\r\\nexport type SlabEndDetail =\\r\\n  | ({\\r\\n      kind: '?당퇉若싩?'\\r\\n      /**\\r\\n       * ?룔걬?믣츪?쎼겓黎뷩굙?잒죱?귚툔塋?춮??L3 ???0d ?뗣겇150mm餓δ툓?띲겒??겎??\\r\\n       * 榮겹걚孃꾠겎??툔?먦걣?앫겇 ??L3 ?②〃鹽뷩걲?뗣겏?방떊?뚥틟若잆겎?ゃ걦?ゃ굥??\\r\\n       */\\r\\n      lengthRule: 'anchorage.L1' | 'anchorage.L3' | 'anchorage.L3.minimum'\\r\\n      lengthMm: number\\r\\n    } & UsedRules)\\r\\n  | ({\\r\\n      kind: '?섉쎊?믣츣?'\\r\\n      /** max(L1, ?뺝쉽竊뗤퐰?룝툔?? ???앫겂?잓쟿?ユ졊?졼걣餓섅걦 */\\r\\n      lengthRule: 'anchorage.L1' | 'anchorage.bent.tail.minimum'\\r\\n      /** 佯딀씮??뒘壤긱겘烏?.3.5 Lb ?앫겗?귙겗?귞ザ?녵툔?먦걣?ゃ걚 */\\r\\n      projectionRule: 'anchorage.Lb'\\r\\n      lengthMm: number\\r\\n      /** 5.3.4(5)(節?(a)?뚦뀲?룔겘?곮〃5.3.4 ??쎍渶싧츣???빓?뺜빳訝듽겏?쇻굥?띲겗 L1 */\\r\\n      straightMinimumMm: number\\r\\n      /** ??b)?뚥퐰?룔겘??d 餓δ툓?띲굮?③빓??툔?먦겓?쏁츞?쀣걼?귙겗 */\\r\\n      tailMinimumMm: number\\r\\n      /** ??c) ?뺝쉽若싩??룔걬 竊?烏?.3.5 Lb */\\r\\n      projectionMm: number\\r\\n    } & UsedRules)\\r\\n\\r\\nexport interface SlabEndInput {\\r\\n  /** 若싩??덀겗鸚㎪쥈??퉭 b (mm) ??佯딀씮嶺뗣겘?볝겗訝?겦?γ겂?╉걚??*/\\r\\n  supportWidthMm: number\\r\\n  /** 若싩??덀겗鸚㎪쥈??걢?뜰굤?㏛폏?▽뻑?귛틞?욍겗?귙겗?㎯겘?ゃ걚 */\\r\\n  supportCover: Record<string, string | boolean>\\r\\n  barSize: BarSize\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  face: '訝딁ク' | '訝뗧ク'\\r\\n}\\r\\n\\r\\nfunction barDiameter(size: BarSize): number {\\r\\n  const diameter = Number(size.replace(/^D/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid BarSize: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\r\\n  if (rule.unit === 'mm') return rule.value\\r\\n  if (rule.unit === 'd' && diameter !== undefined) {\\r\\n    return rule.value * diameter\\r\\n  }\\r\\n\\r\\n  throw new Error(\\r\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function resolveSlabEnd(\\r\\n  input: SlabEndInput,\\r\\n  pack: RulePack,\\r\\n): SlabEndDetail {\\r\\n  const diameter = barDiameter(input.barSize)\\r\\n  const minimumCoverRule = lookupRule(pack, 'cover.minimum', input.supportCover)\\r\\n  const fabricationCoverAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.fabrication.addition',\\r\\n    {},\\r\\n  )\\r\\n  const coverRules = [minimumCoverRule, fabricationCoverAdditionRule]\\r\\n  const availableMm =\\r\\n    input.supportWidthMm -\\r\\n    (millimetres(minimumCoverRule) +\\r\\n      millimetres(fabricationCoverAdditionRule))\\r\\n\\r\\n  if (input.face === '訝뗧ク') {\\r\\n    return resolveBottom(input, pack, diameter, availableMm, coverRules)\\r\\n  }\\r\\n\\r\\n  return resolveTop(input, pack, diameter, availableMm, coverRules)\\r\\n}\\r\\n\\r\\n/**\\r\\n * 訝뗧ク嶺???烏?.3.4 力? ??L3?귙?0d ?뗣겇150mm餓δ툓?띲겒??겎雅뚣겇??죱??ㄷ?띲걚?밤걽??\\r\\n * 鸚㎯걤?꾣뼶?믣룚?뗨쮫嶸쀣걣?볝걪?ャ걗?듽곥꺂?쇈꺂?묆긿??겘 10d ??150mm ?믣닪?끹겓?곥겇\\r\\n * (ADR-002 ???먨뒟鶯곥겗?띲겖泳숁뎸訝뗩솏?ⓨ릪?섇숱)??\\r\\n */\\r\\nfunction resolveBottom(\\r\\n  input: SlabEndInput,\\r\\n  pack: RulePack,\\r\\n  diameter: number,\\r\\n  availableMm: number,\\r\\n  coverRules: RuleHit[],\\r\\n): SlabEndDetail {\\r\\n  const perDiameterRule = lookupRule(pack, 'anchorage.L3', { member: '?밤꺀?? })\\r\\n  const floorRule = lookupRule(pack, 'anchorage.L3.minimum', {\\r\\n    member: '?밤꺀??,\\r\\n  })\\r\\n  const perDiameterMm = millimetres(perDiameterRule, diameter)\\r\\n  const floorMm = millimetres(floorRule)\\r\\n  const lengthMm = Math.max(perDiameterMm, floorMm)\\r\\n\\r\\n  if (lengthMm > availableMm) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '若싩?訝띷닇塋?,\\r\\n      `佯딀씮訝뗧ク嶺뗣겗?당퇉若싩??뚦ㄷ歟곥겓?롢겲?됥겒?? ` +\\r\\n        `恙낁쫨 ${lengthMm} mm > 鵝욜뵪??꺗 ${availableMm} mm`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    kind: '?당퇉若싩?',\\r\\n    lengthRule:\\r\\n      perDiameterMm >= floorMm ? 'anchorage.L3' : 'anchorage.L3.minimum',\\r\\n    lengthMm,\\r\\n    usedRules: [perDiameterRule, floorRule, ...coverRules],\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 訝딁ク嶺???訝?у?L1(力?)?괢2 ??뚦돯獒귞졃鶯듽겗?듽걹?뚣겗?ゃ걚嶸뉑??띺솏若싥겎?곥걹??\\r\\n * ?ㅵ츣?먩뼑?믦＝?곥걣?곥걼?ゃ걚 (R7)?귞쎍渶싥걣?γ굢?ゃ걨?뚣겙 5.3.4(5)(節? ??(a)(b)(c)??\\r\\n */\\r\\nfunction resolveTop(\\r\\n  input: SlabEndInput,\\r\\n  pack: RulePack,\\r\\n  diameter: number,\\r\\n  availableMm: number,\\r\\n  coverRules: RuleHit[],\\r\\n): SlabEndDetail {\\r\\n  const straightRule = lookupRule(pack, 'anchorage.L1', {\\r\\n    fc: input.fc,\\r\\n    grade: input.grade,\\r\\n    hook: false,\\r\\n  })\\r\\n  const straightLengthMm = millimetres(straightRule, diameter)\\r\\n\\r\\n  if (straightLengthMm <= availableMm) {\\r\\n    return {\\r\\n      kind: '?당퇉若싩?',\\r\\n      lengthRule: 'anchorage.L1',\\r\\n      lengthMm: straightLengthMm,\\r\\n      usedRules: [straightRule, ...coverRules],\\r\\n    }\\r\\n  }\\r\\n\\r\\n  // anchorage.L1h ??폊?뗣겒????5.3.4(5)(節? ??L1h ??*?⑴뵪?▽뻑**?㎯걗?ｃ겍\\r\\n  // (a)(b)(c) ??겑??ㅳ굚黎뷩굙?ゃ걚 (鸚㎪쥈??resolveGirderEnd ?ⓨ릪?섊릤????\\r\\n  const projectionRule = lookupRule(pack, 'anchorage.Lb', {\\r\\n    fc: input.fc,\\r\\n    grade: input.grade,\\r\\n  })\\r\\n  const tailMinimumRule = lookupRule(pack, 'anchorage.bent.tail.minimum', {})\\r\\n  const projectionMm = millimetres(projectionRule, diameter)\\r\\n\\r\\n  if (projectionMm > availableMm) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '若싩?訝띷닇塋?,\\r\\n      `佯딀씮訝딁ク嶺뗣겗?섉쎊?믣츣??뚦ㄷ歟곥겓?롢겲?됥겒?? ` +\\r\\n        `恙낁쫨?뺝쉽 ${projectionMm} mm > 鵝욜뵪??꺗 ${availableMm} mm`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const tailMinimumMm = projectionMm + millimetres(tailMinimumRule, diameter)\\r\\n  const lengthMm = Math.max(straightLengthMm, tailMinimumMm)\\r\\n\\r\\n  return {\\r\\n    kind: '?섉쎊?믣츣?',\\r\\n    lengthRule:\\r\\n      straightLengthMm >= tailMinimumMm\\r\\n        ? 'anchorage.L1'\\r\\n        : 'anchorage.bent.tail.minimum',\\r\\n    projectionRule: 'anchorage.Lb',\\r\\n    lengthMm,\\r\\n    straightMinimumMm: straightLengthMm,\\r\\n    tailMinimumMm,\\r\\n    projectionMm,\\r\\n    usedRules: [\\r\\n      straightRule,\\r\\n      projectionRule,\\r\\n      tailMinimumRule,\\r\\n      ...coverRules,\\r\\n    ],\\r\\n  }\\r\\n}\\r\\n/** BAR_SIZES ?ⓨ릪?섅걦?곩츪烏뚧셽?ユ쩂?곥굢?뚣굥?덀걝?띶닓?뗣굢?뗣굮壅룔걪?쇻?*/\\r\\nexport const MEMBER_KINDS = ['??, '鸚㎪쥈', '?먬쐡鶯?, '佯딀씮'] as const\\r\\n\\r\\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\\r\\n\\r\\nexport type MemberClass = '翁?퐪'\\r\\n\\r\\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\\r\\nexport const BAR_SIZES = [\\r\\n  'D10',\\r\\n  'D13',\\r\\n  'D16',\\r\\n  'D19',\\r\\n  'D22',\\r\\n  'D25',\\r\\n  'D29',\\r\\n  'D32',\\r\\n] as const\\r\\n\\r\\nexport type BarSize = (typeof BAR_SIZES)[number]\\r\\n\\r\\n/**\\r\\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\\r\\n *\\r\\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\\r\\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\\r\\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\\r\\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\\r\\n *\\r\\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\\r\\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\\r\\n *\\r\\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\\r\\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\\r\\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\\r\\n */\\r\\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\\r\\n\\r\\nexport type HighStrengthShearBarSize =\\r\\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\\r\\n\\r\\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\\r\\nexport const SHEAR_BAR_SIZES = [\\r\\n  ...BAR_SIZES,\\r\\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\\r\\n] as const\\r\\n\\r\\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\\r\\n\\r\\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\\r\\n\\r\\n/**\\r\\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯겗?ε뒟?㎯걗?ｃ겍獒썲뱚?뚧군?곥겒??(ADR-012)??\\r\\n *\\r\\n * ?곈뇧令띸츞?뷸틬 1?싧뎴4)??) ?뚦릫?뉎걲??겘?띲겖泳숁뎸?ⓦ궗?밧쑇?η텤?뗣걽?묆겒??겎??\\r\\n * 艅잍ː凉뤵꺕繹뜻렏??돮?꾠겘?ャ꺖?ャ깙?껁궚?담겎 `inferred` ??죱?ャ겒?????멥겧?뗣걣\\r\\n * ?ょ▶沃띲겏?쀣겍鈺?몜?뚥퍡??(ADR-015)??\\r\\n */\\r\\nexport const SPLICE_METHODS = [\\r\\n  '?띲겖泳숁뎸',\\r\\n  '?с궧?㎪렏',\\r\\n  '艅잍ː凉?,\\r\\n  '繹뜻렏',\\r\\n] as const\\r\\n\\r\\nexport type SpliceMethod = (typeof SPLICE_METHODS)[number]\\r\\n\\r\\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\\r\\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\\r\\n\\r\\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\\r\\n\\r\\n/**\\r\\n * ?긱겗??씊壤®듁??\\r\\n *\\r\\n * ?녶숱?긱겘 b?팪 ?믡겏?귙겓?닷푶?ャ걲?뗣귛ㄷ歟곥겗?끾퀡?룔걬??3D ??윶?㏂굚 b?팪 ?뗣굢\\r\\n * 黎뷩겲?뗣겗?㎯곩쨼?ε?力뺛겏?쀣겍?뚣걯?ㅳ굮營?걨?겼숱?뜰겗瓦썲뒥?뚩쮫歷ц쫸?뉎굮?뷩굢?뺛겒?꾠?\\r\\n * ?곈뇧?㎩숱?뜰굮誤뗣굥??겘 1?싧뎴2)?뚧뼪?㏂겗鼇?쮫野멩퀡?ャ굠?뗥뫅?룔띲걼?졽?嶸뉑??㎯?\\r\\n * ?녶숱??씊?㎯겘?앫겗?③빓?뚦냶?ⓦ겓?ゃ굥 ??獒썲뱚?뚧뼭?쀣걚?ㅳ굮鵝쒌굥?뤵걨?㎯겘?ゃ걚 (ADR-027)??\\r\\n *\\r\\n * ?밤깙?ㅳ꺀?ョ춮??돮?뤵겒?꾠귝쮽繹뽨퍞礪섉쎑 5.3.4(6)(節? ?뚣뚣궧?묆궎?⒲꺂嶺뗣겗泳숁뎸?듽겞若싩???\\r\\n * ??.3.5 ?ャ굠?뗣띲겏?녈겓冶붵겖?╉걡?듽곥걹??쎋??렅?뉎겎?삣깗??(烏?.3.3 ?ⓨ릪????\\r\\n * ??씊?ゃ궧?덀걣?똇OOP D13@100?띲겏?멥걚?╉걚?뚣겙?앫굦??깢?쇈깤?㎯걗?ｃ겍?곮＝?곥걣\\r\\n * ?밤깙?ㅳ꺀?ャ겏沃?겳?욍걟?뗣걪?ⓦ겘?쀣겒??(ADR-012)??\\r\\n */\\r\\nexport type ColumnShape = '?⒴숱' | '?녶숱'\\r\\n\\r\\nexport interface ColumnSection {\\r\\n  id: string\\r\\n  kind: '??\\r\\n  mark: string\\r\\n  /**\\r\\n   * ??씊?ゃ궧?덉뿉??痍⑥엯?????대뒓 ???됱뿉???붾뒗吏. 寧?뤇(mark)??遺숈씠硫??꾨㈃???녿뒗\\r\\n   * 寧?뤇???낁㉢?몄뿉 洹몃?濡??섍?怨??낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\\r\\n   * ?쒗뭹??Story???鴉뤷쎋 痍⑥엯 ?붾㈃?먯꽌 ?뺥솗 ?쇱튂 ?먮룞 ?좏깮?쇰줈 ?뉖뒗??(ADR-035).\\r\\n   */\\r\\n  storyLabel?: string\\r\\n  /** ??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗?뗣?*/\\r\\n  shape: ColumnShape\\r\\n  b: number\\r\\n  d: number\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  exposure: Exposure\\r\\n  finish: Finish\\r\\n  /** 訝사춮??텤?뗦뼶凉???泳숁뎸嶸뉑??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 (令띸츞?뷸틬 1?싧뎴4)??)) */\\r\\n  spliceMethod: SpliceMethod\\r\\n  main: {\\r\\n    size: BarSize\\r\\n    count: number\\r\\n  }\\r\\n  hoop: {\\r\\n    size: ShearBarSize\\r\\n    pitch: number\\r\\n    /**\\r\\n     * ?띸쉰?븅뼋?????앸㈃?먯꽌 寧?쨌?永귛릭嶺뗭쓣 ?쇰쭏???꾩슦?붿?. 誤뤸틬??媛믪씠 ?녾퀬\\r\\n     * ?ф빊瑜?醫뚯슦?섎?濡??쒗뭹???뺥븯吏 ?딅뒗??????씊訝誤㏃쓽 ?낅젰?대떎 (ADR-012).\\r\\n     */\\r\\n    startOffsetMm: number\\r\\n  }\\r\\n}\\r\\n\\r\\n/** 鸚㎪쥈 訝사춮 1餘듸펷訝딁ク?얇걼??툔塋?펹??퐤營?닪?ф빊?귝뼪?㏂꺁?밤깉??ク?ⓦ꺕訝?ㄾ烏뚣겓野얍퓶?쇻굥??*/\\r\\nexport interface GirderMainRow {\\r\\n  /** 塋?깿竊덃뵱?밧겢竊됥겗?ф빊 */\\r\\n  endCount: number\\r\\n  /** 訝?ㄾ??쑍??*/\\r\\n  centerCount: number\\r\\n  /**\\r\\n   * 冶뗧ク?담겗?ф빊 ??藥?뤂?㏝걬?녴겏?띲걽?묉똻?ㅳ귞꽒?묆굦??endCount ?ⓨ릪?섓펷野양㎞竊됥?\\r\\n   * 冶뗧ク??꺀?녈꺆?쇈궖?ワ펷GirderRun.memberOffsetsMm ??0 ?댐펹??\\r\\n   */\\r\\n  startCount?: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鸚㎪쥈訝사춮??퐤營?닪?ф빊?믡곲뇥?ゃ굤?믢퓷?ㅳ궛?ャ꺖?쀣겦?녻㎗?쇻굥??\\r\\n *\\r\\n * ?ф빊??눕令띺썓?덀겏?쀣겍鰲ｉ뇠?쇻굥?귡싥걮嶺뗣꺕冶뗧ク/永귞ク stub?삡릎鸚?춮?ュ뒥?덀겍??\\r\\n * 訝?밤겗??궧?졼걨?㎩츣??쇻굥 ?몄륫洹쇈굮瓦붵걲?귛쭓塋?겏永귞ク??륫?밤겓若싩??쇻굥 ?몄륫洹쇈겘\\r\\n * ?뚧셽?ユ닇塋뗣걮?ゃ걚?잆굙??oneSidedAnchor` ????밤걽?묆굮?곥겇 (ADR-032)??\\r\\n */\\r\\nexport interface GirderMainDecomposition {\\r\\n  throughCount: number\\r\\n  startStubCount: number\\r\\n  endStubCount: number\\r\\n  centerOnlyCount: number\\r\\n  oneSidedCount: number\\r\\n  oneSidedAnchor?: '冶뗧ク' | '永귞ク'\\r\\n}\\r\\n\\r\\nexport function decomposeGirderMainRow(\\r\\n  row: GirderMainRow,\\r\\n): GirderMainDecomposition {\\r\\n  const startCount = row.startCount ?? row.endCount\\r\\n  const throughCount = Math.min(startCount, row.centerCount, row.endCount)\\r\\n  const startStubCount = Math.max(0, startCount - row.centerCount)\\r\\n  const endStubCount = Math.max(0, row.endCount - row.centerCount)\\r\\n  const centerOnlyCount = Math.max(\\r\\n    0,\\r\\n    row.centerCount - Math.max(startCount, row.endCount),\\r\\n  )\\r\\n  const oneSidedStartCount = Math.max(\\r\\n    0,\\r\\n    Math.min(startCount, row.centerCount) - row.endCount,\\r\\n  )\\r\\n  const oneSidedEndCount = Math.max(\\r\\n    0,\\r\\n    Math.min(row.centerCount, row.endCount) - startCount,\\r\\n  )\\r\\n\\r\\n  if (oneSidedStartCount > 0) {\\r\\n    return {\\r\\n      throughCount,\\r\\n      startStubCount,\\r\\n      endStubCount,\\r\\n      centerOnlyCount,\\r\\n      oneSidedCount: oneSidedStartCount,\\r\\n      oneSidedAnchor: '冶뗧ク',\\r\\n    }\\r\\n  }\\r\\n\\r\\n  if (oneSidedEndCount > 0) {\\r\\n    return {\\r\\n      throughCount,\\r\\n      startStubCount,\\r\\n      endStubCount,\\r\\n      centerOnlyCount,\\r\\n      oneSidedCount: oneSidedEndCount,\\r\\n      oneSidedAnchor: '永귞ク',\\r\\n    }\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    throughCount,\\r\\n    startStubCount,\\r\\n    endStubCount,\\r\\n    centerOnlyCount,\\r\\n    oneSidedCount: 0,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport interface GirderSection {\\r\\n  id: string\\r\\n  kind: '鸚㎪쥈'\\r\\n  mark: string\\r\\n  /** ColumnSection.storyLabel怨?媛숇떎. */\\r\\n  storyLabel?: string\\r\\n  b: number\\r\\n  depth: number\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  exposure: Exposure\\r\\n  finish: Finish\\r\\n  /** ColumnSection.spliceMethod ?ⓨ릪?섅귡싥걮嶺뗣겗泳숁뎸嶸뉑??겹겓?밤걦 */\\r\\n  spliceMethod: SpliceMethod\\r\\n  main: {\\r\\n    size: BarSize\\r\\n    /** 訝딁ク嶺뗣겗鵝띸쉰?ζ쑍??????씊?ゃ궧?덀겗塋?깿?삡릎鸚?죱?뚣걹??겲?얍뀯??*/\\r\\n    top: GirderMainRow\\r\\n    /** 訝뗧ク嶺뗣겗鵝띸쉰?ζ쑍??*/\\r\\n    bottom: GirderMainRow\\r\\n    /**\\r\\n     * ?ャ긿?덀궕?뺟춮?믤윶?㏂걢?됪쥈??냵?담겦鵝?mm ?㎩늾?딀??곥굥?뗣?\\r\\n     *\\r\\n     * ?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1) ?뚣뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑\\r\\n     * ?ャ굠?뗣띲겏冶붵겖?뗣겗?㎬쫸繹뽩겢?ュㅳ걣?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012)??\\r\\n     * 塋?깿?ⓧ릎鸚?걣?뚧빊竊덀궖?껁깉?ゃ깢嶺뗣걣?ゃ걚竊됪뼪?㏂겎??슴?뤵굦?ゃ걚??\\r\\n     */\\r\\n    cutoffFromSupportFaceMm: number\\r\\n  }\\r\\n  stirrup: {\\r\\n    size: ShearBarSize\\r\\n    pitch: number\\r\\n    /** 訝←ク??윶?㏂걢?됬К1?삥?永귙걗?겹굢嶺뗣굮?⒲굦?졼걨?㏂걲?뗣귟쫸繹뽧겓?ㅳ겘?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012) */\\r\\n    startOffsetMm: number\\r\\n  }\\r\\n  /**\\r\\n   * 亮끾??곭춮?귝뼪?㏘?誤㎯겓鼇섋펹??겒?꾣쥈?ャ겘?▲걚?띸춮?ゃ겗?㏛뻣?뤻쟿??겏?쀣?\\r\\n   * `undefined` ??뚪뀓嶺뗣겒?쀣띲굮?뤷뫑?쇻굥 ??獒썲뱚?뚦떇?뗣겓擁녈걬?ゃ걚 (ADR-012)??\\r\\n   * 鼇?쮫?룔걬??빊?뤹찉嶸쀥읃繹?1?싧뎴3) ?뚧뼪?㏂겗鼇?쮫亮끹겏若싥굙?뗣겗?㎩뀯?쎼겘孃꾠겏?붵긿?곥걽?묆?\\r\\n   */\\r\\n  widthTie?: {\\r\\n    size: BarSize\\r\\n    pitch: nu