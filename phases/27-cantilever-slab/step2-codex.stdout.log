Stats {\r\n 274:   lastRebuildMs: number | null\r\n 275:   rebuildCount: number\r\n 276: }\r\n 277: interface KijunViewerRuntimeHook {\r\n 278:   getRendererInfo(): { calls: number; triangles: number }\r\n 279:   getFrameTimestamps(): number[]\r\n 280:   getRebuildStats(): RebuildStats\r\n 281: }\r\n 282: type WindowWithViewerHook = Window & {\r\n 283:   __kijunViewerRuntime?: KijunViewerRuntimeHook\r\n 284: }\r\n 285: \r\n 286: function vector(point: Point3): THREE.Vector3 {\r\n 287:   return new THREE.Vector3(...point).multiplyScalar(MILLIMETRES_TO_SCENE)\r\n 288: }\r\n 289: \r\n 290: function applyClipPlane(\r\n1110:     runtime,\r\n1111:     'buildingConcrete',\r\n1112:     () =>\r\n1113:       new THREE.MeshStandardMaterial({\r\n1114:         color: CONCRETE_COLOR,\r\n1115:         transparent: true,\r\n1116:         opacity: 0.18,\r\n1117:         roughness: 0.9,\r\n1118:         metalness: 0,\r\n1119:         depthWrite: false,\r\n1120:         clippingPlanes: [runtime.clipPlane],\r\n1121:         clipShadows: true,\r\n1122:       }),\r\n1123:   )\r\n1124:   const concreteSelectedMaterial = pooledMaterial(\r\n1125:     runtime,\r\n1126:     'buildingConcreteSelected',\r\n1127:     () =>\r\n1128:       new THREE.MeshStandardMaterial({\r\n1129:         color: CONCRETE_COLOR,\r\n1130:         transparent: true,\r\n1131:         opacity: 0.18,\r\n1132:         roughness: 0.9,\r\n1133:         metalness: 0,\r\n1134:         depthWrite: false,\r\n1135:         emissive: HIGHLIGHT_COLOR,\r\n1136:         emissiveIntensity: 0.3,\r\n1137:         clippingPlanes: [runtime.clipPlane],\r\n1138:         clipShadows: true,\r\n1139:       }),\r\n1140:   )\r\n1141:   const outlineMaterial = pooledMaterial(\r\n1142:     runtime,\r\n1143:     'outline',\r\n1144:     () =>\r\n1145:       new THREE.LineBasicMaterial({\r\n1146:         color: OUTLINE_COLOR,\r\n1147:         clippingPlanes: [runtime.clipPlane],\r\n1148:         clipShadows: true,\r\n1149:       }),\r\n1150:   )\r\n1151:   const pickableMeshes: THREE.Mesh[] = []\r\n1152: \r\n1153:   for (const box of layout.boxes) {\r\n1154:     const geometry = concreteGeometry(box)\r\n1155:     const mesh = new THREE.Mesh(geometry, concreteMaterial)\r\n1156:     mesh.position.copy(vector(box.center))\r\n1157:     mesh.receiveShadow = true\r\n1158:     mesh.userData.memberId = box.memberId\r\n1159:     mesh.userData.layer = 'concrete'\r\n1160:     content.add(mesh)\r\n1161:     pickableMeshes.push(mesh)\r\n1162: \r\n1163:     const outline = new THREE.LineSegments(\r\n1164:       new THREE.EdgesGeometry(geometry),\r\n1165:       outlineMaterial,\r\n1166:     )\r\n1167:     outline.position.copy(mesh.position)\r\n1168:     outline.userData.layer = 'concrete'\r\n1169:     content.add(outline)\r\n1170:   }\r\n1171: \r\n1172:   // 泥좉렐? ?쒖떆 諛섍꼍쨌?덉씠?대퀎 InstancedMesh ???⑥쐞 ?믪씠 ?ㅻ┛?붾? Y ?ㅼ??쇰줈 ?섏씤??(R4).\r\n1173:   const matrix = new THREE.Matrix4()\r\n1174:   const position = new THREE.Vector3()\r\n1175:   const quaternion = new THREE.Quaternion()\r\n1176:   const scale = new THREE.Vector3()\r\n1177:   const direction = new THREE.Vector3()\r\n1178: \r\n1179:   for (const instances of groupInstancesByLayerAndRadius(\r\n1180:     layout.rebar,\r\n1181:   ).values()) {\r\n1182:     const { radius, layer } = instances[0]\r\n1183:     const geometry = new THREE.CylinderGeometry(\r\n1184:       radius * MILLIMETRES_TO_SCENE,\r\n1185:       radius * MILLIMETRES_TO_SCENE,\r\n1186:       1,\r\n1187:       CYLINDER_RADIAL_SEGMENTS,\r\n1188:     )\r\n1189:     const instanced = new THREE.InstancedMesh(\r\n1190:       geometry,\r\n1191:       steelMaterial,\r\n1192:       instances.length,\r\n1193:     )\r\n1194:     const memberIds: string[] = []\r\n1195: \r\n1196:     instances.forEach((instance, index) => {\r\n1197:       const from = vector(instance.from)\r\n1198:       const to = vector(instance.to)\r\n1199:       direction.copy(to).sub(from)\r\n1200:       const length = Math.max(direction.length(), Number.EPSILON)\r\n1201:       if (direction.lengthSq() === 0) direction.copy(Y_AXIS)\r\n1202:       position.copy(from).add(to).multiplyScalar(0.5)\r\n1203:       quaternion.setFromUnitVectors(Y_AXIS, direction.normalize())\r\n1204:       scale.set(1, length, 1)\r\n1205:       matrix.compose(position, quaternion, scale)\r\n1206:       instanced.setMatrixAt(index, matrix)\r\n1207:       memberIds.push(instance.memberId)\r\n1208:     })\r\n1209:     instanced.instanceMatrix.needsUpdate = true\r\n1210:     instanced.castShadow = true\r\n1211:     instanced.userData.memberIds = memberIds\r\n1212:     instanced.userData.layer = layer\r\n1213:     content.add(instanced)\r\n1214:     pickableMeshes.push(instanced)\r\n1215:   }\r\n1216: \r\n1217:   addGround(content, layout.bounds, runtime)\r\n1218: \r\n1219:   runtime.content = content\r\n1220:   runtime.concreteNormalMaterial = concreteMaterial\r\n1221:   runtime.concreteSelectedMaterial = concreteSelectedMaterial\r\n1222:   runtime.pickableMeshes = pickableMeshes\r\n1223:   runtime.scene.add(content)\r\n1224:   frameContent(runtime, layout.bounds, 'building')\r\n1225: }\r\n1226: \r\n1227: /**\r\n1228:  * ?ъ쓣 ?ㅼ떆 吏???댁쑀媛 ?섎뒗 媛믩쭔 紐⑥? ?? `Project`媛 諛붾??뚮쭏??`rebars`쨌\r\n1229:  * `lines` 諛곗뿴? ?덈줈 留뚮뱾?댁?誘濡?李몄“ 鍮꾧탳濡쒕뒗 留ㅻ쾲 ?ъ깮?깅맂?????숃???湲?먯뿉\r\n1230:  * 湲곕뫁 ?꾩껜瑜??먭린?섍퀬 ?ㅼ떆 留뚮뱾吏 ?딆쑝?ㅻ㈃ ?댁슜?쇰줈 鍮꾧탳?댁빞 ?쒕떎.\r\n1231:  */\r\n1232: function geometryKey(view: SelectedSupportedMemberView): string {\r\n1233:   const sectionGeometry =\r\n1234:     view.kind === '佯딀씮'\r\n1235:       ? [\r\n1236:           view.section.thickness,\r\n1237:           view.section.x,\r\n1238:           view.section.y,\r\n1239:           view.x.run.coreLengthMm,\r\n1240:           view.x.offsetMm,\r\n1241:           view.x.run.members.map(({ id }) => id),\r\n1242:           view.y.run.coreLengthMm,\r\n1243:           view.y.offsetMm,\r\n1244:           view.y.run.members.map(({ id }) => id),\r\n1245:           view.bay.clearXMm,\r\n1246:           view.bay.clearYMm,\r\n1247:         ]\r\n1248:       : view.kind === '?먬쐡鶯?\r\n1249:       ? [\r\n1250:           view.section.thickness,\r\n1251:           view.section.layers,\r\n1252:           view.section.vertical,\r\n1253:           view.section.horizontal,\r\n1254:           view.span.clearLengthMm,\r\n1255:           view.span.clearHeightMm,\r\n1256:         ]\r\n1257:       : view.kind === '??\r\n1258:       ? [view.section.b, view.section.d, view.section.hoop]\r\n1259:       : [\r\n1260:           view.section.b,\r\n1261:           view.section.depth,\r\n1262:           view.section.stirrup,\r\n1263:           view.run.members.length,\r\n1264:           view.run.coreLengthMm,\r\n1265:           view.run.members.map(({ id }) => id),\r\n1266:           view.run.spans.map((span) => [\r\n1267:             span.clear,\r\n1268:             span.startSupportLengthAlongAxisMm,\r\n1269:             span.endSupportLengthAlongAxisMm,\r\n1270:           ]),\r\n1271:           view.supportSections.map(({ b, d }) => [b, d]),\r\n1272:         ]\r\n1273: \r\n1274:   return JSON.stringify([\r\n1275:     view.member.id,\r\n1276:     sectionGeometry,\r\n1277:     view.story.height,\r\n1278:     // placement??諛곗튂???좎씪??異쒖쿂????鍮쇰㈃ ?ф빊媛 媛숈? 諛곗튂 蹂寃?訝딃깿鸚㎪쥈?쎼걚\r\n1279:     // 誘몄꽭 議곗젙)???ъ쓣 ???꾩튂濡??④릿??\r\n1280:     view.rebars.map(\r\n1281:       ({ role, size, count, closed, points, zones, placement }) => [\r\n1282:         role,\r\n1283:         size,\r\n1284:         count,\r\n1285:         closed,\r\n1286:         points,\r\n1287:         zones,\r\n1288:         placement,\r\n1289:       ],\r\n1290:     ),\r\n1291:     [...view.rowIds],\r\n1292:   ])\r\n1293: }\r\n1294: \r\n1295: /** 兩븀돥 酉곗쓽 ?ш뎄???ъ쑀: 寃⑹옄쨌痢돠룸떒硫는룸???援ъ꽦??諛붾??뚮쭔. ?숃껊뒗 ?ㅼ뼱媛吏 ?딅뒗?? */\r\n1296: function buildingGeometryKey(project: Project): string {\r\n1297:   return JSON.stringify([\r\n1298:     project.grid,\r\n1299:     project.stories,\r\n1300:     project.sections,\r\n1301:     project.members,\r\n1302:   ])\