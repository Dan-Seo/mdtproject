t: Point3, margin = 0): void {\r\n  for (let axis = 0; axis < 3; axis += 1) {\r\n    bounds.min[axis] = Math.min(bounds.min[axis], point[axis] - margin)\r\n    bounds.max[axis] = Math.max(bounds.max[axis], point[axis] + margin)\r\n  }\r\n}\r\n\r\nfunction translate(point: Point3, offset: Point3): Point3 {\r\n  return [point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]]\r\n}\r\n\r\n/**\r\n * 兩븀돥 酉곗쓽 ?쒖닔 ?덉씠?꾩썐 (DESIGN.md 짠7). ??遺?ъ쓽 肄섑겕由ы듃 ?명삎怨?\r\n * 吏??遺?ъ쓽 諛곌렐 ?몄뒪?댁뒪瑜?mm 醫뚰몴濡??꾧컻?쒕떎. ?깅뒗 洹몃━??援먯젏??\r\n * ?⑤㈃ 以묒떖???뺣젹?섍퀬, 鸚㎪쥈??醫뚯륫 ?깅㈃쨌諛묐㈃쨌??紐⑥꽌由щ? 濡쒖뺄 ?먯젏?쇰줈 ?대떎.\r\n * 誘몄???鸚㎪쥈??肄섑겕由ы듃 諛뺤뒪留??④린怨?泥좉렐???꾧컻?섏? ?딅뒗??(R7 ??.\r\n */\r\nexport function buildingLayout(\r\n  project: Project,\r\n  rebars: Rebar[],\r\n  unsupportedMemberIds: ReadonlySet<string>,\r\n  radiusOf: RadiusOf = rebarRadius,\r\n): BuildingLayout {\r\n  const boxes: ConcreteBox[] = []\r\n  const instances: RebarInstance[] = []\r\n  const bounds = emptyBounds()\r\n\r\n  for (const member of project.members) {\r\n    const story = project.stories.find(({ id }) => id === member.storyId)\r\n    if (!story) {\r\n      throw storyNotFound(member.storyId)\r\n    }\r\n    const elevation = storyElevation(project.stories, member.storyId)\r\n    const section = findSection(project, member.sectionId)\r\n\r\n    let box: ConcreteBox\r\n    // ?뗥룭?ⓦ겎?뤵굤?쒌걚?잏졃?뉎귛즯?삣틞?욍걽?묆걣?곥겇 (1?싧뎴8))\r\n    let pieces: ConcreteBox[] | null = null\r\n    if (member.kind === '??) {\r\n      if (section.kind !== '?? || 'axis' in member.position) {\r\n        throw new Error(`??member references a non-??section: ${member.id}`)\r\n      }\r\n      const { x, y } = gridPoint(\r\n        project.grid,\r\n        member.position.ix,\r\n        member.position.iy,\r\n      )\r\n      box = {\r\n        memberId: member.id,\r\n        kind: '??,\r\n        center: [x, elevation + story.height / 2, y],\r\n        size: [section.b, story.height, section.d],\r\n        shape: section.shape,\r\n      }\r\n    } else if (member.kind === '鸚㎪쥈') {\r\n      if (section.kind !== '鸚㎪쥈' || !('axis' in member.position)) {\r\n        throw new Error(\r\n          `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${member.id}`,\r\n        )\r\n      }\r\n      const position = member.position\r\n      const start = gridPoint(project.grid, position.ix, position.iy)\r\n      const end =\r\n        position.axis === 'X'\r\n          ? gridPoint(project.grid, position.ix + 1, position.iy)\r\n          : gridPoint(project.grid, position.ix, position.iy + 1)\r\n      // 鸚㎪쥈 ?곷떒??痢?泥쒖옣??留욎텣??\r\n      const centerY = elevation + story.height - section.depth / 2\r\n      box =\r\n        position.axis === 'X'\r\n          ? {\r\n              memberId: member.id,\r\n              kind: '鸚㎪쥈',\r\n              center: [(start.x + end.x) / 2, centerY, start.y],\r\n              size: [end.x - start.x, section.depth, section.b],\r\n            }\r\n          : {\r\n              memberId: member.id,\r\n              kind: '鸚㎪쥈',\r\n              center: [start.x, centerY, (start.y + end.y) / 2],\r\n              size: [section.b, section.depth, end.y - start.y],\r\n            }\r\n    } else if (member.kind === '佯딀씮') {\r\n      if (section.kind !== '佯딀씮' || 'axis' in member.position) {\r\n        throw new Error(`佯딀씮 member references a non-佯딀씮 section: ${member.id}`)\r\n      }\r\n      // 佯딀씮?귛냵力뺡깿?녴걹??굚??걽竊덅변鵝볝겗?뷴늽竊덌폇竊됥뚧윶?곫쥈嶺됥겓?γ걲?뗦객亮녔쓲??\r\n      // ?끾퀡?ⓨ늽?랃펹?귡싥굤??뼋?㎪룒?뤵겏鸚㎪쥈?③뇥?ゃ겂?잍씮?ャ겒?뗣?\r\n      const origin = gridPoint(\r\n        project.grid,\r\n        member.position.ix,\r\n        member.position.iy,\r\n      )\r\n      const bay = slabBay(project, member)\r\n      // ?욍겗訝딃씊??쉸??ㄹ雅???鸚㎪쥈??툓塋?겏?뚣걯遙섅걬?㎯곥걹?볝걢?됪씮?싥걽?묇툔?뚣굥??\r\n      const topY = elevation + story.height\r\n      // 佯딀씮???? x ??툟?뚣겗 x竊덅뻗0竊됥곩?? y ??툟?뚣겗 z竊덅뻗2竊됥걽?귡뼀?ｉ깿??\r\n      // ?뤵굤?쒌걦 ???곈뇧?뚧쵟?ㅳ걮?╉걚?뗣겗?ユ씮?뚦줊?뚣겂?╉걚?╉겘沃ф삇?뚥퍡?뗣겒?꾠?\r\n      const slabOriginX = origin.x + bay.startFaceOffsetXMm\r\n      const slabOriginZ = origin.y + bay.startFaceOffsetYMm\r\n      box = {\r\n        memberId: member.id,\r\n        kind: '佯딀씮',\r\n        center: [\r\n          slabOriginX + bay.clearXMm / 2,\r\n          topY - section.thickness / 2,\r\n          slabOriginZ + bay.clearYMm / 2,\r\n        ],\r\n        size: [bay.clearXMm, section.thickness, bay.clearYMm],\r\n      }\r\n      pieces = carveBox(\r\n        box,\r\n        [0, 2],\r\n        boxHoles(member.openings ?? [], slabOriginX, slabOriginZ),\r\n      )\r\n    } else {\r\n      if (section.kind !== '?먬쐡鶯? || !('axis' in member.position)) {\r\n        throw new Error(\r\n          `?먬쐡鶯?member references a non-?먬쐡鶯?section: ${member.id}`,\r\n        )\r\n      }\r\n      // 鶯곥겘翁?퐪??뙷?놅펷寧?渶①К1塋좂К2影竊덌폊竊됧즯竊됥겎?뚧윶?곫쥈?곩틞?욜춬?ユ렏?쇻굥\r\n      // ?귞쎍?먦겗?끾퀡?ⓨ늽?띲겒??겎?곭??귛냵力뺛겎?뤵걦 ??訝?퓘?볝겎?뤵걦?ⓩ윶?삣ㄷ歟곥겏\r\n      // ?띲겒?ｃ걼塋뗤퐪?ャ겒?듽곫빊?륅펷?끾퀡竊됥겏誤뗣걼??걣繇잆걚?뺛걝??\r\n      const position = member.position\r\n      const start = gridPoint(project.grid, position.ix, position.iy)\r\n      const span = wallSpan(project, member)\r\n      const rangeOrigin = span.originOffsetMm ?? { along: 0, height: 0 }\r\n      const alongCenter =\r\n        span.startFaceOffsetMm + rangeOrigin.along + span.clearLengthMm / 2\r\n      const centerY = elevation + rangeOrigin.height + span.clearHeightMm / 2\r\n      // 鶯곥겗掠? x ??싥굤??겗?묆걤竊늌?싥굤?ゃ굢訝뽫븣??x 竊?邕??갳?싥굤?ゃ굢\r\n      // 訝뽫븣??z 竊?邕?竊됥곩?? y ??쳵??竊?邕? ?㎯걗?뗣?\r\n      const alongOrigin =\r\n        (position.axis === 'X' ? start.x : start.y) +\r\n        span.startFaceOffsetMm +\r\n        rangeOrigin.along\r\n      const holes = boxHoles(\r\n        member.openings ?? [],\r\n        alongOrigin,\r\n        elevation + rangeOrigin.height,\r\n      )\r\n      box =\r\n        position.axis === 'X'\r\n          ? {\r\n              memberId: member.id,\r\n              kind: '?먬쐡鶯?,\r\n              center: [start.x + alongCenter, centerY, start.y],\r\n              size: [span.clearLengthMm, span.clearHeightMm, section.thickness],\r\n            }\r\n          : {\r\n              memberId: member.id,\r\n              kind: '?먬쐡鶯?,\r\n              center: [start.x, centerY, start.y + alongCenter],\r\n              size: [section.thickness, span.clearHeightMm, span.clearLengthMm],\r\n            }\r\n      pieces = carveBox(box, position.axis === 'X' ? [0, 1] : [2, 1], holes)\r\n    }\r\n\r\n    // ?뤵걦??겘?뤵굤?쒌걚?잏졃?뉎걽?뚣곫옞??틕?뚣굤??뀇????㎪릍?????뗥룭?㎩쨼壤㏂걣\r\n    // 鸚됥굩?뗣굩?묆겎??겒?꾠걮?곩뀲?㏂걣?뗥룭??깿?먦겘?됥깳?ㅳ꺍?뚦뀍?ヨ맼?ⓦ걮?╉걚?뗣?\r\n    boxes.push(...(pieces ?? [box]))\r\n    expandBounds(bounds, [\r\n      box.center[0] - box.size[0] / 2,\r\n      box.center[1] - box.size[1] / 2,\r\n      box.center[2] - box.size[2] / 2,\r\n    ])\r\n    expandBounds(bounds, [\r\n      box.center[0] + box.size[0] / 2,\r\n      box.center[1] + box.size[1] / 2,\r\n      box.center[2] + box.size[2] / 2,\r\n    ])\r\n  }\r\n\r\n  for (const rebar of rebars) {\r\n    const member = project.members.find(({ id }) => id === rebar.memberId)\r\n    if (!member) {\r\n      throw new Error(`Member not found: ${rebar.memberId}`)\r\n    }\r\n    if (unsupportedMemberIds.has(member.id)) continue\r\n\r\n    const section = findSection(project, member.sectionId)\r\n    let worldPoint: (point: Point3) => Point3\r\n    // ?뗥룭?ⓦ겘?꾤춮????佯㎪쮽楹삠겎?뉎굥 (1?싧뎴8))?귛즯??깿?먨???앫겗?얇겲?곩틞?욍겘\r\n    // ?꾤춮?뚣꺀?녈겎歷с굢?뚣겍?꾠굥??겎?⒲꺍佯㎪쮽??굚??굮鵝욍걝??\r\n    let openings: Opening[] = []\r\n\r\n    if (member.kind === '??) {\r\n      if (section.kind !== '?? || 'axis' in member.position) {\r\n        throw new Error(`??member references a non-??section: ${member.id}`)\r\n      }\r\n      const { x, y } = gridPoint(\r\n        project.grid,\r\n        member.position.ix,\r\n        member.position.iy,\r\n      )\r\n      const offset: Point3 = [\r\n        x - section.b / 2,\r\n        storyElevation(project.stories, member.storyId),\r\n        y - section.d / 2,\r\n      ]\r\n      worldPoint = (point) => translate(point, offset)\r\n    } else if (member.kind === '鸚㎪쥈') {\r\n      if (section.kind !== '鸚㎪쥈' || !('axis' in member.position)) {\r\n        throw new Error(\r\n          `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${member.id}`,\r\n        )\r\n      }\r\n      const story = project.stories.find(({ id }) => id === member.storyId)\r\n      if (!story) {\r\n        throw storyNotFound(member.storyId)\r\n      }\r\n      const start = gridPoint(\r\n        project.grid,\r\n        member.position.ix,\r\n        member.position.iy,\r\n      )\r\n      const span = girderSpan(project, member)\r\n      const base =\r\n        storyElevation(project.stories, member.storyId) +\r\n        story.height -\r\n        section.depth\r\n\r\n      worldPoint =\r\n        member.position.axis === 'X'\r\n          ? ([x, y, z]) => [\r\n              start.x + span.startFaceOffsetMm + x,\r\n              base + y,\r\n              start.y - section.b / 2 + z,\r\n            ]\r\n          : ([x, y, z]) => [\r\n              start.x - section.b / 2 + z,\r\n              base + y,\r\n              start.y + span.startFaceOffsetMm + x,\r\n            ]\r\n    } else if (member.kind === '佯딀씮') {\r\n      if (section.kind !== '佯딀씮' || 'axis' in member.position) {\r\n        throw new Error(`佯딀씮 member references a non-佯딀씮 section: ${member.id}`)\r\n      }\r\n      const slabStory = project.stories.find(({ id }) => id === member.storyId)\r\n      if (!slabStory) {\r\n        throw storyNotFound(member.storyId)\r\n      }\r\n      const origin = gridPoint(\r\n        project.grid,\r\n        member.position.ix,\r\n        member.position.iy,\r\n      )\r\n      const bay = slabBay(project, member)\r\n      openings = slabRun(\r\n        project,\r\n        member,\r\n        rebar.role.startsWith('X?밧릲') ? 'X' : 'Y',\r\n      ).openings\r\n      // 佯딀씮??꺆?쇈궖?ュ렅?밤겘?뚦냵力뺝윜??X ?弱뤵꺕Y ?弱뤵겗?끹곫씮??툔塋?띲귡뎱嶺뗣겘\r\n      // ?⒲꺍??똻?▽말?ュ린掠욁걲?뗣겗?㎯곥걹??똻?▽말??깧?ㅳ겗?끾퀡?잏궧?뚣꺀?녈겗?잏궧?졼?\r\n      const base =\r\n        storyElevation(project.stories, member.storyId) +\r\n        slabStory.height -\r\n        section.thickness\r\n\r\n      worldPoint = ([x, y, z]) => [\r\n        origin.x + bay.startFaceOffsetXMm + x,\r\n        base + z,\r\n        origin.y + bay.startFaceOffsetYMm + y,\r\n      ]\r\n    } else {\r\n      if (section.kind !== '?먬쐡鶯? || !('axis' in member.position)) {\r\n        throw new Error(\r\n          `?먬쐡鶯?member references a non-?먬쐡鶯?section: ${member.id}`,\r\n        )\r\n      }\r\n      const start = gridPoint(\r\n        project.grid,\r\n        member.position.ix,\r\n        member.position.iy,\r\n      )\r\n      const span = wallSpan(project, member)\r\n      const rangeOrigin = span.originOffsetMm ?? { along: 0, height: 0 }\r\n      openings = member.openings ?? []\r\n      // 鶯곥겗??꺖?ャ꺂?잏궧??뚦쭓塋?겗?긷냵?닻씊?삣즯訝뗧ク?삣럻?뺛겗?뗥뎺?㏂띲귛즯訝뗧ク??\r\n      // ?롢겗佯딀씮訝딃씊竊앶쉸??읃繹뽪쮽遙섅걹??굚??겎?귙굥竊덂ㄷ歟곥겏?뺛걚鸚⒳틫?뗣굢訝뗣걩?ゃ걚竊됥?\r\n      const base = storyElevation(project.stories, member.storyId)\r\n\r\n      worldPoint =\r\n        member.position.axis === 'X'\r\n          ? ([x, y, z]) => [\r\n              start.x + span.startFaceOffsetMm + rangeOrigin.along + x,\r\n              base + rangeOrigin.height + y,\r\n              start.y - section.thickness / 2 + z,\r\n            ]\r\n          : ([x, y, z]) => [\r\n              start.x - section.thickness / 2 + z,\r\n              base + rangeOrigin.height + y,\r\n              start.y + span.startFaceOffsetMm + rangeOrigin.along + x,\r\n            ]\r\n    }\r\n\r\n    const layer = roleToLayer(rebar.role)\r\n\r\n    for (const segment of rebarSegments(rebar, section, radiusOf, openings)) {\r\n      const from = worldPoint(segment.from)\r\n      const to = worldPoint(segment.to)\r\n      instances.push({\r\n        memberId: member.id,\r\n        from,\r\n        to,\r\n        radius: segment.radius,\r\n        size: rebar.size,\r\n        role: rebar.role,\r\n        layer,\r\n      })\r\n      expandBounds(bounds, from, segment.radius)\r\n      expandBounds(bounds, to, segment.radius)\r\n    }\r\n  }\r\n\r\n  if (boxes.length === 0 && instances.length === 0) {\r\n    return { boxes, rebar: instances, bounds: { min: [0, 0, 0], max: [0, 0, 0] } }\r\n  }\r\n\r\n  return { boxes, rebar: instances, bounds }\r\n}\r\n\r\n/** InstancedMesh???꾩옱 ?덉씠???좉? 寃쎄퀎??留욎떠 ?쒖떆 ?덉씠?는룸컲寃쎈퀎 ?섎굹?? */\r\nexport function groupInstancesByLayerAndRadius(\r\n  instances: RebarInstance[],\r\n): Map<string, RebarInstance[]> {\r\n  const groups = new Map<string, RebarInstance[]>()\r\n\r\n  for (const instance of instances) {\r\n    const key = `${instance.radius}|${instance.layer}`\r\n    const group = groups.get(key)\r\n    if (group === undefined) groups.set(key, [instance])\r\n    else group.push(instance)\r\n  }\r\n\r\n  return groups\r\n}\r\n","exit_code":0,"status":"completed"}}
