uantityLine[],\r\n1362:   unsupportedMembers: UnsupportedMember[],\r\n1363: ): SelectedMemberView | null {\r\n1364:   if (memberId === null || selectedGroup === null) return null\r\n1365: \r\n1366:   const member = project.members.find(({ id }) => id === memberId)\r\n1367:   if (member === undefined) return null\r\n1368: \r\n1369:   const section = findSection(project, member.sectionId)\r\n1370:   const story = project.stories.find(({ id }) => id === member.storyId)\r\n1371:   if (story === undefined) {\r\n1372:     throw storyNotFound(member.storyId)\r\n1373:   }\r\n1374:   // 遺??醫낅쪟瑜?媛由ъ? ?딅뒗?????깅룄 ??씊訝誤??낅젰???곕씪 ?뺤긽???깅┰?섏?\r\n1375:   // ?딆쓣 ???덇퀬, 洹몃븣 ?낁㉢???ゅ?恙쒖씤??3D留?吏?먯쑝濡?蹂댁씠硫????쒕떎.\r\n1376:   const unsupported = unsupportedMembers.find(\r\n1377:     ({ memberId: unsupportedId }) => unsupportedId === memberId,\r\n1378:   )\r\n1379:   if (unsupported !== undefined) {\r\n1380:     return { status: 'unsupported', member, reason: unsupported.reason }\r\n1381:   }\r\n1382: \r\n1383:   if (member.kind === '??) {\r\n1384:     if (section.kind !== '??) {\r\n1385:       throw new Error(`??member references a non-??section: ${member.id}`)\r\n1386:     }\r\n1387:     return {\r\n1388:       status: 'supported',\r\n1389:       view: {\r\n1390:         kind: '??,\r\n1391:         member,\r\n1392:         section,\r\n1393:         story,\r\n1394:         ...selectedRows(new Set([member.id]), selectedGroup, rebars, lines),\r\n1395:       },\r\n1396:     }\r\n1397:   }\r\n1398: \r\n1399:   if (member.kind === '佯딀씮') {\r\n1400:     if (section.kind !== '佯딀씮') {\r\n1401:       throw new Error(`佯딀씮 member references a non-佯딀씮 section: ${member.id}`)\r\n1402:     }\r\n1403: \r\n1404:     const xRun = slabRun(project, member, 'X')\r\n1405:     const yRun = slabRun(project, member, 'Y')\r\n1406:     const indexIn = (run: SlabRun): number => {\r\n1407:       const index = run.members.findIndex(({ id }) => id === member.id)\r\n1408:       if (index === -1) {\r\n1409:         throw new Error(`佯딀씮 is outside its own run: ${member.id}`)\r\n1410:       }\r\n1411:       return index\r\n1412:     }\r\n1413:     // ?⒲꺍??똻?▽말?뚧똻?ㅹ뎱嶺뗣겗?녴걾?곥걪??릲?띲겗?귙겗?졼걨?믣룚?뗣귝똻?▽말??룏野얍릲?띲겗\r\n1414:     // ?⒲꺍??똻?▽말?㎯굚?귙굤孃쀣굥??겎?곲깿??id ?졼걨?㎫턂?뗣겏鵝쇿늽?ら뎱嶺뗣걣?γ굥??\r\n1415:     const slabRebars = rebars.filter(\r\n1416:       (rebar) =>\r\n1417:         (rebar.memberId === xRun.ownerId && rebar.role.startsWith('X?밧릲')) ||\r\n1418:         (rebar.memberId === yRun.ownerId && rebar.role.startsWith('Y?밧릲')),\r\n1419:     )\r\n1420: \r\n1421:     return {\r\n1422:       status: 'supported',\r\n1423:       view: {\r\n1424:         kind: '佯딀씮',\r\n1425:         member,\r\n1426:         section,\r\n1427:         story,\r\n1428:         bay: slabBay(project, member),\r\n1429:         x: { run: xRun, offsetMm: xRun.memberOffsetsMm[indexIn(xRun)] },\r\n1430:         y: { run: yRun, offsetMm: yRun.memberOffsetsMm[indexIn(yRun)] },\r\n1431:         ...rowsFor(slabRebars, selectedGroup, lines),\r\n1432:       },\r\n1433:     }\r\n1434:   }\r\n1435: \r\n1436:   if (member.kind === '?먬쐡鶯?) {\r\n1437:     if (section.kind !== '?먬쐡鶯?) {\r\n1438:       throw new Error(\r\n1439:         `?먬쐡鶯?member references a non-?먬쐡鶯?section: ${member.id}`,\r\n1440:       )\r\n1441:     }\r\n1442:     return {\r\n1443:       status: 'supported',\r\n1444:       view: {\r\n1445:         kind: '?먬쐡鶯?,\r\n1446:         member,\r\n1447:         section,\r\n1448:         story,\r\n1449:         span: wallSpan(project, member),\r\n1450:         ...selectedRows(new Set([member.id]), selectedGroup, rebars, lines),\r\n1451:       },\r\n1452:     }\r\n1453:   }\r\n1454: \r\n1455:   if (section.kind !== '鸚㎪쥈') {\r\n1456:     throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${member.id}`)\r\n1457:   }\r\n1458: \r\n1459:   const run = girderRun(project, member)\r\n1460:   const owner = run.members.find(({ id }) => id === run.ownerId)\r\n1461:   if (owner === undefined) {\r\n1462:     throw new Error(`GirderRun owner not found: ${run.ownerId}`)\r\n1463:   }\r\n1464: \r\n1465:   return {\r\n1466:     status: 'supported',\r\n1467:     view: {\r\n1468:       kind: '鸚㎪쥈',\r\n1469:       member: owner,\r\n1470:       section,\r\n","exit_code":0,"status":"completed"}}
