릪?섇숱?졼?\\r\\n 463: */\\r\\n 464:function resolveSplice(input: SlabSpliceInput): SlabSplice {\\r\\n 465:  const { run, section, size, measuredLengthMm, lapRule, lapLengthMm, pack } =\\r\\n 466:    input\\r\\n 467:\\r\\n 468:  let countRule: RuleHit\\r\\n 469:  let countPerBar: number\\r\\n 470:  let basis: string\\r\\n 471:\\r\\n 472:  if (run.members.length === 1) {\\r\\n 473:    countRule = lookupRule(pack, 'measure.splice.interval', { size })\\r\\n 474:    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\\r\\n 475:    basis =\\r\\n 476:      `?섊떖佯딀씮 ?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏` +\\r\\n 477:      `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴4) ??2竊덌폇竊됧틞??) ?잆걽?쀦쎑?랃펹`\\r\\n 478:  } else {\\r\\n 479:    countRule = bandedSpliceRule(run.coreLengthMm, continuousSlabBands(pack))\\r\\n 480:    countPerBar = spliceCount(countRule)\\r\\n 481:    basis = `?ｇ텥佯딀씮 佯딀씮??빓??${run.coreLengthMm}竊덃빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞??)竊?\\r\\n 482:  }\\r\\n 483:\\r\\n 484:  const factorRule = lookupRule(pack, 'measure.splice.length.factor', {\\r\\n 485:    method: section.spliceMethod,\\r\\n 486:  })\\r\\n 487:  const lengthMm = spliceLengthMm(countPerBar, lapLengthMm, factorRule)\\r\\n 488:  const rules = [countRule, factorRule]\\r\\n 489:  if (lengthMm > 0) rules.push(lapRule)\\r\\n 490:\\r\\n 491:  return { countPerBar, lengthMm, rules, basis }\\r\\n 492:}\\r\\n 493:\\r\\n 494:/**\\r\\n 495: * ?졾램壤®듁?귚툓塋?춮?뚦ㄷ歟곥겗訝?겎訝뗣겦?섅굦?꿔걣?????욍겗訝?걢?됪쥈??릎?멱맼?▲굥??겎??\\r\\n 496: * ?섅굦?잌뀍??z ??씮??툔塋?펷0竊됥굠?듾툔?ャ겒?뗣걪?ⓦ걣?귙굥?귙걹?뚣걣若잓슋??㎰?㎯걗?뗣?\\r\\n 497: * 訝뗧ク嶺뗣겘?섅굦?ゃ걚竊덅〃5.3.5 Lb ??툓塋?춮??닓?곮〃5.3.4 L3h ??궧?⒲깣轝꾠겘?뚢??랃펹??\\r\\n 498: */\\r\\n 499:function slabPoints(\\r\\n 500:  axis: 'X' | 'Y',\\r\\n 501:  coreLengthMm: number,\\r\\n 502:  barZ: number,\\r\\n 503:  start: SlabEndDetail,\\r\\n 504:  end: SlabEndDetail,\\r\\n 505:): Rebar['points'] {\\r\\n 506:  const at = (along: number, z: number): [number, number, number] =>\\r\\n 507:    axis === 'X' ? [along, 0, z] : [0, along, z]\\r\\n 508:  const points: Rebar['points'] = []\\r\\n 509:\\r\\n 510:  if (start.kind === '?당퇉若싩?') {\\r\\n 511:    points.push(at(-start.lengthMm, barZ))\\r\\n 512:  } else {\\r\\n 513:    const tailMm = start.lengthMm - start.projectionMm\\r\\n 514:    points.push(\\r\\n 515:      at(-start.projectionMm, barZ - tailMm),\\r\\n 516:      at(-start.projectionMm, barZ),\\r\\n 517:    )\\r\\n 518:  }\\r\\n 519:\\r\\n 520:  if (end.kind === '?당퇉若싩?') {\\r\\n 521:    points.push(at(coreLengthMm + end.lengthMm, barZ))\\r\\n 522:  } else {\\r\\n 523:    const tailMm = end.lengthMm - end.projectionMm\\r\\n 524:    points.push(\\r\\n 525:      at(coreLengthMm + end.projectionMm, barZ),\\r\\n 526:      at(coreLengthMm + end.projectionMm, barZ - tailMm),\\r\\n 527:    )\\r\\n 528:  }\\r\\n 529:\\r\\n 530:  return points\\r\\n 531:}\\r\\n--- slab-ends ---\\r\\n   1:import type { BarSize, SteelGrade } from '../model/member'\\r\\n   2:import { MemberUnsupportedError } from '../model/unsupported'\\r\\n   3:import { lookupRule } from '../rules/lookup'\\r\\n   4:import type { RuleHit, RulePack } from '../rules/types'\\r\\n   5:\\r\\n   6:/**\\r\\n   7: * 佯딀씮訝사춮?뚦ㄷ歟곥겗訝?겎?⒲걝若싩??쇻굥??(ADR-028)??\\r\\n   8: *\\r\\n   9: * 鸚㎪쥈??`resolveGirderEnd` ?ⓨ릪?섇숱?졼걣?곩폊?뤷닓?뚪걬?녴?\\r\\n  10: *   訝뗧ク嶺???烏?.3.4 ??**L3竊덀궧?⒲깣轝꾬펹**??0d ?뗣겇150mm餓δ툓??力?)\\r\\n  11: *   訝딁ク嶺???烏?.3.4 ????у?**L1**(力?)?귛뀯?됥겒?묆굦??5.3.4(5)(節? ??뒛?꿔걩若싩??㎯?\\r\\n  12: *            ?뺝쉽??〃5.3.5 ??**Lb**?뚦컦歟곩룋?녈궧?⒲깣??툓塋?춮??쥈?끾뒛?꿔걩若싩???力?)\\r\\n  13: *\\r\\n  14: * 歟곦말嶺뗣겏?뺛걚?곫뒘壤긱겓?뚧윶?쎼걚??/4 ?띴빳訝듽띲겗訝뗩솏??럾?뗣굢?ゃ걚 ??5.3.4(5)(節?(c)\\r\\n  15: * ??걹??퐜?멥겘?뚧쥈訝사춮??윶?끻츣??ャ걡?꾠겍??띲겏野얕괌?믧솏?ｃ겍?꾠굥??\\r\\n  16: *\\r\\n  17: * 訝뗧ク嶺뗣겓??뒛?꿔걩??껁걩?볝걣?ゃ걚?귟〃5.3.5 ??Lb ??툓塋?춮??닓?㎯걗?듽곮〃5.3.4 ??\\r\\n  18: * L3h ??궧?⒲깣轝꾠걣?잍뻼?㎯뚢??띲걽?귝뵱?밤겓?γ굢?ゃ걨?뚣겙?꿔걩?밤굮獒썲뱚?뚥퐳?됥걳?썬겏?쇻?\\r\\n  19: */\\r\\n  20:interface UsedRules {\\r\\n  21:  usedRules: RuleHit[]\\r\\n  22:}\\r\\n  23:\\r\\n  24:export type SlabEndDetail =\\r\\n  25:  | ({\\r\\n  26:      kind: '?당퇉若싩?'\\r\\n  27:      /**\\r\\n