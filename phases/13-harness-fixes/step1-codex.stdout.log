ance zones for $ends.bottom/$ends.top ends',\\\\\\\\\\\\\\\\n    ({ ends, bottomKind, bottomLength, topAnchored }) => {\\\\\\\\\\\\\\\\n      const main = byRole(\\\\\\\\\\\\\\\\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\\\\\\\\\\\\\\\\n        '訝사춮',\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      const expected: RebarZone[] = [\\\\\\\\\\\\\\\\n        {\\\\\\\\\\\\\\\\n          kind: bottomKind,\\\\\\\\\\\\\\\\n          pathFromMm: 0,\\\\\\\\\\\\\\\\n          pathToMm: bottomLength,\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\n      ]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      if (topAnchored) {\\\\\\\\\\\\\\\\n        expected.push({\\\\\\\\\\\\\\\\n          kind: '若싩?',\\\\\\\\\\\\\\\\n          pathFromMm: main.length - anchorage,\\\\\\\\\\\\\\\\n          pathToMm: main.length,\\\\\\\\\\\\\\\\n        })\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(main.zones).toEqual(expected)\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('keeps every zone within the 訝사춮 ?졾램??path', () => {\\\\\\\\\\\\\\\\n    const endCombinations: ColumnEnds[] = [\\\\\\\\\\\\\\\\n      { bottom: '若싩?', top: '若싩?' },\\\\\\\\\\\\\\\\n      { bottom: '若싩?', top: '?ゃ걮' },\\\\\\\\\\\\\\\\n      { bottom: '泳숁뎸', top: '若싩?' },\\\\\\\\\\\\\\\\n      { bottom: '泳숁뎸', top: '?ゃ걮' },\\\\\\\\\\\\\\\\n    ]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    for (const ends of endCombinations) {\\\\\\\\\\\\\\\\n      const main = byRole(\\\\\\\\\\\\\\\\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\\\\\\\\\\\\\\\\n        '訝사춮',\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(main.zones).toBeDefined()\\\\\\\\\\\\\\\\n      for (const zone of main.zones ?? []) {\\\\\\\\\\\\\\\\n        expect(zone.pathFromMm).toBeGreaterThanOrEqual(0)\\\\\\\\\\\\\\\\n        expect(zone.pathFromMm).toBeLessThan(zone.pathToMm)\\\\\\\\\\\\\\\\n        expect(zone.pathToMm).toBeLessThanOrEqual(main.length)\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('does not emit a zone for an end whose condition is ?ゃ걮', () => {\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '若싩?', top: '?ゃ걮' } }),\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\n      '訝사춮',\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(main.zones).toEqual([\\\\\\\\\\\\\\\\n      { kind: '若싩?', pathFromMm: 0, pathToMm: anchorage },\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('cites ?띲겖泳숁뎸 only on the rows that actually carry a joint', () => {\\\\\\\\\\\\\\\\n    const withoutLap = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '若싩?', top: '若싩?' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '訝사춮',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const withLap = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '泳숁뎸', top: '若싩?' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '訝사춮',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(withoutLap.rules).not.toContain('lap.L1')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(withoutLap.formula).not.toContain('?띲겖泳숁뎸')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(withLap.rules).toContain('lap.L1')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('cites 若싩? only on the rows that actually reach a stack end', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const in