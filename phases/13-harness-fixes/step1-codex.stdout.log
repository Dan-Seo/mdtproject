() =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input({ section: tiny }), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toThrow(/positive/)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('fails fast when the 訝딃깿鸚㎪쥈 depth consumes the whole storey height', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(() =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ beamDepthAbove: story.height }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toThrow(/positive/)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('uses the supplied beamDepthAbove instead of a global constant', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const baseHoop = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input(), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '躍?춮',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const changedHoop = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input({ beamDepthAbove: 800 }), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '躍?춮',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(changedHoop.count).not.toBe(baseHoop.count)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(changedHoop.count).toBe(baseHoop.count - 1)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('keeps mm geometry and reproducible calculations on each row', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(generated, '訝사춮')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hoop = byRole(generated, '躍?춮')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const anchorage = lookupRule(jpMlitRulePack, 'anchorage.L1', {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fc: section.fc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grade: section.grade,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hook: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const lap = lookupRule(jpMlitRulePack, 'lap.L1', {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fc: section.fc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grade: section.grade,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hook: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hook135 = lookupRule(jpMlitRulePack, 'bend.hook135', {})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const mainDiameter = Number(section.main.size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hoopDiameter = Number(section.hoop.size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const expectedHoopLength =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      2 *\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        (section.b - 2 * fabricationCover +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          (section.d - 2 * fabricationCover)) +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      2 * hook135.value * hoopDiameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.points).toHaveLength(4)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[0][0]).toBe(fabricationCover)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[0][2]).toBe(fabricationCover)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.points[0]).toEqual([fabricationCover, 0, fabricationCover])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.length).toBe(expectedHoopLength)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `若싩??룔걬 L1 ${anchorage.value}d(${anchorage.value * mainDiameter})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `?띲겖泳숁뎸?룔걬 L1 ${lap.value}d(${lap.value * mainDiameter})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const fabricationCoverFormula =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `?졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${minimumCover} 竊?` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `?좂츞 ${fabricationAddition} 竊?${fabricationCover}竊?\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).toContain(fabricationCoverFormula)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(fabricationCoverFormula)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).not.toContain('?뉏툓??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).not.toContain('?뉏툓??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `2횞{(${section.b}??횞${fabricationCover})竊?,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `135째?뺛긿??퐰??${hook135.value}d(${hook135.value * hoopDiameter})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '???롩쳵 4200 ??訝딃깿鸚㎪쥈?쎼걚 750) 첨 躍?춮?붵긿??100??竊?1 竊?36',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  ColumnSection,\\\\\\\\\\\\\\\\n  ColumnPosition,\\\\\\\\\\\\\\\\n  GirderPosition,\\\\\\\\\\\\\\\\n  Member,\\\\\\\\\\\\\\\\n  Section,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from './member'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// v2 (2026-08-12): Section???꾩닔 ?꾨뱶 exposure쨌finish 異붽? ??v1 JSON?\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// deserializeProject??踰꾩쟾 寃뚯씠?몄뿉??紐낆떆?곸쑝濡?嫄곕??쒕떎 (?곸냽 v1 ?곗씠???놁쓬).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport const PROJECT_SCHEMA_VERSION = 2\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Grid {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  xSpans: number[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ySpans: number[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Story {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  height: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  schemaVersion: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grid: Grid\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  stories: Story[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  sections: Section[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  members: Member[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  /** ?댁뿭???숃? QuantityLine.id瑜??ㅻ줈 ?대떎. 媛믪씠 ?녿뒗 ?됱? ???먯껜媛 ?녿떎. */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  notes?: Record<string, string>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function gridPointCount(grid: Grid): { nx: number; ny: number } {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    nx: grid.xSpans.length + 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ny: grid.ySpans.length + 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function gridPoint(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grid: Grid,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ix: number,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  iy: number,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): { x: number; y: number } {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { nx, ny } = gridPointCount(grid)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    !Number.isInteger(ix) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    !Number.isInteger(iy) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ix < 0 ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ix >= nx ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    iy < 0 ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    iy >= ny\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/** 痢?諛붾떏???꾩쟻 ?쒓퀬(mm). stories 諛곗뿴 ?쒖꽌?濡??꾨옒痢?height瑜??꾩쟻?쒕떎. */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function storyElevation(stories: Story[], storyId: string): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const index = stories.findIndex(({ id }) => id === storyId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (index < 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Story not found: ${storyId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function findSection(project: Project, sectionId: string): Section {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const section = project.sections.find(({ id }) => id === sectionId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!section) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Section not found: ${sectionId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return section\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function memberGroupKey(project: Project, member: Member): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!story) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Story not found: ${member.storyId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const section = findSection(project, member.sectionId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (section.kind !== member.kind) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const memberCode = member.kind === '?? ? 'C' : 'G'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return `${story.name}|${memberCode}|${section.mark}`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction isColumnPosition(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: ColumnPosition | GirderPosition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): position is ColumnPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return !('axis' in position)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction isGirderPosition(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: ColumnPosition | GirderPosition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): position is GirderPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return 'axis' in position\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction touchesColumn(\\\\\\\\\\\\\\\\n  girder: GirderPosition,\\\\\\\\\\\\\\\\n  column: ColumnPosition,\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (girder.axis === 'X') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      girder.iy === column.iy &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (girder.ix === column.ix || girder.ix + 1 === column.ix)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    girder.ix === column.ix &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (girder.iy === column.iy || girder.iy + 1 === column.iy)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface GirderSpan {\\\\\\\\\\\\\\\\n  axis: 'X' | 'Y'\\\\\\\\\\\\\\\\n  /** 洹몃━??援먯젏 媛?以묒떖 ?ㅽ뙩 (mm) */\\\\\\\\\\\\\\\\n  centerSpan: number\\\\\\\\\\\\\\\\n  /** ?끾퀡?룔걬 (mm) ???묐떒 ?깁씊 ?ъ씠 */\\\\\\\\\\\\\\\\n  clear: number\\\\\\\\\\\\\\\\n  /** ?쒖옉 ??以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\\\\\\\\\\\\\\\\n  startFaceOffsetMm: number\\\\\\\\\\\\\\\\n  /** ????以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\\\\\\\\\\\\\\\\n  endFaceOffsetMm: number\\\\\\\\\\\\\\\\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ???쒖옉 ?깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\\\\\\\\\\\\\\\\n  startSupportLengthAlongAxisMm: number\\\\\\\\\\\\\\\\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ?????깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\\\\\\\\\\\\\\\\n  endSupportLengthAlongAxisMm: number\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction supportColumnSection(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  girder: Member,\\\\\\\\\\\\\\\\n  ix: number,\\\\\\\\\\\\\\\\n  iy: number,\\\\\\\\\\\\\\\\n  end: 'start' | 'end',\\\\\\\\\\\\\\\\n): ColumnSection {\\\\\\\\\\\\\\\\n  const support = project.members.find(\\\\\\\\\\\\\\\\n    (candidate) =>\\\\\\\\\\\\\\\\n      candidate.kind === '?? &&\\\\\\\\\\\\\\\\n      candidate.storyId === girder.storyId &&\\\\\\\\\\\\\\\\n      isColumnPosition(candidate.position) &&\\\\\\\\\\\\\\\\n      candidate.position.ix === ix &&\\\\\\\\\\\\\\\\n      candidate.position.iy === iy,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (!support) {\\\\\\\\\\\\\\\\n    throw new Error(`Missing ${end} support ??for 鸚㎪쥈: ${girder.id}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const section = findSection(project, support.sectionId)\\\\\\\\\\\\\\\\n  if (section.kind !== '??) {\\\\\\\\\\\\\\\\n    throw new Error(`??member references a non-??section: ${support.id}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return section\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function girderSpan(project: Project, member: Member): GirderSpan {\\\\\\\\\\\\\\\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\\\\\\\\\\\\\\\n    throw new Error(`girderSpan requires a 鸚㎪쥈: ${member.id}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const { axis, ix, iy } = member.position\\\\\\\\\\\\\\\\n  const endIx = axis === 'X' ? ix + 1 : ix\\\\\\\\\\\\\\\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\\\\\\\\\\\\\\\n  const startPoint = gridPoint(project.grid, ix, iy)\\\\\\\\\\\\\\\\n  const endPoint = gridPoint(project.grid, endIx, endIy)\\\\\\\\\\\\\\\\n  const startSection = supportColumnSection(project, member, ix, iy, 'start')\\\\\\\\\\\\\\\\n  const endSection = supportColumnSection(\\\\\\\\\\\\\\\\n    project,\\\\\\\\\\\\\\\\n    member,\\\\\\\\\\\\\\\\n    endIx,\\\\\\\\\\\\\\\\n    endIy,\\\\\\\\\\\\\\\\n    'end',\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const centerSpan =\\\\\\\\\\\\\\\\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\\\\\\\\\\\\\\\\n  const startSupportLengthAlongAxisMm =\\\\\\\\\\\\\\\\n    axis === 'X' ? startSection.b : startSection.d\\\\\\\\\\\\\\\\n  const endSupportLengthAlongAxisMm =\\\\\\\\\\\\\\\\n    axis === 'X' ? endSection.b : endSection.d\\\\\\\\\\\\\\\\n  const startFaceOffsetMm = startSupportLengthAlongAxisMm / 2\\\\\\\\\\\\\\\\n  const endFaceOffsetMm = endSupportLengthAlongAxisMm / 2\\\\\\\\\\\\\\\\n  const clear = centerSpan - startFaceOffsetMm - endFaceOffsetMm\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (clear <= 0) {\\\\\\\\\\\\\\\\n    throw new Error(`鸚㎪쥈 ?끾퀡?룔걬 must be positive: ${member.id} (${clear} mm)`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    axis,\\\\\\\\\\\\\\\\n    centerSpan,\\\\\\\\\\\\\\\\n    clear,\\\\\\\\\\\\\\\\n    startFaceOffsetMm,\\\\\\\\\\\\\\\\n    endFaceOffsetMm,\\\\\\\\\\\\\\\\n    startSupportLengthAlongAxisMm,\\\\\\\\\\\\\\\\n    endSupportLengthAlongAxisMm,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/**\\\\\\\\\\\\\\\\n * ?긴말嶺뗣겗塋?깿?▽뻑 (R7)?? *\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 痢듦컙 ?묓빀遺?먮뒗 ?댁쓬??**??踰덈쭔** ?덉뼱???쒕떎. ?덉쟾?먮뒗 紐⑤뱺 痢듭씠\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * ?뚪쉸遙?竊?若싩? 竊?泳숁뎸?띾? 諛쏆븘 ?묓빀遺媛 ?꾨옒痢듭쓽 泳숁뎸? ?꾩링??若싩??쇰줈\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * ??踰?怨꾩긽?먮떎. ?묓빀遺??泳숁뎸??**?꾩링 遺?ш? 遺??*?섍퀬, 若싩?? ?ㅽ깮??\\\\\\\\\\\\\\\\n * ????湲곗큹쨌理쒖긽???먮쭔 遺숇뒗??\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n *\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * ?ㅽ깮 ?쒖꽌??`stories` 諛곗뿴 ?쒖꽌瑜?洹몃?濡??좊ː?쒕떎 ??Story???덈꺼 媛믪씠 ?녿떎.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 議곕Ц???꾨땲??愿?됱뿉 ?곕Ⅸ 諛곕텇?대?濡???洹쒖튃 ?먯껜??寃利앸릺吏 ?딆? ?꾩젣??\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnEnds {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  bottom: '若싩?' | '泳숁뎸'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  top: '若싩?' | '?ゃ걮'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function columnEnds(project: Project, member: Member): ColumnEnds {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { position } = member\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (member.kind !== '?? || !isColumnPosition(position)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`columnEnds requires a ?? ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const level = project.stories.findIndex(({ id }) => id === member.storyId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (level < 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Story not found: ${member.storyId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasColumnAtLevel = (candidateLevel: number): boolean => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const story = project.stories[candidateLevel]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (story === undefined) return false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return project.members.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (candidate) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.kind === '?? &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.storyId === story.id &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        isColumnPosition(candidate.position) &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.position.ix === position.ix &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.position.iy === position.iy,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    bottom: hasColumnAtLevel(level - 1) ? '泳숁뎸' : '若싩?',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    top: hasColumnAtLevel(level + 1) ? '?ゃ걮' : '若싩?',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function beamDepthAbove(project: Project, member: Member): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (member.kind !== '?? || !isColumnPosition(member.position)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`beamDepthAbove requires a ?? ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const depths = project.members\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .filter(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (candidate) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.kind === '鸚㎪쥈' &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.storyId === member.storyId &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        isGirderPosition(candidate.position) &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        touchesColumn(candidate.position, member.position),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .map((girder) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const section = findSection(project, girder.sectionId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (section.kind !== '鸚㎪쥈') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      return section.depth\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (depths.length === 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`No touching 鸚㎪쥈 found above ?? ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return Math.max(...depths)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function setNote(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lineId: string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  note: string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const notes = { ...project.notes }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (note === '') delete notes[lineId]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  else notes[lineId] = note\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return { ...project, notes }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function serializeProject(project: Project): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return JSON.stringify(project)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function deserializeProject(json: string): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const parsed: unknown = JSON.parse(json)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    typeof parsed !== 'object' ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    parsed === null ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    !('schemaVersion' in parsed) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    parsed.schemaVersion !== PROJECT_SCHEMA_VERSION\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `Unsupported Project schemaVersion; expected ${PROJECT_SCHEMA_VERSION}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return parsed as Project\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { BarSize, SteelGrade } from '../model/member'\\\\\\\\\\\\\\\\nimport { lookupRule } from '../rules/lookup'\\\\\\\\\\\\\\\\nimport type { RuleHit, RulePack } from '../rules/types'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type GirderEndDetail =\\\\\\\\\\\\\\\\n  | { kind: '?당퇉若싩?'; lengthRule: 'anchorage.L1'; lengthMm: number }\\\\\\\\\\\\\\\\n  | {\\\\\\\\\\\\\\\\n      kind: '?섉쎊?믣츣?'\\\\\\\\\\\\\\\\n      lengthRule: 'anchorage.L1h'\\\\\\\\\\\\\\\\n      projectionRule: 'anchorage.La'\\\\\\\\\\\\\\\\n      lengthMm: number\\\\\\\\\\\\\\\\n      projectionMm: number\\\\\\\\\\\\\\\\n      direction: '訝? | '訝?\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface GirderEndInput {\\\\\\\\\\\\\\\\n  /** 吏???깆쓽 異뺣갑???꾩껜 移섏닔 (GirderSpan??*SupportLengthAlongAxisMm) */\\\\\\\\\\\\\\\\n  supportLengthMm: number\\\\\\\\\\\\\\\\n  barSize: BarSize\\\\\\\\\\\\\\\\n  fc: number\\\\\\\\\\\\\\\\n  grade: SteelGrade\\\\\\\\\\\\\\\\n  /** 訝딁ク嶺뗭씠硫?'訝?(?꾨옒濡??덇끝), 訝뗧ク嶺뗭씠硫?'訝? */\\\\\\\\\\\\\\\\n  bendDirection: '訝? | '訝?\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction barDiameter(size: BarSize): number {\\\\\\\\\\\\\\\\n  const diameter = Number(size.replace(/^D/, ''))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\\\\\\\\\\\\\\\n    throw new Error(`Invalid BarSize: ${size}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return diameter\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\\\\\\\\\\\\\\\n  if (rule.unit === 'mm') return rule.value\\\\\\\\\\\\\\\\n  if (rule.unit === 'd' && diameter !== undefined) {\\\\\\\\\\\\\\\\n    return rule.value * diameter\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  throw new Error(\\\\\\\\\\\\\\\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction ratio(rule: RuleHit): number {\\\\\\\\\\\\\\\\n  if (rule.unit !== 'ratio') {\\\\\\\\\\\\\\\\n    throw new Error(`Rule ${rule.key} must use ratio`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return rule.value\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/**\\\\\\\\\\\\\\\\n * GirderEndInput?먮뒗 ?깆쓽 exposure/finish媛 ?놁쑝誘濡?烏?.3.6??鍮꾪넗???? * ?꾨낫 以?媛?????뗣겤?딅? ?대떎. ?묒? 媛믪쓣 ?꾩쓽 湲곕낯媛믪쑝濡??앺빐 泥좉렐??諛섎?硫? * ?뗣겤?딅? ?ル뒗 寃껊낫??蹂댁닔?곸쑝濡??ㅽ뙣?쒗궎湲??꾪븳 ?먯젙?대떎.\\\\\\\\\\\\\\\\n */\\\\\\\\\\\\\\\\nfunction columnMinimumCover(pack: RulePack): RuleHit {\\\\\\\\\\\\\\\\n  const candidates = pack.entries.filter(\\\\\\\\\\\\\\\\n    ({ key, conditions }) =>\\\\\\\\\\\\\\\\n      key === 'cover.minimum' &&\\\\\\\\\\\\\\\\n      conditions.memberKind === '?? &&\\\\\\\\\\\\\\\\n      conditions.soilContact !== true,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (candidates.length === 0) {\\\\\\\\\\\\\\\\n    throw new Error('Rule not found: cover.minimum for non-soil ??)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const conservative = candidates.reduce((largest, candidate) =>\\\\\\\\\\\\\\\\n    candidate.value > largest.value ? candidate : largest,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return lookupRule(pack, conservative.key, conservative.conditions)\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function resolveGirderEnd(\\\\\\\\\\\\\\\\n  input: GirderEndInput,\\\\\\\\\\\\\\\\n  pack: RulePack,\\\\\\\\\\\\\\\\n): GirderEndDetail {\\\\\\\\\\\\\\\\n  const diameter = barDiameter(input.barSize)\\\\\\\\\\\\\\\\n  const straightRule = lookupRule(pack, 'anchorage.L1', {\\\\\\\\\\\\\\\\n    fc: input.fc,\\\\\\\\\\\\\\\\n    grade: input.grade,\\\\\\\\\\\\\\\\n    hook: false,\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n  const minimumCoverRule = columnMinimumCover(pack)\\\\\\\\\\\\\\\\n  const fabricationCoverAdditionRule = lookupRule(\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\n    'cover.fabrication.addition',\\\\\\\\\\\\\\\\n    {},\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const fabricationCoverMm =\\\\\\\\\\\\\\\\n    millimetres(minimumCoverRule) +\\\\\\\\\\\\\\\\n    millimetres(fabricationCoverAdditionRule)\\\\\\\\\\\\\\\\n  const availableProjectionMm = input.supportLengthMm - fabricationCoverMm\\\\\\\\\\\\\\\\n  const straightLengthMm = millimetres(straightRule, diameter)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (straightLengthMm <= availableProjectionMm) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      kind: '?당퇉若싩?',\\\\\\\\\\\\\\\\n      lengthRule: 'anchorage.L1',\\\\\\\\\\\\\\\\n      lengthMm: straightLengthMm,\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const bentRule = lookupRule(pack, 'anchorage.L1h', {\\\\\\\\\\\\\\\\n    fc: input.fc,\\\\\\\\\\\\\\\\n    grade: input.grade,\\\\\\\\\\\\\\\\n    hook: true,\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n  const projectionRule = lookupRule(pack, 'anchorage.La', {\\\\\\\\\\\\\\\\n    fc: input.fc,\\\\\\\\\\\\\\\\n    grade: input.grade,\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n  const tailMinimumRule = lookupRule(\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\n    'anchorage.bent.tail.minimum',\\\\\\\\\\\\\\\\n    {},\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const projectionMinimumRule = lookupRule(\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\n    'anchorage.bent.projection.minimum',\\\\\\\\\\\\\\\\n    { detail: '歟곦말嶺뗣겗?긷냵若싩?' },\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const projectionMm = Math.max(\\\\\\\\\\\\\\\\n    millimetres(projectionRule, diameter),\\\\\\\\\\\\\\\\n    input.supportLengthMm * ratio(projectionMinimumRule),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (projectionMm > availableProjectionMm) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\n      `?섉쎊?믣츣??뚧뵱?방윶?ュ룑?얇굢?ゃ걚: ` +\\\\\\\\\\\\\\\\n        `恙낁쫨?뺝쉽 ${projectionMm} mm > 鵝욜뵪??꺗 ${availableProjectionMm} mm`,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const lengthMm = Math.max(\\\\\\\\\\\\\\\\n    millimetres(bentRule, diameter),\\\\\\\\\\\\\\\\n    projectionMm + millimetres(tailMinimumRule, diameter),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    kind: '?섉쎊?믣츣?',\\\\\\\\\\\\\\\\n    lengthRule: 'anchorage.L1h',\\\\\\\\\\\\\\\\n    projectionRule: 'anchorage.La',\\\\\\\\\\\\\\\\n    lengthMm,\\\\\\\\\\\\\\\\n    projectionMm,\\\\\\\\\\\\\\\\n    direction: input.bendDirection,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface StirrupLayout {\\\\\\\\\\\\\\\\n  /** ?끾퀡 醫뚰몴怨?醫뚯륫 ?깁씊 = 0)???꾩튂 諛곗뿴 (mm) */\\\\\\\\\\\\\\\\n  positionsMm: number[]\\\\\\\\\\\\\\\\n  /** 留덉?留??붿뿬 媛꾧꺽 (mm) ??踰붾? ?쒖떆??*/\\\\\\\\\\\\\\\\n  lastGapMm: number\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function stirrupPositions(\\\\\\\\\\\\\\\\n  clearMm: number,\\\\\\\\\\\\\\\\n  pitchMm: number,\\\\\\\\\\\\\\\\n  startOffsetMm: number,\\\\\\\\\\\\\\\\n): StirrupLayout {\\\\\\\\\\\\\\\\n  if (!Number.isFinite(clearMm)) {\\\\\\\\\\\\\\\\n    throw new Error(`clearMm must be finite: ${clearMm}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  if (!Number.isFinite(pitchMm) || pitchMm <= 0) {\\\\\\\\\\\\\\\\n    throw new Error(`pitchMm must be positive and finite: ${pitchMm}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  if (!Number.isFinite(startOffsetMm) || startOffsetMm < 0) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\n      `startOffsetMm must be non-negative and finite: ${startOffsetMm}`,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  if (clearMm <= 2 * startOffsetMm) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\n      `clearMm must exceed twice startOffsetMm: ${clearMm} <= ` +\\\\\\\\\\\\\\\\n        `${2 * startOffsetMm}`,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const intervalStartMm = startOffsetMm\\\\\\\\\\\\\\\\n  const intervalEndMm = clearMm - startOffsetMm\\\\\\\\\\\\\\\\n  const positionsMm = [intervalStartMm]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  for (let index = 1; ; index += 1) {\\\\\\\\\\\\\\\\n    const positionMm = intervalStartMm + index * pitchMm\\\\\\\\\\\\\\\\n    if (positionMm >= intervalEndMm) break\\\\\\\\\\\\\\\\n    positionsMm.push(positionMm)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  positionsMm.push(intervalEndMm)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  for (let index = 0; index < positionsMm.length; index += 1) {\\\\\\\\\\\\\\\\n    const positionMm = positionsMm[index]\\\\\\\\\\\\\\\\n    if (positionMm < intervalStartMm || positionMm > intervalEndMm) {\\\\\\\\\\\\\\\\n      throw new Error(`?귙겙?됬춮 position outside placement interval: ${positionMm}`)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    if (index > 0) {\\\\\\\\\\\\\\\\n      const gapMm = positionMm - positionsMm[index - 1]\\\\\\\\\\\\\\\\n      if (gapMm <= 0 || gapMm > pitchMm) {\\\\\\\\\\\\\\\\n        throw new Error(`Invalid ?귙겙?됬춮 gap: ${gapMm}`)\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    positionsMm,\\\\\\\\\\\\\\\\n    lastGapMm:\\\\\\\\\\\\\\\\n      positionsMm[positionsMm.length - 1] -\\\\\\\\\\\\\\\\n      positionsMm[positionsMm.length - 2],\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { BarSize } from './member'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type RebarRole =\\\\\\\\\\\\\\\\n  | '訝사춮'\\\\\\\\\\\\\\\\n  | '躍?춮'\\\\\\\\\\\\\\\\n  | '訝딁ク嶺?\\\\\\\\\\\\\\\\n  | '訝뗧ク嶺?\\\\\\\\\\\\\\\\n  | '?귙겙?됬춮'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type RebarShape = 'straight' | 'hook90' | 'hoop'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface RebarZone {\\\\\\\\\\\\\\\\n  kind: '若싩?' | '?띲겖泳숁뎸'\\\\\\\\\\\\\\\\n  /** 泥좉렐 polyline ?쒖옉?먮??곗쓽 ?꾩쟻 寃쎈줈嫄곕━ (mm) */\\\\\\\\\\\\\\\\n  pathFromMm: number\\\\\\\\\\\\\\\\n  pathToMm: number\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface Rebar {\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\n  memberId: string\\\\\\\\\\\\\\\\n  role: RebarRole\\\\\\\\\\\\\\\\n  size: BarSize\\\\\\\\\\\\\\\\n  shape: RebarShape\\\\\\\\\\\\\\\\n  points: [number, number, number][]\\\\\\\\\\\\\\\\n  closed: boolean\\\\\\\\\\\\\\\\n  length: number\\\\\\\\\\\\\\\\n  count: number\\\\\\\\\\\\\\\\n  zones?: RebarZone[]\\\\\\\\\\\\\\\\n  rules: string[]\\\\\\\\\\\\\\\\n  formula: string\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type MemberKind = '?? | '鸚㎪쥈'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type MemberClass = '翁?퐪'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type BarSize =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D10'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D13'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D16'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D19'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D22'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D25'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D29'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D32'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnSection {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '??\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  d: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: SteelGrade\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: Exposure\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: Finish\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    count: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hoop: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pitch: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface GirderSection {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '鸚㎪쥈'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  depth: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: SteelGrade\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: Exposure\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: Finish\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    topCount: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    bottomCount: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  stirrup: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pitch: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type Section = ColumnSection | GirderSection\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ix: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  iy: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface GirderPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  axis: 'X' | 'Y'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ix: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  iy: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Member {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: MemberKind\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberClass: MemberClass\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  sectionId: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  storyId: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: ColumnPosition | GirderPosition\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_5\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"agent_message\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"현재 작업 트리에는 `phases/3-girder-domain/index.json`의 기존 미커밋 변경이 1건 있습니다. 먼저 diff를 확인해 이전 step의 상태 갱신인지 판별하고 보존하겠습니다. 초기 출력은 PowerShell 인코딩 때문에 깨져 보여 UTF-8로 필요한 파일을 다시 나눠 읽겠습니다.\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_6\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'git diff -- phases/3-girder-domain/index.json; Get-Content -Raw -Encoding utf8 src/domain/rebar/column.ts; Get-Content -Raw -Encoding utf8 src/domain/rebar/girder-ends.ts; Get-Content -Raw -Encoding utf8 src/domain/rebar/stirrup-layout.ts; Get-Content -Raw -Encoding utf8 src/domain/model/rebar.ts; Get-Content -Raw -Encoding utf8 src/domain/model/member.ts'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_6\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'git diff -- phases/3-girder-domain/index.json; Get-Content -Raw -Encoding utf8 src/domain/rebar/column.ts; Get-Content -Raw -Encoding utf8 src/domain/rebar/girder-ends.ts; Get-Content -Raw -Encoding utf8 src/domain/rebar/stirrup-layout.ts; Get-Content -Raw -Encoding utf8 src/domain/model/rebar.ts; Get-Content -Raw -Encoding utf8 src/domain/model/member.ts'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"diff --git a/phases/3-girder-domain/index.json b/phases/3-girder-domain/index.json\\\\\\\\\\\\\\\\nindex 1d1677e..41849b2 100644\\\\\\\\\\\\\\\\n--- a/phases/3-girder-domain/index.json\\\\\\\\\\\\\\\\n+++ b/phases/3-girder-domain/index.json\\\\\\\\\\\\\\\\n@@ -37,7 +37,8 @@\\\\\\\\\\\\\\\\n     {\\\\\\\\\\\\\\\\n       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 4,\\\\\\\\\\\\\\\\n       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"girder-generator\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n-      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n+      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n+      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"started_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-12T13:09:39+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n     },\\\\\\\\\\\\\\\\n     {\\\\\\\\\\\\\\\\n       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 5,\\\\\\\\\\\\\\\\nimport type { BarSize, ColumnSection, Member } from '../model/member'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { Rebar, RebarZone } from '../model/rebar'\\\\\\\\\\\\\\\\nimport type { ColumnEnds, Story } from '../model/project'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { coverConditions, lookupRule } from '../rules/lookup'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { RuleHit, RulePack } from '../rules/types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnRebarInput {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  member: Member\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  section: ColumnSection\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  story: Story\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  beamDepthAbove: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  /** 스택 안에서의 단부 조건. `columnEnds()`가 판정한다 (R7). */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ends: ColumnEnds\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction barDiameter(size: BarSize): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const diameter = Number(size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Invalid BarSize: ${size}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return diameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (rule.unit === 'mm') return rule.value\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (rule.unit === 'd' && diameter !== undefined) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return rule.value * diameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  input: ColumnRebarInput,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  pack: RulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): Rebar[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { member, section, story, beamDepthAbove, ends } = input\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const commonConditions = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    fc: section.fc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    grade: section.grade,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hook: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const coverRule = lookupRule(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    'cover.minimum',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    coverConditions(section),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const fabricationCoverAdditionRule = lookupRule(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 柱主筋の定着は表5.3.4の一般値 L1 (注1 — 注2〜4以外)。L2 は「割裂破壊の\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // おそれのない箇所」限定 (注2) で、その判定材料を製品は持たないため一般値を使う。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const anchorageRule = lookupRule(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    'anchorage.L1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    commonConditions,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const lapRule = lookupRule(pack, 'lap.L1', commonConditions)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hook135Rule = lookupRule(pack, 'bend.hook135', {})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const minimumCover = millimetres(coverRule)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const fabricationCoverAddition = millimetres(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    fabricationCoverAdditionRule,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const fabricationCover = minimumCover + fabricationCoverAddition\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const mainDiameter = barDiameter(section.main.size)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const anchorageLength = millimetres(anchorageRule, mainDiameter)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const lapLength = millimetres(lapRule, mainDiameter)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 端部条件ごとの伸び (R7)。接合部の継手は上階柱が持ち、定着はスタックの\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 両端にしか付かない。どちらでもない端は 0 — 相手側で既に数えている。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const bottomExtension =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ends.bottom === '継手' ? lapLength : anchorageLength\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const topExtension = ends.top === '定着' ? anchorageLength : 0\\\\\\\\\\\\\\\\n  const mainLength = story.height + bottomExtension + topExtension\\\\\\\\\\\\\\\\n  const mainZones: RebarZone[] = [\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\n      kind: ends.bottom === '継手' ? '重ね継手' : '定着',\\\\\\\\\\\\\\\\n      pathFromMm: 0,\\\\\\\\\\\\\\\\n      pathToMm: bottomExtension,\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  ]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (ends.top === '定着') {\\\\\\\\\\\\\\\\n    mainZones.push({\\\\\\\\\\\\\\\\n      kind: '定着',\\\\\\\\\\\\\\\\n      pathFromMm: mainLength - anchorageLength,\\\\\\\\\\\\\\\\n      pathToMm: mainLength,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const endTerms: string[] = []\\\\\\\\\\\\\\\\n  const mainRuleKeys: string[] = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    coverRule.key,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    fabricationCoverAdditionRule.key,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (ends.bottom === '継手') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    endTerms.push(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `下端 重ね継手長さ L1 ${lapRule.value}d(${lapLength})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    mainRuleKeys.push(lapRule.key)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  } else {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    endTerms.push(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `下端 定着長さ L1 ${anchorageRule.value}d(${anchorageLength})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    mainRuleKeys.push(anchorageRule.key)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (ends.top === '定着') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    endTerms.push(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `上端 定着長さ L1 ${anchorageRule.value}d(${anchorageLength})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (!mainRuleKeys.includes(anchorageRule.key)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      mainRuleKeys.push(anchorageRule.key)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  } else {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    endTerms.push('上端 上階柱が継手を負担 0')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoopDiameter = barDiameter(section.hoop.size)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hook135Length = millimetres(hook135Rule, hoopDiameter)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoopWidth = section.b - 2 * fabricationCover\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoopDepth = section.d - 2 * fabricationCover\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 加工用かぶり×2 보다 작은 단면은 음수 加工長을 만들고, 그 값은 집계에서\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 마이너스 kg로 조용히 흘러간다 — 조용히 틀린 값 대신 실패한다 (ADR-014).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hoopWidth <= 0 || hoopDepth <= 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `帯筋 加工寸法 must be positive: ${member.id} ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        `(${section.b}×${section.d} − 2×加工用かぶり ${fabricationCover})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoopLength =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    2 * (hoopWidth + hoopDepth) + 2 * hook135Length\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 上部大梁せい가 階高 이상이면 배치 구간이 사라져 本数가 0 이하로 샌다 —\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 加工寸法 가드와 같은 이유로 실패한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoopSpan = story.height - beamDepthAbove\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hoopSpan <= 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `帯筋 配置区間 must be positive: ${member.id} ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        `(階高 ${story.height} − 上部大梁せい ${beamDepthAbove})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoopCount = Math.ceil(hoopSpan / section.hoop.pitch) + 1\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const fabricationCoverFormula =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    `加工用かぶり厚さ（最小かぶり ${minimumCover} ＋ ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    `加算 ${fabricationCoverAddition} ＝ ${fabricationCover}）`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const main: Rebar = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    id: `${member.id}|main`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    memberId: member.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    role: '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: section.main.size,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    shape: 'straight',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    points: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      [fabricationCover, -bottomExtension, fabricationCover],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        fabricationCover,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        story.height + topExtension,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        fabricationCover,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    closed: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    length: mainLength,\\\\\\\\\\\\\\\\n    count: section.main.count,\\\\\\\\\\\\\\\\n    zones: mainZones,\\\\\\\\\\\\\\\\n    rules: mainRuleKeys,\\\\\\\\\\\\\\\\n    formula:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `加工長 ＝ 階高 ${story.height} ＋ ${endTerms.join(' ＋ ')} ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `＝ ${mainLength} ／ ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `配置基準 ＝ ${fabricationCoverFormula} ／ ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `本数 ＝ 断面一覧の主筋本数 ${section.main.count}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hoop: Rebar = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    id: `${member.id}|hoop`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    memberId: member.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    role: '帯筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: section.hoop.size,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    shape: 'hoop',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    points: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      [fabricationCover, 0, fabricationCover],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      [section.b - fabricationCover, 0, fabricationCover],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        section.b - fabricationCover,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        section.d - fabricationCover,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      [fabricationCover, 0, section.d - fabricationCover],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    closed: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    length: hoopLength,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    count: hoopCount,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rules: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      coverRule.key,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fabricationCoverAdditionRule.key,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hook135Rule.key,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    formula:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `加工長 ＝ 2×{(${section.b}−2×${fabricationCover})＋` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `(${section.d}−2×${fabricationCover})} ＋ 2×135°フック余長 ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `${hook135Rule.value}d(${hook135Length}) ＝ ${hoopLength} ／ ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `${fabricationCoverFormula} ／ ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `本数 ＝ ⌈(階高 ${story.height} − 上部大梁せい ${beamDepthAbove}) ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `÷ 帯筋ピッチ ${section.hoop.pitch}⌉ ＋ 1 ＝ ${hoopCount}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [main, hoop]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { BarSize, SteelGrade } from '../model/member'\\\\\\\\\\\\\\\\nimport { lookupRule } from '../rules/lookup'\\\\\\\\\\\\\\\\nimport type { RuleHit, RulePack } from '../rules/types'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type GirderEndDetail =\\\\\\\\\\\\\\\\n  | { kind: '直線定着'; lengthRule: 'anchorage.L1'; lengthMm: number }\\\\\\\\\\\\\\\\n  | {\\\\\\\\\\\\\\\\n      kind: '折曲げ定着'\\\\\\\\\\\\\\\\n      lengthRule: 'anchorage.L1h'\\\\\\\\\\\\\\\\n      projectionRule: 'anchorage.La'\\\\\\\\\\\\\\\\n      lengthMm: number\\\\\\\\\\\\\\\\n      projectionMm: number\\\\\\\\\\\\\\\\n      direction: '上' | '下'\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface GirderEndInput {\\\\\\\\\\\\\\\\n  /** 지점 柱의 축방향 전체 치수 (GirderSpan의 *SupportLengthAlongAxisMm) */\\\\\\\\\\\\\\\\n  supportLengthMm: number\\\\\\\\\\\\\\\\n  barSize: BarSize\\\\\\\\\\\\\\\\n  fc: number\\\\\\\\\\\\\\\\n  grade: SteelGrade\\\\\\\\\\\\\\\\n  /** 上端筋이면 '下'(아래로 절곡), 下端筋이면 '上' */\\\\\\\\\\\\\\\\n  bendDirection: '上' | '下'\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction barDiameter(size: BarSize): number {\\\\\\\\\\\\\\\\n  const diameter = Number(size.replace(/^D/, ''))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\\\\\\\\\\\\\\\n    throw new Error(`Invalid BarSize: ${size}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return diameter\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\\\\\\\\\\\\\\\n  if (rule.unit === 'mm') return rule.value\\\\\\\\\\\\\\\\n  if (rule.unit === 'd' && diameter !== undefined) {\\\\\\\\\\\\\\\\n    return rule.value * diameter\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  throw new Error(\\\\\\\\\\\\\\\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction ratio(rule: RuleHit): number {\\\\\\\\\\\\\\\\n  if (rule.unit !== 'ratio') {\\\\\\\\\\\\\\\\n    throw new Error(`Rule ${rule.key} must use ratio`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return rule.value\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/**\\\\\\\\\\\\\\\\n * GirderEndInput에는 柱의 exposure/finish가 없으므로 表5.3.6의 비토접 柱\\\\\\\\\\\\\\\\n * 후보 중 가장 큰 かぶり를 쓴다. 작은 값을 임의 기본값으로 택해 철근이 반대면\\\\\\\\\\\\\\\\n * かぶり를 뚫는 것보다 보수적으로 실패시키기 위한 판정이다.\\\\\\\\\\\\\\\\n */\\\\\\\\\\\\\\\\nfunction columnMinimumCover(pack: RulePack): RuleHit {\\\\\\\\\\\\\\\\n  const candidates = pack.entries.filter(\\\\\\\\\\\\\\\\n    ({ key, conditions }) =>\\\\\\\\\\\\\\\\n      key === 'cover.minimum' &&\\\\\\\\\\\\\\\\n      conditions.memberKind === '柱' &&\\\\\\\\\\\\\\\\n      conditions.soilContact !== true,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (candidates.length === 0) {\\\\\\\\\\\\\\\\n    throw new Error('Rule not found: cover.minimum for non-soil 柱')\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const conservative = candidates.reduce((largest, candidate) =>\\\\\\\\\\\\\\\\n    candidate.value > largest.value ? candidate : largest,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return lookupRule(pack, conservative.key, conservative.conditions)\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function resolveGirderEnd(\\\\\\\\\\\\\\\\n  input: GirderEndInput,\\\\\\\\\\\\\\\\n  pack: RulePack,\\\\\\\\\\\\\\\\n): GirderEndDetail {\\\\\\\\\\\\\\\\n  const diameter = barDiameter(input.barSize)\\\\\\\\\\\\\\\\n  const straightRule = lookupRule(pack, 'anchorage.L1', {\\\\\\\\\\\\\\\\n    fc: input.fc,\\\\\\\\\\\\\\\\n    grade: input.grade,\\\\\\\\\\\\\\\\n    hook: false,\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n  const minimumCoverRule = columnMinimumCover(pack)\\\\\\\\\\\\\\\\n  const fabricationCoverAdditionRule = lookupRule(\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\n    'cover.fabrication.addition',\\\\\\\\\\\\\\\\n    {},\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const fabricationCoverMm =\\\\\\\\\\\\\\\\n    millimetres(minimumCoverRule) +\\\\\\\\\\\\\\\\n    millimetres(fabricationCoverAdditionRule)\\\\\\\\\\\\\\\\n  const availableProjectionMm = input.supportLengthMm - fabricationCoverMm\\\\\\\\\\\\\\\\n  const straightLengthMm = millimetres(straightRule, diameter)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (straightLengthMm <= availableProjectionMm) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      kind: '直線定着',\\\\\\\\\\\\\\\\n      lengthRule: 'anchorage.L1',\\\\\\\\\\\\\\\\n      lengthMm: straightLengthMm,\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const bentRule = lookupRule(pack, 'anchorage.L1h', {\\\\\\\\\\\\\\\\n    fc: input.fc,\\\\\\\\\\\\\\\\n    grade: input.grade,\\\\\\\\\\\\\\\\n    hook: true,\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n  const projectionRule = lookupRule(pack, 'anchorage.La', {\\\\\\\\\\\\\\\\n    fc: input.fc,\\\\\\\\\\\\\\\\n    grade: input.grade,\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n  const tailMinimumRule = lookupRule(\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\n    'anchorage.bent.tail.minimum',\\\\\\\\\\\\\\\\n    {},\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const projectionMinimumRule = lookupRule(\\\\\\\\\\\\\\\\n    pack,\\\\\\\\\\\\\\\\n    'anchorage.bent.projection.minimum',\\\\\\\\\\\\\\\\n    { detail: '梁主筋の柱内定着' },\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const projectionMm = Math.max(\\\\\\\\\\\\\\\\n    millimetres(projectionRule, diameter),\\\\\\\\\\\\\\\\n    input.supportLengthMm * ratio(projectionMinimumRule),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (projectionMm > availableProjectionMm) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\n      `折曲げ定着が支点柱に収まらない: ` +\\\\\\\\\\\\\\\\n        `必要投影 ${projectionMm} mm > 使用可能 ${availableProjectionMm} mm`,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const lengthMm = Math.max(\\\\\\\\\\\\\\\\n    millimetres(bentRule, diameter),\\\\\\\\\\\\\\\\n    projectionMm + millimetres(tailMinimumRule, diameter),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    kind: '折曲げ定着',\\\\\\\\\\\\\\\\n    lengthRule: 'anchorage.L1h',\\\\\\\\\\\\\\\\n    projectionRule: 'anchorage.La',\\\\\\\\\\\\\\\\n    lengthMm,\\\\\\\\\\\\\\\\n    projectionMm,\\\\\\\\\\\\\\\\n    direction: input.bendDirection,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface StirrupLayout {\\\\\\\\\\\\\\\\n  /** 内法 좌표계(좌측 柱面 = 0)의 위치 배열 (mm) */\\\\\\\\\\\\\\\\n  positionsMm: number[]\\\\\\\\\\\\\\\\n  /** 마지막 잔여 간격 (mm) — 범례 표시용 */\\\\\\\\\\\\\\\\n  lastGapMm: number\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function stirrupPositions(\\\\\\\\\\\\\\\\n  clearMm: number,\\\\\\\\\\\\\\\\n  pitchMm: number,\\\\\\\\\\\\\\\\n  startOffsetMm: number,\\\\\\\\\\\\\\\\n): StirrupLayout {\\\\\\\\\\\\\\\\n  if (!Number.isFinite(clearMm)) {\\\\\\\\\\\\\\\\n    throw new Error(`clearMm must be finite: ${clearMm}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  if (!Number.isFinite(pitchMm) || pitchMm <= 0) {\\\\\\\\\\\\\\\\n    throw new Error(`pitchMm must be positive and finite: ${pitchMm}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  if (!Number.isFinite(startOffsetMm) || startOffsetMm < 0) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\n      `startOffsetMm must be non-negative and finite: ${startOffsetMm}`,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  if (clearMm <= 2 * startOffsetMm) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\n      `clearMm must exceed twice startOffsetMm: ${clearMm} <= ` +\\\\\\\\\\\\\\\\n        `${2 * startOffsetMm}`,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const intervalStartMm = startOffsetMm\\\\\\\\\\\\\\\\n  const intervalEndMm = clearMm - startOffsetMm\\\\\\\\\\\\\\\\n  const positionsMm = [intervalStartMm]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  for (let index = 1; ; index += 1) {\\\\\\\\\\\\\\\\n    const positionMm = intervalStartMm + index * pitchMm\\\\\\\\\\\\\\\\n    if (positionMm >= intervalEndMm) break\\\\\\\\\\\\\\\\n    positionsMm.push(positionMm)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  positionsMm.push(intervalEndMm)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  for (let index = 0; index < positionsMm.length; index += 1) {\\\\\\\\\\\\\\\\n    const positionMm = positionsMm[index]\\\\\\\\\\\\\\\\n    if (positionMm < intervalStartMm || positionMm > intervalEndMm) {\\\\\\\\\\\\\\\\n      throw new Error(`あばら筋 position outside placement interval: ${positionMm}`)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    if (index > 0) {\\\\\\\\\\\\\\\\n      const gapMm = positionMm - positionsMm[index - 1]\\\\\\\\\\\\\\\\n      if (gapMm <= 0 || gapMm > pitchMm) {\\\\\\\\\\\\\\\\n        throw new Error(`Invalid あばら筋 gap: ${gapMm}`)\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    positionsMm,\\\\\\\\\\\\\\\\n    lastGapMm:\\\\\\\\\\\\\\\\n      positionsMm[positionsMm.length - 1] -\\\\\\\\\\\\\\\\n      positionsMm[positionsMm.length - 2],\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { BarSize } from './member'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type RebarRole =\\\\\\\\\\\\\\\\n  | '主筋'\\\\\\\\\\\\\\\\n  | '帯筋'\\\\\\\\\\\\\\\\n  | '上端筋'\\\\\\\\\\\\\\\\n  | '下端筋'\\\\\\\\\\\\\\\\n  | 'あばら筋'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type RebarShape = 'straight' | 'hook90' | 'hoop'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface RebarZone {\\\\\\\\\\\\\\\\n  kind: '定着' | '重ね継手'\\\\\\\\\\\\\\\\n  /** 철근 polyline 시작점부터의 누적 경로거리 (mm) */\\\\\\\\\\\\\\\\n  pathFromMm: number\\\\\\\\\\\\\\\\n  pathToMm: number\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface Rebar {\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\n  memberId: string\\\\\\\\\\\\\\\\n  role: RebarRole\\\\\\\\\\\\\\\\n  size: BarSize\\\\\\\\\\\\\\\\n  shape: RebarShape\\\\\\\\\\\\\\\\n  points: [number, number, number][]\\\\\\\\\\\\\\\\n  closed: boolean\\\\\\\\\\\\\\\\n  length: number\\\\\\\\\\\\\\\\n  count: number\\\\\\\\\\\\\\\\n  zones?: RebarZone[]\\\\\\\\\\\\\\\\n  rules: string[]\\\\\\\\\\\\\\\\n  formula: string\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type MemberKind = '柱' | '大梁'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type MemberClass = '躯体'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type BarSize =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D10'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D13'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D16'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D19'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D22'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D25'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D29'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | 'D32'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/** 表5.3.6 のかぶり厚さセルを特定する入力 (屋内・屋外 × 仕上げの有無)。 */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type Exposure = '屋内' | '屋外'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type Finish = '仕上げあり' | '仕上げなし'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnSection {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  d: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: SteelGrade\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: Exposure\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: Finish\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    count: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hoop: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pitch: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface GirderSection {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '大梁'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  depth: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: SteelGrade\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: Exposure\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: Finish\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    topCount: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    bottomCount: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  stirrup: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: BarSize\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pitch: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type Section = ColumnSection | GirderSection\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ix: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  iy: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface GirderPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  axis: 'X' | 'Y'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ix: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  iy: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Member {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: MemberKind\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberClass: MemberClass\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  sectionId: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  storyId: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: ColumnPosition | GirderPosition\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_7\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Raw -Encoding utf8 src/domain/rebar/column.test.ts; Get-Content -Raw -Encoding utf8 src/domain/model/project.ts; Get-Content -Raw -Encoding utf8 src/domain/rules/types.ts; Get-Content -Raw -Encoding utf8 src/domain/rules/lookup.ts; Get-Content -Raw -Encoding utf8 phases/3-girder-domain/index.json; Get-Content -Raw -Encoding utf8 package.json'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_7\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Raw -Encoding utf8 src/domain/rebar/column.test.ts; Get-Content -Raw -Encoding utf8 src/domain/model/project.ts; Get-Content -Raw -Encoding utf8 src/domain/rules/types.ts; Get-Content -Raw -Encoding utf8 src/domain/rules/lookup.ts; Get-Content -Raw -Encoding utf8 phases/3-girder-domain/index.json; Get-Content -Raw -Encoding utf8 package.json'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"import { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { ColumnSection, Member } from '../model/member'\\\\\\\\\\\\\\\\nimport type { ColumnEnds, Story } from '../model/project'\\\\\\\\\\\\\\\\nimport type { RebarRole, RebarZone } from '../model/rebar'\\\\\\\\\\\\\\\\nimport { lookupRule } from '../rules/lookup'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { jpMlitRulePack } from '../../rulepack'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { generateColumnRebar, type ColumnRebarInput } from './column'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst member: Member = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: '1F-X2Y2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberClass: '躯体',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  sectionId: 'section-C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  storyId: '1F',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: { ix: 1, iy: 1 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst section: ColumnSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: 'section-C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: 'C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  d: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: { size: 'D25', count: 12 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hoop: { size: 'D13', pitch: 100 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst story: Story = { id: '1F', name: '1階', height: 4200 }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction input(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  overrides: Partial<ColumnRebarInput> = {},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): ColumnRebarInput {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    member,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    section,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    story,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    beamDepthAbove: 750,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 既定は「下は継手・上は定着」＝ スタック最上段の柱。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ends: { bottom: '継手', top: '定着' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ...overrides,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst mainDiameter = Number(section.main.size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst conditions = { fc: section.fc, grade: section.grade, hook: false }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst anchorage =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * mainDiameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst lap =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * mainDiameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst minimumCover = lookupRule(jpMlitRulePack, 'cover.minimum', {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberKind: section.kind,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  soilContact: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: section.exposure,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: section.finish,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}).value\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst fabricationAddition = lookupRule(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  {},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n).value\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst fabricationCover = minimumCover + fabricationAddition\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction byRole(\\\\\\\\\\\\\\\\n  generated: ReturnType<typeof generateColumnRebar>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  role: '主筋' | '帯筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const rebar = generated.find((candidate) => candidate.role === role)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  expect(rebar, `${role} should be generated`).toBeDefined()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return rebar!\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('Rebar model', () => {\\\\\\\\\\\\\\\\n  it('accepts the standard 大梁 row roles', () => {\\\\\\\\\\\\\\\\n    const roles: RebarRole[] = ['上端筋', '下端筋', 'あばら筋']\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(roles).toEqual(['上端筋', '下端筋', 'あばら筋'])\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('generateColumnRebar', () => {\\\\\\\\\\\\\\\\n  it('generates the fixed C1 input as one 主筋 row and one 帯筋 row', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(generated, '主筋')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hoop = byRole(generated, '帯筋')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(generated).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main).toMatchObject({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      memberId: member.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      size: 'D25',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      shape: 'straight',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      closed: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      count: 12,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop).toMatchObject({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      memberId: member.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      size: 'D13',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      shape: 'hoop',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      closed: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      count: 36,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('records only existing rule keys on every generated Rebar', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const knownKeys = new Set(jpMlitRulePack.entries.map(({ key }) => key))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const rebar of generated) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expect(rebar.rules.length).toBeGreaterThan(0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      for (const key of rebar.rules) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        expect(knownKeys.has(key), `${key} should exist in the rule pack`).toBe(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 端部の順（下端 → 上端）で並ぶ。既定入力は 下端 継手・上端 定着。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(byRole(generated, '主筋').rules).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.minimum',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'lap.L1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'anchorage.L1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(byRole(generated, '帯筋').rules).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.minimum',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bend.hook135',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('counts the storey joint once instead of adding 定着 and 継手 to every storey (R7)', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const lower = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '定着', top: 'なし' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const upper = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '継手', top: '定着' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(lower.length).toBe(story.height + anchorage)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(upper.length).toBe(story.height + lap + anchorage)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 2층 스택 합계는 「기초 定着 ＋ 접합부 継手 1회 ＋ 지붕 定着」뿐이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 예전에는 층마다 定着＋継手가 붙어 継手 하나를 더 세고 있었다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const doubleCounted = (story.height + anchorage + lap) * 2\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(lower.length + upper.length).toBeLessThan(doubleCounted)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(doubleCounted - (lower.length + upper.length)).toBe(lap)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('anchors both ends when the column is alone in its stack', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '定着', top: '定着' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.length).toBe(story.height + 2 * anchorage)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('extends the 3D geometry by exactly what each end contributes', () => {\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '継手', top: 'なし' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[0][1]).toBe(-lap)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[1][1]).toBe(story.height)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it.each(\\\\\\\\\\\\\\\\n    [\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\n        ends: { bottom: '定着', top: '定着' },\\\\\\\\\\\\\\\\n        bottomKind: '定着',\\\\\\\\\\\\\\\\n        bottomLength: anchorage,\\\\\\\\\\\\\\\\n        topAnchored: true,\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\n        ends: { bottom: '定着', top: 'なし' },\\\\\\\\\\\\\\\\n        bottomKind: '定着',\\\\\\\\\\\\\\\\n        bottomLength: anchorage,\\\\\\\\\\\\\\\\n        topAnchored: false,\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\n        ends: { bottom: '継手', top: '定着' },\\\\\\\\\\\\\\\\n        bottomKind: '重ね継手',\\\\\\\\\\\\\\\\n        bottomLength: lap,\\\\\\\\\\\\\\\\n        topAnchored: true,\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\n        ends: { bottom: '継手', top: 'なし' },\\\\\\\\\\\\\\\\n        bottomKind: '重ね継手',\\\\\\\\\\\\\\\\n        bottomLength: lap,\\\\\\\\\\\\\\\\n        topAnchored: false,\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\n    ] satisfies {\\\\\\\\\\\\\\\\n      ends: ColumnEnds\\\\\\\\\\\\\\\\n      bottomKind: RebarZone['kind']\\\\\\\\\\\\\\\\n      bottomLength: number\\\\\\\\\\\\\\\\n      topAnchored: boolean\\\\\\\\\\\\\\\\n    }[],\\\\\\\\\\\\\\\\n  )(\\\\\\\\\\\\\\\\n    'emits path-distance zones for $ends.bottom/$ends.top ends',\\\\\\\\\\\\\\\\n    ({ ends, bottomKind, bottomLength, topAnchored }) => {\\\\\\\\\\\\\\\\n      const main = byRole(\\\\\\\\\\\\\\\\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\\\\\\\\\\\\\\\\n        '主筋',\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      const expected: RebarZone[] = [\\\\\\\\\\\\\\\\n        {\\\\\\\\\\\\\\\\n          kind: bottomKind,\\\\\\\\\\\\\\\\n          pathFromMm: 0,\\\\\\\\\\\\\\\\n          pathToMm: bottomLength,\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\n      ]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      if (topAnchored) {\\\\\\\\\\\\\\\\n        expected.push({\\\\\\\\\\\\\\\\n          kind: '定着',\\\\\\\\\\\\\\\\n          pathFromMm: main.length - anchorage,\\\\\\\\\\\\\\\\n          pathToMm: main.length,\\\\\\\\\\\\\\\\n        })\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(main.zones).toEqual(expected)\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('keeps every zone within the 主筋 加工長 path', () => {\\\\\\\\\\\\\\\\n    const endCombinations: ColumnEnds[] = [\\\\\\\\\\\\\\\\n      { bottom: '定着', top: '定着' },\\\\\\\\\\\\\\\\n      { bottom: '定着', top: 'なし' },\\\\\\\\\\\\\\\\n      { bottom: '継手', top: '定着' },\\\\\\\\\\\\\\\\n      { bottom: '継手', top: 'なし' },\\\\\\\\\\\\\\\\n    ]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    for (const ends of endCombinations) {\\\\\\\\\\\\\\\\n      const main = byRole(\\\\\\\\\\\\\\\\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\\\\\\\\\\\\\\\\n        '主筋',\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(main.zones).toBeDefined()\\\\\\\\\\\\\\\\n      for (const zone of main.zones ?? []) {\\\\\\\\\\\\\\\\n        expect(zone.pathFromMm).toBeGreaterThanOrEqual(0)\\\\\\\\\\\\\\\\n        expect(zone.pathFromMm).toBeLessThan(zone.pathToMm)\\\\\\\\\\\\\\\\n        expect(zone.pathToMm).toBeLessThanOrEqual(main.length)\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('does not emit a zone for an end whose condition is なし', () => {\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '定着', top: 'なし' } }),\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(main.zones).toEqual([\\\\\\\\\\\\\\\\n      { kind: '定着', pathFromMm: 0, pathToMm: anchorage },\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('cites 重ね継手 only on the rows that actually carry a joint', () => {\\\\\\\\\\\\\\\\n    const withoutLap = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '定着', top: '定着' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const withLap = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '継手', top: '定着' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(withoutLap.rules).not.toContain('lap.L1')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(withoutLap.formula).not.toContain('重ね継手')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(withLap.rules).toContain('lap.L1')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('cites 定着 only on the rows that actually reach a stack end', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const interior = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '継手', top: 'なし' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(interior.rules).not.toContain('anchorage.L1')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(interior.formula).not.toContain('定着')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(interior.length).toBe(story.height + lap)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('uses the supplied 主筋 count without structurally recalculating it', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const changedSection: ColumnSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ...section,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      main: { ...section.main, count: 16 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input({ section: changedSection }), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.count).toBe(changedSection.main.count)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('fails fast when the section cannot contain the 帯筋 fabrication cover', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 加工用かぶり×2 이하의 단면은 음수 加工長을 만들고 마이너스 kg로\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 조용히 집계된다 — throw로 막는다 (ADR-014).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const tiny: ColumnSection = { ...section, b: 100, d: 100 }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(() =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input({ section: tiny }), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toThrow(/positive/)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('fails fast when the 上部大梁 depth consumes the whole storey height', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(() =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ beamDepthAbove: story.height }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toThrow(/positive/)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('uses the supplied beamDepthAbove instead of a global constant', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const baseHoop = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input(), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '帯筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const changedHoop = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(input({ beamDepthAbove: 800 }), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '帯筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(changedHoop.count).not.toBe(baseHoop.count)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(changedHoop.count).toBe(baseHoop.count - 1)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('keeps mm geometry and reproducible calculations on each row', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(generated, '主筋')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hoop = byRole(generated, '帯筋')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const anchorage = lookupRule(jpMlitRulePack, 'anchorage.L1', {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fc: section.fc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grade: section.grade,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hook: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const lap = lookupRule(jpMlitRulePack, 'lap.L1', {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fc: section.fc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grade: section.grade,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hook: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hook135 = lookupRule(jpMlitRulePack, 'bend.hook135', {})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const mainDiameter = Number(section.main.size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hoopDiameter = Number(section.hoop.size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const expectedHoopLength =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      2 *\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        (section.b - 2 * fabricationCover +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          (section.d - 2 * fabricationCover)) +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      2 * hook135.value * hoopDiameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.points).toHaveLength(4)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[0][0]).toBe(fabricationCover)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[0][2]).toBe(fabricationCover)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.points[0]).toEqual([fabricationCover, 0, fabricationCover])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.length).toBe(expectedHoopLength)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `定着長さ L1 ${anchorage.value}d(${anchorage.value * mainDiameter})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `重ね継手長さ L1 ${lap.value}d(${lap.value * mainDiameter})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const fabricationCoverFormula =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `加工用かぶり厚さ（最小かぶり ${minimumCover} ＋ ` +\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `加算 ${fabricationAddition} ＝ ${fabricationCover}）`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).toContain(fabricationCoverFormula)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(fabricationCoverFormula)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.formula).not.toContain('切上げ')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).not.toContain('切上げ')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `2×{(${section.b}−2×${fabricationCover})＋`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `135°フック余長 ${hook135.value}d(${hook135.value * hoopDiameter})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop.formula).toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '⌈(階高 4200 − 上部大梁せい 750) ÷ 帯筋ピッチ 100⌉ ＋ 1 ＝ 36',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  ColumnSection,\\\\\\\\\\\\\\\\n  ColumnPosition,\\\\\\\\\\\\\\\\n  GirderPosition,\\\\\\\\\\\\\\\\n  Member,\\\\\\\\\\\\\\\\n  Section,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from './member'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// v2 (2026-08-12): Section에 필수 필드 exposure·finish 추가 — v1 JSON은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// deserializeProject의 버전 게이트에서 명시적으로 거부된다 (영속 v1 데이터 없음).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport const PROJECT_SCHEMA_VERSION = 2\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Grid {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  xSpans: number[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ySpans: number[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Story {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  height: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  schemaVersion: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grid: Grid\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  stories: Story[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  sections: Section[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  members: Member[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  /** 내역서 備考. QuantityLine.id를 키로 쓴다. 값이 없는 행은 키 자체가 없다. */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  notes?: Record<string, string>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function gridPointCount(grid: Grid): { nx: number; ny: number } {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    nx: grid.xSpans.length + 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ny: grid.ySpans.length + 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function gridPoint(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grid: Grid,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ix: number,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  iy: number,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): { x: number; y: number } {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { nx, ny } = gridPointCount(grid)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    !Number.isInteger(ix) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    !Number.isInteger(iy) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ix < 0 ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ix >= nx ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    iy < 0 ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    iy >= ny\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/** 층 바닥의 누적 표고(mm). stories 배열 순서대로 아래층 height를 누적한다. */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function storyElevation(stories: Story[], storyId: string): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const index = stories.findIndex(({ id }) => id === storyId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (index < 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Story not found: ${storyId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function findSection(project: Project, sectionId: string): Section {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const section = project.sections.find(({ id }) => id === sectionId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!section) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Section not found: ${sectionId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return section\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function memberGroupKey(project: Project, member: Member): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!story) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Story not found: ${member.storyId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const section = findSection(project, member.sectionId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (section.kind !== member.kind) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const memberCode = member.kind === '柱' ? 'C' : 'G'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return `${story.name}|${memberCode}|${section.mark}`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction isColumnPosition(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: ColumnPosition | GirderPosition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): position is ColumnPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return !('axis' in position)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction isGirderPosition(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: ColumnPosition | GirderPosition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): position is GirderPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return 'axis' in position\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction touchesColumn(\\\\\\\\\\\\\\\\n  girder: GirderPosition,\\\\\\\\\\\\\\\\n  column: ColumnPosition,\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (girder.axis === 'X') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      girder.iy === column.iy &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (girder.ix === column.ix || girder.ix + 1 === column.ix)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    girder.ix === column.ix &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (girder.iy === column.iy || girder.iy + 1 === column.iy)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface GirderSpan {\\\\\\\\\\\\\\\\n  axis: 'X' | 'Y'\\\\\\\\\\\\\\\\n  /** 그리드 교점 간 중심 스팬 (mm) */\\\\\\\\\\\\\\\\n  centerSpan: number\\\\\\\\\\\\\\\\n  /** 内法長さ (mm) — 양단 柱面 사이 */\\\\\\\\\\\\\\\\n  clear: number\\\\\\\\\\\\\\\\n  /** 시작 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\\\\\\\\\\\\\\\\n  startFaceOffsetMm: number\\\\\\\\\\\\\\\\n  /** 끝 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\\\\\\\\\\\\\\\\n  endFaceOffsetMm: number\\\\\\\\\\\\\\\\n  /** 정착 수용성 검사용 — 시작 柱의 축방향 전체 치수 (mm) */\\\\\\\\\\\\\\\\n  startSupportLengthAlongAxisMm: number\\\\\\\\\\\\\\\\n  /** 정착 수용성 검사용 — 끝 柱의 축방향 전체 치수 (mm) */\\\\\\\\\\\\\\\\n  endSupportLengthAlongAxisMm: number\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction supportColumnSection(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  girder: Member,\\\\\\\\\\\\\\\\n  ix: number,\\\\\\\\\\\\\\\\n  iy: number,\\\\\\\\\\\\\\\\n  end: 'start' | 'end',\\\\\\\\\\\\\\\\n): ColumnSection {\\\\\\\\\\\\\\\\n  const support = project.members.find(\\\\\\\\\\\\\\\\n    (candidate) =>\\\\\\\\\\\\\\\\n      candidate.kind === '柱' &&\\\\\\\\\\\\\\\\n      candidate.storyId === girder.storyId &&\\\\\\\\\\\\\\\\n      isColumnPosition(candidate.position) &&\\\\\\\\\\\\\\\\n      candidate.position.ix === ix &&\\\\\\\\\\\\\\\\n      candidate.position.iy === iy,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (!support) {\\\\\\\\\\\\\\\\n    throw new Error(`Missing ${end} support 柱 for 大梁: ${girder.id}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const section = findSection(project, support.sectionId)\\\\\\\\\\\\\\\\n  if (section.kind !== '柱') {\\\\\\\\\\\\\\\\n    throw new Error(`柱 member references a non-柱 section: ${support.id}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return section\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function girderSpan(project: Project, member: Member): GirderSpan {\\\\\\\\\\\\\\\\n  if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\\\\\\\\\\\\\\\\n    throw new Error(`girderSpan requires a 大梁: ${member.id}`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const { axis, ix, iy } = member.position\\\\\\\\\\\\\\\\n  const endIx = axis === 'X' ? ix + 1 : ix\\\\\\\\\\\\\\\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\\\\\\\\\\\\\\\n  const startPoint = gridPoint(project.grid, ix, iy)\\\\\\\\\\\\\\\\n  const endPoint = gridPoint(project.grid, endIx, endIy)\\\\\\\\\\\\\\\\n  const startSection = supportColumnSection(project, member, ix, iy, 'start')\\\\\\\\\\\\\\\\n  const endSection = supportColumnSection(\\\\\\\\\\\\\\\\n    project,\\\\\\\\\\\\\\\\n    member,\\\\\\\\\\\\\\\\n    endIx,\\\\\\\\\\\\\\\\n    endIy,\\\\\\\\\\\\\\\\n    'end',\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const centerSpan =\\\\\\\\\\\\\\\\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\\\\\\\\\\\\\\\\n  const startSupportLengthAlongAxisMm =\\\\\\\\\\\\\\\\n    axis === 'X' ? startSection.b : startSection.d\\\\\\\\\\\\\\\\n  const endSupportLengthAlongAxisMm =\\\\\\\\\\\\\\\\n    axis === 'X' ? endSection.b : endSection.d\\\\\\\\\\\\\\\\n  const startFaceOffsetMm = startSupportLengthAlongAxisMm / 2\\\\\\\\\\\\\\\\n  const endFaceOffsetMm = endSupportLengthAlongAxisMm / 2\\\\\\\\\\\\\\\\n  const clear = centerSpan - startFaceOffsetMm - endFaceOffsetMm\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (clear <= 0) {\\\\\\\\\\\\\\\\n    throw new Error(`大梁 内法長さ must be positive: ${member.id} (${clear} mm)`)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    axis,\\\\\\\\\\\\\\\\n    centerSpan,\\\\\\\\\\\\\\\\n    clear,\\\\\\\\\\\\\\\\n    startFaceOffsetMm,\\\\\\\\\\\\\\\\n    endFaceOffsetMm,\\\\\\\\\\\\\\\\n    startSupportLengthAlongAxisMm,\\\\\\\\\\\\\\\\n    endSupportLengthAlongAxisMm,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/**\\\\\\\\\\\\\\\\n * 柱主筋の端部条件 (R7)。\\\\\\\\\\\\\\\\n *\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 층간 접합부에는 이음이 **한 번만** 있어야 한다. 예전에는 모든 층이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 「階高 ＋ 定着 ＋ 継手」를 받아 접합부가 아래층의 継手와 위층의 定着으로\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 두 번 계상됐다. 접합부의 継手는 **위층 부재가 부담**하고, 定着은 스택의\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 양 끝(기초·최상단)에만 붙는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n *\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 스택 순서는 `stories` 배열 순서를 그대로 신뢰한다 — Story에 레벨 값이 없다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 조문이 아니라 관행에 따른 배분이므로 이 규칙 자체는 검증되지 않은 전제다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ColumnEnds {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  bottom: '定着' | '継手'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  top: '定着' | 'なし'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function columnEnds(project: Project, member: Member): ColumnEnds {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { position } = member\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (member.kind !== '柱' || !isColumnPosition(position)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`columnEnds requires a 柱: ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const level = project.stories.findIndex(({ id }) => id === member.storyId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (level < 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`Story not found: ${member.storyId}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasColumnAtLevel = (candidateLevel: number): boolean => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const story = project.stories[candidateLevel]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (story === undefined) return false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return project.members.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (candidate) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.kind === '柱' &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.storyId === story.id &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        isColumnPosition(candidate.position) &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.position.ix === position.ix &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.position.iy === position.iy,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    bottom: hasColumnAtLevel(level - 1) ? '継手' : '定着',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    top: hasColumnAtLevel(level + 1) ? 'なし' : '定着',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function beamDepthAbove(project: Project, member: Member): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (member.kind !== '柱' || !isColumnPosition(member.position)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`beamDepthAbove requires a 柱: ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const depths = project.members\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .filter(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (candidate) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.kind === '大梁' &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.storyId === member.storyId &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        isGirderPosition(candidate.position) &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        touchesColumn(candidate.position, member.position),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .map((girder) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const section = findSection(project, girder.sectionId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (section.kind !== '大梁') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          `大梁 member references a non-大梁 section: ${girder.id}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      return section.depth\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (depths.length === 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`No touching 大梁 found above 柱: ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return Math.max(...depths)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function setNote(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lineId: string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  note: string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const notes = { ...project.notes }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (note === '') delete notes[lineId]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  else notes[lineId] = note\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return { ...project, notes }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function serializeProject(project: Project): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return JSON.stringify(project)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function deserializeProject(json: string): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const parsed: unknown = JSON.parse(json)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    typeof parsed !== 'object' ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    parsed === null ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    !('schemaVersion' in parsed) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    parsed.schemaVersion !== PROJECT_SCHEMA_VERSION\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `Unsupported Project schemaVersion; expected ${PROJECT_SCHEMA_VERSION}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return parsed as Project\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface ResolvedSource {\\\\\\\\\\\\\\\\n  short: string\\\\\\\\\\\\\\\\n  doc: string\\\\\\\\\\\\\\\\n  edition: string | null\\\\\\\\\\\\\\\\n  publisher: string\\\\\\\\\\\\\\\\n  url: string | null\\\\\\\\\\\\\\\\n  section: string | null\\\\\\\\\\\\\\\\n  page: number | null\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface RuleEntry {\\\\\\\\\\\\\\\\n  key: string\\\\\\\\\\\\\\\\n  label: string\\\\\\\\\\\\\\\\n  expr: string\\\\\\\\\\\\\\\\n  conditions: Record<string, string | number | boolean>\\\\\\\\\\\\\\\\n  value: number\\\\\\\\\\\\\\\\n  unit: string\\\\\\\\\\\\\\\\n  source: ResolvedSource\\\\\\\\\\\\\\\\n  confidence: 'stated' | 'inferred'\\\\\\\\\\\\\\\\n  note: string\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type RuleHit = RuleEntry\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface RulePack {\\\\\\\\\\\\\\\\n  id: string\\\\\\\\\\\\\\\\n  entries: RuleEntry[]\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { BarSize, MemberClass, Section } from '../model/member'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { RuleHit, RulePack } from './types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 表5.3.6 のかぶり厚さセルを特定する共通条件 — 생성기(column.ts)와\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 집계기(quantity/index.ts)가 반드시 같은 셀을 봐야 하므로 단일 출처로 둔다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 地上躯体のみを扱う (基礎・地中部材は ADR-005 でスコープ外) — 土に接しない。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function coverConditions(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  section: Section,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): Record<string, string | boolean> {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    memberKind: section.kind,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    soilContact: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    exposure: section.exposure,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    finish: section.finish,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction matches(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ruleConditions: Record<string, string | number | boolean>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  queryConditions: Record<string, unknown>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return Object.entries(ruleConditions).every(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ([name, value]) => queryConditions[name] === value,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function lookupRule(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  pack: RulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  key: string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  conditions: Record<string, unknown>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): RuleHit {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const candidates = pack.entries.filter(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (entry) => entry.key === key && matches(entry.conditions, conditions),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (candidates.length === 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `Rule not found: ${key} for ${JSON.stringify(conditions)}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const specificity = Math.max(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ...candidates.map((entry) => Object.keys(entry.conditions).length),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const mostSpecific = candidates.filter(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (entry) => Object.keys(entry.conditions).length === specificity,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (mostSpecific.length !== 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      `Rule lookup is ambiguous: ${key} for ${JSON.stringify(conditions)}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return mostSpecific[0]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function lookupMarkup(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  pack: RulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberClass: MemberClass | string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): RuleHit {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return lookupRule(pack, 'markup.rate', { memberClass })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function lookupUnitMass(pack: RulePack, size: BarSize): RuleHit {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return lookupRule(pack, 'unit-mass.value', { size })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n{\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Kijun\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"phase\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"3-girder-domain\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"steps\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"girder-span\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"started_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-12T12:44:12+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"GirderSpan(axis, centerSpan, clear, start/endFaceOffsetMm, start/endSupportLengthAlongAxisMm)을 추가하고 大梁 이외·양단 동일층 柱 결손·柱 단면 불일치·비양수 内法에서 throw\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"completed_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-12T12:49:27+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"rebar-zones-roles\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"started_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-12T12:49:28+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"RebarRole에 上端筋·下端筋·あばら筋 3종과 polyline 누적 경로거리 기반 RebarZone(定着·重ね継手)을 추가하고 柱 主筋이 하단 継手·定着 및 상단 定着 zones를 방출\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\