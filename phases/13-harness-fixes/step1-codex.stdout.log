\\r\\\\n      </p>\\\\r\\\\n    </div>\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction Elevation({\\\\r\\\\n  candidate,\\\\r\\\\n  index,\\\\r\\\\n  locale,\\\\r\\\\n  onApply,\\\\r\\\\n  result,\\\\r\\\\n  discardMembers,\\\\r\\\\n  onDiscardMembersChange,\\\\r\\\\n}: {\\\\r\\\\n  candidate: ElevationCandidate\\\\r\\\\n  index: number\\\\r\\\\n  locale: 'ja' | 'ko'\\\\r\\\\n  onApply: (topLevelIndex: number, bottomLevelIndex: number) => void\\\\r\\\\n  result: ElevationApplyResult | null\\\\r\\\\n  discardMembers: boolean\\\\r\\\\n  onDiscardMembersChange: (next: boolean) => void\\\\r\\\\n}) {\\\\r\\\\n  // ?뚯뼱???덈꺼???롮쓽 寃쎄퀎?멸??띾뒗 議곕Ц???꾨땲???ㅺ퀎 ?섎룄???щ엺??怨좊Ⅸ??\\\\n  // (ADR-030). 湲곕낯媛믪? ???????쒗뭹? ?묆꺀?싥긿?덉씠???븀쨴瑜??뚯븘蹂????놁쑝誘濡?\\\\n  // 媛???볤쾶 ?≪븘 ?먭퀬 ?ъ슜?먭? 醫곹엺??\\\\n  const [top, setTop] = useState(0)\\\\r\\\\n  const [bottom, setBottom] = useState(candidate.levels.length - 1)\\\\r\\\\n\\\\r\\\\n  const levelLabel = (levelIndex: number) => {\\\\r\\\\n    const level = candidate.levels[levelIndex]\\\\r\\\\n    return level.labels.length > 0\\\\r\\\\n      ? level.labels.join('竊?)\\\\r\\\\n      : t(locale, 'planImport.levelUnlabelled')\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    <div\\\\r\\\\n      className={styles.elevation}\\\\r\\\\n      data-testid={`plan-import-elevation-${index}`}\\\\r\\\\n    >\\\\r\\\\n      <div className={styles.blockHeading}>\\\\r\\\\n        <strong>\\\\r\\\\n          {candidate.titles.join('??) ||\\\\r\\\\n            t(locale, 'planImport.elevationUntitled')}\\\\r\\\\n        </strong>\\\\r\\\\n        <button\\\\r\\\\n          type=\\\\\\\"button\\\\\\\"\\\\r\\\\n          className={styles.applyButton}\\\\r\\\\n          data-testid={`plan-import-apply-elevation-${index}`}\\\\r\\\\n          onClick={() => onApply(top, bottom)}\\\\r\\\\n        >\\\\r\\\\n          {t(locale, 'planImport.applyStories')}\\\\r\\\\n        </button>\\\\r\\\\n      </div>\\\\r\\\\n      <p className={styles.axes}>\\\\r\\\\n        {candidate.levels.map((level, levelIndex) => (\\\\r\\\\n          <span key={levelIndex}>\\\\r\\\\n            <span className={styles.axis}>\\\\r\\\\n              {level.labels.join('竊?) || '??}\\\\r\\\\n            </span>\\\\r\\\\n            {levelIndex < candidate.heightsMm.length ? (\\\\r\\\\n              <span className={styles.span}>\\\\r\\\\n                {` ??${candidate.heightsMm[levelIndex]} ??`}\\\\r\\\\n              </span>\\\\r\\\\n            ) : null}\\\\r\\\\n          </span>\\\\r\\\\n        ))}\\\\r\\\\n      </p>\\\\r\\\\n      <div className={styles.storyPicker}>\\\\r\\\\n        <label className={styles.storyPicker}>\\\\r\\\\n          {t(locale, 'planImport.topLevel')}\\\\r\\\\n          <select\\\\r\\\\n            data-testid={`plan-import-level-top-${index}`}\\\\r\\\\n            value={top}\\\\r\\\\n            onChange={(event) => setTop(Number(event.target.value))}\\\\r\\\\n          >\\\\r\\\\n            {candidate.levels.map((level, levelIndex) => (\\\\r\\\\n              <option key={levelIndex} value={levelIndex}>\\\\r\\\\n                {levelLabel(levelIndex)}\\\\r\\\\n              </option>\\\\r\\\\n            ))}\\\\r\\\\n          </select>\\\\r\\\\n        </label>\\\\r\\\\n        <label className={styles.storyPicker}>\\\\r\\\\n          {t(locale, 'planImport.bottomLevel')}\\\\r\\\\n          <select\\\\r\\\\n            data-testid={`plan-import-level-bottom-${index}`}\\\\r\\\\n            value={bottom}\\\\r\\\\n            onChange={(event) => setBottom(Number(event.target.value))}\\\\r\\\\n          >\\\\r\\\\n            {candidate.levels.map((level, levelIndex) => (\\\\r\\\\n              <option key={levelIndex} value={levelIndex}>\\\\r\\\\n                {levelLabel(levelIndex)}\\\\r\\\\n              </option>\\\\r\\\\n            ))}\\\\r\\\\n          </select>\\\\r\\\\n        </label>\\\\r\\\\n      </div>\\\\r\\\\n      {/* ?숈쓽??嫄곕?瑜???踰?蹂??ㅼ뿉留?臾쇱뼱蹂몃떎 */}\\\\r\\\\n      {result?.refusal === '?ⓩ쓲?귙굤?롧쉰?쎽툖?? ? (\\\\r\\\\n        <label className={styles.storyPicker}>\\\\r\\\\n          <input\\\\r\\\\n            type=\\\\\\\"checkbox\\\\\\\"\\\\r\\\\n            data-testid={`plan-import-discard-members-${index}`}\\\\r\\\\n            checked={discardMembers}\\\\r\\\\n            onChange={(event) => onDiscardMembersChange(event.target.checked)}\\\\r\\\\n          />\\\\r\\\\n          {t(locale, 'planImport.discardMembers')}\\\\r\\\\n        </label>\\\\r\\\\n      ) : null}\\\\r\\\\n      {result ? (\\\\r\\\\n        <p\\\\r\\\\n          className={styles.muted}\\\\r\\\\n          data-testid={`plan-import-elevation-result-${index}`}\\\\r\\\\n        >\\\\r\\\\n          {result.refusal\\\\r\\\\n            ? t(locale, `planImport.elevationRefusal.${result.refusal}`)\\\\r\\\\n            : `${t(locale, 'planImport.appliedStories')}: ${result.applied}`}\\\\r\\\\n        </p>\\\\r\\\\n      ) : null}\\\\r\\\\n    </div>\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function PlanImport({\\\\r\\\\n  initialPages,\\\\r\\\\n  extractPages = extractTextPages,\\\\r\\\\n}: PlanImportProps) {\\\\r\\\\n  const locale = useAppStore(({ locale }) => locale)\\\\r\\\\n  const stories = useAppStore(({ project }) => project.stories)\\\\r\\\\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\\\\r\\\\n  const inputRef = useRef<HTMLInputElement>(null)\\\\r\\\\n  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\\\\r\\\\n  const [open, setOpen] = useState(initialPages !== undefined)\\\\r\\\\n  const [loading, setLoading] = useState(false)\\\\r\\\\n  const [failed, setFailed] = useState(false)\\\\r\\\\n  const [storyId, setStoryId] = useState<string>(stories[0]?.id ?? '')\\\\r\\\\n  const [result, setResult] = useState<PlanApplyResult | null>(null)\\\\r\\\\n  const [discardOtherStories, setDiscardOtherStories] = useState(false)\\\\r\\\\n  const [discardMembers, setDiscardMembers] = useState(false)\\\\r\\\\n  const [elevationResults, setElevationResults] = useState<\\\\r\\\\n    Record<number, ElevationApplyResult>\\\\r\\\\n  >({})\\\\r\\\\n  // ?곗냽 ?좏깮 ????쾶 ?앸궃 ?댁쟾 ?뚯씪??寃곌낵媛 理쒖떊 寃곌낵瑜???? ?딄쾶 ?쒕떎\\\\r\\\\n  const requestRef = useRef(0)\\\\r\\\\n\\\\r\\\\n  const plans = useMemo(\\\\r\\\\n    () => (pages ?? []).map((page) => parseFramingPlan(page)),\\\\r\\\\n    [pages],\\\\r\\\\n  )\\\\r\\\\n  const elevations = useMemo(\\\\r\\\\n    () => (pages ?? []).flatMap((page) => parseFrameElevations(page).elevations),\\\\r\\\\n    [pages],\\\\r\\\\n  )\\\\r\\\\n  const grids = plans.flatMap((plan) => plan.grids)\\\\r\\\\n  const gridIndexes = { X: 0, Y: 0 }\\\\r\\\\n  const displayedGrids = grids.map((candidate) => ({\\\\r\\\\n    candidate,\\\\r\\\\n    index: gridIndexes[candidate.direction]++,\\\\r\\\\n  }))\\\\r\\\\n  const blocks: PlanBlock[] = plans.flatMap((plan) => plan.blocks)\\\\r\\\\n  // ?ъ쑀???섏씠吏留덈떎 ?섏삤誘濡??묐뒗????媛숈? 留먯씠 ?섏씠吏 ?섎쭔???섏뼱?쒕㈃ ?쏀엳吏 ?딅뒗??\\\\n  const issues = [...new Set(plans.flatMap((plan) => plan.issues))]\\\\r\\\\n\\\\r\\\\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\\\\r\\\\n    const input = event.currentTarget\\\\r\\\\n    const file = input.files?.[0]\\\\r\\\\n    if (!file) return\\\\r\\\\n\\\\r\\\\n    const requestId = ++requestRef.current\\\\r\\\\n    setOpen(true)\\\\r\\\\n    setLoading(true)\\\\r\\\\n    setFailed(false)\\\\r\\\\n    setResult(null)\\\\r\\\\n    setElevationResults({})\\\\r\\\\n    try {\\\\r\\\\n      const next = await extractPages(file)\\\\r\\\\n      if (requestRef.current !== requestId) return\\\\r\\\\n      setPages(next)\\\\r\\\\n    } catch {\\\\r\\\\n      if (requestRef.current !== requestId) return\\\\r\\\\n      setPages(null)\\\\r\\\\n      setFailed(true)\\\\r\\\\n    } finally {\\\\r\\\\n      if (requestRef.current === requestId) setLoading(false)\\\\r\\\\n      input.value = ''\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const apply = (block: PlanBlock) => {\\\\r\\\\n    let applied: PlanApplyResult | undefined\\\\r\\\\n    updateProject((project) => {\\\\r\\\\n      applied = applyFramingPlan(project, {\\\\r\\\\n        block,\\\\r\\\\n        storyId,\\\\r\\\\n        discardOtherStories,\\\\r\\\\n      })\\\\r\\\\n      return applied.project\\\\r\\\\n    })\\\\r\\\\n    if (applied) setResult(applied)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const applyStories = (\\\\r\\\\n    candidate: ElevationCandidate,\\\\r\\\\n    index: number,\\\\r\\\\n    topLevelIndex: number,\\\\r\\\\n    bottomLevelIndex: number,\\\\r\\\\n  ) => {\\\\r\\\\n    let applied: ElevationApplyResult | undefined\\\\r\\\\n    updateProject((project) => {\\\\r\\\\n      applied = applyElevation(project, {\\\\r\\\\n        candidate,\\\\r\\\\n        topLevelIndex,\\\\r\\\\n        bottomLevelIndex,\\\\r\\\\n        discardMembers,\\\\r\\\\n      })\\\\r\\\\n      return applied.project\\\\r\\\\n    })\\\\r\\\\n    if (applied) {\\\\r\\\\n      const next = applied\\\\r\\\\n      setElevationResults((current) => ({ ...current, [index]: next }))\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    <div className={styles.control}>\\\\r\\\\n      <button\\\\r\\\\n        type=\\\\\\\"button\\\\\\\"\\\\r\\\\n        className={styles.openButton}\\\\r\\\\n        onClick={() => {\\\\r\\\\n          if (pages) setOpen(true)\\\\r\\\\n          else inputRef.current?.click()\\\\r\\\\n        }}\\\\r\\\\n      >\\\\r\\\\n        {t(locale, 'planImport.open')}\\\\r\\\\n      </button>\\\\r\\\\n      <input\\\\r\\\\n        ref={inputRef}\\\\r\\\\n        className={styles.fileInput}\\\\r\\\\n        data-testid=\\\\\\\"plan-import-file\\\\\\\"\\\\r\\\\n        type=\\\\\\\"file\\\\\\\"\\\\r\\\\n        accept=\\\\\\\"application/pdf\\\\\\\"\\\\r\\\\n        aria-label={t(locale, 'planImport.file')}\\\\r\\\\n        onChange={(event) => void selectFile(event)}\\\\r\\\\n      />\\\\r\\\\n      {open ? (\\\\r\\\\n        <section\\\\r\\\\n          className={styles.panel}\\\\r\\\\n          role=\\\\\\\"dialog\\\\\\\"\\\\r\\\\n          aria-modal=\\\\\\\"false\\\\\\\"\\\\r\\\\n          aria-labelledby=\\\\\\\"plan-import-title\\\\\\\"\\\\r\\\\n        >\\\\r\\\\n          <header className={styles.panelHeader}>\\\\r\\\\n            <h3 id=\\\\\\\"plan-import-title\\\\\\\">{t(locale, 'planImport.title')}</h3>\\\\r\\\\n            <div className={styles.panelActions}>\\\\r\\\\n              <button\\\\r\\\\n                type=\\\\\\\"button\\\\\\\"\\\\r\\\\n                className={styles.chooseButton}\\\\r\\\\n                onClick={() => inputRef.current?.click()}\\\\r\\\\n              >\\\\r\\\\n                {t(locale, 'planImport.chooseAnother')}\\\\r\\\\n              </button>\\\\r\\\\n              <button\\\\r\\\\n                type=\\\\\\\"button\\\\\\\"\\\\r\\\\n                className={styles.closeButton}\\\\r\\\\n                onClick={() => setOpen(false)}\\\\r\\\\n              >\\\\r\\\\n                {t(locale, 'planImport.close')}\\\\r\\\\n              </button>\\\\r\\\\n            </div>\\\\r\\\\n          </header>\\\\r\\\\n          <div className={styles.panelBody}>\\\\r\\\\n            {loading ? (\\\\r\\\\n              <p role=\\\\\\\"status\\\\\\\">{t(locale, 'planImport.loading')}</p>\\\\r\\\\n            ) : failed ? (\\\\r\\\\n              <p role=\\\\\\\"alert\\\\\\\">{t(locale, 'planImport.error')}</p>\\\\r\\\\n            ) : (\\\\r\\\\n              <>\\\\r\\\\n                {issues.length > 0 ? (\\\\r\\\\n                  <ul className={styles.issues} data-testid=\\\\\\\"plan-import-issues\\\\\\\">\\\\r\\\\n                    {issues.map((issue) => (\\\\r\\\\n                      <li key={issue}>\\\\r\\\\n                        {t(locale, `planImport.issue.${issue}`)}\\\\r\\\\n                      </li>\\\\r\\\\n                    ))}\\\\r\\\\n                  </ul>\\\\r\\\\n                ) : null}\\\\r\\\\n\\\\r\\\\n                {displayedGrids.map(({ candidate, index }) => (\\\\r\\\\n                  <Axes\\\\r\\\\n                    key={`${candidate.direction}-${index}`}\\\\r\\\\n                    candidate={candidate}\\\\r\\\\n                    label={t(\\\\r\\\\n                      locale,\\\\r\\\\n                      candidate.direction === 'X'\\\\r\\\\n                        ? 'planImport.gridX'\\\\r\\\\n                        : 'planImport.gridY',\\\\r\\\\n                    )}\\\\r\\\\n                    testId={`plan-import-grid-${candidate.direction}-${index}`}\\\\r\\\\n                  />\\\\r\\\\n                ))}\\\\r\\\\n\\\\r\\\\n                {blocks.length > 0 ? (\\\\r\\\\n                  <label className={styles.storyPicker}>\\\\r\\\\n                    {t(locale, 'planImport.story')}\\\\r\\\\n                    <select\\\\r\\\\n                      data-testid=\\\\\\\"plan-import-story\\\\\\\"\\\\r\\\\n                      value={storyId}\\\\r\\\\n                      onChange={(event) => setStoryId(event.target.value)}\\\\r\\\\n                    >\\\\r\\\\n                      {stories.map((story) => (\\\\r\\\\n                        <option key={story.id} value={story.id}>\\\\r\\\\n                          {story.name}\\\\r\\\\n                        </option>\\\\r\\\\n                      ))}\\\\r\\\\n                    </select>\\\\r\\\\n                  </label>\\\\r\\\\n                ) : null}\\\\r\\\\n\\\\r\\\\n                {blocks.map((block, index) => (\\\\r\\\\n                  <div\\\\r\\\\n                    key={`${block.title ?? 'block'}-${index}`}\\\\r\\\\n                    className={styles.block}\\\\r\\\\n                  >\\\\r\\\\n                    <div className={styles.blockHeading}>\\\\r\\\\n                      <strong>\\\\r\\\\n                        {block.title ?? t(locale, 'planImport.blockUntitled')}\\\\r\\\\n                      </strong>\\\\r\\\\n                      <button\\\\r\\\\n                        type=\\\\\\\"button\\\\\\\"\\\\r\\\\n                        className={styles.applyButton}\\\\r\\\\n                        data-testid={`plan-import-apply-${index}`}\\\\r\\\\n                        onClick={() => apply(block)}\\\\r\\\\n                      >\\\\r\\\\n                        {t(locale, 'planImport.apply')}\\\\r\\\\n                      </button>\\\\r\\\\n                    </div>\\\\r\\\\n                    <p className={styles.muted}>\\\\r\\\\n                      {`${t(locale, 'planImport.placements')}: ${block.placements.length}`}\\\\r\\\\n                      {block.unplacedMarks.length > 0\\\\r\\\\n                        ? ` / ${t(locale, 'planImport.unplaced')}: ${block.unplacedMarks.join('??)}`\\\\r\\\\n                        : ''}\\\\r\\\\n                    </p>\\\\r\\\\n                    <Axes\\\\r\\\\n                      candidate={block.xGrid}\\\\r\\\\n                      label={t(locale, 'planImport.gridX')}\\\\r\\\\n                      testId={`plan-import-block-grid-${index}-X`}\\\\r\\\\n                    />\\\\r\\\\n                    <Axes\\\\r\\\\n                      candidate={block.yGrid}\\\\r\\\\n                      label={t(locale, 'planImport.gridY')}\\\\r\\\\n                      testId={`plan-import-block-grid-${index}-Y`}\\\\r\\\\n                    />\\\\r\\\\n                  </div>\\\\r\\\\n                ))}\\\\r\\\\n\\\\r\\\\n                {elevations.map((candidate, index) => (\\\\r\\\\n                  <Elevation\\\\r\\\\n                    key={index}\\\\r\\\\n                    candidate={candidate}\\\\r\\\\n                    index={index}\\\\r\\\\n                    locale={locale}\\\\r\\\\n                    result={elevationResults[index] ?? null}\\\\r\\\\n                    discardMembers={discardMembers}\\\\r\\\\n                    onDiscardMembersChange={setDiscardMembers}\\\\r\\\\n                    onApply={(topLevel, bottomLevel) =>\\\\r\\\\n                      applyStories(candidate, index, topLevel, bottomLevel)\\\\r\\\\n                    }\\\\r\\\\n                  />\\\\r\\\\n                ))}\\\\r\\\\n\\\\r\\\\n                {/* ?숈쓽??嫄곕?瑜???踰?蹂??ㅼ뿉留?臾쇱뼱蹂몃떎 ??泥섏쓬遺???대넃?쇰㈃\\\\r\\\\n                    ?뚮Т???살씤吏 紐⑤Ⅸ 梨?耳??먮뒗 移멥띿씠 ?쒕떎 */}\\\\r\\\\n                {result?.refusal === '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖?? ? (\\\\r\\\\n                  <label className={styles.storyPicker}>\\\\r\\\\n                    <input\\\\r\\\\n                      type=\\\\\\\"checkbox\\\\\\\"\\\\r\\\\n                      data-testid=\\\\\\\"plan-import-discard\\\\\\\"\\\\r\\\\n                      checked={discardOtherStories}\\\\r\\\\n                      onChange={(event) =>\\\\r\\\\n                        setDiscardOtherStories(event.target.checked)\\\\r\\\\n                      }\\\\r\\\\n                    />\\\\r\\\\n                    {t(locale, 'planImport.discardOtherStories')}\\\\r\\\\n                  </label>\\\\r\\\\n                ) : null}\\\\r\\\\n\\\\r\\\\n                {result ? (\\\\r\\\\n                  <p className={styles.muted} data-testid=\\\\\\\"plan-import-result\\\\\\\">\\\\r\\\\n                    {result.refusal\\\\r\\\\n                      ? t(locale, `planImport.refusal.${result.refusal}`)\\\\r\\\\n                      : `${t(locale, 'planImport.applied')}: ${result.applied}`}\\\\r\\\\n                    {result.skipped.length > 0\\\\r\\\\n                      ? ` / ${result.skipped\\\\r\\\\n                          .map(\\\\r\\\\n                            ({ mark, reason }) =>\\\\r\\\\n                              `${mark}(${t(locale, `planImport.skip.${reason}`)})`,\\\\r\\\\n                          )\\\\r\\\\n                          .join('??)}`\\\\r\\\\n                      : ''}\\\\r\\\\n                  </p>\\\\r\\\\n                ) : null}\\\\r\\\\n              </>\\\\r\\\\n            )}\\\\r\\\\n          </div>\\\\r\\\\n        </section>\\\\r\\\\n      ) : null}\\\\r\\\\n    </div>\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * ???鍮덉뭏?쇰줈 ?④릿 ?ъ쑀 肄붾뱶 (section-list??CANDIDATE_ISSUES ?⑦꽩).\\\\r\\\\n * ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎.\\\\r\\\\n */\\\\r\\\\nexport const PLAN_GRID_ISSUES = [\\\\r\\\\n  '?싥굤??꺀?쇻꺂?ゆ쩂??,\\\\r\\\\n  '野멩퀡轝좄맼',\\\\r\\\\n  '潁?갰訝띷빐??,\\\\r\\\\n  '?덅쮫訝띴???,\\\\r\\\\n  '?⒲깧?ユ뻼耶쀦렁??,\\\\r\\\\n  '?싥굤???恙쒍툖??,\\\\r\\\\n] as const\\\\r\\\\n\\\\r\\\\nexport type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\\\\r\\\\n\\\\r\\\\n/** 鴉뤷쎋?먯꽌 ?쎌? ?싥굤????蹂? positionPt???꾨㈃ 醫뚰몴(pt) ??遺???ㅻ깄??湲곗?. */\\\\r\\\\nexport interface AxisCandidate {\\\\r\\\\n  label: string\\\\r\\\\n  positionPt: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** ??諛⑺뼢(X ?먮뒗 Y)???싥굤?????꾨낫. ?뱀씤 ?꾩뿉???뺤긽???섏? ?딅뒗??(ADR-030). */\\\\r\\\\nexport interface PlanGridCandidate {\\\\r\\\\n  /** ?쇰꺼??異?臾몄옄 ??諛대뱶??湲고븯 諛⑺뼢???꾨땲???꾨㈃??遺숈씤 ?대쫫???곕Ⅸ??*/\\\\r\\\\n  direction: 'X' | 'Y'\\\\r\\\\n  /** ?꾩튂 ?ㅻ쫫李⑥닚 */\\\\r\\\\n  axes: AxisCandidate[]\\\\r\\\\n  /** ?몄젒 異??ъ씠 移섏닔(mm). 湲몄씠??axes.length - 1 */\\\\r\\\\n  spansMm: number[]\\\\r\\\\n  /** ?ㅼ륫 異뺤쿃(pt/mm) ?????ㅽ뙩 ?ㅼ륫??以묒븰媛? ?쒓린 異뺤쿃? ?⑹? ?섏〈?대씪 誘우? ?딅뒗??*/\\\\r\\\\n  scalePtPerMm: number\\\\r\\\\n  /** ?꾨㈃???꾩껜 移섏닔媛 紐낃린???덇퀬 ?ㅽ뙩 ?⑷낵 ?쇱튂?덈떎 */\\\\r\\\\n  totalConfirmed: boolean\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 遺?멸? 洹몃━?쒖쓽 ?대뵒???볦??붽? ???꾨㈃?먯꽌 ??**湲고븯**留?留먰븳??\\\\r\\\\n *\\\\r\\\\n * ?똂硫??긱띿쿂??遺???묐몢濡?遺??醫낅퀎???뺥븯吏 ?딅뒗?? 醫낅퀎? ??씊?ゃ궧?덇?\\\\r\\\\n * ?대? 媛뽮퀬 ?덉쑝誘濡?ADR-018), 痍⑥엯??洹?醫낅퀎怨???湲고븯瑜?留욎떠 蹂몃떎 ??\\\\n * ?닿툔?섎㈃ ?щ엺???먮떒???쇱씠吏 ?뚯꽌媛 怨좊? ?쇱씠 ?꾨땲??\\\\r\\\\n */\\\\r\\\\nexport const PLAN_PLACEMENT_ROLES = ['?쇔춴??, '渦?, '?쇻궎'] as const\\\\r\\\\n\\\\r\\\\nexport type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\\\\r\\\\n\\\\r\\\\nexport type MemberPlacement =\\\\r\\\\n  | { mark: string; role: '?쇔춴?? | '?쇻궎'; ix: number; iy: number }\\\\r\\\\n  | {\\\\r\\\\n      mark: string\\\\r\\\\n      role: '渦?\\\\r\\\\n      /** 遺?ш? ?쒖옉?섎뒗 寃⑹옄??*/\\\\r\\\\n      ix: number\\\\r\\\\n      iy: number\\\\r\\\\n      /** 遺?ш? 六쀫뒗 諛⑺뼢 (GirderPosition.axis? 媛숈? ?? */\\\\r\\\\n      axis: 'X' | 'Y'\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * ?꾨㈃ ?꾩쓽 鴉뤷쎋 ???? ???섏씠吏???щ윭 ?μ씠 ?ㅻ━誘濡??ㅻЪ yokohama p7?\\\\r\\\\n * 2?롥틞鴉뤷쎋? R?롥틞鴉뤷쎋 ???? ?싥굤???뺤쓽媛 媛숈븘??**?꾩튂媛 ?ㅻⅤ??* ??\\\\n * 洹몃━???뺤쓽???묓엳吏留?釉붾줉? ?묓엳吏 ?딅뒗??\\\\r\\\\n */\\\\r\\\\nexport interface PlanBlock {\\\\r\\\\n  /** 釉붾줉 ?쒕ぉ ?먮Ц(???롥틞鴉뤷쎋1/100??. ?대뒓 Story?몄????щ엺???뺥븳??*/\\\\r\\\\n  title?: string\\\\r\\\\n  /** ??釉붾줉怨?吏앹??댁쭊 X쨌Y ?싥굤???뺤쓽. 痍⑥엯? 諛섎뱶?????섏쓣 ?대떎 */\\\\r\\\\n  xGrid: PlanGridCandidate\\\\r\\\\n  yGrid: PlanGridCandidate\\\\r\\\\n  placements: MemberPlacement[]\\\\r\\\\n  /** 釉붾줉 ?덉뿉 ?덉쑝???ㅻ깄?섏? 紐삵븳 遺??以묐났 ?놁쓬, ?먮Ц ?? ??吏?대궡吏 ?딅뒗??*/\\\\r\\\\n  unplacedMarks: string[]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface ParsedFramingPlan {\\\\r\\\\n  /** ?싥굤???뺤쓽 ??媛숈? 洹몃━?쒓? ?щ윭 釉붾줉??諛섎났?섎㈃ ?섎굹濡??묓엺??*/\\\\r\\\\n  grids: PlanGridCandidate[]\\\\r\\\\n  blocks: PlanBlock[]\\\\r\\\\n  /** ?꾨낫瑜?紐????ъ쑀 ??泥??깆옣 ?? 以묐났 ?놁쓬 */\\\\r\\\\n  issues: PlanGridIssue[]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 邕며탡?녹뿉??怨꾩뿴??紐????ъ쑀. ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎 */\\\\r\\\\nexport const ELEVATION_ISSUES = ['野멩퀡?쀦쑋濾쒎눣'] as const\\\\r\\\\n\\\\r\\\\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\\\\r\\\\n\\\\r\\\\nexport interface ElevationLevel {\\\\r\\\\n  /** 洹??믪씠???곹엺 ?쇰꺼 ?먮Ц ?꾨?. ?놁쑝硫?鍮?諛곗뿴 ??吏?대궡吏 ?딅뒗??*/\\\\r\\\\n  labels: string[]\\\\r\\\\n  positionPt: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 邕며탡????怨꾩뿴???믪씠 諛⑺뼢 ?쎄린. ?뚯뼱???덈꺼??Story??寃쎄퀎?멸??띾뒗 ?뺥븯吏\\\\r\\\\n * ?딅뒗?????먮Ц?먮뒗 FL쨌GL쨌?븀쨴訝뗧ク쨌RCL???욎뿬 ?덇퀬, 洹몄쨷 臾댁뾿???롮씤吏??\\\\n * 議곕Ц???꾨땲???ㅺ퀎 ?섎룄???щ엺???쎌쓣 ?쇱씠??(ADR-030).\\\\r\\\\n *\\\\r\\\\n * ?싥굤??낵 ?щ━ ?쇰꺼??醫뚯슦 ?뺣젹???쇱젙?섏? ?딆븘(?ㅻЪ p8??醫뚮떒 x??108~198濡?\\\\n * ?⑹뼱吏꾨떎) ?쇰꺼 諛대뱶瑜??듭빱濡??????녿떎. ?듭빱??**移섏닔 ??*?닿퀬, 移섏닔媛 ?먭린\\\\r\\\\n * 援ш컙??以묒젏???볦씤?ㅻ뒗 愿怨꾨줈 異뺤쿃怨??덈꺼 ?꾩튂瑜??④퍡 ?쇰떎.\\\\r\\\\n */\\\\r\\\\nexport interface ElevationCandidate {\\\\r\\\\n  /** ??怨꾩뿴??嫄몃━??邕며탡???쒕ぉ???먮Ц). ??怨꾩뿴???щ윭 ?싥굤??怨듯넻?쇰줈 嫄몃┛??*/\\\\r\\\\n  titles: string[]\\\\r\\\\n  /** ?꾨㈃ 醫뚰몴 ?????꾩뿉???꾨옒濡?*/\\\\r\\\\n  levels: ElevationLevel[]\\\\r\\\\n  /** ?몄젒 ?덈꺼 ?ъ씠 移섏닔(mm). 湲몄씠??levels.length - 1 */\\\\r\\\\n  heightsMm: number[]\\\\r\\\\n  scalePtPerMm: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface ParsedFrameElevations {\\\\r\\\\n  elevations: ElevationCandidate[]\\\\r\\\\n  issues: ElevationIssue[]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 痍⑥엯???듭㎏濡?嫄곕????ъ쑀. ?대븣 旅덁뻑? ?먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\\\\r\\\\nexport const PLAN_APPLY_REFUSALS = [\\\\r\\\\n  '?롦쑋?뉐츣',\\\\r\\\\n  '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\\\\r\\\\n] as const\\\\r\\\\n\\\\r\\\\nexport type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\\\\r\\\\n\\\\r\\\\n/** 遺???섎굹瑜??ｌ? 紐삵븳 ?ъ쑀. 吏?대궡???????肄붾뱶濡??④릿??*/\\\\r\\\\nexport const PLAN_APPLY_SKIPS = [\\\\n  '??씊?ょ쇉??,\\\\n  '?ⓩ쓲葉?닪?면걬',\\\\n  '?쇔춴鸚?,\\\\n  '??씊筽뉑빊屋꿨퐪',\\\\n] as const\\\\n\\\\r\\\\nexport type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\\\\r\\\\n\\\\r\\\\n/** ?롩쳵 痍⑥엯???듭㎏濡?嫄곕????ъ쑀. ?대븣 旅덁뻑? ?먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\\\\r\\\\nexport const ELEVATION_APPLY_REFUSALS = [\\\\r\\\\n  '?롧칱?꿜툖閭?,\\\\r\\\\n  '?ⓩ쓲?귙굤?롧쉰?쎽툖??,\\\\r\\\\n] as const\\\\r\\\\n\\\\r\\\\nexport type ElevationApplyRefusal =\\\\r\\\\n  (typeof ELEVATION_APPLY_REFUSALS)[number]\\\\r\\\\n\\\\r\\\\nimport type { Member, MemberKind, Section } from '@/domain/model/member'\\\\r\\\\nimport type { Grid, Project, Story } from '@/domain/model/project'\\\\r\\\\n\\\\r\\\\nimport type {\\\\r\\\\n  ElevationApplyRefusal,\\\\r\\\\n  ElevationCandidate,\\\\r\\\\n  PlanApplyRefusal,\\\\r\\\\n  PlanApplySkip,\\\\r\\\\n  PlanBlock,\\\\r\\\\n  PlanPlacementRole,\\\\r\\\\n  MemberPlacement,\\\\r\\\\n} from './types'\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 鴉뤷쎋?먯꽌 ?쎌? ?뺤긽??旅덁뻑??諛섏쁺?쒕떎 (ADR-030).\\\\r\\\\n *\\\\r\\\\n * ??씊?ゃ궧??痍⑥엯(ADR-018)怨?媛숈? ?먮━???좊떎 ???ъ슜?먭? ?뱀씤???ㅼ뿉留?遺덈━怨?\\\\r\\\\n * 諛섏쁺?섏? 紐삵븳 寃껋? 吏?대궡吏 ?딄퀬 ?ъ쑀? ?④퍡 ?뚮젮以??\\\\r\\\\n */\\\\r\\\\n\\\\r\\\\n/** 葉?닪???볦씪 ???덈뒗 ?먮━. 議곕Ц???꾨땲???뺤긽???뺤쓽??*/\\\\r\\\\nconst ROLE_FOR_KIND: Record<MemberKind, PlanPlacementRole> = {\\\\r\\\\n  ?? '?쇔춴??,\\\\r\\\\n  鸚㎪쥈: '渦?,\\\\r\\\\n  ?먬쐡鶯? '渦?,\\\\r\\\\n  佯딀씮: '?쇻궎',\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface PlanApplyOptions {\\\\n  block: PlanBlock\\\\n  storyId: string\\\\n  /**\\\\n   * ?대뒓 ?롮쓽 ??씊???몄? ????씊?ゃ궧???먮Ц 洹몃?濡?`2??쨌`6F`). ?щ엺??怨좊Ⅸ??\\\\n   * undefined???뚭퀬瑜댁? ?딆븯?ㅳ띿씠吏 ?똲toryLabel???녿뒗 ??씊?띿씠 ?꾨땲??\\\\n   */\\\\n  sectionStoryLabel?: string\\\\n  /**\\\\n   * ?싥굤??씠 諛붾????ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━怨?吏꾪뻾?쒕떎. 湲곕낯? false?닿퀬,\\\\r\\\\n   * ?붾㈃? 嫄곕?瑜???踰?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 ??議곗슜??湲곕낯媛믪쑝濡?\\\\n   * ?먮㈃ ?ъ슜?먭? 紐⑤Ⅴ???ъ씠???ㅻⅨ 痢듭씠 ?щ씪吏꾨떎\\\\r\\\\n   */\\\\r\\\\n  discardOtherStories?: boolean\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface PlanApplyResult {\\\\r\\\\n  project: Project\\\\r\\\\n  /** 諛섏쁺??遺????*/\\\\r\\\\n  applied: number\\\\r\\\\n  /** 諛섏쁺?섏? 紐삵븳 遺?몄? ?ъ쑀 ???먮Ц ?? 媛숈? 遺?멸? ?щ윭 踰?嫄몃━硫??щ윭 踰?*/\\\\r\\\\n  skipped: Array<{ mark: string; reason: PlanApplySkip }>\\\\r\\\\n  /** ?듭㎏濡?嫄곕????ъ쑀. ?덉쑝硫?project???먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\\\\r\\\\n  refusal?: PlanApplyRefusal\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction gridOf(block: PlanBlock): Grid {\\\\r\\\\n  const { xGrid, yGrid } = block\\\\r\\\\n  return {\\\\r\\\\n    xSpans: [...xGrid.spansMm],\\\\r\\\\n    ySpans: [...yGrid.spansMm],\\\\r\\\\n    // ?싥굤??쓽 ?대쫫? ?꾨㈃???덈뒗 寃껋씠怨? ?닿쾬???덉뼱???똜3塋?폀Y4塋?띿쿂??\\\\n    // 醫뚯슦媛 ?ㅻⅨ ??씊?ゃ궧?덈? ?곗쓽 ?ㅼ젣 諛⑺뼢怨?留욎텧 ???덈떎 (R13???좉껐 議곌굔)\\\\r\\\\n    xLabels: xGrid.axes.map((axis) => axis.label),\\\\r\\\\n    yLabels: yGrid.axes.map((axis) => axis.label),\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * ?ㅽ뙩留?蹂몃떎 ???쇰꺼? ?곈뇧??寃⑹옄 index??諛붽씀吏 ?딆쑝誘濡? ?대쫫留??щ씪吏?\\\\n * 洹몃━?쒕? ?뚮컮?뚯뿀?ㅳ띾줈 蹂대㈃ ?ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━?쇰뒗 臾쇱쓬???댁쑀 ?놁씠 ?щ떎.\\\\r\\\\n */\\\\r\\\\nfunction sameGrid(left: Grid, right: Grid): boolean {\\\\r\\\\n  return (\\\\r\\\\n    left.xSpans.length === right.xSpans.length &&\\\\r\\\\n    left.ySpans.length === right.ySpans.length &&\\\\r\\\\n    left.xSpans.every((span, i) => span === right.xSpans[i]) &&\\\\r\\\\n    left.ySpans.every((span, i) => span === right.ySpans[i])\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction positionOf(placement: MemberPlacement) {\\\\r\\\\n  return placement.role === '渦?\\\\r\\\\n    ? { axis: placement.axis, ix: placement.ix, iy: placement.iy }\\\\r\\\\n    : { ix: placement.ix, iy: placement.iy }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 諛곗튂媛 寃⑹옄 ?덉쓣 媛由ы궎?붽?. 渦븐? 遺?ш? 六쀫뒗 履쎌쑝濡???移????꾩슂?섍퀬,\\\\r\\\\n * ?쇻궎???먯젏 履?寃⑹옄?먯씠誘濡??묒そ?쇰줈 ??移몄뵫 ?⑥븘???쒕떎.\\\\r\\\\n */\\\\r\\\\nfunction withinGrid(placement: MemberPlacement, grid: Grid): boolean {\\\\r\\\\n  const nx = grid.xSpans.length + 1\\\\r\\\\n  const ny = grid.ySpans.length + 1\\\\r\\\\n  const lastIx =\\\\r\\\\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'X')\\\\r\\\\n      ? nx - 2\\\\r\\\\n      : nx - 1\\\\r\\\\n  const lastIy =\\\\r\\\\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'Y')\\\\r\\\\n      ? ny - 2\\\\r\\\\n      : ny - 1\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    placement.ix >= 0 &&\\\\r\\\\n    placement.ix <= lastIx &&\\\\r\\\\n    placement.iy >= 0 &&\\\\r\\\\n    placement.iy <= lastIy\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function applyFramingPlan(\\\\n  project: Project,\\\\n  {\\\\n    block,\\\\n    storyId,\\\\n    sectionStoryLabel,\\\\n    discardOtherStories = false,\\\\n  }: PlanApplyOptions,\\\\n): PlanApplyResult {\\\\n  if (!project.stories.some((story) => story.id === storyId)) {\\\\r\\\\n    return { project, applied: 0, skipped: [], refusal: '?롦쑋?뉐츣' }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const grid = gridOf(block)\\\\r\\\\n  const changesGrid = !sameGrid(project.grid, grid)\\\\r\\\\n  const otherStoryMembers = project.members.some(\\\\r\\\\n    (member) => member.storyId !== storyId,\\\\r\\\\n  )\\\\r\\\\n  // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽 遺?ш?\\\\r\\\\n  // 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫??뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠\\\\r\\\\n  // ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?대뒓 履쎌쓣 踰꾨┫吏???ъ슜?먭? ?뺥븳??\\\\n  if (changesGrid && otherStoryMembers && !discardOtherStories) {\\\\r\\\\n    return {\\\\r\\\\n      project,\\\\r\\\\n      applied: 0,\\\\r\\\\n      skipped: [],\\\\r\\\\n      refusal: '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const sections = new Map<string, Section[]>()\\\\n  for (const section of project.sections) {\\\\n    const candidates = sections.get(section.mark)\\\\n    if (candidates) candidates.push(section)\\\\n    else sections.set(section.mark, [section])\\\\n  }\\\\n\\\\r\\\\n  const members: Member[] = []\\\\r\\\\n  const skipped: PlanApplyResult['skipped'] = []\\\\n  for (const placement of block.placements) {\\\\n    const candidates = (sections.get(placement.mark) ?? []).filter(\\\\n      (section) =>\\\\n        sectionStoryLabel === undefined ||\\\\n        section.storyLabel === sectionStoryLabel,\\\\n    )\\\\n    if (candidates.length === 0) {\\\\n      skipped.push({ mark: placement.mark, reason: '??씊?ょ쇉?? })\\\\n      continue\\\\n    }\\\\n    if (candidates.length > 1) {\\\\n      skipped.push({ mark: placement.mark, reason: '??씊筽뉑빊屋꿨퐪' })\\\\n      continue\\\\n    }\\\\n    const section = candidates[0]\\\\n    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\\\\n      skipped.push({ mark: placement.mark, reason: '?ⓩ쓲葉?닪?면걬' })\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n    if (!withinGrid(placement, grid)) {\\\\r\\\\n      skipped.push({ mark: placement.mark, reason: '?쇔춴鸚? })\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    members.push({\\\\r\\\\n      // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎. 媛숈? ?먮━??媛숈? 寧?뤇??\\\\n      // ??踰?諛섏쁺?대룄 ?섎굹濡??묓엳?꾨줉 ?먮━瑜?id???ｋ뒗??\\\\n      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}${placement.role === '渦? ? `-${placement.axis}` : ''}`,\\\\r\\\\n      kind: section.kind,\\\\r\\\\n      memberClass: '翁?퐪',\\\\r\\\\n      sectionId: section.id,\\\\r\\\\n      storyId,\\\\r\\\\n      position: positionOf(placement),\\\\r\\\\n    })\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const deduped = new Map<string, Member>()\\\\r\\\\n  for (const member of members) deduped.set(member.id, member)\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    project: {\\\\r\\\\n      ...project,\\\\r\\\\n      grid,\\\\r\\\\n      // 痍⑥엯?섎뒗 痢듭? 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딆븘???섍퀬, ?꾨㈃?먯꽌\\\\r\\\\n      // ?щ씪吏?遺?ш? 旅덁뻑???⑥븘 ?덉쑝硫?洹멸쾬???뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠??\\\\n      members: [\\\\r\\\\n        // ?듐굤??씠 諛붾뚮㈃ ?⑥? 遺?ъ쓽 index媛 ?ㅻⅨ ?먮━瑜?媛由ы궎寃??섎?濡?\\\\r\\\\n        // ?숈쓽瑜?諛쏆븯???뚮뒗 ?④린吏 ?딄퀬 ?꾨? 踰꾨┛????諛섏? ??꺼 ?볥뒓??鍮꾩슫??\\\\n        ...(changesGrid && discardOtherStories\\\\r\\\\n          ? []\\\\r\\\\n          : project.members.filter((member) => member.storyId !== storyId)),\\\\r\\\\n        ...deduped.values(),\\\\r\\\\n      ],\\\\r\\\\n    },\\\\r\\\\n    applied: deduped.size,\\\\r\\\\n    skipped,\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface ElevationApplyOptions {\\\\r\\\\n  candidate: ElevationCandidate\\\\r\\\\n  /**\\\\r\\\\n   * ?롮쓽 寃쎄퀎濡????덈꺼??踰붿쐞. index??**?꾨㈃ ?쒖꽌**(?꾩뿉???꾨옒)??\\\\r\\\\n   * ????top)??理쒖긽?롮쓽 泥쒖옣, ?꾨옒 ??bottom)??理쒗븯?롮쓽 諛붾떏???쒕떎 ??\\\\n   * ?묆꺀?싥긿??泥쒕떒?대굹 ?븀쨴訝뗧ク泥섎읆 ?롪? ?꾨땶 ?덈꺼? 踰붿쐞 諛뽰뿉 ?붾떎.\\\\r\\\\n   */\\\\r\\\\n  topLevelIndex: number\\\\r\\\\n  bottomLevelIndex: number\\\\r\\\\n  /** ?롫? 媛덈㈃ 遺?ш? 媛?怨녹쓣 ?껊뒗?? ?붾㈃? 嫄곕?瑜?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 */\\\\r\\\\n  discardMembers?: boolean\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface ElevationApplyResult {\\\\r\\\\n  project: Project\\\\r\\\\n  /** 留뚮뱺 ????*/\\\\r\\\\n  applied: number\\\\r\\\\n  refusal?: ElevationApplyRefusal\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 邕며탡?녹뿉???쎌? ?믪씠瑜?旅덁뻑???롫줈 諛섏쁺?쒕떎 (ADR-030).\\\\r\\\\n *\\\\r\\\\n * ?뚯뼱???덈꺼???롮쓽 寃쎄퀎?멸??띾뒗 ?뚯꽌媛 ?뺥븯吏 ?딆쑝誘濡?FL쨌GL쨌?븀쨴訝뗧ク쨌RCL??\\\\n * ?욎뿬 ?덈떎) ?ш린???ъ슜?먯쓽 ?좏깮??諛쏅뒗?? ?롮쓽 ?대쫫??吏?대궡吏 ?딄퀬 洹??롮쓽\\\\r\\\\n * **諛붾떏???섎뒗 ?덈꺼???먮Ц**??洹몃?濡??대떎 ??媛숈? ?믪씠???쇰꺼???섏씠硫?????\\\\n *