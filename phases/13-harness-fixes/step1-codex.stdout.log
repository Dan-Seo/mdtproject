\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst section: ColumnSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: 'section-C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: 'C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  d: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: { size: 'D25', count: 12 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hoop: { size: 'D13', pitch: 100 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst story: Story = { id: '1F', name: '1階', height: 4200 }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction input(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  overrides: Partial<ColumnRebarInput> = {},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): ColumnRebarInput {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    member,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    section,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    story,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    beamDepthAbove: 750,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 既定は「下は継手・上は定着」＝ スタック最上段の柱。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ends: { bottom: '継手', top: '定着' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ...overrides,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst mainDiameter = Number(section.main.size.replace(/^D/, ''))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst conditions = { fc: section.fc, grade: section.grade, hook: false }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst anchorage =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * mainDiameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst lap =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * mainDiameter\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst minimumCover = lookupRule(jpMlitRulePack, 'cover.minimum', {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberKind: section.kind,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  soilContact: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: section.exposure,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: section.finish,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}).value\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst fabricationAddition = lookupRule(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  {},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n).value\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst fabricationCover = minimumCover + fabricationAddition\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  generated: ReturnType<typeof generateColumnRebar>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  role: '主筋' | '帯筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const rebar = generated.find((candidate) => candidate.role === role)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  expect(rebar, `${role} should be generated`).toBeDefined()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return rebar!\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('Rebar model', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('accepts the standard 大梁 row roles', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const roles: RebarRole[] = ['上端筋', '下端筋', 'あばら筋']\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(roles).toEqual(['上端筋', '下端筋', 'あばら筋'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('generateColumnRebar', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('generates the fixed C1 input as one 主筋 row and one 帯筋 row', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(generated, '主筋')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const hoop = byRole(generated, '帯筋')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(generated).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main).toMatchObject({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      memberId: member.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      size: 'D25',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      shape: 'straight',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      closed: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      count: 12,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(hoop).toMatchObject({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      memberId: member.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      size: 'D13',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      shape: 'hoop',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      closed: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      count: 36,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('records only existing rule keys on every generated Rebar', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const knownKeys = new Set(jpMlitRulePack.entries.map(({ key }) => key))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const rebar of generated) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expect(rebar.rules.length).toBeGreaterThan(0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      for (const key of rebar.rules) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        expect(knownKeys.has(key), `${key} should exist in the rule pack`).toBe(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 端部の順（下端 → 上端）で並ぶ。既定入力は 下端 継手・上端 定着。\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(byRole(generated, '主筋').rules).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.minimum',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'lap.L1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'anchorage.L1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(byRole(generated, '帯筋').rules).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.minimum',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cover.fabrication.addition',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bend.hook135',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('counts the storey joint once instead of adding 定着 and 継手 to every storey (R7)', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const lower = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '定着', top: 'なし' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const upper = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '継手', top: '定着' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(lower.length).toBe(story.height + anchorage)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(upper.length).toBe(story.height + lap + anchorage)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 2층 스택 합계는 「기초 定着 ＋ 접합부 継手 1회 ＋ 지붕 定着」뿐이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    // 예전에는 층마다 定着＋継手가 붙어 継手 하나를 더 세고 있었다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const doubleCounted = (story.height + anchorage + lap) * 2\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(lower.length + upper.length).toBeLessThan(doubleCounted)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(doubleCounted - (lower.length + upper.length)).toBe(lap)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('anchors both ends when the column is alone in its stack', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '定着', top: '定着' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.length).toBe(story.height + 2 * anchorage)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('extends the 3D geometry by exactly what each end contributes', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const main = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      generateColumnRebar(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        input({ ends: { bottom: '継手', top: 'なし' } }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[0][1]).toBe(-lap)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(main.points[1][1]).toBe(story.height)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it.each(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ends: { bottom: '定着', top: '定着' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomKind: '定着',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomLength: anchorage,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        topAnchored: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ends: { bottom: '定着', top: 'なし' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomKind: '定着',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomLength: anchorage,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        topAnchored: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ends: { bottom: '継手', top: '定着' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomKind: '重ね継手',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomLength: lap,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        topAnchored: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ends: { bottom: '継手', top: 'なし' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomKind: '重ね継手',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bottomLength: lap,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        topAnchored: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ] satisfies {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ends: ColumnEnds\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      bottomKind: RebarZone['kind']\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      bottomLength: number\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      topAnchored: boolean\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }[],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    'emits path-distance zones for $ends.bottom/$ends.top ends',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ({ ends, bottomKind, bottomLength, topAnchored }) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const main = byRole(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        '主筋',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const expected: RebarZone[] = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          kind: bottomKind,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          pathFromMm: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          pathToMm: bottomLength,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (topAnchored) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        expected.push({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          kind: '定着',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          pathFromMm: main.length - anchorage,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          pathToMm: main.length,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expect(main.zones).toEqual(expected)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('keeps every zone within the 主筋 加工長 path', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const endCombinations: ColumnEnds[] = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { bottom: '定着', top: '定着' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { bottom: '定着', top: 'なし' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { bottom: '継手', top: '定着' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { bottom: '継手', top: 'なし' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const ends of endCombinations) {\\\\\\\\\\\