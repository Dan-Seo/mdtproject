Grid.axes[0]?.positionPt,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(xPositions).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      0, 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      parsed.blocks.map((block) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        block.placements.map((placement) => placement.mark),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toEqual([['C1'], ['C2']])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('parseFramingPlan ??X쨌Y ?싥굤??吏앹???, () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('Y ?댁씠 X ?댁쓽 ?ㅼ륫 ?ㅽ뙩??鍮꾪빐 ?덈Т 硫硫?釉붾줉??留뚮뱾吏 ?딅뒗??, () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const parsed = parseFramingPlan(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      page([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X1', 0, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X2', 200, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X3', 400, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 100, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 300, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y1', 800, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y2', 800, 200),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y3', 800, 400),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        v('6000', 820, 100),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        v('6000', 820, 300),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.blocks).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.issues).toContain('?싥굤???恙쒍툖??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('?쒕줈 ?ㅻⅨ X ???섏씠 媛숈? Y ?댁쓣 怨듭쑀?섏? ?딅뒗??, () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const parsed = parseFramingPlan(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      page([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X1', 0, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X2', 200, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X3', 400, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X1', 500, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X2', 700, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X3', 900, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 100, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 300, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 600, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 800, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y1', 450, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y2', 450, 200),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y3', 450, 400),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        v('6000', 470, 100),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        v('6000', 470, 300),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.blocks).toHaveLength(1)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.issues).toContain('?싥굤???恙쒍툖??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('理쒖냼 嫄곕━媛 媛숈? Y ?댁씠 ?섏씠硫?諛곗뿴 ?쒖꽌濡?怨좊Ⅴ吏 ?딅뒗??, () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const parsed = parseFramingPlan(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      page([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X1', 400, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X2', 600, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('X3', 800, -40),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 500, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('6000', 700, -20),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y1', 300, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        h('Y2', 300, 200),\\\\\\\\\\\\\\\\r\\\\\\\\\