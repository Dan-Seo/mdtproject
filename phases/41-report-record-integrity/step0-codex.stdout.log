\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"created_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-28T19:40:01+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/lib/import/stb/apply.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { Project } from '@/domain/model/project'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  StbGridCandidate,\\\\\\\\\\\\\\\\n  StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  Stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\u0041pplyResult,\\\\\\\\\\\\\\\\n} from './types'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameNumbers(left: number[], right: number[]): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    left.length === right.length &&\\\\\\\\\\\\\\\\n    left.every((value, index) => value === right[index])\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameStrings(\\\\\\\\\\\\\\\\n  left: string[] | undefined,\\\\\\\\\\\\\\\\n  right: string[] | undefined,\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\n  if (left === undefined || right === undefined) return left === right\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    left.length === right.length &&\\\\\\\\\\\\\\\\n    left.every((value, index) => value === right[index])\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridFor(\\\\\\\\\\\\\\\\n  grids: StbGridCandidate[],\\\\\\\\\\\\\\\\n  direction: StbGridCandidate['direction'],\\\\\\\\\\\\\\\\n): StbGridCandidate | undefined {\\\\\\\\\\\\\\\\n  const matching = grids.filter((grid) => grid.direction === direction)\\\\\\\\\\\\\\\\n  return matching.length === 1 ? matching[0] : undefined\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridValue(\\\\\\\\\\\\\\\\n  xGrid: StbGridCandidate,\\\\\\\\\\\\\\\\n  yGrid: StbGridCandidate,\\\\\\\\\\\\\\\\n): Project['grid'] {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    xSpans: [...xGrid.spansMm],\\\\\\\\\\\\\\\\n    ySpans: [...yGrid.spansMm],\\\\\\\\\\\\\\\\n    xLabels: xGrid.axes.map(({ label }) => label),\\\\\\\\\\\\\\\\n    yLabels: yGrid.axes.map(({ label }) => label),\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameGridSpans(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  nextGrid: Project['grid'],\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    sameNumbers(project.grid.xSpans, nextGrid.xSpans) &&\\\\\\\\\\\\\\\\n    sameNumbers(project.grid.ySpans, nextGrid.ySpans)\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameGrid(project: Project, nextGrid: Project['grid']): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    sameGridSpans(project, nextGrid) &&\\\\\\\\\\\\\\\\n    sameStrings(project.grid.xLabels, nextGrid.xLabels) &&\\\\\\\\\\\\\\\\n    sameStrings(project.grid.yLabels, nextGrid.yLabels)\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameStories(\\\\\\\\\\\\\\\\n  left: Project['stories'],\\\\\\\\\\\\\\\\n  right: Project['stories'],\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    left.length === right.length &&\\\\\\\\\\\\\\\\n    left.every(\\\\\\\\\\\\\\\\n      (story, index) =>\\\\\\\\\\\\\\\\n        story.id === right[index]?.id &&\\\\\\\\\\\\\\\\n        story.name === right[index]?.name &&\\\\\\\\\\\\\\\\n        story.height === right[index]?.height,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function applyStbGrid(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  options: { discardMembers?: boolean } = {},\\\\\\\\\\\\\\\\n): Stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\u0041pplyResult {\\\\\\\\\\\\\\\\n  const xGrid = gridFor(candidate.grids, 'X')\\\\\\\\\\\\\\\\n  const yGrid = gridFor(candidate.grids, 'Y')\\\\\\\\\\\\\\\\n  if (xGrid === undefined || yGrid === undefined) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '通り芯候補なし',\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const nextGrid = gridValue(xGrid, yGrid)\\\\\\\\\\\\\\\\n  const spansMatch = sameGridSpans(project, nextGrid)\\\\\\\\\\\\\\\\n  if (sameGrid(project, nextGrid)) {\\\\\\\\\\\\\\\\n    return { project, applied: false }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\n    !spansMatch &&\\\\\\\\\\\\\\\\n    project.members.length > 0 &&\\\\\\\\\\\\\\\\n    options.discardMembers !== true\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '部材あり通り芯置換不可',\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    project: {\\\\\\\\\\\\\\\\n      ...project,\\\\\\\\\\\\\\\\n      grid: nextGrid,\\\\\\\\\\\\\\\\n      ...(spansMatch ? {} : { members: [] }),\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n    applied: true,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function applyStbStories(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  options: { discardMembers?: boolean } = {},\\\\\\\\\\\\\\\\n): Stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\u0041pplyResult {\\\\\\\\\\\\\\\\n  if (candidate.stories.length === 0) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '階候補なし',\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (project.members.length > 0 && options.discardMembers !== true) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '部材あり階置換不可',\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const stories = candidate.stories.map((story, index) => ({\\\\\\\\\\\\\\\\n    id: `story-${index + 1}`,\\\\\\\\\\\\\\\\n    name: story.name,\\\\\\\\\\\\\\\\n    height: story.heightMm,\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (project.members.length === 0 && sameStories(project.stories, stories)) {\\\\\\\\\\\\\\\\n    return { project, applied: false }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    project: {\\\\\\\\\\\\\\\\n      ...project,\\\\\\\\\\\\\\\\n      stories,\\\\\\\\\\\\\\\\n      members: [],\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n    applied: true,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/lib/import/stb/scope-guard.test.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync, readdirSync } from 'node:fs'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { join, resolve } from 'node:path'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst stbDirectory = resolve(process.cwd(), 'src/lib/import/stb')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction nonTestTypeScriptFiles(directory: string): string[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const path = join(directory, entry.name)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (entry.isDirectory()) return nonTestTypeScriptFiles(path)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (!entry.name.endsWith('.ts') || entry.name.endsWith('.test.ts')) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return [path]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('ST-Bridge document import scope', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('keeps the IR parser free of rule, section, network, and store concerns', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const actualFiles = nonTestTypeScriptFiles(stbDirectory).sort()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const scannedFiles = actualFiles.map((file) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      file,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      source: readFileSync(file, 'utf8'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(scannedFiles.length).toBeGreaterThanOrEqual(3)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(scannedFiles.map(({ file }) => file).sort()).toEqual(actualFiles)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const forbidden = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '定着',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '重ね継手',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '折曲',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'かぶり',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'depth_cover',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'anchorage',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cut_off',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'center_',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbSec',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbApply',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbColumn',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbGirder',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbBeam',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbWall',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbSlab',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbBrace',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbPile',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbFooting',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'fetch',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'XMLHttpRequest',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'WebSocket',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'sendBeacon',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'applyFramingPlan',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'applyElevation',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'updateProject',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'loadProject',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'useAppStore',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'zustand',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'createSampleProject',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const { file, source } of scannedFiles) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      for (const term of forbidden) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        expect(source, `${file} contains forbidden term ${term}`).not.toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          term,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/lib/import/stb/candidates.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbAxisGroupRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbAxisRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbGridCandidate,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbIssue,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbSkeletonCandidate,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from './types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst AXIS_DIRECTIONS = ['X', 'Y'] as const\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ntype AxisDirection = (typeof AXIS_DIRECTIONS)[number]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst SUPPORTED_STORY_KINDS = new Set(['GENERAL', 'ROOF', 'PENTHOUSE'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction addIssue(issues: StbIssue[], issue: StbIssue): void {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!issues.includes(issue)) issues.push(issue)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction unsupportedItems(document: StbDocument): { name: string; count: number }[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [...document.unsupportedAxisKinds, ...document.unreadElements]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction normalizedAngle(angle: string | undefined):\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | { direction: AxisDirection; radians: number }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | undefined {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const value = Number(angle)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!Number.isFinite(value)) return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const normalized = ((value % 360) + 360) % 360\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const quadrant = Math.round(normalized / 90)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (Math.abs(normalized - quadrant * 90) > 0.001) return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const quadrantInCycle = quadrant % 4\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    direction:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      quadrantInCycle === 0 || quadrantInCycle === 2 ? 'Y' : 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    radians: normalized,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction originFor(group: StbAxisGroupRaw, direction: AxisDirection): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const rawOrigin = direction === 'X' ? group.originX : group.originY\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return rawOrigin === undefined ? 0 : Number(rawOrigin)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction hasNodeAtAxisCoordinate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  axis: StbAxisRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  direction: AxisDirection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  expectedCoordinate: number,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  nodesById: Map<string, { x?: string; y?: string }>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return axis.nodeIds.some((nodeId) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const node = nodesById.get(nodeId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (node === undefined) return false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const coordinate = Number(direction === 'X' ? node.x : node.y)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return Number.isFinite(coordinate) &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      Math.abs(coordinate - expectedCoordinate) <= 1\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction gridForDirection(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  group: StbAxisGroupRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  direction: AxisDirection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document: StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  issues: StbIssue[],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbGridCandidate | undefined {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const parsedAxes = group.axes.map((axis) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    axis,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    distance: Number(axis.distance),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (parsedAxes.some(({ distance }) => !Number.isFinite(distance))) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯距離解釈不能')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    group.axes.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (axis) => axis.name === undefined || axis.name.length === 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯ラベル欠落')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (parsedAxes.length < 2) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯未検出')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const sortedAxes = [...parsedAxes].sort(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (left, right) => left.distance - right.distance,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasDuplicate = sortedAxes.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (entry, index) => index > 0 && entry.distance === sortedAxes[index - 1]!.distance,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasDuplicate) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯位置重複')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const spansMm = sortedAxes.slice(1).map(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (entry, index) => entry.distance - sortedAxes[index]!.distance,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (spansMm.some((span) => span <= 0)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯位置重複')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const nodesById = new Map(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    document.nodes.flatMap((node) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      node.id === undefined ? [] : [[node.id, node] as const],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const origin = originFor(group, direction)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasMismatch = sortedAxes.some(({ axis, distance }) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (axis.nodeIds.length === 0) return false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const expectedCoordinate = origin + distance\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return !hasNodeAtAxisCoordinate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      axis,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      direction,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expectedCoordinate,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      nodesById,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasMismatch) addIssue(issues, '通り芯位置と節点の不一致')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const candidate: StbGridCandidate = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    direction,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    axes: sortedAxes.map(({ axis }) => ({ label: axis.name! })),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    spansMm,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (group.groupName !== undefined) candidate.groupName = group.groupName\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return candidate\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction gridsForDocument(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document: StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  issues: StbIssue[],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbGridCandidate[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasArcOrRadial = document.unsupportedAxisKinds.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ({ name, count }) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      count > 0 && (name === 'StbArcAxes' || name === 'StbRadialAxes'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasDrawing = document.unsupportedAxisKinds.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ({ name, count }) => count > 0 && name === 'StbDrawingAxes',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasArcOrRadial) addIssue(issues, '非直交通り芯')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasDrawing) addIssue(issues, '未対応通り芯種別')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasArcOrRadial) return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.axisGroups.length === 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯未検出')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.axisGroups.length !== 2) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯グループ数不一致')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const groupsWithDirections = document.axisGroups.map((group) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    group,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    angle: normalizedAngle(group.angle),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (groupsWithDirections.some(({ angle }) => angle === undefined)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '非直交通り芯')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const directions = groupsWithDirections.map(({ angle }) => angle!.direction)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (directions[0] === directions[1]) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '通り芯方向不明')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const grids = groupsWithDirections.flatMap(({ group, angle }) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    gridForDirection(group, angle!.direction, document, issues) ?? [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return grids.sort(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (left, right) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      AXIS_DIRECTIONS.indexOf(left.direction) -\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      AXIS_DIRECTIONS.indexOf(right.direction),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction storiesForDocument(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document: StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  issues: StbIssue[],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbSkeletonCandidate['stories'] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.stories.length === 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '階不足')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const levels = document.stories.map((story) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    story,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    height: Number(story.height),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (levels.some(({ height }) => !Number.isFinite(height))) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '階レベル解釈不能')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  let hasBasement = false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  let hasUnsupportedKind = false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (const { story, height } of levels) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (story.kind === 'BASEMENT' || height < 0) hasBasement = true\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      story.kind === undefined ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (story.kind !== 'BASEMENT' && !SUPPORTED_STORY_KINDS.has(story.kind))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hasUnsupportedKind = true\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasBasement) addIssue(issues, '地下レベル未対応')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasUnsupportedKind) addIssue(issues, '対応外の階種別')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const sortedLevels = [...levels].sort(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (left, right) => left.height - right.height,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasDuplicate = sortedLevels.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (entry, index) => index > 0 && entry.height === sortedLevels[index - 1]!.height,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasDuplicate) addIssue(issues, '階レベル重複')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (sortedLevels.length < 2) addIssue(issues, '階不足')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    document.stories.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (story) => story.name === undefined || story.name.length === 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '階レベル解釈不能')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasBasement ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasUnsupportedKind ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasDuplicate ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    sortedLevels.length < 2 ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    document.stories.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (story) => story.name === undefined || story.name.length === 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return sortedLevels.slice(0, -1).map((level, index) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    name: level.story.name!,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    heightMm: sortedLevels[index + 1]!.height - level.height,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document: StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbSkeletonCandidate {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const issues: StbIssue[] = []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const unsupported = unsupportedItems(document)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.issues.length > 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate: StbSkeletonCandidate = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      version: document.version,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grids: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      stories: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      unsupported,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      issues: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (document.projectName !== undefined) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      candidate.projectName = document.projectName\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const issue of document.issues) addIssue(candidate.issues, issue)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return candidate\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const grids = gridsForDocument(document, issues)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const stories = storiesForDocument(document, issues)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const candidate: StbSkeletonCandidate = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    version: document.version,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    grids,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    stories,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    unsupported,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    issues,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.projectName !== undefined) candidate.projectName = document.projectName\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return candidate\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/components/stb/StbImport.tsx\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n'use client'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { useRef, useState, type ChangeEvent } from 'react'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { decodeStbBytes } from '@/lib/import/stb/decode'\\\\\\\\\\\\\\\\nimport { parseStbDocument } from '@/lib/import/stb/document'\\\\\\\\\\\\\\\\nimport { toSkeletonCandidate } from '@/lib/import/stb/candidates'\\\\\\\\\\\\\\\\nimport { applyStbGrid, applyStbStories } from '@/lib/import/stb/apply'\\\\\\\\\\\\\\\\nimport type { StbGridCandidate, StbSkeletonCandidate } from '@/lib/import/stb/types'\\\\\\\\\\\\\\\\nimport { t } from '@/lib/i18n'\\\\\\\\\\\\\\\\nimport { useAppStore } from '@/lib/store'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport styles from './StbImport.module.css'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface StbImportProps {\\\\\\\\\\\\\\\\n  /** 테스트에서 파일 해석을 건너뛰고 후보를 직접 넣는 컴포넌트 테스트용 경계. */\\\\\\\\\\\\\\\\n  initialCandidate?: StbSkeletonCandidate\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ntype GridApplyResult = ReturnType<typeof applyStbGrid>\\\\\\\\\\\\\\\\ntype StoriesApplyResult = ReturnType<typeof applyStbStories>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction GridCandidate({\\\\\\\\\\\\\\\\n  candidate,\\\\\\\\\\\\\\\\n  locale,\\\\\\\\\\\\\\\\n}: {\\\\\\\\\\\\\\\\n  candidate: StbGridCandidate\\\\\\\\\\\\\\\\n  locale: 'ja' | 'ko'\\\\\\\\\\\\\\\\n}) {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    <div className={styles.group} data-testid={`stb-import-grid-${candidate.direction}`}>\\\\\\\\\\\\\\\\n      <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n        {t(\\\\\\\\\\\\\\\\n          locale,\\\\\\\\\\\\\\\\n          candidate.direction === 'X' ? 'stbImport.gridX' : 'stbImport.gridY',\\\\\\\\\\\\\\\\n        )}\\\\\\\\\\\\\\\\n      </h4>\\\\\\\\\\\\\\\\n      <p className={styles.axes}>\\\\\\\\\\\\\\\\n        {candidate.axes.map((axis, index) => (\\\\\\\\\\\\\\\\n          <span key={`${axis.label}-${index}`}>\\\\\\\\\\\\\\\\n            <span className={styles.axis}>{axis.label}</span>\\\\\\\\\\\\\\\\n            {index < candidate.spansMm.length ? (\\\\\\\\\\\\\\\\n              <span className={styles.span}>\\\\\\\\\\\\\\\\n                {` — ${candidate.spansMm[index]} — `}\\\\\\\\\\\\\\\\n              </span>\\\\\\\\\\\\\\\\n            ) : null}\\\\\\\\\\\\\\\\n          </span>\\\\\\\\\\\\\\\\n        ))}\\\\\\\\\\\\\\\\n      </p>\\\\\\\\\\\\\\\\n    </div>\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction ApplyResult({\\\\\\\\\\\\\\\\n  result,\\\\\\\\\\\\\\\\n  locale,\\\\\\\\\\\\\\\\n  successKey,\\\\\\\\\\\\\\\\n  count,\\\\\\\\\\\\\\\\n  testId,\\\\\\\\\\\\\\\\n}: {\\\\\\\\\\\\\\\\n  result: GridApplyResult | StoriesApplyResult | null\\\\\\\\\\\\\\\\n  locale: 'ja' | 'ko'\\\\\\\\\\\\\\\\n  successKey: 'stbImport.appliedGrid' | 'stbImport.appliedStories'\\\\\\\\\\\\\\\\n  count: number\\\\\\\\\\\\\\\\n  testId: string\\\\\\\\\\\\\\\\n}) {\\\\\\\\\\\\\\\\n  if (!result) return null\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    <p className={styles.result} data-testid={testId}>\\\\\\\\\\\\\\\\n      {result.refusal\\\\\\\\\\\\\\\\n        ? t(locale, `stbImport.refusal.${result.refusal}`)\\\\\\\\\\\\\\\\n        : `${t(locale, successKey)}: ${count}`}\\\\\\\\\\\\\\\\n    </p>\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function StbImport({ initialCandidate }: StbImportProps) {\\\\\\\\\\\\\\\\n  const locale = useAppStore(({ locale }) => locale)\\\\\\\\\\\\\\\\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\\\\\\\\\\\\\\\\n  const inputRef = useRef<HTMLInputElement>(null)\\\\\\\\\\\\\\\\n  const [candidate, setCandidate] = useState<StbSkeletonCandidate | null>(\\\\\\\\\\\\\\\\n    initialCandidate ?? null,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const [open, setOpen] = useState(initialCandidate !== undefined)\\\\\\\\\\\\\\\\n  const [loading, setLoading] = useState(false)\\\\\\\\\\\\\\\\n  const [failed, setFailed] = useState(false)\\\\\\\\\\\\\\\\n  const [gridResult, setGridResult] = useState<GridApplyResult | null>(null)\\\\\\\\\\\\\\\\n  const [storiesResult, setStoriesResult] = useState<StoriesApplyResult | null>(\\\\\\\\\\\\\\\\n    null,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const [discardGridMembers, setDiscardGridMembers] = useState(false)\\\\\\\\\\\\\\\\n  const [discardStoryMembers, setDiscardStoryMembers] = useState(false)\\\\\\\\\\\\\\\\n  const requestRef = useRef(0)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\\\\\\\\\\\\\\\\n    const input = event.currentTarget\\\\\\\\\\\\\\\\n    const file = input.files?.[0]\\\\\\\\\\\\\\\\n    if (!file) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    const requestId = ++requestRef.current\\\\\\\\\\\\\\\\n    setOpen(true)\\\\\\\\\\\\\\\\n    setLoading(true)\\\\\\\\\\\\\\\\n    setFailed(false)\\\\\\\\\\\\\\\\n    setCandidate(null)\\\\\\\\\\\\\\\\n    setGridResult(null)\\\\\\\\\\\\\\\\n    setStoriesResult(null)\\\\\\\\\\\\\\\\n    setDiscardGridMembers(false)\\\\\\\\\\\\\\\\n    setDiscardStoryMembers(false)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    try {\\\\\\\\\\\\\\\\n      const decoded = decodeStbBytes(await file.arrayBuffer())\\\\\\\\\\\\\\\\n      if (requestRef.current !== requestId) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      if (!decoded.ok) {\\\\\\\\\\\\\\\\n        setCandidate({\\\\\\\\\\\\\\\\n          version: '—',\\\\\\\\\\\\\\\\n          grids: [],\\\\\\\\\\\\\\\\n          stories: [],\\\\\\\\\\\\\\\\n          unsupported: [],\\\\\\\\\\\\\\\\n          issues: [decoded.issue],\\\\\\\\\\\\\\\\n        })\\\\\\\\\\\\\\\\n      } else {\\\\\\\\\\\\\\\\n        const document = parseStbDocument(decoded.text, decoded.encoding)\\\\\\\\\\\\\\\\n        setCandidate(toSkeletonCandidate(document))\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    } catch {\\\\\\\\\\\\\\\\n      if (requestRef.current !== requestId) return\\\\\\\\\\\\\\\\n      setCandidate(null)\\\\\\\\\\\\\\\\n      setFailed(true)\\\\\\\\\\\\\\\\n    } finally {\\\\\\\\\\\\\\\\n      if (requestRef.current === requestId) setLoading(false)\\\\\\\\\\\\\\\\n      input.value = ''\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const applyGrid = () => {\\\\\\\\\\\\\\\\n    if (!candidate) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    let next: GridApplyResult | undefined\\\\\\\\\\\\\\\\n    updateProject((project) => {\\\\\\\\\\\\\\\\n      next = applyStbGrid(project, candidate, {\\\\\\\\\\\\\\\\n        discardMembers: discardGridMembers,\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\n      return next.project\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    if (next) setGridResult(next)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const applyStories = () => {\\\\\\\\\\\\\\\\n    if (!candidate) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    let next: StoriesApplyResult | undefined\\\\\\\\\\\\\\\\n    updateProject((project) => {\\\\\\\\\\\\\\\\n      next = applyStbStories(project, candidate, {\\\\\\\\\\\\\\\\n        discardMembers: discardStoryMembers,\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\n      return next.project\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    if (next) setStoriesResult(next)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const hasGridCandidate =\\\\\\\\\\\\\\\\n    candidate?.grids.filter(({ direction }) => direction === 'X').length === 1 &&\\\\\\\\\\\\\\\\n    candidate.grids.filter(({ direction }) => direction === 'Y').length === 1\\\\\\\\\\\\\\\\n  const hasStoryCandidate = candidate !== null && candidate.stories.length > 0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    <div className={styles.control}>\\\\\\\\\\\\\\\\n      <button\\\\\\\\\\\\\\\\n        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        className={styles.openButton}\\\\\\\\\\\\\\\\n        onClick={() => {\\\\\\\\\\\\\\\\n          if (candidate) setOpen(true)\\\\\\\\\\\\\\\\n          else inputRef.current?.click()\\\\\\\\\\\\\\\\n        }}\\\\\\\\\\\\\\\\n      >\\\\\\\\\\\\\\\\n        {t(locale, 'stbImport.open')}\\\\\\\\\\\\\\\\n      </button>\\\\\\\\\\\\\\\\n      <input\\\\\\\\\\\\\\\\n        ref={inputRef}\\\\\\\\\\\\\\\\n        className={styles.fileInput}\\\\\\\\\\\\\\\\n        data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        accept=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        aria-label={t(locale, 'stbImport.file')}\\\\\\\\\\\\\\\\n        onChange={(event) => void selectFile(event)}\\\\\\\\\\\\\\\\n      />\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      {open ? (\\\\\\\\\\\\\\\\n        <section\\\\\\\\\\\\\\\\n          className={styles.panel}\\\\\\\\\\\\\\\\n          role=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"dialog\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n          aria-modal=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"false\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n          aria-labelledby=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-title\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        >\\\\\\\\\\\\\\\\n          <header className={styles.panelHeader}>\\\\\\\\\\\\\\\\n            <h3 id=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-title\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-title\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n              {t(locale, 'stbImport.title')}\\\\\\\\\\\\\\\\n            </h3>\\\\\\\\\\\\\\\\n            <div className={styles.panelActions}>\\\\\\\\\\\\\\\\n              <button\\\\\\\\\\\\\\\\n                type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                className={styles.chooseButton}\\\\\\\\\\\\\\\\n                onClick={() => inputRef.current?.click()}\\\\\\\\\\\\\\\\n              >\\\\\\\\\\\\\\\\n                {t(locale, 'stbImport.chooseAnother')}\\\\\\\\\\\\\\\\n              </button>\\\\\\\\\\\\\\\\n              <button\\\\\\\\\\\\\\\\n                type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                className={styles.closeButton}\\\\\\\\\\\\\\\\n                onClick={() => setOpen(false)}\\\\\\\\\\\\\\\\n              >\\\\\\\\\\\\\\\\n                {t(locale, 'stbImport.close')}\\\\\\\\\\\\\\\\n              </button>\\\\\\\\\\\\\\\\n            </div>\\\\\\\\\\\\\\\\n          </header>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n          <div className={styles.panelBody}>\\\\\\\\\\\\\\\\n            {loading ? (\\\\\\\\\\\\\\\\n              <p role=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">{t(locale, 'stbImport.loading')}</p>\\\\\\\\\\\\\\\\n            ) : failed ? (\\\\\\\\\\\\\\\\n              <p role=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"alert\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">{t(locale, 'stbImport.error')}</p>\\\\\\\\\\\\\\\\n            ) : candidate ? (\\\\\\\\\\\\\\\\n              <>\\\\\\\\\\\\\\\\n                <div className={styles.metadata}>\\\\\\\\\\\\\\\\n                  <span data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-version\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                    {`${t(locale, 'stbImport.version')}: ${candidate.version}`}\\\\\\\\\\\\\\\\n                  </span>\\\\\\\\\\\\\\\\n                  {candidate.projectName !== undefined ? (\\\\\\\\\\\\\\\\n                    <span data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-project-name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                      {`${t(locale, 'stbImport.projectName')}: ${candidate.projectName}`}\\\\\\\\\\\\\\\\n                    </span>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                </div>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                {candidate.issues.length > 0 ? (\\\\\\\\\\\\\\\\n                  <section className={styles.group} data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-issues\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                    <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.issues')}\\\\\\\\\\\\\\\\n                    </h4>\\\\\\\\\\\\\\\\n                    <ul className={styles.issues}>\\\\\\\\\\\\\\\\n                      {[...new Set(candidate.issues)].map((issue) => (\\\\\\\\\\\\\\\\n                        <li key={issue}>{t(locale, `stbImport.issue.${issue}`)}</li>\\\\\\\\\\\\\\\\n                      ))}\\\\\\\\\\\\\\\\n                    </ul>\\\\\\\\\\\\\\\\n                  </section>\\\\\\\\\\\\\\\\n                ) : null}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                <section className={styles.group}>\\\\\\\\\\\\\\\\n                  <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                    {t(locale, 'stbImport.grids')}\\\\\\\\\\\\\\\\n                  </h4>\\\\\\\\\\\\\\\\n                  {candidate.grids.map((grid, index) => (\\\\\\\\\\\\\\\\n                    <GridCandidate\\\\\\\\\\\\\\\\n                      key={`${grid.direction}-${index}`}\\\\\\\\\\\\\\\\n                      candidate={grid}\\\\\\\\\\\\\\\\n                      locale={locale}\\\\\\\\\\\\\\\\n                    />\\\\\\\\\\\\\\\\n                  ))}\\\\\\\\\\\\\\\\n                  {hasGridCandidate ? (\\\\\\\\\\\\\\\\n                    <button\\\\\\\\\\\\\\\\n                      type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      className={styles.applyButton}\\\\\\\\\\\\\\\\n                      data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-apply-grid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      onClick={applyGrid}\\\\\\\\\\\\\\\\n                    >\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.applyGrid')}\\\\\\\\\\\\\\\\n                    </button>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  {gridResult?.refusal === '部材あり通り芯置換不可' ? (\\\\\\\\\\\\\\\\n                    <label className={styles.discardOption}>\\\\\\\\\\\\\\\\n                      <input\\\\\\\\\\\\\\\\n                        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"checkbox\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-discard-grid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        checked={discardGridMembers}\\\\\\\\\\\\\\\\n                        onChange={(event) =>\\\\\\\\\\\\\\\\n                          setDiscardGridMembers(event.target.checked)\\\\\\\\\\\\\\\\n                        }\\\\\\\\\\\\\\\\n                      />\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.discardMembersGrid')}\\\\\\\\\\\\\\\\n                    </label>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  <ApplyResult\\\\\\\\\\\\\\\\n                    result={gridResult}\\\\\\\\\\\\\\\\n                    locale={locale}\\\\\\\\\\\\\\\\n                    successKey=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stbImport.appliedGrid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                    count={candidate.grids.length}\\\\\\\\\\\\\\\\n                    testId=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-grid-result\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                  />\\\\\\\\\\\\\\\\n                </section>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                <section className={styles.group} data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-stories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                  <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                    {t(locale, 'stbImport.stories')}\\\\\\\\\\\\\\\\n                  </h4>\\\\\\\\\\\\\\\\n                  {candidate.stories.length > 0 ? (\\\\\\\\\\\\\\\\n                    <ul className={styles.storyList}>\\\\\\\\\\\\\\\\n                      {candidate.stories.map((story, index) => (\\\\\\\\\\\\\\\\n                        <li key={`${story.name}-${index}`}>\\\\\\\\\\\\\\\\n                          <span className={styles.axis}>{story.name}</span>\\\\\\\\\\\\\\\\n                          <span className={styles.span}>\\\\\\\\\\\\\\\\n                            {` — ${story.heightMm} ${t(locale, 'stbImport.height')} — `}\\\\\\\\\\\\\\\\n                          </span>\\\\\\\\\\\\\\\\n                        </li>\\\\\\\\\\\\\\\\n                      ))}\\\\\\\\\\\\\\\\n                    </ul>\\\\\\\\\\\\\\\\n                  ) : (\\\\\\\\\\\\\\\\n                    <p className={styles.muted}>{t(locale, 'stbImport.none')}</p>\\\\\\\\\\\\\\\\n                  )}\\\\\\\\\\\\\\\\n                  {hasStoryCandidate ? (\\\\\\\\\\\\\\\\n                    <button\\\\\\\\\\\\\\\\n                      type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      className={styles.applyButton}\\\\\\\\\\\\\\\\n                      data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-apply-stories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      onClick={applyStories}\\\\\\\\\\\\\\\\n                    >\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.applyStories')}\\\\\\\\\\\\\\\\n                    </button>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  {storiesResult?.refusal === '部材あり階置換不可' ? (\\\\\\\\\\\\\\\\n                    <label className={styles.discardOption}>\\\\\\\\\\\\\\\\n                      <input\\\\\\\\\\\\\\\\n                        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"checkbox\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-discard-stories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        checked={discardStoryMembers}\\\\\\\\\\\\\\\\n                        onChange={(event) =>\\\\\\\\\\\\\\\\n                          setDiscardStoryMembers(event.target.checked)\\\\\\\\\\\\\\\\n                        }\\\\\\\\\\\\\\\\n                      />\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.discardMembersStories')}\\\\\\\\\\\\\\\\n                    </label>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  <ApplyResult\\\\\\\\\\\\\\\\n                    result={storiesResult}\\\\\\\\\\\\\\\\n                    locale={locale}\\\\\\\\\\\\\\\\n                    successKey=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stbImport.appliedStories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                    count={candidate.stories.length}\\\\\\\\\\\\\\\\n                    testId=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-stories-result\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                  />\\\\\\\\\\\\\\\\n                </section>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                <section className={styles.group} data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-unsupported\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                  <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                    {`${t(locale, 'stbImport.unsupported')} (${candidate.unsupported.length})`}\\\\\\\\\\\\\\\\n                  </h4>\\\\\\\\\\\\\\\\n                  {candidate.unsupported.length > 0 ? (\\\\\\\\\\\\\\\\n                    <ul className={styles.issues}>\\\\\\\\\\\\\\\\n                      {candidate.unsupported.map(({ name, count }, index) => (\\\\\\\\\\\\\\\\n                        <li key={`${name}-${index}`}>{`${name}: ${count}`}</li>\\\\\\\\\\\\\\\\n                      ))}\\\\\\\\\\\\\\\\n                    </ul>\\\\\\\\\\\\\\\\n                  ) : (\\\\\\\\\\\\\\\\n                    <p className={styles.muted}>{t(locale, 'stbImport.none')}</p>\\\\\\\\\\\\\\\\n                  )}\\\\\\\\\\\\\\\\n                </section>\\\\\\\\\\\\\\\\n              </>\\\\\\\\\\\\\\\\n            ) : null}\\\\\\\\\\\\\\\\n          </div>\\\\\\\\\\\\\\\\n        </section>\\\\\\\\\\\\\\\\n      ) : null}\\\\\\\\\\\\\\\\n    </div>\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- tests/stb-import/apply.test.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync } from 'node:fs'\\\\\\\\\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { toSkeletonCandidate } from '@/lib/import/stb/candidates'\\\\\\\\\\\\\\\\nimport { applyStbGrid, applyStbStories } from '@/lib/import/stb/apply'\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  StbApplyRefusal,\\\\\\\\\\\\\\\\n  StbApplyResult,\\\\\\\\\\\\\\\\n  StbDocument,\\\\\\\\\\\\\\\\n  StbGridCandidate,\\\\\\\\\\\\\\\\n  StbSkeletonCandidate,\\\\\\\\\\\\\\\\n} from '@/lib/import/stb/types'\\\\\\\\\\\\\\\\nimport type { Project } from '@/domain/model/project'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst documentDirectory = resolve(\\\\\\\\\\\\\\\\n  process.cwd(),\\\\\\\\\\\\\\\\n  'tests/fixtures/stb-import/document',\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\nconst appliedDirectory = resolve(\\\\\\\\\\\\\\\\n  process.cwd(),\\\\\\\\\\\\\\\\n  'tests/fixtures/stb-import/applied',\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst fixtureFiles = [\\\\\\\\\\\\\\\\n  'mini.json',\\\\\\\\\\\\\\\\n  'dotnet-sample1.json',\\\\\\\\\\\\\\\\n  'diffchecker-filea.json',\\\\\\\\\\\\\\\\n  'hoaryfox-sample.json',\\\\\\\\\\\\\\\\n  'diffchecker-mini210.json',\\\\\\\\\\\\\\\\n] as const\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface AppliedFixture {\\\\\\\\\\\\\\\\n  _derivedFrom: string\\\\\\\\\\\\\\\\n  grid: {\\\\\\\\\\\\\\\\n    applied: boolean\\\\\\\\\\\\\\\\n    refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n    value: {\\\\\\\\\\\\\\\\n      xSpans: number[]\\\\\\\\\\\\\\\\n      ySpans: number[]\\\\\\\\\\\\\\\\n      xLabels: string[]\\\\\\\\\\\\\\\\n      yLabels: string[]\\\\\\\\\\\\\\\\n    } | null\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  stories: {\\\\\\\\\\\\\\\\n    applied: boolean\\\\\\\\\\\\\\\\n    refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n    value: { id: string; name: string; height: number }[] | null\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface RefusedFixture {\\\\\\\\\\\\\\\\n  applied: boolean\\\\\\\\\\\\\\\\n  refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n  value: null\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction readJson<T>(directory: string, file: string): T {\\\\\\\\\\\\\\\\n  return JSON.parse(\\\\\\\\\\\\\\\\n    readFileSync(resolve(directory, file), 'utf8'),\\\\\\\\\\\\\\\\n  ) as T\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction withoutPrivateKeys<T>(value: T): T {\\\\\\\\\\\\\\\\n  return Object.fromEntries(\\\\\\\\\\\\\\\\n    Object.entries(value as Record<string, unknown>).filter(\\\\\\\\\\\\\\\\n      ([key]) => !key.startsWith('_'),\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\n  ) as T\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction candidateFor(file: (typeof fixtureFiles)[number]): StbSkeletonCandidate {\\\\\\\\\\\\\\\\n  return toSkeletonCandidate(\\\\\\\\\\\\\\\\n    withoutPrivateKeys(\\\\\\\\\\\\\\\\n      readJson<StbDocument>(documentDirectory, file),\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction resultShape(\\\\\\\\\\\\\\\\n  result: StbApplyResult,\\\\\\\\\\\\\\\\n): RefusedFixture {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    applied: result.applied,\\\\\\\\\\\\\\\\n    refusal: result.refusal ?? null,\\\\\\\\\\\\\\\\n    value: null,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst emptyProject: Project = {\\\\\\\\\\\\\\\\n  schemaVersion: 11,\\\\\\\\\\\\\\\\n  name: '사용자가 정한 案件名',\\\\\\\\\\\\\\\\n  grid: {\\\\\\\\\\\\\\\\n    xSpans: [6000, 6000],\\\\\\\\\\\\\\\\n    ySpans: [5000],\\\\\\\\\\\\\\\\n    xLabels: ['기존X1', '기존X2', '기존X3'],\\\\\\\\\\\\\\\\n    yLabels: ['기존Y1', '기존Y2'],\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\n  stories: [{ id: 'existing-story', name: '기존층', height: 3000 }],\\\\\\\\\\\\\\\\n  sections: [],\\\\\\\\\\\\\\\\n  members: [],\\\\\\\\\\\\\\\\n  notes: { 'existing-line': '보존할 메모' },\\\\\\\\\\\\\\\\n  unitMass: { D10: 0.56 },\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst projectWithMember: Project = {\\\\\\\\\\\\\\\\n  ...emptyProject,\\\\\\\\\\\\\\\\n  members: [\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\n      id: 'member-1',\\\\\\\\\\\\\\\\n      kind: '柱',\\\\\\\\\\\\\\\\n      memberClass: '躯体',\\\\\\\\\\\\\\\\n      sectionId: 'section-1',\\\\\\\\\\\\\\\\n      storyId: 'existing-story',\\\\\\\\\\\\\\\\n      position: { ix: 0, iy: 0 },\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  ],\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction relabelCandidate(\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  labels: { x: string[]; y: string[] },\\\\\\\\\\\\\\\\n): StbSkeletonCandidate {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    ...candidate,\\\\\\\\\\\\\\\\n    grids: candidate.grids.map((grid) => ({\\\\\\\\\\\\\\\\n      ...grid,\\\\\\\\\\\\\\\\n      axes:\\\\\\\\\\\\\\\\n        grid.direction === 'X'\\\\\\\\\\\\\\\\n          ? labels.x.map((label) => ({ label }))\\\\\\\\\\\\\\\\n          : labels.y.map((label) => ({ label })),\\\\\\\\\\\\\\\\n    })),\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridCandidate(\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n): { x: StbGridCandidate; y: StbGridCandidate } {\\\\\\\\\\\\\\\\n  const x = candidate.grids.find(({ direction }) => direction === 'X')\\\\\\\\\\\\\\\\n  const y = candidate.grids.find(({ direction }) => direction === 'Y')\\\\\\\\\\\\\\\\n  if (x === undefined || y === undefined) {\\\\\\\\\\\\\\\\n    throw new Error('test candidate does not contain both grid directions')\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return { x, y }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('ST-Bridge candidate application fixtures', () => {\\\\\\\\\\\\\\\\n  for (const file of fixtureFiles) {\\\\\\\\\\\\\\\\n    it(`${file} matches its independently derived applied fixture`, () => {\\\\\\\\\\\\\\\\n      const candidate = candidateFor(file)\\\\\\\\\\\\\\\\n      const expected = readJson<AppliedFixture>(appliedDirectory, file)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      const gridResult = applyStbGrid(emptyProject, candidate)\\\\\\\\\\\\\\\\n      const storiesResult = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n      const grid = gridResult.applied\\\\\\\\\\\\\\\\n        ? {\\\\\\\\\\\\\\\\n            applied: true,\\\\\\\\\\\\\\\\n            refusal: null,\\\\\\\\\\\\\\\\n            value: gridResult.project.grid,\\\\\\\\\\\\\\\\n          }\\\\\\\\\\\\\\\\n        : resultShape(gridResult)\\\\\\\\\\\\\\\\n      const stories = storiesResult.applied\\\\\\\\\\\\\\\\n        ? {\\\\\\\\\\\\\\\\n            applied: true,\\\\\\\\\\\\\\\\n            refusal: null,\\\\\\\\\\\\\\\\n            value: storiesResult.project.stories,\\\\\\\\\\\\\\\\n          }\\\\\\\\\\\\\\\\n        : resultShape(storiesResult)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(expected._derivedFrom).toBe(\\\\\\\\\\\\\\\\n        `tests/fixtures/stb-import/expected/${file}`,\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      expect(grid).toEqual(expected.grid)\\\\\\\\\\\\\\\\n      expect(stories).toEqual(expected.stories)\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('applyStbGrid', () => {\\\\\\\\\\\\\\\\n  it('rejects missing or non-unique X/Y candidates without touching the project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const missingDirection = {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      grids: candidate.grids.filter(({ direction }) => direction === 'X'),\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    const duplicateDirection = {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      grids: [...candidate.grids, candidate.grids[0]!],\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    for (const invalid of [missingDirection, duplicateDirection]) {\\\\\\\\\\\\\\\\n      const result = applyStbGrid(projectWithMember, invalid)\\\\\\\\\\\\\\\\n      expect(result.applied).toBe(false)\\\\\\\\\\\\\\\\n      expect(result.refusal).toBe('通り芯候補なし')\\\\\\\\\\\\\\\\n      expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('rejects a changed grid while members exist, preserving the original reference', () => {\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidateFor('dotnet-sample1.json'))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '部材あり通り芯置換不可',\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('keeps members when only labels change on an otherwise equal grid', () => {\\\\\\\\\\\\\\\\n    const candidate = relabelCandidate(candidateFor('mini.json'), {\\\\\\\\\\\\\\\\n      x: ['X-A', 'X-B', 'X-C'],\\\\\\\\\\\\\\\\n      y: ['Y-A', 'Y-B'],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidate)\\\\\\\\\\\\\\\\n\