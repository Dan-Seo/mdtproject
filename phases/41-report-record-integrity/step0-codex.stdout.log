\\\n} from './types'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameNumbers(left: number[], right: number[]): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    left.length === right.length &&\\\\\\\\\\\\\\\\n    left.every((value, index) => value === right[index])\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameStrings(\\\\\\\\\\\\\\\\n  left: string[] | undefined,\\\\\\\\\\\\\\\\n  right: string[] | undefined,\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\n  if (left === undefined || right === undefined) return left === right\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    left.length === right.length &&\\\\\\\\\\\\\\\\n    left.every((value, index) => value === right[index])\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridFor(\\\\\\\\\\\\\\\\n  grids: StbGridCandidate[],\\\\\\\\\\\\\\\\n  direction: StbGridCandidate['direction'],\\\\\\\\\\\\\\\\n): StbGridCandidate | undefined {\\\\\\\\\\\\\\\\n  const matching = grids.filter((grid) => grid.direction === direction)\\\\\\\\\\\\\\\\n  return matching.length === 1 ? matching[0] : undefined\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridValue(\\\\\\\\\\\\\\\\n  xGrid: StbGridCandidate,\\\\\\\\\\\\\\\\n  yGrid: StbGridCandidate,\\\\\\\\\\\\\\\\n): Project['grid'] {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    xSpans: [...xGrid.spansMm],\\\\\\\\\\\\\\\\n    ySpans: [...yGrid.spansMm],\\\\\\\\\\\\\\\\n    xLabels: xGrid.axes.map(({ label }) => label),\\\\\\\\\\\\\\\\n    yLabels: yGrid.axes.map(({ label }) => label),\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameGridSpans(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  nextGrid: Project['grid'],\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    sameNumbers(project.grid.xSpans, nextGrid.xSpans) &&\\\\\\\\\\\\\\\\n    sameNumbers(project.grid.ySpans, nextGrid.ySpans)\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameGrid(project: Project, nextGrid: Project['grid']): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    sameGridSpans(project, nextGrid) &&\\\\\\\\\\\\\\\\n    sameStrings(project.grid.xLabels, nextGrid.xLabels) &&\\\\\\\\\\\\\\\\n    sameStrings(project.grid.yLabels, nextGrid.yLabels)\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction sameStories(\\\\\\\\\\\\\\\\n  left: Project['stories'],\\\\\\\\\\\\\\\\n  right: Project['stories'],\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    left.length === right.length &&\\\\\\\\\\\\\\\\n    left.every(\\\\\\\\\\\\\\\\n      (story, index) =>\\\\\\\\\\\\\\\\n        story.id === right[index]?.id &&\\\\\\\\\\\\\\\\n        story.name === right[index]?.name &&\\\\\\\\\\\\\\\\n        story.height === right[index]?.height,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function applyStbGrid(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  options: { discardMembers?: boolean } = {},\\\\\\\\\\\\\\\\n): Stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\u0041pplyResult {\\\\\\\\\\\\\\\\n  const xGrid = gridFor(candidate.grids, 'X')\\\\\\\\\\\\\\\\n  const yGrid = gridFor(candidate.grids, 'Y')\\\\\\\\\\\\\\\\n  if (xGrid === undefined || yGrid === undefined) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?싥굤??숃짒?ゃ걮',\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const nextGrid = gridValue(xGrid, yGrid)\\\\\\\\\\\\\\\\n  const spansMatch = sameGridSpans(project, nextGrid)\\\\\\\\\\\\\\\\n  if (sameGrid(project, nextGrid)) {\\\\\\\\\\\\\\\\n    return { project, applied: false }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\n    !spansMatch &&\\\\\\\\\\\\\\\\n    project.members.length > 0 &&\\\\\\\\\\\\\\\\n    options.discardMembers !== true\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?ⓩ쓲?귙굤?싥굤??쉰?쎽툖??,\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    project: {\\\\\\\\\\\\\\\\n      ...project,\\\\\\\\\\\\\\\\n      grid: nextGrid,\\\\\\\\\\\\\\\\n      ...(spansMatch ? {} : { members: [] }),\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n    applied: true,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function applyStbStories(\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  options: { discardMembers?: boolean } = {},\\\\\\\\\\\\\\\\n): Stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\u0041pplyResult {\\\\\\\\\\\\\\\\n  if (candidate.stories.length === 0) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?롥숃짒?ゃ걮',\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (project.members.length > 0 && options.discardMembers !== true) {\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\n      project,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖??,\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const stories = candidate.stories.map((story, index) => ({\\\\\\\\\\\\\\\\n    id: `story-${index + 1}`,\\\\\\\\\\\\\\\\n    name: story.name,\\\\\\\\\\\\\\\\n    height: story.heightMm,\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  if (project.members.length === 0 && sameStories(project.stories, stories)) {\\\\\\\\\\\\\\\\n    return { project, applied: false }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    project: {\\\\\\\\\\\\\\\\n      ...project,\\\\\\\\\\\\\\\\n      stories,\\\\\\\\\\\\\\\\n      members: [],\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n    applied: true,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/lib/import/stb/candidates.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbAxisGroupRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbAxisRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbGridCandidate,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbIssue,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  StbSkeletonCandidate,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from './types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst AXIS_DIRECTIONS = ['X', 'Y'] as const\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ntype AxisDirection = (typeof AXIS_DIRECTIONS)[number]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst SUPPORTED_STORY_KINDS = new Set(['GENERAL', 'ROOF', 'PENTHOUSE'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction addIssue(issues: StbIssue[], issue: StbIssue): void {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!issues.includes(issue)) issues.push(issue)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction unsupportedItems(document: StbDocument): { name: string; count: number }[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [...document.unsupportedAxisKinds, ...document.unreadElements]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction normalizedAngle(angle: string | undefined):\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | { direction: AxisDirection; radians: number }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | undefined {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const value = Number(angle)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (!Number.isFinite(value)) return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const normalized = ((value % 360) + 360) % 360\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const quadrant = Math.round(normalized / 90)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (Math.abs(normalized - quadrant * 90) > 0.001) return undefined\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const quadrantInCycle = quadrant % 4\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    direction:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      quadrantInCycle === 0 || quadrantInCycle === 2 ? 'Y' : 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    radians: normalized,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction originFor(group: StbAxisGroupRaw, direction: AxisDirection): number {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const rawOrigin = direction === 'X' ? group.originX : group.originY\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return rawOrigin === undefined ? 0 : Number(rawOrigin)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction hasNodeAtAxisCoordinate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  axis: StbAxisRaw,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  direction: AxisDirection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  expectedCoordinate: number,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  nodesById: Map<string, { x?: string; y?: string }>,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return axis.nodeIds.some((nodeId) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const node = nodesById.get(nodeId)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (node === undefined) return false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const coordinate = Number(direction === 'X' ? node.x : node.y)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return Number.isFinite(coordinate) &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      Math.abs(coordinate - expectedCoordinate) <= 1\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\