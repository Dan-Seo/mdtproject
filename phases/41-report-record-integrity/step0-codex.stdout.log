\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const groupsWithDirections = document.axisGroups.map((group) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    group,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    angle: normalizedAngle(group.angle),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (groupsWithDirections.some(({ angle }) => angle === undefined)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '?욅쎍雅ㅹ싥굤??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const directions = groupsWithDirections.map(({ angle }) => angle!.direction)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (directions[0] === directions[1]) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '?싥굤??뼶?묇툖??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const grids = groupsWithDirections.flatMap(({ group, angle }) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    gridForDirection(group, angle!.direction, document, issues) ?? [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return grids.sort(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (left, right) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      AXIS_DIRECTIONS.indexOf(left.direction) -\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      AXIS_DIRECTIONS.indexOf(right.direction),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction storiesForDocument(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document: StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  issues: StbIssue[],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbSkeletonCandidate['stories'] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.stories.length === 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '?롣툖擁?)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const levels = document.stories.map((story) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    story,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    height: Number(story.height),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (levels.some(({ height }) => !Number.isFinite(height))) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  let hasBasement = false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  let hasUnsupportedKind = false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (const { story, height } of levels) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (story.kind === 'BASEMENT' || height < 0) hasBasement = true\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      story.kind === undefined ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (story.kind !== 'BASEMENT' && !SUPPORTED_STORY_KINDS.has(story.kind))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hasUnsupportedKind = true\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasBasement) addIssue(issues, '?겻툔?с깧?ユ쑋野얍퓶')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasUnsupportedKind) addIssue(issues, '野얍퓶鸚뽧겗?롧Ŧ??)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const sortedLevels = [...levels].sort(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (left, right) => left.height - right.height,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasDuplicate = sortedLevels.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    (entry, index) => index > 0 && entry.height === sortedLevels[index - 1]!.height,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasDuplicate) addIssue(issues, '?롢꺃?쇻꺂?띹쨭')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (sortedLevels.length < 2) addIssue(issues, '?롣툖擁?)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    document.stories.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (story) => story.name === undefined || story.name.length === 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    addIssue(issues, '?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasBasement ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasUnsupportedKind ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasDuplicate ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    sortedLevels.length < 2 ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    document.stories.some(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      (story) => story.name === undefined || story.name.length === 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return sortedLevels.slice(0, -1).map((level, index) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    name: level.story.name!,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    heightMm: sortedLevels[index + 1]!.height - level.height,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document: StbDocument,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbSkeletonCandidate {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const issues: StbIssue[] = []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const unsupported = unsupportedItems(document)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.issues.length > 0) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate: StbSkeletonCandidate = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      version: document.version,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grids: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      stories: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      unsupported,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      issues: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (document.projectName !== undefined) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      candidate.projectName = document.projectName\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const issue of document.issues) addIssue(candidate.issues, issue)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return candidate\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const grids = gridsForDocument(document, issues)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const stories = storiesForDocument(document, issues)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const candidate: StbSkeletonCandidate = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    version: document.version,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    grids,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    stories,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    unsupported,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    issues,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (document.projectName !== undefined) candidate.projectName = document.projectName\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return candidate\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/components/stb/StbImport.tsx\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n'use client'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { useRef, useState, type ChangeEvent } from 'react'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { decodeStbBytes } from '@/lib/import/stb/decode'\\\\\\\\\\\\\\\\nimport { parseStbDocument } from '@/lib/import/stb/document'\\\\\\\\\\\\\\\\nimport { toSkeletonCandidate } from '@/lib/import/stb/candidates'\\\\\\\\\\\\\\\\nimport { applyStbGrid, applyStbStories } from '@/lib/import/stb/apply'\\\\\\\\\\\\\\\\nimport type { StbGridCandidate, StbSkeletonCandidate } from '@/lib/import/stb/types'\\\\\\\\\\\\\\\\nimport { t } from '@/lib/i18n'\\\\\\\\\\\\\\\\nimport { useAppStore } from '@/lib/store'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport styles from './StbImport.module.css'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface StbImportProps {\\\\\\\\\\\\\\\\n  /** ?뚯뒪?몄뿉???뚯씪 ?댁꽍??嫄대꼫?곌퀬 ?꾨낫瑜?吏곸젒 ?ｋ뒗 而댄룷?뚰듃 ?뚯뒪?몄슜 寃쎄퀎. */\\\\\\\\\\\\\\\\n  initialCandidate?: StbSkeletonCandidate\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ntype GridApplyResult = ReturnType<typeof applyStbGrid>\\\\\\\\\\\\\\\\ntype StoriesApplyResult = ReturnType<typeof applyStbStories>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction GridCandidate({\\\\\\\\\\\\\\\\n  candidate,\\\\\\\\\\\\\\\\n  locale,\\\\\\\\\\\\\\\\n}: {\\\\\\\\\\\\\\\\n  candidate: StbGridCandidate\\\\\\\\\\\\\\\\n  locale: 'ja' | 'ko'\\\\\\\\\\\\\\\\n}) {\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    <div className={styles.group} data-testid={`stb-import-grid-${candidate.direction}`}>\\\\\\\\\\\\\\\\n      <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n        {t(\\\\\\\\\\\\\\\\n          locale,\\\\\\\\\\\\\\\\n          candidate.direction === 'X' ? 'stbImport.gridX' : 'stbImport.gridY',\\\\\\\\\\\\\\\\n        )}\\\\\\\\\\\\\\\\n      </h4>\\\\\\\\\\\\\\\\n      <p className={styles.axes}>\\\\\\\\\\\\\\\\n        {candidate.axes.map((axis, index) => (\\\\\\\\\\\\\\\\n          <span key={`${axis.label}-${index}`}>\\\\\\\\\\\\\\\\n            <span className={styles.axis}>{axis.label}</span>\\\\\\\\\\\\\\\\n            {index < candidate.spansMm.length ? (\\\\\\\\\\\\\\\\n              <span className={styles.span}>\\\\\\\\\\\\\\\\n                {` ??${candidate.spansMm[index]} ??`}\\\\\\\\\\\\\\\\n              </span>\\\\\\\\\\\\\\\\n            ) : null}\\\\\\\\\\\\\\\\n          </span>\\\\\\\\\\\\\\\\n        ))}\\\\\\\\\\\\\\\\n      </p>\\\\\\\\\\\\\\\\n    </div>\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction ApplyResult({\\\\\\\\\\\\\\\\n  result,\\\\\\\\\\\\\\\\n  locale,\\\\\\\\\\\\\\\\n  successKey,\\\\\\\\\\\\\\\\n  count,\\\\\\\\\\\\\\\\n  testId,\\\\\\\\\\\\\\\\n}: {\\\\\\\\\\\\\\\\n  result: GridApplyResult | StoriesApplyResult | null\\\\\\\\\\\\\\\\n  locale: 'ja' | 'ko'\\\\\\\\\\\\\\\\n  successKey: 'stbImport.appliedGrid' | 'stbImport.appliedStories'\\\\\\\\\\\\\\\\n  count: number\\\\\\\\\\\\\\\\n  testId: string\\\\\\\\\\\\\\\\n}) {\\\\\\\\\\\\\\\\n  if (!result) return null\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    <p className={styles.result} data-testid={testId}>\\\\\\\\\\\\\\\\n      {result.refusal\\\\\\\\\\\\\\\\n        ? t(locale, `stbImport.refusal.${result.refusal}`)\\\\\\\\\\\\\\\\n        : `${t(locale, successKey)}: ${count}`}\\\\\\\\\\\\\\\\n    </p>\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function StbImport({ initialCandidate }: StbImportProps) {\\\\\\\\\\\\\\\\n  const locale = useAppStore(({ locale }) => locale)\\\\\\\\\\\\\\\\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\\\\\\\\\\\\\\\\n  const inputRef = useRef<HTMLInputElement>(null)\\\\\\\\\\\\\\\\n  const [candidate, setCandidate] = useState<StbSkeletonCandidate | null>(\\\\\\\\\\\\\\\\n    initialCandidate ?? null,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const [open, setOpen] = useState(initialCandidate !== undefined)\\\\\\\\\\\\\\\\n  const [loading, setLoading] = useState(false)\\\\\\\\\\\\\\\\n  const [failed, setFailed] = useState(false)\\\\\\\\\\\\\\\\n  const [gridResult, setGridResult] = useState<GridApplyResult | null>(null)\\\\\\\\\\\\\\\\n  const [storiesResult, setStoriesResult] = useState<StoriesApplyResult | null>(\\\\\\\\\\\\\\\\n    null,\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n  const [discardGridMembers, setDiscardGridMembers] = useState(false)\\\\\\\\\\\\\\\\n  const [discardStoryMembers, setDiscardStoryMembers] = useState(false)\\\\\\\\\\\\\\\\n  const requestRef = useRef(0)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\\\\\\\\\\\\\\\\n    const input = event.currentTarget\\\\\\\\\\\\\\\\n    const file = input.files?.[0]\\\\\\\\\\\\\\\\n    if (!file) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    const requestId = ++requestRef.current\\\\\\\\\\\\\\\\n    setOpen(true)\\\\\\\\\\\\\\\\n    setLoading(true)\\\\\\\\\\\\\\\\n    setFailed(false)\\\\\\\\\\\\\\\\n    setCandidate(null)\\\\\\\\\\\\\\\\n    setGridResult(null)\\\\\\\\\\\\\\\\n    setStoriesResult(null)\\\\\\\\\\\\\\\\n    setDiscardGridMembers(false)\\\\\\\\\\\\\\\\n    setDiscardStoryMembers(false)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    try {\\\\\\\\\\\\\\\\n      const decoded = decodeStbBytes(await file.arrayBuffer())\\\\\\\\\\\\\\\\n      if (requestRef.current !== requestId) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      if (!decoded.ok) {\\\\\\\\\\\\\\\\n        setCandidate({\\\\\\\\\\\\\\\\n          version: '??,\\\\\\\\\\\\\\\\n          grids: [],\\\\\\\\\\\\\\\\n          stories: [],\\\\\\\\\\\\\\\\n          unsupported: [],\\\\\\\\\\\\\\\\n          issues: [decoded.issue],\\\\\\\\\\\\\\\\n        })\\\\\\\\\\\\\\\\n      } else {\\\\\\\\\\\\\\\\n        const document = parseStbDocument(decoded.text, decoded.encoding)\\\\\\\\\\\\\\\\n        setCandidate(toSkeletonCandidate(document))\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    } catch {\\\\\\\\\\\\\\\\n      if (requestRef.current !== requestId) return\\\\\\\\\\\\\\\\n      setCandidate(null)\\\\\\\\\\\\\\\\n      setFailed(true)\\\\\\\\\\\\\\\\n    } finally {\\\\\\\\\\\\\\\\n      if (requestRef.current === requestId) setLoading(false)\\\\\\\\\\\\\\\\n      input.value = ''\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const applyGrid = () => {\\\\\\\\\\\\\\\\n    if (!candidate) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    let next: GridApplyResult | undefined\\\\\\\\\\\\\\\\n    updateProject((project) => {\\\\\\\\\\\\\\\\n      next = applyStbGrid(project, candidate, {\\\\\\\\\\\\\\\\n        discardMembers: discardGridMembers,\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\n      return next.project\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    if (next) setGridResult(next)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const applyStories = () => {\\\\\\\\\\\\\\\\n    if (!candidate) return\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    let next: StoriesApplyResult | undefined\\\\\\\\\\\\\\\\n    updateProject((project) => {\\\\\\\\\\\\\\\\n      next = applyStbStories(project, candidate, {\\\\\\\\\\\\\\\\n        discardMembers: discardStoryMembers,\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\n      return next.project\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    if (next) setStoriesResult(next)\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const hasGridCandidate =\\\\\\\\\\\\\\\\n    candidate?.grids.filter(({ direction }) => direction === 'X').length === 1 &&\\\\\\\\\\\\\\\\n    candidate.grids.filter(({ direction }) => direction === 'Y').length === 1\\\\\\\\\\\\\\\\n  const hasStoryCandidate = candidate !== null && candidate.stories.length > 0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return (\\\\\\\\\\\\\\\\n    <div className={styles.control}>\\\\\\\\\\\\\\\\n      <button\\\\\\\\\\\\\\\\n        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        className={styles.openButton}\\\\\\\\\\\\\\\\n        onClick={() => {\\\\\\\\\\\\\\\\n          if (candidate) setOpen(true)\\\\\\\\\\\\\\\\n          else inputRef.current?.click()\\\\\\\\\\\\\\\\n        }}\\\\\\\\\\\\\\\\n      >\\\\\\\\\\\\\\\\n        {t(locale, 'stbImport.open')}\\\\\\\\\\\\\\\\n      </button>\\\\\\\\\\\\\\\\n      <input\\\\\\\\\\\\\\\\n        ref={inputRef}\\\\\\\\\\\\\\\\n        className={styles.fileInput}\\\\\\\\\\\\\\\\n        data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        accept=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".stb\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        aria-label={t(locale, 'stbImport.file')}\\\\\\\\\\\\\\\\n        onChange={(event) => void selectFile(event)}\\\\\\\\\\\\\\\\n      />\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      {open ? (\\\\\\\\\\\\\\\\n        <section\\\\\\\\\\\\\\\\n          className={styles.panel}\\\\\\\\\\\\\\\\n          role=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"dialog\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n          aria-modal=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"false\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n          aria-labelledby=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-title\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        >\\\\\\\\\\\\\\\\n          <header className={styles.panelHeader}>\\\\\\\\\\\\\\\\n            <h3 id=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-title\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-title\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n              {t(locale, 'stbImport.title')}\\\\\\\\\\\\\\\\n            </h3>\\\\\\\\\\\\\\\\n            <div className={styles.panelActions}>\\\\\\\\\\\\\\\\n              <button\\\\\\\\\\\\\\\\n                type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                className={styles.chooseButton}\\\\\\\\\\\\\\\\n                onClick={() => inputRef.current?.click()}\\\\\\\\\\\\\\\\n              >\\\\\\\\\\\\\\\\n                {t(locale, 'stbImport.chooseAnother')}\\\\\\\\\\\\\\\\n              </button>\\\\\\\\\\\\\\\\n              <button\\\\\\\\\\\\\\\\n                type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                className={styles.closeButton}\\\\\\\\\\\\\\\\n                onClick={() => setOpen(false)}\\\\\\\\\\\\\\\\n              >\\\\\\\\\\\\\\\\n                {t(locale, 'stbImport.close')}\\\\\\\\\\\\\\\\n              </button>\\\\\\\\\\\\\\\\n            </div>\\\\\\\\\\\\\\\\n          </header>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n          <div className={styles.panelBody}>\\\\\\\\\\\\\\\\n            {loading ? (\\\\\\\\\\\\\\\\n              <p role=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">{t(locale, 'stbImport.loading')}</p>\\\\\\\\\\\\\\\\n            ) : failed ? (\\\\\\\\\\\\\\\\n              <p role=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"alert\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">{t(locale, 'stbImport.error')}</p>\\\\\\\\\\\\\\\\n            ) : candidate ? (\\\\\\\\\\\\\\\\n              <>\\\\\\\\\\\\\\\\n                <div className={styles.metadata}>\\\\\\\\\\\\\\\\n                  <span data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-version\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                    {`${t(locale, 'stbImport.version')}: ${candidate.version}`}\\\\\\\\\\\\\\\\n                  </span>\\\\\\\\\\\\\\\\n                  {candidate.projectName !== undefined ? (\\\\\\\\\\\\\\\\n                    <span data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-project-name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                      {`${t(locale, 'stbImport.projectName')}: ${candidate.projectName}`}\\\\\\\\\\\\\\\\n                    </span>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                </div>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                {candidate.issues.length > 0 ? (\\\\\\\\\\\\\\\\n                  <section className={styles.group} data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-issues\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                    <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.issues')}\\\\\\\\\\\\\\\\n                    </h4>\\\\\\\\\\\\\\\\n                    <ul className={styles.issues}>\\\\\\\\\\\\\\\\n                      {[...new Set(candidate.issues)].map((issue) => (\\\\\\\\\\\\\\\\n                        <li key={issue}>{t(locale, `stbImport.issue.${issue}`)}</li>\\\\\\\\\\\\\\\\n                      ))}\\\\\\\\\\\\\\\\n                    </ul>\\\\\\\\\\\\\\\\n                  </section>\\\\\\\\\\\\\\\\n                ) : null}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                <section className={styles.group}>\\\\\\\\\\\\\\\\n                  <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                    {t(locale, 'stbImport.grids')}\\\\\\\\\\\\\\\\n                  </h4>\\\\\\\\\\\\\\\\n                  {candidate.grids.map((grid, index) => (\\\\\\\\\\\\\\\\n                    <GridCandidate\\\\\\\\\\\\\\\\n                      key={`${grid.direction}-${index}`}\\\\\\\\\\\\\\\\n                      candidate={grid}\\\\\\\\\\\\\\\\n                      locale={locale}\\\\\\\\\\\\\\\\n                    />\\\\\\\\\\\\\\\\n                  ))}\\\\\\\\\\\\\\\\n                  {hasGridCandidate ? (\\\\\\\\\\\\\\\\n                    <button\\\\\\\\\\\\\\\\n                      type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      className={styles.applyButton}\\\\\\\\\\\\\\\\n                      data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-apply-grid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      onClick={applyGrid}\\\\\\\\\\\\\\\\n                    >\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.applyGrid')}\\\\\\\\\\\\\\\\n                    </button>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  {gridResult?.refusal === '?ⓩ쓲?귙굤?싥굤??쉰?쎽툖?? ? (\\\\\\\\\\\\\\\\n                    <label className={styles.discardOption}>\\\\\\\\\\\\\\\\n                      <input\\\\\\\\\\\\\\\\n                        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"checkbox\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-discard-grid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        checked={discardGridMembers}\\\\\\\\\\\\\\\\n                        onChange={(event) =>\\\\\\\\\\\\\\\\n                          setDiscardGridMembers(event.target.checked)\\\\\\\\\\\\\\\\n                        }\\\\\\\\\\\\\\\\n                      />\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.discardMembersGrid')}\\\\\\\\\\\\\\\\n                    </label>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  <ApplyResult\\\\\\\\\\\\\\\\n                    result={gridResult}\\\\\\\\\\\\\\\\n                    locale={locale}\\\\\\\\\\\\\\\\n                    successKey=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stbImport.appliedGrid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                    count={candidate.grids.length}\\\\\\\\\\\\\\\\n                    testId=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-grid-result\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                  />\\\\\\\\\\\\\\\\n                </section>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                <section className={styles.group} data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-stories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                  <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                    {t(locale, 'stbImport.stories')}\\\\\\\\\\\\\\\\n                  </h4>\\\\\\\\\\\\\\\\n                  {candidate.stories.length > 0 ? (\\\\\\\\\\\\\\\\n                    <ul className={styles.storyList}>\\\\\\\\\\\\\\\\n                      {candidate.stories.map((story, index) => (\\\\\\\\\\\\\\\\n                        <li key={`${story.name}-${index}`}>\\\\\\\\\\\\\\\\n                          <span className={styles.axis}>{story.name}</span>\\\\\\\\\\\\\\\\n                          <span className={styles.span}>\\\\\\\\\\\\\\\\n                            {` ??${story.heightMm} ${t(locale, 'stbImport.height')} ??`}\\\\\\\\\\\\\\\\n                          </span>\\\\\\\\\\\\\\\\n                        </li>\\\\\\\\\\\\\\\\n                      ))}\\\\\\\\\\\\\\\\n                    </ul>\\\\\\\\\\\\\\\\n                  ) : (\\\\\\\\\\\\\\\\n                    <p className={styles.muted}>{t(locale, 'stbImport.none')}</p>\\\\\\\\\\\\\\\\n                  )}\\\\\\\\\\\\\\\\n                  {hasStoryCandidate ? (\\\\\\\\\\\\\\\\n                    <button\\\\\\\\\\\\\\\\n                      type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"button\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      className={styles.applyButton}\\\\\\\\\\\\\\\\n                      data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-apply-stories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                      onClick={applyStories}\\\\\\\\\\\\\\\\n                    >\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.applyStories')}\\\\\\\\\\\\\\\\n                    </button>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  {storiesResult?.refusal === '?ⓩ쓲?귙굤?롧쉰?쎽툖?? ? (\\\\\\\\\\\\\\\\n                    <label className={styles.discardOption}>\\\\\\\\\\\\\\\\n                      <input\\\\\\\\\\\\\\\\n                        type=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"checkbox\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-discard-stories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                        checked={discardStoryMembers}\\\\\\\\\\\\\\\\n                        onChange={(event) =>\\\\\\\\\\\\\\\\n                          setDiscardStoryMembers(event.target.checked)\\\\\\\\\\\\\\\\n                        }\\\\\\\\\\\\\\\\n                      />\\\\\\\\\\\\\\\\n                      {t(locale, 'stbImport.discardMembersStories')}\\\\\\\\\\\\\\\\n                    </label>\\\\\\\\\\\\\\\\n                  ) : null}\\\\\\\\\\\\\\\\n                  <ApplyResult\\\\\\\\\\\\\\\\n                    result={storiesResult}\\\\\\\\\\\\\\\\n                    locale={locale}\\\\\\\\\\\\\\\\n                    successKey=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stbImport.appliedStories\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                    count={candidate.stories.length}\\\\\\\\\\\\\\\\n                    testId=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-stories-result\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                  />\\\\\\\\\\\\\\\\n                </section>\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                <section className={styles.group} data-testid=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"stb-import-unsupported\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\">\\\\\\\\\\\\\\\\n                  <h4 className={styles.groupTitle}>\\\\\\\\\\\\\\\\n                    {`${t(locale, 'stbImport.unsupported')} (${candidate.unsupported.length})`}\\\\\\\\\\\\\\\\n                  </h4>\\\\\\\\\\\\\\\\n                  {candidate.unsupported.length > 0 ? (\\\\\\\\\\\\\\\\n                    <ul className={styles.issues}>\\\\\\\\\\\\\\\\n                      {candidate.unsupported.map(({ name, count }, index) => (\\\\\\\\\\\\\\\\n                        <li key={`${name}-${index}`}>{`${name}: ${count}`}</li>\\\\\\\\\\\\\\\\n                      ))}\\\\\\\\\\\\\\\\n                    </ul>\\\\\\\\\\\\\\\\n                  ) : (\\\\\\\\\\\\\\\\n                    <p className={styles.muted}>{t(locale, 'stbImport.none')}</p>\\\\\\\\\\\\\\\\n                  )}\\\\\\\\\\\\\\\\n                </section>\\\\\\\\\\\\\\\\n              </>\\\\\\\\\\\\\\\\n            ) : null}\\\\\\\\\\\\\\\\n          </div>\\\\\\\\\\\\\\\\n        </section>\\\\\\\\\\\\\\\\n      ) : null}\\\\\\\\\\\\\\\\n    </div>\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/lib/import/stb/scope-guard.test.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync, readdirSync } from 'node:fs'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { join, resolve } from 'node:path'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst stbDirectory = resolve(process.cwd(), 'src/lib/import/stb')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction nonTestTypeScriptFiles(directory: string): string[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const path = join(directory, entry.name)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (entry.isDirectory()) return nonTestTypeScriptFiles(path)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (!entry.name.endsWith('.ts') || entry.name.endsWith('.test.ts')) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      return []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return [path]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('ST-Bridge document import scope', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('keeps the IR parser free of rule, section, network, and store concerns', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const actualFiles = nonTestTypeScriptFiles(stbDirectory).sort()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const scannedFiles = actualFiles.map((file) => ({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      file,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      source: readFileSync(file, 'utf8'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(scannedFiles.length).toBeGreaterThanOrEqual(3)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(scannedFiles.map(({ file }) => file).sort()).toEqual(actualFiles)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const forbidden = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '若싩?',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '?띲겖泳숁뎸',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '?섉쎊',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '?뗣겤??,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'depth_cover',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'anchorage',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cut_off',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'center_',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbSec',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbApply',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbColumn',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbGirder',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbBeam',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbWall',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbSlab',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbBrace',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbPile',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'StbFooting',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'fetch',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'XMLHttpRequest',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'WebSocket',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'sendBeacon',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'applyFramingPlan',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'applyElevation',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'updateProject',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'loadProject',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'useAppStore',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'zustand',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'createSampleProject',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const { file, source } of scannedFiles) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      for (const term of forbidden) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        expect(source, `${file} contains forbidden term ${term}`).not.toContain(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          term,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- src/lib/import/stb/candidates.test.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { StbDocument } from './types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { toSkeletonCandidate } from './candidates'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction axis(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: string | undefined,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  distance: string | undefined,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  nodeIds: string[] = [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return { name, distance, nodeIds }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction document(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  overrides: Partial<StbDocument> = {},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): StbDocument {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    version: '2.0.2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    encoding: 'utf-8',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        groupName: 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        angle: '270.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axes: [axis('X1', '0'), axis('X2', '6000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        groupName: 'Y',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        angle: '0.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axes: [axis('Y1', '0'), axis('Y2', '5000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    nodes: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    unsupportedAxisKinds: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    unreadElements: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    issues: [],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ...overrides,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('toSkeletonCandidate', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('maps directions from angles, never from group names', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '0.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('Y1', '0'), axis('Y2', '5000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'Y',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '270.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('X1', '0'), axis('X2', '6000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(candidate.grids).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { direction: 'X', groupName: 'Y', axes: [{ label: 'X1' }, { label: 'X2' }], spansMm: [6000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { direction: 'Y', groupName: 'X', axes: [{ label: 'Y1' }, { label: 'Y2' }], spansMm: [5000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const unnamed = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: '?싥굤',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '90.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('X1', '0'), axis('X2', '6000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'other',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '180.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('Y1', '0'), axis('Y2', '5000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(unnamed.grids.map((grid) => grid.direction)).toEqual(['X', 'Y'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('rejects the whole grid when either group is non-orthogonal and recovers when fixed', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const nonOrthogonal = document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          groupName: 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          angle: '45.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          axes: [axis('X1', '0'), axis('X2', '6000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          groupName: 'Y',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          angle: '0.0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          axes: [axis('Y1', '0'), axis('Y2', '5000')],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(toSkeletonCandidate(nonOrthogonal).grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(toSkeletonCandidate(nonOrthogonal).issues).toEqual(['?욅쎍雅ㅹ싥굤??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    nonOrthogonal.axisGroups[0]!.angle = '270.0'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(toSkeletonCandidate(nonOrthogonal).grids).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('deduplicates issue codes when both axis groups fail the same rule', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const bothNonOrthogonal = document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        { groupName: 'X', angle: '45.0', axes: [axis('X1', '0'), axis('X2', '6000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        { groupName: 'Y', angle: '135.0', axes: [axis('Y1', '0'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(toSkeletonCandidate(bothNonOrthogonal).issues).toEqual(['?욅쎍雅ㅹ싥굤??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const bothInvalidDistance = document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        { groupName: 'X', angle: '270.0', axes: [axis('X1', undefined), axis('X2', '6000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        { groupName: 'Y', angle: '0.0', axes: [axis('Y1', 'abc'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(toSkeletonCandidate(bothInvalidDistance).issues).toEqual(['?싥굤??퇌??㎗?덁툖??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('rejects missing or non-pair axis groups without inventing a grid', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const empty = toSkeletonCandidate(document({ axisGroups: [] }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(empty.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(empty.issues).toEqual(['?싥굤??쑋濾쒎눣'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const one = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({ axisGroups: [document().axisGroups[0]!] }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(one.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(one.issues).toEqual(['?싥굤??궛?ャ꺖?쀦빊訝띴???])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const three = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({ axisGroups: [...document().axisGroups, document().axisGroups[0]!] }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(three.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(three.issues).toEqual(['?싥굤??궛?ャ꺖?쀦빊訝띴???])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('accepts right angles within the documented tolerance', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'X', angle: '0.0', axes: [axis('Y1', '0'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'Y', angle: '89.9995', axes: [axis('X1', '0'), axis('X2', '6000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(candidate.issues).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(candidate.grids.map((grid) => grid.direction)).toEqual(['X', 'Y'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('rejects parallel axes and arc/radial axes, but ignores drawing axes while continuing', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const parallel = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'one', angle: '0', axes: [axis('A1', '0'), axis('A2', '100')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'two', angle: '0', axes: [axis('B1', '0'), axis('B2', '200')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parallel.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parallel.issues).toEqual(['?싥굤??뼶?묇툖??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const arc = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        unsupportedAxisKinds: [{ name: 'StbArcAxes', count: 1 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(arc.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(arc.issues).toEqual(['?욅쎍雅ㅹ싥굤??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const drawing = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        unsupportedAxisKinds: [{ name: 'StbDrawingAxes', count: 1 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(drawing.grids).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(drawing.issues).toEqual(['?ゅ?恙쒒싥굤??Ŧ??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('rejects invalid, missing, duplicate, and insufficient axis positions without inventing labels', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const invalidDistance = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'X', angle: '270', axes: [axis('X1', undefined), axis('X2', '6000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'Y', angle: '0', axes: [axis('Y1', '0'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(invalidDistance.grids).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { direction: 'Y', groupName: 'Y', axes: [{ label: 'Y1' }, { label: 'Y2' }], spansMm: [5000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(invalidDistance.issues).toEqual(['?싥굤??퇌??㎗?덁툖??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const missingLabel = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'X', angle: '270', axes: [axis(undefined, '0'), axis('X2', '6000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'Y', angle: '0', axes: [axis('Y1', '0'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(missingLabel.grids).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { direction: 'Y', groupName: 'Y', axes: [{ label: 'Y1' }, { label: 'Y2' }], spansMm: [5000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(missingLabel.issues).toEqual(['?싥굤??꺀?쇻꺂轝좄맼'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const duplicate = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'X', angle: '270', axes: [axis('X1', '0'), axis('X2', '0')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'Y', angle: '0', axes: [axis('Y1', '0'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(duplicate.grids).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { direction: 'Y', groupName: 'Y', axes: [{ label: 'Y1' }, { label: 'Y2' }], spansMm: [5000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(duplicate.issues).toEqual(['?싥굤??퐤營?뇥筽?])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const insufficient = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'X', angle: '270', axes: [axis('X1', '0')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { groupName: 'Y', angle: '0', axes: [axis('Y1', '0'), axis('Y2', '5000')] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(insufficient.grids).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { direction: 'Y', groupName: 'Y', axes: [{ label: 'Y1' }, { label: 'Y2' }], spansMm: [5000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(insufficient.issues).toEqual(['?싥굤??쑋濾쒎눣'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('reports node mismatches without discarding the grid and includes the group origin', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const mismatch = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '270',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            originX: '100',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('X1', '0', ['x1']), axis('X2', '6000', ['x2'])],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'Y',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            originY: '200',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('Y1', '0', ['y1']), axis('Y2', '5000', ['y2'])],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        nodes: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'x1', x: '100', y: '0' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'x2', x: '6500', y: '0' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'y1', x: '0', y: '200' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'y2', x: '0', y: '5000' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(mismatch.grids).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(mismatch.issues).toEqual(['?싥굤??퐤營?겏影?밤겗訝띴???])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const match = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        axisGroups: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'X',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '270',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            originX: '100',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('X1', '0', ['x1']), axis('X2', '6000', ['x2'])],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            groupName: 'Y',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            angle: '0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            originY: '200',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            axes: [axis('Y1', '0', ['y1']), axis('Y2', '5000', ['y2'])],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        nodes: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'x1', x: '100', y: '0' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'x2', x: '6100', y: '0' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'y1', x: '0', y: '200' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { id: 'y2', x: '0', y: '5200' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(match.issues).not.toContain('?싥굤??퐤營?겏影?밤겗訝띴???)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('rejects an incomplete story stack as a whole and derives adjacent heights', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '200', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '2FL', height: '4700', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '8700', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(candidate.stories).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: '1FL', heightMm: 4500 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: '2FL', heightMm: 4000 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const basement = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'B1F', height: '-3000', kind: 'BASEMENT' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(basement.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(basement.issues).toEqual(['?겻툔?с깧?ユ쑋野얍퓶'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const unsupportedKind = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'ISO', height: '4000', kind: 'ISOLATION' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '8000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(unsupportedKind.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(unsupportedKind.issues).toEqual(['野얍퓶鸚뽧겗?롧Ŧ??])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const twoUnsupportedKinds = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'B1F', height: '-3000', kind: 'BASEMENT' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'ISO', height: '0', kind: 'ISOLATION' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(twoUnsupportedKinds.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(twoUnsupportedKinds.issues).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '?겻툔?с깧?ユ쑋野얍퓶',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '野얍퓶鸚뽧겗?롧Ŧ??,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('accepts ROOF and PENTHOUSE, rejects invalid heights/names/duplicates/short stacks', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            { name: 'PH', height: '4000', kind: 'PENTHOUSE' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            { name: 'RFL', height: '8000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ).issues,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const invalidHeight = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: undefined, kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(invalidHeight.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(invalidHeight.issues).toEqual(['?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(JSON.stringify(invalidHeight)).not.toContain('heightMm\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":0')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const duplicate = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '2FL', height: '4000', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(duplicate.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(duplicate.issues).toEqual(['?롢꺃?쇻꺂?띹쨭'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const insufficient = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({ stories: [{ name: '1FL', height: '0', kind: 'GENERAL' }] }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(insufficient.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(insufficient.issues).toEqual(['?롣툖擁?])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const empty = toSkeletonCandidate(document({ stories: [] }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(empty.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(empty.issues).toEqual(['?롣툖擁?])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const negative = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'B1F', height: '-3000', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(negative.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(negative.issues).toEqual(['?겻툔?с깧?ユ쑋野얍퓶'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const missingName = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: undefined, height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(missingName.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(missingName.issues).toEqual(['?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('copies document failures and unsupported elements without producing candidates', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const failed = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        issues: ['野얍퓶鸚뽧깘?쇈궦?㎯꺍'],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        unsupportedAxisKinds: [{ name: 'StbArcAxes', count: 2 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        unreadElements: [{ name: 'StbColumn', count: 3 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.issues).toEqual(['野얍퓶鸚뽧깘?쇈궦?㎯꺍'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.unsupported).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: 'StbArcAxes', count: 2 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: 'StbColumn', count: 3 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('returns a JSON-only candidate', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate = toSkeletonCandidate(document({ projectName: 'demo' }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(JSON.parse(JSON.stringify(candidate))).toEqual(candidate)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- tests/stb-import/apply.test.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync } from 'node:fs'\\\\\\\\\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { toSkeletonCandidate } from '@/lib/import/stb/candidates'\\\\\\\\\\\\\\\\nimport { applyStbGrid, applyStbStories } from '@/lib/import/stb/apply'\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  StbApplyRefusal,\\\\\\\\\\\\\\\\n  StbApplyResult,\\\\\\\\\\\\\\\\n  StbDocument,\\\\\\\\\\\\\\\\n  StbGridCandidate,\\\\\\\\\\\\\\\\n  StbSkeletonCandidate,\\\\\\\\\\\\\\\\n} from '@/lib/import/stb/types'\\\\\\\\\\\\\\\\nimport type { Project } from '@/domain/model/project'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst documentDirectory = resolve(\\\\\\\\\\\\\\\\n  process.cwd(),\\\\\\\\\\\\\\\\n  'tests/fixtures/stb-import/document',\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\nconst appliedDirectory = resolve(\\\\\\\\\\\\\\\\n  process.cwd(),\\\\\\\\\\\\\\\\n  'tests/fixtures/stb-import/applied',\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst fixtureFiles = [\\\\\\\\\\\\\\\\n  'mini.json',\\\\\\\\\\\\\\\\n  'dotnet-sample1.json',\\\\\\\\\\\\\\\\n  'diffchecker-filea.json',\\\\\\\\\\\\\\\\n  'hoaryfox-sample.json',\\\\\\\\\\\\\\\\n  'diffchecker-mini210.json',\\\\\\\\\\\\\\\\n] as const\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface AppliedFixture {\\\\\\\\\\\\\\\\n  _derivedFrom: string\\\\\\\\\\\\\\\\n  grid: {\\\\\\\\\\\\\\\\n    applied: boolean\\\\\\\\\\\\\\\\n    refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n    value: {\\\\\\\\\\\\\\\\n      xSpans: number[]\\\\\\\\\\\\\\\\n      ySpans: number[]\\\\\\\\\\\\\\\\n      xLabels: string[]\\\\\\\\\\\\\\\\n      yLabels: string[]\\\\\\\\\\\\\\\\n    } | null\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  stories: {\\\\\\\\\\\\\\\\n    applied: boolean\\\\\\\\\\\\\\\\n    refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n    value: { id: string; name: string; height: number }[] | null\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface RefusedFixture {\\\\\\\\\\\\\\\\n  applied: boolean\\\\\\\\\\\\\\\\n  refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n  value: null\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction readJson<T>(directory: string, file: string): T {\\\\\\\\\\\\\\\\n  return JSON.parse(\\\\\\\\\\\\\\\\n    readFileSync(resolve(directory, file), 'utf8'),\\\\\\\\\\\\\\\\n  ) as T\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction withoutPrivateKeys<T>(value: T): T {\\\\\\\\\\\\\\\\n  return Object.fromEntries(\\\\\\\\\\\\\\\\n    Object.entries(value as Record<string, unknown>).filter(\\\\\\\\\\\\\\\\n      ([key]) => !key.startsWith('_'),\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\n  ) as T\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction candidateFor(file: (typeof fixtureFiles)[number]): StbSkeletonCandidate {\\\\\\\\\\\\\\\\n  return toSkeletonCandidate(\\\\\\\\\\\\\\\\n    withoutPrivateKeys(\\\\\\\\\\\\\\\\n      readJson<StbDocument>(documentDirectory, file),\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction resultShape(\\\\\\\\\\\\\\\\n  result: StbApplyResult,\\\\\\\\\\\\\\\\n): RefusedFixture {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    applied: result.applied,\\\\\\\\\\\\\\\\n    refusal: result.refusal ?? null,\\\\\\\\\\\\\\\\n    value: null,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst emptyProject: Project = {\\\\\\\\\\\\\\\\n  schemaVersion: 11,\\\\\\\\\\\\\\\\n  name: '?ъ슜?먭? ?뺥븳 旅덁뻑??,\\\\\\\\\\\\\\\\n  grid: {\\\\\\\\\\\\\\\\n    xSpans: [6000, 6000],\\\\\\\\\\\\\\\\n    ySpans: [5000],\\\\\\\\\\\\\\\\n    xLabels: ['湲곗〈X1', '湲곗〈X2', '湲곗〈X3'],\\\\\\\\\\\\\\\\n    yLabels: ['湲곗〈Y1', '湲곗〈Y2'],\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\n  stories: [{ id: 'existing-story', name: '湲곗〈痢?, height: 3000 }],\\\\\\\\\\\\\\\\n  sections: [],\\\\\\\\\\\\\\\\n  members: [],\\\\\\\\\\\\\\\\n  notes: { 'existing-line': '蹂댁〈??硫붾え' },\\\\\\\\\\\\\\\\n  unitMass: { D10: 0.56 },\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst projectWithMember: Project = {\\\\\\\\\\\\\\\\n  ...emptyProject,\\\\\\\\\\\\\\\\n  members: [\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\n      id: 'member-1',\\\\\\\\\\\\\\\\n      kind: '??,\\\\\\\\\\\\\\\\n      memberClass: '翁?퐪',\\\\\\\\\\\\\\\\n      sectionId: 'section-1',\\\\\\\\\\\\\\\\n      storyId: 'existing-story',\\\\\\\\\\\\\\\\n      position: { ix: 0, iy: 0 },\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  ],\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction relabelCandidate(\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  labels: { x: string[]; y: string[] },\\\\\\\\\\\\\\\\n): StbSkeletonCandidate {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    ...candidate,\\\\\\\\\\\\\\\\n    grids: candidate.grids.map((grid) => ({\\\\\\\\\\\\\\\\n      ...grid,\\\\\\\\\\\\\\\\n      axes:\\\\\\\\\\\\\\\\n        grid.direction === 'X'\\\\\\\\\\\\\\\\n          ? labels.x.map((label) => ({ label }))\\\\\\\\\\\\\\\\n          : labels.y.map((label) => ({ label })),\\\\\\\\\\\\\\\\n    })),\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridCandidate(\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n): { x: StbGridCandidate; y: StbGridCandidate } {\\\\\\\\\\\\\\\\n  const x = candidate.grids.find(({ direction }) => direction === 'X')\\\\\\\\\\\\\\\\n  const y = candidate.grids.find(({ direction }) => direction === 'Y')\\\\\\\\\\\\\\\\n  if (x === undefined || y === undefined) {\\\\\\\\\\\\\\\\n    throw new Error('test candidate does not contain both grid directions')\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return { x, y }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('ST-Bridge candidate application fixtures', () => {\\\\\\\\\\\\\\\\n  for (const file of fixtureFiles) {\\\\\\\\\\\\\\\\n    it(`${file} matches its independently derived applied fixture`, () => {\\\\\\\\\\\\\\\\n      const candidate = candidateFor(file)\\\\\\\\\\\\\\\\n      const expected = readJson<AppliedFixture>(appliedDirectory, file)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      const gridResult = applyStbGrid(emptyProject, candidate)\\\\\\\\\\\\\\\\n      const storiesResult = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n      const grid = gridResult.applied\\\\\\\\\\\\\\\\n        ? {\\\\\\\\\\\\\\\\n            applied: true,\\\\\\\\\\\\\\\\n            refusal: null,\\\\\\\\\\\\\\\\n            value: gridResult.project.grid,\\\\\\\\\\\\\\\\n          }\\\\\\\\\\\\\\\\n        : resultShape(gridResult)\\\\\\\\\\\\\\\\n      const stories = storiesResult.applied\\\\\\\\\\\\\\\\n        ? {\\\\\\\\\\\\\\\\n            applied: true,\\\\\\\\\\\\\\\\n            refusal: null,\\\\\\\\\\\\\\\\n            value: storiesResult.project.stories,\\\\\\\\\\\\\\\\n          }\\\\\\\\\\\\\\\\n        : resultShape(storiesResult)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(expected._derivedFrom).toBe(\\\\\\\\\\\\\\\\n        `tests/fixtures/stb-import/expected/${file}`,\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      expect(grid).toEqual(expected.grid)\\\\\\\\\\\\\\\\n      expect(stories).toEqual(expected.stories)\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('applyStbGrid', () => {\\\\\\\\\\\\\\\\n  it('rejects missing or non-unique X/Y candidates without touching the project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const missingDirection = {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      grids: candidate.grids.filter(({ direction }) => direction === 'X'),\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    const duplicateDirection = {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      grids: [...candidate.grids, candidate.grids[0]!],\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    for (const invalid of [missingDirection, duplicateDirection]) {\\\\\\\\\\\\\\\\n      const result = applyStbGrid(projectWithMember, invalid)\\\\\\\\\\\\\\\\n      expect(result.applied).toBe(false)\\\\\\\\\\\\\\\\n      expect(result.refusal).toBe('?싥굤??숃짒?ゃ걮')\\\\\\\\\\\\\\\\n      expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('rejects a changed grid while members exist, preserving the original reference', () => {\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidateFor('dotnet-sample1.json'))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?ⓩ쓲?귙굤?싥굤??쉰?쎽툖??,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('keeps members when only labels change on an otherwise equal grid', () => {\\\\\\\\\\\\\\\\n    const candidate = relabelCandidate(candidateFor('mini.json'), {\\\\\\\\\\\\\\\\n      x: ['X-A', 'X-B', 'X-C'],\\\\\\\\\\\\\\\\n      y: ['Y-A', 'Y-B'],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidate)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(result.project.members).toBe(projectWithMember.members)\\\\\\\\\\\\\\\\n    expect(result.project.stories).toBe(projectWithMember.stories)\\\\\\\\\\\\\\\\n    expect(result.project.grid).toEqual({\\\\\\\\\\\\\\\\n      xSpans: [6000, 6000],\\\\\\\\\\\\\\\\n      ySpans: [5000],\\\\\\\\\\\\\\\\n      xLabels: ['X-A', 'X-B', 'X-C'],\\\\\\\\\\\\\\\\n      yLabels: ['Y-A', 'Y-B'],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project.grid.xSpans).not.toBe(candidate.grids[0]!.spansMm)\\\\\\\\\\\\\\\\n    expect(result.project.grid.ySpans).not.toBe(candidate.grids[1]!.spansMm)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('discards members only when explicitly requested and preserves unrelated project data', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('dotnet-sample1.json')\\\\\\\\\\\\\\\\n    const before = {\\\\\\\\\\\\\\\\n      stories: projectWithMember.stories,\\\\\\\\\\\\\\\\n      sections: projectWithMember.sections,\\\\\\\\\\\\\\\\n      notes: projectWithMember.notes,\\\\\\\\\\\\\\\\n      unitMass: projectWithMember.unitMass,\\\\\\\\\\\\\\\\n      name: projectWithMember.name,\\\\\\\\\\\\\\\\n      schemaVersion: projectWithMember.schemaVersion,\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidate, {\\\\\\\\\\\\\\\\n      discardMembers: true,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(result.project.members).toEqual([])\\\\\\\\\\\\\\\\n    expect(result.project.stories).toBe(before.stories)\\\\\\\\\\\\\\\\n    expect(result.project.sections).toBe(before.sections)\\\\\\\\\\\\\\\\n    expect(result.project.notes).toBe(before.notes)\\\\\\\\\\\\\\\\n    expect(result.project.unitMass).toBe(before.unitMass)\\\\\\\\\\\\\\\\n    expect(result.project.name).toBe(before.name)\\\\\\\\\\\\\\\\n    expect(result.project.schemaVersion).toBe(before.schemaVersion)\\\\\\\\\\\\\\\\n    expect(JSON.parse(JSON.stringify(result.project))).toEqual(result.project)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('applyStbStories', () => {\\\\\\\\\\\\\\\\n  it('rejects an empty story candidate without touching the project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const result = applyStbStories(projectWithMember, {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      stories: [],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?롥숃짒?ゃ걮',\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('rejects story replacement while members exist, preserving the original reference', () => {\\\\\\\\\\\\\\\\n    const result = applyStbStories(\\\\\\\\\\\\\\\\n      projectWithMember,\\\\\\\\\\\\\\\\n      candidateFor('dotnet-sample1.json'),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖??,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('applies the real candidate from bottom to top and leaves the grid unchanged', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('dotnet-sample1.json')\\\\\\\\\\\\\\\\n    const result = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(result.project.grid).toBe(emptyProject.grid)\\\\\\\\\\\\\\\\n    expect(result.project.stories).toEqual([\\\\\\\\\\\\\\\\n      { id: 'story-1', name: '1FL', height: 5000 },\\\\\\\\\\\\\\\\n      { id: 'story-2', name: '2FL', height: 4200 },\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\n    expect(result.project.stories[0]?.name).toBe('1FL')\\\\\\\\\\\\\\\\n    expect(result.project.name).toBe(emptyProject.name)\\\\\\\\\\\\\\\\n    expect(result.project.sections).toBe(emptyProject.sections)\\\\\\\\\\\\\\\\n    expect(result.project.notes).toBe(emptyProject.notes)\\\\\\\\\\\\\\\\n    expect(JSON.parse(JSON.stringify(result.project))).toEqual(result.project)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('does not block approval merely because the candidate carries an issue', () => {\\\\\\\\\\\\\\\\n    const candidate: StbSkeletonCandidate = {\\\\\\\\\\\\\\\\n      ...candidateFor('mini.json'),\\\\\\\\\\\\\\\\n      issues: ['?싥굤??퐤營?겏影?밤겗訝띴???],\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(applyStbGrid(emptyProject, candidate).applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(applyStbStories(emptyProject, candidate).applied).toBe(true)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('does not share the candidate story array with the applied project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const result = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.project.stories).not.toBe(candidate.stories)\\\\\\\\\\\\\\\\n    expect(result.project.stories[0]).not.toBe(candidate.stories[0])\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('application result invariants', () => {\\\\\\\\\\\\\\\\n  it('maps exactly one X and one Y grid without assuming their input order', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const shuffled = { ...candidate, grids: [...candidate.grids].reverse() }\\\\\\\\\\\\\\\\n    const result = applyStbGrid(emptyProject, shuffled)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    const { x, y } = gridCandidate(shuffled)\\\\\\\\\\\\\\\\n    expect(result.project.grid.xSpans).toEqual(x.spansMm)\\\\\\\\\\\\\\\\n    expect(result.project.grid.ySpans).toEqual(y.spansMm)\\\\\\\\\\\\\\\\n    expect(result.project.grid.xLabels).toEqual(x.axes.map(({ label }) => label))\\\\\\\\\\\\\\\\n    expect(result.project.grid.yLabels).toEqual(y.axes.map(({ label }) => label))\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- vitest.config.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync } from 'node:fs'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { fileURLToPath } from 'node:url'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport react from '@vitejs/plugin-react'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { defineConfig } from 'vitest/config'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst yamlRawPlugin = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: 'yaml-raw',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  load(id: string) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const path = id.split('?', 1)[0]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (!path.endsWith('.yaml')) return null\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return `export default ${JSON.stringify(readFileSync(path, 'utf8'))}`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst aliases = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  '@': fileURLToPath(new URL('./src', import.meta.url)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\