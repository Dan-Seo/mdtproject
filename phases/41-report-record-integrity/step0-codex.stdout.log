\\\\n          \\\\\\\"X2\\\\\\\",\\\\r\\\\n          \\\\\\\"X3\\\\\\\",\\\\r\\\\n          \\\\\\\"X4\\\\\\\"\\\\r\\\\n        ],\\\\r\\\\n        \\\\\\\"spansMm\\\\\\\": [\\\\r\\\\n          5850,\\\\r\\\\n          5150,\\\\r\\\\n          7175,\\\\r\\\\n          3825\\\\r\\\\n        ],\\\\r\\\\n        \\\\\\\"totalMm\\\\\\\": 22000\\\\r\\\\n      },\\\\r\\\\n      \\\\\\\"levelsBottomNote\\\\\\\": \\\\\\\"phase 37의 부분 전사다. phase 38(2026-09-04)에서 300dpi 크롭(위 블록 clip x80-340 y100-320, 아래 블록 y590-810)을 다시 읽어 최상단 두 레벨까지 확정했고, levels·heightsMm이 전 계열이다. levelsBottom·heightsBottomMm은 그 전 계열의 뒤쪽 부분집합이라 그대로 참이다.\\\\\\\",\\\\r\\\\n      \\\\\\\"titles\\\\\\\": [\\\\r\\\\n        \\\\\\\"Y3通り軸組図 S=1/100\\\\\\\"\\\\r\\\\n      ]\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"titles\\\\\\\": [\\\\r\\\\n        \\\\\\\"Y1通り軸組図 S=1/100\\\\\\\",\\\\r\\\\n        \\\\\\\"Y2通り軸組図 S=1/100\\\\\\\"\\\\r\\\\n      ],\\\\r\\\\n      \\\\\\\"levels\\\\\\\": [\\\\r\\\\n        \\\\\\\"パラペット天端\\\\\\\",\\\\r\\\\n        \\\\\\\"RFL(水下)\\\\\\\",\\\\r\\\\n        \\\\\\\"2FL\\\\\\\",\\\\r\\\\n        \\\\\\\"1FL\\\\\\\",\\\\r\\\\n        \\\\\\\"設計GL\\\\\\\",\\\\r\\\\n        \\\\\\\"基礎下端\\\\\\\"\\\\r\\\\n      ],\\\\r\\\\n      \\\\\\\"heightsMm\\\\\\\": [\\\\r\\\\n        600,\\\\r\\\\n        3500,\\\\r\\\\n        3500,\\\\r\\\\n        150,\\\\r\\\\n        1170\\\\r\\\\n      ],\\\\r\\\\n      \\\\\\\"note\\\\\\\": \\\\\\\"위 블록이다. 아래 블록(Y3)과 레벨 계열이 같다 — 300dpi 크롭 두 장에서 각각 읽었다. 通り芯 스팬은 이 블록에서 전사하지 않았다.\\\\\\\"\\\\r\\\\n    }\\\\r\\\\n  ],\\\\r\\\\n  \\\\\\\"notes\\\\\\\": [\\\\r\\\\n    \\\\\\\"2026-09-04 정정: 「2FL 위 최상단 레벨 라벨 미확정」은 해소됐다 — 300dpi 크롭에서 ▽パラペット天端·▽RFL(水下)와 그 사이 600을 읽었다. 7,750은 パラペット天端→設計GL의 合計(600+3500+3500+150)이고 스팬이 아니다\\\\\\\",\\\\r\\\\n    \\\\\\\"같은 열에 보조 레벨이 있다: 梁天端(水下) = 2FL−270, 1SL = 1FL와 같은 높이, 基礎梁天端·B.PL下端은 1FL 아래 20〜250\\\\\\\",\\\\r\\\\n    \\\\\\\"X1 왼쪽에 胴縁芯↔柱面 80 치수가 있다 — 스팬이 아니다. 용지 A1 /Rotate 90\\\\\\\",\\\\r\\\\n    \\\\\\\"위 블록(캡션 Y1·Y2)과 아래 블록(캡션 Y3)의 레벨 계열은 같다 — 두 크롭에서 각각 확인했다\\\\\\\"\\\\r\\\\n  ]\\\\r\\\\n}\\\\r\\\\n--- GOLDEN P22 ---\\\\r\\\\n{\\\\r\\\\n  \\\\\\\"$comment\\\\\\\": \\\\\\\"원문 독립 전사 (ADR-010 준용) — 300dpi 크롭(clip x80-420 y100-330)과 표제란 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 階高는 위→아래 인접 레벨 사이 mm다. 이 면은 레벨 계열만 전사했다 — 通り芯 스팬은 전사하지 않았다.\\\\\\\",\\\\r\\\\n  \\\\\\\"source\\\\\\\": {\\\\r\\\\n    \\\\\\\"cacheFile\\\\\\\": \\\\\\\"dwg-tsu-kanritou.pdf\\\\\\\",\\\\r\\\\n    \\\\\\\"sha256\\\\\\\": \\\\\\\"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\\\\\\\",\\\\r\\\\n    \\\\\\\"issuer\\\\\\\": \\\\\\\"三重県津市\\\\\\\",\\\\r\\\\n    \\\\\\\"project\\\\\\\": \\\\\\\"旧津市民プール跡地テニスコート整備工事 管理棟\\\\\\\",\\\\r\\\\n    \\\\\\\"sheet\\\\\\\": \\\\\\\"S-22 軸組図(2)\\\\\\\",\\\\r\\\\n    \\\\\\\"page\\\\\\\": 22,\\\\r\\\\n    \\\\\\\"transcribedAt\\\\\\\": \\\\\\\"2026-09-04\\\\\\\"\\\\r\\\\n  },\\\\r\\\\n  \\\\\\\"notes\\\\\\\": [\\\\r\\\\n    \\\\\\\"S-21(軸組図(1))과 같은 레벨 계열이다 — 600·3,500·3,500·150·1,170\\\\\\\",\\\\r\\\\n    \\\\\\\"7,750은 パラペット天端→設計GL의 合計이고 스팬이 아니다\\\\\\\",\\\\r\\\\n    \\\\\\\"같은 열 오른쪽에 보조 레벨이 있다: 1SL·基礎梁天端·B.PL下端(1FL 아래 20〜250). 用紙 A1 1/100\\\\\\\"\\\\r\\\\n  ],\\\\r\\\\n  \\\\\\\"elevations\\\\\\\": [\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"titles\\\\\\\": [\\\\r\\\\n        \\\\\\\"X1通り軸組図 S=1/100\\\\\\\",\\\\r\\\\n        \\\\\\\"X2通り軸組図 S=1/100\\\\\\\",\\\\r\\\\n        \\\\\\\"X3通り軸組図 S=1/100\\\\\\\"\\\\r\\\\n      ],\\\\r\\\\n      \\\\\\\"levels\\\\\\\": [\\\\r\\\\n        \\\\\\\"パラペット天端\\\\\\\",\\\\r\\\\n        \\\\\\\"RFL(水下)\\\\\\\",\\\\r\\\\n        \\\\\\\"2FL\\\\\\\",\\\\r\\\\n        \\\\\\\"1FL\\\\\\\",\\\\r\\\\n        \\\\\\\"設計GL\\\\\\\",\\\\r\\\\n        \\\\\\\"基礎下端\\\\\\\"\\\\r\\\\n      ],\\\\r\\\\n      \\\\\\\"heightsMm\\\\\\\": [\\\\r\\\\n        600,\\\\r\\\\n        3500,\\\\r\\\\n        3500,\\\\r\\\\n        150,\\\\r\\\\n        1170\\\\r\\\\n      ]\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"titles\\\\\\\": [\\\\r\\\\n        \\\\