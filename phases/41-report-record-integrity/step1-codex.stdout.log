{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport ast\nimport json\nimport subprocess\nfrom pathlib import Path\nscript=Path('scripts/check-citations.py').read_text(encoding='utf-8')\nassert len(script.splitlines())<=120\nold=subprocess.run(['git','show','HEAD:scripts/check-citations.py'],capture_output=True,check=True).stdout.decode('utf-8')\ndef functions(text):return {n.name:ast.dump(n) for n in ast.parse(text).body if isinstance(n,ast.FunctionDef)}\nbefore,after=functions(old),functions(script)\nfor name in ['sources','require_file','read_json','resolve','failure']:assert before[name]==after[name],name\nprint('Source checking helpers unchanged; checker has',len(script.splitlines()),'lines.')\nfor file in Path('phases').glob('*/step*-report*.json'):\n    if file.as_posix()=='phases/41-report-record-integrity/step1-report.json':continue\n    prior=subprocess.run(['git','show','HEAD:'+file.as_posix()],capture_output=True,check=True).stdout.decode('utf-8-sig')\n    assert file.read_text(encoding='utf-8-sig')==prior.replace('\\\\r\\\\n','\\\\n'),file\nprint('All 125 historical reports unchanged from HEAD (Git-normalized line endings).')\nagents=Path('AGENTS.md').read_text(encoding='utf-8')\nclaude=Path('CLAUDE.md').read_text(encoding='utf-8')\nassert agents.splitlines()[5:]==claude.splitlines()[2:]\nfor file in ['AGENTS.md','CLAUDE.md']:\n    current=Path(file).read_text(encoding='utf-8').splitlines()\n    original=subprocess.run(['git','show','HEAD:'+file],capture_output=True,check=True).stdout.decode('utf-8').splitlines()\n    added=[line for line in current if line not in original]\n    assert len(added)==1 and len(current)==len(original)+1\n    assert '#/mutation_census_note' in added[0] and '?' in added[0]\n    assert [line for line in current if line not in added]==original\nprint('Exactly one matching guardrail line added to each