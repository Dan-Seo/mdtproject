{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport json, re, subprocess, hashlib\nfrom pathlib import Path\nbase = subprocess.check_output(['git','rev-parse','746329f\"'^'\"'],text=True).strip()\nhead = subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()\ndef read(f): return json.loads(Path(f).read_text(encoding='utf-8-sig'))\ndef at(v,p):\n for k in p.lstrip('/').split('/'):\n  k=k.replace('~1','/').replace('~0','~')\n  v=v[int(k)] if isinstance(v,list) else v[k]\n return v\ndef sha(s): return hashlib.sha256(s.encode('utf-8')).hexdigest()\ns0=read('phases/41-report-record-integrity/step0-report.json')\nrecords=[]\nfor i,r in enumerate(s0['restorations']):\n raw=Path(r['log']['file']).read_bytes()\n event=json.loads(raw.decode('utf-8-sig').splitlines()[r['log']['line']-1])\n cmd=event['item']['command']\n pattern=[r\\\"\\\\bsummary\\\\s*:\\\\s*'([\"'^'\"']*)'\\\",r\\\"\\\\bmethod:'([\"'^'\"']*)'\\\",r\\\"\\\\bscope:'([\"'^'\"']*)'\\\",r\\\"report\\\\.summary='([\"'^'\"']*)'\\\"][i]\n matches=re.findall(pattern,cmd)\n assert len(matches)==1, (i,len(matches))\n extracted=matches[0]\n restored=at(read(r['file']),r['pointer'])\n old=json.loads(subprocess.check_output(['git','show',base+':'+r['file']]))\n before=at(old,r['pointer'])\n skeleton=''.join(c if ord(c)<128 else '?' for c in extracted)\n records.append({'file':r['file'],'pointer':r['pointer'],'log_file':r['log']['file'],'log_line':r['log']['line'],\n 'log_event_id':event['item']['id'],'extraction_regex':pattern,'extracted_text':extracted,\n 'log_sha256':hashlib.sha256(raw).hexdigest(),'utf8_bytes':len(extracted.encode('utf-8')),\n 'restored_sha256':sha(restored),'extracted_sha256':sha(extracted),'stored_before_sha256':sha(r['stored_before']),\n 'equal_string':restored==extracted,'equal_utf8_bytes':restored.encode('utf-8')==extracted.encode('utf-8'),\n 'skeleton_matches_stored_before':skeleton==r['stored_before'],'stored_before_matches_prephase':before==r['stored_before']})\ndef differences(a,b,p=''):\n if type(a)\"'!=type(b): return [p]\n if isinstance(a,dict):\n  out=[]\n  for k in sorted(set(a)|set(b)):\n   sub=p+'\"'/'+k.replace('~','~0').replace('/','~1')\n   out += [sub] if k not in a or k not in b else differences(a[k],b[k],sub)\n  return out\n if isinstance(a,list):\n  out=[]\n  for i in range(max(len(a),len(b))):\n   sub=p+'/'+str(i)\n   out += [sub] if i>=len(a) or i>=len(b) else differences(a[i],b[i],sub)\n  return out\n return [] if a==b else [p]\ndiffs=[]\nfor f in sorted({r['file'] for r in s0['restorations']}):\n old=json.loads(subprocess.check_output(['git','show',base+':'+f]))\n changes=differences(old,read(f))\n declared=sorted(r['pointer'] for r in s0['restorations'] if r['file']==f)\n diffs.append({'file':f,'changed_pointers':changes,'declared_pointers':declared,'exact_set_equal':set(changes)==set(declared)})\nchanged=subprocess.check_output(['git','diff','--name-only',base],text=True).splitlines()\npath_checks=[{'path':f,'allowed_by':'phases/' if f.startswith('phases/') else f,\n 'allowed':f.startswith('phases/') or f in ('scripts/check-citations.py','AGENTS.md','CLAUDE.md')} for f in changed]\nref='phases/39-axis-claim/step4-report.json#/mutation_census_note'\nguards={}\nfor f in ('AGENTS.md','CLAUDE.md'):\n text=Path(f).read_text(encoding='utf-8-sig')\n matches=[{'line':n,'text':s} for n,s in enumerate(text.splitlines(),1) if ref in s]\n prior=subprocess.check_output(['git','show',base+':'+f]).decode('utf-8-sig')\n guards[f]={'matches':matches,'absent_prephase':ref not in prior}\nvalue=at(read(ref.split('#')[0]),ref.split('#')[1])\ncommands=[]\nfor f in ['phases/39-axis-claim/step0-report.attempt1.json','phases/40-citation-integrity/step3-report.json']:\n cmd=['python','scripts/check-citations.py',f]\n r=subprocess.run(cmd,capture_output=True,text=True,encoding='utf-8')\n commands.append({'command':' '.