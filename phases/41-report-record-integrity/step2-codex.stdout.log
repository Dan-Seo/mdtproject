{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n\nimport json,re,subprocess,hashlib\nfrom pathlib import Path\nBASE='0d1e674'\nSELF='phases/41-report-record-integrity/step2-report.json'\nSTEP0='phases/41-report-record-integrity/step0-report.json'\nverified=set()\ndef read(file):\n verified.add(file)\n return json.loads(Path(file).read_text(encoding='utf-8-sig'))\ndef ptr(v,p):\n for t in p.lstrip('/').split('/') if p else []:\n  t=t.replace('~1','/').replace('~0','~')\n  v=v[int(t)] if isinstance(v,list) else v[t]\n return v\ndef walk(v,p=''):\n if isinstance(v,dict):\n  for k,c in v.items():yield from walk(c,p+'/'+k.replace('~','~0').replace('/','~1'))\n elif isinstance(v,list):\n  for i,c in enumerate(v):yield from walk(c,p+'/'+str(i))\n elif isinstance(v,str):yield p,v\ndef baseline(file):\n return json.loads(subprocess.check_output(['git','show',BASE+':'+file]).decode('utf-8'))\ndef classification(file,p,v):\n runs=list(re.finditer(r'\\\\?{2,}',v))\n if '/pre_commit_status/' in p and v.startswith('?? '):\n  return 'captured_io','Git porcelain untracked-file status recorded verbatim.'\n if p.endswith('/command') or p.endswith('/stderr') or p.endswith('/test_diff/output'):\n  return 'captured_io','Recorded shell command, stderr, or git diff output; retained execution evidence.'\n if all(len(x.group())==2 for x in runs) and all(re.search(r'[A-Za-z0-9_)]+\\\\s*\"'$'\"',v[:x.start()]) and re.match(r\\\"\\\\s*(?:\\\\[\\\\]|''|'0'|new Set)\\\",v[x.end():]) for x in runs):\n  return 'original_literal','Quoted TypeScript nullish-coalescing operator with operands; prose around it remains intact.'\n return 'unclassified','No allowed explanation found by independent field-context review.'\nfiles=sorted(Path('phases').glob('*/step*-report*.json'))\nassert not Path(SELF).exists()\ndocs={f.as_posix():read(f.as_posix()) for f in files}\ns0=docs[STEP0]\nentries=[]\nfor f,d in docs.items():\n for p,v in walk(d):\n  runs=[{'start':m.start(),'length':len(m.group())} for m in re.finditer(r'\\\\?{2,}',v)]\n  if not runs:continue\n  extra={}\n  if f==STEP0 and re.fullmatch(r'/occurrences/\\\\d+/excerpt',p):\n   row=ptr(d,p.rsplit('/',1)[0])\n   old=ptr(baseline(row['file']),row['pointer'])\n   matched=v in old\n   kind,reason='captured_io','Historical report excerpt; independently matched against git show at the pre-phase commit, without using step 0 classification.'\n   extra={'origin_file':row['file'],'origin_pointer':row['pointer'],'git_revision':BASE,'excerpt_matches_git_value':matched}\n   if not matched:kind='unclassified'\n  elif f==STEP0 and re.fullmatch(r'/restorations/\\\\d+/stored_before',p):\n   row=ptr(d,p.rsplit('/',1)[0])\n   matched=v==ptr(baseline(row['file']),row['pointer'])\n   kind,reason='captured_io','Stored-before evidence is an exact snapshot of the historical report value returned by git show; it is not the restored live value.'\n   extra={'origin_file':row['file'],'origin_pointer':row['pointer'],'git_revision':BASE,'stored_before_matches_git_value':matched}\n   if not matched:kind='unclassified'\n  else:\n   kind,reason=classification(f,p,v)\n  if kind=='unclassified':\n   declarations=[x for x in s0['unrecoverable'] if isinstance(x,dict) and x.get('file')==f and x.get('pointer')==p and x.get('reason')]\n   if declarations:kind,reason='declared_unrecoverable',declarations[0]['reason']\n  entries.append({'file':f,'pointer':p,'source':f+'#'+p,'classification':kind,'reason':reason,'runs':runs,'value_sha256':hashlib.sha256(v.encode('utf-8')).hexdigest(),**extra})\ncounts={k:sum(e['classification']==k for e in entries) for k in ['captured_io','original_literal','declared_unrecoverable','unclassified']}\nprint(json.dumps({'scan_glob':'phases/*/step*-report*.json','scan_timing':'Before creating this verification report; no report was excluded from the 126-file input set. This report records run offsets and citations instead of copying matching strings.','files_scanned':len(files),'matching_string_values':len(entries),'question_mark_runs':sum(len(e['runs']) for e in entries),'classification_counts':counts,'step0_classifications_used':False,'unrecoverable_declarations':len(s0['unrecoverable']),'items':entries,'paths_verified':sorted(verified)},ensure_ascii=True))\n\n'@ | python -X utf8 -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
