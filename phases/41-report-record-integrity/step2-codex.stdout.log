"file\": \"phases/40-citation-integrity/step1-codex.stdout.log\", \"line\": 52}, \"skeleton_match\": true}], \"unrecoverable\": []}\r\n{\"step\": 1, \"keys\": [\"phase\", \"step\", \"step_name\", \"status\", \"summary\", \"implementation\", \"guardrail\", \"validation\", \"limitations\", \"paths_verified\", \"census\"]}\r\n{\"phase\": \"41-report-record-integrity\", \"step\": 1, \"step_name\": \"path-claim-check\", \"status\": \"completed\", \"summary\": \"114\\uc904 \\uac80\\uc0ac\\uae30\\uc5d0 \\uc120\\uc5b8\\ub41c \\uacbd\\ub85c \\uc8fc\\uc7a5 \\ub300\\uc870\\ub97c \\ucd94\\uac00\\ud558\\uace0 \\uac00\\ub4dc\\ub808\\uc77c\\uc744 \\ub3d9\\uae30\\ud654\\ud588\\ub2e4. \\ubc18\\uc99d 2\\uac74\\u00b737\\ud56d\\ubaa9\\u00b7lint \\ud1b5\\uacfc, report 126\\uac1c \\uc804\\uc218 \\uc9d1\\uacc4(paths_verified 292\\u00b7expected_absent 6\\u00b7source 263), \\uae30\\uc874 \\uc2e4\\ud328 9\\uac1c \\ubcf4\\uc874.\", \"implementation\": {\"file\": \"scripts/check-citations.py\", \"line_count\": 114, \"dependencies\": \"Python standard library only\", \"behavior\": [\"Recursively inspect only list-valued paths_verified, paths_expected_absent and fabricated_paths declarations.\", \"paths_verified accepts a string or an object with path; only exists:false claims absence, and an omitted exists claims presence.\", \"paths_expected_absent and fabricated_paths always claim absence, including object entries.\", \"Path.exists() accepts regular files and directories. Relative claim paths use the repository root; report arguments/globs use cwd.\", \"Source traversal, regular-file checks and JSON pointer resolution are unchanged.\"], \"diagnostics\": [\"path_claim_missing\", \"path_claim_unexpected\", \"path_claim_invalid\"]}, \"guardrail\": {\"files\": [\"AGENTS.md\", \"CLAUDE.md\"], \"source\": \"phases/39-axis-claim/step4-report.json#/mutation_census_note\", \"change\": \"\\uac80\\uc99d \\uba85\\ub839\\uc758 \\uc778\\uc790\\uc5d0 \\ud55c\\uae00\\u00b7\\uc77c\\ubcf8\\uc5b4\\ub97c \\ub123