"\r\n    ],\r\n    \"diagnostics\": [\r\n      \"path_claim_missing\",\r\n      \"path_claim_unexpected\",\r\n      \"path_claim_invalid\"\r\n    ]\r\n  },\r\n  \"guardrail\": {\r\n    \"files\": [\r\n      \"AGENTS.md\",\r\n      \"CLAUDE.md\"\r\n    ],\r\n    \"source\": \"phases/39-axis-claim/step4-report.json#/mutation_census_note\",\r\n    \"change\": \"검증 명령의 인자에 한글·일본어를 넣지 않고 파일 단위 실행 후 JSON 리포터 출력에서 결과를 고르도록 개발 프로세스에 같은 항목을 추가했다.\",\r\n    \"synchronization\": \"AGENTS.md-only copy notice is preserved; all body lines match CLAUDE.md.\"\r\n  },\r\n  \"validation\": {\r\n    \"baseline_head\": \"eccef47\",\r\n    \"tdd\": {\r\n      \"method\": \"The same temporary-fixture subprocess assertions ran before and after implementation; no persistent test file or existing test changed.\",\r\n      \"command\": \"@'\\nimport json\\nimport subprocess\\nimport sys\\nimport tempfile\\nfrom pathlib import Path\\n\\nroot = Path.cwd()\\nchecker = root / 'scripts/check-citations.py'\\ncases = []\\nwith tempfile.TemporaryDirectory(prefix='kijun-path-claims-') as name:\\n    folder = Path(name)\\n    report = folder / 'report.json'\\n    target = folder / 'target.json'\\n    target.write_text('{\\\"array\\\":[null],\\\"a/b\\\":{\\\"~\\\":false},\\\"\\\":0}', encoding='utf-8')\\n    plain = folder / 'plain.txt'\\n    plain.write_text('not json', encoding='utf-8')\\n    missing = str(folder / 'missing.json')\\n    def check(label, data, code=0, reasons=(), cwd=root):\\n        report.write_text(json.dumps(data), encoding='utf-8')\\n        result = subprocess.run([sys.executable, str(checker), str(report)],\\n                                cwd=cwd, capture_output=True, text=True, encoding='utf-8')\\n        actual = [json.loads(line)['reason'].split(':')[0] for line in result.stdout.splitlines()]\\n        passed = result.returncode == code and actual == list(reasons) and not result.stderr\\n        cases.append(dict(name=label, expected_exit_code=code, exit_code=result.returncode,\\n                          expected_reasons=list(reasons), stdout=result.stdout, stderr=result.stderr, passed=passed))\\n    check('verified string file', {'paths_verified':[str(plain)]})\\n    check('verified object exists true', {'paths_verified':[{'path':str(plain),'exists':True}]})\\n    check('verified object default present', {'paths_verified':[{'path':str(plain),'checked':True}]})\\n    check('verified string directory', {'paths_verified':[str(folder)]})\\n    check('verified object directory', {'paths_verified':[{'path':str(folder)}]})\\n    check('verified string missing', {'paths_verified':[missing]}, 1, ['path_claim_missing'])\\n    check('verified object missing', {'paths_verified':[{'path':missing}]}, 1, ['path_claim_missing'])\\n    check('verified true missing', {'paths_verified':[{'path':missing,'exists':True}]}, 1, ['path_claim_missing'])\\n    check('verified false missing', {'paths_verified':[{'path':missing,'exists':False}]})\\n    check('verified false file', {'paths_verified':[{'path':str(plain),'exists':False}]}, 1, ['path_claim_unexpected'])\\n    check('verified false directory', {'paths_verified':[{'path':str(folder),'exists':False}]}, 1, ['path_claim_unexpected'])\\n    for field in ['paths_expected_absent','fabricated_paths']:\\n        check(field+' missing string', {field:[missing]})\\n        check(field+' missing object', {field:[{'path':missing,'exists':False}]})\\n        check(field+' existing file', {field:[str(plain)]}, 1, ['path_claim_unexpected'])\\n        check(field+' existing directory', {field:[{'path':str(folder)}]}, 1, ['path_claim_unexpected'])\\n        check(field+' overrides exists true', {field:[{'path':str(plain),'exists':True}]}, 1, ['path_claim_unexpected'])\\n    check('nested declarations', {'items':[{'evidence':{'paths_verified':[missing]}}]}, 1, ['path_claim_missing'])\\n    check('undeclared path text ignored', {'fixture':missing,'path':missing,'commands':[missing],'notes':missing})\\n    check('non-list declaration ignored', {'paths_verified':missing})\\n    check('root relative independent of cwd', {'paths_verified':['scripts']}, cwd=folder)\\n    check('source directory stays invalid', {'source':str(folder)}, 1, ['file_missing'])\\n    check('source plain regular file', {'source':str(plain)})\\n    check('source missing', {'source':missing}, 1, ['file_missing'])\\n    check('source pointer null', {'nested':[{'source':str(target)+'#/array/0'}]})\\n    check('source pointer escapes', {'source':str(target)+'#/a~1b/~0'})\\n    check('source empty key', {'source':str(target)+'#/'})\\n    check('source root pointer', {'source':str(target)+'#'})\\n    check('source bad key', {'source':str(target)+'#/missing'}, 1, ['missing_key'])\\n    check('source bad index', {'source':str(target)+'#/array/1'}, 1, ['array_index'])\\n    check('source invalid pointer', {'source':str(target)+'#x'}, 1, ['invalid_pointer'])\\n    check('source invalid JSON', {'source':str(plain)+'#/x'}, 1, ['json_parse_error'])\\n    check('both kinds reported', {'source':missing,'paths_verified':[missing]}, 1, ['file_missing','path_claim_missing'])\\nfailures = [c['name'] for c in cases if not c['passed']]\\nprint(json.dumps(dict(total=len(cases), passed=len(cases)-len(failures), failed=failures, cases=cases)))\\nsys.exit(bool(failures))\\n'@ | python -X utf8 -\",\r\n      \"red\": {\r\n        \"exit_code\": 1,\r\n        \"total\": 37,\r\n        \"passed\": 24,\r\n        \"failures\": [\r\n          {\r\n            \"name\": \"verified string missing\",\r\n            \"expected_exit_code\": 1,\r\n            \"exit_code\": 0,\r\n            \"expected_reasons\": [\r\n              \"path_claim_missing\"\r\n            ],\r\n            \"stdout\": \"\",\r\n            \"stderr\": \"\",\r\n            \"passed\": false\r\n          },\r\n          {\r\n            \"name\": \"verified object missing\",\r\n            \"expected_exit_code\": 1,\r\n            \"exit_code\": 0,\r\n            \"ex