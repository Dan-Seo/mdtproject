        \"paths_verified\": 15,\r\n          \"expected_absent\": 0,\r\n          \"source\": 39\r\n        },\r\n        \"diagnostics_count\": 0,\r\n        \"command\": \"python scripts/check-citations.py phases/40-citation-integrity/step0-report.json\",\r\n        \"exit_code\": 0,\r\n        \"stdout\": \"\",\r\n        \"stderr\": \"\"\r\n      },\r\n      {\r\n        \"file\": \"phases/40-citation-integrity/step1-report.json\",\r\n        \"counts\": {\r\n          \"paths_verified\": 0,\r\n          \"expected_absent\": 0,\r\n          \"source\": 1\r\n        },\r\n        \"diagnostics_count\": 0,\r\n        \"command\": \"python scripts/check-citations.py phases/40-citation-integrity/step1-report.json\",\r\n        \"exit_code\": 0,\r\n        \"stdout\": \"\",\r\n        \"stderr\": \"\"\r\n      },\r\n      {\r\n        \"file\": \"phases/40-citation-integrity/step2-report.json\",\r\n        \"counts\": {\r\n          \"paths_verified\": 0,\r\n          \"expected_absent\": 0,\r\n          \"source\": 31\r\n        },\r\n        \"diagnostics_count\": 0,\r\n        \"command\": \"python scripts/check-citations.py phases/40-citation-integrity/step2-report.json\",\r\n        \"exit_code\": 0,\r\n        \"stdout\": \"\",\r\n        \"stderr\": \"\"\r\n      },\r\n      {\r\n        \"file\": \"phases/40-citation-integrity/step3-report.json\",\r\n        \"counts\": {\r\n          \"paths_verified\": 0,\r\n          \"expected_absent\": 3,\r\n          \"source\": 2\r\n        },\r\n        \"diagnostics_count\": 0,\r\n        \"command\": \"python scripts/check-citations.py phases/40-citation-integrity/step3-report.json\",\r\n        \"exit_code\": 0,\r\n        \"stdout\": \"\",\r\n        \"stderr\": \"\"\r\n      },\r\n      {\r\n        \"file\": \"phases/40-citation-integrity/step4-report.attempt1.json\",\r\n        \"counts\": {\r\n          \"paths_verified\": 13,\r\n          \"expected_absent\": 0,\r\n          \"source\": 20\r\n        },\r\n  