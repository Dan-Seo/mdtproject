n,\r\n220: ): Section {\r\n221:   if (section.kind === '柱' && candidate.kind === '柱') {\r\n222:     return {\r\n223:       ...section,\r\n224:       mark: candidate.mark,\r\n225:       // 形状は寸法と一組で入る。「600φ」を b×d の枠に落とすと直径が辺長に\r\n226:       // なって周長が変わる — 片方だけ反映しない (ADR-027)\r\n227:       ...(candidate.shape === undefined ? {} : { shape: candidate.shape }),\r\n228:       ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n229:       ...(candidate.d === undefined ? {} : { d: candidate.d }),\r\n230:       ...(candidate.main === undefined\r\n231:         ? {}\r\n232:         : { main: { ...section.main, ...candidate.main } }),\r\n233:       ...(candidate.hoop === undefined\r\n234:         ? {}\r\n235:         : {\r\n236:             hoop: {\r\n237:               ...section.hoop,\r\n238:               size: candidate.hoop.size,\r\n239:               pitch: candidate.hoop.pitchMm,\r\n240:             },\r\n241:           }),\r\n242:     }\r\n243:   }\r\n244: \r\n245:   if (section.kind === '大梁' && candidate.kind === '大梁') {\r\n246:     const parsedMain = candidate.girderMainAsymmetric && girderDirection\r\n361:     if (slabDirection === undefined) return section\r\n362: \r\n363:     const xSource =\r\n364:       slabDirection === 'x' ? candidate.shortSide : candidate.longSide\r\n365:     const ySource =\r\n366:       slabDirection === 'x' ? candidate.longSide : candidate.shortSide\r\n367: \r\n368:     return {\r\n369:       ...section,\r\n370:       mark: candidate.mark,\r\n371:       ...(candidate.thickness === undefined\r\n372:         ? {}\r\n373:         : { thickness: candidate.thickness }),\r\n374:       x: {\r\n375:         ...section.x,\r\n376:         ...(xSource?.top === undefined\r\n377:           ? {}\r\n378:           : {\r\n379:               top: {\r\n380:                 ...section.x.top,\r\n381:                 size: xSource.top.size,\r\n382:                 pitch: xSource.top.pitchMm,\r\n383:               },\r\n384:             }),\r\n385:     