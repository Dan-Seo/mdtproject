가 같은 Section을 덮어쓰면 먼저 반영한 층의 배근이 사라진다 — 매칭 키는\r\n55:  * (符号, 部材, 階)다. 階를 符号에 붙이지는 않는다: 도면에 없는 符号이 内訳書에 그대로\r\n56:  * 나가고, 内訳書는 이미 階별로 묶여 있어 階가 두 번 표시된다.\r\n57:  */\r\n58: type ImportableSection =\r\n59:   | ColumnSection\r\n60:   | GirderSection\r\n61:   | WallSection\r\n62:   | SlabSection\r\n63: \r\n64: type SlabDirection = 'x' | 'y'\r\n65: type GirderDirection = 'first' | 'second'\r\n66: \r\n67: /**\r\n68:  * 「Y2端」のような軸名付きラベルだけを自動対応の対象にする。外端・内端は\r\n69:  * Gridのラベルと偶然一致しても、軸名として解釈してはならない (ADR-033) 。\r\n70:  */\r\n71: function axisNameFromEndLabel(label: string): string | undefined {\r\n72:   const value = compact(label)\r\n73:   if (!value.endsWith('端')) return undefined\r\n74:   const axisName = value.slice(0, -1)\r\n75:   return axisName === '' ? undefined : axisName\r\n76: }\r\n77: \r\n78: /**\r\n79:  * 断面リストの端部ラベルと同じ軸のGridラベルが両方見つかったときだけ、\r\n80:  * 軸インデックスの低い側を始端にする。比較の両辺は compact() を通す —\r\n81:  * framing-plan 側も同じ正規化を使うため、これは文字列の完全一致であって\r\n82:  * 도면 방향을 추정하는 휴리스틱이 아니다 (ADR-033) 。\r\n83:  */\r\n84: function automaticGirderDirection(\r\n85:   project: Project,\r\n86:   candidate: SectionCandidate,\r\n87: ): GirderDirection | undefined {\r\n88:   const asymmetric = candidate.girderMainAsymmetric\r\n89:   if (!asymmetric) return undefined\r\n90: \r\n91:   const axisNames = asymmetric.labels.map(axisNameFromEndLabel)\r\n92:   if (axisNames.some((axisName) => axisName === undefined)) return undefined\r\n93: \r\n94:   for (const labels of [project.grid.xLabels, project.grid.yLabels]) {\r\n95:     if (!labels) continue\r\n96:     const indexes = axisNames.map((axisName) =>\r\n97:       labels.findIndex((label) => compact(label) === axisName),\r\n98:     )\r\n99:     if (indexes.every((index) => index >= 0) && indexes[0] !== indexes[1]) {\r\n100:       return indexes[0] < indexes[1] ? 'first' : 'second'\r\n101:     }\r\n102:   }\r\n103:   return undefined\r\n104: }\r\n105: \r\n106: function resolvedGirderDirection(\r\n107:   project: Project,\r\n108:   candidate: SectionCandidate,\r\n109:   selected?: GirderDirection,\r\n110: ): GirderDirection | undefined {\r\n111:   return selected ?? automaticGirderDirection(project, candidate)\r\n112: }\r\n113: \r\n114: function isImportableSection(section: Section): section is ImportableSection {\r\n115:   return (\r\n116:     section.kind === '柱' ||\r\n117:     section.kind === '大梁' ||\r\n118:     section.kind === '耐震壁' ||\r\n119:     section.kind === '床板'\r\n120:   )\r\n121: }\r\n122: \r\n123: function matchingSection(\r\n124:   project: Project,\r\n125:   candidate: SectionCandidate,\r\n126: ): ImportableSection | undefined {\r\n127:   if (candidate.kind === '対象外') return undefined\r\n128:   return project.sections\r\n129:     .filter(isImportableSection)\r\n130:     .find(\r\n131:       (section) =>\r\n132:         section.mark === candidate.mark &&\r\n133:         section.kind === candidate.kind &&\r\n134:         section.storyLabel === candidate.storyLabel,\r\n135:     )\r\n136: }\r\n137: \r\n138: function cloneSource(\r\n139:   project: Project,\r\n140:   candidate: SectionCandidate,\r\n141: ): ImportableSection | undefined {\r\n142:   if (candidate.kind === '対象外') return undefined\r\n143:   const sameKind = project.sections\r\n144:     .filter(isImportableSection)\r\n145:     .filter((section) => section.kind === candidate.kind)\r\n146:   // 같은 符号의 다른 階가 이미 있으면 그쪽이 복제원이다 — 파싱하지 않는\r\n147:   // fc·강종·노출·仕上げ·初期オフセット은 무관한 부재보다 같은 符号 쪽이 맞다\r\n148:   return (\r\n149:     sameKind.find((section) => section.mark === candidate.mark) ?? sameKind[0]\r\n150:   )\r\n151: }\r\n152: \r\n153: /**\r\n154:  * 신규 符号는 모든 배근·단면 칸이 파싱됐을 때만 반영을 허용한다 — 빈칸을 무관한\r\n155:  * 부재의 복제값으로 채워 물량에 넣으면 파서가 지킨 「지어내지 않는다」(ADR-012)가\r\n156:  * UI에서 무너진다. 기존 Section에는 빈칸이 기존값 유지라 해당하지 않는다.\r\n157:  */\r\n158: function missingParsedFields(\r\n159:   candidate: SectionCandidate,\r\n160:   slabDirection?: SlabDirection,\r\n161:   girderDirection?: GirderDirection,\r\n162: ): boolean {\r\n163:   if (candidate.kind === '柱'