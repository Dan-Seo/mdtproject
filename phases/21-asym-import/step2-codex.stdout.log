{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Raw src/components/section/SectionImport.tsx; Get-Content -Raw src/components/section/SectionTable.tsx'","aggregated_output":"'use client'\r\n\r\nimport {\r\n  useMemo,\r\n  useRef,\r\n  useState,\r\n  type ChangeEvent,\r\n} from 'react'\r\n\r\nimport {\r\n  sectionMarkLabel,\r\n  type ColumnSection,\r\n  type GirderSection,\r\n  type SlabSection,\r\n  type Section,\r\n  type WallSection,\r\n} from '@/domain/model/member'\r\nimport type { Project } from '@/domain/model/project'\r\nimport { extractTextPages } from '@/lib/import/pdf-text'\r\nimport { parseSectionLists } from '@/lib/import/section-list/parse'\r\nimport type {\r\n  ListIssue,\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from '@/lib/import/section-list/types'\r\nimport { t } from '@/lib/i18n'\r\nimport { useAppStore, type Locale } from '@/lib/store'\r\n\r\nimport styles from './SectionImport.module.css'\r\n\r\ninterface SectionImportProps {\r\n  /** pdf.js ?놁씠 TextPage ?쎌뒪泥섎? 二쇱엯?섎뒗 而댄룷?뚰듃 ?뚯뒪?몄슜 寃쎄퀎. */\r\n  initialPages?: TextPage[]\r\n  extractPages?(file: File): Promise<TextPage[]>\r\n}\r\n\r\ninterface CandidateRow {\r\n  id: string\r\n  candidate: SectionCandidate\r\n}\r\n\r\nfunction parsedCandidates(lists: ParsedSectionList[]): CandidateRow[] {\r\n  return lists.flatMap((list, listIndex) =>\r\n    list.candidates.map((candidate, candidateIndex) => ({\r\n      id: `${listIndex}-${candidateIndex}`,\r\n      candidate,\r\n    })),\r\n  )\r\n}\r\n\r\n/**\r\n * ?롫퀎 ?꾨낫媛 媛숈? Section????뼱?곕㈃ 癒쇱? 諛섏쁺??痢듭쓽 諛곌렐???щ씪吏꾨떎 ??留ㅼ묶 ?ㅻ뒗\r\n * (寧?뤇, ?ⓩ쓲, ???? ?롫? 寧?뤇??遺숈씠吏???딅뒗?? ?꾨㈃???녿뒗 寧?뤇???낁㉢?몄뿉 洹몃?濡?\n * ?섍?怨? ?낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n */\r\ntype ImportableSection =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\ntype SlabDirection = 'x' | 'y'\r\n\r\nfunction isImportableSection(section: Section): section is ImportableSection {\r\n  return (\r\n    section.kind === '?? ||\r\n    section.kind === '鸚㎪쥈' ||\r\n    section.kind === '?먬쐡鶯? ||\r\n    section.kind === '佯딀씮'\r\n  )\r\n}\r\n\r\nfunction matchingSection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  return project.sections\r\n    .filter(isImportableSection)\r\n    .find(\r\n      (section) =>\r\n        section.mark === candidate.mark &&\r\n        section.kind === candidate.kind &&\r\n        section.storyLabel === candidate.storyLabel,\r\n    )\r\n}\r\n\r\nfunction cloneSource(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  const sameKind = project.sections\r\n    .filter(isImportableSection)\r\n    .filter((section) => section.kind === candidate.kind)\r\n  // 媛숈? 寧?뤇???ㅻⅨ ?롪? ?대? ?덉쑝硫?洹몄そ??蹂듭젣?먯씠?????뚯떛?섏? ?딅뒗\r\n  // fc쨌媛뺤쥌쨌?몄텧쨌餓뺜툓?뮻룟닜?잆궕?뺛궩?껁깉? 臾닿???遺?щ낫??媛숈? 寧?뤇 履쎌씠 留욌떎\r\n  return (\r\n    sameKind.find((section) => section.mark === candidate.mark) ?? sameKind[0]\r\n  )\r\n}\r\n\r\n/**\r\n * ?좉퇋 寧?뤇??紐⑤뱺 諛곌렐쨌?⑤㈃ 移몄씠 ?뚯떛?먯쓣 ?뚮쭔 諛섏쁺???덉슜?쒕떎 ??鍮덉뭏??臾닿???\n * 遺?ъ쓽 蹂듭젣媛믪쑝濡?梨꾩썙 臾쇰웾???ｌ쑝硫??뚯꽌媛 吏???뚯??대궡吏 ?딅뒗?ㅳ?ADR-012)媛\r\n * UI?먯꽌 臾대꼫吏꾨떎. 湲곗〈 Section?먮뒗 鍮덉뭏??湲곗〈媛??좎????대떦?섏? ?딅뒗??\r\n */\r\nfunction missingParsedFields(\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n): boolean {\r\n  if (candidate.kind === '??) {\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.d === undefined ||\r\n      candidate.main === undefined ||\r\n      candidate.hoop === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '鸚㎪쥈') {\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.depth === undefined ||\r\n      candidate.girderMain === undefined ||\r\n      candidate.stirrup === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    return (\r\n      candidate.thickness === undefined ||\r\n      candidate.layers === undefined ||\r\n      candidate.vertical === undefined ||\r\n      candidate.horizontal === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '佯딀씮') {\r\n    return (\r\n      slabDirection === undefined ||\r\n      candidate.thickness === undefined ||\r\n      candidate.shortSide?.top === undefined ||\r\n      candidate.shortSide?.bottom === undefined ||\r\n      candidate.longSide?.top === undefined ||\r\n      candidate.longSide?.bottom === undefined\r\n    )\r\n  }\r\n  return true\r\n}\r\n\r\nfunction uniqueSectionId(project: Project, mark: string): string {\r\n  const base = `section-${mark}`\r\n  if (!project.sections.some(({ id }) => id === base)) return base\r\n\r\n  let suffix = 2\r\n  while (project.sections.some(({ id }) => id === `${base}-${suffix}`)) {\r\n    suffix += 1\r\n  }\r\n  return `${base}-${suffix}`\r\n}\r\n\r\nfunction applyParsedFields(\r\n  section: Section,\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n): Section {\r\n  if (section.kind === '?? && candidate.kind === '??) {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      // 壤®듁???力뺛겏訝永꾠겎?γ굥?귙?00??띲굮 b횞d ??옞?ヨ맼?ⓦ걲?①쎍孃꾠걣渦븅빓??\n      // ?ゃ겂??뫅?룔걣鸚됥굩?????뉑뼶?졼걨?띷삝?쀣겒??(ADR-027)\r\n      ...(candidate.shape === undefined ? {} : { shape: candidate.shape }),\r\n      ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n      ...(candidate.d === undefined ? {} : { d: candidate.d }),\r\n      ...(candidate.main === undefined\r\n        ? {}\r\n        : { main: { ...section.main, ...candidate.main } }),\r\n      ...(candidate.hoop === undefined\r\n        ? {}\r\n        : {\r\n            hoop: {\r\n              ...section.hoop,\r\n              size: candidate.hoop.size,\r\n              pitch: candidate.hoop.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '鸚㎪쥈' && candidate.kind === '鸚㎪쥈') {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n      ...(candidate.depth === undefined ? {} : { depth: candidate.depth }),\r\n      ...(candidate.girderMain === undefined\r\n        ? {}\r\n        : {\r\n            main: {\r\n              ...section.main,\r\n              size: candidate.girderMain.size,\r\n              // 塋?깿轝꾠굮?곥겇烏ⓦ걽?묆걣塋?깿??쑍?겹굮?γ겓野꾠걪?쇻귝똻?잆겒?꾥〃??뀲?룔겎\r\n              // ?뚣걯?ф빊?ゃ겗?㏛릎鸚?겗?ㅳ굮?앫겗?얇겲塋?깿?ャ굚?γ굦?뗣귛랩?녈겎塋?깿??\n              // ?뺛걝烏ⓦ겘?뽧굤渦쇈겲?ゃ걚 ??parse.ts ??訝사춮塋?깿藥?뤂?면걬 ?㎫㈉轝꾠겓\r\n              // 餘뗣걲 (ADR-021)??\n              top: {\r\n                endCount:\r\n                  candidate.girderMain.endTopCount ??\r\n                  candidate.girderMain.topCount,\r\n                centerCount: candidate.girderMain.topCount,\r\n              },\r\n              bottom: {\r\n                endCount:\r\n                  candidate.girderMain.endBottomCount ??\r\n                  candidate.girderMain.bottomCount,\r\n                centerCount: candidate.girderMain.bottomCount,\r\n              },\r\n            },\r\n          }),\r\n      ...(candidate.stirrup === undefined\r\n        ? {}\r\n        : {\r\n            stirrup: {\r\n              ...section.stirrup,\r\n              size: candidate.stirrup.size,\r\n              pitch: candidate.stirrup.pitchMm,\r\n            },\r\n          }),\r\n      ...(candidate.sideBar === undefined\r\n        ? {}\r\n        : {\r\n            sideBar: {\r\n              size: candidate.sideBar.size,\r\n              count: candidate.sideBar.count,\r\n              // ?밭춮??퐰?룔겘?녜씊?ャ굚與숁틬餓뺞쭣??塋졼겓?귙겒?뤵??싧뎴6) ?뚦쭟??굥\r\n              // JASS 5 ?귝쐣?쇻꺕?ょ▶岳앫겎?귙굥?? ??쫸繹뽩ㅳ겎??겒?뤸쑋?ε뒟?뜻뀑?㎯?\n              // ?℡춼?ㅳ걣?귙굦?겼닶?②끹겗?ε뒟?ⓦ걮?╊퓷??(R9???괪ectionTable ??\n              // extraLengthMm ?? 0 ?ⓨ릪?섉돮?꾠겎?귙굥??\n              extraLengthMm: section.sideBar?.extraLengthMm ?? 0,\r\n            },\r\n          }),\r\n      ...(candidate.widthTie === undefined\r\n        ? {}\r\n        : {\r\n            widthTie: {\r\n              size: candidate.widthTie.size,\r\n              pitch: candidate.widthTie.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '?먬쐡鶯? && candidate.kind === '?먬쐡鶯?) {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.thickness === undefined\r\n        ? {}\r\n        : { thickness: candidate.thickness }),\r\n      ...(candidate.layers === undefined ? {} : { layers: candidate.layers }),\r\n      ...(candidate.vertical === undefined\r\n        ? {}\r\n        : {\r\n            vertical: {\r\n              ...section.vertical,\r\n              size: candidate.vertical.size,\r\n              pitch: candidate.vertical.pitchMm,\r\n            },\r\n          }),\r\n      ...(candidate.horizontal === undefined\r\n        ? {}\r\n        : {\r\n            horizontal: {\r\n              ...section.horizontal,\r\n              size: candidate.horizontal.size,\r\n              pitch: candidate.horizontal.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '佯딀씮' && candidate.kind === '佯딀씮') {\r\n    if (slabDirection === undefined) return section\r\n\r\n    const xSource =\r\n      slabDirection === 'x' ? candidate.shortSide : candidate.longSide\r\n    const ySource =\r\n      slabDirection === 'x' ? candidate.longSide : candidate.shortSide\r\n\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.thickness === undefined\r\n        ? {}\r\n        : { thickness: candidate.thickness }),\r\n      x: {\r\n        ...section.x,\r\n        ...(xSource?.top === undefined\r\n          ? {}\r\n          : {\r\n              top: {\r\n                ...section.x.top,\r\n                size: xSource.top.size,\r\n                pitch: xSource.top.pitchMm,\r\n              },\r\n            }),\r\n        ...(xSource?.bottom === undefined\r\n          ? {}\r\n          : {\r\n              bottom: {\r\n                ...section.x.bottom,\r\n                size: xSource.bottom.size,\r\n                pitch: xSource.bottom.pitchMm,\r\n              },\r\n            }),\r\n      },\r\n      y: {\r\n        ...section.y,\r\n        ...(ySource?.top === undefined\r\n          ? {}\r\n          : {\r\n              top: {\r\n                ...section.y.top,\r\n                size: ySource.top.size,\r\n                pitch: ySource.top.pitchMm,\r\n              },\r\n            }),\r\n        ...(ySource?.bottom === undefined\r\n          ? {}\r\n          : {\r\n              bottom: {\r\n                ...section.y.bottom,\r\n                size: ySource.bottom.size,\r\n                pitch: ySource.bottom.pitchMm,\r\n              },\r\n            }),\r\n      },\r\n    }\r\n  }\r\n\r\n  return section\r\n}\r\n\r\n/** 筽뉓＝?껋쓽 ???쒓린媛 ?꾨낫???몃젮?ㅼ? ?딄쾶 ?쒕떎 ???롮쓽 洹쇨굅???꾨낫 履쎈퓧?대떎. */\r\nfunction withCandidateStory(\r\n  section: Section,\r\n  candidate: SectionCandidate,\r\n): Section {\r\n  const next = { ...section }\r\n  if (candidate.storyLabel === undefined) delete next.storyLabel\r\n  else next.storyLabel = candidate.storyLabel\r\n  return next\r\n}\r\n\r\nfunction applyCandidate(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n): Project {\r\n  if (candidate.kind === '野얕괌鸚?) return project\r\n  if (candidate.kind === '佯딀씮' && slabDirection === undefined) return project\r\n\r\n  const existing = matchingSection(project, candidate)\r\n  if (existing) {\r\n    return {\r\n      ...project,\r\n      sections: project.sections.map((section) =>\r\n        section.id === existing.id\r\n          ? applyParsedFields(section, candidate, slabDirection)\r\n          : section,\r\n      ),\r\n    }\r\n  }\r\n\r\n  const source = cloneSource(project, candidate)\r\n  if (!source || missingParsedFields(candidate, slabDirection)) return project\r\n  // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎 ???롫? ?욎뼱 癒쇱? 醫곹엺??\n  const id = uniqueSectionId(\r\n    project,\r\n    candidate.storyLabel\r\n      ? `${candidate.mark}-${candidate.storyLabel}`\r\n      : candidate.mark,\r\n  )\r\n  const clonedSource: ImportableSection =\r\n    source.kind === '??\r\n      ? { ...source, id, main: { ...source.main }, hoop: { ...source.hoop } }\r\n      : source.kind === '鸚㎪쥈'\r\n        ? {\r\n            ...source,\r\n            id,\r\n            main: { ...source.main },\r\n            stirrup: { ...source.stirrup },\r\n          }\r\n        : source.kind === '?먬쐡鶯?\r\n          ? {\r\n              ...source,\r\n              id,\r\n              vertical: { ...source.vertical },\r\n              horizontal: { ...source.horizontal },\r\n            }\r\n          : {\r\n              ...source,\r\n              id,\r\n              x: {\r\n                top: { ...source.x.top },\r\n                bottom: { ...source.x.bottom },\r\n              },\r\n              y: {\r\n                top: { ...source.y.top },\r\n                bottom: { ...source.y.bottom },\r\n              },\r\n            }\r\n  const cloned = withCandidateStory(\r\n    applyParsedFields(clonedSource, candidate, slabDirection),\r\n    candidate,\r\n  )\r\n\r\n  return { ...project, sections: [...project.sections, cloned] }\r\n}\r\n\r\nfunction sectionSummary(section: ImportableSection): string {\r\n  if (section.kind === '??) {\r\n    const dimension =\r\n      section.shape === '?녶숱' ? `${section.b}?` : `${section.b}횞${section.d}`\r\n    return `${sectionMarkLabel(section)} / ${dimension} / ${section.main.count}-${section.main.size} / ${section.hoop.size}@${section.hoop.pitch}`\r\n  }\r\n  if (section.kind === '鸚㎪쥈') {\r\n    const { top, bottom } = section.main\r\n    return `${sectionMarkLabel(section)} / ${section.b}횞${section.depth} / 訝?{top.endCount}竊?{top.centerCount}?삡툔${bottom.endCount}竊?{bottom.centerCount}-${section.main.size} / ${section.stirrup.size}@${section.stirrup.pitch}`\r\n  }\r\n  if (section.kind === '?먬쐡鶯?) {\r\n    return `${sectionMarkLabel(section)} / 鶯곩럻${section.thickness} / ${section.layers}掠?/ 潁?춮 ${section.vertical.size}@${section.vertical.pitch} / 與ょ춮 ${section.horizontal.size}@${section.horizontal.pitch}`\r\n  }\r\n  return `${sectionMarkLabel(section)} / ?욕럻${section.thickness} / X 訝?{section.x.top.size}@${section.x.top.pitch}?삡툔${section.x.bottom.size}@${section.x.bottom.pitch} / Y 訝?{section.y.top.size}@${section.y.top.pitch}?삡툔${section.y.bottom.size}@${section.y.bottom.pitch}`\r\n}\r\n\r\nfunction candidateFields(candidate: SectionCandidate, locale: Locale): string[] {\r\n  const fields: string[] = []\r\n  if (candidate.shape === '?녶숱' && candidate.b !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}?`)\r\n  } else if (candidate.b !== undefined && candidate.d !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}횞${candidate.d}`)\r\n  } else if (candidate.b !== undefined && candidate.depth !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}횞${candidate.depth}`)\r\n  }\r\n  if (candidate.main) {\r\n    fields.push(`訝사춮 ${candidate.main.count}-${candidate.main.size}`)\r\n  }\r\n  if (candidate.hoop) {\r\n    fields.push(`躍?춮 ${candidate.hoop.size}@${candidate.hoop.pitchMm}`)\r\n  }\r\n  if (candidate.girderMain) {\r\n    const { topCount, bottomCount, size, endTopCount, endBottomCount } =\r\n      candidate.girderMain\r\n    fields.push(`訝사춮 訝?{topCount}?삡툔${bottomCount}-${size}`)\r\n    if (endTopCount !== undefined || endBottomCount !== undefined) {\r\n      fields.push(\r\n        `塋?깿 訝?{endTopCount ?? topCount}?삡툔${endBottomCount ?? bottomCount}`,\r\n      )\r\n    }\r\n  }\r\n  if (candidate.stirrup) {\r\n    fields.push(\r\n      `?귙겙?됬춮 ${candidate.stirrup.size}@${candidate.stirrup.pitchMm}`,\r\n    )\r\n  }\r\n  if (candidate.sideBar) {\r\n    fields.push(\r\n      `${t(locale, 'sectionImport.field.sideBar')} ${candidate.sideBar.count}-${candidate.sideBar.size}`,\r\n    )\r\n  }\r\n  if (candidate.widthTie) {\r\n    fields.push(\r\n      `${t(locale, 'sectionImport.field.widthTie')} ${candidate.widthTie.size}@${candidate.widthTie.pitchMm}`,\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    if (candidate.thickness !== undefined) {\r\n      fields.push(`鶯곩럻 ${candidate.thickness}`)\r\n    }\r\n    if (candidate.layers !== undefined) fields.push(`?띸춮 ${candidate.layers}掠?)\r\n    if (candidate.vertical) {\r\n      fields.push(`潁?춮 ${candidate.vertical.size}@${candidate.vertical.pitchMm}`)\r\n    }\r\n    if (candidate.horizontal) {\r\n      fields.push(\r\n        `與ょ춮 ${candidate.horizontal.size}@${candidate.horizontal.pitchMm}`,\r\n      )\r\n    }\r\n  }\r\n  if (candidate.kind === '佯딀씮') {\r\n    if (candidate.thickness !== undefined) {\r\n      fields.push(`?욕럻 ${candidate.thickness}`)\r\n    }\r\n    for (const [label, side] of [\r\n      ['??씌', candidate.shortSide],\r\n      ['?룩씌', candidate.longSide],\r\n    ] as const) {\r\n      if (side?.top) fields.push(`${label}訝?${side.top.size}@${side.top.pitchMm}`)\r\n      if (side?.bottom) {\r\n        fields.push(`${label}訝?${side.bottom.size}@${side.bottom.pitchMm}`)\r\n      }\r\n    }\r\n  }\r\n  return fields\r\n}\r\n\r\nfunction cloneSourceSummary(source: ImportableSection): string {\r\n  const offset =\r\n    source.kind === '??\r\n      ? source.hoop.startOffsetMm\r\n      : source.kind === '鸚㎪쥈'\r\n        ? source.stirrup.startOffsetMm\r\n        : source.kind === '?먬쐡鶯?\r\n          ? source.vertical.startOffsetMm\r\n          : source.x.top.startOffsetMm\r\n  const exposure = source.kind === '佯딀씮' ? '' : `${source.exposure}/`\r\n  return `fc${source.fc}??{source.grade}??{exposure}${source.finish}?삣닜?잆궕?뺛궩?껁깉${offset}mm`\r\n}\r\n\r\nfunction Candidate({\r\n  row,\r\n  ignored,\r\n  slabDirection,\r\n  onIgnore,\r\n  onSlabDirectionChange,\r\n  onApply,\r\n}: {\r\n  row: CandidateRow\r\n  ignored: boolean\r\n  slabDirection?: SlabDirection\r\n  onIgnore(): void\r\n  onSlabDirectionChange(direction: SlabDirection | undefined): void\r\n  onApply(): void\r\n}) {\r\n  const { candidate } = row\r\n  const project = useAppStore(({ project }) => project)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const existing = matchingSection(project, candidate)\r\n  const source = existing ? undefined : cloneSource(project, candidate)\r\n  const incomplete = !existing && missingParsedFields(candidate, slabDirection)\r\n  const directionMissing =\r\n    candidate.kind === '佯딀씮' && slabDirection === undefined\r\n  const story = candidate.storyLabel ?? t(locale, 'sectionImport.noStory')\r\n  // ?뚯꽌???댁뒋 肄붾뱶留??ｋ뒗????臾몄옣? ?ш린??locale濡??쇰떎\r\n  const issueMessages = candidate.issues.map((issue) =>\r\n    t(locale, `sectionImport.issue.${issue}`),\r\n  )\r\n  const issueText = issueMessages.join('\\n')\r\n\r\n  return (\r\n    <li\r\n      className={styles.candidate}\r\n      data-testid={`section-import-candidate-${candidate.mark}-${candidate.storyLabel ?? 'none'}`}\r\n      hidden={ignored}\r\n    >\r\n      <div className={styles.candidateHeading}>\r\n        <strong>{candidate.mark}</strong>\r\n        <span>{story}</span>\r\n      </div>\r\n      <dl className={styles.diff}>\r\n        <div>\r\n          <dt>{t(locale, 'sectionImport.current')}</dt>\r\n          <dd>\r\n            {existing\r\n              ? sectionSummary(existing)\r\n              : t(locale, 'sectionImport.new')}\r\n          </dd>\r\n        </div>\r\n        <div>\r\n          <dt>{t(locale, 'sectionImport.parsed')}</dt>\r\n          <dd>{candidateFields(candidate, locale).join(' / ') || '??}</dd>\r\n        </div>\r\n      </dl>\r\n      {Object.keys(candidate.raw).length > 0 ? (\r\n        <div className={styles.raw} title={issueText || undefined}>\r\n          {Object.entries(candidate.raw).map(([label, value]) => (\r\n            <span key={label}>\r\n              {label}: {value}\r\n            </span>\r\n          ))}\r\n        </div>\r\n      ) : null}\r\n      {issueMessages.length > 0 ? (\r\n        <ul className={styles.issues}>\r\n          {issueMessages.map((issue) => (\r\n            <li key={issue}>{issue}</li>\r\n          ))}\r\n        </ul>\r\n      ) : null}\r\n      {!existing && source && incomplete ? (\r\n        <p className={styles.cloneNotice}>\r\n          {t(locale, 'sectionImport.incomplete')}\r\n        </p>\r\n      ) : null}\r\n      {!existing && source && !incomplete ? (\r\n        <>\r\n          <p className={styles.cloneNotice}>\r\n            {t(locale, 'sectionImport.clonePrefix')}\r\n            {sectionMarkLabel(source)}\r\n            {`竊?{cloneSourceSummary(source)}竊?}\r\n            {t(locale, 'sectionImport.cloneSuffix')}\r\n          </p>\r\n          <p className={styles.cloneNotice}>\r\n            {t(locale, 'sectionImport.newSectionUnassigned')}\r\n          </p>\r\n        </>\r\n      ) : null}\r\n      {candidate.kind === '佯딀씮' ? (\r\n        <div className={styles.directionChoice}>\r\n          <label htmlFor={`section-import-slab-direction-${row.id}`}>\r\n            {t(locale, 'sectionImport.slabDirection')}\r\n          </label>\r\n          <select\r\n            id={`section-import-slab-direction-${row.id}`}\r\n            data-testid={`section-import-slab-direction-${candidate.mark}`}\r\n            value={slabDirection ?? ''}\r\n            onChange={(event) => {\r\n              const value = event.currentTarget.value\r\n              onSlabDirectionChange(value === 'x' || value === 'y' ? value : undefined)\r\n            }}\r\n          >\r\n            <option value=\"\">\r\n              {t(locale, 'sectionImport.slabDirectionPlaceholder')}\r\n            </option>\r\n            <option value=\"x\">\r\n              {t(locale, 'sectionImport.slabDirection.shortToX')}\r\n            </option>\r\n            <option value=\"y\">\r\n              {t(locale, 'sectionImport.slabDirection.shortToY')}\r\n            </option>\r\n          </select>\r\n        </div>\r\n      ) : null}\r\n      <div className={styles.rowActions}>\r\n        <button\r\n          type=\"button\"\r\n          className={styles.applyButton}\r\n          disabled={\r\n            directionMissing || (!existing && (!source || incomplete))\r\n          }\r\n          onClick={onApply}\r\n        >\r\n          {t(locale, 'sectionImport.apply')}\r\n        </button>\r\n        <button type=\"button\" className={styles.ignoreButton} onClick={onIgnore}>\r\n          {t(locale, 'sectionImport.ignore')}\r\n        </button>\r\n      </div>\r\n    </li>\r\n  )\r\n}\r\n\r\nexport function SectionImport({\r\n  initialPages,\r\n  extractPages = extractTextPages,\r\n}: SectionImportProps) {\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n  const inputRef = useRef<HTMLInputElement>(null)\r\n  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\r\n  const [open, setOpen] = useState(initialPages !== undefined)\r\n  const [loading, setLoading] = useState(false)\r\n  const [failed, setFailed] = useState(false)\r\n  const [ignored, setIgnored] = useState<Set<string>>(() => new Set())\r\n  const [slabDirections, setSlabDirections] = useState<\r\n    Record<string, SlabDirection>\r\n  >({})\r\n  // ?곗냽 ?좏깮 ????쾶 ?앸궃 ?댁쟾 ?뚯씪??寃곌낵媛 理쒖떊 寃곌낵瑜???? ?딄쾶 ?쒕떎\r\n  const requestRef = useRef(0)\r\n  const lists = useMemo(\r\n    () => (pages ?? []).flatMap((page) => parseSectionLists(page)),\r\n    [pages],\r\n  )\r\n  const rows = useMemo(() => parsedCandidates(lists), [lists])\r\n  // ?ъ쑀蹂꾨줈 ?대뒓 由ъ뒪?멸? 嫄몃졇?붿? 臾띕뒗?????꾨낫媛 ?섎굹?쇰룄 ?덉쑝硫??ㅽ뙣???쒓?\r\n  // ?붾㈃?먯꽌 ?щ씪吏??臾몄젣瑜?留됱쑝?ㅻ㈃ ???덈궡媛 ?꾨낫 紐⑸줉怨??④퍡 ??蹂댁뿬???쒕떎\r\n  const listIssues = useMemo(() => {\r\n    const grouped = new Map<ListIssue, string[]>()\r\n    for (const { issue, listKind } of lists) {\r\n      if (issue === undefined) continue\r\n      const kinds = grouped.get(issue) ?? []\r\n      if (!kinds.includes(listKind)) kinds.push(listKind)\r\n      grouped.set(issue, kinds)\r\n    }\r\n    return [...grouped]\r\n  }, [lists])\r\n  const supported = rows.filter(({ candidate }) => candidate.kind !== '野얕괌鸚?)\r\n  const outOfScope = rows.filter(({ candidate }) => candidate.kind === '野얕괌鸚?)\r\n\r\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n    const input = event.currentTarget\r\n    const file = input.files?.[0]\r\n    if (!file) return\r\n\r\n    const requestId = ++requestRef.current\r\n    setOpen(true)\r\n    setLoading(true)\r\n    setFailed(false)\r\n    setIgnored(new Set())\r\n    setSlabDirections({})\r\n    try {\r\n      const next = await extractPages(file)\r\n      if (requestRef.current !== requestId) return\r\n      setPages(next)\r\n    } catch {\r\n      if (requestRef.current !== requestId) return\r\n      setPages(null)\r\n      setFailed(true)\r\n    } finally {\r\n      if (requestRef.current === requestId) setLoading(false)\r\n      input.value = ''\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.control}>\r\n      <button\r\n        type=\"button\"\r\n        className={styles.openButton}\r\n        onClick={() => {\r\n          if (pages) setOpen(true)\r\n          else inputRef.current?.click()\r\n        }}\r\n      >\r\n        {t(locale, 'sectionImport.open')}\r\n      </button>\r\n      <input\r\n        ref={inputRef}\r\n        className={styles.fileInput}\r\n        data-testid=\"section-import-file\"\r\n        type=\"file\"\r\n        accept=\"application/pdf\"\r\n        aria-label={t(locale, 'sectionImport.file')}\r\n        onChange={(event) => void selectFile(event)}\r\n      />\r\n      {open ? (\r\n        <section\r\n          className={styles.panel}\r\n          role=\"dialog\"\r\n          aria-modal=\"false\"\r\n          aria-labelledby=\"section-import-title\"\r\n        >\r\n          <header className={styles.panelHeader}>\r\n            <h3 id=\"section-import-title\">\r\n              {t(locale, 'sectionImport.title')}\r\n            </h3>\r\n            <div className={styles.panelActions}>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.chooseButton}\r\n                onClick={() => inputRef.current?.click()}\r\n              >\r\n                {t(locale, 'sectionImport.chooseAnother')}\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.closeButton}\r\n                onClick={() => setOpen(false)}\r\n              >\r\n                {t(locale, 'sectionImport.close')}\r\n              </button>\r\n            </div>\r\n          </header>\r\n          <div className={styles.panelBody}>\r\n            {loading ? (\r\n              <p role=\"status\">{t(locale, 'sectionImport.loading')}</p>\r\n            ) : failed ? (\r\n              <p role=\"alert\">{t(locale, 'sectionImport.error')}</p>\r\n            ) : pages && rows.length === 0 && listIssues.length === 0 ? (\r\n              <p>{t(locale, 'sectionImport.empty')}</p>\r\n            ) : (\r\n              <>\r\n                {listIssues.map(([issue, kinds]) => (\r\n                  <p key={issue} className={styles.listIssue}>\r\n                    {`${t(locale, `sectionImport.listIssue.${issue}`)}竊?{kinds.join('??)}竊?}\r\n                  </p>\r\n                ))}\r\n                <ul className={styles.candidateList}>\r\n                  {supported.map((row) => (\r\n                    <Candidate\r\n                      key={row.id}\r\n                      row={row}\r\n                      ignored={ignored.has(row.id)}\r\n                      slabDirection={slabDirections[row.id]}\r\n                      onIgnore={() =>\r\n                        setIgnored((current) => new Set(current).add(row.id))\r\n                      }\r\n                      onSlabDirectionChange={(direction) =>\r\n                        setSlabDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onApply={() =>\r\n                        updateProject((project) =>\r\n                          applyCandidate(\r\n                            project,\r\n                            row.candidate,\r\n                            slabDirections[row.id],\r\n                          ),\r\n                        )\r\n                      }\r\n                    />\r\n                  ))}\r\n                </ul>\r\n                {outOfScope.length > 0 ? (\r\n                  <details\r\n                    className={styles.outOfScope}\r\n                    data-testid=\"section-import-out-of-scope\"\r\n                  >\r\n                    <summary>\r\n                      {t(locale, 'sectionImport.outOfScope')} ({outOfScope.length})\r\n                    </summary>\r\n                    <ul className={styles.candidateList}>\r\n                      {outOfScope.map((row) => (\r\n                        <li\r\n                          key={row.id}\r\n                          className={styles.candidate}\r\n                          data-testid={`section-import-candidate-${row.candidate.mark}-${row.candidate.storyLabel ?? 'none'}`}\r\n                        >\r\n                          <div className={styles.candidateHeading}>\r\n                            <strong>{row.candidate.mark}</strong>\r\n                            <span>\r\n                              {row.candidate.storyLabel ??\r\n                                t(locale, 'sectionImport.noStory')}\r\n                            </span>\r\n                          </div>\r\n                          <p>\r\n                            {candidateFields(row.candidate, locale).join(' / ') ||\r\n                              '??}\r\n                          </p>\r\n                        </li>\r\n                      ))}\r\n                    </ul>\r\n                  </details>\r\n                ) : null}\r\n              </>\r\n            )}\r\n          </div>\r\n        </section>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n\r\n'use client'\r\n\r\nimport { useRef, type KeyboardEvent } from 'react'\r\n\r\nimport {\r\n  BAR_SIZES,\r\n  SHEAR_BAR_SIZES,\r\n  SPLICE_METHODS,\r\n  sectionMarkLabel,\r\n  type BarSize,\r\n  type ColumnSection,\r\n  type ColumnShape,\r\n  type Exposure,\r\n  type Finish,\r\n  type GirderSection,\r\n  type Section,\r\n  type ShearBarSize,\r\n  type SpliceMethod,\r\n  type SteelGrade,\r\n  type SlabBarRow,\r\n  type SlabSection,\r\n  type WallSection,\r\n} from '@/domain/model/member'\r\nimport type { Project } from '@/domain/model/project'\r\nimport { useAppStore } from '@/lib/store'\r\nimport { capture } from '@/lib/telemetry'\r\n\r\nimport styles from './SectionTable.module.css'\r\n\r\nconst barSizes: readonly BarSize[] = BAR_SIZES\r\n\r\nconst shearBarSizes: readonly ShearBarSize[] = SHEAR_BAR_SIZES\r\n\r\nconst columnShapes: readonly ColumnShape[] = ['?⒴숱', '?녶숱']\r\n\r\nconst steelGrades: SteelGrade[] = ['SD295', 'SD345', 'SD390']\r\n\r\nconst spliceMethods: readonly SpliceMethod[] = SPLICE_METHODS\r\n\r\nconst exposures: Exposure[] = ['掠뗥냵', '掠뗥쨼']\r\n\r\nconst finishes: Finish[] = ['餓뺜툓?믡걗??, '餓뺜툓?믡겒??]\r\n\r\nfunction replaceSection(\r\n  project: Project,\r\n  sectionId: string,\r\n  updater: (section: Section) => Section,\r\n): Project {\r\n  return {\r\n    ...project,\r\n    sections: project.sections.map((section) =>\r\n      section.id === sectionId ? updater(section) : section,\r\n    ),\r\n  }\r\n}\r\n\r\nfunction boundedNumber(value: string, minimum: number): number | null {\r\n  // Number('')??0?대떎 ???섑븳??0???꾨뱶?먯꽌 鍮?媛믪씠 ?듦낵?섎㈃ 吏?곕뒗 ?쒓컙\r\n  // ?ф빊(=臾쇰웾)媛 0 ?ㅽ봽?뗭쑝濡???씤??\r\n  if (value.trim() === '') return null\r\n\r\n  const parsed = Number(value)\r\n  return Number.isFinite(parsed) && parsed >= minimum ? parsed : null\r\n}\r\n\r\nfunction NumberInput({\r\n  label,\r\n  value,\r\n  onChange,\r\n  // 移섏닔쨌?붵긿?겶룡쑍?곕뒗 0???깅┰?섏? ?딆?留??앮쐿?ゃ깢?삠긿?덉? 0???뺤긽媛믪씠??\r\n  minimum = 1,\r\n  // 亮끾??곭춮쨌?밭춮泥섎읆 ?뚣겒?쀣띻? ?깅┰?섎뒗 ??ぉ? 洹?諛곌렐???놁쓣 ???낅젰??留됰뒗??\r\n  // ?댁뼱 ?먮㈃ updater 媛 current 瑜?洹몃?濡??뚮젮以??낅젰???붿쟻 ?놁씠 ?щ씪吏꾨떎.\r\n  disabled = false,\r\n}: {\r\n  label: string\r\n  value: number\r\n  onChange(value: number): void\r\n  minimum?: number\r\n  disabled?: boolean\r\n}) {\r\n  return (\r\n    <input\r\n      className={styles.numberInput}\r\n      type=\"number\"\r\n      min={minimum}\r\n      step=\"1\"\r\n      value={value}\r\n      disabled={disabled}\r\n      aria-label={label}\r\n      onChange={(event) => {\r\n        const next = boundedNumber(event.currentTarget.value, minimum)\r\n        if (next !== null) onChange(next)\r\n      }}\r\n    />\r\n  )\r\n}\r\n\r\nfunction BarSizeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: BarSize\r\n  onChange(value: BarSize): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) => onChange(event.currentTarget.value as BarSize)}\r\n    >\r\n      {barSizes.map((size) => (\r\n        <option key={size} value={size}>\r\n          {size}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\n/**\r\n * ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ??푶?귚말嶺뗣겗?멩뒢?㏂겏?녴걢?뚣겍?꾠굥??겘??\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺?(K13?팗13) ?믢말嶺뗣겓?γ굦?됥굦?ゃ걚?뗣굢????訝사춮??츣???\n * ?띲겖泳숁뎸?믦〃5.3.4?삭〃5.3.2 ?뗣굢孃꾠겎凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??\n * 烏뚣걣?ゃ걚 (ADR-026)??\n */\r\nfunction ShearBarSizeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: ShearBarSize\r\n  onChange(value: ShearBarSize): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) => onChange(event.currentTarget.value as ShearBarSize)}\r\n    >\r\n      {shearBarSizes.map((size) => (\r\n        <option key={size} value={size}>\r\n          {size}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\n/**\r\n * 亮끾??곭춮쨌?밭춮? ??씊訝誤㏃뿉 ?놁쑝硫?洹?諛곌렐???녿뒗 寃껋씠?????뚣겒?쀣띾? 怨좊Ⅴ硫?\n * ?꾨뱶 ?먯껜瑜?吏?대떎. ?쒗뭹???덈뒗 ??移섍퀬 怨꾩긽?섏? ?딅뒗??(ADR-012).\r\n */\r\nfunction OptionalBarSizeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: BarSize | null\r\n  onChange(value: BarSize | null): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value ?? ''}\r\n      aria-label={label}\r\n      onChange={(event) => {\r\n        const next = event.currentTarget.value\r\n        onChange(next === '' ? null : (next as BarSize))\r\n      }}\r\n    >\r\n      <option value=\"\">?ゃ걮</option>\r\n      {barSizes.map((size) => (\r\n        <option key={size} value={size}>\r\n          {size}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction GradeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: SteelGrade\r\n  onChange(value: SteelGrade): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) => onChange(event.currentTarget.value as SteelGrade)}\r\n    >\r\n      {steelGrades.map((grade) => (\r\n        <option key={grade} value={grade}>\r\n          {grade}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction SpliceMethodSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: SpliceMethod\r\n  onChange(value: SpliceMethod): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) =>\r\n        onChange(event.currentTarget.value as SpliceMethod)\r\n      }\r\n    >\r\n      {spliceMethods.map((method) => (\r\n        <option key={method} value={method}>\r\n          {method}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction CoverConditionField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: Section\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      {/* 烏?.3.6 ??뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥띹죱??퍞訝듽걩??쐣?▲걽?묆겎?녴걢?뚣?\n          掠뗥냵?삣콏鸚뽧겗?뷴닪?믤똻?잆겒?????밤걢?ゃ걚?ㅳ겲?욍굮營?걢?ゃ걚 (ADR-028)??*/}\r\n      {section.kind === '佯딀씮' ? null : (\r\n      <select\r\n        className={styles.select}\r\n        value={section.exposure}\r\n        aria-label={`${sectionMarkLabel(section)} 掠뗥냵鸚?}\r\n        onChange={(event) => {\r\n          const exposure = event.currentTarget.value as Exposure\r\n          update((current) => ({ ...current, exposure }))\r\n        }}\r\n      >\r\n        {exposures.map((exposure) => (\r\n          <option key={exposure} value={exposure}>\r\n            {exposure}\r\n          </option>\r\n        ))}\r\n      </select>\r\n      )}\r\n      <select\r\n        className={styles.select}\r\n        value={section.finish}\r\n        aria-label={`${sectionMarkLabel(section)} 餓뺜툓??}\r\n        onChange={(event) => {\r\n          const finish = event.currentTarget.value as Finish\r\n          update((current) => ({ ...current, finish }))\r\n        }}\r\n      >\r\n        {finishes.map((finish) => (\r\n          <option key={finish} value={finish}>\r\n            {finish}\r\n          </option>\r\n        ))}\r\n      </select>\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * ??씊壤®듁?귛냶壤㏂겦燁삠굥?ⓦ걤 d ??b ?믣뀯?뚣굥??겘?곩냶壤€윶??b?팪 ?믡겏?귙겓?닷푶?ⓦ걮??\n * ?곥겇?뗣굢????鸚㎪쥈??냵力뺛굚 3D ??윶?㏂굚 b?팪 ?뗣굢黎뷩겲??(ADR-027)??\n */\r\nfunction ColumnShapeSelect({\r\n  section,\r\n  update,\r\n}: {\r\n  section: ColumnSection\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={section.shape}\r\n      aria-label={`${sectionMarkLabel(section)} ??씊壤®듁`}\r\n      onChange={(event) => {\r\n        const shape = event.currentTarget.value as ColumnShape\r\n        update((current) =>\r\n          current.kind === '??\r\n            ? { ...current, shape, ...(shape === '?녶숱' ? { d: current.b } : {}) }\r\n            : current,\r\n        )\r\n      }}\r\n    >\r\n      {columnShapes.map((shape) => (\r\n        <option key={shape} value={shape}>\r\n          {shape}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction SectionDimension({\r\n  section,\r\n  update,\r\n}: {\r\n  section: Section\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  if (section.kind === '佯딀씮') {\r\n    // 佯딀씮??뼪?㏂굚?욕럻1?ㅳ걽?귡빓?뺛겘?싥굤??겏鸚㎪쥈亮끹걢?됪군?얇굥?끾퀡?ゃ겗?㎯?\n    // ??씊訝誤㎯겎??똻?잆겒?꾬펷翁?퐪??뙷?놅펷竊뷂펹竊됥?\n    return (\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ?욕럻 t`}\r\n        value={section.thickness}\r\n        onChange={(thickness) =>\r\n          update((current) => ({ ...current, thickness }))\r\n        }\r\n      />\r\n    )\r\n  }\r\n\r\n  if (section.kind === '?먬쐡鶯?) {\r\n    // 鶯곥겗??씊??럻???ㅳ걽?괷횞D ??옞?ユ듉?쀨씔??ⓨ쎋?㏂겓?ゃ걚野멩퀡?믢퐳?ｃ겍?쀣겲?녴?\n    return (\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} 鶯곩럻 t`}\r\n        value={section.thickness}\r\n        onChange={(thickness) =>\r\n          update((current) => ({ ...current, thickness }))\r\n        }\r\n      />\r\n    )\r\n  }\r\n\r\n  if (section.kind === '?? && section.shape === '?녶숱') {\r\n    // ?녶숱?긱겗野멩퀡??쎍孃꾠겛?ⓦ겇?졼괷?팪 ?믣닪?끹겓?뷩걲?ⓨ쎋?㏂겓?ゃ걚?곩뭄??씊??\n    // 鵝쒌굦?╉걮?얇걝 ??1?싧뎴2) ??뫅?룔걣 ?횞?닷푶 ?㎯겒?뤵겒??(ADR-027)??\n    return (\r\n      <div className={styles.compoundField}>\r\n        <ColumnShapeSelect section={section} update={update} />\r\n        <NumberInput\r\n          label={`${sectionMarkLabel(section)} ??씊 ?닷푶`}\r\n          value={section.b}\r\n          onChange={(diameter) =>\r\n            update((current) =>\r\n              current.kind === '??\r\n                ? { ...current, b: diameter, d: diameter }\r\n                : current,\r\n            )\r\n          }\r\n        />\r\n        <span aria-hidden=\"true\">?</span>\r\n      </div>\r\n    )\r\n  }\r\n\r\n  const secondValue = section.kind === '?? ? section.d : section.depth\r\n  const secondLabel = section.kind === '?? ? 'd' : '?쎼걚'\r\n\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      {section.kind === '?? ? (\r\n        <ColumnShapeSelect section={section} update={update} />\r\n      ) : null}\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ??씊 b`}\r\n        value={section.b}\r\n        onChange={(b) => update((current) => ({ ...current, b }))}\r\n      />\r\n      <span aria-hidden=\"true\">횞</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ??씊 ${secondLabel}`}\r\n        value={secondValue}\r\n        onChange={(value) =>\r\n          update((current) =>\r\n            current.kind === '??\r\n              ? { ...current, d: value }\r\n              : { ...current, depth: value },\r\n          )\r\n        }\r\n      />\r\n    </div>\r\n  )\r\n}\r\n\r\nfunction ColumnMainField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: ColumnSection\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} 訝사춮 ?ф빊`}\r\n        value={section.main.count}\r\n        onChange={(count) =>\r\n          update((current) => {\r\n            if (current.kind !== '??) return current\r\n            return { ...current, main: { ...current.main, count } }\r\n          })\r\n        }\r\n      />\r\n      <span aria-hidden=\"true\">??/span>\r\n      <BarSizeSelect\r\n        label={`${sectionMarkLabel(section)} 訝사춮 孃?}\r\n        value={section.main.size}\r\n        onChange={(size) =>\r\n          update((current) => {\r\n            if (current.kind !== '??) return current\r\n            return { ...current, main: { ...current.main, size } }\r\n          })\r\n        }\r\n      />\r\n    </div>\r\n  )\r\n}\r\n\r\nfunction GirderMainCountInput({\r\n  section,\r\n  row,\r\n  place,\r\n  update,\r\n}: {\r\n  section: GirderSection\r\n  row: 'top' | 'bottom'\r\n  place: '塋?깿' | '訝?ㄾ'\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  const key = place === '塋?깿' ? 'endCount' : 'centerCount'\r\n\r\n  return (\r\n    <NumberInput\r\n      label={`${sectionMarkLabel(section)} 訝사춮 ${\r\n        row === 'top' ? '訝? : '訝?\r\n      } ${place} ?ф빊`}\r\n      value={section.main[row][key]}\r\n      onChange={(count) =>\r\n        update((current) => {\r\n          if (current.kind !== '鸚㎪쥈') return current\r\n          return {\r\n            ...current,\r\n            main: {\r\n              ...current.main,\r\n              [row]: { ...current.main[row], [key]: count },\r\n            },\r\n          }\r\n        })\r\n      }\r\n    />\r\n  )\r\n}\r\n\r\nfunction GirderMainField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: GirderSection\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <div className={styles.girderMainField}>\r\n      {(['top', 'bottom'] as const).map((row) => (\r\n        <div key={row} className={styles.compoundField}>\r\n          <span>{row === 'top' ? '訝? : '訝?}</span>\r\n          <GirderMainCountInput\r\n            section={section}\r\n            row={row}\r\n            place=\"塋?깿\"\r\n            update={update}\r\n          />\r\n          <span aria-hidden=\"true\">竊?/span>\r\n          <GirderMainCountInput\r\n            section={section}\r\n            row={row}\r\n            place=\"訝?ㄾ\"\r\n            update={update}\r\n          />\r\n        </div>\r\n      ))}\r\n      <BarSizeSelect\r\n        label={`${sectionMarkLabel(section)} 訝사춮 孃?}\r\n        value={section.main.size}\r\n        onChange={(size) =>\r\n          update((current) => {\r\n            if (current.kind !== '鸚㎪쥈') return current\r\n            return { ...current, main: { ...current.main, size } }\r\n          })\r\n        }\r\n      />\r\n      <div className={styles.compoundField}>\r\n        <span>?ャ긿?덀궕??/span>\r\n        <NumberInput\r\n          label={`${sectionMarkLabel(section)} ?ャ긿?덀궕?뺜퐤營?}\r\n          minimum={0}\r\n          value={section.main.cutoffFromSupportFaceMm}\r\n          onChange={(cutoffFromSupportFaceMm) =>\r\n            update((current) => {\r\n              if (current.kind !== '鸚㎪쥈') return current\r\n              return {\r\n                ...current,\r\n                main: { ...current.main, cutoffFromSupportFaceMm },\r\n              }\r\n            })\r\n          }\r\n        />\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗潁?춮?삥Ø嶺뗣귙겑?▲굢?귙뚦푶 @ ?붵긿??竊??앮쐿?ゃ깢?삠긿?덀띲겎壤㏂걣?뚣걯?ゃ겗??\n * 1?ㅳ겗?녈꺍?앫꺖?띲꺍?덀걣訝→뼶?믣룛?묉똻?ㅳ귙겑?▲굢??죱?뗣겘 `row` ?뚧군?곥굥??\n */\r\nfunction WallBarField({\r\n  section,\r\n  update,\r\n  row,\r\n}: {\r\n  section: WallSection\r\n  update(updater: (section: Section) => Section): void\r\n  row: 'vertical' | 'horizontal'\r\n}) {\r\n  const label = row === 'vertical' ? '潁?춮' : '與ょ춮'\r\n  const bar = section[row]\r\n  const replace = (patch: Partial<WallSection['vertical']>) =>\r\n    update((current) =>\r\n      current.kind === '?먬쐡鶯?\r\n        ? { ...current, [row]: { ...current[row], ...patch } }\r\n        : current,\r\n    )\r\n\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      <BarSizeSelect\r\n        label={`${sectionMarkLabel(section)} ${label} 孃?}\r\n        value={bar.size}\r\n        onChange={(size) => replace({ size })}\r\n      />\r\n      <span aria-hidden=\"true\">@</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?붵긿??}\r\n        value={bar.pitch}\r\n        onChange={(pitch) => replace({ pitch })}\r\n      />\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?앮쐿?ゃ깢?삠긿??}\r\n        minimum={0}\r\n        value={bar.startOffsetMm}\r\n        onChange={(startOffsetMm) => replace({ startOffsetMm })}\r\n      />\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * 佯딀씮??말嶺???1?밧릲?뜰굯??툓塋?춮?삡툔塋?춮?괱?밧릲?쮇?밧릲?㎩닪?끹겓?쀣걨?뽧굥??\n * 孃꾠굚?붵긿?곥굚??씊?ゃ궧?덀겗?ε뒟?㎯걗?ｃ겍誤뤸틬?ユ쑍?겹겗?→뻼??겒??(ADR-012)??\n */\r\nfunction SlabBarField({\r\n  section,\r\n  update,\r\n  axis,\r\n}: {\r\n  section: SlabSection\r\n  update(updater: (section: Section) => Section): void\r\n  axis: 'x' | 'y'\r\n}) {\r\n  const replace = (\r\n    face: 'top' | 'bottom',\r\n    patch: Partial<SlabBarRow>,\r\n  ): void =>\r\n    update((current) =>\r\n      current.kind === '佯딀씮'\r\n        ? {\r\n            ...current,\r\n            [axis]: {\r\n              ...current[axis],\r\n              [face]: { ...current[axis][face], ...patch },\r\n            },\r\n          }\r\n        : current,\r\n    )\r\n\r\n  return (\r\n    <div className={styles.slabBarField}>\r\n      {(['top', 'bottom'] as const).map((face) => {\r\n        const bar = section[axis][face]\r\n        const label = `${axis.toUpperCase()}?밧릲${face === 'top' ? '訝딁ク嶺? : '訝뗧ク嶺?}`\r\n\r\n        return (\r\n          <div key={face} className={styles.compoundField}>\r\n            <BarSizeSelect\r\n              label={`${sectionMarkLabel(section)} ${label} 孃?}\r\n              value={bar.size}\r\n              onChange={(size) => replace(face, { size })}\r\n            />\r\n            <span aria-hidden=\"true\">@</span>\r\n            <NumberInput\r\n              label={`${sectionMarkLabel(section)} ${label} ?붵긿??}\r\n              value={bar.pitch}\r\n              onChange={(pitch) => replace(face, { pitch })}\r\n            />\r\n            <NumberInput\r\n              label={`${sectionMarkLabel(section)} ${label} ?앮쐿?ゃ깢?삠긿??}\r\n              minimum={0}\r\n              value={bar.startOffsetMm}\r\n              onChange={(startOffsetMm) => replace(face, { startOffsetMm })}\r\n            />\r\n          </div>\r\n        )\r\n      })}\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * ?띸춮掠ㅶ빊竊덀궥?녈궛?ワ폀??뽧꺂竊됥귝쑍?겹걣?앫겗?얇겲?띺걬?녴겗?ヨ쫸繹뽧겓?→뻼?뚣겒?뤵?\n * 鶯곥꺁?밤깉??쮼雍됥걹??굚??겎?귙굥 (ADR-012) ???졼걢?됪뿢若싧ㅳ굮營?걢?싮겦?겹걵?뗣?\n */\r\nfunction WallLayersField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: WallSection\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={String(section.layers)}\r\n      aria-label={`${sectionMarkLabel(section)} ?띸춮掠ㅶ빊`}\r\n      onChange={(event) => {\r\n        const layers = Number(event.currentTarget.value) === 2 ? 2 : 1\r\n        update((current) =>\r\n          current.kind === '?먬쐡鶯? ? { ...current, layers } : current,\r\n        )\r\n      }}\r\n    >\r\n      <option value=\"1\">?룔꺍?겹꺂</option>\r\n      <option value=\"2\">??뽧꺂</option>\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction ShearField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: Section\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  // 鶯곥겗?쎼굯??짒凉룔겓?귙걼?뗣겗??Ø嶺뗣걽?귙걪?볝걢?됧뀍??윶?삣ㄷ歟곥걽?묆걣?싥굥 ??\n  // 訝뗣겗 update ?녈꺖?ャ깘?껁궚?뚩먬쐡鶯곥굮榮좈싥걮?쇻굥??겘?앫겗?잆굙?㎯걗?뗣?\n  if (section.kind === '?먬쐡鶯?) {\r\n    return <WallBarField section={section} update={update} row=\"horizontal\" />\r\n  }\r\n\r\n  // 佯딀씮?ャ걵?볠뼪獒쒎섭嶺뗣겘?ゃ걚?귙걪??닓?ャ겘?귙걝訝?밤겗?묆걤??말嶺뗣굮營?걦 ??\n  // 令뷸쵂?ャ걲?뗣겏2?밧릲??걝?←뎴?밤걮?뗥뀯?쎼겎?띲겒?꾥〃?ャ겒?뗣?\n  if (section.kind === '佯딀씮') {\r\n    return <SlabBarField section={section} update={update} axis=\"y\" />\r\n  }\r\n\r\n  const reinforcement = section.kind === '?? ? section.hoop : section.stirrup\r\n  const label = section.kind === '?? ? '躍?춮' : '?귙겙?됬춮'\r\n\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      <ShearBarSizeSelect\r\n        label={`${sectionMarkLabel(section)} ${label} 孃?}\r\n        value={reinforcement.size}\r\n        onChange={(size) =>\r\n          update((current) =>\r\n            current.kind === '??\r\n              ? { ...current, hoop: { ...current.hoop, size } }\r\n              : current.kind === '鸚㎪쥈'\r\n                ? { ...current, stirrup: { ...current.stirrup, size } }\r\n                : current,\r\n          )\r\n        }\r\n      />\r\n      <span aria-hidden=\"true\">@</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?붵긿??}\r\n        value={reinforcement.pitch}\r\n        onChange={(pitch) =>\r\n          update((current) =>\r\n            current.kind === '??\r\n              ? { ...current, hoop: { ...current.hoop, pitch } }\r\n              : current.kind === '鸚㎪쥈'\r\n                ? { ...current, stirrup: { ...current.stirrup, pitch } }\r\n                : current,\r\n          )\r\n        }\r\n      />\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?앮쐿?ゃ깢?삠긿??}\r\n        minimum={0}\r\n        value={reinforcement.startOffsetMm}\r\n        onChange={(startOffsetMm) =>\r\n          update((current) =>\r\n            current.kind === '??\r\n              ? { ...current, hoop: { ...current.hoop, startOffsetMm } }\r\n              : current.kind === '鸚㎪쥈'\r\n                ? {\r\n                    ...current,\r\n                    stirrup: { ...current.stirrup, startOffsetMm },\r\n                  }\r\n                : current,\r\n          )\r\n        }\r\n      />\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * M3c ??뿥?у쎓?됭㈂榮???亮끾??곭춮?②끃嶺뗣귙겑?▲굢?귛ㄷ歟곥걽?묆겓營?걦??\n * 亮끾??곭춮?믤뙔?믡굥?곈뇧令띸츞?뷸틬 1?싧뎴3) ??깿?먦겘?븀쨴歟곥꺕歟곥꺕鶯곫쥈?삣즯?㎪윶?믣맜?얇걳??\n * ?밭춮?믤돮??2竊덌폆竊됪쥈3) ?귝쥈??씉?끹걽?뗣굢?㎯걗?뗣?\n */\r\nfunction GirderDetailField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: GirderSection\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  const { widthTie, sideBar } = section\r\n\r\n  return (\r\n    <div className={styles.girderDetailField}>\r\n      <span>亮끾?</span>\r\n      <OptionalBarSizeSelect\r\n        label={`${sectionMarkLabel(section)} 亮끾??곭춮 孃?}\r\n        value={widthTie?.size ?? null}\r\n        onChange={(size) =>\r\n          update((current) => {\r\n            if (current.kind !== '鸚㎪쥈') return current\r\n            if (size === null) {\r\n              const next = { ...current }\r\n              delete next.widthTie\r\n              return next\r\n            }\r\n            return {\r\n              ...current,\r\n              // ?붵긿?곥겘??씊訝誤㎯겗?ε뒟??(ADR-012)?귟쫸繹뽧겓亮끾??곭춮??깞?껁긽??겒?뤵?\n              // ?귙겙?됬춮??ㅳ굮?잆굤?뚣겙?⑴뵪?끹걣?γ굦?╉걚?ゃ걚?겼춻??1?싧뎴7) ??\n              // ?꿜퍡?ф빊?ュ뀯?ｃ겍?쀣겲?녴? 竊??ゅ뀯?쎼겏?쀣겍?ャ긿?덀궕?뺜퐤營?겏?뚣걯??\n              // ?볟끁?담겓?ㅵ츣?뺛걵??(ADR-021 ????\n              widthTie: { size, pitch: current.widthTie?.pitch ?? 0 },\r\n            }\r\n          })\r\n        }\r\n      />\r\n      <span aria-hidden=\"true\">@</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} 亮끾??곭춮 ?붵긿??}\r\n        disabled={widthTie === undefined}\r\n        minimum={0}\r\n        value={widthTie?.pitch ?? 0}\r\n        onChange={(pitch) =>\r\n          update((current) =>\r\n            current.kind !== '鸚㎪쥈' || current.widthTie === undefined\r\n              ? current\r\n              : { ...current, widthTie: { ...current.widthTie, pitch } },\r\n          )\r\n        }\r\n      />\r\n      <span>?밭춮</span>\r\n      <OptionalBarSizeSelect\r\n        label={`${sectionMarkLabel(section)} ?밭춮 孃?}\r\n        value={sideBar?.size ?? null}\r\n        onChange={(size) =>\r\n          update((current) => {\r\n            if (current.kind !== '鸚㎪쥈') return current\r\n            if (size === null) {\r\n              const next = { ...current }\r\n              delete next.sideBar\r\n              return next\r\n            }\r\n            return {\r\n              ...current,\r\n              sideBar: {\r\n                size,\r\n                // ?ф빊??Ŧ??륫?닻씊???с걳?ㅳ겗2?с귚퐰?룔겘 0 ??\n                // JASS 5 ?뚧쑋閻뷰퓷?㎬쫸繹뽩ㅳ걣?ゃ걚??겎?곩뀯?뚣겒?꾠걢?롢굤鼇덁툓?쀣겒??(R9????\n                count: current.sideBar?.count ?? 2,\r\n                extraLengthMm: current.sideBar?.extraLengthMm ?? 0,\r\n              },\r\n            }\r\n          })\r\n        }\r\n      />\r\n      <span aria-hidden=\"true\">횞</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ?밭춮 ?ф빊`}\r\n        disabled={sideBar === undefined}\r\n        value={sideBar?.count ?? 2}\r\n        onChange={(count) =>\r\n          update((current) =>\r\n            current.kind !== '鸚㎪쥈' || current.sideBar === undefined\r\n              ? current\r\n              : { ...current, sideBar: { ...current.sideBar, count } },\r\n          )\r\n        }\r\n      />\r\n      <span>鵝숅빓</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ?밭춮 鵝숅빓`}\r\n        disabled={sideBar === undefined}\r\n        minimum={0}\r\n        value={sideBar?.extraLengthMm ?? 0}\r\n        onChange={(extraLengthMm) =>\r\n          update((current) =>\r\n            current.kind !== '鸚㎪쥈' || current.sideBar === undefined\r\n              ? current\r\n              : {\r\n                  ...current,\r\n                  sideBar: { ...current.sideBar, extraLengthMm },\r\n                },\r\n          )\r\n        }\r\n      />\r\n    </div>\r\n  )\r\n}\r\n\r\nexport function SectionTable() {\r\n  const project = useAppStore(({ project }) => project)\r\n  const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\r\n  const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\r\n  const selectMember = useAppStore(({ selectMember }) => selectMember)\r\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n  const sectionEditReported = useRef(false)\r\n  const selectedSectionId = project.members.find(\r\n    ({ id }) => id === selectedMemberId,\r\n  )?.sectionId\r\n\r\n  const update = (\r\n    sectionId: string,\r\n    updater: (section: Section) => Section,\r\n  ) => {\r\n    updateProject((current) => replaceSection(current, sectionId, updater))\r\n\r\n    // onChange?????낅젰留덈떎 ?ㅼ뼱?⑤떎. ?뚭퀬 ?띠? 寃껋? ?몄쭛 ?잛닔媛 ?꾨땲??\"???몄뀡?먯꽌\r\n    // ??씊烏⑤? ?먮뙏?붽?\"(?대엺 ???몄쭛 ???대낫?닿린 ?쇰꼸??媛?대뜲 移??대?濡???踰덉쑝濡??⑹튇??\r\n    if (sectionEditReported.current) return\r\n    sectionEditReported.current = true\r\n    capture('section_edited')\r\n  }\r\n\r\n  const selectSection = (sectionId: string) => {\r\n    const representative =\r\n      project.members.find(\r\n        (member) =>\r\n          member.storyId === activeStoryId && member.sectionId === sectionId,\r\n      ) ?? project.members.find((member) => member.sectionId === sectionId)\r\n\r\n    if (!representative) return\r\n\r\n    // ???덉쓽 ?낅젰移몄쓣 ?대┃???몄쭛留??대룄 onClick??踰꾨툝留곷뤌 ?ш린濡??ㅼ떆\r\n    // ?ㅼ뼱?⑤떎. ?대? 洹?遺?ш? ?좏깮???덉쑝硫??ㅼ떆 ?몄? ?딅뒗??\r\n    const changed = representative.id !== selectedMemberId\r\n    selectMember(representative.id)\r\n    if (changed) capture('member_selected', { source: 'section' })\r\n  }\r\n\r\n  const activateRow = (\r\n    event: KeyboardEvent<HTMLTableRowElement>,\r\n    sectionId: string,\r\n  ) => {\r\n    if (event.key !== 'Enter' && event.key !== ' ') return\r\n    event.preventDefault()\r\n    selectSection(sectionId)\r\n  }\r\n\r\n  return (\r\n    <div className={styles.tableFrame}>\r\n      <table className={styles.table}>\r\n        <thead>\r\n          <tr>\r\n            <th scope=\"col\">寧?뤇</th>\r\n            <th scope=\"col\">??씊</th>\r\n            <th scope=\"col\">訝사춮</th>\r\n            <th scope=\"col\">躍?춮 / ?귙겙?됬춮</th>\r\n            <th scope=\"col\">亮끾??곭춮 / ?밭춮</th>\r\n            <th scope=\"col\">Fc</th>\r\n            <th scope=\"col\">grade</th>\r\n            <th scope=\"col\">泳숁뎸?밧폀</th>\r\n            <th scope=\"col\">?뗣겤?딀씉餓?/th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {project.sections.map((section) => {\r\n            const selected = selectedSectionId === section.id\r\n            const updateCurrent = (updater: (current: Section) => Section) =>\r\n              update(section.id, updater)\r\n\r\n            return (\r\n              <tr\r\n                key={section.id}\r\n                className={selected ? styles.selectedRow : undefined}\r\n                data-testid={`section-row-${section.id}`}\r\n                tabIndex={0}\r\n                aria-selected={selected}\r\n                onClick={() => selectSection(section.id)}\r\n                onKeyDown={(event) => activateRow(event, section.id)}\r\n              >\r\n                <td>\r\n                  <input\r\n                    className={styles.markInput}\r\n                    value={section.mark}\r\n                    aria-label={`${sectionMarkLabel(section)} 寧?뤇`}\r\n                    onChange={(event) => {\r\n                      const mark = event.currentTarget.value\r\n                      updateCurrent((current) => ({ ...current, mark }))\r\n                    }}\r\n                  />\r\n                  {section.storyLabel ? (\r\n                    <span className={styles.storyLabel}>\r\n                      {section.storyLabel}\r\n                    </span>\r\n                  ) : null}\r\n                </td>\r\n                <td>\r\n                  <SectionDimension section={section} update={updateCurrent} />\r\n                </td>\r\n                <td>\r\n                  {section.kind === '?? ? (\r\n                    <ColumnMainField\r\n                      section={section}\r\n                      update={updateCurrent}\r\n                    />\r\n                  ) : section.kind === '?먬쐡鶯? ? (\r\n                    <WallBarField\r\n                      section={section}\r\n                      update={updateCurrent}\r\n                      row=\"vertical\"\r\n                    />\r\n                  ) : section.kind === '佯딀씮' ? (\r\n                    <SlabBarField\r\n                    