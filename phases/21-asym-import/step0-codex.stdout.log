ming-plan\\parse.ts:584:      a.xGrid.axes[0].positionPt - b.xGrid.axes[0].positionPt ||\r\nsrc/lib/import\\framing-plan\\parse.ts:585:      a.yGrid.axes[0].positionPt - b.yGrid.axes[0].positionPt,\r\nsrc/lib/import\\framing-plan\\parse.ts-586-  )\r\nsrc/lib/import\\framing-plan\\parse.ts-587-}\r\nsrc/lib/import\\framing-plan\\parse.ts-588-\r\n--\nsrc/lib/import\\framing-plan\\parse.ts-614-    const candidate = gridCandidate(sequence)\r\nsrc/lib/import\\framing-plan\\parse.ts-615-    const key = [\r\nsrc/lib/import\\framing-plan\\parse.ts-616-      candidate.direction,\r\nsrc/lib/import\\framing-plan\\parse.ts:617:      candidate.axes.map((axis) => axis.label).join(','),\r\nsrc/lib/import\\framing-plan\\parse.ts-618-      candidate.spansMm.join(','),\r\nsrc/lib/import\\framing-plan\\parse.ts-619-    ].join('|')\r\nsrc/lib/import\\framing-plan\\parse.ts-620-    if (seen.has(key)) continue\r\n--\nsrc/lib/import\\framing-plan\\parse.ts-624-  grids.sort(\r\nsrc/lib/import\\framing-plan\\parse.ts-625-    (a, b) =>\r\nsrc/lib/import\\framing-plan\\parse.ts-626-      a.direction.localeCompare(b.direction) ||\r\nsrc/lib/import\\framing-plan\\parse.ts:627:      a.axes[0].positionPt - b.axes[0].positionPt,\r\nsrc/lib/import\\framing-plan\\parse.ts-628-  )\r\nsrc/lib/import\\framing-plan\\parse.ts-629-\r\nsrc/lib/import\\framing-plan\\parse.ts-630-  const blocks = buildBlocks(\r\n--\nsrc/lib/import\\framing-plan\\types.ts-13-\r\nsrc/lib/import\\framing-plan\\types.ts-14-export type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\nsrc/lib/import\\framing-plan\\types.ts-15-\r\nsrc/lib/import\\framing-plan\\types.ts:16:/** 伏図에서 읽은 通り芯 한 본. positionPt는 도면 좌표(pt) — 부재 스냅의 기준. */\r\nsrc/lib/import\\framing-plan\\types.ts-17-export interface AxisCandidate {\r\nsrc/lib/import\\framing-plan\\types.ts:18:  label: string\r\nsrc/lib/import\\framing-plan\\types.ts:19:  positionPt: number\r\nsrc/lib/import\\framing-plan\\types.ts-20-}\r\nsrc/lib/import\\framing-plan\\types.ts-21-\r\nsrc/lib/import\\framing-plan\\types.ts-22-/** 한 방향(X 또는 Y)의 通り芯 열 후보. 승인 전에는 형상이 되지 않는다 (ADR-030). */\r\n--\nsrc/lib/import\\framing-plan\\types.ts-88-export interface ElevationLevel {\r\nsrc/lib/import\\framing-plan\\types.ts-89-  /** 그 높이에 적힌 라벨 원문 전부. 없으면 빈 배열 — 지어내지 않는다 */\r\nsrc/lib/import\\framing-plan\\types.ts-90-  labels: string[]\r\nsrc/lib/import\\framing-plan\\types.ts:91:  positionPt: number\r\nsrc/lib/import\\framing-plan\\types.ts-92-}\r\nsrc/lib/import\\framing-plan\\types.ts-93-\r\nsrc/lib/import\\framing-plan\\types.ts-94-/**\r\n--- index diff\r\ndiff --git a/phases/21-asym-import/index.json b/phases/21-asym-import/index.json\nindex e81dbc7..18b8a8b 100644\n--- a/phases/21-asym-import/index.json\n+++ b/phases/21-asym-import/index.json\n@@ -6,7 +6,8 @@\n       \"step\": 0,\n       \"name\": \"verify-adr033-premises\",\n       \"kind\": \"verify\",\n-      \"status\": \"pending\"\n+      \"status\": \"pending\",\n+      \"started_at\": \"2026-08-26T13:39:00+0900\"\n     },\n     {\n       \"step\": 1,\n@@ -18,5 +19,6 @@\n       \"name\": \"import-apply-and-editor\",\n       \"status\": \"pending\"\n     }\n-  ]\n-}\n+  ],\n+  \"created_at\": \"2026-08-26T13:39:00+0900\"\n+}\n\\ No newline at end of file\n--- phase files\r\n\r\nName                   Length LastWriteTime        \r\n----                   ------ -------------        \r\nindex.json                498 2026-08-26 오후 1:39:00\r\nstep0-codex.stderr.log      0 2026-08-26 오후 1:39:00\r\nstep0-codex.stdout.log      0 2026-08-26 오후 1:39:00\r\nstep0.md                 2236 2026-08-26 오후 1:23:03\r\nstep1.md                 3339 2026-08-26 오후 1:23:03\r\nstep2.md                 3991 2026-08-26 오후 1:23:35\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
