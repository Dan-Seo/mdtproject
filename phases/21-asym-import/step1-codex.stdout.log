nd\\\": \\\"verify\\\",\\r\\n      \\\"status\\\": \\\"pending\\\",\\r\\n      \\\"started_at\\\": \\\"2026-08-26T13:39:00+0900\\\"\\r\\n    },\\r\\n    {\\r\\n      \\\"step\\\": 1,\\r\\n      \\\"name\\\": \\\"parse-asymmetric-cells\\\",\\r\\n      \\\"status\\\": \\\"pending\\\"\\r\\n    },\\r\\n    {\\r\\n      \\\"step\\\": 2,\\r\\n      \\\"name\\\": \\\"import-apply-and-editor\\\",\\r\\n      \\\"status\\\": \\\"pending\\\"\\r\\n    }\\r\\n  ],\\r\\n  \\\"created_at\\\": \\\"2026-08-26T13:39:00+0900\\\"\\r\\n}\\r\\n--- src/domain/model/project.ts\\r\\n   */\\r\\n  memberOffsetsMm: number[]\\r\\n  /** ?싥걮嶺?肄붿뼱 湲몄씠 (mm) = 誇?끾퀡 竊?誇訝?뼋?긱겗邕멩뼶?묆걵??*/\\r\\n  coreLengthMm: number\\r\\n}\\r\\n\\r\\nfunction girderAxisIndex(position: GirderPosition): number {\\r\\n  return position.axis === 'X' ? position.ix : position.iy\\r\\n}\\r\\n\\r\\nexport function girderRun(project: Project, member: Member): GirderRun {\\r\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\r\\n    throw new Error(`girderRun requires a 鸚㎪쥈: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const position = member.position\\r\\n  const candidates = project.members\\r\\n    .filter((candidate) => {\\r\\n      if (\\r\\n        candidate.kind !== '鸚㎪쥈' ||\\r\\n        candidate.storyId !== member.storyId ||\\r\\n        !isGirderPosition(candidate.position) ||\\r\\n        candidate.position.axis !== position.axis\\r\\n      ) {\\r\\n        return false\\r\\n      }\\r\\n\\r\\n      return position.axis === 'X'\\r\\n        ? candidate.position.iy === position.iy\\r\\n        : candidate.position.ix === position.ix\\r\\n    })\\r\\n    .sort((left, right) => {\\r\\n      if (!isGirderPosition(left.position) || !isGirderPosition(right.position)) {\\r\\n        throw new Error('鸚㎪쥈 run contains a non-girder position')\\r\\n      }\\r\\n      return girderAxisIndex(left.position) - girderAxisIndex(right.position)\\r\\n    })\\r\\n  const memberIndex = candidates.findIndex(({ id }) => id === member.id)\\r\\n\\r\\n  if (memberIndex < 0) {\\r\\n    throw new Error(`鸚㎪쥈 member not found in project: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  let first = memberIndex\\r\\n  let last = memberIndex\\r\\n  while (\\r\\n    first > 0 &&\\r\\n    girderAxisIndex(candidates[first - 1].position as GirderPosition) ===\\r\\n      girderAxisIndex(candidates[first].position as GirderPosition) - 1\\r\\n  ) {\\r\\n    first -= 1\\r\\n  }\\r\\n  while (\\r\\n    last + 1 < candidates.length &&\\r\\n    girderAxisIndex(candidates[last + 1].position as GirderPosition) ===\\r\\n      girderAxisIndex(candidates[last].position as GirderPosition) + 1\\r\\n  ) {\\r\\n    last += 1\\r\\n  }\\r\\n\\r\\n  const members = candidates.slice(first, last + 1)\\r\\n  const sectionId = members[0].sectionId\\r\\n  if (members.some((candidate) => candidate.sectionId !== sectionId)) {\\r\\n    throw new Error(\\r\\n      `鸚㎪쥈 run contains mixed sections: ${members.map(({ id, sectionId: idOfSection }) => `${id}:${idOfSection}`).join(', ')}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const spans = members.map((candidate) => girderSpan(project, candidate))\\r\\n  // ?ㅽ뙩 ?쒖옉硫대뱾???꾩쟻 ?꾩튂. 留덉?留??ㅽ뙩 ?쒖옉硫?竊?洹??끾퀡??肄붿뼱 湲몄씠????\\r\\n  // ??媛믪쓣 ?곕줈 ?몃㈃ 怨??닿툔?섎?濡???踰덈쭔 ?꾩쟻?쒕떎.\\r\\n  const memberOffsetsMm: number[] = []\\r\\n  let offsetMm = 0\\r\\n  for (const span of spans) {\\r\\n    memberOffsetsMm.push(offsetMm)\\r\\n    offsetMm += span.clear + span.endSupportLengthAlongAxisMm\\r\\n  }\\r\\n  const lastSpan = spans[spans.length - 1]\\r\\n  const coreLengthMm =\\r\\n    memberOffsetsMm[memberOffsetsMm.length - 1] + lastSpan.clear\\r\\n\\r\\n  return {\\r\\n    axis: position.axis,\\r\\n    members,\\r\\n    ownerId: members[0].id,\\r\\n    spans,\\r\\n    memberOffsetsMm,\\r\\n    coreLengthMm,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?긴말嶺뗣겗塋?깿?▽뻑 (R7?졼꺕R9????\\r\\n *\\r\\n * 若싩?(bottom)? ?ㅽ깮??**理쒗븯??*(湲곗큹)?먮쭔 遺숇뒗?? 訝?뼋 ?묓빀遺??泥좉렐??\\r\\n--- src/lib/import/framing-plan/types.ts\\r\\n/**\\r\\n * ???鍮덉뭏?쇰줈 ?④릿 ?ъ쑀 肄붾뱶 (section-list??CANDIDATE_ISSUES ?⑦꽩).\\r\\n * ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎.\\r\\n */\\r\\nexport const PLAN_GRID_ISSUES = [\\r\\n  '?싥굤??꺀?쇻꺂?ゆ쩂??,\\r\\n  '野멩퀡轝좄맼',\\r\\n  '潁?갰訝띷빐??,\\r\\n  '?덅쮫訝띴???,\\r\\n  '?⒲깧?ユ뻼耶쀦렁??,\\r\\n  '?싥굤???恙쒍툖??,\\r\\n] as const\\r\\n\\r\\nexport type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\\r\\n\\r\\n/** 鴉뤷쎋?먯꽌 ?쎌? ?싥굤????蹂? positionPt???꾨㈃ 醫뚰몴(pt) ??遺???ㅻ깄??湲곗?. */\\r\\nexport interface AxisCandidate {\\r\\n  label: string\\r\\n  positionPt: number\\r\\n}\\r\\n\\r\\n/** ??諛⑺뼢(X ?먮뒗 Y)???싥굤?????꾨낫. ?뱀씤 ?꾩뿉???뺤긽???섏? ?딅뒗??(ADR-030). */\\r\\nexport interface PlanGridCandidate {\\r\\n  /** ?쇰꺼??異?臾몄옄 ??諛대뱶??湲고븯 諛⑺뼢???꾨땲???꾨㈃??遺숈씤 ?대쫫???곕Ⅸ??*/\\r\\n  direction: 'X' | 'Y'\\r\\n  /** ?꾩튂 ?ㅻ쫫李⑥닚 */\\r\\n  axes: AxisCandidate[]\\r\\n  /** ?몄젒 異??ъ씠 移섏닔(mm). 湲몄씠??axes.length - 1 */\\r\\n  spansMm: number[]\\r\\n  /** ?ㅼ륫 異뺤쿃(pt/mm) ?????ㅽ뙩 ?ㅼ륫??以묒븰媛? ?쒓린 異뺤쿃? ?⑹? ?섏〈?대씪 誘우? ?딅뒗??*/\\r\\n  scalePtPerMm: number\\r\\n  /** ?꾨㈃???꾩껜 移섏닔媛 紐낃린???덇퀬 ?ㅽ뙩 ?⑷낵 ?쇱튂?덈떎 */\\r\\n  totalConfirmed: boolean\\r\\n}\\r\\n\\r\\n/**\\r\\n * 遺?멸? 洹몃━?쒖쓽 ?대뵒???볦??붽? ???꾨㈃?먯꽌 ??**湲고븯**留?留먰븳??\\r\\n *\\r\\n * ?똂硫??긱띿쿂??遺???묐몢濡?遺??醫낅퀎???뺥븯吏 ?딅뒗?? 醫낅퀎? ??씊?ゃ궧?덇?\\r\\n * ?대? 媛뽮퀬 ?덉쑝誘濡?ADR-018), 痍⑥엯??洹?醫낅퀎怨???湲고븯瑜?留욎떠 蹂몃떎 ??\\r\\n * ?닿툔?섎㈃ ?щ엺???먮떒???쇱씠吏 ?뚯꽌媛 怨좊? ?쇱씠 ?꾨땲??\\r\\n */\\r\\nexport const PLAN_PLACEMENT_ROLES = ['?쇔춴??, '渦?, '?쇻궎'] as const\\r\\n\\r\\nexport type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\\r\\n\\r\\nexport type MemberPlacement =\\r\\n  | { mark: string; role: '?쇔춴?? | '?쇻궎'; ix: number; iy: number }\\r\\n  | {\\r\\n      mark: string\\r\\n      role: '渦?\\r\\n      /** 遺?ш? ?쒖옉?섎뒗 寃⑹옄??*/\\r\\n      ix: number\\r\\n      iy: number\\r\\n      /** 遺?ш? 六쀫뒗 諛⑺뼢 (GirderPosition.axis? 媛숈? ?? */\\r\\n      axis: 'X' | 'Y'\\r\\n    }\\r\\n\\r\\n/**\\r\\n * ?꾨㈃ ?꾩쓽 鴉뤷쎋 ???? ???섏씠吏???щ윭 ?μ씠 ?ㅻ━誘濡??ㅻЪ yokohama p7?\\r\\n * 2?롥틞鴉뤷쎋? R?롥틞鴉뤷쎋 ???? ?싥굤???뺤쓽媛 媛숈븘??**?꾩튂媛 ?ㅻⅤ??* ??\\r\\n * 洹몃━???뺤쓽???묓엳吏留?釉붾줉? ?묓엳吏 ?딅뒗??\\r\\n */\\r\\nexport interface PlanBlock {\\r\\n  /** 釉붾줉 ?쒕ぉ ?먮Ц(???롥틞鴉뤷쎋1/100??. ?대뒓 Story?몄????щ엺???뺥븳??*/\\r\\n  title?: string\\r\\n  /** ??釉붾줉怨?吏앹??댁쭊 X쨌Y ?싥굤???뺤쓽. 痍⑥엯? 諛섎뱶?????섏쓣 ?대떎 */\\r\\n  xGrid: PlanGridCandidate\\r\\n  yGrid: PlanGridCandidate\\r\\n  placements: MemberPlacement[]\\r\\n  /** 釉붾줉 ?덉뿉 ?덉쑝???ㅻ깄?섏? 紐삵븳 遺??以묐났 ?놁쓬, ?먮Ц ?? ??吏?대궡吏 ?딅뒗??*/\\r\\n  unplacedMarks: string[]\\r\\n}\\r\\n\\r\\nexport interface ParsedFramingPlan {\\r\\n  /** ?싥굤???뺤쓽 ??媛숈? 洹몃━?쒓? ?щ윭 釉붾줉??諛섎났?섎㈃ ?섎굹濡??묓엺??*/\\r\\n  grids: PlanGridCandidate[]\\r\\n  blocks: PlanBlock[]\\r\\n  /** ?꾨낫瑜?紐????ъ쑀 ??泥??깆옣 ?? 以묐났 ?놁쓬 */\\r\\n  issues: PlanGridIssue[]\\r\\n}\\r\\n\\r\\n/** 邕며탡?녹뿉??怨꾩뿴??紐????ъ쑀. ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎 */\\r\\nexport const ELEVATION_ISSUES = ['野멩퀡?쀦쑋濾쒎눣'] as const\\r\\n\\r\\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\\r\\n\\r\\nexport interface ElevationLevel {\\r\\n  /** 洹??믪씠???곹엺 ?쇰꺼 ?먮Ц ?꾨?. ?놁쑝硫?鍮?諛곗뿴 ??吏?대궡吏 ?딅뒗??*/\\r\\n  labels: string[]\\r\\n  positionPt: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * 邕며탡????怨꾩뿴???믪씠 諛⑺뼢 ?쎄린. ?뚯뼱???덈꺼??Story??寃쎄퀎?멸??띾뒗 ?뺥븯吏\\r\\n * ?딅뒗?????먮Ц?먮뒗 FL쨌GL쨌?븀쨴訝뗧ク쨌RCL???욎뿬 ?덇퀬, 洹몄쨷 臾댁뾿???롮씤吏??\\r\\n * 議곕Ц???꾨땲???ㅺ퀎 ?섎룄???щ엺???쎌쓣 ?쇱씠??(ADR-030).\\r\\n *\\r\\n * ?싥굤??낵 ?щ━ ?쇰꺼??醫뚯슦 ?뺣젹???쇱젙?섏? ?딆븘(?ㅻЪ p8??醫뚮떒 x??108~198濡?\\r\\n * ?⑹뼱吏꾨떎) ?쇰꺼 諛대뱶瑜??듭빱濡??????녿떎. ?듭빱??**移섏닔 ??*?닿퀬, 移섏닔媛 ?먭린\\r\\n * 援ш컙??以묒젏???볦씤?ㅻ뒗 愿怨꾨줈 異뺤쿃怨??덈꺼 ?꾩튂瑜??④퍡 ?쇰떎.\\r\\n */\\r\\nexport interface ElevationCandidate {\\r\\n  /** ??怨꾩뿴??嫄몃━??邕며탡???쒕ぉ???먮Ц). ??怨꾩뿴???щ윭 ?싥굤??怨듯넻?쇰줈 嫄몃┛??*/\\r\\n  titles: string[]\\r\\n  /** ?꾨㈃ 醫뚰몴 ?????꾩뿉???꾨옒濡?*/\\r\\n  levels: ElevationLevel[]\\r\\n  /** ?몄젒 ?덈꺼 ?ъ씠 移섏닔(mm). 湲몄씠??levels.length - 1 */\\r\\n  heightsMm: number[]\\r\\n  scalePtPerMm: number\\r\\n}\\r\\n\\r\\nexport interface ParsedFrameElevations {\\r\\n  elevations: ElevationCandidate[]\\r\\n  issues: ElevationIssue[]\\r\\n}\\r\\n\\r\\n/** 痍⑥엯???듭㎏濡?嫄곕????ъ쑀. ?대븣 旅덁뻑? ?먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\\r\\nexport const PLAN_APP