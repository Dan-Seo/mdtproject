뷸틬 1?싧뎴3) ??닓?쇻겓?긱걣?ゃ걚)??\n   */\r\n  widthTie?: { size: BarSize; pitchMm: number }\r\n  /**\r\n   * ?밭춮?귛쎋?㏂걣??-D10?띲겏?멥걦?겹걹??굚????1?싧뎴7) ??돯餓섅겎??겒?꾠?\n   * ?ゅ츣獰⒲겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲굮?뤷뫑?쇻굥 (ADR-012)??\n   * 鵝숅빓 (extraLengthMm) ??쎋?㏂겓?▲걚 ???뽧굤渦쇈겳?담걣黎뷩굙??(R9????\n   */\r\n  sideBar?: { size: BarSize; count: number }\r\n  /** ?먬쐡鶯곥겗鶯곩럻 (mm)??*/\r\n  thickness?: number\r\n  /** ?먬쐡鶯곥겗?띸춮掠ㅶ빊?귛쎋?㏂겗?룔꺍?겹꺂/??뽧꺂烏②쮼?믡걹??겲?얍룛?묆굥??*/\r\n  layers?: 1 | 2\r\n  /** ?먬쐡鶯곥겗潁?춮?삥Ø嶺뗣?*/\r\n  vertical?: { size: BarSize; pitchMm: number }\r\n  horizontal?: { size: BarSize; pitchMm: number }\r\n  /** 佯딀씮??뼶?묆겘?곮뻗??군若싧뎺?ゃ겗?㎫윮渦뷩꺕?룩씌??겲?얌퓷?곥걲?뗣?*/\r\n  shortSide?: {\r\n    top?: { size: BarSize; pitchMm: number }\r\n    bottom?: { size: BarSize; pitchMm: number }\r\n  }\r\n  longSide?: {\r\n    top?: { size: BarSize; pitchMm: number }\r\n    bottom?: { size: BarSize; pitchMm: number }\r\n  }\r\n  /** 鰲ｉ뇠?㎯걤?싩㈉轝꾠겓?쀣걼?끿쎅??렅?뉎?*/\r\n  raw: Record<string, string>\r\n  issues: CandidateIssue[]\r\n}\r\n\r\n/**\r\n * ???섎굹媛 ?듭㎏濡??꾨낫瑜?紐????ъ쑀. ?꾨낫 諛곗뿴??鍮꾩뿀?ㅻ뒗 ?ъ떎留뚯쑝濡쒕뒗\r\n * ?뚨Е?룹쓣 紐??쎌뿀?ㅳ띿? ?뚨Е?룹? ?쎌뿀?붾뜲 ??ぉ ?됱쓣 紐??쎌뿀?ㅳ띻? 援щ텇?섏? ?딄퀬,\r\n * ?섏? ?ъ슜?먭? ?먮룄?먯꽌 蹂?怨녹씠 ?ㅻⅤ??\r\n */\r\nexport const LIST_ISSUES = ['寧?뤇烏뚧쑋沃띹춼', '?끿쎅烏뚧쑋沃띹춼'] as const\r\n\r\nexport type ListIssue = (typeof LIST_ISSUES)[number]\r\n\r\nexport interface ParsedSectionList {\r\n  listKind: string\r\n  candidates: SectionCandidate[]\r\n  issue?: ListIssue\r\n}\r\n\r\nimport {\r\n  BAR_SIZES,\r\n  SHEAR_BAR_SIZES,\r\n  type BarSize,\r\n  type ShearBarSize,\r\n} from '@/domain/model/member'\r\n\r\nimport {\r\n  compact,\r\n  makeSegments,\r\n  normalized,\r\n  PROXIMITY_MULTIPLIER,\r\n  recoverRows,\r\n  verticalRuns,\r\n  type TextRow,\r\n  type TextSegment,\r\n  type VerticalRun,\r\n} from '../runs'\r\n\r\nimport type {\r\n  CandidateIssue,\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from './types'\r\n\r\ninterface MarkColumn {\r\n  mark: string\r\n  centerX: number\r\n}\r\n\r\ninterface PositionColumn {\n  label: string\n  rawLabel: string\n  centerX: number\n  mark: string\n}\n\r\ninterface StoryRow {\r\n  label: string\r\n  row: TextRow\r\n}\r\n\r\ninterface TitleAnchor {\r\n  listKind: string\r\n  /** 罹≪쿂媛 ?꾨땶 ??댄? ?멸렇癒쇳듃 ?먮Ц ??野얕괌鸚??먯젙? ?ш린瑜?蹂몃떎 */\r\n  titleText: string\r\n  row: TextRow\r\n  x: number\r\n}\r\n\r\ninterface ParsedBar {\r\n  size: BarSize\r\n  count: number\r\n}\r\n\r\nconst barSizes = new Set<BarSize>(BAR_SIZES)\r\n// 躍?춮?삠걗?겹굢嶺뗣걽?묆걣遙섇섭佯╉걵?볠뼪獒쒎섭嶺?(K13?팗13) ?믣룚?뚣굥?귚말嶺뗣겗 barSizes ??\n// ?녴걨?╉걚?뗣겗??곦말嶺뗣겓?γ굥?②〃5.3.4?삭〃5.3.2 ?ャ겒?꾢푶?믣폊?뤵걢?됥걽 (ADR-026)??\nconst shearBarSizes = new Set<ShearBarSize>(SHEAR_BAR_SIZES)\r\n\r\nconst TITLE_PATTERN =\r\n  /(?길뼪?㏂꺁?밤깉|鸚㎪쥈??씊?ゃ궧??弱뤸쥈??씊?ゃ궧??弱뤸쥈?ゃ궧???뉑똻歟곥꺁?밤깉|?뉑똻?밤꺀?뽧꺁?밤깉|?먨쑇?덀꺁?밤깉|鶯곥꺁?밤깉|?밤꺀?뽧꺁?밤깉|?겻릎歟곥꺁?밤깉|?긱꺁?밤깉|鸚㎪쥈?ゃ궧??歟곥꺁?밤깉)/\r\nconst STORY_PATTERN = /^(?:RF|R??\\d+F|\\d+??$/\r\nconst MARK_PATTERN = /^(?:(?:FCG|CG|EW|BW|FS|CS|FC|FG|FB|CB|C|G|B|S|W)\\d+[A-Z]?|fg)$/i\r\n\r\n/** ?몃줈 ?곗쓣 痢??щ씪?댁뒪??諛곗젙???뚯쓽 嫄곕━ ?곹븳 = ?щ씪?댁뒪 ??횞 ??媛?\r\n *  諛곗젙 ?듭빱媛 痢??쇰꺼?대뜕 ?숈븞?먮뒗 ??寃?ш? 以묎컙 痢듭뿉????긽 李몄씠?덈떎 ??\n *  ?щ씪?댁뒪媛 留욌떯???덉뼱(endY[i] == startY[i+1]) ?쇰꺼 理쒓렐?묒쓽 蹂대줈?몄씠 寃쎄퀎媛\r\n *  span/2? ?뺥솗???쇱튂?덇린 ?뚮Ц?대떎. ?듭빱瑜??쒖쓽 ?됱쑝濡?諛붽퓭 ?곹븳???ㅼ젣濡?\n *  ?묐룞?섍쾶 ?먮떎 (#32?? verticalsBySlice 李멸퀬) */\r\nconst SLICE_DISTANCE_LIMIT_RATIO = 0.5\r\n\r\n/**\r\n * ?쒖젣?(?꾨㈃ ?고븯??釉붾줉)???녜씊?띸㎞ 移몄뿉??洹??꾨㈃???대쫫???ㅼ뼱媛꾨떎 ??\n * ?뚧쥈?ゃ궧?덀띿쿂??由ъ뒪????댄?怨?湲?먭? 媛숇떎. ?닿쾬???듭빱濡??≪쑝硫????쒓? 嫄곌린??\n * ?딄꺼 留덉?留?痢?釉붾줉???곗씠???됱씠 ?듭㎏濡??щ씪吏꾨떎: ?ㅻЪ ojkk p3?먯꽌 2F 7移몄씠\r\n * 議곗슜???놁뼱議뚭퀬(寧?뤇 ?됱? 寃쎄퀎 ?? ?곗씠???됱? 諛?, ?꾨낫 0媛쒖쭨由??좊졊 由ъ뒪?멸?\r\n * ?뚯씤??紐????쒓? ?덈떎?띾줈 ?쒖떆?먮떎.\r\n *\r\n * ?쇰꺼? 媛믨낵 ?곕줈 ?⑥뼱吏湲곕룄 ?섍퀬(ojkk: ?뚦쎋?℡릫燁겹??ㅼ쓬 ?멸렇癒쇳듃媛 ?뚧쥈?ゃ궧?덀?\r\n * ???⑹씠媛 ?섍린???쒕떎(yokohama: ?똀1=1/30?녜씊?띸㎞鸚㎪쥈??씊?ゃ궧?덀? ??????蹂몃떎.\r\n * ???꾩껜瑜?蹂댁????딅뒗?? ?쒖젣? ?좊뒗 ?꾨㈃ ??쓣 媛濡쒖?瑜대?濡?ojkk ?ㅼ륫 x=893~1150)\r\n * 媛숈? y???볦씤 吏꾩쭨 ??댄?源뚯? ?④퍡 吏?뚯쭊??\r\n */\r\nfunction isTitleBlockField(segments: TextSegment[], index: number): boolean {\r\n  return (\r\n    segments[index].compact.includes('?녜씊?띸㎞') ||\r\n    segments[index - 1]?.compact.endsWith('?녜씊?띸㎞') === true\r\n  )\r\n}\r\n\r\nfunction titleAnchors(rows: TextRow[]): TitleAnchor[] {\r\n  const anchors: TitleAnchor[] = []\r\n\r\n  // ???됱뿉 ??댄????щ윭 媛쒕㈃(醫뚯슦 蹂묒튂) ?꾨? ?듭빱濡??〓뒗??\n  for (const row of rows) {\r\n    for (const [index, segment] of row.segments.entries()) {\r\n      const match = segment.compact.match(TITLE_PATTERN)\r\n      if (!match || isTitleBlockField(row.segments, index)) continue\r\n      anchors.push({\r\n        listKind: match[1],\r\n        titleText: segment.compact,\r\n        row,\r\n        x: segment.x,\r\n      })\r\n    }\r\n  }\r\n\r\n  return anchors.sort(\r\n    (left, right) => left.row.y - right.row.y || left.x - right.x,\r\n  )\r\n}\r\n\r\nfunction exactLabel(row: TextRow, aliases: readonly string[]): TextSegment | undefined {\r\n  const normalizedAliases = aliases.map(compact)\r\n  return row.segments.find((segment) =>\r\n    normalizedAliases.includes(segment.compact),\r\n  )\r\n}\r\n\r\nfunction canonicalMark(value: string): string | undefined {\r\n  const mark = compact(value)\r\n  if (!MARK_PATTERN.test(mark)) return undefined\r\n  return mark === 'fg' ? mark : mark.toUpperCase()\r\n}\r\n\r\nfunction markColumns(row: TextRow): MarkColumn[] {\r\n  const label = exactLabel(row, ['寧?뤇'])\r\n  if (!label) return []\r\n\r\n  return row.segments\r\n    .filter((segment) => segment.centerX > label.endX)\r\n    .map((segment) => ({\r\n      mark: canonicalMark(segment.text),\r\n      centerX: segment.centerX,\r\n    }))\r\n    .filter((entry): entry is MarkColumn => entry.mark !== undefined)\r\n}\r\n\r\nfunction storyFromRow(row: TextRow): string | undefined {\r\n  return row.segments\r\n    .map((segment) => segment.compact)\r\n    .find((value) => STORY_PATTERN.test(value))\r\n}\r\n\r\n/**\r\n * 弱뤸쥈쨌?겻릎歟겶룟읃鹽?由ъ뒪?몃뒗 諛섏쁺 ??곸씠 ?꾨땲??(ADR-005). 罹≪쿂(listKind)??\n * ?뚦읃鹽롦쥈?ゃ궧?덀띿뿉???뚧쥈?ゃ궧?덀띾줈 ?섎━誘濡???댄? ?먮Ц??蹂몃떎.\r\n * ?꾨낫 遺꾨쪟? ?몄떇 ?ㅽ뙣 ?덈궡媛 媛숈? ?먯젙??遊먯빞 ?쒕떎 ???쒖そ留?怨좎튂硫?\n * ?뚰썑蹂대뒗 野얕괌鸚뽰씤???ㅽ뙣 ?덈궡???щ떎?띾줈 議곗슜??媛덈씪吏꾨떎\r\n */\r\nfunction isOutOfScopeList(titleText: string): boolean {\r\n  return /弱뤸쥈|?겻릎歟??븀쨴|?뉑똻歟??뉑똻?밤꺀???먨쑇??.test(titleText)\r\n}\r\n\r\nfunction kindFromMark(mark: string, titleText: string): SectionCandidate['kind'] {\r\n  if (isOutOfScopeList(titleText)) return '野얕괌鸚?\r\n  if (/^C\\d/i.test(mark)) return '??\r\n  if (/^G\\d/i.test(mark)) return '鸚㎪쥈'\r\n  return '野얕괌鸚?\r\n}\r\n\r\nfunction median(values: number[]): number {\r\n  if (values.length === 0) return 1\r\n  const sorted = [...values].sort((left, right) => left - right)\r\n  return sorted[Math.floor(sorted.length / 2)]\r\n}\r\n\r\nfunction positionColumns(row: TextRow, marks: MarkColumn[]): PositionColumn[] {\r\n  const label = exactLabel(row, ['鵝띸쉰'])\r\n  if (!label || marks.length === 0) return []\r\n\r\n  const positions = row.segments\n    .filter((segment) => segment.centerX > label.endX)\n    .map((segment) => ({\n      label: segment.compact,\n      rawLabel: segment.text,\n      centerX: segment.centerX,\n    }))\n    .filter((position) => position.label.length > 0)\r\n\r\n  if (positions.length === 0) return []\r\n\r\n  const spacings = positions\r\n    .slice(1)\r\n    .map((position, index) => position.centerX - positions[index].centerX)\r\n    .filter((spacing) => spacing > 0)\r\n  const emptyPenalty = Math.pow(median(spacings) * 0.75, 2)\r\n  const costs = Array.from({ length: marks.length + 1 }, () =>\r\n    Array<number>(positions.length + 1).fill(Number.POSITIVE_INFINITY),\r\n  )\r\n  const choices = Array.from({ length: marks.length + 1 }, () =>\r\n    Array<number>(positions.length + 1).fill(0),\r\n  )\r\n  costs[0][0] = 0\r\n\r\n  for (let markIndex = 0; markIndex < marks.length; markIndex += 1) {\r\n    for (let used = 0; used <= positions.length; used += 1) {\r\n      if (!Number.isFinite(costs[markIndex][used])) continue\r\n      for (let count = 0; used + count <= positions.length; count += 1) {\r\n        const group = positions.slice(used, used + count)\r\n        const mean =\r\n          count === 0\r\n            ? marks[markIndex].centerX\r\n            : group.reduce((total, position) => total + position.centerX, 0) /\r\n              count\r\n        const spread =\r\n          count === 0\r\n            ? 0\r\n            : group.reduce(\r\n                (total, position) => total + Math.pow(position.centerX - mean, 2),\r\n                0,\r\n              ) / count\r\n        const groupCost =\r\n          count === 0\r\n            ? emptyPenalty\r\n            : Math.pow(mean - marks[markIndex].centerX, 2) + spread * 0.1\r\n        const nextCost = costs[markIndex][used] + groupCost\r\n        if (nextCost < costs[markIndex + 1][used + count]) {\r\n          costs[markIndex + 1][used + count] = nextCost\r\n          choices[markIndex + 1][used + count] = count\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  const counts = Array<number>(marks.length).fill(0)\r\n  let used = positions.length\r\n  for (let markIndex = marks.length; markIndex > 0; markIndex -= 1) {\r\n    const count = choices[markIndex][used]\r\n    counts[markIndex - 1] = count\r\n    used -= count\r\n  }\r\n\r\n  const result: PositionColumn[] = []\r\n  let positionIndex = 0\r\n  counts.forEach((count, markIndex) => {\r\n    for (let index = 0; index < count; index += 1) {\r\n      const position = positions[positionIndex]\r\n      result.push({ ...position, mark: marks[markIndex].mark })\r\n      positionIndex += 1\r\n    }\r\n  })\r\n  return result\r\n}\r\n\r\nfunction dataSegments(row: TextRow, aliases: readonly string[]): TextSegment[] {\r\n  const label = exactLabel(row, aliases)\r\n  if (!label) return []\r\n  return row.segments.filter((segment) => segment.centerX > label.endX)\r\n}\r\n\r\nfunction valuesAtTargets(\r\n  segments: TextSegment[],\r\n  targets: Array<{ id: string; centerX: number }>,\r\n): Map<string, string> {\r\n  const assigned = new Map<string, TextSegment[]>()\r\n  if (targets.length === 0) return new Map()\r\n  const bounded = boundedAnchors(targets)\r\n\r\n  for (const segment of segments) {\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    // ??媛꾧꺽???섏뼱 ?⑥뼱吏??멸렇癒쇳듃?????쒖쓽 移몄씠 ?꾨땲?? ?ㅻⅨ履????댁? ??\n    // 諛붽묑??湲?먮? ?꾨? ?쇳궓?????쒖젣????쒖? 媛숈? ?됱뿉 嫄몄튂硫???-D22?띻?\r\n    // ??-D22訝榮싧뻠影됧＋雅뗥떃??╉띻? ?섏뼱 ?뺤젙?대뜕 移몄씠 鰲ｉ뇠訝띹꺗?쇰줈 ?ㅼ쭛?뚮떎\r\n    // (?ㅻЪ ojkk p3 G5/2F). ?댁씠 ?섎굹肉먯씠硫??곹븳???녿떎(limit=Infinity)\r\n    if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n    const existing = assigned.get(target.id) ?? []\r\n    existing.push(segment)\r\n    assigned.set(target.id, existing)\r\n  }\r\n\r\n  return new Map(\r\n    [...assigned.entries()].map(([id, targetSegments]) => [\r\n      id,\r\n      targetSegments\r\n        .sort((left, right) => left.x - right.x)\r\n        .map((segment) => segment.text)\r\n        .join(''),\r\n    ]),\r\n  )\r\n}\r\n\r\nfunction valuesByMark(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  return valuesAtTargets(\r\n    dataSegments(row, aliases),\r\n    marks.map(({ mark, centerX }) => ({ id: mark, centerX })),\r\n  )\r\n}\r\n\r\nfunction segmentsByMark(\r\n  segments: TextSegment[],\r\n  marks: MarkColumn[],\r\n): Map<string, TextSegment[]> {\r\n  const grouped = new Map<string, TextSegment[]>()\r\n  if (marks.length === 0) return grouped\r\n\r\n  for (const segment of segments) {\r\n    const target = marks.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    const existing = grouped.get(target.mark) ?? []\r\n    existing.push(segment)\r\n    grouped.set(target.mark, existing)\r\n  }\r\n  return grouped\r\n}\r\n\r\n/**\r\n * 鵝띸쉰蹂?? 媛믪쓣 鵝띸쉰 ?몃뜳?ㅻ줈 ?섎룎由곕떎. 鵝띸쉰 ?댁쓣 ?섎굹??諛곗젙諛쏆? 紐삵븳 寧?뤇????\r\n * 諛곗젙 ??곸뿉??類????洹몃?濡??먮㈃ 洹????理쒓렐??鵝띸쉰(??寧?뤇??????遺숈뼱 ?⑥쓽 媛믪쓣\r\n * ?ㅼ뿼?쒗궓?? 鍮좎쭊 寧?뤇? valuesByMark濡??곕줈 ?쎈뒗??\r\n *\r\n * 寧?뤇 ???쑝濡?癒쇱? 媛瑜댁????딅뒗?? ?ㅻЪ ?꾨㈃(yokohama G54)?먯꽌 寧?뤇 ?ㅻ뜑 以묒떖??\n * ??寃쎄퀎? ?닿툔???댁썐 ??媛믪씠 ????덉쑝濡??ㅼ뼱?ㅻ뒗 寃쎌슦媛 ?덉뼱, ????곗꽑 諛곗젙?\r\n * 鵝띸쉰瑜?媛吏?寧?뤇???源뚯? 萸됯컿??\r\n */\r\nfunction valuesByPosition(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n  positions: PositionColumn[],\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  const positionless = new Set(\r\n    marks\r\n      .filter(({ mark }) => !positions.some((position) => position.mark === mark))\r\n      .map(({ mark }) => mark),\r\n  )\r\n  const segments = dataSegments(row, aliases)\r\n  const assignable =\r\n    positionless.size === 0\r\n      ? segments\r\n      : [...segmentsByMark(segments, marks)]\r\n          .filter(([mark]) => !positionless.has(mark))\r\n          .flatMap(([, group]) => group)\r\n\r\n  return valuesAtTargets(\r\n    assignable,\r\n    positions.map((position, index) => ({\r\n      id: String(index),\r\n      centerX: position.centerX,\r\n    })),\r\n  )\r\n}\r\n\r\n/** ?꾪봽 ?뺤긽 湲고샇(?≤룐뼡쨌??? ?댁쓬 ?섏씠????? 癒몃━???μ떇留?踰쀪릿?? */\r\nfunction stripDecoration(value: string): string {\r\n  return compact(value).replace(/^[-?△뼡??+/, '')\r\n}\r\n\r\nfunction parseBar(value: string): ParsedBar | undefined {\r\n  // parsePitch? 媛숈? 洹쒖빟: ?μ떇??踰쀪릿 ? ?꾩껜媛 ?⑥씪 ?뚧쑍??孃꾠띿씪 ?뚮쭔 ?뺤젙?쒕떎 ??\n  // 蹂듭닔 ?쒓린(??-D25+2-D22???? ?〓Ц?먭? 遺숈? ??0016-D25?띾룄 鍮덉뭏+?먮Ц 寃쎈줈濡?蹂대궦??\n  const match = stripDecoration(value).match(/^(\\d+)-?(D\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[2].toUpperCase() as BarSize\r\n  if (!barSizes.has(size)) return undefined\r\n  const count = Number(match[1])\r\n  // ?ф빊 3?먮━???몄젒 移섏닔???レ옄媛 遺숈? ? 蹂묓빀 ?붿옱(??0016-D25???닿퀬,\r\n  // 0蹂몄? 臾쇰웾 0??遺?щ? 留뚮뱺?????대뒓 履쎈룄 ?뺤젙?섏? ?딅뒗??\n  return count > 99 || count <= 0 ? undefined : { count, size }\r\n}\r\n\r\nfunction parsePitch(\r\n  value: string,\r\n): { size: ShearBarSize; pitchMm: number } | undefined {\r\n  // ? ?꾩껜媛 ?⑥씪 ?뚦푶@?붵긿?곥띿씪 ?뚮쭔 梨꾪깮?쒕떎 ??遺遺?留ㅼ튂瑜??덉슜?섎㈃\r\n  // 永꾣빊 ?묐몢????-D13@100??媛 議곗슜???⑥뼱??1永꾨줈 ?덈컲 怨꾩긽?쒕떎.\r\n  // ?쇈겞?띿쓽 ?묐몢 ?곷Ц?먮? D濡??쒖젙?섏? ?딅뒗 寃껋? 遙섇섭佯╉걵?볠뼪獒쒎섭嶺??뚮Ц?닿퀬,\r\n  // 紐⑸줉???녿뒗 ?쇈겞?띿? ?꾨옒 吏묓빀 寃?ъ뿉??鍮덉뭏+?먮Ц?쇰줈 ?⑥뼱吏꾨떎 (R10)\r\n  const match = stripDecoration(value).match(/^([A-Z]\\d+(?:\\.\\d+)?)-?@(\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as ShearBarSize\r\n  if (!shearBarSizes.has(size)) return undefined\r\n  const pitchMm = Number(match[2])\r\n  // 4?먮━ ?쇱튂???몄젒 ?멸렇癒쇳듃媛 遺숈? ?붿옱???똃13@100?????? ???뺤젙?섏? ?딅뒗??\n  return pitchMm > 999 || pitchMm <= 0 ? undefined : { size, pitchMm }\r\n}\r\n\r\n/**\r\n * compact???배쮼瑜???.?띾????쒖감??踰덊샇?대줈 癒쇱? 媛瑜몃떎. ?レ옄媛 ?쇱튂??遺숈뼱\r\n * ??5002.?띻? ?섏뼱???ㅼ쓬 踰덊샇媛 2?쇰뒗 ?ъ떎???ㅻⅨ履?寃쎄퀎瑜?利앸챸?쒕떎.\r\n * 踰덊샇?댁씠 ?놁쑝硫??쒖젣 ?꾩껜媛 ????ぉ?대ŉ, 鍮???ぉ? 踰덊샇?댁쓽 利앸챸???꾨땲誘濡?\n * 遺꾨━?섏? ?딅뒗??\r\n */\r\nfunction sequentialTitleItems(titleText: string): string[] {\r\n  const text = compact(titleText)\r\n  const firstMarker = text.indexOf('1.')\r\n  if (firstMarker < 0) return [text]\r\n\r\n  const items: string[] = []\r\n  let itemStart = firstMarker + '1.'.length\r\n  let nextNumber = 2\r\n\r\n  while (true) {\r\n    const marker = `${nextNumber}.`\r\n    const boundary = text.indexOf(marker, itemStart)\r\n    if (boundary < 0) {\r\n      const lastItem = text.slice(itemStart)\r\n      return lastItem.length > 0 ? [...items, lastItem] : [text]\r\n    }\r\n\r\n    const item = text.slice(itemStart, boundary)\r\n    const nextStart = boundary + marker.length\r\n    if (item.length === 0 || nextStart >= text.length) return [text]\r\n\r\n    items.push(item)\r\n    itemStart = nextStart\r\n    nextNumber += 1\r\n  }\r\n}\r\n\r\nfunction widthTieFromTitle(\r\n  titleText: string,\r\n): { value?: SectionCandidate['widthTie']; raw?: string } | undefined {\r\n  const item = sequentialTitleItems(titleText).find((candidate) =>\r\n    /(?:亮?藥?閭??:???嶺?.test(candidate),\r\n  )\r\n  if (!item) return undefined\r\n\r\n  const label = item.match(/(?:亮?藥?閭??:???嶺?)\r\n  if (!label || label.index === undefined) return undefined\r\n\r\n  const raw = item.slice(label.index)\r\n  // ??ぉ 寃쎄퀎瑜?利앸챸???ㅼ뿉???먮┸?섎줈 ?쇱튂 ?앹쓣 異붿륫?섏? ?딅뒗?? 亮끾??곭춮 ??ぉ\r\n  // ?꾩껜媛 ??臾몃쾿???뚮쭔 ?뺤젙?섍퀬, ?ㅼ뿉 ?ㅻⅨ ?배쮼媛 遺숈쑝硫?raw 寃쎈줈濡?蹂대궦??\r\n  const match = raw.match(\r\n    /^(?:亮?藥?閭??:???嶺??:???([A-Z]\\d+(?:\\.\\d+)?)-?@(\\d+)(?:?ⓦ걲???[??]*$/i,\r\n  )\r\n  if (!match) return { raw }\r\n\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  if (!barSizes.has(size) || pitchMm <= 0) return { raw }\r\n\r\n  return {\r\n    value: { size, pitchMm },\r\n  }\r\n}\r\n\r\n// 4?먮━ 珥덇낵??? 蹂묓빀 ?붿옱, ???먮━???뚯닔 ?쒓린(??.8횞0.8?띯넂8횞0)???붿옱????\n// ?대뒓 履쎈룄 ?뺤젙?섏? ?딅뒗??\nfunction inDimensionRange(b: number, depth: number): boolean {\r\n  return b >= 10 && b <= 9999 && depth >= 10 && depth <= 9999\r\n}\r\n\r\n/**\r\n * ?녶숱??씊???00??띲궾녴꺕過?삠렂烏②쮼??굞?뚣걽?묆굮誤뗣굥 ???겼ㅳ겛?ⓦ겇?졼걨??\n * ?삠꺂竊덀궧?긱긿?곥겗野멩퀡渶싷펹??냶?②き?얇겒?꾠귞쎍孃꾥쮼?룔걣?귙굥?볝겏?뚧졊?졼겎?귙굥??\n */\r\nfunction parseCircularDimension(value: string): { diameter: number } | undefined {\r\n  const match = normalized(value).match(/^(\\d[\\d,]*)\\s*[?過]$|^[?過]\\s*(\\d[\\d,]*)$/)\r\n  if (!match) return undefined\r\n  const diameter = Number((match[1] ?? match[2]).replace(/,/g, ''))\r\n  return inDimensionRange(diameter, diameter) ? { diameter } : undefined\r\n}\r\n\r\nfunction parseDimension(value: string): { b: number; depth: number } | undefined {\r\n  // ?댁썐 ???遺숈? ??00횞800 900횞900?띿뿉??泥?留ㅼ튂瑜?痍⑦븯硫???踰덉㎏ 洹몃９??\n  // 怨듬갚 ?덈㉧ ?レ옄源뚯? ?쇱폒 b=800쨌depth=800900???쒕떎 ???ㅼ쨷 留ㅼ튂??嫄곕??쒕떎\r\n  const matches = [\r\n    ...normalized(value).matchAll(/(\\d[\\d,]*)\\s*[x횞]\\s*(\\d[\\d,]*)/gi),\r\n  ]\r\n  if (matches.length !== 1) return undefined\r\n  const b = Number(matches[0][1].replace(/,/g, ''))\r\n  const depth = Number(matches[0][2].replace(/,/g, ''))\r\n  return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n}\r\n\r\n/**\r\n * ?ㅼ?移섏뿉 遺숈? 媛濡쑣룹꽭濡?移섏닔瑜?吏앹???b횞d瑜??쎈뒗?? ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖뿉?쒕뒗\r\n * ???섏씠 ?좎씪??洹쇨굅?? ?쒖そ留뚯쑝濡쒕뒗 ?뺤젙?섏? ?딅뒗?????⑤룆 ?レ옄瑜??뺤궗媛곹삎?쇰줈\r\n * ?밴꺽?섎뒗 寃껋? ?꾨㈃???녿뒗 媛믪쓣 留뚮뱶??寃껋씠??\r\n */\r\nfunction pairedDimension(\r\n  horizontal: string,\r\n  vertical: string,\r\n): { b: number; depth: number } | undefined {\r\n  if (!/^\\d+$/.test(horizontal) || !/^\\d+$/.test(vertical)) return undefined\r\n  const b = Number(horizontal)\r\n  const depth = Number(vertical)\r\n  return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n}\r\n\r\n/**\r\n * ?뺤젙?섏? 紐삵븳 ????④린???먮Ц 李멸퀬 ?쒖떆. 癒몃━???μ떇留?踰쀪린怨??섎㉧吏??洹몃?濡?\n * ?붾떎 ???좏겙留?戮묒븘 以꾩씠硫???-D13@100?띿쓽 @100泥섎읆 ?먮Ц ?뺣낫媛 ?щ씪吏꾨떎.\r\n *\r\n * ?μ떇留뚯쑝濡??대（?댁쭊 ?? 踰쀪린硫?鍮?臾몄옄?댁씠 ?섎?濡??섏궡由곕떎. ?뚢뺛띾뒗 ?뚰빐???놁쓬?띿쓣\r\n * ?삵븯??媛믪씤??yokohama p13 ?밭춮 ??, 鍮덉뭏?쇰줈 ?대낫?대㈃ ?붾㈃?먯꽌 ?뚯씫吏 紐삵븳 ??띻낵\r\n * 援щ퀎?섏? ?딅뒗??\r\n */\r\nfunction cleanedRebarRaw(value: string): string {\r\n  return stripDecoration(value) || compact(value)\r\n}\r\n\r\nfunction addIssue(candidate: SectionCandidate, issue: CandidateIssue): void {\r\n  if (!candidate.issues.includes(issue)) candidate.issues.push(issue)\r\n}\r\n\r\nfunction setDimension(\r\n  candidate: SectionCandidate,\r\n  value: string | undefined,\r\n  column: boolean,\r\n  vertical?: string,\r\n): void {\r\n  if (!value) {\r\n    // ?몃줈留??쏀엺 移몃룄 ?먮Ц???④릿????議곗슜??踰꾨━硫??ъ슜?먮뒗 ????씊??鍮꾩뿀?붿?\r\n    // ?????녿떎. ?뺤젙?섏? 紐삵븳 移몄? 鍮덉뭏+?먮Ц 李멸퀬媛 ???뚯꽌??洹쒖빟?대떎\r\n    if (vertical !== undefined) {\r\n      candidate.raw['??씊'] = compact(vertical)\r\n      addIssue(candidate, '??씊?⒴숱訝띷닇塋?)\r\n    }\r\n    return\r\n  }\r\n  // ?녶숱??윶?ャ걮?뗣겒?꾠귛ㄷ歟곥겗??씊轝꾠겓??뚧씎?잆굢?앫굦??き?욥걬?덀겒??겎閻뷴츣?쀣겒?꾠?\n  const circular = column ? parseCircularDimension(value) : undefined\r\n  if (circular) {\r\n    candidate.shape = '?녶숱'\r\n    candidate.b = circular.diameter\r\n    candidate.d = circular.diameter\r\n    return\r\n  }\r\n\r\n  const parsed =\r\n    parseDimension(value) ??\r\n    (vertical !== undefined ? pairedDimension(value, vertical) : undefined)\r\n  if (parsed) {\r\n    if (column) candidate.shape = '?⒴숱'\r\n    candidate.b = parsed.b\r\n    if (column) candidate.d = parsed.depth\r\n    else candidate.depth = parsed.depth\r\n    return\r\n  }\r\n\r\n  // ?⑤룆 ?レ옄??b횞d濡??뺤젙?????녿떎 ???ㅼ?移?移섏닔???レ옄瑜??뺤궗媛곹삎?쇰줈\r\n  // ?밴꺽?섎㈃ 媛믪쓣 吏?대궡??寃껋씠 ?쒕떎 (ADR-012 怨꾩뿴). 鍮덉뭏+?먮Ц?쇰줈 ?④릿??\r\n  // ?몃줈???쎌뿀?붾뜲 吏앹쭞湲?pairedDimension)媛 嫄곕???寃쎌슦, 媛濡쒕쭔 ?④린硫?\n  // ?먮Ц ?몃줈媛믪씠 議곗슜???щ씪吏꾨떎 ???④퍡 ?④릿??\n  candidate.raw['??씊'] = compact(value)\r\n  if (vertical !== undefined) candidate.raw['??씊(潁?'] = compact(vertical)\r\n  addIssue(candidate, '??씊?⒴숱訝띷닇塋?)\r\n}\r\n\r\nfunction setColumnMain(\r\n  candidate: SectionCandidate,\r\n  cells: Array<{ position?: string; raw: string }>,\r\n  expectedCellCount: number,\r\n): void {\r\n  if (cells.length === 0) return\r\n  const parsed = cells.map(({ raw }) => parseBar(raw))\r\n  const allParsed = parsed.every((entry): entry is ParsedBar => entry !== undefined)\r\n  const allEqual =\r\n    allParsed &&\r\n    parsed.every(\r\n      (entry) => entry.count === parsed[0].count && entry.size === parsed[0].size,\r\n    )\r\n  const complete =\r\n    expectedCellCount === 0 || cells.length === expectedCellCount\r\n\r\n  if (allEqual && complete) {\r\n    candidate.main = parsed[0]\r\n    return\r\n  }\r\n\r\n  for (const cell of cells) {\r\n    const key = cell.position ? `訝사춮(${cell.position})` : '訝사춮'\r\n    candidate.raw[key] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  addIssue(\r\n    candidate,\r\n    !allParsed ? '訝사춮鰲ｉ뇠訝띹꺗' : !complete ? '訝사춮鵝띸쉰轝좄맼' : '訝사춮鵝띸쉰?면걬',\r\n  )\r\n}\r\n\r\n/**\r\n * 鵝띸쉰轝꾠겗?⒲깧?ャ걣?뉎걲?븅뼋?귙똜3塋?띲뚦쨼塋?띲겗?덀걝?ラ싥굤??릫?꾢릲?띲걣餓섅걦烏ⓦ굚?귙굥?뚣?\n * ?ュ갼??뚨ク?띲걣塋?깿?믤뙁?쇻겗??뀻?싥걲?뗣귟き?곥겒?꾠꺀?쇻꺂??undefined ?ャ걮?╉?\n * 塋?깿?삡릎鸚?겓沃?겳?욍걟?ゃ걚 ??沃?겳?욍걟?뚣겙?녜씊?ャ겒?꾣뼪?㏂굮鵝쒌굥??\n */\r\nfunction positionZone(label: string): '塋?깿' | '訝?ㄾ' | undefined {\n  const normalizedLabel = compact(label)\n  if (normalizedLabel.includes('訝?ㄾ')) return '訝?ㄾ'\n  if (normalizedLabel.includes('塋?)) return '塋?깿'\n  return undefined\n}\n\nfunction isThreePositionLayout(\n  cells: Array<{ position: string }>,\n): boolean {\n  const zones = cells.map(({ position }) => positionZone(position))\n  return (\n    cells.length === 3 &&\n    zones[0] === '塋?깿' &&\n    zones[1] === '訝?ㄾ' &&\n    zones[2] === '塋?깿'\n  )\n}\n\r\nfunction uniqueCount(bars: ParsedBar[]): number | undefined {\r\n  const first = bars[0]\r\n  if (first === undefined) return undefined\r\n  return bars.every((bar) => bar.count === first.count)\r\n    ? first.count\r\n    : undefined\r\n}\r\n\r\n/**\r\n * 鵝띸쉰?㎪쑍?겹굮?녴걨?╉걚?뗨〃?믡곭ク?ⓩ쵂?ⓧ릎鸚?쵂????ⓦ걮??き???\n *\r\n * ?똜3塋?폀Y4塋?띲겗?덀걝?ヤ륫塋?걣?뺛걝訝됪쵂烏ⓦ겘?곦퐤營?꺀?쇻꺂?ⓨ랩?녈겗?ф빊?? * ?앫겗?얇겲?숃짒?ヨ펹?쎼굥?귚틠轝꾠겗塋?깿?삡릎鸚?〃??풏?γ겑?듽굤?섆???ク?ⓩ쑍?겹겓\n * ?녈겳渦쇈??귛푶??뀲轝꾠겎訝?ㅳ겓?껁겂?╉걚?뗨〃?졼걨?믥▶若싥걲?뗣? */\r\nfunction positionalGirderMain(\n  cells: Array<{ position: string; rawPosition?: string }>,\n  top: ParsedBar[],\r\n  bottom: ParsedBar[],\r\n):\r\n  | { girderMain: NonNullable<SectionCandidate['girderMain']> }\r\n  | { issue: CandidateIssue }\r\n  | undefined {\r\n  const zones = cells.map(({ position }) => positionZone(position))\n  if (zones.some((zone) => zone === undefined)) return undefined\n\n  // 藥?ク?삡릎鸚?꺕?녕ク??툒轝꾠겎?ゃ걚烏ⓦ겘?곩랩?녜씆野양㎞??ク?ⓦ겏?쀣겍?띹㎗?덀걮?ゃ걚??  // 塋?깿?삡릎鸚?겗雅뚧쵂??풏?γ겑?듽굤?곩뜕訝??ク?ⓩ쑍?겹겏?쀣겍?긱걝??  const asymmetricLayout = isThreePositionLayout(cells)\n  if (cells.length === 3 && !asymmetricLayout) return undefined\n\r\n  const pick = (bars: ParsedBar[], zone: '塋?깿' | '訝?ㄾ') =>\r\n    bars.filter((_, index) => zones[index] === zone)\r\n  const endTop = pick(top, '塋?깿')\r\n  const endBottom = pick(bottom, '塋?깿')\r\n  const centerTopCount = uniqueCount(pick(top, '訝?ㄾ'))\n  const centerBottomCount = uniqueCount(pick(bottom, '訝?ㄾ'))\n  if (\n    centerTopCount === undefined ||\n    centerBottomCount === undefined ||\n    endTop.length === 0 ||\n    endBottom.length === 0\n  ) {\n    if (\n      endTop.length > 0 &&\n      uniqueCount(endTop) === undefined &&\n      !asymmetricLayout\n    ) {\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\n    }\n    if (\n      endBottom.length > 0 &&\n      uniqueCount(endBottom) === undefined &&\n      !asymmetricLayout\n    ) {\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\n    }\n    return undefined\n  }\n\r\n  const size = top[0]?.size\r\n  if (size === undefined) return undefined\r\n  if (![...top, ...bottom].every((bar) => bar.size === size)) return undefined\r\n\r\n  if (!asymmetricLayout) {\n    const endTopCount = uniqueCount(endTop)\n    const endBottomCount = uniqueCount(endBottom)\n    if (endTopCount === undefined || endBottomCount === undefined) {\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\n    }\n    return {\n      girderMain: {\n        size,\n        topCount: centerTopCount,\n        bottomCount: centerBottomCount,\n        endTopCount,\n        endBottomCount,\n      },\n    }\n  }\n\n  const endTopCounts = [top[0]?.count, top[2]?.count] as const\n  const endBottomCounts = [bottom[0]?.count, bottom[2]?.count] as const\n  if (\n    endTopCounts[0] === undefined ||\n    endTopCounts[1] === undefined ||\n    endBottomCounts[0] === undefined ||\n    endBottomCounts[1] === undefined\n  ) {\n    return undefined\n  }\n\n  const labels = [\n    cells[0]?.rawPosition ?? cells[0]?.position,\n    cells[2]?.rawPosition ?? cells[2]?.position,\n  ] as const\n  if (labels[0] === undefined || labels[1] === undefined) return undefined\n  const asymmetricTop = endTopCounts[0] !== endTopCounts[1]\n  const asymmetricBottom = endBottomCounts[0] !== endBottomCounts[1]\n  const girderMain: NonNullable<SectionCandidate['girderMain']> = {\n    size,\n    topCount: centerTopCount,\n    bottomCount: centerBottomCount,\n  }\n\n  if (asymmetricTop || asymmetricBottom) {\n    girderMain.asymmetricEnds = {\n      labels: [labels[0], labels[1]],\n      ...(asymmetricTop\n        ? { topCounts: [endTopCounts[0], endTopCounts[1]] as [number, number] }\n        : {}),\n      ...(asymmetricBottom\n        ? {\n            bottomCounts: [endBottomCounts[0], endBottomCounts[1]] as [\n              number,\n              number,\n            ],\n          }\n        : {}),\n    }\n    if (!asymmetricTop) girderMain.endTopCount = endTopCounts[0]\n    if (!asymmetricBottom) girderMain.endBottomCount = endBottomCounts[0]\n  } else {\n    girderMain.endTopCount = endTopCounts[0]\n    girderMain.endBottomCount = endBottomCounts[0]\n  }\n\n  return { girderMain }\n}\n\r\nfunction setGirderMain(\n  candidate: SectionCandidate,\r\n  topLabel: string,\r\n  bottomLabel: string,\r\n  topCells: Array<{ position: string; rawPosition?: string; raw: string }>,\n  bottomCells: Array<{\n    position: string\n    rawPosition?: string\n    raw: string\n  }>,\n  expectedCellCount: number,\r\n): void {\r\n  if (topCells.length === 0 && bottomCells.length === 0) return\r\n  const top = topCells.map(({ raw }) => parseBar(raw))\r\n  const bottom = bottomCells.map(({ raw }) => parseBar(raw))\r\n  const allParsed = [...top, ...bottom].every(\r\n    (entry): entry is ParsedBar => entry !== undefined,\r\n  )\r\n  const complete =\r\n    top.length > 0 &&\r\n    bottom.length > 0 &&\r\n    (expectedCellCount === 0 ||\r\n      (top.length === expectedCellCount && bottom.length === expectedCellCount))\r\n  // 鵝띸쉰??洹좎씪?쒕뜲 訝듾툔 孃꾨쭔 ?ㅻⅨ(?ㅻТ?먯꽌 ?뷀븳) ????뚥퐤營?쎑?뺛띾줈 紐곕㈃\r\n  // ?ъ슜?먭? ?먯씤???ㅼ씤?쒕떎 ???꾩슜 ?ъ쑀 肄붾뱶濡?援щ텇?쒕떎\r\n  let sizeMismatch = false\r\n  let positionalIssue: CandidateIssue | undefined\r\n  if (complete && allParsed) {\r\n    const parsedTop = top as ParsedBar[]\r\n    const parsedBottom = bottom as ParsedBar[]\r\n    const firstTop = parsedTop[0]\r\n    const firstBottom = parsedBottom[0]\r\n    const topUniform =\r\n      firstTop !== undefined &&\r\n      parsedTop.every(\r\n        (entry) =>\r\n          entry.count === firstTop.count && entry.size === firstTop.size,\r\n      )\r\n    const bottomUniform =\r\n      firstBottom !== undefined &&\r\n      parsedBottom.every(\r\n        (entry) =>\r\n          entry.count === firstBottom.count && entry.size === firstBottom.size,\r\n      )\r\n\r\n    if (topUniform && bottomUniform && firstTop.size === firstBottom.size) {\r\n      candidate.girderMain = {\r\n        size: firstTop.size,\r\n        topCount: firstTop.count,\r\n        bottomCount: firstBottom.count,\r\n      }\r\n      return\r\n    }\r\n    sizeMismatch =\r\n      topUniform && bottomUniform && firstTop.size !== firstBottom.size\r\n\r\n    // 鵝띸쉰?㎪쑍?겹걣?녴걢?뚣걼烏ⓦ귚툓訝뗣겗鵝띸쉰轝꾠걣?껁겂?╉걚?뗨〃?졼걨?믣??ⓦ걮??き?\r\n    const aligned =\r\n      topCells.length === bottomCells.length &&\r\n      topCells.every(\r\n        (cell, index) => cell.position === bottomCells[index].position,\r\n      )\r\n    const positional = aligned\r\n      ? positionalGirderMain(topCells, parsedTop, parsedBottom)\r\n      : undefined\r\n    if (positional && 'girderMain' in positional) {\r\n      candidate.girderMain = positional.girderMain\r\n      return\r\n    }\r\n    positionalIssue = positional?.issue\r\n  }\r\n\r\n  for (const cell of topCells) {\r\n    candidate.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  for (const cell of bottomCells) {\r\n    candidate.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  addIssue(\r\n    candidate,\r\n    positionalIssue ??\r\n      (sizeMismatch\r\n        ? '訝사춮訝듾툔孃꾤쎑??\r\n        : allParsed && complete\r\n          ? '訝사춮鵝띸쉰?면걬'\r\n          : !allParsed\r\n            ? '訝사춮鰲ｉ뇠訝띹꺗'\r\n            : '訝사춮鵝띸쉰轝좄맼'),\r\n  )\r\n}\r\n\r\nfunction setPitch(\r\n  candidate: SectionCandidate,\r\n  key: 'hoop' | 'stirrup',\r\n  label: string,\r\n  raw: string | undefined,\r\n  folded: string | undefined,\r\n): void {\r\n  // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????躍?춮 ?붵긿?곴? 以꾨쭏???ㅻⅤ硫??ф빊媛 ?由곕떎.\r\n  // 訝사춮怨?媛숈? 洹쒖빟?쇰줈 泥?以꾩씠 ?녿뒗 寃쎌슦瑜??섎늿?????묓옒 ?놁씠???댁븘?⑤뒗 寧?뤇??\n  // ?앷릿 ?ㅻ줈???뚯뾾???섏㎏ 以꾩쓣 李얠븘蹂대씪?띾뒗 ?덈궡媛 ?ㅼ젣濡??꾨떖?쒕떎\r\n  if (folded !== undefined) {\r\n    const wrapped = raw !== undefined && raw.length > 0\r\n    if (wrapped) candidate.raw[label] = cleanedRebarRaw(raw as string)\r\n    candidate.raw[`${label}(${wrapped ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`] =\r\n      cleanedRebarRaw(folded)\r\n    addIssue(candidate, wrapped ? '躍?춮?섋퓭?? : '躍?춮?⒲깧?ヨ죱鸚?)\r\n    return\r\n  }\r\n  if (!raw) return\r\n  const parsed = parsePitch(raw)\r\n  if (parsed) {\r\n    candidate[key] = parsed\r\n    return\r\n  }\r\n\r\n  candidate.raw[label] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '躍?춮鰲ｉ뇠訝띹꺗')\r\n}\r\n\r\nfunction setSideBar(\r\n  candidate: SectionCandidate,\r\n  raw: string | undefined,\r\n): void {\r\n  if (raw === undefined) return\r\n  const value = compact(raw)\r\n  // 令뷸쵂?삥Ø渶싥겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲겏?꾠걝閭ｅ만?ゅ쎋?℡ㅳ겎?귙굤?곮き?뽩ㅁ?쀣겎??겒?꾠?\n  if (value === '' || /^[-??+$/.test(value)) return\r\n\r\n  // 訝사춮?ⓨ릪???ф빊-孃??뉑퀡?믢슴?녴귟끃嶺뗣겘遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣굮?뽧굢?ゃ걚??\n  const parsed = parseBar(raw)\r\n  if (parsed) {\r\n    candidate.sideBar = parsed\r\n    return\r\n  }\r\n\r\n  candidate.raw['?밭춮'] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '?밭춮鰲ｉ뇠訝띹꺗')\r\n}\r\n\r\ninterface WallMarkGroup {\r\n  marks: string[]\r\n  centerX: number\r\n}\r\n\r\nconst WALL_MARK_PATTERN = /(?:EW\\d+[A-Z]?|W\\d+[A-Z]?)/gi\r\nconst SLAB_MARK_PATTERN = /^(?:S|FS|CS)\\d+[A-Z]?$/i\r\n\r\nfunction marksInText(value: string): string[] {\r\n  return [...value.matchAll(WALL_MARK_PATTERN)].map((match) =>\r\n    match[0].toUpperCase(),\r\n  )\r\n}\r\n\r\nfunction wallMarkGroups(row: TextRow): WallMarkGroup[] {\r\n  const labels = row.segments.filter((segment) => segment.compact === '寧?뤇')\r\n  for (const label of [...labels].reverse()) {\r\n    const groups = row.segments\r\n      .filter((segment) => segment.x > label.endX)\r\n      .flatMap((segment) => {\r\n        const marks = marksInText(segment.compact)\r\n        return marks.length > 0 ? [{ marks, centerX: segment.centerX }] : []\r\n      })\r\n    if (groups.length > 0) return groups\r\n  }\r\n  return []\r\n}\r\n\r\nfunction valuesForWallGroups(\r\n  row: TextRow,\r\n  labelText: string,\r\n  groups: WallMarkGroup[],\r\n  split: (text: string) => string[],\r\n  valueRow: TextRow = row,\r\n): Map<string, string> {\r\n  const label = [...row.segments]\r\n    .reverse()\r\n    .find((segment) => segment.compact === labelText)\r\n  if (!label) return new Map()\r\n\r\n  const values = valueRow.segments.filter((segment) =>\r\n    valueRow === row ? segment.x > label.endX : true,\r\n  )\r\n  const result = new Map<string, string>()\r\n  for (const segment of values) {\r\n    const covered = groups.filter(\r\n      (group) => group.centerX >= segment.x && group.centerX <= segment.endX,\r\n    )\r\n    if (covered.length === 0) continue\r\n    const parts = split(segment.text)\r\n    if (covered.length === parts.length) {\r\n      covered.forEach((group, index) => {\r\n        for (const mark of group.marks) result.set(mark, parts[index])\r\n      })\r\n      continue\r\n    }\r\n    if (covered.length === 1 && parts.length === covered[0].marks.length) {\r\n      covered[0].marks.forEach((mark, index) => result.set(mark, parts[index]))\r\n      continue\r\n    }\r\n    // A single mark with two thicknesses is ambiguous. Keep the complete cell\r\n    // for every mark in the group; the caller will leave the typed field empty.\r\n    for (const group of covered) {\r\n      for (const mark of group.marks) result.set(mark, segment.text)\r\n    }\r\n  }\r\n  return result\r\n}\r\n\r\nfunction wallThicknessParts(text: string): string[] {\r\n  return normalized(text)\r\n    .split(',')\r\n    .map((value) => value.trim())\r\n    .filter((value) => value.length > 0)\r\n}\r\n\r\nfunction wallBarParts(text: string): string[] {\r\n  const value = compact(text)\r\n  if (/[?삼쉈]/.test(value) || /[A-Z]\\d+[A-Z]\\d+/i.test(value)) return []\r\n  return value.match(/[A-Z]\\d+-?@\\d+(?:\\([^)]*\\))?/gi) ?? []\r\n}\r\n\r\nfunction parseWallBar(value: string):\r\n  | { size: BarSize; pitchMm: number; layers: 1 | 2 }\r\n  | undefined {\r\n  const match = compact(value).match(\r\n    /^([A-Z]\\d+)-?@(\\d+)(?:\\(([^)]*)\\))?$/i,\r\n  )\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  if (!barSizes.has(size) || pitchMm <= 0) return undefined\r\n  const note = match[3]\r\n  if (!note) return undefined\r\n  const layers = /??뽧꺂|絶絶욑풄絶욑풖/.test(normalized(note)) ? 2 : /?룔꺍?겹꺂/.test(note) ? 1 : undefined\r\n  return layers === undefined ? undefined : { size, pitchMm, layers }\r\n}\r\n\r\nfunction parseWallBlock(\r\n  rows: TextRow[],\r\n  titleText: string,\r\n  endY: number,\r\n): SectionCandidate[] {\r\n  const header = rows.find((row) => wallMarkGroups(row).length > 0)\r\n  if (!header) return []\r\n  const groups = wallMarkGroups(header)\r\n  const bodyRows = rows.filter((row) => row.y > header.y && row.y < endY)\r\n  const dimensionRow = bodyRows\r\n    .filter((row) =>\r\n      row.segments.some((segment) => segment.compact === '??씊'),\r\n    )\r\n    .at(-1)\r\n  const verticalRow = bodyRows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '潁?춮'),\r\n  )\r\n  const horizontalRow = bodyRows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '與ょ춮'),\r\n  )\r\n  if (!dimensionRow && !verticalRow && !horizontalRow) return []\r\n\r\n  const dimensionValueRow = dimensionRow\r\n    ? bodyRows.find(\r\n        (row) =>\r\n          row.y > dimensionRow.y &&\r\n          row.y < (verticalRow?.y ?? endY) &&\r\n          row.segments.some((segment) =>\r\n            groups.some(\r\n              (group) =>\r\n                group.centerX >= segment.x && group.centerX <= segment.endX,\r\n            ),\r\n          ),\r\n      )\r\n    : undefined\r\n  const thicknesses = dimensionRow\r\n    ? valuesForWallGroups(\r\n        dimensionRow,\r\n        '??씊',\r\n        groups,\r\n        wallThicknessParts,\r\n        dimensionValueRow,\r\n      )\r\n    : new Map<string, string>()\r\n  const verticals = verticalRow\r\n    ? valuesForWallGroups(verticalRow, '潁?춮', groups, wallBarParts)\r\n    : new Map<string, string>()\r\n  const horizontals = horizontalRow\r\n    ? valuesForWallGroups(horizontalRow, '與ょ춮', groups, wallBarParts)\r\n    : new Map<string, string>()\r\n\r\n  return groups.flatMap(({ marks }) =>\r\n    marks.map((mark): SectionCandidate => {\r\n      const candidate: SectionCandidate = {\r\n        kind: isOutOfScopeList(titleText) ? '野얕괌鸚? : '?먬쐡鶯?,\r\n        mark,\r\n        raw: {},\r\n        issues: [],\r\n      }\r\n      const thickness = thicknesses.get(mark)\r\n      if (thickness && /^\\d+$/.test(thickness)) {\r\n        candidate.thickness = Number(thickness)\r\n      } else if (thickness) {\r\n        candidate.raw['??씊'] = thickness\r\n        addIssue(candidate, '鶯곩럻?면걬')\r\n      }\r\n\r\n      const setBar = (\r\n        role: 'vertical' | 'horizontal',\r\n        value: string | undefined,\r\n      ) => {\r\n        if (value === undefined) return\r\n        const parsed = parseWallBar(value)\r\n        if (!parsed) {\r\n          candidate.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'] = value\r\n          addIssue(candidate, '鶯곭춮鰲ｉ뇠訝띹꺗')\r\n          return\r\n        }\r\n        if (candidate.layers !== undefined && candidate.layers !== parsed.layers) {\r\n          candidate.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'] = value\r\n          addIssue(candidate, '鶯곭춮鰲ｉ뇠訝띹꺗')\r\n          return\r\n        }\r\n        candidate[role] = { size: parsed.size, pitchMm: parsed.pitchMm }\r\n        candidate.layers = parsed.layers\r\n      }\r\n      setBar('vertical', verticals.get(mark))\r\n      setBar('horizontal', horizontals.get(mark))\r\n      return candidate\r\n    }),\r\n  )\r\n}\r\n\r\nfunction slabMark(row: TextRow): { mark: string; centerX: number } | undefined {\r\n  const segment = row.segments.find((candidate) =>\r\n    SLAB_MARK_PATTERN.test(candidate.compact),\r\n  )\r\n  return segment\r\n    ? { mark: segment.compact.toUpperCase(), centerX: segment.centerX }\r\n    : undefined\r\n}\r\n\r\nfunction slabBarCell(row: TextRow, centerX: number): TextSegment | undefined {\r\n  return row.segments\r\n    .filter((segment) => /@\\d+/.test(compact(segment.text)))\r\n    .sort(\r\n      (left, right) =>\r\n        Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n    )[0]\r\n}\r\n\r\nfunction parseSlabBar(value: string): { size: BarSize; pitchMm: number } | undefined {\r\n  const match = compact(value).match(/^([A-Z]\\d+)-?@(\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  return barSizes.has(size) && pitchMm > 0 ? { size, pitchMm } : undefined\r\n}\r\n\r\nfunction slabThickness(row: TextRow, centerX: number): number | undefined {\r\n  const value = row.segments\r\n    .filter((segment) => /^\\d[\\d,]*$/.test(compact(segment.text)))\r\n    .sort(\r\n      (left, right) =>\r\n        Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n    )[0]\r\n    ?.compact\r\n  return value === undefined ? undefined : Number(value.replace(/,/g, ''))\r\n}\r\n\r\nfunction nextHeaderY(rows: TextRow[], endY: number): number | undefined {\r\n  return rows.find(\r\n    (row) =>\r\n      row.y >= endY &&\r\n      row.segments.some((segment) => segment.compact.startsWith('寧?뤇')) &&\r\n      !row.segments.some((segment) =>\r\n        /??씌?밧릲|?룩씌?밧릲/.test(segment.compact),\r\n      ),\r\n  )?.y\r\n}\r\n\r\nfunction parseSlabBlock(\r\n  rows: TextRow[],\r\n  anchor: TitleAnchor,\r\n  endY: number,\r\n): SectionCandidate[] {\r\n  const directionHeader = rows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '??씌?밧릲') &&\r\n    row.segments.some((segment) => segment.compact === '?룩씌?밧릲'),\r\n  )\r\n  const shortX = directionHeader?.segments.find(\r\n    (segment) => segment.compact === '??씌?밧릲',\r\n  )?.centerX\r\n  const longX = directionHeader?.segments.find(\r\n    (segment) => segment.compact === '?룩씌?밧릲',\r\n  )?.centerX\r\n  if (shortX === undefined || longX === undefined) return []\r\n\r\n  const initialRows = rows.filter((row) => row.y > anchor.row.y)\r\n  const firstMark = initialRows.map(slabMark).find(\r\n    (mark): mark is { mark: string; centerX: number } => mark !== undefined,\r\n  )\r\n  if (!firstMark) return []\r\n  const markRows = initialRows\r\n    .map((row) => ({ row, mark: slabMark(row) }))\r\n    .filter(\r\n      (entry): entry is { row: TextRow; mark: { mark: string; centerX: number } } =>\r\n        entry.mark !== undefined &&\r\n        Math.abs(entry.mark.centerX - firstMark.centerX) <\r\n          Math.max(20, Math.abs(shortX - firstMark.centerX)),\r\n    )\r\n  const bridgeTitle = rows.find(\r\n    (row) =>\r\n      Math.abs(row.y - endY) < 0.01 &&\r\n      row.segments.some((segment) => /鶯곥꺁?밤깉/.test(segment.compact)),\r\n  )\r\n  const scanEnd = bridgeTitle ? nextHeaderY(rows, endY) ?? endY : endY\r\n  const candidates = markRows.filter(({ row }) => row.y < scanEnd)\r\n  if (candidates.length === 0) return []\r\n\r\n  const thicknessHeader = rows.find((row) =>\r\n    row.segments.some((segment) => /佯듿럻|?밤꺀?뽩럻/.test(segment.compact)),\r\n  )\r\n  const thicknessX =\r\n    thicknessHeader?.segments.find((segment) =>\r\n      /佯듿럻|?밤꺀?뽩럻/.test(segment.compact),\r\n    )?.centerX ?? firstMark.centerX\r\n  const outOfScope = isOutOfScopeList(anchor.titleText)\r\n\r\n  return candidates.map(({ row, mark }, index) => {\r\n    const nextY = candidates[index + 1]?.row.y ?? scanEnd\r\n    const cantilever =\r\n      mark.mark.startsWith('CS') &&\r\n      rows.some(\r\n        (candidateRow) =>\r\n          candidateRow.y >= row.y - 1 &&\r\n          candidateRow.y < nextY &&\r\n          candidateRow.segments.some((segment) =>\r\n            segment.compact.includes('?뉑똻?▲궧?⒲깣'),\r\n          ),\r\n      )\r\n    const candidate: SectionCandidate = {\r\n      kind: outOfScope || cantilever ? '野얕괌鸚? : '佯딀씮',\r\n      mark: mark.mark,\r\n      raw: {},\r\n      issues: [],\r\n    }\r\n    const sectionRows = rows.filter(\r\n      (candidateRow) => candidateRow.y > row.y - 20 && candidateRow.y < nextY,\r\n    )\r\n    const thickness = slabThickness(row, thicknessX)\r\n    if (!outOfScope && thickness !== undefined) candidate.thickness = thickness\r\n\r\n    if (outOfScope || cantilever) return candidate\r\n\r\n    const faceRows = new Map<'top' | 'bottom', TextRow>()\r\n    for (const face of ['top', 'bottom'] as const) {\r\n      const labels = face === 'top' ? ['訝딁ク嶺?, '訝딁춮'] : ['訝뗧ク嶺?, '訝뗧춮']\r\n      const faceRow = sectionRows\r\n        .filter((candidateRow) =>\r\n          candidateRow.segments.some((segment) =>\r\n            labels.includes(segment.compact),\r\n          ),\r\n        )\r\n        .sort((left, right) => Math.abs(left.y - row.y) - Math.abs(right.y - row.y))[0]\r\n      if (faceRow) faceRows.set(face, faceRow)\r\n    }\r\n\r\n    for (const [face, faceRow] of faceRows) {\r\n      for (const [axis, centerX] of [\r\n        ['??씌?밧릲', shortX],\r\n        ['?룩씌?밧릲', longX],\r\n      ] as const) {\r\n        const cell = slabBarCell(faceRow, centerX)\r\n        const key = axis === '??씌?밧릲' ? 'shortSide' : 'longSide'\r\n        const rawKey = `${axis}(${face})`\r\n        if (!cell) continue\r\n        const parsed = parseSlabBar(cell.text)\r\n        if (!parsed) {\r\n          candidate.raw[rawKey] = cell.text\r\n          addIssue(candidate, '佯딀씮嶺뗨㎗?덁툖??)\r\n          continue\r\n        }\r\n        candidate[key] = {\r\n          ...candidate[key],\r\n          [face]: parsed,\r\n        }\r\n      }\r\n    }\r\n    return candidate\r\n  })\r\n}\r\n\r\nfunction rowsBetween(rows: TextRow[], startY: number, endY: number): TextRow[] {\r\n  return rows.filter((row) => row.y > startY && row.y < endY)\r\n}\r\n\r\n// ?굿룟ㄷ歟?釉붾줉???뚮젮吏??쇰꺼 ???꾨? ???묓옒 媛먯????뚮떎???쇰꺼 ?됥??먯젙???대떎.\r\nconst ROW_LABELS = [\r\n  '訝사춮',\r\n  '躍?춮',\r\n  'HOOP',\r\n  '??씊',\r\n  '鵝띸쉰',\r\n  '訝딁춮',\r\n  '訝딁ク嶺?,\r\n  '訝뗧춮',\r\n  '訝뗧ク嶺?,\r\n  'ST',\r\n  'STP',\r\n  '?귙겙?됬춮',\r\n  'b횞D',\r\n  '?밭춮',\r\n] as const\r\n\r\n/** ?ф빊-孃??좏겙(訝사춮 ?)怨?孃??붵긿???좏겙(躍?춮쨌?귙겙?됬춮 ?)??援щ텇???묓옒??李얜뒗?? */\r\nconst BAR_TOKEN = /\\d+-?D\\d+/i\r\n\r\nconst PITCH_TOKEN = /D\\d+-?@\\d+/i\r\n\r\n/**\r\n * ?쇰꺼 ?됯낵 ?ㅼ쓬 ?쇰꺼 ???ъ씠??臾대씪踰??됱뿉???꾤춮 ?좏겙??留덊겕蹂꾨줈 紐⑥???\r\n * ? ?댁슜??以꾨컮轅덉쑝濡??묓엳硫??섏㎏ 以꾩? 蹂꾨룄 ?됱씠 ?섏뼱 ?쇰꺼 ?됰쭔 ?쎈뒗 寃쎈줈?먯꽌\r\n * 議곗슜???щ씪吏꾨떎 ??泥?以꾨쭔?쇰줈 ?뺤젙?섎㈃ 2餘든춮 嫄곕? 諛⑹묠??以꾨컮轅?蹂?뺤뿉???뚮떎.\r\n */\r\nfunction barContinuationByMark(\r\n  dataRows: TextRow[],\r\n  labelRow: TextRow,\r\n  endY: number,\r\n  marks: MarkColumn[],\r\n  token: RegExp,\r\n): Map<string, string> {\r\n  const nextLabelY = dataRows\r\n    .filter((row) => row.y > labelRow.y && exactLabel(row, ROW_LABELS))\r\n    .reduce((min, row) => Math.min(min, row.y), endY)\r\n  const merged = new Map<string, string>()\r\n\r\n  for (const row of dataRows) {\r\n    if (row.y <= labelRow.y || row.y >= nextLabelY) continue\r\n    if (exactLabel(row, ROW_LABELS)) continue\r\n    const barSegments = row.segments.filter((segment) =>\r\n      token.test(segment.compact),\r\n    )\r\n    if (barSegments.length === 0) continue\r\n    const values = valuesAtTargets(\r\n      barSegments,\r\n      marks.map(({ mark, centerX }) => ({ id: mark, centerX })),\r\n    )\r\n    for (const [mark, value] of values) {\r\n      const existing = merged.get(mark)\r\n      merged.set(mark, existing ? `${existing}/${value}` : value)\r\n    }\r\n  }\r\n\r\n  return merged\r\n}\r\n\r\nfunction lastPositionRow(\r\n  rows: TextRow[],\r\n  headerY: number,\r\n  beforeY: number,\r\n): TextRow | undefined {\r\n  return rows\r\n    .filter(\r\n      (row) =>\r\n        row.y > headerY && row.y < beforeY && exactLabel(row, ['鵝띸쉰']),\r\n    )\r\n    .at(-1)\r\n}\r\n\r\n/**\r\n * ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖쓽 ?ㅼ?移?媛濡?移섏닔. 李쎌쓽 ?섑븳? ?몄떇???곗씠???쇰꺼 ??以?\n * 媛???꾨떎 ???쇰꺼 ?섎굹?먮쭔 留ㅼ뼱 ?먮㈃ 洹??쇰꺼??紐??쎌? ?쒖뿉??李쎌씠 ?щ씪?댁뒪 ?꾩껜濡?\n * ?대젮 ?꾨옒 ???숃??????⑤룆 ?レ옄媛 移섏닔濡??뺤젙?쒕떎. ?쇰꺼 ?됱쓣 ?섎굹???몄떇?섏?\r\n * 紐삵뻽?쇰㈃ 洹??쒖뿉???쎌? 寃껋씠 ?녿떎???살씠誘濡??대갚???뚮━吏 ?딅뒗??\r\n *\r\n * ?곹븳???щ씪?댁뒪??endY瑜???諛쏆? ?딅뒗????labelRows???꾨? rowsBetween(rows,\r\n * slice.startY, slice.endY)?먯꽌 ?섏삤誘濡???긽 y < slice.endY?? 洹?endY瑜??ㅼ떆\r\n * Math.min???ｌ뼱???덈? ?좏깮?????놁뼱 ?덉????딆? ?곹븳 蹂댄샇泥섎읆 ?쏀삍??(#35)\r\n */\r\nfunction sketchDimensions(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  labelRows: Array<TextRow | undefined>,\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  const labelYs = labelRows.flatMap((row) => (row ? [row.y] : []))\r\n  if (labelYs.length === 0) return new Map()\r\n  return scalarDimensions(rows, startY, Math.min(...labelYs), anchors)\r\n}\r\n\r\n/**\r\n * ?ㅼ?移?移섏닔瑜?諛곗젙?????듭빱. 鵝띸쉰 ?댁씠 ?덉쑝硫?洹멸쾬?대떎 ??寧?뤇 ?쇰꺼? 移?以묒븰??\n * ?볦씠吏留?移???? 遺?щ쭏???щ씪?? 以묒떖 ?ъ씠 以묒젏??寃쎄퀎濡??곕㈃ 醫곸? 移몄씠 ?볦? 移몄쓽\r\n * ?앹쓣 癒밸뒗?? ?ㅻЪ ojkk 鸚㎪쥈?먯꽌 G3(??85) ??G4(??42.5)媛 G3???몃줈 移섏닔瑜?\n * 媛?멸컮?? 鵝띸쉰 ?댁? 移몄쓣 ?ㅼ젣濡???쇰쭅?섎?濡???씠 ?ㅻⅨ ?댁썐怨?遺숈뼱???닿툔?섏? ?딅뒗??\r\n */\r\nfunction markAnchors(\r\n  marks: MarkColumn[],\r\n  positions: PositionColumn[],\r\n): MarkColumn[] {\r\n  return marks.flatMap(({ mark, centerX }) => {\r\n    const own = positions.filter((position) => position.mark === mark)\r\n    return own.length > 0\r\n      ? own.map((position) => ({ mark, centerX: position.centerX }))\r\n      : [{ mark, centerX }]\r\n  })\r\n}\r\n\r\n/**\r\n * ?듭빱蹂?嫄곕━ ?곹븳. 移?寃쎄퀎?????듭빱 ?ъ씠???덉쑝誘濡??듭빱?먯꽌 寃쎄퀎源뚯???嫄곕━??洹?\n * ?댁썐源뚯???媛꾧꺽蹂대떎 吏㏓떎 ???곹븳???댁썐 媛꾧꺽?쇰줈 ?〓뒗?? ?댁썐蹂꾨줈 ?щ뒗 ?댁쑀??移???씠\r\n * ?대쭏???щ씪?쒕떎: 媛꾧꺽??以묒븰媛믪쓣 ?곕㈃ ?먭린 移몄씠 ?⑤뱾蹂대떎 ?볦? ?댁뿉???ㅻЪ 媛믪씠\r\n * ?섎━怨?ojkk ??FC1? ?댁썐 媛꾧꺽 85.1???ㅼ륫 51.7), 醫뚯슦 以???履쎌쓣 ?곕㈃ 珥섏킌???댁씠\r\n * 諛섎???癒??댁쓽 ?곹븳??臾쇰젮諛쏆븘 ?????ъ씠 鍮????퉴吏 癒밸뒗??\r\n *\r\n * ?듭빱媛 ?섎굹肉먯씠硫?媛꾧꺽???놁뼱 ?곹븳??Infinity媛 ?쒕떎 ???몃줈 吏앹쭞湲곕뒗 寧?뤇 2媛?\n * ?댁긽???곕줈 ?붽뎄?섍퀬, 媛濡쒕뒗 ?쇰꺼 ?????쑝濡??대? 醫곹????덉쑝硫? ? 媛믪? ?댁씠\r\n * ?섎굹硫?洹??댁씠 ???꾩껜瑜?諛쏅뒗 寃껋씠 留욌떎.\r\n */\r\nfunction boundedAnchors<T extends { centerX: number }>(\r\n  anchors: T[],\r\n): Array<T & { limit: number }> {\r\n  const sorted = [...anchors].sort(\r\n    (left, right) => left.centerX - right.centerX,\r\n  )\r\n  return sorted.map((anchor, index) => {\r\n    const gaps = [\r\n      index > 0 ? anchor.centerX - sorted[index - 1].centerX : undefined,\r\n      index + 1 < sorted.length\r\n        ? sorted[index + 1].centerX - anchor.centerX\r\n        : undefined,\r\n    ].filter((gap): gap is number => gap !== undefined)\r\n    return { ...anchor, limit: Math.min(...gaps) }\r\n  })\r\n}\r\n\r\nfunction scalarDimensions(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  endY: number,\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  if (marks.length === 0) return new Map()\r\n  const numericSegments = rows\r\n    .filter((row) => row.y > startY && row.y < endY)\r\n    .flatMap((row) => row.segments)\r\n    .filter((segment) => /^\\d[\\d\\s,]*$/.test(normalized(segment.text)))\r\n\r\n  // ?대떦 ?レ옄 ?멸렇癒쇳듃媛 ?뺥솗??1媛쒖씪 ?뚮쭔 ?섍릿????2媛??댁긽???댁뼱遺숈씠硫?\n  // ??00????00?띿씠 700900mm媛 ?쒕떎. ?섍릿 媛믩룄 b횞d濡??뺤젙?섏????딄퀬\r\n  // setDimension?먯꽌 鍮덉뭏+?먮Ц 李멸퀬濡??⑤뒗??\r\n  const perMark = new Map<string, string[]>()\r\n  const bounded = boundedAnchors(marks)\r\n  for (const segment of numericSegments) {\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    // ?몃줈 ?곌낵 媛숈? ?곹븳??嫄대떎 ???쒖そ留??곹븳???놁쑝硫??ㅼ?移????쓽 ?꾨Т ?レ옄??\n    // 理쒓렐???댁뿉 遺숈뼱 ?댁뒋 ?녿뒗 ?뺤젙 b媛 ?쒕떎\r\n    if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n    const existing = perMark.get(target.mark) ?? []\r\n    existing.push(segment.compact)\r\n    perMark.set(target.mark, existing)\r\n  }\r\n\r\n  // 肄ㅻ쭏???먮┸??援щ텇?대떎(parseDimension??踰쀪꺼 諛쏅뒗?? verticalsByMark? 媛숈? 洹쒖빟) ??\n  // ?ш린????,200?띿쓣 ?レ옄媛 ?꾨땲?쇨퀬 踰꾨━硫???1,000mm ?댁긽??遺?щ? ?볦튇??\n  return new Map(\r\n    [...perMark.entries()].flatMap(([mark, values]) => {\r\n      const text = values[0].replace(/,/g, '')\r\n      return values.length === 1 && /^\\d+$/.test(text)\r\n        ? [[mark, text] as const]\r\n        : []\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * ?몃줈 移섏닔瑜??대퀎濡?紐⑥??? scalarDimensions? 媛숈? 洹쒖빟 ???대떦 ?뺥솗??1媛쒖씪 ?뚮쭔\r\n * ?섍릿?? ??????몃줈 ?レ옄媛 ?섏씠硫??대뒓 履쎌씠 ??씊?몄? ?먯젙??洹쇨굅媛 ?녿떎.\r\n */\r\nfunction verticalsByMark(\r\n  runs: VerticalRun[],\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  // ?쇰꺼 ?됱뿉 留ㅼ씤 媛濡?媛믨낵 ?щ━ ?몃줈 ?곗? ???대뵒?먮굹 ?덉쓣 ???덉뼱, ?곹븳???놁쑝硫?\n  // ?⑥쓽 ???レ옄媛 ???댁쓽 d濡??뺤젙?쒕떎. 寧?뤇???섎굹硫???媛꾧꺽???????녿떎 ??\n  // ?곹븳???몄슱 洹쇨굅媛 ?놁쑝??吏앹쭞吏 ?딅뒗?? ?듭빱 ?섎줈 ?щ㈃ ???쒕떎: 鵝띸쉰 ?댁씠\r\n  // ??寧?뤇???щ윭 ?듭빱濡??섎━誘濡??⑥씪 寧?뤇 ?쒖뿉?쒕룄 ?듦낵?쒕떎\r\n  if (new Set(anchors.map(({ mark }) => mark)).size < 2) return new Map()\r\n  const bounded = boundedAnchors(anchors)\r\n  const perMark = new Map<string, string[]>()\r\n\r\n  for (const run of runs) {\r\n    // 肄ㅻ쭏???먮┸??援щ텇?대떎(parseDimension??踰쀪꺼 諛쏅뒗??. ?ш린????,200?띿쓣\r\n    // ?レ옄媛 ?꾨땲?쇨퀬 踰꾨━硫?移댁슫?몄뿉?쒕룄 鍮좎졇 ?뚯뿴???뺥솗??1媛쒌?諛⑹뼱媛 ?ル┛??\n    const text = run.text.replace(/,/g, '')\r\n    if (!/^\\d+$/.test(text)) continue\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - run.x) < Math.abs(closest.centerX - run.x)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    if (Math.abs(target.centerX - run.x) > target.limit) continue\r\n    const bucket = perMark.get(target.mark)\r\n    if (bucket) bucket.push(text)\r\n    else perMark.set(target.mark, [text])\r\n  }\r\n\r\n  return new Map(\r\n    [...perMark.entries()].flatMap(([mark, values]) =>\r\n      values.length === 1 ? [[mark, values[0]] as const] : [],\r\n    ),\r\n  )\r\n}\r\n\r\n/**\r\n * ?몃줈 移섏닔瑜?痢??щ씪?댁뒪??諛곗젙?쒕떎. ?ㅼ?移섏쓽 ?몃줈 移섏닔??痢??쇰꺼 ?됰낫???꾩뿉\r\n * ?볦씠湲곕룄 ?댁꽌 ?щ씪?댁뒪??y????쇰꺼 ??~ ?ㅼ쓬 ?쇰꺼 ???쇰줈 ?먮Ⅴ硫??듭㎏濡?鍮좎쭊??\r\n *\r\n * 諛곗젙 ?듭빱??**?쒖쓽 ??以??곗뿉 媛??媛源뚯슫 寃?*?닿퀬, 洹??됱씠 ???щ씪?댁뒪媛 ?꾩옄??\r\n * 痢??쇰꺼???듭빱濡??곕㈃ ?섏씠 ?④퍡 留앷?議뚮떎 (#32??:\r\n *   - ?щ씪?댁뒪媛 留욌떯???덉뼱(endY[i] == startY[i+1]) ?쇰꺼 理쒓렐?묒쓽 蹂대줈?몄씠 寃쎄퀎媛\r\n *     span/2? ?뺥솗???쇱튂?쒕떎 ???꾨옒 嫄곕━ ?곹븳??以묎컙 痢듭뿉????긽 李몄씠 ?먮떎.\r\n *   - ?먭린 痢??곗씠?????ъ씠???덈뒗 ?곗씠 ??媛源뚯슫 ?꾨옒 痢??쇰꺼濡??섏뼱媛, 洹?痢듭씠\r\n *     ?⑥쓽 移섏닔濡??뺤젙?먮떎.\r\n * ?됱쓣 ?듭빱濡??곕㈃ ?쇰꺼源뚯???嫄곕━媛 span/2瑜??섏쓣 ???덉뼱 ?곹븳???ㅼ젣濡??묐룞?쒕떎.\r\n *\r\n * rows????諛??됱쓣 ?섍린吏 留?寃????ㅻЪ ojkk p3??2F ?ㅼ?移섏뿉?쒕뒗 ?쒖젣???\n * ?녜씊?띸㎞ ?됱씠 ?몃줈 移섏닔?먯꽌 0.6pt 嫄곕━??痢??쇰꺼(12.3pt)蹂대떎 媛源앸떎.\r\n *\r\n * ?ㅻЪ 5硫?70嫄댁뿉????諛곗젙? 痢??쇰꺼 理쒓렐?묎낵 寃곌낵媛 媛숇떎(?꾩닔 ?議?. 諛붾뚮뒗 寃껋?\r\n * ?????ㅽ뙣肉먯씠??\r\n */\r\nfunction verticalsBySlice(\r\n  runs: VerticalRun[],\r\n  slices: Array<{ startY: number; endY: number }>,\r\n  rows: TextRow[],\r\n): VerticalRun[][] {\r\n  const buckets: VerticalRun[][] = slices.map(() => [])\r\n  if (slices.length === 0) return buckets\r\n\r\n  for (const run of runs) {\r\n    const anchorY =\r\n      rows.length > 0\r\n        ? rows.reduce((closest, row) =>\r\n            Math.abs(row.y - run.y) < Math.abs(closest.y - run.y) ? row : closest,\r\n          ).y\r\n        : run.y\r\n    // ?щ씪?댁뒪??留욌떯???뺣젹???덉쑝誘濡? startY媛 ?듭빱 ?댄븯??留덉?留??щ씪?댁뒪媛\r\n    // 洹??됱쓣 ?댁? ?щ씪?댁뒪?? 泥??щ씪?댁뒪蹂대떎 ??癒몃━????硫?泥??щ씪?댁뒪濡?蹂몃떎\r\n    let best = 0\r\n    slices.forEach((slice, index) => {\r\n      if (slice.startY <= anchorY) best = index\r\n    })\r\n    // ?먭린 釉붾줉??留덉?留??됰낫???꾨옒???덈뒗 ?곗? ?대뒓 痢듭쓽 寃껊룄 ?꾨땲?? 洹?\n    // 釉붾줉???댁슜? 嫄곌린???앸굹怨??ㅼ쓬 痢??쇰꺼源뚯???鍮덉뭏?몃뜲, ???쭔 蹂대㈃ 洹?\n    // 鍮덉뭏???꾩쭅 ???щ씪?댁뒪???꾨옒 嫄곕━媛 0???섏뼱 ?⑥쓽 移섏닔媛 議곗슜???뺤젙?쒕떎.\r\n    // ?ㅻЪ?먯꽌 ?몃줈 移섏닔??鍮덉뭏??**?꾨옒履?*, ?먭린 痢??쇰꺼 諛붾줈 ?꾩뿉 ?볦씠誘濡?\n    // (?ㅼ륫 7.68~13.46pt, 5硫?51嫄? ?먭린 釉붾줉??泥??됰낫?ㅻ룄 ?꾨떎 ????洹쒖튃??\n    // 嫄몃━吏 ?딅뒗?? 鍮덉뭏 ?꾩そ?????レ옄???꾩옄瑜?媛由?洹쇨굅媛 ?놁쑝???뺤젙?섏?\r\n    // ?딄퀬 ?먮Ц?쇰줈 ?④릿??(R10, PR #61 由щ럭 major)\r\n    // ?먭린 ?됱쓽 踰붿쐞??endY 媛 ?꾨땲??**?ㅼ쓬 ?щ씪?댁뒪??startY** 濡??딅뒗??\r\n    // ?몄텧遺媛 留덉?留??щ씪?댁뒪??endY 瑜?tableBottom(= ??諛붾떏 ???먯떊??y)?쇰줈\r\n    // ?먮Ⅴ誘濡? endY 瑜?諛고? ?곹븳?쇰줈 ?곕㈃ 洹??됱씠 鍮좎졇 理쒗븯痢듭뿉?쒕쭔 lastRowY 媛\r\n    // ?????꾨줈 諛由곕떎 (PR #61 由щ럭 major)\r\n    const bandEnd = slices[best + 1]?.startY ?? Number.POSITIVE_INFINITY\r\n    const lastRowY = rows.reduce(\r\n      (last, row) =>\r\n        row.y >= slices[best].startY && row.y < bandEnd && row.y > last\r\n          ? row.y\r\n          : last,\r\n      slices[best].startY,\r\n    )\r\n    if (run.y > lastRowY) continue\r\n\r\n    // ?먭린 痢??ㅼ?移섍? ?꾨땶 ?곗? 踰꾨┛?? 嫄곕━ ?쒗븳 ?놁씠 ?ｌ쑝硫??대뼡 ?レ옄???대뒓\r\n    // 痢듭뿏媛 遺숈뼱 ?댁뒋 ?녿뒗 ?뺤젙 d媛 ?쒕떎 ??誘몄? ?뺤떇?먯꽌???뺤젙?섏? ?딄퀬 ?먮Ц?쇰줈\r\n    // ?⑤뒗 履쎌씠 ?노떎 (R10)\r\n    //\r\n    // 嫄곕━???쇰꺼(startY) ???먯씠 ?꾨땲???щ씪?댁뒪 **???*源뚯?濡??곕떎. ?듭빱媛 ?됱씤??\n    // ?곹븳留??쇰꺼 湲곗??대㈃ ?꾩옄 ?щ씪?댁뒪媛 ?먭린 ?곗쓣 踰꾨┛????????섎컲遺???볦씤\r\n    // ?곗? ?녠쾶 諛곗젙?섍퀬??startY ?먯꽌 span/2 瑜??섏뼱 ?먭린?쒕떎 (PR #61 由щ럭 major)\r\n    const { startY, endY } = slices[best]\r\n    const span = endY - startY\r\n    const distance = Math.max(startY - run.y, run.y - endY, 0)\r\n    if (distance <= span * SLICE_DISTANCE_LIMIT_RATIO) buckets[best].push(run)\r\n  }\r\n\r\n  return buckets\r\n}\r\n\r\n/**\r\n * ?쒖쓽 ?ㅼ젣 諛붾떏 y瑜?援ы븳?? 留덉?留?釉붾줉??endY???ㅼ쓬 ??댄????놁쑝硫??섏씠吏\r\n * 諛붾떏源뚯? ?대젮 ?덉뼱, blockRows.at(-1)????諛??쒖젣? ?띿뒪???꾨㈃踰덊샇쨌異뺤쿃 ??媛\r\n * ?????덈떎 ??寧?뤇 ?댁쓽 x?????tableRight) ?덉뿉 ?멸렇癒쇳듃媛 ?덈뒗 ?됱쑝濡?癒쇱?\r\n * 醫곹?????諛??띿뒪?멸? ?섏쭛 李쎌쓣 諛?대궡吏 ?딅뒗??(#37, #33??遺?묒슜)\r\n */\r\nfunction tableBottomY(\r\n  blockRows: TextRow[],\r\n  marks: MarkColumn[],\r\n  endY: number,\r\n): number {\r\n  return rowsWithinTable(blockRows, marks).at(-1)?.y ?? endY\r\n}\r\n\r\n/**\r\n * ?????됰쭔 ?④릿????寧?뤇 ?댁쓽 x?????tableRight) ?덉뿉 ?멸렇癒쇳듃媛 ?덈뒗 ?됱씠??\r\n * ?쒖젣?(?녜씊?띸㎞쨌嶸←릤兩븀칹鶯???? ?쒖? 媛숈? y???뿉 嫄몄퀜 ?덉뼱 y濡쒕뒗 紐?媛瑜몃떎.\r\n */\r\nfunction rowsWithinTable(blockRows: TextRow[], marks: MarkColumn[]): TextRow[] {\r\n  const tableRight = Math.max(...marks.map(({ centerX }) => centerX))\r\n  return blockRows.filter((row) =>\r\n    row.segments.some((segment) => segment.centerX <= tableRight),\r\n  )\r\n}\r\n\r\nfunction parseColumnBlock(\r\n  rows: TextRow[],\r\n  headerIndex: number,\r\n  endY: number,\r\n  titleText: string,\r\n  verticals: VerticalRun[],\r\n): SectionCandidate[] {\r\n  const header = rows[headerIndex]\r\n  const marks = markColumns(header)\r\n  if (marks.length === 0) return []\r\n  const blockRows = rowsBetween(rows, header.y, endY)\r\n  const stories: StoryRow[] = blockRows\r\n    .map((row) => ({ label: storyFromRow(row), row }))\r\n    .filter((entry): entry is StoryRow => entry.label !== undefined)\r\n  // 亮녑콏 ?????쇰꺼???녿뒗 ?쒕뒗 鸚㎪쥈 釉붾줉怨?媛숈? ?대갚?쇰줈 ???щ씪?댁뒪 泥섎━?쒕떎 ??\n  // 議곌린 諛섑솚?섎㈃ ?쒓? ?듭㎏濡??뚯씤??遺덇??띾줈 ?щ씪吏꾨떎\r\n  const slices: Array<{\r\n    storyLabel: string | undefined\r\n    startY: number\r\n    endY: number\r\n  }> =\r\n    stories.length > 0\r\n      ? stories.map((story, index) => ({\r\n          storyLabel: story.label,\r\n          startY: story.row.y,\r\n          endY: stories[index + 1]?.row.y ?? endY,\r\n        }))\r\n      : [{ storyLabel: undefined, startY: header.y, endY }]\r\n  // ?섏쭛 李쎌쓣 ?쒖쓽 ?ㅼ젣 ??踰붿쐞濡??ル뒗?? 媛濡?移섏닔???쇰꺼 ???ъ씠濡?醫곴쾶 ?섎━誘濡?\n  // 媛숈? ?몄텧???녿떎\r\n  const tableBottom = tableBottomY(blockRows, marks, endY)\r\n  const blockVerticals = verticalsBySlice(\r\n    verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n    // 留덉?留??щ씪?댁뒪??endY???쒖쓽 ?앹씠 ?꾨땲???ㅼ쓬 ??댄?쨌?섏씠吏 諛붾떏?대떎.\r\n    // 洹몃?濡??먮㈃ 洹?痢듭뿉?쒕쭔 嫄곕━ ?곹븳??痢?媛꾧꺽??紐?諛곕줈 踰뚯뼱吏꾨떎\r\n    slices.map((slice) => ({\r\n      startY: slice.startY,\r\n      endY: Math.min(slice.endY, tableBottom),\r\n    })),\r\n    rowsWithinTable(blockRows, marks),\r\n  )\r\n\r\n  const candidates: SectionCandidate[] = []\r\n  for (const [sliceIndex, slice] of slices.entries()) {\r\n    const dataRows = rowsBetween(rows, slice.startY, slice.endY)\r\n    const mainRows = dataRows.filter((row) => exactLabel(row, ['訝사춮']))\r\n    const hoopRows = dataRows.filter((row) => exactLabel(row, ['躍?춮', 'HOOP']))\r\n    // ?쇰꺼 議댁옱留?蹂대㈃ 媛??멸렇癒쇳듃媛 ?녿뒗 ?쇰꺼 ?됱씠 scalarDimensions ?대갚源뚯?\r\n    // 留됱븘 ?먮Ц 李멸퀬 ?쒖떆媛 ?듭㎏濡??щ씪吏꾨떎 ??鸚㎪쥈 釉붾줉怨?媛숈? 議곌굔???대떎\r\n    const dimensionRows = dataRows.filter(\r\n      (row) => exactLabel(row, ['??씊']) && dataSegments(row, ['??씊']).length > 0,\r\n    )\r\n    // ???щ씪?댁뒪??媛숈? ?쇰꺼 ?됱씠 寃뱀쑝濡??덉쑝硫??щ윭 痢?釉붾줉???⑹퀜吏?寃껋씠????\n    // ???쇰꺼???섎굹???몄떇?섏? ?딆? ???뚥??ч쉸?????쇰?留??몄떇??????F???똁1F????\n    // 泥???媛믪쓣 ?뺤젙?섎㈃ ?섎㉧吏 痢?媛믪씠 ?ъ쑀???먮Ц???놁씠 ?щ씪吏꾨떎\r\n    const storyAmbiguous =\r\n      mainRows.length > 1 || hoopRows.length > 1 || dimensionRows.length > 1\r\n    const mainRow = storyAmbiguous ? undefined : mainRows[0]\r\n    const hoopRow = storyAmbiguous ? undefined : hoopRows[0]\r\n    const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n    const positionRow =\r\n      lastPositionRow(rows, header.y, slice.startY) ??\r\n      dataRows.find((row) => exactLabel(row, ['鵝띸쉰']))\r\n    const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n    const mainContinuations = mainRow\r\n      ? barContinuationByMark(dataRows, mainRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const hoopContinuations = hoopRow\r\n      ? barContinuationByMark(dataRows, hoopRow, slice.endY, marks, PITCH_TOKEN)\r\n      : new Map<string, string>()\r\n    // ?ㅼ?移?移섏닔??媛濡쑣룹꽭濡?紐⑤몢 媛숈? ???듭빱濡?諛곗젙?쒕떎 ???쒖そ留?寧?뤇 以묒떖?대㈃\r\n    // 洹몄そ?먯꽌留?醫곸? ?댁썐 移몄씠 媛믪쓣 媛?멸컙??\n    const anchors = markAnchors(marks, positions)\r\n    const dimensionValues = storyAmbiguous\r\n      ? new Map<string, string>()\r\n      : dimensionRow\r\n        ? valuesByMark(dimensionRow, ['??씊'], marks)\r\n        : sketchDimensions(\r\n            rows,\r\n            slice.startY,\r\n            [mainRow, hoopRow],\r\n            anchors,\r\n          )\r\n    // ??씊 ?쇰꺼 ?됱씠 ?덉쑝硫??몃줈 移섏닔??蹂댁? ?딅뒗?????쇰꺼 ??媛믪씠 ???뺤떎??洹쇨굅??\n    const verticalValues =\r\n      storyAmbiguous || dimensionRow\r\n        ? new Map<string, string>()\r\n        : verticalsByMark(blockVerticals[sliceIndex], anchors)\r\n    const mainByPosition =\r\n      mainRow && positions.length > 0\r\n        ? valuesByPosition(mainRow, ['訝사춮'], positions, marks)\r\n        : new Map<string, string>()\r\n    // 鵝띸쉰 ?댁쓣 ?섎굹??諛곗젙諛쏆? 紐삵븳 寧?뤇(DP媛 ??寧?뤇??紐곗븘以 寃쎌슦)?먮룄 ?? ?덈떎 ??\n    // ?대갚 ?놁씠 ?먮㈃ 洹?寧?뤇??訝사춮???뺤젙???먮Ц???댁뒋???놁씠 ?щ씪吏꾨떎\r\n    const mainByMark = mainRow\r\n      ? valuesByMark(mainRow, ['訝사춮'], marks)\r\n      : new Map<string, string>()\r\n    const hoopLabel = hoopRow\r\n      ? exactLabel(hoopRow, ['躍?춮', 'HOOP'])?.compact\r\n      : undefined\r\n    const hoopValues =\r\n      hoopRow && hoopLabel ? valuesByMark(hoopRow, [hoopLabel], marks) : new Map()\r\n\r\n    marks.forEach(({ mark }) => {\r\n      if (storyAmbiguous) {\r\n        // 媛??놁씠 ?ъ쑀留??ㅼ? ?꾨낫瑜??④릿?????쒓? 議곗슜???щ씪吏硫??ъ슜?먮뒗\r\n        // ?몄떇 ?ㅽ뙣? 援щ텇?????녿떎. ?롫? 紐??쎌? 寃껉낵 ?롫뒗 ?쎌뿀?쇰굹 ?됱씠 寃뱀씤 寃껋?\r\n        // ?ъ슜?먭? ?먮룄?먯꽌 ?뺤씤??怨녹씠 ?ㅻⅤ誘濡??ъ쑀瑜??섎늿??\n        candidates.push({\r\n          kind: kindFromMark(mark, titleText),\r\n          mark,\r\n          storyLabel: slice.storyLabel,\r\n          raw: {},\r\n          issues: [slice.storyLabel === undefined ? '?롣툖?? : '?끿쎅烏뚪뇥筽?],\r\n        })\r\n        return\r\n      }\r\n      const markPositions = positions\r\n        .map((position, index) => ({ ...position, index }))\r\n        .filter((position) => position.mark === mark)\r\n      const mainCells =\r\n        markPositions.length > 0\r\n          ? markPositions\r\n              .map((position) => ({\r\n                position: position.label,\r\n                raw: mainByPosition.get(String(position.index)),\r\n              }))\r\n              .filter(\r\n                (cell): cell is { position: string; raw: string } =>\r\n                  cell.raw !== undefined,\r\n              )\r\n          : mainByMark.has(mark)\r\n            ? [{ raw: mainByMark.get(mark) as string }]\r\n            : []\r\n      const dimension = dimensionValues.get(mark)\r\n      const hoop = hoopValues.get(mark)\r\n      // ?묓옒 寃?щ낫??癒쇱? ?⑥뼱?⑤━硫? 媛믪씠 ?묓엺 ?섏㎏ 以꾩뿉留??덈뒗 寧?뤇??\n      // ?ъ쑀???먮Ц???놁씠 ?щ씪吏꾨떎 ???묓옒???뚯씫? 寃껋씠 ?덈떎?띿뿉 ?ｋ뒗??\n      if (\r\n        !dimension &&\r\n        mainCells.length === 0 &&\r\n        !hoop &&\r\n        !mainContinuations.has(mark) &&\r\n        !hoopContinuations.has(mark)\r\n      ) {\r\n        return\r\n      }\r\n\r\n      const result: SectionCandidate = {\r\n        kind: kindFromMark(mark, titleText),\r\n        mark,\r\n        storyLabel: slice.storyLabel,\r\n        raw: {},\r\n        issues: [],\r\n      }\r\n      setDimension(result, dimension, true, verticalValues.get(mark))\r\n      const continuation = mainContinuations.get(mark)\r\n      if (continuation !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗??????以꾩쓣 ?먮Ц 李멸퀬濡??④릿??\n        for (const cell of mainCells) {\r\n          const key =\r\n            'position' in cell ? `訝사춮(${cell.position})` : '訝사춮'\r\n          result.raw[key] = cleanedRebarRaw(cell.raw)\r\n        }\r\n        // 泥?以꾩씠 ?꾩삁 ?놁쑝硫??뚯젒? ?덈떎?띻? ?꾨땲?????녿뒗 ?묓옒???뚮━硫?\n        // ?ъ슜?먮뒗 ?먮룄?먯꽌 議댁옱?섏? ?딅뒗 ?섏㎏ 以꾩쓣 李얜뒗??\n        const folded = mainCells.length > 0\r\n        result.raw[folded ? '訝사춮(?섋퓭??' : '訝사춮(?▲꺀?쇻꺂烏?'] =\r\n          cleanedRebarRaw(continuation)\r\n        addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n      } else {\r\n        setColumnMain(result, mainCells, markPositions.length)\r\n      }\r\n      if (hoopLabel) {\r\n        setPitch(result, 'hoop', hoopLabel, hoop, hoopContinuations.get(mark))\r\n      }\r\n      candidates.push(result)\r\n    })\r\n  }\r\n\r\n  return candidates\r\n}\r\n\r\nfunction cellsForMark(\n  values: Map<string, string>,\r\n  positions: Array<PositionColumn & { index: number }>,\r\n  mark: string,\r\n): Array<{ position: string; rawPosition: string; raw: string }> {\n  return positions\r\n    .filter((position) => position.mark === mark)\r\n    .map((position) => ({\n      position: position.label,\n      rawPosition: position.rawLabel,\n      raw: values.get(String(position.index)),\n    }))\n    .filter(\n      (cell): cell is {\n        position: string\n        rawPosition: string\n        raw: string\n      } => cell.raw !== undefined,\n    )\n}\n\r\nfunction cutoffCellsByMark(\n  rows: TextRow[],\r\n  positions: PositionColumn[],\r\n  marks: MarkColumn[],\r\n): Map<string, Array<{ position?: string; raw: string }>> {\r\n  const result = new Map<\r\n    string,\r\n    Array<{ position?: string; raw: string }>\r\n  >()\r\n  const positionTargets = positions.map((position, index) => ({\r\n    id: String(index),\r\n    centerX: position.centerX,\r\n  }))\r\n  const markTargets = marks.map(({ mark, centerX }) => ({\r\n    id: mark,\r\n    centerX,\r\n  }))\r\n\r\n  for (const segment of rows.flatMap((row) => row.segments)) {\r\n    // NFKC濡??②쭜 竊삼섹瑜??딂쭜 []???묐릺, raw?먮뒗 ?먮Ц 湲?먮? 洹몃?濡??④릿??\r\n    // ?덉씠 鍮?烏③죱???뚳섶竊썲냵??╉띾뒗 ?レ옄 議곌굔???듦낵?섏? ?딅뒗??\r\n    if (!/^\\[\\d+\\]$/.test(compact(segment.text))) continue\r\n\r\n    const positionIndex = valuesAtTargets(\r\n      [segment],\r\n      positionTargets,\r\n    ).keys().next().value as string | undefined\r\n    const position =\r\n      positionIndex === undefined ? undefined : positions[Number(positionIndex)]\r\n    const mark =\r\n      position?.mark ??\r\n      (valuesAtTargets([segment], markTargets).keys().next().value as\r\n        | string\r\n        | undefined)\r\n    if (mark === undefined) continue\r\n\r\n    const cells = result.get(mark) ?? []\r\n    cells.push({ position: position?.label, raw: segment.text })\r\n    result.set(mark, cells)\r\n  }\r\n\r\n  return result\n}\n\nfunction cutoffFromSupportFace(\n  cells: Array<{ position?: string; raw: string }>,\n  positions: PositionColumn[],\n): number | undefined {\n  if (\n    cells.length === 0 ||\n    !isThreePositionLayout(positions.map(({ label }) => ({ position: label })))\n  ) {\n    return undefined\n  }\n\n  const leftLabel = positions[0]?.label\n  const rightLabel = positions[2]?.label\n  if (leftLabel === undefined || rightLabel === undefined) return undefined\n\n  const values: number[] = []\n  for (const cell of cells) {\n    if (cell.position !== leftLabel && cell.position !== rightLabel) {\n      return undefined\n    }\n    const match = compact(cell.raw).match(/^\\[(\\d+)\\]$/)\n    if (!match) return undefined\n    const value = Number(match[1])\n    if (!Number.isFinite(value)) return undefined\n    values.push(value)\n  }\n\n  const first = values[0]\n  return first !== undefined && values.every((value) => value === first)\n    ? first\n    : undefined\n}\n\r\nfunction parseGirderBlock(\r\n  rows: TextRow[],\r\n  headerIndex: number,\r\n  endY: number,\r\n  titleText: string,\r\n  verticals: VerticalRun[],\r\n): SectionCandidate[] {\r\n  const header = rows[headerIndex]\r\n  const marks = markColumns(header)\r\n  if (marks.length === 0) return []\r\n  const blockRows = rowsBetween(rows, header.y, endY)\r\n  const stories: StoryRow[] = blockRows\r\n    .map((row) => ({ label: storyFromRow(row), row }))\r\n    .filter((entry): entry is StoryRow => entry.label !== undefined)\r\n  const slices =\r\n    stories.length > 0\r\n      ? stories.map((story, index) => ({\r\n          storyLabel: story.label,\r\n          startY: story.row.y,\r\n          endY: stories[index + 1]?.row.y ?? endY,\r\n        }))\r\n      : [{ storyLabel: undefined, startY: header.y, endY }]\r\n  // ??釉붾줉怨?媛숈? ?댁쑀濡??섏쭛 李쎄낵 ?щ씪?댁뒪 ?곹븳???쒖쓽 ?ㅼ젣 ??踰붿쐞濡??ル뒗??\n  const tableBottom = tableBottomY(blockRows, marks, endY)\r\n  const blockVerticals = verticalsBySlice(\r\n    verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n    slices.map((slice) => ({\r\n      startY: slice.startY,\r\n      endY: Math.min(slice.endY, tableBottom),\r\n    })),\r\n    rowsWithinTable(blockRows, marks),\r\n  )\r\n  const candidates: SectionCandidate[] = []\r\n\r\n  for (const [sliceIndex, slice] of slices.entries()) {\r\n    const dataRows = rowsBetween(rows, slice.startY, slice.endY)\r\n    const dimensionRows = dataRows.filter(\r\n      (row) =>\r\n        exactLabel(row, ['??씊', 'b횞D']) &&\r\n        dataSegments(row, ['??씊', 'b횞D']).length > 0,\r\n    )\r\n    const topRows = dataRows.filter((row) => exactLabel(row, ['訝딁춮', '訝딁ク嶺?]))\r\n    const bottomRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['訝뗧춮', '訝뗧ク嶺?]),\r\n    )\r\n    const stirrupRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['ST', 'STP', '?귙겙?됬춮']),\r\n    )\r\n    const sideBarRows = dataRows.filter((row) => exactLabel(row, ['?밭춮']))\r\n    // ??釉붾줉怨?媛숈? 諛⑹뼱 ???쇰꺼 ?됱씠 寃뱀씠硫??щ윭 痢?釉붾줉???⑹퀜吏?寃껋씠??\n    const storyAmbiguous =\r\n      topRows.length > 1 ||\r\n      bottomRows.length > 1 ||\r\n      stirrupRows.length > 1 ||\r\n      sideBarRows.length > 1 ||\r\n      dimensionRows.length > 1\r\n    const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n    const topRow = storyAmbiguous ? undefined : topRows[0]\r\n    const bottomRow = storyAmbiguous ? undefined : bottomRows[0]\r\n    const stirrupRow = storyAmbiguous ? undefined : stirrupRows[0]\r\n    const sideBarRow = storyAmbiguous ? undefined : sideBarRows[0]\r\n    const positionRow =\r\n      lastPositionRow(rows, header.y, slice.startY) ??\r\n      dataRows.find((row) => exactLabel(row, ['鵝띸쉰']))\r\n    const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n    const indexedPositions = positions.map((position, index) => ({\r\n      ...position,\r\n      index,\r\n    }))\r\n    const cutoffCells = cutoffCellsByMark(dataRows, positions, marks)\r\n    const dimensionLabel = dimensionRow\r\n      ? exactLabel(dimensionRow, ['??씊', 'b횞D'])?.compact\r\n      : undefined\r\n    // ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ??ojkk 鸚㎪쥈?ゃ궧????洹쇨굅???ㅼ?移?移섏닔肉먯씠??????釉붾줉怨?\n    // 媛숈? ?대갚?쇰줈 媛濡?移섏닔瑜?以띻퀬, ?몃줈(?뚯쟾 臾몄옄??? 吏앹??댁빞 b횞D媛 ?섏삩??\n    const anchors = markAnchors(marks, positions)\r\n    const dimensionValues = storyAmbiguous\r\n      ? new Map<string, string>()\r\n      : dimensionRow && dimensionLabel\r\n        ? valuesByMark(dimensionRow, [dimensionLabel], marks)\r\n        : sketchDimensions(\r\n            rows,\r\n            slice.startY,\r\n            [topRow, bottomRow, stirrupRow],\r\n            anchors,\r\n          )\r\n    // ??씊 ?쇰꺼 ?됱씠 ?덉쑝硫??몃줈 移섏닔??蹂댁? ?딅뒗?????쇰꺼 ??媛믪씠 ???뺤떎??洹쇨굅??\n    const verticalValues =\r\n      storyAmbiguous || dimensionRow\r\n        ? new Map<string, string>()\r\n        : verticalsByMark(blockVerticals[sliceIndex], anchors)\r\n    const topLabel = topRow\r\n      ? exactLabel(topRow, ['訝딁춮', '訝딁ク嶺?])?.compact\r\n      : undefined\r\n    const bottomLabel = bottomRow\r\n      ? exactLabel(bottomRow, ['訝뗧춮', '訝뗧ク嶺?])?.compact\r\n      : undefined\r\n    // ??釉붾줉怨?媛숈? ?대갚 ??鵝띸쉰 ?댁쓣 諛곗젙諛쏆? 紐삵븳 寧?뤇??????④릿??\n    const topByPosition =\r\n      topRow && topLabel && positions.length > 0\r\n        ? valuesByPosition(topRow, [topLabel], positions, marks)\r\n        : new Map<string, string>()\r\n    const topByMark =\r\n      topRow && topLabel\r\n        ? valuesByMark(topRow, [topLabel], marks)\r\n        : new Map<string, string>()\r\n    const bottomByPosition =\r\n      bottomRow && bottomLabel && positions.length > 0\r\n        ? valuesByPosition(bottomRow, [bottomLabel], positions, marks)\r\n        : new Map<string, string>()\r\n    const bottomByMark =\r\n      bottomRow && bottomLabel\r\n        ? valuesByMark(bottomRow, [bottomLabel], marks)\r\n        : new Map<string, string>()\r\n    const stirrupLabel = stirrupRow\r\n      ? exactLabel(stirrupRow, ['ST', 'STP', '?귙겙?됬춮'])?.compact\r\n      : undefined\r\n    const stirrupValues =\r\n      stirrupRow && stirrupLabel\r\n        ? valuesByMark(stirrupRow, [stirrupLabel], marks)\r\n        : new Map<string, string>()\r\n    const sideBarValues = sideBarRow\r\n      ? valuesByMark(sideBarRow, ['?밭춮'], marks)\r\n      : new Map<string, string>()\r\n    // ?묓엺 ?(以꾨컮轅? 媛먯? ????釉붾줉怨?媛숈? 諛⑹뼱瑜?訝딁춮/訝뗧춮/?귙겙?됬춮?먮룄 嫄대떎\r\n    const topContinuations = topRow\r\n      ? barContinuationByMark(dataRows, topRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const bottomContinuations = bottomRow\r\n      ? barContinuationByMark(dataRows, bottomRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const stirrupContinuations = stirrupRow\r\n      ? barContinuationByMark(\r\n          dataRows,\r\n          stirrupRow,\r\n          slice.endY,\r\n          marks,\r\n          PITCH_TOKEN,\r\n        )\r\n      : new Map<string, string>()\r\n\r\n    for (const { mark } of marks) {\r\n      if (storyAmbiguous) {\r\n        candidates.push({\r\n          kind: kindFromMark(mark, titleText),\r\n          mark,\r\n          storyLabel: slice.storyLabel,\r\n          raw: {},\r\n          issues: [slice.storyLabel === undefined ? '?롣툖?? : '?끿쎅烏뚪뇥筽?],\r\n        })\r\n        continue\r\n      }\r\n      const markPositions = indexedPositions.filter(\r\n        (position) => position.mark === mark,\r\n      )\r\n      const topCells =\r\n        markPositions.length > 0\r\n          ? cellsForMark(topByPosition, indexedPositions, mark)\r\n          : topByMark.has(mark)\r\n            ? [{ position: '?ⓩ뼪??, raw: topByMark.get(mark) as string }]\r\n            : []\r\n      const bottomCells =\r\n        markPositions.length > 0\r\n          ? cellsForMark(bottomByPosition, indexedPositions, mark)\r\n          : bottomByMark.has(mark)\r\n            ? [{ position: '?ⓩ뼪??, raw: bottomByMark.get(mark) as string }]\r\n            : []\r\n      const dimension = dimensionValues.get(mark)\r\n      const stirrup = stirrupValues.get(mark)\r\n      const sideBar = sideBarValues.get(mark)\r\n      // ??釉붾줉怨?媛숈? ?댁쑀 ???묓옒???뚯씫? 寃껋씠 ?덈떎?띿뿉 ?ｋ뒗??\n      if (\r\n        !dimension &&\r\n        topCells.length === 0 &&\r\n        bottomCells.length === 0 &&\r\n        !stirrup &&\r\n        sideBar === undefined &&\r\n        !cutoffCells.has(mark) &&\r\n        !topContinuations.has(mark) &&\r\n        !bottomContinuations.has(mark) &&\r\n        !stirrupContinuations.has(mark)\r\n      ) {\r\n        continue\r\n      }\r\n\r\n      const result: SectionCandidate = {\n        kind: kindFromMark(mark, titleText),\n        mark,\n        storyLabel: slice.storyLabel,\n        raw: {},\n        issues: [],\n      }\n      const cutoffMm = cutoffFromSupportFace(\n        cutoffCells.get(mark) ?? [],\n        markPositions,\n      )\n      setDimension(result, dimension, false, verticalValues.get(mark))\n      const topFold = topContinuations.get(mark)\r\n      const bottomFold = bottomContinuations.get(mark)\r\n      if (topFold !== undefined || bottomFold !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????以꾨뱾???먮Ц 李멸퀬濡??④릿??\n        if (topLabel) {\r\n          for (const cell of topCells) {\r\n            result.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        if (bottomLabel) {\r\n          for (const cell of bottomCells) {\r\n            result.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        // 訝듾툔瑜????ㅼ뿉 紐곕㈃ ?묒そ???묓엺 ?쒖뿉??訝뗧춮 以꾩씠 訝딁춮 以꾩쓣 ??뒗??\r\n        // 躍?춮쨌ST? 媛숈? ?쇰꺼 洹쒖빟?????대뒓 ?됱씠 ?묓삍?붿????④릿??\r\n        // ??釉붾줉怨?媛숈? ?댁쑀濡?泥?以꾩씠 ?녿뒗 履쎌? ?묓옒?대씪 遺瑜댁? ?딅뒗??\n        if (topFold !== undefined) {\r\n          const folded = topCells.length > 0\r\n          result.raw[\r\n            `${topLabel ?? '訝딁춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(topFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n        if (bottomFold !== undefined) {\r\n          const folded = bottomCells.length > 0\r\n          result.raw[\r\n            `${bottomLabel ?? '訝뗧춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(bottomFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n      } else if (topLabel || bottomLabel) {\n        // ?쒖そ ?쇰꺼留??몄떇?쇰룄 ?쎌뼱???? ?④릿????setGirderMain??訝듾툔 ?묒そ??\n        // ?붽뎄?섎?濡??뚥말嶺뗤퐤營?쵟?썬띿씠 遺숆퀬, ?뺤젙 ?놁씠 ?먮Ц??蹂댁〈?쒕떎\r\n        setGirderMain(\r\n          result,\r\n          topLabel ?? '訝딁춮',\r\n          bottomLabel ?? '訝뗧춮',\r\n          topCells,\r\n          bottomCells,\r\n          markPositions.length,\r\n        )\n      }\n      if (cutoffMm !== undefined && result.girderMain !== undefined) {\n        result.girderMain.cutoffFromSupportFaceMm = cutoffMm\n      }\n      if (stirrupLabel) {\n        setPitch(\r\n          result,\r\n          'stirrup',\r\n          stirrupLabel,\r\n          stirrup,\r\n          stirrupContinuations.get(mark),\r\n        )\r\n      }\r\n      setSideBar(result, sideBar)\r\n      for (const cell of cutoffCells.get(mark) ?? []) {\r\n        const key = cell.position\r\n          ? `?ャ긿?덀궕??${cell.position})`\r\n          : '?ャ긿?덀궕??\r\n        result.raw[key] = cell.raw\r\n      }\r\n      candidates.push(result)\r\n    }\r\n  }\r\n\r\n  return candidates\r\n}\r\n\r\nfunction parseTableRegion(\r\n  rows: TextRow[],\r\n  anchor: TitleAnchor,\r\n  endY: number,\r\n  xStart: number,\r\n  xEnd: number,\r\n  verticals: VerticalRun[],\r\n): ParsedSectionList | undefined {\r\n  const isSlabList = /?밤꺀?뽧꺁?밤깉|?먨쑇?덀꺁?밤깉/.test(anchor.listKind)\r\n  const isWallList = anchor.listKind === '鶯곥꺁?밤깉'\r\n  // ?곸뿭??y肉??꾨땲??x???쑝濡쒕룄 ?섎씪?몃떎 ??醫뚯슦濡??섎???由ъ뒪?몄뿉?????쒖쓽\r\n  // ?멸렇癒쇳듃媛 ?욎씠硫?寧?뤇쨌?쇰꺼 留ㅼ묶?????쒕? ?ㅼ뿼?쒗궓??\n  const tableRows = rows\r\n    .filter(\r\n      (row) =>\r\n        row.y >= anchor.row.y && (isSlabList || row.y < endY),\r\n    )\r\n    .map((row) => {\r\n      const items = row.items.filter(\r\n        (item) =>\r\n          isSlabList || isWallList || (item.x + item.w >= xStart && item.x < xEnd),\r\n      )\r\n      return items.length > 0\r\n        ? { ...row, items, segments: makeSegments(items) }\r\n        : undefined\r\n    })\r\n    .filter((row): row is TextRow => row !== undefined)\r\n  const headerIndexes = tableRows\r\n    .map((row, index) => ({ index, marks: markColumns(row) }))\r\n    .filter(({ marks }) => marks.length > 0)\r\n    .map(({ index }) => index)\r\n  // ??댄?怨??배쮼??媛숈? ?쒖젣 以꾩씠?대룄 湲???ш린쨌湲곗???李⑥씠濡??몄젒 蹂듭썝 ?됱씠 ????\n  // ?덈떎. 理쒖큹 寧?뤇 ???욊퉴吏留??⑹퀜 ?쒖쓽 ?곗씠???됱? 嫄대뱶由ъ? ?딅뒗??\r\n  const titleLineText = compact(\r\n    tableRows\r\n      .slice(0, headerIndexes[0] ?? tableRows.length)\r\n      .flatMap((row) => row.items)\r\n      .map((item) => item.str)\r\n      .join(''),\r\n  )\r\n  // ??곸씠 ?꾨땶 由ъ뒪?몃? 紐??쎌뿀?ㅺ퀬 ?뚮━硫??뺤긽 ?뚯떛???꾨㈃?먯꽌???ㅽ뙣 ?덈궡媛 ?щ떎\r\n  const outOfScope = isOutOfScopeList(anchor.titleText)\r\n  if (isWallList || isSlabList) {\r\n    const candidates =\r\n      isWallList\r\n        ? parseWallBlock(tableRows, anchor.titleText, endY)\r\n        : parseSlabBlock(tableRows, anchor, endY)\r\n    return {\r\n      listKind: anchor.listKind,\r\n      candidates,\r\n      ...(candidates.length === 0 && !outOfScope\r\n        ? { issue: '?끿쎅烏뚧쑋沃띹춼' as const }\r\n        : {}),\r\n    }\r\n  }\r\n  // ??댄?? ?몄떇?덈뒗??寧?뤇 ?됱쓣 紐??쎌? ?쒕? ?듭㎏濡?踰꾨━硫? ?붾㈃?먮뒗\r\n  // ?뚧뼪?㏂꺁?밤깉媛 ?녿떎?띾줈 蹂댁뿬 ?ъ슜?먭? ?몄떇 ?ㅽ뙣? 援щ텇?????녿떎.\r\n  // ?ъ쑀瑜?肄붾뱶濡??ㅼ뼱 蹂대궡怨?臾멸뎄???쒖떆遺媛 怨좊Ⅸ??(CandidateIssue? 媛숈? 洹쒖빟)\r\n  if (headerIndexes.length === 0) {\r\n    return outOfScope\r\n      ? undefined\r\n      : { listKind: anchor.listKind, candidates: [], issue: '寧?뤇烏뚧쑋沃띹춼' }\r\n  }\r\n\r\n  const candidates: SectionCandidate[] = []\r\n  // ?쒖쓽 x???諛??몃줈 臾몄옄?댁? ???쒖쓽 寃껋씠?????됯낵 媛숈? 寃쎄퀎濡??먮Ⅸ??\n  const tableVerticals = verticals.filter(\r\n    (run) => run.x >= xStart && run.x < xEnd,\r\n  )\r\n  headerIndexes.forEach((headerIndex, index) => {\r\n    const blockEnd = tableRows[headerIndexes[index + 1]]?.y ?? endY\r\n    const parsed = anchor.listKind.includes('??)\r\n      ? parseColumnBlock(\r\n          tableRows,\r\n          headerIndex,\r\n          blockEnd,\r\n          anchor.titleText,\r\n          tableVerticals,\r\n        )\r\n      : parseGirderBlock(\r\n          tableRows,\r\n          headerIndex,\r\n          blockEnd,\r\n          anchor.titleText,\r\n          tableVerticals,\r\n        )\r\n    candidates.push(...parsed)\r\n  })\r\n\r\n  // 亮끾??곭춮??꺁?밤깉?ⓧ퐪??돶鼇섅겎?귙굤?곩릪?섇ㄷ歟곥꺁?밤깉??뀲?숃짒?ュ듅?뤵?\n  // ?긱꺕弱뤸쥈?㎯겘?볝겗?배쮼?や퐪?믦き?얇겒????1?싧뎴3) ???穩▲겓?긱겘?ゃ걦?곩컦歟곥겘影꾢쎊鸚뽧?\n  const hasGirder = candidates.some((candidate) => candidate.kind === '鸚㎪쥈')\r\n  const widthTie = hasGirder\r\n    ? widthTieFromTitle(titleLineText)\r\n    : undefined\r\n  if (widthTie) {\r\n    for (const candidate of candidates) {\r\n      if (candidate.kind !== '鸚㎪쥈') continue\r\n      if (widthTie.value) candidate.widthTie = { ...widthTie.value }\r\n      else if (widthTie.raw) {\r\n        candidate.raw['亮끾?嶺?] = widthTie.raw\r\n        addIssue(candidate, '亮끾??곭춮鰲ｉ뇠訝띹꺗')\r\n      }\r\n    }\r\n  }\r\n\r\n  // 寧?뤇? ?쎌뿀?쇰굹 ??ぉ ????씊쨌訝사춮쨌躍?춮)???섎굹??紐??쎌? ?????뚨Е?룹쓣 紐?\n  // ?쎌뿀?ㅳ띾줈 ?덈궡?섎㈃ ?ъ슜?먭? ?먮룄???됰슧??怨녹쓣 蹂몃떎\r\n  return {\r\n    listKind: anchor.listKind,\r\n    candidates,\r\n    ...(candidates.length === 0 && !outOfScope\r\n      ? { issue: '?끿쎅烏뚧쑋沃띹춼' as const }\r\n      : {}),\r\n  }\r\n}\r\n\r\nexport function parseSectionLists(page: TextPage): ParsedSectionList[] {\r\n  const rows = recoverRows(page.items)\r\n  const verticals = verticalRuns(page.items)\r\n  const anchors = titleAnchors(rows)\r\n  const parsed: ParsedSectionList[] = []\r\n\r\n  anchors.forEach((anchor) => {\r\n    // 媛숈? y???쓽 ?ㅻⅨ履???댄?? ?꾨옒 ?쒓? ?꾨땲?????쒕떎 ??x 寃쎄퀎媛 ?쒕떎\r\n    const sameBand = Math.max(anchor.row.height, 1) * PROXIMITY_MULTIPLIER\r\n    // 醫뚯륫 寃쎄퀎瑜???댄? x??0?쇰줈 怨좎젙?섎㈃ 以묒븰 ?뺣젹 ??댄? ?쒖쓽 ?쇱そ ?쇰꺼?댁씠\r\n    // ?섎┛????醫뚯륫 ?댁썐 ??댄?怨쇱쓽 以묒젏???곌퀬, ?댁썐???놁쑝硫??쇱そ???댁뼱 ?붾떎\r\n    const leftNeighbor = anchors\r\n      .filter(\r\n        (other) =>\r\n          other !== anchor &&\r\n          Math.abs(other.row.y - anchor.row.y) <= sameBand &&\r\n          other.x < anchor.x,\r\n      )\r\n      .sort((left, right) => right.x - left.x)[0]\r\n    const xStart = leftNeighbor\r\n      ? (leftNeighbor.x + anchor.x) / 2\r\n      : Number.NEGATIVE_INFINITY\r\n    const rightNeighbor = anchors\r\n      .filter(\r\n        (other) =>\r\n          other !== anchor &&\r\n          Math.abs(other.row.y - anchor.row.y) <= sameBand &&\r\n          other.x > anchor.x,\r\n      )\r\n      .sort((left, right) => left.x - right.x)[0]\r\n    // ?곗륫 寃쎄퀎??以묒젏 ???뚯씠??x??0??怨좎젙?대㈃ 以묒븰 ?뺣젹 ??댄???媛吏??ㅻⅨ履??쒖쓽\r\n    // ?쇰꺼?댁씠 ?쇱そ ???뿉 ?덉뼱 ?ㅼ뼱? ? 媛믪뿉 ?댁뼱遺숇뒗??\n    const xEnd = rightNeighbor\r\n      ? isOutOfScopeList(anchor.titleText)\r\n        ? rightNeighbor.x\r\n        : (anchor.x + rightNeighbor.x) / 2\r\n      : Number.POSITIVE_INFINITY\r\n    // 釉붾줉 ?앹? ??x????덉뿉???꾨옒???ㅻ뒗 ?ㅼ쓬 ??댄?\r\n    const below = anchors\r\n      .filter(\r\n        (other) =>\r\n          other.row.y - anchor.row.y > sameBand &&\r\n          other.x >= xStart &&\r\n          other.x < xEnd,\r\n      )\r\n      .sort((left, right) => left.row.y - right.row.y)[0]\r\n    const endY = below?.row.y ?? page.heightPt\r\n    const result = parseTableRegion(\r\n      rows,\r\n      anchor,\r\n      endY,\r\n      xStart,\r\n      xEnd,\r\n      verticals,\r\n    )\r\n    if (result) parsed.push(result)\r\n  })\r\n\r\n  return parsed\r\n}\r\n\r\nimport { readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseSectionLists } from '@/lib/import/section-list/parse'\r\nimport type {\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readExpected<T>(file: string): T {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/expected',\r\n    file,\r\n  )\r\n  return JSON.parse(readFileSync(fixturePath, 'utf8')) as T\r\n}\r\n\r\nfunction list(\r\n  parsed: ParsedSectionList[],\r\n  listKind: string,\r\n): ParsedSectionList {\r\n  const found = parsed.find((entry) => entry.listKind === listKind)\r\n  expect(found, `missing list: ${listKind}`).toBeDefined()\r\n  return found as ParsedSectionList\r\n}\r\n\r\nfunction candidate(\r\n  parsedList: ParsedSectionList,\r\n  mark: string,\r\n  storyLabel?: string,\r\n): SectionCandidate {\r\n  const found = parsedList.candidates.find(\r\n    (entry) => entry.mark === mark && entry.storyLabel === storyLabel,\r\n  )\r\n  expect(\r\n    found,\r\n    `missing candidate: ${parsedList.listKind} ${mark} ${storyLabel ?? ''}`,\r\n  ).toBeDefined()\r\n  return found as SectionCandidate\r\n}\r\n\r\nfunction expectMarksInclude(\r\n  parsedList: ParsedSectionList,\r\n  expectedMarks: readonly string[],\r\n): void {\r\n  const parsedMarks = new Set(parsedList.candidates.map(({ mark }) => mark))\r\n  for (const mark of expectedMarks) expect(parsedMarks.has(mark), mark).toBe(true)\r\n}\r\n\r\nfunction titlePage(title: string, mark: string): TextPage {\r\n  return {\r\n    widthPt: 300,\r\n    heightPt: 180,\r\n    items: [\r\n      { str: title, x: 10, y: 5, w: 260, h: 8 },\r\n      { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n      { str: mark, x: 140, y: 20, w: 12, h: 8 },\r\n      { str: '??씊', x: 10, y: 50, w: 20, h: 8 },\r\n      { str: '400횞600', x: 120, y: 50, w: 50, h: 8 },\r\n    ],\r\n  }\r\n}\r\n\r\ndescribe('parseSectionLists', () => {\r\n  it('parses the horizontal ojkk ?긱꺁?밤깉 without inventing unsupported hoop sizes', () => {\r\n    const parsed = parseSectionLists(readPage('ojkk-p2.json'))\r\n    const columns = list(parsed, '?긱꺁?밤깉')\r\n\r\n    expectMarksInclude(columns, ['C1', 'C2', 'C2A', 'FC1'])\r\n    // ???쒖뿉????씊 ?쇰꺼 ?됱씠 ?녿떎 ??洹쇨굅???ㅼ?移섏뿉 遺숈? 媛濡쑣룹꽭濡?移섏닔 ??媛쒕퓧?닿퀬,\r\n    // ?몃줈???뚯쟾 臾몄옄?댁씠????蹂듭썝?먯꽌 鍮좎쭊?? ?섏쓣 吏앹??댁빞 700횞700???섏삩??\r\n    const c1 = candidate(columns, 'C1', '6F')\r\n    expect(c1).toMatchObject({\r\n      kind: '??,\r\n      mark: 'C1',\r\n      shape: '?⒴숱',\r\n      storyLabel: '6F',\r\n      main: { count: 16, size: 'D25' },\r\n      hoop: { size: 'D13', pitchMm: 100 },\r\n    })\r\n    expect([c1.b, c1.d]).toEqual([700, 700])\r\n    expect(c1.raw['??씊']).toBeUndefined()\r\n    expect(c1.issues).toHaveLength(0)\r\n    expect(candidate(columns, 'C2A', '2F')).toMatchObject({\r\n      main: { count: 20, size: 'D29' },\r\n    })\r\n\r\n    // 遙섇섭佯╉걵?볠뼪獒쒎섭嶺?K13?귙깢?쇈깤??빊?뤵겘??씊?③빓?졼걨?㎪군?얇굥??겎\r\n    // 誤뤸틬?ャ겒?꾢ㅳ굮凉뺛걢?싥겓?뽧굤渦쇈굙??(ADR-026)\r\n    const c2aFirst = candidate(columns, 'C2A', '1F')\r\n    expect(c2aFirst.main).toEqual({ count: 22, size: 'D32' })\r\n    expect(c2aFirst.hoop).toEqual({ size: 'K13', pitchMm: 100 })\r\n    expect(c2aFirst.raw['躍?춮']).toBeUndefined()\r\n    expect(c2aFirst.issues).toHaveLength(0)\r\n\r\n    const c2First = candidate(columns, 'C2', '1F')\r\n    expect(c2First.hoop).toEqual({ size: 'K13', pitchMm: 100 })\r\n    expect(candidate(columns, 'FC1', '1F').kind).toBe('野얕괌鸚?)\r\n  })\r\n\r\n  it('detects the fifth TextItem fixture and its 鸚㎪쥈 list', () => {\r\n    const parsed = parseSectionLists(readPage('ojkk-p3.json'))\r\n    const girders = list(parsed, '鸚㎪쥈?ゃ궧??)\r\n\r\n    expectMarksInclude(girders, ['G1', 'G2', 'G3', 'G4', 'G5'])\r\n    expect(candidate(girders, 'G1', 'RF').kind).toBe('鸚㎪쥈')\r\n    expect(candidate(girders, 'G1', 'RF').sideBar).toEqual({\r\n      size: 'D10',\r\n      count: 2,\r\n    })\r\n    expect(girders.candidates).not.toHaveLength(0)\r\n    for (const parsedCandidate of girders.candidates) {\r\n      expect(parsedCandidate.widthTie).toEqual({\r\n        size: 'D10',\r\n        pitchMm: 1000,\r\n      })\r\n    }\r\n  })\r\n\r\n  it('parses yokohama ??and 弱뤸쥈 tables on the same page', () => {\r\n    const parsed = parseSectionLists(readPage('yokohama-p13.json'))\r\n    const columns = list(parsed, '?길뼪?㏂꺁?밤깉')\r\n    const smallGirders = list(parsed, '弱뤸쥈??씊?ゃ궧??)\r\n\r\n    expectMarksInclude(columns, [\r\n      'C51',\r\n      'C52',\r\n      'C53',\r\n      'C54',\r\n      'C55',\r\n      'C56',\r\n      'C57',\r\n      'C58',\r\n      'C58A',\r\n    ])\r\n    expect(candidate(columns, 'C51', '2??)).toMatchObject({\r\n      kind: '??,\r\n      b: 800,\r\n      d: 800,\r\n      main: { count: 18, size: 'D25' },\r\n      hoop: { size: 'D13', pitchMm: 100 },\r\n    })\r\n\r\n    const c51First = candidate(columns, 'C51', '1??)\r\n    expect(c51First.main).toEqual({ count: 22, size: 'D25' })\r\n    expect(c51First.hoop).toEqual({ size: 'S13', pitchMm: 100 })\r\n    expect(c51First.raw['HOOP']).toBeUndefined()\r\n    for (const parsedCandidate of columns.candidates) {\r\n      expect(parsedCandidate.widthTie).toBeUndefined()\r\n    }\r\n\r\n    // ?녶숱?긱귞쎍孃꾥쮼?룔걣?귙굥??겎 b횞d ?㎯겘?ゃ걦?닷푶?꿔겏?ㅳ겏?쀣겍閻뷴츣?쇻굥 (ADR-027)\r\n    const c56 = candidate(columns, 'C56', '2??)\r\n    expect(c56.main).toEqual({ count: 12, size: 'D22' })\r\n    expect(c56.shape).toBe('?녶숱')\r\n    expect(c56.b).toBe(600)\r\n    expect(c56.d).toBe(600)\r\n    expect(c56.raw['??씊']).toBeUndefined()\r\n    expect(c56.issues).toHaveLength(0)\r\n    expect(candidate(columns, 'C58A', '1??).main).toEqual({\r\n      count: 26,\r\n      size: 'D25',\r\n    })\r\n\r\n    expectMarksInclude(smallGirders, ['B51'])\r\n    expect(candidate(smallGirders, 'B51').kind).toBe('野얕괌鸚?)\r\n\r\n    // ?뚢뺛띲겘沃?룚鸚길븮?㎯겘?ゃ걦?곥걹??쵂?ラ뀓嶺뗣걣?ゃ걚?ⓦ걚?녶쎋?㏂겗?ㅳ겎?귙굥??\n    const b55 = candidate(smallGirders, 'B55')\r\n    expect(b55.sideBar).toBeUndefined()\r\n    expect(b55.issues).not.toContain('?밭춮鰲ｉ뇠訝띹꺗')\r\n    for (const parsedCandidate of smallGirders.candidates) {\r\n      expect(parsedCandidate.widthTie).toBeUndefined()\r\n    }\r\n  })\r\n\r\n  it('maps position-dependent 鸚㎪쥈 main bars, including asymmetric ends', () => {\n    const parsed = parseSectionLists(readPage('yokohama-p14.json'))\r\n    const girders = list(parsed, '鸚㎪쥈??씊?ゃ궧??)\r\n\r\n    expectMarksInclude(girders, ['G51', 'G54', 'G55', 'G55A'])\r\n\r\n    const g51Roof = candidate(girders, 'G51', 'R??)\r\n    expect(g51Roof).toMatchObject({\r\n      kind: '鸚㎪쥈',\r\n      b: 650,\r\n      depth: 800,\r\n      stirrup: { size: 'D13', pitchMm: 100 },\r\n    })\r\n    expect(g51Roof.girderMain).toEqual({\n      size: 'D25',\n      topCount: 8,\n      bottomCount: 8,\n      asymmetricEnds: {\n        labels: ['鸚뽫ク', '?끿ク'],\n        topCounts: [8, 13],\n        bottomCounts: [8, 11],\n      },\n      cutoffFromSupportFaceMm: 2500,\n    })\n    expect(g51Roof.issues).not.toContain('訝사춮塋?깿藥?뤂?면걬')\n    expect(g51Roof.sideBar).toEqual({ size: 'D10', count: 2 })\r\n\r\n    const cutoffEntries = girders.candidates.flatMap(({ raw }) =>\r\n      Object.entries(raw).filter(([key]) => key.startsWith('?ャ긿?덀궕??)),\r\n    )\r\n    expect(g51Roof.raw['?ャ긿?덀궕???끿ク)']?.normalize('NFKC')).toBe('[2500]')\r\n    expect(cutoffEntries).toHaveLength(6)\r\n    expect(\r\n      cutoffEntries.map(([, value]) => value.normalize('NFKC')).sort(),\r\n    ).toEqual(['[2500]', '[2700]', '[2700]', '[2700]', '[2700]', '[3000]'])\r\n\r\n    expect(candidate(girders, 'G52', 'R??).sideBar).toEqual({\r\n      size: 'D10',\r\n      count: 4,\r\n    })\r\n    expect(girders.candidates).not.toHaveLength(0)\r\n    for (const parsedCandidate of girders.candidates) {\r\n      expect(parsedCandidate.widthTie).toEqual({\r\n        size: 'D10',\r\n        pitchMm: 1000,\r\n      })\r\n    }\r\n\r\n    const g51Second = candidate(girders, 'G51', '2??)\r\n    expect(g51Second.stirrup).toEqual({ size: 'D13', pitchMm: 150 })\r\n    // 訝←ク?뚦릪?ㅳ겗烏ⓦ겘鵝띸쉰?γ겓閻뷴츣?쇻굥 ??訝듾툔?ⓦ굚訝?ㄾ 7?사ク??11\r\n    expect(g51Second.girderMain).toEqual({\r\n      size: 'D25',\r\n      topCount: 7,\r\n      bottomCount: 7,\r\n      endTopCount: 11,\r\n      endBottomCount: 11,\r\n    })\r\n\r\n    expect(candidate(girders, 'G54', 'R??).girderMain).toEqual({\r\n      size: 'D25',\r\n      topCount: 5,\r\n      bottomCount: 5,\r\n    })\r\n    expect(candidate(girders, 'G55A', 'R??)).toMatchObject({\r\n      b: 450,\r\n      depth: 700,\r\n      girderMain: { size: 'D22', topCount: 5, bottomCount: 4 },\r\n    })\r\n    expect(candidate(girders, 'G55', 'R??).girderMain).toEqual({\n      size: 'D25',\n      topCount: 5,\n      bottomCount: 5,\n      asymmetricEnds: {\n        labels: ['Y2塋?, 'Y3塋?],\n        topCounts: [4, 8],\n        bottomCounts: [4, 5],\n      },\n    })\n  })\r\n\r\n  it('keeps a half-width cutoff raw without a position instead of inventing a candidate field', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 300,\r\n      heightPt: 180,\r\n      items: [\r\n        {\r\n          str: '鸚㎪쥈?ゃ궧?덄돶鼇?]?끹겘?ャ긿?덀궕?뺛겗?깁씊?뗣굢???力뺛굮鹽뷩걲??,\r\n          x: 10,\r\n          y: 5,\r\n          w: 220,\r\n          h: 8,\r\n        },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n        { str: '[1500]', x: 120, y: 40, w: 40, h: 8 },\r\n        { str: '??씊', x: 10, y: 60, w: 20, h: 8 },\r\n        { str: '400횞600', x: 120, y: 60, w: 50, h: 8 },\r\n      ],\r\n    })\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.raw['?ャ긿?덀궕??]).toBe('[1500]')\r\n    expect('cutoff' in g1).toBe(false)\r\n  })\r\n\r\n  it.each([\r\n    ['ojkk-p3.json', '鸚㎪쥈?ゃ궧??],\r\n    ['kani-p38.json', '?겻릎歟곥꺁?밤깉'],\r\n  ])('%s has no ?ャ긿?덀궕??raw values', (fixture, listKind) => {\r\n    const parsedList = list(parseSectionLists(readPage(fixture)), listKind)\r\n\r\n    for (const parsedCandidate of parsedList.candidates) {\r\n      expect(\r\n        Object.keys(parsedCandidate.raw).some((key) =>\r\n          key.startsWith('?ャ긿?덀궕??),\r\n        ),\r\n      ).toBe(false)\r\n    }\r\n  })\r\n\r\n  it('parses the vertical kani ?겻릎歟곥꺁?밤깉 and tolerates an empty ?밭춮 cell', () => {\r\n    const parsed = parseSectionLists(readPage('kani-p38.json'))\r\n    const foundationGirders = list(parsed, '?겻릎歟곥꺁?밤깉')\r\n\r\n    expectMarksInclude(foundationGirders, ['FG1'])\r\n    const fg1 = candidate(foundationGirders, 'FG1')\r\n    expect(fg1).toMatchObject({\r\n      kind: '野얕괌鸚?,\r\n      mark: 'FG1',\r\n      b: 300,\r\n      depth: 500,\r\n      girderMain: { size: 'D19', topCount: 3, bottomCount: 3 },\r\n      stirrup: { size: 'D10', pitchMm: 200 },\r\n    })\r\n    expect(fg1.sideBar).toBeUndefined()\r\n    expect(fg1.widthTie).toBeUndefined()\r\n    expect(fg1.issues).not.toContain('?밭춮鰲ｉ뇠訝띹꺗')\r\n    expect(fg1.raw['?밭춮']).toBeUndefined()\r\n  })\r\n\r\n  it('keeps an unexpected ?밭춮 cell raw instead of inventing a value', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 300,\r\n      heightPt: 180,\r\n      items: [\r\n        { str: '鸚㎪쥈?ゃ궧??, x: 10, y: 5, w: 60, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n        { str: '?밭춮', x: 10, y: 50, w: 20, h: 8 },\r\n        { str: '2-K13', x: 125, y: 50, w: 36, h: 8 },\r\n      ],\r\n    })\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.sideBar).toBeUndefined()\r\n    expect(g1.raw['?밭춮']).toBe('2-K13')\r\n    expect(g1.issues).toContain('?밭춮鰲ｉ뇠訝띹꺗')\r\n  })\r\n\r\n  it('separates a three-digit 亮끾??곭춮 pitch from the next numbered title item', () => {\r\n    const parsed = parseSectionLists(\r\n      titlePage(\r\n        '鸚㎪쥈?ゃ궧?덄돶鼇섅겒?띺솏??.藥얏?嶺딡10-@5002.訝?릨?딁춮?쀣걨嶺딡10-@1000',\r\n        'G1',\r\n      ),\r\n    )\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 500 })\r\n  })\r\n\r\n  it.each([\r\n    {\r\n      fixture: 'ojkk-p3',\r\n      title: '鸚㎪쥈?ゃ궧?댿삣퉭閭®춮?츯10@1000?ⓦ걲??,\r\n      listKind: '鸚㎪쥈?ゃ궧??,\r\n      mark: 'G1',\r\n      expected: { size: 'D10', pitchMm: 1000 },\r\n    },\r\n    {\r\n      fixture: 'yokohama-p14',\r\n      title:\r\n        '鸚㎪쥈??씊?ゃ궧?덄돶鼇섅겒?띺솏??.藥얏?嶺딡10-@10002.訝?릨?딁춮?쀣걨嶺딡10-@10003.竊삼섹?끹겘節띰쉴絶꾬슉絶뚣겗?깁씊?뗣굢???力뺛굮鹽뷩걲??,\r\n      listKind: '鸚㎪쥈??씊?ゃ궧??,\r\n      mark: 'G1',\r\n      expected: { size: 'D10', pitchMm: 1000 },\r\n    },\r\n    {\r\n      fixture: 'yokohama-p13 ??,\r\n      title:\r\n        '?길뼪?㏂꺁?밤깉1/30?배쮼?ゃ걤?먦굤1.藥얏?嶺딡10-@5002.S13?츺SS785?믥ㅊ?쇻?.HOOP???,\r\n      listKind: '?길뼪?㏂꺁?밤깉',\r\n      mark: 'C1',\r\n      expected: undefined,\r\n    },\r\n    {\r\n      fixture: 'yokohama-p13 弱뤸쥈',\r\n      title:\r\n        '弱뤸쥈??씊?ゃ궧??/30?배쮼?ゃ걤?먦굤1.藥얏?嶺딡10-@10002.訝?릨?딁춮?쀣걨嶺딡10-@1000',\r\n      listKind: '弱뤸쥈??씊?ゃ궧??,\r\n      mark: 'B1',\r\n      expected: undefined,\r\n    },\r\n  ])('reads the restored $fixture title without crossing item boundaries', ({\r\n    title,\r\n    listKind,\r\n    mark,\r\n    expected,\r\n  }) => {\r\n    const parsedCandidate = candidate(\r\n      list(parseSectionLists(titlePage(title, mark)), listKind),\r\n      mark,\r\n    )\r\n\r\n    expect(parsedCandidate.widthTie).toEqual(expected)\r\n  })\r\n\r\n  it('recognizes a two-digit next item number only after splitting sequential items', () => {\r\n    const title =\r\n      '鸚㎪쥈?ゃ궧?덄돶鼇섅겒?띺솏??.a2.b3.c4.d5.e6.f7.g8.h9.藥얏?嶺딡10-@50010.訝?릨?딁춮'\r\n    const g1 = candidate(\r\n      list(parseSectionLists(titlePage(title, 'G1')), '鸚㎪쥈?ゃ궧??),\r\n      'G1',\r\n    )\r\n\r\n    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 500 })\r\n  })\r\n\r\n  it('keeps an unbounded 亮끾??곭춮 title item raw with an issue', () => {\r\n    const parsed = parseSectionLists(\r\n      titlePage(\r\n        '鸚㎪쥈?ゃ궧?덄돶鼇섇퉭閭㏂굙嶺딡10-@1000訝?릨?딁춮?쀣걨嶺딡13-@200',\r\n        'G1',\r\n      ),\r\n    )\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.widthTie).toBeUndefined()\r\n    expect(g1.raw['亮끾?嶺?]).toBe(\r\n      '亮끾??곭춮D10-@1000訝?릨?딁춮?쀣걨嶺딡13-@200',\r\n    )\r\n    expect(g1.issues).toContain('亮끾??곭춮鰲ｉ뇠訝띹꺗')\r\n  })\r\n\r\n  it('keeps the pre-phase-7 numeric pitch limit for table cells', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 300,\r\n      heightPt: 180,\r\n      items: [\r\n        { str: '鸚㎪쥈?ゃ궧??, x: 10, y: 5, w: 60, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n        { str: 'ST', x: 10, y: 40, w: 20, h: 8 },\r\n        { str: 'D13@0100', x: 120, y: 40, w: 50, h: 8 },\r\n      ],\r\n    })\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.stirrup).toEqual({ size: 'D13', pitchMm: 100 })\r\n  })\r\n\r\n})\r\n\r\n// ?? ?꾩궗 ?쎌뒪泥???? ?議?????????????????????????????????????????????????\r\n// expected/*.json? ?꾨㈃???덉쑝濡??쎌뼱 ?곸? ?먮Ц ?낅┰ ?꾩궗??(ADR-010).\r\n// 洹쒖튃: ?뚯꽌媛 ?뺤젙??媛믪? ?꾩궗? ?쇱튂?댁빞 ?섍퀬(吏?대궡湲?寃異?, ?뺤젙?섏? ?딆?\r\n// 移몄? raw ?먮Ц???꾩궗? 紐⑥닚?섎㈃ ???쒕떎. ?대뒓 移몄쓣 ?뺤젙?좎????뚯꽌 ?뺤콉?대?濡?\n// 媛믪씠 ?꾨땲???뺤젙 移??섎? ??쇰줈 諛뺤븘 ???誘명솗???뚭?瑜?留됰뒗??\r\n\r\ninterface ExpectedColumnCell {\r\n  b?: number\r\n  d?: number\r\n  /** ?녶숱??씊??쎍孃꾠괷?팪 ??빰?뤵굤?ャ걪?뚣굮?곥겇 (ADR-027) */\r\n  ?닷푶?: number\r\n  ??씊raw?: string\r\n  訝사춮: string | Record<string, string>\r\n  躍?춮?: string\r\n  HOOP?: string\r\n}\r\n\r\ninterface ExpectedColumnsDoc {\r\n  entries: Array<{ mark: string; stories: Record<string, ExpectedColumnCell> }>\r\n}\r\n\r\n/** 烏??쇰꺼? ?꾨㈃留덈떎 ?ㅻⅤ?????꾩궗??洹??꾨㈃????留먯쓣 洹몃?濡??곷뒗??*/\r\ninterface GirderLabels {\r\n  top: string\r\n  bottom: string\r\n  stirrup: string\r\n}\r\n\r\ntype ExpectedGirderCell = Record<string, unknown> & {\r\n  b: number\r\n  depth: number\r\n}\r\n\r\ninterface ExpectedGirdersDoc {\r\n  entries: Array<{ mark: string; stories: Record<string, ExpectedGirderCell> }>\r\n}\r\n\r\ninterface ExpectedKaniEntry {\r\n  mark: string\r\n  b: number\r\n  depth: number\r\n  訝딁ク嶺? string\r\n  訝뗧ク嶺? string\r\n  STP: string\r\n}\r\n\r\ninterface ExpectedWallEntry {\r\n  mark: string\r\n  thickness?: number\r\n  ??씊raw?: string\r\n  潁?춮: string\r\n  與ょ춮: string\r\n}\r\n\r\ninterface ExpectedSlabEntry {\r\n  mark: string\r\n  thickness: number\r\n  訝딁ク嶺?: Record<string, string>\r\n  訝뗧ク嶺?: Record<string, string>\r\n  訝딁춮?: Record<string, string>\r\n  訝뗧춮?: Record<string, string>\r\n}\r\n\r\ninterface ExpectedList {\r\n  listKind: string\r\n  scope?: string\r\n  entries?: Array<{ mark: string }>\r\n  outOfScopeMarks?: string[]\r\n  marks?: string[]\r\n}\r\n\r\ninterface ExpectedWallSlabDoc {\r\n  lists: Array<ExpectedList & {\r\n    entries?: Array<ExpectedWallEntry | ExpectedSlabEntry>\r\n  }>\r\n}\r\n\r\n/** ?똃13-@100?띉룔똃10@200???쒓린 李⑤? ?≪닔?쒕떎 ???섏씠?덉? ?μ떇?대떎 */\r\nfunction normPitch(text: string): string {\r\n  return text.replace('-@', '@')\r\n}\r\n\r\nfunction sweepColumns(\r\n  pageFile: string,\r\n  expectedFile: string,\r\n  listKind: string,\r\n): { main: number; hoop: number; dimension: number } {\r\n  const doc = readExpected<ExpectedColumnsDoc>(expectedFile)\r\n  const columns = list(parseSectionLists(readPage(pageFile)), listKind)\r\n  const counts = { main: 0, hoop: 0, dimension: 0 }\r\n\r\n  for (const entry of doc.entries) {\r\n    for (const [story, cell] of Object.entries(entry.stories)) {\r\n      const c = candidate(columns, entry.mark, story)\r\n      const label = `${entry.mark}/${story}`\r\n\r\n      if (c.b !== undefined) {\r\n        // ?녶숱??b횞d ?㎯겘?ゃ걦?닷푶?꿔겏?ㅳ귟빪?쇿겢?귙?00??띲굮?닷푶 600 ?②き?\r\n        if (cell.?닷푶 !== undefined) {\r\n          expect(c.shape, label).toBe('?녶숱')\r\n          expect(c.b, label).toBe(cell.?닷푶)\r\n          expect(c.d, label).toBe(cell.?닷푶)\r\n        } else {\r\n          expect(c.shape, label).toBe('?⒴숱')\r\n          expect(c.b, label).toBe(cell.b)\r\n          expect(c.d, label).toBe(cell.d)\r\n        }\r\n        counts.dimension += 1\r\n      }\r\n      if (cell.??씊raw !== undefined && c.raw['??씊'] !== undefined) {\r\n        expect(c.raw['??씊'], label).toBe(cell.??씊raw)\r\n      }\r\n\r\n      const mainCells =\r\n        typeof cell.訝사춮 === 'string' ? { ?ⓩ뼪?? cell.訝사춮 } : cell.訝사춮\r\n      if (c.main) {\r\n        for (const text of Object.values(mainCells)) {\r\n          expect(`${c.main.count}-${c.main.size}`, label).toBe(text)\r\n        }\r\n        counts.main += 1\r\n      } else {\r\n        for (const [position, text] of Object.entries(mainCells)) {\r\n          const raw = c.raw[`訝사춮(${position})`] ?? c.raw['訝사춮']\r\n          if (raw !== undefined) expect(raw, label).toBe(text)\r\n        }\r\n      }\r\n\r\n      const hoopText = cell.躍?춮 ?? cell.HOOP\r\n      if (hoopText !== undefined) {\r\n        if (c.hoop) {\r\n          expect(`${c.hoop.size}@${c.hoop.pitchMm}`, label).toBe(\r\n            normPitch(hoopText),\r\n          )\r\n          counts.hoop += 1\r\n        } else {\r\n          const raw = c.raw['躍?춮'] ?? c.raw['HOOP']\r\n          if (raw !== undefined) {\r\n            expect(normPitch(raw), label).toBe(normPitch(hoopText))\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  return counts\r\n}\r\n\r\n/**\r\n * 邕℡넍??꺖??퐤營?릫?귟〃??릎鸚?쵂?믢??ㅳ걮?뗦똻?잆겒?꾠겗?㎯곦릎鸚?겎?ゃ걨?뚣겙塋?깿?졼?\n * ?뚯꽌??遺꾨쪟湲곕? ?곗? ?딄퀬 ?뚯뒪?멸? ?곕줈 ?먯젙?쒕떎 (ADR-010).\r\n */\r\nfunction isCenterPosition(position: string): boolean {\r\n  return position.includes('訝?ㄾ')\r\n}\r\n\r\nfunction sweepGirders(\r\n  pageFile: string,\r\n  expectedFile: string,\r\n  listKind: string,\r\n  labels: GirderLabels,\r\n): { main: number; stirrup: number; dimension: number } {\r\n  const doc = readExpected<ExpectedGirdersDoc>(expectedFile)\r\n  const girders = list(parseSectionLists(readPage(pageFile)), listKind)\r\n  const counts = { main: 0, stirrup: 0, dimension: 0 }\r\n\r\n  for (const entry of doc.entries) {\r\n    for (const [story, cell] of Object.entries(entry.stories)) {\r\n      const c = candidate(girders, entry.mark, story)\r\n      const label = `${entry.mark}/${story}`\r\n      const topCellsRaw = cell[labels.top]\r\n      const bottomCellsRaw = cell[labels.bottom]\r\n      expect(topCellsRaw, `${label} ${labels.top} fixture key missing`).toBeDefined()\r\n      expect(\r\n        bottomCellsRaw,\r\n        `${label} ${labels.bottom} fixture key missing`,\r\n      ).toBeDefined()\r\n      const topCells = topCellsRaw as Record<string, string>\r\n      const bottomCells = bottomCellsRaw as Record<string, string>\r\n      const stirrupText = cell[labels.stirrup] as string\r\n\r\n      if (c.b !== undefined) {\r\n        expect(c.b, label).toBe(cell.b)\r\n        expect(c.depth, label).toBe(cell.depth)\r\n        counts.dimension += 1\r\n      }\r\n      if (c.girderMain) {\n        // 鵝띸쉰?γ겓閻뷴츣?쀣걼?숃짒??곦퐤營?걫?ⓦ겓邕℡넍?①챳?띶릦?뤵걵????塋?깿??ㅳ굮訝?ㄾ??        // ?γ굦?잌숃짒??뚨▶若싥걮?잆띲겲?얇걪?볝굮?싥겂?╉걮?얇걝\n        const {\n          size,\n          topCount,\n          bottomCount,\n          endTopCount,\n          endBottomCount,\n          asymmetricEnds,\n        } = c.girderMain\n        if (asymmetricEnds) {\n          const endpointPositions = Object.keys(topCells).filter(\n            (position) => !isCenterPosition(position),\n          )\n          expect(asymmetricEnds.labels, `${label} endpoint labels`).toEqual(\n            endpointPositions,\n          )\n          if (asymmetricEnds.topCounts) {\n            expect(\n              asymmetricEnds.topCounts,\n              `${label} ${labels.top} endpoint counts`,\n            ).toEqual(\n              endpointPositions.map((position) =>\n                Number(topCells[position]?.split('-')[0]),\n              ),\n            )\n          }\n          if (asymmetricEnds.bottomCounts) {\n            expect(\n              asymmetricEnds.bottomCounts,\n              `${label} ${labels.bottom} endpoint counts`,\n            ).toEqual(\n              endpointPositions.map((position) =>\n                Number(bottomCells[position]?.split('-')[0]),\n              ),\n            )\n          }\n        }\n        for (const [position, text] of Object.entries(topCells)) {\n          const endIndex = asymmetricEnds?.labels.indexOf(position) ?? -1\n          const count = isCenterPosition(position)\n            ? topCount\n            : endIndex >= 0\n              ? (asymmetricEnds?.topCounts?.[endIndex] ?? endTopCount ?? topCount)\n              : (endTopCount ?? topCount)\n          expect(`${count}-${size}`, `${label} ${labels.top}(${position})`).toBe(\n            text,\n          )\n        }\n        for (const [position, text] of Object.entries(bottomCells)) {\n          const endIndex = asymmetricEnds?.labels.indexOf(position) ?? -1\n          const count = isCenterPosition(position)\n            ? bottomCount\n            : endIndex >= 0\n              ? (asymmetricEnds?.bottomCounts?.[endIndex] ??\n                endBottomCount ??\n                bottomCount)\n              : (endBottomCount ?? bottomCount)\n          expect(\r\n            `${count}-${size}`,\r\n            `${label} ${labels.bottom}(${position})`,\r\n          ).toBe(text)\r\n        }\r\n        counts.main += 1\r\n      } else {\r\n        for (const [position, text] of Object.entries(topCells)) {\r\n          const raw = c.raw[`${labels.top}(${position})`]\r\n          expect(raw, `${label} ${labels.top}(${position}) ?먮Ц ?뚯떎`).toBeDefined()\r\n          expect(raw, label).toBe(text)\r\n        }\r\n        for (const [position, text] of Object.entries(bottomCells)) {\r\n          const raw = c.raw[`${labels.bottom}(${position})`]\r\n          expect(\r\n            raw,\r\n            `${label} ${labels.bottom}(${position}) ?먮Ц ?뚯떎`,\r\n          ).toBeDefined()\r\n          expect(raw, label).toBe(text)\r\n        }\r\n      }\r\n      if (c.stirrup) {\r\n        expect(`${c.stirrup.size}@${c.stirrup.pitchMm}`, label).toBe(\r\n          normPitch(stirrupText),\r\n        )\r\n        counts.stirrup += 1\r\n      } else if (c.raw[labels.stirrup] !== undefined) {\r\n        expect(normPitch(c.raw[labels.stirrup]), label).toBe(\r\n          normPitch(stirrupText),\r\n        )\r\n      }\r\n    }\r\n  }\r\n\r\n  return counts\r\n}\r\n\r\ndescribe('?꾩궗 ?쎌뒪泥???? ?議?(ADR-010)', () => {\r\n  it('ojkk ?긱꺁?밤깉 ??19移?(鵝띸쉰 2?됀룟릭嶺뗭쓽 怨좉컯??K13 ?ы븿 ??移??뺤젙)', () => {\r\n    expect(\r\n      sweepColumns('ojkk-p2.json', 'ojkk-akamichi-p2-columns.json', '?긱꺁?밤깉'),\r\n      // K13 3移?C2 1F쨌C2A 2F쨌C2A 1F)??ADR-026濡??뺤젙?섏뼱 躍?춮????移?李쇰떎.\r\n      // ??씊? ?쇰꺼 ?됱씠 ?놁?留??ㅼ?移섏쓽 媛濡쑣룹꽭濡?移섏닔瑜?吏앹?????移??뺤젙 ??\n      // 媛믪? ?꾩궗(700횞700쨌FC1 600횞600)? ?議곕맂??\n    ).toEqual({ main: 19, hoop: 19, dimension: 19 })\r\n  })\r\n\r\n  it('yokohama ?길뼪?㏂꺁?밤깉 ??15移?(??씊 ?쇰꺼 ?됀룝퐤營??놁쓬쨌S13쨌600? ??移??뺤젙)', () => {\r\n    expect(\r\n      sweepColumns(\r\n        'yokohama-p13.json',\r\n        'yokohama-kanazawa-p13-columns.json',\r\n        '?길뼪?㏂꺁?밤깉',\r\n      ),\r\n      // S13 4移몄? ADR-026濡? 600?(C56)??ADR-027?쇰줈 ?뺤젙?섏뼱 ??移몄씠 李쇰떎\r\n    ).toEqual({ main: 15, hoop: 15, dimension: 15 })\r\n  })\r\n\r\n  it('yokohama 鸚㎪쥈??씊?ゃ궧?????꾩궗遺?5移?(鵝띸쉰蹂??곸씠 訝사춮 ?ы븿)', () => {\r\n    expect(\r\n      sweepGirders(\r\n        'yokohama-p14.json',\r\n        'yokohama-kanazawa-p14-girders.json',\r\n        '鸚㎪쥈??씊?ゃ궧??,\r\n        { top: '訝딁춮', bottom: '訝뗧춮', stirrup: 'ST' },\r\n      ),\r\n      // 塋?깿媛 醫뚯슦 ?숆컪??1移?G51 2??? 湲곗〈 ?移??꾨뱶濡? ?섎㉧吏 2移?      // (G51 R??鸚뽫ク8/?끿ク13, G55 R??? ?먮Ц ?쇰꺼怨?醫뚯슦 蹂몄닔瑜?      // asymmetricEnds濡??뺤젙?쒕떎. 諛⑺뼢 寃곗젙? ?ㅼ쓬 痍⑥엯 ?④퀎??梨낆엫?대떎\n    ).toEqual({ main: 5, stirrup: 5, dimension: 5 })\n  })\n\r\n  it('ojkk 鸚㎪쥈?ゃ궧????32移?(??씊 ?쇰꺼 ???놁쓬쨌2F?먮쭔 G1A쨌G2A)', () => {\r\n    expect(\r\n      sweepGirders(\r\n        'ojkk-p3.json',\r\n        'ojkk-akamichi-p3-girders.json',\r\n        '鸚㎪쥈?ゃ궧??,\r\n        { top: '訝딁ク嶺?, bottom: '訝뗧ク嶺?, stirrup: '?귙겙?됬춮' },\r\n      ),\r\n      // ??씊? ?쇰꺼 ?됱씠 ?놁?留??ㅼ?移섏쓽 媛濡?塋?깿 ?꾨옒)쨌?몃줈(訝?ㄾ ?ㅻⅨ履? 移섏닔瑜?\n      // 吏앹?????移??뺤젙 ???뺤궗媛곹삎???꾨땲??媛濡쒋넂b쨌?몃줈?뭗epth ??묎퉴吏 ?議곕맂??\r\n      // 訝사춮? 塋?깿? 訝?ㄾ???ㅻⅨ 17移몃룄 鵝띸쉰?λ줈 ?뺤젙????移몄씠 李쇰떎 ??\n      // ?쒓? 塋?깿/訝?ㄾ ???대쭔 ?곕?濡?醫뚯슦 諛⑺뼢???뺥븷 ?꾩슂媛 ?녿떎\r\n    ).toEqual({ main: 32, 