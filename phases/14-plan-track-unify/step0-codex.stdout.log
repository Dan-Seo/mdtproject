      },\n    ])\n  })\n\n  it('?먰쉶洹 媛??? ?좎“ 0嫄??낅┰ 由щ럭 ?뵶1)?몑okohama-p14 X??援ш컙 ??移섏닔媛 ?뺥솗??1媛쒖씤?곕룄 寃⑹옄瑜?留뚮뱾吏 ?딅뒗??, () => {\n    // yokohama-p14 X????씊?ゃ궧?덉쓽 寧?뤇 X2?팞3媛 ?싥굤???쇰꺼濡??ㅼ씤?섍퀬,\n    // 洹??ъ씠 援ш컙??野멩퀡 ?꾨낫媛 ?뺥솗???섎굹(900)留??덈떎 ???쇰꺼 2媛??ㅽ뙩 1蹂?\n    // 異뺤쓽 ?ㅼ륫 ?щ??? writtenAsTotal 媛???덅쮫???ㅽ뙩怨??ㅻⅨ ??蹂몄씠?댁빞\n    // ?쒕떎)留뚯쑝濡쒕뒗 ??異뺤쓣 紐?留됰뒗?ㅻ뒗 寃껋씠 ?낅┰ 由щ럭??吏?곸씠?덈떎: ?곗뿰??    // ?섏씠吏??900???좎씪媛믪씠??留됲삍??肉? ?ㅻⅨ 怨녹뿉 900????踰????덉뿀?ㅻ㈃\n    // ?똛2~X3 ??900mm?띾씪???꾨㈃???녿뒗 寃⑹옄媛 issues:[] 濡??깅┰?덉쓣 寃껋씠??\n    // 吏湲덉? ?쇰꺼 2媛??ㅽ뙩 1蹂? ?먯껜瑜??곗씠?곗? 臾닿??섍쾶 嫄곗젅?섎?濡??븅뼋?겻툖擁?\n    // ??異뺤? ?대뼡 寃쎌슦?먮룄 媛믪쓣 ?댁? ?딅뒗??\n    const [x] = parseGrid(readItems('yokohama-p14.json'))\n\n    expect(x.axis).toBe('X')\n    expect(x.labels.map((label) => label.label)).toEqual(['X2', 'X3'])\n    expect(x.issues).toEqual(['?븅뼋?겻툖擁?])\n    expect(x.spansMm).toEqual([])\n    expect(x.totalMm).toBeNull()\n  })\n\n  it('?먰쉶洹 媛??? ?뚯꽌 異쒕젰 ?좊옒. 若잍릍 怨⑤뱺???꾨땲?ㅳ멾ani-p38?먯꽌 ??異???寃⑹옄媛 ?섎굹濡??뺥빐吏꾨떎', () => {\n    // ????媛?쒖? 媛숈? ?깃꺽(?뚯꽌 異쒕젰 ?좊옒)?닿퀬, ?ш린??吏?ㅻ뒗 寃껋?\n    // **?꾨낫 38쨌52嫄댁뿉???닿? ?뺥솗???섎굹濡?醫곹?吏꾨떎**???ъ떎?대떎.\n    // ?섎굹?쇰룄 ???섏삤硫?`野멩퀡永꾢릦?쎽툖若????섏뼱 媛믪씠 ???섏삩????利???媛?쒕뒗\n    // ?뚥퐤營?援ш컙 竊??덅쮫????寃뱀씠 ?ㅻ룄硫댁뿉???ㅼ젣濡??좎씪?대? 留뚮뱺?ㅻ뒗\n    // ADR-031????二쇱옣??遺숈옟?붾떎.\n    expect(parseGrid(readItems('kani-p38.json'))).toMatchObject([\n      {\n        axis: 'X',\n        spansMm: [6000, 6000, 8000],\n        totalMm: 20000,\n        issues: [],\n      },\n      {\n        axis: 'Y',\n        spansMm: [6000, 10500],\n        totalMm: 16500,\n        issues: [],\n      },\n    ])\n  })\n})\n\r\n--- deleted unit test head/tail ---\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport {\r\n  axisLabels,\r\n  dimensionTexts,\r\n  parseGrid,\r\n} from '@/lib/import/plan/grid-parse'\r\nimport type { GridCandidate } from '@/lib/import/plan/types'\r\nimport type { TextItem } from '@/lib/import/types'\r\n\r\nconst glyph = (str: string, x: number, y: number, h = 8): TextItem => ({\r\n  str,\r\n