       role: '渦?,\r\n 170:       ix: 0,\r\n 171:       iy: 2,\r\n 172:       axis: 'Y',\r\n 173:     })\r\n 174:   })\r\n 175: \r\n 176:   it('遺?몃뒗 ?꾨㈃???덈뒗 留뚰겮留??섏삤怨?吏?대궡吏 ?딅뒗??, () => {\r\n 177:     // 弱뤸쥈?쇰줈 ?섍쾶 ?섎돏 移??덉쓽 ?ㅳ꺀?뼿룟컦歟?遺?몃뒗 訝??듐굤??뿉 遺숈? ?딅뒗????\r\n 178:     // ?쒗뭹??弱뤸쥈??紐⑤뜽留곹븯吏 ?딆쑝誘濡?ADR-005) 遺숈씪 ?먮━ ?먯껜媛 ?녿떎\r\n 179:     for (const block of parsed.blocks) {\r\n 180:       expect(block.placements.length).toBeGreaterThan(0)\r\n 181:       for (const placement of block.placements) {\r\n 182:         expect(placement.ix).toBeGreaterThanOrEqual(0)\r\n 183:         expect(placement.ix).toBeLessThan(block.xGrid.axes.length)\r\n 184:         expect(placement.iy).toBeGreaterThanOrEqual(0)\r\n 185:         expect(placement.iy).toBeLessThan(block.yGrid.axes.length)\r\n 186:         if (placement.role === '渦? && placement.axis === 'X') {\r\n 187:           expect(placement.ix).toBeLessThan(block.xGrid.axes.length - 1)\r\n 188:         }\r\n 189:         if (placement.role === '渦? && placement.axis === 'Y') {\r\n 190:           expect(placement.iy).toBeLessThan(block.yGrid.axes.length - 1)\r\n 191:         }\r\n 192:       }\r\n 193:     }\r\n 194:   })\r\n 195: })\r\n--- framing types ---\r\n/**\r\n * ???鍮덉뭏?쇰줈 ?④릿 ?ъ쑀 肄붾뱶 (section-list??CANDIDATE_ISSUES ?⑦꽩).\r\n * ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎.\r\n */\r\nexport const PLAN_GRID_ISSUES = [\r\n  '?싥굤??꺀?쇻꺂?ゆ쩂??,\r\n  '野멩퀡轝좄맼',\r\n  '潁?갰訝띷빐??,\r\n  '?덅쮫訝띴???,\r\n  '?⒲깧?ユ뻼耶쀦렁??,\r\n  '?싥굤???恙쒍툖??,\r\n] as const\r\n\r\nexport type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\n\r\n/** 鴉뤷쎋?먯꽌 ?쎌? ?싥굤????蹂? positionPt???꾨㈃ 醫뚰몴(pt) ??遺???ㅻ깄??湲곗?. */\r\nexport interface AxisCandidate {\r\n  label: string\r\n  positionPt: number\r\n}\r\n\r\n/** ??諛⑺뼢(X ?먮뒗 Y)???싥굤?????꾨낫. ?뱀씤 ?꾩뿉???뺤긽???섏? ?딅뒗??(ADR-030). */\r\nexport interface PlanGridCandidate {\r\n  /** ?쇰꺼??異?臾몄옄 ??諛대뱶??湲고븯 諛⑺뼢???꾨땲???꾨㈃??遺숈씤 ?대쫫???곕Ⅸ??*/\r\n  direction: 'X' | 'Y'\r\n  /** ?꾩튂 ?ㅻ쫫李⑥닚 */\r\n  axes: AxisCandidate[]\r\n  /** ?몄젒 異??ъ씠 移섏닔(mm). 湲몄씠??axes.length - 1 */\r\n  spansMm: number[]\r\n  /** ?ㅼ륫 異뺤쿃(pt/mm) ?????ㅽ뙩 ?ㅼ륫??以묒븰媛? ?쒓린 異뺤쿃? ?⑹? ?섏〈?대씪 誘우? ?딅뒗??*/\r\n  scalePtPerMm: number\r\n  /** ?꾨㈃???꾩껜 移섏닔媛 紐낃린???덇퀬 ?ㅽ뙩 ?⑷낵 ?쇱튂?덈떎 */\r\n  totalConfirmed: boolean\r\n}\r\n\r\n/**\r\n * 遺?멸? 洹몃━?쒖쓽 ?대뵒???볦??붽? ???꾨㈃?먯꽌 ??**湲고븯**留?留먰븳??\r\n *\r\n * ?똂硫??긱띿쿂??遺???묐몢濡?遺??醫낅퀎???뺥븯吏 ?딅뒗?? 醫낅퀎? ??씊?ゃ궧?덇?\r\n * ?대? 媛뽮퀬 ?덉쑝誘濡?ADR-018), 痍⑥엯??洹?醫낅퀎怨???湲고븯瑜?留욎떠 蹂몃떎 ??\n * ?닿툔?섎㈃ ?щ엺???먮떒???쇱씠吏 ?뚯꽌媛 怨좊? ?쇱씠 ?꾨땲??\r\n */\r\nexport const PLAN_PLACEMENT_ROLES = ['?쇔춴??, '渦?, '?쇻궎'] as const\r\n\r\nexport type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\r\n\r\nexport type MemberPlacement =\r\n  | { mark: string; role: '?쇔춴?? | '?쇻궎'; ix: number; iy: number }\r\n  | {\r\n      mark: string\r\n      role: '渦?\r\n      /** 遺?ш? ?쒖옉?섎뒗 寃⑹옄??*/\r\n      ix: number\r\n      iy: number\r\n      /** 遺?ш? 六쀫뒗 諛⑺뼢 (GirderPosition.axis? 媛숈? ?? */\r\n      axis: 'X' | 'Y'\r\n    }\r\n\r\n/**\r\n * ?꾨㈃ ?꾩쓽 鴉뤷쎋 ???? ???섏씠吏???щ윭 ?μ씠 ?ㅻ━誘濡??ㅻЪ yokohama p7?\r\n * 2?롥틞鴉뤷쎋? R?롥틞鴉뤷쎋 ???? ?싥굤???뺤쓽媛 媛숈븘??**?꾩튂媛 ?ㅻⅤ??* ??\n * 洹몃━???뺤쓽???묓엳吏留?釉붾줉? ?묓엳吏 ?딅뒗??\r\n */\r\nexport interface PlanBlock {\r\n  /** 釉붾줉 ?쒕ぉ ?먮Ц(???롥틞鴉뤷쎋1/100??. ?대뒓 Story?몄????щ엺???뺥븳??*/\r\n  title?: string\r\n  /** ??釉붾줉怨?吏앹??댁쭊 X쨌Y ?싥굤???뺤쓽. 痍⑥엯? 諛섎뱶?????섏쓣 ?대떎 */\r\n  xGrid: PlanGridCandidate\r\n  yGrid: PlanGridCandidate\r\n  placements: MemberPlacement[]\r\n  /** 釉붾줉 ?덉뿉 ?덉쑝???ㅻ깄?섏? 紐삵븳 遺??以묐났 ?놁쓬, ?먮Ц ?? ??吏?대궡吏 ?딅뒗??*/\r\n  unplacedMarks: string[]\r\n}\r\n\r\nexport interface ParsedFramingPlan {\r\n  /** ?싥굤???뺤쓽 ??媛숈? 洹몃━?쒓? ?щ윭 釉붾줉??諛섎났?섎㈃ ?섎굹濡??묓엺??*/\r\n  grids: PlanGridCandidate[]\r\n  blocks: PlanBlock[]\r\n  /** ?꾨낫瑜?紐????ъ쑀 ??泥??깆옣 ?? 以묐났 ?놁쓬 */\r\n  issues: PlanGridIssue[]\r\n}\r\n\r\n/** 邕며탡?녹뿉??怨꾩뿴??紐????ъ쑀. ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎 */\r\nexport const ELEVATION_ISSUES = ['野멩퀡?쀦쑋濾쒎눣'] as const\r\n\r\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\r\n\r\nexport interface ElevationLevel {\r\n  /** 洹??믪씠???곹엺 ?쇰꺼 ?먮Ц ?꾨?. ?놁쑝硫?鍮?諛곗뿴 ??吏?대궡吏 ?딅뒗??*/\r\n  labels: string[]\r\n  positionPt: number\r\n}\r\n\r\n/**\r\n * 邕며탡????怨꾩뿴???믪씠 諛⑺뼢 ?쎄린. ?뚯뼱???덈꺼??Story??寃쎄퀎?멸??띾뒗 ?뺥븯吏\r\n * ?딅뒗?????먮Ц?먮뒗 FL쨌GL쨌?븀쨴訝뗧ク쨌RCL???욎뿬 ?덇퀬, 洹몄쨷 臾댁뾿???롮씤吏??\n * 議곕Ц???꾨땲???ㅺ퀎 ?섎룄???щ엺???쎌쓣 ?쇱씠??(ADR-030).\r\n *\r\n * ?싥굤??낵 ?щ━ ?쇰꺼??醫뚯슦 ?뺣젹???쇱젙?섏? ?딆븘(?ㅻЪ p8??醫뚮떒 x??108~198濡?\n * ?⑹뼱吏꾨떎) ?쇰꺼 諛대뱶瑜??듭빱濡??????녿떎. ?듭빱??**移섏닔 ??*?닿퀬, 移섏닔媛 ?먭린\r\n * 援ш컙??以묒젏???볦씤?ㅻ뒗 愿怨꾨줈 異뺤쿃怨??덈꺼 ?꾩튂瑜??④퍡 ?쇰떎.\r\n */\r\nexport interface ElevationCandidate {\r\n  /** ??怨꾩뿴??嫄몃━??邕며탡???쒕ぉ???먮Ц). ??怨꾩뿴???щ윭 ?싥굤??怨듯넻?쇰줈 嫄몃┛??*/\r\n  titles: string[]\r\n  /** ?꾨㈃ 醫뚰몴 ?????꾩뿉???꾨옒濡?*/\r\n  levels: ElevationLevel[]\r\n  /** ?몄젒 ?덈꺼 ?ъ씠 移섏닔(mm). 湲몄씠??levels.length - 1 */\r\n  heightsMm: number[]\r\n  scalePtPerMm: number\r\n}\r\n\r\nexport interface ParsedFrameElevations {\r\n  elevations: ElevationCandidate[]\r\n  issues: ElevationIssue[]\r\n}\r\n\r\n/** 痍⑥엯???듭㎏濡?嫄곕????ъ쑀. ?대븣 旅덁뻑? ?먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\r\nexport const PLAN_APPLY_REFUSALS = [\r\n  '?롦쑋?뉐츣',\r\n  '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\r\n] as const\r\n\r\nexport type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\r\n\r\n/** 遺???섎굹瑜??ｌ? 紐삵븳 ?ъ쑀. 吏?대궡???????肄붾뱶濡??④릿??*/\r\nexport const PLAN_APPLY_SKIPS = [\r\n  '??씊?ょ쇉??,\r\n  '?ⓩ쓲葉?닪?면걬',\r\n  '?쇔춴鸚?,\r\n  '??씊筽뉑빊屋꿨퐪',\r\n] as const\r\n\r\nexport type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\r\n\r\n/** ?롩쳵 痍⑥엯???듭㎏濡?嫄곕????ъ쑀. ?대븣 旅덁뻑? ?먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\r\nexport const ELEVATION_APPLY_REFUSALS = [\r\n  '?롧칱?꿜툖閭?,\r\n  '?ⓩ쓲?귙굤?롧쉰?쎽툖??,\r\n] as const\r\n\r\nexport type ElevationApplyRefusal =\r\n  (typeof ELEVATION_APPLY_REFUSALS)[number]\r\n\r\n--- package scripts ---\r\n{\n  \"dev\": \"next dev\",\n  \"build\": \"next build\",\n  \"lint\": \"eslint .\",\n  \"typecheck\": \"tsc --noEmit\",\n  \"test\": \"vitest run\",\n  \"test:golden\": \"vitest run tests/golden\",\n  \"lighthouse\": \"lhci autorun --config=lighthouserc.cjs\",\n  \"perf:measure\": \"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\",\n  \"eval\": \"tsx --env-file-if-exists=.env evals/harness/run.ts\",\n  \"test:hooks\": \"bash scripts/hooks/tdd-guard.spec.sh\",\n  \"hooks:install\": \"git config core.hooksPath scripts/githooks\",\n  \"test:ci-scripts\": \"bash scripts/ci/scrub-secrets.spec.sh && bash scripts/ci/review-scope.spec.sh && bash scripts/ci/review-carryforward.spec.sh && bash scripts/ci/review-verdict.spec.sh && bash scripts/ci/distill-failure-log.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts/perf/blocking-graph.test.mjs\"\n}\n--- fixture paths ---\r\nkani-p38.json\r\nkani-p40.json\r\nojkk-p2.json\r\nojkk-p3.json\r\nyokohama-p13.json\r\nyokohama-p14.json\r\nyokohama-p7.json\r\nyokohama-p8.json\r\n","exit_code":0,"status":"completed"}}
