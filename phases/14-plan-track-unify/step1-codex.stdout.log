\n  yGrid: PlanGridCandidate\\r\\n  placements: MemberPlacement[]\\r\\n  /** 釉붾줉 ?덉뿉 ?덉쑝???ㅻ깄?섏? 紐삵븳 遺??以묐났 ?놁쓬, ?먮Ц ?? ??吏?대궡吏 ?딅뒗??*/\\r\\n  unplacedMarks: string[]\\r\\n}\\r\\n\\r\\nexport interface ParsedFramingPlan {\\r\\n  /** ?싥굤???뺤쓽 ??媛숈? 洹몃━?쒓? ?щ윭 釉붾줉??諛섎났?섎㈃ ?섎굹濡??묓엺??*/\\r\\n  grids: PlanGridCandidate[]\\r\\n  blocks: PlanBlock[]\\r\\n  /** ?꾨낫瑜?紐????ъ쑀 ??泥??깆옣 ?? 以묐났 ?놁쓬 */\\r\\n  issues: PlanGridIssue[]\\r\\n}\\r\\n\\r\\n/** 邕며탡?녹뿉??怨꾩뿴??紐????ъ쑀. ?뚯꽌??肄붾뱶留??ｊ퀬 ?쒖떆遺媛 踰덉뿭?쒕떎 */\\r\\nexport const ELEVATION_ISSUES = ['野멩퀡?쀦쑋濾쒎눣'] as const\\r\\n\\r\\nexport type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\\r\\n\\r\\nexport interface ElevationLevel {\\r\\n  /** 洹??믪씠???곹엺 ?쇰꺼 ?먮Ц ?꾨?. ?놁쑝硫?鍮?諛곗뿴 ??吏?대궡吏 ?딅뒗??*/\\r\\n  labels: string[]\\r\\n  positionPt: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * 邕며탡????怨꾩뿴???믪씠 諛⑺뼢 ?쎄린. ?뚯뼱???덈꺼??Story??寃쎄퀎?멸??띾뒗 ?뺥븯吏\\r\\n * ?딅뒗?????먮Ц?먮뒗 FL쨌GL쨌?븀쨴訝뗧ク쨌RCL???욎뿬 ?덇퀬, 洹몄쨷 臾댁뾿???롮씤吏??\\n * 議곕Ц???꾨땲???ㅺ퀎 ?섎룄???щ엺???쎌쓣 ?쇱씠??(ADR-030).\\r\\n *\\r\\n * ?싥굤??낵 ?щ━ ?쇰꺼??醫뚯슦 ?뺣젹???쇱젙?섏? ?딆븘(?ㅻЪ p8??醫뚮떒 x??108~198濡?\\n * ?⑹뼱吏꾨떎) ?쇰꺼 諛대뱶瑜??듭빱濡??????녿떎. ?듭빱??**移섏닔 ??*?닿퀬, 移섏닔媛 ?먭린\\r\\n * 援ш컙??以묒젏???볦씤?ㅻ뒗 愿怨꾨줈 異뺤쿃怨??덈꺼 ?꾩튂瑜??④퍡 ?쇰떎.\\r\\n */\\r\\nexport interface ElevationCandidate {\\r\\n  /** ??怨꾩뿴??嫄몃━??邕며탡???쒕ぉ???먮Ц). ??怨꾩뿴???щ윭 ?싥굤??怨듯넻?쇰줈 嫄몃┛??*/\\r\\n  titles: string[]\\r\\n  /** ?꾨㈃ 醫뚰몴 ?????꾩뿉???꾨옒濡?*/\\r\\n  levels: ElevationLevel[]\\r\\n  /** ?몄젒 ?덈꺼 ?ъ씠 移섏닔(mm). 湲몄씠??levels.length - 1 */\\r\\n  heightsMm: number[]\\r\\n  scalePtPerMm: number\\r\\n}\\r\\n\\r\\nexport interface ParsedFrameElevations {\\r\\n  elevations: ElevationCandidate[]\\r\\n  issues: ElevationIssue[]\\r\\n}\\r\\n\\r\\n/** 痍⑥엯???듭㎏濡?嫄곕????ъ쑀. ?대븣 旅덁뻑? ?먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\\r\\nexport const PLAN_APPLY_REFUSALS = [\\r\\n  '?롦쑋?뉐츣',\\r\\n  '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\\r\\n] as const\\r\\n\\r\\nexport type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\\r\\n\\r\\n/** 遺???섎굹瑜??ｌ? 紐삵븳 ?ъ쑀. 吏?대궡???????肄붾뱶濡??④릿??*/\\r\\nexport const PLAN_APP