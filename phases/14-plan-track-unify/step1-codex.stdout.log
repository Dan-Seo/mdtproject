          { label: 'bY1', positionPt: 100 },\\n          { label: 'bY2', positionPt: 300 },\\n        ],\\n        spansMm: [4500],\\n        scalePtPerMm: 200 / 4500,\\n        totalConfirmed: false,\\n      },\\n    ])\\n  })\\n\\n  it('?쇳몴 移섏닔(6,000)瑜?mm ?뺤닔濡??쎈뒗??, () => {\\n    const parsed = parseFramingPlan(\\n      page([h('X1', 100, 50), h('X2', 300, 50), h('6,000', 200, 80)]),\\n    )\\n    expect(parsed.grids[0]?.spansMm).toEqual([6000])\\n  })\\n\\n  it('?몄젒 ?띿쓽 以묒젏??移섏닔媛 ?놁쑝硫?野멩퀡轝좄맼 ???꾨낫瑜??댁? ?딅뒗??, () => {\\n    const cases: TextItem[][] = [\\n      // 移섏닔 ?먯껜媛 ?녿떎\\n      [h('X1', 100, 50), h('X2', 300, 50)],\\n      // 以묒젏?먯꽌 20pt 踰쀬뼱?щ떎 (?덉슜 15pt)\\n      [h('X1', 100, 50), h('X2', 300, 50), h('6000', 220, 80)],\\n      // ?쇰꺼 諛대뱶?먯꽌 70pt ?⑥뼱吏??ㅻⅨ ?댁쓽 ?レ옄??(李?60pt)\\n      [h('X1', 100, 50), h('X2', 300, 50), h('6000', 200, 120)],\\n    ]\\n    for (const items of cases) {\\n      const parsed = parseFramingPlan(page(items))\\n      expect(parsed.grids).toEqual([])\\n      expect(parsed.issues).toEqual(['野멩퀡轝좄맼'])\\n    }\\n  })\\n\\n  it('?ㅽ뙩蹂??ㅼ륫 異뺤쿃??3%瑜??섍쾶 媛덈━硫?潁?갰訝띷빐??, () => {\\n    const parsed = parseFramingPlan(\\n      page([\\n        h('X1', 100, 50),\\n        h('X2', 300, 50),\\n        h('X3', 500, 50),\\n        h('6000', 200, 80),\\n        h('3000', 400, 80), // 媛숈? 200pt?몃뜲 3000mm ??異뺤쿃??2諛?媛덈┛??      ]),\\n    )\\n    expect(parsed.grids).toEqual([])\\n    expect(parsed.issues).toEqual(['潁?갰訝띷빐??])\\n  })\\n\\n  it('?꾩껜 移섏닔媛 ?ㅽ뙩 ?⑷낵 ?쇱튂?섎㈃ totalConfirmed', () => {\\n    const parsed = parseFramingPlan(\\n      page([\\n        h('X1', 100, 50),\\n        h('X2', 300, 50),\\n        h('X3', 500, 50),\\n        h('6000', 200, 80),\\n        h('6000', 400, 80),\\n        h('12000', 300, 110), // 泥???以묒젏. ?몄젒 以묒젏(200쨌400)怨쇰뒗 100pt ?⑥뼱???덈떎\\n      ]),\\n    )\\n    expect(parsed.issues).toEqual([])\\n    expect(parsed.grids[0]?.totalConfirmed).toBe(true)\\n  })\\n\\n  it('?꾩껜 移섏닔媛 ?ㅽ뙩 ?⑷낵 ?ㅻⅤ硫??덅쮫訝띴??????ㅻ룆 ?좏샇?대?濡??꾨낫瑜??댁? ?딅뒗