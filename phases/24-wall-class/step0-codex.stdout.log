ject, wall: Member): number {\r\n370-  const position = wall.position\r\n371-  if (!isGirderPosition(position)) {\r\n372-    throw new Error(`girderDepthAboveWall requires an edge position: ${wall.id}`)\r\n373-  }\r\n374-\r\n375-  const girder = project.members.find(\r\n376-    (candidate) =>\r\n377-      candidate.kind === '大梁' &&\r\n378-      candidate.storyId === wall.storyId &&\r\n379-      isGirderPosition(candidate.position) &&\r\n380-      candidate.position.axis === position.axis &&\r\n381-      candidate.position.ix === position.ix &&\r\n382-      candidate.position.iy === position.iy,\r\n383-  )\r\n441-  heightMm: number\r\n442-  /** 1通則8) なお書きに基づく設計図書転記の開口補強筋 */\r\n443-  reinforcements?: OpeningReinforcement[]\r\n444-}\r\n445-\r\n446:export interface Member {\r\n447-  id: string\r\n448-  kind: MemberKind\r\n449-  memberClass: MemberClass\r\n450-  sectionId: string\r\n451-  storyId: string\r\n452-  position: ColumnPosition | GirderPosition | WallPosition | SlabPosition\r\n453-  /**\r\n454-   * この部材に開いている開口部 (1通則8))。未指定は「開口なし」であって\r\n455-   * 「未入力」ではない — 製品は開口の有無を推定しないので、内訳書は開口補強筋を\r\n456-   * 計上していないことを常時告知する (R14)。柱・大梁は受け取らない：同項が\r\n457-   * 挙げるのは窓・出入口等で、それが開くのは壁と床板だからである。\r\n458-   */\r\n459-  openings?: Opening[]\r\n460-}\r\n","exit_code":0,"status":"completed"}}
