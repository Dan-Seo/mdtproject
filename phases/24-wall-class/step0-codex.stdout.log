.2.0\",\r\n    \"@types/react\": \"^19.2.18\",\r\n    \"@types/react-dom\": \"^19.2.4\",\r\n    \"@types/three\": \"^0.185.4\",\r\n    \"@vitejs/plugin-react\": \"^6.0.5\",\r\n    \"autoprefixer\": \"^10.5.4\",\r\n    \"eslint\": \"^8.57.1\",\r\n    \"eslint-config-next\": \"^15.5.23\",\r\n    \"fake-indexeddb\": \"6.2.5\",\r\n    \"jsdom\": \"^30.0.1\",\r\n    \"postcss\": \"^8.5.26\",\r\n    \"raw-loader\": \"^4.0.2\",\r\n    \"tailwindcss\": \"^3.4.17\",\r\n    \"tsx\": \"^4.23.12\",\r\n    \"typescript\": \"^5.9.3\",\r\n    \"vitest\": \"^4.1.10\"\r\n  },\r\n  \"overrides\": {\r\n    \"posthog-js\": \"1.417.4\"\r\n  }\r\n}\r\n\r\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2017\",\n    \"lib\": [\"dom\", \"dom.iterable\", \"esnext\"],\n    \"allowJs\": false,\n    \"skipLibCheck\": true,\n    \"strict\": true,\n    \"noEmit\": true,\n    \"esModuleInterop\": true,\n    \"module\": \"esnext\",\n    \"moduleResolution\": \"bundler\",\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"jsx\": \"preserve\",\n    \"incremental\": true,\n    \"plugins\": [{ \"name\": \"next\" }],\n    \"paths\": {\n      \"@/*\": [\"./src/*\"]\n    }\n  },\n  \"include\": [\n    \"next-env.d.ts\",\n    \"**/*.ts\",\n    \"**/*.tsx\",\n    \".next/types/**/*.ts\"\n  ],\n  \"exclude\": [\"node_modules\"]\n}\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"rg -n \\\"wallClass|generateWallRebar|wallLayerOffsets|cover\\\\.minimum|lap\\\\.wall\\\\.minimum|lookupRule|applyCandidate|memberKinds|スラブ、耐力壁以外の壁|耐力壁\\\" src tests/golden tests/fixtures/section-import/expected phases/24-wall-class docs/ADR.md\"","aggregated_output":"docs/ADR.md:140:**이유**: `src/domain/`의 가드 함수는 실패 사유를 `` `clearMm must be finite: ${clearMm}` ``처럼 값을 문자열 보간해 던지고, `lookupRule`의 `Rule not found` 메시지는 `JSON.stringify(conditions)`로 exposure·finish 같은 문자값을, `memberGroupKey`가 만드는 그룹 id는 층 이름·符号을 담는다. 이 메시지들이 `captureException`을 타고 그대로 나가면 「사용자 도면 데이터를 서버로 보내지 말 것」(CLAUDE.md CRITICAL)의 정면 위반이다.\r\ndocs/ADR.md:150:「어느 룰팩 key가 없는가」는 `lookupRule` 실패 message에서 읽을 수 없게 됐다. 이 계측의 목적 중 하나였으므로 손실이다 — 되찾으려면 message를 파싱하는 게 아니라 호출부가 `captureException(error, { rule_key })`처럼 **구조화 속성으로 명시해** 실어야 한다(별건). `takeoff_exported`의 `inferred_rules`는 그 경로로 이미 나가고 있다.\r\ndocs/ADR.md:235:| 壁 | 103쪽 (표5.3.6 「柱、梁、耐力壁」행, 5.3.4(3)(ｱ)) | 34쪽 (第4編第3章 2（５）壁, 1通則3)8), 第1章第2節（５）壁) | **산정한다** |\r\ndocs/ADR.md:252:- `cover.minimum`의 `memberKind: 耐震壁` 5행 — 값을 새로 만든 게 아니라 表5.3.6이 「**柱、梁、耐力壁**」을 한 행으로 묶고 있어 기존 柱·大梁와 같은 칸을 가리킨다. 같은 표의 다른 행 「スラブ、耐力壁**以外**の壁」(仕上げあり20·仕上げなし30)은 싣지 않았다 — 雑壁을 다루게 될 때 그 행이 필요하고, **耐震壁 값으로 대용해서는 안 된다**.\r\ndocs/ADR.md:253:- `lap.wall.minimum` = 40d — 5.3.4(3)(ｱ)가 耐力壁에만 주는 하한이다. 柱·梁 主筋과 달리 表5.3.2 값을 그대로 쓰지 않고 「40d 又は表5.3.2 のうちいずれか大きい値」를 취한다. `max`를 취하는 계산은 TS이고 룰팩이 갖는 것은 하한값 자체다(ADR-002). 원문 괄호의 「軽量コンクリートの場合は50d」는 싣지 않았다 — 콘크리트 종별 입력이 없어 소비자 없는 행이 되고, 表5.3.6 注1이 같은 이유로 かぶり를 普通コンクリート 한정으로 두고 있어 제품은 이미 그 전제 위에 있다.\r\ndocs/ADR.md:322:| 表5.3.6 「スラブ、耐力壁以外の壁」 | 紙面 p.33 (仕上げあり20・なし30) | — | **かぶり** |\r\ndocs/ADR.md:336:- **下端筋** → 表5.3.4 注3의 **L3(スラブ欄)** ＝ 「10d かつ150mm以上」. 10d와 150mm를 룰팩의 **두 행**으로 싣고 큰 쪽을 취하는 계산은 TS다 (ADR-002 — `lap.wall.minimum`과 같은 형태). D13에서는 下限 150이 이기고 D16부터 10d가 이긴다.\r\ndocs/ADR.md:340:**룰팩에 새로 실은 것은 넷이다.** `anchorage.L3`(10d)·`anchorage.L3.minimum`(150mm)·`anchorage.Lb`(表5.3.5 Lb 11칸 → fc 전개 20행)·`cover.minimum`의 `memberKind: 床板` 2행, 그리고 継手 区分表 `measure.splice.slab.continuous` 3행＋`.band.upper` 3행. **표5.3.4의 L3·표5.3.5의 Lb는 ADR-005 시절 「小梁·スラブ는 대상 외」로 픽스처의 `excluded` 대장에 올려 두었던 열이다** — 범위가 넓어졌으므로 대장에서 `entries`로 옮겼고, 남은 除外는 小梁의 열과 원문이 「─」인 L3h뿐이다. ADR-025가 「雑壁을 다루게 될 때 필요하다, 耐震壁 값으로 대용해서는 안 된다」고 적어 둔 表5.3.6의 「スラブ、耐力壁以外の壁」행도 여기서 먼저 필요해졌다.\r\ndocs/ADR.md:342:**`SlabSection`이 `exposure`를 갖지 않는 것은 원문의 구조다.** 表5.3.6의 「スラブ、耐力壁以外の壁」행은 仕上げ의 有無로만 갈리고 **屋内·屋外의 구별을 갖지 않는다** — 「柱、梁、耐力壁」행과 다르다. 입력에 두면 화면에 듣지 않는 손잡이가 놓이므로 필드도 조회 조건도 두지 않는다.\r\ndocs/ADR.md:523:**맥락**: `数量積算基準` 第4編第1章第2節（５）의 壁 정의는 「袖壁、下り壁、腰壁等もこれらに準ずる」로 雑壁을 壁에 포섭하고, 계측 조문 2（５）壁1)①②③는 耐力/非耐力을 가르지 않는다 — ②는 오히려 「開口部腰壁、手すり壁等の継手はないものとする」로 雑壁을 지명한다. 두 원문에서 耐力壁 여부로 갈리는 것은 둘뿐이다: ① `標準仕様書` 表5.3.6 かぶり — 「柱、梁、耐力壁」(30/40)과 「スラブ、耐力壁以外の壁」(仕上げあり20·仕上げなし30, 屋内外 구분 없음), ② 5.3.4(3)(ｱ)의 重ね継手 40d 하한 — 원문이 「耐力壁の鉄筋の」로 명시 한정. 현행 제품은 벽을 전부 耐震壁으로 두어 ①은 ADR-025가 예고한 대로 대용 금지 상태고(耐震壁 값을 쓰면 안 되는 벽이 耐震壁 값을 받는다), ②는 무조건 적용되고 있다 — 근거 없는 40d가 kg를 올린다.\r\ndocs/ADR.md:526:1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로다(ADR-025의 「雑壁 부재 금지」는 부재로서는 유지). 조문이 雑壁을 壁에 준하게 하므로 갈림은 부재 축이 아니라 단면 축이다: `WallSection.wallClass?: '耐力壁' | '耐力壁以外'`, 없으면 `耐力壁`(기존 案件 무변경 — schemaVersion 유지, 판단 기준 「같은 案件의 数量이 달라지는가」).\r\ndocs/ADR.md:527:2. **구분은 設計図書 판단의 전사 입력이다** — 어느 벽이 耐力壁인지는 두 원문에 판정 기준이 없다(構造設計의 몫). 실도면 2부의 壁リスト도 雑壁을 `W○` 부호＋자유 텍스트 備考로만 적으므로, 断面リスト 취입은 자동 판정하지 않고(備考 분류 금지 전사 주석 유지) 断面一覧에서 사용자가 고른다. 취입은 기존 단면의 `wallClass`를 덮지 않는다 — 전사 대상이 아니다.\r\ndocs/ADR.md:528:3. **かぶり** — 룰팩에 表5.3.6 「スラブ、耐力壁以外の壁」행을 `memberKind: 雑壁` 2행(仕上げあり20·仕上げなし30, soilContact:false, exposure 조건 없음 — 원문 구조)으로 싣는다. 값은 ADR-028이 床板용으로 이미 전사한 fixture 행에 있고, 이 행은 부재가 아니라 구분을 가르므로 제품 어휘 토큰 `雑壁`을 조건에 쓴다 — 기존 耐震壁 행과 조건이 배타라 조회 동점(ambiguous)을 만들지 않는다. かぶり는 設計長さ(kg)에 영향이 없고 3D 배치와 ダブル 성립 가드에만 미친다 — 지금 `寸法不成立`으로 떨어지는 얇은 벽이 계상되기 시작할 수 있고, 그것이 옳은 방향이다.\r\ndocs/ADR.md:529:4. **40d 하한은 雑壁에 적용하지 않는다 — 제품의 읽기다.** 5.3.4(3)(ｱ)는 耐力壁 한정이고 耐力壁以外의 하한을 정한 조문은 없으므로, 일반 규정(表5.3.2의 L1)만 남는다고 읽는다. ADR-029의 開口部腰壁 판정과 같은 성격으로 기록한다(R2). `wallClass: 耐力壁以外`이면 `lap.wall.minimum`을 조회하지 않고 ruleHits에도 싣지 않으며, 算出式에 그 사실을 적는다. **kg가 달라지는 유일한 지점이다** (L1 ＜ 40d인 조합에서만).\r\ntests/golden\\spec-tables.test.ts:4:import { lookupRule } from '../../src/domain/rules/lookup'\r\ntests/golden\\spec-tables.test.ts:61:  kind: 'cover.minimum'\r\ntests/golden\\spec-tables.test.ts:63:    memberKinds: string[]\r\ntests/golden\\spec-tables.test.ts:161:  ({ kind }) => kind === 'cover.minimum',\r\ntests/golden\\spec-tables.test.ts:165:  const { memberKinds, ...baseConditions } = entry.conditions\r\ntests/golden\\spec-tables.test.ts:167:  return memberKinds.map((memberKind) => ({\r\ntests/golden\\spec-tables.test.ts:183:).find(({ kind }) => kind === 'lap.wall.minimum')\r\ntests/golden\\spec-tables.test.ts:186:  throw new Error('Fixture is missing lap.wall.minimum')\r\ntests/golden\\spec-tables.test.ts:208:      const hit = lookupRule(jpMlitRulePack, entry.kind, conditions)\r\ntests/golden\\spec-tables.test.ts:223:      lookupRule(jpMlitRulePack, 'anchorage.L2', {\r\ntests/golden\\spec-tables.test.ts:236:      const hit = lookupRule(jpMlitRulePack, entry.kind, entry.conditions)\r\ntests/golden\\spec-tables.test.ts:252:      const hit = lookupRule(jpMlitRulePack, entry.kind, conditions)\r\ntests/golden\\spec-tables.test.ts:268:      const hit = lookupRule(jpMlitRulePack, entry.kind, entry.conditions)\r\ntests/golden\\spec-tables.test.ts:283:      const hit = lookupRule(jpMlitRulePack, entry.kind, conditions)\r\ntests/golden\\spec-tables.test.ts:299:      const hit = lookupRule(jpMlitRulePack, entry.kind, entry.conditions)\r\ntests/golden\\spec-tables.test.ts:314:    const perDiameter = lookupRule(jpMlitRulePack, 'anchorage.L3', {\r\ntests/golden\\spec-tables.test.ts:317:    const floor = lookupRule(jpMlitRulePack, 'anchorage.L3.minimum', {\r\ntests/golden\\spec-tables.test.ts:326:  it('matches the 耐力壁