unitMassKgPerM: number | null\r\n  designKg: number | null\r\n  requiredKg: number | null\r\n}\r\n\r\nexport interface SpliceQuantityLine extends QuantityLineBase {\r\n  unit: '嶸뉑?'\r\n  method: SpliceMethod\r\n  /** 1?ⓩ쓲?귙걼?듽겗泳숁뎸嶸뉑???竊?1?с걗?잆굤嶸뉑???횞 ?ф빊 */\r\n  countPerMember: number\r\n  /** 嶸뉑??겹겗?덅쮫 竊?countPerMember 횞 places */\r\n  totalCount: number\r\n}\r\n\r\nexport type QuantityLine = MassQuantityLine | SpliceQuantityLine\r\n\r\nexport function isMassLine(line: QuantityLine): line is MassQuantityLine {\r\n  return line.unit === 'kg'\r\n}\r\n\r\nexport function isSpliceLine(line: QuantityLine): line is SpliceQuantityLine {\r\n  return line.unit === '嶸뉑?'\r\n}\r\n\r\nexport function massLines(lines: QuantityLine[]): MassQuantityLine[] {\r\n  return lines.filter(isMassLine)\r\n}\r\n\r\nexport function spliceLines(lines: QuantityLine[]): SpliceQuantityLine[] {\r\n  return lines.filter(isSpliceLine)\r\n}\r\n\r\n/** ?섆퐤蘊ら뇧?뚥??ㅳ겎?귝쵟?묆걼?됧컦鼇덀꺕?덅쮫?귛눣?ゃ걚 ???γ겂?잌푶?졼걨??뭽??릦鼇덀겎??겒?꾠?*/\r\nexport interface StorySubtotal {\r\n  storyName: string\r\n  designKg: number | null\r\n  requiredKg: number | null\r\n}\r\n\r\n/**\r\n * 孃꾢닪??나?뤵귞쇇力ⓦ겘孃꾠걫?ⓦ겓?뷩걲??겎?곲쉸?귡깿?먦굚瓮ⓦ걚?㏛??с겓?얇겏?곥굥??\r\n * ?롥컦鼇덀겏?뺛겂??**孃꾠걫?ⓦ겓?х쳦?쀣겍** null ?ャ겒?????볝겗烏ⓦ겗?③붵겘\r\n * ?뚣겑??푶?뚣겲?좂쇇力ⓦ겎?띲겒?꾠걢?띲굮誤뗣걵?뗣걪?ⓦ겒??겎?곫쵟?묆걼孃꾠걣餓뽧겗孃꾠겲??\r\n * 藥삠걤渦쇈??ⓦ곥걹??깄?긱걣易덀걟?뗣?\r\n */\r\nexport interface SizeSubtotal {\r\n  size: ShearBarSize\r\n  designKg: number | null\r\n  requiredKg: number | null\r\n}\r\n\r\nexport interface QuantityTotal {\r\n  designKg: number | null\r\n  requiredKg: number | null\r\n}\r\n\r\nexport interface SpliceTotal {\r\n  method: SpliceMethod\r\n  totalCount: number\r\n}\r\n\r\ntype GroupedLine =\r\n  | { kind: 'kg'; line: MassQuantityLine; memberIds: Set<string>; markupRate: number }\r\n  | { kind: '嶸뉑?'; line: SpliceQuantityLine; memberIds: Set<string> }\r\n\r\nfunction storyName(project: Project, member: Member): string {\r\n  const story = project.stories.find(({ id }) => id === member.storyId)\r\n  if (!story) {\r\n    throw storyNotFound(member.storyId)\r\n  }\r\n  return story.name\r\n}\r\n\r\nfunction sectionLabel(section: Section): string {\r\n  // ?녶숱?긱겘?녜씊?ⓨ릪?섅?00??띲겎?멥걦?괷횞d ?ⓩ쎑?뤵겏?녜씊?ャ겒?꾤윪壤€뼪?㏂겓誤뗣걟?뗣?\r\n  if (section.kind === '??) {\r\n    return section.shape === '?녶숱'\r\n      ? `${section.b}?`\r\n      : `${section.b}횞${section.d}`\r\n  }\r\n  if (section.kind === '鸚㎪쥈') return `${section.b}횞${section.depth}`\r\n\r\n  // 鶯곥굚佯딀씮?귝뼪?㏂걣?싥걬1?ㅳ겒??겎?녜씊?ⓨ릪?섅똳180?띲겗?멥걤?밤겓?쇻굥??\r\n  // ?⒲걾?됥겗?ⓩ쓲?뗣겘?겹꺂?쇈깤誤뗥눣?쀣겗?ⓩ쓲葉?닪?뚩??녴?\r\n  return `t${section.thickness}`\r\n}\r\n\r\nfunction ruleIdentity(rule: RuleHit): string {\r\n  const conditions = Object.entries(rule.conditions).sort(\r\n    ([left], [right]) => left.localeCompare(right),\r\n  )\r\n  return `${rule.key}\\u0000${JSON.stringify(conditions)}`\r\n}\r\n\r\nfunction uniqueRules(rules: RuleHit[]): RuleHit[] {\r\n  const seen = new Set<string>()\r\n  return rules.filter((rule) => {\r\n    const identity = ruleIdentity(rule)\r\n    if (seen.has(identity)) return false\r\n    seen.add(identity)\r\n    return true\r\n  })\r\n}\r\n\r\nfunction contributingRules(\r\n  pack: RulePack,\r\n  member: Member,\r\n  rebar: Rebar,\r\n): { rules: RuleHit[]; markup: RuleHit } {\r\n  // ?곗젙遺媛 ?ㅼ젣濡?議고쉶???됱쓣 洹몃?濡??대떎 ???ㅼ뿉??議고쉶 議곌굔???섏쭦?쇰㈃\r\n  // ?섏쭦?????녿뒗 議고쉶(吏???깆쓽 ?뗣겤??媛 洹쇨굅?먯꽌 ?щ씪吏꾨떎.\r\n  const rebarRules = rebar.ruleHits\r\n  const markup = lookupMarkup(pack, member.memberClass)\r\n\r\n  if (markup.unit !== 'ratio') {\r\n    throw new Error(`Rule ${markup.key} must use ratio`)\r\n  }\r\n\r\n79:export function isMassLine(line: QuantityLine): line is MassQuantityLine {\r\n83:export function isSpliceLine(line: QuantityLine): line is SpliceQuantityLine {\r\n87:export function massLines(lines: QuantityLine[]): MassQuantityLine[] {\r\n91:export function spliceLines(lines: QuantityLine[]): SpliceQuantityLine[] {\r\n193:export function quantityLineId(groupId: string, rebar: Rebar): string {\r\n208:export function spliceLineId(groupId: string, rebar: Rebar): string {\r\n242:export function aggregateQuantity(\r\n369:export function spliceTotals(lines: QuantityLine[]): SpliceTotal[] {\r\n389:export function weakestConfidence(rules: RuleHit[]): RuleConfidence {\r\n404:export function hasUnverified(lines: QuantityLine[]): boolean {\r\n413:export function hasUnverifiedRules(\r\n419:export function unverifiedRules(lines: QuantityLine[]): RuleHit[] {\r\n428:export function inferredRules(lines: QuantityLine[]): RuleHit[] {\r\n442:export function storySubtotals(lines: QuantityLine[]): StorySubtotal[] {\r\n465:export function sizeSubtotals(lines: QuantityLine[]): SizeSubtotal[] {\r\n497:export function grandTotal(lines: QuantityLine[]): QuantityTotal {\r\n","exit_code":0,"status":"completed"}}
