{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/components/section/SectionImport.tsx'","aggregated_output":"'use client'\r\n * (寧?뤇, ?ⓩ쓲, ???? ?롫? 寧?뤇??遺숈씠吏???딅뒗?? ?꾨㈃???녿뒗 寧?뤇???낁㉢?몄뿉 洹몃?濡?\r\n * ?섍?怨? ?낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n */\r\ntype ImportableSection =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\ntype SlabDirection = 'x' | 'y'\r\ntype GirderDirection = 'first' | 'second'\r\n\r\n/**\r\n * ?똜2塋?띲겗?덀걝?よ뻗?띴퍡?띲꺀?쇻꺂?졼걨?믦눎?뺝?恙쒌겗野얕괌?ャ걲?뗣귛쨼塋?꺕?끿ク??\r\n * Grid??꺀?쇻꺂?ⓨ겤?뜸??담걮?╉굚?곮뻗?띲겏?쀣겍鰲ｉ뇠?쀣겍??겒?됥겒??(ADR-033) ??\r\n */\r\nfunction axisNameFromEndLabel(label: string): string | undefined {\r\n  const value = compact(label)\r\n  if (!value.endsWith('塋?)) return undefined\r\n  const axisName = value.slice(0, -1)\r\n  return axisName === '' || axisName === '鸚? || axisName === '??\r\n    ? undefined\r\n    : axisName\r\n}\r\n\r\n/**\r\n * ??씊?ゃ궧?덀겗塋?깿?⒲깧?ャ겏?뚣걯邕멥겗Grid?⒲깧?ャ걣訝→뼶誤뗣겇?뗣겂?잆겏?띲걽?묆?\r\n * 邕멥궎?녈깈?껁궚?밤겗鵝롢걚?담굮冶뗧ク?ャ걲?뗣귝캈雍껁겗訝↑씌??compact() ?믧싥걲 ??\r\n * framing-plan ?담굚?뚣걯閭ｈ쫸?뽧굮鵝욍걝?잆굙?곥걪?뚣겘?뉐춻?쀣겗若뚦뀲訝?담겎?귙겂??\r\n * ?꾨㈃ 諛⑺뼢??異붿젙?섎뒗 ?대━?ㅽ떛???꾨땲??(ADR-033) ??\r\n */\r\nfunction automaticGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): GirderDirection | undefined {\r\n  const asymmetric = candidate.girderMainAsymmetric\r\n  if (!asymmetric) return undefined\r\n\r\n  const axisNames = asymmetric.labels.map(axisNameFromEndLabel)\r\n  if (axisNames.some((axisName) => axisName === undefined)) return undefined\r\n\r\n  for (const labels of [project.grid.xLabels, project.grid.yLabels]) {\r\n    if (!labels) continue\r\n    const indexes = axisNames.map((axisName) =>\r\n      labels.findIndex((label) => compact(label) === axisName),\r\n    )\r\n    if (indexes.every((index) => index >= 0) && indexes[0] !== indexes[1]) {\r\n      return indexes[0] < indexes[1] ? 'first' : 'second'\r\n    }\r\n  }\r\n  return undefined\r\n}\r\n\r\nfunction resolvedGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  selected?: GirderDirection,\r\n): GirderDirection | undefined {\r\n  return selected ?? automaticGirderDirection(project, candidate)\r\n}\r\n\r\nfunction isImportableSection(section: Section): section is ImportableSection {\r\n  return (\r\n    section.kind === '?? ||\r\n    section.kind === '鸚㎪쥈' ||\r\n    section.kind === '?먬쐡鶯? ||\r\n    section.kind === '佯딀씮'\r\n  )\r\n}\r\n\r\nfunction matchingSection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  return project.sections\r\n    .filter(isImportableSection)\r\n    .find(\r\n      (section) =>\r\n        section.mark === candidate.mark &&\r\n        section.kind === candidate.kind &&\r\n        section.storyLabel === candidate.storyLabel,\r\n    )\r\n}\r\n\r\nfunction cloneSource(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  const sameKind = project.sections\r\n    .filter(isImportableSection)\r\n    .filter((section) => section.kind === candidate.kind)\r\n  // 媛숈? 寧?뤇???ㅻⅨ ?롪? ?대? ?덉쑝硫?洹몄そ??蹂듭젣?먯씠?????뚯떛?섏? ?딅뒗\r\n  // fc쨌媛뺤쥌쨌?몄텧쨌餓뺜툓?뮻룟닜?잆궕?뺛궩?껁깉? 臾닿???遺?щ낫??媛숈? 寧?뤇 履쎌씠 留욌떎\r\n  return (\r\n    sameKind.find((section) => section.mark === candidate.mark) ?? sameKind[0]\r\n  )\r\n}\r\n\r\n/**\r\n * ?좉퇋 寧?뤇??紐⑤뱺 諛곌렐쨌?⑤㈃ 移몄씠 ?뚯떛?먯쓣 ?뚮쭔 諛섏쁺???덉슜?쒕떎 ??鍮덉뭏??臾닿???\r\n * 遺?ъ쓽 蹂듭젣媛믪쑝濡?梨꾩썙 臾쇰웾???ｌ쑝硫??뚯꽌媛 吏???뚯??대궡吏 ?딅뒗?ㅳ?ADR-012)媛\r\n * UI?먯꽌 臾대꼫吏꾨떎. 湲곗〈 Section?먮뒗 鍮덉뭏??湲곗〈媛??좎????대떦?섏? ?딅뒗??\r\n */\r\nfunction missingParsedFields(\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  girderDirection?: GirderDirection,\r\n): boolean {\r\n  if (candidate.kind === '??) {\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.d === undefined ||\r\n      candidate.main === undefined ||\r\n      candidate.hoop === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '鸚㎪쥈') {\r\n    const mainAvailable =\r\n      candidate.girderMain !== undefined ||\r\n      (candidate.girderMainAsymmetric !== undefined &&\r\n        girderDirection !== undefined)\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.depth === undefined ||\r\n      !mainAvailable ||\r\n      candidate.stirrup === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    return (\r\n      candidate.thickness === undefined ||\r\n      candidate.layers === undefined ||\r\n      candidate.vertical === undefined ||\r\n      candidate.horizontal === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '佯딀씮') {\r\n    return (\r\n      slabDirection === undefined ||\r\n      candidate.thickness === undefined ||\r\n      candidate.shortSide?.top === undefined ||\r\n      candidate.shortSide?.bottom === undefined ||\r\n      candidate.longSide?.top === undefined ||\r\n      candidate.longSide?.bottom === undefined\r\n    )\r\n  }\r\n  return true\r\n}\r\n\r\nfunction uniqueSectionId(project: Project, mark: string): string {\r\n  const base = `section-${mark}`\r\n  if (!project.sections.some(({ id }) => id === base)) return base\r\n\r\n  let suffix = 2\r\n  while (project.sections.some(({ id }) => id === `${base}-${suffix}`)) {\r\n    suffix += 1\r\n  }\r\n  return `${base}-${suffix}`\r\n}\r\n\r\nfunction applyParsedFields(\r\n  section: Section,\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  girderDirection?: GirderDirection,\r\n): Section {\r\n  if (section.kind === '?? && candidate.kind === '??) {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      // 壤®듁???力뺛겏訝永꾠겎?γ굥?귙?00??띲굮 b횞d ??옞?ヨ맼?ⓦ걲?①쎍孃꾠걣渦븅빓??\r\n      // ?ゃ겂??뫅?룔걣鸚됥굩?????뉑뼶?졼걨?띷삝?쀣겒??(ADR-027)\r\n      ...(candidate.shape === undefined ? {} : { shape: candidate.shape }),\r\n      ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n      ...(candidate.d === undefined ? {} : { d: candidate.d }),\r\n      ...(candidate.main === undefined\r\n        ? {}\r\n        : { main: { ...section.main, ...candidate.main } }),\r\n      ...(candidate.hoop === undefined\r\n        ? {}\r\n        : {\r\n            hoop: {\r\n              ...section.hoop,\r\n              size: candidate.hoop.size,\r\n              pitch: candidate.hoop.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '鸚㎪쥈' && candidate.kind === '鸚㎪쥈') {\r\n    const parsedMain = candidate.girderMainAsymmetric && girderDirection\r\n      ? (() => {\r\n          const startIndex = girderDirection === 'first' ? 0 : 1\r\n          const endIndex = 1 - startIndex\r\n          return {\r\n            ...section.main,\r\n            size: candidate.girderMainAsymmetric.size,\r\n            top: {\r\n              startCount: candidate.girderMainAsymmetric.topCounts[startIndex],\r\n              centerCount: candidate.girderMainAsymmetric.topCenterCount,\r\n              endCount: candidate.girderMainAsymmetric.topCounts[endIndex],\r\n            },\r\n            bottom: {\r\n              startCount:\r\n                candidate.girderMainAsymmetric.bottomCounts[startIndex],\r\n              centerCount: candidate.girderMainAsymmetric.bottomCenterCount,\r\n              endCount: candidate.girderMainAsymmetric.bottomCounts[endIndex],\r\n            },\r\n          }\r\n        })()\r\n      : candidate.girderMain === undefined\r\n        ? undefined\r\n        : {\r\n            ...section.main,\r\n            size: candidate.girderMain.size,\r\n            top: {\r\n              endCount:\r\n                candidate.girderMain.endTopCount ??\r\n                candidate.girderMain.topCount,\r\n              centerCount: candidate.girderMain.topCount,\r\n            },\r\n            bottom: {\r\n              endCount:\r\n                candidate.girderMain.endBottomCount ??\r\n                candidate.girderMain.bottomCount,\r\n              centerCount: candidate.girderMain.bottomCount,\r\n            },\r\n          }\r\n    const nextMain =\r\n      candidate.cutoffFromSupportFaceMm === undefined\r\n        ? parsedMain\r\n        : {\r\n            ...(parsedMain ?? section.main),\r\n            cutoffFromSupportFaceMm: candidate.cutoffFromSupportFaceMm,\r\n          }\r\n\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n      ...(candidate.depth === undefined ? {} : { depth: candidate.depth }),\r\n      ...(nextMain === undefined ? {} : { main: nextMain }),\r\n      ...(candidate.stirrup === undefined\r\n        ? {}\r\n        : {\r\n            stirrup: {\r\n              ...section.stirrup,\r\n              size: candidate.stirrup.size,\r\n              pitch: candidate.stirrup.pitchMm,\r\n            },\r\n          }),\r\n      ...(candidate.sideBar === undefined\r\n        ? {}\r\n        : {\r\n            sideBar: {\r\n              size: candidate.sideBar.size,\r\n              count: candidate.sideBar.count,\r\n              // ?밭춮??퐰?룔겘?녜씊?ャ굚與숁틬餓뺞쭣??塋졼겓?귙겒?뤵??싧뎴6) ?뚦쭟??굥\r\n              // JASS 5 ?귝쐣?쇻꺕?ょ▶岳앫겎?귙굥?? ??쫸繹뽩ㅳ겎??겒?뤸쑋?ε뒟?뜻뀑?㎯?\r\n              // ?℡춼?ㅳ걣?귙굦?겼닶?②끹겗?ε뒟?ⓦ걮?╊퓷??(R9???괪ectionTable ??\r\n              // extraLengthMm ?? 0 ?ⓨ릪?섉돮?꾠겎?귙굥??\r\n              extraLengthMm: section.sideBar?.extraLengthMm ?? 0,\r\n            },\r\n          }),\r\n      ...(candidate.widthTie === undefined\r\n        ? {}\r\n        : {\r\n            widthTie: {\r\n              size: candidate.widthTie.size,\r\n              pitch: candidate.widthTie.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '?먬쐡鶯? && candidate.kind === '?먬쐡鶯?) {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.thickness === undefined\r\n        ? {}\r\n        : { thickness: candidate.thickness }),\r\n      ...(candidate.layers === undefined ? {} : { layers: candidate.layers }),\r\n      ...(candidate.vertical === undefined\r\n        ? {}\r\n        : {\r\n            vertical: {\r\n              ...section.vertical,\r\n              size: candidate.vertical.size,\r\n              pitch: candidate.vertical.pitchMm,\r\n            },\r\n          }),\r\n      ...(candidate.horizontal === undefined\r\n        ? {}\r\n        : {\r\n            horizontal: {\r\n              ...section.horizontal,\r\n              size: candidate.horizontal.size,\r\n              pitch: candidate.horizontal.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '佯딀씮' && candidate.kind === '佯딀씮') {\r\n    if (slabDirection === undefined) return section\r\n\r\n    const xSource =\r\n      slabDirection === 'x' ? candidate.shortSide : candidate.longSide\r\n    const ySource =\r\n      slabDirection === 'x' ? candidate.longSide : candidate.shortSide\r\n\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.thickness === undefined\r\n        ? {}\r\n        : { thickness: candidate.thickness }),\r\n      x: {\r\n        ...section.x,\r\n        ...(xSource?.top === undefined\r\n          ? {}\r\n          : {\r\n              top: {\r\n                ...section.x.top,\r\n                size: xSource.top.size,\r\n                pitch: xSource.top.pitchMm,\r\n              },\r\n            }),\r\n        ...(xSource?.bottom === undefined\r\n          ? {}\r\n          : {\r\n              bottom: {\r\n                ...section.x.bottom,\r\n                size: xSource.bottom.size,\r\n                pitch: xSource.bottom.pitchMm,\r\n              },\r\n            }),\r\n      },\r\n      y: {\r\n        ...section.y,\r\n        ...(ySource?.top === undefined\r\n          ? {}\r\n          : {\r\n              top: {\r\n                ...section.y.top,\r\n                size: ySource.top.size,\r\n                pitch: ySource.top.pitchMm,\r\n              },\r\n            }),\r\n        ...(ySource?.bottom === undefined\r\n          ? {}\r\n          : {\r\n              bottom: {\r\n                ...section.y.bottom,\r\n                size: ySource.bottom.size,\r\n                pitch: ySource.bottom.pitchMm,\r\n              },\r\n            }),\r\n      },\r\n    }\r\n  }\r\n\r\n  return section\r\n}\r\n\r\n/** 筽뉓＝?껋쓽 ???쒓린媛 ?꾨낫???몃젮?ㅼ? ?딄쾶 ?쒕떎 ???롮쓽 洹쇨굅???꾨낫 履쎈퓧?대떎. */\r\nfunction withCandidateStory(\r\n  section: Section,\r\n  candidate: SectionCandidate,\r\n): Section {\r\n  const next = { ...section }\r\n  if (candidate.storyLabel === undefined) delete next.storyLabel\r\n  else next.storyLabel = candidate.storyLabel\r\n  return next\r\n}\r\n\r\nfunction applyCandidate(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  selectedGirderDirection?: GirderDirection,\r\n): Project {\r\n  if (candidate.kind === '野얕괌鸚?) return project\r\n  if (candidate.kind === '佯딀씮' && slabDirection === undefined) return project\r\n  const girderDirection = resolvedGirderDirection(\r\n    project,\r\n    candidate,\r\n    selectedGirderDirection,\r\n  )\r\n  if (\r\n    candidate.girderMainAsymmetric !== undefined &&\r\n    girderDirection === undefined\r\n  ) {\r\n    return project\r\n  }\r\n\r\n  const existing = matchingSection(project, candidate)\r\n  if (existing) {\r\n    return {\r\n      ...project,\r\n      sections: project.sections.map((section) =>\r\n        section.id === existing.id\r\n          ? applyParsedFields(\r\n              section,\r\n              candidate,\r\n              slabDirection,\r\n              girderDirection,\r\n            )\r\n          : section,\r\n      ),\r\n    }\r\n  }\r\n\r\n  const source = cloneSource(project, candidate)\r\n  if (\r\n    !source ||\r\n    missingParsedFields(candidate, slabDirection, girderDirection)\r\n  ) {\r\n    return project\r\n  }\r\n  // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎 ???롫? ?욎뼱 癒쇱? 醫곹엺??\r\n  const id = uniqueSectionId(\r\n    project,\r\n    candidate.storyLabel\r\n      ? `${candidate.mark}-${candidate.storyLabel}`\r\n      : candidate.mark,\r\n  )\r\n  const clonedSource: ImportableSection =\r\n    source.kind === '??\r\n      ? { ...source, id, main: { ...source.main }, hoop: { ...source.hoop } }\r\n      : source.kind === '鸚㎪쥈'\r\n        ? {\r\n            ...source,\r\n            id,\r\n            main: { ...source.main },\r\n            stirrup: { ...source.stirrup },\r\n          }\r\n        : source.kind === '?먬쐡鶯?\r\n          ? {\r\n              ...source,\r\n              id,\r\n              vertical: { ...source.vertical },\r\n              horizontal: { ...source.horizontal },\r\n            }\r\n          : {\r\n              ...source,\r\n              id,\r\n              x: {\r\n                top: { ...source.x.top },\r\n                bottom: { ...source.x.bottom },\r\n              },\r\n              y: {\r\n                top: { ...source.y.top },\r\n                bottom: { ...source.y.bottom },\r\n              },\r\n            }\r\n  const cloned = withCandidateStory(\r\n    applyParsedFields(\r\n      clonedSource,\r\n      candidate,\r\n      slabDirection,\r\n      girderDirection,\r\n    ),\r\n    candidate,\r\n  )\r\n\r\n  return { ...project, sections: [...project.sections, cloned] }\r\n}\r\n\r\nfunction sectionSummary(section: ImportableSection): string {\r\n  if (section.kind === '??) {\r\n    const dimension =\r\n      section.shape === '?녶숱' ? `${section.b}?` : `${section.b}횞${section.d}`\r\n    return `${sectionMarkLabel(section)} / ${dimension} / ${section.main.count}-${section.main.size} / ${section.hoop.size}@${section.hoop.pitch}`\r\n  }\r\n  if (section.kind === '鸚㎪쥈') {\r\n    const { top, bottom } = section.main\r\n    const topCounts =\r\n      top.startCount === undefined\r\n        ? `${top.endCount}竊?{top.centerCount}`\r\n        : `${top.startCount}竊?{top.centerCount}竊?{top.endCount}`\r\n    const bottomCounts =\r\n      bottom.startCount === undefined\r\n        ? `${bottom.endCount}竊?{bottom.centerCount}`\r\n        : `${bottom.startCount}竊?{bottom.centerCount}竊?{bottom.endCount}`\r\n    return `${sectionMarkLabel(section)} / ${section.b}횞${section.depth} / 訝?{topCounts}?삡툔${bottomCounts}-${section.main.size} / ${section.stirrup.size}@${section.stirrup.pitch}`\r\n  }\r\n  if (section.kind === '?먬쐡鶯?) {\r\n    return `${sectionMarkLabel(section)} / 鶯곩럻${section.thickness} / ${section.layers}掠?/ 潁?춮 ${section.vertical.size}@${section.vertical.pitch} / 與ょ춮 ${section.horizontal.size}@${section.horizontal.pitch}`\r\n  }\r\n  return `${sectionMarkLabel(section)} / ?욕럻${section.thickness} / X 訝?{section.x.top.size}@${section.x.top.pitch}?삡툔${section.x.bottom.size}@${section.x.bottom.pitch} / Y 訝?{section.y.top.size}@${section.y.top.pitch}?삡툔${section.y.bottom.size}@${section.y.bottom.pitch}`\r\n}\r\n\r\nfunction candidateFields(candidate: SectionCandidate, locale: Locale): string[] {\r\n  const fields: string[] = []\r\n  if (candidate.shape === '?녶숱' && candidate.b !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}?`)\r\n  } else if (candidate.b !== undefined && candidate.d !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}횞${candidate.d}`)\r\n  } else if (candidate.b !== undefined && candidate.depth !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}횞${candidate.depth}`)\r\n  }\r\n  if (candidate.main) {\r\n    fields.push(`訝사춮 ${candidate.main.count}-${candidate.main.size}`)\r\n  }\r\n  if (candidate.hoop) {\r\n    fields.push(`躍?춮 ${candidate.hoop.size}@${candidate.hoop.pitchMm}`)\r\n  }\r\n  if (candidate.girderMain) {\r\n    const { topCount, bottomCount, size, endTopCount, endBottomCount } =\r\n      candidate.girderMain\r\n    fields.push(`訝사춮 訝?{topCount}?삡툔${bottomCount}-${size}`)\r\n    if (endTopCount !== undefined || endBottomCount !== undefined) {\r\n      fields.push(\r\n        `塋?깿 訝?{endTopCount ?? topCount}?삡툔${endBottomCount ?? bottomCount}`,\r\n      )\r\n    }\r\n  }\r\n  if (candidate.girderMainAsymmetric) {\r\n    const asymmetric = candidate.girderMainAsymmetric\r\n    fields.push(\r\n      `訝사춮 訝?{asymmetric.topCenterCount}?삡툔${asymmetric.bottomCenterCount}-${asymmetric.size}`,\r\n    )\r\n    fields.push(\r\n      `塋?깿 ${asymmetric.labels[0]} 訝?{asymmetric.topCounts[0]}?삡툔${asymmetric.bottomCounts[0]} / ${asymmetric.labels[1]} 訝?{asymmetric.topCounts[1]}?삡툔${asymmetric.bottomCounts[1]}`,\r\n    )\r\n  }\r\n  if (candidate.stirrup) {\r\n    fields.push(\r\n      `?귙겙?됬춮 ${candidate.stirrup.size}@${candidate.stirrup.pitchMm}`,\r\n    )\r\n  }\r\n  if (candidate.sideBar) {\r\n    fields.push(\r\n      `${t(locale, 'sectionImport.field.sideBar')} ${candidate.sideBar.count}-${candidate.sideBar.size}`,\r\n    )\r\n  }\r\n  if (candidate.widthTie) {\r\n    fields.push(\r\n      `${t(locale, 'sectionImport.field.widthTie')} ${candidate.widthTie.size}@${candidate.widthTie.pitchMm}`,\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    if (candidate.thickness !== undefined) {\r\n      fields.push(`鶯곩럻 ${candidate.thickness}`)\r\n    }\r\n    if (candidate.layers !== undefined) fields.push(`?띸춮 ${candidate.layers}掠?)\r\n    if (candidate.vertical) {\r\n      fields.push(`潁?춮 ${candidate.vertical.size}@${candidate.vertical.pitchMm}`)\r\n    }\r\n    if (candidate.horizontal) {\r\n      fields.push(\r\n        `與ょ춮 ${candidate.horizontal.size}@${candidate.horizontal.pitchMm}`,\r\n      )\r\n    }\r\n  }\r\n  if (candidate.kind === '佯딀씮') {\r\n    if (candidate.thickness !== undefined) {\r\n      fields.push(`?욕럻 ${candidate.thickness}`)\r\n    }\r\n    for (const [label, side] of [\r\n      ['??씌', candidate.shortSide],\r\n      ['?룩씌', candidate.longSide],\r\n    ] as const) {\r\n      if (side?.top) fields.push(`${label}訝?${side.top.size}@${side.top.pitchMm}`)\r\n      if (side?.bottom) {\r\n        fields.push(`${label}訝?${side.bottom.size}@${side.bottom.pitchMm}`)\r\n      }\r\n    }\r\n  }\r\n  return fields\r\n}\r\n\r\nfunction cloneSourceSummary(source: ImportableSection): string {\r\n  const offset =\r\n    source.kind === '??\r\n      ? source.hoop.startOffsetMm\r\n      : source.kind === '鸚㎪쥈'\r\n        ? source.stirrup.startOffsetMm\r\n        : source.kind === '?먬쐡鶯?\r\n          ? source.vertical.startOffsetMm\r\n          : source.x.top.startOffsetMm\r\n  const exposure = source.kind === '佯딀씮' ? '' : `${source.exposure}/`\r\n  return `fc${source.fc}??{source.grade}??{exposure}${source.finish}?삣닜?잆궕?뺛궩?껁깉${offset}mm`\r\n}\r\n\r\nfunction Candidate({\r\n  row,\r\n  ignored,\r\n  slabDirection,\r\n  girderDirection,\r\n  onIgnore,\r\n  onSlabDirectionChange,\r\n  onGirderDirectionChange,\r\n  onApply,\r\n}: {\r\n  row: CandidateRow\r\n  ignored: boolean\r\n  slabDirection?: SlabDirection\r\n  girderDirection?: GirderDirection\r\n  onIgnore(): void\r\n  onSlabDirectionChange(direction: SlabDirection | undefined): void\r\n  onGirderDirectionChange(direction: GirderDirection | undefined): void\r\n  onApply(): void\r\n}) {\r\n  const { candidate } = row\r\n  const project = useAppStore(({ project }) => project)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const existing = matchingSection(project, candidate)\r\n  const source = existing ? undefined : cloneSource(project, candidate)\r\n  const automaticDirection = automaticGirderDirection(project, candidate)\r\n  const resolvedDirection =\r\n    girderDirection ?? automaticDirection\r\n  const incomplete =\r\n    !existing &&\r\n    missingParsedFields(candidate, slabDirection, resolvedDirection)\r\n  const directionMissing =\r\n    (candidate.kind === '佯딀씮' && slabDirection === undefined) ||\r\n    (candidate.girderMainAsymmetric !== undefined &&\r\n      resolvedDirection === undefined)\r\n  const story = candidate.storyLabel ?? t(locale, 'sectionImport.noStory')\r\n  // ?뚯꽌???댁뒋 肄붾뱶留??ｋ뒗????臾몄옣? ?ш린??locale濡??쇰떎\r\n  const issueMessages = candidate.issues.map((issue) =>\r\n    t(locale, `sectionImport.issue.${issue}`),\r\n  )\r\n  const issueText = issueMessages.join('\\n')\r\n\r\n  return (\r\n    <li\r\n      className={styles.candidate}\r\n      data-testid={`section-import-candidate-${candidate.mark}-${candidate.storyLabel ?? 'none'}`}\r\n      hidden={ignored}\r\n    >\r\n      <div className={styles.candidateHeading}>\r\n        <strong>{candidate.mark}</strong>\r\n        <span>{story}</span>\r\n      </div>\r\n      <dl className={styles.diff}>\r\n        <div>\r\n          <dt>{t(locale, 'sectionImport.current')}</dt>\r\n          <dd>\r\n            {existing\r\n              ? sectionSummary(existing)\r\n              : t(locale, 'sectionImport.new')}\r\n          </dd>\r\n        </div>\r\n        <div>\r\n          <dt>{t(locale, 'sectionImport.parsed')}</dt>\r\n          <dd>{candidateFields(candidate, locale).join(' / ') || '??}</dd>\r\n        </div>\r\n      </dl>\r\n      {Object.keys(candidate.raw).length > 0 ? (\r\n        <div className={styles.raw} title={issueText || undefined}>\r\n          {Object.entries(candidate.raw).map(([label, value]) => (\r\n            <span key={label}>\r\n              {label}: {value}\r\n            </span>\r\n          ))}\r\n        </div>\r\n      ) : null}\r\n      {issueMessages.length > 0 ? (\r\n        <ul className={styles.issues}>\r\n          {issueMessages.map((issue) => (\r\n            <li key={issue}>{issue}</li>\r\n          ))}\r\n        </ul>\r\n      ) : null}\r\n      {!existing && source && incomplete ? (\r\n        <p className={styles.cloneNotice}>\r\n          {t(locale, 'sectionImport.incomplete')}\r\n        </p>\r\n      ) : null}\r\n      {!existing && source && !incomplete ? (\r\n        <>\r\n          <p className={styles.cloneNotice}>\r\n            {t(locale, 'sectionImport.clonePrefix')}\r\n            {sectionMarkLabel(source)}\r\n            {`竊?{cloneSourceSummary(source)}竊?}\r\n            {t(locale, 'sectionImport.cloneSuffix')}\r\n          </p>\r\n          <p className={styles.cloneNotice}>\r\n            {t(locale, 'sectionImport.newSectionUnassigned')}\r\n          </p>\r\n        </>\r\n      ) : null}\r\n      {candidate.kind === '佯딀씮' ? (\r\n        <div className={styles.directionChoice}>\r\n          <label htmlFor={`section-import-slab-direction-${row.id}`}>\r\n            {t(locale, 'sectionImport.slabDirection')}\r\n          </label>\r\n          <select\r\n            id={`section-import-slab-direction-${row.id}`}\r\n            data-testid={`section-import-slab-direction-${candidate.mark}`}\r\n            value={slabDirection ?? ''}\r\n            onChange={(event) => {\r\n              const value = event.currentTarget.value\r\n              onSlabDirectionChange(value === 'x' || value === 'y' ? value : undefined)\r\n            }}\r\n          >\r\n            <option value=\"\">\r\n              {t(locale, 'sectionImport.slabDirectionPlaceholder')}\r\n            </option>\r\n            <option value=\"x\">\r\n              {t(locale, 'sectionImport.slabDirection.shortToX')}\r\n            </option>\r\n            <option value=\"y\">\r\n              {t(locale, 'sectionImport.slabDirection.shortToY')}\r\n            </option>\r\n          </select>\r\n        </div>\r\n      ) : null}\r\n      {candidate.kind === '鸚㎪쥈' && candidate.girderMainAsymmetric ? (\r\n        <div className={styles.directionChoice}>\r\n          <label htmlFor={`section-import-girder-direction-${row.id}`}>\r\n            {t(locale, 'sectionImport.girderDirection')}\r\n          </label>\r\n          <select\r\n            id={`section-import-girder-direction-${row.id}`}\r\n            data-testid={`section-import-girder-direction-${candidate.mark}`}\r\n            value={resolvedDirection ?? ''}\r\n            onChange={(event) => {\r\n              const value = event.currentTarget.value\r\n              onGirderDirectionChange(\r\n                value === 'first' || value === 'second' ? value : undefined,\r\n              )\r\n            }}\r\n          >\r\n            <option value=\"\">\r\n              {t(locale, 'sectionImport.girderDirectionPlaceholder')}\r\n            </option>\r\n            <option value=\"first\">\r\n              {candidate.girderMainAsymmetric.labels[0]}=冶뗧ク\r\n            </option>\r\n            <option value=\"second\">    }\r\n\r\n                  <details\r\n                    className={styles.outOfScope}\r\n                    data-testid=\"section-import-out-of-scope\"\r\n                  >\r\n                    <summary>\r\n                      {t(locale, 'sectionImport.outOfScope')} ({outOfScope.length})\r\n                    </summary>\r\n                    <ul className={styles.candidateList}>\r\n                      {outOfScope.map((row) => (\r\n                        <li\r\n                          key={row.id}\r\n                          className={styles.candidate}\r\n                          data-testid={`section-import-candidate-${row.candidate.mark}-${row.candidate.storyLabel ?? 'none'}`}\r\n                        >\r\n                          <div className={styles.candidateHeading}>\r\n                            <strong>{row.candidate.mark}</strong>\r\n                            <span>\r\n                              {row.candidate.storyLabel ??\r\n                                t(locale, 'sectionImport.noStory')}\r\n                            </span>\r\n                          </div>\r\n                          <p>\r\n                            {candidateFields(row.candidate, locale).join(' / ') ||\r\n                              '??}\r\n                          </p>\r\n                        </li>\r\n                      ))}\r\n                    </ul>\r\n                  </details>\r\n                ) : null}\r\n              </>\r\n            )}\r