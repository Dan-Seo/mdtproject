nSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\ntype SlabDirection = 'x' | 'y'\r\ntype GirderDirection = 'first' | 'second'\r\n\r\n/**\r\n * ?똜2塋?띲겗?덀걝?よ뻗?띴퍡?띲꺀?쇻꺂?졼걨?믦눎?뺝?恙쒌겗野얕괌?ャ걲?뗣귛쨼塋?꺕?끿ク??\r\n * Grid??꺀?쇻꺂?ⓨ겤?뜸??담걮?╉굚?곮뻗?띲겏?쀣겍鰲ｉ뇠?쀣겍??겒?됥겒??(ADR-033) ??\r\n */\r\nfunction axisNameFromEndLabel(label: string): string | undefined {\r\n  const value = compact(label)\r\n  if (!value.endsWith('塋?)) return undefined\r\n  const axisName = value.slice(0, -1)\r\n  return axisName === '' || axisName === '鸚? || axisName === '??\r\n    ? undefined\r\n    : axisName\r\n}\r\n\r\n/**\r\n * ??씊?ゃ궧?덀겗塋?깿?⒲깧?ャ겏?뚣걯邕멥겗Grid?⒲깧?ャ걣訝→뼶誤뗣겇?뗣겂?잆겏?띲걽?묆?\r\n * 邕멥궎?녈깈?껁궚?밤겗鵝롢걚?담굮冶뗧ク?ャ걲?뗣귝캈雍껁겗訝↑씌??compact() ?믧싥걲 ??\r\n * framing-plan ?담굚?뚣걯閭ｈ쫸?뽧굮鵝욍걝?잆굙?곥걪?뚣겘?뉐춻?쀣겗若뚦뀲訝?담겎?귙겂??\r\n * ?꾨㈃ 諛⑺뼢??異붿젙?섎뒗 ?대━?ㅽ떛???꾨땲??(ADR-033) ??\r\n */\r\nfunction automaticGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): GirderDirection | undefined {\r\n  const asymmetric = candidate.girderMainAsymmetric\r\n  if (!asymmetric) return undefined\r\n\r\n  const axisNames = asymmetric.labels.map(axisNameFromEndLabel)\r\n  if (axisNames.some((axisName) => axisName === undefined)) return undefined\r\n\r\n  for (const labels of [project.grid.xLabels, project.grid.yLabels]) {\r\n    if (!labels) continue\r\n    const indexes = axisNames.map((axisName) =>\r\n      labels.findIndex((label) => compact(label) === axisName),\r\n    )\r\n    if (indexes.every((index) => index >= 0) && indexes[0] !== indexes[1]) {\r\n      return indexes[0] < indexes[1] ? 'first' : 'second'\r\n    }\r\n  }\r\n  return undefined\r\n}\r\n\r\nfunction resolvedGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  selected?: GirderDirection,\r\n): GirderDirection | undefined {\r\n  return selected ?? automaticGirderDirection(project, candidate)\r\n}\r\n\r\nfunction isImportableSection(section: Section): section is ImportableSection {\r\n  return (\r\n    section.kind === '?? ||\r\n    section.kind === '鸚㎪쥈' ||\r\n    section.kind === '?먬쐡鶯? ||\r\n    section.kind === '佯딀씮'\r\n  )\r\n}\r\n\r\nfunction matchingSection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  return project.sections\r\n    .filter(isImportableSection)\r\n    .find(\r\n      (section) =>\r\n        section.mark === candidate.mark &&\r\n        section.kind === candidate.kind &&\r\n        section.storyLabel === candidate.storyLabel,\r\n    )\r\n}\r\n\r\nfunction cloneSource(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  const sameKind = project.sections\r\n    .filter(isImportableSection)\r\n    .filter((section) => section.kind === candidate.kind)\r\n  // 媛숈? 寧?뤇???ㅻⅨ ?롪? ?대? ?덉쑝硫?洹몄そ??蹂듭젣?먯씠?????뚯떛?섏? ?딅뒗\r\n  // fc쨌媛뺤쥌쨌?몄텧쨌餓뺜툓?뮻룟닜?잆궕?뺛궩?껁깉? 臾닿???遺?щ낫??媛숈? 寧?뤇 履쎌씠 留욌떎\r\n  return (\r\n    sameKind.find((section) => section.mark === candidate.mark) ?? sameKind[0]\r\n  )\r\n}\r\n\r\n/**\r\n * ?좉퇋 寧?뤇??紐⑤뱺 諛곌렐쨌?⑤㈃ 移몄씠 ?뚯떛?먯쓣 ?뚮쭔 諛섏쁺???덉슜?쒕떎 ??鍮덉뭏??臾닿???\r\n * 遺?ъ쓽 蹂듭젣媛믪쑝濡?梨꾩썙 臾쇰웾???ｌ쑝硫??뚯꽌媛 吏???뚯??대궡吏 ?딅뒗?ㅳ?ADR-012)媛\r\n * UI?먯꽌 臾대꼫吏꾨떎. 湲곗〈 Section?먮뒗 鍮덉뭏??湲곗〈媛??좎????대떦?섏? ?딅뒗??\r\n */\r\nfunction missingParsedFields(\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  girderDirection?: GirderDirection,\r\n): boolean {\r\n  if (candidate.kind === '??) {\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.d === undefined ||\r\n      candidate.main === undefined ||\r\n      candidate.hoop === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '鸚㎪쥈') {\r\n    const mainAvailable =\r\n      candidate.girderMain !== undefined ||\r\n      (candidate.girderMainAsymmetric !== undefined &&\r\n        girderDirection !== undefined)\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.depth === undefined ||\r\n      !mainAvailable ||\r\n      candidate.stirrup === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    return (\r\n      candidate.thickness === undefined ||\r\n      candidate.layers === undefined ||\r\n      candidate.vertical === undefined ||\r\n      candidate.horizontal === undefined\r\n    fireEvent.click(within(row).getByRole('button', { name: '?띷삝' }))\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(\r\n        ({ mark, storyLabel }) => mark === 'G55' && storyLabel === 'R??,\r\n      )\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected imported 鸚㎪쥈 section')\r\n    expect(section.main.top).toMatchObject({\r\n      startCount: 8,\r\n      centerCount: 5,\r\n      endCount: 4,\r\n    })\r\n  })\r\n\r\n  it('requires a manual 冶뗧ク choice when Grid has no matching labels', () => {\r\n    render(<SectionImport initialPages={[yokohamaGirderPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-G55-R??)\r\n    const direction = within(row).getByTestId(\r\n      'section-import-girder-direction-G55',\r\n    )\r\n    expect(direction).toHaveValue('')\r\n    expect(row).not.toHaveTextContent('?싥굤??꺀?쇻꺂??젂佯뤵겎?ゅ땿黎뷴츣')\r\n    expect(within(row).getByRole('button', { name: '?띷삝' })).toBeDisabled()\r\n\r\n    fireEvent.change(direction, { target: { value: 'second' } })\r\n    expect(within(row).getByRole('button', { name: '?띷삝' })).not.toBeDisabled()\r\n    fireEvent.click(within(row).getByRole('button', { name: '?띷삝' }))\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(\r\n        ({ mark, storyLabel }) => mark === 'G55' && storyLabel === 'R??,\r\n      )\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected imported 鸚㎪쥈 section')\r\n    expect(section.main.top).toMatchObject({\r\n      startCount: 8,\r\n      centerCount: 5,\r\n      endCount: 4,\r\n    })\r\n  })\r\n\r\n  it('does not auto-resolve 鸚뽫ク/?끿ク labels and applies cutoff with manual choice', () => {\r\n    const base = createSampleProject()\r\n    useAppStore.setState({\r\n      project: {\r\n        ...base,\r\n        grid: { ...base.grid, xLabels: ['鸚?, '??] },\r\n      },\r\n    })\r\n    render(<SectionImport initialPages={[yokohamaGirderPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-G51-R??)\r\n    const direction = within(row).getByTestId(\r\n      'section-import-girder-direction-G51',\r\n    )\r\n    expect(direction).toHaveValue('')\r\n    expect(row).not.toHaveTextContent('?싥굤??꺀?쇻꺂??젂佯뤵겎?ゅ땿黎뷴츣')\r\n    expect(within(row).getByRole('button', { name: '?띷삝' })).toBeDisabled()\r\n\r\n    fireEvent.change(direction, { target: { value: 'first' } })\r\n    fireEvent.click(within(row).getByRole('button', { name: '?띷삝' }))\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(\r\n        ({ mark, storyLabel }) => mark === 'G51' && storyLabel === 'R??,\r\n      )\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected imported 鸚㎪쥈 section')\r\n    expect(section.main).toMatchObject({\r\n      size: 'D25',\r\n      top: { startCount: 8, centerCount: 8, endCount: 13 },\r\n      bottom: { startCount: 8, centerCount: 8, endCount: 11 },\r\n      cutoffFromSupportFaceMm: 2500,\r\n    })\r\n  })\r\n\r\n  it('applies asymmetric fields and preserves other existing story-scoped values', () => {\r\n    const base = createSampleProject()\r\n    useAppStore.setState({\r\n      project: {\r\n        ...base,\r\n        sections: [\r\n          ...base.sections,\r\n          {\r\n            id: 'section-G51-RF',\r\n            kind: '鸚㎪쥈',\r\n            mark: 'G51',\r\n            storyLabel: 'R??,\r\n            b: 500,\r\n            depth: 700,\r\n            fc: 24,\r\n            grade: 'SD345',\r\n            exposure: '掠뗥냵',\r\n            finish: '餓뺜툓?믡걗??,\r\n            spliceMethod: '?띲겖泳숁뎸',\r\n            main: {\r\n              size: 'D22',\r\n              top: { endCount: 4, centerCount: 4 },\r\n              bottom: { endCount: 4, centerCount: 4 },\r\n              cutoffFromSupportFaceMm: 1500,\r\n            },\r\n            stirrup: { size: 'D10', pitch: 150, startOffsetMm: 50 },\r\n          },\r\n        ],\r\n      },\r\n    })\r\n    render(<SectionImport initialPages={[yokohamaGirderPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-G51-R??)\r\n    fireEvent.change(\r\n      within(row).getByTestId('section-import-girder-direction-G51'),\r\n      { target: { value: 'first' } },\r\n    )\r\n    fireEvent.click(within(row).getByRole('button', { name: '?띷삝' }))\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(\r\n        ({ mark, storyLabel }) => mark === 'G51' && storyLabel === 'R??,\r\n      )\r\n    expect(section?.kind).toBe('鸚㎪쥈')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected existing 鸚㎪쥈 section')\r\n    expect(section).toMatchObject({\r\n      b: 650,\r\n      depth: 800,\r\n      // 鍮꾨?移?訝사춮? ?섎룞?쇰줈 冶뗧ク???뺥븳 ??諛섏쁺?쒕떎.\r\n      main: {\r\n        size: 'D25',\r\n        top: { startCount: 8, centerCount: 8, endCount: 13 },\r\n        bottom: { startCount: 8, centerCount: 8, endCount: 11 },\r\n        cutoffFromSupportFaceMm: 2500,\r\n      },\r\n      stirrup: { size: 'D13', pitch: 100, startOffsetMm: 50 },\r\n    })\r\n  })\r\n\r\n  it('applies ojkk ?밭춮 and 亮끾??곭춮 onto an existing 鸚㎪쥈 section', () => {\r\n    const base = createSampleProject()\r\n    useAppStore.setState({\r\n      project: {\r\n        ...base,\r\n        sections: base.sections.map((section) => {\r\n          if (section.kind !== '鸚㎪쥈' || section.mark !== 'G1') return section\r\n          const next = { ...section, storyLabel: 'RF' }\r\n          delete next.sideBar\r\n          delete next.widthTie\r\n          return next\r\n        }),\r\n      },\r\n    })\r\n    render(<SectionImport initialPages={[ojkkGirderPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-G1-RF')\r\n    expect(row).toHaveTextContent('?밭춮 2-D10')\r\n    expect(row).toHaveTextContent('亮끾??곭춮 D10@1000')\r\n    fireEvent.click(within(row).getByRole('button', { name: '?띷삝' }))\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(\r\n        ({ mark, storyLabel }) => mark === 'G1' && storyLabel === 'RF',\r\n      )\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected imported 鸚㎪쥈 section')\r\n    expect(section.sideBar).toEqual({\r\n      size: 'D10',\r\n      count: 2,\r\n      extraLengthMm: 0,\r\n    })\r\n    expect(section.widthTie).toEqual({ size: 'D10', pitch: 1000 })\r\n  })\r\n\r\n  it('keeps the entered ?밭춮 鵝숅빓 while updating parsed size and count', () => {\r\n    const base = createSampleProject()\r\n    useAppStore.setState({\r\n      project: {\r\n        ...base,\r\n        sections: base.sections.map((section) =>\r\n          section.kind === '鸚㎪쥈' && section.mark === 'G1'\r\n            ? {\r\n                ...section,\r\n                storyLabel: 'RF',\r\n                sideBar: {\r\n                  size: 'D13',\r\n                  count: 4,\r\n                  extraLengthMm: 120,\r\n                },\r\n              }\r\n            : section,\r\n        ),\r\n      },\r\n    })\r\n    render(<SectionImport initialPages={[ojkkGirderPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-G1-RF')\r\n    fireEvent.click(within(row).getByRole('button', { name: '?띷삝' }))\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(\r\n        ({ mark, storyLabel }) => mark === 'G1' && storyLabel === 'RF',\r\n      )\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected imported 鸚㎪쥈 section')\r\n    expect(section.sideBar).toEqual({\r\n      size: 'D10',\r\n      count: 2,\r\n      extraLengthMm: 120,\r\n    })\r\n  })\r\n\r\n  it('ignores a stale extraction that resolves after a newer file', async () => {\r\n    let resolveSlow!: (pages: TextPage[]) => void\r\n    const slow = new Promise<TextPage[]>((resolve) => {\r\n      resolveSlow = resolve\r\n    })\r\n    const extractPages = vi\r\n      .fn<(file: File) => Promise<TextPage[]>>()\r\n      .mockReturnValueOnce(slow)\r\n      .mockResolvedValueOnce([{ widthPt: 100, heightPt: 100, items: [] }])\r\n    render(<SectionImport extractPages={extractPages} />)\r\n    const input = screen.getByTestId('section-import-file')\r\n\r\n    fireEvent.change(input, {\r\n      target: {\r\n        files: [new File(['a'], 'slow.pdf', { type: 'application/pdf' })],\r\n      },\r\n    })\r\n    fireEvent.change(input, {\r\n      target: {\r\n        files: [new File(['b'], 'fast.pdf', { type: 'application/pdf' })],\r\n      },\r\n    })\r\n\r\n    expect(\r\n      await screen.findByText('沃띹춼?㎯걤?뗦뼪?㏂꺁?밤깉?뚩쫳?ㅳ걢?듽겲?쎼굯'),\r\n    ).toBeVisible()\r\n\r\n    // 癒쇱? 怨좊Ⅸ ?뚯씪????쾶 ?앸굹???섏쨷 ?뚯씪??寃곌낵瑜???? ?딅뒗??\r\n    await act(async () => {\r\n      resolveSlow([yokohamaPage])\r\n      await slow\r\n    })\r\n    expect(\r\n      screen.queryByTestId('section-import-candidate-C51-2??),\r\n    ).toBeNull()\r\n    expect(\r\n      screen.getByText('沃띹춼?㎯걤?뗦뼪?㏂꺁?밤깉?뚩쫳?ㅳ걢?듽겲?쎼굯'),\r\n    ).toBeVisible()\r\n  })\r\n\r\n  it('renders parser issues through the locale layer', () => {\r\n    // ?뚯꽌???댁뒋 肄붾뱶留??ｋ뒗????ko ?ъ슜?먯뿉寃??쇰낯???꾩꽦 臾몄옣???몄텧?섎㈃ ???쒕떎\r\n    useAppStore.setState({ locale: 'ko' })\r\n    render(<SectionImport initialPages={[yokohamaGirderPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-G51-R??)\r\n    expect(row).toHaveTextContent(\r\n      '?묐떒??訝사춮???쒕줈 ?щ씪 ?대뒓 履쎌씠 ?쒖옉?⑥씤吏 ?뺥븷 ???놁뼱 鍮덉뭏?쇰줈 ?먯뿀?듬땲??',\r\n    )\r\n  })\r\n\r\n  it('does not offer approval for 野얕괌鸚?candidates', () => {\r\n    render(<SectionImport initialPages={[yokohamaPage]} />)\r\n\r\n    const group = screen.getByTestId('section-import-out-of-scope')\r\n    const row = within(group).getByTestId('section-import-candidate-B51-none')\r\n    expect(row).toHaveTextContent('B51')\r\n    expect(within(row).queryByRole('button', { name: '?띷삝' })).toBeNull()\r\n  })\r\n\r\n  it('ignores one candidate without changing Project', () => {\r\n    const before = useAppStore.getState().project\r\n    render(<SectionImport initialPages={[yokohamaPage]} />)\r\n\r\n    const row = screen.getByTestId('section-import-candidate-C52-2??)\r\n    fireEvent.click(within(row).getByRole('button', { name: '?↑쫿' }))\r\n\r\n    expect(row).not.toBeVisible()\r\n    expect(useAppStore.getState().project).toBe(before)\r\n  })\r\n\r\n  it('shows a non-throwing empty result when no section list is found', () => {\r\n    render(\r\n      <SectionImport\r\n        initialPages={[{ widthPt: 100, heightPt: 100, items: [] }]}\r\n      />,\r\n    )\r\n\r\n    expect(\r\n      screen.getByText('沃띹춼?㎯걤?뗦뼪?㏂꺁?밤깉?뚩쫳?ㅳ걢?듽겲?쎼굯'),\r\n    ).toBeVisible()\r\n  })\r\n\r\n  it('distinguishes a recognized list with no 寧?뤇 row from no list at all', () => {\r\n    render(<SectionImport initialPages={[headerlessPage]} />)\r\n\r\n    // ?뚮━?ㅽ듃 ?먯껜媛 ?녿떎?띿? ?뚮━?ㅽ듃??李얠븯吏留?寧?뤇 ?됱쓣 紐??쎌뿀?ㅳ띾뒗\r\n    // ?ъ슜?먭? ???쇱씠 ?ㅻⅤ?????꾩옄???먮룄??洹??쒕? ?뺤씤?섎㈃ ?쒕떎\r\n    expect(\r\n      screen.getByText(/寧?뤇??죱?믦첀鈺섅겎?띲겲?쎼굯?㎯걮??),\r\n    ).toHaveTextContent('?길뼪?㏂꺁?밤깉')\r\n    expect(\r\n      screen.queryByText('沃띹춼?㎯걤?뗦뼪?㏂꺁?밤깉?뚩쫳?ㅳ걢?듽겲?쎼굯'),\r\n    ).toBeNull()\r\n  })\r\n\r\n  it('applies 塋?깿轝?as 鵝띸쉰??訝사춮?ф빊 onto the 鸚㎪쥈 section', () => {\r\n    render(\r\n      <SectionImport\r\n        initialPages={[\r\n          {\r\n            widthPt: 480,\r\n            heightPt: 240,\r\n            items: [\r\n              { str: '鸚㎪쥈?ゃ궧??, x: 10, y: 5, w: 60, h: 8 },\r\n              { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n              { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n              { str: '鵝띸쉰', x: 10, y: 32, w: 20, h: 8 },\r\n              { str: '塋?깿', x: 90, y: 32, w: 20, h: 8 },\r\n 