s,\r\n    sections: [columnSection, ...girderSections, wallSection, slabSection],\r\n    members: sampleStories.flatMap(({ id }) => [\r\n      ...createColumns(id),\r\n      ...createGirders(id),\r\n      ...createWalls(id),\r\n      ...createSlabs(id),\r\n    ]),\r\n  }\r\n}\r\n--- current wall labels in SectionTable tests ---\r\n--- current locales complete first 70 ---\r\n{\r\n  \"app.wordmark\": \"Kijun 基準\",\r\n  \"pane.plan\": \"平面エディタ\",\r\n  \"pane.section\": \"部材断面一覧\",\r\n  \"pane.viewer\": \"3Dビュー\",\r\n  \"pane.takeoff\": \"数量内訳書\",\r\n  \"pane.failure\": \"このペインを表示できません — 入力を見直してください。\",\r\n  \"sectionImport.open\": \"PDF取込\",\r\n  \"sectionImport.file\": \"断面リストPDF\",\r\n  \"sectionImport.title\": \"断面リスト取込候補\",\r\n  \"sectionImport.chooseAnother\": \"別のPDFを選択\",\r\n  \"sectionImport.close\": \"閉じる\",\r\n  \"sectionImport.loading\": \"PDFをブラウザ内で解析しています\",\r\n  \"sectionImport.error\": \"PDFを読み込めませんでした — 別のPDFを選択してください\",\r\n  \"sectionImport.empty\": \"認識できる断面リストが見つかりません\",\r\n  \"sectionImport.listIssue.符号行未認識\": \"断面リストの見出しは見つかりましたが、符号の行を認識できませんでした（原図を参照）\",\r\n  \"sectionImport.listIssue.項目行未認識\": \"符号は読み取れましたが、断面・主筋・帯筋などの項目の行を認識できませんでした（原図を参照）\",\r\n  \"sectionImport.current\": \"現行値\",\r\n  \"sectionImport.parsed\": \"解析値\",\r\n  \"sectionImport.new\": \"新規\",\r\n  \"sectionImport.noStory\": \"階指定なし\",\r\n  \"sectionImport.apply\": \"反映\",\r\n  \"sectionImport.ignore\": \"無視\",\r\n  \"sectionImport.clonePrefix\": \"未解析の欄は\",\r\n  \"sectionImport.cloneSuffix\": \"から複製\",\r\n  \"sectionImport.incomplete\": \"未解析の欄がある新規符号は反映できません（原文を参照）\",\r\n  \"sectionImport.newSectionUnassigned\": \"追加された符号はまだどの部材にも割り当てられていません（数量・3Dに未反映）\",\r\n  \"sectionImport.field.sideBar\": \"腹筋\",\r\n  \"sectionImport.field.widthTie\": \"幅止め筋\",\r\n  \"sectionImport.slabDirection\": \"短辺の方向\",\r\n  \"sectionImport.slabDirectionPlaceholder\": \"方向を選択\",\r\n  \"sectionImport.slabDirection.shortToX\": \"短辺=X方向\",\r\n  \"sectionImport.slabDirection.shortToY\": \"短辺=Y方向\",\r\n  \"