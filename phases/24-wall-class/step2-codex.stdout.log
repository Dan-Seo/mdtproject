is=\"x\"\r\n1021-                    />\r\n1022-                  ) : (\r\n1023-                    <GirderMainField\r\n1024-                      section={section}\r\n1025-                      update={updateCurrent}\r\n1026-                    />\r\n1027-                  )}\r\n1028-                </td>\r\n1029-                <td>\r\n1030-                  <ShearField section={section} update={updateCurrent} />\r\n1031-                </td>\r\n1032-                <td>\r\n1033:                  {section.kind === '大梁' ? (\r\n1034-                    <GirderDetailField\r\n1035-                      section={section}\r\n1036-                      update={updateCurrent}\r\n1037-                    />\r\n1038:                  ) : section.kind === '耐震壁' ? (\r\n1039:                    <WallLayersField\r\n1040-                      section={section}\r\n1041-                      update={updateCurrent}\r\n1042-                    />\r\n1043-                  ) : (\r\n1044-                    // 柱には置かない配筋なので、空欄ではなく「対象外」と示す。\r\n1045-                    <span className={styles.notApplicable}>—</span>\r\n1046-                  )}\r\n1047-                </td>\r\n--\n1071-                      updateCurrent((current) => ({\r\n1072-                        ...current,\r\n1073-                        spliceMethod,\r\n1074-                      }))\r\n1075-                    }\r\n1076-                  />\r\n1077-                </td>\r\n1078-                <td>\r\n1079:                  <CoverConditionField\r\n1080-                    section={section}\r\n1081-                    update={updateCurrent}\r\n1082-                  />\r\n1083-                </td>\r\n1084-              </tr>\r\n1085-            )\r\n1086-          })}\r\n1087-        </tbody>\r\n--- SectionTable tail ---\r\n              ...current,\r\n              // ピッチは断面一覧の入力だ (ADR-012)。規準に幅止め筋のピッチはなく、\r\n              // あばら筋の値を借りれば利用者が入れていない数字が 1通則7) の\r\n              // 割付本数に入ってしまう。0 ＝ 未入力としてカットオフ位置と同じく