AR_SIZES\r\n\r\nconst shearBarSizes: readonly ShearBarSize[] = SHEAR_BAR_SIZES\r\n\r\nconst columnShapes: readonly ColumnShape[] = ['?⒴숱', '?녶숱']\r\n\r\nconst steelGrades: SteelGrade[] = ['SD295', 'SD345', 'SD390']\r\n\r\nconst spliceMethods: readonly SpliceMethod[] = SPLICE_METHODS\r\n\r\nconst exposures: Exposure[] = ['掠뗥냵', '掠뗥쨼']\r\n\r\nconst finishes: Finish[] = ['餓뺜툓?믡걗??, '餓뺜툓?믡겒??]\r\n\r\nfunction replaceSection(\r\n  project: Project,\r\n  sectionId: string,\r\n  updater: (section: Section) => Section,\r\n): Project {\r\n  return {\r\n    ...project,\r\n    sections: project.sections.map((section) =>\r\n      section.id === sectionId ? updater(section) : section,\r\n    ),\r\n  }\r\n}\r\n\r\nfunction boundedNumber(value: string, minimum: number): number | null {\r\n  // Number('')??0?대떎 ???섑븳??0???꾨뱶?먯꽌 鍮?媛믪씠 ?듦낵?섎㈃ 吏?곕뒗 ?쒓컙\r\n  // ?ф빊(=臾쇰웾)媛 0 ?ㅽ봽?뗭쑝濡???씤??\r\n  if (value.trim() === '') return null\r\n\r\n  const parsed = Number(value)\r\n  return Number.isFinite(parsed) && parsed >= minimum ? parsed : null\r\n}\r\n\r\nfunction NumberInput({\r\n  label,\r\n  value,\r\n  onChange,\r\n  // 移섏닔쨌?붵긿?겶룡쑍?곕뒗 0???깅┰?섏? ?딆?留??앮쐿?ゃ깢?삠긿?덉? 0???뺤긽媛믪씠??\r\n  minimum = 1,\r\n  // 亮끾??곭춮쨌?밭춮泥섎읆 ?뚣겒?쀣띻? ?깅┰?섎뒗 ??ぉ? 洹?諛곌렐???놁쓣 ???낅젰??留됰뒗??\r\n  // ?댁뼱 ?먮㈃ updater 媛 current 瑜?洹몃?濡??뚮젮以??낅젰???붿쟻 ?놁씠 ?щ씪吏꾨떎.\r\n  disabled = false,\r\n}: {\r\n  label: string\r\n  value: number\r\n  onChange(value: number): void\r\n  minimum?: number\r\n  disabled?: boolean\r\n}) {\r\n  return (\r\n    <input\r\n      className={styles.numberInput}\r\n      type=\"number\"\r\n      min={minimum}\r\n      step=\"1\"\r\n      value={value}\r\n      disabled={disabled}\r\n      aria-label={label}\r\n      onChange={(event) => {\r\n        const next = boundedNumber(event.currentTarget.value, minimum)\r\n        if (next !== null) onChange(next)\r\n      }}\r\n    />\r\n  )\r\n}\r\n\r\nfunction BarSizeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: BarSize\r\n  onChange(value: BarSize): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) => onChange(event.currentTarget.value as BarSize)}\r\n    >\r\n      {barSizes.map((size) => (\r\n        <option key={size} value={size}>\r\n          {size}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\n/**\r\n * ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ??푶?귚말嶺뗣겗?멩뒢?㏂겏?녴걢?뚣겍?꾠굥??겘??\r\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺?(K13?팗13) ?믢말嶺뗣겓?γ굦?됥굦?ゃ걚?뗣굢????訝사춮??츣???\r\n * ?띲겖泳숁뎸?믦〃5.3.4?삭〃5.3.2 ?뗣굢孃꾠겎凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??\r\n * 烏뚣걣?ゃ걚 (ADR-026)??\r\n */\r\nfunction ShearBarSizeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: ShearBarSize\r\n  onChange(value: ShearBarSize): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) => onChange(event.currentTarget.value as ShearBarSize)}\r\n    >\r\n      {shearBarSizes.map((size) => (\r\n        <option key={size} value={size}>\r\n          {size}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\n/**\r\n * 亮끾??곭춮쨌?밭춮? ??씊訝誤㏃뿉 ?놁쑝硫?洹?諛곌렐???녿뒗 寃껋씠?????뚣겒?쀣띾? 怨좊Ⅴ硫?\r\n * ?꾨뱶 ?먯껜瑜?吏?대떎. ?쒗뭹???덈뒗 ??移섍퀬 怨꾩긽?섏? ?딅뒗??(ADR-012).\r\n */\r\nfunction OptionalBarSizeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: BarSize | null\r\n  onChange(value: BarSize | null): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value ?? ''}\r\n      aria-label={label}\r\n      onChange={(event) => {\r\n        const next = event.currentTarget.value\r\n        onChange(next === '' ? null : (next as BarSize))\r\n      }}\r\n    >\r\n      <option value=\"\">?ゃ걮</option>\r\n      {barSizes.map((size) => (\r\n        <option key={size} value={size}>\r\n          {size}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction GradeSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: SteelGrade\r\n  onChange(value: SteelGrade): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) => onChange(event.currentTarget.value as SteelGrade)}\r\n    >\r\n      {steelGrades.map((grade) => (\r\n        <option key={grade} value={grade}>\r\n          {grade}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction SpliceMethodSelect({\r\n  label,\r\n  value,\r\n  onChange,\r\n}: {\r\n  label: string\r\n  value: SpliceMethod\r\n  onChange(value: SpliceMethod): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={value}\r\n      aria-label={label}\r\n      onChange={(event) =>\r\n        onChange(event.currentTarget.value as SpliceMethod)\r\n      }\r\n    >\r\n      {spliceMethods.map((method) => (\r\n        <option key={method} value={method}>\r\n          {method}\r\n        </option>\r\n      ))}\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction CoverConditionField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: Section\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      {/* 烏?.3.6 ??뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥띹죱??퍞訝듽걩??쐣?▲걽?묆겎?녴걢?뚣?\r\n          掠뗥냵?삣콏鸚뽧겗?뷴닪?믤똻?잆겒?????밤걢?ゃ걚?ㅳ겲?욍굮營?걢?ゃ걚 (ADR-028)??*/}\r\n      {section.kind === '佯딀씮' ? null : (\r\n      <select\r\n        className={styles.select}\r\n        value={section.exposure}\r\n        aria-label={`${sectionMarkLabel(section)} 掠뗥냵鸚?}\r\n        onChange={(event) => {\r\n          const exposure = event.currentTarget.value as Exposure\r\n          update((current) => ({ ...current, exposure }))\r\n        }}\r\n      >\r\n        {exposures.map((exposure) => (\r\n          <option key={exposure} value={exposure}>\r\n            {exposure}\r\n          </option>\r\n        ))}\r\n      </select>\r\n      )}\r\n      <select\r\n        className={styles.select}\r\n        value={section.finish}\r\n        aria-label={`${sectionMarkLabel(section)} 餓뺜툓??}\r\n        onChange={(event) => {\r\n          const finish = event.currentTarget.value as Finish\r\n          update((current) => ({ ...current, finish }))\r\n        }}\r\n      >\r\n        {finishes.map((finish) => (\r\n          <option key={finish} value={finish}>\r\n            {finish}\r\n          </option>\r\n        ))}\r\n                  if (asymmetric) nextRow.startCount ??= nextRow.endCount\r\n                  else delete nextRow.startCount\r\n                  return {\r\n                    ...current,\r\n                    main: { ...current.main, [row]: nextRow },\r\n                  }\r\n                })\r\n              }}\r\n            />\r\n            藥?뤂?㏝걬??\r\n          </label>\r\n        </div>\r\n      ))}\r\n      <BarSizeSelect\r\n        label={`${sectionMarkLabel(section)} 訝사춮 孃?}\r\n        value={section.main.size}\r\n        onChange={(size) =>\r\n          update((current) => {\r\n            if (current.kind !== '鸚㎪쥈') return current\r\n            return { ...current, main: { ...current.main, size } }\r\n          })\r\n        }\r\n      />\r\n      <div className={styles.compoundField}>\r\n        <span>?ャ긿?덀궕??/span>\r\n        <NumberInput\r\n          label={`${sectionMarkLabel(section)} ?ャ긿?덀궕?뺜퐤營?}\r\n          minimum={0}\r\n          value={section.main.cutoffFromSupportFaceMm}\r\n          onChange={(cutoffFromSupportFaceMm) =>\r\n            update((current) => {\r\n              if (current.kind !== '鸚㎪쥈') return current\r\n              return {\r\n                ...current,\r\n                main: { ...current.main, cutoffFromSupportFaceMm },\r\n              }\r\n            })\r\n          }\r\n        />\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗潁?춮?삥Ø嶺뗣귙겑?▲굢?귙뚦푶 @ ?붵긿??竊??앮쐿?ゃ깢?삠긿?덀띲겎壤㏂걣?뚣걯?ゃ겗??\r\n * 1?ㅳ겗?녈꺍?앫꺖?띲꺍?덀걣訝→뼶?믣룛?묉똻?ㅳ귙겑?▲굢??죱?뗣겘 `row` ?뚧군?곥굥??\r\n */\r\nfunction WallBarField({\r\n  section,\r\n  update,\r\n  row,\r\n}: {\r\n  section: WallSection\r\n  update(updater: (section: Section) => Section): void\r\n  row: 'vertical' | 'horizontal'\r\n}) {\r\n  const label = row === 'vertical' ? '潁?춮' : '與ょ춮'\r\n  const bar = section[row]\r\n  const replace = (patch: Partial<WallSection['vertical']>) =>\r\n    update((current) =>\r\n      current.kind === '?먬쐡鶯?\r\n        ? { ...current, [row]: { ...current[row], ...patch } }\r\n        : current,\r\n    )\r\n\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      <BarSizeSelect\r\n        label={`${sectionMarkLabel(section)} ${label} 孃?}\r\n        value={bar.size}\r\n        onChange={(size) => replace({ size })}\r\n      />\r\n      <span aria-hidden=\"true\">@</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?붵긿??}\r\n        value={bar.pitch}\r\n        onChange={(pitch) => replace({ pitch })}\r\n      />\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?앮쐿?ゃ깢?삠긿??}\r\n        minimum={0}\r\n        value={bar.startOffsetMm}\r\n        onChange={(startOffsetMm) => replace({ startOffsetMm })}\r\n      />\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * 佯딀씮??말嶺???1?밧릲?뜰굯??툓塋?춮?삡툔塋?춮?괱?밧릲?쮇?밧릲?㎩닪?끹겓?쀣걨?뽧굥??\r\n * 孃꾠굚?붵긿?곥굚??씊?ゃ궧?덀겗?ε뒟?㎯걗?ｃ겍誤뤸틬?ユ쑍?겹겗?→뻼??겒??(ADR-012)??\r\n */\r\nfunction SlabBarField({\r\n  section,\r\n  update,\r\n  axis,\r\n}: {\r\n  section: SlabSection\r\n  update(updater: (section: Section) => Section): void\r\n  axis: 'x' | 'y'\r\n}) {\r\n  const replace = (\r\n    face: 'top' | 'bottom',\r\n    patch: Partial<SlabBarRow>,\r\n  ): void =>\r\n    update((current) =>\r\n      current.kind === '佯딀씮'\r\n        ? {\r\n            ...current,\r\n            [axis]: {\r\n              ...current[axis],\r\n              [face]: { ...current[axis][face], ...patch },\r\n            },\r\n          }\r\n        : current,\r\n    )\r\n\r\n  return (\r\n    <div className={styles.slabBarField}>\r\n      {(['top', 'bottom'] as const).map((face) => {\r\n        const bar = section[axis][face]\r\n        const label = `${axis.toUpperCase()}?밧릲${face === 'top' ? '訝딁ク嶺? : '訝뗧ク嶺?}`\r\n\r\n        return (\r\n          <div key={face} className={styles.compoundField}>\r\n            <BarSizeSelect\r\n              label={`${sectionMarkLabel(section)} ${label} 孃?}\r\n              value={bar.size}\r\n              onChange={(size) => replace(face, { size })}\r\n            />\r\n            <span aria-hidden=\"true\">@</span>\r\n            <NumberInput\r\n              label={`${sectionMarkLabel(section)} ${label} ?붵긿??}\r\n              value={bar.pitch}\r\n              onChange={(pitch) => replace(face, { pitch })}\r\n            />\r\n            <NumberInput\r\n              label={`${sectionMarkLabel(section)} ${label} ?앮쐿?ゃ깢?삠긿??}\r\n              minimum={0}\r\n              value={bar.startOffsetMm}\r\n              onChange={(startOffsetMm) => replace(face, { startOffsetMm })}\r\n            />\r\n          </div>\r\n        )\r\n      })}\r\n    </div>\r\n  )\r\n}\r\n\r\n/**\r\n * ?띸춮掠ㅶ빊竊덀궥?녈궛?ワ폀??뽧꺂竊됥귝쑍?겹걣?앫겗?얇겲?띺걬?녴겗?ヨ쫸繹뽧겓?→뻼?뚣겒?뤵?\r\n * 鶯곥꺁?밤깉??쮼雍됥걹??굚??겎?귙굥 (ADR-012) ???졼걢?됪뿢若싧ㅳ굮營?걢?싮겦?겹걵?뗣?\r\n */\r\nfunction WallLayersField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: WallSection\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  return (\r\n    <select\r\n      className={styles.select}\r\n      value={String(section.layers)}\r\n      aria-label={`${sectionMarkLabel(section)} ?띸춮掠ㅶ빊`}\r\n      onChange={(event) => {\r\n        const layers = Number(event.currentTarget.value) === 2 ? 2 : 1\r\n        update((current) =>\r\n          current.kind === '?먬쐡鶯? ? { ...current, layers } : current,\r\n        )\r\n      }}\r\n    >\r\n      <option value=\"1\">?룔꺍?겹꺂</option>\r\n      <option value=\"2\">??뽧꺂</option>\r\n    </select>\r\n  )\r\n}\r\n\r\nfunction ShearField({\r\n  section,\r\n  update,\r\n}: {\r\n  section: Section\r\n  update(updater: (section: Section) => Section): void\r\n}) {\r\n  // 鶯곥겗?쎼굯??짒凉룔겓?귙걼?뗣겗??Ø嶺뗣걽?귙걪?볝걢?됧뀍??윶?삣ㄷ歟곥걽?묆걣?싥굥 ??\r\n  // 訝뗣겗 update ?녈꺖?ャ깘?껁궚?뚩먬쐡鶯곥굮榮좈싥걮?쇻굥??겘?앫겗?잆굙?㎯걗?뗣?\r\n  if (section.kind === '?먬쐡鶯?) {\r\n    return <WallBarField section={section} update={update} row=\"horizontal\" />\r\n  }\r\n\r\n  // 佯딀씮?ャ걵?볠뼪獒쒎섭嶺뗣겘?ゃ걚?귙걪??닓?ャ겘?귙걝訝?밤겗?묆걤??말嶺뗣굮營?걦 ??\r\n  // 令뷸쵂?ャ걲?뗣겏2?밧릲??걝?←뎴?밤걮?뗥뀯?쎼겎?띲겒?꾥〃?ャ겒?뗣?\r\n  if (section.kind === '佯딀씮') {\r\n    return <SlabBarField section={section} update={update} axis=\"y\" />\r\n  }\r\n\r\n  const reinforcement = section.kind === '?? ? section.hoop : section.stirrup\r\n  const label = section.kind === '?? ? '躍?춮' : '?귙겙?됬춮'\r\n\r\n  return (\r\n    <div className={styles.compoundField}>\r\n      <ShearBarSizeSelect\r\n        label={`${sectionMarkLabel(section)} ${label} 孃?}\r\n        value={reinforcement.size}\r\n        onChange={(size) =>\r\n          update((current) =>\r\n            current.kind === '??\r\n              ? { ...current, hoop: { ...current.hoop, size } }\r\n              : current.kind === '鸚㎪쥈'\r\n                ? { ...current, stirrup: { ...current.stirrup, size } }\r\n                : current,\r\n          )\r\n        }\r\n      />\r\n      <span aria-hidden=\"true\">@</span>\r\n      <NumberInput\r\n        label={`${sectionMarkLabel(section)} ${label} ?붵긿??}\r\n        value={reinforcement.pitch}\r\n        onChange={(pitch) =>\r\n          update((current) =>\r\n            current.kind === '??\r\n              ? { ...current, hoop: { ...current.hoop, pitch } }\r\n              : current.kind === '鸚㎪쥈'\r\n                ? { ...current, stirrup: { ...current.stirrup, pitch } }\r\n                : current,\r\n          )\r\n        }\r\n      />\r\n--- SectionImport apply regions ---\r\n\r\nimport {\r\n  useMemo,\r\n  useRef,\r\n  useState,\r\n  type ChangeEvent,\r\n} from 'react'\r\n\r\nimport {\r\n  sectionMarkLabel,\r\n  type ColumnSection,\r\n  type GirderSection,\r\n  type SlabSection,\r\n  type Section,\r\n  type WallSection,\r\n} from '@/domain/model/member'\r\nimport type { Project } from '@/domain/model/project'\r\nimport { extractTextPages } from '@/lib/import/pdf-text'\r\nimport { parseSectionLists } from '@/lib/import/section-list/parse'\r\nimport type {\r\n  ListIssue,\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from '@/lib/import/section-list/types'\r\nimport { t } from '@/lib/i18n'\r\nimport { compact } from '@/lib/import/runs'\r\nimport { useAppStore, type Locale } from '@/lib/store'\r\n\r\nimport styles from './SectionImport.module.css'\r\n\r\ninterface SectionImportProps {\r\n  /** pdf.js ?놁씠 TextPage ?쎌뒪泥섎? 二쇱엯?섎뒗 而댄룷?뚰듃 ?뚯뒪?몄슜 寃쎄퀎. */\r\n  initialPages?: TextPage[]\r\n  extractPages?(file: File): Promise<TextPage[]>\r\n}\r\n\r\ninterface CandidateRow {\r\n  id: string\r\n  candidate: SectionCandidate\r\n}\r\n\r\nfunction parsedCandidates(lists: ParsedSectionList[]): CandidateRow[] {\r\n  return lists.flatMap((list, listIndex) =>\r\n    list.candidates.map((candidate, candidateIndex) => ({\r\n      id: `${listIndex}-${candidateIndex}`,\r\n      candidate,\r\n    })),\r\n  )\r\n}\r\n\r\n/**\r\n * ?롫퀎 ?꾨낫媛 媛숈? Section????뼱?곕㈃ 癒쇱? 諛섏쁺??痢듭쓽 諛곌렐???щ씪吏꾨떎 ??留ㅼ묶 ?ㅻ뒗\r\n * (寧?뤇, ?ⓩ쓲, ???? ?롫? 寧?뤇??遺숈씠吏???딅뒗?? ?꾨㈃???녿뒗 寧?뤇???낁㉢?몄뿉 洹몃?濡?\r\n * ?섍?怨? ?낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n */\r\ntype ImportableSection =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\ntype SlabDirection = 'x' | 'y'\r\ntype GirderDirection = 'first' | 'second'\r\n\r\n/**\r\n * ?똜2塋?띲겗?덀걝?よ뻗?띴퍡?띲꺀?쇻꺂?졼걨?믦눎?뺝?恙쒌겗野얕괌?ャ걲?뗣귛쨼塋?꺕?끿ク??\r\n * Grid??꺀?쇻꺂?ⓨ겤?뜸??담걮?╉굚?곮뻗?띲겏?쀣겍鰲ｉ뇠?쀣겍??겒?됥겒??(ADR-033) ??\r\n */\r\nfunction axisNameFromEndLabel(label: string): string | undefined {\r\n  const value = compact(label)\r\n  if (!value.endsWith('塋?)) return undefined\r\n  const axisName = value.slice(0, -1)\r\n  return axisName === '' || axisName === '鸚? || axisName === '??\r\n    ? undefined\r\n    : axisName\r\n}\r\n\r\n/**\r\n * ??씊?ゃ궧?덀겗塋?깿?⒲깧?ャ겏?뚣걯邕멥겗Grid?⒲깧?ャ걣訝→뼶誤뗣겇?뗣겂?잆겏?띲걽?묆?\r\n * 邕멥궎?녈깈?껁궚?밤겗鵝롢걚?담굮冶뗧ク?ャ걲?뗣귝캈雍껁겗訝↑씌??compact() ?믧싥걲 ??\r\n * framing-plan ?담굚?뚣걯閭ｈ쫸?뽧굮鵝욍걝?잆굙?곥걪?뚣겘?뉐춻?쀣겗若뚦뀲訝?담겎?귙겂??\r\n * ?꾨㈃ 諛⑺뼢??異붿젙?섎뒗 ?대━?ㅽ떛???꾨땲??(ADR-033) ??\r\n */\r\nfunction automaticGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): GirderDirection | undefined {\r\n  const asymmetric = candidate.girderMainAsymmetric\r\n  if (!asymmetric) return undefined\r\n\r\n  const axisNames = asymmetric.labels.map(axisNameFromEndLabel)\r\n  if (axisNames.some((axisName) => axisName === undefined)) return undefined\r\n\r\n  for (const labels of [project.grid.xLabels, project.grid.yLabels]) {\r\n    if (!labels) continue\r\n    const indexes = axisNames.map((axisName) =>\r\n      labels.findIndex((label) => compact(label) === axisName),\r\n    )\r\n    if (indexes.every((index) => index >= 0) && indexes[0] !== indexes[1]) {\r\n      return indexes[0] < indexes[1] ? 'first' : 'second'\r\n    }\r\n  }\r\n  return undefined\r\n}\r\n\r\nfunction resolvedGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  selected?: GirderDirection,\r\n): GirderDirection | undefined {\r\n  return selected ?? automaticGirderDirection(project, candidate)\r\n}\r\n\r\nfunction isImportableSection(section: Section): section is ImportableSection {\r\n  return (\r\n    section.kind === '?? ||\r\n    section.kind === '鸚㎪쥈' ||\r\n    section.kind === '?먬쐡鶯? ||\r\n    section.kind === '佯딀씮'\r\n  )\r\n}\r\n\r\nfunction matchingSection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  return project.sections\r\n    .filter(isImportableSection)\r\n    .find(\r\n      (section) =>\r\n        section.mark === candidate.mark &&\r\n        section.kind === candidate.kind &&\r\n        section.storyLabel === candidate.storyLabel,\r\n    )\r\n}\r\n\r\nfunction cloneSource(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  const sameKind = project.sections\r\n    .filter(isImportableSection)\r\n    .filter((section) => section.kind === candidate.kind)\r\n  // 媛숈? 寧?뤇???ㅻⅨ ?롪? ?대? ?덉쑝硫?洹몄そ??蹂듭젣?먯씠?????뚯떛?섏? ?딅뒗\r\n  // fc쨌媛뺤쥌쨌?몄텧쨌餓뺜툓?뮻룟닜?잆궕?뺛궩?껁깉? 臾닿???遺?щ낫??媛숈? 寧?뤇 履쎌씠 留욌떎\r\n  return (\r\n    sameKind.find((section) => section.mark === candidate.mark) ?? sameKind[0]\r\n              onGirderDirectionChange(\r\n                value === 'first' || value === 'second' ? value : undefined,\r\n              )\r\n            }}\r\n          >\r\n            <option value=\"\">\r\n              {t(locale, 'sectionImport.girderDirectionPlaceholder')}\r\n            </option>\r\n            <option value=\"first\">\r\n              {candidate.girderMainAsymmetric.labels[0]}=冶뗧ク\r\n            </option>\r\n            <option value=\"second\">\r\n              {candidate.girderMainAsymmetric.labels[1]}=冶뗧ク\r\n            </option>\r\n          </select>\r\n          <span>\r\n            {automaticDirection !== undefined\r\n              ? `${t(locale, 'sectionImport.girderDirection.auto')}竊?{candidate.girderMainAsymmetric.labels[resolvedDirection === 'first' ? 0 : 1]}=冶뗧ク竊?\r\n              : t(locale, 'sectionImport.girderDirection.manual')}\r\n          </span>\r\n        </div>\r\n      ) : null}\r\n      <div className={styles.rowActions}>\r\n        <button\r\n          type=\"button\"\r\n          className={styles.applyButton}\r\n          disabled={\r\n            directionMissing || (!existing && (!source || incomplete))\r\n          }\r\n          onClick={onApply}\r\n        >\r\n          {t(locale, 'sectionImport.apply')}\r\n        </button>\r\n        <button type=\"button\" className={styles.ignoreButton} onClick={onIgnore}>\r\n          {t(locale, 'sectionImport.ignore')}\r\n        </button>\r\n      </div>\r\n    </li>\r\n  )\r\n}\r\n\r\nexport function SectionImport({\r\n  initialPages,\r\n  extractPages = extractTextPages,\r\n}: SectionImportProps) {\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n  const inputRef = useRef<HTMLInputElement>(null)\r\n  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\r\n  const [open, setOpen] = useState(initialPages !== undefined)\r\n  const [loading, setLoading] = useState(false)\r\n  const [failed, setFailed] = useState(false)\r\n  const [ignored, setIgnored] = useState<Set<string>>(() => new Set())\r\n  const [slabDirections, setSlabDirections] = useState<\r\n    Record<string, SlabDirection>\r\n  >({})\r\n  const [girderDirections, setGirderDirections] = useState<\r\n    Record<string, GirderDirection>\r\n  >({})\r\n  // ?곗냽 ?좏깮 ????쾶 ?앸궃 ?댁쟾 ?뚯씪??寃곌낵媛 理쒖떊 寃곌낵瑜???? ?딄쾶 ?쒕떎\r\n  const requestRef = useRef(0)\r\n  const lists = useMemo(\r\n    () => (pages ?? []).flatMap((page) => parseSectionLists(page)),\r\n    [pages],\r\n  )\r\n  const rows = useMemo(() => parsedCandidates(lists), [lists])\r\n  // ?ъ쑀蹂꾨줈 ?대뒓 由ъ뒪?멸? 嫄몃졇?붿? 臾띕뒗?????꾨낫媛 ?섎굹?쇰룄 ?덉쑝硫??ㅽ뙣???쒓?\r\n  // ?붾㈃?먯꽌 ?щ씪吏??臾몄젣瑜?留됱쑝?ㅻ㈃ ???덈궡媛 ?꾨낫 紐⑸줉怨??④퍡 ??蹂댁뿬???쒕떎\r\n  const listIssues = useMemo(() => {\r\n    const grouped = new Map<ListIssue, string[]>()\r\n    for (const { issue, listKind } of lists) {\r\n      if (issue === undefined) continue\r\n      const kinds = grouped.get(issue) ?? []\r\n      if (!kinds.includes(listKind)) kinds.push(listKind)\r\n      grouped.set(issue, kinds)\r\n    }\r\n    return [...grouped]\r\n  }, [lists])\r\n  const supported = rows.filter(({ candidate }) => candidate.kind !== '野얕괌鸚?)\r\n  const outOfScope = rows.filter(({ candidate }) => candidate.kind === '野얕괌鸚?)\r\n\r\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n    const input = event.currentTarget\r\n    const file = input.files?.[0]\r\n    if (!file) return\r\n\r\n    const requestId = ++requestRef.current\r\n    setOpen(true)\r\n    setLoading(true)\r\n    setFailed(false)\r\n    setIgnored(new Set())\r\n    setSlabDirections({})\r\n    setGirderDirections({})\r\n    try {\r\n      const next = await extractPages(file)\r\n      if (requestRef.current !== requestId) return\r\n      setPages(next)\r\n    } catch {\r\n      if (requestRef.current !== requestId) return\r\n      setPages(null)\r\n      setFailed(true)\r\n    } finally {\r\n      if (requestRef.current === requestId) setLoading(false)\r\n      input.value = ''\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.control}>\r\n      <button\r\n        type=\"button\"\r\n        className={styles.openButton}\r\n        onClick={() => {\r\n          if (pages) setOpen(true)\r\n          else inputRef.current?.click()\r\n        }}\r\n      >\r\n        {t(locale, 'sectionImport.open')}\r\n      </button>\r\n      <input\r\n        ref={inputRef}\r\n        className={styles.fileInput}\r\n        data-testid=\"section-import-file\"\r\n        type=\"file\"\r\n        accept=\"application/pdf\"\r\n        aria-label={t(locale, 'sectionImport.file')}\r\n        onChange={(event) => void selectFile(event)}\r\n      />\r\n      {open ? (\r\n        <section\r\n          className={styles.panel}\r\n          role=\"dialog\"\r\n          aria-modal=\"false\"\r\n          aria-labelledby=\"section-import-title\"\r\n        >\r\n          <header className={styles.panelHeader}>\r\n            <h3 id=\"section-import-title\">\r\n              {t(locale, 'sectionImport.title')}\r\n            </h3>\r\n            <div className={styles.panelActions}>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.chooseButton}\r\n                onClick={() => inputRef.current?.click()}\r\n              >\r\n                {t(locale, 'sectionImport.chooseAnother')}\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.closeButton}\r\n                onClick={() => setOpen(false)}\r\n              >\r\n                {t(locale, 'sectionImport.close')}\r\n              </button>\r\n            </div>\r\n          </header>\r\n          <div className={styles.panelBody}>\r\n            {loading ? (\r\n              <p role=\"status\">{t(locale, 'sectionImport.loading')}</p>\r\n            ) : failed ? (\r\n              <p role=\"alert\">{t(locale, 'sectionImport.error')}</p>\r\n            ) : pages && rows.length === 0 && listIssues.length === 0 ? (\r\n              <p>{t(locale, 'sectionImport.empty')}</p>\r\n            ) : (\r\n              <>\r\n                {listIssues.map(([issue, kinds]) => (\r\n                  <p key={issue} className={styles.listIssue}>\r\n                    {`${t(locale, `sectionImport.listIssue.${issue}`)}竊?{kinds.join('??)}竊?}\r\n                  </p>\r\n                ))}\r\n                <ul className={styles.candidateList}>\r\n                  {supported.map((row) => (\r\n                    <Candidate\r\n                      key={row.id}\r\n                      row={row}\r\n                      ignored={ignored.has(row.id)}\r\n                      slabDirection={slabDirections[row.id]}\r\n                      girderDirection={girderDirections[row.id]}\r\n                      onIgnore={() =>\r\n                        setIgnored((current) => new Set(current).add(row.id))\r\n                      }\r\n                      onSlabDirectionChange={(direction) =>\r\n                        setSlabDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onGirderDirectionChange={(direction) =>\r\n                        setGirderDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onApply={() =>\r\n                        updateProject((project) =>\r\n                          applyCandidate(\r\n                            project,\r\n                            row.candidate,\r\n                            slabDirections[row.id],\r\n                            girderDirections[row.id],\r\n                          ),\r\n                        )\r\n                      }\r\n                    />\r\n                  ))}\r\n                </ul>\r\n                {outOfScope.length > 0 ? (\r\n                  <details\r\n                    className={styles.outOfScope}\r\n                    data-testid=\"section-import-out-of-scope\"\r\n                  >\r\n                    <summary>\r\n                      {t(locale, 'sectionImport.outOfScope')} ({outOfScope.length})\r\n                    </summary>\r\n                    <ul className={styles.candidateList}>\r\n                      {outOfScope.map((row) => (\r\n                        <li\r\n                          key={row.id}\r\n                          className={styles.candidate}\r\n                          data-testid={`section-import-candidate-${row.candidate.mark}-${row.candidate.storyLabel ?? 'none'}`}\r\n                        >\r\n                          <div className={styles.candidateHeading}>\r\n                            <strong>{row.candidate.mark}</strong>\r\n                            <span>\r\n                              {row.candidate.storyLabel ??\r\n                                t(locale, 'sectionImport.noStory')}\r\n                            </span>\r\n                          </div>\r\n                          <p>\r\n                            {candidateFields(row.candidate, locale).join(' / ') ||\r\n                              '??}\r\n                          </p>\r\n                        </li>\r\n                      ))}\r\n                    </ul>\r\n                  </details>\r\n                ) : null}\r\n              </>\r\n            )}\r\n          </div>\r\n        </section>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n--- SectionTable tests ---\r\nimport { act, fireEvent, render, screen } from '@testing-library/react'\r\nimport { beforeEach, describe, expect, it, vi } from 'vitest'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport { useAppStore } from '@/lib/store'\r\n\r\nimport { SectionTable } from './SectionTable'\r\n\r\nconst { capture } = vi.hoisted(() => ({ capture: vi.fn() }))\r\n\r\nvi.mock('@/lib/telemetry', () => ({ capture }))\r\n\r\ndescribe('SectionTable', () => {\r\n  beforeEach(() => {\r\n    capture.mockClear()\r\n    useAppStore.setState({\r\n      project: createSampleProject(),\r\n      sel: { group: null, memberId: null },\r\n      activeStoryId: '1F',\r\n      locale: 'ja',\r\n    })\r\n  })\r\n\r\n  it('keeps a user change to ??訝사춮 count in Project', () => {\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.change(screen.getByLabelText('C1 訝사춮 ?ф빊'), {\r\n      target: { value: '10' },\r\n    })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-C1')\r\n    expect(section?.kind).toBe('??)\r\n    if (section?.kind !== '??) throw new Error('Expected ??section')\r\n    expect(section.main.count).toBe(10)\r\n    expect(screen.getByLabelText('C1 訝사춮 ?ф빊')).toHaveValue(10)\r\n  })\r\n\r\n  it('keeps a user change to 泳숁뎸?밧폀 in Project', () => {\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.change(screen.getByLabelText('G1 泳숁뎸?밧폀'), {\r\n      target: { value: '?с궧?㎪렏' },\r\n    })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    expect(section?.spliceMethod).toBe('?с궧?㎪렏')\r\n    expect(screen.getByLabelText('G1 泳숁뎸?밧폀')).toHaveValue('?с궧?㎪렏')\r\n  })\r\n\r\n  it('toggles each 鸚㎪쥈訝사춮 row between symmetric and asymmetric塋?깿 counts', () => {\r\n    render(<SectionTable />)\r\n\r\n    const toggle = screen.getByLabelText('G1 訝딁춮 藥?뤂?㏝걬??)\r\n    expect(toggle).not.toBeChecked()\r\n\r\n    fireEvent.click(toggle)\r\n    let section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.main.top.startCount).toBe(section.main.top.endCount)\r\n\r\n    fireEvent.change(screen.getByLabelText('G1 訝사춮 訝?冶뗧ク ?ф빊'), {\r\n      target: { value: '6' },\r\n    })\r\n    fireEvent.change(screen.getByLabelText('G1 訝사춮 訝?永귞ク ?ф빊'), {\r\n      target: { value: '7' },\r\n    })\r\n\r\n    section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.main.top).toMatchObject({\r\n      startCount: 6,\r\n      endCount: 7,\r\n      centerCount: 4,\r\n    })\r\n\r\n    fireEvent.click(screen.getByLabelText('G1 訝딁춮 藥?뤂?㏝걬??))\r\n    section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.main.top).toEqual({\r\n      endCount: 7,\r\n      centerCount: 4,\r\n    })\r\n  })\r\n\r\n  // 亮끾??곭춮쨌?밭춮? ??씊訝誤㏃뿉 ?놁쑝硫?洹?諛곌렐???녿떎???살씠??optional ?대떎\r\n  // (ADR-012). 洹몃옒???뚣겒????孃꾩쓣 怨좊쫫?띻낵 ?뚯씠誘??덈뒗 孃꾩쓣 諛붽퓞?띿씠 ?쒕줈 ?ㅻⅨ\r\n  // 寃쎈줈瑜???붾뜲, ?꾩옄媛 鍮좎졇 ?덉뿀????孃꾩쓣 ??踰덉㎏濡?怨좊Ⅴ硫?媛믪씠 踰꾨젮議뚮떎.\r\n  it('keeps a second ?밭춮 孃?change, not just the first', () => {\r\n    render(<SectionTable />)\r\n\r\n    const select = screen.getByLabelText('G1 ?밭춮 孃?)\r\n    fireEvent.change(select, { target: { value: 'D10' } })\r\n    fireEvent.change(screen.getByLabelText('G1 ?밭춮 ?ф빊'), {\r\n      target: { value: '4' },\r\n    })\r\n    fireEvent.change(select, { target: { value: 'D13' } })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.sideBar?.size).toBe('D13')\r\n    // 孃꾩쓣 諛붽엥?ㅺ퀬 ?대? ?낅젰???ф빊媛 ?⑥븮媛믪쑝濡??섎룎?꾧?硫????쒕떎\r\n    expect(section.sideBar?.count).toBe(4)\r\n    expect(select).toHaveValue('D13')\r\n  })\r\n\r\n  it('keeps a second 亮끾??곭춮 孃?change and holds the pitch', () => {\r\n    render(<SectionTable />)\r\n\r\n    const select = screen.getByLabelText('G1 亮끾??곭춮 孃?)\r\n    fireEvent.change(select, { target: { value: 'D10' } })\r\n    fireEvent.change(screen.getByLabelText('G1 亮끾??곭춮 ?붵긿??), {\r\n      target: { value: '600' },\r\n    })\r\n    fireEvent.change(select, { target: { value: 'D13' } })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.widthTie?.size).toBe('D13')\r\n    expect(section.widthTie?.pitch).toBe(600)\r\n    expect(select).toHaveValue('D13')\r\n  })\r\n\r\n  // ADR-012 ????씊訝誤㎯겗?ㅳ겘?ε뒟?졼귙걗?겹굢嶺뗣겗?붵긿?곥굮葉?겓?잆굤?뗣겏?곩닶?②끹걣\r\n  // 亮끾??곭춮?ャ겇?꾠겍訝佯╉굚?γ굦?╉걚?ゃ걚?겼춻??1?싧뎴7) ??돯餓섉쑍?겹굮黎뷩굙?╉걮?얇걝??\r\n  it('does not borrow the ?귙겙?됬춮 pitch when 亮끾??곭춮 is switched back on', () => {\r\n    render(<SectionTable />)\r\n\r\n    const select = screen.getByLabelText('G1 亮끾??곭춮 孃?)\r\n    fireEvent.change(select, { target: { value: '' } })\r\n    fireEvent.change(select, { target: { value: 'D13' } })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.widthTie?.pitch).toBe(0)\r\n    expect(section.widthTie?.pitch).not.toBe(section.stirrup.pitch)\r\n  })\r\n\r\n  it('drops the field entirely when ?밭춮 is set back to ?ゃ걮', () => {\r\n    render(<SectionTable />)\r\n\r\n    const select = screen.getByLabelText('G1 ?밭춮 孃?)\r\n    fireEvent.change(select, { target: { value: 'D10' } })\r\n    fireEvent.change(select, { target: { value: '' } })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    // undefined 濡??먮뒗 寃??꾨땲?????먯껜媛 ?놁뼱???쒕떎 ???닷닓?뽱뻽????\r\n    // ?뚮같洹??놁쓬?띻낵 ?뚯엯?????ⓦ띿씠 媛숈? 紐⑥뼇???쒕떎 (ADR-012)\r\n    expect('sideBar' in section).toBe(false)\r\n  })\r\n\r\n  it('locks the ?밭춮 number inputs while the field is ?ゃ걮', () => {\r\n    render(<SectionTable />)\r\n\r\n    // ?뚣겒?쀣띿씤 ?숈븞 ?댁뼱 ?먮㈃ updater 媛 current 瑜?洹몃?濡??뚮젮二쇰?濡??낅젰??\r\n    // ?꾨Т ?붿쟻 ?놁씠 ?щ씪吏꾨떎. 議곗슜??no-op ???留됰뒗??\r\n    // ?섑뵆 ??씊? ?밭춮??媛吏誘濡?泥섏쓬???대젮 ?덈떎.\r\n    expect(screen.getByLabelText('G1 ?밭춮 ?ф빊')).toBeEnabled()\r\n\r\n    fireEvent.change(screen.getByLabelText('G1 ?밭춮 孃?), {\r\n      target: { value: '' },\r\n    })\r\n\r\n    expect(screen.getByLabelText('G1 ?밭춮 ?ф빊')).toBeDisabled()\r\n    expect(screen.getByLabelText('G1 ?밭춮 鵝숅빓')).toBeDisabled()\r\n\r\n    fireEvent.change(screen.getByLabelText('G1 ?밭춮 孃?), {\r\n      target: { value: 'D13' },\r\n    })\r\n\r\n    expect(screen.getByLabelText('G1 ?밭춮 ?ф빊')).toBeEnabled()\r\n  })\r\n\r\n  it('keeps a user change to ?뗣겤?딀씉餓?in Project', () => {\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.change(screen.getByLabelText('C1 掠뗥냵鸚?), {\r\n      target: { value: '掠뗥냵' },\r\n    })\r\n    fireEvent.change(screen.getByLabelText('C1 餓뺜툓??), {\r\n      target: { value: '餓뺜툓?믡걗?? },\r\n    })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-C1')\r\n    expect(section).toMatchObject({\r\n      exposure: '掠뗥냵',\r\n      finish: '餓뺜툓?믡걗??,\r\n    })\r\n    expect(screen.getByLabelText('C1 掠뗥냵鸚?)).toHaveValue('掠뗥냵')\r\n    expect(screen.getByLabelText('C1 餓뺜툓??)).toHaveValue('餓뺜툓?믡걗??)\r\n  })\r\n\r\n  it('keeps a user change to ?귙겙?됬춮 ?앮쐿?ゃ깢?삠긿??in Project', () => {\r\n    // 誤뤸틬??媛믪씠 ?녿뒗 諛곗튂媛믪씠誘濡?猷고뙥???꾨땲????씊訝誤㏃씠 ?뺥븳??(ADR-012).\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.change(screen.getByLabelText('G1 ?귙겙?됬춮 ?앮쐿?ゃ깢?삠긿??), {\r\n      target: { value: '75' },\r\n    })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.stirrup.startOffsetMm).toBe(75)\r\n  })\r\n\r\n  it('keeps a user change to 躍?춮 ?앮쐿?ゃ깢?삠긿??in Project', () => {\r\n    // 躍?춮 ?ㅽ봽?뗫룄 ?ф빊(=臾쇰웾)瑜?醫뚯슦?섎?濡??쒗뭹 ?곸닔媛 ?꾨땲???낅젰?대떎.\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.change(screen.getByLabelText('C1 躍?춮 ?앮쐿?ゃ깢?삠긿??), {\r\n      target: { value: '50' },\r\n    })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-C1')\r\n    if (section?.kind !== '??) throw new Error('Expected ??section')\r\n    expect(section.hoop.startOffsetMm).toBe(50)\r\n  })\r\n\r\n  it('ignores an emptied ?앮쐿?ゃ깢?삠긿??instead of committing 0', () => {\r\n    // Number('')??0?대씪 ?섑븳??0???꾨뱶?먯꽌??鍮?媛믪씠 ?듦낵?쒕떎 ??吏?곕뒗 ?쒓컙\r\n    // ?ф빊(=臾쇰웾)媛 ?ъ슜?먭? ?섎룄?섏? ?딆? ?쒖젏??諛붾먮떎.\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.change(screen.getByLabelText('G1 ?귙겙?됬춮 ?앮쐿?ゃ깢?삠긿??), {\r\n      target: { value: '' },\r\n    })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.stirrup.startOffsetMm).toBe(50)\r\n  })\r\n\r\n  it('accepts 0 for ?앮쐿?ゃ깢?삠긿?? unlike 野멩퀡?삠깞?껁긽 fields', () => {\r\n    // ?깆쓽 湲곕낯媛믪씠 0?대떎 ??min=1??怨듭슜 ?낅젰??洹몃?濡??곕㈃ ?낅젰議곗감 紐??쒕떎.\r\n    render(<SectionTable />)\r\n\r\n    const offset = screen.getByLabelText('G1 ?귙겙?됬춮 ?앮쐿?ゃ깢?삠긿??)\r\n    expect(offset).toHaveAttribute('min', '0')\r\n    fireEvent.change(offset, { target: { value: '0' } })\r\n\r\n    const section = useAppStore\r\n      .getState()\r\n      .project.sections.find(({ id }) => id === 'section-G1')\r\n    if (section?.kind !== '鸚㎪쥈') throw new Error('Expected 鸚㎪쥈 section')\r\n    expect(section.stirrup.startOffsetMm).toBe(0)\r\n  })\r\n\r\n  it('selects a representative member when a section row is clicked', () => {\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.click(screen.getByTestId('section-row-section-G2'))\r\n\r\n    expect(useAppStore.getState().sel.group).toBe('1??G|G2')\r\n    expect(useAppStore.getState().sel.memberId).toBe(\r\n      '1F-G2-X1Y2-X',\r\n    )\r\n    expect(capture).toHaveBeenCalledWith('member_selected', {\r\n      source: 'section',\r\n    })\r\n  })\r\n\r\n  // ???덉쓽 ?낅젰移몄쓣 ?대┃???몄쭛留??대룄 onClick??踰꾨툝留곷뤌 selectSection??\r\n  // ?ㅼ떆 遺덈┛?? ?좏깮???대? 洹?遺?ъ??쇰㈃ member_selected媛 ???섍???\r\n  // ???쒕떎 ??source蹂??좏깮 ??鍮꾧탳媛 section 履쎌쑝濡?遺?쇰떎.\r\n  it('does not re-report member_selected when the row is already selected', () => {\r\n    render(<SectionTable />)\r\n\r\n    fireEvent.click(screen.getByTestId('section-row-section-G2'))\r\n    expect(capture).toHaveBeenCalledTimes(1)\r\n\r\n    fireEvent.click(screen.getByTestId('section-row-section-G2'))\r\n    expect(capture).toHaveBeenCalledTimes(1)\r\n  })\r\n\r\n  it('follows a selection changed outside the section pane', () => {\r\n    render(<SectionTable />)\r\n\r\n    act(() => useAppStore.getState().selectMember('1F-G2-X