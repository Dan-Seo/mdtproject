[6000, 6000], ySpans: [6000, 6000] },\r\n  88:     stories: [{ id: '1F', name: '1階', height: 4200 }],\r\n  89:     sections: [columnSection, shallowGirderSection, deepGirderSection],\r\n  90:     members,\r\n  91:   }\r\n  92: }\r\n  93: \r\n  94: describe('storyElevation', () => {\r\n  95:   const stories: Story[] = [\r\n  96:     { id: '1F', name: '1階', height: 4200 },\r\n  97:     { id: '2F', name: '2階', height: 3800 },\r\n  98:     { id: '3F', name: '3階', height: 3800 },\r\n  99:   ]\r\n 100: \r\n 101:   it('accumulates the heights of the stories below in array order', () => {\r\n 102:     expect(storyElevation(stories, '1F')).toBe(0)\r\n 103:     expect(storyElevation(stories, '2F')).toBe(4200)\r\n 104:     expect(storyElevation(stories, '3F')).toBe(8000)\r\n 105:   })\r\n 106: \r\n 107:   it('returns 0 for the only story of a single-story project', () => {\r\n 108:     expect(storyElevation([stories[0]], '1F')).toBe(0)\r\n 109:   })\r\n 110: \r\n 111:   // 階 라벨은 断面リスト 취입으로 도면에서 들어오는 값이라 메시지에 맨몸으로\r\n 112:   // 싣지 않고 JSON 블록으로 감싼다. 원래는 텔레메트리 스크러버(블랙리스트)가\r\n 113:   // letter+digit 토큰을 룰팩 상수로 오인해 통과시키는 것을 피하려는 조치였다.\r\n 114:   // ADR-020이 허용목록으로 바뀌어 예외 message 자체가 안 나가므로 그 결합은\r\n 115:   // 사라졌다 — 이 모양을 되돌리는 것은 별건이다.\r\n 116:   it('throws on an unknown story id with the id wrapped as a JSON block', () => {\r\n 117:     expect(() => storyElevation(stories, 'RF')).toThrow(\r\n 118:       'Story not found: {\"storyId\":\"RF\"}',\r\n 119:     )\r\n 120:   })\r\n 121: })\r\n 122: \r\n 123: describe('grid helpers', () => {\r\n 124:   it('returns grid point counts and cumulative coordinates in mm', () => {\r\n 125:     const grid = { xSpans: [1000, 2000], ySpans: [500] }\r\n 126: \r\n 127:     expect(gridPointCount(grid)).toEqual({ nx: 3, ny: 2 })\r\n 128:     expect(gridPoint(grid, 2, 1)).toEqual({ x: 3000, y: 500 })\r\n 129:   })\r\n 130: \r\n 131:   it.each([\r\n 132:     [-1, 0],\r\n 133:     [0, -1],\r\n 134:     [3, 0],\r\n 135:     [0, 3],\r\n 136:   ])('throws 