): ColumnSection {\r\n 108:   return {\r\n 109:     id: 'section-C1',\r\n 110:     kind: '柱',\r\n 111:     mark: 'C1',\r\n 112:     shape: '矩形',\r\n 113:     b: 800,\r\n 114:     d: 800,\r\n 115:     fc: 24,\r\n 116:     grade: 'SD345',\r\n 117:     exposure: '屋外',\r\n 118:     finish: '仕上げなし',\r\n 119:     spliceMethod: '重ね継手',\r\n 120:     main: { size: 'D25', count: 12 },\r\n 121:     hoop: { size: 'D13', pitch: 100, startOffsetMm: 0 },\r\n 122:     ...overrides,\r\n 123:   }\r\n 124: }\r\n 125: \r\n 126: function girderSection(\r\n 127:   overrides: Partial<GirderSection> = {},\r\n 128: ): GirderSection {\r\n 129:   return {\r\n 130:     id: 'section-G1',\r\n 131:     kind: '大梁',\r\n 132:     mark: 'G1',\r\n 133:     b: 400,\r\n 134:     depth: 750,\r\n 135:     fc: 24,\r\n 136:     grade: 'SD345',\r\n 137:     exposure: '屋外',\r\n 138:     finish: '仕上げなし',\r\n 139:     spliceMethod: '重ね継手',\r\n 140:     main: {\r\n 141:       size: 'D25',\r\n 142:       top: { endCount: 4, centerCount: 4 },\r\n 143:       bottom: { endCount: 4, centerCount: 4 },\r\n 144:       cutoffFromSupportFaceMm: 0,\r\n 145:     },\r\n 146:     stirrup: { size: 'D13', pitch: 100, startOffsetMm: 50 },\r\n 147:     ...overrides,\r\n 148:   }\r\n 149: }\r\n 150: \r\n 151: function slabSection(overrides: Partial<SlabSection> = {}): SlabSection {\r\n 152:   return {\r\n 153:     id: 'section-S1',\r\n 154:     kind: '床板',\r\n 155:     mark: 'S1',\r\n 156:     thickness: 200,\r\n 157:     fc: 24,\r\n 158:     grade: 'SD345',\r\n 159:     finish: '仕上げあり',\r\n 160:     spliceMethod: '重ね継手',\r\n 161:     x: {\r\n 162:       top: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n 163:       bottom: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n 164:     },\r\n 165:     y: {\r\n 166:       top: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n 167:       bottom: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n 168:     },\r\n 169:     ...overrides,\r\n 170:   }\r\n 171: }\r\n 172: \r\n 173: function columnMember(index: number, sectionId: string): Member {\r\n 174:   return {\r\n 175:     id: `1F-C${index}`,\r\n 176:     kind: '柱',\r\n 177:     memberClass: '躯体',\r\n 178:     sectionId,\r\n 179:     storyId: STORY.id,\r\n 180:     position: { ix: index, iy: 0 },\r\n1170:               id: `${entry.label}#${index + 1}`,\r\n1171:             })),\r\n1172:             clearXMm: entry.clearXMm,\r\n1173:             clearYMm: entry.clearYMm,\r\n1174:             barAxis,\r\n1175:             pitchMm: entry.pitchMm,\r\n1176:             totalCount: expected.totalCount,\r\n1177:           },\r\n1178:           jpMlitRulePack,\r\n1179:         )\r\n1180: \r\n1181:         expect(result.groups).toEqual(expected.groups)\r\n1182:         // 群の合計は割付本数そのもの — 欠除は本数を減らさず長さを減らす。\r\n1183:         expect(result.groups.reduce((sum, { count }) => sum + count, 0)).toBe(\r\n1184:           expected.totalCount,\r\n1185:         )\r\n1186:       }\r\n1187:     },\r\n1188:   )\r\n1189: \r\n1190:   it('leaves 開口補強筋 to 設計図書 — the clause delegates it', () => {\r\n1191:     const clause = fixture.clauses.find(({ id }) => id === '1通則8)')\r\n1192: \r\n1193:     expect(clause?.quote).toContain('開口補強筋は設計図書により計測・計算する')\r\n1194:     // 委任された鉄筋の値をルールパックが持っていたら、原文にない数字を\r\n1195:     // 製品が作ったということだ。開口部について持ってよいのは「欠除しない\r\n1196:     // 大きさ」の1行だけである。\r\n1197:     expect(\r\n1198:       jpMlitRulePack.entries.filter(({ key }) =>\r\n1199:         key.startsWith('measure.opening'),\r\n1200:       ),\r\n1201:     ).toHaveLength(1)\r\n1202:   })\r\n1203: })\r\n1204: \r\n1205: describe('1通則8) 開口補強筋の設計図書転記', () => {\r\n1206:   function wallInput(entry: OpeningReinforcementCase) {\r\n1207:     const section: WallSection = {\r\n1208:       id: 'section-opening-wall',\r\n1209:       kind: '耐震壁',\r\n1210:       mark: 'W-opening',\r\n1211:       thickness: 200,\r\n1212:       fc: 24,\r\n1213:       grade: 'SD345',\r\n1214:       exposure: '屋内',\r\n1215:       finish: '仕上げあり',\r\n1216:       spliceMethod: '重ね継手',\r\n1217:       layers: 1,\r\n1218:       vertical: { size: 'D13', pitch: 200, startOffsetMm: 0 },\r\n1219:       horizontal: { size: 'D13', pitch: 200, startOffsetMm: 0 },\r\n1220:     }\r\n1221:     const member: Member = {\r\n1222:       id: '1F-W-opening-X1Y1-X',\r\n1223:       kind: '耐震壁',\r\n1224:       memberClass: '躯体',\r\n1225:       sectionId: section.id,\r\n1226:       storyId: STORY.id,\r\n1227:       position: { axis: 'X', ix: 0, iy: 0 },\r\n1228:       openings: [\r\n1229:         {\r\n1230:           id: `${entry.id}-opening`,\r\n1231:           xMm: 1000,\r\n1232:           yMm: 500,\r\n1233:           widthMm: 1800,\r\n1234:           heightMm: 1200,\r\n1235:           reinforcements: entry.reinforcements,\r\n1236:         },\r\n1237:       ],\r\n1238:     }\r\n1239:     const project: Project = {\r\n1240:       schemaVersion: PROJECT_SCHEMA_VERSION,\r\n1241:       name: `開口補強筋ゴールデン — ${entry.label}`,\r\n1242:       grid: { xSpans: [6000], ySpans: [6000] },\r\n1243:       stories: [STORY],\r\n1244:       sections: [section],\r\n1245:       members: [member],\r\n1246:       unitMass: entry.unitMassKgPerM,\r\n1247:     }\r\n1248:     const span: WallSpan = {\r\n1249:       axis: 'X',\r\n1250:       clearLengthMm: 5200,\r\n1251:       clearHeightMm: 3450,\r\n1252:       startFaceOffsetMm: 400,\r\n1253:       endFaceOffsetMm: 400,\r\n1254:       girderDepthAboveMm: 750,\r\n1255:     }\r\n1256: \r\n1257:     return {\r\n1258:       project,\r\n1259:       rebars: generateWallRebar({ member, section, span }, jpMlitRulePack),\r\n1260:     }\r\n1261:   }\r\n1262: \r\n1263:   function slabInput(entry: OpeningReinforcementCase) {\r\n1264:     const base = slabRunFor([6000], 'X', slabSection())\r\n1265:     const original = base.project.members.find(({ kind }) => kind === '床板')!\r\n1266:     const project: Project = {\r\n1267:       ...base.project,\r\n1268:       unitMass: entry.unitMassKgPerM,\r\n1269:       members: base.project.members.map((member) =>\r\n1270:         member.id === original.id\r\n1271:           ? {\r\n1272:               ...member,\r\n1273:               openings: [\r\n1274:                 {\r\n1275:                   id: `${entry.id}-opening`,\r\n1276:                   xMm: 2400,\r\n1277:                   yMm: 2400,\r\n1278:                   widthMm: 1200,\r\n1279:                   heightMm: 1200,\r\n1280:                   reinforcements: entry.reinforcements,\r\n1281:                 },\r\n1282:               ],\r\n1283:             }\r\n1284:           : member,\r\n1285:       ),\r\n1286:     }\r\n1287:     const member = project.members.find(({ kind }) => kind === '床板')!\r\n1288: \r\n1289:     return {\r\n1290:       project,\r\n1291:       rebars: generateSlabRebar(\r\n1292:         { run: slabRun(project, member, 'X'), section: slabSection() },\r\n1293:         jpMlitRulePack,\r\n1294:       ),\r\n1295:     }\r\n1296:   }\r\n1297: \r\n1298:   it.each(openingReinforcementCases)('$id — $handDerivation', (entry) => {\r\n1299:     const generated =\r\n1300:       entry.memberKind === '耐震壁' ? wallInput(entry) : slabInput(entry)\r\n1301:     const reinforcementRebars = generated.rebars.filter(\r\n1302:       ({ role }) => role === '開口補強筋',\r\n1303:     )\r\n1304:     const reinforcementLines = massLines(\r\n1305:       aggregateQuantity(generated.project, generated.rebars, jpMlitRulePack),\r\n1306:     ).filter(({ role }) => role === '開口補強筋')\r\n1307: \r\n1308:     expect(reinforcementRebars).toHaveLength(entry.expected.length)\r\n1309:     expect(reinforcementLines).toHaveLength(entry.expected.length)\r\n1310: \r\n1311:     for (const expected of entry.expected) {\r\n1312:       const rebar = reinforcementRebars.find(\r\n1313:         ({ size }) => size === expected.size,\r\n1314:       )!\r\n1315:       const line = reinforcementLines.find(\r\n1316:         ({ size }) => size === expected.size,\r\n1317:       )!\r\n1318: \r\n1319:       expect(rebar).toMatchObject({\r\n1320:         role: '開口補強筋',\r\n1321:         size: expected.size,\r\n1322:         count: expected.count,\r\n1323:         length: expected.lengthMm,\r\n1324:         shape: 'straight',\r\n1325:         points: [\r\n1326:           [0, 0, 0],\r\n1327:           [expected.lengthMm, 0, 0],\r\n1328:         ],\r\n1329:         closed: false,\r\n1330:         ruleHits: [],\r\n1331:       })\r\n1332:       expect(rebar).not.toHaveProperty('zones')\r\n1333:       expect(rebar).not.toHaveProperty('placement')\r\n1334:       expect(roleToLayer(rebar.role)).toBe('hidden')\r\n1335:       expect(rebarSegments(rebar, columnSection())).toEqual([])\r\n1336:       expect(\r\n1337:         rebarBatches(\r\n1338:           [{ rowId: rebar.id, rebar }],\r\n1339:           columnSection(),\r\n1340:         ),\r\n1341:       ).toEqual([])\r\n1342:       expect(rebar.formula).toContain('設計図書転記')\r\n1343:       expect(rebar.formula).toContain('1通則8)')\r\n1344:       expect(line.countPerMember).toBe(expected.count)\r\n1345:       expect(line.lengthMm).toBe(expected.lengthMm)\r\n1346:       expect(line.unitMassKgPerM).toBe(\r\n1347:         entry.unitMassKgPerM[expected.size] ?? null,\r\n1348:       )\r\n1349:       if (expected.designKg === null) {\r\n1350:         expect(line.designKg, entry.handDerivation).toBeNull()\r\n1351:       } else {\r\n1352:         expect(line.designKg, entry.handDerivation).toBeCloseTo(\r\n1353:           expected.designKg,\r\n1354:           10,\r\n1355:         )\r\n1356:       }\r\n1357:       if (expected.requiredKg === null) {\r\n1358:         expect(line.requiredKg, entry.handDerivation).toBeNull()\r\n1359:       } else {\r\n1360:         expect(line.requiredKg, entry.handDerivation).toBeCloseTo(\r\n1361:           expected.requiredKg,\r\n1362:           10,\r\n1363:         )\r\n1364:       }\r\n1365:     }\r\n1366:   })\r\n1367: \r\n1368:   it('does not add a rule-pack entry for transcribed reinforcement values', () => {\r\n1369:     expect(\r\n1370:       jpMlitRulePack.entries.filter(({ key }) =>\r\n1371:         key.startsWith('measure.opening.reinforcement'),\r\n1372:       ),\r\n1373:     ).toEqual([])\r\n1374:   })\r\n1375: })\r\n===== tests/golden/spec-tables.test.ts =====\r\n===== tests/golden/rulepack-invariants.test.ts =====\r\n","exit_code":0,"status":"completed"}}
