:   }\r\n 262: }\r\n 263: \r\n 264: /**\r\n 265:  * 耐震壁 — ラーメン構造の壁である。壁式構造の壁ではない。\r\n 266:  *\r\n 267:  * 数量積算基準 2（５）壁 は 1)「壁式構造以外」と 2)「壁式構造」を別条文で扱い、\r\n 268:  * 後者は端部筋・縦筋・壁梁筋・横筋・補強筋の5区分に分かれて条文の量がまるで違う。\r\n 269:  * ここが実装するのは 1) だけで、壁式構造は扱わない。\r\n 270:  *\r\n 271:  * 幅止筋を持たないのは意図的だ。1通則3) は長さ（＝壁厚）を壁にも与えるが、\r\n 272:  * 本数を定める条文は 2（３）梁3) で梁しか名指しておらず、2（５）壁 に幅止筋の\r\n 273:  * 記述は一切ない。本数を製品が作らないと計上できない — 作らない (ADR-022 の腹筋と同じ判断)。\r\n 274:  */\r\n 275: export interface WallSection {\r\n 276:   id: string\r\n 277:   kind: '耐震壁'\r\n 278:   mark: string\r\n 279:   /** ColumnSection.storyLabel と同じ。 */\r\n 280:   storyLabel?: string\r\n 281:   /** 壁厚 (mm) */\r\n 282:   thickness: number\r\n 283:   fc: number\r\n 284:   grade: SteelGrade\r\n 285:   exposure: Exposure\r\n 286:   finish: Finish\r\n 287:   /** 縦筋・横筋の継手方式。継手箇所数と設計長さへの算入を決める */\r\n 288:   spliceMethod: SpliceMethod\r\n 289:   /**\r\n 290:    * 配筋の層数 — シングル(1) か ダブル(2) か。本数がそのまま倍違うが、\r\n 291:    * これを決める条文は規準にない。壁リストの「D13@200 ダブル」という記載\r\n 292:    * そのものであり、断面一覧の入力である (ADR-012)。\r\n 293:    */\r\n 294:   layers: 1 | 2\r\n 295:   /** 縦筋 — 上下の梁・床板へ定着する */\r\n 296:   vertical: {\r\n 297:     size: BarSize\r\n 298:     pitch: number\r\n 299:     /**\r\n 300:      * 内法端から第1・最終の縦筋をどれだけ離すか。柱の hoop・大梁の stirrup と\r\n 301:      * 同じ理由で規準に値がなく、断面一覧の入力である (ADR-012)。1通則7) は\r\n 302:      * 初期オフセットを見ないので数量には効かない — 3D 形状だけの値である。\r\n 303:      */\r\n 304:     startOffsetMm: number\r\n 305:   }\r\n 306:   /** 横筋 — 両側の柱へ定着する */\r\n 307:   horizontal: {\r\n 308:     size: BarSize\r\n 309:     pitch: number\r\n 310:     /** 縦筋の startOffsetMm と同じ。こちらは内法高さの下端からの距離である。 */\r\n 311:     startOffsetMm: number\r\n 312:   }\r\n 313: }\r\n 314: \r\n 315: /**\r\n 316:  * 床板（スラブ）の1方向・1面の主筋。\r\n 317:  *\r\n 318:  * 径もピッチも断面リストの入力である。数量積算基準 2（４）床板1) が「トップ筋、\r\n 319:  * ハンチ部分の主筋、補強筋等は設計図書による」と委ね、規準側に本数を定める\r\n 320:  * 条文がない (ADR-012)。ここが規準から引くのは定着長さだけだ。\r\n 321:  */\r\n 322: export interface SlabBarRow {\r\n 323:   size: BarSize\r\n 324:   pitch: number\r\n 325:   /**\r\n 326:    * 内法端から第1・最終の鉄筋をどれだけ離すか。柱の帯筋・大梁のあばら筋と\r\n 327:    * 同じ理由で規準に値がなく、断面一覧の入力である (ADR-012)。1通則7) は\r\n 328:    * 初期オフセットを見ないので数量には効かない — 3D 形状だけの値である。\r\n 329:    */\r\n 330:   startOffsetMm: number\r\n 331: }\r\n 332: \r\n 333: /**\r\n 334:  * 床板（スラブ）— 数量積算基準 2（４）床板 で測る。\r\n 335:  *\r\n 336:  * 測る対象は内法だ。躯体の区分（第4編第1章第2節（４））が床板を「柱、梁等に\r\n 337:  * 接する水平材の内法部分」と定めるので、長さは通り芯間ではなく両側の大梁の\r\n 338:  * 内側面の間である。柱・大梁と二重に計上しないのはこの定義による (ADR-028)。\r\n 339:  *\r\n 340:  * `exposure` を持たないのは表5.3.6 の構造そのものだ。同表の「スラブ、耐力壁\r\n 341:  * 以外の壁」行は仕上げの有無だけで分かれ、屋内・屋外の区別を**持たない** —\r\n 342:  * 「柱、梁、耐力壁」行と違う。入力に置くと画面に効かないつまみが並ぶ。\r\n 343:  *\r\n 344:  * 幅止筋を持たないのは耐震壁と同じ理由である。1通則3) が長さを与える部材の\r\n 345:  * 列挙は「基礎梁、梁、壁梁、壁」で床板がなく、本数を定める条文もない。\r\n 346:  */\r\n 347: export interface SlabSection {\r\n 348:   id: string\r\n 349:   kind: '床板'\r\n 350:   mark: string\r\n 351:   /** ColumnSection.storyLabel と同じ。 */\r\n 352:   storyLabel?: string\r\n 353:   /** 板厚 (mm) */\r\n 354:   thickness: number\r\n 355:   fc: number\r\n 356:   grade: SteelGrade\r\n 357:   finish: Finish\r\n 358:   /** 主筋の継手方式。継手箇所数と設計長さへの算入を決める */\r\n 359:   spliceMethod: SpliceMethod\r\n 360:   /** X通り方向（X軸に沿って伸びる）の主筋 */\r\n 361:   x: { top: SlabBarRow; bottom: SlabBarRow }\r\n 362:   /** Y通り方向の主筋 */\r\n 363:   y: { top: SlabBarRow; bottom: SlabBarRow }\r\n 364: }\r\n 365: \r\n 366: export type Section =\r\n 367:   | ColumnSection\r\n 368:   | GirderSection\r\n 369:   | WallSection\r\n 370:   | SlabSection\r\n 371: \r\n 372: /**\r\n 373:  * 화면 표시·aria-label용 이름. 같은 符号이 階별로 여러 断面이 될 수 있으므로\r\n 374:  * 階를 여기서 붙인다 — 저장되는 `mark`는 도면의 符号 그대로 둔다.\r\n 375:  */\r\n 376: export function sectionMarkLabel(section: Section): string {\r\n 377:   return section.storyLabel\r\n 378:     ? `${section.mark}(${section.storyLabel})`\r\n 379:     : section.mark\r\n 380: }\r\n===== src/domain/model/project.ts =====\r\n   1: import {\r\n   2:   BAR_SIZES,\r\n   3:   MEMBER_KINDS,\r\n   4:   type BarSize,\r\n   5:   type ColumnSection,\r\n   6:   type ColumnPosition,\r\n   7:   type GirderPosition,\r\n   8:   type GirderSection,\r\n   9:   type Member,\r\n  10:   type MemberKind,\r\n  11:   type Opening,\r\n  12:   type Section,\r\n  13:   type ShearBarSize,\r\n  14:   type SlabPosition,\r\n  15: } from './member'\r\n  16: import { MemberUnsupportedError } from './unsupported'\r\n  17: import { coverConditions } from '../rules/lookup'\r\n  18: \r\n  19: // v2 (2026-08-12): Section에 필수 필드 exposure·finish 추가 — v1 JSON은\r\n  20: // deserializeProject의 버전 게이트에서 명시적으로 거부된다 (영속 v1 데이터 없음).\r\n  21: // v3 (2026-08-12): GirderSection.stirrup에 필수 필드 startOffsetMm 추가. 規準에\r\n  22: // 없는 배치값을 룰팩에 가짜 출처로 넣는 대신 입력으로 받는다 (ADR-012).\r\n  23: // v4 (2026-08-12): ColumnSection.hoop에도 같은 이유로 startOffsetMm 추가.\r\n  24: // 이 값이 帯筋 本数(=물량)를 좌우하므로 제품 상수로 두지 않는다.\r\n  25: // v5 (2026-08-14): Section에 필수 필드 spliceMethod 추가. 継手箇所数와 설계길이\r\n  26: // 산입이 방식마다 다른데(積算基準 1通則4)·5)) 규준에 기본 방식이 없으므로\r\n  27: // 조용한 기본값 대신 입력으로 받는다.\r\n  28: // v6 (2026-08-20): Project에 선택 필드 unitMass 추가. 数量積算基準 1通則 前文은\r\n  29: // 質量을 「設計長さ × JIS G 3112 の単位質量」으로 정의할 뿐 값 자체는 JIS에\r\n  30: // 위임한다. JIS는 유료 규격이라 확보하지 못했고, 읽지 않은 문헌을 룰팩의\r\n  31: // 出典에 세울 수는 없으므로(ADR-003) 값을 입력으로 받는다. 미입력 径은 키가\r\n  32: // 없고, 그 径의 kg은 산출하지 않는다.\r\n  33: // v7 (2026-08-21): GirderSection에 두 갈래 변경이 함께 들어갔다 — 둘 다\r\n  34: // 영속 데이터가 없는 상태에서 같은 판으로 나가므로 버전은 하나다.\r\n  35: //   ① (M3b) main の topCount·bottomCount を位置別 (端部·中央) の GirderMainRow に\r\n  36: //      置き換え、カットオフ位置を必須入力にした。積算基準 2（３）梁1) が定めるのは\r\n  37: //      「梁の全長にわたる主筋」だけで、トップ筋等は設計図書に委ねられる —\r\n  38: //      位置別本数がないと通し筋とカットオフ筋を分けられない。\r\n  39: //   ② (M3c) 任意 필드 widthTie·sideBar 추가. 둘 다 「断面一覧에 없으면 그 배근이\r\n  40: //      없다」를 뜻하는 optional이다 — 있는지 없는지를 제품이 정하지 않는다.\r\n  41: //      腹筋의 余長은 積算基準 1通則6)이 JASS 5에 위임하는데 그 규격이 미확보라\r\n  42: //      룰팩 행이 아니라 입력으로 받는다 (R9②).\r\n  43: // v8 (2026-08-22): 耐震壁を部材として受け取る。MemberKind に '耐震壁'、Section に\r\n  44: //   WallSection が加わり、Member.position は大梁と同じ辺の位置を使う。数量積算基準\r\n  45: //   2（５）壁1)（壁式構造以外）と、躯体の区分（５）壁「柱、梁、床板等に接する垂直材の\r\n  46: //   内法部分」に対応する — 壁式構造の壁（2）は扱わない (ADR-025)。\r\n  47: // v9 (2026-08-22): ColumnSection に必須フィールド shape を追加。円形柱は b・d を\r\n  48: //   ともに直径にする。数量で形状を見るのは 1通則2)「断面の設計寸法による周長」\r\n  49: //   だけで、円形断面ではそれが円周になる — 省略可能にすると「記載なし＝矩形」と\r\n  50: //   いう黙った既定値になるので必須にする (ADR-027)。\r\n  51: // v10 (2026-08-22): 床板（スラブ）を部材として受け取る。MemberKind に '床板'、\r\n  52: //   Section に SlabSection が加わり、Member.position はベイ（通り芯で囲まれた\r\n  53: //   1区画）の原点側格子点を指す。数量積算基準 2（４）床板 と、躯体の区分（４）\r\n  54: //   「柱、梁等に接する水平材の内法部分」に対応する (ADR-028)。SlabSection が\r\n  55: //   exposure を持たないのは表5.3.6 の「スラブ、耐力壁以外の壁」行に屋内・屋外の\r\n  56: //   区別がないからで、省略ではなく原文の構造である。\r\n  57: // v11 (2026-08-22): Member に任意フィールド openings を追加。数量積算基準 1通則8)\r\n  58: //   「窓、出入口等の開口部による鉄筋の欠除は……建具類等開口部の内法寸法による」\r\n  59: //   に対応する。断面ではなく部材に付くのは、同じ符号の壁が何枚も建つのに窓は\r\n  60: //   その1枚に開いているからだ。未指定は「開口なし」で、それが v10 までの JSON の\r\n  61: //   意味とも一致する — それでも版を上げるのは、開口を受け取れる版とそうでない版で\r\n  62: //   同じ案件の数量が変わるからである (ADR-029・R14)。\r\n  63: export const PROJECT_SCHEMA_VERSION = 11\r\n  64: \r\n  65: export interface Grid {\r\n  66:   xSpans: number[]\r\n  67:   ySpans: number[]\r\n  68:   /**\r\n  69:    * 通り芯의 이름 (「bX1」「Y3」). 伏図에서 읽은 원문 그대로이고 길이는\r\n  70:    * spans.length + 1이다. 미지정은 「도면에서 읽은 이름이 없다」는 뜻이며,\r\n  71:    * 제품이 index로 이름을 지어내지 않는다 (ADR-004·ADR-030).\r\n  72:    *\r\n  73:    * schemaVersion을 올리지 않는다 — 이 필드는 数量을 바꾸지 않는다. 版을\r\n  74:    * 올리는 기준은 「같은 案件의 数量이 달라지는가」다 (v11 주석 참조).\r\n  75:    */\r\n  76:   xLabels?: string[]\r\n  77:   yLabels?: string[]\r\n  78: }\r\n  79: \r\n  80: /** 라벨 배열이 스팬 수와 맞는가. 어긋나면 어느 축의 이름인지 알 수 없다 */\r\n  81: export function isGridLabels(\r\n  82:   labels: unknown,\r\n  83:   spanCount: number,\r\n  84: ): labels is string[] {\r\n  85:   return (\r\n  86:     Array.isArray(labels) &&\r\n  87:     labels.length === spanCount + 1 &&\r\n  88:     labels.every((label) => typeof label === 'string')\r\n  89:   )\r\n  90: }\r\n  91: \r\n  92: export interface Story {\r\n  93:   id: string\r\n  94:   name: string\r\n  95:   height: number\r\n  96: }\r\n  97: \r\n  98: export interface Project {\r\n  99:   schemaVersion: number\r\n 100:   name: string\r\n 101:   grid: Grid\r\n 102:   stories: Story[]\r\n 103:   sections: Section[]\r\n 104:   members: Member[]\r\n 105:   /** 내역서 備考. QuantityLine.id를 키로 쓴다. 값이 없는 행은 키 자체가 없다. */\r\n 106:   notes?: Record<string, string>\r\n 107:   /**\r\n 108:    * 径별 単位質量 (kg/m) — 利用者入力. 미입력 径은 키가 없다.\r\n 109:    * 규준이 JIS에 위임한 값이라 룰팩이 아니라 프로젝트가 들고 있다.\r\n 110:    */\r\n 111:   unitMass?: Partial<Record<ShearBarSize, number>>\r\n 112: }\r\n 113: \r\n 114: export function gridPointCount(grid: Grid): { nx: number; ny: number } {\r\n 115:   return {\r\n 116:     nx: grid.xSpans.length + 1,\r\n 117:     ny: grid.ySpans.length + 1,\r\n 118:   }\r\n 119: }\r\n 120: \r\n 121: export function gridPoint(\r\n 122:   grid: Grid,\r\n 123:   ix: number,\r\n 124:   iy: number,\r\n 125: ): { x: number; y: number } {\r\n 126:   const { nx, ny } = gridPointCount(grid)\r\n 127: \r\n 128:   if (\r\n 129:     !Number.isInteger(ix) ||\r\n 130:     !Number.isInteger(iy) ||\r\n 131:     ix < 0 ||\r\n 132:     ix >= nx ||\r\n 133:     iy < 0 ||\r\n 134:     iy >= ny\r\n 135:   ) {\r\n 136:     throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\r\n 137:   }\r\n 138: \r\n 139:   return {\r\n 140:     x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\r\n 141:     y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\r\n 142:   }\r\n 143: }\r\n 144: \r\n 145: /**\r\n 146:  * storyId는 \"1F\" 같은 letter+digit 라벨이라 룰팩 상수(D25 등)와 값의\r\n 147:  * 모양만으로 구분되지 않는다 — telemetry.ts의 스크러버는 letter+digit\r\n 148:  * 토큰을 통째로 남기므로, 그냥 보간하면 階 라벨이 그대로 새어 나간다(9차\r\n 149:  * 리뷰 critical). JSON 블록으로 감싸면 스크러버의 `{...}` 규칙에 걸린다.\r\n 150:  * 이 포맷을 함수 하나로 고정해 다음 호출부가 규약을 손으로 다시 베끼지\r\n 151:  * 않게 한다(9차 리뷰 minor).\r\n 152:  */\r\n 153: export function storyNotFound(storyId: string): Error {\r\n 154:   return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\r\n 155: }\r\n 156: \r\n 157: /** 층 바닥의 누적 표고(mm). stories 배열 순서대로 아래층 height를 누적한다. */\r\n 158: export function storyElevation(stories: Story[], storyId: string): number {\r\n 159:   const index = stories.findIndex(({ id }) => id === storyId)\r\n 160: \r\n 161:   if (index < 0) {\r\n 162:     throw storyNotFound(storyId)\r\n 163:   }\r\n 164: \r\n 165:   return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\r\n 166: }\r\n 167: \r\n 168: export function findSection(project: Project, sectionId: string): Section {\r\n 169:   const section = project.sections.find(({ id }) => id === sectionId)\r\n 170: \r\n 171:   if (!section) {\r\n 172:     throw new Error(`Section not found: ${sectionId}`)\r\n 173:   }\r\n 174: \r\n 175:   return section\r\n 176: }\r\n 177: \r\n 178: export function memberGroupKey(project: Project, member: Member): string {\r\n 179:   const story = project.stories.find(({ id }) => id === member.storyId)\r\n 180:   if (!story) {\r\n 181:     throw storyNotFound(member.storyId)\r\n 182:   }\r\n 183: \r\n 184:   const section = findSection(project, member.sectionId)\r\n 185:   if (section.kind !== member.kind) {\r\n 186:     throw new Error(\r\n 187:       `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\r\n 188:     )\r\n 189:   }\r\n 190: \r\n 191:   const memberCode = MEMBER_GROUP_CODE[member.kind]\r\n 192:   return `${story.name}|${memberCode}|${section.mark}`\r\n 193: }\r\n 194: \r\n 195: /** 内訳書のグループ鍵に使う部材コード。符号(mark)と階の間に挟まる一文字。 */\r\n 196: const MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\r\n 197:   柱: 'C',\r\n 198:   大梁: 'G',\r\n 199:   耐震壁: 'W',\r\n 200:   床板: 'S',\r\n 201: }\r\n 202: \r\n 203: function isColumnPosition(\r\n 204:   position: ColumnPosition | GirderPosition,\r\n 205: ): position is ColumnPosition {\r\n 206:   return !('axis' in position)\r\n 207: }\r\n 208: \r\n 209: function isGirderPosition(\r\n 210:   position: ColumnPosition | GirderPosition,\r\n 211: ): position is GirderPosition {\r\n 212:   return 'axis' in position\r\n 213: }\r\n 214: \r\n 215: function touchesColumn(\r\n 216:   girder: GirderPosition,\r\n 217:   column: ColumnPosition,\r\n 218: ): boolean {\r\n 219:   if (girder.axis === 'X') {\r\n 220:     return (\r\n 221:       girder.iy === column.iy &&\r\n 222:       (girder.ix === column.ix || girder.ix + 1 === column.ix)\r\n 223:     )\r\n 224:   }\r\n 225: \r\n 226:   return (\r\n 227:     girder.ix === column.ix &&\r\n 228:     (girder.iy === column.iy || girder.iy + 1 === column.iy)\r\n 229:   )\r\n 230: }\r\n 231: \r\n 232: export interface GirderSpan {\r\n 233:   axis: 'X' | 'Y'\r\n 234:   /** 그리드 교점 간 중심 스팬 (mm) */\r\n 235:   centerSpan: number\r\n 236:   /** 内法長さ (mm) — 양단 柱面 사이 */\r\n 237:   clear: number\r\n 238:   /** 시작 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n 239:   startFaceOffsetMm: number\r\n 240:   /** 끝 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n 241:   endFaceOffsetMm: number\r\n 242:   /** 정착 수용성 검사용 — 시작 柱의 축방향 전체 치수 (mm) */\r\n 243:   startSupportLengthAlongAxisMm: number\r\n 244:   /** 정착 수용성 검사용 — 끝 柱의 축방향 전체 치수 (mm) */\r\n 245:   endSupportLengthAlongAxisMm: number\r\n 246:   /** 지점 柱의 かぶり 조회 조건 — 端部条件은 大梁이 아니라 柱의 かぶり로 판정한다 */\r\n 247:   startSupportCover: Record<string, string | boolean>\r\n 248:   endSupportCover: Record<string, string | boolean>\r\n 249: }\r\n 250: \r\n 251: export function girderSupportSections(\r\n 252:   project: Project,\r\n 253:   member: Member,\r\n 254: ): { start: ColumnSection; end: ColumnSection } {\r\n 255:   if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\r\n 256:     throw new Error(`girderSupportSections requires a 大梁: ${member.id}`)\r\n 257:   }\r\n 258: \r\n 259:   const { axis, ix, iy } = member.position\r\n 260:   const endIx = axis === 'X' ? ix + 1 : ix\r\n 650:         // 言うが、径が同じでもピッチが違えば全部の鉄筋が通るわけではない —\r\n 651:         // 断面が同じことはその十分条件であって、図面にない連続を作らない。\r\n 652:         candidate.sectionId === member.sectionId &&\r\n 653:         isSlabPosition(candidate.position) &&\r\n 654:         candidate.position.ix === candidateIx &&\r\n 655:         candidate.position.iy === candidateIy,\r\n 656:     )\r\n 657: \r\n 658:   const step = (offset: number): [number, number] =>\r\n 659:     axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\r\n 660: \r\n 661:   const members: Member[] = [member]\r\n 662:   for (let offset = -1; ; offset -= 1) {\r\n 663:     const previous = slabAt(...step(offset))\r\n 664:     if (!previous) break\r\n 665:     members.unshift(previous)\r\n 666:   }\r\n 667:   for (let offset = 1; ; offset += 1) {\r\n 668:     const next = slabAt(...step(offset))\r\n 669:     if (!next) break\r\n 670:     members.push(next)\r\n 671:   }\r\n 672: \r\n 673:   const bays = members.map((candidate) => slabBay(project, candidate))\r\n 674:   const clearAlong = (bay: SlabBay): number =>\r\n 675:     axis === 'X' ? bay.clearXMm : bay.clearYMm\r\n 676:   const clearAcross = (bay: SlabBay): number =>\r\n 677:     axis === 'X' ? bay.clearYMm : bay.clearXMm\r\n 678: \r\n 679:   // 割付本数は 1通則7) が「その部分の長さ」を鉄筋の間隔で除して求める1つの数だ。\r\n 680:   // ランの途中で直交方向の内法が変われば、その1つの数がどちらのベイでも正しく\r\n 681:   // ならない — 一部だけ通る鉄筋を製品が表現できないので、作らずに落とす。\r\n 682:   const distributionClearMm = clearAcross(bays[0])\r\n 683:   const uneven = bays.findIndex(\r\n 684:     (bay) => clearAcross(bay) !== distributionClearMm,\r\n 685:   )\r\n 686:   if (uneven > 0) {\r\n 687:     throw new MemberUnsupportedError(\r\n 688:       '寸法不成立',\r\n 689:       `床板ラン内で割付方向の内法長さが揃わない: ${members[0].id} ` +\r\n 690:         `(${distributionClearMm} mm) と ${members[uneven].id} ` +\r\n 691:         `(${clearAcross(bays[uneven])} mm)`,\r\n 692:     )\r\n 693:   }\r\n 694: \r\n 695:   // 中間大梁の幅は「幅の1/2」が両側から来て1本分になる — 2（４）床板1) の\r\n 696:   // 但書がそう定める。大梁のラン芯長が中間柱せいを足すのと同じ形だ。\r\n 697:   // ベイの始まりを一度だけ累積し、最後のベイの始まり ＋ その内法を芯長とする —\r\n 698:   // 二つを別々に数えるとすぐ食い違う（大梁のランと同じ約束）。\r\n 699:   const memberOffsetsMm: number[] = []\r\n 700:   let offsetMm = 0\r\n 701:   for (const bay of bays) {\r\n 702:     memberOffsetsMm.push(offsetMm)\r\n 703:     offsetMm +=\r\n 704:       clearAlong(bay) +\r\n 705:       (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\r\n 706:   }\r\n 707:   const coreLengthMm =\r\n 708:     memberOffsetsMm[memberOffsetsMm.length - 1] +\r\n 709:     clearAlong(bays[bays.length - 1])\r\n 710: \r\n 711:   const first = bays[0]\r\n 712:   const last = bays[bays.length - 1]\r\n 713: \r\n 714:   // ベイ局所の開口をラン座標へ移す。走る向きにだけベイのオフセットが乗る —\r\n 715:   // 直交方向の内法はラン内で共通なので（上でそれを検査している）そのままだ。\r\n 716:   const openings = members.flatMap((candidate, index) =>\r\n 717:     (candidate.openings ?? []).map((opening) => ({\r\n 718:       ...opening,\r\n 719:       xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\r\n 720:       yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\r\n 721:     })),\r\n 722:   )\r\n 723: \r\n 724:   return {\r\n 725:     axis,\r\n 726:     members,\r\n 727:     ownerId: members[0].id,\r\n 728:     bays,\r\n 729:     memberOffsetsMm,\r\n 730:     coreLengthMm,\r\n 731:     distributionClearMm,\r\n 732:     startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\r\n 733:     endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\r\n 734:     openings,\r\n 735:   }\r\n 736: }\r\n 737: \r\n 738: export interface GirderRun {\r\n 739:   axis: 'X' | 'Y'\r\n 740:   /** 축방향 오름차순. 단일 스팬이면 길이 1 */\r\n 741:   members: Member[]\r\n 742:   /** 通し筋을 귀속시킬 부재 = members[0].id */\r\n 743:   ownerId: string\r\n 744:   /** members와 같은 순서 */\r\n 745:   spans: GirderSpan[]\r\n 746:   /**\r\n 747:    * 런 원점(시작 柱の内側面)에서 각 스팬 시작면까지의 거리 (mm). members와 같은\r\n 748:    * 순서이고 [0]은 0이다.\r\n 749:    *\r\n 750:    * 通し筋은 런 전체를 한 프레임에 덮지만 あばら筋은 각 부재 자기 스팬 로컬(0 기준)\r\n 751:    * 이다. 런을 한 프레임에 그리는 쪽이 이 오프셋을 모르면 2번째 이후 스팬의\r\n 752:    * あばら筋이 1번째 스팬 위에 겹친다.\r\n 753:    */\r\n 754:   memberOffsetsMm: number[]\r\n 755:   /** 通し筋 코어 길이 (mm) = Σ内法 ＋ Σ中間柱の軸方向せい */\r\n 756:   coreLengthMm: number\r\n 757: }\r\n 758: \r\n 759: function girderAxisIndex(position: GirderPosition): number {\r\n 760:   return position.axis === 'X' ? position.ix : position.iy\r\n 761: }\r\n 762: \r\n 763: export function girderRun(project: Project, member: Member): GirderRun {\r\n 764:   if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\r\n 765:     throw new Error(`girderRun requires a 大梁: ${member.id}`)\r\n 766:   }\r\n 767: \r\n 768:   const position = member.position\r\n 769:   const candidates = project.members\r\n 770:     .filter((candidate) => {\r\n 771:       if (\r\n 772:         candidate.kind !== '大梁' ||\r\n 773:         candidate.storyId !== member.storyId ||\r\n 774:         !isGirderPosition(candidate.position) ||\r\n 775:         candidate.position.axis !== position.axis\r\n 776:       ) {\r\n 777:         return false\r\n 778:       }\r\n 779: \r\n 780:       return position.axis === 'X'\r\n 781:         ? candidate.position.iy === position.iy\r\n 782:         : candidate.position.ix === position.ix\r\n 783:     })\r\n 784:     .sort((left, right) => {\r\n 785:       if (!isGirderPosition(left.position) || !isGirderPosition(right.position)) {\r\n 786:         throw new Error('大梁 run contains a non-girder position')\r\n 787:       }\r\n 788:       return girderAxisIndex(left.position) - girderAxisIndex(right.position)\r\n 789:     })\r\n 790:   const memberIndex = candidates.findIndex(({ id }) => id === member.id)\r\n 791: \r\n 792:   if (memberIndex < 0) {\r\n 793:     throw new Error(`大梁 member not found in project: ${member.id}`)\r\n 794:   }\r\n 795: \r\n 796:   let first = memberIndex\r\n 797:   let last = memberIndex\r\n 798:   while (\r\n 799:     first > 0 &&\r\n 800:     girderAxisIndex(candidates[first - 1].position as GirderPosition) ===\r\n 801:       girderAxisIndex(candidates[first].position as GirderPosition) - 1\r\n 802:   ) {\r\n 803:     first -= 1\r\n 804:   }\r\n 805:   while (\r\n 806:     last + 1 < candidates.length &&\r\n 807:     girderAxisIndex(candidates[last + 1].position as GirderPosition) ===\r\n 808:       girderAxisIndex(candidates[last].position as GirderPosition) + 1\r\n 809:   ) {\r\n 810:     last += 1\r\n 811:   }\r\n 812: \r\n 813:   const members = candidates.slice(first, last + 1)\r\n 814:   const sectionId = members[0].sectionId\r\n 815:   if (members.some((candidate) => candidate.sectionId !== sectionId)) {\r\n 816:     throw new Error(\r\n 817:       `大梁 run contains mixed sections: ${members.map(({ id, sectionId: idOfSection }) => `${id}:${idOfSection}`).join(', ')}`,\r\n 818:     )\r\n 819:   }\r\n 820: \r\n 821:   const spans = members.map((candidate) => girderSpan(project, candidate))\r\n 822:   // 스팬 시작면들의 누적 위치. 마지막 스팬 시작면 ＋ 그 内法이 코어 길이다 —\r\n 823:   // 두 값을 따로 세면 곧 어긋나므로 한 번만 누적한다.\r\n 824:   const memberOffsetsMm: number[] = []\r\n 825:   let offsetMm = 0\r\n 826:   for (const span of spans) {\r\n 827:     memberOffsetsMm.push(offsetMm)\r\n 828:     offsetMm += span.clear + span.endSupportLengthAlongAxisMm\r\n 829:   }\r\n 830:   const lastSpan = spans[spans.length - 1]\r\n 831:   const coreLengthMm =\r\n 832:     memberOffsetsMm[memberOffsetsMm.length - 1] + lastSpan.clear\r\n 833: \r\n 834:   return {\r\n 835:     axis: position.axis,\r\n 836:     members,\r\n 837:     ownerId: members[0].id,\r\n 838:     spans,\r\n 839:     memberOffsetsMm,\r\n 840:     coreLengthMm,\r\n 841:   }\r\n 842: }\r\n 843: \r\n 844: /**\r\n 845:  * 柱主筋の端部条件 (R7①・R9①)。\r\n 846:  *\r\n 847:  * 定着(bottom)은 스택의 **최하단**(기초)에만 붙는다. 中間 접합부는 철근이\r\n 848:  * 그대로 지나가므로 なし다.\r\n 849:  *\r\n 850:  * top은 定着을 붙이지 않는다 — 항상 なし(중간 접합부, 위층으로 통과) 아니면\r\n 851:  * 先端(스택 최상단, 위에 柱가 없음)이다. 数量積算基準 1通則1)「先端で止まる\r\n 852:  * 鉄筋は、コンクリートの設計寸法をその部分の鉄筋の長さとする」＋（２）柱1)\r\n 853:  * 但書「最上階柱の主筋については、１通則１）による」가 最上階柱主筋을 명시적으로\r\n 854:  * 1通則1)에 걸어두므로, 스택 최상단은 定着 없이 콘크리트 설계 치수까지만\r\n 855:  * 간다(R9①). 이전에는 스택 최상단에도 定着을 붙였는데, 이는 조문과 어긋났다.\r\n 856:  *\r\n 857:  * 접합부의 **継手는 여기서 다루지 않는다.** 数量積算基準 2（２）柱2)가\r\n 858:  * 「各階柱の全長にわたる主筋については各階ごとに1か所」로 정하므로 층마다\r\n 859:  * 조문대로 1か所이고, 그 배분을 제품이 정할 여지가 없다. 예전에는 접합부의\r\n 860:  * 継手를 위층 부재에 귀속시키는 관행을 코드가 들고 있었는데(그래서 최하층은\r\n 861:  * 継手가 0이었다), 조문이 그 자리를 대신한다.\r\n 862:  *\r\n 863:  * 스택 순서는 `stories` 배열 순서를 그대로 신뢰한다 — Story에 레벨 값이 없다.\r\n 864:  */\r\n 865: export interface ColumnEnds {\r\n 866:   bottom: '定着' | 'なし'\r\n 867:   top: 'なし' | '先端'\r\n 868: }\r\n 869: \r\n 870: export function columnEnds(project: Project, member: Member): ColumnEnds {\r\n 871:   const { position } = member\r\n 872: \r\n 873:   if (member.kind !== '柱' || !isColumnPosition(position)) {\r\n 874:     throw new Error(`columnEnds requires a 柱: ${member.id}`)\r\n 875:   }\r\n 876: \r\n 877:   const level = project.stories.findIndex(({ id }) => id === member.storyId)\r\n 878:   if (level < 0) {\r\n 879:     throw storyNotFound(member.storyId)\r\n 880:   }\r\n 881: \r\n 882:   const hasColumnAtLevel = (candidateLevel: number): boolean => {\r\n 883:     const story = project.stories[candidateLevel]\r\n 884:     if (story === undefined) return false\r\n 885: \r\n 886:     return project.members.some(\r\n 887:       (candidate) =>\r\n 888:         candidate.kind === '柱' &&\r\n 889:         candidate.storyId === story.id &&\r\n 890:         isColumnPosition(candidate.position) &&\r\n 891:         candidate.position.ix === position.ix &&\r\n 892:         candidate.position.iy === position.iy,\r\n 893:     )\r\n 894:   }\r\n 895: \r\n 896:   return {\r\n 897:     bottom: hasColumnAtLevel(level - 1) ? 'なし' : '定着',\r\n 898:     top: hasColumnAtLevel(level + 1) ? 'なし' : '先端',\r\n 899:   }\r\n 900: }\r\n 901: \r\n 902: export function beamDepthAbove(project: Project, member: Member): number {\r\n 903:   if (member.kind !== '柱' || !isColumnPosition(member.position)) {\r\n 904:     throw new Error(`beamDepthAbove requires a 柱: ${member.id}`)\r\n 905:   }\r\n 906: \r\n 907:   const depths = project.members\r\n 908:     .filter(\r\n 909:       (candidate) =>\r\n 910:         candidate.kind === '大梁' &&\r\n 911:         candidate.storyId === member.storyId &&\r\n 912:         isGirderPosition(candidate.position) &&\r\n 913:         touchesColumn(candidate.position, member.position),\r\n 914:     )\r\n 915:     .map((girder) => {\r\n 916:       const section = findSection(project, girder.sectionId)\r\n 917:       if (section.kind !== '大梁') {\r\n 918:         throw new Error(\r\n 919:           `大梁 member references a non-大梁 section: ${girder.id}`,\r\n 920:         )\r\n 921:       }\r\n 922:       return section.depth\r\n 923:     })\r\n 924: \r\n 925:   if (depths.length === 0) {\r\n 926:     throw new Error(`No touching 大梁 found above 柱: ${member.id}`)\r\n 927:   }\r\n 928: \r\n 929:   return Math.max(...depths)\r\n 930: }\r\n 931: \r\n 932: export function setNote(\r\n 933:   project: Project,\r\n 934:   lineId: string,\r\n 935:   note: string,\r\n 936: ): Project {\r\n 937:   const notes = { ...project.notes }\r\n 938: \r\n 939:   if (note === '') delete notes[lineId]\r\n 940:   else notes[lineId] = note\r\n 941: \r\n 942:   return { ...project, notes }\r\n 943: }\r\n 944: \r\n 945: /** 빈 입력은 키를 지운다 — 0 kg/m는 입력이 아니라 없는 값이다. */\r\n 946: export function setUnitMass(\r\n 947:   project: Project,\r\n 948:   size: ShearBarSize,\r\n 949:   value: number | null,\r\n 950: ): Project {\r\n 951:   const unitMass = { ...project.unitMass }\r\n 952: \r\n 953:   if (value === null) delete unitMass[size]\r\n 954:   else unitMass[size] = value\r\n 955: \r\n 956:   return { ...project, unitMass }\r\n 957: }\r\n 958: \r\n 959: export function serializeProject(project: Project): string {\r\n 960:   return JSON.stringify(project)\r\n 961: }\r\n 962: \r\n 963: const isString = (value: unknown): boolean => typeof value === 'string'\r\n 964: \r\n 965: const isFiniteNumber = (value: unknown): boolean =>\r\n 966:   typeof value === 'number' && Number.isFinite(value)\r\n 967: \r\n 968: function isRecord(value: unknown): value is Record<string, unknown> {\r\n 969:   return typeof value === 'object' && value !== null && !Array.isArray(value)\r\n 970: }\r\n 971: \r\n 972: function hasShape(\r\n 973:   value: unknown,\r\n 974:   fields: Record<string, (field: unknown) => boolean>,\r\n 975: ): boolean {\r\n 976:   return (\r\n 977:     isRecord(value) &&\r\n 978:     Object.entries(fields).every(([key, check]) => check(value[key]))\r\n 979:   )\r\n 980: }\r\n===== src/domain/rebar/wall.ts =====\r\n===== src/domain/rebar/index.ts =====\r\nResolve-Path : Cannot find path 'C:\\Users\\emper\\mdtproject\\src\\domain\\rebar\\index.ts' because it does not exist.\r\nAt line:2 char:375\r\n+ ... == $f =====\"; $lines=[IO.File]::ReadAllLines((Resolve-Path $f)); swit ...\r\n+                                                   ~~~~~~~~~~~~~~~\r\n    + CategoryInfo          : ObjectNotFound: (C:\\Users\\emper\\...\\rebar\\index.ts:String) [Resolve-Path], ItemNotFoundE \r\n   xception\r\n    + FullyQualifiedErrorId : PathNotFound,Microsoft.PowerShell.Commands.ResolvePathCommand\r\n \r\nException calling \"ReadAllLines\" with \"1\" argument(s): \"Value cannot be null.\r\nParameter name: path\"\r\nAt line:2 char:343\r\n+ ...  $f =====\"; $lines=[IO.File]::ReadAllLines((Resolve-Path $f)); switch ...\r\n+                 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\r\n    + CategoryInfo          : NotSpecified: (:) [], MethodInvocationException\r\n    + FullyQualifiedErrorId : ArgumentNullException\r\n \r\n===== src/domain/quantity/measurement.ts =====\r\nResolve-Path : Cannot find path 'C:\\Users\\emper\\mdtproject\\src\\domain\\quantity\\measurement.ts' because it does not exis\r\nt.\r\nAt line:2 char:375\r\n+ ... == $f =====\"; $lines=[IO.File]::ReadAllLines((Resolve-Path $f)); swit ...\r\n+                                                   ~~~~~~~~~~~~~~~\r\n    + CategoryInfo          : ObjectNotFound: (C:\\Users\\emper\\...\\measurement.ts:String) [Resolve-Path],