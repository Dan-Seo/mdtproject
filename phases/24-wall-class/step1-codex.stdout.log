\r\n 190: describe('GirderMainRow serialization compatibility', () => {\r\n 191:   it('accepts a finite startCount while keeping the legacy omitted field valid', () => {\r\n 192:     const project = createProject()\r\n 193:     const withAsymmetricRow = {\r\n 194:       ...project,\r\n 195:       sections: [\r\n 196:         columnSection,\r\n 197:         {\r\n 198:           ...shallowGirderSection,\r\n 199:           main: {\r\n 200:             ...shallowGirderSection.main,\r\n 201:             top: { endCount: 8, centerCount: 5, startCount: 4 },\r\n 202:           },\r\n 203:         },\r\n 204:       ],\r\n 205:     }\r\n 206: \r\n 207:     expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n 208:     expect(deserializeProject(serializeProject(withAsymmetricRow))).toEqual(\r\n 209:       withAsymmetricRow,\r\n 210:     )\r\n 211:   })\r\n 212: \r\n 213:   it('rejects a non-finite-shaped startCount when it is present', () => {\r\n 214:     const project = createProject()\r\n 215:     const validProject = {\r\n 216:       ...project,\r\n 217:       sections: [\r\n 218:         columnSection,\r\n 219:         {\r\n 220:           ...shallowGirderSection,\r\n 221:           main: {\r\n 222:             ...shallowGirderSection.main,\r\n 223:             top: { endCount: 8, centerCount: 5, startCount: 4 },\r\n 224:           },\r\n 225:         },\r\n 226:       ],\r\n 227:     }\r\n 228:     const serialized = serializeProject(validProject).replace(\r\n 229:       '\"startCount\":4',\r\n 230:       '\"startCount\":null',\r\n 231:     )\r\n 232: \r\n 233:     expect(() => deserializeProject(serialized)).toThrow(\r\n 234:       'Project shape mismatch',\r\n 235:     )\r\n 236:   })\r\n 237: })\r\n 238: \r\n 239: describe('Opening.reinforcements serialization validation', () => {\r\n 240:   const opening = {\r\n 241:     id: 'opening-1',\r\n 242:     xMm: 1000,\r\n 243:     yMm: 500,\r\n 244:     widthMm: 1200,\r\n 245:     heightMm: 800,\r\n 246:   }\r\n 247: \r\n 248:   it('keeps an opening without reinforcements compatible with existing records', () => {\r\n 249:     const project = createProject([\r\n 250:       {\r\n 251:         ...column,\r\n 252:         openings: [opening],\r\n 253:       },\r\n 254:     ])\r\n 255: \r\n 256:     expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n 257:   })\r\n 258: \r\n 259:   it('round-trips transcribed opening reinforcements without changing the schema version', () => {\r\n 260:     const project = createProject([\r\n 261:       {\r\n 262:         ...column,\r\n 263:         openings: [\r\n 264:           {\r\n 265:             ...opening,\r\n 266:             reinforcements: [\r\n 267:               { size: 'D13', count: 4, lengthMm: 1800 },\r\n 268:               { size: 'D10', count: 2, lengthMm: 1200 },\r\n 269:             ],\r\n 270:           },\r\n 271:         ],\r\n 272:       },\r\n 273:     ])\r\n 274: \r\n 275:     expect(project.schemaVersion).toBe(PROJECT_SCHEMA_VERSION)\r\n 276:     expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n 277:   })\r\n 278: \r\n 279:   it('round-trips an untranscribed zero-length reinforcement row', () => {\r\n 280:     const project = createProject([\r\n 281:       {\r\n 282:         ...column,\r\n 283:         openings: [\r\n 284:           {\r\n 285:             ...opening,\r\n 286:             reinforcements: [{ size: 'D13', count: 1, lengthMm: 0 }],\r\n 287:           },\r\n 288:         ],\r\n 289:       },\r\n 290:     ])\r\n 291: \r\n 292:     expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n 293:   })\r\n 294: \r\n 295:   it.each([\r\n 296:     ['an unsupported bar size', { size: 'D99' }],\r\n 297:     ['a high-strength shear bar size', { size: 'K13' }],\r\n 298:     ['a zero count', { count: 0 }],\r\n 299:     ['a fractional count', { count: 1.5 }],\r\n 300:     ['a negative length', { lengthMm: -1 }],\r\n 301:     ['a non-finite length', { lengthMm: Number.POSITIVE_INFINITY }],\r\n 302:   ])('rejects %s in a reinforcement transcription', (_label, change) => {\r\n 303:     const reinforcement = {\r\n 304:       size: 'D13',\r\n 305:       count: 1,\r\n 306:       lengthMm: 1000,\r\n 307:       ...change,\r\n 308:     } as unknown as OpeningReinforcement\r\n 309:     const project = createProject([\r\n 310:       {\r\n 311:         ...column,\r\n 312:         openings: [{ ...opening, reinforcements: [reinforcement] }],\r\n 313:       },\r\n 314:     ])\r\n 315: \r\n 316:     expect(() => deserializeProject(serializeProject(project))).toThrow(\r\n 317:       'Project shape mismatch',\r\n 318:     )\r\n 319:   })\r\n 320: })\r\n 321: \r\n 322: describe('girderSpan', () => {\r\n 323:   const rectangularColumnSection: ColumnSection = {\r\n 324:     ...columnSection,\r\n 325:     id: 'section-C-rectangular',\r\n 326:     mark: 'C-rectangular',\r\n 327:     b: 700,\r\n 328:     d: 900,\r\n 329:   }\r\n 330:   const narrowColumnSection: ColumnSection = {\r\n 331:     ...columnSection,\r\n 332:     id: 'section-C-narrow',\r\n 333:     mark: 'C-narrow',\r\n 334:     b: 600,\r\n 335:   }\r\n 336:   const wideColumnSection: ColumnSection = {\r\n 337:     ...columnSection,\r\n 338:     id: 'section-C-wide',\r\n 339:     mark: 'C-wide',\r\n 340:     b: 1000,\r\n 341:   }\r\n 342: \r\n 343:   function supportColumn(\r\n 344:     id: string,\r\n 345:     sectionId: string,\r\n 346:     ix: number,\r\n 347:     iy: number,\r\n 348:   ): Member {\r\n 349:     return {\r\n 350:       id,\r\n 351:       kind: '柱',\r\n 352:       memberClass: '躯体',\r\n 353:       sectionId,\r\n 354:       storyId: '1F',\r\n 355:       position: { ix, iy },\r\n 356:     }\r\n 357:   }\r\n 358: \r\n 359:   function girder(axis: 'X' | 'Y'): Member {\r\n 360:     return {\r\n 361:       id: `1F-G1-${axis}`,\r\n 362:       kind: '大梁',\r\n 363:       memberClass: '躯体',\r\n 364:       sectionId: deepGirderSection.id,\r\n 365:       storyId: '1