ed(value).replace(/\\s+/g, '')\n}\n\n/**\n * ?몄젒 ?먯젙 諛곗닔??湲곕낯媛? ?뱀뀡由ъ뒪???뚯꽌媛 吏湲덇퉴吏 ??媛믪쑝濡??숈옉???붽퀬,\n * gapRatio瑜??앸왂?섎뒗 ?몄텧(?뱀뀡由ъ뒪??履?? ?꾨? ??媛믪쓣 洹몃?濡??대떎 ??諛붽씀硫? * 洹??뚯꽌?????섎닎???щ씪吏꾨떎.\n */\nconst DEFAULT_SEGMENT_GAP_RATIO = 2.2\n\nexport function makeSegments(\n  items: TextItem[],\n  gapRatio: number = DEFAULT_SEGMENT_GAP_RATIO,\n): TextSegment[] {\n  const sorted = [...items].sort((left, right) => left.x - right.x)\n  const groups: TextItem[][] = []\n\n  for (const item of sorted) {\n    const group = groups.at(-1)\n    const previous = group?.at(-1)\n    // 臾명꽦? 湲???믪씠??諛곗닔 ?섎굹肉먯씠?????덈? ?섑븳(??`Math.max(4, ??`)?\n    // ?먯? ?딅뒗?? ?댁쑀媛 ?섏씠??\n    //\n    // (1) ?대뼡 ?뺥깭濡??⑤룄 二쎌? 媛吏媛 ?쒕떎. ?섑븳??gapRatio??鍮꾨??쒗궎硫?    //     `4*(r/2.2) > min(h)*r ??min(h) < 4/2.2 = 1.8182pt`濡?**r???쎈텇??*\n    //     諛곗닔? 臾닿??댁?怨? ?쎌뒪泥?5遺??湲???믪씠??4.26~14.16pt???대뒓\n    //     ?몄텧遺?먯꽌???닿린吏 紐삵븳?? 怨좎젙 4pt濡??섎룎由щ㈃ ?대쾲??諛섎?濡?    //     醫곹엺 諛곗닔(0.5)瑜?h??pt ?꾨㈃?먯꽌 ?듭㎏濡??좎떇?쒕떎.\n    // (2) 吏??寃껋씠 ?덈떎??媛???먯껜媛 ?ㅼ륫?먯꽌 臾대꼫吏꾨떎. ?뚰븳 ?좏겙???щ윭\n    //     pdf.js ?꾩씠?쒖쑝濡?履쇨컻???묒? ?덈? 媛꾧꺽???⑤뒗???щ???肄뷀띁?ㅼ뿉\n    //     ?ㅼ옱?쒕떎 ??yokohama-p14 y??15.84????50x1000?띿씠 `650`쨌`x`쨌`1`쨌`000`\n    //     ???꾩씠?쒖쑝濡??⑤떎. 洹몃윴??**遺숈뿬????媛꾧꺽(`1`??000`)怨?媛덈씪????    //     媛꾧꺽(`650`??x`, `x`??1`)???꾨? ?뺥솗??4.9770pt濡?媛숇떎.** ?대뼡 ?섑븳??    //     ?섏쓣 媛瑜댁? 紐삵븳??????000?띿쓣 ?대━??媛믪? ?똸1000?띾룄 ?④퍡 留뚮뱺??\n    //     ?섑븳??吏?????덉뿀???좎씪???ㅻЪ???먮━?곸쑝濡?吏?????녿뒗 寃껋씠??\n    //\n    // 媛숈? ?꾩씠???덉쓽 湲?먮뒗 媛꾧꺽??**?뺥솗??0**?대떎(toTextItems媛\n    // `x = ?먯젏 + characterWidth*index`濡??볤퀬 洹?characterWidth瑜?w濡??ｋ뒗??.\n    // 洹몃옒????臾명꽦??媛瑜대뒗 寃껋? ?몄젣???꾩씠??**?ъ씠**?닿퀬, 臾명꽦??醫곹삍???뚯쓽\n    // ?ㅽ뙣??蹂묓빀???꾨땲??遺꾨━ ??吏?대궡吏 ?딄퀬 嫄곗젅?섎뒗 履쎌씠??\n    const threshold = previous ? Math.min(previous.h, item.h) * gapRatio : 0\n\n    if (!group || !previous || item.x - (previous.x + previous.w) > threshold) {\n      groups.push([item])\n    } else {\n      group.push(item)\n    }\n  }\n\n  return groups.map((group) => {\n    const t