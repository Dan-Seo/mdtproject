berId) && scope.memberIds.includes(b.memberId))\r\n 285: }\r\n 286: \r\n 287: export function defaultExclusions(now: string): CheckExclusion[] {\r\n 288:   const reason = '作図規則による意図された接触 — 帯筋/あばら筋の外面をかぶり面に、主筋をその内面に接するよう配置する（src/lib/viewer/geometry.ts rebarPlacements）'\r\n 289:   return [\r\n 290:     ['帯筋', '主筋'],\r\n 291:     ['あばら筋', '上端筋'],\r\n 292:     ['あばら筋', '下端筋'],\r\n 293:   ].map(([left, right]) => {\r\n 294:     const scope = {\r\n 295:       sameMemberOnly: true,\r\n 296:       roles: [left, right] as [string, string],\r\n 297:       kinds: [CONTACT] as FindingKind[],\r\n 298:     }\r\n 299:     return { id: hashString(canonicalJson(scope)), scope, reason, createdAt: now }\r\n 300:   })\r\n 301: }\r\n 302: \r\n 303: export function runGeometryCheck(input: CheckInput): CheckResult {\r\n 304:   const allRebarMemberIds = jointRebarMemberIds(input.project, input.joint)\r\n 305:   const memberIds = jointMemberIds(input.joint)\r\n 306:   const unsupported = allRebarMemberIds.filter((id) => input.unsupportedMemberIds.has(id))\r\n 307:   const rebarMemberIds = allRebarMemberIds.filter((id) => !input.unsupportedMemberIds.has(id))\r\n 308:   const targetIds = new Set(rebarMemberIds)\r\n 309:   const layout = buildingLayout(\r\n 310:     input.project,\r\n 311:     input.rebars,\r\n 312:     input.unsupportedMemberIds,\r\n 313:     (size) => barDiameter(size) / 2,\r\n 314:   )\r\n 315:   const targetInstances = layout.rebar.filter((instance) => targetIds.has(instance.memberId))\r\n 316:   const maximumDiameter = targetInstances.length\r\n 317:     ? Math.max(...targetInstances.map(({ size }) => barDiameter(size)))\r\n 318:     : 0\r\n 319:   const column = findColumnBox(input.project, input.joint.columnMemberId)\r\n 320:   const regionMm = checkRegion(layout, column, targetInstances, maximumDiameter)\r\n 321:   const scope: CheckScope = {\r\n 322:     memberIds: [...memberIds],\r\n 323:     rebarMemberIds: [...rebarMemberIds],\r\n 324:     referenceMemberIds: [...input.joint.reference.memberIds],\r\n 325:     unsupportedMemberIds: [...unsupported],\r\n 326:     barCount: new Set(targetInstances.map(({ rebarId, barIndex }) => `${rebarId}:${barIndex}`)).size,\r\n 327:     segmentCount: targetInstances.length,\r\n 328:     regionMm,\r\n 329:     pairsTested: 0,\r\n 330:     droppedOutsideRegion: 0,\r\n 331:   }\r\n 332: \r\n 333:   const padding = Math.max(NUMERICAL_TOLERANCE_MM, input.settings.clearance?.valueMm ?? 0)\r\n 334:   const candidates = targetInstances.filter((instance) => segmentIntersectsRegion(instance, regionMm, padding))\r\n 335:   const findings: Finding[] = []\r\n 336: \r\n 337:   for (let leftIndex = 0; leftIndex < candidates.length; leftIndex += 1) {\r\n 338:     const left = candidates[leftIndex]\r\n 339:     for (let rightIndex = leftIndex + 1; rightIndex < candidates.length; rightIndex += 1) {\r\n 340:       const right = candidates[rightIndex]\r\n 341:       if (left.rebarId === right.rebarId && left.barIndex === right.barIndex) continue\r\n 342:       if (!rangesOverlap(expandedSegmentRange(left, 0, left.radius + padding), expandedSegmentRange(right, 0, right.radius + padding))) continue\r\n 343:       if (!rangesOverlap(expandedSegmentRange(left, 1, left.radius + padding), expandedSegmentRange(right, 1, right.radius + padding))) continue\r\n 344:       if (!rangesOverlap(expandedSegmentRange(left, 2, left.radius + padding), expandedSegmentRange(right, 2, right.radius + padding))) continue\r\n 345: \r\n 346:       scope.pairsTested += 1\r\n 347:       const result = capsuleClearanceMm(\r\n 348:         { from: left.from, to: left.to, radius: left.radius } satisfies Segment,\r\n 349:         { from: right.from, to: right.to, radius: right.radius } satisfies Segment,\r\n 350:       )\r\n 351:       const middle = midpoint(result.pa, result.pb)\r\n 352:       if (!pointInPlanRegion(middle, regionMm)) {\r\n 353:         scope.droppedOutsideRegion += 1\r\n 354:         continue\r\n 355:       }\r\n 356: \r\n 357:       const leftRef = refOf(left)\r\n 358:       const rightRef = refOf(right)\r\n 359:       let kind: FindingKind | null = null\r\n 360:       let basis: Finding['basis'] | null = null\r\n 361:       if (result.clearanceMm < -NUMERICAL_TOLERANCE_MM) {\r\n 362:         kind = CLASH\r\n 363:         basis = { kind: '幾何学的重なり' }\r\n 364:       } else if (Math.abs(result.clearanceMm) <= NUMERICAL_TOLERANCE_MM) {\r\n 365:         kind = CONTACT\r\n 366:         basis = { kind: '接触（許容誤差内）' }\r\n 367:       } else if (input.settings.clearance !== null && result.clearanceMm < input.settings.clearance.valueMm) {\r\n 368:         kind = CLEARANCE\r\n 369:         basis = {\r\n 370:           kind: '利用者入力あき',\r\n 371:           valueMm: input.settings.clearance.valueMm,\r\n 372:           scope: input.settings.clearance.scope,\r\n 373:         }\r\n 374:       }\r\n 375:       if (kind === null || basis === null) continue\r\n 376: \r\n 377:       const excludedBy = input.exclusions.find((exclusion) => exclusionMatches(exclusion, kind, leftRef, rightRef))?.id ?? null\r\n 378:       const [a, b] = orderedRefs(leftRef, rightRef)\r\n 379:       findings.push({\r\n 380:         id: findingId(kind, a, b),\r\n 381:         kind,\r\n 382:         a,\r\n 383:         b,\r\n 384:         clearanceMm: result.clearanceMm,\r\n 385:         closestPoints: [result.pa, result.pb],\r\n 386:         midpoint: middle,\r\n 387:         basis,\r\n 388:         excludedBy,\r\n 389:       })\r\n 390:     }\r\n 391:   }\r\n 392: \r\n 393:   findings.sort((left, right) => findingOrder(left.kind) - findingOrder(right.kind)\r\n 394:     || left.clearanceMm - right.clearanceMm\r\n 395:     || left.id.localeCompare(right.id))\r\n 396: \r\n 397:   const checkId = hashString(canonicalJson({\r\n 398:     version: GEOMETRY_CHECK_VERSION,\r\n 399:     members: Object.fromEntries(rebarMemberIds.slice().sort().map((memberId) => [memberId, input.fingerprints.members[memberId] ?? null])),\r\n 400:     checkConditions: checkConditionsFingerprint(input.settings, input.exclusions),\r\n 401:     regionMm,\r\n 402:   }))\r\n 403:   return {\r\n 404:     checkId,\r\n 405:     version: GEOMETRY_CHECK_VERSION,\r\n 406:     jointRef: { columnMemberId: input.joint.columnMemberId },\r\n 407:     scope,\r\n 408:     verdict: verdictFor(findings, scope.pairsTested, input.settings.clearance),\r\n 409:     findings,\r\n 410:     unchecked: uncheckedItems(unsupported),\r\n 411:     assumptions: [...ASSUMPTIONS],\r\n 412:     toleranceMm: NUMERICAL_TOLERANCE_MM,\r\n 413:   }\r\n 414: }\r\n\n---USE-REVIEW---\r\n   1: 'use client'\r\n   2: \r\n   3: import { useMemo } from 'react'\r\n   4: \r\n   5: import type { Project } from '@/domain/model/project'\r\n   6: import { assessImpact, type TakeoffSnapshot } from '@/domain/review/impact'\r\n   7: import {\r\n   8:   checkConditionsFingerprint,\r\n   9:   projectFingerprints,\r\n  10: } from '@/domain/review/fingerprint'\r\n  11: import type { CurrentModel } from '@/domain/review/validity'\r\n  12: import type { ReviewFingerprints } from '@/domain/review/types'\r\n  13: import { GEOMETRY_CHECK_VERSION } from '@/lib/review/geometry-check'\r\n  14: import { useAppStore } from '@/lib/store'\r\n  15: import { jpMlitRulePack } from '@/rulepack'\r\n  16: \r\n  17: import { buildTakeoff, useTakeoff, type TakeoffResult } from './useTakeoff'\r\n  18: \r\n  19: export function toSnapshot(\r\n  20:   project: Project,\r\n  21:   takeoff: TakeoffResult,\r\n  22:   fingerprints: ReviewFingerprints,\r\n  23: ): TakeoffSnapshot {\r\n  24:   return {\r\n  25:     project,\r\n  26:     rebars: takeoff.rebars,\r\n  27:     lines: takeoff.lines,\r\n  28:     unsupportedMemberIds: new Set(\r\n  29:       takeoff.unsupportedMembers.map(({ memberId }) => memberId),\r\n  30:     ),\r\n  31:     fingerprints,\r\n  32:   }\r\n  33: }\r\n  34: \r\n  35: export function useReviewModel(): {\r\n  36:   current: CurrentModel\r\n  37:   currentSnapshot: TakeoffSnapshot\r\n  38:   baselineSnapshot: TakeoffSnapshot | null\r\n  39: } {\r\n  40:   const project = useAppStore(({ project }) => project)\r\n  41:   const review = useAppStore(({ review }) => review)\r\n  42:   const takeoff = useTakeoff()\r\n  43:   const checkConditions = useMemo(\r\n  44:     () => checkConditionsFingerprint(review.settings, review.exclusions),\r\n  45:     [review.settings, review.exclusions],\r\n  46:   )\r\n  47:   const unsupportedMemberIds = useMemo(\r\n  48:     () => new Set(takeoff.unsupportedMembers.map(({ memberId }) => memberId)),\r\n  49:     [takeoff],\r\n  50:   )\r\n  51:   const currentFingerprints = useMemo(\r\n  52:     () => projectFingerprints(\r\n  53:       project,\r\n  54:       takeoff.rebars,\r\n  55:       unsupportedMemberIds,\r\n  56:       jpMlitRulePack,\r\n  57:       GEOMETRY_CHECK_VERSION,\r\n  58:       checkConditions,\r\n  59:     ),\r\n  60:     [project, takeoff, unsupportedMemberIds, checkConditions],\r\n  61:   )\r\n  62:   const currentSnapshot = useMemo(\r\n  63:     () => toSnapshot(project, takeoff, currentFingerprints),\r\n  64:     [project, takeoff, currentFingerprints],\r\n  65:   )\r\n  66:   const baselineSnapshot = useMemo(() => {\r\n  67:     const baseline = review.baseline\r\n  68:     return baseline === null\r\n  69:       ? null\r\n  70:       : toSnapshot(\r\n  71:           baseline.project,\r\n  72:           buildTakeoff(baseline.project),\r\n  73:           baseline.fingerprints,\r\n  74:         )\r\n  75:   }, [review.baseline])\r\n  76:   const impact = useMemo(\r\n  77:     () => baselineSnapshot === null\r\n  78:       ? null\r\n  79:       : assessImpact(baselineSnapshot, currentSnapshot),\r\n  80:     [baselineSnapshot, currentSnapshot],\r\n  81:   )\r\n  82:   const current = useMemo(\r\n  83:     () => ({ project, fingerprints: currentFingerprints, impact }),\r\n  84:     [project, currentFingerprints, impact],\r\n  85:   )\r\n  86: \r\n  87:   return { current, currentSnapshot, base