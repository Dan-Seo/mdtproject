LengthMm)}</td>\r\n 227:             <td data-testid=\"xray-drawn-length\">\r\n 228:               {view.shape.drawn ? formatLength(view.shape.drawnLengthMm) : view.shape.reason}\r\n 229:             </td>\r\n 230:           </tr>\r\n 231:           <tr>\r\n 232:             <th>{t(locale, 'review.xray.count')}</th>\r\n 233:             <td data-testid=\"xray-design-count\">{view.quantity.designCount}</td>\r\n 234:             <td data-testid=\"xray-placed-count\">{shapeCount(view)}</td>\r\n 235:           </tr>\r\n 236:           {differs && (\r\n 237:             <tr>\r\n 238:               <th colSpan={3} data-testid=\"xray-differs\">\r\n 239:                 {t(locale, 'review.xray.differs')}\r\n 240:               </th>\r\n 241:             </tr>\r\n 242:           )}\r\n 243:         </tbody>\r\n 244:       </table>\r\n 245:       <pre className={styles.formula}>{view.formula}</pre>\r\n 246:       <RuleTable\r\n 247:         rules={view.rules}\r\n 248:         project={project}\r\n 249:         rebars={rebars}\r\n 250:         lines={lines}\r\n 251:         setHoverRow={setHoverRow}\r\n 252:       />\r\n 253:       {view.zones.length > 0 && (\r\n 254:         <ul>\r\n 255:           {view.zones.map((zone) => (\r\n 256:             <li key={`${zone.ruleKey}-${zone.fromMm}`}>\r\n 257:               {t(locale, 'review.xray.zone')}: {zone.fromMm}–{zone.toMm}mm ({formatLength(zone.lengthMm)}m) · {zone.ruleKey}\r\n 258:               <SourceChips rules={[zone.rule]} />\r\n 259:             </li>\r\n 260:           ))}\r\n 261:         </ul>\r\n 262:       )}\r\n 263:     </article>\r\n 264:   )\r\n 265: }\r\n 266: \r\n 267: function XRaySection() {\r\n 268:   const project = useAppStore(({ project }) => project)\r\n 269:   const memberId = useAppStore(({ sel }) => sel.memberId)\r\n 270:   const hoverRowId = useAppStore(({ hoverRowId }) => hoverRowId)\r\n 271:   const setHoverRow = useAppStore(({ setHoverRow }) => setHoverRow)\r\n 272:   const locale = useAppStore(({