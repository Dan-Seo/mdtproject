Error('sample column main rebar expected')\r\n  46:     const member = project.members.find(({ id }) => id === rebar.memberId)\r\n  47:     if (!member) throw new Error('sample column expected')\r\n  48:     const rowId = quantityLineId(memberGroupKey(project, member), rebar)\r\n  49:     const expected = xrayForRow(rowId, takeoff.rebars, project, takeoff.lines)\r\n  50:     if (expected.length === 0 || !expected[0].shape.drawn) {\r\n  51:       throw new Error('sample xray expected')\r\n  52:     }\r\n  53:     act(() => useAppStore.getState().setHoverRow(rowId))\r\n  54: \r\n  55:     render(<ReviewPane />)\r\n  56: \r\n  57:     const designLengths = screen.getAllByTestId('xray-design-length')\r\n  58:     const drawnLengths = screen.getAllByTestId('xray-drawn-length')\r\n  59:     expect(designLengths.map((cell) => cell.textContent)).toContain(\r\n  60:       formatLength(expected[0].quantity.designLengthMm),\r\n  61:     )\r\n  62:     expect(drawnLengths.map((cell) => cell.textContent)).toContain(\r\n  63:       formatLength(expected[0].shape.drawnLengthMm),\r\n  64:     )\r\n  65:     expect(designLengths[0].textContent).not.toBe(drawnLengths[0].textContent)\r\n  66:     expect(screen.getAllByTestId('xray-differs')[0]).toHaveTextContent(\r\n  67:       '一致しない（数量には用いない）',\r\n  68:     )\r\n  69:     expect(screen.getAllByTestId('xray-rule-anchorage.L1')[0]).toHaveTextContent('fc=24')\r\n  70:     expect(screen.getAllByTestId('xray-rule-lap.L1')[0]).toBeInTheDocument()\r\n  71:     expect(screen.getAllByTestId('xray-rule-cover.minimum')[0]).toBeInTheDocument()\r\n  72: \r\n  73:     const anchorageRule = screen.getAllByTestId('xray-rule-anchorage.L1')[0]\r\n  74:     fireEvent.click(\r\n  75:       within(anchorageRule).getByRole('button', { name: 'この根拠を使う鉄筋' }),\r\n  76:     )\r\n  77: \r\n  78:     const users = within(anchorageRule).getAllByRole('button')\r\n  79:     expect(users.length).toBeGreaterThan(1)\r\n  80:     fireEvent.click(users[1])\r\n  81:    