{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Encoding utf8 src/lib/viewer/geometry.ts | Select-Object -Skip 600 -First 95; Get-Content -Encoding utf8 src/rulepack/jp-mlit/cover.yaml | Select-Object -First 120'","aggregated_output":"  if (section.kind === '床板') {\r\n    return slabRebarPlacements(rebar, section, radiusOf)\r\n  }\r\n  if (rebar.role === 'あばら筋' || rebar.role === '幅止め筋') {\r\n    return girderRepeatedPlacements(rebar)\r\n  }\r\n  if (rebar.role === '腹筋') {\r\n    return girderSideBarPlacements(rebar, section)\r\n  }\r\n\r\n  return girderMainPlacements(rebar, section, radiusOf)\r\n}\r\n\r\nfunction insetCoordinate(\r\n  value: number,\r\n  minimum: number,\r\n  maximum: number,\r\n  radius: number,\r\n): number {\r\n  const inset = Math.min(radius, (maximum - minimum) / 2)\r\n  return Math.min(Math.max(value, minimum + inset), maximum - inset)\r\n}\r\n\r\n// hoop 중심선을 かぶり면에서 표시 반경만큼 안쪽으로 넣는다. 평면은 부재 kind로\r\n// 명시적으로 고른다: 柱는 X–Z, 大梁은 Y–Z. 좌표 변화로 평면을 추론하지 않는다.\r\nfunction hoopDisplayPoint(\r\n  point: Point3,\r\n  framePoints: Point3[],\r\n  radius: number,\r\n  section: Section,\r\n): Point3 {\r\n  if (section.kind === '柱' && section.shape === '円形') {\r\n    // 円は辺ごとに詰められない — 中心からの距離を表示半径だけ縮める。\r\n    const centre = section.b / 2\r\n    const [x, y, z] = point\r\n    const distance = Math.hypot(x - centre, z - centre)\r\n    if (distance === 0) return point\r\n    const scale = Math.max(0, distance - radius) / distance\r\n\r\n    return [centre + (x - centre) * scale, y, centre + (z - centre) * scale]\r\n  }\r\n\r\n  if (section.kind === '柱') {\r\n    const xs = framePoints.map((candidate) => candidate[0])\r\n    const zs = framePoints.map((candidate) => candidate[2])\r\n    const minX = Math.min(...xs)\r\n    const maxX = Math.max(...xs)\r\n    const minZ = Math.min(...zs)\r\n    const maxZ = Math.max(...zs)\r\n\r\n    return [\r\n      insetCoordinate(point[0], minX, maxX, radius),\r\n      point[1],\r\n      insetCoordinate(point[2], minZ, maxZ, radius),\r\n    ]\r\n  }\r\n\r\n  const ys = framePoints.map((candidate) => candidate[1])\r\n  const zs = framePoints.map((candidate) => candidate[2])\r\n  const minY = Math.min(...ys)\r\n  const maxY = Math.max(...ys)\r\n  const minZ = Math.min(...zs)\r\n  const maxZ = Math.max(...zs)\r\n\r\n  return [\r\n    point[0],\r\n    insetCoordinate(point[1], minY, maxY, radius),\r\n    insetCoordinate(point[2], minZ, maxZ, radius),\r\n  ]\r\n}\r\n\r\nfunction translate(point: Point3, offset: Point3): Point3 {\r\n  return [point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]]\r\n}\r\n\r\ninterface PathSegment {\r\n  from: Point3\r\n  to: Point3\r\n  /** 135°フック余長 — 表示では clamp せず、始点の inset ぶんの平行移動で描く */\r\n  hookTail?: boolean\r\n}\r\n\r\ninterface PathRun {\r\n  zone: RebarZone['kind'] | null\r\n  segments: PathSegment[]\r\n}\r\n\r\ninterface SegmentRun {\r\n  zone: RebarZone['kind'] | null\r\n  segments: Segment[]\r\n}\r\n\r\nfunction pointDistance(from: Point3, to: Point3): number {\r\n  return Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2])\r\n}\r\n- key: cover.minimum\r\n  label: 柱の最小かぶり厚さ（屋内・仕上げあり）\r\n  expr: 30mm\r\n  conditions: { memberKind: 柱, soilContact: false, exposure: 屋内, finish: 仕上げあり }\r\n  value: 30\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋内・仕上げあり）\r\n\r\n- key: cover.minimum\r\n  label: 大梁の最小かぶり厚さ（屋内・仕上げあり）\r\n  expr: 30mm\r\n  conditions: { memberKind: 大梁, soilContact: false, exposure: 屋内, finish: 仕上げあり }\r\n  value: 30\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋内・仕上げあり）\r\n\r\n- key: cover.minimum\r\n  label: 柱の最小かぶり厚さ（屋内・仕上げなし）\r\n  expr: 30mm\r\n  conditions: { memberKind: 柱, soilContact: false, exposure: 屋内, finish: 仕上げなし }\r\n  value: 30\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋内・仕上げなし）\r\n\r\n- key: cover.minimum\r\n  label: 大梁の最小かぶり厚さ（屋内・仕上げなし）\r\n  expr: 30mm\r\n  conditions: { memberKind: 大梁, soilContact: false, exposure: 屋内, finish: 仕上げなし }\r\n  value: 30\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋内・仕上げなし）\r\n\r\n- key: cover.minimum\r\n  label: 柱の最小かぶり厚さ（屋外・仕上げあり）\r\n  expr: 30mm\r\n  conditions: { memberKind: 柱, soilContact: false, exposure: 屋外, finish: 仕上げあり }\r\n  value: 30\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋外・仕上げあり）\r\n\r\n- key: cover.minimum\r\n  label: 大梁の最小かぶり厚さ（屋外・仕上げあり）\r\n  expr: 30mm\r\n  conditions: { memberKind: 大梁, soilContact: false, exposure: 屋外, finish: 仕上げあり }\r\n  value: 30\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋外・仕上げあり）\r\n\r\n- key: cover.minimum\r\n  label: 柱の最小かぶり厚さ（屋外・仕上げなし）\r\n  expr: 40mm\r\n  conditions: { memberKind: 柱, soilContact: false, exposure: 屋外, finish: 仕上げなし }\r\n  value: 40\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋外・仕上げなし）\r\n\r\n- key: cover.minimum\r\n  label: 大梁の最小かぶり厚さ（屋外・仕上げなし）\r\n  expr: 40mm\r\n  conditions: { memberKind: 大梁, soilContact: false, exposure: 屋外, finish: 仕上げなし }\r\n  value: 40\r\n  unit: mm\r\n  source: { ref: spec, section: 表5.3.6, page: 33 }\r\n  confidence: transcribed\r\n  note: 原文転写（転写者＝承認者・独立検討待ち R6）（表5.3.6 屋外・仕上げなし）\r\n\r\n- key: cover.minimum\r\n  label: 柱の最小かぶり厚さ（土に接する部分）\r\n  expr: 40mm\r\n  conditions: { memberKind: 柱, soilContact: true }\r\n  value: 40\r\n  unit: mm\r\n  source: { ref: spec,