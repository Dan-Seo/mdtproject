tionPt: 300 },\\\\n        ],\\\\n        spansMm: [6000],\\\\n        scalePtPerMm: 200 / 6000,\\\\n        totalConfirmed: false,\\\\n      },\\\\n    ])\\\\n  })\\\\n\\\\n  it('?몃줈 諛대뱶: ?꾩튂??y, 移섏닔??rot=-90 ?곗뿉???⑤떎', () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([h('bY1', 50, 100), h('bY2', 50, 300), v('4500', 80, 200)]),\\\\n    )\\\\n    expect(parsed.issues).toEqual([])\\\\n    expect(parsed.grids).toEqual([\\\\n      {\\\\n        direction: 'Y',\\\\n        axes: [\\\\n          { label: 'bY1', positionPt: 100 },\\\\n          { label: 'bY2', positionPt: 300 },\\\\n        ],\\\\n        spansMm: [4500],\\\\n        scalePtPerMm: 200 / 4500,\\\\n        totalConfirmed: false,\\\\n      },\\\\n    ])\\\\n  })\\\\n\\\\n  it('?쇳몴 移섏닔(6,000)瑜?mm ?뺤닔濡??쎈뒗??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([h('X1', 100, 50), h('X2', 300, 50), h('6,000', 200, 80)]),\\\\n    )\\\\n    expect(parsed.grids[0]?.spansMm).toEqual([6000])\\\\n  })\\\\n\\\\n  it('?몄젒 ?띿쓽 以묒젏??移섏닔媛 ?놁쑝硫?野멩퀡轝좄맼 ???꾨낫瑜??댁? ?딅뒗??, () => {\\\\n    const cases: TextItem[][] = [\\\\n      // 移섏닔 ?먯껜媛 ?녿떎\\\\n      [h('X1', 100, 50), h('X2', 300, 50)],\\\\n      // 以묒젏?먯꽌 20pt 踰쀬뼱?щ떎 (?덉슜 15pt)\\\\n      [h('X1', 100, 50), h('X2', 300, 50), h('6000', 220, 80)],\\\\n      // ?쇰꺼 諛대뱶?먯꽌 70pt ?⑥뼱吏??ㅻⅨ ?댁쓽 ?レ옄??(李?60pt)\\\\n      [h('X1', 100, 50), h('X2', 300, 50), h('6000', 200, 120)],\\\\n    ]\\\\n    for (const items of cases) {\\\\n      const parsed = parseFramingPlan(page(items))\\\\n      expect(parsed.grids).toEqual([])\\\\n      expect(parsed.issues).toEqual(['野멩퀡轝좄맼'])\\\\n    }\\\\n  })\\\\n\\\\n  it('?ㅽ뙩蹂??ㅼ륫 異뺤쿃??3%瑜??섍쾶 媛덈━硫?潁?갰訝띷빐??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 100, 50),\\\\n        h('X2', 300, 50),\\\\n        h('X3', 500, 50),\\\\n        h('6000', 200, 80),\\\\n        h('3000', 400, 80), // 媛숈? 200pt?몃뜲 3000mm ??異뺤쿃??2諛?媛덈┛??      ]),\\\\n    )\\\\n    expect(parsed.grids).toEqual([])\\\\n    expect(parsed.issues).toEqual(['潁?갰訝띷빐??])\\\\n  })\\\\n\\\\n  it('?꾩껜 移섏닔媛 ?ㅽ뙩 ?⑷낵 ?쇱튂?섎㈃ totalConfirmed', () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 100, 50),\\\\n        h('X2', 300, 50),\\\\n        h('X3', 500, 50),\\\\n        h('6000', 200, 80),\\\\n        h('6000', 400, 80),\\\\n        h('12000', 300, 110), // 泥???以묒젏. ?몄젒 以묒젏(200쨌400)怨쇰뒗 100pt ?⑥뼱???덈떎\\\\n      ]),\\\\n    )\\\\n    expect(parsed.issues).toEqual([])\\\\n    expect(parsed.grids[0]?.totalConfirmed).toBe(true)\\\\n  })\\\\n\\\\n  it('?꾩껜 移섏닔媛 ?ㅽ뙩 ?⑷낵 ?ㅻⅤ硫??덅쮫訝띴??????ㅻ룆 ?좏샇?대?濡??꾨낫瑜??댁? ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 100, 50),\\\\n        h('X2', 300, 50),\\\\n        h('X3', 500, 50),\\\\n        h('6000', 200, 80),\\\\n        h('6000', 400, 80),\\\\n        h('11000', 300, 110),\\\\n      ]),\\\\n    )\\\\n    expect(parsed.grids).toEqual([])\\\\n    expect(parsed.issues).toEqual(['?덅쮫訝띴???])\\\\n  })\\\\n\\\\n  it('媛숈? 諛대뱶?먯꽌 ?쇰꺼??諛섎났?섎㈃ 釉붾줉 寃쎄퀎濡?媛덈씪 ?쎄퀬, ?숈씪 寃곌낵???섎굹濡??묐뒗??, () => {\\\\n    // ???섏씠吏??媛숈? 洹몃━?쒖쓽 鴉뤷쎋媛 ??釉붾줉 ???ㅻЪ p7??諛곗튂??    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 100, 50),\\\\n        h('X2', 300, 50),\\\\n        h('X1', 700, 50),\\\\n        h('X2', 900, 50),\\\\n        h('6000', 200, 80),\\\\n        h('6000', 800, 80),\\\\n      ]),\\\\n    )\\\\n    expect(parsed.issues).toEqual([])\\\\n    expect(parsed.grids).toHaveLength(1)\\\\n    expect(parsed.grids[0]?.axes.map((axis) => axis.label)).toEqual([\\\\n      'X1',\\\\n      'X2',\\\\n    ])\\\\n  })\\\\n\\\\n  it('??諛대뱶??X? Y ?쇰꺼???욎씠硫??⒲깧?ユ뻼耶쀦렁????諛⑺뼢??吏?대궡吏 ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([h('X1', 50, 100), h('Y2', 50, 300), v('4500', 80, 200)]),\\\\n    )\\\\n    expect(parsed.grids).toEqual([])\\\\n    expect(parsed.issues).toEqual(['?⒲깧?ユ뻼耶쀦렁??])\\\\n  })\\\\n})\\\\n\\\\ndescribe('parseFramingPlan ??遺??諛곗튂', () => {\\\\n  /** 3횞3 寃⑹옄 ?섎굹. X: X1쨌X2쨌X3 (0쨌200쨌400pt), Y: Y1쨌Y2쨌Y3 (0쨌200쨌400pt) */\\\\n  function gridItems(): TextItem[] {\\\\n    return [\\\\n      h('X1', 0, -40),\\\\n      h('X2', 200, -40),\\\\n      h('X3', 400, -40),\\\\n      h('6000', 100, -20),\\\\n      h('6000', 300, -20),\\\\n      h('Y1', -40, 0),\\\\n      h('Y2', -40, 200),\\\\n      h('Y3', -40, 400),\\\\n      v('6000', -20, 100),\\\\n      v('6000', -20, 300),\\\\n    ]\\\\n  }\\\\n\\\\n  it('寃⑹옄???꾩쓽 遺?몃뒗 ?쇔춴????諛⑺뼢??媛뽰? ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(page([...gridItems(), h('C1', 200, 200)]))\\\\n    expect(parsed.blocks).toHaveLength(1)\\\\n    expect(parsed.blocks[0]?.placements).toEqual([\\\\n      { mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 },\\\\n    ])\\\\n  })\\\\n\\\\n  it('X 以묒젏쨌Y 寃⑹옄?먯씠硫?渦?axis=X ???쒖옉 寃⑹옄?먯쓣 ?ｋ뒗??, () => {\\\\n    const parsed = parseFramingPlan(page([...gridItems(), h('G1', 300, 200)]))\\\\n    expect(parsed.blocks[0]?.placements).toEqual([\\\\n      { mark: 'G1', role: '渦?, ix: 1, iy: 1, axis: 'X' },\\\\n    ])\\\\n  })\\\\n\\\\n  it('X 寃⑹옄?먃톉 以묒젏?대㈃ 渦?axis=Y', () => {\\\\n    const parsed = parseFramingPlan(page([...gridItems(), h('G2', 200, 100)]))\\\\n    expect(parsed.blocks[0]?.placements).toEqual([\\\\n      { mark: 'G2', role: '渦?, ix: 1, iy: 0, axis: 'Y' },\\\\n    ])\\\\n  })\\\\n\\\\n  it('?묒そ 以묒젏?대㈃ ?쇻궎 ???먯젏 履?寃⑹옄?먯쓣 ?ｋ뒗??, () => {\\\\n    const parsed = parseFramingPlan(page([...gridItems(), h('S1', 300, 300)]))\\\\n    expect(parsed.blocks[0]?.placements).toEqual([\\\\n      { mark: 'S1', role: '?쇻궎', ix: 1, iy: 1 },\\\\n    ])\\\\n  })\\\\n\\\\n  it('寃⑹옄?먯뿉?쒕룄 以묒젏?먯꽌??癒?遺?몃뒗 吏?대궡吏 ?딄퀬 ?ら뀓營?줈 ?④릿??, () => {\\\\n    // ?덉슜? **以묒븰媛?* ?ㅽ뙩??1/4?대?濡? ?깃컙寃?寃⑹옄?먯꽌???대뒓 ?먯씠??諛섎뱶??    // ?대뵖媛??遺숇뒗??理쒕? 嫄곕━媛 ?뺥솗???덉슜怨?媛숇떎). 紐?遺숇뒗 ?먮━???좊궃??    // 湲??ㅽ뙩 ?덉뿉???앷릿?????ㅻЪ yokohama??1200mm ?좎? 8700mm ?ㅽ뙩泥섎읆\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 0, -40),\\\\n        h('X2', 200, -40),\\\\n        h('X3', 400, -40),\\\\n        h('X4', 1200, -40),\\\\n        h('6000', 100, -20),\\\\n        h('6000', 300, -20),\\\\n        h('24000', 800, -20),\\\\n        h('Y1', -40, 0),\\\\n        h('Y2', -40, 200),\\\\n        v('6000', -20, 100),\\\\n        // 寃⑹옄??400 ?먯꽌??以묒젏 800 ?먯꽌??200pt ??以묒븰媛??ㅽ뙩 200 ??1/4 ???섎뒗??        h('B1', 600, 0),\\\\n      ]),\\\\n    )\\\\n    expect(parsed.blocks[0]?.placements).toEqual([])\\\\n    expect(parsed.blocks[0]?.unplacedMarks).toEqual(['B1'])\\\\n  })\\\\n\\\\n  it('釉붾줉 諛뽰쓽 遺?몃뒗 ?꾩삁 蹂댁? ?딅뒗????媛숈? ?섏씠吏????씊?ゃ궧?덇? ?욎씠吏 ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(page([...gridItems(), h('C9', 900, 900)]))\\\\n    expect(parsed.blocks[0]?.placements).toEqual([])\\\\n    expect(parsed.blocks[0]?.unplacedMarks).toEqual([])\\\\n  })\\\\n\\\\n  it('媛숈? 遺?멸? ?щ윭 ?먮━???덉쑝硫??먮━留덈떎 ?섎굹???몃떎', () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([...gridItems(), h('C1', 0, 0), h('C1', 400, 400)]),\\\\n    )\\\\n    expect(parsed.blocks[0]?.placements).toEqual([\\\\n      { mark: 'C1', role: '?쇔춴??, ix: 0, iy: 0 },\\\\n      { mark: 'C1', role: '?쇔춴??, ix: 2, iy: 2 },\\\\n    ])\\\\n  })\\\\n\\\\n  it('鴉뤷쎋 ?쒕ぉ???먮Ц 洹몃?濡??ｋ뒗????????묒? ?щ엺???뺥븳??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([...gridItems(), h('2?롥틞鴉뤷쎋1/100', 200, 460)]),\\\\n    )\\\\n    expect(parsed.blocks[0]?.title).toBe('2?롥틞鴉뤷쎋1/100')\\\\n  })\\\\n\\\\n  it('釉붾줉留덈떎 ?먭린 ?꾩튂???싥굤??쓣 媛뽯뒗????洹몃━?쒕뒗 ?묓???釉붾줉? ???묓엺??, () => {\\\\n    const right = gridItems().map((item) => ({ ...item, x: item.x + 800 }))\\\\n    const parsed = parseFramingPlan(\\\\n      page([...gridItems(), ...right, h('C1', 200, 200), h('C2', 1000, 200)]),\\\\n    )\\\\n    expect(parsed.grids).toHaveLength(2)\\\\n    expect(parsed.blocks).toHaveLength(2)\\\\n    const xPositions = parsed.blocks.map(\\\\n      (block) => block.xGrid.axes[0]?.positionPt,\\\\n    )\\\\n    expect(xPositions).toEqual([\\\\n      0, 800,\\\\n    ])\\\\n    expect(\\\\n      parsed.blocks.map((block) =>\\\\n        block.placements.map((placement) => placement.mark),\\\\n      ),\\\\n    ).toEqual([['C1'], ['C2']])\\\\n  })\\\\n})\\\\n\\\\ndescribe('parseFramingPlan ??X쨌Y ?싥굤??吏앹???, () => {\\\\n  it('Y ?댁씠 X ?댁쓽 ?ㅼ륫 ?ㅽ뙩??鍮꾪빐 ?덈Т 硫硫?釉붾줉??留뚮뱾吏 ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 0, -40),\\\\n        h('X2', 200, -40),\\\\n        h('X3', 400, -40),\\\\n        h('6000', 100, -20),\\\\n        h('6000', 300, -20),\\\\n        h('Y1', 800, 0),\\\\n        h('Y2', 800, 200),\\\\n        h('Y3', 800, 400),\\\\n        v('6000', 820, 100),\\\\n        v('6000', 820, 300),\\\\n      ]),\\\\n    )\\\\n\\\\n    expect(parsed.blocks).toEqual([])\\\\n    expect(parsed.issues).toContain('?싥굤???恙쒍툖??)\\\\n  })\\\\n\\\\n  it('?쒕줈 ?ㅻⅨ X ???섏씠 媛숈? Y ?댁쓣 怨듭쑀?섏? ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 0, -40),\\\\n        h('X2', 200, -40),\\\\n        h('X3', 400, -40),\\\\n        h('X1', 500, -40),\\\\n        h('X2', 700, -40),\\\\n        h('X3', 900, -40),\\\\n        h('6000', 100, -20),\\\\n        h('6000', 300, -20),\\\\n        h('6000', 600, -20),\\\\n        h('6000', 800, -20),\\\\n        h('Y1', 450, 0),\\\\n        h('Y2', 450, 200),\\\\n        h('Y3', 450, 400),\\\\n        v('6000', 470, 100),\\\\n        v('6000', 470, 300),\\\\n      ]),\\\\n    )\\\\n\\\\n    expect(parsed.blocks).toHaveLength(1)\\\\n    expect(parsed.issues).toContain('?싥굤???恙쒍툖??)\\\\n  })\\\\n\\\\n  it('理쒖냼 嫄곕━媛 媛숈? Y ?댁씠 ?섏씠硫?諛곗뿴 ?쒖꽌濡?怨좊Ⅴ吏 ?딅뒗??, () => {\\\\n    const parsed = parseFramingPlan(\\\\n      page([\\\\n        h('X1', 400, -40),\\\\n        h('X2', 600, -40),\\\\n        h('X3', 800, -40),\\\\n        h('6000', 500, -20),\\\\n        h('6000', 700, -20),\\\\n        h('Y1', 300, 0),\\\\n        h('Y2', 300, 200),\\\\n        h('Y3', 300, 400),\\\\n        v('6000', 320, 100),\\\\n        v('6000', 320, 300),\\\\n        h('Y1', 900, 0),\\\\n        h('Y2', 900, 200),\\\\n        h('Y3', 900, 400),\\\\n        v('6000', 920, 100),\\\\n        v('6000', 920, 300),\\\\n      ]),\\\\n    )\\\\n\\\\n    expect(parsed.blocks).toEqual([])\\\\n    expect(parsed.issues).toContain('?싥굤???恙쒍툖??)\\\\n  })\\\\n})\\\\n\\\\r\\\\n--- framing parse ---\\\\r\\\\nimport { compact, recoverRows, verticalRuns, type TextSegment } from '../runs'\\\\nimport type { TextItem } from '../types'\\\\nimport type { TextPage } from '../section-list/types'\\\\n\\\\nimport type {\\\\n  AxisCandidate,\\\\n  MemberPlacement,\\\\n  ParsedFramingPlan,\\\\n  PlanBlock,\\\\n  PlanGridCandidate,\\\\n  PlanGridIssue,\\\\n} from './types'\\\\n\\\\n/**\\\\n * 鴉뤷쎋???싥굤??洹몃━?쒖? 遺??諛곗튂瑜??띿뒪???덉씠?대쭔?쇰줈 蹂듭썝?쒕떎 (ADR-030).\\\\n *\\\\n * ?ㅼ륫(2026-08-23 ?ㅽ뙆?댄겕, yokohama p5?뱎7쨌kani p38)??以 援ъ“:\\\\n * 異??쇰꺼? ??諛대뱶(媛숈? x ?먮뒗 媛숈? y)???섏뼱?쒓퀬, ?ㅽ뙩 移섏닔 臾몄옄?댁?\\\\n * ?몄젒 ?쇰꺼 醫뚰몴??**以묒젏**???볦씤???ㅼ륫 ?ㅼ감 ??pt). ?꾩껜 移섏닔媛 ?덉쑝硫? * 泥???以묒젏???볦뿬 ?⑷퀎 寃利앹떇???쒕떎. 遺??遺?몃뒗 寃⑹옄????쨌蹂??以묒젏\\\\n * (鸚㎪쥈)쨌移?以묒븰(佯딀씮) 以??섎굹???볦씤?? 踰≫꽣 ?좊텇? ?곗? ?딅뒗???? * 訝?백럷渶싳씠 吏㏃? 議곌컖?쇰줈 遺꾪빐???덇퀬 ?띿뒪?몃쭔?쇰줈 蹂듭썝???꾧껐?쒕떎.\\\\n */\\\\n\\\\n/**\\\\n * ?싥굤???쇰꺼 ?섎굹. ?뚮Ц???묐몢(b쨌c 竊?汝?援щ텇)???ㅼ륫 踰붿쐞????誘몄? ?쒓린(bX2A?? * ?똀??媛숈? ?앯빁)??吏?대궡吏 ?딄퀬 ?뺤쭅?섍쾶 ?볦튇??(R10).\\\\n *\\\\n * sticky ?뚮옒洹몃뒗 ?뚯씠 ?멸렇癒쇳듃媛 ?쇰꺼???곗냽?쇰줈 ?④??놁씠 ?ㅻ챸?섎뒗媛?띾? 臾산린\\\\n * ?꾪븳 寃껋씠????遺遺??쇱튂瑜??쇰꺼濡?諛쏆쑝硫??앯빁 異뺤씠 議곗슜??蹂몃쾲?쇰줈 ?붽컩?쒕떎.\\\\n */\\\\nconst AXIS_LABEL_PATTERN = /[a-z]?[XY]\\\\\\\\d+/y\\\\n/** 移섏닔 臾몄옄?????쇳몴 援щ텇(6,000)怨?臾닿뎄遺?8700) ?????ㅻЪ???덈떎 */\\\\nconst DIMENSION_PATTERN = /^(?:\\\\\\\\d{1,3}(?:,\\\\\\\\d{3})+|\\\\\\\\d{2,})$/\\\\n/**\\\\n * 遺??遺?? ??씊?ゃ궧?덉쓽 寃?section-list??MARK_PATTERN)??S(佯딀씮)瑜??뷀뻽???? * 鴉뤷쎋?먮뒗 ?ㅳ꺀??遺?멸? ?섏삤怨?由ъ뒪???쒖뿉???섏삤吏 ?딅뒗??\\\\n */\\\\nconst MARK_PATTERN = /^(?:C|G|FC|FG|B|CB|S|W)\\\\\\\\d+[A-Z]?$/\\\\n/** 釉붾줉 ?쒕ぉ. ???롥틞鴉뤷쎋1/100?띿쿂??異뺤쿃??遺숈뼱 ?ㅻ?濡?遺遺??쇱튂濡?蹂몃떎 */\\\\nconst BLOCK_TITLE_PATTERN = /鴉뤷쎋/\\\\n\\\\n// ?ㅼ륫 湲곕컲 ?덉슜?ㅼ감. 洹쇨굅???ㅽ뙆?댄겕 ?ㅼ륫媛믪씠怨?ADR-030???곸뿀??\\\\n/** ?쇰꺼??媛숈? 諛대뱶濡?蹂대뒗 怨좎젙 醫뚰몴 ?덉슜?ㅼ감. ?ㅼ륫 ?몄감??1pt 誘몃쭔?대떎 */\\\\nconst BAND_TOLERANCE_PT = 8\\\\n/** 移섏닔 ?댁씠 ?쇰꺼 諛대뱶?먯꽌 ?⑥뼱吏????덈뒗 嫄곕━. ?ㅼ륫 理쒕? 50pt(kani X) */\\\\nconst DIMENSION_WINDOW_PT = 60\\\\n/** 移섏닔 以묒떖怨??몄젒 異?以묒젏???닿툔???덉슜. ?ㅼ륫 理쒕? 8pt, ?몃? 移섏닔 ?곗뇙?? *  理쒓렐???ㅽ깘??40pt??洹??ъ씠???붾떎 */\\\\nconst MIDPOINT_TOLERANCE_PT = 15\\\\n/** ?ㅽ뙩蹂??ㅼ륫 異뺤쿃(pt/mm)??以묒븰媛??鍮??덉슜 ?몄감. ?ㅼ륫 理쒕? 0.5% */\\\\nconst SCALE_TOLERANCE_RATIO = 0.03\\\\n/**\\\\n * 遺?몃? 寃⑹옄?먃룹쨷?먯뿉 遺숈씠???덉슜 嫄곕━ 竊?洹?諛⑺뼢 **以묒븰媛??ㅽ뙩**????鍮꾩쑉.\\\\n *\\\\n * ?몄젒 ?ㅽ뙩???곗? ?딅뒗 ?댁쑀媛 ?덈떎: ?ㅻЪ yokohama p7??bX3?밹X1? 1200mm(34pt)\\\\n * 吏쒕━ 醫곸? ?좊씪, ?몄젒 ?ㅽ뙩 湲곗??대㈃ ?덉슜??8pt濡?醫곸븘??凉뺝눣渶싳쑝濡?20pt易? * 鍮꾩폒 ?곹엺 ??遺?멸? ?듭㎏濡??⑥뼱吏꾨떎. 以묒븰媛믪? 洹?醫곸? ???섎굹???붾뱾由ъ? ?딅뒗??\\\\n *\\\\n * 1/4???섍만 ?섎뒗 ?녿떎 ??寃⑹옄?먭낵 以묒젏??諛??ㅽ뙩 媛꾧꺽?대?濡?1/4???뚯뼱??履쎌뿉?? * 遺숈씪 ???덈떎?띿쓽 寃쎄퀎?? 洹몃낫???ш쾶 ?≪쑝硫??대뒓 履쎌씤吏 ?쒗뭹??怨좊Ⅴ寃??쒕떎.\\\\n */\\\\nconst SNAP_RATIO = 0.25\\\\n/**\\\\n * X쨌Y ??吏앹????곹븳 竊?X ?싥굤??쓽 以묒븰媛??ㅼ륫 ?ㅽ뙩 횞 ??鍮꾩쑉.\\\\n * ?섏씠吏 異뺤쿃???곕씪 ?④퍡 蹂?섍퀬, Y ?쇰꺼 ?좉? ????ㅽ뙩 1.5移몃낫??硫硫? * 媛숈? 鴉뤷쎋?대씪??湲고븯 洹쇨굅媛 ?놁쑝誘濡?釉붾줉???댁? ?딅뒗??\\\\n */\\\\nconst GRID_PAIRING_DISTANCE_RATIO = 1.5\\\\n\\\\ninterface LabelToken {\\\\n  label: string\\\\n  letter: 'X' | 'Y'\\\\n  x: number\\\\n  y: number\\\\n}\\\\n\\\\ninterface PositionedToken {\\\\n  text: string\\\\n  x: number\\\\n  y: number\\\\n}\\\\n\\\\ninterface DimensionToken {\\\\n  valueMm: number\\\\n  x: number\\\\n  y: number\\\\n}\\\\n\\\\ninterface AxisSequence {\\\\n  letters: Set<'X' | 'Y'>\\\\n  /** positionPt媛 ?대뒓 醫뚰몴?멸? ??移섏닔 留ㅼ묶??媛숈? 醫뚰몴瑜?遊먯빞 ?쒕떎 */\\\\n  alongKey: 'x' | 'y'\\\\n  /** 諛대뱶??怨좎젙 醫뚰몴(?됯퇏) ??移섏닔 李쎌쓽 湲곗? */\\\\n  across: number\\\\n  axes: AxisCandidate[]\\\\n}\\\\n\\\\n/** 移섏닔쨌異뺤쿃源뚯? ?뺤씤???앸궃 異??? 洹몃━???뺤쓽? 釉붾줉???????ш린???섏삩??*/\\\\ninterface ValidatedSequence extends AxisSequence {\\\\n  direction: 'X' | 'Y'\\\\n  spansMm: number[]\\\\n  scalePtPerMm: number\\\\n  totalConfirmed: boolean\\\\n}\\\\n\\\\n/**\\\\n * ?멸렇癒쇳듃 ?섎굹瑜??쇰꺼???곗냽?쇰줈 ?섍?瑜몃떎. `makeSegments`???쒖쓽 移몄쓣 臾띠쑝?ㅺ퀬\\\\n * 留뚮뱺 洹쒖튃?대씪 ?몄젒?????싥굤??쓣 ???⑹씠濡?遺숈씤?????ㅻЪ yokohama p7?먯꽌\\\\n * `bX3`(34pt 媛꾧꺽)? `cX1`???똟X3cX1?띿씠 ?먮떎.\\\\n *\\\\n * ?섍?瑜??쇰꺼??醫뚰몴??**洹??쇰꺼???대， 臾몄옄?ㅼ뿉??* ?ㅼ떆 ?곕떎. ?깅텇쨌蹂닿컙?쇰줈\\\\n * 留뚮뱾硫??꾨㈃???녿뒗 ?꾩튂瑜??쒗뭹???뺥븯??寃껋씠 ?섍퀬, 洹??꾩튂媛 洹몃?濡??ㅽ뙩\\\\n * 移섏닔??以묒젏 ?먯젙???곗씤??\\\\n *\\\\n * ?멸렇癒쇳듃 ?꾩껜媛 ?쇰꺼濡??④??놁씠 ?ㅻ챸???뚮쭔 諛쏅뒗??\\\\n */\\\\nfunction splitAxisLabels(segment: TextSegment, y: number): LabelToken[] {\\\\n  // NFKC媛 ??湲?먮? ?щ윭 湲?먮줈 ?대뒗 寃쎌슦媛 ?덉쑝誘濡?1:1??媛?뺥븯吏 ?딄퀬\\\\n  // 臾몄옄留덈떎 ?띿뒪?몄긽??援ш컙??湲곕줉???섏갼?붾떎\\\\n  let text = ''\\\\n  const spans: Array<{ start: number; end: number; item: TextItem }> = []\\\\n  for (const item of segment.items) {\\\\n    const piece = compact(item.str)\\\\n    if (piece === '') continue\\\\n    spans.push({ start: text.length, end: text.length + piece.length, item })\\\\n    text += piece\\\\n  }\\\\n  if (text === '') return []\\\\n\\\\n  const tokens: LabelToken[] = []\\\\n  AXIS_LABEL_PATTERN.lastIndex = 0\\\\n  while (AXIS_LABEL_PATTERN.lastIndex < text.length) {\\\\n    const start = AXIS_LABEL_PATTERN.lastIndex\\\\n    const match = AXIS_LABEL_PATTERN.exec(text)\\\\n    if (!match) return []\\\\n    const end = AXIS_LABEL_PATTERN.lastIndex\\\\n\\\\n    const owned = spans\\\\n      .filter((span) => span.start < end && span.end > start)\\\\n      .map((span) => span.item)\\\\n    if (owned.length === 0) return []\\\\n\\\\n    let minX = Number.POSITIVE_INFINITY\\\\n    let maxX = Number.NEGATIVE_INFINITY\\\\n    for (const item of owned) {\\\\n      if (item.x < minX) minX = item.x\\\\n      if (item.x + item.w > maxX) maxX = item.x + item.w\\\\n    }\\\\n\\\\n    tokens.push({\\\\n      label: match[0],\\\\n      letter: match[0].includes('X') ? 'X' : 'Y',\\\\n      x: (minX + maxX) / 2,\\\\n      y,\\\\n    })\\\\n  }\\\\n\\\\n  return tokens\\\\n}\\\\n\\\\ninterface CollectedTokens {\\\\n  labels: LabelToken[]\\\\n  dimensions: DimensionToken[]\\\\n  marks: PositionedToken[]\\\\n  titles: PositionedToken[]\\\\n}\\\\n\\\\nfunction collectTokens(page: TextPage): CollectedTokens {\\\\n  const labels: LabelToken[] = []\\\\n  const dimensions: DimensionToken[] = []\\\\n  const marks: PositionedToken[] = []\\\\n  const titles: PositionedToken[] = []\\\\n\\\\n  const classify = (text: string, x: number, y: number) => {\\\\n    if (DIMENSION_PATTERN.test(text)) {\\\\n      dimensions.push({\\\\n        valueMm: Number.parseInt(text.replaceAll(',', ''), 10),\\\\n        x,\\\\n        y,\\\\n      })\\\\n      return\\\\n    }\\\\n    if (MARK_PATTERN.test(text)) {\\\\n      marks.push({ text, x, y })\\\\n      return\\\\n    }\\\\n    if (BLOCK_TITLE_PATTERN.test(text)) titles.push({ text, x, y })\\\\n  }\\\\n\\\\n  for (const row of recoverRows(page.items)) {\\\\n    for (const segment of row.segments) {\\\\n      labels.push(...splitAxisLabels(segment, row.y))\\\\n      classify(segment.compact, segment.centerX, row.y)\\\\n    }\\\\n  }\\\\n\\\\n  // ?몃줈?곌린??臾몄옄 醫뚰몴媛 ?몃줈濡??먮Ⅴ誘濡??섍?瑜닿린瑜?嫄몄? ?딅뒗?????ㅼ륫 肄뷀띁?ㅼ쓽\\\\n  // ?몃줈 ?곗? 移섏닔肉먯씠怨? ?몃줈 ?쇰꺼??遺숈뼱 ?섏삤???꾨㈃? 鍮??꾨낫濡??ㅽ뙣?쒕떎 (R10)\\\\n  for (const run of verticalRuns(page.items)) {\\\\n    if (/^[a-z]?[XY]\\\\\\\\d+$/.test(run.text)) {\\\\n      labels.push({\\\\n        label: run.text,\\\\n        letter: run.text.includes('X') ? 'X' : 'Y',\\\\n        x: run.x,\\\\n        y: run.y,\\\\n      })\\\\n      continue\\\\n    }\\\\n    classify(run.text, run.x, run.y)\\\\n  }\\\\n\\\\n  return { labels, dimensions, marks, titles }\\\\n}\\\\n\\\\n/**\\\\n * ?쇰꺼?ㅼ쓣 怨좎젙 醫뚰몴媛 ?댁뼱吏??諛대뱶濡?臾띔퀬, 諛대뱶 ?덉뿉???꾩튂 ?ㅻ쫫李⑥닚?쇰줈\\\\n * ?섏뼱?볦? ???쇰꺼??諛섎났?섎뒗 ?먮━?먯꽌 媛덈씪 異??댁쓣 留뚮뱺???????섏씠吏?? * 媛숈? 洹몃━?쒖쓽 鴉뤷쎋媛 ?щ윭 釉붾줉 ?덉쑝硫??ㅻЪ p7) 媛숈? 諛대뱶???댁씠 諛섎났?쒕떎.\\\\n */\\\\nfunction axisSequences(\\\\n  labels: LabelToken[],\\\\n  across: 'x' | 'y',\\\\n): AxisSequence[] {\\\\n  const along = across === 'x' ? 'y' : 'x'\\\\n  const sorted = [...labels].sort((a, b) => a[across] - b[across])\\\\n  const bands: LabelToken[][] = []\\\\n\\\\n  for (const token of sorted) {\\\\n    const band = bands.at(-1)\\\\n    const previous = band?.at(-1)\\\\n    if (\\\\n      band &&\\\\n      previous &&\\\\n      token[across] - previous[across] <= BAND_TOLERANCE_PT\\\\n    ) {\\\\n      band.push(token)\\\\n    } else {\\\\n      bands.push([token])\\\\n    }\\\\n  }\\\\n\\\\n  const sequences: AxisSequence[] = []\\\\n  for (const band of bands) {\\\\n    if (band.length < 2) continue\\\\n    const ordered = [...band].sort((a, b) => a[along] - b[along])\\\\n\\\\n    let current: LabelToken[] = []\\\\n    const flush = () => {\\\\n      if (current.length >= 2) {\\\\n        sequences.push({\\\\n          letters: new Set(current.map((token) => token.letter)),\\\\n          alongKey: along,\\\\n          across:\\\\n            current.reduce((total, token) => total + token[across], 0) /\\\\n            current.length,\\\\n          axes: current.map((token) => ({\\\\n            label: token.label,\\\\n            positionPt: token[along],\\\\n          })),\\\\n        })\\\\n      }\\\\n      current = []\\\\n    }\\\\n\\\\n    for (const token of ordered) {\\\\n      if (current.some((seen) => seen.label === token.label)) flush()\\\\n      current.push(token)\\\\n    }\\\\n    flush()\\\\n  }\\\\n\\\\n  return sequences\\\\n}\\\\n\\\\n/** ?몄젒 異??띿쓽 以묒젏?먯꽌, ?쇰꺼 諛대뱶??移섏닔 李??덉뿉 ?덈뒗 移섏닔瑜?李얜뒗??*/\\\\nfunction dimensionAt(\\\\n  dimensions: DimensionToken[],\\\\n  used: Set<DimensionToken>,\\\\n  along: 'x' | 'y',\\\\n  across: 'x' | 'y',\\\\n  midpoint: number,\\\\n  bandAcross: number,\\\\n): DimensionToken | undefined {\\\\n  let best: DimensionToken | undefined\\\\n  let bestDistance = Number.POSITIVE_INFINITY\\\\n\\\\n  for (const token of dimensions) {\\\\n    if (used.has(token)) continue\\\\n    const alongDistance = Math.abs(token[along] - midpoint)\\\\n    if (alongDistance > MIDPOINT_TOLERANCE_PT) continue\\\\n    if (Math.abs(token[across] - bandAcross) > DIMENSION_WINDOW_PT) continue\\\\n    if (alongDistance < bestDistance) {\\\\n      best = token\\\\n      bestDistance = alongDistance\\\\n    }\\\\n  }\\\\n\\\\n  return best\\\\n}\\\\n\\\\nfunction median(values: number[]): number {\\\\n  return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\\\\n}\\\\n\\\\nfunction validateSequence(\\\\n  sequence: AxisSequence,\\\\n  dimensions: DimensionToken[],\\\\n  issue: (code: PlanGridIssue) => void,\\\\n): ValidatedSequence | undefined {\\\\n  if (sequence.letters.size > 1) {\\\\n    issue('?⒲깧?ユ뻼耶쀦렁??)\\\\n    return undefined\\\\n  }\\\\n  const alongKey = sequence.alongKey\\\\n  const acrossKey: 'x' | 'y' = alongKey === 'y' ? 'x' : 'y'\\\\n\\\\n  const used = new Set<DimensionToken>()\\\\n  const spans: DimensionToken[] = []\\\\n  for (let i = 0; i + 1 < sequence.axes.length; i++) {\\\\n    const midpoint =\\\\n      (sequence.axes[i].positionPt + sequence.axes[i + 1].positionPt) / 2\\\\n    const dimension = dimensionAt(\\\\n      dimensions,\\\\n      used,\\\\n      alongKey,\\\\n      acrossKey,\\\\n      midpoint,\\\\n      sequence.across,\\\\n    )\\\\n    if (!dimension) break\\\\n    used.add(dimension)\\\\n    spans.push(dimension)\\\\n  }\\\\n  if (spans.length < sequence.axes.length - 1) {\\\\n    issue('野멩퀡轝좄맼')\\\\n    return undefined\\\\n  }\\\\n\\\\n  // ?ㅽ뙩蹂??ㅼ륫 異뺤쿃??媛덈━硫?移섏닔 ?ㅻ같?뺤씠????議곗슜??洹몃━?쒕? ?대뒓???ㅽ뙣?쒕떎\\\\n  const scales = spans.map(\\\\n    (span, i) =>\\\\n      (sequence.axes[i + 1].positionPt - sequence.axes[i].positionPt) /\\\\n      span.valueMm,\\\\n  )\\\\n  const medianScale = median(scales)\\\\n  if (\\\\n    scales.some(\\\\n      (scale) => Math.abs(scale / medianScale - 1) > SCALE_TOLERANCE_RATIO,\\\\n    )\\\\n  ) {\\\\n    issue('潁?갰訝띷빐??)\\\\n    return undefined\\\\n  }\\\\n\\\\n  // ?꾩껜 移섏닔(泥???以묒젏)媛 ?덉쑝硫??⑷퀎 寃利앹떇?쇰줈 ?대떎 ??遺덉씪移섎뒗 ?ㅻ룆 ?좏샇??  const spanSum = spans.reduce((sum, span) => sum + span.valueMm, 0)\\\\n  const first = sequence.axes[0].positionPt\\\\n  const last = sequence.axes.at(-1)?.positionPt ?? first\\\\n  const total = dimensionAt(\\\\n    dimensions,\\\\n    used,\\\\n    alongKey,\\\\n    acrossKey,\\\\n    (first + last) / 2,\\\\n    sequence.across,\\\\n  )\\\\n  if (total && total.valueMm !== spanSum) {\\\\n    issue('?덅쮫訝띴???)\\\\n    return undefined\\\\n  }\\\\n\\\\n  return {\\\\n    ...sequence,\\\\n    direction: [...sequence.letters][0],\\\\n    spansMm: spans.map((span) => span.valueMm),\\\\n    scalePtPerMm: medianScale,\\\\n    totalConfirmed: total !== undefined,\\\\n  }\\\\n}\\\\n\\\\nfunction extent(axes: AxisCandidate[]): { min: number; max: number } {\\\\n  return {\\\\n    min: axes[0].positionPt,\\\\n    max: axes[axes.length - 1].positionPt,\\\\n  }\\\\n}\\\\n\\\\n/** ?먯뿉??援ш컙源뚯???嫄곕━. 援ш컙 ?덉씠硫?0 */\\\\nfunction distanceToRange(value: number, min: number, max: number): number {\\\\n  if (value < min) return min - value\\\\n  if (value > max) return value - max\\\\n  return 0\\\\n}\\\\n\\\\n/**\\\\n * 遺?멸? 遺숇뒗 ?먮━瑜?留뚮뱺????寃⑹옄?먭낵 洹??ъ씠 以묒젏??踰덇컝???볦씤 ?덇툑?대떎.\\\\n * 吏앹닔 index媛 寃⑹옄??index/2), ??섍? 以묒젏(?ъ씠 (index-1)/2).\\\\n */\\\\nfunction snapTargets(axes: AxisCandidate[]): number[] {\\\\n  const targets: number[] = []\\\\n  for (let i = 0; i < axes.length; i++) {\\\\n    targets.push(axes[i].positionPt)\\\\n    if (i + 1 < axes.length) {\\\\n      targets.push((axes[i].positionPt + axes[i + 1].positionPt) / 2)\\\\n    }\\\\n  }\\\\n  return targets\\\\n}\\\\n\\\\nfunction spanLengths(axes: AxisCandidate[]): number[] {\\\\n  return axes\\\\n    .slice(1)\\\\n    .map((axis, i) => axis.positionPt - axes[i].positionPt)\\\\n}\\\\n\\\\ninterface Snap {\\\\n  index: number\\\\n  onNode: boolean\\\\n}\\\\n\\\\nfunction snap(\\\\n  value: number,\\\\n  axes: AxisCandidate[],\\\\n  limit: number,\\\\n): Snap | undefined {\\\\n  const targets = snapTargets(axes)\\\\n  let best = -1\\\\n  let bestDistance = Number.POSITIVE_INFINITY\\\\n  for (let i = 0; i < targets.length; i++) {\\\\n    const distance = Math.abs(targets[i] - value)\\\\n    if (distance < bestDistance) {\\\\n      best = i\\\\n      bestDistance = distance\\\\n    }\\\\n  }\\\\n  if (best < 0 || bestDistance > limit) return undefined\\\\n  return { index: best >> 1, onNode: best % 2 === 0 }\\\\n}\\\\n\\\\nfunction placementFor(\\\\n  mark: string,\\\\n  x: Snap,\\\\n  y: Snap,\\\\n): MemberPlacement {\\\\n  if (x.onNode && y.onNode) {\\\\n    return { mark, role: '?쇔춴??, ix: x.index, iy: y.index }\\\\n  }\\\\n  if (!x.onNode && y.onNode) {\\\\n    return { mark, role: '渦?, ix: x.index, iy: y.index, axis: 'X' }\\\\n  }\\\\n  if (x.onNode && !y.onNode) {\\\\n    return { mark, role: '渦?, ix: x.index, iy: y.index, axis: 'Y' }\\\\n  }\\\\n  return { mark, role: '?쇻궎', ix: x.index, iy: y.index }\\\\n}\\\\n\\\\nfunction gridCandidate(sequence: ValidatedSequence): PlanGridCandidate {\\\\n  return {\\\\n    direction: sequence.direction,\\\\n    axes: sequence.axes,\\\\n    spansMm: sequence.spansMm,\\\\n    scalePtPerMm: sequence.scalePtPerMm,\\\\n    totalConfirmed: sequence.totalConfirmed,\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 釉붾줉??吏볥뒗????X ???섎굹? **媛??媛源뚯슫** Y ???섎굹瑜?吏앹쭞?붾떎.\\\\n *\\\\n * 怨좎젙 ?щ갚?쇰줈 ?뚰룷?ⓦ띿쓣 ?먯젙?섏? ?딅뒗 ?댁쑀: ?쇰꺼? ?꾨㈃ 諛붽묑???볦씠誘濡? * ?щ갚???꾩슂?쒕뜲(?ㅻЪ 156pt), 洹??щ갚???볧엳硫???釉붾줉???닿퉴吏 ?쇳궓??\\\\n * 理쒓렐?묒? 洹??ъ씠瑜??ъ? ?딄퀬???녹? 吏앹쓣 怨좊Ⅸ??\\\\n *\\\\n * 媛숈? 釉붾줉???꽷룹븘???쇰꺼 ?좊뒗 異??꾩튂媛 媛숈쑝誘濡?洹??먮━?먯꽌 ?섎굹濡??묓엺??\\\\n */\\\\nfunction buildBlocks(\\\\n  xSequences: ValidatedSequence[],\\\\n  ySequences: ValidatedSequence[],\\\\n  marks: PositionedToken[],\\\\n  titles: PositionedToken[],\\\\n  issue: (code: PlanGridIssue) => void,\\\\n): PlanBlock[] {\\\\n  const blocks: PlanBlock[] = []\\\\n  if (xSequences.length === 0 || ySequences.length === 0) return blocks\\\\n\\\\n  const seen = new Set<string>()\\\\n  const claimedY = new Map<ValidatedSequence, string>()\\\\n\\\\n  for (const xSequence of xSequences) {\\\\n    const xExtent = extent(xSequence.axes)\\\\n    const xKey = xSequence.axes\\\\n      .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\\\\n      .join(',')\\\\n    const pairingLimit =\\\\n      median(spanLengths(xSequence.axes)) * GRID_PAIRING_DISTANCE_RATIO\\\\n    let paired: ValidatedSequence | undefined\\\\n    let pairedDistance = Number.POSITIVE_INFINITY\\\\n    let tied = false\\\\n    for (const ySequence of ySequences) {\\\\n      const claimedBy = claimedY.get(ySequence)\\\\n      if (claimedBy !== undefined && claimedBy !== xKey) continue\\\\n      const distance = distanceToRange(\\\\n        ySequence.across,\\\\n        xExtent.min,\\\\n        xExtent.max,\\\\n      )\\\\n      if (distance < pairedDistance) {\\\\n        paired = ySequence\\\\n        pairedDistance = distance\\\\n        tied = false\\\\n      } else if (distance === pairedDistance) {\\\\n        tied = true\\\\n      }\\\\n    }\\\\n    if (!paired || tied || pairedDistance > pairingLimit) {\\\\n      issue('?싥굤???恙쒍툖??)\\\\n      continue\\\\n    }\\\\n    claimedY.set(paired, xKey)\\\\n\\\\n    const xGrid = gridCandidate(xSequence)\\\\n    const yGrid = gridCandidate(paired)\\\\n    const xAxes = xGrid.axes\\\\n    const yAxes = yGrid.axes\\\\n    const key = [xAxes, yAxes]\\\\n      .map((axes) =>\\\\n        axes\\\\n          .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\\\\n          .join(','),\\\\n      )\\\\n      .join('|')\\\\n    if (seen.has(key)) continue\\\\n    seen.add(key)\\\\n\\\\n    const xLimit = median(spanLengths(xAxes)) * SNAP_RATIO\\\\n    const yLimit = median(spanLengths(yAxes)) * SNAP_RATIO\\\\n    const yExtent = extent(yAxes)\\\\n\\\\n    const placements: MemberPlacement[] = []\\\\n    const unplacedMarks: string[] = []\\\\n    for (const mark of marks) {\\\\n      // 釉붾줉 諛뽰쓽 遺?몃뒗 ?꾩삁 蹂댁? ?딅뒗????媛숈? ?섏씠吏????씊?ゃ궧?덇? ?욎씤??\\\\n      // ?먯젙 ?щ갚???ㅻ깄 ?덉슜怨?媛숆쾶 ?먯뼱, ?뚮툝濡??덉씤??紐?遺숈??ㅳ띿?\\\\n      // ?뚮툝濡?諛뽰씠?ㅳ띻? 媛숈? ?먮줈 媛덈━寃??쒕떎\\\\n      if (distanceToRange(mark.x, xExtent.min, xExtent.max) > xLimit) continue\\\\n      if (distanceToRange(mark.y, yExtent.min, yExtent.max) > yLimit) continue\\\\n\\\\n      const x = snap(mark.x, xAxes, xLimit)\\\\n      const y = snap(mark.y, yAxes, yLimit)\\\\n      if (!x || !y) {\\\\n        if (!unplacedMarks.includes(mark.text)) unplacedMarks.push(mark.text)\\\\n        continue\\\\n      }\\\\n      placements.push(placementFor(mark.text, x, y))\\\\n    }\\\\n\\\\n    // ?쒕ぉ? 釉붾줉??媛濡?踰붿쐞 ?덉뿉 ?덈뒗 寃껊쭔 蹂몃떎 ???섎???????鴉뤷쎋?먯꽌\\\\n    // ?몃줈 嫄곕━留뚯쑝濡?怨좊Ⅴ硫???釉붾줉???쒕ぉ??遺숇뒗??    let title: string | undefined\\\\n    let titleDistance = Number.POSITIVE_INFINITY\\\\n    for (const candidate of titles) {\\\\n      if (distanceToRange(candidate.x, xExtent.min, xExtent.max) > 0) continue\\\\n      const distance = distanceToRange(candidate.y, yExtent.min, yExtent.max)\\\\n      if (distance < titleDistance) {\\\\n        title = candidate.text\\\\n        titleDistance = distance\\\\n      }\\\\n    }\\\\n\\\\n    blocks.push({\\\\n      ...(title === undefined ? {} : { title }),\\\\n      xGrid,\\\\n      yGrid,\\\\n      placements,\\\\n      unplacedMarks,\\\\n    })\\\\n  }\\\\n\\\\n  return blocks.sort(\\\\n    (a, b) =>\\\\n      a.xGrid.axes[0].positionPt - b.xGrid.axes[0].positionPt ||\\\\n      a.yGrid.axes[0].positionPt - b.yGrid.axes[0].positionPt,\\\\n  )\\\\n}\\\\n\\\\nexport function parseFramingPlan(page: TextPage): ParsedFramingPlan {\\\\n  const { labels, dimensions, marks, titles } = collectTokens(page)\\\\n\\\\n  const issues: PlanGridIssue[] = []\\\\n  const issue = (code: PlanGridIssue) => {\\\\n    if (!issues.includes(code)) issues.push(code)\\\\n  }\\\\n\\\\n  if (labels.length === 0) {\\\\n    return { grids: [], blocks: [], issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??] }\\\\n  }\\\\n\\\\n  // ?쇰꺼 臾몄옄?댁씠 媛濡쒕줈 ?볦뿬??諛대뱶(異뺤쓽 ?섏뼱??諛⑺뼢)???몃줈?????덈떎 ??  // ??諛⑺뼢 ??臾띠뼱 蹂닿퀬, 寃利?以묒젏 移섏닔쨌異뺤쿃)??媛吏?諛대뱶瑜?嫄몃윭?몃떎.\\\\n  const validated = [\\\\n    ...axisSequences(labels, 'x'),\\\\n    ...axisSequences(labels, 'y'),\\\\n  ].flatMap((sequence) => {\\\\n    const result = validateSequence(sequence, dimensions, issue)\\\\n    return result ? [result] : []\\\\n  })\\\\n\\\\n  const grids: PlanGridCandidate[] = []\\\\n  const seen = new Set<string>()\\\\n  for (const sequence of validated) {\\\\n    const candidate = gridCandidate(sequence)\\\\n    const key = [\\\\n      candidate.direction,\\\\n      candidate.axes.map((axis) => axis.label).join(','),\\\\n      candidate.spansMm.join(','),\\\\n    ].join('|')\\\\n    if (seen.has(key)) continue\\\\n    seen.add(key)\\\\n    grids.push(candidate)\\\\n  }\\\\n  grids.sort(\\\\n    (a, b) =>\\\\n      a.direction.localeCompare(b.direction) ||\\\\n      a.axes[0].positionPt - b.axes[0].positionPt,\\\\n  )\\\\n\\\\n  const blocks = buildBlocks(\\\\n    validated.filter((sequence) => sequence.direction === 'X'),\\\\n    validated.filter((sequence) => sequence.direction === 'Y'),\\\\n    marks,\\\\n    titles,\\\\n    issue,\\\\n  )\\\\n\\\\n  return { grids, blocks, issues }\\\\n}\\\\n\\\\r\\\\n--- plan-import parse test ---\\\\r\\\\nimport { readFileSync } from 'node:fs'\\\\r\\\\nimport { resolve } from 'node:path'\\\\r\\\\n\\\\r\\\\nimport { describe, expect, it } from 'vitest'\\\\r\\\\n\\\\r\\\\nimport { parseFramingPlan } from '@/lib/import/framing-plan/parse'\\\\r\\\\nimport type { PlanGridCandidate } from '@/lib/import/framing-plan/types'\\\\r\\\\nimport type { TextPage } from '@/lib/import/section-list/types'\\\\r\\\\n\\\\r\\\\n// TextItem ?쎌뒪泥?肄뷀띁?ㅻ뒗 section-import? 怨듭쑀?쒕떎 ??醫뚰몴 洹쒖빟怨??쒖젣? ?쒖쇅瑜?\\\\n// ???뚯씠?꾨씪??scripts/extract-textitems.mjs)??蹂댁쬆?섍린 ?뚮Ц?대떎.\\\\r\\\\ntype TextItemFixture = {\\\\r\\\\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\\\\r\\\\n  items: TextPage['items']\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction readPage(file: string): TextPage {\\\\r\\\\n  const fixturePath = resolve(\\\\r\\\\n    process.cwd(),\\\\r\\\\n    'tests/fixtures/section-import/textitems',\\\\r\\\\n    file,\\\\r\\\\n  )\\\\r\\\\n  const fixture = JSON.parse(\\\\r\\\\n    readFileSync(fixturePath, 'utf8'),\\\\r\\\\n  ) as TextItemFixture\\\\r\\\\n\\\\r\\\\n  return { ...fixture.page, items: fixture.items }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction grid(\\\\r\\\\n  candidates: PlanGridCandidate[],\\\\r\\\\n  direction: 'X' | 'Y',\\\\r\\\\n): PlanGridCandidate {\\\\r\\\\n  const found = candidates.find((entry) => entry.direction === direction)\\\\r\\\\n  expect(found, `missing ${direction} grid`).toBeDefined()\\\\r\\\\n  return found as PlanGridCandidate\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n// 湲곕?媛믪? ?꾨㈃?먯꽌 ?낅┰ ?꾩궗??媛믪씠??(?먮낯: tests/fixtures/section-import/SOURCES.md).\\\\r\\\\n// 異??꾩튂(pt)???꾨㈃ 醫뚰몴???ш린 諛뺤? ?딄퀬 ?⑥“ 利앷?留?蹂몃떎 ???꾨㈃??吏꾩떎?\\\\r\\\\n// ?쇰꺼 ?쒖꽌? ?ㅽ뙩 移섏닔(mm)??\\\\r\\\\n\\\\r\\\\ndescribe('yokohama p7 (2?롥틞鴉뤷쎋?팕?롥틞鴉뤷쎋)', () => {\\\\r\\\\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\\\\r\\\\n\\\\r\\\\n  it('??釉붾줉쨌?묐떒 以묐났???묓? X쨌Y 媛?1媛쒖쓽 ?꾨낫媛 ?⑤뒗??, () => {\\\\r\\\\n    expect(parsed.issues).toEqual([])\\\\r\\\\n    expect(parsed.grids).toHaveLength(2)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('X: bX1?밷X3쨌cX1, ?ㅽ뙩 8700쨌8700쨌1200', () => {\\\\r\\\\n    const x = grid(parsed.grids, 'X')\\\\r\\\\n    expect(x.axes.map((axis) => axis.label)).toEqual([\\\\r\\\\n      'bX1',\\\\r\\\\n      'bX2',\\\\r\\\\n      'bX3',\\\\r\\\\n      'cX1',\\\\r\\\\n    ])\\\\r\\\\n    expect(x.spansMm).toEqual([8700, 8700, 1200])\\\\r\\\\n    expect(x.totalConfirmed).toBe(false)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('Y: bY6?뭕Y1 (?꾨㈃ 洹몃?濡쒖쓽 ?쒖꽌), ?ㅽ뙩 5000쨌6000쨌10000쨌6000쨌5000', () => {\\\\r\\\\n    const y = grid(parsed.grids, 'Y')\\\\r\\\\n    expect(y.axes.map((axis) => axis.label)).toEqual([\\\\r\\\\n      'bY6',\\\\r\\\\n      'bY5',\\\\r\\\\n      'bY4',\\\\r\\\\n      'bY3',\\\\r\\\\n      'bY2',\\\\r\\\\n      'bY1',\\\\r\\\\n    ])\\\\r\\\\n    expect(y.spansMm).toEqual([5000, 6000, 10000, 6000, 5000])\\\\r\\\\n    expect(y.totalConfirmed).toBe(false)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('異??꾩튂???⑥“ 利앷??섍퀬 ?ㅼ륫 異뺤쿃? 1/100 遺洹쇱씠??, () => {\\\\r\\\\n    for (const candidate of parsed.grids) {\\\\r\\\\n      const positions = candidate.axes.map((axis) => axis.positionPt)\\\\r\\\\n      expect([...positions].sort((a, b) => a - b)).toEqual(positions)\\\\r\\\\n      // 1/100 ?꾨㈃??pt/mm = 72 / 25.4 / 100 ??0.02835\\\\r\\\\n      expect(candidate.scalePtPerMm).toBeGreaterThan(0.027)\\\\r\\\\n      expect(candidate.scalePtPerMm).toBeLessThan(0.03)\\\\r\\\\n    }\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\ndescribe('kani p38 (?븀쨴鴉뤷쎋)', () => {\\\\r\\\\n  const parsed = parseFramingPlan(readPage('kani-p38.json'))\\\\r\\\\n\\\\r\\\\n  it('X: X1?밲4, ?ㅽ뙩 6000쨌6000쨌8000 ???꾩껜 移섏닔 20,000?쇰줈 ?뺤씤?쒕떎', () => {\\\\r\\\\n    const x = grid(parsed.grids, 'X')\\\\r\\\\n    expect(x.axes.map((axis) => axis.label)).toEqual(['X1', 'X2', 'X3', 'X4'])\\\\r\\\\n    expect(x.spansMm).toEqual([6000, 6000, 8000])\\\\r\\\\n    expect(x.totalConfirmed).toBe(true)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('Y: ?꾨㈃ 醫뚢넂?곌? Y3쨌Y2쨌Y1 ???ㅽ뙩 6000쨌10500, ?꾩껜 16,500?쇰줈 ?뺤씤?쒕떎', () => {\\\\r\\\\n    const y = grid(parsed.grids, 'Y')\\\\r\\\\n    expect(y.axes.map((axis) => axis.label)).toEqual(['Y3', 'Y2', 'Y1'])\\\\r\\\\n    expect(y.spansMm).toEqual([6000, 10500])\\\\r\\\\n    expect(y.totalConfirmed).toBe(true)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('?몃? 移섏닔 ?곗뇙(2,800+3,200 ????以묒젏 留ㅼ묶??諛곗젣?쒕떎', () => {\\\\r\\\\n    expect(parsed.issues).toEqual([])\\\\r\\\\n    expect(parsed.grids).toHaveLength(2)\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\n// ?꾨옒 諛곗튂 湲곕?媛믪? ?쎌뒪泥?醫뚰몴瑜??먯쑝濡?寃?고빐 ?살뿀??(?뚯꽌 異쒕젰?먯꽌 ?좊룄?섏?\\\\r\\\\n// ?딅뒗????ADR-010). 寃??洹쇨굅: 醫뚮툝濡앹쓽 ?싥굤???ㅼ쥖?쒕뒗 bX1=510쨌bX2=757쨌\\\\r\\\\n// bX3=1003쨌cX1=1037(x), bY6=216쨌bY5=358쨌bY4=528쨌bY3=812쨌bY2=982쨌bY1=1123(y)?대떎.\\\\r\\\\n//   C51@(528,207)  ??x??bX1(510)?먯꽌 18pt, y??bY6(216)?먯꽌 9pt        ???쇔춴??0,0)\\\\r\\\\n//   G51@(880,335)  ??x??bX2?밷X3 以묒젏(880)???뺥솗?? y??bY5(358)?먯꽌 23 ??渦?X(1,1)\\\\r\\\\n//   C53@(528,519)  ??bX1(18) 쨌 bY4(9)                                    ???쇔춴??0,2)\\\\r\\\\n//   CB52@(476,669) ??bX1(34) 쨌 bY4?밷Y3 以묒젏(670)?먯꽌 1pt                 ??渦?Y(0,2)\\\\r\\\\ndescribe('yokohama p7 ??遺??諛곗튂', () => {\\\\r\\\\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\\\\r\\\\n\\\\r\\\\n  it('???μ쓽 鴉뤷쎋媛 媛곴컖 釉붾줉???섍퀬 ?쒕ぉ???먮Ц?濡?媛뽯뒗??, () => {\\\\r\\\\n    expect(parsed.blocks.map((block) => block.title)).toEqual([\\\\r\\\\n      '2?롥틞鴉뤷쎋1/100',\\\\r\\\\n      'R?롥틞鴉뤷쎋1/100',\\\\r\\\\n    ])\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('釉붾줉留덈떎 ?먭린 ?꾩튂???싥굤??쓣 媛뽯뒗?????쇰꺼? 媛숆퀬 醫뚰몴???ㅻⅤ??, () => {\\\\r\\\\n    const [left, right] = parsed.blocks\\\\r\\\\n    expect(left.xGrid.axes.map((axis) => axis.label)).toEqual(\\\\r\\\\n      right.xGrid.axes.map((axis) => axis.label),\\\\r\\\\n    )\\\\r\\\\n    expect(left.xGrid.axes[0].positionPt).toBeLessThan(\\\\r\\\\n      right.xGrid.axes[0].positionPt,\\\\r\\\\n    )\\\\r\\\\n    expect(left.yGrid.axes.map((axis) => axis.label)).toEqual([\\\\r\\\\n      'bY6',\\\\r\\\\n      'bY5',\\\\r\\\\n      'bY4',\\\\r\\\\n      'bY3',\\\\r\\\\n      'bY2',\\\\r\\\\n      'bY1',\\\\r\\\\n    ])\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('?깅뒗 ?쇔춴?? 鸚㎪쥈??渦븐쑝濡?遺숇뒗??, () => {\\\\r\\\\n    const placements = parsed.blocks[0].placements\\\\r\\\\n    expect(placements).toContainEqual({\\\\r\\\\n      mark: 'C51',\\\\r\\\\n      role: '?쇔춴??,\\\\r\\\\n      ix: 0,\\\\r\\\\n      iy: 0,\\\\r\\\\n    })\\\\r\\\\n    expect(placements).toContainEqual({\\\\r\\\\n      mark: 'C53',\\\\r\\\\n      role: '?쇔춴??,\\\\r\\\\n      ix: 0,\\\\r\\\\n      iy: 2,\\\\r\\\\n    })\\\\r\\\\n    expect(placements).toContainEqual({\\\\r\\\\n      mark: 'G51',\\\\r\\\\n      role: '渦?,\\\\r\\\\n      ix: 1,\\\\r\\\\n      iy: 1,\\\\r\\\\n      axis: 'X',\\\\r\\\\n    })\\\\r\\\\n    expect(placements).toContainEqual({\\\\r\\\\n      mark: 'CB52',\\\\r\\\\n      role: '渦?,\\\\r\\\\n      ix: 0,\\\\r\\\\n      iy: 2,\\\\r\\\\n      axis: 'Y',\\\\r\\\\n    })\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('遺?몃뒗 ?꾨㈃???덈뒗 留뚰겮留??섏삤怨?吏?대궡吏 ?딅뒗??, () => {\\\\r\\\\n    // 弱뤸쥈?쇰줈 ?섍쾶 ?섎돏 移??덉쓽 ?ㅳ꺀?뼿룟컦歟?遺?몃뒗 訝??듐굤??뿉 遺숈? ?딅뒗????\\\\n    // ?쒗뭹??弱뤸쥈??紐⑤뜽留곹븯吏 ?딆쑝誘濡?ADR-005) 遺숈씪 ?먮━ ?먯껜媛 ?녿떎\\\\r\\\\n    for (const block of parsed.blocks) {\\\\r\\\\n      expect(block.placements.length).toBeGreaterThan(0)\\\\r\\\\n      for (const placement of block.placements) {\\\\r\\\\n        expect(placement.ix).toBeGreaterThanOrEqual(0)\\\\r\\\\n        expect(placement.ix).toBeLessThan(block.xGrid.axes.length)\\\\r\\\\n        expect(placement.iy).toBeGreaterThanOrEqual(0)\\\\r\\\\n        expect(placement.iy).toBeLessThan(block.yGrid.axes.length)\\\\r\\\\n        if (placement.role === '渦? && placement.axis === 'X') {\\\\r\\\\n          expect(placement.ix).toBeLessThan(block.xGrid.axes.length - 1)\\\\r\\\\n        }\\\\r\\\\n        if (placement.role === '渦? && placement.axis === 'Y') {\\\\r\\\\n          expect(placement.iy).toBeLessThan(block.yGrid.axes.length - 1)\\\\r\\\\n        }\\\\r\\\\n      }\\\\r\\\\n    }\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\n--- section plan grid ---\\\\r\\\\nimport { readFileSync } from 'node:fs'\\\\nimport { resolve } from 'node:path'\\\\n\\\\nimport { describe, expect, it } from 'vitest'\\\\n\\\\nimport {\\\\n  axisLabels,\\\\n  dimensionTexts,\\\\n  parseGrid,\\\\n} from '@/lib/import/plan/grid-parse'\\\\nimport type { TextItem } from '@/lib/import/types'\\\\n\\\\n/**\\\\n * 鴉뤷쎋 ?뚯꽌瑜??쎌뒪泥?5遺???듭㎏濡??뚮━??媛?? ?몃씪??glyph ?⑥쐞 ?뚯뒪?몃뒗\\\\n * `src/lib/import/plan/grid-parse.test.ts`???④퀬, **?ㅻ룄硫?肄뷀띁?ㅻ? ?꾨뒗 寃껋?\\\\n * ?ш린 紐⑥???* ?????덊룷??肄뷀띁??媛?쒕뒗 ?덉쇅 ?놁씠 node ?꾨줈?앺듃(`tests/`)?? * ?덇퀬, 濡쒕뜑 洹쒖빟??`parse.test.ts`? 媛숇떎.\\\\n */\\\\nconst FIXTURES = [\\\\n  'kani-p38.json',\\\\n  'ojkk-p2.json',\\\\n  'ojkk-p3.json',\\\\n  'yokohama-p13.json',\\\\n  'yokohama-p14.json',\\\\n]\\\\n\\\\nfunction readItems(file: string): TextItem[] {\\\\n  const fixturePath = resolve(\\\\n    process.cwd(),\\\\n    'tests/fixtures/section-import/textitems',\\\\n    file,\\\\n  )\\\\n  return (JSON.parse(readFileSync(fixturePath, 'utf8')) as { items: TextItem[] })\\\\n    .items\\\\n}\\\\n\\\\ndescribe('鴉뤷쎋 ?뚯꽌 ???ㅻ룄硫?5遺', () => {\\\\n  it('若잌쎋???ⓦ겗?⒲걪?뗣굢??0mm ?숃짒?뚦눣?ゃ걚', () => {\\\\n    // ?뷰툓??㈀?㎯겘?ゃ걚: yokohama-p14 ???50x1000?띲겘 pdf.js ??    // `650`??x`??1`??000` ???㏂궎?녴깲?ュ돯?ｃ겍?뷩걲??겎?곭떗?곥걼?얍ㅳ겎??    // `000` ?뚦뜕?с궩?겹깳?녈깉?ャ겒??0mm ?ⓦ걮??싥겂?╉걚?잞펷4?뗦?竊됥?    for (const file of FIXTURES) {\\\\n      const zeros = dimensionTexts(readItems(file)).filter(\\\\n        (dimension) => dimension.valueMm <= 0,\\\\n      )\\\\n      expect({ file, zeros }).toEqual({ file, zeros: [] })\\\\n    }\\\\n  })\\\\n\\\\n  it('?먰쉶洹 媛??? ?뚯꽌 異쒕젰 ?좊옒. 若잍릍 怨⑤뱺???꾨땲?ㅳ멾ani-p38???싥굤??낵 ?ㅽ뙩쨌?덅쮫媛 洹몃?濡??섏삩??, () => {\\\\n    // **湲곕?媛믪쓽 異쒖쿂???뚯꽌 ?먯떊??異쒕젰?대떎.** ADR-010??怨⑤뱺?뚯뒪?몃뒗 ?뚯썝臾?    // ?쒕? ?낅┰ ?꾩궗???쎌뒪泥섅띿? ?議고븯??寃껋씠怨????뚯뒪?몃뒗 洹멸쾬???꾨땲????    // `.cache/`媛 鍮꾩뼱 ?먮낯 PDF媛 ?놁뼱 吏湲덉? ?≪븞 ?꾩궗瑜???諛⑸쾿???녿떎.\\\\n    // 洹몃옒???닿쾬? ?뚯씠 媛믪씠 ?노떎?띾? 二쇱옣?섏? ?딅뒗?? 吏?ㅻ뒗 寃껋? ?섎굹??\\\\n    // **?몄젒 臾명꽦 3媛?媛濡?諛곗닔 0.5쨌?몃줈 諛곗닔 1.5쨌怨좎젙 4pt ?섑븳 ?쒓굅)瑜??쒓볼踰덉뿉\\\\n    // ?吏곸??붾뜲, ???꾨㈃??議곗슜???ㅽ뙩???껋? ?딅뒗媛.** 吏곸쟾 ?먯쓽 ?ㅻ룄硫?    // ?뚯뒪?몃뒗 ??mm媛 ???섏삩?ㅳ띾쭔 遊ㅺ린 ?뚮Ц???ㅽ뙩 ?섎굹媛 ?듭㎏濡??щ씪?몃룄\\\\n    // ?꾨Т??紐곕옄??\\\\n    //\\\\n    // ?≪븞 ?꾩궗??`kani-p38-grid.json`???ㅼ뼱?ㅻ㈃ ???뚯뒪?몃뒗 洹멸쾬?쇰줈 援먯껜?쒕떎.\\\\n    // 洹몃븣源뚯? ??媛믩뱾???뚮룄硫댁씠 ?대젃?ㅳ띿쓽 洹쇨굅濡??몄슜?섏? 留?寃?\\\\n    //\\\\n    // 媛믪? ADR-031??若잍릍 ?쒖닠怨??쇱튂?쒕떎: X1~X4쨌Y1~Y3, X ?ㅽ뙩 6,000/6,000/8,000\\\\n    // ?덅쮫 20,000(= 6,000+6,000+8,000), Y ?ㅽ뙩 6,000/10,500 ?덅쮫 16,500.\\\\n    const items = readItems('kani-p38.json')\\\\n\\\\n    // ?쇰꺼? 諛섑솚 ?쒖꽌(??y?뭯??議곗슦 ?쒖꽌)瑜??쎌냽?섏? ?딆쑝誘濡??쇰꺼紐낆쑝濡?    // ?뺣젹??鍮꾧탳?쒕떎. 鵝띸쉰??pt瑜?諛섏삱由쇳븳????遺?숈냼???붿감瑜?怨좎젙?섎뒗 寃껋?\\\\n    // ??媛?쒖쓽 紐⑹쟻???꾨땲??\\\\n    const labels = axisLabels(items)\\\\n      .map((label) => ({\\\\n        label: label.label,\\\\n        axis: label.axis,\\\\n        at: Math.round(label.positionPt),\\\\n      }))\\\\n      .sort((left, right) => left.label.localeCompare(right.label))\\\\n\\\\n    expect(labels).toEqual([\\\\n      { label: 'X1', axis: 'X', at: 364 },\\\\n      { label: 'X2', axis: 'X', at: 534 },\\\\n      { label: 'X3', axis: 'X', at: 704 },\\\\n      { label: 'X4', axis: 'X', at: 931 },\\\\n      // Y???꾨㈃ ?꾩そ??y ?묒? 履???Y3媛 ?? Y1???꾨옒??      { label: 'Y1', axis: 'Y', at: 786 },\\\\n      { label: 'Y2', axis: 'Y', at: 488 },\\\\n      { label: 'Y3', axis: 'Y', at: 318 },\\\\n    ])\\\\n\\\\n    const dimensions = dimensionTexts(items)\\\\n    const pool = (axis: 'X' | 'Y') =>\\\\n      dimensions.filter((dimension) => dimension.axis === axis)\\\\n\\\\n    const spans = (axis: 'X' | 'Y', values: number[]) =>\\\\n      pool(axis)\\\\n        .filter((dimension) => values.includes(dimension.valueMm))\\\\n        .map((dimension) => ({\\\\n          mm: dimension.valueMm,\\\\n          at: Math.round(dimension.positionPt),\\\\n        }))\\\\n        .sort((left, right) => left.at - right.at)\\\\n\\\\n    // 鵝띸쉰 ?쒖꽌濡??섏뼱?볥뒗?? ?덅쮫???꾨㈃ ?꾩껜瑜?嫄몄튂??移섏닔?좎씠??以묒븰???⑤떎.\\\\n    expect(spans('X', [6000, 8000, 20000])).toEqual([\\\\n      { mm: 6000, at: 449 }, // X1?밲2\\\\n      { mm: 6000, at: 619 }, // X2?밲3\\\\n      { mm: 20000, at: 647 }, // ?덅쮫 X1?밲4\\\\n      { mm: 8000, at: 818 }, // X3?밲4\\\\n    ])\\\\n    expect(spans('Y', [6000, 10500, 16500])).toEqual([\\\\n      { mm: 6000, at: 405 }, // Y3?밳2\\\\n      { mm: 16500, at: 554 }, // ?덅쮫 Y3?밳1\\\\n      { mm: 10500, at: 639 }, // Y2?밳1\\\\n    ])\\\\n\\\\n    // ?꾨낫 ????ш린 竊?ADR-031???뚮끂?댁쫰媛 ?뺣룄?곸씠???덅쮫 ?議곌? ?좎씪??    // ?μ튂?ㅳ띿쓽 洹쇨굅濡????섏튂?? ?먯쑝濡??곷뒗 媛믪씠??肄붾뱶蹂대떎 ?ㅼ쿂吏誘濡?    // ?ш린??紐?諛뺣뒗????臾명꽦???吏곸뿬 ???섍? 蹂?섎㈃ ADR??媛숈씠 怨좎퀜???쒕떎.\\\\n    expect({ x: pool('X').length, y: pool('Y').length }).toEqual({\\\\n      x: 38,\\\\n      y: 52,\\\\n    })\\\\n  })\\\\n\\\\n  it('?먰쉶洹 媛??? ?뚯꽌 異쒕젰 ?좊옒. 若잍릍 怨⑤뱺???꾨땲?ㅳ묇폀?녠? ?꾨땶 4遺?먯꽌??寃⑹옄瑜??섎굹???댁? ?딅뒗??, () => {\\\\n    // ?욎쓽 媛?쒖? 媛숈? ?댁쑀濡??뚯꽌 異쒕젰 ?좊옒?????ㅻ쭔 ?ш린??吏?ㅻ뒗 寃껋?\\\\n    // **媛믪씠 ?꾨땲??移⑤У**?대떎. ojkk 2遺? yokohama 2遺????씊?ゃ궧???섏씠吏??    // 鴉뤷쎋媛 ?녾퀬, ?곕씪???대뼡 寃⑹옄???섏??쒕뒗 ???쒕떎.\\\\n    //\\\\n    // yokohama-p14 ??洹몃깷 ?뚮씪踰⑥씠 ?녿떎?띾줈 ?앸굹吏 ?딅뒗?? ??씊?ゃ궧?덉쓽 寧?뤇\\\\n    // X2?팞3(洹몃━怨?Y4?팢5)媛 ?싥굤???쇰꺼??紐⑥뼇??洹몃?濡?媛뽮퀬 ?덉뼱 ?쇰꺼濡?    // ?≫엺?? ?????쇰꺼???뺥솗??2媛??ㅽ뙩 1蹂???異뺤씠怨? ?뚦뭽 竊??덅쮫?띾뒗\\\\n    // ?ㅽ뙩??1蹂몄씪 ??**?꾨Т寃껊룄 ?뺤씤?섏? ?딅뒗??* ??洹?1蹂??먯떊???덅쮫濡?    // ?쎌쑝硫??몄젣???깅┰?섍린 ?뚮Ц?대떎(?븅뼋 ?덉쓽 900 ???덅쮫濡??쎌쑝硫?    // ?똛2~X3 ??900mm?띾씪???꾨㈃???녿뒗 寃⑹옄媛 ?깅┰?섎뒗 ??. ?댁쟾?먮뒗\\\\n    // ?뚦릦鼇덇? ?ㅽ뙩怨??ㅻⅨ ??蹂몄쑝濡??곹? ?덉뼱???쒕떎?띾뒗 writtenAsTotal 媛?쒓?\\\\n    // ??援щ찉??留됯퀬 ?덉뿀?쇰굹, ?낅┰ 由щ럭媛 洹?媛?쒕뒗 **?곗뿰??* 留됲삍??肉먯엫??    // 蹂댁???媛숈? 媛믪씠 ?섏씠吏 ?대뵖媛????踰????덇린留??대룄 ?ル┛?? ??洹몃옒??    // 吏湲덉? ?쇰꺼??2媛쒖씤 異뺤? ?곗씠?곕? 蹂닿린???꾩뿉 嫄곗젅?쒕떎(`?븅뼋?겻툖擁?,\\\\n    // ADR-031??2 ?뺤젙). X?팢 ???????댁쑀濡??듭씪?쒕떎.\\\\n    const produced = FIXTURES.filter((file) => file !== 'kani-p38.json').flatMap(\\\\n      (file) =>\\\\n        parseGrid(readItems(file)).map((candidate) => ({\\\\n          file,\\\\n          axis: candidate.axis,\\\\n          labels: candidate.labels.map((label) => label.label),\\\\n          spansMm: candidate.spansMm,\\\\n          totalMm: candidate.totalMm,\\\\n          issues: candidate.issues,\\\\n        })),\\\\n    )\\\\n\\\\n    expect(produced).toEqual([\\\\n      ...['ojkk-p2.json', 'ojkk-p3.json', 'yokohama-p13.json'].flatMap((file) =>\\\\n        (['X', 'Y'] as const).map((axis) => ({\\\\n          file,\\\\n          axis,\\\\n          labels: [],\\\\n          spansMm: [],\\\\n          totalMm: null,\\\\n          issues: ['?싥굤??꺀?쇻꺂訝띹떨'],\\\\n        })),\\\\n      ),\\\\n      {\\\\n        file: 'yokohama-p14.json',\\\\n        axis: 'X',\\\\n        labels: ['X2', 'X3'],\\\\n        spansMm: [],\\\\n        totalMm: null,\\\\n        issues: ['?븅뼋?겻툖擁?],\\\\n      },\\\\n      {\\\\n        file: 'yokohama-p14.json',\\\\n        axis: 'Y',\\\\n        labels: ['Y4', 'Y5'],\\\\n        spansMm: [],\\\\n        totalMm: null,\\\\n        issues: ['?븅뼋?겻툖擁?],\\\\n      },\\\\n    ])\\\\n  })\\\\n\\\\n  it('?먰쉶洹 媛??? ?좎“ 0嫄??낅┰ 由щ럭 ?뵶1)?몑okohama-p14 X??援ш컙 ??移섏닔媛 ?뺥솗??1媛쒖씤?곕룄 寃⑹옄瑜?留뚮뱾吏 ?딅뒗??, () => {\\\\n    // yokohama-p14 X????씊?ゃ궧?덉쓽 寧?뤇 X2?팞3媛 ?싥굤???쇰꺼濡??ㅼ씤?섍퀬,\\\\n    // 洹??ъ씠 援ш컙??野멩퀡 ?꾨낫媛 ?뺥솗???섎굹(900)留??덈떎 ???쇰꺼 2媛??ㅽ뙩 1蹂?\\\\n    // 異뺤쓽 ?ㅼ륫 ?щ??? writtenAsTotal 媛???덅쮫???ㅽ뙩怨??ㅻⅨ ??蹂몄씠?댁빞\\\\n    // ?쒕떎)留뚯쑝濡쒕뒗 ??異뺤쓣 紐?留됰뒗?ㅻ뒗 寃껋씠 ?낅┰ 由щ럭??吏?곸씠?덈떎: ?곗뿰??    // ?섏씠吏??900???좎씪媛믪씠??留됲삍??肉? ?ㅻⅨ 怨녹뿉 900????踰????덉뿀?ㅻ㈃\\\\n    // ?똛2~X3 ??900mm?띾씪???꾨㈃???녿뒗 寃⑹옄媛 issues:[] 濡??깅┰?덉쓣 寃껋씠??\\\\n    // 吏湲덉? ?쇰꺼 2媛??ㅽ뙩 1蹂? ?먯껜瑜??곗씠?곗? 臾닿??섍쾶 嫄곗젅?섎?濡??븅뼋?겻툖擁?\\\\n    // ??異뺤? ?대뼡 寃쎌슦?먮룄 媛믪쓣 ?댁? ?딅뒗??\\\\n    const [x] = parseGrid(readItems('yokohama-p14.json'))\\\\n\\\\n    expect(x.axis).toBe('X')\\\\n    expect(x.labels.map((label) => label.label)).toEqual(['X2', 'X3'])\\\\n    expect(x.issues).toEqual(['?븅뼋?겻툖擁?])\\\\n    expect(x.spansMm).toEqual([])\\\\n    expect(x.totalMm).toBeNull()\\\\n  })\\\\n\\\\n  it('?먰쉶洹 媛??? ?뚯꽌 異쒕젰 ?좊옒. 若잍릍 怨⑤뱺???꾨땲?ㅳ멾ani-p38?먯꽌 ??異???寃⑹옄媛 ?섎굹濡??뺥빐吏꾨떎', () => {\\\\n    // ????媛?쒖? 媛숈? ?깃꺽(?뚯꽌 異쒕젰 ?좊옒)?닿퀬, ?ш린??吏?ㅻ뒗 寃껋?\\\\n    // **?꾨낫 38쨌52嫄댁뿉???닿? ?뺥솗???섎굹濡?醫곹?吏꾨떎**???ъ떎?대떎.\\\\n    // ?섎굹?쇰룄 ???섏삤硫?`野멩퀡永꾢릦?쎽툖若????섏뼱 媛믪씠 ???섏삩????利???媛?쒕뒗\\\\n    // ?뚥퐤營?援ш컙 竊??덅쮫????寃뱀씠 ?ㅻ룄硫댁뿉???ㅼ젣濡??좎씪?대? 留뚮뱺?ㅻ뒗\\\\n    // ADR-031????二쇱옣??遺숈옟?붾떎.\\\\n    expect(parseGrid(readItems('kani-p38.json'))).toMatchObject([\\\\n      {\\\\n        axis: 'X',\\\\n        spansMm: [6000, 6000, 8000],\\\\n        totalMm: 20000,\\\\n        issues: [],\\\\n      },\\\\n      {\\\\n        axis: 'Y',\\\\n        spansMm: [6000, 10500],\\\\n        totalMm: 16500,\\\\n        issues: [],\\\\n      },\\\\n    ])\\\\n  })\\\\n})\\\\n\\\\r\\\\n--- deleted unit test head/tail ---\\\\r\\\\nimport { describe, expect, it } from 'vitest'\\\\r\\\\n\\\\r\\\\nimport {\\\\r\\\\n  axisLabels,\\\\r\\\\n  dimensionTexts,\\\\r\\\\n  parseGrid,\\\\r\\\\n} from '@/lib/import/plan/grid-parse'\\\\r\\\\nimport type { GridCandidate } from '@/lib/import/plan/types'\\\\r\\\\nimport type { TextItem } from '@/lib/import/types'\\\\r\\\\n\\\\r\\\\nconst glyph = (str: string, x: number, y: numbe