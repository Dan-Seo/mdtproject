\\\\\n  { id: '2F', name: '2階', height: 3600 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// M1 화면 확인용 사용자 입력 예시이며 규준 수치가 아니다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 屋外・仕上げなし는 종전 플레이스홀더 最小かぶり(40mm)와 같은 셀이다. 다만 같은 M2에서\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 加工用かぶり(＋10mm)가 帯筋 加工長에 적용되므로 샘플 산출값 자체는 보존되지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst columnSection: ColumnSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: 'section-C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: 'C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  d: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: { size: 'D25', count: 12 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hoop: { size: 'D13', pitch: 100 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst girderSections: GirderSection[] = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    id: 'section-G1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    kind: '大梁',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    mark: 'G1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    b: 400,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    depth: 750,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    main: { size: 'D25', topCount: 4, bottomCount: 4 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    stirrup: { size: 'D13', pitch: 100 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    id: 'section-G2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    kind: '大梁',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    mark: 'G2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    b: 400,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    depth: 700,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    main: { size: 'D22', topCount: 4, bottomCount: 4 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    stirrup: { size: 'D13', pitch: 150 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction createColumns(storyId: string): Member[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { nx, ny } = gridPointCount(sampleGrid)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const columns: Member[] = []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (let iy = 0; iy < ny; iy += 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (let ix = 0; ix < nx; ix += 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      columns.push({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        id: `${storyId}-X${ix + 1}Y${iy + 1}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        memberClass: '躯体',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        sectionId: columnSection.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        storyId,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        position: { ix, iy },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return columns\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction createGirders(storyId: string): Member[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { nx, ny } = gridPointCount(sampleGrid)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const girders: Member[] = []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (let iy = 0; iy < ny; iy += 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const mark = iy === 1 ? 'G2' : 'G1'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (let ix = 0; ix < nx - 1; ix += 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      girders.push({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        id: `${storyId}-${mark}-X${ix + 1}Y${iy + 1}-X`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        kind: '大梁',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        memberClass: '躯体',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        sectionId: `section-${mark}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        storyId,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        position: { axis: 'X', ix, iy },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (let ix = 0; ix < nx; ix += 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const mark = ix === 1 ? 'G2' : 'G1'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (let iy = 0; iy < ny - 1; iy += 1) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      girders.push({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        id: `${storyId}-${mark}-X${ix + 1}Y${iy + 1}-Y`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        kind: '大梁',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        memberClass: '躯体',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        sectionId: `section-${mark}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        storyId,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        position: { axis: 'Y', ix, iy },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return girders\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function createSampleProject(): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    schemaVersion: PROJECT_SCHEMA_VERSION,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    name: 'サンプル案件 / RC