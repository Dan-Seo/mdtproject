n,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): position is GirderPosition {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return 'axis' in position\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport type GirderSupport =\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | { supported: true }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  | { supported: false; reason: '連続スパン' }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function girderSupport(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  project: Project,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  member: Member,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): GirderSupport {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    throw new Error(`girderSupport requires a 大梁: ${member.id}`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const position = member.position\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const hasAdjacentGirder = project.members.some((candidate) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      candidate.kind !== '大梁' ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      candidate.storyId !== member.storyId ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      !isGirderPosition(candidate.position) ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      candidate.position.axis !== position.axis\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      return false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (position.axis === 'X') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      return (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        candidate.position.iy === position.iy &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        Math.abs(candidate.position.ix - position.ix) === 1\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      candidate.position.ix === position.ix &&\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      Math.abs(candidate.position.iy - position.iy) === 1\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return hasAdjacentGirder\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ? { supported: false, reason: '連続スパン' }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    : { supported: true }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction touchesColumn(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  girder: GirderPosition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  column: ColumnPosition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): boolean {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (girder.axis === 'X') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_27\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'git log -6 --oneline --decorate'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"3f47455 (HEAD -> feat-3-girder-domain