\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Raw -Encoding UTF8 src/lib/hooks/useTakeoff.test.tsx'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_34\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Raw -Encoding UTF8 src/lib/hooks/useTakeoff.test.tsx'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"import { renderHook } from '@testing-library/react'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { beforeEach, describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { createSampleProject } from '@/domain/model/sample-project'\\\\\\\\\\\\\\\\nimport { gridPointCount } from '@/domain/model/project'\\\\\\\\\\\\\\\\nimport { useAppStore } from '@/lib/store'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { useTakeoff } from './useTakeoff'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('useTakeoff', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  beforeEach(() => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    useAppStore.setState({ project: createSampleProject() })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('derives supported X大梁 rows and reports continuous Y大梁 separately', () => {\\\\\\\\\\\\\\\\n    const { result } = renderHook(() => useTakeoff())\\\\\\\\\\\\\\\\n    const project = useAppStore.getState().project\\\\\\\\\\\\\\\\n    const { nx, ny } = gridPointCount(project.grid)\\\\\\\\\\\\\\\\n    const columnsPerStory = nx * ny\\\\\\\\\\\\\\\\n    const supportedGirdersPerStory = (nx - 1) * ny\\\\\\\\\\\\\\\\n    const unsupportedGirdersPerStory = nx * (ny - 1)\\\\\\\\\\\\\\\\n    const xGirderIds = new Set(\\\\\\\\\\\\\\\\n      project.members\\\\\\\\\\\\\\\\n        .filter(\\\\\\\\\\\\\\\\n          (member) =>\\\\\\\\\\\\\\\\n            member.kind === '大梁' &&\\\\\\\\\\\\\\\\n            'axis' in member.position &&\\\\\\\\\\\\\\\\n            member.position.axis === 'X',\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        .map(({ id }) => id),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    const yGirderIds = new Set(\\\\\\\\\\\\\\\\n      project.members\\\\\\\\\\\\\\\\n        .filter(\\\\\\\\\\\\\\\\n          (member) =>\\\\\\\\\\\\\\\\n            member.kind === '大梁' &&\\\\\\\\\\\\\\\\n            'axis' in member.position &&\\\\\\\\\\\\\\\\n            member.position.axis === 'Y',\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        .map(({ id }) => id),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    const girderLines = result.current.lines.filter(\\\\\\\\\\\\\\\\n      ({ memberKind }) => memberKind === '大梁',\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    const firstStoryG1Lines = girderLines.filter(\\\\\\\\\\\\\\\\n      ({ storyName, mark }) => storyName === '1階' && mark === 'G1',\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    const firstStoryColumnLines = result.current.lines.filter(\\\\\\\\\\\\\\\\n      ({ storyName, memberKind }) =>\\\\\\\\\\\\\\\\n        storyName === '1階' && memberKind === '柱',\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.current.rebars.length).toBeGreaterThan(0)\\\\\\\\\\\\\\\\n    expect(result.current.lines.length).toBeGreaterThan(0)\\\\\\\\\\\\\\\\n    expect(firstStoryG1Lines.map(({ role }) => role)).toEqual([\\\\\\\\\\\\\\\\n      '上端筋',\\\\\\\\\\\\\\\\n      '下端筋',\\\\\\\\\\\\\\\\n      'あばら筋',\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\n      girderLines.reduce((sum, { places }) => sum + places, 0),\\\\\\\\\\\\\\\\n    ).toBe(\\\\\\\\\\\\\\\\n      project.stories.length * supportedGirdersPerStory * 3,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\n      firstStoryColumnLines\\\\\\\\\\\\\\\\n        .filter(({ role }) => role === '主筋')\\\\\\\\\\\\\\\\n        .reduce((sum, { places }) => sum + places, 0),\\\\\\\\\\\\\\\\n    ).toBe(columnsPerStory)\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\n      firstStoryColumnLines\\\\\\\\\\\\\\\\n        .filter(({ role }) => role === '帯筋')\\\\\\\\\\\\\\\\n        .reduce((sum, { places }) => sum + places, 0),\\\\\\\\\\\\\\\\n    ).toBe(columnsPerStory)\\\\\\\\\\\\\\\\n    expect(result.current.unsupportedMembers).toHaveLength(\\\\\\\\\\\\\\\\n      project.stories.length * unsupportedGirdersPerStory,\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    expect(result.current.unsupportedMembers).toContainEqual({\\\\\\\\\\\\\\\\n      memberId: '1F-G1-X1Y1-Y',\\\\\\\\\\\\\\\\n      mark: 'G1',\\\\\\\\\\\\\\\\n      storyName: '1階',\\\\\\\\\\\\\\\\n      reason: '連続スパン',\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\n      result.current.rebars.every(({ memberId }) => !yGirderIds.has(memberId)),\\\\\\\\\\\\\\\\n    ).toBe(true)\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\n      [...xGirderIds].every((memberId) =>\\\\\\\\\\\\\\\\n        result.current.rebars.some((rebar) => rebar.memberId === memberId),\\\\\\\\\\\\\\\\n      ),\\\\\\\\\