\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction sourceLocation(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  rule: RuleHit,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  locale: Locale,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  includeLabel: boolean,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const copy = exportCopy[locale]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const location = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rule.source.doc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rule.source.edition ?? copy.unavailableEdition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rule.source.section ?? copy.unknownSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rule.source.page === null ? null : `${rule.source.page}頁`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .filter(Boolean)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .join(' / ')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return includeLabel ? `${rule.label}（${location}）` : location\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction lineSources(line: QuantityLine, locale: Locale): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return line.rules\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .map((rule) => sourceLocation(rule, locale, false))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    .join('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction sourceIdentity(source: ResolvedSource): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [source.doc, source.edition, source.publisher, source.url].join('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\0')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction contributingSources(lines: QuantityLine[]): ResolvedSource[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const sources = new Map<string, ResolvedSource>()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (const rule of lines.flatMap(({ rules }) => rules)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const identity = sourceIdentity(rule.source)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (!sources.has(identity)) sources.set(identity, rule.source)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [...sources.values()]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction sourceNotice(source: ResolvedSource, locale: Locale): string {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const copy = exportCopy[locale]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    source.doc,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    source.edition ?? copy.unavailableEdition,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    source.publisher,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    source.url ?? copy.unavailableUrl,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ].join(' / ')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction workbookHeaders(locale: Locale): string[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'export.story'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'export.member'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'export.mark'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.rebar'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.diameter'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.shape'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.length'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.count'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.places'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.totalLength'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.unitMass'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.designQuantity'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.requiredQuantity'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.source'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'takeoff.note'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    t(locale, 'export.formula'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction dataRow(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  line: QuantityLine,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  locale: Locale,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  note: string,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): WorkbookRowSpec {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return row(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    'data',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.storyName),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.memberKind),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.mark),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(`${line.inferred ? '⚠ ' : ''}${line.role}`),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.size),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(shapeLabel(locale, line.shape)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.lengthMm / 1000, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.countPerMember, { numberFormat: '0' }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.places, { numberFormat: '0' }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.totalLengthMm / 1000, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.unitMassKgPerM, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.designKg, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.requiredKg, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(lineSources(line, locale)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(note),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(line.formula),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    line.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function buildTakeoffWorkbook(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  input: TakeoffWorkbookInput,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): WorkbookSpec {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { project, lines, locale } = input\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const copy = exportCopy[locale]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const rows: WorkbookRowSpec[] = []\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (hasInferred(lines)) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rows.push(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      row('watermark', [cell('※ 未確認の規準値を含む — 検収前の参考値')]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      row('watermark', [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        cell(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          `${copy.inferredList}: ${inferredRules(lines)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            .map((rule) => sourceLocation(rule, locale, true))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            .join(' / ')}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const headerRowNumber = rows.length + 1\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  rows.push(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'header',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      workbookHeaders(locale).map((header) => cell(header)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ...lines.map((line) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      dataRow(line, locale, project.notes?.[line.id] ?? ''),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const total = grandTotal(lines)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  rows.push(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row('total', [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(t(locale, 'takeoff.total')),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ...Array.from({ length: 10 }, () => cell(null)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(total.designKg, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      cell(total.requiredKg, { numberFormat: THREE_DECIMALS }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row('spacer', []),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row('source-heading', [cell(copy.sourceHeading)]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ...contributingSources(lines).map((source) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      row('source', [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        cell(sourceNotice(source, locale), {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          hyperlink: source.url ?? undefined,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row('notice', [cell(copy.scopeNotice)]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row('notice', [cell(copy.modificationNotice)]),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    filename: 'kijun-takeoff.xlsx',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    sheetName: copy.sheetName,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    title: `${project.name} — ${copy.sheetName}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    columns: COLUMN_WIDTHS.map((width) => ({ width })),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rows,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    headerRowNumber,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst workbookColors = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  canvas: 'FFF7F7F4',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  canvasSoft: 'FFFAFAF7',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  error: 'FFCF2D56',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hairline: 'FFE6E5E0',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ink: 'FF26251E',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  link: 'FF0563C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  white: 'FFFFFFFF',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport async function exportTakeoffXlsx(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  input: TakeoffWorkbookInput,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): Promise<void> {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const spec = buildTakeoffWorkbook(input)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const { Workbook } = await import('exceljs')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const workbook = new Workbook()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  workbook.creator = 'Kijun'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  workbook.title = spec.title\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const worksheet = workbook.addWorksheet(spec.sheetName, {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    properties: { defaultRowHeight: 20 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    pageSetup: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fitToPage: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      fitToWidth: 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      orientation: 'landscape',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      paperSize: 9,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    views: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        state: 'frozen',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ySplit: spec.headerRowNumber,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        showGridLines: false,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  worksheet.columns = spec.columns.map(({ width }) => ({ width }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  for (const rowSpec of spec.rows) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const values = rowSpec.cells.map(({ value, hyperlink }) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      hyperlink && value !== null\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ? { text: String(value), hyperlink }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        : value,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const worksheetRow = worksheet.addRow(values)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    rowSpec.cells.forEach((cellSpec, index) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const worksheetCell = worksheetRow.getCell(index + 1)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (cellSpec.numberFormat) worksheetCell.numFmt = cellSpec.numberFormat\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetCell.alignment = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        vertical: 'middle',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        wrapText: index === 13 || index === 15,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (cellSpec.hyperlink) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        worksheetCell.font = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          color: { argb: workbookColors.link },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          underline: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      rowSpec.kind === 'watermark' ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      rowSpec.kind === 'source-heading' ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      rowSpec.kind === 'source' ||\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      rowSpec.kind === 'notice'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheet.mergeCells(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        worksheetRow.number,\\\\\\\\\\\\\\\\r\\\\\\\\\\