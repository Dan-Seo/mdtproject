kColors.canvas },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        worksheetCell.border = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          bottom: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            style: 'thin',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            color: { argb: workbookColors.hairline },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (rowSpec.kind === 'data') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const wrappedLineCount = Math.max(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        String(rowSpec.cells[13].value).split('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n').length,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        String(rowSpec.cells[15].value).split('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n').length,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.height = Math.max(32, (wrappedLineCount + 1) * 16)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.getCell(13).fill = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        type: 'pattern',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        pattern: 'solid',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        fgColor: { argb: workbookColors.canvasSoft },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.getCell(13).border = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        left: { style: 'medium', color: { argb: workbookColors.ink } },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (String(rowSpec.cells[3].value).startsWith('⚠ ')) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        worksheetRow.getCell(4).font = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          color: { argb: workbookColors.error },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (rowSpec.kind === 'total') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.height = 28\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.font = { bold: true, color: { argb: workbookColors.ink } }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.eachCell((worksheetCell) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        worksheetCell.border = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          top: { style: 'medium', color: { argb: workbookColors.ink } },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.getCell(13).fill = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        type: 'pattern',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        pattern: 'solid',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        fgColor: { argb: workbookColors.canvasSoft },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (rowSpec.kind === 'source-heading') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.height = 28\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.getCell(1).font = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        bold: true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        color: { argb: workbookColors.ink },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.getCell(1).fill = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        type: 'pattern',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        pattern: 'solid',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        fgColor: { argb: workbookColors.canvas },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (rowSpec.kind === 'source' || rowSpec.kind === 'notice') {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      worksheetRow.height = 32\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      if (!worksheetRow.getCell(1).font) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        worksheetRow.getCell(1).font = { color: { argb: workbookColors.ink } }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  worksheet.autoFilter = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    from: { row: spec.headerRowNumber, column: 1 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    to: { row: spec.headerRowNumber, column: COLUMN_COUNT },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const output = await workbook.xlsx.writeBuffer()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const blob = new Blob([new Uint8Array(output)], {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const url = URL.createObjectURL(blob)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const anchor = document.createElement('a')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  anchor.href = url\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  anchor.download = spec.filename\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  anchor.style.display = 'none'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  document.body.appendChild(anchor)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  anchor.click()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  anchor.remove()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  URL.revokeObjectURL(url)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_14\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Raw -Encoding UTF8 src/lib/hooks/useTakeoff.ts'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"'use client'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { useMemo } from 'react'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { Rebar } from '@/domain/model/rebar'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  beamDepthAbove,\\\\\\\\\\\\\\\\n  columnEnds,\\\\\\\\\\\\\\\\n  findSection,\\\\\\\\\\\\\\\\n  girderSpan,\\\\\\\\\\\\\\\\n  girderSupport,\\\\\\\\\\\\\\\\n  type Project,\\\\\\\\\\\\\\\\n} from '@/domain/model/project'\\\\\\\\\\\\\\\\nimport {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  aggregateQuantity,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hasInferred as getHasInferred,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  inferredRules as getInferredRules,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  type QuantityLine,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from '@/domain/quantity'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { generateColumnRebar } from '@/domain/rebar/column'\\\\\\\\\\\\\\\\nimport { generateGirderRebar } from '@/domain/rebar/girder'\\\\\\\\\\\\\\\\nimport type { RuleHit } from '@/domain/rules/types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { useAppStore } from '@/lib/store'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { jpMlitRulePack } from '@/rulepack'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport interface TakeoffResult {\\\\\\\\\\\\\\\\n  rebars: Rebar[]\\\\\\\\\\\\\\\\n  lines: QuantityLine[]\\\\\\\\\\\\\\\\n  hasInferred: boolean\\\\\\\\\\\\\\\\n  inferredRules: RuleHit[]\\\\\\\\\\\\\\\\n  unsupportedMembers: UnsupportedMember[]\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface UnsupportedMember {\\\\\\\\\\\\\\\\n  memberId: string\\\\\\\\\\\\\\\\n  mark: string\\\\\\\\\\\\\\\\n  storyName: string\\\\\\\\\\\\\\\\n  reason: '連続スパン'\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * `Project`는 갱신될 때마다 통째로 교체되므로 참조가 곧 버전이다. 직전 결과 하나만\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 들고 있으면 같은 버전을 보는 모든 소비자(TakeoffPane·TakeoffActions·Viewer3D)가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n * 한 번의 계산을 나눠 쓴다. `useMemo`만으로는 컴포넌트마다 따로 계산한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n */\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nlet lastComputed: { project: Project; result: TakeoffResult } | null = null\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction computeTakeoff(project: Project): TakeoffResult {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  if (lastComputed !== null && lastComputed.project === project) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return lastComputed.result\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const result = buildTakeoff(project)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  lastComputed = { project, result }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return result\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport function useTakeoff(): TakeoffResult {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const project = useAppStore(({ project }) => project)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return useMemo(() => computeTakeoff(project), [project])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction buildTakeoff(project: Project): TakeoffResult {\\\\\\\\\\\\\\\\n  const rebars: Rebar[] = []\\\\\\\\\\\\\\\\n  const unsupportedMembers: UnsupportedMember[] = []\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  for (const member of project.members) {\\\\\\\\\\\\\\\\n    const section = findSection(project, member.sectionId)\\\\\\\\\\\\\\\\n    const story = project.stories.find(({ id }) => id === member.storyId)\\\\\\\\\\\\\\\\n    if (!story) {\\\\\\\\\\\\\\\\n      throw new Error(`Story not found: ${member.storyId}`)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    if (member.kind === '柱') {\\\\\\\\\\\\\\\\n      if (section.kind !== '柱') {\\\\\\\\\\\\\\\\n        throw new Error(`柱 member references a non-柱 section: ${member.id}`)\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      rebars.push(\\\\\\\\\\\\\\\\n        ...generateColumnRebar(\\\\\\\\\\\\\\\\n          {\\\\\\\\\\\\\\\\n            member,\\\\\\\\\\\\\\\\n            section,\\\\\\\\\\\\\\\\n            story,\\\\\\\\\\\\\\\\n            beamDepthAbove: beamDepthAbove(project, member),\\\\\\\\\\\\\\\\n            ends: columnEnds(project, member),\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\n          jpMlitRulePack,\\\\\\\\\\\\\\\\n        ),\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      continue\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    if (section.kind !== '大梁') {\\\\\\\\\\\\\\\\n      throw new Error(`大梁 member references a non-大梁 section: ${member.id}`)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    const support = girderSupport(project, member)\\\\\\\\\\\\\\\\n    if (!support.supported) {\\\\\\\\\\\\\\\\n      unsupportedMembers.push({\\\\\\\\\\\\\\\\n        memberId: member.id,\\\\\\\\\\\\\\\\n        mark: section.mark,\\\\\\\\\\\\\\\\n        storyName: story.name,\\\\\\\\\\\\\\\\n        reason: support.reason,\\\\\\\\\\\\\\\\n      })\\\\\\\\\\\\\\\\n      continue\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    rebars.push(\\\\\\\\\\\\\\\\n      ...generateGirderRebar(\\\\\\\\\\\\\\\\n        { member, section, span: girderSpan(project, member) },\\\\\\\\\\\\\\\\n        jpMlitRulePack,\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const lines = aggregateQuantity(project, rebars, jpMlitRulePack)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    rebars,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    lines,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    hasInferred: getHasInferred(lines),\\\\\\\\\\\\\\\\n    inferredRules: getInferredRules(lines),\\\\\\\\\\\\\\\\n    unsupportedMembers,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_17\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'rg -n -C 12 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"girderPending|TakeoffPane|大梁|unsupported\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" src/components/quantity/TakeoffPane.test.tsx'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"8-  within,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n9-} from '@testing-library/react'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n10-import { beforeEach, describe, expect, it, vi } from 'vitest'\\\\\\\\\\