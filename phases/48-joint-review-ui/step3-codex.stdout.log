tate {\r\n  enabled: boolean\r\n  axis: 'x' | 'y' | 'z'\r\n  ratio: number\r\n}\r\n\r\nexport type ViewerLayers = Record<'main' | 'hoop' | 'concrete', boolean>\r\n\r\nexport interface MemberFingerprint {\r\n  input: string\r\n  result: string | null\r\n}\r\n\r\nexport interface ReviewFingerprints {\r\n  rulepack: string\r\n  checkVersion: number\r\n  checkConditions: string | null\r\n  members: Record<string, MemberFingerprint>\r\n}\r\n\r\nexport interface ReviewSnapshot {\r\n  capturedAt: string\r\n  fingerprints: ReviewFingerprints\r\n  viewer: {\r\n    mode: 'member' | 'building' | 'joint'\r\n    pose: ViewerPose | null\r\n    clip: ClipState\r\n    layers: ViewerLayers\r\n    selection: { group: string | null; memberId: string | null; rowId: string | null }\r\n  }\r\n.tableFrame {\r\n  width: 100%;\r\n  min-height: 100%;\r\n  overflow: auto;\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  min-width: 1240px;\r\n  border-spacing: 0;\r\n  border-collapse: separate;\r\n  font-size: var(--type-caption-size);\r\n}\r\n\r\n.table th,\r\n.table td {\r\n  padding: var(--space-xs);\r\n  border-right: var(--border-hairline-soft);\r\n  border-bottom: var(--border-hairline);\r\n  background: var(--surface-card);\r\n  text-align: left;\r\n  vertical-align: middle;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table th:last-child,\r\n.table td:last-child {\r\n  border-right: 0;\r\n}\r\n\r\n.table thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n  background: var(--color-canvas-soft);\r\n  color: var(--text-muted);\r\n  font-size: var(--type-caption-uppercase-size);\r\n  font-weight: var(--type-caption-uppercase-weight);\r\n  letter-spacing: var(--type-caption-uppercase-ls);\r\n}\r\n\r\n.table .numericCell {\r\n  text-align: right;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.table .requiredColumn {\r\n  border-left: 2px solid var(--text-ink);\r\n  background: var(--color-canvas-soft);\r\n}\r\n\r\n.storyRow th,\r\n.storyRow td {\r\n  border-top: var(--border-hair