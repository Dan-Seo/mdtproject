815:    mesh.userData.reviewFocusSegment = index\nsrc/components\\viewer\\Viewer3D.tsx:846:  connector.userData.reviewMarker = 'connector'\nsrc/components\\viewer\\Viewer3D.tsx:855:  midpoint.userData.reviewMarker = 'midpoint'\nsrc/components\\viewer\\Viewer3D.tsx:858:  runtime.reviewMarker = marker\nsrc/components\\viewer\\Viewer3D.tsx:1821:  const setHoverRow = useAppStore(({ setHoverRow }) => setHoverRow)\nsrc/components\\viewer\\Viewer3D.tsx:1837:  const reviewFocus = useAppStore(({ reviewFocus }) => reviewFocus)\nsrc/components\\viewer\\Viewer3D.tsx:1839:  const setHoverRowRef = useRef(setHoverRow)\nsrc/components\\viewer\\Viewer3D.tsx:1848:  setHoverRowRef.current = setHoverRow\nsrc/components\\viewer\\Viewer3D.tsx:1995:      reviewMarker: null,\nsrc/components\\viewer\\Viewer3D.tsx:2105:        setHoverRowRef.current(rowId)\r\nsrc/components\\viewer\\Viewer3D.tsx:2220:      viewerMode === 'joint' && jointScene !== null ? reviewFocus : null\nsrc/components\\viewer\\Viewer3D.tsx:2248:  }, [jointScene, reviewFocus, viewerMode])\nsrc/components\\viewer\\Viewer3D.tsx:2343:      data-review-focus={reviewFocus === null ? undefined : '1'}\nsrc/components\\viewer\\ViewerTabs.tsx:19:  const setViewerMode = useAppStore(({ setViewerMode }) => setViewerMode)\r\nsrc/components\\viewer\\ViewerTabs.tsx:40:              setViewerMode(mode)\r\n--- takeoff component details ---\r\n        return (\r\n          <LineRows\r\n            key={line.id}\r\n            line={line}\r\n            representative={representative}\r\n            expanded={expanded}\r\n            toggleLine={toggleLine}\r\n            setHoverRow={setHoverRow}\r\n          />\r\n        )\r\n      })}\r\n    </>\r\n  )\r\n}\r\n\r\nfunction LineRows({\r\n  line,\r\n  representative,\r\n  expanded,\r\n  toggleLine,\r\n  setHoverRow,\r\n}: {\r\n  line: QuantityLine\r\n  representative: string\r\n  expanded: boolean\r\n  toggleLine(line: QuantityLine, memberId: string): void\r\n  setHoverRow(rowId: string | null): void\r\n}) {\r\n  const toggle = () => toggleLine(line, representative)\r\n\r\n  return (\r\n    <>\r\n      <tr\r\n        className={styles.lineRow}\r\n        data-testid={`quantity-line-${line.id}`}\r\n        onClick={toggle}\r\n        onMouseEnter={() => setHoverRow(line.id)}\r\n        onMouseLeave={() => setHoverRow(null)}\r\n        onFocus={() => setHoverRow(line.id)}\r\n        onBlur={() => setHoverRow(null)}\r\n      >\r\n        <td className={styles.rebarCell}>\r\n          {/* 행 어디를 눌러도 펼쳐지지만, 펼침 상태는 여기에 둔다 — role=row의\r\n              aria-expanded는 treegrid 안에서만 유효해 평범한 table에서는 읽히지 않는다.\r\n              onFocus/onBlur는 focusin/focusout이라 이 버튼에 포커스가 와도 tr에서 잡힌다. */}\r\n          <button\r\n            type=\"button\"\r\n            className={styles.disclosure}\r\n            aria-expanded={expanded}\r\n            onClick={(event) => {\r\n              event.stopPropagation() // tr의 onClick으로 번지면 두 번 토글돼 아무 일도 안 일어난다\r\n              toggle()\r\n            }}\r\n          >\r\n            {isMassLine(line)\r\n              ? line.role\r\n              : `${line.role}　継手（${line.method}）`}\r\n          </button>\r\n          <ConfidenceWarning line={line} />\r\n        </td>\r\n        <td className={styles.numericCell}>{line.size}</td>\r\n        {isMassLine(line) ? (\r\n          <>\r\n            <td>\r\n              <ShapeIcon shape={line.shape} />\r\n            </td>\r\n            <td className={styles.numericCell}>\r\n              {formatLength(line.lengthMm)}\r\n            </td>\r\n            <td className={styles.numericCell}>{line.countPerMember}</td>\r\n            <td className={styles.numericCell}>{line.places}</td>\r\n            <td className={styles.numericCell}>\r\n              {formatLength(line.totalLengthMm)}\r\n            </td>\r\n            <td className={`${styles.numericCell} ${styles.unitMass}`}>\r\n              {formatMass(line.unitMassKgPerM)}\r\n            </td>\r\n            <td className={styles.numericCell}>{formatMass(line.designKg)}</td>\r\n            <td className={`${styles.numericCell} ${styles.requiredColumn}`}>\r\n              {formatMass(line.requiredKg)}\r\n            </td>\r\n          </>\r\n        ) : (\r\n          // 継手は箇所で数える。長さ・質量の列は空欄ではなく「値がない」と示す —\r\n          // 割増（1通則9)）も設計「数量」＝質量への規定なので所要数量は出ない。\r\n          <>\r\n            <td>{NOT_APPLICABLE}</td>\r\n            <td className={styles.numericCell}>{NOT_APPLICABLE}</td>\r\n            <td className={styles.numericCell}>\r\n              {formatCount(line.countPerMember)}\r\n            </td>\r\n            <td className={styles.numericCell}>{line.places}</td>\r\n            <td className={styles.numericCell}>{NOT_APPLICABLE}</td>\r\n            <td className={`${styles.numericCell} ${styles.unitMass}`}>\r\n              {NOT_APPLICABLE}\r\n            </td>\r\n            <td className={styles.numericCell}>\r\n              {formatCount(line.totalCount)}\r\n            </td>\r\n            <td className={`${styles.numericCell} ${styles.requiredColumn}`}>\r\n              {NOT_APPLICABLE}\r\n            </td>\r\n          </>\r\n        )}\r\n        <td>{line.unit}</td>\r\n        <td>\r\n          <SourceChips rules={line.rules} />\r\n        </td>\r\n        <td>\r\n          <NoteInput lineId={line.id} />\r\n        </td>\r\n      </tr>\r\n      {expanded && (\r\n        <tr className={styles.formulaRow} data-testid={`formula-${line.id}`}>\r\n          <td colSpan={13}>\r\n            <pre>{line.formula}</pre>\r\n          </td>\r\n        </tr>\r\n      )}\r\n    </>\r\n  )\r\n}\r\n\r\nexport function TakeoffPane() {\r\n  const { lines, unsupportedMembers } = useTakeoff()\r\n  const locale = useAppStore(({ locale }) => locale)\r\n\r\n  // 箇所数は計上したが位置は決まっていない（表5.3.3 が原文で画像）。接힌\r\n  // 산출식에만 두면 3D에 継手가 안 보이는 이유를 사용자가 알 수 없다 —\r\n  // 継手 행이 하나라도 있으면 항상 보이게 한다.\r\n  const hasSplice = spliceLines(lines).length > 0\r\n  // 描かれる長さが設計長さより短い理由も同じ扱いにする — 3D とつき合わせる\r\n  // ときに読む必要があるので、折りたたまれた算出式の中だけには置かない。\r\n  const hasCutoff = lines.some(\r\n    ({ role }) =>\r\n      role === '上端カットオフ筋' || role === '下端カットオフ筋',\r\n  )\r\n  // 開口部の欠除（1通則8)）を計上していても、開口補強筋は設計図書からの転記入力であり、\r\n  // 製品が転記の完全性を判定できるわけではない。「빠진 것」ではなく「틀린 채로 완성된 것」になるため、\r\n  // 壁や床板の行が1つでもあれば常に見せる (ADR-025・ADR-028)。1通則8) は窓・出入口だけでなく\r\n  // 床板の開口（階段・設備）にも同じように掛かる。\r\n  const hasOpeningRisk = lines.some(({ memberKind }) =>\r\n    ['耐震壁', '床板'].includes(memberKind),\r\n  )\r\n\r\n  return (\r\n    <>\r\n      {hasSplice && (\r\n        <p\r\n          className={styles.splicePositionNotice}\r\n          role=\"note\"\r\n          data-testid=\"splice-position-notice\"\r\n        >\r\n          ▲ {t(locale, 'takeoff.splicePosition')}\r\n        </p>\r\n      )}\r\n      {hasCutoff && (\r\n        <p\r\n          className={styles.splicePositionNotice}\r\n          role=\"note\"\r\n          data-testid=\"cutoff-anchorage-notice\"\r\n        >\r\n          ▲ {t(locale, 'takeoff.cutoffAnchorage')}\r\n        </p>\r\n      )}\r\n      {hasOpeningRisk && (\r\n        <p\r\n          className={styles.splicePositionNotice}\r\n          role=\"note\"\r\n          data-testid=\"wall-opening-notice\"\r\n        >\r\n          ▲ {t(locale, 'takeoff.wallOpening')}\r\n        </p>\r\n      )}\r\n      {unsupportedMembers.length > 0 && (\r\n        <div\r\n          className={styles.unsupportedNotice}\r\n          role=\"note\"\r\n          data-testid=\"unsupported-notice\"\r\n        >\r\n          <strong>\r\n            {t(locale, 'takeoff.unsupported.title')}{' '}\r\n            {unsupportedMembers.length}\r\n            {t(locale, 'takeoff.unsupported.count')}\r\n          </strong>\r\n          <ul className={styles.unsupportedList}>\r\n            {unsupportedMembers.map((member) => (\r\n              <li key={member.memberId}>\r\n                {member.mark}（{member.storyName}）—{' '}\r\n                {t(\r\n                  locale,\r\n                  `takeoff.unsupported.reason.${member.reason}`,\r\n                )}\r\n              </li>\r\n            ))}\r\n          </ul>\r\n          <p data-testid=\"unsupported-plan\">\r\n            {[...new Set(unsupportedMembers.map(({ reason }) => reason))]\r\n              .map((reason) =>\r\n                t(locale, `takeoff.unsupported.plan.${reason}`),\r\n              )\r\n              .join(' / ')}\r\n          </p>\r\n        </div>\r\n      )}\r\n      <UnitMassInput lines={lines} />\r\n      <TakeoffTable lines={lines} />\r\n    </>\r\n  )\r\n}\r\n\r\nexport function TakeoffActions() {\r\n  const project = useAppStore(({ project }) => project)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const { lines, hasUnverified, inferredRules } = useTakeoff()\r\n  const markupRate = useMemo(() => {\r\n    const rates = [\r\n      ...new Set(\r\n        project.members.map(\r\n          ({ memberClass }) =>\r\n            lookupMarkup(jpMlitRulePack, memberClass).value,\r\n        ),\r\n      ),\r\n    ]\r\n\r\n    // 部材が一本もなければ引く対象がない — 誤りではなく空である。区分ごとに\r\n    // 率が割れているときだけが誤りで、それは黙って一方を選べない (ADR-014)\r\n    if (rates.length > 1) {\r\n      throw new Error('Takeoff header requires exactly one markup rate')\r\n    }\r\n\r\n    return rates[0]\r\n  }, [project])\r\n  const formattedMarkup =\r\n    markupRate === undefined\r\n--- styles ---\r\n.tableFrame {\r\n  width: 100%;\r\n  min-height: 100%;\r\n  overflow: auto;\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  min-width: 1240px;\r\n  border-spacing: 0;\r\n  border-collapse: separate;\r\n  font-size: var(--type-caption-size);\r\n}\r\n\r\n.table th,\r\n.table td {\r\n  padding: var(--space-xs);\r\n  border-right: var(--border-hairline-soft);\r\n  border-bottom: var(--border-hairline);\r\n  background: var(--surface-card);\r\n  text-align: left;\r\n  vertical-align: middle;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table th:last-child,\r\n.table td:last-child {\r\n  border-right: 0;\r\n}\r\n\r\n.table thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n  background: var(--color-canvas-soft);\r\n  color: var(--text-muted);\r\n  font-size: var(--type-caption-uppercase-size);\r\n  font-weight: var(--type-caption-uppercase-weight);\r\n  letter-spacing: var(--type-caption-uppercase-ls);\r\n}\r\n\r\n.table .numericCell {\r\n  text-align: right;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.table .requiredColumn {\r\n  border-left: 2px solid var(--text-ink);\r\n  background: var(--color-canvas-soft);\r\n}\r\n\r\n.storyRow th,\r\n.storyRow td {\r\n  border-top: var(--border-hairline-strong);\r\n  background: var(--color-canvas);\r\n  color: var(--text-ink);\r\n  font-weight: 600;\r\n}\r\n\r\n.storyRow .requiredColumn {\r\n  background: var(--color-canvas-soft);\r\n}\r\n\r\n.groupRow {\r\n  cursor: pointer;\r\n}\r\n\r\n.groupRow th {\r\n  color: var(--text-body-strong);\r\n  font-weight: 600;\r\n}\r\n\r\n.selectedGroupRow th {\r\n  border-left: 3px solid var(--color-primary);\r\n  background: color-mix(in srgb, var(--color-primary) 7%, transparent);\r\n  color: var(--color-primary);\r\n}\r\n\r\n.lineRow {\r\n  cursor: pointer;\r\n}\r\n\r\n.lineRow:hover td {\r\n  background: var(--color-canvas-soft);\r\n}\r\n\r\n.lineRow:hover .requiredColumn {\r\n  background: var(--color-canvas);\r\n}\r\n\r\n.rebarCell {\r\n  padding-left: 30px !important;\r\n}\r\n\r\n/* 펼치기 컨트롤. 겉보기는 기존 역할명 텍스트 그대로다 — 행 전체가 여전히 클릭 가능하고,\r\n   이 버튼은 펼침 상태(aria-expanded)를 유효한 롤 위에 얹기 위해 있다.\r\n   포커스 링은 base.css의 전역 *:focus-visible이 준다. */\r\n.disclosure {\r\n  padding: 0;\r\n  border: 0;\r\n  margin-right: var(--space-xxs);\r\n  background: none;\r\n  color: inherit;\r\n  cursor: pointer;\r\n  font: inherit;\r\n  text-align: left;\r\n}\r\n\r\n.inferredWarning {\r\n  color: var(--color-error);\r\n  font-size: var(--type-caption-uppercase-size);\r\n}\r\n\r\n/* 原文明示だが独立検討待ち — 誤りではないので error 色にはしない */\r\n.transcribedWarning {\r\n  color: var(--color-caution);\r\n  font-size: var(--type-caption-uppercase-size);\r\n}\r\n\r\n.shapeIcon {\r\n  display: block;\r\n  color: var(--text-muted);\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 1.5;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n}\r\n\r\n.unitMass {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.sourceChips {\r\n  display: flex;\r\n  max-width: 280px;\r\n  flex-wrap: wrap;\r\n  gap: var(--space-xxs);\r\n  white-space: normal;\r\n}\r\n\r\n.sourceChip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  min-height: 20px;\r\n  padding: 0 var(--space-xxs);\r\n  border: var(--border-hairline);\r\n  border-radius: var(--radius-xs);\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  line-height: 1;\r\n}\r\n\r\na.sourceChip {\r\n  border-bottom: var(--border-hairline);\r\n}\r\n\r\n/* base.css의 전역 a:hover가 링크를 --color-primary로 칠한다. 出典 칩이 그 색을\r\n   쓰면 선택 상태와 구분되지 않으므로(docs/UX.md §3.4) 칩만 제외한다. */\r\na.sourceChip:hover {\r\n  border-color: var(--hairline-strong);\r\n  border-bottom-color: var(--hairline-strong);\r\n  color: var(--text-ink);\r\n}\r\n\r\n.inferredSourceChip,\r\na.inferredSourceChip {\r\n  border-color: var(--color-error);\r\n  color: var(--color-error);\r\n}\r\n\r\na.inferredSourceChip:hover {\r\n  border-color: var(--color-error);\r\n  border-bottom-color: var(--color-error);\r\n  color: var(--color-error);\r\n}\r\n\r\n.transcribedSourceChip,\r\na.transcribedSourceChip {\r\n  border-color: var(--color-caution);\r\n  color: var(--color-caution);\r\n}\r\n\r\na.transcribedSourceChip:hover {\r\n  border-color: var(--color-caution);\r\n  border-bottom-color: var(--color-caution);\r\n  color: var(--color-caution);\r\n}\r\n\r\n.disabledSourceChip {\r\n  cursor: not-allowed;\r\n  opacity: 0.72;\r\n}\r\n\r\n.noteInput {\r\n  width: 112px;\r\n  min-height: 28px;\r\n  padding: 0 var(--space-xxs);\r\n  border: 1px solid transparent;\r\n  border-radius: var(--radius-xs);\r\n  background: transparent;\r\n  color: var(--text-body);\r\n  font: inherit;\r\n}\r\n\r\n.note