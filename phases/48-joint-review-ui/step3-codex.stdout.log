r\n  border-radius: var(--radius-xs);\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  line-height: 1;\r\n}\r\n\r\na.sourceChip {\r\n  border-bottom: var(--border-hairline);\r\n}\r\n\r\n/* base.css의 전역 a:hover가 링크를 --color-primary로 칠한다. 出典 칩이 그 색을\r\n   쓰면 선택 상태와 구분되지 않으므로(docs/UX.md §3.4) 칩만 제외한다. */\r\na.sourceChip:hover {\r\n  border-color: var(--hairline-strong);\r\n  border-bottom-color: var(--hairline-strong);\r\n  color: var(--text-ink);\r\n}\r\n\r\n.inferredSourceChip,\r\na.inferredSourceChip {\r\n  border-color: var(--color-error);\r\n  color: var(--color-error);\r\n}\r\n\r\na.inferredSourceChip:hover {\r\n  border-color: var(--color-error);\r\n  border-bottom-color: var(--color-error);\r\n  color: var(--color-error);\r\n}\r\n\r\n.transcribedSourceChip,\r\na.transcribedSourceChip {\r\n  border-color: var(--color-caution);\r\n  color: var(--color-caution);\r\n}\r\n\r\na.transcribedSourceChip:hover {\r\n  border-color: var(--color-caution);\r\n  border-bottom-color: var(--color-caution);\r\n  color: var(--color-caution);\r\n}\r\n\r\n.disabledSourceChip {\r\n  cursor: not-allowed;\r\n  opacity: 0.72;\r\n}\r\n\r\n.noteInput {\r\n  width: 112px;\r\n  min-height: 28px;\r\n  padding: 0 var(--space-xxs);\r\n  border: 1px solid transparent;\r\n  border-radius: var(--radius-xs);\r\n  background: transparent;\r\n  color: var(--text-body);\r\n  font: inherit;\r\n}\r\n\r\n.noteInput:focus {\r\n  border-color: var(--hairline);\r\n  background: var(--color-canvas-soft);\r\n}\r\n\r\n.formulaRow td {\r\n  padding: 0;\r\n  background: var(--color-canvas-soft);\r\n}\r\n\r\n.formulaRow pre {\r\n  margin: 0;\r\n  padding: var(--space-sm) 30px;\r\n  color: var(--text-body);\r\n  font-family: var(--font-mono);\r\n  font-size: var(--type-code-size);\r\n  line-height: var(--type-code-lh);\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.totalRow th,\r\n.totalRow td {\r\n  border-top: 2px solid var(--text-ink);\r\n  color: var(--text-ink);\r\n  f