ctionImport.issue.帯筋解釈不能\": \"帯筋/あばら筋을 대응하는 철근 径으로 해석할 수 없습니다.\",\r\n  \"sectionImport.issue.帯筋折返し\": \"帯筋/あばら筋 셀이 여러 줄로 접혀 있어 값을 확정하지 않았습니다.\",\r\n  \"sectionImport.issue.帯筋ラベル行外\": \"帯筋/あばら筋 값이 그 행이 아니라 바로 아래 무라벨 행에 있어 값을 확정하지 않았습니다.\",\r\n  \"sectionImport.issue.腹筋解釈不能\": \"腹筋을 대응하는 철근 径·본수로 해석할 수 없습니다.\",\r\n  \"sectionImport.issue.幅止め筋解釈不能\": \"幅止め筋을 대응하는 철근 径·피치로 유일하게 해석할 수 없어 후보를 빈칸으로 두었습니다.\",\r\n  \"sectionImport.issue.壁筋解釈不能\": \"壁의 縦筋·横筋을 단일 철근 径·피치로 해석할 수 없어 후보를 빈칸으로 두었습니다.\",\r\n  \"sectionImport.issue.壁厚相違\": \"壁厚 표기가 여러 개라 어느 값을 쓸지 정할 수 없어 빈칸으로 두었습니다.\",\r\n  \"sectionImport.issue.床板筋解釈不能\": \"床板 배근을 단일 철근 径·피치로 해석할 수 없어 후보를 빈칸으로 두었습니다.\",\r\n  \"sectionImport.outOfScope\": \"対象外(柱·大梁 이외)\",\r\n  \"plan.storyTabs\": \"층 선택\",\r\n  \"plan.addSpan\": \" 스팬 추가\",\r\n  \"plan.removeSpan\": \" 삭제\",\r\n  \"plan.placement.wall.title\": \"耐震壁 배치\",\r\n  \"plan.placement.slab.title\": \"床板 배치\",\r\n  \"plan.placement.cantilever.title\": \"片持床板 배치\",\r\n  \"plan.placement.cantilever.side\": \"支持辺\",\r\n  \"plan.placement.cantilever.positive\": \"正\",\r\n  \"plan.placement.cantilever.negative\": \"負\",\r\n  \"plan.placement.cantilever.projection\": \"내민 길이\",\r\n  \"plan.placement.section\": \"断面\",\r\n  \"plan.placement.empty\": \"배치할 수 있는 빈 위치가 없습니다\",\r\n  \"plan.placement.wall.sectionMissing\": \"耐震壁 断面이 없습니다 — 부재 단면일람에서 断面을 입력하세요\",\r\n  \"plan.placement.slab.sectionMissing\": \"床板 断面이 없습니다 — 부재 단면일람에서 断面을 입력하세요\",\r\n  \"plan.placement.sectionMissing\": \"배치할 断面이 없습니다\",\r\n  \"plan.placement.delete\": \"부재 삭제\",\r\n  \"plan.placement.duplicate\": \"같은 위치·符号의 부재가 이미 있습니다\",\r\n  \"plan.placement.unavailable\": \"이 위치에는 배치할 수 없습니다\",\r\n  \"locale.ja\": \"日本語\",\r\n  \"locale.ko\": \"한국어\",\r\n--- relevant tests ---\r\nimport { fireEvent, render, screen } from '@testing-library/react'\r\nimport { beforeEach, describe, expect, it, vi } from 'vitest'\r\n\r\nimport { useAppStore } from '@/lib/store'\r\n\r\nconst { capture } = vi.hoisted(() => ({ capture: vi.fn() }))\r\n\r\nvi.mock('@/lib/telemetry', () => ({ capture }))\r\n\r\nimport { ViewerTabs } from './ViewerTabs'\r\n\r\ndescribe('ViewerTabs', () => {\r\n  beforeEach(() => {\r\n    capture.mockClear()\r\n    useAppStore.setState({ locale: 'ja', viewerMode: 'member' })\r\n  })\r\n\r\n  it('renders 部材/建物 tabs with the current mode selected', () => {\r\n    render(<ViewerTabs />)\r\n\r\n    expect(screen.getByRole('tab', { name: '部材' })).toHaveAttribute(\r\n      'aria-selected',\r\n      'true',\r\n    )\r\n    expect(screen.getByRole('tab', { name: '建物' })).toHaveAttribute(\r\n      'aria-selected',\r\n      'false',\r\n    )\r\n    expect(screen.getByRole('tab', { name: '接合部' })).toHaveAttribute(\r\n      'aria-selected',\r\n      'false',\r\n    )\r\n  })\r\n\r\n  it('switches the store mode on click', () => {\r\n    render(<ViewerTabs />)\r\n\r\n    fireEvent.click(screen.getByRole('tab', { name: '建物' }))\r\n\r\n    expect(useAppStore.getState().viewerMode).toBe('building')\r\n  })\r\n\r\n  it('switches to the joint mode on click', () => {\r\n    render(<ViewerTabs />)\r\n\r\n    fireEvent.click(screen.getByRole('tab', { name: '接合部' }))\r\n\r\n    expect(useAppStore.getState().viewerMode).toBe('joint')\r\n  })\r\n\r\n  it('reports the mode switch', () => {\r\n    render(<ViewerTabs />)\r\n\r\n    fireEvent.click(screen.getByRole('tab', { name: '建物' }))\r\n\r\n    expect(capture).toHaveBeenCalledWith('viewer_mode_changed', {\r\n      mode: 'building',\r\n    })\r\n  })\r\n\r\n  // 이미 활성인 탭을 다시 눌러도 전환이 아니다 — member_selected와 발화\r\n  // 기준을 맞춘다 (9차 리뷰 nit).\r\n  it('does not report when clicking the already-active tab', () => {\r\n    render(<ViewerTabs />)\r\n\r\n    fireEvent.click(screen.getByRole('tab', { name: '部材' }))\r\n\r\n    expect(capture).not.toHaveBeenCalled()\r\n  })\r\n\r\n  it('translates the tab labels instead of hardcoding Japanese', () => {\r\n    useAppStore.setState({ locale: 'ko' })\r\n    render(<ViewerTabs />)\r\n\r\n    expect(\r\n      screen.getByRole('tablist', { name: '표시 전환' }),\r\n    ).toBeInTheDocument()\r\n    expect(screen.getByRole('tab', { name: '부재' })).toBeInTheDocument()\r\n    expect(screen.getByRole('tab', { name: '건물' })).toBeInTheDocument()\r\n    expect(screen.getByRole('tab', { name: '接合部' })).toBeInTheDocument()\r\n  })\r\n})\r\n--- package ---\r\n{\r\n  \"name\": \"kijun\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"predev\": \"node scripts/copy-pdfjs-assets.mjs\",\r\n    \"dev\": \"next dev\",\r\n    \"prebuild\": \"node scripts/copy-pdfjs-assets.mjs\",\r\n    \"build\": \"next build\",\r\n    \"lint\": \"eslint .\",\r\n    \"typecheck\": \"tsc --noEmit\",\r\n    \"test\": \"vitest run\",\r\n    \"test:golden\": \"vitest run tests/golden\",\r\n    \"rulepack:review-sheet\": \"tsx scripts/rulepack/review-sheet.ts\",\r\n    \"lighthouse\": \"lhci autorun --config=lighthouserc.cjs\",\r\n    \"perf:measure\": \"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\",\r\n    \"eval\": \"tsx --env-file-if-exists=.env evals/harness/run.ts\",\r\n    \"test:hooks\": \"bash scripts/hooks/tdd-guard.spec.sh\",\r\n    \"hooks:install\": \"git config core.hooksPath scripts/githooks\",\r\n    \"test:ci-scripts\": \"bash scripts/ci/scrub-secrets.spec.sh && bash scripts/ci/review-scope.spec.sh && bash scripts/ci/review-carryforward.spec.sh && bash scripts/ci/review-verdict.spec.sh && bash scripts/ci/distill-failure-log.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts/perf/blocking-graph.test.mjs\"\r\n  },\r\n  \"dependencies\": {\r\n    \"exceljs\": \"^4.4.0\",\r\n    \"js-yaml\": \"^5.2.3\",\r\n    \"next\": \"^15.5.23\",\r\n    \"pdfjs-dist\": \"6.2.108\",\r\n    \"posthog-js\": \"1.417.4\",\r\n    \"react\": \"^19.2.8\",\r\n    \"react-dom\": \"^19.2.8\",\r\n    \"three\": \"^0.185.1\",\r\n    \"zustand\": \"^5.0.14\"\r\n  },