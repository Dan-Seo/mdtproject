\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  function girder(axis: 'X' | 'Y'): Member {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      id: `1F-G1-${axis}`,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      kind: '大梁',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      memberClass: '躯体',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      sectionId: deepGirderSection.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      storyId: '1F',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      position: { axis, ix: 0, iy: 0 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  function spanProject(members: Member[]): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ...createProject(members),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      grid: { xSpans: [6000], ySpans: [6000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      sections: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        columnSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        rectangularColumnSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        narrowColumnSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        wideColumnSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        shallowGirderSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        deepGirderSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('calculates the X-axis clear span between two 800 mm 柱 faces', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const member = girder('X')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const project = spanProject([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      supportColumn('start', columnSection.id, 0, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      supportColumn('end', columnSection.id, 1, 0),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      member,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\