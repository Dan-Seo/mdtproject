ow(\\\\\\\\\\\\\\\\n+      'Project shape mismatch',\\\\\\\\\\\\\\\\n+    )\\\\\\\\\\\\\\\\n+  })\\\\\\\\\\\\\\\\n+})\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\n describe('girderSpan', () => {\\\\\\\\\\\\\\\\n   const rectangularColumnSection: ColumnSection = {\\\\\\\\\\\\\\\\n     ...columnSection,\\\\\\\\\\\\\\\\ndiff --git a/src/domain/model/project.ts b/src/domain/model/project.ts\\\\\\\\\\\\\\\\nindex 6839a46..a94dc2d 100644\\\\\\\\\\\\\\\\n--- a/src/domain/model/project.ts\\\\\\\\\\\\\\\\n+++ b/src/domain/model/project.ts\\\\\\\\\\\\\\\\n@@ -986,10 +986,19 @@ const shapedAs =\\\\\\\\\\\\\\\\n   (value: unknown): boolean =>\\\\\\\\\\\\\\\\n     hasShape(value, fields)\\\\\\\\\\\\\\\\n \\\\\\\\\\\\\\\\n-const isMainRow = shapedAs({\\\\\\\\\\\\\\\\n-  endCount: isFiniteNumber,\\\\\\\\\\\\\\\\n-  centerCount: isFiniteNumber,\\\\\\\\\\\\\\\\n-})\\\\\\\\\\\\\\\\n+const isMainRow = (value: unknown): boolean => {\\\\\\\\\\\\\\\\n+  if (\\\\\\\\\\\\\\\\n+    !hasShape(value, {\\\\\\\\\\\\\\\\n+      endCount: isFiniteNumber,\\\\\\\\\\\\\\\\n+      centerCount: isFiniteNumber,\\\\\\\\\\\\\\\\n+    })\\\\\\\\\\\\\\\\n+  ) {\\\\\\\\\\\\\\\\n+    return false\\\\\\\\\\\\\\\\n+  }\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\n+  const row = value as Record<string, unknown>\\\\\\\\\\\\\\\\n+  return row.startCount === undefined || isFiniteNumber(row.startCount)\\\\\\\\\\\\\\\\n+}\\\\\\\\\\\\\\\\n \\\\\\\\\\\\\\\\n const isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\\\\\\\\\\\\\\\\n \\\\\\\\\\\\\\\\n--- step0 commit ---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nf6d8983 (HEAD -> feat-20-girder-end-asymmetry) chore(20-girder-end-asymmetry): step 0 output\\\\\\\\\\\\\\\\n phases/20-girder-end-asymmetry/index.json          |  5 +-\\\\\\\\\\\\\\\\n .../20-girder-end-asymmetry/step0-codex.stderr.log |  2 +\\\\\\\\\\\\\\\\n .../20-girder-end-asymmetry/step0-codex.stdout.log | 61 ++++++++++++++++++++++\\\\\\\\\\\\\\\\n phases/20-girder-end-asymmetry/step0-invoke.json   |  9 ++++\\\\\\\\\\\\