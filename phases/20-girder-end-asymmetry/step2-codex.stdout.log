  \"xMm\":  2000,\r\n                                                                                  \"yMm\":  600,\r\n                                                                                  \"widthMm\":  700,\r\n                                                                                  \"heightMm\":  700\r\n                                                                              }\r\n                                                                          ],\r\n                                                             \"expected\":  {\r\n                                                                              \"alongX\":  {\r\n                                                                                             \"totalCount\":  13,\r\n                                                                                             \"groups\":  \"\"\r\n                                                                                         },\r\n                                                                              \"alongY\":  {\r\n                                                                                             \"totalCount\":  27,\r\n                                                                                             \"groups\":  \"\"\r\n                                                                                         }\r\n                                                                          },\r\n                                                             \"handDerivation\":  \"700×700 ＝ 0.49㎡ は「1か所当たり内法面積0.5㎡以下」なので、開口があっても鉄筋は1本も欠けない\"\r\n                                                         },\r\n                                                         {\r\n                                                             \"label\":  \"耐震壁 ちょうど 0.50㎡ の開口 — 「以下」なので欠除しない\",\r\n                                                             \"memberKind\":  \"耐震壁\",\r\n                                                             \"clearXMm\":  5200,\r\n                                                             \"clearYMm\":  2400,\r\n                                                             \"pitchMm\":  200,\r\n                                                             \"openings\":  [\r\n                                                                              {\r\n                                                                                  \"xMm\":  2000,\r\n                                                                                  \"yMm\":  900,\r\n                                                                                  \"widthMm\":  1000,\r\n                                                                                  \"heightMm\":  500\r\n                                                                              }\r\n                                                                          ],\r\n                                                             \"expected\":  {\r\n                                                                              \"alongX\":  {\r\n                                                                                             \"totalCount\":  13,\r\n                                                                                             \"groups\":  \"\"\r\n                                                                                         },\r\n                                                                              \"alongY\":  {\r\n                                                                                             \"totalCount\":  27,\r\n                                                                                             \"groups\":  \"\"\r\n                                                                                         }\r\n                                                                          },\r\n                                                             \"handDerivation\":  \"1000×500 ＝ 0.50㎡ は条文の「１か所当たり内法面積０．５㎡以下」にちょうど当たる。「以下」なので境目そのものは欠除しない — 開口を横切る位置に鉄筋があっても1本も欠けない\"\r\n                                                         },\r\n                                                         {\r\n                                                             \"label\":  \"床板 内法5600×5600 に 1200×1200 の開口1か所 — 壁と同じ条項\",\r\n                                                             \"memberKind\":  \"床板\",\r\n                                                             \"clearXMm\":  5600,\r\n                                                             \"clearYMm\":  5600,\r\n                                                             \"pitchMm\":  200,\r\n                                                             \"openings\":  [\r\n                                                                              {\r\n                                                                                  \"xMm\":  2400,\r\n                                                                                  \"yMm\":  2400,\r\n                                                                                  \"widthMm\":  1200,\r\n                                                                                  \"heightMm\":  1200\r\n                                                                              }\r\n                                                                          ],\r\n                                                             \"expected\":  {\r\n                                                                              \"alongX\":  {\r\n                                                                                             \"totalCount\":  29,\r\n                                                                                             \"groups\":  \" \"\r\n                                                                                         },\r\n                 