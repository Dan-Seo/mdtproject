     }\r\n              ]\r\n            },\r\n            \"alongY\": {\r\n              \"totalCount\": 27,\r\n              \"groups\": [\r\n                {\r\n                  \"deductionMm\": 0,\r\n                  \"count\": 27\r\n                }\r\n              ]\r\n            }\r\n          },\r\n          \"handDerivation\": \"1000×500 ＝ 0.50㎡ は条文の「１か所当たり内法面積０．５㎡以下」にちょうど当たる。「以下」なので境目そのものは欠除しない — 開口を横切る位置に鉄筋があっても1本も欠けない\"\r\n        },\r\n        {\r\n          \"label\": \"床板 内法5600×5600 に 1200×1200 の開口1か所 — 壁と同じ条項\",\r\n          \"memberKind\": \"床板\",\r\n          \"clearXMm\": 5600,\r\n          \"clearYMm\": 5600,\r\n          \"pitchMm\": 200,\r\n          \"openings\": [\r\n            {\r\n              \"xMm\": 2400,\r\n              \"yMm\": 2400,\r\n              \"widthMm\": 1200,\r\n              \"heightMm\": 1200\r\n            }\r\n          ],\r\n          \"expected\": {\r\n            \"alongX\": {\r\n              \"totalCount\": 29,\r\n              \"groups\": [\r\n                {\r\n                  \"deductionMm\": 0,\r\n                  \"count\": 24\r\n                },\r\n                {\r\n                  \"deductionMm\": 1200,\r\n                  \"count\": 5\r\n                }\r\n              ]\r\n            },\r\n            \"alongY\": {\r\n              \"totalCount\": 29,\r\n              \"groups\": [\r\n                {\r\n                  \"deductionMm\": 0,\r\n                  \"count\": 24\r\n                },\r\n                {\r\n                  \"deductionMm\": 1200,\r\n                  \"count\": 5\r\n                }\r\n              ]\r\n            }\r\n          },\r\n          \"handDerivation\": \"1通則8) は部材を限らない。本数 ＝ ⌈5600÷200⌉＋1 ＝ 29、位置は 0・200・…・5600。X方向筋は開口の y 内法 (2400, 3600) の内側 2600〜3400 の5本が 開口の x 寸法 1200 を欠き、Y方向筋はその逆で同じ数になる（正方形の開口なので）\"\r\n        }\r\n      ]\r\n    }\r\n  }\r\n}\r\n{\r\n  \"name\": \"kijun\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"t