\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  setNote,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  storyElevation,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  type Project,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  type Story,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from './project'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { MemberUnsupportedError } from './unsupported'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { coverConditions } from '../rules/lookup'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst columnSection: ColumnSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: 'section-C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: 'C1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  shape: '矩形',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  d: 800,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  spliceMethod: '重ね継手',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: { size: 'D25', count: 12 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  hoop: { size: 'D13', pitch: 100, startOffsetMm: 0 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst shallowGirderSection: GirderSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: 'section-G2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '大梁',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: 'G2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  b: 400,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  depth: 700,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  fc: 24,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  grade: 'SD345',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  exposure: '屋外',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  finish: '仕上げなし',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  spliceMethod: '重ね継手',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  main: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    size: 'D22',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    top: { endCount: 4, centerCount: 4 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    bottom: { endCount: 4, centerCount: 4 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    cutoffFromSupportFaceMm: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  stirrup: { size: 'D13', pitch: 150, startOffsetMm: 50 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst deepGirderSection: GirderSection = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ...shallowGirderSection,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: 'section-G1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  mark: 'G1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  depth: 750,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst column: Member = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  id: '1F-X2Y2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  kind: '柱',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  memberClass: '躯体',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  sectionId: columnSection.id,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  storyId: '1F',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  position: { ix: 1, iy: 1 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction createProject(members: Member[] = [column]): Project {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    schemaVersion: PROJECT_SCHEMA_VERSION,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    name: 'テスト案件',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    grid: { xSpans: [6000, 6000], ySpans: [6000, 6000] },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    stories: [{ id: '1F', name: '1階', height: 4200 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    sections: [columnSection, shallowGirderSection, deepGirderSection],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    members,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('storyElevation', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const stories: Story[] = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    { id: '1F', name: '1階', height: 4200 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    { id: '2F', name: '2階', height: 3800 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    { id: '3F', name: '3階', height: 3800 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('accumulates the heights of the stories below in array order', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(storyElevation(stories, '1F')).toBe(0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(storyElevation(stories, '2F')).toBe(4200)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(storyElevation(stories, '3F')).toBe(8000)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('returns 0 for the only story of a single-story project', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(storyElevation([stories[0]], '1F')).toBe(0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 階 라벨은 断面リスト 취입으로 도면에서 들어오는 값이라 메시지에 맨몸으로\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 싣지 않고 JSON 블록으로 감싼다. 원래는 텔레메트리 스크러버(블랙리스트)가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // letter+digit 토큰을 룰팩 상수로 오인해 통과시키는 것을 피하려는 조치였다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // ADR-020이 허용목록으로 바뀌어 예외 message 자체가 안 나가므로 그 결합은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 사라졌다 — 이 모양을 되돌리는 것은 별건이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('throws on an unknown story id with the id wrapped as a JSON block', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(() => storyElevation(stories, 'RF')).toThrow(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'Story not found: {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"storyId\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"RF\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"}',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('grid helpers', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('returns grid point counts and cumulative coordinates in mm', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const grid = { xSpans: [1000, 2000], ySpans: [500] }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(gridPointCount(grid)).toEqual({ nx: 3, ny: 2 })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(gridPoint(grid, 2, 1)).toEqual({ x: 3000, y: 500 })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it.each([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    [-1, 0],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    [0, -1],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    [3, 0],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    [0, 3],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ])('throws for an out-of-range grid index (%s, %s)', (ix, iy) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(() => gridPoint(createProject().grid, ix, iy)).toThrow()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('project lookup helpers', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('finds a section and throws when the section is absent', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const project = createProject()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(findSection(project, 'section-C1')).toEqual(columnSection)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(() => findSection(project, 'missing')).toThrow()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"uses Story.name, C/G and 符号 for the fixed group-key format\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(memberGroupKey(createProject(), column)).toBe('1階|C|C1')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('returns the greatest