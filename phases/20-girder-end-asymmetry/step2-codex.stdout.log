els.length === spanCount + 1 &&\\\\r\\\\n    labels.every((label) => typeof label === 'string')\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface Story {\\\\r\\\\n  id: string\\\\r\\\\n  name: string\\\\r\\\\n  height: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface Project {\\\\r\\\\n  schemaVersion: number\\\\r\\\\n  name: string\\\\r\\\\n  grid: Grid\\\\r\\\\n  stories: Story[]\\\\r\\\\n  sections: Section[]\\\\r\\\\n  members: Member[]\\\\r\\\\n  /** ?댁뿭???숃? QuantityLine.id瑜??ㅻ줈 ?대떎. 媛믪씠 ?녿뒗 ?됱? ???먯껜媛 ?녿떎. */\\\\r\\\\n  notes?: Record<string, string>\\\\r\\\\n  /**\\\\r\\\\n   * 孃꾨퀎 ?섆퐤蘊ら뇧 (kg/m) ???⑴뵪?끻뀯?? 誘몄엯??孃꾩? ?ㅺ? ?녿떎.\\\\r\\\\n   * 洹쒖???JIS???꾩엫??媛믪씠??猷고뙥???꾨땲???꾨줈?앺듃媛 ?ㅺ퀬 ?덈떎.\\\\r\\\\n   */\\\\r\\\\n  unitMass?: Partial<Record<ShearBarSize, number>>\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function gridPointCount(grid: Grid): { nx: number; ny: number } {\\\\r\\\\n  return {\\\\r\\\\n    nx: grid.xSpans.length + 1,\\\\r\\\\n    ny: grid.ySpans.length + 1,\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function gridPoint(\\\\r\\\\n  grid: Grid,\\\\r\\\\n  ix: number,\\\\r\\\\n  iy: number,\\\\r\\\\n): { x: number; y: number } {\\\\r\\\\n  const { nx, ny } = gridPointCount(grid)\\\\r\\\\n\\\\r\\\\n  if (\\\\r\\\\n    !Number.isInteger(ix) ||\\\\r\\\\n    !Number.isInteger(iy) ||\\\\r\\\\n    ix < 0 ||\\\\r\\\\n    ix >= nx ||\\\\r\\\\n    iy < 0 ||\\\\r\\\\n    iy >= ny\\\\r\\\\n  ) {\\\\r\\\\n    throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\\\\r\\\\n    y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * storyId??\\\\\\\"1F\\\\\\\" 媛숈? letter+digit ?쇰꺼?대씪 猷고뙥 ?곸닔(D25 ??? 媛믪쓽\\\\r\\\\n * 紐⑥뼇留뚯쑝濡?援щ텇?섏? ?딅뒗????telemetry.ts???ㅽ겕?щ쾭??letter+digit\\\\r\\\\n * ?좏겙???듭㎏濡??④린誘濡? 洹몃깷 蹂닿컙?섎㈃ ???쇰꺼??洹몃?濡??덉뼱 ?섍컙??9李? * 由щ럭 critical). JSON 釉붾줉?쇰줈 媛먯떥硫??ㅽ겕?щ쾭??`{...}` 洹쒖튃??嫄몃┛??\\\\r\\\\n * ???щ㎎???⑥닔 ?섎굹濡?怨좎젙???ㅼ쓬 ?몄텧遺媛 洹쒖빟???먯쑝濡??ㅼ떆 踰좊겮吏\\\\r\\\\n * ?딄쾶 ?쒕떎(9李?由щ럭 minor).\\\\r\\\\n */\\\\r\\\\nexport function storyNotFound(storyId: string): Error {\\\\r\\\\n  return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 痢?諛붾떏???꾩쟻 ?쒓퀬(mm). stories 諛곗뿴 ?쒖꽌?濡??꾨옒痢?height瑜??꾩쟻?쒕떎. */\\\\r\\\\nexport function storyElevation(stories: Story[], storyId: string): number {\\\\r\\\\n  const index = stories.findIndex(({ id }) => id === storyId)\\\\r\\\\n\\\\r\\\\n  if (index < 0) {\\\\r\\\\n    throw storyNotFound(storyId)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function findSection(project: Project, sectionId: string): Section {\\\\r\\\\n  const section = project.sections.find(({ id }) => id === sectionId)\\\\r\\\\n\\\\r\\\\n  if (!section) {\\\\r\\\\n    throw new Error(`Section not found: ${sectionId}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return section\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function memberGroupKey(project: Project, member: Member): string {\\\\r\\\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\\\r\\\\n  if (!story) {\\\\r\\\\n    throw storyNotFound(member.storyId)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const section = findSection(project, member.sectionId)\\\\r\\\\n  if (section.kind !== member.kind) {\\\\r\\\\n    throw new Error(\\\\r\\\\n      `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const memberCode = MEMBER_GROUP_CODE[member.kind]\\\\r\\\\n  return `${story.name}|${memberCode}|${section.mark}`\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** ?낁㉢?멥겗?겹꺂?쇈깤?듐겓鵝욍걝?ⓩ쓲?녈꺖?됥귞Е??mark)?③쉸??뼋?ユ뙚?얇굥訝?뉐춻??*/\\\\r\\\\nconst MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\\\\r\\\\n  ?? 'C',\\\\r\\\\n  鸚㎪쥈: 'G',\\\\r\\\\n  ?먬쐡鶯? 'W',\\\\r\\\\n  佯딀씮: 'S',\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction isColumnPosition(\\\\r\\\\n  position: ColumnPosition | GirderPosition,\\\\r\\\\n): position is ColumnPosition {\\\\r\\\\n  return !('axis' in position)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction isGirderPosition(\\\\r\\\\n  position: ColumnPosition | GirderPosition,\\\\r\\\\n): position is GirderPosition {\\\\r\\\\n  return 'axis' in position\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction touchesColumn(\\\\r\\\\n  girder: GirderPosition,\\\\r\\\\n  column: ColumnPosition,\\\\r\\\\n): boolean {\\\\r\\\\n  if (girder.axis === 'X') {\\\\r\\\\n    return (\\\\r\\\\n      girder.iy === column.iy &&\\\\r\\\\n      (girder.ix === column.ix || girder.ix + 1 === column.ix)\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    girder.ix === column.ix &&\\\\r\\\\n    (girder.iy === column.iy || girder.iy + 1 === column.iy)\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface GirderSpan {\\\\r\\\\n  axis: 'X' | 'Y'\\\\r\\\\n  /** 洹몃━??援먯젏 媛?以묒떖 ?ㅽ뙩 (mm) */\\\\r\\\\n  centerSpan: number\\\\r\\\\n  /** ?끾퀡?룔걬 (mm) ???묐떒 ?깁씊 ?ъ씠 */\\\\r\\\\n  clear: number\\\\r\\\\n  /** ?쒖옉 ??以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\\\\r\\\\n  startFaceOffsetMm: number\\\\r\\\\n  /** ????以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\\\\r\\\\n  endFaceOffsetMm: number\\\\r\\\\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ???쒖옉 ?깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\\\\r\\\\n  startSupportLengthAlongAxisMm: number\\\\r\\\\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ?????깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\\\\r\\\\n  endSupportLengthAlongAxisMm: number\\\\r\\\\n  /** 吏???깆쓽 ?뗣겤??議고쉶 議곌굔 ??塋?깿?▽뻑? 鸚㎪쥈???꾨땲???깆쓽 ?뗣겤?딅줈 ?먯젙?쒕떎 */\\\\r\\\\n  startSupportCover: Record<string, string | boolean>\\\\r\\\\n  endSupportCover: Record<string, string | boolean>\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function girderSupportSections(\\\\r\\\\n  project: Project,\\\\r\\\\n  member: Member,\\\\r\\\\n): { start: ColumnSection; end: ColumnSection } {\\\\r\\\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\\\r\\\\n    throw new Error(`girderSupportSections requires a 鸚㎪쥈: ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const { axis, ix, iy } = member.position\\\\r\\\\n  const endIx = axis === 'X' ? ix + 1 : ix\\\\r\\\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    start: supportColumnSection(project, member, ix, iy, 'start'),\\\\r\\\\n    end: supportColumnSection(project, member, endIx, endIy, 'end'),\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction supportColumnSection(\\\\r\\\\n  project: Project,\\\\r\\\\n  supported: Member,\\\\r\\\\n  ix: number,\\\\r\\\\n  iy: number,\\\\r\\\\n  end: 'start' | 'end',\\\\r\\\\n): ColumnSection {\\\\r\\\\n  const support = project.members.find(\\\\r\\\\n    (candidate) =>\\\\r\\\\n      candidate.kind === '?? &&\\\\r\\\\n      candidate.storyId === supported.storyId &&\\\\r\\\\n      isColumnPosition(candidate.position) &&\\\\r\\\\n      candidate.position.ix === ix &&\\\\r\\\\n      candidate.position.iy === iy,\\\\r\\\\n  )\\\\r\\\\n\\\\r\\\\n  if (!support) {\\\\r\\\\n    throw new Error(\\\\r\\\\n      `Missing ${end} support ??for ${supported.kind}: ${supported.id}`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const section = findSection(project, support.sectionId)\\\\r\\\\n  if (section.kind !== '??) {\\\\r\\\\n    throw new Error(`??member references a non-??section: ${support.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return section\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function girderSpan(project: Project, member: Member): GirderSpan {\\\\r\\\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\\\r\\\\n    throw new Error(`girderSpan requires a 鸚㎪쥈: ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const { axis, ix, iy } = member.position\\\\r\\\\n  const endIx = axis === 'X' ? ix + 1 : ix\\\\r\\\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\\\r\\\\n  const startPoint = gridPoint(project.grid, ix, iy)\\\\r\\\\n  const endPoint = gridPoint(project.grid, endIx, endIy)\\\\r\\\\n  const { start: startSection, end: endSection } = girderSupportSections(\\\\r\\\\n    project,\\\\r\\\\n    member,\\\\r\\\\n  )\\\\r\\\\n  const centerSpan =\\\\r\\\\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\\\\r\\\\n  const startSupportLengthAlongAxisMm =\\\\r\\\\n    axis === 'X' ? startSection.b : startSection.d\\\\r\\\\n  const endSupportLengthAlongAxisMm =\\\\r\\\\n    axis === 'X' ? endSection.b : endSection.d\\\\r\\\\n  const startFaceOffsetMm = startSupportLengthAlongAxisMm / 2\\\\r\\\\n  const endFaceOffsetMm = endSupportLengthAlongAxisMm / 2\\\\r\\\\n  const clear = centerSpan - startFaceOffsetMm - endFaceOffsetMm\\\\r\\\\n\\\\r\\\\n  if (clear <= 0) {\\\\r\\\\n    throw new MemberUnsupportedError(\\\\r\\\\n      '野멩퀡訝띷닇塋?,\\\\r\\\\n      `鸚㎪쥈 ?끾퀡?룔걬 must be positive: ${member.id} (${clear} mm)`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    axis,\\\\r\\\\n    centerSpan,\\\\r\\\\n    clear,\\\\r\\\\n    startFaceOffsetMm,\\\\r\\\\n    endFaceOffsetMm,\\\\r\\\\n    startSupportLengthAlongAxisMm,\\\\r\\\\n    endSupportLengthAlongAxisMm,\\\\r\\\\n    startSupportCover: coverConditions(startSection),\\\\r\\\\n    endSupportCover: coverConditions(endSection),\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * ?먬쐡鶯곥겗?끾퀡野멩퀡?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬?? * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곩즯??쳵?뺛굚?룔걬?귚릎恙껈뼋?㎯겘?ゃ걦?끾퀡?㎯걗?뗣? * ?긱꺕鸚㎪쥈?ⓧ틠?띹쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?앫겗?귙겗?㎯곩ㄷ歟곥걣?끾퀡?룔걬?ゃ겗?ⓨ릪?섇숱?졼? */\\\\r\\\\nexport interface WallSpan {\\\\r\\\\n  axis: 'X' | 'Y'\\\\r\\\\n  /** ?끾퀡?룔걬 (mm) ??訝▼겢??윶??냵?닻씊??뼋 */\\\\r\\\\n  clearLengthMm: number\\\\r\\\\n  /** ?끾퀡遙섅걬 (mm) ???롩쳵 ??訝딃깿鸚㎪쥈?쎼걚 */\\\\r\\\\n  clearHeightMm: number\\\\r\\\\n  /** 冶뗧ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\\\\r\\\\n  startFaceOffsetMm: number\\\\r\\\\n  /** 永귞ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\\\\r\\\\n  endFaceOffsetMm: number\\\\r\\\\n  /** ?끾퀡遙섅걬?믤군?곥걼訝딃깿鸚㎪쥈??걵??(mm) */\\\\r\\\\n  girderDepthAboveMm: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 鶯곥겗訝듽겓雍됥굥鸚㎪쥈??걵?꾠귛즯?ⓨ릪?섋씌竊덂릪?섌싥굤??꺕?뚣걯?밤깙?놂펹??ㄷ歟곥굮誤뗣굥 ?? * ?먬쐡鶯곥겘2?с겗?긱겗?볝겓塋뗣걾?곥걹??툓??ㄷ歟곥겎??굮閭㏂굙?됥굦?뗣걢?됥겎?귙굥?? *\\\\r\\\\n * 誤뗣겇?뗣굢?ゃ걨?뚣겙?ε뒟??툖?닷릦?ゃ겗?㏝퍢?ｃ겍?롩쳵?믢슴?뤵겒?꾠귛ㄷ歟곥겗?ゃ걚渦뷩겓鶯곥굮\\\\r\\\\n * 營?걦?ⓨ냵力뺡쳵?뺛걣黎뷩겲?됥걳?곲쉸遙섅겎餓ｇ뵪?쇻굦?겼ㄷ歟곥겏?띲겒?ｃ걼鶯곥굮鼇덁툓?쀣겍?쀣겲?녴? */\\\\r\\\\nfunction girderDepthAboveWall(project: Project, wall: Member): number {\\\\r\\\\n  const position = wall.position\\\\r\\\\n  if (!isGirderPosition(position)) {\\\\r\\\\n    throw new Error(`girderDepthAboveWall requires an edge position: ${wall.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const girder = project.members.find(\\\\r\\\\n    (candidate) =>\\\\r\\\\n      candidate.kind === '鸚㎪쥈' &&\\\\r\\\\n      candidate.storyId === wall.storyId &&\\\\r\\\\n      isGirderPosition(candidate.position) &&\\\\r\\\\n      candidate.position.axis === position.axis &&\\\\r\\\\n      candidate.position.ix === position.ix &&\\\\r\\\\n      candidate.position.iy === position.iy,\\\\r\\\\n  )\\\\r\\\\n\\\\r\\\\n  if (!girder) {\\\\r\\\\n    throw new Error(`Missing 鸚㎪쥈 above ?먬쐡鶯? ${wall.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const section = findSection(project, girder.sectionId)\\\\r\\\\n  if (section.kind !== '鸚㎪쥈') {\\\\r\\\\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return section.depth\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function wallSpan(project: Project, member: Member): WallSpan {\\\\r\\\\n  if (member.kind !== '?먬쐡鶯? || !isGirderPosition(member.position)) {\\\\r\\\\n    throw new Error(`wallSpan requires a ?먬쐡鶯? ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\\\r\\\\n  if (!story) {\\\\r\\\\n    throw storyNotFound(member.storyId)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const { axis, ix, iy } = member.position\\\\r\\\\n  const endIx = axis === 'X' ? ix + 1 : ix\\\\r\\\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\\\r\\\\n  const startPoint = gridPoint(project.grid, ix, iy)\\\\r\\\\n  const endPoint = gridPoint(project.grid, endIx, endIy)\\\\r\\\\n  const startSection = supportColumnSection(project, member, ix, iy, 'start')\\\\r\\\\n  const endSection = supportColumnSection(project, member, endIx, endIy, 'end')\\\\r\\\\n\\\\r\\\\n  const centerSpan =\\\\r\\\\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\\\\r\\\\n  const startFaceOffsetMm =\\\\r\\\\n    (axis === 'X' ? startSection.b : startSection.d) / 2\\\\r\\\\n  const endFaceOffsetMm = (axis === 'X' ? endSection.b : endSection.d) / 2\\\\r\\\\n  const clearLengthMm = centerSpan - startFaceOffsetMm - endFaceOffsetMm\\\\r\\\\n\\\\r\\\\n  if (clearLengthMm <= 0) {\\\\r\\\\n    throw new MemberUnsupportedError(\\\\r\\\\n      '野멩퀡訝띷닇塋?,\\\\r\\\\n      `?먬쐡鶯??끾퀡?룔걬 must be positive: ${member.id} (${clearLengthMm} mm)`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const girderDepthAboveMm = girderDepthAboveWall(project, member)\\\\r\\\\n  const clearHeightMm = story.height - girderDepthAboveMm\\\\r\\\\n\\\\r\\\\n  if (clearHeightMm <= 0) {\\\\r\\\\n    throw new MemberUnsupportedError(\\\\r\\\\n      '野멩퀡訝띷닇塋?,\\\\r\\\\n      `?먬쐡鶯??끾퀡遙섅걬 must be positive: ${member.id} ` +\\\\r\\\\n        `(?롩쳵 ${story.height} ??訝딃깿鸚㎪쥈?쎼걚 ${girderDepthAboveMm})`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    axis,\\\\r\\\\n    clearLengthMm,\\\\r\\\\n    clearHeightMm,\\\\r\\\\n    startFaceOffsetMm,\\\\r\\\\n    endFaceOffsetMm,\\\\r\\\\n    girderDepthAboveMm,\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 佯딀씮竊덀궧?⒲깣竊??쇻궎??냵力뺝?力뺛겏?곩썪渦뷩겎?쀣걨?뗥ㄷ歟곥? *\\\\r\\\\n * 翁?퐪??뙷?놅펷寧?渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲?뗦객亮녔쓲??냵力뺡깿?녴? * ?ⓨ츣?곥굥??겎?곫릍?뗣겗??싥굤??뼋?㎯겘?ゃ걦鸚㎪쥈??냵?닻씊??뼋?㎯걗?뗣귝윶?삣ㄷ歟곥겏\\\\r\\\\n * 雅뚪뇥鼇덁툓?쀣겒?꾠겗??걪??츣獰⒲걹??굚??겎?곩ㄷ歟곥걣?끾퀡?룔걬?삣즯?뚦냵力뺡깿?녴겒??겏?뚣걯壤㏂걽?? */\\\\r\\\\nexport interface SlabBay {\\\\r\\\\n  /** ?싥굤??뼋?밤깙??(mm) */\\\\r\\\\n  centerSpanXMm: number\\\\r\\\\n  centerSpanYMm: number\\\\r\\\\n  /** ?끾퀡?룔걬 (mm) ??X?밧릲??륫?담겗 Y?싥굤鸚㎪쥈??냵?닻씊??뼋 */\\\\r\\\\n  clearXMm: number\\\\r\\\\n  clearYMm: number\\\\r\\\\n  /** ?쇻궎?잏궧??졏耶먪궧?뗣굢?끾퀡?잆겗?잏궧?얇겎??퇌??(mm) 竊??쀣걨?뗥ㄷ歟곩퉭??/2 */\\\\r\\\\n  startFaceOffsetXMm: number\\\\r\\\\n  startFaceOffsetYMm: number\\\\r\\\\n  /** ?쏂씌?㎩룛?묆굥鸚㎪쥈?괱?밧릲??냵力뺛굮黎뷩굙?뗣겗??minX?팵axX竊늍?싥굤鸚㎪쥈竊됥겎?귙굥 */\\\\r\\\\n  supports: {\\\\r\\\\n    minX: SlabEdgeSupport\\\\r\\\\n    maxX: SlabEdgeSupport\\\\r\\\\n    minY: SlabEdgeSupport\\\\r\\\\n    maxY: SlabEdgeSupport\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 佯딀씮嶺뗣걣若싩??쀣겍?꾠걦?덀겗鸚㎪쥈1?с?*/\\\\r\\\\nexport interface SlabEdgeSupport {\\\\r\\\\n  memberId: string\\\\r\\\\n  /** 鸚㎪쥈??퉭 b (mm) ??佯딀씮嶺뗣겘?볝겗訝?겦若싩??쇻굥 */\\\\r\\\\n  widthMm: number\\\\r\\\\n  /** 若싩??뚨킀?얇굥?뗣겗?ㅵ츣??뵱?뱄펷鸚㎪쥈竊됥겗?뗣겤?듽겎烏뚣걝 ??佯딀씮??굚??겎??겒??*/\\\\r\\\\n  cover: Record<string, string | boolean>\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction isSlabPosition(\\\\r\\\\n  position: ColumnPosition | GirderPosition,\\\\r\\\\n): position is SlabPosition {\\\\r\\\\n  return !('axis' in position)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction girderSectionAt(\\\\r\\\\n  project: Project,\\\\r\\\\n  storyId: string,\\\\r\\\\n  axis: 'X' | 'Y',\\\\r\\\\n  ix: number,\\\\r\\\\n  iy: number,\\\\r\\\\n  requestedBy: Member,\\\\r\\\\n): { member: Member; section: GirderSection } {\\\\r\\\\n  const girder = project.members.find(\\\\r\\\\n    (candidate) =>\\\\r\\\\n      candidate.kind === '鸚㎪쥈' &&\\\\r\\\\n      candidate.storyId === storyId &&\\\\r\\\\n      isGirderPosition(candidate.position) &&\\\\r\\\\n      candidate.position.axis === axis &&\\\\r\\\\n      candidate.position.ix === ix &&\\\\r\\\\n      candidate.position.iy === iy,\\\\r\\\\n  )\\\\r\\\\n\\\\r\\\\n  // ?쏂씌??겑?뚣걢?뚧쵟?묆굥?ⓨ냵力뺛걣黎뷩겲?됥겒?꾠귡싥굤??뼋?㏛빰?ⓦ걲?뚣겙鸚㎪쥈?③뇥?ゃ겂??  // 佯딀씮?믦쮫訝듽걮?╉걮?얇걝??겎?곲퍢?ｃ겍?뗣굙?ゃ걚 ??鶯곥겗訝딃깿鸚㎪쥈?ⓨ릪?섉돮?꾠겎?귙굥??  if (!girder) {\\\\r\\\\n    throw new Error(\\\\r\\\\n      `Missing ${axis}?싥굤鸚㎪쥈 beside 佯딀씮: ${requestedBy.id} (${ix}, ${iy})`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const section = findSection(project, girder.sectionId)\\\\r\\\\n  if (section.kind !== '鸚㎪쥈') {\\\\r\\\\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return { member: girder, section }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function slabBay(project: Project, member: Member): SlabBay {\\\\r\\\\n  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\\\\r\\\\n    throw new Error(`slabBay requires a 佯딀씮: ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const { ix, iy } = member.position\\\\r\\\\n  const origin = gridPoint(project.grid, ix, iy)\\\\r\\\\n  const far = gridPoint(project.grid, ix + 1, iy + 1)\\\\r\\\\n\\\\r\\\\n  const edge = (\\\\r\\\\n    axis: 'X' | 'Y',\\\\r\\\\n    edgeIx: number,\\\\r\\\\n    edgeIy: number,\\\\r\\\\n  ): SlabEdgeSupport => {\\\\r\\\\n    const { member: girder, section } = girderSectionAt(\\\\r\\\\n      project,\\\\r\\\\n      member.storyId,\\\\r\\\\n      axis,\\\\r\\\\n      edgeIx,\\\\r\\\\n      edgeIy,\\\\r\\\\n      member,\\\\r\\\\n    )\\\\r\\\\n    return {\\\\r\\\\n      memberId: girder.id,\\\\r\\\\n      widthMm: section.b,\\\\r\\\\n      cover: coverConditions(section),\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  // X?밧릲??냵力뺛굮黎뷩굙?뗣겗??Y?싥굤竊덄를?ヨ뎔?뗰펹鸚㎪쥈??퉭?㎯걗????壅겹굥?묆걤??  // 亮끹굮歷с굥?묆걤?뚨쎍雅ㅳ걲?뗣겗?㎯곥걪?볝굮?뽧굤?뺛걟?뗣겏?끾퀡?뚦뀯?뚧쎘?뤵굥??  const supports = {\\\\r\\\\n    minX: edge('Y', ix, iy),\\\\r\\\\n    maxX: edge('Y', ix + 1, iy),\\\\r\\\\n    minY: edge('X', ix, iy),\\\\r\\\\n    maxY: edge('X', ix, iy + 1),\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const centerSpanXMm = far.x - origin.x\\\\r\\\\n  const centerSpanYMm = far.y - origin.y\\\\r\\\\n  const startFaceOffsetXMm = supports.minX.widthMm / 2\\\\r\\\\n  const startFaceOffsetYMm = supports.minY.widthMm / 2\\\\r\\\\n  const clearXMm =\\\\r\\\\n    centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\\\\r\\\\n  const clearYMm =\\\\r\\\\n    centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\\\\r\\\\n\\\\r\\\\n  if (clearXMm <= 0 || clearYMm <= 0) {\\\\r\\\\n    throw new MemberUnsupportedError(\\\\r\\\\n      '野멩퀡訝띷닇塋?,\\\\r\\\\n      `佯딀씮 ?끾퀡?룔걬 must be positive: ${member.id} ` +\\\\r\\\\n        `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    centerSpanXMm,\\\\r\\\\n    centerSpanYMm,\\\\r\\\\n    clearXMm,\\\\r\\\\n    clearYMm,\\\\r\\\\n    startFaceOffsetXMm,\\\\r\\\\n    startFaceOffsetYMm,\\\\r\\\\n    supports,\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * ?뚥???씊??틞?욍걣鸚㎪쥈?믧싥걮??ｃ겒?뗧칱?????곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞??) ?? * ?뚦릪訝??푶??말嶺뗣걣歟곥곩즯嶺됥굮?싥걮??ｇ텥?쇻굥?닷릦?띲걣?볝굦?㎯걗?뗣? *\\\\r\\\\n * 鸚㎪쥈??꺀??(girderRun) ?ⓨ릪?섇숱?졼??쇻궎?ゃ굢?룔걬1??꺀?녈겎?뚦뜕?у틞?욍띲? * 2?쇻궎餓δ툓?ゃ굢?뚪ｇ텥?쇻굥佯딀씮?띲겓?ゃ굤?곭텤?뗧츋??겹겗?→뻼??2竊덌폇竊됧틞??) ?? * ?뉎굤?욍굩?뗣괱?밧릲?쮇?밧릲?㎩닪??꺀?녈굮?곥겇 ??佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥?뗣굢?졼? */\\\\r\\\\nexport interface SlabRun {\\\\r\\\\n  axis: 'X' | 'Y'\\\\r\\\\n  /** 邕멩뼶?묆겗?뉔젂?귛뜕?у틞?욍겒?됮빓?? */\\\\r\\\\n  members: Member[]\\\\r\\\\n  /** ?싥걮嶺뗣굮躍겼콪?뺛걵?뗩깿??竊?members[0].id */\\\\r\\\\n  ownerId: string\\\\r\\\\n  /** members ?ⓨ릪?섌젂佯?*/\\\\r\\\\n  bays: SlabBay[]\\\\r\\\\n  /**\\\\r\\\\n   * ?⒲꺍?잏궧竊덂쭓塋?겗鸚㎪쥈??냵?닻씊竊됥걢?됧릢?쇻궎??냵力뺝윜??쭓?얇굤?얇겎??퇌??(mm)??   * bays ?ⓨ릪?섌젂佯뤵겎 [0] ??0 ?㎯걗?뗣?D ?뚣꺀?녈굮1?ㅳ겗?졼겓?뤵걦?ⓦ걤??   * ?꾠깧?ㅳ겗嶸긱굮?볝걪?ョ쉰?????뤹뵽?담겎擁녈걮?담걲?③뀓嶺뗣겏?싥굦?뗣?   */\\\\r\\\\n  memberOffsetsMm: number[]\\\\r\\\\n  /** ?⒲꺍??빓 (mm) 竊?誇?끾퀡?룔걬 竊?誇訝?뼋鸚㎪쥈??퉭 */\\\\r\\\\n  coreLengthMm: number\\\\r\\\\n  /** ?꿜퍡?밧릲竊덁말嶺뗣겏?답벡?쇻굥?묆걤竊됥겗?끾퀡?룔걬 (mm) ???⒲꺍?끹겎?깁싥겎?귙굥 */\\\\r\\\\n  distributionClearMm: number\\\\r\\\\n  /** 冶뗧ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\\\\r\\\\n  startSupport: SlabEdgeSupport\\\\r\\\\n  /** 永귞ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\\\\r\\\\n  endSupport: SlabEdgeSupport\\\\r\\\\n  /**\\\\r\\\\n   * ?⒲꺍?ラ뼀?꾠겍?꾠굥?뗥룭??(1?싧뎴8))??*?⒲꺍?잏궧?뗣굢??벨與?*?ョ쎍?쀣걼?귙겗??   *\\\\r\\\\n   * ?뗥룭??깧?ㅿ펷竊앶깿?먲펹?붵겏?ュ뀯?쎼걬?뚣굥?뚣곩틞?욍겗?꾤춮??꺀?녈겎歷с굥??겎??   * 轝좈솮??D??늾?딀쵟?띲굚?⒲꺍佯㎪쮽?㎬쫳?뗣귙걪?볝겎訝佯╉걽?묊쎍?쀣겍?듽걢?ゃ걚?ⓦ?   * ?곈뇧?②〃鹽뷩걣?γ끹겓?쇻궎??궕?뺛궩?껁깉?믦떨?쀧쎍?쀣겍繇잆걚?뺛걝 (ADR-029)??   */\\\\r\\\\n  openings: Opening[]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function slabRun(\\\\r\\\\n  project: Project,\\\\r\\\\n  member: Member,\\\\r\\\\n  axis: 'X' | 'Y',\\\\r\\\\n): SlabRun {\\\\r\\\\n  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\\\\r\\\\n    throw new Error(`slabRun requires a 佯딀씮: ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const { ix, iy } = member.position\\\\r\\\\n  const slabAt = (\\\\r\\\\n    candidateIx: number,\\\\r\\\\n    candidateIy: number,\\\\r\\\\n  ): Member | undefined =>\\\\r\\\\n    project.members.find(\\\\r\\\\n      (candidate) =>\\\\r\\\\n        candidate.kind === '佯딀씮' &&\\\\r\\\\n        candidate.storyId === member.storyId &&\\\\r\\\\n        // ?뚥???씊?㎯걗?뗣걪?ⓦ굮?ｇ텥??씉餓뜰겓?쇻굥?귝씉?뉎겘?뚦릪訝??푶??말嶺뗣걣?띲겏\\\\r\\\\n        // 鼇?녴걣?곩푶?뚦릪?섅겎?귙깞?껁긽?뚪걬?덀겙?③깿??뎱嶺뗣걣?싥굥?뤵걨?㎯겘?ゃ걚 ??        // ??씊?뚦릪?섅걪?ⓦ겘?앫겗?곩늽?▽뻑?㎯걗?ｃ겍?곩쎋?㏂겓?ゃ걚?ｇ텥?믢퐳?됥겒?꾠?        candidate.sectionId === member.sectionId &&\\\\r\\\\n        isSlabPosition(candidate.position) &&\\\\r\\\\n        candidate.position.ix === candidateIx &&\\\\r\\\\n        candidate.position.iy === candidateIy,\\\\r\\\\n    )\\\\r\\\\n\\\\r\\\\n  const step = (offset: number): [number, number] =>\\\\r\\\\n    axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\\\\r\\\\n\\\\r\\\\n  const members: Member[] = [member]\\\\r\\\\n  for (let offset = -1; ; offset -= 1) {\\\\r\\\\n    const previous = slabAt(...step(offset))\\\\r\\\\n    if (!previous) break\\\\r\\\\n    members.unshift(previous)\\\\r\\\\n  }\\\\r\\\\n  for (let offset = 1; ; offset += 1) {\\\\r\\\\n    const next = slabAt(...step(offset))\\\\r\\\\n    if (!next) break\\\\r\\\\n    members.push(next)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const bays = members.map((candidate) => slabBay(project, candidate))\\\\r\\\\n  const clearAlong = (bay: SlabBay): number =>\\\\r\\\\n    axis === 'X' ? bay.clearXMm : bay.clearYMm\\\\r\\\\n  const clearAcross = (bay: SlabBay): number =>\\\\r\\\\n    axis === 'X' ? bay.clearYMm : bay.clearXMm\\\\r\\\\n\\\\r\\\\n  // ?꿜퍡?ф빊??1?싧뎴7) ?뚣뚣걹??깿?녴겗?룔걬?띲굮?꾤춮??뼋?붵겎?ㅳ걮??콆?곥굥1?ㅳ겗?겹걽??  // ?⒲꺍??붶릎?㎫쎍雅ㅶ뼶?묆겗?끾퀡?뚦쨯?뤵굦?겹곥걹???ㅳ겗?겹걣?⒲걾?됥겗?쇻궎?㎯굚閭ｃ걮??  // ?ゃ굢?ゃ걚 ??訝?ⓦ걽?묌싥굥?꾤춮?믦＝?곥걣烏①뤎?㎯걤?ゃ걚??겎?곦퐳?됥걳?ヨ맼?ⓦ걲??  const distributionClearMm = clearAcross(bays[0])\\\\r\\\\n  const uneven = bays.findIndex(\\\\r\\\\n    (bay) => clearAcross(bay) !== distributionClearMm,\\\\r\\\\n  )\\\\r\\\\n  if (uneven > 0) {\\\\r\\\\n    throw new MemberUnsupportedError(\\\\r\\\\n      '野멩퀡訝띷닇塋?,\\\\r\\\\n      `佯딀씮?⒲꺍?끹겎?꿜퍡?밧릲??냵力뺡빓?뺛걣?껁굩?ゃ걚: ${members[0].id} ` +\\\\r\\\\n        `(${distributionClearMm} mm) ??${members[uneven].id} ` +\\\\r\\\\n        `(${clearAcross(bays[uneven])} mm)`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  // 訝?뼋鸚㎪쥈??퉭??뚦퉭??/2?띲걣訝▼겢?뗣굢?γ겍1?у늽?ャ겒????2竊덌폇竊됧틞??) ??  // 鵝녷쎑?뚣걹?녶츣?곥굥?귛ㄷ歟곥겗?⒲꺍??빓?뚥릎?볠윶?쎼걚?믦떨?쇻겗?ⓨ릪?섇숱?졼?  // ?쇻궎??쭓?얇굤?믢?佯╉걽?묊눕令띲걮?곫?孃뚣겗?쇻궎??쭓?얇굤 竊??앫겗?끾퀡?믦뒸?룔겏?쇻굥 ??  // 雅뚣겇?믣닪?끹겓?겹걟?뗣겏?쇻걧繇잆걚?뺛걝竊덂ㄷ歟곥겗?⒲꺍?ⓨ릪?섊큵?잞펹??  const memberOffsetsMm: number[] = []\\\\r\\\\n  let offsetMm = 0\\\\r\\\\n  for (const bay of bays) {\\\\r\\\\n    memberOffsetsMm.push(offsetMm)\\\\r\\\\n    offsetMm +=\\\\r\\\\n      clearAlong(bay) +\\\\r\\\\n      (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\\\\r\\\\n  }\\\\r\\\\n  const coreLengthMm =\\\\r\\\\n    memberOffsetsMm[memberOffsetsMm.length - 1] +\\\\r\\\\n    clearAlong(bays[bays.length - 1])\\\\r\\\\n\\\\r\\\\n  const first = bays[0]\\\\r\\\\n  const last = bays[bays.length - 1]\\\\r\\\\n\\\\r\\\\n  // ?쇻궎掠???뼀?ｃ굮?⒲꺍佯㎪쮽?며㎉?쇻귟뎔?뗥릲?띲겓?졼걨?쇻궎??궕?뺛궩?껁깉?뚥퉿????  // ?답벡?밧릲??냵力뺛겘?⒲꺍?끹겎?깁싥겒??겎竊덁툓?㎯걹?뚣굮濾쒏읅?쀣겍?꾠굥竊됥걹??겲?얇걽??  const openings = members.flatMap((candidate, index) =>\\\\r\\\\n    (candidate.openings ?? []).map((opening) => ({\\\\r\\\\n      ...opening,\\\\r\\\\n      xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\\\\r\\\\n      yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\\\\r\\\\n    })),\\\\r\\\\n  )\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    axis,\\\\r\\\\n    members,\\\\r\\\\n    ownerId: members[0].id,\\\\r\\\\n    bays,\\\\r\\\\n    memberOffsetsMm,\\\\r\\\\n    coreLengthMm,\\\\r\\\\n    distributionClearMm,\\\\r\\\\n    startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\\\\r\\\\n    endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\\\\r\\\\n    openings,\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface GirderRun {\\\\r\\\\n  axis: 'X' | 'Y'\\\\r\\\\n  /** 異뺣갑???ㅻ쫫李⑥닚. ?⑥씪 ?ㅽ뙩?대㈃ 湲몄씠 1 */\\\\r\\\\n  members: Member[]\\\\r\\\\n  /** ?싥걮嶺뗭쓣 洹?띿떆??遺??= members[0].id */\\\\r\\\\n  ownerId: string\\\\r\\\\n  /** members? 媛숈? ?쒖꽌 */\\\\r\\\\n  spans: GirderSpan[]\\\\r\\\\n  /**\\\\r\\\\n   * ???먯젏(?쒖옉 ?긱겗?끻겢???먯꽌 媛??ㅽ뙩 ?쒖옉硫닿퉴吏??嫄곕━ (mm). members? 媛숈?\\\\r\\\\n   * ?쒖꽌?닿퀬 [0]? 0?대떎.\\\\r\\\\n   *\\\\r\\\\n   * ?싥걮嶺뗭? ???꾩껜瑜????꾨젅?꾩뿉 ???留??귙겙?됬춮? 媛?遺???먭린 ?ㅽ뙩 濡쒖뺄(0 湲곗?)\\\\r\\\\n   * ?대떎. ?곗쓣 ???꾨젅?꾩뿉 洹몃━??履쎌씠 ???ㅽ봽?뗭쓣 紐⑤Ⅴ硫?2踰덉㎏ ?댄썑 ?ㅽ뙩??   * ?귙겙?됬춮??1踰덉㎏ ?ㅽ뙩 ?꾩뿉 寃뱀튇??\\\\r\\\\n   */\\\\r\\\\n  memberOffsetsMm: number[]\\\\r\\\\n  /** ?싥걮嶺?肄붿뼱 湲몄씠 (mm) = 誇?끾퀡 竊?誇訝?뼋?긱겗邕멩뼶?묆걵??*/\\\\r\\\\n  coreLengthMm: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction girderAxisIndex(position: GirderPosition): number {\\\\r\\\\n  return position.axis === 'X' ? position.ix : position.iy\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function girderRun(project: Project, member: Member): GirderRun {\\\\r\\\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\\\r\\\\n    throw new Error(`girderRun requires a 鸚㎪쥈: ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const position = member.position\\\\r\\\\n  const candidates = project.members\\\\r\\\\n    .filter((candidate) => {\\\\r\\\\n      if (\\\\r\\\\n        candidate.kind !== '鸚㎪쥈' ||\\\\r\\\\n        candidate.storyId !== member.storyId ||\\\\r\\\\n        !isGirderPosition(candidate.position) ||\\\\r\\\\n        candidate.position.axis !== position.axis\\\\r\\\\n      ) {\\\\r\\\\n        return false\\\\r\\\\n      }\\\\r\\\\n\\\\r\\\\n      return position.axis === 'X'\\\\r\\\\n        ? candidate.position.iy === position.iy\\\\r\\\\n        : candidate.position.ix === position.ix\\\\r\\\\n    })\\\\r\\\\n    .sort((left, right) => {\\\\r\\\\n      if (!isGirderPosition(left.position) || !isGirderPosition(right.position)) {\\\\r\\\\n        throw new Error('鸚㎪쥈 run contains a non-girder position')\\\\r\\\\n      }\\\\r\\\\n      return girderAxisIndex(left.position) - girderAxisIndex(right.position)\\\\r\\\\n    })\\\\r\\\\n  const memberIndex = candidates.findIndex(({ id }) => id === member.id)\\\\r\\\\n\\\\r\\\\n  if (memberIndex < 0) {\\\\r\\\\n    throw new Error(`鸚㎪쥈 member not found in project: ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  let first = memberIndex\\\\r\\\\n  let last = memberIndex\\\\r\\\\n  while (\\\\r\\\\n    first > 0 &&\\\\r\\\\n    girderAxisIndex(candidates[first - 1].position as GirderPosition) ===\\\\r\\\\n      girderAxisIndex(candidates[first].position as GirderPosition) - 1\\\\r\\\\n  ) {\\\\r\\\\n    first -= 1\\\\r\\\\n  }\\\\r\\\\n  while (\\\\r\\\\n    last + 1 < candidates.length &&\\\\r\\\\n    girderAxisIndex(candidates[last + 1].position as GirderPosition) ===\\\\r\\\\n      girderAxisIndex(candidates[last].position as GirderPosition) + 1\\\\r\\\\n  ) {\\\\r\\\\n    last += 1\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const members = candidates.slice(first, last + 1)\\\\r\\\\n  const sectionId = members[0].sectionId\\\\r\\\\n  if (members.some((candidate) => candidate.sectionId !== sectionId)) {\\\\r\\\\n    throw new Error(\\\\r\\\\n      `鸚㎪쥈 run contains mixed sections: ${members.map(({ id, sectionId: idOfSection }) => `${id}:${idOfSection}`).join(', ')}`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const spans = members.map((candidate) => girderSpan(project, candidate))\\\\r\\\\n  // ?ㅽ뙩 ?쒖옉硫대뱾???꾩쟻 ?꾩튂. 留덉?留??ㅽ뙩 ?쒖옉硫?竊?洹??끾퀡??肄붿뼱 湲몄씠????  // ??媛믪쓣 ?곕줈 ?몃㈃ 怨??닿툔?섎?濡???踰덈쭔 ?꾩쟻?쒕떎.\\\\r\\\\n  const memberOffsetsMm: number[] = []\\\\r\\\\n  let offsetMm = 0\\\\r\\\\n  for (const span of spans) {\\\\r\\\\n    memberOffsetsMm.push(offsetMm)\\\\r\\\\n    offsetMm += span.clear + span.endSupportLengthAlongAxisMm\\\\r\\\\n  }\\\\r\\\\n  const lastSpan = spans[spans.length - 1]\\\\r\\\\n  const coreLengthMm =\\\\r\\\\n    memberOffsetsMm[memberOffsetsMm.length - 1] + lastSpan.clear\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    axis: position.axis,\\\\r\\\\n    members,\\\\r\\\\n    ownerId: members[0].id,\\\\r\\\\n    spans,\\\\r\\\\n    memberOffsetsMm,\\\\r\\\\n    coreLengthMm,\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * ?긴말嶺뗣겗塋?깿?▽뻑 (R7?졼꺕R9???? *\\\\r\\\\n * 若싩?(bottom)? ?ㅽ깮??**理쒗븯??*(湲곗큹)?먮쭔 遺숇뒗?? 訝?뼋 ?묓빀遺??泥좉렐?? * 洹몃?濡?吏?섍?誘濡??ゃ걮??\\\\r\\\\n *\\\\r\\\\n * top? 若싩???遺숈씠吏 ?딅뒗??????긽 ?ゃ걮(以묎컙 ?묓빀遺, ?꾩링?쇰줈 ?듦낵) ?꾨땲硫? * ?덄ク(?ㅽ깮 理쒖긽?? ?꾩뿉 ?깃? ?놁쓬)?대떎. ?곈뇧令띸츞?뷸틬 1?싧뎴1)?뚦뀍塋?겎閭㏂겲?? * ?꾤춮??곥궠?녈궚?ゃ꺖?덀겗鼇?쮫野멩퀡?믡걹??깿?녴겗?꾤춮??빓?뺛겏?쇻굥?랃펻竊덌폃竊됪윶1)\\\\r\\\\n * 鵝녷쎑?뚧?訝딃쉸?긱겗訝사춮?ャ겇?꾠겍??곻폂?싧뎴竊묕펹?ャ굠?뗣띻? ?訝딃쉸?긴말嶺뗭쓣 紐낆떆?곸쑝濡? * 1?싧뎴1)??嫄몄뼱?먮?濡? ?ㅽ깮 理쒖긽?⑥? 若싩? ?놁씠 肄섑겕由ы듃 ?ㅺ퀎 移섏닔源뚯?留? * 媛꾨떎(R9??. ?댁쟾?먮뒗 ?ㅽ깮 理쒖긽?⑥뿉??若싩???遺숈??붾뜲, ?대뒗 議곕Ц怨??닿툔?щ떎.\\\\r\\\\n *\\\\r\\\\n * ?묓빀遺??**泳숁뎸???ш린???ㅻ（吏 ?딅뒗??** ?곈뇧令띸츞?뷸틬 2竊덌폃竊됪윶2)媛\\\\r\\\\n * ?뚦릢?롦윶??뀲?룔겓?뤵걼?뗤말嶺뗣겓?ㅳ걚?╉겘?꾦쉸?붵겏???뗦??띾줈 ?뺥븯誘濡?痢듬쭏?? * 議곕Ц?濡?1?뗦??닿퀬, 洹?諛곕텇???쒗뭹???뺥븷 ?ъ?媛 ?녿떎. ?덉쟾?먮뒗 ?묓빀遺?? * 泳숁뎸瑜??꾩링 遺?ъ뿉 洹?띿떆?ㅻ뒗 愿?됱쓣 肄붾뱶媛 ?ㅺ퀬 ?덉뿀?붾뜲(洹몃옒??理쒗븯痢듭?\\\\r\\\\n * 泳숁뎸媛 0?댁뿀??, 議곕Ц??洹??먮━瑜???좏븳??\\\\r\\\\n *\\\\r\\\\n * ?ㅽ깮 ?쒖꽌??`stories` 諛곗뿴 ?쒖꽌瑜?洹몃?濡??좊ː?쒕떎 ??Story???덈꺼 媛믪씠 ?녿떎.\\\\r\\\\n */\\\\r\\\\nexport interface ColumnEnds {\\\\r\\\\n  bottom: '若싩?' | '?ゃ걮'\\\\r\\\\n  top: '?ゃ걮' | '?덄ク'\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function columnEnds(project: Project, member: Member): ColumnEnds {\\\\r\\\\n  const { position } = member\\\\r\\\\n\\\\r\\\\n  if (member.kind !== '?? || !isColumnPosition(position)) {\\\\r\\\\n    throw new Error(`columnEnds requires a ?? ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const level = project.stories.findIndex(({ id }) => id === member.storyId)\\\\r\\\\n  if (level < 0) {\\\\r\\\\n    throw storyNotFound(member.storyId)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const hasColumnAtLevel = (candidateLevel: number): boolean => {\\\\r\\\\n    const story = project.stories[candidateLevel]\\\\r\\\\n    if (story === undefined) return false\\\\r\\\\n\\\\r\\\\n    return project.members.some(\\\\r\\\\n      (candidate) =>\\\\r\\\\n        candidate.kind === '?? &&\\\\r\\\\n        candidate.storyId === story.id &&\\\\r\\\\n        isColumnPosition(candidate.position) &&\\\\r\\\\n        candidate.position.ix === position.ix &&\\\\r\\\\n        candidate.position.iy === position.iy,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    bottom: hasColumnAtLevel(level - 1) ? '?ゃ걮' : '若싩?',\\\\r\\\\n    top: hasColumnAtLevel(level + 1) ? '?ゃ걮' : '?덄ク',\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function beamDepthAbove(project: Project, member: Member): number {\\\\r\\\\n  if (member.kind !== '?? || !isColumnPosition(member.position)) {\\\\r\\\\n    throw new Error(`beamDepthAbove requires a ?? ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const depths = project.members\\\\r\\\\n    .filter(\\\\r\\\\n      (candidate) =>\\\\r\\\\n        candidate.kind === '鸚㎪쥈' &&\\\\r\\\\n        candidate.storyId === member.storyId &&\\\\r\\\\n        isGirderPosition(candidate.position) &&\\\\r\\\\n        touchesColumn(candidate.position, member.position),\\\\r\\\\n    )\\\\r\\\\n    .map((girder) => {\\\\r\\\\n      const section = findSection(project, girder.sectionId)\\\\r\\\\n      if (section.kind !== '鸚㎪쥈') {\\\\r\\\\n        throw new Error(\\\\r\\\\n          `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`,\\\\r\\\\n        )\\\\r\\\\n      }\\\\r\\\\n      return section.depth\\\\r\\\\n    })\\\\r\\\\n\\\\r\\\\n  if (depths.length === 0) {\\\\r\\\\n    throw new Error(`No touching 鸚㎪쥈 found above ?? ${member.id}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return Math.max(...depths)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function setNote(\\\\r\\\\n  project: Project,\\\\r\\\\n  lineId: string,\\\\r\\\\n  note: string,\\\\r\\\\n): Project {\\\\r\\\\n  const notes = { ...project.notes }\\\\r\\\\n\\\\r\\\\n  if (note === '') delete notes[lineId]\\\\r\\\\n  else notes[lineId] = note\\\\r\\\\n\\\\r\\\\n  return { ...project, notes }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 鍮??낅젰? ?ㅻ? 吏?대떎 ??0 kg/m???낅젰???꾨땲???녿뒗 媛믪씠?? */\\\\r\\\\nexport function setUnitMass(\\\\r\\\\n  project: Project,\\\\r\\\\n  size: ShearBarSize,\\\\r\\\\n  value: number | null,\\\\r\\\\n): Project {\\\\r\\\\n  const unitMass = { ...project.unitMass }\\\\r\\\\n\\\\r\\\\n  if (value === null) delete unitMass[size]\\\\r\\\\n  else unitMass[size] = value\\\\r\\\\n\\\\r\\\\n  return { ...project, unitMass }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function serializeProject(project: Project): string {\\\\r\\\\n  return JSON.stringify(project)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nconst isString = (value: unknown): boolean => typeof value === 'string'\\\\r\\\\n\\\\r\\\\nconst isFiniteNumber = (value: unknown): boolean =>\\\\r\\\\n  typeof value === 'number' && Number.isFinite(value)\\\\r\\\\n\\\\r\\\\nfunction isRecord(value: unknown): value is Record<string, unknown> {\\\\r\\\\n  return typeof value === 'object' && value !== null && !Array.isArray(value)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction hasShape(\\\\r\\\\n  value: unknown,\\\\r\\\\n  fields: Record<string, (field: unknown) => boolean>,\\\\r\\\\n): boolean {\\\\r\\\\n  return (\\\\r\\\\n    isRecord(value) &&\\\\r\\\\n    Object.entries(fields).every(([key, check]) => check(value[key]))\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nconst isNumberArray = (value: unknown): boolean =>\\\\r\\\\n  Array.isArray(value) && value.every(isFiniteNumber)\\\\r\\\\n\\\\r\\\\n/** ?쇈겞?랃펻?ф빊??굠?녴겒弱뤵걬?ょ탡?믤쩂?곥굥??*/\\\\r\\\\nconst shapedAs =\\\\r\\\\n  (fields: Record<string, (field: unknown) => boolean>) =>\\\\r\\\\n  (value: unknown): boolean =>\\\\r\\\\n    hasShape(value, fields)\\\\r\\\\n\\\\r\\\\nconst isMainRow = shapedAs({\\\\r\\\\n  endCount: isFiniteNumber,\\\\r\\\\n  centerCount: isFiniteNumber,\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\nconst isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 葉?닪?붵겏?ャ?*?뽧굤渦쇈굯?좂쎍孃뚣겗鼇덄츞?뚩쫳若덀굤?ゃ걮?ュ뢿?㎯걲??*?담걽?묆굮訝╉겧?뗣? *\\\\r\\\\n * ?볝걪?ョ꽒?꾢졃 (fc?팮rade?팫xposure?퍀pliceMethod ?ゃ겑) ??곫쵟?묆겍?귙꺂?쇈꺂?묆긿?? * 凉뺛걤?뚦릫?띲겗?귙굥堊뗥쨼?㎪??곥굥 ???⒲걪?㏛퐬?뚩떨?듽겒?꾠걢?뚨뵽?㏂겓?뷩굥?? * ?멥굯?㎯걗?뗣겗??TypeError ?ャ겒?뗥졃 ???앫굦?졼걨?뚣뚥퐬?뚩돈?띲걼?뗨??덀겒?꾥맼?→뼶?띲굮?쇻굥?? */\\\\r\\\\nconst isBarRow = shapedAs({\\\\r\\\\n  size: isString,\\\\r\\\\n  pitch: isFiniteNumber,\\\\r\\\\n  startOffsetMm: isFiniteNumber,\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 野멩퀡??뜷??Ŧ?γ겎?뺛걝?귝윶?삣ㄷ歟곥겘 b ?ⓦ걵?꾠걽?뚣곮먬쐡鶯곥꺕佯딀씮??thickness 訝?? * ????翁?퐪??뙷?녴걣鶯곥굮?뚦냵力뺡깿?녴띲곩틞?욍굮?뚦냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲빓?뺛겘\\\\r\\\\n * 鵝띸쉰?③슔??깿?먦걢?됧눣??뼪?㏂겓??꽒??(ADR-025?틻DR-028)?귛뀻?싥겗?닸???b ?? * 黎귙굙?뗣겏?곫??쀣걚鶯곥겗鼇섌뙯?뚦숱?뺛걚?ⓦ걮??센?뗣굦?뗣? */\\\\r\\\\nconst SECTION_FIELDS: Record<\\\\r\\\\n  MemberKind,\\\\r\\\\n  Record<string, (field: unknown) => boolean>\\\\r\\\\n> = {\\\\r\\\\n  ?? {\\\\r\\\\n    b: isFiniteNumber,\\\\r\\\\n    d: isFiniteNumber,\\\\r\\\\n    main: shapedAs({ size: isString, count: isFiniteNumber }),\\\\r\\\\n    hoop: isBarRow,\\\\r\\\\n  },\\\\r\\\\n  鸚㎪쥈: {\\\\r\\\\n    b: isFiniteNumber,\\\\r\\\\n    depth: isFiniteNumber,\\\\r\\\\n    main: shapedAs({\\\\r\\\\n      size: isString,\\\\r\\\\n      top: isMainRow,\\\\r\\\\n      bottom: isMainRow,\\\\r\\\\n      cutoffFromSupportFaceMm: isFiniteNumber,\\\\r\\\\n    }),\\\\r\\\\n    stirrup: isBarRow,\\\\r\\\\n  },\\\\r\\\\n  ?먬쐡鶯? {\\\\r\\\\n    thickness: isFiniteNumber,\\\\r\\\\n    // 掠ㅶ빊??걹??겲?얏쑍?겹겗?띸럤?졼귝쵟?묆굥?①를嶺뗣꺕與ょ춮??쑍?겹걣 NaN ?ャ겒?뗣?    layers: isFiniteNumber,\\\\r\\\\n    vertical: isBarRow,\\\\r\\\\n    horizontal: isBarRow,\\\\r\\\\n  },\\\\r\\\\n  佯딀씮: {\\\\r\\\\n    thickness: isFiniteNumber,\\\\r\\\\n    x: shapedAs({ top: isBarRow, bottom: isBarRow }),\\\\r\\\\n    y: shapedAs({ top: isBarRow, bottom: isBarRow }),\\\\r\\\\n  },\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 鵝띸쉰??숱?귞Ŧ?γ겎?뺛걝?귛틞?욍겘?쇔춴?밤겎??겒??*?쇻궎**?믤뙁?쇻겗??(ix, iy) ?? * (ix+1, iy+1) ??륫?밤굮凉뺛걦 ??壤㏂겘?긱겏?뚣걯?㎯굚?뤷뫑?뚪걬?녴? */\\\\r\\\\nconst POSITION_FIELDS: Record<\\\\r\\\\n  MemberKind,\\\\r\\\\n  Record<string, (field: unknown) => boolean>\\\\r\\\\n> = {\\\\r\\\\n  ?? { ix: isFiniteNumber, iy: isFiniteNumber },\\\\r\\\\n  鸚㎪쥈: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\\\\r\\\\n  ?먬쐡鶯? { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\\\\r\\\\n  佯딀씮: { ix: isFiniteNumber, iy: isFiniteNumber },\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nconst isOpening = shapedAs({\\\\r\\\\n  id: isString,\\\\r\\\\n  xMm: isFiniteNumber,\\\\r\\\\n  yMm: isFiniteNumber,\\\\r\\\\n  widthMm: isFiniteNumber,\\\\r\\\\n  heightMm: isFiniteNumber,\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\nconst isMemberKind = (value: unknown): boolean =>\\\\r\\\\n  MEMBER_KINDS.includes(value as MemberKind)\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 謠ⓩ졏?졼걨?믤쩂?곥굥?귛룚?딂씔?旅덁뻑??퍟雅뷩걣鵝쒌겂?잍뻼耶쀥닓?㎯걌chemaVersion ?쀣걢\\\\r\\\\n * 誤뗣걳?ラ싥걲?ⓨ숱??걬??JSON ??Project ?ⓦ걮??ⅴ?얇겎?γ굥 ???곈뇧??NaN ?ャ겒?뗣걢\\\\r\\\\n * ?삯씊?뚩맼?▲굥?뗣겎?곥겑?▲굢?귙뚩き?욤씔?곥겒?뗣겂?잆띲굠?딀궕?꾠? *\\\\r\\\\n * 濾쒌굙?뗣겗??＝?곥걣?쇻걧曆삣춻?믣폊?뤷졃? (stories?팵embers?퍀ections?팮rid) ?ⓦ? * ?낁㉢?멥겗?삠꺂?ャ걹??겲?얍눣?뗦뻼耶쀥닓?졼걨?졼귛ㅳ겗倻ε퐪??(孃꾠걣若잌쑉?쇻굥?뗣? * ?ф빊?뚧??? ??걪?볝겎??쫳?ゃ걚 ???앫굦??뼪?㏘?誤㎯겗?ε뒟濾쒏읅??똻?▼졃?㎯? * ?볝걪?㏛틠?띲겓?곥겇?②쫸繹뽧걣雅뚣걢??ュ늽?뗣굦?뗣? */\\\\r\\\\n/**\\\\r\\\\n * 壤㏂걽?묌싥겂?╊릎翁ャ겗?귞뀱?뚦늾?뚣겍?꾠굥鼇섌뙯?믣늾?뗣? *\\\\r\\\\n * ?볝걪?㎬쫳?ゃ걚?ⓦ곩풄?뗣굢?뤹뵽??붶릎?㎬맼?▲굥 ??useProjectPersistence ?? * catch ??loadProject ?뚩㏄?ｃ걼? (??앫겗?? ?쀣걢誤뗣겒?꾠겗?㎯곩ㄷ歟곥겗??씊?? * 轝졼걨?╉걚?뗨쮼?꿔겘?앫걪?믥킔?싥굤?쀣겍 PaneBoundary ?ュ눣?뗣? */\\\\r\\\\ninterface ReferencedPosition {\\\\r\\\\n  axis?: 'X' | 'Y'\\\\r\\\\n  ix: number\\\\r\\\\n  iy: number\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction hasIntactReferences(\\\\r\\\\n  grid: Grid,\\\\r\\\\n  sections: { id: string; kind: MemberKind }[],\\\\r\\\\n  stories: { id: string }[],\\\\r\\\\n  members: {\\\\r\\\\n    kind: MemberKind\\\\r\\\\n    sectionId: string\\\\r\\\\n    storyId: string\\\\r\\\\n    position: ReferencedPosition\\\\r\\\\n  }[],\\\\r\\\\n): boolean {\\\\r\\\\n  const sectionKinds = new Map(sections.map(({ id, kind }) => [id, kind]))\\\\r\\\\n  const storyIds = new Set(stories.map(({ id }) => id))\\\\r\\\\n  const { nx, ny } = gridPointCount(grid)\\\\r\\\\n\\\\r\\\\n  // 鸚㎪쥈?삭먬쐡鶯곥겘?ｃ겗雅ㅷ궧?얇겎鴉멥겞?뗣겗?㎯곥걹??뻗?졼걨訝?ㅶ뎸?띲겲?㎯걽?귛틞?욍겘\\\\r\\\\n  // ?쇻궎?ゃ겗?㏛륫邕멥겏?귚??ㅶ뎸????slabBay ??(ix+1, iy+1) ?믣폊?뤵?  const inGrid = (\\\\r\\\\n    kind: MemberKind,\\\\r\\\\n    { axis, ix, iy }: ReferencedPosition,\\\\r\\\\n  ): boolean => {\\\\r\\\\n    const spansX = kind === '佯딀씮' || axis === 'X'\\\\r\\\\n    const spansY = kind === '佯딀씮' || axis === 'Y'\\\\r\\\\n\\\\r\\\\n    return (\\\\r\\\\n      Number.isInteger(ix) &&\\\\r\\\\n      Number.isInteger(iy) &&\\\\r\\\\n      ix >= 0 &&\\\\r\\\\n      iy >= 0 &&\\\\r\\\\n      ix < nx - (spansX ? 1 : 0) &&\\\\r\\\\n      iy < ny - (spansY ? 1 : 0)\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return members.every(\\\\r\\\\n    (member) =>\\\\r\\\\n      // 葉?닪?뺛걚?귛늾?뗣귛ㄷ歟곥걣?긱겗??씊?믤뙁?쇻겏 buildingLayout ?뚧뒘?믡굥??      sectionKinds.get(member.sectionId) === member.kind &&\\\\r\\\\n      storyIds.has(member.storyId) &&\\\\r\\\\n      // ?겹꺁?껁깋??쨼?믤뙁?쇾퐤營?겘 gridPoint ??RangeError ?㎪뒘?믡곩뀲?싥궎?녈걣?썬걾?뗣?      // ?앫겗旅덁뻑?믦눎?뺜퓷耶섅걣?멥걦??겎?곫А??Ø?뤵겎?귛릪?섉??㎬맼?▲굥??      inGrid(member.kind, member.position),\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction hasGridLabels(grid: unknown): boolean {\\\\r\\\\n  if (!isRecord(grid)) return false\\\\r\\\\n  const { xSpans, ySpans, xLabels, yLabels } = grid\\\\r\\\\n  if (!Array.isArray(xSpans) || !Array.isArray(ySpans)) return false\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    (xLabels === undefined || isGridLabels(xLabels, xSpans.length)) &&\\\\r\\\\n    (yLabels === undefined || isGridLabels(yLabels, ySpans.length))\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction isProjectShape(value: unknown): boolean {\\\\r\\\\n  if (!isRecord(value)) return false\\\\r\\\\n\\\\r\\\\n  const { stories, sections, members, notes, unitMass } = value\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    isString(value.name) &&\\\\r\\\\n    hasShape(value.grid, { xSpans: isNumberArray, ySpans: isNumberArray }) &&\\\\r\\\\n    // ?쇰꺼? ?놁뼱???섏?留? ?덉쑝硫?異뺤쓽 蹂몄닔? 留욎븘???쒕떎 ???닿툔??諛곗뿴?\\\\r\\\\n    // ?뚯뼱???싥굤??쓽 ?대쫫?멸??띾? ?껋? 湲곕줉?닿퀬, 洹몃?濡??먮㈃ ?붾㈃???됰슧??    // 異뺤뿉 ?대쫫??遺숈씤??    hasGridLabels(value.grid) &&\\\\r\\\\n    // 令뷩겗 stories ??뚪쉸?뚨꽒?꾣죭餓뜰띲겎??겒?뤷즸?뚣걼鼇섌뙯?졼귟＝?곥겘?녈굥???    // stories[0] ?믤뿢若싧ㅳ겓鵝욍걝??    Array.isArray(stories) &&\\\\r\\\\n    stories.length > 0 &&\\\\r\\\\n    stories.every((story) =>\\\\r\\\\n      hasShape(story, { id: isString, name: isString, height: isFiniteNumber }),\\\\r\\\\n    ) &&\\\\r\\\\n    Array.isArray(sections) &&\\\\r\\\\n    sections.every(\\\\r\\\\n      (section) =>\\\\r\\\\n        hasShape(section, {\\\\r\\\\n          id: isString,\\\\r\\\\n          // ?ㅵ닪耶먦겘?밧닪?졼귙걪?볝걣 union ??쨼??ㅳ걽?ⓦ곩숱??싥겂?잆겲??          // ??씊??옗?녴걢?뚣걣?멥겧?싥곭츞若싥겗?붶릎?㎬맼?▲굥??          kind: isMemberKind,\\\\r\\\\n          mark: isString,\\\\r\\\\n        }) &&\\\\r\\\\n        // ?쎼걚?귡뀓嶺뗣겗?ε뒟?귞Ŧ?γ겎?듐걣?뺛걝?귛뀻?싥겗?닸??졼걨?㎪툑?얇걵?뗣겏??        // ?쎼걚 ??쵟?묆걼??씊?뚪싥겂??릭嶺뗣겗?졾램野멩퀡??NaN ??겲?얍냵鼇녔쎑??릦鼇덀겲??        // 役곥굦?걅ain/hoop/stirrup ??쵟?묆걼??씊??generateColumnRebar ??릎??        // TypeError ?ャ겒?뗢붵겑?▲굢?귙걪??뼟?겹걣閭㏂굙?잆걢?ｃ걼永먩옖?앫겗?귙겗?졼?        // ?앫굮?멥겧?뗣겗??툓?㎩닩?ε춴?믤쩂?곥겍?귙굥?뗣굢?졼?        hasShape(section, SECTION_FIELDS[(section as Section).kind]),\\\\r\\\\n    ) &&\\\\r\\\\n    Array.isArray(members) &&\\\\r\\\\n    members.every(\\\\r\\\\n      (member) =>\\\\r\\\\n        hasShape(member, {\\\\r\\\\n          id: isString,\\\\r\\\\n          kind: isMemberKind,\\\\r\\\\n          sectionId: isString,\\\\r\\\\n          storyId: isString,\\\\r\\\\n        }) &&\\\\r\\\\n        // position ?뚨꽒?묆굦??buildingLayout ??`'axis' in member.position` ??        // ?앫겗?담겎 TypeError ?ャ겒?뗣귟뻗??'X'/'Y' 餓ε쨼?믧싥걬?ゃ걚 ??        // 訝됮쟿轢붺츞耶먦겎 Y ?ヨ맼?▲겍?곩쎋?㏂겓?▲걚?묆걤??ㄷ歟곥굮容쇻겂?╊퐳?뗣?        hasShape(member, {\\\\r\\\\n          position: shapedAs(POSITION_FIELDS[(member as Member).kind]),\\\\r\\\\n        }) &&\\\\r\\\\n        // ?뗥룭??꽒?뤵겍?덀걚 (?뚪뼀?ｃ겒?쀣띲겗?? ?뚣곫쐣?뗣겒?됮뀓?쀣겎?ゃ걨?뚣겙\\\\r\\\\n        // ?ゃ굢?ゃ걚 ??openingDeduction ?뚥릎?믦き?볝겎轝좈솮?뤵굮?뷩걲?뗣굢?졼?        ((member as { openings?: unknown }).openings === undefined ||\\\\r\\\\n          (Array.isArray((member as { openings?: unknown }).openings) &&\\\\r\\\\n            ((member as { openings: unknown[] }).openings).every(isOpening))),\\\\r\\\\n    ) &&\\\\r\\\\n    (notes === undefined ||\\\\r\\\\n      (isRecord(notes) && Object.values(notes).every(isString))) &&\\\\r\\\\n    (unitMass === undefined ||\\\\r\\\\n      (isRecord(unitMass) && Object.values(unitMass).every(isFiniteNumber))) &&\\\\r\\\\n    // ?볝걪?얇겎??3 ?ㅳ겗?띶닓??숱?뚧툑?볝겎?꾠굥?귝츐?뗣겗??틨?꾠겗?뉎걮?덀걚?졼?    hasIntactReferences(\\\\r\\\\n      value.grid as Grid,\\\\r\\\\n      sections as { id: string; kind: MemberKind }[],\\\\r\\\\n      stories as { id: string }[],\\\\r\\\\n      members as {\\\\r\\\\n        kind: MemberKind\\\\r\\\\n        sectionId: string\\\\r\\\\n        storyId: string\\\\r\\\\n        position: ReferencedPosition\\\\r\\\\n      }[],\\\\r\\\\n    )\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function deserializeProject(json: string): Project {\\\\r\\\\n  const parsed: unknown = JSON.parse(json)\\\\r\\\\n\\\\r\\\\n  if (\\\\r\\\\n    typeof parsed !== 'object' ||\\\\r\\\\n    parsed === null ||\\\\r\\\\n    !('schemaVersion' in parsed) ||\\\\r\\\\n    parsed.schemaVersion !== PROJECT_SCHEMA_VERSION\\\\r\\\\n  ) {\\\\r\\\\n    throw new Error(\\\\r\\\\n      `Unsupported Project schemaVersion; expected ${PROJECT_SCHEMA_VERSION}`,\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  if (!isProjectShape(parsed)) {\\\\r\\\\n    throw new Error('Project shape mismatch')\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return parsed as Project\\\\r\\\\n}\\\\r\\\\n\\\\n--- git status/log ---\\\\r\\\\n M phases/20-girder-end-asymmetry/index.json\\\\n?? phases/20-girder-end-asymmetry/step1-codex.stderr.log\\\\n?? phases/20-girder-end-asymmetry/step1-codex.stdout.log\\\\nf6d8983 chore(20-girder-end-asymmetry): step 0 output\\\\n3bf93a2 feat(20-girder-end-asymmetry): step 0 — verify ADR-032 decomposition\\\\n5e06849 spec(20-girder-end-asymmetry): 大梁 主筋の左右非対称 端部를 모델·산정에 담게 한다 (ADR-032)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n+{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Write-Output '--- ADR-032 ---'; rg -n -A75 -B8 'ADR-032' docs/ADR.md; Write-Output '--- phase index ---'; Get-Content -LiteralPath phases/20-girder-end-asymmetry/index.json -Encoding utf8; Write-Output '--- member symbols ---'; rg -n -A25 -B12 'GirderMainRow|splitGirderMainRow|interface Girder' src/domain/model/member.ts src/domain/model/member.test.ts; Write-Output '--- project isMainRow/schema ---'; rg -n -A12 -B8 'isMainRow|PROJECT_SCHEMA_VERSION' src/domain/model/project.ts; Write-Output '--- focused diff ---'; git diff -- phases/20-girder-end-asymmetry/index.json; Write-Output '--- tracked/untracked phase files ---'; Get-ChildItem -LiteralPath phases/20-girder-end-asymmetry -Force | Select-Object Name,Length,LastWriteTime\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n+{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Write-Output '--- ADR-032 ---'; rg -n -A75 -B8 'ADR-032' docs/ADR.md; Write-Output '--- phase index ---'; Get-Content -LiteralPath phases/20-girder-end-asymmetry/index.json -Encoding utf8; Write-Output '--- member symbols ---'; rg -n -A25 -B12 'GirderMainRow|splitGirderMainRow|interface Girder' src/domain/model/member.ts src/domain/model/member.test.ts; Write-Output '--- project isMainRow/schema ---'; rg -n -A12 -B8 'isMainRow|PROJECT_SCHEMA_VERSION' src/domain/model/project.ts; Write-Output '--- focused diff ---'; git diff -- phases/20-girder-end-asymmetry/index.json; Write-Output '--- tracked/untracked phase files ---'; Get-ChildItem -LiteralPath phases/20-girder-end-asymmetry -Force | Select-Object Name,Length,LastWriteTime\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"--- ADR-032 ---\\\\r\\\\n445-**③-2 (2026-08-25 정정): 「별개의 한 본」 요구만으로는 스팬 1본 축을 못 막는다 — 그 축은 애초에 값을 내지 않는다.** 위 문단은 `writtenAsTotal > 1`(合計로 쓰는 값이 그 축 어딘가에 한 번 더 있어야 한다는 조건)이 이 구멍을 닫았다고 적었는데, 독립 리뷰가 그 판정이 틀렸음을 보였다 — 두 사람이 각각 다른 경로로 재현했다(리뷰어는 yokohama-p14의 `900` 글리프를 페이지 다른 곳에 하나 더 복제해서, 컨트롤러는 합성 입력으로). 스팬이 1본인 축에서 「합 ＝ 合計」는 그 1본 자신을 合計로 읽으면 **언제나** 성립하는 정의이지, 무언가를 확인하는 증거가 아니다 — `writtenAsTotal > 1`은 그 축 위 **어딘가**에 같은 값이 한 번 더 있는지만 보는데, 그것은 이 스팬과 무관한 우연일 수 있다(인스턴스 동일성으로도 안 닫힌다: 「다른 900」을 合計로 잡아도 자기 자신과의 대조인 것은 같다). yokohama-p14가 지금까지 버틴 것은 그 페이지의 X 값 풀에서 `900`이 유일값이었던 **우연**이고, kani-p38이 반대 방향(`20000`이 유일값)으로 버틴 것도 같은 우연이다. 그래서 술어를 수리하는 대신 **라벨이 정확히 2개(스팬 1본)인 축은 데이터를 보기도 전에 값을 내지 않는다**로 바꿨다 — 검산이 원리상 아무것도 배제할 수 없는 자리에서 「우연히 통과했다」를 정답으로 치지 않는다는 뜻이다. 새 `GridIssue`는 `区間数不足`이고(라벨 부족＝스팬 0개인 `通り芯ラベル不足`과 대구를 이룬다), yokohama-p14의 X・Y 둘 다(라벨 2개씩) 이 이유로 통일된다.\\\\r\\\\n446-\\\\r\\\\n447-**③-3 pt↔mm 축척 일관성은 쓰지 않는다.** kani-p38은 축척이 잘 맞고(X 0.02833/0.02833/0.02838, Y 0.02833/0.02838) 合計보다 강한 필터가 될 수 있다. 그래도 넣지 않는 이유가 셋이다 — (1) 위치＋合計로 실측 양 축 모두 해가 정확히 하나라 지금 고쳐지는 실패가 없다, (2) 허용오차를 정할 근거가 도면 1부뿐이라 R10(포맷 과적합)의 덫 그 자체다, (3) 재고 있는 것은 통り芯 자체가 아니라 라벨 **문자의 중심**이라 축척 일치는 원리상 근사다. `寸法組合せ不定`이 실측 도면에서 나오는 시점에, 그 도면을 근거로 넣는다.\\\\r\\\\n448-\\\\r\\\\n449-**④ 좌표 규약은 한 곳에만 둔다.** `TextItem.y`는 글자 상단이 아니라 **베이스라인**이다(`textitems.ts`: 「좌상 원점, +y 아래, y=ベースライン」). 호출부가 그때그때 세로 중심으로 환산하면 부호를 뒤집는다 — 실제로 이 모듈의 첫 판이 그렇게 틀렸고(PR #71) 계획 단계 검토·구현·독립 리뷰 **셋 다 통과했다**. 셋 모두 산술만 재유도하고 규약의 의미까지 내려가지 않았기 때문이다. 그래서 세로 중심은 `makeSegments`가 `centerY`로 실어 보내고 **호출부는 환산하지 않는다**. `centerX`와 대칭이 되는 것은 부수 효과다.\\\\r\\\\n450-\\\\r\\\\n451-**트레이드오프**: (1) 커버리지는 kani 1부에서만 확인됐다 — ojkk·yokohama의 伏図 페이지는 아직 픽스처에 없어 **R10(포맷 과적합)에 그대로 걸린다.** 断面リスト 파서가 3부에 과적합돼 있는 것과 같은 종류의 빚을 새로 지는 것이고, 갚는 방법도 같다(도면 수집). (2) 合計를 요구하므로 合計를 안 적는 도면은 통째로 실패한다 — 사용자에게는 「인식 불가」로 보이고, 왜 실패했는지는 `GridIssue`로만 알 수 있다. (3) 通り芯 라벨의 표기 흔들림(`X1'`·`X1A` 같은 補助通り芯)은 정규식이 거절하므로 조용히 빠진다. 지어내지 않지만 사용자는 빠진 줄 모를 수 있다 — 라벨 수와 스팬 수의 불일치가 그것을 잡는 유일한 장치다. (4) 런 재조립의 인접 문턱은 **좁히는 쪽으로만 틀려야 한다**. 붙는 쪽으로 틀리면 「150」＋「50」이 「15050」이 되어 DIMENSION을 **통과**하므로, 거절이 아니라 날조가 후보 풀에 들어간다. 세로 런에서 쓸 수 있는 창은 실측상 개구간 (1w, 2w) 뿐이다 — 한 pdf.js 아이템 안의 글자는 원점 간격이 구조상 정확히 1w이고(`toTextItems`), 실물에서 관측된 토큰 사이 간격의 최솟값이 정확히 2w다(kani-p38 x≈1625.92). 배수를 이 창 밖으로 넓히지 말 것. **가로에는 그런 창이 아예 없다** — yokohama-p14 y≈315.84의 「650x1000」에서 갈라야 할 간격(`0`→`x`, `x`→`1`)과 붙여야 할 간격(`1`→`0`)이 실측상 **전부 정확히 4.977pt로 같다.** 어떤 배수도 이 셋을 분리하지 못하므로 가로축에서 「650」 같은 가짜 후보가 풀에 들어오는 것은 문턱으로 막을 수 없고, 더 나쁘게는 콤마 없는 「6000」이 쪼개져 「600」이 남는 **그럴듯한 가짜**도 원리상 열려 있다(현 코퍼스에서는 안 터진다). 그래서 가로축을 실제로 지키는 것은 0mm 거절과 ③의 위치＋合計 두 겹뿐이고, 그 둘을 약하게 만드는 변경은 문턱 조정과 같은 무게로 다뤄야 한다. (5) **콤마 없이 쓴 6자리 合計는 여전히 잃는다.** `DIMENSION`이 콤마 없는 6자리를 무조건 거절하므로(콤마 없는 6자리는 두 치수가 한 세그먼트로 붙었을 때 나오는 형태다), 치수를 「6000」처럼 쓰는 100m급 도면은 合計 「120000」이 후보 풀에 못 들어가 ③의 자기검산이 그 축에서 원리상 성립하지 않는다. **지금 고치지 않는다** — 코퍼스 5부에 6자리 값이 0건이고 콤마 없는 도면 자체가 없어 검증할 픽스처가 없다. 근거 없는 휴리스틱(페이지 단위 콤마 표기 판정)을 미리 넣는 것은 이 레포의 규율에 어긋난다. 콤마 없는 실도면이 코퍼스에 들어오는 시점의 **조건부 과제**다(R10과 같은 종류의 빚).\\\\r\\\\n452-\\\\n453:### ADR-032: 大梁 主筋の左右非対称 端部를 모델·산정이 담는다 — R13의 모델 제약 해소\\\\n454-\\\\n455-**맥락**: R13 — yokohama 断面リスト 8칸이 「外端/中央/内端」·「Y2端/中央/Y3端」처럼 좌우 다른 主筋 本数를 적는다. `GirderMainRow`는 `{endCount, centerCount}` 둘이라 비대칭을 담을 수 없고, 취입은커녕 손 입력도 불가했다(2026-08-22 식별). 실물의 형은 둘이다(`tests/fixtures/section-import/expected/yokohama-kanazawa-p14-girders.json`, 전사는 눈+raw 대조):\\\\n456-\\\\n457-- **스텁형** — G51 R階 上筋 外端8／中央8／内端13, 下筋 8／8／11: 中央이 한쪽 端과 같고 다른쪽 端만 많다. 差分은 그쪽 支点에만 서는 짧은 カットオフ筋이다.\\\\n458-- **혼합형** — G55 R階 上筋 Y2端4／中央5／Y3端8, 下筋 4／5／5: 中央이 한쪽 端보다 많고 다른쪽 端보다 적다. 「한쪽 支点에만 定着하고 반대쪽 支点 앞에서 끊기는」 **편측근**이 필요하다 — 현행 3형(通し・端部스텁・中央筋)으로는 표현 불가.\\\\n459-\\\\n460-**결정**:\\\\n461-\\\\n462-1. `GirderMainRow`에 optional `startCount?: number`를 더한다. 없으면 대칭(始端=終端=endCount) — **기존 직렬화 그대로 읽히고 기존 案件의 数量이 변하지 않으므로 schemaVersion은 올리지 않는다**(版 기준: 「같은 案件의 数量이 달라지는가」).\\\\n463-2. 始端/終端은 런 로컬이다 — `GirderRun.memberOffsetsMm`의 0 쪽이 始端.\\\\n464-3. **분해는 nesting 해석으로 한다**: 위치별 本数는 누적 집합이다 — i번째 本은 「本数 ≥ i」인 모든 위치에 선다. s = startCount ?? endCount, e = endCount, c = centerCount로:\\\\n465-   - 通し筋 ＝ min(s, c, e)\\\\n466-   - 始端스텁 ＝ max(0, s − c)、終端스텁 ＝ max(0, e − c) — 그쪽 支点에 定着하고 柱面에서 カットオフ位置까지\\\\n467-   - 中央筋 ＝ max(0, c − max(s, e)) — 양쪽 支点 앞 カットオフ位置에서 끊는다\\\\n468-   - 편측근(始端定着) ＝ max(0, min(s, c) − e)、편측근(終端定着) ＝ max(0, min(c, e) − s) — 한쪽 支点에 定着하고 반대쪽 支点 앞 カットオフ位置에서 끊는다. 둘은 동시에 양수일 수 없다(전자는 e<s, 후자는 s<e를 요구).\\\\n469-   - **불변식(각 지점 단면의 본수 보존)**: s ＝ 通し＋始端스텁＋편측(始) ／ c ＝ 通し＋中央＋편측(始)＋편측(終) ／ e ＝ 通し＋終端스텁＋편측(終).\\\\n470-   - s＝e이면 현행 `splitGirderMainRow`와 동치다(스텁 양측 ＝ 기존 端部 카ットオフ, 中央筋 ＝ 기존 中央 카ットオフ, 편측근 0).\\\\n471-4. **길이는 전부 기존 규칙의 재사용이다** — 스텁 ＝ 定着＋カットオフ位置, 中央筋 ＝ 内法−2×位置, 편측근 ＝ (内法−位置)＋定着. 定着은 resolveGirderEnd(룰팩), 継手는 1通則4) 간격 계상(intervalSplice) 그대로. 새 규준 수치는 없다. カットオフ位置(`cutoffFromSupportFaceMm`)는 断面 하나에 하나 — 실물 G51도 값이 内端 [2500] 하나뿐이고, 좌우 다른 값이 실물에 나타나면 그때 넓힌다.\\\\n472-5. **다스팬 런 × 비대칭은 불성립으로 끊는다.** 리스트의 外端/内端이 다스팬 런의 어느 支点인지 조문·모델로 정할 수 없고, 정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004 원리). `MemberUnsupportedError`로 정직하게 실패한다. 대칭 다스팬은 현행 그대로.\\\\n473-6. nesting 해석 자체는 조문이 아니라 판단이다 — 積算基準 2（３）梁1)은 全長にわたる主筋 외의 길이를 設計図書에 위임할 뿐, 位置別 本数를 본 단위로 잇는 규칙은 주지 않는다. R2 꼬리표(inferred)를 단다. 현행 min/差 분해도 같은 해석을 암묵으로 쓰고 있었다 — 이 ADR은 그것을 명시하고 일반화한다.\\\\n474-7. 이 ADR의 범위는 모델·산정·数量·3D까지다. **입력 경로는 별건이다** — 断面一覧 편집 UI와 断面リスト 취입(8칸)의 「도면 라벨(外端/Y2端)↔始端/終端 대응」은 다음 phase이고, R13은 그때 닫힌다.\\\\n--- phase index ---\\\\r\\\\n{\\\\r\\\\n  \\\\\\\"project\\\\\\\": \\\\\\\"Kijun\\\\\\\",\\\\r\\\\n  \\\\\\\"phase\\\\\\\": \\\\\\\"20-girder-end-asymmetry\\\\\\\",\\\\r\\\\n  \\\\\\\"steps\\\\\\\": [\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"step\\\\\\\": 0,\\\\r\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"verify-adr032-decomposition\\\\\\\",\\\\r\\\\n      \\\\\\\"kind\\\\\\\": \\\\\\\"verify\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"completed\\\\\\\",\\\\r\\\\n      \\\\\\\"summary\\\\\\\": \\\\\\\"ADR-032 §3 분해 수식은 s,c,e ∈ [0,12]^3 2,197조합 전수검사와 G51/G55 실물 TextItem 대조에서 반증되지 않았다. 음수·편측근 동시 양수·불변식·대칭 동치·비연속 그룹 모두 반례 0건이며, 기존 min/差 분해 및 직렬화 호환 전제도 코드와 일치한다.\\\\\\\",\\\\r\\\\n      \\\\\\\"started_at\\\\\\\": \\\\\\\"2026-08-26T12:21:25+0900\\\\\\\",\\\\r\\\\n      \\\\\\\"completed_at\\\\\\\": \\\\\\\"2026-08-26T12:26:33+0900\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"step\\\\\\\": 1,\\\\r\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"model-decompose-main-row\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\r\\\\n      \\\\\\\"started_at\\\\\\\": \\\\\\\"2026-08-26T12:26:33+0900\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"step\\\\\\\": 2,\\\\r\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"engine-goldens-viewer\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\"\\\\r\\\\n    }\\\\r\\\\n  ],\\\\r\\\\n  \\\\\\\"created_at\\\\\\\": \\\\\\\"2026-08-26T12:21:25+0900\\\\\\\"\\\\r\\\\n}\\\\r\\\\n--- member symbols ---\\\\r\\\\nsrc/domain/model/member.ts-112-  hoop: {\\\\r\\\\nsrc/domain/model/member.ts-113-    size: ShearBarSize\\\\r\\\\nsrc/domain/model/member.ts-114-    pitch: number\\\\r\\\\nsrc/domain/model/member.ts-115-    /**\\\\r\\\\nsrc/domain/model/member.ts-116-     * 配置区間의 양 끝면에서 第1·最終帯筋을 얼마나 띄우는지. 規準에 값이 없고\\\\r\\\\nsrc/domain/model/member.ts-117-     * 本数를 좌우하므로 제품이 정하지 않는다 — 断面一覧의 입력이다 (ADR-012).\\\\r\\\\nsrc/domain/model/member.ts-118-     */\\\\r\\\\nsrc/domain/model/member.ts-119-    startOffsetMm: number\\\\r\\\\nsrc/domain/model/member.ts-120-  }\\\\r\\\\nsrc/domain/model/member.ts-121-}\\\\r\\\\nsrc/domain/model/member.ts-122-\\\\r\\\\nsrc/domain/model/member.ts-123-/** 大梁 主筋 1段（上端または下端）の位置別本数。断面リストの端部・中央行に対応する。 */\\\\r\\\\nsrc/domain/model/member.ts:124:export interface GirderMainRow {\\\\r\\\\nsrc/domain/model/member.ts-125-  /** 端部（支点側）の本数 */\\\\r\\\\nsrc/domain/model/member.ts-126-  endCount: number\\\\r\\\\nsrc/domain/model/member.ts-127-  /** 中央の本数 */\\\\r\\\\nsrc/domain/model/member.ts-128-  centerCount: number\\\\r\\\\nsrc/domain/model/member.ts-129-}\\\\r\\\\nsrc/domain/model/member.ts-130-\\\\r\\\\nsrc/domain/model/member.ts-131-/**\\\\r\\\\nsrc/domain/model/member.ts-132- * 位置別本数を「梁の全長にわたる主筋」と「そうでない主筋」に分けた結果。\\\\r\\\\nsrc/domain/model/member.ts-133- *\\\\r\\\\nsrc/domain/model/member.ts-134- * 数量積算基準 2（３）梁1) が長さを定めるのは全長にわたる主筋だけで、トップ筋・\\\\r\\\\nsrc/domain/model/member.ts-135- * 補強筋等は設計図書に委ねられる。両位置に共通して立つ本数（少ない方）が通し筋、\\\\r\\\\nsrc/domain/model/member.ts-136- * 差がカットオフ筋である。\\\\r\\\\nsrc/domain/model/member.ts-137- */\\\\r\\\\nsrc/domain/model/member.ts:138:export interface GirderMainSplit {\\\\r\\\\nsrc/domain/model/member.ts-139-  throughCount: number\\\\r\\\\nsrc/domain/model/member.ts-140-  cutoffCount: number\\\\r\\\\nsrc/domain/model/member.ts-141-  /** カットオフ筋が立つ側。cutoffCount が 0 なら意味を持たない */\\\\r\\\\nsrc/domain/model/member.ts-142-  cutoffAt: '端部' | '中央'\\\\r\\\\nsrc/domain/model/member.ts-143-}\\\\r\\\\nsrc/domain/model/member.ts-144-\\\\r\\\\nsrc/domain/model/member.ts:145:export function splitGirderMainRow(row: GirderMainRow): GirderMainSplit {\\\\r\\\\nsrc/domain/model/member.ts-146-  return {\\\\r\\\\nsrc/domain/model/member.ts-147-    throughCount: Math.min(row.endCount, row.centerCount),\\\\r\\\\nsrc/domain/model/member.ts-148-    cutoffCount: Math.abs(row.endCount - row.centerCount),\\\\r\\\\nsrc/domain/model/member.ts-149-    cutoffAt: row.endCount >= row.centerCount ? '端部' : '中央',\\\\r\\\\nsrc/domain/model/member.ts-150-  }\\\\r\\\\nsrc/domain/model/member.ts-151-}\\\\r\\\\nsrc/domain/model/member.ts-152-\\\\r\\\\nsrc/domain/model/member.ts:153:export interface GirderSection {\\\\r\\\\nsrc/domain/model/member.ts-154-  id: string\\\\r\\\\nsrc/domain/model/member.ts-155-  kind: '大梁'\\\\r\\\\nsrc/domain/model/member.ts-156-  mark: string\\\\r\\\\nsrc/domain/model/member.ts-157-  /** ColumnSection.storyLabel과 같다. */\\\\r\\\\nsrc/domain/model/member.ts-158-  storyLabel?: string\\\\r\\\\nsrc/domain/model/member.ts-159-  b: number\\\\r\\\\nsrc/domain/model/member.ts-160-  depth: number\\\\r\\\\nsrc/domain/model/member.ts-161-  fc: number\\\\r\\\\nsrc/domain/model/member.ts-162-  grade: SteelGrade\\\\r\\\\nsrc/domain/model/member.ts-163-  exposure: Exposure\\\\r\\\\nsrc/domain/model/member.ts-164-  finish: Finish\\\\r\\\\nsrc/domain/model/member.ts-165-  /** ColumnSection.spliceMethod と同じ。通し筋の継手箇所数に効く */\\\\r\\\\nsrc/domain/model/member.ts-166-  spliceMethod: SpliceMethod\\\\r\\\\nsrc/domain/model/member.ts-167-  main: {\\\\r\\\\nsrc/domain/model/member.ts-168-    size: BarSize\\\\r\\\\nsrc/domain/model/member.ts-169-    /** 上端筋の位置別本数 — 断面リストの端部・中央行がそのまま入る */\\\\r\\\\nsrc/domain/model/member.ts:170:    top: GirderMainRow\\\\r\\\\nsrc/domain/model/member.ts-171-    /** 下端筋の位置別本数 */\\\\r\\\\nsrc/domain/model/member.ts:172:    bottom: GirderMainRow\\\\r\\\\nsrc/domain/model/member.ts-173-    /**\\\\r\\\\nsrc/domain/model/member.ts-174-     * カットオフ筋を柱面から梁の内側へ何 mm で切り止めるか。\\\\r\\\\nsrc/domain/model/member.ts-175-     *\\\\r\\\\nsrc/domain/model/member.ts-176-     * 数量積算基準 2（３）梁1) が「トップ筋、ハンチ部分の主筋、補強筋等は設計図書\\\\r\\\\nsrc/domain/model/member.ts-177-     * による」と委ねるので規準側に値がない — 断面一覧の入力である (ADR-012)。\\\\r\\\\nsrc/domain/model/member.ts-178-     * 端部と中央が同数（カットオフ筋がない）断面では使われない。\\\\r\\\\nsrc/domain/model/member.ts-179-     */\\\\r\\\\nsrc/domain/model/member.ts-180-    cutoffFromSupportFaceMm: number\\\\r\\\\nsrc/domain/model/member.ts-181-  }\\\\r\\\\nsrc/domain/model/member.ts-182-  stirrup: {\\\\r\\\\nsrc/domain/model/member.ts-183-    size: ShearBarSize\\\\r\\\\nsrc/domain/model/member.ts-184-    pitch: number\\\\r\\\\nsrc/domain/model/member.ts-185-    /** 両端の柱面から第1・最終あばら筋をどれだけ離すか。規準に値はない — 断面一覧の入力である (ADR-012) */\\\\r\\\\nsrc/domain/model/member.ts-186-    startOffsetMm: number\\\\r\\\\nsrc/domain/model/member.ts-187-  }\\\\r\\\\nsrc/domain/model/member.ts-188-  /**\\\\r\\\\nsrc/domain/model/member.ts-189-   * 幅止め筋。断面一覧に記載のない梁には無い配筋なので任意項目とし、\\\\r\\\\nsrc/domain/model/member.ts-190-   * `undefined` は「配筋なし」を意味する — 製品が勝手に足さない (ADR-012)。\\\\r\\\\nsrc/domain/model/member.ts-191-   * 設計長さは数量積算基準 1通則3) が断面の設計幅と定めるので入力は径とピッチだけ。\\\\r\\\\nsrc/domain/model/member.ts-192-   */\\\\r\\\\nsrc/domain/model/member.ts-193-  widthTie?: {\\\\r\\\\nsrc/domain/model/member.ts-194-    size: BarSize\\\\r\\\\nsrc/domain/model/member.ts-195-    pitch: number\\\\r\\\\nsrc/domain/model/member.ts-196-  }\\\\r\\\\nsrc/domain/model/member.ts-197-  /**\\\\r\\\\n--\\\\nsrc/domain/model/member.ts-325- */\\\\r\\\\nsrc/domain/model/member.ts-326-export function sectionMarkLabel(section: Section): string {\\\\r\\\\nsrc/domain/model/member.ts-327-  return section.storyLabel\\\\r\\\\nsrc/domain/model/member.ts-328-    ? `${section.mark}(${section.storyLabel})`\\\\r\\\\nsrc/domain/model/member.ts-329-    : section.mark\\\\r\\\\nsrc/domain/model/member.ts-330-}\\\\r\\\\nsrc/domain/model/member.ts-331-\\\\r\\\\nsrc/domain/model/member.ts-332-export interface ColumnPosition {\\\\r\\\\nsrc/domain/model/member.ts-333-  ix: number\\\\r\\\\nsrc/domain/model/member.ts-334-  iy: number\\\\r\\\\nsrc/domain/model/member.ts-335-}\\\\r\\\\nsrc/domain/model/member.ts-336-\\\\r\\\\nsrc/domain/model/member.ts:337:export interface GirderPosition {\\\\r\\\\nsrc/domain/model/member.ts-338-  axis: 'X' | 'Y'\\\\r\\\\nsrc/domain/model/member.ts-339-  ix: number\\\\r\\\\nsrc/domain/model/member.ts-34