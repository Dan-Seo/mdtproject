\nsrc\\lib\\hooks\\useTakeoff.ts:185:        if (!(error instanceof MemberUnsupportedError)) throw error\r\nsrc\\lib\\hooks\\useTakeoff.ts:203:    // MemberUnsupportedError만 잡는다 — 룰팩 공백 같은 결함은 그대로 터진다.\r\nsrc\\lib\\hooks\\useTakeoff.ts:218:      if (!(error instanceof MemberUnsupportedError)) throw error\r\nsrc\\lib\\viewer\\geometry.ts:2:  splitGirderMainRow,\r\nsrc\\lib\\viewer\\geometry.ts:219:function girderMainPlacements(\r\nsrc\\lib\\viewer\\geometry.ts:225:  const split = splitGirderMainRow(row)\r\nsrc\\lib\\viewer\\geometry.ts:599:  return girderMainPlacements(rebar, section, radiusOf)\r\nphases/20-girder-end-asymmetry\\step0.md:23:   - s＝e에서 현행 `splitGirderMainRow`(`src/domain/model/member.ts`)와\nphases/20-girder-end-asymmetry\\step0-report.json:22:      \"what\": \"s=e에서 기존 splitGirderMainRow와 동치다\",\nphases/20-girder-end-asymmetry\\step0-report.json:35:      \"range\": \"src/domain/model/project.ts:isMainRow 및 src/domain/model/member.ts:splitGirderMainRow\",\nphases/20-girder-end-asymmetry\\step0-report.json:37:      \"evidence\": \"현재 isMainRow는 endCount와 centerCount가 유한수인지만 요구하고 startCount를 요구하지 않으므로 startCount 없는 기존 레코드를 통과시키는 구조다. 현재 splitGirderMainRow는 ADR-032가 일반화하려는 min/差 분해를 그대로 사용한다.\"\nphases/20-girder-end-asymmetry\\step0-codex.stdout.log:6:{\"type\":\"item.started\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'rg -n \\\"splitGirderMainRow|startCount|throughCount|cutoffAt|G51|G55|8.*13|4.*5.*8\\\" src tests phases/20-girder-end-asymmetry docs/ADR.md'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\nphases/20-girder-end-asymmetry\\step0-codex.stdout.log:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'rg -n \\\"splitGirderMainRow|startCount|throughCount|cutoffAt|G51|G55|8.*13|4.*5.*8\\\" src tests phases/20-girder-end-asymmetry docs/ADR.md'\",\"aggregated_output\":\"docs/ADR.md:94:**이유**: 같은 기준서가 躯体 4%(15쪽/PDF 20), 흙막이벽 3%(8쪽/PDF 13), 말뚝 3%(9쪽/PDF 14)로 다르게 정한다. \\\"모든 철근 4%\\\"로 일반화하면 지원 범위를 넓힌 순간 조용히 틀린 값이 나가고, 이것이 정확히 ADR 철학이 막으려는 실패 방식이다.\\r\\ndocs/ADR.md:118:**구현 결과 (2026-08-23, phase 7-section-fields)**: `腹筋: 2-D10`과 리스트 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 행 단위 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 「배근 없음」과 「인식 실패」를 구분하지 못하므로 기존 수기값을 지우지 않는다. 腹筋의 `extraLengthMm`은 기존값을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력 상태)이다. `カットオフ` 치수는 원문 `raw` 보존까지만 완료했고, 좌우 端部를 담지 못하는 R13 본체가 닫히기 전에는 값으로 반영하지 않는다. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이어서 이번 phase에서 제외했다 — 없는 것을 읽지 못하는 것은 파서 결함이 아니다.\\r\\ndocs/ADR.md:188:**이유**: 이전 2단계는 **거짓말을 하고 있었다.** `定着長さ 40d`는 `表5.3.4`(紙面30)에 명시된 값인데 `inferred`(추론)로 표시됐다. 실제 이유는 추론이 아니라 R6 — 전사자와 승인자가 같아서 독립 검토가 안 끝났다는 것이고, 룰팩 note에도 그대로 `LLM転写 — 独立検討待ち`라고 적혀 있었다. 그 결과 「원문에 명시된 값(178행)」과 「원문에 없어 지어낸 값(11행)」이 같은 통에 들어가 **전 행에 ▲가 붙었고, ▲는 아무것도 가리키지 못했다.** 등급을 나누자 ▲는 실제로 근거가 없는 곳만 가리킨다.\\r\\ndocs/ADR.md:215:2. 화면의 `rebarRadius`는 가독성을 위해 **최소 ⌀14·1.6배로 부풀린 표시값**이다. 내보내는 모형에 그대로 쓰면 D25가 ⌀40의 봉으로 실측된다. 화면과 파일이 달라지는 대가를 치르더라도, 실측 가능한 산출물에 부풀린 치수를 담지 않는다 — 이 프로젝트가 못 견디는 실패는 「빠진 것」이 아니라 「틀린 채로 완성된 것」이다(철학). 그래서 `RebarInstance`가 呼び名를 함께 들고, 내보내기 쪽이 実半径을 뽑는다. **반경은 굵기뿐 아니라 위치도 정한다** — 帯筋을 관통하지 않게 主筋을 안쪽으로 밀어넣는 값이 반경에서 나오므로, 반경 함수(`RadiusOf`)를 `buildingLayout`에 주입해 화면은 표시값을, 내보내기는 実寸을 쓴다. 한쪽만 実寸으로 하면 굵기는 맞는데 위치가 설계보다 수십 mm 안쪽으로 몰린 모형이 나간다(D13 帯筋·D25 主筋에서 84.8mm — 실제는 25.5mm).\\r\\ndocs/ADR.md:283:**主筋에 넣을 수 없는 이유도 같은 형태다.** 主筋은 定着(表5.3.4)·重ね継手(表5.3.2)를 **径과 鉄筋の種類로** 引는다. 그 표에 高強度せん断補強筋의 행은 없다 — 넣으면 SD345 칸을 785급 철근에 적용하게 되고, 그것은 근거 없는 값을 조용히 쓰는 것이다. `ShearBarSize = BarSize | HighStrengthShearBarSize`로 나누고 `main.size`는 `BarSize`인 채 둔다. 壁筋도 定着 L1을 引으므로 `BarSize`다.\\r\\ndocs/ADR.md:388:**검증**: 골든 픽스처 `quantity-r5-ch3.json`의 `cases.openingDeduction`에 1通則8)과 1通則7) **둘만으로 손유도한** 6케이스를 박았다 — 개구 1개, 세로로 겹친 2개(같은 본이 둘 다 지남), 가로로 나란한 높이 다른 2개(欠除量이 다른 群으로 갈리고, 직교 방향에서는 겹쳐 2000을 欠く 본이 나온다), 0.49㎡(欠除 없음), **0.50㎡ 딱(「以下」이므로 欠除 없음)**, 床板 1개(같은 조항이 부재를 가리지 않는다). 뮤테이션으로 감도를 실측했다 — 경계를 `<=`로 무르게 하면 4케이스, 走る向き를 뒤바꾸면 3케이스, 0.5㎡의 「以下」를 「未満」으로 바꾸면 1케이스가 떨어진다. 1通則8)의 픽스처 항목이 `deferred`에서 `covered`로 넘어갔다. 브라우저 실검증은 `tests/e2e/uc21-opening.js`.\\r\\ndocs/ADR.md:399:2. **부재 부호가 그리드에 스냅된다.** `FG51`@(235,1727): x가 bY6 축(216) 위, y가 bX1–bX2 중점(1727.5) — 大梁은 「한 축 위 ＋ 스팬 중점」. `S55`@(285,1730): 두 좌표 모두 중점 — 床板은 칸 중앙. `F`계 부호는 교점 부근이되 지시선 오프셋이 있다(스냅 허용오차 필요).\\r\\ndocs/ADR.md:411:**뒤에 붙은 것 (2026-08-23)**: ⑥ **階高 → Story 취입** — 「어느 레벨이 階의 경계인가」를 파서가 정하지 않으므로 최상階의 천단과 최하階의 바닥을 사람이 고른다. 階의 이름은 그 階의 **바닥이 되는 레벨의 원문**이고, 같은 높이의 라벨 둘은 둘 다 남긴다(실물의 「中央棟1FL」과 「基準GL」은 190mm 차라 도면상 같은 자리다). ⑦ **`Grid`의 通り芯 라벨** — `xLabels`·`yLabels`는 optional이고 미지정은 「도면에서 읽은 이름이 없다」다. schemaVersion은 올리지 않는다: 版을 올리는 기준은 「같은 案件의 数量이 달라지는가」인데(v11 주석) 이름은 数量을 바꾸지 않는다. 이것이 R13의 선결 조건이다 — 도면의 「Y3端／Y4端」을 런의 실제 방향과 맞추려면 제품이 通り芯의 이름을 알아야 한다. ⑧ **軸組図 계열의 반증 가능성** — 발주처를 하나 더 넣자(kani p40) 파서가 두 번 연속으로 없는 층을 지어냈다. 치수 둘짜리 연쇄는 축척을 하나 유도하는데 유도한 값이 자기 자신과 어긋날 수 없어 일관성 검사가 공회전하고, 남는 증거인 라벨 일치가 글자 빽빽한 도면에서 **우연히** 맞는다. 셋을 요구해 축척이 서로를 반증하게 하고, 레벨 라벨의 가로 창도 150pt에서 80pt로 좁혔다(실측 최대 67pt, 오검출은 128pt).\\r\\ndocs/ADR.md:431:가로런 수는 이 항을 처음 쓸 때 36개였다. 세그먼트 인접 문턱에 있던 고정 4pt 하한을 지우면서(글자 높이의 배수라는 정의를 덮고 있었고, 지금 배수 0.5에서는 문턱이 3.54pt다) 같은 행의 「300×500」이 간격 3.93pt에서 `300`과 `500`으로 갈라져 둘이 늘었다. **노이즈가 2개 는 것이지 스팬이 는 것이 아니다** — 스팬 3개·2개와 合計는 그대로이므로 이 항의 논지(노이즈가 압도적이라 合計 대조가 유일한 장치다)는 오히려 강해진다. 숫자는 손으로 적는 값이라 코드보다 뒤처지기 쉽다(CLAUDE.md) — 다시 재려면 `dimensionTexts(kani-p38.items)`를 축별로 세면 된다.\\r\\ndocs/ADR.md:451:**트레이드오프**: (1) 커버리지는 kani 1부에서만 확인됐다 — ojkk·yokohama의 伏図 페이지는 아직 픽스처에 없어 **R10(포맷 과적합)에 그대로 걸린다.** 断面リスト 파서가 3부에 과적합돼 있는 것과 같은 종류의 빚을 새로 지는 것이고, 갚는 방법도 같다(도면 수집). (2) 合計를 요구하므로 合計를 안 적는 도면은 통째로 실패한다 — 사용자에게는 「인식 불가」로 보이고, 왜 실패했는지는 `GridIssue`로만 알 수 있다. (3) 通り芯 라벨의 표기 흔들림(`X1'`·`X1A` 같은 補助通り芯)은 정규식이 거절하므로 조용히 빠진다. 지어내지 않지만 사용자는 빠진 줄 모를 수 있다 — 라벨 수와 스팬 수의 불일치가 그것을 잡는 유일한 장치다. (4) 런 재조립의 인접 문턱은 **좁히는 쪽으로만 틀려야 한다**. 붙는 쪽으로 틀리면 「150」＋「50」이 「15050」이 되어 DIMENSION을 **통과**하므로, 거절이 아니라 날조가 후보 풀에 들어간다. 세로 런에서 쓸 수 있는 창은 실측상 개구간 (1w, 2w) 뿐이다 — 한 pdf.js 아이템 안의 글자는 원점 간격이 구조상 정확히 1w이고(`toTextItems`), 실물에서 관측된 토큰 사이 간격의 최솟값이 정확히 2w다(kani-p38 x≈1625.92). 배수를 이 창 밖으로 넓히지 말 것. **가로에는 그런 창이 아예 없다** — yokohama-p14 y≈315.84의 「650x1000」에서 갈라야 할 간격(`0`→`x`, `x`→`1`)과 붙여야 할 간격(`1`→`0`)이 실측상 **전부 정확히 4.977pt로 같다.** 어떤 배수도 이 셋을 분리하지 못하므로 가로축에서 「650」 같은 가짜 후보가 풀에 들어오는 것은 문턱으로 막을 수 없고, 더 나쁘게는 콤마 없는 「6000」이 쪼개져 「600」이 남는 **그럴듯한 가짜**도 원리상 열려 있다(현 코퍼스에서는 안 터진다). 그래서 가로축을 실제로 지키는 것은 0mm 거절과 ③의 위치＋合計 두 겹뿐이고, 그 둘을 약하게 만드는 변경은 문턱 조정과 같은 무게로 다뤄야 한다. (5) **콤마 없이 쓴 6자리 合計는 여전히 잃는다.** `DIMENSION`이 콤마 없는 6자리를 무조건 거절하므로(콤마 없는 6자리는 두 치수가 한 세그먼트로 붙었을 때 나오는 형태다), 치수를 「6000」처럼 쓰는 100m급 도면은 合計 「120000」이 후보 풀에 못 들어가 ③의 자기검산이 그 축에서 원리상 성립하지 않는다. **지금 고치지 않는다** — 코퍼스 5부에 6자리 값이 0건이고 콤마 없는 도면 자체가 없어 검증할 픽스처가 없다. 근거 없는 휴리스틱(페이지 단위 콤마 표기 판정)을 미리 넣는 것은 이 레포의 규율에 어긋난다. 콤마 없는 실도면이 코퍼스에 들어오는 시점의 **조건부 과제**다(R10과 같은 종류의 빚).\\r\\ndocs/ADR.md:457:- **스텁형** — G51 R階 上筋 外端8／中央8／内端13, 下筋 8／8／11: 中央이 한쪽 端과 같고 다른쪽 端만 많다. 差分은 그쪽 支点에만 서는 짧은 カットオフ筋이다.\\ndocs/ADR.md:458:- **혼합형** — G55 R階 上筋 Y2端4／中央5／Y3端8, 下筋 4／5／5: 中央이 한쪽 端보다 많고 다른쪽 端보다 적다. 「한쪽 支点에만 定着하고 반대쪽 支点 앞에서 끊기는」 **편측근**이 필요하다 — 현행 3형(通し・端部스텁・中央筋)으로는 표현 불가.\\ndocs/ADR.md:462:1. `GirderMainRow`에 optional `startCount?: number`를 더한다. 없으면 대칭(始端=終端=endCount) — **기존 직렬화 그대로 읽히고 기존 案件의 数量이 변하지 않으므로 schemaVersion은 올리지 않는다**(版 기준: 「같은 案件의 数量이 달라지는가」).\\ndocs/ADR.md:464:3. **분해는 nesting 해석으로 한다**: 위치별 本数는 누적 집합이다 — i번째 本은 「本数 ≥ i」인 모든 위치에 선다. s = startCount ?? endCount, e = endCount, c = centerCount로:\\ndocs/ADR.md:470:   - s＝e이면 현행 `splitGirderMainRow`와 동치다(스텁 양측 ＝ 기존 端部 카ットオフ, 中央筋 ＝ 기존 中央 카ットオフ, 편측근 0).\\ndocs/ADR.md:471:4. **길이는 전부 기존 규칙의 재사용이다** — 스텁 ＝ 定着＋カットオフ位置, 中央筋 ＝ 内法−2×位置, 편측근 ＝ (内法−位置)＋定着. 定着은 resolveGirderEnd(룰팩), 継手는 1通則4) 간격 계상(intervalSplice) 그대로. 새 규준 수치는 없다. カットオフ位置(`cutoffFromSupportFaceMm`)는 断面 하나에 하나 — 실물 G51도 값이 内端 [2500] 하나뿐이고, 좌우 다른 값이 실물에 나타나면 그때 넓힌다.\\ndocs/ADR.md:474:7. 이 ADR의 범위는 모델·산정·数量·3D까지다. **입력 경로는 별건이다** — 断面一覧 편집 UI와 断面リスト 취입(8칸)의 「도면 라벨(外端/Y2端)↔始端/終端 대응」은 다음 phase이고, R13은 그때 닫힌다.\\ntests\\\\section-import\\\\textitems.test.ts:32:    sha256: 'dcb9504a50d8661a76bbd96c412a20f468cfff7495167cd055ca0bb2289e1343',\\r\\ntests\\\\section-import\\\\textitems.test.ts:41:    sha256: 'dcb9504a50d8661a76bbd96c412a20f468cfff7495167cd055ca0bb2289e1343',\\r\\ntests\\\\section-import\\\\textitems.test.ts:63:    needles: [['大梁断面リスト'], ['G51'], ['13-D25'], ['650']],\\r\\ntests\\\\section-import\\\\textitems.test.ts:73:    needles: [['2階床伏図'], ['bX1'], ['bY6'], ['8700'], ['G51']],\\r\\ntests\\\\section-import\\\\textitems.test.ts:78:    sha256: '6d4b0f806b429a0103facf10189f75ef87568303459759fbc2826988fc037c8f',\\r\\ntests\\\\section-import\\\\textitems.test.ts:88:    sha256: '6d4b0f806b429a0103facf10189f75ef87568303459759fbc2826988fc037c8f',\\r\\ntests\\\\section-import\\\\textitems.test.ts:97:    sha256: 'dcb9504a50d8661a76bbd96c412a20f468cfff7495167cd055ca0bb2289e1343',\\r\\ntests\\\\section-import\\\\textitems.test.ts:119:    needles: [['bY1'], ['bY6'], ['8700'], ['FG51']],\\r\\ntests\\\\section-import\\\\textitems.test.ts:135:    // 実測 1,545 件 × 0.8 の切り捨て。\\r\\ntests\\\\section-import\\\\textitems.test.ts:142:    sha256: '6d4b0f806b429a0103facf10189f75ef87568303459759fbc2826988fc037c8f',\\r\\ntests\\\\section-import\\\\textitems.test.ts:151:    sha256: '6d4b0f806b429a0103facf10189f75ef87568303459759fbc2826988fc037c8f',\\r\\ntests\\\\section-import\\\\parse.test.ts:81:      { str: '400×600', x: 120, y: 50, w: 50, h: 8 },\\r\\ntests\\\\section-import\\\\parse.test.ts:203:    expectMarksInclude(girders, ['G51', 'G54', 'G55', 'G55A'])\\r\\ntests\\\\section-import\\\\parse.test.ts:205:    const g51Roof = candidate(girders, 'G51', 'R階')\\r\\ntests\\\\section-import\\\\parse.test.ts:222:    // 外端 8 ≠ 内端 13 — どちらが始端かを決められないので確定しない\\