          split.throughCount +\\\\n+              split.endStubCount +\\\\n+              (oneSidedAtEnd ? split.oneSidedCount : 0),\\\\n+          )\\\\n+          expect(oneSidedAtStart && oneSidedAtEnd).toBe(false)\\\\n+          expect(split.throughCount).toBeGreaterThanOrEqual(0)\\\\n+          expect(split.startStubCount).toBeGreaterThanOrEqual(0)\\\\n+          expect(split.endStubCount).toBeGreaterThanOrEqual(0)\\\\n+          expect(split.centerOnlyCount).toBeGreaterThanOrEqual(0)\\\\n+          expect(split.oneSidedCount).toBeGreaterThanOrEqual(0)\\\\n+        }\\\\n+      }\\\\n+    }\\\\n+  })\\\\n+\\\\n+  it('is equivalent to splitGirderMainRow for symmetric ends', () => {\\\\n+    for (let endCount = 0; endCount <= 12; endCount += 1) {\\\\n+      for (let centerCount = 0; centerCount <= 12; centerCount += 1) {\\\\n+        const row = { endCount, centerCount, startCount: endCount }\\\\n+        const decomposed = decomposeGirderMainRow(row)\\\\n+        const legacy = splitGirderMainRow(row)\\\\n+\\\\n+        expect(decomposed.throughCount).toBe(legacy.throughCount)\\\\n+        expect(decomposed.oneSidedCount).toBe(0)\\\\n+        if (endCount >= centerCount) {\\\\n+          expect(decomposed.startStubCount).toBe(legacy.cutoffCount)\\\\n+          expect(decomposed.endStubCount).toBe(legacy.cutoffCount)\\\\n+          expect(decomposed.centerOnlyCount).toBe(0)\\\\n+          expect(legacy.cutoffAt).toBe('端部')\\\\n+        } else {\\\\n+          expect(decomposed.startStubCount).toBe(0)\\\\n+          expect(decomposed.endStubCount).toBe(0)\\\\n+          expect(decomposed.centerOnlyCount).toBe(legacy.cutoffCount)\\\\n+          expect(legacy.cutoffAt).toBe('中央')\\\\n+        }\\\\n+      }\\\\n+    }\\\\n+  })\\\\n+})\\\\n+\\\\n describe('高強度せん断補強筋 (大臣認定品)', () => {\\\\n   it('はせん断補強筋にだけ許され、主筋・壁筋には型として入らない', () => {\\\\n     // 主筋・壁筋の径は表5.3.2(重ね継手)・表5.3.4(定着)を引く。その表に\\\\ndiff --git a/src/domain/model/member.ts b/src/domain/model/member.ts\\\\nindex 7a89159..bed6769 100644\\\\n--- a/src/domain/model/member.ts\\\\n+++ b/src/domain/model/member.ts\\\\n@@ -126,6 +126,11 @@ export interface GirderMainRow {\\\\n   endCount: number\\\\n   /** 中央の本数 */\\\\n   centerCount: number\\\\n+  /**\\\\n+   * 始端側の本数 — 左右で違うときだけ持つ。無ければ endCount と同じ（対称）。\\\\n+   * 始端はランローカル（GirderRun.memberOffsetsMm の 0 側）。\\\\n+   */\\\\n+  startCount?: number\\\\n }\\\\n \\\\n /**\\\\n@@ -150,6 +155,73 @@ export function splitGirderMainRow(row: GirderMainRow): GirderMainSplit {\\\\n   }\\\\n }\\\\n \\\\n+/**\\\\n+ * 大梁主筋の位置別本数を、重なりを保つグループへ分解する。\\\\n+ *\\\\n+ * 本数は累積集合として解釈する。通し筋・始端/終端 stub・中央筋に加えて、\\\\n+ * 一方の支点だけで定着する 편측근を返す。始端と終端の両方に定着する 편측근は\\\\n+ * 同時に成立しないため、`oneSidedAnchor` は一方だけを持つ (ADR-032)。\\\\n+ */\\\\n+export interface GirderMainDecomposition {\\\\n+  throughCount: number\\\\n+  startStubCount: number\\\\n+  endStubCount: number\\\\n+  centerOnlyCount: number\\\\n+  oneSidedCount: number\\\\n+  oneSidedAnchor?: '始端' | '終端'\\\\n+}\\\\n+\\\\n+export function decomposeGirderMainRow(\\\\n+  row: GirderMainRow,\\\\n+): GirderMainDecomposition {\\\\n+  const startCount = row.startCount ?? row.endCount\\\\n+  const throughCount = Math.min(startCount, row.centerCount, row.endCount)\\\\n+  const startStubCount = Math.max(0, startCount - row.centerCount)\\\\n+  const endStubCount = Math.max(0, row.endCount - row.centerCount)\\\\n+  const centerOnlyCount = Math.max(\\\\n+    0,\\\\n+    row.centerCount - Math.max(startCount, row.endCount),\\\\n+  )\\\\n+  const oneSidedStartCount = Math.max(\\\\n+    0,\\\\n+    Math.min(startCount, row.centerCount) - row.endCount,\\\\n+  )\\\\n+  const oneSidedEndCount = Math.max(\\\\n+    0,\\\\n+    Math.min(row.centerCount, row.endCount) - startCount,\\\\n+  )\\\\n+\\\\n+  if (oneSidedStartCount > 0) {\\\\n+    return {\\\\n+      throughCount,\\\\n+      startStubCount,\\\\n+      endStubCount,\\\\n+      centerOnlyCount,\\\\n+      oneSidedCount: oneSidedStartCount,\\\\n+      oneSidedAnchor: '始端',\\\\n+    }\\\\n+  }\\\\n+\\\\n+  if (oneSidedEndCount > 0) {\\\\n+    return {\\\\n+      throughCount,\\\\n+      startStubCount,\\\\n+      endStubCount,\\\\n+      centerOnlyCount,\\\\n+      oneSidedCount: oneSidedEndCount,\\\\n+      oneSidedAnchor: '終端',\\\\n+    }\\\\n+  }\\\\n+\\\\n+  return {\\\\n+    throughCount,\\\\n+    startStubCount,\\\\n+    endStubCount,\\\\n+    centerOnlyCount,\\\\n+    oneSidedCount: 0,\\\\n+  }\\\\n+}\\\\n+\\\\n export interface GirderSection {\\\\n   id: string\\\\n   kind: '大梁'\\\\ndiff --git a/src/domain/model/project.test.ts b/src/domain/model/project.test.ts\\\\nindex 09c5dfd..4ef8004 100644\\\\n--- a/src/domain/model/project.test.ts\\\\n+++ b/src/domain/model/project.test.ts\\\\n@@ -182,6 +182,51 @@ describe('project lookup helpers', () => {\\\\n   })\\\\n })\\\\n \\\\n+describe('GirderMainRow serialization compatibility', () => {\\\\n+  it('accepts a finite startCount while keeping the legacy omitted field valid', () => {\\\\n+    const project = createProject()\\\\n+    const withAsymmetricRow = {\\\\n+      ...project,\\\\n+      sections: [\\\\n+        columnSection,\\\\n+        {\\\\n+          ...shallowGirderSection,\\\\n+          main: {\\\\n+            ...shallowGirderSection.main,\\\\n+            top: { endCount: 8, centerCount: 5, startCount: 4 },\\\\n+          },\\\\n+        },\\\\n+      ],\\\\n+    }\\\\n+\\\\n+    expect(deserializeProject(serializeProject(project))).toEqual(project)\\\\n+    expect(deserializeProject(serializeProject(withAsymmetricRow))).toEqual(\\\\n+      withAsymmetricRow,\\\\n+    )\\\\n+  })\\\\n+\\\\n+  it('rejects a non-finite-shaped startCount when it is present', () => {\\\\n+    const project = createProject()\\\\n+    const serialized = serializeProject({\\\\n+      ...project,\\\\n+      sections: [\\\\n+        columnSection,\\\\n+        {\\\\n+          ...shallowGirderSection,\\\\n+          main: {\\\\n+            ...shallowGirderSection.main,\\\\n+            top: { endCount: 8, centerCount: 5, startCount: null as never },\\\\n+          },\\\\n+        },\\\\n+      ],\\\\n+    })\\\\n+\\\\n+    expect(() => deserializeProject(serialized)).toThrow(\\\\n+      'Project shape mismatch',\\\\n+    )\\\\n+  })\\\\n+})\\\\n+\\\\n describe('girderSpan', () => {\\\\n   const rectangularColumnSection: ColumnSection = {\\\\n     ...columnSection,\\\\ndiff --git a/src/domain/model/project.ts b/src/domain/model/project.ts\\\\nindex 6839a46..a94dc2d 100644\\\\n--- a/src/domain/model/project.ts\\\\n+++ b/src/domain/model/project.ts\\\\n@@ -986,10 +986,19 @@ const shapedAs =\\\\n   (value: unknown): boolean =>\\\\n     hasShape(value, fields)\\\\n \\\\n-const isMainRow = shapedAs({\\\\n-  endCount: isFiniteNumber,\\\\n-  centerCount: isFiniteNumber,\\\\n-})\\\\n+const isMainRow = (value: unknown): boolean => {\\\\n+  if (\\\\n+    !hasShape(value, {\\\\n+      endCount: isFiniteNumber,\\\\n+      centerCount: isFiniteNumber,\\\\n+    })\\\\n+  ) {\\\\n+    return false\\\\n+  }\\\\n+\\\\n+  const row = value as Record<string, unknown>\\\\n+  return row.startCount === undefined || isFiniteNumber(row.startCount)\\\\n+}\\\\n \\\\n const isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\\\\n \\\\n--- step0 commit ---\\\\r\\\\nf6d8983 (HEAD -> feat-20-girder-end-asymmetry) chore(20-girder-end-asymmetry): step 0 output\\\\n phases/20-girder-end-asymmetry/index.json          |  5 +-\\\\n .../20-girder-end-asymmetry/step0-codex.stderr.log |  2 +\\\\n .../20-girder-end-asymmetry/step0-codex.stdout.log | 61 ++++++++++++++++++++++\\\\n phases/20-girder-end-asymmetry/step0-invoke.json   |  9 ++++\\\\n 4 files changed, 75 insertions(+), 2 deletions(-)\\\\n--- gitignore phase/log rules ---\\\\r\\\\n.gitignore:12:# phase execution outputs\\\\r\\\\n.gitignore:13:phases/**/phase*-output.json\\\\r\\\\n.gitignore:14:phases/**/step*-output.json\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\nphases/20-girder-end-asymmetry\\\\step1-codex.stdout.log:38:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_21\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Get-Content -LiteralPath phases/20-girder-end-asymmetry/step0-report.json -Encoding utf8; Write-Output '--- invoke/index json shape ---'; Get-Content -LiteralPath phases/20-girder-end-asymmetry/step0-invoke.json -Encoding utf8; Write-Output '--- phase tracked state ---'; git ls-files phases/20-girder-end-asymmetry\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"      \\\\\\\"what\\\\\\\": \\\\\\\"ADR-032의 다섯 분해항은 음수가 되지 않고 세 위치별 본수 불변식을 보존한다\\\\\\\",\\\\r\\\\n      \\\\\\\"range\\\\\\\": \\\\\\\"s, c, e ∈ [0, 12]^3; 2,197조합\\\\\\\",\\\\r\\\\n      \\\\\\\"counterexamples\\\\\\\": [],\\\\r\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"through=min(s,c,e), startStub=max(0,s-c), endStub=max(0,e-c), centerOnly=max(0,c-max(s,e)), oneSided(始端)=max(0,min(s,c)-e), oneSided(終端)=max(0,min(c,e)-s)를 스크래치 전수 계산했다. s=through+startStub+oneSided(始端), c=through+centerOnly+oneSided(始端)+oneSided(終端), e=through+endStub+oneSided(終端)가 전 조합에서 성립했다.\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"what\\\\\\\": \\\\\\\"始端定着 편측근과 終端定着 편측근은 동시에 양수가 아니다\\\\\\\",\\\\r\\\\n      \\\\\\\"range\\\\\\\": \\\\\\\"s, c, e ∈ [0, 12]^3; 2,197조합\\\\\\\",\\\\r\\\\n      \\\\\\\"counterexamples\\\\\\\": [],\\\\r\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"두 항의 동시 양수 조건은 각각 e<min(s,c), s<min(c,e)이므로 e<s와 s<e를 동시에 요구한다. 전수 계산에서도 동시 양수 0건이었다.\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"what\\\\\\\": \\\\\\\"각 분해 그룹은 始端→中央→終端에서 연속한 한 구간으로 해석된다\\\\\\\",\\\\r\\\\n      \\\\\\\"range\\\\\\\": \\\\\\\"s, c, e ∈ [0, 12]^3; 양수인 각 항의 위치 서명\\\\\\\",\\\\r\\\\n      \\\\\\\"counterexamples\\\\\\\": [],\\\\r\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"through=SCE, startStub=S, endStub=E, centerOnly=C, oneSided(始端)=SC, oneSided(終端)=CE로 분류했다. 비연속 서명 SE(始端과終端에는 서지만中央에는 없는 본)는 어떤 항에도 생성되지 않았다. 예시 (6,4,9)는 through=4, startStub=2, endStub=5로 두 단부 스텁으로 분해된다.\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"what\\\\\\\": \\\\\\\"s=e에서 기존 splitGirderMainRow와 동치다\\\\\\\",\\\\r\\\\n      \\\\\\\"range\\\\\\\": \\\\\\\"s=e ∈ [0, 12], c ∈ [0, 12]; 169조합\\\\\\\",\\\\r\\\\n      \\\\\\\"counterexamples\\\\\\\": [],\\\\r\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"기존 함수의 throughCount=min(endCount,centerCount), cutoffCount=abs(endCount-centerCount), cutoffAt=(endCount>=centerCount ? 端部 : 中央)와 대조했다. 端部 지배 시 양측 stub=cutoffCount·centerOnly=0, 中央 지배 시 centerOnly=cutoffCount·양측 stub=0, 양 편측근=0이 전 조합에서 일치했다.\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"what\\\\\\\": \\\\\\\"yokohama-p14의 ADR-032 인용 실물 전제\\\\\\\",\\\\r\\\\n      \\\\\\\"range\\\\\\\": \\\\\\\"tests/fixtures/section-import/textitems/yokohama-p14.json; 문자 단위 TextItem을 y행/x순으로 재구성\\\\\\\",\\\\r\\\\n      \\\\\\\"counterexamples\\\\\\\": [],\\\\r\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"G51(헤더 x=364.98,y=124.38)의 위치행은 外端・中央・内端이고 上筋 행은 8-D25・8-D25・13-D25, 下筋 행은 8-D25・8-D25・11-D25였다. G55(헤더 x=1900.44,y=124.38)의 위치행은 Y2端・中央・Y3端이고 上筋 행은 4-D25・5-D25・8-D25, 下筋 행은 4-D25・5-D25・5-D25였다.\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"what\\\\\\\": \\\\\\\"기존 직렬화와 현재 코드의 호환 주장\\\\\\\",\\\\r\\\\n      \\\\\\\"range\\\\\\\": \\\\\\\"src/domain/model/project.ts:isMainRow 및 src/domain/model/member.ts:splitGirderMainRow\\\\\\\",\\\\r\\\\n      \\\\\\\"counterexamples\\\\\\\": [],\\\\r\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"현재 isMainRow는 endCount와 centerCount가 유한수인지만 요구하고 startCount를 요구하지 않으므로 startCount 없는 기존 레코드를 통과시키는 구조다. 현재 splitGirderMainRow는 ADR-032가 일반화하려는 min/差 분해를 그대로 사용한다.\\\\\\\"\\\\r\\\\n    }\\\\r\\\\n  ],\\\\r\\\\n  \\\\\\\"verdict\\\\\\\": \\\\\\\"upheld\\\\\\\",\\\\r\\\\n  \\\\\\\"summary\\\\\\\": \\\\\\\"ADR-032 §3 분해 수식은 s,c,e ∈ [0,12]^3 2