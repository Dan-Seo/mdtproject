se] as const),\\\\r\\\\n  )('%s', (_id, testCase) => {\\\\r\\\\n    const rebar = generate(testCase).find(\\\\r\\\\n      (candidate) => candidate.role === testCase.role,\\\\r\\\\n    )\\\\r\\\\n\\\\r\\\\n    expect(rebar, `${testCase.role} should be generated`).toBeDefined()\\\\r\\\\n    expect(\\\\r\\\\n      polylineLength(rebar!.points, rebar!.closed),\\\\r\\\\n      `${testCase.title}\\\\\\\\n${testCase.derivation}`,\\\\r\\\\n    ).toBe(testCase.expectedFabricationLengthMm)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it.each(\\\\r\\\\n    fixture.cases\\\\r\\\\n      .filter((testCase) => 'expectation' in testCase)\\\\r\\\\n      .map((testCase) => [testCase.id, testCase] as const),\\\\r\\\\n  )('%s', (_id, testCase) => {\\\\r\\\\n    let thrown: unknown\\\\r\\\\n    try {\\\\r\\\\n      generate(testCase)\\\\r\\\\n    } catch (error) {\\\\r\\\\n      thrown = error\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    expect(\\\\r\\\\n      thrown,\\\\r\\\\n      `${testCase.title}\\\\\\\\n${testCase.derivation}`,\\\\r\\\\n    ).toBeInstanceOf(MemberUnsupportedError)\\\\r\\\\n    expect((thrown as MemberUnsupportedError).reason).toBe(testCase.reason)\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\nGet-Content : Cannot find path 'tests/golden/quantity-r5-ch3.json' because it does not exist.\\\\r\\\\nAt line:2 char:279\\\\r\\\\n+ ... -First 360; Get-Content -LiteralPath tests/golden/quantity-r5-ch3.jso ...\\\\r\\\\n+                 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\\\r\\\\n    + CategoryInfo          : ObjectNotFound: (tests/golden/quantity-r5-ch3.json:String) [Get-Content], ItemNotFoundEx \\\\r\\\\n   ception\\\\r\\\\n    + FullyQualifiedErrorId : PathNotFound,Microsoft.PowerShell.Commands.GetContentCommand\\\\r\\\\n \\\\r\\\\n\\\\r\\\\n\\\\r\\\\n\\\",\\\"exit_code\\\":1,\\\"status\\\":\\\"failed\\\"}}\\r\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_15\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS