n--- member.ts ---\\\\r\\\\n/** BAR_SIZES ?ⓨ릪?섅걦?곩츪烏뚧셽?ユ쩂?곥굢?뚣굥?덀걝?띶닓?뗣굢?뗣굮壅룔걪?쇻?*/\\\\r\\\\nexport const MEMBER_KINDS = ['??, '鸚㎪쥈', '?먬쐡鶯?, '佯딀씮'] as const\\\\r\\\\n\\\\r\\\\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\\\\r\\\\n\\\\r\\\\nexport type MemberClass = '翁?퐪'\\\\r\\\\n\\\\r\\\\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\\\\r\\\\nexport const BAR_SIZES = [\\\\r\\\\n  'D10',\\\\r\\\\n  'D13',\\\\r\\\\n  'D16',\\\\r\\\\n  'D19',\\\\r\\\\n  'D22',\\\\r\\\\n  'D25',\\\\r\\\\n  'D29',\\\\r\\\\n  'D32',\\\\r\\\\n] as const\\\\r\\\\n\\\\r\\\\nexport type BarSize = (typeof BAR_SIZES)[number]\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\\\\r\\\\n *\\\\r\\\\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\\\\r\\\\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\\\\r\\\\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\\\\r\\\\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\\\\r\\\\n *\\\\r\\\\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\\\\r\\\\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\\\\r\\\\n *\\\\r\\\\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\\\\r\\\\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\\\\r\\\\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\\\\r\\\\n */\\\\r\\\\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\\\\r\\\\n\\\\r\\\\nexport type HighStrengthShearBarSize =\\\\r\\\\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\\\\r\\\\n\\\\r\\\\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\\\\r\\\\nexport const SHEAR_BAR_SIZES = [\\\\r\\\\n  ...BAR_SIZES,\\\\r\\\\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\\\\r\\\\n] as const\\\\r\\\\n\\\\r\\\\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\\\\r\\\\n\\\\r\\\\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯