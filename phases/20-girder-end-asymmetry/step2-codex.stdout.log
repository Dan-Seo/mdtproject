ount = Math.max(0, row.endCount - row.centerCount)\\\\\\\\\\\\\\\\n+  const centerOnlyCount = Math.max(\\\\\\\\\\\\\\\\n+    0,\\\\\\\\\\\\\\\\n+    row.centerCount - Math.max(startCount, row.endCount),\\\\\\\\\\\\\\\\n+  )\\\\\\\\\\\\\\\\n+  const oneSidedStartCount = Math.max(\\\\\\\\\\\\\\\\n+    0,\\\\\\\\\\\\\\\\n+    Math.min(startCount, row.centerCount) - row.endCount,\\\\\\\\\\\\\\\\n+  )\\\\\\\\\\\\\\\\n+  const oneSidedEndCount = Math.max(\\\\\\\\\\\\\\\\n+    0,\\\\\\\\\\\\\\\\n+    Math.min(row.centerCount, row.endCount) - startCount,\\\\\\\\\\\\\\\\n+  )\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\n+  if (oneSidedStartCount > 0) {\\\\\\\\\\\\\\\\n+    return {\\\\\\\\\\\\\\\\n+      throughCount,\\\\\\\\\\\\\\\\n+      startStubCount,\\\\\\\\\\\\\\\\n+      endStubCount,\\\\\\\\\\\\\\\\n+      centerOnlyCount,\\\\\\\\\\\\\\\\n+      oneSidedCount: oneSidedStartCount,\\\\\\\\\\\\\\\\n+      oneSidedAnchor: '始端',\\\\\\\\\\\\\\\\n+    }\\\\\\\\\\\\\\\\n+  }\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\n+  if (oneSidedEndCount > 0) {\\\\\\\\\\\\\\\\n+    return {\\\\\\\\\\\\\\\\n+      throughCount,\\\\\\\\\\\\\\\\n+      startStubCount,\\\\\\\\\\\\\\\\n+      endStubCount,\\\\\\\\\\\\\\\\n+      centerOnlyCount,\\\\\\\\\\\\\\\\n+      oneSidedCount: oneSidedEndCount,\\\\\\\\\\\\\\\\n+      oneSidedAnchor: '終端',\\\\\\\\\\\\\\\\n+    }\\\\\\\\\\\\\\\\n+  }\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\n+  return {\\\\\\\\\\\\\\\\n+    throughCount,\\\\\\\\\\\\\\\\n+    startStubCount,\\\\\\\\\\\\\\\\n+    endStubCount,\\\\\\\\\\\\\\\\n+    centerOnlyCount,\\\\\\\\\\\\\\\\n+    oneSidedCount: 0,\\\\\\\\\\\\\\\\n+  }\\\\\\\\\\\\\\\\n+}\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\n export interface GirderSection {\\\\\\\\\\\\\\\\n   id: string\\\\\\\\\\\\\\\\n   kind: '大梁'\\\\\\\\\\\\\\\\ndiff --git a/src/domain/model/project.test.ts b/src/domain/model/project.test.ts\\\\\\\\\\\\\\\\nindex 09c5dfd..4ef8004 100644\\\\\\\\\\\\\\\\n--- a/src/domain/model/project.test.ts\\\\\\\\\\\\\\\\n+++ b/src/domain/model/p