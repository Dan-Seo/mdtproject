                                       \\\"clearLengthsMm\\\":  [\\r\\n                                                                      5200,\\r\\n                                                                      5200\\r\\n                                                                  ],\\r\\n                                               \\\"intermediateSupportLengthsMm\\\":  [\\r\\n                                                                                    800\\r\\n                                                                                ],\\r\\n                                               \\\"halfSupportWidthPerSideMm\\\":  400,\\r\\n                                               \\\"expectedCoreLengthMm\\\":  11200,\\r\\n                                               \\\"note\\\":  \\\"梁の長さ(内法)の和 ＋ 中間柱の両側それぞれ柱幅の1/2 ＝ 5200＋5200＋400＋400。中間支点に定着は付かない\\\"\\r\\n                                           },\\r\\n                  \\\"continuousSlabMain\\\":  {\\r\\n                                             \\\"clause\\\":  \\\"2（４）床板1)\\\",\\r\\n                                             \\\"label\\\":  \\\"同一径の主筋が中間大梁を通して連続する2ベイ\\\",\\r\\n                                             \\\"clearLengthsMm\\\":  [\\r\\n                                                                    5600,\\r\\n                                                                    5600\\r\\n                                                                ],\\r\\n                                             \\\"intermediateSupportLengthsMm\\\":  [\\r\\n                                                                                  400\\r\\n                                                                              ],\\r\\n                                             \\\"halfSupportWidthPerSideMm\\\":  200,\\r\\n                                             \\\"expectedCoreLengthMm\\\":  11600,\\r\\n                                             \\\"note\\\":