del/member.ts-196-  }\r\nsrc/domain/model/member.ts-197-  /**\r\n--\nsrc/domain/model/member.ts-325- */\r\nsrc/domain/model/member.ts-326-export function sectionMarkLabel(section: Section): string {\r\nsrc/domain/model/member.ts-327-  return section.storyLabel\r\nsrc/domain/model/member.ts-328-    ? `${section.mark}(${section.storyLabel})`\r\nsrc/domain/model/member.ts-329-    : section.mark\r\nsrc/domain/model/member.ts-330-}\r\nsrc/domain/model/member.ts-331-\r\nsrc/domain/model/member.ts-332-export interface ColumnPosition {\r\nsrc/domain/model/member.ts-333-  ix: number\r\nsrc/domain/model/member.ts-334-  iy: number\r\nsrc/domain/model/member.ts-335-}\r\nsrc/domain/model/member.ts-336-\r\nsrc/domain/model/member.ts:337:export interface GirderPosition {\r\nsrc/domain/model/member.ts-338-  axis: 'X' | 'Y'\r\nsrc/domain/model/member.ts-339-  ix: number\r\nsrc/domain/model/member.ts-340-  iy: number\r\nsrc/domain/model/member.ts-341-}\r\nsrc/domain/model/member.ts-342-\r\nsrc/domain/model/member.ts-343-/**\r\nsrc/domain/model/member.ts-344- * 耐震壁の位置。大梁と同じく通り芯の1スパン分の辺を占めるので形も同じである。\r\nsrc/domain/model/member.ts-345- *\r\nsrc/domain/model/member.ts-346- * TypeScript は構造的型付けなので、別名を作っても型としては GirderPosition と\r\nsrc/domain/model/member.ts-347- * 区別されない — どちらであるかを決めるのは常に `Member.kind` の方だ。位置だけを\r\nsrc/domain/model/member.ts-348- * 見て部材種別を判定するコードを書かないこと。\r\nsrc/domain/model/member.ts-349- */\r\nsrc/domain/model/member.ts-350-export type WallPosition = GirderPosition\r\nsrc/domain/model/member.ts-351-\r\nsrc/domain/model/member.ts-352-/**\r\nsrc/domain/model/member.ts-353- * 床板の位置 — 通り芯で囲まれた1ベイを占める。(ix, iy) はそのベイの原点側\r\nsrc/domain/model/member.ts-354- * （X・Y とも小さい側）の格子点で、ベイは (ix, iy)〜(ix+1, iy+1) である。\r\nsrc/domain/model/member.ts-355- *\r\nsrc/domain/model/member.ts-356- * 柱の ColumnPosition と形は同じだが指すものが違う（格子点かベイか）。\r\nsrc/domain/model/member.ts-357- * TypeScript は構造的型付けなので型では区別されない — どちらであるかを\r\nsrc/domain/model/member.ts-358- * 決めるのは常に `Member.kind` の方だ。\r\nsrc/domain/mod