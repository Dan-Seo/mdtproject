Sel = initialSelection(initialProject)\r\n65: \r\n66: /** 選択が指す部材の階。指す部材が無ければ最初の階に戻す。 */\r\n67: function storyOf(project: Project, selection: Selection): string {\r\n68:   return (\r\n69:     project.members.find(({ id }) => id === selection.memberId)?.storyId ??\r\n70:     project.stories[0].id\r\n71:   )\r\n72: }\r\n73: \r\n74: export const useAppStore = create<AppState>((set) => ({\r\n75:   project: initialProject,\r\n76:   sel: initialSel,\r\n77:   hoverRowId: null,\r\n78:   locale: 'ja',\r\n79:   activeStoryId: storyOf(initialProject, initialSel),\r\n80:   viewerMode: 'member',\r\n81:   viewerLayers: { main: true, hoop: true, concrete: true },\r\n82:   selectMember(memberId) {\r\n83:     set(({ project }) => {\r\n84:       const member = findMember(project, memberId)\r\n85:       return {\r\n86:         sel: {\r\n87:           group: memberGroupKey(project, member),\r\n88:           memberId: member.id,\r\n89:         },\r\n90:         activeStoryId: member.storyId,\r\n91:       }\r\n92:     })\r\n93:   },\r\n94:   selectGroup(groupId, memberId) {\r\n95:     set(({ project }) => {\r\n96:       const member = findMember(project, memberId)\r\n97:       return {\r\n98:         sel: { group: groupId, memberId: member.id },\r\n99:         activeStoryId: member.storyId,\r\n100:       }\r\n101:     })\r\n102:   },\r\n103:   setHoverRow(rowId) {\r\n104:     set({ hoverRowId: rowId })\r\n105:   },\r\n106:   setLocale(locale) {\r\n107:     set({ locale })\r\n108:   },\r\n109:   setActiveStory(storyId) {\r\n110:     set({ activeStoryId: storyId })\r\n111:   },\r\n112:   setViewerMode(mode) {\r\n113:     set({ viewerMode: mode })\r\n114:   },\r\n115:   toggleViewerLayer(layer) {\r\n116:     set(({ viewerLayers }) => ({\r\n117:       viewerLayers: {\r\n118:         ...viewerLayers,\r\n119:         [layer]: !viewerLayers[layer],\r\n120:       },\r\n121:     }))\r\n122:   },\r\n123:   updateProject(updater) {\r\n124:     set(({ project }) => ({ project: updater(project) }))\r