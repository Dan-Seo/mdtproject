nId && section.kind === kind,\n275:   )\n276: }\n277: \n278: /**\n279:  * 壁を置いたときに wallSpan が内法を決められるかを判定する。\n280:  *\n281:  * 既存の部材の有無や符号は見ない。符号から作る id の重複は配置操作側の\n282:  * 責務であり、別の符号の壁を同じ辺に置くことをここで禁じない (ADR-038)。\n283:  */\n284: export function canPlaceWall(\n285:   project: Project,\n286:   storyId: string,\n287:   position: GirderPosition,\n288: ): boolean {\n289:   if (!isGridEdgePosition(project.grid, position)) return false\n290: \n291:   const story = project.stories.find(({ id }) => id === storyId)\n292:   const endIx = position.axis === 'X' ? position.ix + 1 : position.ix\n293:   const endIy = position.axis === 'Y' ? position.iy + 1 : position.iy\n294:   const startColumn = columnAt(project, storyId, position.ix, position.iy)\n295:   const endColumn = columnAt(project, storyId, endIx, endIy)\n296:   const upperGirder = girderAt(project, storyId, position)\n297: \n298:   if (\n299:     story === undefined ||\n300:     startColumn === undefined ||\n301:     endColumn === undefined ||\n302:     upperGirder === undefined ||\n303:     !sectionHasKind(project, startColumn, '柱') ||\n304:     !sectionHasKind(project, endColumn, '柱') ||\n305:     !sectionHasKind(project, upperGirder, '大梁')\n306:   ) {\n307:     return false\n308:   }\n309: \n310:   const startSection = project.sections.find(\n311:     (section) => section.id === startColumn.sectionId,\n312:   )\n313:   const endSection = project.sections.find(\n314:     (section) => section.id === endColumn.sectionId,\n315:   )\n316:   const upperSection = project.sections.find(\n317:     (section) => section.id === upperGirder.sectionId,\n318:   )\n319:   if (\n320:     startSection?.kind !== '柱' ||\n321:     endSection?.kind !== '柱' ||\n322:     upperSection?.kind !== '大梁'\n323:   ) {\n324:     return false\n325:   }\n326: \n327:   const startPoint = gridPoint(project.grid, position.ix, position.iy)\n328:   const endPoint = gridPoint(project.grid, endIx, endIy)\n329:   const centerSpan =\n330:     position.axis === 'X'\n331:       ? endPoint.x - startPoint.x\n332:       : endPoint.y - startPoint.y\n333:   const startSupportLength =\n334:     position.axis === 'X' ? startSection.b : startSection.d\n335:   const endSupportLength =\n336:     position.axis === 'X' ? endSection.b : endSection.d\n337:   const clearLength =\n338:     centerSpan - startSupportLength / 2 - endSupportLength / 2\n339:   const clearHeight = story.height - upperSection.depth\n340: \n341:   return clearLength > 0 && clearHeight > 0\n342: }\n343: \n344: /**\n345:  * 지정한 階에서 실제 내법을 계산할 수 있는 벽 辺 후보를 반환한다.\n346:  * 반환값은 기하 후보이며, 같은 符号로 만든 id 중복은 이 함수에서 판정하지 않는다.\n347:  */\n348: export function placeableWallPositions(\n349:   project: Project,\n350:   storyId: string,\n351: ): GirderPosition[] {\n352:   const { nx, ny } = gridPointCount(project.grid)\n353:   const positions: GirderPosition[] = []\n354: \n355:   for (const axis of ['X', 'Y'] as const) {\n356:     const ixLimit = axis === 'X' ? nx - 1 : nx\n357:     const iyLimit = axis === 'Y' ? ny - 1 : ny\n358:     for (let iy = 0; iy < iyLimit; iy += 1) {\n359:       for (let ix = 0; ix < ixLimit; ix += 1) {\n360:         const position = { axis, ix, iy }\n361:         if (canPlaceWall(project, storyId, position)) {\n362:           positions.push(position)\n363:         }\n364:       }\n365:     }\n366:   }\n367: \n368:   return positions\n369: }\n370: \n371: function slabSupports(\n372:   project: Project,\n373:   storyId: string,\n374:   position: SlabPosition,\n375: ): {\n376:   minX: Member\n377:   maxX: Member\n378:   minY: Member\n379:   maxY: Member\n380: } | undefined {\n381:   const supports = {\n382:     minX: girderAt(project, storyId, {\n383:       axis: 'Y',\n384:       ix: position.ix,\n385:       iy: position.iy,\n386:     }),\n387:     maxX: girderAt(project, storyId, {\n388:       axis: 'Y',\n389:       ix: position.ix + 1,\n390:       iy: position.iy,\n391:     }),\n392:     minY: girderAt(project, storyId, {\n393:       axis: 'X',\n394:       ix: position.ix,\n395:       iy: position.iy,\n396:     }),\n397:     maxY: girderAt(project, storyId, {\n398:       axis: 'X',\n399:       ix: position.ix,\n400:       iy: position.iy + 1,\n401:     }),\n402:   }\n403: \n404:   if (\n405:     supports.minX === undefined ||\n406:     supports.maxX === undefined ||\n407:     supports.minY === undefined ||\n408:     supports.maxY === undefined ||\n409:     !sectionHasKind(project, supports.minX, '大梁') ||\n410:     !sectionHasKind(project, supports.maxX, '大梁') ||\n411:     !sectionHasKind(project, supports.minY, '大梁') ||\n412:     !sectionHasKind(project, supports.maxY, '大梁')\n413:   ) {\n414:     return undefined\n415:   }\n416: \n417:   return {\n418:     minX: supports.minX,\n419:     maxX: supports.maxX,\n420:     minY: supports.minY,\n421:     maxY: supports.maxY,\n422:   }\n423: }\n424: \n425: /**\n426:  * 床板을 놓았을 때 slabBay가 네 변의 내법을 계산할 수 있는지 판정한다.\n427:  * 개별 符号에서 유도되는 id 중복은 이 기하 판정의 대상이 아니다 (ADR-038).\n428:  */\n429: export function canPlaceSlab(\n430:   project: Project,\n431:   storyId: string,\n432:   position: SlabPosition,\n433: ): boolean {\n434:   const { nx, ny } = gridPointCount(project.grid)\n435:   if (!project.stories.some(({ id }) => id === storyId)) return false\n436:   if (isGirderPosition(position)) return false\n437: \n438:   if (\n439:     !Number.isInteger(position.ix) ||\n440:     !Number.isInteger(position.iy) ||\n441:     position.ix < 0 ||\n442:     position.iy < 0 ||\n443:     position.ix >= nx - 1 ||\n444:     position.iy >= ny - 1\n445:   ) {\n446:     return false\n447:   }\n448: \n449:   const supports = slabSupports(project, storyId, position)\n450:   if (supports === undefined) return false\n451: \n452:   const supportSections = {\n453:     minX: project.sections.find(\n454:       (section) => section.id === supports.minX.sectionId,\n455:     ),\n456:     maxX: project.sections.find(\n457:       (section) => section.id === supports.maxX.sectionId,\n458:     ),\n459:     minY: project.sections.find(\n460:       (section) => section.id === supports.minY.sectionId,\n461:     ),\n462:     maxY: project.sections.find(\n463:       (section) => section.id === supports.maxY.sectionId,\n464:     ),\n465:   }\n466:   if (\n467:     supportSections.minX?.kind !== '大梁' ||\n468:     supportSections.maxX?.kind !== '大梁' ||\n469:     supportSections.minY?.kind !== '大梁' ||\n470:     supportSections.maxY?.kind !== '大梁'\n471:   ) {\n472:     return false\n473:   }\n474: \n475:   const origin = gridPoint(project.grid, position.ix, position.iy)\n476:   const far = gridPoint(project.grid, position.ix + 1, position.iy + 1)\n477:   const clearX =\n478:     far.x -\n479:     origin.x -\n480:     supportSections.minX.b / 2 -\n481:     supportSections.maxX.b / 2\n482:   const clearY =\n483:     far.y -\n484:     origin.y -\n485:     supportSections.minY.b / 2 -\n486:     supportSections.maxY.b / 2\n487: \n488:   return clearX > 0 && clearY > 0\n489: }\n490: \n491: /** 지정한 階에서 네 변의 大梁가 모두 있는 床板 ベイ 후보를 반환한다. */\n492: export function placeableSlabPositions(\n493:   project: Project,\n494:   storyId: string,\n495: ): SlabPosition[] {\n496:   const { nx, ny } = gridPointCount(project.grid)\n497:   const positions: SlabPosition[] = []\n498: \n499:   for (let iy = 0; iy < ny - 1; iy += 1) {\n500:     for (let ix = 0; ix < nx - 1; ix += 1) {\n501:       const position = { ix, iy }\n502:       if (canPlaceSlab(project, storyId, position)) {\n503:         positions.push(position)\n504:       }\n505:     }\n506:   }\n507: \n508:   return positions\n509: }\n510: \r\n511: function touchesColumn(\r\n512:   girder: GirderPosition,\r\n513:   column: ColumnPosition,\r\n514: ): boolean {\r\n515:   if (girder.axis === 'X') {\r\n516:     return (\r\n517:       girder.iy === column.iy &&\r\n518:       (girder.ix === column.ix || girder.ix + 1 === column.ix)\r\n519:     )\r\n520:   }\r\n521: \r\n522:   return (\r\n523:     girder.ix === column.ix &&\r\n524:     (girder.iy === column.iy || girder.iy + 1 === column.iy)\r\n525:   )\r\n526: }\r\n527: \r\n528: export interface GirderSpan {\r\n529:   axis: 'X' | 'Y'\r\n530:   /** 그리드 교점 간 중심 스팬 (mm) */\r\n531:   centerSpan: number\r\n532:   /** 内法長さ (mm) — 양단 柱面 사이 */\r\n533:   clear: number\r\n534:   /** 시작 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n535:   startFaceOffsetMm: number\r\n536:   /** 끝 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n537:   endFaceOffsetMm: number\r\n538:   /** 정착 수용성 검사용 — 시작 柱의 축방향 전체 치수 (mm) */\r\n539:   startSupportLengthAlongAxisMm: number\r\n540:   /** 정착 수용성 검사용 — 끝 柱의 축방향 전체 치수 (mm) */\r\n--- src/domain/model/member.ts:360-430 ---\n360:   thickness: number\r\n361:   fc: number\r\n362:   grade: SteelGrade\r\n363:   finish: Finish\r\n364:   /** 主筋の継手方式。継手箇所数と設計長さへの算入を決める */\r\n365:   spliceMethod: SpliceMethod\r\n366:   /** X通り方向（X軸に沿って伸びる）の主筋 */\r\n367:   x: { top: SlabBarRow; bottom: SlabBarRow }\r\n368:   /** Y通り方向の主筋 */\r\n369:   y: { top: SlabBarRow; bottom: SlabBarRow }\r\n370: }\r\n371: \r\n372: export type Section =\r\n373:   | ColumnSection\r\n374:   | GirderSection\r\n375:   | WallSection\r\n376:   | SlabSection\r\n377: \r\n378: /**\r\n379:  * 화면 표시·aria-label용 이름. 같은 符号이 階별로 여러 断面이 될 수 있으므로\r\n380:  * 階를 여기서 붙인다 — 저장되는 `mark`는 도면의 符号 그대로 둔다.\r\n381:  */\r\n382: export function sectionMarkLabel(section: Section): string {\r\n383:   return section.storyLabel\r\n384:     ? `${section.mark}(${section.storyLabel})`\r\n385:     : section.mark\r\n386: }\r\n387: \r\n388: export interface ColumnPosition {\r\n389:   ix: number\r\n390:   iy: number\r\n391: }\r\n392: \r\n393: export interface GirderPosition {\r\n394:   axis: 'X' | 'Y'\r\n395:   ix: number\r\n396:   iy: number\r\n397: }\r\n398: \r\n399: /**\r\n400:  * 耐震壁の位置。大梁と同じく通り芯の1スパン分の辺を占めるので形も同じである。\r\n401:  *\r\n402:  * TypeScript は構造的型付けなので、別名を作っても型としては GirderPosition と\r\n403:  * 区別されない — どちらであるかを決めるのは常に `Member.kind` の方だ。位置だけを\r\n404:  * 見て部材種別を判定するコードを書かないこと。\r\n405:  */\r\n406: export type WallPosition = GirderPosition\r\n407: \r\n408: /**\r\n409:  * 床板の位置 — 通り芯で囲まれた1ベイを占める。(ix, iy) はそのベイの原点側\r\n410:  * （X・Y とも小さい側）の格子点で、ベイは (ix, iy)〜(ix+1, iy+1) である。\r\n411:  *\r\n412:  * 柱の ColumnPosition と形は同じだが指すものが違う（格子点かベイか）。\r\n413:  * TypeScript は構造的型付けなので型では区別されない — どちらであるかを\r\n414:  * 決めるのは常に `Member.kind` の方だ。\r\n415:  */\r\n416: export type SlabPosition = ColumnPosition\r\n417: \r\n418: /**\r\n419:  * 雑壁（腰壁・下り壁・袖壁）の内法範囲。設計図書からの部材単位の転記であり、\r\n420:  * 省略した軸は全内法を意味する。範囲を断面に置かないのは、同じ符号でも部材ごと\r\n421:  * に高さ・長さが違い得るためである (ADR-037)。\r\n422:  */\r\n423: export interface WallExtent {\r\n424:   vertical?: {\r\n425:     anchor: '下端' | '上端'\r\n426:     heightMm: number\r\n427:   }\r\n428:   horizontal?: {\r\n429:     anchor: '始端' | '終端'\r\n430:     lengthMm: number\r\n--- src/domain/model/sample-project.ts:90-260 ---\n90:       cutoffFromSupportFaceMm: 1500,\r\n91:     },\r\n92:     stirrup: { size: 'D13', pitch: 150, startOffsetMm: 50 },\r\n93:   },\r\n94: ]\r\n95: \r\n96: // 耐震壁 (ADR-025)。ラーメン構造の壁なので数量積算基準 2（５）壁1)「壁式構造以外」\r\n97: // で測る。屋内・仕上げありにしてあるのは柱・大梁と別のかぶりセル（表5.3.6 の\r\n98: // 「柱、梁、耐力壁」行・屋内）を通すためで、壁だけ条件を変えられることの例でもある。\r\n99: export const wallSection: WallSection = {\r\n100:   id: 'section-W1',\r\n101:   kind: '耐震壁',\r\n102:   mark: 'W1',\r\n103:   thickness: 200,\r\n104:   fc: 24,\r\n105:   grade: 'SD345',\r\n106:   exposure: '屋内',\r\n107:   finish: '仕上げあり',\r\n108:   spliceMethod: '重ね継手',\r\n109:   // 壁リストの「D13@200 ダブル」そのもの — 層数は規準ではなく図面の記載である。\r\n110:   layers: 2,\r\n111:   vertical: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n112:   horizontal: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n113: }\r\n114: \r\n115: /**\r\n116:  * 耐震壁は Y1〜Y2 の X1 通りに1枚だけ立てる。全スパンに入れると 3D が壁で埋まって\r\n117:  * 中の配筋が見えなくなり、「入力したものが合っているか」を確かめるという\r\n118:  * ビューアの用途 (ADR-016) を潰してしまう。\r\n119:  */\r\n120: function createWalls(storyId: string): Member[] {\r\n121:   return [\r\n122:     {\r\n123:       id: `${storyId}-W1-X1Y1-Y`,\r\n124:       kind: '耐震壁',\r\n125:       memberClass: '躯体',\r\n126:       sectionId: wallSection.id,\r\n127:       storyId,\r\n128:       position: { axis: 'Y', ix: 0, iy: 0 },\r\n129:     },\r\n130:   ]\r\n131: }\r\n132: \r\n133: /**\r\n134:  * 床板（スラブ）(ADR-028)。数量積算基準 2（４）床板 で測る。屋内・屋外の入力を\r\n135:  * 持たないのは表5.3.6 の「スラブ、耐力壁以外の壁」行に区別がないからで、\r\n136:  * 仕上げありの 20mm がこの断面の最小かぶりになる — 柱・大梁の 30/40mm より薄い。\r\n137:  * X方向とY方向で別々に径・ピッチを受け取る。スラブリストの「D13@200 タテヨコ」\r\n138:  * という記載そのものであって、規準側に本数を定める条文はない (ADR-012)。\r\n139:  */\r\n140: export const slabSection: SlabSection = {\r\n141:   id: 'section-S1',\r\n142:   kind: '床板',\r\n143:   mark: 'S1',\r\n144:   thickness: 200,\r\n145:   fc: 24,\r\n146:   grade: 'SD345',\r\n147:   finish: '仕上げあり',\r\n148:   spliceMethod: '重ね継手',\r\n149:   x: {\r\n150:     top: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n151:     bottom: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n152:   },\r\n153:   y: {\r\n154:     top: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n155:     bottom: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n156:   },\r\n157: }\r\n158: \r\n159: /**\r\n160:  * 床板は通り芯で囲まれた全ベイに置く。壁と違って全部置くのは、床板が階の\r\n161:  * 天井面にしかなく下の配筋を隠さないからだ（壁は立ち上がって中を覆う）。\r\n162:  * Y方向に2ベイ並ぶので、同じサンプルの中に「連続する床板」（Y方向・2ベイ）と\r\n163:  * 「単独床板」（X方向・1ベイ）の両方が出る — 継手の条文が切り替わる境目を\r\n164:  * 画面で確かめられる。\r\n165:  */\r\n166: function createSlabs(storyId: string): Member[] {\r\n167:   const { nx, ny } = gridPointCount(sampleGrid)\r\n168:   const slabs: Member[] = []\r\n169: \r\n170:   for (let iy = 0; iy < ny - 1; iy += 1) {\r\n171:     for (let ix = 0; ix < nx - 1; ix += 1) {\r\n172:       slabs.push({\r\n173:         id: `${storyId}-S1-X${ix + 1}Y${iy + 1}`,\r\n174:         kind: '床板',\r\n175:         memberClass: '躯体',\r\n176:         sectionId: slabSection.id,\r\n177:         storyId,\r\n178:         position: { ix, iy },\r\n179:       })\r\n180:     }\r\n181:   }\r\n182: \r\n183:   return slabs\r\n184: }\r\n185: \r\n186: function createColumns(storyId: string): Member[] {\r\n187:   const { nx, ny } = gridPointCount(sampleGrid)\r\n188:   const columns: Member[] = []\r\n189: \r\n190:   for (let iy = 0; iy < ny; iy += 1) {\r\n191:     for (let ix = 0; ix < nx; ix += 1) {\r\n192:       columns.push({\r\n193:         id: `${storyId}-X${ix + 1}Y${iy + 1}`,\r\n194:         kind: '柱',\r\n195:         memberClass: '躯体',\r\n196:         sectionId: columnSection.id,\r\n197:         storyId,\r\n198:         position: { ix, iy },\r\n199:       })\r\n200:     }\r\n201:   }\r\n202: \r\n203:   return columns\r\n204: }\r\n205: \r\n206: function createGirders(storyId: string): Member[] {\r\n207:   const { nx, ny } = gridPointCount(sampleGrid)\r\n208:   const girders: Member[] = []\r\n209: \r\n210:   for (let iy = 0; iy < ny; iy += 1) {\r\n211:     const mark = iy === 1 ? 'G2' : 'G1'\r\n212:     for (let ix = 0; ix < nx - 1; ix += 1) {\r\n213:       girders.push({\r\n214:         id: `${storyId}-${mark}-X${ix + 1}Y${iy + 1}-X`,\r\n215:         kind: '大梁',\r\n216:         memberClass: '躯体',\r\n217:         sectionId: `section-${mark}`,\r\n218:         storyId,\r\n219:         position: { axis: 'X', ix, iy },\r\n220:       })\r\n221:     }\r\n222:   }\r\n223: \r\n224:   for (let ix = 0; ix < nx; ix += 1) {\r\n225:     const mark = ix === 1 ? 'G2' : 'G1'\r\n226:     for (let iy = 0; iy < ny - 1; iy += 1) {\r\n227:       girders.push({\r\n228:         id: `${storyId}-${mark}-X${ix + 1}Y${iy + 1}-Y`,\r\n229:         kind: '大梁',\r\n230:         memberClass: '躯体',\r\n231:         sectionId: `section-${mark}`,\r\n232:         storyId,\r\n233:         position: { axis: 'Y', ix, iy },\r\n234:       })\r\n235:     }\r\n236:   }\r\n237: \r\n238:   return girders\r\n239: }\r\n240: \r\n241: export function createSampleProject(): Project {\r\n242:   return {\r\n243:     schemaVersion: PROJECT_SCHEMA_VERSION,\r\n244:     name: 'サンプル案件 / RC 2階建て',\r\n245:     grid: sampleGrid,\r\n246:     stories: sampleStories,\r\n247:     sections: [columnSection, ...girderSections, wallSection, slabSection],\r\n248:     members: sampleStorie