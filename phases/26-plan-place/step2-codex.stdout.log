+\n+    const placed = useAppStore\n+      .getState()\n+      .project.members.find(({ id }) => id === '1F-W1-0-0-X')\n+    expect(placed).toMatchObject({\n+      id: '1F-W1-0-0-X',\n+      kind: '耐震壁',\n+      memberClass: '躯体',\n+      sectionId: 'section-W1',\n+      storyId: '1F',\n+      position: { axis: 'X', ix: 0, iy: 0 },\n+    })\n+    expect(screen.queryByTestId('placement-wall-X-0-0')).not.toBeInTheDocument()\n+  })\n+\n+  it('places 床板 only in an empty bay surrounded by four 大梁', () => {\n+    const project = createSampleProject()\n+    setProject({\n+      ...project,\n+      members: project.members.filter(({ kind }) => kind !== '床板'),\n+    })\n+    render(<PlanEditor />)\n+\n+    fireEvent.click(screen.getByTestId('placement-slab-0-0'))\n+\n+    expect(\n+      useAppStore\n+        .getState()\n+        .project.members.find(({ id }) => id === '1F-S1-0-0'),\n+    ).toMatchObject({\n+      kind: '床板',\n+      memberClass: '躯体',\n+      sectionId: 'section-S1',\n+      position: { ix: 0, iy: 0 },\n+    })\n+  })\n+\n+  it('does not offer a wall edge when its 大梁 or endpoint 柱 is absent', () => {\n+    const project = createSampleProject()\n+    const withoutGirder = project.members.filter(\n+      ({ id }) => id !== '1F-G1-X1Y1-X',\n+    )\n+    setProject({\n+      ...project,\n+      members: withoutGirder.filter(({ kind }) => kind !== '耐震壁'),\n+    })\n+    const { rerender } = render(<PlanEditor />)\n+    expect(screen.queryByTestId('placement-wall-X-0-0')).not.toBeInTheDocument()\n+\n+    setProject({\n+      ...project,\n+      members: project.members.filter(\n+        ({ id, kind }) => id !== '1F-X1Y1' && kind !== '耐震壁',\n+      ),\n+    })\n+    rerender(<PlanEditor />)\n+    expect(screen.queryByTestId('placement-wall-X-0-0')).not.toBeInTheDocument()\n+  })\n+\n+  it('does not offer a bay when one of its four surrounding 大梁 is absent', () => {\n+    const project = createSampleProject()\n+    setProject({\n+      ...project,\n+      members: project.members.filter(\n+        ({ id, kind }) => id !== '1F-G1-X1Y1-X' && kind !== '床板',\n+      ),\n+    })\n+    render(<PlanEditor />)\n+\n+    expect(screen.queryByTestId('placement-slab-0-0')).not.toBeInTheDocument()\n+  })\n+\n+  it('shows only section guidance and no candidates when a section kind is absent', () => {\n+    const project = createSampleProject()\n+    setProject({\n+      ...project,\n+      sections: project.sections.filter(({ kind }) => kind !== '耐震壁'),\n+      members: project.members.filter(({ kind }) => kind !== '耐震壁'),\n+    })\n+    render(<PlanEditor />)\n+\n+    expect(screen.getByTestId('placement-wall-no-section')).toBeInTheDocument()\n+    expect(screen.queryByTestId('placement-wall-X-0-0')).not.toBeInTheDocument()\n+  })\n+\n+  it('rejects a second placement with the same position and 符号', () => {\n+    const project = createSampleProject()\n+    const withoutWalls = {\n+      ...project,\n+      members: project.members.filter(({ kind }) => kind !== '耐震壁'),\n+    }\n+    const first = placePlanMember(withoutWalls, '1F', 'section-W1', {\n+      axis: 'X',\n+      ix: 0,\n+      iy: 0,\n+    })\n+    expect(first.member).toBeDefined()\n+\n+    const second = placePlanMember(first.project, '1F', 'section-W1', {\n+      axis: 'X',\n+      ix: 0,\n+      iy: 0,\n+    })\n+    expect(second.reason).toBe('duplicate')\n+    expect(second.project.members).toHaveLength(first.project.members.length)\n+  })\n+\n+  it('deletes the selected wall, including its openings and wallExtent, without changing other members', () => {\n+    const project = createSampleProject()\n+    const wall = project.members.find(({ kind }) => kind === '耐震壁')!\n+    const withDetails = {\n+      ...project,\n+      members: project.members.map((member) =>\n+        member.id === wall.id\n+          ? {\n+              ...member,\n+              openings: [\n+                {\n+                  id: 'opening-to-delete',\n+                  xMm: 100,\n+                  yMm: 100,\n+                  widthMm: 800,\n+                  heightMm: 800,\n+                },\n+              ],\n+              wallExtent: {\n+                vertical: { anchor: '下端' as const, heightMm: 900 },\n+              },\n+            }\n+          : member,\n+      ),\n+    }\n+    setProject(withDetails)\n+    act(() => useAppStore.getState().selectMember(wall.id))\n+    render(<PlanEditor />)\n+\n+    const otherIds = withDetails.members\n+      .filter(({ id }) => id !== wall.id)\n+      .map(({ id }) => id)\n+    fireEvent.click(screen.getByTestId('delete-member'))\n+\n+    const state = useAppStore.getState()\n+    expect(state.project.members.find(({ id }) => id === wall.id)).toBeUndefined()\n+    expect(state.project.members.map(({ id }) => id)).toEqual(otherIds)\n+    expect(state.sel).toEqual({ group: null, memberId: null })\n+  })\n+\n+  it('deletes a selected 床板 and does not expose deletion for a selected 柱', () => {\n+    const project = createSampleProject()\n+    const slab = project.members.find(({ kind }) => kind === '床板')!\n+    setProject(project)\n+    act(() => useAppStore.getState().selectMember(slab.id))\n+    const { rerender } = render(<PlanEditor />)\n+\n+    expect(screen.getByTestId('delete-member')).toBeInTheDocument()\n+    fireEvent.click(screen.getByTestId('delete-member'))\n+    expect(\n+      useAppStore.getState().project.members.find(({ id }) => id === slab.id),\n+    ).toBeUndefined()\n+\n+    const column = useAppStore\n+      .getState()\n+      .project.members.find(({ kind }) => kind === '柱')!\n+    act(() => useAppStore.getState().selectMember(column.id))\n+    rerender(<PlanEditor />)\n+    expect(screen.queryByTestId('delete-member')).not.toBeInTheDocument()\n+  })\n+})\n+\n describe('PlanEditor 開口部の入力 (数量積算基準 1通則8))', () => {\n   beforeEach(() => {\n     capture.mockClear()\ndiff --git a/src/components/plan/PlanEditor.tsx b/src/components/plan/PlanEditor.tsx\nindex 162b6a8..5689a8f 100644\n--- a/src/components/plan/PlanEditor.tsx\n+++ b/src/components/plan/PlanEditor.tsx\n@@ -5,14 +5,19 @@ import { useRef, useState, type KeyboardEvent } from 'react'\n import {\n   BAR_SIZES,\n   type BarSize,\n+  type GirderPosition,\n   type Member,\n   type Opening,\n   type OpeningReinforcement,\n+  type Section,\n+  type SlabPosition,\n   type WallExtent,\n } from '@/domain/model/member'\n import {\n   findSection,\n   gridPoint,\n+  placeableSlabPositions,\n+  placeableWallPositions,\n   slabBay,\n   storyNotFound,\n   wallSpan,\n@@ -531,6 +536,375 @@ function SpanEditor({ axis }: { axis: SpanAxis }) {\n   )\n }\n \n+type PlacementPosition = GirderPosition | SlabPosition\n+type PlacementFailure = 'section' | 'unavailable' | 'duplicate'\n+\n+export interface PlanPlacementResult {\n+  project: Project\n+  member?: Member\n+  reason?: PlacementFailure\n+}\n+\n+function placementMemberId(\n+  storyId: string,\n+  mark: string,\n+  position: PlacementPosition,\n+): string {\n+  const axis = 'axis' in position ? `-${position.axis}` : ''\n+  return `${storyId}-${mark}-${position.ix}-${position.iy}${axis}`\n+}\n+\n+function samePlacementPosition(\n+  member: Member,\n+  storyId: string,\n+  kind: '耐震壁' | '床板',\n+  position: PlacementPosition,\n+): boolean {\n+  if (member.storyId !== storyId || member.kind !== kind) return false\n+\n+  if (kind === '耐震壁') {\n+    if (!('axis' in member.position) || !('axis' in position)) return false\n+    return (\n+      member.position.axis === position.axis &&\n+      member.position.ix === position.ix &&\n+      member.position.iy === position.iy\n+    )\n+  }\n+\n+  if ('axis' in member.position || 'axis' in position) return false\n+  return (\n+    member.position.ix === position.ix && member.position.iy === position.iy\n+  )\n+}\n+\n+function hasMemberAtPlacement(\n+  project: Project,\n+  storyId: string,\n+  kind: '耐震壁' | '床板',\n+  position: PlacementPosition,\n+): boolean {\n+  return project.members.some((member) =>\n+    samePlacementPosition(member, storyId, kind, position),\n+  )\n+}\n+\n+/**\n+ * UI가 누를 수 있는 배치 한 건을 Project로 변환한다.\n+ *\n+ * 기하의 성립 여부는 step 1의 도메인 판정만 사용하고, 여기서는 UI가\n+ * 선택한 断面과 부재 id를 조합한다. duplicate 검사는 이벤트가 연속으로\n+ * 들어오거나 이미 취입된 案件을 편집하는 경우에도 같은 id가 늘지 않게\n+ * 하는 마지막 방어다.\n+ */\n+export function placePlanMember(\n+  project: Project,\n+  storyId: string,\n+  sectionId: string,\n+  position: PlacementPosition,\n+): PlanPlacementResult {\n+  const section = project.sections.find(({ id }) => id === sectionId)\n+  if (section === undefined) return { project, reason: 'section' }\n+\n+  const kind = section.kind\n+  if (kind !== '耐震壁' && kind !== '床板') {\n+    return { project, reason: 'section' }\n+  }\n+\n+  const placeable =\n+    kind === '耐震壁'\n+      ? 'axis' in position &&\n+        placeableWallPositions(project, storyId).some(\n+          (candidate) =>\n+            candidate.axis === position.axis &&\n+            candidate.ix === position.ix &&\n+            candidate.iy === position.iy,\n+        )\n+      : !('axis' in position) &&\n+        placeableSlabPositions(project, storyId).some(\n+          (candidate) =>\n+            candidate.ix === position.ix && candidate.iy === position.iy,\n+        )\n+\n+  if (!placeable) return { project, reason: 'unavailable' }\n+\n+  const id = placementMemberId(storyId, section.mark, position)\n+  if (project.members.some((member) => member.id === id)) {\n+    return { project, reason: 'duplicate' }\n+  }\n+\n+  const member: Member = {\n+    id,\n+    kind,\n+    memberClass: '躯体',\n+    sectionId: section.id,\n+    storyId,\n+    position,\n+  }\n+\n+  return {\n+    project: { ...project, members: [...project.members, member] },\n+    member,\n+  }\n+}\n+\n+function placementAxisLabel(\n+  project: Project,\n+  axis: 'X' | 'Y',\n+  index: number,\n+): string {\n+  const labels = axis === 'X' ? project.grid.xLabels : project.grid.yLabels\n+  return labels?.[index] ?? `${axis}${index + 1}`\n+}\n+\n+function placementLabel(\n+  project: Project,\n+  position: PlacementPosition,\n+): string {\n+  if ('axis' in position) {\n+    if (position.axis === 'Y') {\n+      return `${placementAxisLabel(project, 'X', position.ix)} / ${placementAxisLabel(project, 'Y', position.iy)}-${placementAxisLabel(project, 'Y', position.iy + 1)}`\n+    }\n+    return `${placementAxisLabel(project, 'X', position.ix)}-${placementAxisLabel(project, 'X', position.ix + 1)} / ${placementAxisLabel(project, 'Y', position.iy)}`\n+  }\n+\n+  return `${placementAxisLabel(project, 'X', position.ix)}-${placementAxisLabel(project, 'X', position.ix + 1)} / ${placementAxisLabel(project, 'Y', position.iy)}-${placementAxisLabel(project, 'Y', position.iy + 1)}`\n+}\n+\n+function removePlanMember(project: Project, memberId: string): Project {\n+  return {\n+    ...project,\n+    members: project.members.filter(({ id }) => id !== memberId),\n+  }\n+}\n+\n+function PlacementEditor() {\n+  const project = useAppStore(({ project }) => project)\n+  const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\n+  const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\n+  const locale = useAppStore(({ locale }) => locale)\n+  const [wallSectionSelection, setWallSectionSelection] = useState<string>()\n+  const [slabSectionSelection, setSlabSectionSelection] = useState<string>()\n+  const [placementError, setPlacementError] = useState<PlacementFailure>()\n+\n+  const wallSections = project.sections.filter(\n+    (section): section is Extract<Section, { kind: '耐震壁' }> =>\n+      section.kind === '耐震壁',\n+  )\n+  const slabSections = project.sections.filter(\n+    (section): section is Extract<Section, { kind: '床板' }> =>\n+      section.kind === '床板',\n+  )\n+  const wallSectionId = wallSections.some(\n+    ({ id }) => id === wallSectionSelection,\n+  )\n+    ? wallSectionSelection\n+    : wallSections[0]?.id\n+  const slabSectionId = slabSections.some(\n+    ({ id }) => id === slabSectionSelection,\n+  )\n+    ? slabSectionSelection\n+    : slabSections[0]?.id\n+  const wallPositions =\n+    wallSectionId === undefined\n+      ? []\n+      : placeableWallPositions(project, activeStoryId).filter(\n+          (position) =>\n+            !hasMemberAtPlacement(project, activeStoryId, '耐震壁', position),\n+        )\n+  const slabPositions =\n+    slabSectionId === undefined\n+      ? []\n+      : placeableSlabPositions(project, activeStoryId).filter(\n+          (position) =>\n+            !hasMemberAtPlacement(project, activeStoryId, '床板', position),\n+        )\n+\n+  const place = (sectionId: string | undefined, position: PlacementPosition) => {\n+    if (sectionId === undefined) return\n+\n+    let result: PlanPlacementResult | undefined\n+    useAppStore.setState((state) => {\n+      result = placePlanMember(state.project, activeStoryId, sectionId, position)\n+      return result.member === undefined ? {} : { project: result.project }\n+    })\n+\n+    if (result?.member === undefined) {\n+      setPlacementError(result?.reason)\n+      return\n+    }\n+\n+    setPlacementError(undefined)\n+    useAppStore.getState().selectMember(result.member.id)\n+  }\n+\n+  const selectedMember = project.members.find(\n+    ({ id }) => id === selectedMemberId,\n+  )\n+  const canDelete =\n+    selectedMember?.kind === '耐震壁' || selectedMember?.kind === '床板'\n+  const selectedSection =\n+    selectedMember === undefined\n+      ? undefined\n+      : project.sections.find(({ id }) => id === selectedMember.sectionId)\n+\n+  const deleteSelected = () => {\n+    if (!selectedMember || !canDelete) return\n+    useAppStore.setState((state) => ({\n+      project: removePlanMember(state.project, selectedMember.id),\n+      sel: { group: null, memberId: null },\n+    }))\n+    setPlacementError(undefined)\n+  }\n+\n+  const failureMessage =\n+    placementError === 'duplicate'\n+      ? t(locale, 'plan.placement.duplicate')\n+      : placementError === 'unavailable'\n+        ? t(locale, 'plan.placement.unavailable')\n+        : placementError === 'section'\n+          ? t(locale, 'plan.placement.sectionMissing')\n+          : null\n+\n+  return (\n+    <section className={styles.placementEditor} data-testid=\"placement-editor\">\n+      <div className={styles.placementGroups}>\n+        <fieldset className={styles.placementGroup}>\n+          <legend className={styles.spanLegend}>\n+            {t(locale, 'plan.placement.wall.title')}\n+          </legend>\n+          {wallSections.length === 0 ? (\n+            <p\n+              className={styles.openingHint}\n+              data-testid=\"placement-wall-no-section\"\n+            >\n+              {t(locale, 'plan.placement.wall.sectionMissing')}\n+            </p>\n+          ) : (\n+            <>\n+              <label className={styles.placementLabel}>\n+                <span>{t(locale, 'plan.placement.section')}</span>\n+                <select\n+                  className={styles.placementSelect}\n+                  data-testid=\"placement-wall-section\"\n+                  value={wallSectionId ?? ''}\n+                  onChange={(event) =>\n+                    setWallSectionSelection(event.currentTarget.value)\n+                  }\n+                >\n+                  {wallSections.map((section) => (\n+                    <option key={section.id} value={section.id}>\n+                      {section.mark}\n+                    </option>\n+                  ))}\n+                </select>\n+              </label>\n+              <div className={styles.placementCandidates}>\n+                {wallPositions.length === 0 ? (\n+                  <p className={styles.openingHint}>\n+                    {t(locale, 'plan.placement.empty')}\n+                  </p>\n+                ) : (\n+                  wallPositions.map((position) => (\n+                    <button\n+                      key={`wall-${position.axis}-${position.ix}-${position.iy}`}\n+                      type=\"button\"\n+                      className={styles.placementCandidate}\n+                      data-testid={`placement-wall-${position.axis}-${position.ix}-${position.iy}`}\n+                      onClick={() => place(wallSectionId, position)}\n+                    >\n+                      {placementLabel(project, position)}\n+                    </button>\n+                  ))\n+                )}\n+              </div>\n+            </>\n+          )}\n+        </fieldset>\n+\n+        <fieldset className={styles.placementGroup}>\n+          <legend className={styles.spanLegend}>\n+            {t(locale, 'plan.placement.slab.title')}\n+          </legend>\n+          {slabSections.length === 0 ? (\n+            <p\n+              className={styles.openingHint}\n+              data-testid=\"placement-slab-no-section\"\n+            >\n+              {t(locale, 'plan.placement.slab.sectionMissing')}\n+            </p>\n+          ) : (\n+            <>\n+              <label className={styles.placementLabel}>\n+                <span>{t(locale, 'plan.placement.section')}</span>\n+                <select\n+                  className={styles.placementSelect}\n+                  data-testid=\"placement-slab-section\"\n+                  value={slabSectionId ?? ''}\n+                  onChange={(event) =>\n+                    setSlabSectionSelection(event.currentTarget.value)\n+                  }\n+                >\n+                  {slabSections.map((section) => (\n+                    <option key={section.id} value={section.id}>\n+                      {section.mark}\n+                    </option>\n+                  ))}\n+                </select>\n+              </label>\n+              <div className={styles.placementCandidates}>\n+                {slabPositions.length === 0 ? (\n+                  <p className={styles.openingHint}>\n+                    {t(locale, 'plan.placement.empty')}\n+                  </p>\n+                ) : (\n+                  slabPositions.map((position) => (\n+                    <button\n+                      key={`slab-${position.ix}-${position.iy}`}\n+                      type=\"button\"\n+                      className={styles.placementCandidate}\n+                      data-testid={`placement-slab-${position.ix}-${position.iy}`}\n+                      onClick={() => place(slabSectionId, position)}\n+                    >\n+                      {placementLabel(project, position)}\n+                    </button>\n+                  ))\n+                )}\n+              </div>\n+            </>\n+          )}\n+        </fieldset>\n+      </div>\n+\n+      {canDelete && selectedMember && selectedSection && (\n+        <div className={styles.placementActions}>\n+          <button\n+            type=\"button\"\n+            className={styles.placementDelete}\n+            data-testid=\"delete-member\"\n+            aria-label={`${selectedSection.mark} ${selectedMember.id} ${t(\n+              locale,\n+              'plan.placement.delete',\n+            )}`}\n+            onClick={deleteSelected}\n+          >\n+            {t(locale, 'plan.placement.delete')}\n+          </button>\n+        </div>\n+      )}\n+\n+      {failureMessage !== null && (\n+        <p\n+          className={styles.placementMessage}\n+          data-testid=\"placement-error\"\n+          role=\"alert\"\n+        >\n+          ▲ {failureMessage}\n+        </p>\n+      )}\n+    </section>\n+  )\n+}\n+\n /**\n  * 部材の内法域の大きさ (mm)。開口部はこの中に収まらなければならない\n  * （数量積算基準 1通則8) の「内法寸法」は部材の内法の中の話だ）。\n@@ -1327,6 +1701,7 @@ export function PlanEditor() {\n         <SpanEditor axis=\"x\" />\n         <SpanEditor axis=\"y\" />\n       </div>\n+      <PlacementEditor />\n       <WallExtentEditor />\n       <OpeningEditor />\n       <div className={styles.drawingFrame}>\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'git diff -- src/components/plan/PlanEditor.module.css src/locales/ja.json src/locales/ko.json docs/MILESTONES.md phases/26-plan-place/index.json'","aggregated_output":"warning: in the working copy of 'docs/MILESTONES.md', LF will be replaced by CRLF the next time Git touches it\nwarning: in the working copy of 'src/components/plan/PlanEditor.module.css', LF will be replaced by CRLF the next time Git touches it\nwarning: in the working copy of 'src/locales/ja.json', LF will be replaced by CRLF the next time Git touches it\nwarning: in the working copy of 'src/locales/ko.json', LF will be replaced by CRLF the next time Git touches it\ndiff --git a/docs/MILESTONES.md b/docs/MILESTONES.md\nindex 2ad1af5..daf23fe 100644\n--- a/docs/MILESTONES.md\n+++ b/docs/MILESTONES.md\n@@ -10,7 +10,7 @@\n - [ ] **M3c** — 진행 중. 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다\n - [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `girderMainAsymmetric` 후보로 보존하고 phase 21에서 Grid 축 순서 자동 또는 사용자 선택으로 始端/終端에 반영한다. 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 좌우 상이 8칸은 방향 미선택을 기본으로 유지한 비대칭 후보로 반영 단계에 넘겼다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 고강도 전단보강근·円形柱 표현, `カットオフ` 값 반영 — 位置 열이 있는 3란 표는 phase 21에서 취입까지 닫혔고, 위치 없는 반폭 표기는 원문 `raw` 보존까지. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\n    - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — 断面リスト 취입에서 좌우 비대칭 主筋의 始端/終端 대응에 사용한다. ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조). **끝난 것**(2026-08-26, ADR-035·phase 23): 階 라벨↔`Story` 대응 — 伏図 제목과 `Story`/断面의 정확 일치 자동 선택, 미일치 시 사용자 선택, stale `storyId` 리셋을 고정했다.\n-- [ ] **부재 확장(耐震壁·床板)** — 진행 중 (2026-08-22 착수, ADR-025·ADR-028). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **끝난 것**(開口補強筋 전사 입력, 2026-08-26, ADR-034·phase 22): 開口마다 `径・本数・設計長さ(mm)`를 설계도서에서 전사해 입력하고, 내역서에는 `開口補強筋`으로 계상한다. 3D는 위치·형상을 제품이 만들지 않도록 해당 role을 건물·부재 뷰에서 건너뛴다. 미전사 開口의 과소 계상은 상시 고지가 안내한다. **남은 것**: 平面 뷰에서 벽·床板을 놓고 지우는 입력(지금은 표시만), 片持床板(형상 입력이 선결)\n+- [ ] **부재 확장(耐震壁·床板)** — 진행 중 (2026-08-22 착수, ADR-025·ADR-028). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **끝난 것**(開口補強筋 전사 입력, 2026-08-26, ADR-034·phase 22): 開口마다 `径・本数・設計長さ(mm)`를 설계도서에서 전사해 입력하고, 내역서에는 `開口補強筋`으로 계상한다. 3D는 위치·형상을 제품이 만들지 않도록 해당 role을 건물·부재 뷰에서 건너뛴다. 미전사 開口의 과소 계상은 상시 고지가 안내한다. **남은 것**: 片持床板(형상 입력이 선결). 平面 뷰의 壁·床板 배치·삭제 입력은 phase 26(ADR-038)에서 완료\n - [ ] **일본 고유 형태·제품 확장** — 진행 중 (2026-08-22 착수). 후보를 두 원문 전수 검색으로 재고 4개를 골랐다. **끝난 것**: ① **高強度せん断補強筋**(K13·S13, ADR-026) — `帯筋`·`あばら筋` 전용 呼び名이다. 두 원문에 「高強度」·「大臣認定」이 **0건**인데도 만들 수 있는 이유는 1通則2)가 フープ 長さ를 断面周長으로 정해 **径으로 引는 룰팩 행이 帯筋에 하나도 없기** 때문이다 — 룰팩 신규 행 0. 主筋·壁筋은 定着·重ね継手를 径으로 引으므로 타입(`ShearBarSize`)이 막는다. 断面リスト 파서도 읽는다. ② **円形柱**(ADR-027) — 1通則2)의 「断面の設計寸法による周長」이 円形에서는 원주 π×直径이다. 조문이 형상을 矩形으로 한정하지 않으므로 여기서도 룰팩 신규 행이 0이다. `ColumnSection.shape`(스키마 v9)로 받고 b·d를 둘 다 直径으로 둔다 — 大梁 内法·3D 柱面·平面 히트영역이 전부 b·d에서 나오므로 外接寸法을 그대로 두면 형상 추가가 계측을 흔들지 않는다. 3D는 円柱와 円形フープ(24각형 作図規則)다. `600φ`도 파싱한다. **スパイラル筋은 만들지 않는다** — 継手·定着이 図5.3.5＝이미지다. **끝난 것**: ③ **雑壁** — 区分(`wallClass`)·かぶり·40d 하한은 phase 24(ADR-036)로 완료. 부분 높이·부분 길이 형상은 phase 25(ADR-037)로 완료. **남은 것**: ④ **壁式構造の壁**(積算基準 2（５）壁**2)**의 端部筋·縦筋·壁梁筋·横筋·補強筋 5구분). **만들지 않는 것**: `免震`(0건, ADR-025)·スパイラル筋의 継手·定着(図5.3.5＝**이미지**라 表5.3.3과 같은 함정)·機械式定着(標準仕様書 5.3.4(ｳ)가 전부 「特記による」라 제품이 가질 값이 없다). `ガス圧接`·`機械式継手`는 M3b에서 이미 끝났다\n - [x] **M4** — 완료 (2026-08-22). 네 갈래다. ① **재방문 경로**: `src/lib/persist/`(IndexedDB 자동저장 500ms 디바운스 ＋ 案件 JSON 저장/불러오기)와 `useProjectPersistence`. 복원 불가한 기록(옛 schemaVersion·끊긴 문자열)은 조용히 버리고 샘플로 착지한다 — 기동 경로라 던지면 지울 방법 없이 화면이 하얘진다. 반대로 사용자가 고른 파일이 안 읽히면 **말한다**(지금 案件은 남긴 채). ② **내역서 양식**: xlsx에 층별 小計 행과 `径別集計` 시트를 넣었다(`sizeSubtotals`는 径마다 독립해서 null이 된다 — 「어느 径이 아직 発注 불가인가」가 이 표의 용도라 欠損이 다른 径을 물들이면 안 된다). ③ **PDF**: 라이브러리 대신 브라우저 인쇄 경로(`@media print` ＋ `window.print()`). 종이도 같은 `WorkbookSpec`에서 나오고, 出典·算出式 두 열은 열 정의의 `printed` 플래그로 뺀다(PDL1.0 의무는 算出根拠 블록이 진다). ④ **glTF(glb)**: `EXT_mesh_gpu_instancing`으로 案件 전체를 낸다. **화면의 표시 반경이 아니라 実寸이다** — `rebarRadius`는 가독성용으로 최소 ⌀14·1.6배로 부풀린 값이라 그대로 내면 D25가 ⌀40으로 실측된다(ADR-024). 스트레스는 `tests/stress/multi-story.test.ts`(5층 45,885 인스턴스)와 실브라우저 `tests/e2e/uc17-stress-building.js`로 잰다. glb에도 出典·改変·ADR-015 경고가 `scene.userData`(＝extras)로 실린다 — 書き出し 경로마다 표시 의무가 면제되지 않는다. **3D를 쓰는 코드는 押した時에 받는다**: 헤더 상주 釦이 `gltf.ts`를 정적 import하면 three가 `/`의 차단 경로로 돌아오는데, Lighthouse 예산은 이것을 통과시킨다(뷰어가 어차피 three를 받으므로 총량이 안 변한다). 확인은 `.next/app-build-manifest.json`의 `pages['/page']`로 한다\n - [ ] **M5** — 한국 실무자 UX 리뷰 반영\ndiff --git a/phases/26-plan-place/index.json b/phases/26-plan-place/index.json\nindex 625979e..ea6bda9 100644\n--- a/phases/26-plan-place/index.json\n+++ b/phases/26-plan-place/index.json\n@@ -22,7 +22,8 @@\n     {\n       \"step\": 2,\n       \"name\": \"plan-place-delete-ui\",\n-      \"status\": \"pending\"\n+      \"status\": \"pending\",\n+      \"started_at\": \"2026-08-26T22:56:54+0900\"\n     }\n   ],\n   \"created_at\": \"2026-08-26T22:27:50+0900\"\ndiff --git a/src/components/plan/PlanEditor.module.css b/src/components/plan/PlanEditor.module.css\nindex 0fe81de..9ed55c4 100644\n--- a/src/components/plan/PlanEditor.module.css\n+++ b/src/components/plan/PlanEditor.module.css\n@@ -23,7 +23,7 @@\n \n .editor {\n   display: grid;\n-  grid-template-rows: auto minmax(220px, 1fr);\n+  grid-template-rows: auto auto auto auto minmax(220px, 1fr);\n   min-height: 100%;\n }\n \n@@ -97,6 +97,93 @@\n   margin-top: var(--space-xxs);\n }\n \n+.placementEditor {\n+  padding: var(--space-xs) var(--space-sm);\n+  border-bottom: var(--border-hairline);\n+  background: var(--color-canvas-soft);\n+}\n+\n+.placementGroups {\n+  display: grid;\n+  grid-template-columns: repeat(2, minmax(0, 1fr));\n+  gap: var(--space-sm);\n+}\n+\n+.placementGroup {\n+  min-width: 0;\n+  margin: 0;\n+  padding: 0;\n+  border: 0;\n+}\n+\n+.placementLabel {\n+  display: grid