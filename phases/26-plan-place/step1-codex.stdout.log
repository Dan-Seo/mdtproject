? QuantityLine.id瑜??ㅻ줈 ?대떎. 媛믪씠 ?녿뒗 ?됱? ???먯껜媛 ?녿떎. */\r\n  notes?: Record<string, string>\r\n  /**\r\n   * 孃꾨퀎 ?섆퐤蘊ら뇧 (kg/m) ???⑴뵪?끻뀯?? 誘몄엯??孃꾩? ?ㅺ? ?녿떎.\r\n   * 洹쒖???JIS???꾩엫??媛믪씠??猷고뙥???꾨땲???꾨줈?앺듃媛 ?ㅺ퀬 ?덈떎.\r\n   */\r\n  unitMass?: Partial<Record<ShearBarSize, number>>\r\n}\r\n\r\nexport function gridPointCount(grid: Grid): { nx: number; ny: number } {\r\n  return {\r\n    nx: grid.xSpans.length + 1,\r\n    ny: grid.ySpans.length + 1,\r\n  }\r\n}\r\n\r\nexport function gridPoint(\r\n  grid: Grid,\r\n  ix: number,\r\n  iy: number,\r\n): { x: number; y: number } {\r\n  const { nx, ny } = gridPointCount(grid)\r\n\r\n  if (\r\n    !Number.isInteger(ix) ||\r\n    !Number.isInteger(iy) ||\r\n    ix < 0 ||\r\n    ix >= nx ||\r\n    iy < 0 ||\r\n    iy >= ny\r\n  ) {\r\n    throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\r\n  }\r\n\r\n  return {\r\n    x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\r\n    y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\r\n  }\r\n}\r\n\r\n/**\r\n * storyId??\"1F\" 媛숈? letter+digit ?쇰꺼?대씪 猷고뙥 ?곸닔(D25 ??? 媛믪쓽\r\n * 紐⑥뼇留뚯쑝濡?援щ텇?섏? ?딅뒗????telemetry.ts???ㅽ겕?щ쾭??letter+digit\r\n * ?좏겙???듭㎏濡??④린誘濡? 洹몃깷 蹂닿컙?섎㈃ ???쇰꺼??洹몃?濡??덉뼱 ?섍컙??9李?\r\n * 由щ럭 critical). JSON 釉붾줉?쇰줈 媛먯떥硫??ㅽ겕?щ쾭??`{...}` 洹쒖튃??嫄몃┛??\r\n * ???щ㎎???⑥닔 ?섎굹濡?怨좎젙???ㅼ쓬 ?몄텧遺媛 洹쒖빟???먯쑝濡??ㅼ떆 踰좊겮吏\r\n * ?딄쾶 ?쒕떎(9李?由щ럭 minor).\r\n */\r\nexport function storyNotFound(storyId: string): Error {\r\n  return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\r\n}\r\n\r\n/** 痢?諛붾떏???꾩쟻 ?쒓퀬(mm). stories 諛곗뿴 ?쒖꽌?濡??꾨옒痢?height瑜??꾩쟻?쒕떎. */\r\nexport function storyElevation(stories: Story[], storyId: string): number {\r\n  const index = stories.findIndex(({ id }) => id === storyId)\r\n\r\n  if (index < 0) {\r\n    throw storyNotFound(storyId)\r\n  }\r\n\r\n  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\r\n}\r\n\r\nexport function findSection(project: Project, sectionId: string): Section {\r\n  const section = project.sections.find(({ id }) => id === sectionId)\r\n\r\n  if (!section) {\r\n    throw new Error(`Section not found: ${sectionId}`)\r\n  }\r\n\r\n  return section\r\n}\r\n\r\nexport function memberGroupKey(project: Project, member: Member): string {\r\n  const story = project.stories.find(({ id }) => id === member.storyId)\r\n  if (!story) {\r\n    throw storyNotFound(member.storyId)\r\n  }\r\n\r\n  const section = findSection(project, member.sectionId)\r\n  if (section.kind !== member.kind) {\r\n    throw new Error(\r\n      `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\r\n    )\r\n  }\r\n\r\n  const memberCode = MEMBER_GROUP_CODE[member.kind]\r\n  return `${story.name}|${memberCode}|${section.mark}`\r\n}\r\n\r\n/** ?낁㉢?멥겗?겹꺂?쇈깤?듐겓鵝욍걝?ⓩ쓲?녈꺖?됥귞Е??mark)?③쉸??뼋?ユ뙚?얇굥訝?뉐춻??*/\r\nconst MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\r\n  ?? 'C',\r\n  鸚㎪쥈: 'G',\r\n  ?먬쐡鶯? 'W',\r\n  佯딀씮: 'S',\r\n}\r\n\r\nfunction isColumnPosition(\r\n  position: ColumnPosition | GirderPosition,\r\n): position is ColumnPosition {\r\n  return !('axis' in position)\r\n}\r\n\r\nfunction isGirderPosition(\r\n  position: ColumnPosition | GirderPosition,\r\n): position is GirderPosition {\r\n  return 'axis' in position\r\n}\r\n\r\nfunction touchesColumn(\r\n  girder: GirderPosition,\r\n  column: ColumnPosition,\r\n): boolean {\r\n  if (girder.axis === 'X') {\r\n    return (\r\n      girder.iy === column.iy &&\r\n      (girder.ix === column.ix || girder.ix + 1 === column.ix)\r\n    )\r\n  }\r\n\r\n  return (\r\n    girder.ix === column.ix &&\r\n    (girder.iy === column.iy || girder.iy + 1 === column.iy)\r\n  )\r\n}\r\n\r\nexport interface GirderSpan {\r\n  axis: 'X' | 'Y'\r\n  /** 洹몃━??援먯젏 媛?以묒떖 ?ㅽ뙩 (mm) */\r\n  centerSpan: number\r\n  /** ?끾퀡?룔걬 (mm) ???묐떒 ?깁씊 ?ъ씠 */\r\n  clear: number\r\n  /** ?쒖옉 ??以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\r\n  startFaceOffsetMm: number\r\n  /** ????以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\r\n  endFaceOffsetMm: number\r\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ???쒖옉 ?깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\r\n  startSupportLengthAlongAxisMm: number\r\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ?????깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\r\n  endSupportLengthAlongAxisMm: number\r\n  /** 吏???깆쓽 ?뗣겤??議고쉶 議곌굔 ??塋?깿?▽뻑? 鸚㎪쥈???꾨땲???깆쓽 ?뗣겤?딅줈 ?먯젙?쒕떎 */\r\n  startSupportCover: Record<string, string | boolean>\r\n  endSupportCover: Record<string, string | boolean>\r\n}\r\n\r\nexport function girderSupportSections(\r\n  project: Project,\r\n  member: Member,\r\n): { start: ColumnSection; end: ColumnSection } {\r\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\r\n    throw new Error(`girderSupportSections requires a 鸚㎪쥈: ${member.id}`)\r\n  }\r\n\r\n  const { axis, ix, iy } = member.position\r\n  const endIx = axis === 'X' ? ix + 1 : ix\r\n  const endIy = axis === 'Y' ? iy + 1 : iy\r\n\r\n  return {\r\n    start: supportColumnSection(project, member, ix, iy, 'start'),\r\n    end: supportColumnSection(project, member, endIx, endIy, 'end'),\r\n  }\r\n}\r\n\r\nfunction supportColumnSection(\r\n  project: Project,\r\n  supported: Member,\r\n  ix: number,\r\n  iy: number,\r\n  end: 'start' | 'end',\r\n): ColumnSection {\r\n  const support = project.members.find(\r\n    (candidate) =>\r\n      candidate.kind === '?? &&\r\n      candidate.storyId === supported.storyId &&\r\n      isColumnPosition(candidate.position) &&\r\n      candidate.position.ix === ix &&\r\n      candidate.position.iy === iy,\r\n  )\r\n\r\n  if (!support) {\r\n    throw new Error(\r\n      `Missing ${end} support ??for ${supported.kind}: ${supported.id}`,\r\n    )\r\n  }\r\n\r\n  const section = findSection(project, support.sectionId)\r\n  if (section.kind !== '??) {\r\n    throw new Error(`??member references a non-??section: ${support.id}`)\r\n  }\r\n\r\n  return section\r\n}\r\n\r\nexport function girderSpan(project: Project, member: Member): GirderSpan {\r\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\r\n    throw new Error(`girderSpan requires a 鸚㎪쥈: ${member.id}`)\r\n  }\r\n\r\n  const { axis, ix, iy } = member.position\r\n  const endIx = axis === 'X' ? ix + 1 : ix\r\n  const endIy = axis === 'Y' ? iy + 1 : iy\r\n  const startPoint = gridPoint(project.grid, ix, iy)\r\n  const endPoint = gridPoint(project.grid, endIx, endIy)\r\n  const { start: startSection, end: endSection } = girderSupportSections(\r\n    project,\r\n    member,\r\n  )\r\n  const centerSpan =\r\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\r\n  const startSupportLengthAlongAxisMm =\r\n    axis === 'X' ? startSection.b : startSection.d\r\n  const endSupportLengthAlongAxisMm =\r\n    axis === 'X' ? endSection.b : endSection.d\r\n  const startFaceOffsetMm = startSupportLengthAlongAxisMm / 2\r\n  const endFaceOffsetMm = endSupportLengthAlongAxisMm / 2\r\n  const clear = centerSpan - startFaceOffsetMm - endFaceOffsetMm\r\n\r\n  if (clear <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `鸚㎪쥈 ?끾퀡?룔걬 must be positive: ${member.id} (${clear} mm)`,\r\n    )\r\n  }\r\n\r\n  return {\r\n    axis,\r\n    centerSpan,\r\n    clear,\r\n    startFaceOffsetMm,\r\n    endFaceOffsetMm,\r\n    startSupportLengthAlongAxisMm,\r\n    endSupportLengthAlongAxisMm,\r\n    startSupportCover: coverConditions(startSection),\r\n    endSupportCover: coverConditions(endSection),\r\n  }\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗?끾퀡野멩퀡?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬??\r\n * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곩즯??쳵?뺛굚?룔걬?귚릎恙껈뼋?㎯겘?ゃ걦?끾퀡?㎯걗?뗣?\r\n * ?긱꺕鸚㎪쥈?ⓧ틠?띹쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?앫겗?귙겗?㎯곩ㄷ歟곥걣?끾퀡?룔걬?ゃ겗?ⓨ릪?섇숱?졼?\r\n */\r\nexport interface WallSpan {\r\n  axis: 'X' | 'Y'\r\n  /** ?끾퀡?룔걬 (mm) ??訝▼겢??윶??냵?닻씊??뼋 */\r\n  clearLengthMm: number\r\n  /** ?끾퀡遙섅걬 (mm) ???롩쳵 ??訝딃깿鸚㎪쥈?쎼걚 */\r\n  clearHeightMm: number\r\n  /** 冶뗧ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\r\n  startFaceOffsetMm: number\r\n  /** 永귞ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\r\n  endFaceOffsetMm: number\r\n  /** ?끾퀡遙섅걬?믤군?곥걼訝딃깿鸚㎪쥈??걵??(mm) */\r\n  girderDepthAboveMm: number\r\n  /** 影꾢쎊?믤뙁若싥걮?잆겏?띲겗?ょ뵳塋?귞쐛?θ뻗??륫塋?걣?η텥?담겎?귙굥??*/\r\n  freeEnds?: {\r\n    vertical?: '訝딁ク' | '訝뗧ク'\r\n    horizontal?: '冶뗧ク' | '永귞ク'\r\n  }\r\n  /** ?끾퀡?잆겗?잏궧?뗣굢?곭칱?꿔겗?잏궧?얇겎??꺆?쇈궖?ャ궕?뺛궩?껁깉 (mm)??*/\r\n  originOffsetMm?: {\r\n    along: number\r\n    height: number\r\n  }\r\n}\r\n\r\n/**\r\n * 鶯곥겗訝듽겓雍됥굥鸚㎪쥈??걵?꾠귛즯?ⓨ릪?섋씌竊덂릪?섌싥굤??꺕?뚣걯?밤깙?놂펹??ㄷ歟곥굮誤뗣굥 ??\r\n * ?먬쐡鶯곥겘2?с겗?긱겗?볝겓塋뗣걾?곥걹??툓??ㄷ歟곥겎??굮閭㏂굙?됥굦?뗣걢?됥겎?귙굥??\r\n *\r\n * 誤뗣겇?뗣굢?ゃ걨?뚣겙?ε뒟??툖?닷릦?ゃ겗?㏝퍢?ｃ겍?롩쳵?믢슴?뤵겒?꾠귛ㄷ歟곥겗?ゃ걚渦뷩겓鶯곥굮\r\n * 營?걦?ⓨ냵力뺡쳵?뺛걣黎뷩겲?됥걳?곲쉸遙섅겎餓ｇ뵪?쇻굦?겼ㄷ歟곥겏?띲겒?ｃ걼鶯곥굮鼇덁툓?쀣겍?쀣겲?녴?\r\n */\r\nfunction girderDepthAboveWall(project: Project, wall: Member): number {\r\n  const position = wall.position\r\n  if (!isGirderPosition(position)) {\r\n    throw new Error(`girderDepthAboveWall requires an edge position: ${wall.id}`)\r\n  }\r\n\r\n  const girder = project.members.find(\r\n    (candidate) =>\r\n      candidate.kind === '鸚㎪쥈' &&\r\n      candidate.storyId === wall.storyId &&\r\n      isGirderPosition(candidate.position) &&\r\n      candidate.position.axis === position.axis &&\r\n      candidate.position.ix === position.ix &&\r\n      candidate.position.iy === position.iy,\r\n  )\r\n\r\n  if (!girder) {\r\n    throw new Error(`Missing 鸚㎪쥈 above ?먬쐡鶯? ${wall.id}`)\r\n  }\r\n\r\n  const section = findSection(project, girder.sectionId)\r\n  if (section.kind !== '鸚㎪쥈') {\r\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\r\n  }\r\n\r\n  return section.depth\r\n}\r\n\r\nexport function wallSpan(project: Project, member: Member): WallSpan {\r\n  if (member.kind !== '?먬쐡鶯? || !isGirderPosition(member.position)) {\r\n    throw new Error(`wallSpan requires a ?먬쐡鶯? ${member.id}`)\r\n  }\r\n\r\n  const story = project.stories.find(({ id }) => id === member.storyId)\r\n  if (!story) {\r\n    throw storyNotFound(member.storyId)\r\n  }\r\n\r\n  const { axis, ix, iy } = member.position\r\n  const endIx = axis === 'X' ? ix + 1 : ix\r\n  const endIy = axis === 'Y' ? iy + 1 : iy\r\n  const startPoint = gridPoint(project.grid, ix, iy)\r\n  const endPoint = gridPoint(project.grid, endIx, endIy)\r\n  const startSection = supportColumnSection(project, member, ix, iy, 'start')\r\n  const endSection = supportColumnSection(project, member, endIx, endIy, 'end')\r\n\r\n  const centerSpan =\r\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\r\n  const startFaceOffsetMm =\r\n    (axis === 'X' ? startSection.b : startSection.d) / 2\r\n  const endFaceOffsetMm = (axis === 'X' ? endSection.b : endSection.d) / 2\r\n  const clearLengthMm = centerSpan - startFaceOffsetMm - endFaceOffsetMm\r\n\r\n  if (clearLengthMm <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?먬쐡鶯??끾퀡?룔걬 must be positive: ${member.id} (${clearLengthMm} mm)`,\r\n    )\r\n  }\r\n\r\n  const girderDepthAboveMm = girderDepthAboveWall(project, member)\r\n  const fullClearHeightMm = story.height - girderDepthAboveMm\r\n\r\n  if (fullClearHeightMm <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?먬쐡鶯??끾퀡遙섅걬 must be positive: ${member.id} ` +\r\n        `(?롩쳵 ${story.height} ??訝딃깿鸚㎪쥈?쎼걚 ${girderDepthAboveMm})`,\r\n    )\r\n  }\r\n\r\n  const extent = member.wallExtent\r\n  let actualLengthMm = clearLengthMm\r\n  let actualHeightMm = fullClearHeightMm\r\n  let alongOriginMm = 0\r\n  let heightOriginMm = 0\r\n  const freeEnds: NonNullable<WallSpan['freeEnds']> = {}\r\n\r\n  if (extent?.horizontal) {\r\n    assertWallExtentDimension(\r\n      member,\r\n      'lengthMm',\r\n      extent.horizontal.lengthMm,\r\n      clearLengthMm,\r\n    )\r\n    actualLengthMm = extent.horizontal.lengthMm\r\n    alongOriginMm =\r\n      extent.horizontal.anchor === '冶뗧ク'\r\n        ? 0\r\n        : clearLengthMm - extent.horizontal.lengthMm\r\n    freeEnds.horizontal =\r\n      extent.horizontal.anchor === '冶뗧ク' ? '永귞ク' : '冶뗧ク'\r\n  }\r\n\r\n  if (extent?.vertical) {\r\n    assertWallExtentDimension(\r\n      member,\r\n      'heightMm',\r\n      extent.vertical.heightMm,\r\n      fullClearHeightMm,\r\n    )\r\n    actualHeightMm = extent.vertical.heightMm\r\n    heightOriginMm =\r\n      extent.vertical.anchor === '訝뗧ク'\r\n        ? 0\r\n        : fullClearHeightMm - extent.vertical.heightMm\r\n    freeEnds.vertical = extent.vertical.anchor === '訝뗧ク' ? '訝딁ク' : '訝뗧ク'\r\n  }\r\n\r\n  return {\r\n    axis,\r\n    clearLengthMm: actualLengthMm,\r\n    clearHeightMm: actualHeightMm,\r\n    startFaceOffsetMm,\r\n    endFaceOffsetMm,\r\n    girderDepthAboveMm,\r\n    freeEnds,\r\n    originOffsetMm: { along: alongOriginMm, height: heightOriginMm },\r\n  }\r\n}\r\n\r\nfunction assertWallExtentDimension(\r\n  member: Member,\r\n  field: 'lengthMm' | 'heightMm',\r\n  value: number,\r\n  fullDimensionMm: number,\r\n): void {\r\n  if (\r\n    !Number.isFinite(value) ||\r\n    value <= 0 ||\r\n    value > fullDimensionMm\r\n  ) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?먬쐡鶯?wallExtent.${field} must be within ?끾퀡野멩퀡: ${member.id} ` +\r\n        `(${value} mm > ${fullDimensionMm} mm)`,\r\n    )\r\n  }\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊??쇻궎??냵力뺝?力뺛겏?곩썪渦뷩겎?쀣걨?뗥ㄷ歟곥?\r\n *\r\n * 翁?퐪??뙷?놅펷寧?渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲?뗦객亮녔쓲??냵力뺡깿?녴?\r\n * ?ⓨ츣?곥굥??겎?곫릍?뗣겗??싥굤??뼋?㎯겘?ゃ걦鸚㎪쥈??냵?닻씊??뼋?㎯걗?뗣귝윶?삣ㄷ歟곥겏\r\n * 雅뚪뇥鼇덁툓?쀣겒?꾠겗??걪??츣獰⒲걹??굚??겎?곩ㄷ歟곥걣?끾퀡?룔걬?삣즯?뚦냵力뺡깿?녴겒??겏?뚣걯壤㏂걽??\r\n */\r\nexport interface SlabBay {\r\n  /** ?싥굤??뼋?밤깙??(mm) */\r\n  centerSpanXMm: number\r\n  centerSpanYMm: number\r\n  /** ?끾퀡?룔걬 (mm) ??X?밧릲??륫?담겗 Y?싥굤鸚㎪쥈??냵?닻씊??뼋 */\r\n  clearXMm: number\r\n  clearYMm: number\r\n  /** ?쇻궎?잏궧??졏耶먪궧?뗣굢?끾퀡?잆겗?잏궧?얇겎??퇌??(mm) 竊??쀣걨?뗥ㄷ歟곩퉭??/2 */\r\n  startFaceOffsetXMm: number\r\n  startFaceOffsetYMm: number\r\n  /** ?쏂씌?㎩룛?묆굥鸚㎪쥈?괱?밧릲??냵力뺛굮黎뷩굙?뗣겗??minX?팵axX竊늍?싥굤鸚㎪쥈竊됥겎?귙굥 */\r\n  supports: {\r\n    minX: SlabEdgeSupport\r\n    maxX: SlabEdgeSupport\r\nfunction girderSectionAt(\r\n  project: Project,\r\n  storyId: string,\r\n  axis: 'X' | 'Y',\r\n  ix: number,\r\n  iy: number,\r\n  requestedBy: Member,\r\n): { member: Member; section: GirderSection } {\r\n  const girder = project.members.find(\r\n    (candidate) =>\r\n      candidate.kind === '鸚㎪쥈' &&\r\n      candidate.storyId === storyId &&\r\n      isGirderPosition(candidate.position) &&\r\n      candidate.position.axis === axis &&\r\n      candidate.position.ix === ix &&\r\n      candidate.position.iy === iy,\r\n  )\r\n\r\n  // ?쏂씌??겑?뚣걢?뚧쵟?묆굥?ⓨ냵力뺛걣黎뷩겲?됥겒?꾠귡싥굤??뼋?㏛빰?ⓦ걲?뚣겙鸚㎪쥈?③뇥?ゃ겂??\r\n  // 佯딀씮?믦쮫訝듽걮?╉걮?얇걝??겎?곲퍢?ｃ겍?뗣굙?ゃ걚 ??鶯곥겗訝딃깿鸚㎪쥈?ⓨ릪?섉돮?꾠겎?귙굥??\r\n  if (!girder) {\r\n    throw new Error(\r\n      `Missing ${axis}?싥굤鸚㎪쥈 beside 佯딀씮: ${requestedBy.id} (${ix}, ${iy})`,\r\n    )\r\n  }\r\n\r\n  const section = findSection(project, girder.sectionId)\r\n  if (section.kind !== '鸚㎪쥈') {\r\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\r\n  }\r\n\r\n  return { member: girder, section }\r\n}\r\n\r\nexport function slabBay(project: Project, member: Member): SlabBay {\r\n  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\r\n    throw new Error(`slabBay requires a 佯딀씮: ${member.id}`)\r\n  }\r\n\r\n  const { ix, iy } = member.position\r\n  const origin = gridPoint(project.grid, ix, iy)\r\n  const far = gridPoint(project.grid, ix + 1, iy + 1)\r\n\r\n  const edge = (\r\n    axis: 'X' | 'Y',\r\n    edgeIx: number,\r\n    edgeIy: number,\r\n  ): SlabEdgeSupport => {\r\n    const { member: girder, section } = girderSectionAt(\r\n      project,\r\n      member.storyId,\r\n      axis,\r\n      edgeIx,\r\n      edgeIy,\r\n      member,\r\n    )\r\n    return {\r\n      memberId: girder.id,\r\n      widthMm: section.b,\r\n      cover: coverConditions(section),\r\n    }\r\n  }\r\n\r\n  // X?밧릲??냵力뺛굮黎뷩굙?뗣겗??Y?싥굤竊덄를?ヨ뎔?뗰펹鸚㎪쥈??퉭?㎯걗????壅겹굥?묆걤??\r\n  // 亮끹굮歷с굥?묆걤?뚨쎍雅ㅳ걲?뗣겗?㎯곥걪?볝굮?뽧굤?뺛걟?뗣겏?끾퀡?뚦뀯?뚧쎘?뤵굥??\r\n  const supports = {\r\n    minX: edge('Y', ix, iy),\r\n    maxX: edge('Y', ix + 1, iy),\r\n    minY: edge('X', ix, iy),\r\n    maxY: edge('X', ix, iy + 1),\r\n  }\r\n\r\n  const centerSpanXMm = far.x - origin.x\r\n  const centerSpanYMm = far.y - origin.y\r\n  const startFaceOffsetXMm = supports.minX.widthMm / 2\r\n  const startFaceOffsetYMm = supports.minY.widthMm / 2\r\n  const clearXMm =\r\n    centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\r\n  const clearYMm =\r\n    centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\r\n\r\n  if (clearXMm <= 0 || clearYMm <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `佯딀씮 ?끾퀡?룔걬 must be positive: ${member.id} ` +\r\n        `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\r\n    )\r\n  }\r\n\r\n  return {\r\n    centerSpanXMm,\r\n    centerSpanYMm,\r\n    clearXMm,\r\n    clearYMm,\r\n    startFaceOffsetXMm,\r\n    startFaceOffsetYMm,\r\n    supports,\r\n  }\r\n}\r\n\r\n/**\r\n * ?뚥???씊??틞?욍걣鸚㎪쥈?믧싥걮??ｃ겒?뗧칱?????곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞??) ??\r\n * ?뚦릪訝??푶??말嶺뗣걣歟곥곩즯嶺됥굮?싥걮??ｇ텥?쇻굥?닷릦?띲걣?볝굦?㎯걗?뗣?\r\n *\r\n * 鸚㎪쥈??꺀??(girderRun) ?ⓨ릪?섇숱?졼??쇻궎?ゃ굢?룔걬1??꺀?녈겎?뚦뜕?у틞?욍띲?\r\n * 2?쇻궎餓δ툓?ゃ굢?뚪ｇ텥?쇻굥佯딀씮?띲겓?ゃ굤?곭텤?뗧츋??겹겗?→뻼??2竊덌폇竊됧틞??) ??\r\n * ?뉎굤?욍굩?뗣괱?밧릲?쮇?밧릲?㎩닪??꺀?녈굮?곥겇 ??佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥?뗣굢?졼?\r\n */\r\nexport interface SlabRun {\r\n  axis: 'X' | 'Y'\r\n  /** 邕멩뼶?묆겗?뉔젂?귛뜕?у틞?욍겒?됮빓?? */\r\n  members: Member[]\r\n  /** ?싥걮嶺뗣굮躍겼콪?뺛걵?뗩깿??竊?members[0].id */\r\n  ownerId: string\r\n  /** members ?ⓨ릪?섌젂佯?*/\r\n  bays: SlabBay[]\r\n  /**\r\n   * ?⒲꺍?잏궧竊덂쭓塋?겗鸚㎪쥈??냵?닻씊竊됥걢?됧릢?쇻궎??냵力뺝윜??쭓?얇굤?얇겎??퇌??(mm)??\r\n   * bays ?ⓨ릪?섌젂佯뤵겎 [0] ??0 ?㎯걗?뗣?D ?뚣꺀?녈굮1?ㅳ겗?졼겓?뤵걦?ⓦ걤??\r\n   * ?꾠깧?ㅳ겗嶸긱굮?볝걪?ョ쉰?????뤹뵽?담겎擁녈걮?담걲?③뀓嶺뗣겏?싥굦?뗣?\r\n   */\r\n  memberOffsetsMm: number[]\r\n  /** ?⒲꺍??빓 (mm) 竊?誇?끾퀡?룔걬 竊?誇訝?뼋鸚㎪쥈??퉭 */\r\n  coreLengthMm: number\r\n  /** ?꿜퍡?밧릲竊덁말嶺뗣겏?답벡?쇻굥?묆걤竊됥겗?끾퀡?룔걬 (mm) ???⒲꺍?끹겎?깁싥겎?귙굥 */\r\n  distributionClearMm: number\r\n  /** 冶뗧ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\r\n  startSupport: SlabEdgeSupport\r\n  /** 永귞ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\r\n  endSupport: SlabEdgeSupport\r\n  /**\r\n   * ?⒲꺍?ラ뼀?꾠겍?꾠굥?뗥룭??(1?싧뎴8))??*?⒲꺍?잏궧?뗣굢??벨與?*?ョ쎍?쀣걼?귙겗??\r\n   *\r\n   * ?뗥룭??깧?ㅿ펷竊앶깿?먲펹