_SIZES,\r\n   7:   type BarSize,\r\n   8:   type Member,\r\n   9:   type Opening,\r\n  10:   type OpeningReinforcement,\r\n  11:   type WallExtent,\r\n  12: } from '@/domain/model/member'\r\n  13: import {\r\n  14:   findSection,\r\n  15:   gridPoint,\r\n  16:   slabBay,\r\n  17:   storyNotFound,\r\n  18:   wallSpan,\r\n  19:   type Project,\r\n  20: } from '@/domain/model/project'\r\n  21: import { MemberUnsupportedError } from '@/domain/model/unsupported'\r\n  22: import { lookupRule } from '@/domain/rules/lookup'\r\n  23: import { jpMlitRulePack } from '@/rulepack'\r\n  24: import { t } from '@/lib/i18n'\r\n  25: import { useAppStore } from '@/lib/store'\r\n  26: import { capture } from '@/lib/telemetry'\r\n  27: \r\n  28: import { spanCoordinates, updateProjectSpans, type SpanAxis } from './grid'\r\n  29: import styles from './PlanEditor.module.css'\r\n  30: \r\n  31: // 壁の面線を通り芯からどれだけ離すか (px)。大梁のヒット領域が片側 9px\r\n  32: // (girderHitArea の stroke-width 18) なので、その外に出さないと壁を選べない。\r\n  33: const wallFaceOffset = 12\r\n  34: \r\n  35: // 床板の塗りを通り芯からどれだけ引っ込めるか (px)。壁の面線のヒット領域が\r\n  36: // 通り芯から片側 12＋8 ＝ 20px まで届くので、その外から塗り始めないと\r\n  37: // 床板が上に載って大梁も壁も選べなくなる。\r\n  38: const slabEdgeInset = 22\r\n  39: \r\n  40: const viewWidth = 640\r\n  41: const viewHeight = 420\r\n  42: const plotLeft = 96\r\n  43: const plotTop = 56\r\n  44: const plotWidth = 476\r\n  45: const plotHeight = 282\r\n  46: \r\n  47: interface DrawingTransform {\r\n  48:   x(value: number): number\r\n  49:   y(value: number): number\r\n  50: }\r\n  51: \r\n  52: function drawingTransform(project: Project): DrawingTransform {\r\n  53:   const xCoordinates = spanCoordinates(project.grid.xSpans)\r\n  54:   const yCoordinates = spanCoordinates(project.grid.ySpans)\r\n  55:   const totalX = xCoordinates[xCoordinates.length - 1]\r\n  56:   const totalY = yCoordinates[yCoordinates.length - 1]\r\n  57:   const scale = Math.min(plotWidth / totalX, plotHeight / totalY)\r\n  58:   const drawingWidth = totalX * scale\r\n  59:   const drawingHeight = totalY * scale\r\n  60:   const offsetX = plotLeft + (plotWidth - drawingWidth) / 2\r\n  61:   const offsetY = plotTop + (plotHeight - drawingHeight) / 2\r\n  62: \r\n  63:   return {\r\n  64:     x: (value) => offsetX + value * scale,\r\n  65:     y: (value) => offsetY + drawingHeight - value * scale,\r\n  66:   }\r\n  67: }\r\n  68: \r\n  69: function activateMember(\r\n  70:   event: KeyboardEvent<SVGGElement>,\r\n  71:   select: () => void,\r\n  72: ): void {\r\n  73:   if (event.key !== 'Enter' && event.key !== ' ') return\r\n  74:   event.preventDefault()\r\n  75:   select()\r\n  76: }\r\n  77: \r\n  78: function wallExtentLabel(member: Member): string | null {\r\n  79:   const extent = member.wallExtent\r\n  80:   if (extent === undefined) return null\r\n  81: \r\n  82:   const labels: string[] = []\r\n  83:   if (extent.vertical !== undefined) {\r\n  84:     labels.push(\r\n  85:       `${extent.vertical.anchor === '下端' ? '腰壁' : '下り壁'} H=${extent.vertical.heightMm}`,\r\n  86:     )\r\n  87:   }\r\n  88:   if (extent.horizontal !== undefined) {\r\n  89:     labels.push(`袖壁 L=${extent.horizontal.lengthMm}`)\r\n  90:   }\r\n  91: \r\n  92:   return labels.length === 0 ? null : labels.join(' / ')\r\n  93: }\r\n  94: \r\n  95: export function StoryTabs() {\r\n  96:   const stories = useAppStore(({ project }) => project.stories)\r\n  97:   const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\r\n  98:   const locale = useAppStore(({ locale }) => locale)\r\n  99:   const setActiveStory = useAppStore(({ setActiveStory }) => setActiveStory)\r\n 100: \r\n 101:   return (\r\n 102:     <div\r\n 103:       className={styles.storyTabs}\r\n 104:       role=\"tablist\"\r\n 105:       aria-label={t(locale, 'plan.storyTabs')}\r\n 106:     >\r\n 107:       {stories.map((story) => {\r\n 108:         const selected = story.id === activeStoryId\r\n 109:         return (\r\n 110:           <button\r\n 111:             key={story.id}\r\n 112:             type=\"button\"\r\n 113:             role=\"tab\"\r\n 114:             className={`${styles.storyTab} ${\r\n 115:               selected ? styles.storyTabActive : ''\r\n 116:             }`}\r\n 117:             aria-selected={selected}\r\n 118:             onClick={() => {\r\n 119:               setActiveStory(story.id)\r\n 120:               // ViewerTabs·member_selected와 같은 기준 — 이미 활성인 층을\r\n 121:               // 다시 눌러도 전환이 아니다 (10차 리뷰 minor).\r\n 122:               if (!selected) capture('story_selected')\r\n 123:             }}\r\n 124:           >\r\n 125:             {story.name}\r\n 126:           </button>\r\n 127:         )\r\n 128:       })}\r\n 129:     </div>\r\n 130:   )\r\n 131: }\r\n 132: \r\n 133: function PlanMember({\r\n 134:   member,\r\n 135:   project,\r\n 136:   transform,\r\n 137: }: {\r\n 138:   member: Member\r\n 139:   project: Project\r\n 140:   transform: DrawingTransform\r\n 141: }) {\r\n 142:   const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\r\n 143:   const selectMember = useAppStore(({ selectMember }) => selectMember)\r\n 144:   const section = findSection(project, member.sectionId)\r\n 145:   const selected = selectedMemberId === member.id\r\n 146:   // 부재 id는 그리드 좌표를 담고 있어 보내지 않는다 — 어느 페인에서 골랐는지만 남긴다.\r\n 147:   // 이미 선택된 부재를 다시 클릭해도 재발화하지 않는다 — SectionTable·TakeoffPane과\r\n 148:   // 같은 판정이라 source별 선택 수 비교가 어느 한쪽으로 부풀지 않는다.\r\n 149:   const select = () => {\r\n 150:     selectMember(member.id)\r\n 151:     if (!selected) capture('member_selected', { source: 'plan' })\r\n 152:   }\r\n 153: \r\n 154:   if (member.kind === '柱' && !('axis' in member.position)) {\r\n 155:     const point = gridPoint(\r\n 156:       project.grid,\r\n 157:       member.position.ix,\r\n 158:       member.position.iy,\r\n 159:     )\r\n 160:     const x = transform.x(point.x)\r\n 161:     const y = transform.y(point.y)\r\n 162: \r\n 163:     // 라벨은 그룹 밖에 둔다 — 안에 있으면 그룹 bbox가 라벨까지 감싸\r\n 164:     // 클릭 중심이 마커를 벗어나 大梁 히트영역으로 밀린다.\r\n 165:     return (\r\n 166:       <>\r\n 167:         <g\r\n 168:           className={`${styles.member} ${\r\n 169:             selected ? styles.memberSelected : ''\r\n 170:           }`}\r\n 171:           role=\"button\"\r\n 172:           tabIndex={0}\r\n 173:           aria-label={`${section.mark} ${member.id}`}\r\n 174:           aria-pressed={selected}\r\n 175:           onClick={select}\r\n 176:           onKeyDown={(event) => activateMember(event, select)}\r\n 177:         >\r\n 178:           <rect\r\n 179:             className={styles.column}\r\n 180:             x={x - 7}\r\n--- SectionTable top ---\r\n   1: 'use client'\r\n   2: \r\n   3: import { useRef, type KeyboardEvent } from 'react'\r\n   4: \r\n   5: import {\r\n   6:   BAR_SIZES,\r\n   7:   SHEAR_BAR_SIZES,\r\n   8:   SPLICE_METHODS,\r\n   9:   sectionMarkLabel,\r\n  10:   type BarSize,\r\n  11:   type ColumnSection,\r\n  12:   type ColumnShape,\r\n  13:   type Exposure,\r\n  14:   type Finish,\r\n  15:   type GirderSection,\r\n  16:   type Section,\r\n  17:   type ShearBarSize,\r\n  18:   type SpliceMethod,\r\n  19:   type SteelGrade,\r\n  20:   type SlabBarRow,\r\n  21:   type SlabSection,\r\n  22:   type WallSection,\r\n  23: } from '@/domain/model/member'\r\n  24: import type { Project } from '@/domain/model/project'\r\n  25: import { t } from '@/lib/i18n'\r\n  26: import { useAppStore, type Locale } from '@/lib/store'\r\n  27: import { capture } from '@/lib/telemetry'\r\n  28: \r\n  29: import styles from './SectionTable.module.css'\r\n  30: \r\n  31: const barSizes: readonly BarSize[] = BAR_SIZES\r\n  32: \r\n  33: const shearBarSizes: readonly ShearBarSize[] = SHEAR_BAR_SIZES\r\n  34: \r\n  35: const columnShapes: readonly ColumnShape[] = ['矩形', '円形']\r\n  36: \r\n  37: const steelGrades: SteelGrade[] = ['SD295', 'SD345', 'SD390']\r\n  38: \r\n  39: const spliceMethods: readonly SpliceMethod[] = SPLICE_METHODS\r\n  40: \r\n  41: const exposures: Exposure[] = ['屋内', '屋外']\r\n  42: \r\n  43: const finishes: Finish[] = ['仕上げあり', '仕上げなし']\r\n  44: \r\n  45: type WallClass = NonNullable<WallSection['wallClass']>\r\n  46: \r\n  47: const wallClasses: readonly WallClass[] = ['耐力壁', '耐力壁以外']\r\n  48: \r\n  49: function replaceSection(\r\n  50:   project: Project,\r\n  51:   sectionId: string,\r\n  52:   updater: (section: Section) => Section,\r\n  53: ): Project {\r\n  54:   return {\r\n  55:     ...project,\r\n  56:     sections: project.sections.map((section) =>\r\n  57:       section.id === sectionId ? updater(section) : section,\r\n  58:     ),\r\n  59:   }\r\n  60: }\r\n  61: \r\n  62: function boundedNumber(value: string, minimum: number): number | null {\r\n  63:   // Number('')는 0이다 — 하한이 0인 필드에서 빈 값이 통과하면 지우는 순간\r\n  64:   // 本数(=물량)가 0 오프셋으로 덮인다.\r\n  65:   if (value.trim() === '') return null\r\n  66: \r\n  67:   const parsed = Number(value)\r\n  68:   return Number.isFinite(parsed) && parsed >= minimum ? parsed : null\r\n  69: }\r\n  70: \r\n  71: function NumberInput({\r\n  72:   label,\r\n  73:   value,\r\n  74:   onChange,\r\n  75:   // 치수·ピッチ·本数는 0이 성립하지 않지만 初期オフセット은 0이 정상값이다.\r\n  76:   minimum = 1,\r\n  77:   // 幅止め筋·腹筋처럼 「なし」가 성립하는 항목은 그 배근이 없을 때 입력을 막는다.\r\n  78:   // 열어 두면 updater 가 current 를 그대로 돌려줘 입력이 흔적 없이 사라진다.\r\n  79:   disabled = false,\r\n  80: }: {\r\n  81:   label: string\r\n  82:   value: number\r\n  83:   onChange(value: number): void\r\n  84:   minimum?: number\r\n  85:   disabled?: boolean\r\n  86: }) {\r\n  87:   return (\r\n  88:     <input\r\n  89:       className={styles.numberInput}\r\n  90:       type=\"number\"\r\n  91:       min={minimum}\r\n  92:       step=\"1\"\r\n  93:       value={value}\r\n  94:       disabled={disabled}\r\n  95:       aria-label={label}\r\n  96:       onChange={(event) => {\r\n  97:         const next = boundedNumber(event.currentTarget.value, minimum)\r\n  98:         if (next !== null) onChange(next)\r\n  99:       }}\r\n 100:     />\r\n 101:   )\r\n 102: }\r\n 103: \r\n 104: function BarSizeSelect({\r\n 105:   label,\r\n 106:   value,\r\n 107:   onChange,\r\n 108: }: {\r\n 109:   label: string\r\n 110:   value: BarSize\r\n 111:   onChange(value: BarSize): void\r\n 112: }) {\r\n 113:   return (\r\n 114:     <select\r\n 115:       className={styles.select}\r\n 116:       value={value}\r\n 117:       aria-label={label}\r\n 118:       onChange={(event) => onChange(event.currentTarget.value as BarSize)}\r\n 119:     >\r\n 120:       {barSizes.map((size) => (\r\n 121:         <option key={size} value={size}>\r\n 122:           {size}\r\n 123:         </option>\r\n 124:       ))}\r\n 125:     </select>\r\n 126:   )\r\n 127: }\r\n 128: \r\n 129: /**\r\n 130:  * せん断補強筋 (帯筋・あばら筋) の径。主筋の選択肢と分かれているのは、\r\n 131:  * 高強度せん断補強筋 (K13・S13) を主筋に入れられないからだ — 主筋は定着・\r\n 132:  * 重ね継手を表5.3.4・表5.3.2 から径で引くが、その表に高強度せん断補強筋の\r\n 133:  * 行がない (ADR-026)。\r\n 134:  */\r\n 135: function ShearBarSizeSelect({\r\n 136:   label,\r\n 137:   value,\r\n 138:   onChange,\r\n 139: }: {\r\n 140:   label: string\r\n 141:   value: ShearBarSize\r\n 142:   onChange(value: ShearBarSize): void\r\n 143: }) {\r\n 144:   return (\r\n 145:     <select\r\n 146:       className={styles.select}\r\n 147:       value={value}\r\n 148:       aria-label={label}\r\n 149:       onChange={(event) => onChange(event.currentTarget.value as ShearBarSize)}\r\n 150:     >\r\n 151:       {shearBarSizes.map((size) => (\r\n 152:         <option key={size} value={size}>\r\n 153:           {size}\r\n 154:         </option>\r\n 155:       ))}\r\n 156:     </select>\r\n 157:   )\r\n 158: }\r\n 159: \r\n 160: /**\r\n--- framing types ---\r\n   1: /**\r\n   2:  * 셀을 빈칸으로 남긴 사유 코드 (section-list의 CANDIDATE_ISSUES 패턴).\r\n   3:  * 파서는 코드만 싣고 표시부가 번역한다.\r\n   4:  */\r\n   5: export const PLAN_GRID_ISSUES = [\r\n   6:   '通り芯ラベル未検出',\r\n   7:   '寸法欠落',\r\n   8:   '縮尺不整合',\r\n   9:   '合計不一致',\r\n  10:   'ラベル文字混在',\r\n  11:   '通り芯対応不明',\r\n  12: ] as const\r\n  13: \r\n  14: export type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\n  15: \r\n  16: /** 伏図에서 읽은 通り芯 한 본. positionPt는 도면 좌표(pt) — 부재 스냅의 기준. */\r\n  17: export interface AxisCandidate {\r\n  18:   label: string\r\n  19:   positionPt: number\r\n  20: }\r\n  21: \r\n  22: /** 한 방향(X 또는 Y)의 通り芯 열 후보. 승인 전에는 형상이 되지 않는다 (ADR-030). */\r\n  23: export interface PlanGridCandidate {\r\n  24:   /** 라벨의 축 문자 — 밴드의 기하 방향이 아니라 도면이 붙인 이름을 따른다 */\r\n  25:   direction: 'X' | 'Y'\r\n  26:   /** 위치 오름차순 */\r\n  27:   axes: AxisCandidate[]\r\n  28:   /** 인접 축 사이 치수(mm). 길이는 axes.length - 1 */\r\n  29:   spansMm: number[]\r\n  30:   /** 실측 축척(pt/mm) — 전 스팬 실측의 중앙값. 표기 축척은 용지 의존이라 믿지 않는다 */\r\n  31:   scalePtPerMm: number\r\n  32:   /** 도면에 전체 치수가 명기돼 있고 스팬 합과 일치했다 */\r\n  33:   totalConfirmed: boolean\r\n  34: }\r\n  35: \r\n  36: /**\r\n  37:  * 부호가 그리드의 어디에 놓였는가 — 도면에서 잰 **기하**만 말한다.\r\n  38:  *\r\n  39:  * 「C면 柱」처럼 부호 접두로 부재 종별을 정하지 않는다. 종별은 断面リスト가\r\n  40:  * 이미 갖고 있으므로(ADR-018), 취입이 그 종별과 이 기하를 맞춰 본다 —\r\n  41:  * 어긋나면 사람이 판단할 일이지 파서가 고를 일이 아니다.\r\n  42:  */\r\n  43: export const PLAN_PLACEMENT_ROLES = ['格子点', '辺', 'ベイ'] as const\r\n  44: \r\n  45: export type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\r\n  46: \r\n  47: export type MemberPlacement =\r\n  48:   | { mark: string; role: '格子点' | 'ベイ'; ix: number; iy: number }\r\n  49:   | {\r\n  50:       mark: string\r\n  51:       role: '辺'\r\n  52:       /** 부재가 시작하는 격자점 */\r\n  53:       ix: number\r\n  54:       iy: number\r\n  55:       /** 부재가 뻗는 방향 (GirderPosition.axis와 같은 뜻) */\r\n  56:       axis: 'X' | 'Y'\r\n  57:     }\r\n  58: \r\n  59: /**\r\n  60:  * 도면 위의 伏図 한 장. 한 페이지에 여러 장이 실리므로(실물 yokohama p7은\r\n  61:  * 2階床伏図와 R階床伏図 두 장) 通り芯 정의가 같아도 **위치가 다르다** —\r\n  62:  * 그리드 정의는 접히지만 블록은 접히지 않는다.\r\n  63:  */\r\n  64: export interface PlanBlock {\r\n  65:   /** 블록 제목 원문(「2階床伏図1/100」). 어느 Story인지는 사람이 정한다 */\r\n  66:   title?: string\r\n  67:   /** 이 블록과 짝지어진 X·Y 通り芯 정의. 취입은 반드시 이 둘을 쓴다 */\r\n  68:   xGrid: PlanGridCandidate\r\n  69:   yGrid: PlanGridCandidate\r\n  70:   placements: MemberPlacement[]\r\n  71:   /** 블록 안에 있으나 스냅하지 못한 부호(중복 없음, 원문 순) — 지어내지 않는다 */\r\n  72:   unplacedMarks: string[]\r\n  73: }\r\n  74: \r\n  75: export interface ParsedFramingPlan {\r\n  76:   /** 通り芯 정의 — 같은 그리드가 여러 블록에 반복되면 하나로 접힌다 */\r\n  77:   grids: PlanGridCandidate[]\r\n  78:   blocks: PlanBlock[]\r\n  79:   /** 후보를 못 낸 사유 — 첫 등장 순, 중복 없음 */\r\n  80:   issues: PlanGridIssue[]\r\n  81: }\r\n  82: \r\n  83: /** 軸組図에서 계열을 못 낸 사유. 파서는 코드만 싣고 표시부가 번역한다 */\r\n  84: export const ELEVATION_ISSUES = ['寸法列未検出'] as const\r\n  85: \r\n  86: export type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\r\n  87: \r\n  88: export interface ElevationLevel {\r\n  89:   /** 그 높이에 적힌 라벨 원문 전부. 없으면 빈 배열 — 지어내지 않는다 */\r\n  90:   labels: string[]\r\n  91:   positionPt: number\r\n  92: }\r\n  93: \r\n  94: /**\r\n  95:  * 軸組図 한 계열의 높이 방향 읽기. 「어느 레벨이 Story의 경계인가」는 정하지\r\n  96:  * 않는다 — 원문에는 FL·GL·基礎下端·RCL이 섞여 있고, 그중 무엇이 階인지는\r\n  97:  * 조문이 아니라 설계 의도라 사람이 읽을 일이다 (ADR-030).\r\n  98:  *\r\n  99:  * 通り芯과 달리 라벨의 좌우 정렬이 일정하지 않아(실물 p8의 좌단 x는 108~198로\r\n 100:  * 흩어진다) 라벨 밴드를 앵커로 쓸 수 없다. 앵커는 **치수 열**이고, 치수가 자기\r\n 101:  * 구간의 중점에 놓인다는 관계로 축척과 레벨 위치를 함께 푼다.\r\n 102:  */\r\n 103: export interface ElevationCandidate {\r\n 104:   /** 이 계열이 걸리는 軸組図 제목들(원문). 한 계열이 여러 通り에 공통으로 걸린다 */\r\n 105:   titles: string[]\r\n 106:   /** 도면 좌표 순 — 위에서 아래로 */\r\n 107:   levels: ElevationLevel[]\r\n 108:   /** 인접 레벨 사이 치수(mm). 길이는 levels.length - 1 */\r\n 109:   heightsMm: number[]\r\n 110:   scalePtPerMm: number\r\n 111: }\r\n 112: \r\n 113: export interface ParsedFrameElevations {\r\n 114:   elevations: ElevationCandidate[]\r\n 115:   issues: ElevationIssue[]\r\n 116: }\r\n 117: \r\n 118: /** 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\n 119: export const PLAN_APPLY_REFUSALS = [\r\n 120:   '階未指定',\r\n 121:   '他階部材あり通り芯変更不可',\r\n 122: ] as const\r\n 123: \r\n 124: export type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\r\n 125: \r\n 126: /** 부호 하나를 넣지 못한 사유. 지어내는 대신 이 코드로 남긴다 */\r\n 127: export const PLAN_APPLY_SKIPS = [\r\n 128:   '断面未登録',\r\n 129:   '部材種別相違',\r\n 130:   '格子外',\r\n 131:   '断面複数該当',\r\n 132: ] as const\r\n 133: \r\n 134: export type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\r\n 135: \r\n 136: /** 階高 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\n 137: export const ELEVATION_APPLY_REFUSALS = [\r\n 138:   '階範囲不正',\r\n 139:   '部材あり階置換不可',\r\n 140: ] as const\r\n 141: \r\n 142: export type ElevationApplyRefusal =\r\n 143:   (typeof ELEVATION_APPLY_REFUSALS)[number]\r\n","exit_code":0,"status":"completed"}}
