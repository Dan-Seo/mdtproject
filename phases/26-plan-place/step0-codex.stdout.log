\r\n 180:     }\r\n 181:   }\r\n 182: \r\n 183:   if (oneSidedEndCount > 0) {\r\n 184:     return {\r\n 185:       throughCount,\r\n 186:       startStubCount,\r\n 187:       endStubCount,\r\n 188:       centerOnlyCount,\r\n 189:       oneSidedCount: oneSidedEndCount,\r\n 190:       oneSidedAnchor: '終端',\r\n 191:     }\r\n 192:   }\r\n 193: \r\n 194:   return {\r\n 195:     throughCount,\r\n 196:     startStubCount,\r\n 197:     endStubCount,\r\n 198:     centerOnlyCount,\r\n 199:     oneSidedCount: 0,\r\n 200:   }\r\n 201: }\r\n 202: \r\n 203: export interface GirderSection {\r\n 204:   id: string\r\n 205:   kind: '大梁'\r\n 206:   mark: string\r\n 207:   /** ColumnSection.storyLabel과 같다. */\r\n 208:   storyLabel?: string\r\n 209:   b: number\r\n 210:   depth: number\r\n 211:   fc: number\r\n 212:   grade: SteelGrade\r\n 213:   exposure: Exposure\r\n 214:   finish: Finish\r\n 215:   /** ColumnSection.spliceMethod と同じ。通し筋の継手箇所数に効く */\r\n 216:   spliceMethod: SpliceMethod\r\n 217:   main: {\r\n 218:     size: BarSize\r\n 219:     /** 上端筋の位置別本数 — 断面リストの端部・中央行がそのまま入る */\r\n 220:     top: GirderMainRow\r\n 221:     /** 下端筋の位置別本数 */\r\n 222:     bottom: GirderMainRow\r\n 223:     /**\r\n 224:      * カットオフ筋を柱面から梁の内側へ何 mm で切り止めるか。\r\n 225:      *\r\n 226:      * 数量積算基準 2（３）梁1) が「トップ筋、ハンチ部分の主筋、補強筋等は設計図書\r\n 227:      * による」と委ねるので規準側に値がない — 断面一覧の入力である (ADR-012)。\r\n 228:      * 端部と中央が同数（カットオフ筋がない）断面では使われない。\r\n 229:      */\r\n 230:     cutoffFromSupportFaceMm: number\r\n 231:   }\r\n 232:   stirrup: {\r\n 233:     size: ShearBarSize\r\n 234:     pitch: number\r\n 235:     /** 両端の柱面から第1・最終あばら筋をどれだけ離すか。規準に値はない — 断面一覧の入力である (ADR-012) */\r\n 236:     startOffsetMm: number\r\n 237:   }\r\n 238:   /**\r\n 239:    * 幅止め筋。断面一覧に記載のない梁には無い配筋なので任意項目とし、\r\n 240:    * `undefined` は「配筋なし」を意味する — 製品が勝手に足さない (ADR-012)。\r\n 241:    * 設計長さは数量積算基準 1通則3) が断面の設計幅と定めるので入力は径とピッチだけ。\r\n 242:    */\r\n 243:   widthTie?: {\r\n 244:     size: BarSize\r\n 245:     pitch: number\r\n 246:   }\r\n 247:   /**\r\n 248:    * 腹筋。`undefined` は「配筋なし」。本数は図面が「2-D10」と記載する数そのもの\r\n 249:    * なので 1通則7) の割付ではない。\r\n 250:    */\r\n 251:   sideBar?: {\r\n 252:     size: BarSize\r\n 253:     count: number\r\n 254:     /**\r\n 255:      * 梁の両端で内法を越えて伸びる余長 (mm)。数量積算基準 2（３）梁3) は\r\n 256:      * これを 1通則6) に委ね、同項は設計図書に記載がなければ JASS 5 準用と\r\n 257:      * する。JASS 5 は有料規格で未確保、標準仕様書5章には腹筋の記述が一切\r\n 258:      * ないため規準値を取れない — 設計図書の値を入力として受け取る (R9②)。\r\n 259:      */\r\n 260:     extraLengthMm: number\r\n--- framing apply tests ---\r\n   1: import { describe, expect, it } from 'vitest'\r\n   2: \r\n   3: import type { Section } from '@/domain/model/member'\r\n   4: import type { Project } from '@/domain/model/project'\r\n   5: import { createSampleProject } from '@/domain/model/sample-project'\r\n   6: \r\n   7: import type { TextItem } from '../types'\r\n   8: import type { TextPage } from '../section-list/types'\r\n   9: \r\n  10: import { applyElevation, applyFramingPlan } from './apply'\r\n  11: import { parseFramingPlan } from './parse'\r\n  12: import type {\r\n  13:   ElevationCandidate,\r\n  14:   PlanBlock,\r\n  15:   PlanGridCandidate,\r\n  16: } from './types'\r\n  17: \r\n  18: // 断面은 손으로 짓지 않고 샘플 案件에서 빌린다 — 손으로 지으면 스키마가 자라날 때\r\n  19: // 이 테스트만 옛 모양으로 남고, 그 사실을 vitest는 알려주지 않는다 (tsc가 잡는다)\r\n  20: const sample = createSampleProject()\r\n  21: \r\n  22: function sectionOf(kind: Section['kind'], mark: string): Section {\r\n  23:   const source = sample.sections.find((section) => section.kind === kind)\r\n  24:   if (!source) throw new Error(`sample has no ${kind} section`)\r\n  25:   return { ...source, id: `sec-${mark}`, mark }\r\n  26: }\r\n  27: \r\n  28: function sectionWithStory(\r\n  29:   kind: Section['kind'],\r\n  30:   mark: string,\r\n  31:   storyLabel: string | undefined,\r\n  32:   id = `sec-${mark}-${storyLabel ?? 'none'}`,\r\n  33: ): Section {\r\n  34:   return { ...sectionOf(kind, mark), id, storyLabel }\r\n  35: }\r\n  36: \r\n  37: const columnSection = (mark: string) => sectionOf('柱', mark)\r\n  38: const girderSection = (mark: string) => sectionOf('大梁', mark)\r\n  39: \r\n  40: function h(str: string, x: number, y: number): TextItem {\r\n  41:   return { str, x, y, w: 0, h: 8 }\r\n  42: }\r\n  43: \r\n  44: function v(str: string, x: number, y: number): TextItem {\r\n  45:   return { str, x, y, w: 8, h: 0, rot: -90 }\r\n  46: }\r\n  47: \r\n  48: function framingItems(\r\n  49:   xSpanMm: number,\r\n  50:   ySpanMm: number,\r\n  51:   xOffsetPt = 0,\r\n  52: ): TextItem[] {\r\n  53:   return [\r\n  54:     h('X1', xOffsetPt, -40),\r\n  55:     h('X2', xOffsetPt + 200, -40),\r\n  56:     h(String(xSpanMm), xOffsetPt + 100, -20),\r\n  57:     h('Y1', xOffsetPt - 40, 0),\r\n  58:     h('Y2', xOffsetPt - 40, 200),\r\n  59:     v(String(ySpanMm), xOffsetPt - 20, 100),\r\n  60:   ]\r\n  61: }\r\n  62: \r\n  63: function framingPage(xSpanMm: number, ySpanMm: number): TextPage {\r\n  64:   return {\r\n  65:     widthPt: 1000,\r\n  66:     heightPt: 1000,\r\n  67:     items: framingItems(xSpanMm, ySpanMm),\r\n  68:   }\r\n  69: }\r\n  70: \r\n  71: function project(overrides: Partial<Project> = {}): Project {\r\n  72:   return {\r\n  73:     schemaVersion: 11,\r\n  74:     name: 'test',\r\n  75:     grid: { xSpans: [6000], ySpans: [6000] },\r\n  76:     stories: [{ id: 'story-1', name: '1F', height: 4000 }],\r\n  77:     sections: [],\r\n  78:     members: [],\r\n  79:     ...overrides,\r\n  80:   }\r\n  81: }\r\n  82: \r\n  83: const xGrid: PlanGridCandidate = {\r\n  84:   direction: 'X',\r\n  85:   axes: [\r\n  86:     { label: 'X1', positionPt: 0 },\r\n  87:     { label: 'X2', positionPt: 200 },\r\n  88:     { label: 'X3', positionPt: 400 },\r\n  89:   ],\r\n  90:   spansMm: [7000, 7000],\r\n  91:   scalePtPerMm: 200 / 7000,\r\n  92:   totalConfirmed: false,\r\n  93: }\r\n  94: \r\n  95: const yGrid: PlanGridCandidate = {\r\n  96:   direction: 'Y',\r\n  97:   axes: [\r\n  98:     { label: 'Y1', positionPt: 0 },\r\n  99:     { label: 'Y2', positionPt: 200 },\r\n 100:   ],\r\n 101:   spansMm: [5000],\r\n 102:   scalePtPerMm: 200 / 5000,\r\n 103:   totalConfirmed: false,\r\n 104: }\r\n 105: \r\n 106: function block(overrides: Partial<PlanBlock> = {}): PlanBlock {\r\n 107:   return {\r\n 108:     xGrid,\r\n 109:     yGrid,\r\n 110:     placements: [],\r\n 111:     unplacedMarks: [],\r\n 112:     ...overrides,\r\n 113:   }\r\n 114: }\r\n 115: \r\n 116: describe('applyFramingPlan', () => {\r\n 117:   it('同じ符号の断面が複数階にあれば階指定なしで反映しない', () => {\r\n 118:     const result = applyFramingPlan(\r\n 119:       project({\r\n 120:         sections: [\r\n 121:           sectionWithStory('柱', 'C1', '1階'),\r\n 122:           sectionWithStory('柱', 'C1', '2階'),\r\n 123:         ],\r\n 124:       }),\r\n 125:       {\r\n 126:         block: block({\r\n 127:           placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n 128:         }),\r\n 129:         storyId: 'story-1',\r\n 130:       },\r\n 131:     )\r\n 132: \r\n 133:     expect(result.applied).toBe(0)\r\n 134:     expect(result.skipped).toEqual([\r\n 135:       { mark: 'C1', reason: '断面複数該当' },\r\n 136:     ])\r\n 137:   })\r\n 138: \r\n 139:   it('断面の階ラベルを厳密に指定すれば該当する断面だけを反映する', () => {\r\n 140:     const result = applyFramingPlan(\r\n 141:       project({\r\n 142:         sections: [\r\n 143:           sectionWithStory('柱', 'C1', '1階'),\r\n 144:           sectionWithStory('柱', 'C1', '2階'),\r\n 145:         ],\r\n 146:       }),\r\n 147:       {\r\n 148:         block: block({\r\n 149:           placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n 150:         }),\r\n 151:         storyId: 'story-1',\r\n 152:         sectionStoryLabel: '2階',\r\n 153:       },\r\n 154:     )\r\n 155: \r\n 156:     expect(result.applied).toBe(1)\r\n 157:     expect(result.project.members[0]?.sectionId).toBe('sec-C1-2階')\r\n 158:   })\r\n 159: \r\n 160:   it('指定した階ラベルの断面がなければ未登録として残す', () => {\r\n 161:     const result = applyFramingPlan(\r\n 162:       project({\r\n 163:         sections: [sectionWithStory('柱', 'C1', '1階')],\r\n 164:       }),\r\n 165:       {\r\n 166:         block: block({\r\n 167:           placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n 168:         }),\r\n 169:         storyId: 'story-1',\r\n 170:         sectionStoryLabel: '3階',\r\n 171:       },\r\n 172:     )\r\n 173: \r\n 174:     expect(result.applied).toBe(0)\r\n 175:     expect(result.skipped).toEqual([{ mark: 'C1', reason: '断面未登録' }])\r\n 176:   })\r\n 177: \r\n 178:   it('同じ符号と同じ階ラベルの重複断面も選べない', () => {\r\n 179:     const result = applyFramingPlan(\r\n 180:       project({\r\n 181:         sections: [\r\n 182:           sectionWithStory('柱', 'C1', '2階', 'sec-C1-2階-a'),\r\n 183:           sectionWithStory('柱', 'C1', '2階', 'sec-C1-2階-b'),\r\n 184:         ],\r\n 185:       }),\r\n 186:       {\r\n 187:         block: block({\r\n 188:           placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n 189:         }),\r\n 190:         storyId: 'story-1',\r\n 191:         sectionStoryLabel: '2階',\r\n 192:       },\r\n 193:     )\r\n 194: \r\n 195:     expect(result.applied).toBe(0)\r\n 196:     expect(result.skipped).toEqual([\r\n 197:       { mark: 'C1', reason: '断面複数該当' },\r\n 198:     ])\r\n 199:   })\r\n 200: \r\n 201:   it('階ラベルを正規化せず原文どおりに比較する', () => {\r\n 202:     const result = applyFramingPlan(\r\n 203:       project({\r\n 204:         sections: [sectionWithStory('柱', 'C1', '2階')],\r\n 205:       }),\r\n 206:       {\r\n 207:         block: block({\r\n 208:           placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n 209:         }),\r\n 210:         storyId: 'story-1',\r\n 211:         sectionStoryLabel: '2F',\r\n 212:       },\r\n 213:     )\r\n 214: \r\n 215:     expect(result.applied).toBe(0)\r\n 216:     expect(result.skipped).toEqual([{ mark: 'C1', reason: '断面未登録' }])\r\n 217:   })\r\n 218: \r\n 219:   it('階ラベル이 없는 단면은 지정된 층의 후보로 취급하지 않는다', () => {\r\n 220:     const result = applyFramingPlan(\r\n 221:       project({\r\n 222:         sections: [\r\n 223:           sectionWithStory('柱', 'C1', undefined, 'sec-C1-no-story'),\r\n 224:           sectionWithStory('柱', 'C1', '2階'),\r\n 225:         ],\r\n 226:       }),\r\n 227:       {\r\n 228:         block: block({\r\n 229:           placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n 230:         }),\r\n 231:         storyId: 'story-1',\r\n 232:         sectionStoryLabel: '2階',\r\n 233:       },\r\n 234:     )\r\n 235: \r\n 236:     expect(result.applied).toBe(1)\r\n 237:     expect(result.project.members[0]?.sectionId).toBe('sec-C1-2階')\r\n 238:   })\r\n 239: \r\n 240:   it('일치하는 階 라벨이 없으면 무라벨 断面으로 폴백한다', () => {\r\n 241:     const result = applyFramingPlan(\r\n 242:       project({\r\n 243:         sections: [sectionWithStory('耐震壁', 'W1', undefined, 'sec-W1-no-story')],\r\n 244:       }),\r\n 245:       {\r\n 246:         block: block({\r\n 247:           placements: [{ mark: 'W1', role: '辺', ix: 0, iy: 0, axis: 'X' }],\r\n 248:         }),\r\n 249:         storyId: 'story-1',\r\n 250:         sectionStoryLabel: '2階',\r\n 251:       },\r\n 252:     )\r\n 253: \r\n 254:     expect(result.applied).toBe(1)\r\n 255:     expect(result.project.members[0]?.sectionId).toBe('sec-W1-no-story')\r\n 256:   })\r\n 257: \r\n 258:   it('일치하는 階 라벨이 없고 무라벨 断面이 여러 개면 선택하지 않는다', () => {\r\n 259:     const result = applyFramingPlan(\r\n 260:       project({\r\n 261:         sections: [\r\n 262:           sectionWithStory('耐震壁', 'W1', undefined, 'sec-W1-no-story-a'),\r\n 263:           sectionWithStory('耐震壁', 'W1', undefined, 'sec-W1-no-story-b'),\r\n 264:         ],\r\n 265:       }),\r\n 266:       {\r\n 267:         block: block({\r\n 268:           placements: [{ mark: 'W1', role: '辺', ix: 0, iy: 0, axis: 'X' }],\r\n 269:         }),\r\n 270:         storyId: 'story-1',\r\n 271:         sectionStoryLabel: '2階',\r\n 272:       },\r\n 273:     )\r\n 274: \r\n 275:     expect(result.applied).toBe(0)\r\n 276:     expect(result.project.members).toEqual([])\r\n 277:     expect(result.skipped).toEqual([{ mark: 'W1', reason: '断面複数該当' }])\r\n 278:   })\r\n 279: \r\n 280:   it('여러 伏図 중 두 번째 블록은 두 번째 도면의 X·Y 通り芯을 구별해 취입한다', () => {\r\n 281:     const plans = [framingPage(6000, 5000), framingPage(8000, 7000)].map(\r\n 282:       parseFramingPlan,\r\n 283:     )\r\n 284:     const blocks = plans.flatMap((plan) => plan.blocks)\r\n 285:     if (!blocks[1]) {\r\n 286:       throw new Error('synthetic framing plans were not parsed')\r\n 287:     }\r\n 288: \r\n 289:     const result = applyFramingPlan(project(), {\r\n 290:       block: blocks[1],\r\n 291:       storyId: 'story-1',\r\n 292:     })\r\n 293: \r\n 294:     expect(result.project.grid.xSpans).toEqual([8000])\r\n 295:     expect(result.project.grid.ySpans).toEqual([7000])\r\n 296:     expect(result.refusal).toBeUndefined()\r\n 297:     expect(result.skipped).toEqual([])\r\n 298:   })\r\n 299: \r\n 300:   it('한 페이지의 스팬이 다른 伏図 두 장은 각 블록의 X·Y 通り芯으로 취입한다', () => {\r\n 301:     const parsed = parseFramingPlan({\r\n 302:       widthPt: 1400,\r\n 303:       heightPt: 1000,\r\n 304:       items: [\r\n 305:         ...framingItems(6000, 5000),\r\n 306:         ...framingItems(8000, 7000, 600),\r\n 307:       ],\r\n 308:     })\r\n 309: \r\n 310:     expect(parsed.blocks).toHaveLength(2)\r\n 311:     expect(parsed.blocks.map((candidate) => candidate.xGrid.spansMm)).toEqual([\r\n 312:       [6000],\r\n 313:       [8000],\r\n 314:     ])\r\n 315:     expect(parsed.blocks.map((candidate) => candidate.yGrid.spansMm)).toEqual([\r\n 316:       [5000],\r\n 317:       [7000],\r\n 318:     ])\r\n 319: \r\n 320:     const appliedGrids = parsed.blocks.map(\r\n 321:       (candidate) =>\r\n 322:         applyFramingPlan(project(), {\r\n 323:           block: candidate,\r\n 324:           storyId: 'story-1',\r\n 325:         }).project.grid,\r\n 326:     )\r\n 327:     expect(appliedGrids).toEqual([\r\n 328:       {\r\n 329:         xSpans: [6000],\r\n 330:         ySpans: [5000],\r\n 331:         xLabels: ['X1', 'X2'],\r\n 332:         yLabels: ['Y1', 'Y2'],\r\n 333:       },\r\n 334:       {\r\n 335:         xSpans: [8000],\r\n 336:         ySpans: [7000],\r\n 337:         xLabels: ['X1', 'X2'],\r\n 338:         yLabels: ['Y1', 'Y2'],\r\n 339:       },\r\n 340:     ])\r\n 341:   })\r\n 342: \r\n 343:   it('通り芯을 도면의 스팬으로 바꾼다', () => {\r\n 344:     const result = applyFramingPlan(project(), {\r\n 345:       block: block(),\r\n 346:       storyId: 'story-1',\r\n 347:     })\r\n 348:     expect(result.project.grid).toEqual({\r\n 349:       xSpans: [7000, 7000],\r\n 350:       ySpans: [5000],\r\n 351:       xLabels: ['X1', 'X2', 'X3'],\r\n 352:       yLabels: ['Y1', 'Y2'],\r\n 353:     })\r\n 354:     expect(result.refusal).toBeUndefined()\r\n 355:   })\r\n 356: \r\n 357:   it('通り芯의 이름을 도면에서 읽은 원문 그대로 싣는다', () => {\r\n 358:     // 이것이 R13(端部 좌우 비대칭)의 선결 조건이다 — 이름이 있어야 도면의\r\n 359:     // 「Y3端／Y4端」을 런의 실제 방향과 맞출 수 있다\r\n 360:     const result = applyFramingPlan(project(), {\r\n 361:       block: block(),\r\n 362:       storyId: 'story-1',\r\n 363:     })\r\n 364:     expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\r\n 365:     expect(result.project.grid.yLabels).toEqual(['Y1', 'Y2'])\r\n 366:   })\r\n 367: \r\n 368:   it('이름만 다른 그리드는 「바뀌었다」로 보지 않는다', () => {\r\n 369:     // 라벨은 数量도 격자 index도 바꾸지 않는다 — 이름 때문에 다른 층을 버리라는\r\n 370:     // 물음이 뜨면 사용자는 이유를 알 수 없다\r\n 371:     const base = project({\r\n 372:       grid: { xSpans: [7000, 7000], ySpans: [5000] },\r\n 373:       sections: [columnSection('C1')],\r\n 374:       members: [\r\n 375:         {\r\n 376:           id: 'm1',\r\n 377:           kind: '柱',\r\n 378:           memberClass: '躯体',\r\n 379:           sectionId: 'sec-C1',\r\n 380:           storyId: 'story-2',\r\n 381:           position: { ix: 1, iy: 1 },\r\n 382:         },\r\n 383:       ],\r\n 384:       stories: [\r\n 385:         { id: 'story-1', name: '1F', height: 4000 },\r\n 386:         { id