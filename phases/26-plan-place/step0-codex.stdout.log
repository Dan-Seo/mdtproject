lter(\r\n  34:       ({ memberKind }) => memberKind === '大梁',\r\n  35:     )\r\n  36:     const firstStoryG1Lines = girderLines.filter(\r\n  37:       ({ storyName, mark }) => storyName === '1階' && mark === 'G1',\r\n  38:     )\r\n  39:     const firstStoryGirderLines = girderLines.filter(\r\n  40:       ({ storyName }) => storyName === '1階',\r\n  41:     )\r\n  42:     const firstStoryColumnLines = result.current.lines.filter(\r\n  43:       ({ storyName, memberKind }) =>\r\n  44:         storyName === '1階' && memberKind === '柱',\r\n  45:     )\r\n  46: \r\n  47:     expect(result.current.rebars.length).toBeGreaterThan(0)\r\n  48:     expect(result.current.lines.length).toBeGreaterThan(0)\r\n  49:     // 単一 스팬 런 2개와 2스팬 런 1개가 만드는 행 구성을 그대로 박는다.\r\n  50:     // あばら筋·幅止め筋·腹筋은 X·Y 스팬 内法이 같아 각각 한 행으로 묶이고\r\n  51:     // places로 세어진다 — 셋 다 부재(梁)마다 생기는 배근이라 런으로 묶이지 않는다.\r\n  52:     // 継手 행(箇所)은 単一 스팬 런에도 붙는다 — 単独梁이라 1通則4)로 돌아가는데\r\n  53:     // 折曲げ定着 全長이 5.3.4(5)(ｲ)(a)의 L1 하한을 받으면서 D25 通し筋이 7.2m가\r\n  54:     // 되어 7.0m를 넘긴다(1か所). 2스팬 런은 連続梁이라 （３）梁2)의 11.2m ＝ 2か所.\r\n  55:     expect(firstStoryG1Lines.map(({ role, unit }) => `${role}/${unit}`)).toEqual([\r\n  56:       '上端筋/kg',\r\n  57:       '上端筋/箇所',\r\n  58:       '下端筋/kg',\r\n  59:       '下端筋/箇所',\r\n  60:       'あばら筋/kg',\r\n  61:       '幅止め筋/kg',\r\n  62:       '腹筋/kg',\r\n  63:       '上端筋/kg',\r\n  64:       '上端筋/箇所',\r\n  65:       '下端筋/kg',\r\n  66:       '下端筋/箇所',\r\n  67:     ])\r\n  68:     // 샘플 1층: X 단일 스팬 런 3 + Y 2스팬 런 2 = 5런.\r\n  69:     // 같은 길이·符号는 QuantityLine 한 행으로 묶일 수 있으므로 places 합으로\r\n  70:     // 通し筋은 런 수, あばら筋은 실제 부재 수(3 + 2×2 = 7)를 검산한다.\r\n  71:     // 箇所 행은 같은 役割로 따로 서므로 質量 행만 세어야 런 수가 된다.\r\n  72:     const firstStoryGirderMassLines = firstStoryGirderLines.filter(\r\n  73:       ({ unit }) => unit === 'kg',\r\n  74:     )\r\n  75:     expect(\r\n  76:       firstStoryGirderMassLines\r\n  77:         .filter(({ role }) => role === '上端筋')\r\n  78:         .reduce((sum, { places }) => sum + places, 0),\r\n  79:     ).toBe(5)\r\n  80:     expect(\r\n  81:       firstStoryGirderMassLines\r\n  82:         .filter(({ role }) => role === '下端筋')\r\n  83:         .reduce((sum, { places }) => sum + places, 0),\r\n  84:     ).toBe(5)\r\n  85:     expect(\r\n  86:       firstStoryGirderMassLines\r\n  87:         .filter(({ role }) => role === 'あばら筋')\r\n  88:         .reduce((sum, { places }) => sum + places, 0),\r\n  89:     ).toBe(7)\r\n  90:     // 柱主筋에도 継手 행이 붙는다（（２）柱2) 各階ごとに1か所）— 여기서 세려는\r\n  91:     // 것은 부재 수이므로 質量 행만 센다.\r\n  92:     const firstStoryColumnMassLines = firstStoryColumnLines.filter(\r\n  93:       ({ unit }) => unit === 'kg',\r\n  94:     )\r\n  95:     expect(\r\n  96:       firstStoryColumnMassLines\r\n  97:         .filter(({ role }) => role === '主筋')\r\n  98:         .reduce((sum, { places }) => sum + places, 0),\r\n  99:     ).toBe(columnsPerStory)\r\n 100:     expect(\r\n 101:       firstStoryColumnMassLines\r\n 102:         .filter(({ role }) => role === '帯筋')\r\n 103:         .reduce((sum, { places }) => sum + places, 0),\r\n 104:     ).toBe(columnsPerStory)\r\n 105:     const yOwner = project.members.find(\r\n 106:       ({ id }) => id === '1F-G1-X1Y1-Y',\r\n 107:     )!\r\n 108:     const yRun = girderRun(project, yOwner)\r\n 109:     expect(\r\n 110:       result.current.rebars\r\n 111:         .filter(({ memberId }) => memberId === yRun.ownerId)\r\n 112:         .map(({ role }) => role),\r\n 113:     ).toEqual(['上端筋', '下端筋', 'あばら筋', '幅止め筋', '腹筋'])\r\n 114:     expect(\r\n 115:       yRun.members.every(({ id: memberId }) =>\r\n 116:         result.current.rebars.some(\r\n 117:           (rebar) => rebar.memberId === memberId && rebar.role === 'あばら筋',\r\n 118:         ),\r\n 119:       ),\r\n 120:     ).toBe(true)\r\n 121:     expect(\r\n 122:       [...xGirderIds].every((memberId) =>\r\n 123:         result.current.rebars.some((rebar) => rebar.memberId === memberId),\r\n 124:       ),\r\n 125:     ).toBe(true)\r\n 126:     expect(result.current.hasUnverified).toBe(true)\r\n 127:     expect(result.current.unverifiedRules.length).toBeGreaterThan(0)\r\n 128:     // kg 행은 継手 算入倍率(measure.splice.length.factor — 反対解釈로 세운 것이라\r\n 129:     // 原文에 明文이 없다)을 타므로 추론 근거가 남는다. 単位質量은 schema v6 에서\r\n 130:     // 룰팩을 떠나 Project.unitMass 입력이 됐으므로 더 이상 여기 관여하지 않는다.\r\n 131:     expect(result.current.inferredRules.length).toBeGreaterThan(0)\r\n 132:   })\r\n 133: \r\n 134:   it('reports every member of an unsupported run and keeps other runs and 柱', () => {\r\n 135:     const targetIds = ['1F-G1-X1Y1-Y', '1F-G1-X1Y2-Y']\r\n 136: \r\n 137:     // 한 Y방향 2스팬 런에만 별도 단면을 붙여 あばら筋 배치구간을 불성립시킨다.\r\n 138:     // 깨진 스팬 하나가 있으면 通し筋까지 생성되지 않으므로 런의 두 부재가 모두\r\n 139:     // 미지원이어야 하며, 다른 런과 柱 산정은 계속되어야 한다.\r\n 140:     useAppStore.getState().updateProject((project) => {\r\n 141:       const girderSection = project.sections.find(\r\n 142:         ({ id }) => id === 'section-G1',\r\n 143:       )\r\n 144:       if (girderSection?.kind !== '大梁') {\r\n 145:         throw new Error('expected section-G1')\r\n 146:       }\r\n 147: \r\n 148:       return {\r\n 149:         ...project,\r\n 150:         sections: [\r\n 151:           ...project.sections,\r\n 152:           {\r\n 153:             ...girderSection,\r\n 154:             id: 'section-G1-unsupported',\r\n 155:             stirrup: {\r\n 156:               ...girderSection.stirrup,\r\n 157:               startOffsetMm: 3000,\r\n 158:             },\r\n 159:           },\r\n 160:         ],\r\n 161:         members: project.members.map((member) =>\r\n 162:           targetIds.includes(member.id)\r\n 163:             ? { ...member, sectionId: 'section-G1-unsupported' }\r\n 164:             : member,\r\n 165:         ),\r\n 166:       }\r\n 167:     })\r\n 168: \r\n 169:     const { result } = renderHook(() => useTakeoff())\r\n 170: \r\n 171:     const unsupportedTargetIds = result.current.unsupportedMembers\r\n 172:       .filter(\r\n 173:         ({ storyName, reason }) =>\r\n 174:           storyName === '1階' && reason === '寸法不成立',\r\n 175:       )\r\n 176:       .map(({ memberId }) => memberId)\r\n 177: \r\n 178:     expect(unsupportedTargetIds).toEqual(targetIds)\r\n 179:     expect(\r\n 180:       result.current.rebars.some(\r\n 181:         ({ memberId, role }) =>\r\n 182:           memberId === '1F-G2-X2Y1-Y' && role === '上端筋',\r\n 183:       ),\r\n 184:     ).toBe(true)\r\n 185:     expect(result.current.lines.some(({ role }) => role === '主筋')).toBe(true)\r\n 186:   })\r\n 187: \r\n 188:   it('keeps the other members when a 柱 turns out unbuildable', () => {\r\n 189:     // 帯筋 初期オフセット은 이제 断面一覧 입력이라 사용자가 배치 구간을 넘길 수\r\n 190:     // 있다. 大梁과 같이 그 부재만 빠져야 하고, 페인이 죽으면 안 된다.\r\n 191:     useAppStore.getState().updateProject((project) => ({\r\n 192:       ...project,\r\n 193:       sections: project.sections.map((section) =>\r\n 194:         section.kind === '柱'\r\n 195:           ? { ...section, hoop: { ...section.hoop, startOffsetMm: 5000 } }\r\n 196:           : section,\r\n 197:       ),\r\n 198:     }))\r\n 199: \r\n 200:     const { result } = renderHook(() => useTakeoff())\r\n 201: \r\n 202:     expect(\r\n 203:       result.current.unsupportedMembers.some(\r\n 204:         ({ reason }) => reason === '寸法不成立',\r\n 205:       ),\r\n 206:     ).toBe(true)\r\n 207:     expect(result.current.lines.some(({ role }) => role === '上端筋')).toBe(\r\n 208:       true,\r\n 209:     )\r\n 210:   })\r\n 211: \r\n 212:   it('lets a real defect through instead of hiding it as unsupported', () => {\r\n 213:     // 룰팩 공백·타입 위반까지 미지원으로 흡수하면 결함이 화면에서 사라진다.\r\n 214:     useAppStore.getState().updateProject((project) => ({\r\n 215:       ...project,\r\n 216:       sections: project.sections.map((section) =>\r\n 217:         section.kind === '大梁' ? { ...section, fc: 25 } : section,\r\n 218:       ),\r\n 219:     }))\r\n 220: \r\n 221:     expect(() => renderHook(() => useTakeoff())).toThrow(/not found/i)\r\n 222:   })\r\n 223: \r\n 224:   it('shares one computation across every consumer of the same Project', () => {\r\n 225:     // TakeoffPane · TakeoffActions · Viewer3D가 각각 호출한다. 각자 계산하면\r\n 226:     // 입력 한 글자에 파이프라인이 세 번 돈다.\r\n 227:     const first = renderHook(() => useTakeoff())\r\n 228:     const second = renderHook(() => useTakeoff())\r\n 229: \r\n 230:     expect(second.result.current.lines).toBe(first.result.current.lines)\r\n 231:     expect(second.result.current.rebars).toBe(first.result.current.rebars)\r\n 232:   })\r\n 233: \r\n 234:   it('recomputes once the Project is replaced', () => {\r\n 235:     const { result } = renderHook(() => useTakeoff())\r\n 236:     const before = result.current.lines\r\n 237: \r\n 238:     useAppStore\r\n 239:       .getState()\r\n 240:       .updateProject((project) => ({ ...project, name: '別案件' }))\r\n 241: \r\n 242:     const after = renderHook(() => useTakeoff()).result.current.lines\r\n 243: \r\n 244:     expect(after).not.toBe(before)\r\n 245:     expect(after).toHaveLength(before.length)\r\n 246:   })\r\n 247: })\r\n--- quantity aggregator ---\r\n 221: \r\n 222:   if (grouped.kind === '箇所') {\r\n 223:     grouped.line.totalCount =\r\n 224:       grouped.line.countPerMember * grouped.line.places\r\n 225:     return\r\n 226:   }\r\n 227: \r\n 228:   const massLine = grouped.line\r\n 229:   massLine.totalLengthMm =\r\n 230:     massLine.lengthMm * massLine.countPerMember * massLine.places\r\n 231: \r\n 232:   if (massLine.unitMassKgPerM === null) {\r\n 233:     massLine.designKg = null\r\n 234:     massLine.requiredKg = null\r\n 235:     return\r\n 236:   }\r\n 237: \r\n 238:   massLine.designKg = (massLine.totalLengthMm / 1000) * massLine.unitMassKgPerM\r\n 239:   massLine.requiredKg = massLine.designKg * (1 + grouped.markupRate)\r\n 240: }\r\n 241: \r\n 242: export function aggregateQuantity(\r\n 243:   project: Project,\r\n 244:   rebars: Rebar[],\r\n 245:   pack: RulePack,\r\n 246: ): QuantityLine[] {\r\n 247:   const members = new Map(project.members.map((member) => [member.id, member]))\r\n 248:   const grouped = new Map<string, GroupedLine>()\r\n 249: \r\n 250:   for (const rebar of rebars) {\r\n 251:     const member = members.get(rebar.memberId)\r\n 252:     if (!member) {\r\n 253:       throw new Error(`Member not found for Rebar: ${rebar.memberId}`)\r\n 254:     }\r\n 255: \r\n 256:     const section = findSection(project, member.sectionId)\r\n 257:     if (section.kind !== member.kind) {\r\n 258:       throw new Error(\r\n 259:         `Member and section kinds do not match: ${member.id} ` +\r\n 260:           `(${member.kind}/${section.kind})`,\r\n 261:       )\r\n 262:     }\r\n 263: \r\n 264:     const groupId = memberGroupKey(project, member)\r\n 265:     const id = quantityLineId(groupId, rebar)\r\n 266:     const contributions = contributingRules(pack, member, rebar)\r\n 267:     const existing = grouped.get(id)\r\n 268:     const common = {\r\n 269:       groupId,\r\n 270:       storyName: storyName(project, member),\r\n 271:       memberKind: member.kind,\r\n 272:       mark: section.mark,\r\n 273:       sectionLabel: sectionLabel(section),\r\n 274:       role: rebar.role,\r\n 275:       size: rebar.size,\r\n 276:       places: 0,\r\n 277:       // recalculate() 가 행의 근거 전부를 보고 다시 정한다 — 여기 값은 자리표다.\r\n 278:       confidence: 'stated' as RuleConfidence,\r\n 279:     }\r\n 280: \r\n 281:     if (existing) {\r\n 282:       if (existing.kind !== 'kg') {\r\n 283:         throw new Error(`Quantity line ${id} is not measured in kg`)\r\n 284:       }\r\n 285:       if (\r\n 286:         existing.line.size !== rebar.size ||\r\n 287:         existing.line.shape !== rebar.shape\r\n 288:       ) {\r\n 289:         throw new Error(`Inconsistent size or shape in quantity group ${id}`)\r\n 290:       }\r\n 291:       if (existing.markupRate !== contributions.markup.value) {\r\n 292:         throw new Error(`Inconsistent quantity rules in group ${id}`)\r\n 293:       }\r\n 294:       existing.memberIds.add(member.id)\r\n 295:       existing.line.rules = uniqueRules([\r\n 296:         ...existing.line.rules,\r\n 297:         ...contributions.rules,\r\n 298:       ])\r\n 299:       recalculate(existing)\r\n 300:     } else {\r\n 301:       const created: GroupedLine = {\r\n 302:         kind: 'kg',\r\n 303:         line: {\r\n 304:           ...common,\r\n 305:           id,\r\n 306:           unit: 'kg',\r\n 307:           shape: rebar.shape,\r\n 308:           lengthMm: rebar.length,\r\n 309:           countPerMember: rebar.count,\r\n 310:           totalLengthMm: 0,\r\n 311:           // 径で引いて未入力なら null。同じ行に集まる鉄筋は径が同じなので\r\n 312:           // （上の size 検査）、行の中で値が食い違うことはない。\r\n 313:           unitMassKgPerM: project.unitMass?.[rebar.size] ?? null,\r\n 314:           designKg: null,\r\n 315:           requiredKg: null,\r\n 316:           rules: contributions.rules,\r\n 317:           formula: rebar.formula,\r\n 318:         },\r\n 319:         memberIds: new Set([member.id]),\r\n 320:         markupRate: contributions.markup.value,\r\n 321:       }\r\n 322:       recalculate(created)\r\n 323:       grouped.set(id, created)\r\n 324:     }\r\n 325: \r\n 326:     // 継手のない鉄筋（フープ・スタラップ）と、条項が 0 か所と数えた鉄筋は\r\n 327:     // 行を作らない — 0 の行は内訳書を埋めるだけで何も伝えない。\r\n 328:     const splice = rebar.splice\r\n 329:     if (!splice || splice.countPerBar === 0) continue\r\n 330: \r\n 331:     const spliceId = spliceLineId(groupId, rebar)\r\n 332:     const existingSplice = grouped.get(spliceId)\r\n 333: \r\n 334:     if (existingSplice) {\r\n 335:       if (existingSplice.kind !== '箇所') {\r\n 336:         throw new Error(`Quantity line ${spliceId} is not measured in 箇所`)\r\n 337:       }\r\n 338:       existingSplice.memberIds.add(member.id)\r\n 339:       existingSplice.line.rules = uniqueRules([\r\n 340:         ...existingSplice.line.rules,\r\n 341:         ...splice.rules,\r\n 342:       ])\r\n 343:       recalculate(existingSplice)\r\n 344:       continue\r\n 345:     }\r\n 346: \r\n 347:     const createdSplice: GroupedLine = {\r\n 348:       kind: '箇所',\r\n 349:       line: {\r\n 350:         ...common,\r\n 351:         id: spliceId,\r\n 352:         unit: '箇所',\r\n 353:         method: splice.method,\r\n 354:         countPerMember: splice.countPerBar * rebar.count,\r\n 355:         totalCount: 0,\r\n 356:         rules: splice.rules,\r\n 357:         formula: splice.formula,\r\n 358:       },\r\n 359:       memberIds: new Set([member.id]),\r\n 360:     }\r\n 361:     recalculate(createdSplice)\r\n 362:     grouped.set(spliceId, createdSplice)\r\n 363:   }\r\n 364: \r\n 365:   return [...grouped.values()].map(({ line }) => line)\r\n 366: }\r\n 367: \r\n 368: /** 継手は方式ごとに単価が違うので、合計も方式ごとに出す。 */\r\n 369: export function spliceTotals(lines: QuantityLine[]): SpliceTotal[] {\r\n 370:   const totals = new Map<SpliceMethod, SpliceTotal>()\r\n 371: \r\n 372:   for (const line of spliceLines(lines)) {\r\n 373:     const total = totals.get(line.method)\r\n 374:     if (total) {\r\n 375:       total.totalCount += line.totalCount\r\n 376:       continue\r\n 377:     }\r\n 378: \r\n 379:     totals.set(line.method, {\r\n 380:       method: line.method,\r\n 381:       totalCount: line.totalCount,\r\n 382:     })\r\n 383:   }\r\n 384: \r\n 385:   return [...totals.values()]\r\n 386: }\r\n 387: \r\n 388: /** 여러 근거를 묶을 때의 대표 등급 — 가장 약한 것. 근거가 없으면 `stated`. */\r\n 389: export function weakestConfidence(rules: RuleHit[]): RuleConfidence {\r\n 390:   return rules.reduce<RuleConfidence>(\r\n 391:     (weakest, { confidence }) =>\r\n 392:       CONFIDENCE_ORDER.indexOf(confidence) < CONFIDENCE_ORDER.indexOf(weakest)\r\n 393:         ? confidence\r\n 394:         : weakest,\r\n 395:     'stated',\r\n 396:   )\r\n 397: }\r\n 398: \r\n 399: /**\r\n 400:  * 独立検討가 끝나지 않은 근거가 하나라도 있는가 — 즉 `stated` 가 아닌 행이 있는가.\r\n 401:  * `transcribed`(원문 명시·검토 대기)도 여기 들어간다. 경고를 내릴지 판단하는 값이므로\r\n 402:  * 「원문에 값이 없다」(inferred)만 세면 검토 대기분이 조용히 통과한다 (ADR-015).\r\n 403:  */\r\n 404: export function hasUnverified(lines: QuantityLine[]): boolean {\r\n 405:   return hasUnverifiedRules(lines)\r\n 406: }\r\n 407: \r\n 408: /**\r\n 409:  * 同じ判定を RuleHit の列に。glTF は行を持たず ruleHits を直に持つので、\r\n 410:  * 向こうで書き直すと ADR-023 の等級が変わったとき xlsx・印刷と glb で\r\n--- project helpers ---\r\n 151:  * 이 포맷을 함수 하나로 고정해 다음 호출부가 규약을 손으로 다시 베끼지\r\n 152:  * 않게 한다(9차 리뷰 minor).\r\n 153:  */\r\n 154: export function storyNotFound(storyId: string): Error {\r\n 155:   return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\r\n 156: }\r\n 157: \r\n 158: /** 층 바닥의 누적 표고(mm). stories 배열 순서대로 아래층 height를 누적한다. */\r\n 159: export function storyElevation(stories: Story[], storyId: string): number {\r\n 160:   const index = stories.findIndex(({ id }) => id === storyId)\r\n 161: \r\n 162:   if (index < 0) {\r\n 163:     throw storyNotFound(storyId)\r\n 164:   }\r\n 165: \r\n 166:   return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\r\n 167: }\r\n 168: \r\n 169: export function findSection(project: Project, sectionId: string): Section {\r\n 170:   const section = project.sections.find(({ id }) => id === sectionId)\r\n 171: \r\n 172:   if (!section) {\r\n 173:     throw new Error(`Section not found: ${sectionId}`)\r\n 174:   }\r\n 175: \r\n 176:   return section\r\n 177: }\r\n 178: \r\n 179: export function memberGroupKey(project: Project, member: Member): string {\r\n 180:   const story = project.stories.find(({ id }) => id === member.storyId)\r\n 181:   if (!story) {\r\n 182:     throw storyNotFound(member.storyId)\r\n 183:   }\r\n 184: \r\n 185:   const section = findSection(project, member.sectionId)\r\n 186:   if (section.kind !== member.kind) {\r\n 187:     throw new Error(\r\n 188:       `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\r\n 189:     )\r\n 190:   }\r\n 191: \r\n 192:   const memberCode = MEMBER_GROUP_CODE[member.kind]\r\n 193:   return `${story.name}|${memberCode}|${section.mark}`\r\n 194: }\r\n 195: \r\n 196: /** 内訳書のグループ鍵に使う部材コード。符号(mark)と階の間に挟まる一文字。 */\r\n 197: const MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\r\n 198:   柱: 'C',\r\n 199:   大梁: 'G',\r\n 200:   耐震壁: 'W',\r\n 201:   床板: 'S',\r\n 202: }\r\n 203: \r\n 204: function isColumnPosition(\r\n 205:   position: ColumnPosition | GirderPosition,\r\n 206: ): position is ColumnPosition {\r\n 207:   return !('axis' in position)\r\n 208: }\r\n 209: \r\n 210: function isGirderPosition(\r\n 211:   position: ColumnPosition | GirderPosition,\r\n 212: ): position is GirderPosition {\r\n 213:   return 'axis' in position\r\n 214: }\r\n 215: \r\n 216: function touchesColumn(\r\n 217:   girder: GirderPosition,\r\n 218:   column: ColumnPosition,\r\n 219: ): boolean {\r\n 220:   if (girder.axis === 'X') {\r\n 221:     return (\r\n 222:       girder.iy === column.iy &&\r\n 223:       (girder.ix === column.ix || girder.ix + 1 === column.ix)\r\n 224:     )\r\n 225:   }\r\n 226: \r\n 227:   return (\r\n 228:     girder.ix === column.ix &&\r\n 229:     (girder.iy === column.iy || girder.iy + 1 === column.iy)\r\n 230:   )\r\n 231: }\r\n 232: \r\n 233: export interface GirderSpan {\r\n 234:   axis: 'X' | 'Y'\r\n 235:   /** 그리드 교점 간 중심 스팬 (mm) */\r\n 236:   centerSpan: number\r\n 237:   /** 内法長さ (mm) — 양단 柱面 사이 */\r\n 238:   clear: number\r\n 239:   /** 시작 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n 240:   startFaceOffsetMm: number\r\n 241:   /** 끝 柱 중심 → 大梁 내측 柱面 오프셋 (mm) */\r\n 242:   endFaceOffsetMm: number\r\n 243:   /** 정착 수용성 검사용 — 시작 柱의 축방향 전체 치수 (mm) */\r\n 244:   startSupportLengthAlongAxisMm: number\r\n 245:   /** 정착 수용성 검사용 — 끝 柱의 축방향 전체 치수 (mm) */\r\n 246:   endSupportLengthAlongAxisMm: number\r\n 247:   /** 지점 柱의 かぶり 조회 조건 — 端部条件은 大梁이 아니라 柱의 かぶり로 판정한다 */\r\n 248:   startSupportCover: Record<string, string | boolean>\r\n 249:   endSupportCover: Record<string, string | boolean>\r\n 250: }\r\n 251: \r\n 252: export function girderSupportSections(\r\n 253:   project: Project,\r\n 254:   member: Member,\r\n 255: ): { start: ColumnSection; end: ColumnSection } {\r\n 256:   if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\r\n 257:     throw new Error(`girderSupportSections requires a 大梁: ${member.id}`)\r\n 258:   }\r\n 259: \r\n 260:   const { axis, ix, iy } = member.position\r\n 261:   const endIx = axis === 'X' ? ix + 1 : ix\r\n 262:   const endIy = axis === 'Y' ? iy + 1 : iy\r\n 263: \r\n 264:   return {\r\n 265:     start: supportColumnSection(project, member, ix, iy, 'start'),\r\n 266:     end: supportColumnSection(project, member, endIx, endIy, 'end'),\r\n 267:   }\r\n 268: }\r\n 269: \r\n 270: function supportColumnSection(\r\n 271:   project: Project,\r\n 272:   supported: Member,\r\n 273:   ix: number,\r\n 274:   iy: number,\r\n 275:   end: 'start' | 'end',\r\n 276: ): ColumnSection {\r\n 277:   const support = project.members.find(\r\n 278:     (candidate) =>\r\n 279:       candidate.kind === '柱' &&\r\n 280:       candidate.storyId === supported.storyId &&\r\n 281:       isColumnPosition(candidate.position) &&\r\n 282:       candidate.position.ix === ix &&\r\n 283:       candidate.position.iy === iy,\r\n 284:   )\r\n 285: \r\n 286:   if (!support) {\r\n 287:     throw new Error(\r\n 288:       `Missing ${end} support 柱 for ${supported.kind}: ${supported.id}`,\r\n 289:     )\r\n 290:   }\r\n 291: \r\n 292:   const section = findSection(project, support.sectionId)\r\n 293:   if (section.kind !== '柱') {\r\n 294:     throw new Error(`柱 member references a non-柱 section: ${support.id}`)\r\n 295:   }\r\n 296: \r\n 297:   return section\r\n 298: }\r\n 299: \r\n 300: export function girderSpan(project: Project, member: Member): GirderSpan {\r\n 301:   if (member.kind !== '大梁' || !isGirderPosition(member.position)) {\r\n 302:     throw new Error(`girderSpan requires a 大梁: ${member.id}`)\r\n 303:   }\r\n 304: \r\n 305:   const { axis, ix, iy } = member.position\r\n","exit_code":0,"status":"completed"}}
