er.storyId)\r\n 235:         }\r\n 236: \r\n 237:         unsupportedMembers.push({\r\n 238:           memberId: runMember.id,\r\n 239:           mark: runSection.mark,\r\n 240:           storyName: runStory.name,\r\n 241:           reason: error.reason,\r\n 242:         })\r\n 243:       }\r\n 244:     }\r\n--- src/domain/model/project.ts ---\r\n 380: function girderDepthAboveWall(project: Project, wall: Member): number {\r\n 381:   const position = wall.position\r\n 382:   if (!isGirderPosition(position)) {\r\n 383:     throw new Error(`girderDepthAboveWall requires an edge position: ${wall.id}`)\r\n 384:   }\r\n 385: \r\n 386:   const girder = project.members.find(\r\n 387:     (candidate) =>\r\n 388:       candidate.kind === '大梁' &&\r\n 389:       candidate.storyId === wall.storyId &&\r\n 390:       isGirderPosition(candidate.position) &&\r\n 391:       candidate.position.axis === position.axis &&\r\n 392:       candidate.position.ix === position.ix &&\r\n 393:       candidate.position.iy === position.iy,\r\n 394:   )\r\n 395: \r\n 396:   if (!girder) {\r\n 397:     throw new Error(`Missing 大梁 above 耐震壁: ${wall.id}`)\r\n 398:   }\r\n 399: \r\n 400:   const section = findSection(project, girder.sectionId)\r\n 401:   if (section.kind !== '大梁') {\r\n 402:     throw new Error(`大梁 member references a non-大梁 section: ${girder.id}`)\r\n 403:   }\r\n 404: \r\n 405:   return section.depth\r\n 406: }\r\n 407: \r\n 408: export function wallSpan(project: Project, member: Member): WallSpan {\r\n 409:   if (member.kind !== '耐震壁' || !isGirderPosition(member.position)) {\r\n 410:     throw new Error(`wallSpan requires a 耐震壁: ${member.id}`)\r\n 411:   }\r\n 412: \r\n 413:   const story = project.stories.find(({ id }) => id === member.storyId)\r\n 414:   if (!story) {\r\n 415:     throw storyNotFound(member.storyId)\r\n 416:   }\r\n 417: \r\n 418:   const { axis, ix, iy } = member.position\r\n 419:   const endIx = axis === 'X' ? ix + 1 : ix\r\n 420:   const endIy = axis === 'Y' ? iy + 1 : iy\r\n 421:   const startPoint = gridPoint(project.grid, ix, iy)\r\n 422:   const endPoint = gridPoint(project.grid, endIx, endIy)\r\n 423:   const startSection = supportColumnSection(project, member, ix, iy, 'start')\r\n 424:   const endSection = supportColumnSection(project, member, endIx, endIy, 'end')\r\n 425: \r\n 426:   const centerSpan =\r\n 427:     axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\r\n 428:   const startFaceOffsetMm =\r\n 429:     (axis === 'X' ? startSection.b : startSection.d) / 2\r\n 430:   const endFaceOffsetMm = (axis === 'X' ? endSection.b : endSection.d) / 2\r\n 431:   const clearLengthMm = centerSpan - startFaceOffsetMm - endFaceOffsetMm\r\n 432: \r\n 433:   if (clearLengthMm <= 0) {\r\n 434:     throw new MemberUnsupportedError(\r\n 435:       '寸法不成立',\r\n 436:       `耐震壁 内法長さ must be positive: ${member.id} (${clearLengthMm} mm)`,\r\n 437:     )\r\n 438:   }\r\n 439: \r\n 440:   const girderDepthAboveMm = girderDepthAboveWall(project, member)\r\n 441:   const fullClearHeightMm = story.height - girderDepthAboveMm\r\n 442: \r\n 443:   if (fullClearHeightMm <= 0) {\r\n 444:     throw new MemberUnsupportedError(\r\n 445:       '寸法不成立',\r\n 446:       `耐震壁 内法高さ must be positive: ${member.id} ` +\r\n 447:         `(階高 ${story.height} − 上部大梁せい ${girderDepthAboveMm})`,\r\n 448:     )\r\n 449:   }\r\n 450: \r\n 451:   const extent = member.wallExtent\r\n 452:   let actualLengthMm = clearLengthMm\r\n 453:   let actualHeightMm = fullClearHeightMm\r\n 454:   let alongOriginMm = 0\r\n 455:   let heightOriginMm = 0\r\n 456:   const freeEnds: NonNullable<WallSpan['freeEnds']> = {}\r\n 457: \r\n 458:   if (extent?.horizontal) {\r\n 459:     assertWallExtentDimension(\r\n 460:       member,\r\n 461:       'lengthMm',\r\n 462:       extent.horizontal.lengthMm,\r\n 463:       clearLengthMm,\r\n 464:     )\r\n 465:     actualLengthMm = extent.horizontal.lengthMm\r\n 466:     alongOriginMm =\r\n 467:       extent.horizontal.anchor === '始端'\r\n 468:         ? 0\r\n 469:         : clearLengthMm - extent.horizontal.lengthMm\r\n 470:     freeEnds.horizontal =\r\n 471:       extent.horizontal.anchor === '始端' ? '終端' : '始端'\r\n 472:   }\r\n 473: \r\n 474:   if (extent?.vertical) {\r\n 475:     assertWallExtentDimension(\r\n 476:       member,\r\n 477:       'heightMm',\r\n 478:       extent.vertical.heightMm,\r\n 479:       fullClearHeightMm,\r\n 480:     )\r\n 481:     actualHeightMm = extent.vertical.heightMm\r\n 482:     heightOriginMm =\r\n 483:       extent.vertical.anchor === '下端'\r\n 484:         ? 0\r\n 485:         : fullClearHeightMm - extent.vertical.heightMm\r\n 486:     freeEnds.vertical = extent.vertical.anchor === '下端' ? '上端' : '下端'\r\n 487:   }\r\n 488: \r\n 489:   return {\r\n 490:     axis,\r\n 491:     clearLengthMm: actualLengthMm,\r\n 492:     clearHeightMm: actualHeightMm,\r\n 493:     startFaceOffsetMm,\r\n 494:     endFaceOffsetMm,\r\n 495:     girderDepthAboveMm,\r\n 496:     freeEnds,\r\n 497:     originOffsetMm: { along: alongOriginMm, height: heightOriginMm },\r\n 498:   }\r\n 499: }\r\n 500: \r\n 501: function assertWallExtentDimension(\r\n 502:   member: Member,\r\n 503:   field: 'lengthMm' | 'heightMm',\r\n 504:   value: number,\r\n 505:   fullDimensionMm: number,\r\n 506: ): void {\r\n 507:   if (\r\n 508:     !Number.isFinite(value) ||\r\n 509:     value <= 0 ||\r\n 510:     value > fullDimensionMm\r\n 511:   ) {\r\n 512:     throw new MemberUnsupportedError(\r\n 513:       '寸法不成立',\r\n 514:       `耐震壁 wallExtent.${field} must be within 内法寸法: ${member.id} ` +\r\n 515:         `(${value} mm > ${fullDimensionMm} mm)`,\r\n 516:     )\r\n 517:   }\r\n 518: }\r\n 519: \r\n 520: /**\r\n 521:  * 床板（スラブ）1ベイの内法寸法と、四辺で受ける大梁。\r\n 522:  *\r\n 523:  * 躯体の区分（第4編第1章第2節（４））が床板を「柱、梁等に接する水平材の内法部分」\r\n 524:  * と定めるので、測るのは通り芯間ではなく大梁の内側面の間である。柱・大梁と\r\n 525:  * 二重計上しないのはこの定義そのもので、大梁が内法長さ・壁が内法部分なのと同じ形だ。\r\n 526:  */\r\n 527: export interface SlabBay {\r\n 528:   /** 通り芯間スパン (mm) */\r\n 529:   centerSpanXMm: number\r\n 530:   centerSpanYMm: number\r\n 531:   /** 内法長さ (mm) — X方向は両側の Y通り大梁の内側面の間 */\r\n 532:   clearXMm: number\r\n 533:   clearYMm: number\r\n 534:   /** ベイ原点の格子点から内法域の原点までの距離 (mm) ＝ 受ける大梁幅の1/2 */\r\n 535:   startFaceOffsetXMm: number\r\n 536:   startFaceOffsetYMm: number\r\n 537:   /** 四辺で受ける大梁。X方向の内法を決めるのは minX・maxX（Y通り大梁）である */\r\n 538:   supports: {\r\n 539:     minX: SlabEdgeSupport\r\n 540:     maxX: SlabEdgeSupport\r\n 541:     minY: SlabEdgeSupport\r\n 542:     maxY: SlabEdgeSupport\r\n 543:   }\r\n 544: }\r\n 545: \r\n 546: /** 床板筋が定着していく先の大梁1本。 */\r\n 547: export interface SlabEdgeSupport {\r\n 548:   memberId: string\r\n 549:   /** 大梁の幅 b (mm) — 床板筋はこの中へ定着する */\r\n 550:   widthMm: number\r\n 551:   /** 定着が納まるかの判定は支点（大梁）のかぶりで行う — 床板のものではない */\r\n 552:   cover: Record<string, string | boolean>\r\n 553: }\r\n 554: \r\n 555: function isSlabPosition(\r\n 556:   position: ColumnPosition | GirderPosition,\r\n 557: ): position is SlabPosition {\r\n 558:   return !('axis' in position)\r\n 559: }\r\n 560: \r\n 561: function girderSectionAt(\r\n 562:   project: Project,\r\n 563:   storyId: string,\r\n 564:   axis: 'X' | 'Y',\r\n 565:   ix: number,\r\n 566:   iy: number,\r\n 567:   requestedBy: Member,\r\n 568: ): { member: Member; section: GirderSection } {\r\n 569:   const girder = project.members.find(\r\n 570:     (candidate) =>\r\n 571:       candidate.kind === '大梁' &&\r\n 572:       candidate.storyId === storyId &&\r\n 573:       isGirderPosition(candidate.position) &&\r\n 574:       candidate.position.axis === axis &&\r\n 575:       candidate.position.ix === ix &&\r\n 576:       candidate.position.iy === iy,\r\n 577:   )\r\n 578: \r\n 579:   // 四辺のどれかが欠けると内法が決まらない。通り芯間で代用すれば大梁と重なった\r\n 580:   // 床板を計上してしまうので、黙って埋めない — 壁の上部大梁と同じ扱いである。\r\n 581:   if (!girder) {\r\n 582:     throw new Error(\r\n 583:       `Missing ${axis}通り大梁 beside 床板: ${requestedBy.id} (${ix}, ${iy})`,\r\n 584:     )\r\n 585:   }\r\n 586: \r\n 587:   const section = findSection(project, girder.sectionId)\r\n 588:   if (section.kind !== '大梁') {\r\n 589:     throw new Error(`大梁 member references a non-大梁 section: ${girder.id}`)\r\n 590:   }\r\n 591: \r\n 592:   return { member: girder, section }\r\n 593: }\r\n 594: \r\n 595: export function slabBay(project: Project, member: Member): SlabBay {\r\n 596:   if (member.kind !== '床板' || !isSlabPosition(member.position)) {\r\n 597:     throw new Error(`slabBay requires a 床板: ${member.id}`)\r\n 598:   }\r\n 599: \r\n 600:   const { ix, iy } = member.position\r\n 601:   const origin = gridPoint(project.grid, ix, iy)\r\n 602:   const far = gridPoint(project.grid, ix + 1, iy + 1)\r\n 603: \r\n 604:   const edge = (\r\n 605:     axis: 'X' | 'Y',\r\n 606:     edgeIx: number,\r\n 607:     edgeIy: number,\r\n 608:   ): SlabEdgeSupport => {\r\n 609:     const { member: girder, section } = girderSectionAt(\r\n 610:       project,\r\n 611:       member.storyId,\r\n 612:       axis,\r\n 613:       edgeIx,\r\n 614:       edgeIy,\r\n 615:       member,\r\n 616:     )\r\n 617:     return {\r\n 618:       memberId: girder.id,\r\n 619:       widthMm: section.b,\r\n 620:       cover: coverConditions(section),\r\n 621:     }\r\n 622:   }\r\n 623: \r\n 624:   // X方向の内法を決めるのは Y通り（縦に走る）大梁の幅である — 走る向きと\r\n 625:   // 幅を測る向きが直交するので、ここを取り違えると内法が入れ替わる。\r\n 626:   const supports = {\r\n 627:     minX: edge('Y', ix, iy),\r\n 628:     maxX: edge('Y', ix + 1, iy),\r\n 629:     minY: edge('X', ix, iy),\r\n 630:     maxY: edge('X', ix, iy + 1),\r\n 631:   }\r\n 632: \r\n 633:   const centerSpanXMm = far.x - origin.x\r\n 634:   const centerSpanYMm = far.y - origin.y\r\n 635:   const startFaceOffsetXMm = supports.minX.widthMm / 2\r\n 636:   const startFaceOffsetYMm = supports.minY.widthMm / 2\r\n 637:   const clearXMm =\r\n 638:     centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\r\n 639:   const clearYMm =\r\n 640:     centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\r\n 641: \r\n 642:   if (clearXMm <= 0 || clearYMm <= 0) {\r\n 643:     throw new MemberUnsupportedError(\r\n 644:       '寸法不成立',\r\n 645:       `床板 内法長さ must be positive: ${member.id} ` +\r\n 646:         `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\r\n 647:     )\r\n 648:   }\r\n 649: \r\n 650:   return {\r\n 651:     centerSpanXMm,\r\n 652:     centerSpanYMm,\r\n 653:     clearXMm,\r\n 654:     clearYMm,\r\n 655:     startFaceOffsetXMm,\r\n 656:     startFaceOffsetYMm,\r\n 657:     supports,\r\n 658:   }\r\n 659: }\r\n 660: \r\n 661: /**\r\n 662:  * 同一断面の床板が大梁を通して連なる範囲 — 数量積算基準 2（４）床板1) の\r\n 663:  * 「同一の径の主筋が梁、壁等を通して連続する場合」がこれである。\r\n 664:  *\r\n 665:  * 大梁のラン (girderRun) と同じ形だ。1ベイなら長さ1のランで「単独床板」、\r\n 666:  * 2ベイ以上なら「連続する床板」になり、継手箇所数の条文が 2（４）床板2) に\r\n 667:  * 切り替わる。X方向とY方向で別のランを持つ — 床板は2方向に主筋が走るからだ。\r\n 668:  */\r\n 669: export interface SlabRun {\r\n 670:   axis: 'X' | 'Y'\r\n 671:   /** 軸方向の昇順。単独床板なら長さ1 */\r\n 672:   members: Member[]\r\n 673:   /** 通し筋を帰属させる部材 ＝ members[0].id */\r\n 674:   ownerId: string\r\n 675:   /** members と同じ順序 */\r\n 676:   bays: SlabBay[]\r\n 677:   /**\r\n 678:    * ラン原点（始端の大梁の内側面）から各ベイの内法域の始まりまでの距離 (mm)。\r\n 679:    * bays と同じ順序で [0] は 0 である。3D がランを1つの枠に描くとき、\r\n 680:    * 各ベイの箱をここに置く — 描画側で足し直すと配筋とずれる。\r\n 681:    */\r\n 682:   memberOffsetsMm: number[]\r\n 683:   /** ラン芯長 (mm) ＝ Σ内法長さ ＋ Σ中間大梁の幅 */\r\n 684:   coreLengthMm: number\r\n 685:   /** 割付方向（主筋と直交する向き）の内法長さ (mm) — ラン内で共通である */\r\n 686:   distributionClearMm: number\r\n 687:   /** 始端で定着していく大梁 */\r\n 688:   startSupport: SlabEdgeSupport\r\n 689:   /** 終端で定着していく大梁 */\r\n 690:   endSupport: SlabEdgeSupport\r\n 691:   /**\r\n 692:    * ランに開いている開口部 (1通則8))、**ラン原点からの座標**に直したもの。\r\n 693:    *\r\n 694:    * 開口はベイ（＝部材）ごとに入力されるが、床板の鉄筋はランで測るので、\r\n 695:    * 欠除も3Dの切り欠きもラン座標で見る。ここで一度だけ直しておかないと、\r\n 696:    * 数量と表示が別々にベイのオフセットを足し直して食い違う (ADR-029)。\r\n 697:    */\r\n 698:   openings: Opening[]\r\n 699: }\r\n 700: \r\n 701: export function slabRun(\r\n 702:   project: Project,\r\n 703:   member: Member,\r\n 704:   axis: 'X' | 'Y',\r\n 705: ): SlabRun {\r\n 706:   if (member.kind !== '床板' || !isSlabPosition(member.position)) {\r\n 707:     throw new Error(`slabRun requires a 床板: ${member.id}`)\r\n 708:   }\r\n 709: \r\n 710:   const { ix, iy } = member.position\r\n 711:   const slabAt = (\r\n 712:     candidateIx: number,\r\n 713:     candidateIy: number,\r\n 714:   ): Member | undefined =>\r\n 715:     project.members.find(\r\n 716:       (candidate) =>\r\n 717:         candidate.kind === '床板' &&\r\n 718:         candidate.storyId === member.storyId &&\r\n 719:         // 同一断面であることを連続の条件にする。条文は「同一の径の主筋が」と\r\n 720:         // 言うが、径が同じでもピッチが違えば全部の鉄筋が通るわけではない —\r\n 721:         // 断面が同じことはその十分条件であって、図面にない連続を作らない。\r\n 722:         candidate.sectionId === member.sectionId &&\r\n 723:         isSlabPosition(candidate.position) &&\r\n 724:         candidate.position.ix === candidateIx &&\r\n 725:         candidate.position.iy === candidateIy,\r\n 726:     )\r\n 727: \r\n 728:   const step = (offset: number): [number, number] =>\r\n 729:     axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\r\n 730: \r\n 731:   const members: Member[] = [member]\r\n 732:   for (let offset = -1; ; offset -= 1) {\r\n 733:     const previous = slabAt(...step(offset))\r\n 734:     if (!previous) break\r\n 735:     members.unshift(previous)\r\n 736:   }\r\n 737:   for (let offset = 1; ; offset += 1) {\r\n 738:     const next = slabAt(...step(offset))\r\n 739:     if (!next) break\r\n 740:     members.push(next)\r\n 741:   }\r\n 742: \r\n 743:   const bays = members.map((candidate) => slabBay(project, candidate))\r\n 744:   const clearAlong = (bay: SlabBay): number =>\r\n 745:     axis === 'X' ? bay.clearXMm : bay.clearYMm\r\n 746:   const clearAcross = (bay: SlabBay): number =>\r\n 747:     axis === 'X' ? bay.clearYMm : bay.clearXMm\r\n 748: \r\n 749:   // 割付本数は 1通則7) が「その部分の長さ」を鉄筋の間隔で除して求める1つの数だ。\r\n 750:   // ランの途中で直交方向の内法が変われば、その1つの数がどちらのベイでも正しく\r\n 751:   // ならない — 一部だけ通る鉄筋を製品が表現できないので、作らずに落とす。\r\n 752:   const distributionClearMm = clearAcross(bays[0])\r\n 753:   const uneven = bays.findIndex(\r\n 754:     (bay) => clearAcross(bay) !== distributionClearMm,\r\n 755:   )\r\n 756:   if (uneven > 0) {\r\n 757:     throw new MemberUnsupportedError(\r\n 758:       '寸法不成立',\r\n 759:       `床板ラン内で割付方向の内法長さが揃わない: ${members[0].id} ` +\r\n","exit_code":0,"status":"completed"}}
