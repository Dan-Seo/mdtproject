 computeTakeoff(project), [project])\r\n  77: }\r\n  78: \r\n  79: function buildTakeoff(project: Project): TakeoffResult {\r\n  80:   const rebars: Rebar[] = []\r\n  81:   const unsupportedMembers: UnsupportedMember[] = []\r\n  82:   const processedGirderMemberIds = new Set<string>()\r\n  83:   // 床板は方向ごとに別のランを持つ — X で処理済みでも Y はこれからだ。\r\n  84:   const processedSlabRunKeys = new Set<string>()\r\n  85: \r\n  86:   for (const member of project.members) {\r\n  87:     if (\r\n  88:       member.kind === '大梁' &&\r\n  89:       processedGirderMemberIds.has(member.id)\r\n  90:     ) {\r\n  91:       continue\r\n  92:     }\r\n  93: \r\n  94:     const section = findSection(project, member.sectionId)\r\n  95:     const story = project.stories.find(({ id }) => id === member.storyId)\r\n  96:     if (!story) {\r\n  97:       throw storyNotFound(member.storyId)\r\n  98:     }\r\n  99: \r\n 100:     if (member.kind === '柱') {\r\n 101:       if (section.kind !== '柱') {\r\n 102:         throw new Error(`柱 member references a non-柱 section: ${member.id}`)\r\n 103:       }\r\n 104: \r\n 105:       // 柱도 大梁과 같다 — 성립 불가 형상은 그 부재만 빼고 계속한다.\r\n 106:       try {\r\n 107:         rebars.push(\r\n 108:           ...generateColumnRebar(\r\n 109:             {\r\n 110:               member,\r\n 111:               section,\r\n 112:               story,\r\n 113:               beamDepthAbove: beamDepthAbove(project, member),\r\n 114:               ends: columnEnds(project, member),\r\n 115:             },\r\n 116:             jpMlitRulePack,\r\n 117:           ),\r\n 118:         )\r\n 119:       } catch (error) {\r\n 120:         if (!(error instanceof MemberUnsupportedError)) throw error\r\n 121: \r\n 122:         unsupportedMembers.push({\r\n 123:           memberId: member.id,\r\n 124:           mark: section.mark,\r\n 125:           storyName: story.name,\r\n 126:           reason: error.reason,\r\n 127:         })\r\n 128:       }\r\n 129:       continue\r\n 130:     }\r\n 131: \r\n 132:     if (member.kind === '床板') {\r\n 133:       if (section.kind !== '床板') {\r\n 134:         throw new Error(`床板 member references a non-床板 section: ${member.id}`)\r\n 135:       }\r\n 136: \r\n 137:       // 床板は X方向・Y方向で別々のランになる。大梁と同じくランごとに1回だけ\r\n 138:       // 生成し、成立しない寸法・定着はそのラン全体を落として続ける。\r\n 139:       for (const axis of ['X', 'Y'] as const) {\r\n 140:         if (processedSlabRunKeys.has(`${axis}|${member.id}`)) continue\r\n 141: \r\n 142:         let run: SlabRun | undefined\r\n 143:         try {\r\n 144:           run = slabRun(project, member, axis)\r\n 145:           for (const runMember of run.members) {\r\n 146:             processedSlabRunKeys.add(`${axis}|${runMember.id}`)\r\n 147:           }\r\n 148: \r\n 149:           rebars.push(\r\n 150:             ...generateSlabRebar({ run, section }, jpMlitRulePack),\r\n 151:           )\r\n 152:         } catch (error) {\r\n 153:           if (!(error instanceof MemberUnsupportedError)) throw error\r\n 154: \r\n 155:           for (const runMember of run?.members ?? [member]) {\r\n 156:             processedSlabRunKeys.add(`${axis}|${runMember.id}`)\r\n 157:             unsupportedMembers.push({\r\n 158:               memberId: runMember.id,\r\n 159:               mark: section.mark,\r\n 160:               storyName: story.name,\r\n 161:               reason: error.reason,\r\n 162:             })\r\n 163:           }\r\n 164:         }\r\n 165:       }\r\n 166:       continue\r\n 167:     }\r\n 168: \r\n 169:     if (member.kind === '耐震壁') {\r\n 170:       if (section.kind !== '耐震壁') {\r\n 171:         throw new Error(\r\n 172:           `耐震壁 member references a non-耐震壁 section: ${member.id}`,\r\n 173:         )\r\n 174:       }\r\n 175: \r\n 176:       // 柱・大梁と同じ扱い — 成立しない寸法はその壁だけ落として続ける。\r\n 177:       try {\r\n 178:         rebars.push(\r\n 179:           ...generateWallRebar(\r\n 180:             { member, section, span: wallSpan(project, member) },\r\n 181:             jpMlitRulePack,\r\n 182:      