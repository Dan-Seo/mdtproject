{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport pathlib,yaml,collections,json\nroot=pathlib.Path('.')\nentries=[]\nfor p in sorted((root/'src/rulepack/jp-mlit').glob('*.yaml')):\n d=yaml.safe_load(p.read_text(encoding='utf-8'))\n if isinstance(d,list): entries.extend(d)\nnotes=collections.Counter(e.get('note','') for e in entries if e.get('confidence')=='transcribed')\nprint('transcribed notes unique',len(notes))\nfor note,n in notes.items(): print(n, 'COUNT',n)\nprint('all notes containing review phrase',sum('独立検討待ち' in e.get('note','') for e in entries if e.get('confidence')=='transcribed'))\nprint('all notes')\nfor note,n in collections.Counter(e.get('note','') for e in entries).items(): print(repr(note),n)\nprint('source raw fields',collections.Counter(tuple(sorted((e.get('source') or {}).keys())) for e in entries))\nprint('bad source structure',[(e['key'],e.get('conditions'),e.get('source')) for e in entries if not isinstance(e.get('source'),dict) or not e['source'].get('ref') or not e['source'].get('section') or e['source'].get('page') is None])\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
