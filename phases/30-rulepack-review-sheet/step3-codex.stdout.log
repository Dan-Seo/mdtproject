ns.method),\r\n  48:     ).toEqual(['重ね継手', 'ガス圧接', '機械式', '溶接'])\r\n  49:   })\r\n  50: \r\n  51:   it('round-trips every original entry without losing any field', () => {\r\n  52:     const sheet = foldRulePack(jpMlitRulePack)\r\n  53: \r\n  54:     expect(expandFoldedReviewSheet(sheet)).toEqual(jpMlitRulePack.entries)\r\n  55:   })\r\n  56: \r\n  57:   it('fails instead of choosing a representative when a declared band disagrees', () => {\r\n  58:     const pack = clonePack()\r\n  59:     const target = pack.entries.find(\r\n  60:       (entry) =>\r\n  61:         entry.key === 'measure.splice.interval' &&\r\n  62:         entry.conditions.size === 'D13',\r\n  63:     )!\r\n  64:     target.value += 1\r\n  65: \r\n  66:     expect(() => foldRulePack(pack)).toThrow(/帯.*値|value.*band/i)\r\n  67:   })\r\n  68: \r\n  69:   it('marks the 77 cells covered by the existing agent re-read without excluding them', () => {\r\n  70:     const sheet = foldRulePack(jpMlitRulePack)\r\n  71: \r\n  72:     expect(sheet.verification.reviewCellCount).toBe(77)\r\n  73:     expect(sheet.verification.note).toContain('独立検討ではない')\r\n  74: \r\n  75:     const markdown = renderReviewSheet(jpMlitRulePack)\r\n  76:     expect(markdown).toContain('전 칸 일치 / 불일치(칸을 적음)')\r\n  77:     expect(markdown).toContain('재대조 표식이 있어도 회신 대상에서 제외하지 않는다')\r\n  78:     expect(markdown).toContain('measure.splice.interval')\r\n  79:   })\r\n  80: \r\n  81:   it('renders deterministically and keeps the quantity interval at two cells', () => {\r\n  82:     const first = renderReviewSheet(jpMlitRulePack)\r\n  83:     const second = renderReviewSheet(jpMlitRulePack)\r\n  84: \r\n  85:     expect(second).toBe(first)\r\n  86:     expect(first.match(/measure\\.splice\\.interval/g)).toHaveLength(1)\r\n  87:     expect(first).toContain('D10·D13')\r\n  88:     expect(first).toContain('D16·D19·D22·D25·D29·D32')\r\n  89:   })\r\n  90: \r\n  91:   it('matches the checked-in golden Markdown snapshot', () => {\r\n  92:     co