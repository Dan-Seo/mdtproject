\\n136-    source.publisher,\\n--\\n140-  ])\\n141-}\\n142-\\n143-function conditionSignature(conditions: Record<string, unknown>): string {\\n144:  return JSON.stringify(\\n145-    Object.entries(conditions).sort(([left], [right]) =>\\n146-      left.localeCompare(right),\\n147-    ),\\n148-  )\\n--\\n228-    displayConditions,\\n229-    representative: sorted[0].entry,\\n230-    originalEntries: sorted.map(({ entry }) => entry),\\n231-    originalIndices: sorted.map(({ index }) => index),\\n232:    verification: isVerifiedCell(table, sorted),\\n233-  }\\n234-}\\n235-\\n236-function isVerifiedCell(table: string, entries: readonly IndexedEntry[]): boolean {\\n--\\n250-  for (const indexed of entries) {\\n251-    const grade = stringCondition(indexed.entry, 'grade')\\n252-    const fc = numberCondition(indexed.entry, 'fc')\\n253-    if (grade === undefined || fc === undefined) {\\n254:      throw new Error(`${table}: Fc帯の条件が不完全です`)\\n255-    }\\n256-    if (!grades.includes(grade)) grades.push(grade)\\n257-    if (!findBand(String(fc), FC_BANDS)) {\\n258-      throw new Error(`${table}: 알려지지 않은 Fc帯 ${String(fc)}`)\\n--\\n283-        if (\\n284-          conditionWithout(member.entry.conditions, 'fc') !==\\n285-          conditionWithout(first.conditions, 'fc')\\n286-        ) {\\n287:          throw new Error(`${table}: ${grade} ${band.label} の条件が一致しません`)\\n288-        }\\n289-      }\\n290-      cells.push(makeCell(members, { grade, fcBand: band.label }, table))\\n291-    }\\n--\\n304-\\n305-  for (const indexed of entries) {\\n306-    const size = stringCondition(indexed.entry, 'size')\\n307-    if (size === undefined || !knownSizes.has(size)) {\\n308:      throw new Error(`${table}: 알려지지 않은 径条件을 접을 수 없습니다`)\\n309-    }\\n310-  }\\n311-\\n312-  for (const band of INTERVAL_BANDS) {\\n--\\n324-      if (\\n325-        conditionWithout(member.entry.conditions, 'size') !==\\n326-        conditionWithout(first.conditions, 'size')\\n327-      ) {\\n328:        throw new 