arryforward.spec.sh && bash scripts/ci/review-verdict.spec.sh && bash scripts/ci/dist\r\n                        ill-failure-log.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budge\r\n                        t-report.test.mjs scripts/perf/blocking-graph.test.mjs\r\n\r\n\r\n\r\n--- generator 100-400 ---\r\n 101: ]\r\n 102: \r\n 103: const COVER_MEMBER_BANDS: readonly BandSpec[] = [\r\n 104:   { label: '柱・大梁・耐震壁', values: ['柱', '大梁', '耐震壁'] },\r\n 105:   { label: '床板・雑壁', values: ['床板', '雑壁'] },\r\n 106: ]\r\n 107: \r\n 108: const NEVER_FOLD_KEYS = new Set(['measure.splice.length.factor'])\r\n 109: \r\n 110: /**\r\n 111:  * This mirrors the existing `source.verifications` scope in\r\n 112:  * `tests/golden/fixtures/spec-r7-ch5.json`. It is provenance metadata for the\r\n 113:  * review sheet, not a second source of rule values. The marker deliberately\r\n 114:  * does not remove a cell from the reply field: the second read was by the same\r\n 115:  * person as the transcription and is not independent review.\r\n 116:  */\r\n 117: const VERIFIED_KEYS_BY_TABLE: Readonly<Record<string, readonly string[]>> = {\r\n 118:   '表5.3.2': ['lap.L1', 'lap.L1h'],\r\n 119:   '表5.3.4': [\r\n 120:     'anchorage.L1',\r\n 121:     'anchorage.L2',\r\n 122:     'anchorage.L1h',\r\n 123:     'anchorage.L2h',\r\n 124:   ],\r\n 125:   '表5.3.5': ['anchorage.La'],\r\n 126: }\r\n 127: \r\n 128: const VERIFICATION_NOTE =\r\n 129:   'source.verifications の既存再対照（by=agent）は転写者と同じ人格による2回目の読みであり、独立検討ではない。'\r\n 130: \r\n 131: function sourceSignature(source: ResolvedSource): string {\r\n 132:   return JSON.stringify([\r\n 133:     source.short,\r\n 134:     source.doc,\r\n 135:     source.edition,\r\n 136:     source.publisher,\r\n 137:     source.url,\r\n 138:     source.section,\r\n 139:     source.page,\r\n 140:   ])\r\n 141: }\r\n 142: \r\n 143: function conditionSignature(conditions: Record<string, unknown>): string {\r\n 144:   return JSON.stringify(\r\n 145:     Object.entries(conditions).sort(([left], [right]) =>\r\n 146:       left.localeCompare(right),\r\n 147:     ),\r\n 148:   )\r\n 149: }\r\n 150: \r\n 151: function conditionWithout(\r\n 152:   conditions: RuleEntry['conditions'],\r\n 153:   omitted: string,\r\n 154: ): string {\r\n 155:   return conditionSignature(\r\n 156:     Object.fromEntries(\r\n 157:       Object.entries(conditions).filter(([key]) => key !== omitted),\r\n 158:     ),\r\n 159:   )\r\n 160: }\r\n 161: \r\n 162: function conditionWithoutMany(\r\n 163:   conditions: RuleEntry['conditions'],\r\n 164:   omitted: readonly string[],\r\n 165: ): string {\r\n 166:   const omittedSet = new Set(omitted)\r\n 167:   return conditionSignature(\r\n 168:     Object.fromEntries(\r\n 169:       Object.entries(conditions).filter(([key]) => !omittedSet.has(key)),\r\n 170:     ),\r\n 171:   )\r\n 172: }\r\n 173: \r\n 174: function tableName(section: string | null): string {\r\n 175:   if (section === null) return '出典未指定'\r\n 176:   const match = section.match(/^表\\d+\\.\\d+\\.\\d+/)\r\n 177:   return match?.[0] ?? section\r\n 178: }\r\n 179: \r\n 180: function stringCondition(\r\n 181:   entry: RuleEntry,\r\n 182:   name: string,\r\n 183: ): string | undefined {\r\n 184:   const value = entry.conditions[name]\r\n 185:   return typeof value === 'string' ? value : undefined\r\n 186: }\r\n 187: \r\n 188: function numberCondition(\r\n 189:   entry: RuleEntry,\r\n 190:   name: string,\r\n 191: ): number | undefined {\r\n 192:   const value = entry.conditions[name]\r\n 193:   return typeof value === 'number' ? value : undefined\r\n 194: }\r\n 195: \r\n 196: function assertConsistent(entries: readonly IndexedEntry[], context: string): void {\r\n 197:   const first = entries[0]?.entry\r\n 198:   if (!first) throw new Error(`${context}: empty fold cell`)\r\n 199: \r\n 200:   for (const current of entries.slice(1)) {\r\n 201:     if (\r\n 202:       current.entry.value !== first.value ||\r\n 203:       current.entry.unit !== first.unit ||\r\n 204:       sourceSignature(current.entry.source) !== sourceSignature(first.source)\r\n 205:     ) {\r\n 206:       throw new Error(\r\n 207:         `${context}: 帯の値または単位が一致しません。代表値を選ばず、原文帯を見直してください`,\r\n 208:       )\r\n 209:     }\r\n 210:   }\r\n 211: }\r\n 212: \r\n 213: function findBand(value: string, bands: readonly BandSpec[]): BandSpec | undefined {\r\n 214:   return bands.find((band) => band.values.includes(value))\r\n 215: }\r\n 216: \r\n 217: function makeCell(\r\n 218:   entries: readonly IndexedEntry[],\r\n 219:   displayConditions: Record<string, Primitive>,\r\n 220:   table: string,\r\n 221: ): FoldedCell {\r\n 222:   if (entries.length === 0) {\r\n 223:     throw new Error(`${table}: empty fold cell`)\r\n 224:   }\r\n 225:   assertConsistent(entries, `${table} ${entries[0].entry.key}`)\r\n 226:   const sorted = [...entries].sort((left, right) => left.index - right.index)\r\n 227:   return {\r\n 228:     displayConditions,\r\n 229:     representative: sorted[0].entry,\r\n 230:     originalEntries: sorted.map(({ entry }) => entry),\r\n 231:     originalIndices: sorted.map(({ index }) => index),\r\n 232:     verification: isVerifiedCell(table, sorted),\r\n 233:   }\r\n 234: }\r\n 235: \r\n 236: function isVerifiedCell(table: string, entries: readonly IndexedEntry[]): boolean {\r\n 237:   const keys = VERIFIED_KEYS_BY_TABLE[table]\r\n 238:   return (\r\n 239:     keys !== undefined &&\r\n 240:     entries.length > 0 &&\r\n 241:     entries.every(({ entry }) => keys.includes(entry.key))\r\n 242:   )\r\n 243: }\r\n 244: \r\n 245: function foldFcGroup(\r\n 246:   entries: readonly IndexedEntry[],\r\n 247:   table: string,\r\n 248: ): { kind: FoldKind; cells: FoldedCell[]; missingCells: string[] } {\r\n 249:   const grades: string[] = []\r\n 250:   for (const indexed of entries) {\r\n 251:     const grade = stringCondition(indexed.entry, 'grade')\r\n 252:     const fc = numberCondition(indexed.entry, 'fc')\r\n 253:     if (grade === undefined || fc === undefined) {\r\n 254:       throw new Error(`${table}: Fc帯の条件が不完全です`)\r\n 255:     }\r\n 256:     if (!grades.includes(grade)) grades.push(grade)\r\n 257:     if (!findBand(String(fc), FC_BANDS)) {\r\n 258:       throw new Error(`${table}: 알려지지 않은 Fc帯 ${String(fc)}`)\r\n 259:     }\r\n 260:   }\r\n 261: \r\n 262:   const cells: FoldedCell[] = []\r\n 263:   const missingCells: string[] = []\r\n 264:   for (const grade of grades) {\r\n 265:     for (const band of FC_BANDS) {\r\n 266:       const members = entries.filter(\r\n 267:         ({ entry }) =>\r\n 268:           stringCondition(entry, 'grade') === grade &&\r\n 269:           band.values.includes(String(numberCondition(entry, 'fc'))),\r\n 270:       )\r\n 271:       if (members.length === 0) {\r\n 272:         missingCells.push(`${grade} × ${band.label}`)\r\n 273:         continue\r\n 274:       }\r\n 275:       if (members.length !== band.values.length) {\r\n 276:         throw new Error(\r\n 277:           `${table}: ${grade} の ${band.label} 帯が不完全です。値を代表させず失敗します`,\r\n 278:         )\r\n 279:       }\r\n 280:       assertConsistent(members, `${table} ${grade} ${band.label}`)\r\n 281:       const first = members[0].entry\r\n 282:       for (const member of members) {\r\n 283:         if (\r\n 284:           conditionWithout(member.entry.conditions, 'fc') !==\r\n 285:           conditionWithout(first.conditions, 'fc')\r\n 286:         ) {\r\n 287:           throw new Error(`${table}: ${grade} ${band.label} の条件が一致しません`)\r\n 288:         }\r\n 289:       }\r\n 290:       cells.push(makeCell(members, { grade, fcBand: band.label }, table))\r\n 291:     }\r\n 292:   }\r\n 293: \r\n 294:   return { kind: 'fc-band', cells, missingCells }\r\n 295: }\r\n 296: \r\n 297: function foldSizeGroup(\r\n 298:   entries: readonly IndexedEntry[],\r\n 299:   table: string,\r\n 300: ): { kind: FoldKind; cells: FoldedCell[]; missingCells: string[] } {\r\n 301:   const cells: FoldedCell[] = []\r\n 302:   const missingCells: string[] = []\r\n 303:   const knownSizes = new Set(INTERVAL_BANDS.flatMap(({ values }) => values))\r\n 304: \r\n 305:   for (const indexed of entries) {\r\n 306:     const size = stringCondition(indexed.entry, 'size')\r\n 307:     if (size === undefined || !knownSizes.has(size)) {\r\n 308:       throw new Error(`${table}: 알려지지 않은 径条件을 접을 수 없습니다`)\r\n 309:     }\r\n 310:   }\r\n 311: \r\n 312:   for (const band of INTERVAL_BANDS) {\r\n 313:     const members = entries.filter(({ entry }) =>\r\n 314:       band.values.includes(stringCondition(entry, 'size') ?? ''),\r\n 315:     )\r\n 316:     if (members.length !== band.values.length) {\r\n 317:       throw new Error(\r\n 318:         `${table}: ${band.label} 帯が不完全です。値を代表させず失敗します`,\r\n 319:       )\r\n 320:     }\r\n 321:     assertConsistent(members, `${table} ${band.label}`)\r\n 322:     const first = members[0].entry\r\n 323:     for (const member of members) {\r\n 324:       if (\r\n 325:         conditionWithout(member.entry.conditions, 'size') !==\r\n 326:         conditionWithout(first.conditions, 'size')\r\n 327:       ) {\r\n 328:         throw new Error(`${table}: ${band.label} の条件が一致しません`)\r\n 329:       }\r\n 330:     }\r\n 331:     cells.push(makeCell(members, { sizeBand: band.label }, table))\r\n 332:   }\r\n 333: \r\n 334:   return { kind: 'size-band', cells, missingCells }\r\n 335: }\r\n 336: \r\n 337: function foldBendGroup(\r\n 338:   entries: readonly IndexedEntry[],\r\n 339:   table: string,\r\n 340: ): { kind: FoldKind; cells: FoldedCell[]; missingCells: string[] } {\r\n 341:   const cells: FoldedCell[] = []\r\n 342:   const used = new Set<number>()\r\n 343: \r\n 344:   for (const spec of BEND_CELL_SPECS) {\r\n 345:     const members = entries.filter(({ entry }) => {\r\n 346:       const grade = stringCondition(entry, 'grade')\r\n 347:       const size = stringCondition(entry, 'size')\r\n 348:       return spec.grades.includes(grade ?? '') && spec.diameterBand.values.includes(size ?? '')\r\n 349:     })\r\n 350:     const expectedCount = spec.grades.length * spec.diameterBand.values.length\r\n 351:     if (members.length !== expectedCount) {\r\n 352:       throw new Error(\r\n 353:         `${table}: ${spec.gradeLabel} ${spec.diameterBand.label} declared band is incomplete`,\r\n 354:       )\r\n 355:     }\r\n 356:     const first = members[0]?.entry\r\n 357:     if (!first) throw new Error(`${table}: empty bend fold cell`)\r\n 358:     for (const member of members) {\r\n 359:       if (\r\n 360:         conditionWithoutMany(member.entry.conditions, ['grade', 'size']) !==\r\n 361:         conditionWithoutMany(first.conditions, ['grade', 'size'])\r\n 362:       ) {\r\n 363:         throw new Error(\r\n 364:           `${table}: ${spec.gradeLabel} ${spec.diameterBand.label} has inconsistent conditions`,\r\n 365:         )\r\n 366:       }\r\n 367:       used.add(member.index)\r\n 368:     }\r\n 369:     cells.push(\r\n 370:       makeCell(\r\n 371:         members,\r\n 372:         {\r\n 373:           gradeBand: spec.gradeLabel,\r\n 374:           sizeBand: spec.diameterBand.label,\r\n 375:         },\r\n 376:         table,\r\n 377:       ),\r\n 378:     )\r\n 379:   }\r\n 380: \r\n 381:   if (used.size !== entries.length) {\r\n 382:     throw new Error(`${table}: bend entry is outside the declared original cells`)\r\n 383:   }\r\n 384: \r\n 385:   const grades = [\r\n 386:     ...new Set(\r\n 387:       entries\r\n 388:         .map(({ entry }) => stringCondition(entry, 'grade'))\r\n 389:         .filter((value): value is string => value !== undefined),\r\n 390:     ),\r\n 391:   ]\r\n 392:   const missingCells: string[] = []\r\n 393:   for (const grade of grades) {\r\n 394:     for (const band of DIAMETER_BANDS) {\r\n 395:       if (\r\n 396:         !entries.some(\r\n 397:           ({ entry }) =>\r\n 398:             stringCondition(entry, 'grade') === grade &&\r\n 399:             band.values.includes(stringCondition(entry, 'size') ?? ''),\r\n 400:         )\r\n--- fixture head and table contexts ---\r\n   1: # 룰팩 원문 표 단위 대조 시트\r\n   2: \r\n   3: 이 문서는 `jpMlitRulePack`을 원문 표의 帯 단위로 되접어 사람이 대조할 비용을 줄이는 작업물이다. 어떤 `confidence`도 승격하지 않는다.\r\n   4: \r\n   5: ## 집계\r\n   6: \r\n   7: - 룰팩 전체 행: 243\r\n   8: - 되접은 검토 셀: 135\r\n   9: - 표·조항 단위: 8\r\n  10: - 단발항: 17\r\n  11: - 기존 재대조 표식: 77칸\r\n  12: - source.verifications の既存再対照（by=agent）は転写者と同じ人格による2回目の読みであり、独立検討ではない。\r\n  13: \r\n  14: ## 검토 순서\r\n  15: \r\n  16: 1. `表5.3.2`와 `表5.3.4`의 L1·L1h가 한 칸도 빠짐없이 같은지 확인한다. 원문이 정말 같은지, 전사 때 복사됐는지에 따라 다수 행이 한꺼번에 좌우된다.\r\n  17: 2. `表5.3.6`에서 柱＝大梁 조건이 모두 동일한지 확인한다.\r\n  18: 3. 결번을 원문과 대조한다. 현재 확인된 결번은 룰팩에 없는 원문帯이며, 자동으로 채우지 않는다.\r\n  19: \r\n  20: ## 표·조항 단위\r\n  21: \r\n  22: ### 表5.3.6 — `cover.minimum`\r\n  23: \r\n  24: 출처: 公共建築工事標準仕様書（建築工事編）・令和7年版（最終改定 令和7年5月12日） / 表5.3.6 / 인쇄쪽 33쪽\r\n  25: 룰팩 전개 행: 19 / 대조 시트 셀: 7\r\n  26: \r\n  27: | 원문 부재帯 | 나머지 조건 | 값 |\r\n  28: |---|---|---:|\r\n  29: | 柱・大梁・耐震壁 | [[\"exposure\",\"屋内\"],[\"finish\",\"仕上げあり\"],[\"soilContact\",false]] | △ 30 mm [transcribed] |\r\n  30: | 柱・大梁・耐震壁 | [[\"exposure\",\"屋内\"],[\"finish\",\"仕上げなし\"],[\"soilContact\",false]] | △ 30 mm [transcribed] |\r\n  31: | 柱・大梁・耐震壁 | [[\"exposure\",\"屋外\"],[\"finish\",\"仕上げあり\"],[\"soilContact\",false]] | △ 30 mm [transcribed] |\r\n  32: | 柱・大梁・耐震壁 | [[\"exposure\",\"屋外\"],[\"finish\",\"仕上げなし\"],[\"soilContact\",false]] | △ 40 mm [transcribed] |\r\n  33: | 柱・大梁・耐震壁 | [[\"soilContact\",true]] | △ 40 mm [transcribed] |\r\n  34: | 床板・雑壁 | [[\"finish\",\"仕上げあり\"],[\"soilContact\",false]] | △ 20 mm [transcribed] |\r\n  35: | 床板・雑壁 | [[\"finish\",\"仕上げなし\"],[\"soilContact\",false]] | △ 30 mm [transcribed] |\r\n  36: \r\n  37: > 회신란: 전 칸 일치 / 불일치(칸을 적음). 재대조 표식이 있어도 회신 대상에서 제외하지 않는다.\r\n  38: \r\n  39: ### 表5.3.4 — `anchorage.L1`\r\n  40: \r\n  41: 출처: 公共建築工事標準仕様書（建築工事編）・令和7年版（最終改定 令和7年5月12日） / 表5.3.4 / 인쇄쪽 30쪽\r\n  42: 룰팩 전개 행: 20 / 대조 시트 셀: 11\r\n  43: \r\n  44: | grade \\ Fc帯 | Fc18 | Fc21 | Fc24、27 | Fc30、33、36 |\r\n  45: |---|