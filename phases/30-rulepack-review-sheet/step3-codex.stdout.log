= new Set(cells.flatMap((cell) =>\r\n 644:     cell.originalEntries.map((entry) => entry.confidence),\r\n 645:   ))\r\n 646:   if (confidences.size === 1) return [...confidences][0]\r\n 647:   return [...confidences].sort().join('/')\r\n 648: }\r\n 649: \r\n 650: function confidenceMark(confidence: string): string {\r\n 651:   if (confidence === 'inferred') return '▲'\r\n 652:   if (confidence === 'transcribed') return '△'\r\n 653:   return '○'\r\n 654: }\r\n 655: \r\n 656: function cellValue(cell: FoldedCell): string {\r\n 657:   const confidence = confidenceLabel([cell])\r\n 658:   const marker = cell.verification\r\n 659:     ? ' ※既存再対照（agent・独立検討ではない）'\r\n 660:     : ''\r\n 661:   return `${confidenceMark(confidence)} ${formatValue(cell.representative)} [${confidence}]${marker}`\r\n 662: }\r\n 663: \r\n 664: function sourceLine(group: FoldedGroup): string {\r\n 665:   const { source } = group\r\n 666:   const edition = source.edition ? `・${source.edition}` : ''\r\n 667:   const page = source.page === null ? '印刷쪽 미특정' : `인쇄쪽 ${source.page}쪽`\r\n 668:   return `출처: ${source.doc}${edition} / ${source.section ?? '조항 미특정'} / ${page}`\r\n 669: }\r\n 670: \r\n 671: function replyLine(): string {\r\n 672:   return '> 회신란: 전 칸 일치 / 불일치(칸을 적음). 재대조 표식이 있어도 회신 대상에서 제외하지 않는다.'\r\n 673: }\r\n 674: \r\n 675: function renderFcGroup(group: FoldedGroup): string[] {\r\n 676:   const grades = [...new Set(group.cells.map((cell) => String(cell.displayConditions.grade)))]\r\n 677:   const lines = [\r\n 678:     '| grade \\\\ Fc帯 | Fc18 | Fc21 | Fc24、27 | Fc30、33、36 |',\r\n 679:     '|---|---:|---:|---:|---:|',\r\n 680:   ]\r\n 681:   for (const grade of grades) {\r\n 682:     const values = FC_BANDS.map((band) =>\r\n 683:       group.cells.find(\r\n 684:         (cell) =>\r\n 685:           cell.displayConditions.grade === grade &&\r\n 686:           cell.displayConditions.fcBand === band.label,\r\n 687:       ),\r\n 688:     )\r\n 689:     lines.push(`| ${grade} | ${values.map((cell) => cell ? cellValue(cell) : '— 결번').join(' | ')} |`)\r\n 690:   }\r\n 691:   return lines\r\n 692: }\r\n 693: \r\n 694: function renderSizeGroup(group: FoldedGroup): string[] {\r\n 695:   return [\r\n 696:     '| 径帯 | 값 |',\r\n 697:     '|---|---:|',\r\n 698:     ...INTERVAL_BANDS.map((band) => {\r\n 699:       const cell = group.cells.find(\r\n 700:         (candidate) => candidate.displayConditions.sizeBand === band.label,\r\n 701:       )\r\n 702:       return `| ${band.label} | ${cell ? cellValue(cell) : '— 결번'} |`\r\n 703:     }),\r\n 704:   ]\r\n 705: }\r\n 706: \r\n 707: function renderBendGroup(group: FoldedGroup): string[] {\r\n 708:   const gradeBands = [...new Set(BEND_CELL_SPECS.map((spec) => spec.gradeLabel))]\r\n 709:   return [\r\n 710:     '| 鉄筋種類帯 \\\\ 径帯 | D16以下 | D19〜D38 |',\r\n 711:     '|---|---:|---:|',\r\n 712:     ...gradeBands.map((gradeBand) => {\r\n 713:       const values = DIAMETER_BANDS.map((diameterBand) => {\r\n 714:         const cell = group.cells.find(\r\n 715:           (candidate) =>\r\n 716:             candidate.displayConditions.gradeBand === gradeBand &&\r\n 717:             candidate.displayConditions.sizeBand === diameterBand.label,\r\n 718:         )\r\n 719:         if (cell) return cellValue(cell)\r\n 720:         const missing = group.missingCells.some((value) =>\r\n 721:           value.endsWith(`× ${diameterBand.label}`) &&\r\n 722:           value.startsWith(`${gradeBand.split('・')[0]} `),\r\n 723:         )\r\n 724:         return missing ? '— (結番)' : '—'\r\n 725:       })\r\n 726:       return `| ${gradeBand} | ${values.join(' | ')} |`\r\n 727:     }),\r\n 728:   ]\r\n 729: }\r\n 730: \r\n 731: function renderMemberGroup(group: FoldedGroup): string[] {\r\n 732:   return [\r\n 733:     '| 원문 부재帯 | 나머지 조건 | 값 |',\r\n 734:     '|---|---|---:|',\r\n 735:     ...group.cells.map(\r\n 736:       (cell) =>\r\n 737:         `| ${String(cell.displayConditions.memberKinds)} | ${String(cell.displayConditions.conditions)} | $