\\\\\\\\\nphases\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\1-skeleton\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\step0.md\\\\\\\\\\\\\\\\nphases\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\1-skeleton\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\index.json\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\README.md\\\\\\\\\\\\\\\\ndocs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\SOURCES.md\\\\\\\\\\\\\\\\ndocs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\PRD.md\\\\\\\\\\\\\\\\ndocs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\DESIGN.md\\\\\\\\\\\\\\\\ndocs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ARCHITECTURE.md\\\\\\\\\\\\\\\\ndocs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ADR.md\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\_ds_bundle.js\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\typography.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\spacing.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\radius.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\fonts.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\elevation.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\colors.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\base.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\styles.css\\\\\\\\\\\\\\\\ndesign\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\readme.md\\\\\\\\\\\\\\\\nPath                     \\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n----                     \\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nC:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_5\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Write-Output '===== AGENTS.md ====='; Get-Content -Raw -Encoding UTF8 'AGENTS.md'\\\\\\\\\\\\\\\\nWrite-Output '===== docs/ARCHITECTURE.md ====='; Get-Content -Raw -Encoding UTF8 'docs/ARCHITECTURE.md'\\\\\\\\\\\\\\\\nWrite-Output '===== docs/ADR.md ====='; Get-Content -Raw -Encoding UTF8 'docs/ADR.md'\\\\\\\\\\\\\\\\nWrite-Output '===== design/README.md ====='; Get-Content -Raw -Encoding UTF8 'design/README.md'\\\\\\\\\\\\\\\\nWrite-Output '===== scripts/hooks/tdd-guard.sh ====='; Get-Content -Raw -Encoding UTF8 'scripts/hooks/tdd-guard.sh'\\\\\\\\\\\\\\\\nWrite-Output '===== scripts/hooks/stop-verify.sh ====='; Get-Content -Raw -Encoding UTF8 'scripts/hooks/stop-verify.sh'\\\\\\\\\\\\\\\\nWrite-Output '===== phases/1-skeleton/index.json ====='; Get-Content -Raw -Encoding UTF8 'phases/1-skeleton/index.json'\\\\\\\\\\\\\\\\nWrite-Output '===== phases/1-skeleton/step0.md ====='; Get-Content -Raw -Encoding UTF8 'phases/1-skeleton/step0.md'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_5\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Write-Output '===== AGENTS.md ====='; Get-Content -Raw -Encoding UTF8 'AGENTS.md'\\\\\\\\\\\\\\\\nWrite-Output '===== docs/ARCHITECTURE.md ====='; Get-Content -Raw -Encoding UTF8 'docs/ARCHITECTURE.md'\\\\\\\\\\\\\\\\nWrite-Output '===== docs/ADR.md ====='; Get-Content -Raw -Encoding UTF8 'docs/ADR.md'\\\\\\\\\\\\\\\\nWrite-Output '===== design/README.md ====='; Get-Content -Raw -Encoding UTF8 'design/README.md'\\\\\\\\\\\\\\\\nWrite-Output '===== scripts/hooks/tdd-guard.sh ====='; Get-Content -Raw -Encoding UTF8 'scripts/hooks/tdd-guard.sh'\\\\\\\\\\\\\\\\nWrite-Output '===== scripts/hooks/stop-verify.sh ====='; Get-Content -Raw -Encoding UTF8 'scripts/hooks/stop-verify.sh'\\\\\\\\\\\\\\\\nWrite-Output '===== phases/1-skeleton/index.json ====='; Get-Content -Raw -Encoding UTF8 'phases/1-skeleton/index.json'\\\\\\\\\\\\\\\\nWrite-Output '===== phases/1-skeleton/step0.md ====='; Get-Content -Raw -Encoding UTF8 'phases/1-skeleton/step0.md'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"===== AGENTS.md =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# 프로젝트: Kijun (基準)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> 이 파일은 `CLAUDE.md`와 같은 내용의 사본이다 (Codex는 AGENTS.md를, Claude Code는 CLAUDE.md를 읽는다).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> 한쪽을 고치면 반대쪽도 같이 고칠 것.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n일본 공공건축 기준에 근거해 브라우저에서 柱·大梁의 배근상세를 산정하고 물량·3D를 산출하는 웹 도구.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n배경과 결정 근거는 `docs/PRD.md`, `docs/ARCHITECTURE.md`, `docs/ADR.md`, 근거 문서 목록은 `docs/SOURCES.md`에 있다. 작업 전에 ADR을 읽을 것.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 기술 스택\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- Next.js 15 App Router (서버 컴포넌트 미사용 — 전부 클라이언트)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- TypeScript strict mode\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- Tailwind CSS\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- three.js (3D), exceljs (내역서), zustand (상태), vitest (테스트)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 배포: Vercel — GitHub 연동 자동 배포, PR 프리뷰\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 아키텍처 규칙\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: **배근 규준 수치를 코드에 쓰지 말 것.** 定着長さ, 重ね継手長さ, 折曲げ, かぶり厚さ, 할증률 등 모든 수치는 `src/rulepack/`의 YAML에서 조회한다. `.ts` 파일에 규준 숫자 리터럴이 나타나면 잘못된 것이다. 조회 **로직**은 평범한 TS 함수로 쓰고, 룰 DSL·평가기는 만들지 말 것 (ADR-002).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: **主筋 경·본수와 帯筋/あばら筋 피치는 입력이다.** 단면일람에서 받은 값을 제품이 바꾸지 않는다. 룰팩 조회 대상은 배근 상세값(定着·重ね継手·折曲げ·かぶり)뿐이다. 主筋 본수를 룰팩에서 조회하는 코드를 쓰지 말 것 (ADR-012).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: **룰팩 항목에 `source`와 `confidence`가 없으면 추가하지 말 것.** `source`는 문서명·URL·페이지, `confidence`는 `stated`(원문 명시) 또는 `inferred`(추론). 근거 없는 값은 넣지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: **`src/domain/`은 순수 TypeScript.** React, DOM, three.js, Next.js를 import하지 않는다. Node에서 그대로 실행되어야 골든테스트가 돈다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: **사용자 도면 데이터를 서버로 보내지 말 것.** 모든 계산은 브라우저에서. 서버 저장·전송 코드를 만들지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: **출처 표시는 법적 의무다.** 근거 자료는 PDL1.0 준거로 출처 표시와 개변 사실 표시가 요구된다. UI 하단 고지와 룰팩 `source` 필드를 제거하지 말 것.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 도메인 용어는 일본어 원어를 그대로 쓴다: `柱`, `大梁`, `主筋`, `帯筋`, `あばら筋`, `定着`, `重ね継手`, `かぶり厚さ`, `SD345`, `Fc24`, `D13`. 한국어로 번역하지 말 것 (ADR-008).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 부재는 `柱`와 `大梁`만. `壁`·`スラブ`·`基礎`·`小梁` 코드를 미리 만들지 말 것. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다 (ADR-005).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 할증률 조회는 부재 구분을 인자로 받는다. 躯体 4%이고 흙막이벽·말뚝은 3%이므로, 범위 밖이 들어오면 기본값 4%를 주지 말고 실패시킬 것 (ADR-014).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 파생 상태(`Rebar[]`, `QuantityLine[]`)를 스토어에 저장하지 말 것. `Project`에서 계산한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `Project`는 순수 JSON으로 직렬화 가능해야 한다. 클래스 인스턴스·함수·Date 객체를 넣지 말 것.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 개발 프로세스\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: 새 기능 구현 시 반드시 테스트를 먼저 작성하고, 테스트가 통과하는 구현을 작성할 것 (TDD)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- CRITICAL: 규준 관련 기능은 **골든테스트 먼저**. `標準仕様書`·`수량적산기준`의 표 값을 `tests/golden/`에 픽스처로 박고, 엔진 출력이 한 칸이라도 다르면 실패하게 한다. 픽스처에는 출처 쪽·표를 함께 적을 것 — 사후 대조의 유일한 단서다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 마일스톤 순서를 건너뛰지 말 것. M0(스파이크) → M1(워킹 스켈레톤) → M2(룰팩) → M3(大梁) → M4(확장) → M5(UX 리뷰)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 커밋 메시지는 conventional commits 형식을 따를 것 (feat:, fix:, docs:, refactor:)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 마일스톤 현황\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- [ ] **M0** — `標準仕様書 R7`에 배근 상세 수치가 실제로 몇 개 있는지, 표가 텍스트인지 이미지인지 판정. R7 대응 `標準詳細図` 도면 본편의 소재도 함께 확인 (반나절)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- [ ] **M1** — 워킹 스켈레톤: 柱 1종 + 가짜 룰로 입력→철근→물량→3D→Excel 관통\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- [ ] **M2** — 룰팩 정식화 + 골든테스트 전 셀 통과\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- [ ] **M3** — 大梁 추가 (あばら筋 피치 변화, カットオフ, 継手位置)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- [ ] **M4** — 다층·다스팬, 내역서 양식 정식화, glTF export\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- [ ] **M5** — 한국 실무자 UX 리뷰 반영\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 열린 리스크\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **R1** `標準詳細図` 인용 PDF가 표지 3쪽뿐임이 확인됨 → 근거 목록에서 제외. 배근 상세를 `標準仕様書` 본문에서 찾아야 하고 없으면 `inferred`로 남는다. M0에서 공백 크기 측정 (ADR-003, SOURCES.md)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **R2** 조문에 없는 관행(暗黙知)은 영구 미검증 → `confidence: inferred` 목록으로 축적\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **R3** 일본 사용자 접점 0 → MVP 이후 과제\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **R4** 층당 철근 1만 개 규모 → `InstancedMesh` 필수\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **R5** 근거가 공공건축(관청시설) 기준이라 민간공사 관행과 다를 수 있음 → UI 하단에 산출 근거 고정 표시 (ADR-003)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **R6** LLM 추출값은 추출자=승인자이므로 독립 검토가 아님 → `inferred`로 남기고 경고·워터마크 (ADR-015)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 명령어\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run dev          # 개발 서버\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run build        # 프로덕션 빌드\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run lint         # ESLint\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run test         # 전체 테스트\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run test:golden  # 규준 표 대조 골든테스트만\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== docs/ARCHITECTURE.md =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# 아키텍처\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 디렉토리 구조\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nsrc/\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├── app/                  # Next.js App Router — 페이지 셸만. 전부 클라이언트 컴포넌트\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├── components/\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   ├── plan/             # 평면 입력 에디터\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   ├── section/          # 부재 단면일람 테이블\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   ├── viewer/           # three.js 3D 뷰어\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   └── quantity/         # 물량 내역서 테이블\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├── domain/               # 순수 TypeScript. React·DOM·three.js 의존 금지\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   ├── model/            # Project / Member / Rebar 타입\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   ├── rules/            # 룰팩 로더 + 조회 엔진\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   ├── rebar/            # 철근 생성기 (柱, 大梁)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   └── quantity/         # 물량 집계 (設計数量 → 할증률 조회 → 所要数量)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├── rulepack/\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│   └── jp-mlit/          # YAML 룰팩 (定着·重ね継手·折曲げ·かぶり·할증률)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├── lib/                  # 직렬화, IndexedDB, exceljs, glTF, i18n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n└── locales/              # ja.json (기본), ko.json (fallback → ja)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ntests/\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n└── golden/               # 標準仕様書·수량적산기준 표 ↔ 엔진 출력 대조\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n템플릿에 있던 `services/`(외부 API 래퍼)는 두지 않는다. 외부 API를 호출하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`types/`를 따로 두지 않고 `domain/model/`에 둔다. 타입과 그 타입을 다루는 순수 함수가 붙어 있는 편이 낫다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 패턴\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**도메인은 UI를 모른다.** `src/domain/`은 React·DOM·three.js·Next.js를 import하지 않는다. Node에서 그대로 실행되고, 그래서 골든테스트가 브라우저 없이 돈다. 이 경계가 이 프로젝트에서 가장 중요한 규칙이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**룰 로직은 코드, 룰 수치는 데이터.** 어느 표를 볼지 결정하고 길이를 조합하는 것은 평범한 TS 함수로 쓴다. 그 함수가 읽는 **수치**는 `.ts` 파일에 리터럴로 나타나면 안 되고 전부 `rulepack/`의 YAML에서 조회한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n이 분리는 취향이 아니다. 수치가 코드에 박히면 **항목 단위로 `confidence`를 붙일 수 없고** `inferred` 경고와 워터마크가 성립하지 않는다. 반대로 룰 DSL이나 평가기를 만들지도 않는다 — 로직은 함수로 충분하다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n룰팩 항목의 형태:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```yaml\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- key: teichaku.L2\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  conditions: { fc: 24, grade: SD345, hook: false }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  value: 35            # 배수(d)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  unit: d\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  source:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    doc: 公共建築工事標準仕様書（建築工事編）令和7年版\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    edition: 令和7年3月21日 国営建技第5号\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    url: https://www.mlit.go.jp/gobuild/content/001888816.pdf\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    page: null         # 원문 대조로 쪽을 특정하면 채운다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  confidence: inferred # stated | inferred — page가 null이면 stated일 수 없다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nM0 이전에는 모든 항목이 `inferred`다. 쪽을 특정한 항목만 `stated`로 올린다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`confidence: inferred`는 원문에 명시되지 않아 추론으로 채운 값이거나, 원문 대조를 아직 하지 않은 값이다. 이 목록이 곧 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"일본 실무자를 만나면 물어볼 질문 목록\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이다. `source.page`가 없는 항목이 `stated`일 수는 없다 — 로더가 이를 검사한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**할증률 룰은 부재 구분을 인자로 받는다.** 수량적산기준은 躯体 철근 4%(20쪽)와 별개로 흙막이벽 3%(13쪽)·말뚝 3%(14쪽)를 정한다. \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"모든 철근 4%\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"로 일반화하면 조용히 틀린 값이 나가므로, 지원 범위 밖의 부재 구분이 들어오면 값을 반환하지 않고 실패한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**출처 표시는 법적 의무다.** 근거 자료는 PDL1.0(공공데이터이용규약 제1.0판) 준거로 상업적 이용·가공이 가능하나, 출처 표시와 개변 사실 표시가 요구된다. 룰팩의 `source` 필드와 UI 하단 고지가 이 의무를 충족한다. `source.url`은 UI에서 **클릭 가능한 링크**로 노출한다 — 원문 대조 비용을 0으로 만드는 것이 ADR-003이 이 문서를 고른 이유다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**서버 컴포넌트를 쓰지 않는다.** Next.js를 선택했지만 MVP에서 서버 렌더링의 이점이 없고, 캔버스·상태 중심 앱에서 RSC 경계는 방해만 된다. 계정·DB가 필요해지는 시점에 서버 컴포넌트를 도입한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 데이터 흐름\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n평면 입력 + 단면일람\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ↓\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nProject (직렬화 가능한 순수 JSON)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ↓\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nRebarGenerator(Member, RulePack) → Rebar[]           ← 규준 수치는 전부 룰팩 조회\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ↓\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nQuantityAggregator(Rebar[], RulePack) → QuantityLine[]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      設計数量 → 부재 구분별 할증률 조회 → 所要数量\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ↓\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n┌─────────────┬──────────────────┬─────────────┐\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│ 내역서 테이블 │ three.js         │ exceljs      │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│              │ InstancedMesh    │ glTF export  │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n└─────────────┴──────────────────┴─────────────┘\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n전 구간이 브라우저에서 돈다. 사용자 도면 데이터는 서버로 전송되지 않는다. 이는 성능 선택이 아니라 신뢰 선택이다 — 건설 도면과 물량은 기밀이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n앱 자체는 Vercel에서 정적으로 배포되므로 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"아웃바운드 요청 0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"을 주장하지는 않는다. 주장하는 것은 **사용자 데이터가 나가지 않는다**는 것이며, 이는 서버 저장·전송 코드를 만들지 않음으로써 성립한다 (ADR-006).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`Rebar[]`와 `QuantityLine[]`은 **저장하지 않는다.** `Project`에서 매번 계산한다. 파생 상태를 저장하면 반드시 어긋난다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 상태 관리\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **도메인 상태**: `Project` 객체 하나. zustand 스토어 1개. 순수 JSON으로 직렬화 가능해야 한다 — 이것이 저장·불러오기·나중에 서버 도입까지의 이음매다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **파생 상태**: `Rebar[]`, `QuantityLine[]`은 메모이즈된 계산 결과. 스토어에 넣지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **선택 상태**: 평면·3D·내역서 세 패널이 공유하는 `selectedMemberId` / `selectedRebarId`. 스토어에 둔다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **3D 씬**: three.js 오브젝트는 React state에 넣지 않는다. `Rebar[]`가 바뀔 때 씬을 재구성한다. 층당 철근 개체가 1만 개 규모이므로 `InstancedMesh`를 쓴다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **영속화**: IndexedDB 자동 저장(디바운스) + JSON 파일 다운로드/업로드. 서버 저장 없음.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== docs/ADR.md =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# Architecture Decision Records\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 철학\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**검증할 수 없는 것은 만들지 않는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n이 프로젝트는 1인 사이드 프로젝트이고, 개발자는 건축/토목 전공이지만 실무 경험이 짧고 일본어를 읽지 못한다. 이 조건에서 가장 큰 위험은 기능이 안 만들어지는 것이 아니라 **틀린 채로 완성되고, 완성된 줄 아는 것**이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n따라서 모든 결정은 다음 순서로 판단한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n1. 이 기능의 출력이 맞았는지 **기계가** 판정할 수 있는가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n2. 없다면, **문서 대조로** 사람이 판정할 수 있는가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n3. 둘 다 안 되면 만들지 않는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n그리고 범위에 대해서는: **부재 1종으로 파이프라인 전체를 관통하는 것이, 부재 4종을 절반씩 하는 것보다 낫다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-001: 일본 기준으로 직행 (한국 기준을 거치지 않음)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: MVP를 처음부터 일본 법규·시방서 기준으로 만든다. 한국 기준(KDS) 구현 단계를 거치지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 룰 레이어가 곧 제품의 차별점인데, 한국으로 연습하면 가장 어려운 부분을 가장 동기가 떨어졌을 때로 미루게 된다. 한국 시장에는 이미 동등한 제품이 있어 만들 이유가 없다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 개발자가 일본어를 읽지 못한다. 원문 독해는 LLM이 대행하고 한국어로 보고받는다. 이것으로 **원문 해석의 1차 초안은 얻지만 검증은 얻지 못한다** — 추출자와 승인자가 같으면 독립 검토가 아니다. 따라서 LLM 추출값은 `confidence: inferred`로 들어가고, 원문 대조로 쪽·표를 특정한 값만 `stated`가 된다. 조문에 없는 관행(暗黙知)과 독립 검증자 부재는 해결되지 않는다. 이 잔여 리스크를 안고 간다 (ADR-010, ADR-015).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-002: 룰 로직은 코드, 룰 수치는 데이터(룰팩)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 어느 표를 볼지 결정하고 길이를 조합하는 **로직**은 평범한 TS 함수로 쓴다. 그 함수가 읽는 **수치**(定着長さ, 重ね継手長さ, 折曲げ 형상, かぶり厚さ, 할증률)는 `rulepack/*.yaml`에 두고 코드에 리터럴로 쓰지 않는다. 각 항목은 `source`(문서·판·URL·페이지)와 `confidence`(stated|inferred)를 가진다. 룰 DSL이나 평가기는 만들지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 네 가지를 동시에 해결한다. ① 기존 제품(BuilderHub-Q, 鉄之助 등)은 규준이 하드코딩이라 발주처 특기시방서 대응이 벤더 작업이다 — 룰팩 교체가 유일한 차별점이 된다. ② `source`가 있으면 누구든 클릭 한 번으로 대조 검증할 수 있다. ③ PDL1.0의 출처 표시 의무를 자동으로 충족한다. ④ **수치가 코드에 박히면 항목 단위로 `confidence`를 붙일 수 없어 `inferred` 경고와 워터마크(ADR-015)가 성립하지 않는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 조회 엔진(조건 매칭)을 만들어야 하고, 하드코딩보다 초기 비용이 높다. 룰팩 스키마를 잘못 설계하면 나중에 전량 마이그레이션이 필요하다. 로직/수치 경계가 애매한 항목(조건 분기 자체가 규준에 적힌 경우)에서는 판단이 필요하다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-003: 근거 문서를 国交省 공개 자료로 고정 (`建築工事標準詳細図`는 제외)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: `公共建築工事標準仕様書(建築工事編) 令和7年版` + `공공건축 수량적산기준(令和5년 개정)` + `건축기준법 시행령`을 근거로 삼는다. **`建築工事標準詳細図(令和4年改定)`은 근거 목록에서 제외한다.** JASS 5와 발주처 특기시방서는 쓰지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 무료·공개·URL 인용 가능하다는 점이 결정적이다. 개발자가 검증할 수 없는 프로젝트에서, 누구든 클릭 한 번으로 대조할 수 있다는 성질이 유료 서적의 시장 적합성보다 중요하다. PDL1.0으로 상업적 이용·가공도 허용된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n標準詳細図을 제외하는 이유는 확인 결과다. 인용 PDF(`001157902.pdf`)는 **3쪽뿐이고 표지와 총칙만 있어 실제 상세도가 없으며**, 2쪽 총칙이 근거를 시방서 **令和4年版**으로 명시해 이 프로젝트가 쓰는 R7과 판이 어긋난다. 배근 상세를 여기서 가져올 수 없다. R7 대응 개정판과 도면 본편의 소재는 M0에서 확인하고, 찾으면 근거 목록에 복귀시킨다. 자세한 판정은 `docs/SOURCES.md`에 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 관공서 공사 기준이다. 일본 민간 공사는 JASS 5 기반이 주류이므로 시장 적합성이 좁다. JASS 5는 나중에 추가 룰팩으로 대응한다 — ADR-002 덕분에 이것이 로드맵이 된다. 그리고 상세도가 빠진 만큼 **배근 상세 수치의 상당 부분을 시방서 본문에서 찾아야 하며, 시방서에 없으면 `inferred`로 남는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-004: DWG 자동인식을 하지 않고 웹 간이 평면 입력을 받는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 형상 입력은 브라우저의 간이 평면 에디터 + 단면일람 표로 받는다. DWG/DXF 도면 인식, IFC 업로드는 하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 도면 인식은 본질적으로 데이터 문제다. 검증용 실도면 세트를 구할 수 없으므로 노력으로 해결되지 않는다. 그리고 일본 주류 철근 적산 소프트(`鉄之助`)가 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"平面図入力によるカンタン操作\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 판매 포인트로 삼는다 — 도면 인식 없이도 시장이 존재한다는 선례가 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: BuilderHub-Q의 가장 큰 세일즈 포인트를 포기한다. 이미 CAD 도면이 있는 사용자에게는 입력이 이중 작업이 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-005: 철근 산정 범위를 柱 + 大梁으로 한정\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: MVP는 柱와 大梁만 배근한다. 壁·スラブ·基礎·小梁은 코드조차 만들지 않는다. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 골조 철근 물량의 대부분을 차지하면서, 규준이 상대적으로 표준화되어 있다. 壁의 開口補強筋은 관행 덩어리라 ADR 철학의 3번(검증 불가)에 걸린다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n콘크리트·거푸집을 넣지 않는 이유는 별개다. 사용자가 원하는 것은 철근 물량이고, 거푸집 면적은 개구부 공제 기준 등 **또 하나의 룰 세트**를 요구한다. 형상 입력 UI와 `geometry` 모듈까지 딸려오므로 MVP 한 벌 값이 더 든다. v1.1로 미룬다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 한 층 전체 물량이 나오지 않아 실무에 바로 쓰이지 못한다. 데모에서 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"슬래브는요?\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라는 질문을 받는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-006: 계산을 전부 클라이언트에서 하고 서버 상태를 두지 않는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 배근 생성·물량 집계·3D·Excel 생성을 전부 브라우저에서 수행한다. 계정, DB, 서버 저장을 두지 않는다. 프로젝트는 JSON 파일 다운로드/업로드 + IndexedDB.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: DWG 인식과 솔리드 모델링을 뺀 결과, 남은 계산은 표 조회와 산술뿐이라 서버가 필요 없다. 그리고 건설 도면·물량은 기밀이다 — \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"데이터가 우리 서버로 올라가지 않는다\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"는 일본 시장에서 유효한 신뢰 근거다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 룰 로직이 클라이언트에 노출된다. 사용 데이터를 수집할 수 없다. 협업·공유 기능이 불가능하다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-007: Vite가 아니라 Next.js App Router를 쓴다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: Next.js App Router. 단, 서버 컴포넌트를 쓰지 않고 전부 클라이언트 컴포넌트로 작성한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: ADR-006으로 서버가 필요 없어졌으므로 순수 클라이언트 3D 도구에는 Vite가 더 잘 맞는다. 그럼에도 Next.js를 고르는 유일한 이유는, 계정·프로젝트 저장·룰팩 배포·과금이 결국 들어올 때 Vite SPA에서 옮기는 비용이 지금 Next.js를 감내하는 비용보다 크기 때문이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: `'use client'`를 도배하게 되고, 쓰지 않는 프레임워크 기능의 복잡도를 계속 이고 간다. 만약 이 제품이 SaaS가 아니라 단일 도구로 끝난다면 이 결정은 낭비였던 것으로 판명된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-008: 기본 로케일은 `ja`, `ko`는 fallback 보조 로케일\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 기본 로케일을 `ja`로 두고, `ko`의 fallback을 `ja`로 설정한다. 한국어는 핵심 문구만 번역한다. 도메인 용어(柱, 大梁, 帯筋, あばら筋, 定着, 重ね継手, SD345, Fc24)는 번역하지 않고 일본어 원어를 고정한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 번역되지 않은 키가 자동으로 일본어로 노출되므로 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"핵심만 한국어\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"가 유지보수 비용 없이 성립한다. 도메인 용어를 번역하면 일본 기준을 구현하면서 한국 개념으로 생각하게 되고, `あばら筋`과 늑근의 미묘한 관행 차이가 조용히 섞인다 — 정확히 개발자가 잡아낼 수 없는 종류의 오류다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 한국어 UI가 군데군데 일본어로 남는다. 일본 진출 시점에는 `ko`를 삭제한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-009: ~~設計数量만 산출하고 적산 할증은 사용자 계수로 받는다~~ (ADR-013으로 대체됨)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 도면상 철근 길이의 합(設計数量)만 계산한다. `建築数量積算基準`의 할증·로스·이음 개소 산정 규칙은 구현하지 않고, 사용자가 할증 계수를 입력하게 한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: `建築数量積算基準`은 유료 서적이라 ADR-003의 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"검증 가능한 근거\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" 조건을 만족하지 못한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**폐기 사유**: **전제가 틀렸다.** 유료 서적을 볼 필요가 없다 — 国交省이 공개한 `공공건축 수량적산기준(令和5년 개정)`이 무료·PDL1.0이고 20쪽에 躯体 철근 4% 할증이 명시되어 있다. ADR-003의 근거 조건을 만족하므로 구현하지 않을 이유가 없다. ADR-013·ADR-014로 대체한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-010: 검증을 골든테스트(숫자)와 사람(UX)으로 분리한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 규준 수치의 정확성은 `標準仕様書`·`수량적산기준`의 표를 테스트 픽스처로 박은 골든테스트가 판정한다. 사람에게는 UX만 검증받는다 — 한국 실무자에게 입력 흐름·내역서 양식·빠진 항목을 묻는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 한국 실무자는 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이 정착길이가 일본 기준에 맞는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 판정할 수 없다. 판정할 수 없는 것을 사람에게 묻고 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"확인받았다\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"고 여기는 것이 가장 위험하다. 반대로 표 대조는 사람 없이 CI에서 돈다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 골든테스트가 판정하는 것은 **\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"엔진 출력이 픽스처와 일치하는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"까지다.** \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"픽스처가 원문을 옳게 옮겼는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"는 판정하지 못하고, 이 프로젝트에서는 원문 전사를 LLM이 하므로 그 층에 검증이 없다. 픽스처를 만들 때 쪽·표를 반드시 기록해 사후 대조 비용을 낮추는 것으로 대응하고, 대조되지 않은 값은 `inferred`로 남긴다 (ADR-015).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n문서에 명시되지 않은 관행도 영구히 미검증으로 남는다. `confidence: inferred` 목록이 그 미검증 항목의 대장 역할을 하고, 일본 접점이 생기는 시점의 질문지가 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-011: 룰팩보다 워킹 스켈레톤을 먼저 만든다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: M0(반나절 스파이크: `標準仕様書 R7`에 배근 상세 수치가 실제로 몇 개 있는지, 표가 텍스트인지 이미지인지 판정) 직후, 柱 1종 + 가짜 룰(`定着 = 40d` 같은 상수)로 입력→철근→물량→3D→Excel 전 구간을 먼저 관통시킨다. 실제 룰팩은 그다음에 가짜 룰을 교체하는 방식으로 넣는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 통합 리스크를 가장 먼저 죽인다. 그리고 1인 사이드 프로젝트가 죽는 가장 흔한 원인은 기술 난이도가 아니라 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"몇 달째 보여줄 게 없음\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이다. ADR-002로 룰이 데이터로 분리되어 있으므로 교체가 곧 정식 구현이 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 초기에 화면에 뜨는 숫자가 틀린 값이다. 이 기간에는 누구에게도 보여주지 않거나, 가짜 값임을 화면에 크게 표시한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-012: 主筋·帯筋 사양은 입력이며 제품이 바꾸지 않는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 단면일람의 主筋 경·본수, 帯筋/あばら筋 경·피치는 사용자 입력이고 제품이 변경하지 않는다. 룰팩 조회 대상은 定着·重ね継手·折曲げ·かぶり 등 **배근 상세값**으로 한정한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 원래 PRD는 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"主筋 본수·배치를 룰팩에서 조회\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라고 썼는데 같은 PRD가 단면일람을 입력으로 받았다 — 같은 값을 입력이자 산출로 둔 모순이었다. 더 근본적으로 **主筋 본수는 標準仕様書가 주는 값이 아니라 구조계산 결과**이고 구조도의 柱リスト/梁リスト에서 온다. 룰팩으로 조회할 대상이 애초에 존재하지 않는다. 그리고 이 경계가 제품이 구조설계 책임을 지지 않는 근거가 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 主筋 자동설계를 포기한다. 사용자가 단면일람을 전부 입력해야 하므로 입력량이 늘어난다 — 이것이 UX 리뷰(ADR-010)의 최우선 측정 대상이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-013: 設計数量과 所要数量을 모두 산출한다 (ADR-009 대체)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 철근의 設計数量과 躯体 4% 할증을 적용한 所要数量을 별도 필드로 둔다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: ADR-009의 전제(근거가 유료 서적뿐)가 틀렸다. `공공건축 수량적산기준(令和5년 개정)`이 무료·PDL1.0이고 20쪽에 명시가 있다. 그리고 적산 담당자가 실제 발주에 쓰는 숫자는 所要数量이므로, 設計数量만 내면 제품이 사용자의 마지막 한 걸음을 남겨두는 셈이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n같은 기준서 6쪽은 所要数量을 「定尺寸法による切り無駄や、施工上やむを得ない損耗を含んだ数量」로 정의한다 — **정척 절단 로스가 표준 할증률에 이미 포괄되어 있다.** 따라서 절단 조합 최적화를 별도로 구현할 이유가 없고, MVP 제외가 근거를 갖는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 두 숫자가 표에 함께 나오므로 어느 쪽을 발주에 쓰는지 UI가 명확히 구분해야 한다. 이 혼동은 틀린 값보다 위험할 수 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-014: 할증률 룰은 부재 구분을 인자로 받고 범위 밖이면 실패한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 할증률 조회 함수는 부재 구분을 필수 인자로 받는다. 躯体는 4%를 반환하고, 지원 범위 밖(흙막이벽·말뚝 등)이 들어오면 값을 반환하지 않고 **실패한다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 같은 기준서가 躯体 4%(20쪽), 흙막이벽 3%(13쪽), 말뚝 3%(14쪽)로 다르게 정한다. \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"모든 철근 4%\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"로 일반화하면 지원 범위를 넓힌 순간 조용히 틀린 값이 나가고, 이것이 정확히 ADR 철학이 막으려는 실패 방식이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 미지원 부재의 개략 산출이 불가능하다. 기본값 4%를 주는 편이 편하지만 그 편의가 침묵하는 오류를 만든다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-015: 미검증 수치는 차단하지 않고 경고 + 워터마크로 처리한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: `confidence: inferred` 값이 계산에 기여하면 해당 내역서 행에 경고를 붙이고, 내보내기 산출물에 워터마크와 기여 항목 목록을 넣는다. 계산이나 내보내기 자체를 차단하지는 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 독립 검토자를 확보할 경로가 현재 없다(R3). 미검증 값 하나로 내보내기를 봉쇄하는 fail-closed 규율은 검토자가 있는 조직에서는 옳지만, **이 프로젝트 조건에서는 제품이 영구히 출하되지 않는다는 뜻이 된다.** 대신 틀릴 수 있음을 산출물 자체에 각인시켜, 사용자가 모르고 발주에 쓰는 경로를 막는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: fail-closed보다 약하다. 사용자가 경고를 무시하고 쓸 수 있고 우리는 막을 수 없다. 독립 검토자가 생기면 이 결정을 재검토한다 — 그때는 `stated` 비율이 올라가 봉쇄가 현실적 선택이 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-016: 3D 뷰어를 MVP에 유지한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: three.js 3D 뷰어와 glTF/GLB 내보내기를 MVP 범위에 남긴다. 층별 2D 평면으로 대체하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 대상 사용자가 소규모 설계·시공 사무소와 적산 담당이며, 이들에게 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"입력한 게 맞나\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 확인시키는 가장 빠른 수단이 3D다. 표만 있는 물량 도구는 이미 존재하므로 데모에서 구분되지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 정직하게 말하면 이 결정은 ADR 철학과 긴장 관계다. 3D는 MVP에서 가장 비싼 항목이면서 어떤 검증 가설에도 기여하지 않고, 번들·성능(층당 철근 1만 개 → `InstancedMesh`)·별도 작업을 끌고 온다. 원본 구조도가 평면도이므로 대조 자체는 2D가 더 쉽다는 것도 사실이다. **M1 워킹 스켈레톤이 3D 때문에 지연되기 시작하면 이 결정을 되돌린다** — 신호는 M1이 예정의 2배를 넘는 시점이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== design/README.md =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# design/\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclaude.ai/design 프로젝트 `5b8804ed-775d-4ad9-a490-d36698c90f32`에서 반입한 **참조 자료**. 빌드에 포함되지 않는다.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n화면 사양은 `docs/DESIGN.md`가 정본이다. 이 폴더는 그 근거 자료다.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\nkijun-design-system/    토큰 CSS 7개 + styles.css + readme + 컴포넌트 번들\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n## 주의\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n- **`kijun-design-system/readme.md`의 Index 절반은 실재하지 않는다.** `components/`, `guidelines/`, `ui_kits/`, `templates/`를 나열하지만 원격 프로젝트에 없다. 컴포넌트 구현은 `_ds_bundle.js`(16종 컴파일본) 안에만 있다. readme는 원문 그대로 두었다 — `docs/DESIGN.md` §9 참조.\\\\\\\\\\\\\\\\n- **readme의 브랜드 서사는 다른 제품의 것이다.** \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"저장소를 읽는 에디터\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"로 서술돼 있다. 토큰은 그대로 쓰고, 브랜드 카피와 타임라인 파스텔 5색은 적용 대상이 아니다.\\\\\\\\\\\\\\\\n- **프로토타입 소스는 반입하지 않았다.** 규준 수치를 코드에 하드코딩하는 등 ADR-002·014와 충돌한다. 화면 사양은 `docs/DESIGN.md`로 옮겼고, 충돌 8건은 §10에 정리했다.\\\\\\\\\\\\\\\\n- **`fonts.css`가 Google Fonts를 `@import`한다.** 제품에 편입할 때는 `next/font` 셀프호스팅으로 바꾼다.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== scripts/hooks/tdd-guard.sh =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n#!/bin/bash\\\\\\\\\\\\\\\\n# TDD Guard Hook — PreToolUse\\\\\\\\\\\\\\\\n# 구현 코드를 작성하려 할 때, 해당 모듈의 테스트 파일이 먼저 존재하는지 체크.\\\\\\\\\\\\\\\\n# 테스트 없이 구현 코드를 작성하려 하면 차단.\\\\\\\\\\\\\\\\n#\\\\\\\\\\\\\\\\n# Claude(.claude/settings.json)와 Codex(.codex/hooks.json) 양쪽에서 공유한다.\\\\\\\\\\\\\\\\n# 훅 출력 와이어 포맷(hookSpecificOutput.permissionDecision)은 두 도구가 동일하고,\\\\\\\\\\\\\\\\n# 편집 대상을 표현하는 입력만 다르다:\\\\\\\\\\\\\\\\n#   - Claude Edit|Write   → tool_input.file_path (한 개, 절대경로)\\\\\\\\\\\\\\\\n#   - Codex apply_patch   → tool_input.command 가 패치 본문이고, 그 안의\\\\\\\\\\\\\\\\n#                           '*** Add|Update File: <path>' 헤더가 대상이다 (여러 개, 상대경로)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nINPUT=$(cat)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# --- 편집 대상 경로 추출 ---\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nFILE_PATHS=$(echo \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$INPUT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | jq -r '.tool_input.file_path // empty' 2>/dev/null)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nif [ -z \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATHS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n  # Delete File은 대상이 사라지므로 테스트를 요구하지 않는다 — Add/Update만 본다.\\\\\\\\\\\\\\\\n  FILE_PATHS=$(echo \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$INPUT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | jq -r '.tool_input.command // empty' 2>/dev/null \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    | tr -d '\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\r' \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    | sed -nE 's/^\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\* (Add|Update) File: (.+)$/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\2/p')\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nif [ -z \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATHS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n  exit 0\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# 프로젝트가 아직 스캐폴딩되지 않았으면(package.json 없음) TDD 가드를 건너뛴다.\\\\\\\\\\\\\\\\n# 테스트 프레임워크가 깔리기 전(MVP 부트스트랩)에는 강제할 대상이 없기 때문.\\\\\\\\\\\\\\\\n# package.json이 생기면 이후 모든 lib/소스 편집에 TDD가 적용된다.\\\\\\\\\\\\\\\\nROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\\\\\\\\\\\\\\\\nif [ ! -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$ROOT/package.json\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n  exit 0\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# --- 경로 한 개 판정: 0 = 테스트 없이 편집 불가(차단), 1 = 허용 ---\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nneeds_test() {\\\\\\\\\\\\\\\\n  FILE_PATH=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # 테스트 파일 자체를 수정하는 건 허용\\\\\\\\\\\\\\\\n  case \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in\\\\\\\\\\\\\\\\n    *test*|*spec*|*.test.*|*.spec.*|*__tests__*)\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n      ;;\\\\\\\\\\\\\\\\n  esac\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # .claude/·.codex/ 인프라(설정·훅·슬래시 커맨드)와 workflows/ 오케스트레이션 스크립트는 TDD 비대상 — 허용.\\\\\\\\\\\\\\\\n  # 이유: 워크플로우 스크립트는 런타임이 주입하는 전역(agent/pipeline/log)에 의존하는 오케스트레이션\\\\\\\\\\\\\\\\n  #       정의로, lib/services 비즈니스 로직이 아니며 유닛 테스트를 붙일 수 없다.\\\\\\\\\\\\\\\\n  case \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in\\\\\\\\\\\\\\\\n    .claude/*|*/.claude/*|.codex/*|*/.codex/*|workflows/*|*/workflows/*)\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n      ;;\\\\\\\\\\\\\\\\n  esac\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # 설정/타입/스타일 파일은 테스트 불필요 — 허용\\\\\\\\\\\\\\\\n  case \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in\\\\\\\\\\\\\\\\n    *.json|*.css|*.scss|*.md|*.yml|*.yaml|*.env*|*.config.*|*tailwind*|*postcss*|*next.config*|*tsconfig*)\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n      ;;\\\\\\\\\\\\\\\\n  esac\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # types/ 폴더는 테스트 불필요 — 허용\\\\\\\\\\\\\\\\n  case \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in\\\\\\\\\\\\\\\\n    types/*|*/types/*|*/types.ts|types.ts|*/types.d.ts|types.d.ts)\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n      ;;\\\\\\\\\\\\\\\\n  esac\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # Next.js 프레임워크 파일은 허용 (layout, page, loading, error, not-found, global styles)\\\\\\\\\\\\\\\\n  case \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in\\\\\\\\\\\\\\\\n    */layout.tsx|*/layout.ts|*/page.tsx|*/page.ts|*/loading.tsx|*/error.tsx|*/not-found.tsx|*/globals.css)\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n      ;;\\\\\\\\\\\\\\\\n  esac\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # lib/ 또는 소스 파일이면 테스트 파일 존재 여부 확인\\\\\\\\\\\\\\\\n  case \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in\\\\\\\\\\\\\\\\n    *.ts|*.tsx|*.js|*.jsx) ;;\\\\\\\\\\\\\\\\n    *) return 1 ;;\\\\\\\\\\\\\\\\n  esac\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  DIR=$(dirname \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n  BASENAME=$(basename \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | sed -E 's/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.(ts|tsx|js|jsx)$//')\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # 같은 폴더에 .test 파일\\\\\\\\\\\\\\\\n  for EXT in ts tsx js jsx; do\\\\\\\\\\\\\\\\n    if [ -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${DIR}/${BASENAME}.test.${EXT}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ] || [ -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${DIR}/${BASENAME}.spec.${EXT}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n    fi\\\\\\\\\\\\\\\\n  done\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # __tests__ 폴더\\\\\\\\\\\\\\\\n  PARENT=$(dirname \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$DIR\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n  for EXT in ts tsx js jsx; do\\\\\\\\\\\\\\\\n    if [ -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${PARENT}/__tests__/${BASENAME}.test.${EXT}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ] || [ -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${DIR}/__tests__/${BASENAME}.test.${EXT}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n    fi\\\\\\\\\\\\\\\\n  done\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  # src/__tests__/ 루트 테스트 폴더\\\\\\\\\\\\\\\\n  for EXT in ts tsx js jsx; do\\\\\\\\\\\\\\\\n    if [ -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${ROOT}/src/__tests__/${BASENAME}.test.${EXT}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n      return 1\\\\\\\\\\\\\\\\n    fi\\\\\\\\\\\\\\\\n  done\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return 0\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# --- 추출된 경로를 전부 검사 (파이프 대신 here-doc — 서브셸에서 결과가 유실되지 않게) ---\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nMISSING=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\nwhile IFS= read -r FILE_PATH; do\\\\\\\\\\\\\\\\n  [ -z \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ] && continue\\\\\\\\\\\\\\\\n  if needs_test \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"; then\\\\\\\\\\\\\\\\n    NAME=$(basename \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$FILE_PATH\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | sed -E 's/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.(ts|tsx|js|jsx)$//')\\\\\\\\\\\\\\\\n    MISSING=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${MISSING}${MISSING:+, }${NAME}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n  fi\\\\\\\\\\\\\\\\ndone <<EOF\\\\\\\\\\\\\\\\n$FILE_PATHS\\\\\\\\\\\\\\\\nEOF\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nif [ -n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$MISSING\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n  FIRST=${MISSING%%,*}\\\\\\\\\\\\\\\\n  cat << EOF\\\\\\\\\\\\\\\\n{\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"hookSpecificOutput\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": {\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"hookEventName\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"PreToolUse\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"permissionDecision\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"deny\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"permissionDecisionReason\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"TDD GUARD: '${MISSING}'에 대한 테스트 파일이 존재하지 않습니다. 구현 코드를 작성하기 전에 테스트를 먼저 작성하세요. (테스트 파일 예: ${FIRST}.test.ts)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\nEOF\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexit 0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== scripts/hooks/stop-verify.sh =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n#!/bin/bash\\\\\\\\\\\\\\\\n# Stop Verify Hook — 턴이 끝날 때 lint·build·test로 검증한다.\\\\\\\\\\\\\\\\n#\\\\\\\\\\\\\\\\n# Codex Stop 이벤트 계약:\\\\\\\\\\\\\\\\n#   - exit 0일 때 stdout은 JSON이어야 한다. plain text는 invalid로 처리된다.\\\\\\\\\\\\\\\\n#     따라서 npm 출력을 stdout으로 흘리면 안 된다 — 캡처해서 reason에 담는다.\\\\\\\\\\\\\\\\n#   - decision \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"block\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" + reason은 턴을 거부하는 게 아니라, reason을 새 프롬프트로 삼아\\\\\\\\\\\\\\\\n#     Codex가 이어서 작업하게 만든다. 검증 실패를 고치게 하는 용도로 맞다.\\\\\\\\\\\\\\\\n#   - 성공하면 아무것도 출력하지 않고 exit 0 한다.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nINPUT=$(cat)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# 이미 Stop 훅이 한 번 이어붙인 턴이면 다시 이어붙이지 않는다 — 무한 루프 방지.\\\\\\\\\\\\\\\\nif [ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$(echo \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$INPUT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | jq -r '.stop_hook_active // false' 2>/dev/null)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"true\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n  exit 0\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# 스캐폴딩 도중에는 게이트를 걸지 않는다. 걸면 M0~M1 내내 매 턴이 막힌다.\\\\\\\\\\\\\\\\n#   - package.json이 아직 없다 → 검증 대상 자체가 없다\\\\\\\\\\\\\\\\n#   - package.json은 생겼지만 lint·build·test가 아직 다 정의되지 않았다\\\\\\\\\\\\\\\\n#     → `npm run`이 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Missing script\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"로 실패해 무의미한 차단이 된다\\\\\\\\\\\\\\\\nif [ ! -f \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$ROOT/package.json\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n  exit 0\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfor SCRIPT in lint build test; do\\\\\\\\\\\\\\\\n  if [ -z \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$(jq -r --arg s \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$SCRIPT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" '.scripts[$s] // empty' \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$ROOT/package.json\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" 2>/dev/null)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ]; then\\\\\\\\\\\\\\\\n    exit 0\\\\\\\\\\\\\\\\n  fi\\\\\\\\\\\\\\\\ndone\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nOUTPUT=$(cd \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$ROOT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" && npm run lint 2>&1 && npm run build 2>&1 && npm run test 2>&1)\\\\\\\\\\\\\\\\nSTATUS=$?\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nif [ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$STATUS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -eq 0 ]; then\\\\\\\\\\\\\\\\n  exit 0\\\\\\\\\\\\\\\\nfi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n# 컨텍스트를 아끼려고 꼬리만 넘긴다. jq -n으로 만들어 따옴표·개행을 정확히 이스케이프한다.\\\\\\\\\\\\\\\\nTAIL=$(echo \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$OUTPUT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | tail -40)\\\\\\\\\\\\\\\\nREASON=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lint · build · test가 실패했습니다 (exit ${STATUS}). 아래 출력을 보고 원인을 고친 뒤 다시 실행하세요.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n${TAIL}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\njq -n --arg reason \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$REASON\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" '{decision: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"block\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", reason: $reason}'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexit 0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== phases/1-skeleton/index.json =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n{\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Kijun\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"phase\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1-skeleton\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"steps\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project-setup\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"started_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-09T18:49:22+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"domain-model\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 2,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"rulepack\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 3,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"rebar-column\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 4,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"quantity\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 5,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"app-shell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 6,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"input-panes\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 7,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"takeoff-pane\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 8,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"viewer-3d\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 9,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"export-xlsx\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"created_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2026-08-09T18:49:22+0900\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== phases/1-skeleton/step0.md =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# Step 0: project-setup\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nM1(워킹 스켈레톤)의 첫 step이다. 저장소에는 아직 문서와 하네스 스크립트만 있고 **애플리케이션 코드가 한 줄도 없다.** 이 step은 이후 9개 step이 올라탈 빌드 인프라를 세운다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 읽어야 할 파일\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n먼저 아래 파일들을 읽고 프로젝트의 아키텍처와 설계 의도를 파악하라:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/AGENTS.md` — 기술 스택과 CRITICAL 규칙\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/docs/ARCHITECTURE.md` — §디렉토리 구조를 그대로 따른다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/docs/ADR.md` — ADR-007(Next.js를 쓰되 서버 컴포넌트 미사용), ADR-011(워킹 스켈레톤 우선)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/docs/DESIGN.md` — §1(디자인 토큰), §9(디자인 시스템 자체의 불일치), §10-6(CDN 의존 해소)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/design/README.md` 와 `/design/kijun-design-system/` 아래 `styles.css`, `tokens/*.css` 7개\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/scripts/hooks/tdd-guard.sh` — **이 훅이 이 step 이후 모든 파일 편집을 검사한다.** 어떤 경로가 테스트를 요구받고 어떤 경로가 면제되는지 반드시 파악해둘 것\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `/scripts/hooks/stop-verify.sh` — `package.json`에 `lint`·`build`·`test`가 모두 정의되는 순간부터 턴이 끝날 때마다 이 세 커맨드가 실행된다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 작업\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 1. Next.js 15 App Router 스캐폴딩\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- Next.js 15 App Router, React 19, TypeScript **strict mode**, Tailwind CSS, ESLint.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `src/` 디렉토리 구조를 쓴다. App Router 경로는 `src/app/`.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `src/app/layout.tsx`와 `src/app/page.tsx`는 **모두 `'use client'`** 로 시작한다. 서버 컴포넌트를 쓰지 않는다(ADR-007).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `src/app/page.tsx`는 이 step에서는 플레이스홀더 한 줄이면 된다. 실제 화면은 step 5에서 만든다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 2. 의존성 설치\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`/AGENTS.md`의 기술 스택이 이미 고정되어 있으므로 이 step에서 한 번에 설치한다. step마다 나눠 설치하지 않는다 — 중간 step에서 설치가 실패하면 그 step 전체가 재시도되기 때문이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 런타임: `next`, `react`, `react-dom`, `three`, `zustand`, `exceljs`, `js-yaml`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 개발: `typescript`, `@types/react`, `@types/react-dom`, `@types/node`, `@types/three`, `@types/js-yaml`, `eslint`, `eslint-config-next`, `tailwindcss`(+ 필요한 postcss 패키지), `vitest`, `jsdom`, `@vitejs/plugin-react`, `@testing-library/react`, `@testing-library/jest-dom`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 3. package.json scripts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n정확히 아래 5개를 정의한다. 이름을 바꾸지 마라 — `/AGENTS.md`의 §명령어와 `stop-verify.sh`가 이 이름에 의존한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```json\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"dev\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"next dev\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"build\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"next build\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lint\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"eslint .\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"vitest run\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test:golden\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"vitest run tests/golden\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 4. vitest 설정 — domain 프로젝트만\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`vitest.config.ts`에 **`domain` 프로젝트 하나만** 정의한다. jsdom 환경의 `ui` 프로젝트는 step 5에서 첫 컴포넌트가 생길 때 추가한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `name: 'domain'`, `environment: 'node'`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `include`: `src/domain/**/*.test.ts`, `src/rulepack/**/*.test.ts`, `tests/**/*.test.ts`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **`passWithNoTests`를 켜지 마라.** 글로브가 깨져도 조용히 통과하게 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**YAML을 raw 문자열로 읽는 vite 플러그인을 이 설정 안에 넣어라.** step 2가 `src/rulepack/*.yaml`을 문자열로 import하는데, vite는 `.yaml` 확장자를 기본으로 처리하지 못한다. `load` 훅에서 `.yaml`로 끝나는 id를 `fs.readFileSync`로 읽어 `export default <문자열 리터럴>`로 돌려주는 10줄 이내의 인라인 플러그인이면 충분하다. 별도 패키지를 설치하지 마라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 5. next.config에 YAML raw 로더\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nstep 2가 브라우저 번들에서도 같은 `.yaml` 파일을 문자열로 읽어야 한다. Node(vitest)와 브라우저(next build) 양쪽에서 **같은 import 문**이 동작해야 한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- Turbopack: `.yaml`을 raw 문자열로 반환하는 rule\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- Webpack fallback: `{ test: /\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.yaml$/, type: 'asset/source' }`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`src/types/yaml.d.ts`에 앰비언트 선언을 둔다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndeclare module '*.yaml' {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const content: string\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  export default content\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 6. 디자인 토큰 반입\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`/design/`은 참조 자료이고 **빌드에 포함되지 않는다**(`/design/README.md`). 따라서 복사해서 들여온다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `design/kijun-design-system/tokens/*.css` 7개와 `styles.css`를 `src/styles/`로 복사한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `fonts.css`의 Google Fonts `@import`를 제거하고 `next/font`로 셀프호스팅한다(Inter + JetBrains Mono). **CDN 요청이 남으면 안 된다**(DESIGN §10-6).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 복사한 각 파일 맨 위에 개변 사실을 주석으로 남긴다. 예: `/* design/kijun-design-system/tokens/fonts.css 에서 복사. Google Fonts @import 제거, next/font 로 대체 (2026-08). */`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `src/app/globals.css`가 `src/styles/styles.css`를 import하도록 연결한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `_ds_bundle.js`는 **가져오지 마라.** 소스가 없는 컴파일본이고 React 버전이 불명이다(DESIGN §9).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 7. 스캐폴딩 스모크 테스트\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`tests/scaffold.test.ts`를 작성한다. 내용:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `package.json`의 `scripts`에 `dev`·`build`·`lint`·`test`·`test:golden`이 모두 존재\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `tsconfig.json`의 `compilerOptions.strict === true`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n이 테스트가 있어야 `npm test`가 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"테스트 파일 없음\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"으로 실패하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 8. 디렉토리 골격\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`/docs/ARCHITECTURE.md`의 구조를 따른다. **빈 디렉토리를 미리 만들지 마라** — 각 step이 자기 파일을 만들 때 생긴다. 다만 아래 두 가지는 구조를 벗어나므로 하지 마라:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `src/services/` 를 만들지 마라. 외부 API를 호출하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `src/types/` 에 도메인 타입을 두지 마라. `yaml.d.ts` 같은 앰비언트 선언만 둔다. 도메인 타입은 step 1에서 `src/domain/model/`에 들어간다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## Acceptance Criteria\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```bash\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run lint\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm run build\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nnpm test\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n세 커맨드가 모두 종료코드 0이어야 한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n추가로 아래를 확인한다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```bash\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ngrep -rn \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"fonts.googleapis\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\|unpkg.com\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\|cdn.jsdelivr\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" src/    # 출력이 없어야 한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 검증 절차\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n1. 위 AC 커맨드를 실행한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n2. 아키텍처 체크리스트를 확인한다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - ARCHITECTURE.md 디렉토리 구조를 따르는가? (`src/app`, `src/components`, `src/domain`, `src/rulepack`, `src/lib`, `src/locales`, `tests/golden`)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - `layout.tsx`·`page.tsx`가 `'use client'`인가? (ADR-007)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - `src/`에 CDN URL이 남아 있지 않은가? (DESIGN §10-6)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - `tsconfig.json`이 strict인가?\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n3. 결과에 따라 `phases/1-skeleton/index.json`의 step 0을 업데이트한다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - 성공 → `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"산출물 한 줄 요약\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` (다음 step이 알아야 할 것: 설치된 패키지 버전, vitest 프로젝트 이름, 토큰 CSS 경로, YAML import 방식)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - 수정 3회 시도 후에도 실패 → `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"error\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"error_message\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"구체적 에러 내용\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   - 사용자 개입 필요 → `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"blocked\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"blocked_reason\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"구체적 사유\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` 후 즉시 중단\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 금지사항\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **규준 수치를 어떤 파일에도 쓰지 마라.** 이유: 定着長さ·重ね継手長さ·折曲げ·かぶり厚さ·할증률·단위질량은 전부 step 2의 YAML에서 온다. 이 step은 인프라만 만든다 (ADR-002).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **화면을 만들지 마라.** 이유: 레이아웃은 step 5, 각 페인은 step 6~8의 몫이다. 여기서 만들면 두 번 만들게 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **서버 컴포넌트·API Route·server action을 만들지 마라.** 이유: ADR-006·007. 사용자 도면 데이터가 서버로 나갈 경로 자체를 만들지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **`_ds_bundle.js`를 `src/`로 복사하지 마라.** 이유: 소스 없는 컴파일본이라 유지보수가 불가능하고 React 버전이 불명이다 (DESIGN §9).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **`--passWithNoTests`를 쓰지 마라.** 이유: include 글로브가 깨져도 CI가 초록으로 보인다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 기존 테스트를 깨뜨리지 마라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_6\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command '$files = @('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'docs/ADR.md','docs/DESIGN.md','design/kijun-design-system/styles.css','design/kijun-design-system/tokens/base.css','design/kijun-design-system/tokens/colors.css','design/kijun-design-system/tokens/elevation.css','design/kijun-design-system/tokens/fonts.css','design/kijun-design-system/tokens/radius.css','design/kijun-design-system/tokens/spacing.css','design/kijun-design-system/tokens/typography.css'); foreach (\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'$file in $files) { $lines=(Get-Content -Encoding UTF8 $file).Count; Write-Output \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$file`t$lines\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" }'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_6\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command '$files = @('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'docs/ADR.md','docs/DESIGN.md','design/kijun-design-system/styles.css','design/kijun-design-system/tokens/base.css','design/kijun-design-system/tokens/colors.css','design/kijun-design-system/tokens/elevation.css','design/kijun-design-system/tokens/fonts.css','design/kijun-design-system/tokens/radius.css','design/kijun-design-system/tokens/spacing.css','design/kijun-design-system/tokens/typography.css'); foreach (\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'$file in $files) { $lines=(Get-Content -Encoding UTF8 $file).Count; Write-Output \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"$file`t$lines\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" }'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"docs/ADR.md\\\\\\\\\\\\\\\\t105\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndocs/DESIGN.md\\\\\\\\\\\\\\\\t281\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/styles.css\\\\\\\\\\\\\\\\t7\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/base.css\\\\\\\\\\\\\\\\t14\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/colors.css\\\\\\\\\\\\\\\\t59\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/elevation.css\\\\\\\\\\\\\\\\t11\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/fonts.css\\\\\\\\\\\\\\\\t7\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/radius.css\\\\\\\\\\\\\\\\t11\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/spacing.css\\\\\\\\\\\\\\\\t18\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndesign/kijun-design-system/tokens/typography.css\\\\\\\\\\\\\\\\t32\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_7\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Write-Output '===== docs/ADR.md 1-60 ====='; Get-Content -Encoding UTF8 docs/ADR.md | Select-Object -First 60; Write-Output '===== docs/ADR.md 61-120 ====='; Get-Content -Encoding UTF8 docs/ADR.md | Select-Object -Skip 60 -First 60; Write-Output '===== docs/DESIGN.md 1-95 ====='; Get-Content -Encoding UTF8 docs/DESIGN.md | Select-Object -First 95; Write-Output '===== docs/DESIGN.md 96-190 ====='; Get-Content -Encoding UTF8 docs/DESIGN.md | Select-Object -Skip 95 -First 95\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_7\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Write-Output '===== docs/ADR.md 1-60 ====='; Get-Content -Encoding UTF8 docs/ADR.md | Select-Object -First 60; Write-Output '===== docs/ADR.md 61-120 ====='; Get-Content -Encoding UTF8 docs/ADR.md | Select-Object -Skip 60 -First 60; Write-Output '===== docs/DESIGN.md 1-95 ====='; Get-Content -Encoding UTF8 docs/DESIGN.md | Select-Object -First 95; Write-Output '===== docs/DESIGN.md 96-190 ====='; Get-Content -Encoding UTF8 docs/DESIGN.md | Select-Object -Skip 95 -First 95\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"===== docs/ADR.md 1-60 =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# Architecture Decision Records\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 철학\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**검증할 수 없는 것은 만들지 않는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n이 프로젝트는 1인 사이드 프로젝트이고, 개발자는 건축/토목 전공이지만 실무 경험이 짧고 일본어를 읽지 못한다. 이 조건에서 가장 큰 위험은 기능이 안 만들어지는 것이 아니라 **틀린 채로 완성되고, 완성된 줄 아는 것**이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n따라서 모든 결정은 다음 순서로 판단한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n1. 이 기능의 출력이 맞았는지 **기계가** 판정할 수 있는가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n2. 없다면, **문서 대조로** 사람이 판정할 수 있는가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n3. 둘 다 안 되면 만들지 않는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n그리고 범위에 대해서는: **부재 1종으로 파이프라인 전체를 관통하는 것이, 부재 4종을 절반씩 하는 것보다 낫다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-001: 일본 기준으로 직행 (한국 기준을 거치지 않음)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: MVP를 처음부터 일본 법규·시방서 기준으로 만든다. 한국 기준(KDS) 구현 단계를 거치지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 룰 레이어가 곧 제품의 차별점인데, 한국으로 연습하면 가장 어려운 부분을 가장 동기가 떨어졌을 때로 미루게 된다. 한국 시장에는 이미 동등한 제품이 있어 만들 이유가 없다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 개발자가 일본어를 읽지 못한다. 원문 독해는 LLM이 대행하고 한국어로 보고받는다. 이것으로 **원문 해석의 1차 초안은 얻지만 검증은 얻지 못한다** — 추출자와 승인자가 같으면 독립 검토가 아니다. 따라서 LLM 추출값은 `confidence: inferred`로 들어가고, 원문 대조로 쪽·표를 특정한 값만 `stated`가 된다. 조문에 없는 관행(暗黙知)과 독립 검증자 부재는 해결되지 않는다. 이 잔여 리스크를 안고 간다 (ADR-010, ADR-015).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-002: 룰 로직은 코드, 룰 수치는 데이터(룰팩)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 어느 표를 볼지 결정하고 길이를 조합하는 **로직**은 평범한 TS 함수로 쓴다. 그 함수가 읽는 **수치**(定着長さ, 重ね継手長さ, 折曲げ 형상, かぶり厚さ, 할증률)는 `rulepack/*.yaml`에 두고 코드에 리터럴로 쓰지 않는다. 각 항목은 `source`(문서·판·URL·페이지)와 `confidence`(stated|inferred)를 가진다. 룰 DSL이나 평가기는 만들지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 네 가지를 동시에 해결한다. ① 기존 제품(BuilderHub-Q, 鉄之助 등)은 규준이 하드코딩이라 발주처 특기시방서 대응이 벤더 작업이다 — 룰팩 교체가 유일한 차별점이 된다. ② `source`가 있으면 누구든 클릭 한 번으로 대조 검증할 수 있다. ③ PDL1.0의 출처 표시 의무를 자동으로 충족한다. ④ **수치가 코드에 박히면 항목 단위로 `confidence`를 붙일 수 없어 `inferred` 경고와 워터마크(ADR-015)가 성립하지 않는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 조회 엔진(조건 매칭)을 만들어야 하고, 하드코딩보다 초기 비용이 높다. 룰팩 스키마를 잘못 설계하면 나중에 전량 마이그레이션이 필요하다. 로직/수치 경계가 애매한 항목(조건 분기 자체가 규준에 적힌 경우)에서는 판단이 필요하다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-003: 근거 문서를 国交省 공개 자료로 고정 (`建築工事標準詳細図`는 제외)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: `公共建築工事標準仕様書(建築工事編) 令和7年版` + `공공건축 수량적산기준(令和5년 개정)` + `건축기준법 시행령`을 근거로 삼는다. **`建築工事標準詳細図(令和4年改定)`은 근거 목록에서 제외한다.** JASS 5와 발주처 특기시방서는 쓰지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 무료·공개·URL 인용 가능하다는 점이 결정적이다. 개발자가 검증할 수 없는 프로젝트에서, 누구든 클릭 한 번으로 대조할 수 있다는 성질이 유료 서적의 시장 적합성보다 중요하다. PDL1.0으로 상업적 이용·가공도 허용된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n標準詳細図을 제외하는 이유는 확인 결과다. 인용 PDF(`001157902.pdf`)는 **3쪽뿐이고 표지와 총칙만 있어 실제 상세도가 없으며**, 2쪽 총칙이 근거를 시방서 **令和4年版**으로 명시해 이 프로젝트가 쓰는 R7과 판이 어긋난다. 배근 상세를 여기서 가져올 수 없다. R7 대응 개정판과 도면 본편의 소재는 M0에서 확인하고, 찾으면 근거 목록에 복귀시킨다. 자세한 판정은 `docs/SOURCES.md`에 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 관공서 공사 기준이다. 일본 민간 공사는 JASS 5 기반이 주류이므로 시장 적합성이 좁다. JASS 5는 나중에 추가 룰팩으로 대응한다 — ADR-002 덕분에 이것이 로드맵이 된다. 그리고 상세도가 빠진 만큼 **배근 상세 수치의 상당 부분을 시방서 본문에서 찾아야 하며, 시방서에 없으면 `inferred`로 남는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-004: DWG 자동인식을 하지 않고 웹 간이 평면 입력을 받는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 형상 입력은 브라우저의 간이 평면 에디터 + 단면일람 표로 받는다. DWG/DXF 도면 인식, IFC 업로드는 하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 도면 인식은 본질적으로 데이터 문제다. 검증용 실도면 세트를 구할 수 없으므로 노력으로 해결되지 않는다. 그리고 일본 주류 철근 적산 소프트(`鉄之助`)가 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"平面図入力によるカンタン操作\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 판매 포인트로 삼는다 — 도면 인식 없이도 시장이 존재한다는 선례가 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: BuilderHub-Q의 가장 큰 세일즈 포인트를 포기한다. 이미 CAD 도면이 있는 사용자에게는 입력이 이중 작업이 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-005: 철근 산정 범위를 柱 + 大梁으로 한정\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: MVP는 柱와 大梁만 배근한다. 壁·スラブ·基礎·小梁은 코드조차 만들지 않는다. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 골조 철근 물량의 대부분을 차지하면서, 규준이 상대적으로 표준화되어 있다. 壁의 開口補強筋은 관행 덩어리라 ADR 철학의 3번(검증 불가)에 걸린다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n콘크리트·거푸집을 넣지 않는 이유는 별개다. 사용자가 원하는 것은 철근 물량이고, 거푸집 면적은 개구부 공제 기준 등 **또 하나의 룰 세트**를 요구한다. 형상 입력 UI와 `geometry` 모듈까지 딸려오므로 MVP 한 벌 값이 더 든다. v1.1로 미룬다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 한 층 전체 물량이 나오지 않아 실무에 바로 쓰이지 못한다. 데모에서 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"슬래브는요?\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라는 질문을 받는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-006: 계산을 전부 클라이언트에서 하고 서버 상태를 두지 않는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 배근 생성·물량 집계·3D·Excel 생성을 전부 브라우저에서 수행한다. 계정, DB, 서버 저장을 두지 않는다. 프로젝트는 JSON 파일 다운로드/업로드 + IndexedDB.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: DWG 인식과 솔리드 모델링을 뺀 결과, 남은 계산은 표 조회와 산술뿐이라 서버가 필요 없다. 그리고 건설 도면·물량은 기밀이다 — \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"데이터가 우리 서버로 올라가지 않는다\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"는 일본 시장에서 유효한 신뢰 근거다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 룰 로직이 클라이언트에 노출된다. 사용 데이터를 수집할 수 없다. 협업·공유 기능이 불가능하다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-007: Vite가 아니라 Next.js App Router를 쓴다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: Next.js App Router. 단, 서버 컴포넌트를 쓰지 않고 전부 클라이언트 컴포넌트로 작성한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: ADR-006으로 서버가 필요 없어졌으므로 순수 클라이언트 3D 도구에는 Vite가 더 잘 맞는다. 그럼에도 Next.js를 고르는 유일한 이유는, 계정·프로젝트 저장·룰팩 배포·과금이 결국 들어올 때 Vite SPA에서 옮기는 비용이 지금 Next.js를 감내하는 비용보다 크기 때문이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: `'use client'`를 도배하게 되고, 쓰지 않는 프레임워크 기능의 복잡도를 계속 이고 간다. 만약 이 제품이 SaaS가 아니라 단일 도구로 끝난다면 이 결정은 낭비였던 것으로 판명된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-008: 기본 로케일은 `ja`, `ko`는 fallback 보조 로케일\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 기본 로케일을 `ja`로 두고, `ko`의 fallback을 `ja`로 설정한다. 한국어는 핵심 문구만 번역한다. 도메인 용어(柱, 大梁, 帯筋, あばら筋, 定着, 重ね継手, SD345, Fc24)는 번역하지 않고 일본어 원어를 고정한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 번역되지 않은 키가 자동으로 일본어로 노출되므로 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"핵심만 한국어\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"가 유지보수 비용 없이 성립한다. 도메인 용어를 번역하면 일본 기준을 구현하면서 한국 개념으로 생각하게 되고, `あばら筋`과 늑근의 미묘한 관행 차이가 조용히 섞인다 — 정확히 개발자가 잡아낼 수 없는 종류의 오류다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== docs/ADR.md 61-120 =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 한국어 UI가 군데군데 일본어로 남는다. 일본 진출 시점에는 `ko`를 삭제한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-009: ~~設計数量만 산출하고 적산 할증은 사용자 계수로 받는다~~ (ADR-013으로 대체됨)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 도면상 철근 길이의 합(設計数量)만 계산한다. `建築数量積算基準`의 할증·로스·이음 개소 산정 규칙은 구현하지 않고, 사용자가 할증 계수를 입력하게 한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: `建築数量積算基準`은 유료 서적이라 ADR-003의 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"검증 가능한 근거\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" 조건을 만족하지 못한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**폐기 사유**: **전제가 틀렸다.** 유료 서적을 볼 필요가 없다 — 国交省이 공개한 `공공건축 수량적산기준(令和5년 개정)`이 무료·PDL1.0이고 20쪽에 躯体 철근 4% 할증이 명시되어 있다. ADR-003의 근거 조건을 만족하므로 구현하지 않을 이유가 없다. ADR-013·ADR-014로 대체한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-010: 검증을 골든테스트(숫자)와 사람(UX)으로 분리한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 규준 수치의 정확성은 `標準仕様書`·`수량적산기준`의 표를 테스트 픽스처로 박은 골든테스트가 판정한다. 사람에게는 UX만 검증받는다 — 한국 실무자에게 입력 흐름·내역서 양식·빠진 항목을 묻는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 한국 실무자는 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이 정착길이가 일본 기준에 맞는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 판정할 수 없다. 판정할 수 없는 것을 사람에게 묻고 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"확인받았다\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"고 여기는 것이 가장 위험하다. 반대로 표 대조는 사람 없이 CI에서 돈다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 골든테스트가 판정하는 것은 **\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"엔진 출력이 픽스처와 일치하는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"까지다.** \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"픽스처가 원문을 옳게 옮겼는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"는 판정하지 못하고, 이 프로젝트에서는 원문 전사를 LLM이 하므로 그 층에 검증이 없다. 픽스처를 만들 때 쪽·표를 반드시 기록해 사후 대조 비용을 낮추는 것으로 대응하고, 대조되지 않은 값은 `inferred`로 남긴다 (ADR-015).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n문서에 명시되지 않은 관행도 영구히 미검증으로 남는다. `confidence: inferred` 목록이 그 미검증 항목의 대장 역할을 하고, 일본 접점이 생기는 시점의 질문지가 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-011: 룰팩보다 워킹 스켈레톤을 먼저 만든다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: M0(반나절 스파이크: `標準仕様書 R7`에 배근 상세 수치가 실제로 몇 개 있는지, 표가 텍스트인지 이미지인지 판정) 직후, 柱 1종 + 가짜 룰(`定着 = 40d` 같은 상수)로 입력→철근→물량→3D→Excel 전 구간을 먼저 관통시킨다. 실제 룰팩은 그다음에 가짜 룰을 교체하는 방식으로 넣는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 통합 리스크를 가장 먼저 죽인다. 그리고 1인 사이드 프로젝트가 죽는 가장 흔한 원인은 기술 난이도가 아니라 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"몇 달째 보여줄 게 없음\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이다. ADR-002로 룰이 데이터로 분리되어 있으므로 교체가 곧 정식 구현이 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 초기에 화면에 뜨는 숫자가 틀린 값이다. 이 기간에는 누구에게도 보여주지 않거나, 가짜 값임을 화면에 크게 표시한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-012: 主筋·帯筋 사양은 입력이며 제품이 바꾸지 않는다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 단면일람의 主筋 경·본수, 帯筋/あばら筋 경·피치는 사용자 입력이고 제품이 변경하지 않는다. 룰팩 조회 대상은 定着·重ね継手·折曲げ·かぶり 등 **배근 상세값**으로 한정한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 원래 PRD는 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"主筋 본수·배치를 룰팩에서 조회\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라고 썼는데 같은 PRD가 단면일람을 입력으로 받았다 — 같은 값을 입력이자 산출로 둔 모순이었다. 더 근본적으로 **主筋 본수는 標準仕様書가 주는 값이 아니라 구조계산 결과**이고 구조도의 柱リスト/梁リスト에서 온다. 룰팩으로 조회할 대상이 애초에 존재하지 않는다. 그리고 이 경계가 제품이 구조설계 책임을 지지 않는 근거가 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 主筋 자동설계를 포기한다. 사용자가 단면일람을 전부 입력해야 하므로 입력량이 늘어난다 — 이것이 UX 리뷰(ADR-010)의 최우선 측정 대상이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-013: 設計数量과 所要数量을 모두 산출한다 (ADR-009 대체)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 철근의 設計数量과 躯体 4% 할증을 적용한 所要数量을 별도 필드로 둔다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: ADR-009의 전제(근거가 유료 서적뿐)가 틀렸다. `공공건축 수량적산기준(令和5년 개정)`이 무료·PDL1.0이고 20쪽에 명시가 있다. 그리고 적산 담당자가 실제 발주에 쓰는 숫자는 所要数量이므로, 設計数量만 내면 제품이 사용자의 마지막 한 걸음을 남겨두는 셈이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n같은 기준서 6쪽은 所要数量을 「定尺寸法による切り無駄や、施工上やむを得ない損耗を含んだ数量」로 정의한다 — **정척 절단 로스가 표준 할증률에 이미 포괄되어 있다.** 따라서 절단 조합 최적화를 별도로 구현할 이유가 없고, MVP 제외가 근거를 갖는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 두 숫자가 표에 함께 나오므로 어느 쪽을 발주에 쓰는지 UI가 명확히 구분해야 한다. 이 혼동은 틀린 값보다 위험할 수 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-014: 할증률 룰은 부재 구분을 인자로 받고 범위 밖이면 실패한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: 할증률 조회 함수는 부재 구분을 필수 인자로 받는다. 躯体는 4%를 반환하고, 지원 범위 밖(흙막이벽·말뚝 등)이 들어오면 값을 반환하지 않고 **실패한다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 같은 기준서가 躯体 4%(20쪽), 흙막이벽 3%(13쪽), 말뚝 3%(14쪽)로 다르게 정한다. \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"모든 철근 4%\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"로 일반화하면 지원 범위를 넓힌 순간 조용히 틀린 값이 나가고, 이것이 정확히 ADR 철학이 막으려는 실패 방식이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 미지원 부재의 개략 산출이 불가능하다. 기본값 4%를 주는 편이 편하지만 그 편의가 침묵하는 오류를 만든다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-015: 미검증 수치는 차단하지 않고 경고 + 워터마크로 처리한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: `confidence: inferred` 값이 계산에 기여하면 해당 내역서 행에 경고를 붙이고, 내보내기 산출물에 워터마크와 기여 항목 목록을 넣는다. 계산이나 내보내기 자체를 차단하지는 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 독립 검토자를 확보할 경로가 현재 없다(R3). 미검증 값 하나로 내보내기를 봉쇄하는 fail-closed 규율은 검토자가 있는 조직에서는 옳지만, **이 프로젝트 조건에서는 제품이 영구히 출하되지 않는다는 뜻이 된다.** 대신 틀릴 수 있음을 산출물 자체에 각인시켜, 사용자가 모르고 발주에 쓰는 경로를 막는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: fail-closed보다 약하다. 사용자가 경고를 무시하고 쓸 수 있고 우리는 막을 수 없다. 독립 검토자가 생기면 이 결정을 재검토한다 — 그때는 `stated` 비율이 올라가 봉쇄가 현실적 선택이 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### ADR-016: 3D 뷰어를 MVP에 유지한다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**결정**: three.js 3D 뷰어와 glTF/GLB 내보내기를 MVP 범위에 남긴다. 층별 2D 평면으로 대체하지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**이유**: 대상 사용자가 소규모 설계·시공 사무소와 적산 담당이며, 이들에게 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"입력한 게 맞나\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 확인시키는 가장 빠른 수단이 3D다. 표만 있는 물량 도구는 이미 존재하므로 데모에서 구분되지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**트레이드오프**: 정직하게 말하면 이 결정은 ADR 철학과 긴장 관계다. 3D는 MVP에서 가장 비싼 항목이면서 어떤 검증 가설에도 기여하지 않고, 번들·성능(층당 철근 1만 개 → `InstancedMesh`)·별도 작업을 끌고 온다. 원본 구조도가 평면도이므로 대조 자체는 2D가 더 쉽다는 것도 사실이다. **M1 워킹 스켈레톤이 3D 때문에 지연되기 시작하면 이 결정을 되돌린다** — 신호는 M1이 예정의 2배를 넘는 시점이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== docs/DESIGN.md 1-95 =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n# DESIGN: Kijun UI 사양\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`docs/PRD.md`가 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"무엇을 만드는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", `docs/ARCHITECTURE.md`가 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"어떻게 쪼개는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라면 이 문서는 **\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"화면에서 어떻게 보이고 어떻게 조작되는가\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"**를 고정한다. 근거는 claude.ai/design에서 반입한 디자인 시스템과 동작하는 프로토타입이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 0. 반입 경위와 출처\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 원본 (claude.ai/design 프로젝트 `5b8804ed-775d-4ad9-a490-d36698c90f32`) | 로컬 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `_ds/kijun-design-system-7f1cd279…/readme.md` | `design/kijun-design-system/readme.md` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `_ds/…/styles.css`, `tokens/*.css` (7) | `design/kijun-design-system/` (동일 구조) |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `_ds/…/_ds_bundle.js` (컴포넌트 16종 컴파일본) | `design/kijun-design-system/_ds_bundle.js` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `Kijun 配筋・数量内訳.html` | **미반입** — §10 참조 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `app/{rulepack,i18n,engine}.js`, `app/{PlanEditor,Viewer3D,Takeoff,App}.jsx` | **미반입** — §10 참조 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n반입일 2026-08-09. 원격 프로젝트의 `github.md`에 이렇게 기록돼 있다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> No repository content has been imported yet — the GitHub browse tools were not available in that session, so the prototype was built from the pasted Kijun PRD.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n즉 **프로토타입은 이 저장소를 한 줄도 읽지 않고 PRD만 보고 만들어졌다.** 코드와의 정합성은 검증된 적이 없고, 아래 §10의 충돌은 그 결과다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 1. 디자인 토큰\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`design/kijun-design-system/styles.css` 하나만 불러오면 7개 토큰 파일이 `@import`된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 파일 | 내용 | 고정 규칙 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `colors.css` | 베이스 팔레트 + 시맨틱 별칭 | 컴포넌트에 hex 직접 쓰지 않음 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `typography.css` | 14단 타입 래더 + `.t-*` 유틸 | display는 **항상 weight 400**, 음수 자간 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `spacing.css` | 4px 기준, 섹션 80px | — |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `radius.css` | 4 / 6 / 8 / 12 / 16 / pill | CTA·input 8px, 카드·페인 12px |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `elevation.css` | 테두리 + 포커스 링 | **`box-shadow` 없음.** 모든 elevation이 `none`으로 해석됨 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `fonts.css` | Inter + JetBrains Mono | Google Fonts CDN — §10-6 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `base.css` | 문서 기본값 | — |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n핵심 색 3개만 외우면 된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 바닥은 크림 `--color-canvas` `#f7f7f4`. **순백은 바닥색이 아니라 카드색**(`--surface-card` `#ffffff`)이다. 카드가 떠 보이는 이유는 그림자가 아니라 바닥보다 하얗기 때문.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 글자는 따뜻한 근사 검정 `--text-ink` `#26251e`. 순검정은 없다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 브랜드 오렌지 `--color-primary` `#f54e00`는 **화면당 하나**. 워드마크와 선택 강조에만 쓴다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n깊이는 전부 1px 선(`--hairline` `#e6e5e0`)이다. 다중 페인 레이아웃은 그리드 `gap:1px` + 배경 hairline으로 구분선을 만든다 — 테두리를 그리지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 2. 화면 구조\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n한 화면에 4개 페인. 모달 없음, 라우팅 없음.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n┌──────────────────────────────────────────────────────────────────┐\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│ Kijun 基準 │ サンプル案件 / RC 2階建て          [日本語][한국어] │ 52px\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├───────────────────────────┬──────────────────────────────────────┤\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│ 平面エディタ  [2FL][RFL]  │ 3Dビュー  1F-X2Y2        C1の配筋   │ 38px\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│                           ├──────────────────────────────────────┤\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│      ○X1    ○X2    ○X3    │                                      │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│  ○Y3 ─┼──G1──┼──G1──┼─    │        (선택 부재의 배근만)          │ 44%\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│       │      │      │     │         다크 캔버스 #1b1a14          │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│  ○Y2 ─┼──G2──┼──G2──┼─    │                                      │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│       │      │      │     ├──────────────────────────────────────┤\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│  ○Y1 ─┼──G1──┼──G1──┼─    │ 数量内訳書        [割増 4%][書き出し]│ 38px\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│      6000   6000          ├──────────────────────────────────────┤\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│                           │ 1階                    12,345  12,839│\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n├───────────────────────────┤   柱 C1  800×800 [9箇所]             │ 56%\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│ 部材断面一覧              │     主筋  D25 ─── 4.500  12  9  ...  │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│ 符号 断面 主筋 帯筋       │     帯筋  D13 ▭   2.960  36  9  ...  │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n│ C1  800×800 12-D25 D13@100│   大梁 G1 400×750 [8箇所]            │\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n└───────────────────────────┴──────────────────────────────────────┘\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n     minmax(392px, 34%)      │                 1fr\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 최상위: `height:100vh`, 헤더 52px 고정 + 본문 `1fr`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 본문: `grid-template-columns: minmax(392px,34%) 1fr`, `gap:1px`, 배경 `--hairline`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 오른쪽 열: `grid-template-rows: minmax(0,44%) minmax(0,56%)` — 3D 위, 내역서 아래\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 모든 페인 헤더는 38px, `t-caption-uppercase` 라벨(11px, +0.88px 자간)로 시작\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 3. 상호 선택 모델\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n내역서 행 ↔ 3D 철근 ↔ 평면 부재를 잇는 축이 두 개다. **이게 이 제품의 핵심 상호작용이다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 3.1 부재 그룹 선택 — `sel`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```js\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nsel = { group: '1F|C|C1', memberId: '1F-X2Y2' }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`group`은 `{층 또는 레벨}|{C|G}|{符号}`. 같은 符号의 부재는 한 그룹으로 묶여 내역서에 **1행 + 箇所수**로 집계된다(9개 기둥 → 1행 × 9箇所). `memberId`는 그 그룹의 대표 1개 — 3D에 실제로 그려지는 부재.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 조작 | 결과 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== docs/DESIGN.md 96-190 =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 평면에서 부재 클릭 | `sel` 갱신 → 3D가 그 부재를 그리고, 내역서가 해당 그룹으로 자동 스크롤 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 내역서 그룹/행 클릭 | `sel` 갱신 → 3D 갱신, 평면 강조 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| `sel` 변경 | 그 부재가 속한 층으로 평면 탭이 **자동 전환** |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n선택 표시는 오렌지 하나로 통일: 채움 `rgba(245,78,0,.05~.14)`, 테두리·글자 `--color-primary`.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 3.2 철근 행 강조 — `hoverRow`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`sel`과 **별개 축**이다. 값은 행 id(`1F|C|C1|main`).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 조작 | 결과 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 내역서 행에 hover | 3D에서 그 행의 철근만 오렌지(`#f54e00`)로, 나머지는 회색(`#b8b3a6`) |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 3D에서 철근 클릭 | 레이캐스트 → `rowId` 역추적 → 해당 내역서 행 강조 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nPRD 핵심 기능 4번 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"내역서 행 ↔ 3D 철근 개체 상호 선택\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이 이 축이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 4. 내역서 양식\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n화면 12열. `thead`는 sticky.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| # | 열 | 정렬 | 비고 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 1 | 鉄筋 | 좌 | inferred면 이름 옆 crimson 경고 삼각형 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 2 | 径 | 우 | `D25` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 3 | 形状 | 좌 | 32×18 SVG 아이콘 — `straight` / `hook90` / `hoop` 3종 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 4 | 長さ (m) | 우 | 소수 3자리 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 5 | 本数 | 우 | 부재 1개당 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 6 | 箇所 | 우 | 그룹 내 부재 수 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 7 | 総延長 (m) | 우 | `長さ × 本数 × 箇所` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 8 | kg/m | 우 | 단위질량, muted |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 9 | 設計数量 (kg) | 우 | |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 10 | **所要数量 (kg)** | 우 | **좌측 2px 실선 + `canvas-soft` 배경** — 발주 열 구분 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 11 | 出典 | 좌 | 규준 칩(§6) |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 12 | 備考 | 좌 | 인라인 입력. 평소 테두리 없음, 포커스 시에만 hairline+배경 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n행 계층 3단:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n1. **층 행** — `1階` / `2階`, 배경 canvas, 위쪽 hairline-strong, 소계 굵게\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n2. **그룹 행** — `柱　C1  800×800  [9 箇所]`, 좌측 3px 오렌지 바(선택 시)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n3. **철근 행** — 들여쓰기 30px. 클릭하면 **算出式 디스클로저**가 아래에 펼쳐짐\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n합계 행은 위쪽 `2px solid var(--text-ink)`.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 4.1 算出式 디스클로저\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n행을 열면 mono `<pre>`로 산출 과정이 그대로 나온다. PRD의 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"행 단위 산출식\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"이 이것이다(계산 DAG는 MVP 제외).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n加工長 ＝ 2×{(800−2×40)＋(800−2×40)} ＋ 2×135°フック余長 6d(78) ＝ 3040\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n本数 ＝ ⌈(階高 4200 − 上部大梁せい 750) ÷ 100⌉ ＋ 1 ＝ 36\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n읽는 사람이 표 값을 손으로 재현할 수 있어야 한다 — 숫자만이 아니라 **어느 규준값이 어디에 들어갔는지**가 문장에 남는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 4.2 CSV 내보내기\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n화면 12열 + `階 / 部材 / 符号` 3열 + `算出式` 1열 = **16열**. 파일 앞머리에 §5의 워터마크 2줄이 먼저 온다. `﻿` BOM 포함(Excel 한글·일본어 깨짐 방지), 파일명 `kijun-takeoff.csv`.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> MVP 목표는 exceljs 기반 `.xlsx`다. CSV는 프로토타입 단계의 대용이며, PDF·glTF는 미구현.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 5. inferred 경고와 워터마크\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nPRD 핵심 기능 5번의 UI 구현. **3단계로 중첩**해서 놓친 사람이 없게 한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 단계 | 위치 | 표시 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 1 | 철근 행 이름 옆 | crimson 경고 삼각형 + 툴팁에 기여한 항목명 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 2 | 出典 칩 | 테두리·글자가 `--color-error`로 바뀜 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 3 | 내보낸 파일 첫 줄 | `※ 未確認の規準値を含む — 検収前の参考値` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 3 | 내보낸 파일 둘째 줄 | 기여한 inferred 항목 전체 목록 (규준명·조항 포함) |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 3 | 항목명 셀 | `⚠ ` 접두사 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n전파 규칙: 철근 행의 `rules[]` 중 하나라도 `inferred`면 그 **행 전체가 inferred**다. 행이 하나라도 inferred면 산출물 전체에 워터마크가 붙는다. 부분 워터마크는 없다 — 어느 숫자가 오염됐는지 사용자가 추적하게 만들지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 6. 출처 표시 UI\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**법적 의무다**(PDL1.0 준거, CLAUDE.md CRITICAL). 제거 대상이 아니다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n칩 하나가 규준 하나에 대응한다. 표기는 `{약칭} {조항}` — 예: `標準仕様書 5.3.4`.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 클릭 → 원문 URL 새 탭 (`e.stopPropagation()`으로 행 선택과 분리)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- hover 툴팁 4줄: `라벨 ＝ 값` / `문서명(판) 조항 쪽` / (inferred면) `⚠ 未確認 —` / 주석\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 10px mono, 4px radius, 1px 테두리\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n출처 데이터 구조:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```js\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nKJ_SOURCES.spec = { short:'標準仕様書', doc:'公共建築工事標準仕様書（建築工事編）',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_8\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Write-Output '===== docs/DESIGN.md 191-281 ====='; Get-Content -Encoding UTF8 docs/DESIGN.md | Select-Object -Skip 190; Get-ChildItem design/kijun-design-system/tokens/*.css | Sort-Object Name | ForEach-Object { Write-Output \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"===== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'$($_.FullName) =====\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"; Get-Content -Raw -Encoding UTF8 $_.FullName }; Write-Output '\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'===== styles.css ====='; Get-Content -Raw -Encoding UTF8 design/kijun-design-system/styles.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"in_progress\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_8\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Write-Output '===== docs/DESIGN.md 191-281 ====='; Get-Content -Encoding UTF8 docs/DESIGN.md | Select-Object -Skip 190; Get-ChildItem design/kijun-design-system/tokens/*.css | Sort-Object Name | ForEach-Object { Write-Output \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"===== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'$($_.FullName) =====\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"; Get-Content -Raw -Encoding UTF8 $_.FullName }; Write-Output '\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"'===== styles.css ====='; Get-Content -Raw -Encoding UTF8 design/kijun-design-system/styles.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"===== docs/DESIGN.md 191-281 =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n                    ed:'令和4年版', pub:'国土交通省 大臣官房官庁営繕部', url:'…' }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nKJ_RULES['lap.L1'] = { label:'重ね継手長さ L1（フックなし）', expr:'40d',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n                       src:'spec', sec:'5.3.4 表5.3.2', page:'5-12',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n                       confidence:'…', note:'SD345 / Fc 21–27 N/mm²。' }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n룰팩 YAML로 옮길 때 이 필드 집합을 그대로 유지한다. UI가 `doc`·`ed`·`sec`·`page`·`url`을 전부 쓴다 — 하나라도 빠지면 툴팁이 비고 고지 의무를 못 채운다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 7. 3D 뷰어\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 좌표계: **mm**, `X` = 평면 x, `Y` = 높이, `Z` = 평면 y. 씬에는 `×0.001`로 스케일해서 넣는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **선택된 부재 1개의 배근만** 렌더한다. 골조 전체를 그리지 않는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 부재 외형은 `EdgesGeometry` 와이어프레임(`#4a483c`)으로만 암시. 콘크리트 솔리드는 없다 — 철근이 주인공.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 철근은 꺾인점 사이를 8각 실린더로 잇는다. 帯筋/あばら筋은 `closed:true`로 폐합.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 재질 `#b8b3a6` (roughness .5 / metalness .35), 강조 시 `#f54e00`.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 카메라: fov 38, 방향 `(0.72, 0.34, 0.86)` 정규화, 바운딩박스 8꼭짓점을 투영해 여유 1.08로 자동 프레이밍. OrbitControls damping 0.08.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**의도적 예외 2건** (디자인 시스템 규칙 위반이지만 유지):\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n1. 캔버스 배경이 다크 `#1b1a14`. DS는 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"한 페이지에 배경색 2개(크림·화이트)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"를 규정하지만, 회색 철근을 크림 위에 놓으면 대비가 죽는다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n2. 철근 반경을 `max(径, 14) × 1.6`으로 과장했다. **실경 축척이 아니다.** D10이 실제 비율대로면 화면에서 사라진다. 치수 판독용이 아님을 UI에 명시할 것.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 8. i18n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`ja`(기본) / `ko` 두 로케일. 헤더 우측 토글로 즉시 전환.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**도메인 용어는 번역하지 않는다** (ADR-008). `ko` 로케일에서도 `柱`·`大梁`·`主筋`·`帯筋`·`あばら筋`는 일본어 원어 그대로다. 번역 대상은 UI 레이블(`길이`, `본수`, `설계수량`)뿐이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n한국 실무자 UX 리뷰(M5)가 이 로케일 위에서 이뤄진다. PRD의 검증 분리 — 한국 실무자는 UX만, 숫자는 골든테스트 — 를 UI가 흐리지 않아야 한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 9. 디자인 시스템 자체의 불일치\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`design/kijun-design-system/readme.md`를 그대로 믿으면 안 되는 지점들. 원문은 손대지 않고 반입했다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 불일치 | 내용 | 판단 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **브랜드 서사가 다른 제품** | readme는 Kijun을 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"저장소 전체를 읽는 에디터\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라는 개발자도구로 설명한다. 마케팅 사이트·가격표·블로그·에이전트 타임라인이 컴포넌트 인벤토리에 있다. 실제 Kijun(基準)은 배근·물량 산출 도구다 | **토큰은 그대로 쓴다.** 브랜드 카피·CONTENT FUNDAMENTALS·타임라인 파스텔 5색은 대상 제품이 달라 적용 대상 아님 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **Index의 절반이 존재하지 않음** | readme가 `components/`, `guidelines/`, `ui_kits/`, `templates/`, `assets/`, `SKILL.md`를 나열하지만 반입한 프로젝트에는 토큰·`styles.css`·`_ds_bundle.js`뿐 | 컴포넌트 구현은 `_ds_bundle.js` 안에만 있음(16종). 소스 JSX 없음 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **hover 정책 모순** | readme: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"hover는 소스 브랜드에 정의돼 있지 않으며 여기서 발명하지 않는다 — press와 focus만\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | 프로토타입은 hover가 **핵심 상호작용**이다(행↔3D 강조, 출처 툴팁). 제품 쪽이 옳다. DS 문서를 갱신할 것 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **폰트가 대체품** | KijunGothic 라이선스 미보유 → Inter로 대체 | 실무상 문제 없음. 단 CJK 글리프는 Inter에 없어 시스템 폰트로 폴백된다 — 일본어 UI에서 자간·리듬이 readme 설계와 달라짐 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 10. 반입물이 프로젝트 규칙과 충돌하는 지점\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n프로토타입 소스(`app/*.js`, `app/*.jsx`)는 **저장소에 반입하지 않았다.** TDD 가드 훅이 차단했고, 아래를 보면 그 판단이 맞다. 프로토타입은 화면 사양의 근거일 뿐 구현 출발점이 아니다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| # | 항목 | 위치 | 충돌 | 조치 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|---|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 1 | **규준 수치가 코드에 이중 선언** | `engine.js` — `V={coverC:40, coverB:40, L1:40, L2:35, h90:8, h135:6}` | **ADR-002 CRITICAL.** 룰팩은 `expr:'40d'` 문자열을 표시용으로만 갖고, 계산은 별도 JS 상수가 한다. 표시값과 계산값이 갈릴 수 있는 구조 | 룰팩 YAML을 유일 출처로. 조회 함수가 숫자를 반환하고 UI·엔진이 같은 값을 본다 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 2 | **할증률이 무조건 1.04** | `engine.js` — `reqKg = designKg * V.markup` | **ADR-014.** 부재 구분을 인자로 받아야 하고, 범위 밖이면 기본값 4%를 주지 말고 실패해야 함 | `markup(memberClass)` 시그니처. 흙막이벽·말뚝 3%는 MVP 범위 밖이지만 시그니처는 지금 정한다 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 3 | **`confidence: 'verified'`** | `rulepack.js` — 8개 중 6개 | CLAUDE.md의 어휘는 `stated` / `inferred`다. 게다가 파일 헤더가 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"デモ用のプレースホルダであり、原文抽出の結果ではない\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"라고 스스로 밝힌다 → `verified`는 **이중으로 틀렸다** (ADR-015, R6) | 어휘를 `stated`/`inferred`로 교정. M0 전에는 전부 `inferred` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 4 | **출처 없는 산출 규칙** | `engine.js` — `r10 = 10mm 올림` | 모든 길이에 적용되는데 근거 문서가 없다 | 수량적산기준에서 근거를 찾아 룰팩 항목화하거나, 없으면 `inferred`로 명시 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 5 | **상부 大梁せい 상수** | `engine.js` — `beamDepthAbove: 750` | 帯筋 본수 `⌈(階高 − 750) ÷ 피치⌉ + 1`에 직접 들어간다. 부재별 사실을 전역 상수로 굳힘 | 단면일람에서 해당 층 大梁 せい를 조회 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 6 | **CDN 의존** | `index.html` — React·Babel·three.js(unpkg), Google Fonts | 도면 데이터가 실려 나가진 않으므로 CRITICAL 위반은 아니다. 다만 외부 요청이 5건 생기고 오프라인에서 죽는다 | Next.js 번들 + `next/font` 셀프호스팅 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 7 | **철근 1개당 Mesh 1개** | `Viewer3D.jsx` | **R4** — 층당 1만 개 규모에서 `InstancedMesh` 필수. 현재는 선택 부재 1개만 그려서 문제가 드러나지 않음 | 다부재 표시로 확장하는 시점에 반드시 교체 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| 8 | **골조가 하드코딩** | `engine.js` — `SECTIONS`·`STORIES`·`LEVELS` (3×3 그리드 6000, 2층) | 프로토타입으로는 정당. 다만 M1 입력 UI가 대체해야 할 대상이 정확히 이것 | 평면 편집 + 단면일람 입력으로 대체 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**1·2·3번은 구현 전에 반드시 해소한다.** 프로토타입 로직을 그대로 옮기면 세 개의 CRITICAL 규칙을 한 번에 깬다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 11. 마일스톤 매핑\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| | 프로토타입이 이미 보여준 것 | 남은 것 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n|---|---|---|\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **M1** 워킹 스켈레톤 | 입력→철근→물량→3D→내보내기 관통 경로 전체 | 입력이 하드코딩 → 평면 편집·단면일람 입력 UI |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **M2** 룰팩 정식화 | 룰팩 데이터 구조, 출처 칩, inferred 경고 UX | YAML 이관, §10-1·2·3 해소, 골든테스트 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **M3** 大梁 | 정착(직선/절곡 분기), あばら筋 본수 | カットオフ, 継手位置, 피치 변화 구간 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **M4** 확장 | 2층 3×3 다스팬, CSV | exceljs `.xlsx`, PDF, glTF, `InstancedMesh` |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n| **M5** UX 리뷰 | `ko` 로케일 | 실무자 피드백 반영 |\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n---\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 부록: 프로토타입 소재\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**프로토타입 소스는 저장소에 없다.** 화면 사양은 이 문서로 전부 옮겼고, 소스를 옆에 두면 §10-1·2·3을 그대로 베낄 위험이 실질적이라 반입하지 않았다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n동작을 눈으로 봐야 하면 원격 디자인 프로젝트에서 연다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nhttps://claude.ai/design/p/5b8804ed-775d-4ad9-a490-d36698c90f32\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n로드 순서만 여기 남긴다 — 의존 구조 자체가 사양이기 때문이다. 토큰 CSS 7개 → `_ds_bundle.js` → `rulepack` → `i18n` → `engine` → 컴포넌트 4개. **룰팩이 엔진보다 먼저 와야 한다**는 제약이 여기서 드러나고, 이건 제품에서도 유지된다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\base.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* Base document defaults. */\\\\\\\\\\\\\\\\nhtml{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}\\\\\\\\\\\\\\\\nbody{margin:0;background:var(--color-canvas);color:var(--text-body);font-family:var(--font-sans);font-size:var(--type-body-md-size);line-height:1.5;text-wrap:pretty}\\\\\\\\\\\\\\\\nh1,h2,h3,h4{color:var(--text-ink);font-weight:400;margin:0}\\\\\\\\\\\\\\\\nh1{font-size:var(--type-display-mega-size);line-height:1.1;letter-spacing:-2.16px}\\\\\\\\\\\\\\\\nh2{font-size:var(--type-display-lg-size);line-height:1.2;letter-spacing:-.72px}\\\\\\\\\\\\\\\\nh3{font-size:var(--type-display-md-size);line-height:1.25;letter-spacing:-.325px}\\\\\\\\\\\\\\\\nh4{font-size:var(--type-display-sm-size);line-height:1.3;letter-spacing:-.11px}\\\\\\\\\\\\\\\\np{margin:0}\\\\\\\\\\\\\\\\ncode,pre,kbd{font-family:var(--font-mono);font-size:var(--type-code-size)}\\\\\\\\\\\\\\\\na{color:var(--text-ink);text-decoration:none;border-bottom:1px solid var(--hairline-strong);transition:color .15s ease,border-color .15s ease}\\\\\\\\\\\\\\\\na:hover{color:var(--color-primary);border-bottom-color:var(--color-primary)}\\\\\\\\\\\\\\\\n::selection{background:var(--kj-peach);color:var(--text-ink)}\\\\\\\\\\\\\\\\n*:focus-visible{outline:none;box-shadow:var(--focus-ring)}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\colors.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* Kijun colors — base palette, then semantic aliases. Never inline hex in components. */\\\\\\\\\\\\\\\\n:root{\\\\\\\\\\\\\\\\n/* ---- base palette ---- */\\\\\\\\\\\\\\\\n--kj-orange:#f54e00;\\\\\\\\\\\\\\\\n--kj-orange-active:#d04200;\\\\\\\\\\\\\\\\n--kj-cream-50:#fafaf7;\\\\\\\\\\\\\\\\n--kj-cream-100:#f7f7f4;\\\\\\\\\\\\\\\\n--kj-white:#ffffff;\\\\\\\\\\\\\\\\n--kj-warm-200:#efeee8;\\\\\\\\\\\\\\\\n--kj-warm-300:#e6e5e0;\\\\\\\\\\\\\\\\n--kj-warm-400:#cfcdc4;\\\\\\\\\\\\\\\\n--kj-warm-500:#a09c92;\\\\\\\\\\\\\\\\n--kj-warm-600:#807d72;\\\\\\\\\\\\\\\\n--kj-warm-700:#5a5852;\\\\\\\\\\\\\\\\n--kj-warm-900:#26251e;\\\\\\\\\\\\\\\\n--kj-peach:#dfa88f;\\\\\\\\\\\\\\\\n--kj-mint:#9fc9a2;\\\\\\\\\\\\\\\\n--kj-sky:#9fbbe0;\\\\\\\\\\\\\\\\n--kj-lavender:#c0a8dd;\\\\\\\\\\\\\\\\n--kj-gold:#c08532;\\\\\\\\\\\\\\\\n--kj-green:#1f8a65;\\\\\\\\\\\\\\\\n--kj-crimson:#cf2d56;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/* ---- brand action (the only brand voltage — use scarcely) ---- */\\\\\\\\\\\\\\\\n--color-primary:var(--kj-orange);\\\\\\\\\\\\\\\\n--color-primary-active:var(--kj-orange-active);\\\\\\\\\\\\\\\\n--color-on-primary:var(--kj-white);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/* ---- surfaces ---- */\\\\\\\\\\\\\\\\n--color-canvas:var(--kj-cream-100);\\\\\\\\\\\\\\\\n--color-canvas-soft:var(--kj-cream-50);\\\\\\\\\\\\\\\\n--surface-card:var(--kj-white);\\\\\\\\\\\\\\\\n--surface-strong:var(--kj-warm-300);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/* ---- hairlines (the only depth system) ---- */\\\\\\\\\\\\\\\\n--hairline:var(--kj-warm-300);\\\\\\\\\\\\\\\\n--hairline-soft:var(--kj-warm-200);\\\\\\\\\\\\\\\\n--hairline-strong:var(--kj-warm-400);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/* ---- text ---- */\\\\\\\\\\\\\\\\n--text-ink:var(--kj-warm-900);\\\\\\\\\\\\\\\\n--text-body:var(--kj-warm-700);\\\\\\\\\\\\\\\\n--text-body-strong:var(--kj-warm-900);\\\\\\\\\\\\\\\\n--text-muted:var(--kj-warm-600);\\\\\\\\\\\\\\\\n--text-muted-soft:var(--kj-warm-500);\\\\\\\\\\\\\\\\n--text-on-primary:var(--kj-white);\\\\\\\\\\\\\\\\n--text-on-ink:var(--kj-cream-100);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/* ---- agent timeline pastels — in-product agent visualizations ONLY ---- */\\\\\\\\\\\\\\\\n--timeline-thinking:var(--kj-peach);\\\\\\\\\\\\\\\\n--timeline-grep:var(--kj-mint);\\\\\\\\\\\\\\\\n--timeline-read:var(--kj-sky);\\\\\\\\\\\\\\\\n--timeline-edit:var(--kj-lavender);\\\\\\\\\\\\\\\\n--timeline-done:var(--kj-gold);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n/* ---- semantic status ---- */\\\\\\\\\\\\\\\\n--color-success:var(--kj-green);\\\\\\\\\\\\\\\\n--color-error:var(--kj-crimson);\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\elevation.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* Hairline-only depth. There are no drop shadows in Kijun — these tokens exist so that\\\\\\\\\\\\\\\\n   \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"elevation\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" always resolves to a border, never a shadow. */\\\\\\\\\\\\\\\\n:root{\\\\\\\\\\\\\\\\n--elevation-flat:none;\\\\\\\\\\\\\\\\n--elevation-card:none;\\\\\\\\\\\\\\\\n--shadow-none:none;\\\\\\\\\\\\\\\\n--border-hairline:1px solid var(--hairline);\\\\\\\\\\\\\\\\n--border-hairline-soft:1px solid var(--hairline-soft);\\\\\\\\\\\\\\\\n--border-hairline-strong:1px solid var(--hairline-strong);\\\\\\\\\\\\\\\\n--focus-ring:0 0 0 2px var(--color-canvas),0 0 0 4px var(--kj-warm-400);\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\fonts.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* Kijun type stack.\\\\\\\\\\\\\\\\n   KijunGothic is a licensed display+text face and is NOT distributed with this system.\\\\\\\\\\\\\\\\n   Documented open-source substitute: Inter (weight 400 for display, -1.5% tracking).\\\\\\\\\\\\\\\\n   Code surfaces: JetBrains Mono.\\\\\\\\\\\\\\\\n   Both substitutes are loaded from Google Fonts — swap this file for self-hosted\\\\\\\\\\\\\\\\n   @font-face rules once the licensed binaries are available. */\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\radius.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* Compact developer dialect: 8px CTAs, 12px cards. */\\\\\\\\\\\\\\\\n:root{\\\\\\\\\\\\\\\\n--radius-none:0px;\\\\\\\\\\\\\\\\n--radius-xs:4px;\\\\\\\\\\\\\\\\n--radius-sm:6px;\\\\\\\\\\\\\\\\n--radius-md:8px;\\\\\\\\\\\\\\\\n--radius-lg:12px;\\\\\\\\\\\\\\\\n--radius-xl:16px;\\\\\\\\\\\\\\\\n--radius-pill:9999px;\\\\\\\\\\\\\\\\n--radius-full:9999px;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\spacing.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* 4px base unit. 80px section rhythm. */\\\\\\\\\\\\\\\\n:root{\\\\\\\\\\\\\\\\n--space-xxs:4px;\\\\\\\\\\\\\\\\n--space-xs:8px;\\\\\\\\\\\\\\\\n--space-sm:12px;\\\\\\\\\\\\\\\\n--space-base:16px;\\\\\\\\\\\\\\\\n--space-md:20px;\\\\\\\\\\\\\\\\n--space-lg:24px;\\\\\\\\\\\\\\\\n--space-xl:32px;\\\\\\\\\\\\\\\\n--space-xxl:48px;\\\\\\\\\\\\\\\\n--space-section:80px;\\\\\\\\\\\\\\\\n--space-cta-band:96px;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n--container-max:1200px;\\\\\\\\\\\\\\\\n--nav-height:64px;\\\\\\\\\\\\\\\\n--grid-gap:24px;\\\\\\\\\\\\\\\\n--card-gap:16px;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\kijun-design-system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\tokens\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\typography.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n/* Kijun typography. Display stays at weight 400 — never bold. Negative tracking on display only. */\\\\\\\\\\\\\\\\n:root{\\\\\\\\\\\\\\\\n--font-sans:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Inter\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"KijunGothic\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",system-ui,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Helvetica Neue\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",Helvetica,Arial,sans-serif;\\\\\\\\\\\\\\\\n--font-mono:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"JetBrains Mono\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n--type-display-mega-size:72px;--type-display-mega-weight:400;--type-display-mega-lh:1.1;--type-display-mega-ls:-2.16px;\\\\\\\\\\\\\\\\n--type-display-lg-size:36px;--type-display-lg-weight:400;--type-display-lg-lh:1.2;--type-display-lg-ls:-0.72px;\\\\\\\\\\\\\\\\n--type-display-md-size:26px;--type-display-md-weight:400;--type-display-md-lh:1.25;--type-display-md-ls:-0.325px;\\\\\\\\\\\\\\\\n--type-display-sm-size:22px;--type-display-sm-weight:400;--type-display-sm-lh:1.3;--type-display-sm-ls:-0.11px;\\\\\\\\\\\\\\\\n--type-title-md-size:18px;--type-title-md-weight:600;--type-title-md-lh:1.4;--type-title-md-ls:0;\\\\\\\\\\\\\\\\n--type-title-sm-size:16px;--type-title-sm-weight:600;--type-title-sm-lh:1.4;--type-title-sm-ls:0;\\\\\\\\\\\\\\\\n--type-body-md-size:16px;--type-body-md-weight:400;--type-body-md-lh:1.5;--type-body-md-ls:0;\\\\\\\\\\\\\\\\n--type-body-tracked-size:16px;--type-body-tracked-weight:400;--type-body-tracked-lh:1.5;--type-body-tracked-ls:0.08px;\\\\\\\\\\\\\\\\n--type-body-sm-size:14px;--type-body-sm-weight:400;--type-body-sm-lh:1.5;--type-body-sm-ls:0;\\\\\\\\\\\\\\\\n--type-caption-size:13px;--type-caption-weight:400;--type-caption-lh:1.4;--type-caption-ls:0;\\\\\\\\\\\\\\\\n--type-caption-uppercase-size:11px;--type-caption-uppercase-weight:600;--type-caption-uppercase-lh:1.4;--type-caption-uppercase-ls:0.88px;\\\\\\\\\\\\\\\\n--type-code-size:13px;--type-code-weight:400;--type-code-lh:1.5;--type-code-ls:0;\\\\\\\\\\\\\\\\n--type-button-size:14px;--type-button-weight:500;--type-button-lh:1;--type-button-ls:0;\\\\\\\\\\\\\\\\n--type-nav-link-size:14px;--type-nav-link-weight:500;--type-nav-link-lh:1.4;--type-nav-link-ls:0;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n.t-display-mega{font-family:var(--font-sans);font-size:var(--type-display-mega-size);font-weight:400;line-height:var(--type-display-mega-lh);letter-spacing:var(--type-display-mega-ls)}\\\\\\\\\\\\\\\\n.t-display-lg{font-family:var(--font-sans);font-size:var(--type-display-lg-size);font-weight:400;line-height:var(--type-display-lg-lh);letter-spacing:var(--type-display-lg-ls)}\\\\\\\\\\\\\\\\n.t-display-md{font-family:var(--font-sans);font-size:var(--type-display-md-size);font-weight:400;line-height:var(--type-display-md-lh);letter-spacing:var(--type-display-md-ls)}\\\\\\\\\\\\\\\\n.t-display-sm{font-family:var(--font-sans);font-size:var(--type-display-sm-size);font-weight:400;line-height:var(--type-display-sm-lh);letter-spacing:var(--type-display-sm-ls)}\\\\\\\\\\\\\\\\n.t-title-md{font-family:var(--font-sans);font-size:var(--type-title-md-size);font-weight:600;line-height:1.4}\\\\\\\\\\\\\\\\n.t-title-sm{font-family:var(--font-sans);font-size:var(--type-title-sm-size);font-weight:600;line-height:1.4}\\\\\\\\\\\\\\\\n.t-body-md{font-family:var(--font-sans);font-size:var(--type-body-md-size);font-weight:400;line-height:1.5}\\\\\\\\\\\\\\\\n.t-body-tracked{font-family:var(--font-sans);font-size:16px;font-weight:400;line-height:1.5;letter-spacing:.08px}\\\\\\\\\\\\\\\\n.t-body-sm{font-family:var(--font-sans);font-size:var(--type-body-sm-size);font-weight:400;line-height:1.5}\\\\\\\\\\\\\\\\n.t-caption{font-family:var(--font-sans);font-size:var(--type-caption-size);font-weight:400;line-height:1.4}\\\\\\\\\\\\\\\\n.t-caption-uppercase{font-family:var(--font-sans);font-size:var(--type-caption-uppercase-size);font-weight:600;line-height:1.4;letter-spacing:var(--type-caption-uppercase-ls);text-transform:uppercase}\\\\\\\\\\\\\\\\n.t-code{font-family:var(--font-mono);font-size:var(--type-code-size);font-weight:400;line-height:1.5}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n===== styles.css =====\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/fonts.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/colors.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/typography.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/spacing.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/radius.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/elevation.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n@import url(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tokens/base.css\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_9\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"agent_message\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"필수 문서를 모두 대조했습니다. 핵심 제약은 설정·스타일·App Router 셸이