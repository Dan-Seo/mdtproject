\\\r\\\\n 111:   if (rebar.shape === 'hoop') {\\\\r\\\\n 112:     return Array.from({ length: rebar.count }, (_, index) => [\\\\r\\\\n 113:       0,\\\\r\\\\n 114:       index * section.hoop.pitch,\\\\r\\\\n 115:       0,\\\\r\\\\n 116:     ])\\\\r\\\\n 117:   }\\\\r\\\\n 118: \\\\r\\\\n 119:   // 主筋: 帯筋 안쪽 사각형 둘레를 등간격으로 돈다. 대표 배근이 시작 모서리다.\\\\r\\\\n 120:   const [insetX, , insetZ] = rebar.points[0]\\\\r\\\\n 121:   const inward =\\\\r\\\\n 122:     2 * rebarRadius(section.hoop.size) + rebarRadius(rebar.size)\\\\r\\\\n 123:   const width = Math.max(0, section.b - 2 * (insetX + inward))\\\\r\\\\n 124:   const depth = Math.max(0, section.d - 2 * (insetZ + inward))\\\\r\\\\n 125:   const perimeter = 2 * (width + depth)\\\\r\\\\n 126: \\\\r\\\\n 127:   return Array.from({ length: rebar.count }, (_, index): Point3 => {\\\\r\\\\n 128:     const walked = (index * perimeter) / rebar.count\\\\r\\\\n 129: \\\\r\\\\n 130:     if (walked <= width) return [inward + walked, 0, inward]\\\\r\\\\n 131:     if (walked <= width + depth) {\\\\r\\\\n 132:       return [inward + width, 0, inward + walked - width]\\\\r\\\\n 133:     }\\\\r\\\\n 134:     if (walked <= 2 * width + depth) {\\\\r\\\\n 135:       return [inward + width - (walked - width - depth), 0, inward + depth]\\\\r\\\\n 136:     }\\\\r\\\\n 137:     return [inward, 0, inward + depth - (walked - 2 * width - depth)]\\\\r\\\\n 138:   })\\\\r\\\\n 139: }\\\\r\\\\n 140: \\\\r\\\\n 141: function girderMainPlacements(\\\\r\\\\n 142:   rebar: Rebar,\\\\r\\\\n 143:   section: GirderSection,\\\\r\\\\n 144: ): Point3[] {\\\\r\\\\n 145:   if (rebar.role !== '上端筋' && rebar.role !== '下端筋') {\\\\r\\\\n 146:     throw new Error(`Unsupported 大梁 main role: ${rebar.role}`)\\\\r\\\\n 147:   }\\\\r\\\\n 148: \\\\r\\\\n 149:   const [, , insetZ] = rebar.points[0]\\\\r\\\\n 150:   const inward =\\\\r\\\\n 151:     2 * rebarRadius(section.stirrup.size) + rebarRadius(rebar.size)\\\\r\\\\n 152:   const width = Math.max(0, section.b - 2 * (insetZ + inward))\\\\r\\\\n 153:   const y = rebar.role === '上端筋' ? -inward : inward\\\\r\\\\n 154: \\\\r\\\\n 155:   return Array.from({ length: rebar.count }, (_, index): Point3 => {\\\\r\\\\n 156:     const z =\\\\r\\\\n 157:       rebar.count === 1\\\\r\\\\n 158:         ? inward + width / 2\\\\r\\\\n 159:         : inward + (index * width) / (rebar.count - 1)\\\\r\\\\n 160: \\\\r\\\\n 161:     return [0, y, z]\\\\r\\\\n 162:   })\\\\r\\\\n 163: }\\\\r\\\\n 164: \\\\r\\\\n 165: function girderStirrupPlacements(\\\\r\\\\n 166:   rebar: Rebar,\\\\r\\\\n 167:   section: GirderSection,\\\\r\\\\n 168: ): Point3[] {\\\\r\\\\n 169:   if (rebar.placement?.axis !== 'x') {\\\\r\\\\n 170:     throw new Error(`あばら筋 x-axis placement is missing: ${rebar.id}`)\\\\r\\\\n 171:   }\\\\r\\\\n 172: \\\\r\\\\n 173:   const positions = stirrupPositions(\\\\r\\\\n 174:     rebar.placement.clearMm,\\\\r\\\\n 175:     section.stirrup.pitch,\\\\r\\\\n 176:     section.stirrup.startOffsetMm,\\\\r\\\\n 177:   ).positionsMm\\\\r\\\\n 178: \\\\r\\\\n 179:   if (positions.length !== rebar.count) {\\\\r\\\\n 180:     throw new Error(\\\\r\\\\n 181:       `あばら筋 placement count mismatch: ${positions.length} !== ${rebar.count}`,\\\\r\\\\n 182:     )\\\\r\\\\n 183:   }\\\\r\\\\n 184: \\\\r\\\\n 185:   return positions.map((x): Point3 => [x, 0, 0])\\\\r\\\\n 186: }\\\\r\\\\n 187: \\\\r\\\\n 188: export function rebarPlacements(rebar: Rebar, section: Section): Point3[] {\\\\r\\\\n 189:   if (section.kind === '柱') {\\\\r\\\\n 190:     return columnRebarPlacements(rebar, section)\\\\r\\\\n 191:   }\\\\r\\\\n 192:   if (rebar.role === 'あばら筋') {\\\\r\\\\n 193:     return girderStirrupPlacements(rebar, section)\\\\r\\\\n 194:   }\\\\r\\\\n 195: \\\\r\\\\n 196:   return girderMainPlacements(rebar, section)\\\\r\\\\n 197: }\\\\r\\\\n 198: \\\\r\\\\n 199: function insetCoordinate(\\\\r\\\\n 200:   value: number,\\\\r\\\\n 201:   minimum: number,\\\\r\\\\n 202:   maximum: number,\\\\r\\\\n 203:   radius: number,\\\\r\\\\n 204: ): number {\\\\r\\\\n 205:   const inset = Math.min(radius, (maximum - minimum) / 2)\\\\r\\\\n 206:   return Math.min(Math.max(value, minimum + inset), maximum - inset)\\\\r\\\\n 207: }\\\\r\\\\n 208: \\\\r\\\\n 209: // hoop 중심선을 かぶり면에서 표시 반경만큼 안쪽으로 넣는다. 평면은 부재 kind로\\\\r\\\\n 210: // 명시적으로 고른다: 柱는 X–Z, 大梁은 Y–Z. 좌표 변화로 평면을 추론하지 않는다.\\\\r\\\\n 211: function hoopDisplayPoint(\\\\r\\\\n 212:   point: Point3,\\\\r\\\\n 213:   framePoints: Point3[],\\\\r\\\\n 214:   radius: number,\\\\r\\\\n 215:   section: Section,\\\\r\\\\n 216: ): Point3 {\\\\r\\\\n 217:   if (section.kind === '柱') {\\\\r\\\\n 218:     const xs = framePoints.map((candidate) => candidate[0])\\\\r\\\\n 219:     const zs = framePoints.map((candidate) => candidate[2])\\\\r\\\\n 220:     const minX = Math.min(...xs)\\\\r\\\\n 221:     const maxX = Math.max(...xs)\\\\r\\\\n 222:     const minZ = Math.min(...zs)\\\\r\\\\n 223:     const maxZ = Math.max(...zs)\\\\r\\\\n 224: \\\\r\\\\n 225:     return [\\\\r\\\\n 226:       insetCoordinate(point[0], minX, maxX, radius),\\\\r\\\\n 227:       point[1],\\\\r\\\\n 228:       insetCoordinate(point[2], minZ, maxZ, radius),\\\\r\\\\n 229:     ]\\\\r\\\\n 230:   }\\\\r\\\\n 130:   main: { size: 'D25', topCount: 4, bottomCount: 3 },\\\\r\\\\n 131:   stirrup: { size: 'D13', pitch: 200, startOffsetMm: 50 },\\\\r\\\\n 132: }\\\\r\\\\n 133: \\\\r\\\\n 134: const girderTop: Rebar = {\\\\r\\\\n 135:   id: '1F-G1|top',\\\\r\\\\n 136:   memberId: '1F-G1',\\\\r\\\\n 137:   role: '上端筋',\\\\r\\\\n 138:   size: 'D25',\\\\r\\\\n 139:   shape: 'straight',\\\\r\\\\n 140:   points: [\\\\r\\\\n 141:     [-500, 700, 50],\\\\r\\\\n 142:     [5700, 700, 50],\\\\r\\\\n 143:   ],\\\\r\\\\n 144:   closed: false,\\\\r\\\\n 145:   length: 6200,\\\\r\\\\n 146:   count: girderSection.main.topCount,\\\\r\\\\n 147:   ruleHits: [],\\\\r\\\\n 148:   formula: 'test',\\\\r\\\\n 149: }\\\\r\\\\n 150: \\\\r\\\\n 151: const girderBottom: Rebar = {\\\\r\\\\n 152:   ...girderTop,\\\\r\\\\n 153