ntentRect: {\\\\r\\\\n 140:             bottom: 360,\\\\r\\\\n   1: import { describe, expect, it } from 'vitest'\\\\r\\\\n   2: \\\\r\\\\n   3: import type { ColumnSection, GirderSection, Member } from '../model/member'\\\\r\\\\n   4: import type { GirderSpan } from '../model/project'\\\\r\\\\n   5: import type { Rebar } from '../model/rebar'\\\\r\\\\n   6: import { MemberUnsupportedError } from '../model/unsupported'\\\\r\\\\n   7: import { coverConditions, lookupRule } from '../rules/lookup'\\\\r\\\\n   8: import { jpMlitRulePack } from '../../rulepack'\\\\r\\\\n   9: import { resolveGirderEnd } from './girder-ends'\\\\r\\\\n  10: import {\\\\r\\\\n  11:   generateGirderRebar,\\\\r\\\\n  12:   type GirderRebarInput,\\\\r\\\\n  13: } from './girder'\\\\r\\\\n  14: import { stirrupPositions } from './stirrup-layout'\\\\r\\\\n  15: \\\\r\\\\n  16: const member: Member = {\\\\r\\\\n  17:   id: '1F-G1-X1Y1-X',\\\\r\\\\n  18:   kind: '大梁',\\\\r\\\\n  19:   memberClass: '躯体',\\\\r\\\\n  20:   sectionId: 'section-G1',\\\\r\\\\n  21:   storyId: '1F',\\\\r\\\\n  22:   position: { axis: 'X', ix: 0, iy: 0 },\\\\r\\\\n  23: }\\\\r\\\\n  24: \\\\r\\\\n  25: const section: GirderSection = {\\\\r\\\\n  26:   id: 'section-G1',\\\\r\\\\n  27:   kind: '大梁',\\\\r\\\\n  28:   mark: 'G1',\\\\r\\\\n  29:   b: 400,\\\\r\\\\n  30:   depth: 750,\\\\r\\\\n  31:   fc: 24,\\\\r\\\\n  32:   grade: 'SD345',\\\\r\\\\n  33:   exposure: '屋外',\\\\r\\\\n  34:   finish: '仕上げなし',\\\\r\\\\n  35:   main: { size: 'D25', topCount: 4, bottomCount: 4 },\\\\r\\\\n  36:   stirrup: { size: 'D13', pitch: 100, startOffsetMm: 50 },\\\\r\\\\n  37: }\\\\r\\\\n  38: \\\\r\\\\n  39: const supportColumnSection: ColumnSection = {\\\\r\\\\n  40:   id: 'section-C1',\\\\r\\\\n  41:   kind: '柱',\\\\r\\\\n  42:   mark: 'C1',\\\\r\\\\n  43:   b: 800,\\\\r\\\\n  44:   d: 800,\\\\r\\\\n  45:   fc: 24,\\\\r\\\\n  46:   grade: 'SD345',\\\\r\\\\n  47:   exposure: '屋外',\\\\r\\\\n  48:   finish: '仕上げなし',\\\\r\\\\n  49:   main: { size: 'D25', count: 12 },\\\\r\\\\n  50:   hoop: { size: 'D13', pitch: 100 },\\\\r\\\\n  51: }\\\\r\\\\n  52: \\\\r\\\\n  53: const supportCover = coverConditions(supportColumnSection)\\\\r\\\\n  54: \\\\r\\\\n  55: const span: GirderSpan = {\\\\r\\\\n  56:   axis: 'X',\\\\r\\\\n  57:   centerSpan: 6000,\\\\r\\\\n  58:   clear: 5200,\\\\r\\\\n  59:   startFaceOffsetMm: 400,\\\\r\\\\n  60:   endFaceOffsetMm: 400,\\\\r\\\\n  61:   startSupportLengthAlongAxisMm: 800,\\\\r\\\\n  62:   endSupportLengthAlongAxisMm: 800,\\\\r\\\\n  63:   startSupportCover: supportCover,\\\\r\\\\n  64:   endSupportCover: supportCover,\\\\r\\\\n  65: }\\\\r\\\\n  66: \\\\r\\\\n  67: function input(\\\\r\\\\n  68:   overrides: Partial<GirderRebarInput> = {},\\\\r\\\\n  69: ): GirderRebarInput {\\\\r\\\\n  70:   return { member, section, span, ...overrides }\\\\r\\\\n  71: }\\\\r\\\\n  72: \\\\r\\\\n  73: function byRole(\\\\r\\\\n  74:   generated: ReturnType<typeof generateGirderRebar>,\\\\r\\\\n  75:   role: '上端筋' | '下端筋' | 'あばら筋',\\\\r\\\\n  76: ) {\\\\r\\\\n  77:   const rebar = generated.find((candidate) => candidate.role === role)\\\\r\\\\n  78:   expect(rebar, `${role} should be generated`).toBeDefined()\\\\r\\\\n  79:   return rebar!\\\\r\\\\n  80: }\\\\r\\\\n  81: \\\\r\\\\n  82: function polylineLength(points: Rebar['points'], closed: boolean): number {\\\\r\\\\n  83:   const pairs = points.slice(1).map((point, index) => [points[index], point])\\\\r\\\\n  84:   if (closed) pairs.push([points.at(-1)!, points[0]])\\\\r\\\\n  85: \\\\r\\\\n  86:   return pairs.reduce((total, [from, to]) => {\\\\r\\\\n  87:     const [dx, dy, dz] = to.map((value, index) => value - from[index])\\\\r\\\\n  88:     return total + Math.hypot(dx, dy, dz)\\\\r\\\\n  89:   }, 0)\\\\r\\\\n  90: }\\\\r\\\\n  91: \\\\r\\\\n  92: const coverRule = lookupRule(\\\\r\\\\n  93:   jpMlitRulePack,\\\\r\\\\n  94:   'cover.minimum',\\\\r\\\\n  95:   coverConditions(section),\\\\r\\\\n  96: )\\\\r\\\\n  97: const fabricationAdditionRule = lookupRule(\\\\r\\\\n  98:   jpMlitRulePack,\\\\r\\\\n  99:   'cover.fabrication.addition',\\\\r\\\\n 100:   {},\\\\r\\\\n 101: )\\\\r\\\\n 102: const fabricationCover = coverRule.value + fabricationAdditionRule.value\\\\r\\\\n 103: \\\\r\\\\n 104: describe('generateGirderRebar', () => {\\\\r\\\\n 105:   it('generates [上端筋, 下端筋, あばら筋] as representative rows', () => {\\\\r\\\\n 106:     const expectedStirrups = stirrupPositions(\\\\r\\\\n 107:       span.clear,\\\\r\\\\n 108:       section.stirrup.pitch,\\\\r\\\\n 109:       section.stirrup.startOffsetMm,\\\\r\\\\n 110:     )\\\\r\\\\n 111:     const generated = generateGirderRebar(input(), jpMlitRulePack)\\\\r\\\\n 112: \\\\r\\\\n 113:     expect(generated.map(({ role }) => role)).toEqual([\\\\r\\\\n 114:       '上端筋',\\\\r\\\\n 115:       '下端筋',\\\\r\\\\n 116:       'あばら筋',\\\\r\\\\n 117:     ])\\\\r\\\\n 118:     expect(byRole(generated, '上端筋')).toMatchObject({\\\\r\\\\n 119:       shape: 'hook90',\\\\r\\\\n 120:       closed: false,\\\\r\\\\n 121:       count: 4,\\\\r\\\\n 122:     })\\\\r\\\\n 123:     expect(byRole(generated, '下端筋')).toMatchObject({\\\\r\\\\n 124:       shape: 'hook90',\\\\r\\\\n 125:       closed: false,\\\\r\\\\n 126:       count: 4,\\\\r\\\\n 127:     })\\\\r\\\\n 128:     expect(byRole(generated, 'あばら筋')).toMatchObject({\\\\r\\\\n 129:       shape: 'hoop',\\\\r\\\\n 130:       closed: true,\\\\r\\\\n 131:       count: expectedStirrups.positionsMm.length,\\\\r\\\\n 132:       placement: { axis: 'x', clearMm: span.clear },\\\\r\\\\n 133:     })\\\\r\\\\n 134:   })\\\\r\\\\n 135: \\\\r\\\\n 136:   it('adds both 折曲げ定着 lengths to the sample G1 上端筋 without rounding', () => {\\\\r\\\\n 137:     const endInput = {\\\\r\\\\n 138:       barSize: section.main.size,\\\\r\\\\n 139:       supportCover,\\\\r\\\\n 140:       fc: section.fc,\\\\r\\\\n 141:       grade: section.grade,\\\\r\\\\n 142:       bendDirection: '下' as const,\\\\r\\\\n 143:     }\\\\r\\\\n 144:     const start = resolveGirderEnd(\\\\r\\\\n 145:       {\\\\r\\\\n 146:         ...endInput,\\\\r\\\\n 147:         supportLengthMm: span.startSupportLengthAlongAxisMm,\\\\r\\\\n 148:       },\\\\r\\\\n 149:       jpMlitRulePack,\\\\r\\\\n 150:     )\\\\r\\\\n 151:     const end = resolveGirderEnd(\\\\r\\\\n 152:       {\\\\r\\\\n 153:         ...endInput,\\\\r\\\\n 154:         supportLengthMm: span.endSupportLengthAlongAxisMm,\\\\r\\\\n 155:       },\\\\r\\\\n 156:       jpMlitRulePack,\\\\r\\\\n 157:     )\\\\r\\\\n 158:     const top = byRole(generateGirderRebar(input(), jpMlitRulePack), '上端筋')\\\\r\\\\n 159: \\\\r\\\\n 160:     expect(start.kind).toBe('折曲げ定着')\\\\r\\\\n 161:     expect(end.kind).toBe('折曲げ定着')\\\\r\\\\n 162:     expect(top.length).toBe(span.clear + start.lengthMm + end.lengthMm)\\\\r\\\\n 163:     expect(polylineLength(top.points, top.closed)).toBe(top.length)\\\\r\\\\n 164:     expect(top.formula).not.toContain('切上げ')\\\\r\\\\n 165:   })\\\\r\\\\n 166: \\\\r\\\\n 167:   it('uses 直線定着 at both ends when virtual supports are large enough', () => {\\\\r\\\\n 168:     const largeSupportSpan: GirderSpan = {\\\\r\\\\n 169:       ...span,\\\\r\\\\n 170:       centerSpan: 6600,\\\\r\\\\n 171:       startFaceOffsetMm: 700,\\\\r\\\\n 172:       endFaceOffsetMm: 700,\\\\r\\\\n 173:       startSupportLengthAlongAxisMm: 1400,\\\\r\\\\n 174:       endSupportLengthAlongAxisMm: 1400,\\\\r\\\\n 175:     }\\\\r\\\\n 176:     const endInput = {\\\\r\\\\n 177:       supportLengthMm: 1400,\\\\r\\\\n 178:       supportCover,\\\\r\\\\n 179:       barSize: section.main.size,\\\\r\\\\n 180:       fc: section.fc,\\\\r\\\\n 181:       grade: section.grade,\\\\r\\\\n 182:       bendDirection: '下' as const,\\\\r\\\\n 183:     }\\\\r\\\\n 184:     const detail = resolveGirderEnd(endInput, jpMlitRulePack)\\\\r\\\\n 185:     const top = byRole(\\\\r\\\\n 186:       generateGirderRebar(\\\\r\\\\n 187:         input({ span: largeSupportSpan }),\\\\r\\\\n 188:         jpMlitRulePack,\\\\r\\\\n 189:       ),\\\\r\\\\n 190:       '上端筋',\\\\r\\\\n 191:     )\\\\r\\\\n 192: \\\\r\\\\n 193:     expect(detail.kind).toBe('直線定着')\\\\r\\\\n 194:     expect(top.shape).toBe('straight')\\\\r\\\\n 195:     expect(top.length).toBe(largeSupportSpan.clear + 2 * detail.lengthMm)\\\\r\\\\n 196:     expect(top.points).toEqual([\\\\r\\\\n 197:       [-detail.lengthMm, section.depth - fabricationCover, fabricationCover],\\\\r\\\\n 198:       [\\\\r\\\\n 199:         largeSupportSpan.clear + detail.lengthMm,\\\\r\\\\n 200:         section.depth - fabricationCover,\\\\r\\\\n 201:         fabricationCover,\\\\r\\\\n 202:       ],\\\\r\\\\n 203:     ])\\\\r\\\\n 204:   })\\\\r\\\\n 205: \\\\r\\\\n 206:   it('records two path-distance 定着 zones within each 主筋 加工長', () => {\\\\r\\\\n 207:     const generated = generateGirderRebar(input(), jpMlitRulePack)\\\\r\\\\n 208: \\\\r\\\\n 209:     for (const role of ['上端筋', '下端筋'] as const) {\\\\r\\\\n 210:       const main = byRole(generated, role)\\\\r\\\\n 211: \\\\r\\\\n 212:       const bendDirection: '上' | '下' = role === '上端筋' ? '下' : '上'\\\\r\\\\n 213:       const endInput = {\\\\r\\\\n 214:         barSize: section.main.size,\\\\r\\\\n 215:         supportCover,\\\\r\\\\n 216:         fc: section.fc,\\\\r\\\\n 217:         grade: section.grade,\\\\r\\\\n 218:         bendDirection,\\\\r\\\\n 219:       }\\\\r\\\\n 220:       const start = resolveGirderEnd(\\\\r\\\\n 221:         {\\\\r\\\\n 222:           ...endInput,\\\\r\\\\n 223:           supportLengthMm: span.startSupportLengthAlongAxisMm,\\\\r\\\\n 224:         },\\\\r\\\\n 225:         jpMlitRulePack,\\\\r\\\\n 226:       )\\\\r\\\\n 227:       const end = resolveGirderEnd(\\\\r\\\\n 228:         {\\\\r\\\\n 229:           ...endInput,\\\\r\\\\n 230:           supportLengthMm: span.endSupportLengthAlongAxisMm,\\\\r\\\\n 231:         },\\\\r\\\\n 232:         jpMlitRulePack,\\\\r\\\\n 233:       )\\\\r\\\\n 234: \\\\r\\\\n 235:       expect(main.zones).toEqual([\\\\r\\\\n 236:         { kind: '定着', pathFromMm: 0, pathToMm: start.lengthMm },\\\\r\\\\n 237:         {\\\\r\\\\n 238:           kind: '定着',\\\\r\\\\n 239:           pathFromMm: main.length - end.lengthMm,\\\\r\\\\n 240:           pathToMm: main.length,\\\\r\\\\n 241:         },\\\\r\\\\n 242:       ])\\\\r\\\\n 243: \\\\r\\\\n 244:       for (const zone of main.zones ?? []) {\\\\r\\\\n 245:         expect(zone.pathFromMm).toBeGreaterThanOrEqual(0)\\\\r\\\\n 246:         expect(zone.pathFromMm).toBeLessThan(zone.pathToMm)\\\\r\\\\n 247:         expect(zone.pathToMm).toBeLessThanOrEqual(main.length)\\\\r\\\\n 248:       }\\\\r\\\\n 249:     }\\\\r\\\\n 250:   })\\\\r\\\\n 251: \\\\r\\\\n 252:   it('derives あばら筋 count from the bounded placement array', () => {\\\\r\\\\n 253:     const positions = stirrupPositions(\\\\r\\\\n 254:       span.clear,\\\\r\\\\n 255:       section.stirrup.pitch,\\\\r\\\\n 256:       section.stirrup.startOffsetMm,\\\\r\\\\n 257:     ).positionsMm\\\\r\\\\n 258:     const stirrup = byRole(\\\\r\\\\n 259:       generateGirderRebar(input(), jpMlitRulePack),\\\\r\\\\n 260:       'あばら筋',\\\\r\\\\n   1: import { describe, expect, it } from 'vitest'\\\\r\\\\n   2: \\\\r\\\\n   3: import type { ColumnSection, Member } from '../model/member'\\\\r\\\\n   4: import type { ColumnEnds, Story } from '../model/project'\\\\r\\\\n   5: import type { RebarRole, RebarZone } from '../model/rebar'\\\\r\\\\n   6: import { lookupRule } from '../rules/lookup'\\\\r\\\\n   7: import { jpMlitRulePack } from '../../rulepack'\\\\r\\\\n   8: import { generateColumnRebar, type ColumnRebarInput } from './column'\\\\r\\\\n   9: \\\\r\\\\n  10: const member: Member = {\\\\r\\\\n  11:   id: '1F-X2Y2',\\\\r\\\\n  12:   kind: '柱',\\\\r\\\\n  13:   memberClass: '躯体',\\\\r\\\\n  14:   sectionId: 'section-C1',\\\\r\\\\n  15:   storyId: '1F',\\\\r\\\\n  16:   position: { ix: 1, iy: 1 },\\\\r\\\\n  17: }\\\\r\\\\n  18: \\\\r\\\\n  19: const section: ColumnSection = {\\\\r\\\\n  20:   id: 'section-C1',\\\\r\\\\n  21:   kind: '柱',\\\\r\\\\n  22:   mark: 'C1',\\\\r\\\\n  23:   b: 800,\\\\r\\\\n  24:   d: 800,\\\\r\\\\n  25:   fc: 24,\\\\r\\\\n  26:   grade: 'SD345',\\\\r\\\\n  27:   exposure: '屋外',\\\\r\\\\n  28:   finish: '仕上げなし',\\\\r\\\\n  29:   main: { size: 'D25', count: 12 },\\\\r\\\\n  30:   hoop: { size: 'D13', pitch: 100 },\\\\r\\\\n  31: }\\\\r\\\\n  32: \\\\r\\\\n  33: const story: Story = { id: '1F', name: '1階', height: 4200 }\\\\r\\\\n  34: \\\\r\\\\n  35: function input(\\\\r\\\\n  36:   overrides: Partial<ColumnRebarInput> = {},\\\\r\\\\n  37: ): ColumnRebarInput {\\\\r\\\\n  38:   return {\\\\r\\\\n  39:     member,\\\\r\\\\n  40:     section,\\\\r\\\\n  41:     story,\\\\r\\\\n  42:     beamDepthAbove: 750,\\\\r\\\\n  43:     // 既定は「下は継手・上は定着」＝ スタック最上段の柱。\\\\r\\\\n  44:     ends: { bottom: '継手', top: '定着' },\\\\r\\\\n  45:     ...overrides,\\\\r\\\\n  46:   }\\\\r\\\\n  47: }\\\\r\\\\n  48: \\\\r\\\\n  49: const mainDiameter = Number(section.main.size.replace(/^D/, ''))\\\\r\\\\n  50: const conditions = { fc: section.fc, grade: section.grade, hook: false }\\\\r\\\\n  51: const anchorage =\\\\r\\\\n  52:   lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * mainDiameter\\\\r\\\\n  53: const lap =\\\\r\\\\n  54:   lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * mainDiameter\\\\r\\\\n  55: const minimumCover = lookupRule(jpMlitRulePack, 'cover.minimum', {\\\\r\\\\n  56:   memberKind: section.kind,\\\\r\\\\n  57:   soilContact: false,\\\\r\\\\n  58:   exposure: section.exposure,\\\\r\\\\n  59:   finish: section.finish,\\\\r\\\\n  60: }).value\\\\r\\\\n  61: const fabricationAddition = lookupRule(\\\\r\\\\n  62:   jpMlitRulePack,\\\\r\\\\n  63:   'cover.fabrication.addition',\\\\r\\\\n  64:   {},\\\\r\\\\n  65: ).value\\\\r\\\\n  66: const fabricationCover = minimumCover + fabricationAddition\\\\r\\\\n  67: \\\\r\\\\n  68: function byRole(\\\\r\\\\n  69:   generated: ReturnType<typeof generateColumnRebar>,\\\\r\\\\n  70:   role: '主筋' | '帯筋',\\\\r\\\\n  71: ) {\\\\r\\\\n  72:   const rebar = generated.find((candidate) => candidate.role === role)\\\\r\\\\n  73:   expect(rebar, `${role} should be generated`).toBeDefined()\\\\r\\\\n  74:   return rebar!\\\\r\\\\n  75: }\\\\r\\\\n  76: \\\\r\\\\n  77: describe('Rebar model', () => {\\\\r\\\\n  78:   it('accepts the standard 大梁 row roles', () => {\\\\r\\\\n  79:     const roles: RebarRole[] = ['上端筋', '下端筋', 'あばら筋']\\\\r\\\\n  80: \\\\r\\\\n  81:     expect(roles).toEqual(['上端筋', '下端筋', 'あばら筋'])\\\\r\\\\n  82:   })\\\\r\\\\n  83: })\\\\r\\\\n  84: \\\\r\\\\n  85: describe('generateColumnRebar', () => {\\\\r\\\\n  86:   it('generates the fixed C1 input as one 主筋 row and one 帯筋 row', () => {\\\\r\\\\n  87:     const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\r\\\\n  88:     const main = byRole(generated, '主筋')\\\\r\\\\n  89:     const hoop = byRole(generated, '帯筋')\\\\r\\\\n  90: \\\\r\\\\n  91:     expect(generated).toHaveLength(2)\\\\r\\\\n  92:     expect(main).toMatchObject({\\\\r\\\\n  93:       memberId: member.id,\\\\r\\\\n  94:       size: 'D25',\\\\r\\\\n  95:       shape: 'straight',\\\\r\\\\n  96:       closed: false,\\\\r\\\\n  97:       count: 12,\\\\r\\\\n  98:     })\\\\r\\\\n  99:     expect(hoop).toMatchObject({\\\\r\\\\n 100:       memberId: member.id,\\\\r\\\\n 101:       size: 'D13',\\\\r\\\\n 102:       shape: 'hoop',\\\\r\\\\n 103:       closed: true,\\\\r\\\\n 104:       count: 36,\\\\r\\\\n 105:     })\\\\r\\\\n 106:   })\\\\r\\\\n 107: \\\\r\\\\n 108:   it('records only rows that came from the rule pack on every generated Rebar', () => {\\\\r\\\\n 109:     const generated = generateColumnRebar(input(), jpMlitRulePack)\\\\r\\\\n 110: \\\\r\\\\n 111:     for (const rebar of generated) {\\\\r\\\\n 112:       expect(rebar.ruleHits.length).toBeGreaterThan(0)\\\\r\\\\n 113:       for (const hit of rebar.ruleHits) {\\\\r\\\\n 114:         expect(\\\\r\\\\n 115:           jpMlitRulePack.entries.includes(hit),\\\\r\\\\n 116:           `${hit.key} should be a row of the rule pack`,\\\\r\\\\n 117:         ).toBe(true)\\\\r\\\\n 118:       }\\\\r\\\\n 119:     }\\\\r\\\\n 120: \\\\r\\\\n 121:     // 端部の順（下端 → 上端）で並ぶ。既定入力は 下端 継手・上端 定着。\\\\r\\\\n 122:     expect(byRole(generated, '主筋').ruleHits.map(({ key }) => key)).toEqual([\\\\r\\\\n 123:       'cover.minimum',\\\\r\\\\n 124:       'cover.fabrication.addition',\\\\r\\\\n 125:       'lap.L1',\\\\r\\\\n 126:       'anchorage.L1',\\\\r\\\\n 127:     ])\\\\r\\\\n 128:     expect(byRole(generated, '帯筋').ruleHits.map(({ key }) => key)).toEqual([\\\\r\\\\n 129:       'cover.minimum',\\\\r\\\\n 130:       'cover.fabrication.addition',\\\\r\\\\n 131:       'bend.hook135',\\\\r\\\\n 132:     ])\\\\r\\\\n 133:   })\\\\r\\\\n 134: \\\\r\\\\n 135:   it('counts the storey joint once instead of adding 定着 and 継手 to every storey (R7)', () => {\\\\r\\\\n 136:     const lower = byRole(\\\\r\\\\n 137:       generateColumnRebar(\\\\r\\\\n 138:         input({ ends: { bottom: '定着', top: 'なし' } }),\\\\r\\\\n 139:         jpMlitRulePack,\\\\r\\\\n 140:       ),\\\\r\\\\n 141:       '主筋',\\\\r\\\\n 142:     )\\\\r\\\\n 143:     const upper = byRole(\\\\r\\\\n 144:       generateColumnRebar(\\\\r\\\\n 145:         input({ ends: { bottom: '継手', top: '定着' } }),\\\\r\\\\n 146:         jpMlitRulePack,\\\\r\\\\n 147:       ),\\\\r\\\\n 148:       '主筋',\\\\r\\\\n 149:     )\\\\r\\\\n 150: \\\\r\\\\n 151:     expect(lower.length).toBe(story.height + anchorage)\\\\r\\\\n 152:     expect(upper.length).toBe(story.height + lap + anchorage)\\\\r\\\\n 153: \\\\r\\\\n 154:     // 2층 스택 합계는 「기초 定着 ＋ 접합부 継手 1회 ＋ 지붕 定着」뿐이다.\\\\r\\\\n 155:     // 예전에는 층마다 定着＋継手가 붙어 継手 하나를 더 세고 있었다.\\\\r\\\\n 156:     const doubleCounted = (story.height + anchorage + lap) * 2\\\\r\\\\n 157: \\\\r\\\\n 158:     expect(lower.length + upper.length).toBeLessThan(doubleCounted)\\\\r\\\\n 159:     expect(doubleCounted - (lower.length + upper.length)).toBe(lap)\\\\r\\\\n 160:   })\\\\r\\\\n 161: \\\\r\\\\n 162:   it('anchors both ends when the column is alone in its stack', () => {\\\\r\\\\n 163:     const main = byRole(\\\\r\\\\n 164:       generateColumnRebar(\\\\r\\\\n 165:         input({ ends: { bottom: '定着', top: '定着' } }),\\\\r\\\\n 166:         jpMlitRulePack,\\\\r\\\\n 167:       ),\\\\r\\\\n 168:       '主筋',\\\\r\\\\n 169:     )\\\\r\\\\n 170: \\\\r\\\\n 171:     expect(main.length).toBe(story.height + 2 * anchorage)\\\\r\\\\n 172:   })\\\\r\\\\n 173: \\\\r\\\\n 174:   it('extends the 3D geometry by exactly what each end contributes', () => {\\\\r\\\\n 175:     const main = byRole(\\\\r\\\\n 176:       generateColumnRebar(\\\\r\\\\n 177:         input({ ends: { bottom: '継手', top: 'なし' } }),\\\\r\\\\n 178:         jpMlitRulePack,\\\\r\\\\n 179:       ),\\\\r\\\\n 180:       '主筋',\\\\r\\\\n 181:     )\\\\r\\\\n 182: \\\\r\\\\n 183:     expect(main.points[0][1]).toBe(-lap)\\\\r\\\\n 184:     expect(main.points[1][1]).toBe(story.height)\\\\r\\\\n 185:   })\\\\r\\\\n 186: \\\\r\\\\n 187:   it.each(\\\\r\\\\n 188:     [\\\\r\\\\n 189:       {\\\\r\\\\n 190:         ends: { bottom: '定着', top: '定着' },\\\\r\\\\n 191:         bottomKind: '定着',\\\\r\\\\n 192:         bottomLength: anchorage,\\\\r\\\\n 193:         topAnchored: true,\\\\r\\\\n 194:       },\\\\r\\\\n 195:       {\\\\r\\\\n 196:         ends: { bottom: '定着', top: 'なし' },\\\\r\\\\n 197:         bottomKind: '定着',\\\\r\\\\n 198:         bottomLength: anchorage,\\\\r\\\\n 199:         topAnchored: false,\\\\r\\\\n 200:       },\\\\r\\\\n 201:       {\\\\r\\\\n 202:         ends: { bottom: '継手', top: '定着' },\\\\r\\\\n 203:         bottomKind: '重ね継手',\\\\r\\\\n 204:         bottomLength: lap,\\\\r\\\\n 205:         topAnchored: true,\\\\r\\\\n 206:       },\\\\r\\\\n 207:       {\\\\r\\\\n 208:         ends: { bottom: '継手', top: 'なし' },\\\\r\\\\n 209:         bottomKind: '重ね継手',\\\\r\\\\n 210:         bottomLength: lap,\\\\r\\\\n 211:         topAnchored: false,\\\\r\\\\n 212:       },\\\\r\\\\n 213:     ] satisfies {\\\\r\\\\n 214:       ends: ColumnEnds\\\\r\\\\n 215:       bottomKind: RebarZone['kind']\\\\r\\\\n 216:       bottomLength: number\\\\r\\\\n 217:       topAnchored: boolean\\\\r\\\\n 218:     }[],\\\\r\\\\n 219:   )(\\\\r\\\\n 220:     'emits path-distance zones for $ends.bottom/$ends.top ends',\\\\r\\\\nexport interface ResolvedSource {\\\\n  short: string\\\\n  doc: string\\\\n  edition: string | null\\\\n  publisher: string\\\\n  url: string | null\\\\n  section: string | null\\\\n  page: number | null\\\\n}\\\\n\\\\nexport interface RuleEntry {\\\\n  key: string\\\\n  label: string\\\\n  expr: string\\\\n  conditions: Record<string, string | number | boolean>\\\\n  value: number\\\\n  unit: string\\\\n  source: ResolvedSource\\\\n  confidence: 'stated' | 'inferred'\\\\n  note: string\\\\n}\\\\n\\\\nexport type RuleHit = RuleEntry\\\\n\\\\nexport interface RulePack {\\\\n  id: string\\\\n  entries: RuleEntry[]\\\\n}\\\\n\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '$OutputEncoding = [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); $a=Get-Content -Encoding utf8 src/components/viewer/Viewer3D.tsx; for($i=1377;$i -le $a.Length;$i++){\\\\\\\"{0,4}: {1}\\\\\\\" -f $i,$a[$i-1]}; rg -n '\\\\\\\"'\\\\\\\\\\\\\\\"viewer\\\\\\\\\\\\\\\\.' src/locales/ja.json src/locales/ko.json; Get-Content -Encoding utf8 -Raw src/domain/model/sample-project.ts; Get-Content -Encoding utf8 -Raw src/lib/i18n.ts\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"