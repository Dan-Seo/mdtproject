    return mocks.raycastIntersections(objects)\\\\r\\\\n  82:       }\\\\r\\\\n  83:       return objects.map((object) => ({ object }))\\\\r\\\\n  84:     }\\\\r\\\\n  85:   }\\\\r\\\\n  86: \\\\r\\\\n  87:   class SceneMock extends actual.Scene {\\\\r\\\\n  88:     add(...objects: import('three').Object3D[]) {\\\\r\\\\n  89:       mocks.sceneObjects.push(...objects)\\\\r\\\\n  90:       return super.add(...objects)\\\\r\\\\n  91:     }\\\\r\\\\n  92:   }\\\\r\\\\n  93: \\\\r\\\\n  94:   return {\\\\r\\\\n  95:     ...actual,\\\\r\\\\n  96:     PMREMGenerator: PMREMGeneratorMock,\\\\r\\\\n  97:     Raycaster: RaycasterMock,\\\\r\\\\n  98:     Scene: SceneMock,\\\\r\\\\n  99:     WebGLRenderer: WebGLRendererMock,\\\\r\\\\n 100:   }\\\\r\\\\n 101: })\\\\r\\\\n 102: \\\\r\\\\n 103: vi.mock('three/examples/jsm/controls/OrbitControls.js', () => ({\\\\r\\\\n 104:   OrbitControls: class OrbitControlsMock {\\\\r\\\\n 105:     target = { set: mocks.controlsTargetSet }\\\\r\\\\n 106:     enableDamping = false\\\\r\\\\n 107:     dampingFactor = 0\\\\r\\\\n 108:     update = vi.fn()\\\\r\\\\n 109:     addEventListener = vi.fn()\\\\r\\\\n 110:     dispose = mocks.controlsDispose\\\\r\\\\n 111:   },\\\\r\\\\n 112: }))\\\\r\\\\n 113: \\\\r\\\\n 114: vi.mock('three/examples/jsm/environments/RoomEnvironment.js', () => ({\\\\r\\\\n 115:   RoomEnvironment: class RoomEnvironmentMock {},\\\\r\\\\n 116: }))\\\\r\\\\n 117: \\\\r\\\\n 118: import {\\\\r\\\\n 119:   ACESFilmicToneMapping,\\\\r\\\\n 120:   GridHelper,\\\\r\\\\n 121:   Group,\\\\r\\\\n 122:   InstancedMesh,\\\\r\\\\n 123:   Material,\\\\r\\\\n 124:   Mesh,\\\\r\\\\n 125:   PCFSoftShadowMap,\\\\r\\\\n 126:   SRGBColorSpace,\\\\r\\\\n 127: } from 'three'\\\\r\\\\n 128: \\\\r\\\\n 129: import { Viewer3D } from './Viewer3D'\\\\r\\\\n 130: \\\\r\\\\n 131: class ResizeObserverMock {\\\\r\\\\n 132:   constructor(private readonly callback: ResizeObserverCallback) {}\\\\r\\\\n 133: \\\\r\\\\n 134:   observe(target: Element) {\\\\r\\\\n 135:     this.callback(\\\\r\\\\n 136:       [\\\\r\\\\n 137:         {\\\\r\\\\n 138:           target,\\\\r\\\\n 139:           contentRect: {\\\\r\\\\n 140:             bottom: 360,\\\\r\\\\n 141:             height: 360,\\\\r\\\\n 142:             left: 0,\\\\r\\\\n 143:             right: 640,\\\\r\\\\n 144:             top: 0,\\\\r\\\\n 145:             width: 640,\\\\r\\\\n 146:             x: 0,\\\\r\\\\n 147:             y: 0,\\\\r\\\\n 148:             toJSON: () => ({}),\\\\r\\\\n 149:           },\\\\r\\\\n 150:         } as ResizeObserverEntry,\\\\r\\\\n 151:       ],\\\\r\\\\n 152:       this as unknown as ResizeObserver,\\\\r\\\\n 153:     )\\\\r\\\\n 154:   }\\\\r\\\\n 155: \\\\r\\\\n 156:   unobserve() {}\\\\r\\\\n 157: \\\\r\\\\n 158:   disconnect() {\\\\r\\\\n 159:     mocks.resizeDisconnect()\\\\r\\\\n 160:   }\\\\r\\\\n 161: }\\\\r\\\\n 162: \\\\r\\\\n 163: function latestContent(): Group {\\\\r\\\\n 164:   const content = mocks.sceneObjects\\\\r\\\\n 165:     .filter((object): object is Group => object instanceof Group)\\\\r\\\\n 166:     .at(-1)\\\\r\\\\n 167: \\\\r\\\\n 168:   if (content === undefined) throw new Error('Viewer content was not built')\\\\r\\\\n 169:   return content\\\\r\\\\n 170: }\\\\r\\\\n 171: \\\\r\\\\n 172: function clipTargetMaterials(content: Group): Material[] {\\\\r\\\\n 173:   const materials = new Set<Material>()\\\\r\\\\n 174: \\\\r\\\\n 175:   content.traverse((object) => {\\\\r\\\\n 176:     if (!(object instanceof Mesh)) return\\\\r\\\\n 177:     if (!['main', 'hoop', 'concrete'].includes(object.userData.layer)) return\\\\r\\\\n 178: \\\\r\\\\n 179:     const objectMaterials = Array.isArray(object.material)\\\\r\\\\n 180:       ? object.material\\\\r\\\\n 181:       : [object.material]\\\\r\\\\n 182:     for (const material of objectMaterials) materials.add(material)\\\\r\\\\n 183: \\\\r\\\\n 184:     const baseMaterial: unknown = object.userData.baseMaterial\\\\r\\\\n 185:     if (baseMaterial instanceof Material) materials.add(baseMaterial)\\\\r\\\\n 186:   })\\\\r\\\\n 187: \\\\r\\\\n 188:   return [...materials]\\\\r\\\\n 189: }\\\\r\\\\n 190: \\\\r\\\\n 191: function runNextAnimationFrame(): void {\\\\r\\\\n 192:   const callback = mocks.animationFrames.shift()\\\\r\\\\n 193:   if (callback === undefined) throw new Error('Animation frame not scheduled')\\\\r\\\\n 194:   act(() => callback(performance.now()))\\\\r\\\\n 195: }\\\\r\\\\n 196: \\\\r\\\\n 197: describe('Viewer3D', () => {\\\\r\\\\n 198:   beforeEach(() => {\\\\r\\\\n 199:     mocks.controlsDispose.mockClear()\\\\r\\\\n 200:     mocks.controlsTargetSet.mockClear()\\\\r\\\\n 201:     mocks.rendererDispose.mockClear()\\\\r\\\\n 202:     mocks.resizeDisconnect.mockClear()\\\\r\\\\n 203:     mocks.envTextureDispose.mockClear()\\\\r\\\\n 204:     mocks.rendererInstances.length = 0\\\\r\\\\n 205:     mocks.pickableCounts.length = 0\\\\r\\\\n 206:     mocks.pickableMeshes.length = 0\\\\r\\\\n 207:     mocks.raycastIntersections = null\\\\r\\\\n 208:     mocks.animationFrames.length = 0\\\\r\\\\n 209:     mocks.sceneObjects.length = 0\\\\r\\\\n 210:     vi.stubGlobal('ResizeObserver', ResizeObserverMock)\\\\r\\\\n 211:     vi.spyOn(window, 'requestAnimationFrame').mockImplementation((callback) => {\\\\r\\\\n 212:       mocks.animationFrames.push(callback)\\\\r\\\\n 213:       return mocks.animationFrames.length\\\\r\\\\n 214:     })\\\\r\\\\n 215:     vi.spyOn(window, 'cancelAnimationFrame').mockImplementation(() => {})\\\\r\\\\n 216: \\\\r\\\\n 217:     useAppStore.setState({\\\\r\\\\n 218:       project: createSampleProject(),\\\\r\\\\n 219:       sel: { group: '1階|C|C1', memberId: '1F-X1Y1' },\\\\r\\\\n 220:       hoverRowId: null,\\\\r\\\\n 220:       hoverRowId: null,\\\\r\\\\n 221:       activeStoryId: '1F',\\\\r\\\\n 222:       locale: 'ja',\\\\r\\\\n 223:       viewerMode: 'member',\\\\r\\\\n 224:       viewerLayers: { main: true, hoop: true, concrete: true },\\\\r\\\\n 225:     })\\\\r\\\\n 226:   })\\\