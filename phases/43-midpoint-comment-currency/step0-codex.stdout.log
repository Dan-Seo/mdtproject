"accepted_max_pt\":  null,\r\n                      \"competing_min_pt\":  null,\r\n                      \"competitor_span_pairs_within_15\":  0\r\n                  },\r\n                  {\r\n                      \"page\":  \"tsu-p16.json\",\r\n                      \"input_sha256\":  \"9cfd8f2947d8ca6db10175e065b6f5a83e98b99d71b8cf6f4a0e0d233d69e13f\",\r\n                      \"grids\":  3,\r\n                      \"blocks\":  1,\r\n                      \"returned_sequences\":  4,\r\n                      \"accepted_span_measurements\":  9,\r\n                      \"accepted_max_pt\":  4.200020332864597,\r\n                      \"competing_min_pt\":  20.81401368726472,\r\n                      \"competitor_span_pairs_within_15\":  0\r\n                  },\r\n                  {\r\n                      \"page\":  \"tsu-p20.json\",\r\n                      \"input_sha256\":  \"653de993ef69888b79379358fb74b07cd3a063031e5cdc6c22e5aa1f4d634be7\",\r\n                      \"grids\":  2,\r\n                      \"blocks\":  1,\r\n                      \"returned_sequences\":  3,\r\n                      \"accepted_span_measurements\":  8,\r\n                      \"accepted_max_pt\":  4.200020332864597,\r\n                      \"competing_min_pt\":  5.939958859566445,\r\n                      \"competitor_span_pairs_within_15\":  1\r\n                  },\r\n                  {\r\n                      \"page\":  \"tsu-p21.json\",\r\n                      \"input_sha256\":  \"8c1e25e08a022ac30767fa806f04f4a186fe73b94955dbe9627085cafee70e67\",\r\n                      \"grids\":  1,\r\n                      \"blocks\":  0,\r\n                      \"returned_sequences\":  1,\r\n                      \"accepted_span_measurements\":  4,\r\n                      \"accepted_max_pt\":  0.0899955618634749,\r\n                      \"competing_min_pt\":  50.36998865720807,\r\n                      \"competitor_span_pairs_within_15\":  0\r\n                  },\r\n  