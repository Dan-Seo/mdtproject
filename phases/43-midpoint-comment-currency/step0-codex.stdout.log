c('git', args, {maxBuffer: 64 * 1024 * 1024});\\nconst save = (name, value) => fs.writeFileSync(path.join(out, name + '.json'), JSON.stringify(value, null, 2) + '\\\\n');\\nfunction instrument(source) {\\n  const ast = ts.createSourceFile(parserPath, source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);\\n  const changes = [];\\n  let functionName = '';\\n  const visit = node => {\\n    const parentName = functionName;\\n    if (ts.isFunctionDeclaration(node)) functionName = node.name?.text;\\n    if (ts.isReturnStatement(node) && node.expression && ts.isObjectLiteralExpression(node.expression)) {\\n      const expr = node.expression;\\n      const raw = expr.getText(ast);\\n      if (functionName === 'validateSequence' && expr.properties.some(p => p.name?.getText(ast) === 'spansMm')) {\\n        const partial = raw.includes('solution.spans\\\\n') || /spansMm:\\\\s*solution\\\\.spans/.test(raw);\\n        const tokens = partial ? 'solution.spans.slice(first.firstIndex, first.lastIndex)' : raw.includes('selected.solution') ? 'selected.solution.spans' : 'selected.spans';\\n        changes.push([expr.getStart(ast), expr.end, `__record(${raw}, sequence, ${tokens}, ${partial ? 'first.firstIndex' : '0'}, dimensions)`]);\\n      }\\n      if (functionName === 'gridCandidate') changes.push([expr.getStart(ast), expr.end, `__grid(${raw}, sequence)`]);\\n    }\\n    ts.forEachChild(node, visit);\\n    functionName = parentName;\\n  };\\n  visit(ast);\\n  assert.equal(changes.length, 4);\\n  for (const [start, end, value] of changes.sort((a,b)=>b[0]-a[0])) source = source.slice(0,start)+value+source.slice(end);\\n  source = source.replace('dimensions.push({', 'dimensions.push({ __raw: normalizedText,');\\n  return source + `\\nconst __tag = Symbol('step3');\\nconst __grids = new WeakMap();\\nfunction __record(result, original, tokens, offset, dimensions) {\\n  result[__tag] = {original, tokens, offset, dimensions};\\n  return result;\\n}\\nfunction __grid(result, sequence) { __grids.set(result, sequence); return result; }\\nexport function audit(output) {\\n  const rows = [];\\n  const sequences = new Set([...output.grids, ...output.blocks.flatMap(b => [b.xGrid,b.yGrid])].map(g => __grids.get(g)));\\n  for (const sequence of sequences) {\\n    const {original,tokens,offset,dimensions} = sequence[__tag];\\n    const used = new Set(tokens);\\n    const along = sequence.alongKey;\\n    const across = along === 'x' ? 'y' : 'x';\\n    for (let i = 0; i < tokens.length; i++) {\\n      const midpoint = (sequence.axes[i].positionPt + sequence.axes[i+1].positionPt)/2;\\n      const bands = [...new Set([...original.axisAcrossOptions[i+offset],...original.axisAcrossOptions[i+offset+1]])];\\n      const describe = token => ({text:token.__raw,value_mm:token.valueMm,center:{x:token.x,y:token.y},distance_pt:Math.abs(token[along]-midpoint),across_distance_pt:Math.min(...bands.map(b=>Math.abs(token[across]-b)))});\\n      const competitors = dimensions.filter(d => !used.has(d) && bands.some(b=>Math.abs(d[across]-b)<=DIMENSION_WINDOW_PT)).map(describe).sort((a,b)=>a.distance_pt-b.distance_pt);\\n      rows.push({direction:sequence.direction,along_key:along,labels:sequence.axes.slice(i,i+2).map(a=>a.label),positions_pt:sequence.axes.slice(i,i+2).map(a=>a.positionPt),midpoint_pt:midpoint,bands_pt:bands,totalConfirmed:sequence.totalConfirmed,accepted:describe(tokens[i]),competitor:competitors[0]??null});\\n    }\\n  }\\n  return rows;\\n}\\n`;\\n}\\nfunction compile(source, debug) {\\n  const code = esbuild.buildSync({stdin:{contents:debug?instrument(source):source,loader:'ts',sourcefile:path.resolve(parserPath),resolveDir:path.dirname(path.resolve(parserPath))},bundle:true,write:false,platform:'node',format:'cjs',logLevel:'silent'}).outputFiles[0].text;\\n  const evaluated = new Module(path.join(out, 'virtual.cjs'));\\n  evaluated.filename = path.join(out, 'virtual.cjs');\\n  evaluated.paths = Module._nodeModulePaths(root);\\n  evaluated._compile(code, evaluated.filename);\\n  return evaluated.exports;\\n}\\nconst currentBytes = fs.readFileSync(parserPath);\\nconst before = git(['show', `${base}:${parserPath}`]).toString('utf8');\\nconst current = currentBytes.toString('utf8');\\n// runs.ts is the only runtime dependency of this parser; require it unchanged.\\nassert.equal(git(['diff', base, '--', 'src/lib/import/runs.ts']).length, 0);\\nconst baseline = compile(before, false);\\nconst baselineAudit = compile(before, true);\\nconst now = compile(current, false);\\nconst nowAudit = compile(current, true);\\nconst dir = 'tests/fixtures/section-import/textitems';\\nconst files = fs.readdirSync(dir).filter(f=>f.endsWith('.json')).sort();\\nassert.equal(files.length, 36);\\nconst pages = files.map(file => {\\n  const fixture = JSON.parse(fs.readFileSync(path.join(dir,file),'utf8'));\\n  const page = {...fixture.page,items:fixture.items};\\n  const oldOutput = baseline.parseFramingPlan(page);\\n  const oldDebug = baselineAudit.parseFramingPlan(page);\\n  const newOutput = now.parseFramingPlan(page);\\n  const newDebug = nowAudit.parseFramingPlan(page);\\n  assert.equal(JSON.stringify(oldOutput),JSON.stringify(oldDebug));\\n  assert.equal(JSON.stringify(newOutput),JSON.stringify(newDebug));\\n  return {file,before:oldOutput,after:newOutput,before_measurements:baselineAudit.audit(oldDebug),after_measurements:nowAudit.audit(newDebug)};\\n});\\nfunction margin(key) {\\n  const rows = pages.flatMap(p=>p[key].map(r=>({page:p.file,...r})));\\n  const max = rows.reduce((a,b)=>a.accepted.distance_pt>=b.accepted.distance_pt?a:b);\\n  const min = rows.filter(r=>r.competitor).reduce((a,b)=>a.competitor.distance_pt<=b.competitor.distance_pt?a:b);\\n  const unconfirmed = rows.filter(r=>!r.totalConfirmed&&r.competitor).reduce((a,b)=>a.competitor.distance_pt<=b.competitor.distance_pt?a:b);\\n  return {page_count:pages.length,span_count:rows.length,A:max.accepted.distance_pt,B:min.competitor.distance_pt,holds:max.accepted.distance_pt<=15&&15<min.competitor.distance_pt,accepted_max:max,competing_min:min,unconfirmed_min:unconfirmed};\\n}\\nconst census = pages.map(p=>{\\n  const oldKeys = p.before.grids.map(g=>JSON.stringify(g));\\n  const newKeys = p.after.grids.map(g=>JSON.stringify(g));\\n  return {page:p.file,before_grids:oldKeys.length,after_grids:newKeys.length,unchanged:oldKeys.filter(k=>newKeys.includes(k)).length,removed:p.before.grids.filter((g,i)=>!newKeys.includes(oldKeys[i])),added:p.after.grids.filter((g,i)=>!oldKeys.includes(newKeys[i])),before_blocks:p.before.blocks.map(b=>b.placements.length),after_blocks:p.after.blocks.map(b=>b.placements.length),blocks_byte_json_equal:JSON.stringify(p.before.blocks)===JSON.stringify(p.after.blocks)};\\n});\\nsave('pages',pages);\\nsave('measurements',{base,parser_sha256_before:sha(currentBytes),parser_sha256_after:sha(fs.readFileSync(parserPath)),historical:margin('before_measurements'),current:margin('after_measurements'),census});\\nconsole.log(JSON.stringify({historical:margin('before_measurements'),current:margin('after_measurements'),changed:census.filter(p=>p.removed.length||p.added.length),all_blocks_equal:census.every(p=>p.blocks_byte_json_equal)},null,2));\\n\"\r\n      },\r\n      {\r\n        \"temporary_path\": \".cache/phase42-step3/mutate.py\",\r\n        \"content\": \"import hashlib\\nimport json\\nfrom pathlib import Path\\nimport subprocess\\n\\nwork = Path('.cache/phase42-step3')\\ntarget = Path('src/lib/import/framing-plan/parse.ts')\\nhashof = lambda b: hashlib.sha256(b).hexdigest()\\nresults = []\\n\\ndef test(label):\\n    report = work / f'{label}.json'\\n    command = ['npx.cmd', 'vitest', 'run', 'src/lib/import/framing-plan/parse.test.ts', '--reporter=json', f'--outputFile={report.as_posix()}']\\n    run = subprocess.run(command, capture_output=True)\\n    data = json.loads(report.read_text(encoding='utf-8'))\\n    cases = [case for suite in data['testResults'] for case in suite['assertionResults']]\\n    return {'command': command, 'exit_code': run.returncode,\\n            'total': data['numTotalTests'], 'passed': data['numPassedTests'], 'failed': data['numFailedTests'],\\n            'failed_cases': [{'name': c['fullName'], 'messages': c['failureMessages']} for c in cases if c['status'] == 'failed'],\\n            'property_cases': [{'name': c['fullName'], 'status': c['status']} for c in cases if 'P1:' in c['fullName'] or 'P2:' in c['fullName']]}\\n\\nmutations = [\\n    ('P1', 'index > 0 && axis.positionPt === result.axes[index - 1].positionPt',\\n     'false && index > 0 && axis.positionPt === result.axes[index - 1].positionPt'),\\n    ('P2', '!Number.isFinite(result.scalePtPerMm) ||\\\\n      result.scalePtPerMm < MIN_PLAN_SCALE_PT_PER_MM ||\\\\n      result.scalePtPerMm > MAX_PLAN_SCALE_PT_PER_MM',\\n     'false'),\\n]\\nfor name, old, new in mutations:\\n    original = target.read_bytes()\\n    normalized = original.decode('utf-8').replace('\\\\r\\\\n', '\\\\n')\\n    assert normalized.count(old) == 1\\n    entry = {'property': name, 'path': target.as_posix(), 'original_sha256': hashof(original),\\n             'removed_condition': old, 'replacement': new}\\n    try:\\n        target.write_text(normalized.replace(old, new), encoding='utf-8', newline='\\\\n')\\n        entry['mutated_sha256'] = hashof(target.read_bytes())\\n        entry['disabled'] = test(f'{name}-disabled')\\n    finally:\\n        target.write_bytes(original)\\n        entry['restored_sha256'] = hashof(target.read_bytes())\\n        entry['byte_equal'] = original == target.read_bytes()\\n    entry['restored'] = test(f'{name}-restored')\\n    entry['holds'] = (entry['disabled']['exit_code'] != 0\\n                      and any(name + ':' in c['name'] for c in entry['disabled']['failed_cases'])\\n                      and entry['restored']['exit_code'] == 0 and entry['byte_equal'])\\n    results.append(entry)\\n    (work / 'mutations.json').write_text(json.dumps(results, ensure_ascii=False, indent=2) + '\\\\n'