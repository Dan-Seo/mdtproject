\n      \"For B, exclude selected span token objects and use the original adjacent axes across-window options, with no midpoint cutoff. Compare the minimum across all spans and the subset with totalConfirmed=false.\",\r\n      \"Require exact equality of all 36 full parser outputs and unchanged input/parser text. Report the maximum, coordinates, per-page hashes and all measured span rows. The earlier report is read only afterwards for comparison.\",\r\n      \"Remove the temporary replay file and its JSON output after inspection. The replay code is preserved here for future independent reruns.\"\r\n    ],\r\n    \"replay_file\": {\r\n      \"temporary_path\": \".cache/phase43-step0-measure.cjs\",\r\n      \"content\": \"const fs = require('node:fs');\\nconst path = require('node:path');\\nconst assert = require('node:assert/strict');\\nconst crypto = require('node:crypto');\\nconst { createRequire } = require('node:module');\\nconst ts = require('typescript');\\n\\nconst parserPath = path.resolve('src/lib/import/framing-plan/parse.ts');\\nconst original = fs.readFileSync(parserPath, 'utf8');\\nconst sha256 = text => crypto.createHash('sha256').update(text).digest('hex');\\nconst ast = ts.createSourceFile(parserPath, original, ts.ScriptTarget.Latest, true);\\nconst edits = [];\\nconst hooks = { text: 0, remember: 0, grid: 0 };\\nfunction wrap(node, call, args) {\\n  edits.push({ start: node.getStart(ast), end: node.end,\\n    text: `${call}(${node.getText(ast)}, ${args})` });\\n}\\nfunction visit(node, owner) {\\n  if (ts.isFunctionDeclaration(node)) owner = node.name?.text;\\n  if (owner === 'collectTokens' && ts.isCallExpression(node) &&\\n      node.expression.getText(ast) === 'dimensions.push') {\\n    assert.equal(node.arguments.length, 1);\\n    wrap(node.arguments[0], '__text', 'normalizedText');\\n    hooks.text++;\\n  }\\n  if (owner === 'validateSequence' && ts.isReturnStatement(node) &&\\n      node.expression && ts.isObjectLiteralExpression(node.expression) &&\\n      node.expression.properties.some(p => p.name?.getText(ast) === 'spansMm')) {\\n    const spans = node.expression.properties.find(p => p.name?.getText(ast) === 'spansMm');\\n    const expression = spans.initializer.getText(ast);\\n    const partial = expression.startsWith('solution.spans');\\n    const tokens = partial ? 'solution.spans.slice(first.firstIndex, first.lastIndex)' :\\n      expression.startsWith('selected.solution.spans') ? 'selected.solution.spans' : 'selected.spans';\\n    wrap(node.expression, '__remember', `${tokens}, dimensions, sequence, ${partial ? 'first.firstIndex' : '0'}`);\\n    hooks.remember++;\\n  }\\n  if (owner === 'gridCandidate' && ts.isReturnStatement(node) && node.expression) {\\n    wrap(node.expression, '__grid', 'sequence');\\n    hooks.grid++;\\n  }\\n  ts.forEachChild(node, child => visit(child, owner));\\n}\\nvisit(ast);\\nassert.deepEqual(hooks, { text: 1, remember: 3, grid: 1 });\\nlet instrumented = original;\\nfor (const edit of edits.sort((a, b) => b.start - a.start)) {\\n  instrumented = instrumented.slice(0, edit.start) + edit.text + instrumented.slice(edit.end);\\n}\\nconst tokenText = new WeakMap();\\nconst selectedBySpans = new WeakMap();\\nconst gridOrigins = new WeakMap();\\nfunction loadParser(code) {\\n  const js = ts.transpileModule(code, { compilerOptions: {\\n    target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS,\\n  }}).outputText;\\n  const module = { exports: {} };\\n  new Function('require', 'module', 'exports', '__text', '__remember', '__grid', js)(\\n    createRequire(parserPath), module, module.exports,\\n    (token, text) => { tokenText.set(token, text); return token; },\\n    (result, tokens, dimensions, sequence, start) => {\\n      selectedBySpans.set(result.spansMm, { tokens, dimensions, sequence, start });\\n      return result;\\n    },\\n    (grid, sequence) => { gridOrigins.set(grid, sequence); return grid; },\\n  );\\n  return module.exports.parseFramingPlan;\\n}\\nconst baseline = loadParser(original);\\nconst measured = loadParser(instrumented);\\nconst fixtureDir = 'tests/fixtures/section-import/textitems';\\nconst files = fs.readdirSync(fixtureDir).filter(file => file.endsWith('.json')).sort();\\nassert.equal(files.length, 36);\\nconst windowPt = Number(original.match(/const DIMENSION_WINDOW_PT = ([0-9.]+)/)[1]);\\nconst tolerancePt = Number(original.match(/const MIDPOINT_TOLERANCE_PT = ([0-9.]+)/)[1]);\\nconst pages = [];\\nconst allSpans = [];\\nfor (const file of files) {\\n  const fixturePath = `${fixtureDir}/${file}`;\\n  const fixtureBytes = fs.readFileSync(fixturePath);\\n  const fixture = JSON.parse(fixtureBytes.toString('utf8'));\\n  const input = { ...fixture.page, items: fixture.items };\\n  const beforeInput = JSON.stringify(input);\\n  const plainOutput = baseline(input);\\n  const output = measured(input);\\n  assert.deepEqual(output, plainOutput, `Instrumentation changed ${file}`);\\n  assert.equal(JSON.stringify(input), beforeInput, `Input mutated: ${file}`);\\n  const returned = [...output.grids, ...output.blocks.flatMap(b => [b.xGrid, b.yGrid])];\\n  const unique = new Set(returned.map(grid => {\\n    const sequence = gridOrigins.get(grid);\\n    assert.ok(sequence, `Untraced grid: ${file}`);\\n    return sequence;\\n  }));\\n  const spans = [];\\n  for (const sequence of unique) {\\n    const observation = selectedBySpans.get(sequence.spansMm);\\n    assert.ok(observation, `Untraced selection: ${file}`);\\n    const { tokens, dimensions, sequence: originalSequence, start } = observation;\\n    assert.equal(tokens.length, sequence.axes.length - 1);\\n    const along = sequence.alongKey;\\n    const across = along === 'x' ? 'y' : 'x';\\n    const used = new Set(tokens);\\n    tokens.forEach((token, i) => {\\n      assert.equal(token.valueMm, sequence.spansMm[i]);\\n      const positions = [sequence.axes[i].positionPt, sequence.axes[i + 1].positionPt];\\n      const midpoint = (positions[0] + positions[1]) / 2;\\n      const bands = [...new Set([\\n        ...originalSequence.axisAcrossOptions[start + i],\\n        ...originalSequence.axisAcrossOptions[start + i + 1],\\n      ])];\\n      assert.ok(bands.some(band => Math.abs(token[across] - band) <= windowPt));\\n      const distance = Math.abs(token[along] - midpoint);\\n      assert.ok(distance <= tolerancePt);\\n      const competitors = dimensions.filter(candidate => !used.has(candidate) &&\\n        bands.some(band => Math.abs(candidate[across] - band) <= windowPt))\\n        .sort((a, b) => Math.abs(a[along] - midpoint) - Math.abs(b[along] - midpoint));\\n      const competitor = competitors[0];\\n      const row = {\\n        page: file.replace(/\\\\.json$/, ''), direction: sequence.direction,\\n        axis_labels: [sequence.axes[i].label, sequence.axes[i + 1].label],\\n        dimension_text: tokenText.get(token), value_mm: token.valueMm,\\n        value_pt: distance, along_key: along, positions_pt: positions,\\n        midpoint_pt: midpoint, token_center_pt: { x: token.x, y: token.y },\\n        bands_pt: bands, total_confirmed: sequence.totalConfirmed,\\n        competitor: competitor ? {\\n          dimension_text: tokenText.get(competitor), value_mm: competitor.valueMm,\\n          value_pt: Math.abs(competitor[along] - midpoint),\\n        } : null,\\n      };\\n      spans.push(row);\\n      allSpans.push(row);\\n    });\\n  }\\n  pages.push({ path: fixturePath, sha256: sha256(fixtureBytes),\\n    grids: output.grids.length, blocks: output.blocks.length,\\n    returned_sequences: unique.size, span_count: spans.length,\\n    instrumented_output_equals_baseline: true,\\n    output_sha256: sha256(JSON.stringify(output)), spans });\\n}\\nconst max = allSpans.reduce((a, b) => a.value_pt >= b.value_pt ? a : b);\\nconst minB = allSpans.filter(s => s.competitor).reduce((a, b) =>\\n  a.competitor.value_pt <= b.competitor.value_pt ? a : b);\\nconst minUnconfirmed = allSpans.filter(s => !s.total_confirmed && s.competitor)\\n  .reduce((a, b) => a.competitor.value_pt <= b.competitor.value_pt ? a : b);\\nassert.equal(fs.readFileSync(parserPath, 'utf8'), original);\\nconst result = {\\n  parser_sha256: sha256(original), hooks, tolerance_pt: tolerancePt,\\n  dimension_window_pt: windowPt,\\n  remeasured: { page_count: pages.length, span_count: allSpans.length,\\n    A: { value_pt: max.value_pt, page: max.page, direction: max.direction,\\n      axis_labels: max.axis_labels, dimension_text: max.dimension_text } },\\n  accepted_max: max, B: minB, unconfirmed_B: minUnconfirmed,\\n  grid_count: pages.reduce((sum, p) => sum + p.grids, 0),\\n  block_count: pages.reduce((sum, p) => sum + p.blocks, 0),\\n  parser_file_unchanged: true, pages,\\n};\\nfs.writeFileSync('.cache/phase43-step0-measurement.json', JSON.stringify(result, null, 2) + '\\\\n');\\nconsole.log(JSON.stringify({ ...result.remeasured, accepted_max: max,\\n  B: minB.competitor.value_pt, unconfirmed_B: minUnconfirmed.competitor.value_pt,\\n  grids: result.grid_count, blocks: result.block_count }));\\n\"\r\n    }\r\n  },\r\n  \"citations\": [\r\n    {\r\n      \"value\": 36,\r\n      \"source\": \"phases/43-midpoint-comment-currency/step0-report.json#/remeasured/page_count\"\r\n    },\r\n    {\r\n      \"value\": 206,\r\n      \"source\": \"phases/43-midpoint-comment-currency/step0-report.json#/remeasured/span_count\"\r\n    },\r\n    {\r\n      \"value\": 7.685713,\r\n      \"source\": \"phases/43-midpoint-comment-currency/step0-report.json#/remeasured/A/value_pt\",\r\n      \"decimals\": 6\r\n    },\r\n    {\r\n      \"value\": {\r\n        \"value_pt\": 7.685713200000237,\r\n        \"page\": \"shibata-p13\",\r\n        \"direction\": \"X\",\r\n        \"axis_labels\": [\r\n          \"1\",\r\n          \"5\"\r\n        ],\r\n        \"dimension_text\": \"41,000\"\r\n      },\r\n      \"source\": \"phases/43-midpoint-comment-currency/step0-report.json#/remeasured/A\"\r\n    },\r\n    {\r\n      \"value\": 60,\r\n      \"sour