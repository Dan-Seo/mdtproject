{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$taskVerifyDir = Join-Path $env:TEMP '\"'kijun-phase43-step1'; @'\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst assert = require('node:assert/strict');\nconst { createRequire } = require('node:module');\nconst { execFileSync } = require('node:child_process');\nconst { createHash } = require('node:crypto');\nconst root = process.cwd();\nconst localRequire = createRequire(path.join(root, 'package.json'));\nlocalRequire('tsx/cjs');\nconst ts = localRequire('typescript');\nconst parserFile = 'src/lib/import/framing-plan/parse.ts';\nconst parserRequire = createRequire(path.join(root, parserFile));\nconst base = execFileSync('git', ['rev-parse', 'a7a5e5d'], {encoding:'utf8'}).trim();\nconst before = execFileSync('git', ['show', \"'`${base}:${parserFile}`], {encoding:'\"'utf8'});\nconst current = fs.readFileSync(parserFile, 'utf8');\nconst digest = s => createHash('sha256').update(s).digest('hex');\nconst compile = code => ts.transpileModule(code, {compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,removeComments:true}}).outputText;\nconst spanTokens = new WeakMap();\nconst gridSequences = new WeakMap();\nconst textForToken = new WeakMap();\nconst observations = [];\nconst edits = [];\nconst hookCounts = {spanValues:0,grid:0,text:0};\nconst ast = ts.createSourceFile('parse.ts', current, ts.ScriptTarget.Latest, true);\nconst wrap = (expr, prefix, suffix) => edits.push({start:expr.getStart(ast),end:expr.end,text:prefix + expr.getText(ast) + suffix});\nfunction visit(node, owner='') {\n  if (ts.isFunctionDeclaration(node)) owner = node.name?.text || owner;\n  if (owner==='validateSequence' && ts.isPropertyAssignment(node) && node.name.getText(ast)==='spansMm') {\n    const init=node.initializer;\n    assert.ok(ts.isCallExpression(init) && init.expression.name.text==='map');\n    const tokenArray=init.expression.expression.getText(ast);\n    wrap(init, '__captureValues(', \"'`, ${tokenArray})`);\n    hookCounts.spanValues++;\n  }\n  if (owner==='\"'gridCandidate' && ts.isReturnStatement(node) && node.expression) {\n    wrap(node.expression, '__captureGrid(', ', sequence)');\n    hookCounts.grid++;\n  }\n  if (owner==='collectTokens' && ts.isCallExpression(node) && node.expression.getText(ast)==='dimensions.push') {\n    wrap(node.arguments[0], '__captureText(', ', normalizedText)');\n    hookCounts.text++;\n  }\n  ts.forEachChild(node, child=>visit(child,owner));\n}\nvisit(ast);\nassert.deepEqual(hookCounts,{spanValues:3,grid:1,text:1});\nlet traced=current;\nfor(const e of edits.sort((a,b)=>b.start-a.start)) traced=traced.slice(0,e.start)+e.text+traced.slice(e.end);\nfunction parser(code) {\n  const module={exports:{}};\n  new Function('require','module','exports','__captureValues','__captureGrid','__captureText',compile(code))(\n    parserRequire,module,module.exports,\n    (values,tokens)=>{spanTokens.set(values,tokens);return values},\n    (grid,sequence)=>{gridSequences.set(grid,sequence);return grid},\n    (token,text)=>{textForToken.set(token,text);return token},\n  );\n  return module.exports.parseFramingPlan;\n}\nconst baselineParser=parser(before), currentParser=parser(current), traceParser=parser(traced);\nconst fixtureDir='tests/fixtures/section-import/textitems';\nconst files=fs.readdirSync(fixtureDir).filter(f=>f.endsWith('.json')).sort();\nassert.equal(files.length,36);\nconst pages=[];\nconst differingPages=[];\nfor(const file of files) {\n  const fixturePath=\"'`${fixtureDir}/${file}`;\n  const bytes=fs.readFileSync(fixturePath);\n  const f=JSON.parse(bytes);\n  const input={...f.page,items:f.items};\n  const serializedInput=JSON.stringify(input);\n  const oldOutput=baselineParser(structuredClone(input));\n  const currentOutput=currentParser(structuredClone(input));\n  const tracedOutput=traceParser