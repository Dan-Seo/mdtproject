n      \"errors\": 0,\r\n      \"warnings\": 1,\r\n      \"warning\": \"src/app/api/oncall/alert/route.test.ts:161:23 _omitted is assigned a value but never used (@typescript-eslint/no-unused-vars); this file is unchanged.\"\r\n    },\r\n    \"citations\": {\r\n      \"command\": \"python scripts/check-citations.py phases/43-midpoint-comment-currency/step0-report.json\",\r\n      \"status\": \"passed\",\r\n      \"exit_code\": 0\r\n    },\r\n    \"diff_scope\": {\r\n      \"baseline_commit\": \"e40c4b3a0222a63ae6b5aaa90f3a003d1e1a1ddb\",\r\n      \"command\": \"git diff e40c4b3a0222a63ae6b5aaa90f3a003d1e1a1ddb --name-only\",\r\n      \"exit_code\": 0,\r\n      \"paths\": [\r\n        \"docs/RISKS.md\",\r\n        \"phases/43-midpoint-comment-currency/index.json\",\r\n        \"phases/43-midpoint-comment-currency/step0-report.json\",\r\n        \"src/lib/import/framing-plan/parse.ts\"\r\n      ],\r\n      \"within_allowed_paths\": true\r\n    },\r\n    \"citation_values_match_targets\": true,\r\n    \"diff_check\": {\r\n      \"command\": \"git diff --cached --check\",\r\n      \"exit_code\": 0\r\n    }\r\n  },\r\n  \"paths_verified\": [\r\n    \"AGENTS.md\",\r\n    \"docs/ADR.md\",\r\n    \"docs/RISKS.md\",\r\n    \"src/lib/import/framing-plan/parse.ts\",\r\n    \"package.json\",\r\n    \"src/lib/import/runs.ts\",\r\n    \"scripts/check-citations.py\",\r\n    \"phases/43-midpoint-comment-currency/index.json\",\r\n    \"phases/43-midpoint-comment-currency/step0.md\",\r\n    \"phases/43-midpoint-comment-currency/step0-report.json\",\r\n    \"phases/42-plan-grid-soundness/step0-report.json\",\r\n    \"phases/42-plan-grid-soundness/step3-report.json\",\r\n    \"phases/42-plan-grid-soundness/step1-report.json\",\r\n    \"src/app/api/oncall/alert/route.test.ts\",\r\n    \"tests/plan-import\",\r\n    \"tests/fixtures/section-import/textitems/fuji-p15.json\",\r\n    \"tests/fixtures/section-import/textitems/fuji-p17.json\",\r\n    \"tests/fixtures/section-import/textitems/f