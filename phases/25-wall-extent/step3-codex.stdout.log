 reinforcements }\r\n        }),\r\n      }\r\n    }),\r\n  }\r\n}\r\n\r\nconst openingFields = [\r\n  { key: 'xMm', label: 'plan.openings.x' },\r\n  { key: 'yMm', label: 'plan.openings.y' },\r\n  { key: 'widthMm', label: 'plan.openings.width' },\r\n  { key: 'heightMm', label: 'plan.openings.height' },\r\n] as const\r\n\r\n/**\r\n * ?뗥룭?ⓦ겗?ε뒟 (?곈뇧令띸츞?뷸틬 1?싧뎴8))?귝뼪?㏘?誤㎯겎??겒?뤷뭄?㏂겓營?걦??겘?곲뼀?ｃ걣\r\n * ??씊竊덄Е?뤄펹?㎯겘?ゃ걦**?앫겗1?싥겗?ⓩ쓲**?ュ콪?쇻굥?뗣굢?????뚣걯寧?뤇??즯?뚥퐬?싥굚\r\n * 兩뷩겇??겓囹볝겘?앫겗1?싥겓?뗣걚?╉걚??(ADR-004?틻DR-029)??\r\n */\r\nfunction OpeningEditor() {\r\n  const project = useAppStore(({ project }) => project)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\r\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n  const editReported = useRef(false)\r\n\r\n  const member = project.members.find(({ id }) => id === selectedMemberId)\r\n  const clear = member === undefined ? null : memberClearSize(project, member)\r\n\r\n  if (!member || clear === null) {\r\n    return (\r\n      <p className={styles.openingHint} data-testid=\"opening-editor-hint\">\r\n        {t(locale, 'plan.openings.select')}\r\n      </p>\r\n    )\r\n  }\r\n\r\n  const section = findSection(project, member.sectionId)\r\n  const openings = member.openings ?? []\r\n  const minimumAreaMm2 =\r\n    lookupRule(jpMlitRulePack, 'measure.opening.deduction.minimum.area', {})\r\n      .value * 1_000_000\r\n\r\n  const reportEdit = () => {\r\n    if (editReported.current) return\r\n    editReported.current = true\r\n    capture('opening_edited', { memberKind: member.kind })\r\n  }\r\n\r\n  const commit = (next: Opening[]) => {\r\n    updateProject((current) => replaceOpenings(current, member.id, next))\r\n    reportEdit()\r\n  }\r\n\r\n  const commitReinforcements = (\r\n    openingId: string,\r\n    reinforcements: OpeningReinforcement[],\r\n  ) => {\r\n    updateProject((current) =>\r\n      replaceOpeningReinforcements(\r\n        current,\r\n        member.id,\r\n        openingId,\r\n        reinforcements,\r\n      ),\r\n    )\r\n    reportEdit()\r\n  }\r\n\r\n  const add = () => {\r\n    // ?℡츣?ㅳ겘?끾퀡??릎鸚?겓1/3??ㄷ?띲걬?귙겑?볝겒?ⓩ쓲?㎯굚恙끹걳?롢겲?뗥ㄷ?띲걬?뗣굢\r\n    // 冶뗣굙?뚣겙?곭쉰?꾠걼?ч뼋?ャ뚦냵力뺛굮??겳?뷩걲?띲겎?ⓩ쓲?붵겏?썬걾?뗣걪?ⓦ걣?ゃ걚??\r\n    const widthMm = Math.max(1, Math.round(clear.xMm / 3))\r\n    const heightMm = Math.max(1, Math.round(clear.yMm / 3))\r\n    commit([\r\n      ...openings,\r\n      {\r\n        id: `${member.id}|op${openings.length + 1}`,\r\n        xMm: Math.round((clear.xMm - widthMm) / 2),\r\n        yMm: Math.round((clear.yMm - heightMm) / 2),\r\n        widthMm,\r\n        heightMm,\r\n      },\r\n    ])\r\n  }\r\n\r\n  const addReinforcement = (opening: Opening) => {\r\n    commitReinforcements(opening.id, [\r\n      ...(opening.reinforcements ?? []),\r\n      // 孃꾠겘?멩뒢?㏂겗?덆젺?믢뺍營?걤?쇻굥?귟Þ鼇덆빓?뺛겘誤뤸틬?뗣굢鵝쒌굢?싥곮Þ鼇덂쎋?멥겗\r\n      // 邕?쮼?ㅳ굮?⑴뵪?끹걣?ε뒟?쇻굥?얇겎 0 ??겲?얇겓?쀣겍?곮＝?곥걣?ㅳ굮?뷸삇?쀣겒?꾠?\r\n      { size: BAR_SIZES[0], count: 1, lengthMm: 0 },\r\n    ])\r\n  }\r\n\r\n  return (\r\n    <fieldset className={styles.openingFieldset} data-testid=\"opening-editor\">\r\n      <legend className={styles.spanLegend}>\r\n        {t(locale, 'plan.openings.title')} ??{section.mark}竊덂냵力?{clear.xMm}횞\r\n        {clear.yMm}竊?\r\n      </legend>\r\n      <p className={styles.openingHint}>{t(locale, 'plan.openings.hint')}</p>\r\n      {openings.length === 0 ? (\r\n        <p className={styles.openingHint}>{t(locale, 'plan.openings.empty')}</p>\r\n      ) : (\r\n        <ul className={styles.openingList}>\r\n          {openings.map((opening, index) => {\r\n            const outside =\r\n              opening.xMm < 0 ||\r\n              opening.yMm < 0 ||\r\n              opening.xMm + opening.widthMm > clear.xMm ||\r\n              opening.yMm + opening.heightMm > clear.yMm\r\n            const ignored =\r\n              opening.widthMm * opening.heightMm <= minimumAreaMm2\r\n\r\n            return (\r\n              <li className={styles.openingItem} key={opening.id}>\r\n                {openingFields.map(({ key, label }) => (\r\n                  <label className={styles.openingField} key={key}>\r\n                    <span className={styles.openingFieldLabel}>\r\n                      {t(locale, label)}\r\n                    </span>\r\n                    <input\r\n                      className={styles.spanInput}\r\n                      type=\"number\"\r\n                      min=\"0\"\r\n                      step=\"10\"\r\n                      value={opening[key]}\r\n                      aria-label={`${section.mark} ${member.id} ${index + 1} ${t(\r\n                        locale,\r\n                        label,\r\n                      )}`}\r\n                      onChange={(event) => {\r\n                        const value = Number(event.currentTarget.value)\r\n                        if (!Number.isFinite(value) || value < 0) return\r\n                        commit(\r\n                          openings.map((current, position) =>\r\n                            position === index\r\n                              ? { ...current, [key]: value }\r\n                              : current,\r\n                          ),\r\n                        )\r\n                      }}\r\n                    />\r\n                  </label>\r\n                ))}\r\n                <button\r\n                  type=\"button\"\r\n                  className={styles.removeButton}\r\n                  aria-label={`${section.mark} ${member.id} ${index + 1} ${t(\r\n                    locale,\r\n                    'plan.openings.remove',\r\n                  )}`}\r\n                  onClick={() =>\r\n                    commit(openings.filter((_, position) => position !== index))\r\n                  }\r\n                >\r\n                  ??\r\n                </button>\r\n                {ignored && (\r\n                  <span className={styles.openingNote}>\r\n                    {t(locale, 'plan.openings.ignored')}\r\n                  </span>\r\n                )}\r\n                {outside && (\r\n                  <span\r\n                    className={styles.openingWarning}\r\n                    data-testid=\"opening-outside\"\r\n                  >\r\n                    ???끾퀡?믡겘?욕눣?쀣겍?꾠겲??\r\n                  </span>\r\n                )}\r\n                <div\r\n                  className={styles.reinforcementEditor}\r\n                  data-testid={`opening-reinforcements-${opening.id}`}\r\n                >\r\n                  <span className={styles.openingFieldLabel}>\r\n                    {t(locale, 'plan.openings.reinforcements.title')}\r\n                  </span>\r\n                  <p className={styles.openingHint}>\r\n                    {t(locale, 'plan.openings.reinforcements.hint')}\r\n                  </p>\r\n                  {(opening.reinforcements ?? []).length === 0 ? (\r\n                    <p\r\n                      className={styles.openingHint}\r\n                      data-testid={`opening-reinforcements-empty-${opening.id}`}\r\n                    >\r\n                      {t(locale, 'plan.openings.reinforcements.empty')}\r\n                    </p>\r\n                  ) : (\r\n                    <ul className={styles.reinforcementList}>\r\n                      {(opening.reinforcements ?? []).map(\r\n                        (reinforcement, reinforcementIndex) => {\r\n                          const labelPrefix = `${section.mark} ${member.id} ${\r\n                            index + 1\r\n                          } ${t(\r\n                            locale,\r\n                            'plan.openings.reinforcements.title',\r\n                          )} ${reinforcementIndex + 1}`\r\n\r\n                          return (\r\n                            <li\r\n                              className={styles.reinforcementItem}\r\n                              data-testid={`opening-reinforcement-${opening.id}-${reinforcementIndex}`}\r\n                              key={`${opening.id}-reinforcement-${reinforcementIndex}`}\r\n                            >\r\n                              <label className={styles.openingField}>\r\n                                <span className={styles.openingFieldLabel}>\r\n                                  {t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.size',\r\n                                  )}\r\n                                </span>\r\n                                <select\r\n                                  className={styles.spanInput}\r\n                                  value={reinforcement.size}\r\n                                  aria-label={`${labelPrefix} ${t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.size',\r\n                                  )}`}\r\n                                  onChange={(event) => {\r\n                                    const size = event.currentTarget\r\n                                      .value as BarSize\r\n                                    commitReinforcements(\r\n                                      opening.id,\r\n                                      (opening.reinforcements ?? []).map(\r\n                                        (current, position) =>\r\n                                          position === reinforcementIndex\r\n                                            ? { ...current, size }\r\n                                            : current,\r\n                                      ),\r\n                                    )\r\n                                  }}\r\n                                >\r\n                                  {BAR_SIZES.map((size) => (\r\n                                    <option key={size} value={size}>\r\n                                      {size}\r\n                                    </option>\r\n                                  ))}\r\n                                </select>\r\n                              </label>\r\n                              <label className={styles.openingField}>\r\n                                <span className={styles.openingFieldLabel}>\r\n                                  {t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.count',\r\n                                  )}\r\n                                </span>\r\n                                <input\r\n                                  className={styles.spanInput}\r\n                                  type=\"number\"\r\n                                  min=\"1\"\r\n                                  step=\"1\"\r\n                                  value={reinforcement.count}\r\n                                  aria-label={`${labelPrefix} ${t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.count',\r\n                                  )}`}\r\n                                  onChange={(event) => {\r\n                                    const count = Number(\r\n                                      event.currentTarget.value,\r\n                                    )\r\n                                    if (\r\n                                      !Number.isInteger(count) ||\r\n                                      count < 1\r\n                                    ) {\r\n                                      return\r\n                                    }\r\n                                    commitReinforcements(\r\n                                      opening.id,\r\n                                      (opening.reinforcements ?? []).map(\r\n                                        (current, position) =>\r\n                                          position === reinforcementIndex\r\n                                            ? { ...current, count }\r\n                                            : current,\r\n                                      ),\r\n                                    )\r\n                                  }}\r\n                                />\r\n                              </label>\r\n                              <label className={styles.openingField}>\r\n                                <span className={styles.openingFieldLabel}>\r\n                                  {t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.length',\r\n                                  )}\r\n                                </span>\r\n                                <input\r\n                                  className={styles.spanInput}\r\n                                  type=\"number\"\r\n                                  min=\"0\"\r\n                                  step=\"10\"\r\n                                  value={reinforcement.lengthMm}\r\n                                  aria-label={`${labelPrefix} ${t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.length',\r\n                                  )}`}\r\n                                  onChange={(event) => {\r\n                                    const lengthMm = Number(\r\n                                      event.currentTarget.value,\r\n                                    )\r\n                                    if (\r\n                                      !Number.isFinite(lengthMm) ||\r\n                                      lengthMm < 0\r\n                                    ) {\r\n                                      return\r\n                                    }\r\n                                    commitReinforcements(\r\n                                      opening.id,\r\n                                      (opening.reinforcements ?? []).map(\r\n                                        (current, position) =>\r\n                                          position === reinforcementIndex\r\n                                            ? { ...current, lengthMm }\r\n                                            : current,\r\n                                      ),\r\n                                    )\r\n                                  }}\r\n                                />\r\n                              </label>\r\n                              <button\r\n                                type=\"button\"\r\n                                className={styles.removeButton}\r\n                                aria-label={`${labelPrefix} ${t(\r\n                                  locale,\r\n                                  'plan.openings.reinforcements.remove',\r\n                                )}`}\r\n                                onClick={() =>\r\n                                  commitReinforcements(\r\n                                    opening.id,\r\n                                    (opening.reinforcements ?? []).filter(\r\n                                      (_, position) =>\r\n                                        position !== reinforcementIndex,\r\n                                    ),\r\n                                  )\r\n                                }\r\n                              >\r\n                                ??\r\n                              </button>\r\n                              {reinforcement.lengthMm === 0 && (\r\n                                <span\r\n                                  className={styles.openingWarning}\r\n                                  data-testid=\"opening-reinforcement-untranscribed\"\r\n                                >\r\n                                  {t(\r\n                                    locale,\r\n                                    'plan.openings.reinforcements.untranscribed',\r\n                                  )}\r\n                                </span>\r\n                              )}\r\n                            </li>\r\n                          )\r\n                        },\r\n                      )}\r\n                    </ul>\r\n                  )}\r\n                  <button\r\n                    type=\"button\"\r\n                    className={styles.addButton}\r\n                    onClick={() => addReinforcement(opening)}\r\n                  >\r\n                    {t(locale, 'plan.openings.reinforcements.add')}\r\n                  </button>\r\n                </div>\r\n              </li>\r\n            )\r\n          })}\r\n        </ul>\r\n      )}\r\n      <button type=\"button\" className={styles.addButton} onClick={add}>\r\n        {t(locale, 'plan.openings.add')}\r\n      </button>\r\n    </fieldset>\r\n  )\r\n}\r\n\r\nexport function PlanEditor() {\r\n  const project = useAppStore(({ project }) => project)\r\n  const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\r\n  const story = project.stories.find(({ id }) => id === activeStoryId)\r\n  const transform = drawingTransform(project)\r\n  const xCoordinates = spanCoordinates(project.grid.xSpans)\r\n  const yCoordinates = spanCoordinates(project.grid.ySpans)\r\n  const members = project.members.filter(\r\n    ({ storyId }) => storyId === activeStoryId,\r\n  )\r\n\r\n  if (!story) {\r\n    throw storyNotFound(activeStoryId)\r\n  }\r\n\r\n  return (\r\n    <div className={styles.editor}>\r\n      <div className={styles.spanEditors}>\r\n        <SpanEditor axis=\"x\" />\r\n        <SpanEditor axis=\"y\" />\r\n      </div>\r\n      <OpeningEditor />\r\n      <div className={styles.drawingFrame}>\r\n        <svg\r\n          className={styles.drawing}\r\n          viewBox={`0 0 ${viewWidth} ${viewHeight}`}\r\n          role=\"img\"\r\n          aria-label={`${story.name} 亮녜씊`}\r\n        >\r\n          {members\r\n            .filter(({ kind }) => kind === '佯딀씮')\r\n            .map((member) => (\r\n              <PlanMember\r\n                key={member.id}\r\n                member={member}\r\n                project={project}\r\n                transform={transform}\r\n              />\r\n            ))}\r\n          {members\r\n            .filter(({ kind }) => kind === '?먬쐡鶯?)\r\n            .map((member) => (\r\n              <PlanMember\r\n                key={member.id}\r\n                member={member}\r\n                project={project}\r\n                transform={transform}\r\n              />\r\n            ))}\r\n          {members\r\n            .filter(({ kind }) => kind === '鸚㎪쥈')\r\n            .map((member) => (\r\n              <PlanMember\r\n                key={member.id}\r\n                member={member}\r\n                project={project}\r\n                transform={transform}\r\n              />\r\n            ))}\r\n          {members\r\n            .filter(({ kind }) => kind === '??)\r\n            .map((member) => (\r\n              <PlanMember\r\n    })\r\n    fireEvent.change(screen.getByLabelText('X?밤깙??1'), {\r\n      target: { value: '6500' },\r\n    })\r\n    fireEvent.change(screen.getByLabelText('Y?밤깙??1'), {\r\n      target: { value: '5000' },\r\n    })\r\n\r\n    const edits = capture.mock.calls.filter(\r\n      ([name]) => name === 'grid_edited',\r\n    )\r\n    expect(edits).toHaveLength(2)\r\n    expect(edits.map(([, properties]) => properties)).toEqual([\r\n      { axis: 'x' },\r\n      { axis: 'y' },\r\n    ])\r\n  })\r\n\r\n  it('draws a wall only over its partial extent and labels the height extent', () => {\r\n    const project = createSampleProject()\r\n    const wall = project.members.find(({ kind }) => kind === '?먬쐡鶯?)!\r\n\r\n    const { container } = render(<PlanEditor />)\r\n    const fullWallButton = screen.getByRole('button', {\r\n      name: `W1 ${wall.id}`,\r\n    })\r\n    const fullWallLines = fullWallButton.querySelectorAll('line')\r\n    const fullWallFace = fullWallLines[2]\r\n    if (fullWallFace === undefined) {\r\n      throw new Error('Full wall face was not rendered')\r\n    }\r\n    const fullLength = Math.abs(\r\n      Number(fullWallFace.getAttribute('y2')) -\r\n        Number(fullWallFace.getAttribute('y1')),\r\n    )\r\n\r\n    act(() =>\r\n      useAppStore.setState({\r\n        project: {\r\n          ...project,\r\n          members: project.members.map((member) =>\r\n            member.id === wall.id\r\n              ? {\r\n                  ...member,\r\n                  wallExtent: {\r\n                    horizontal: { anchor: '永귞ク', lengthMm: 2400 },\r\n                    vertical: { anchor: '訝뗧ク', heightMm: 900 },\r\n                  },\r\n                }\r\n              : member,\r\n          ),\r\n        },\r\n      }),\r\n    )\r\n\r\n    const wallButton = screen.getByRole('button', { name: `W1 ${wall.id}` })\r\n    const wallLines = wallButton.querySelectorAll('line')\r\n    const visibleWall = wallLines[2]\r\n    if (visibleWall === undefined) throw new Error('Wall face was not rendered')\r\n\r\n    const drawnLength = Math.abs(\r\n      Number(visibleWall.getAttribute('y2')) -\r\n        Number(visibleWall.getAttribute('y1')),\r\n    )\r\n    expect(drawnLength).toBeGreaterThan(0)\r\n    expect(drawnLength).toBeLessThan(fullLength * 0.6)\r\n    expect(screen.getByTestId('wall-extent-label')).toHaveTextContent(\r\n      '?겼즯 H=900',\r\n    )\r\n    expect(container.querySelectorAll('[data-testid=\"wall-extent-label\"]')).toHaveLength(1)\r\n  })\r\n})\r\n\r\ndescribe('PlanEditor ?뗥룭?ⓦ겗?ε뒟 (?곈뇧令띸츞?뷸틬 1?싧뎴8))', () => {\r\n  beforeEach(() => {\r\n    capture.mockClear()\r\n    useAppStore.setState({\r\n      project: createSampleProject(),\r\n      sel: { group: null, memberId: null },\r\n      activeStoryId: '1F',\r\n      locale: 'ja',\r\n    })\r\n  })\r\n\r\n  function selectWall() {\r\n    const wall = useAppStore\r\n      .getState()\r\n      .project.members.find(({ kind }) => kind === '?먬쐡鶯?)!\r\n    act(() => {\r\n      useAppStore.getState().selectMember(wall.id)\r\n    })\r\n    return wall\r\n  }\r\n\r\n  it('tells the user to pick a ?먬쐡鶯?or 佯딀씮 first', () => {\r\n    render(<PlanEditor />)\r\n\r\n    expect(screen.getByTestId('opening-editor-hint')).toBeInTheDocument()\r\n    expect(screen.queryByTestId('opening-editor')).not.toBeInTheDocument()\r\n  })\r\n\r\n  it('does not offer openings for ????1?싧뎴8) names 囹볝꺕?뷴뀯??, () => {\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: 'C1 1F-X2Y2' }))\r\n\r\n    expect(screen.queryByTestId('opening-editor')).not.toBeInTheDocument()\r\n  })\r\n\r\n  it('adds an opening that fits inside the ?끾퀡 of the selected wall', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n\r\n    const stored = useAppStore\r\n      .getState()\r\n      .project.members.find(({ id }) => id === wall.id)!.openings!\r\n    expect(stored).toHaveLength(1)\r\n    // ?끾퀡 5200횞3450 ??릎鸚?겓 1/3 ??ㄷ?띲걬 ??營?걚?잏옱?볝겓??겳?뷩걬?ゃ걚??\r\n    const [opening] = stored\r\n    expect(opening.xMm).toBeGreaterThanOrEqual(0)\r\n    expect(opening.yMm).toBeGreaterThanOrEqual(0)\r\n    expect(opening.xMm + opening.widthMm).toBeLessThanOrEqual(5200)\r\n    expect(opening.yMm + opening.heightMm).toBeLessThanOrEqual(3450)\r\n    expect(capture).toHaveBeenCalledWith('opening_edited', {\r\n      memberKind: '?먬쐡鶯?,\r\n    })\r\n  })\r\n\r\n  it('edits an opening dimension through updateProject', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n\r\n    const width = screen.getByLabelText(`W1 ${wall.id} 1 ?끾퀡亮?)\r\n    fireEvent.change(width, { target: { value: '1800' } })\r\n\r\n    expect(\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .widthMm,\r\n    ).toBe(1800)\r\n  })\r\n\r\n  it('edits an ?뗥룭獒쒎섭嶺?transcription through updateProject', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n\r\n    fireEvent.change(\r\n      screen.getByLabelText(\r\n        `W1 ${wall.id} 1 ?뗥룭獒쒎섭嶺뗰펷鼇?쮫?녔쎑?뗣굢邕?쮼竊?1 孃?,\r\n      ),\r\n      { target: { value: 'D16' } },\r\n    )\r\n    fireEvent.change(\r\n      screen.getByLabelText(\r\n        `W1 ${wall.id} 1 ?뗥룭獒쒎섭嶺뗰펷鼇?쮫?녔쎑?뗣굢邕?쮼竊?1 ?ф빊`,\r\n      ),\r\n      { target: { value: '4' } },\r\n    )\r\n    fireEvent.change(\r\n      screen.getByLabelText(\r\n        `W1 ${wall.id} 1 ?뗥룭獒쒎섭嶺뗰펷鼇?쮫?녔쎑?뗣굢邕?쮼竊?1 鼇?쮫?룔걬 (mm)`,\r\n      ),\r\n      { target: { value: '1800' } },\r\n    )\r\n\r\n    const reinforcement =\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .reinforcements![0]\r\n    expect(reinforcement).toEqual({ size: 'D16', count: 4, lengthMm: 1800 })\r\n  })\r\n\r\n  it('marks a newly added zero-length row as untranscribed', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n\r\n    expect(\r\n      screen.getByTestId('opening-reinforcement-untranscribed'),\r\n    ).toHaveTextContent('?よ빪鼇?)\r\n    expect(\r\n      screen.getByTestId('opening-reinforcement-untranscribed'),\r\n    ).toHaveTextContent('?곈뇧?ヨ쮫訝듽걬?뚣겲?쎼굯')\r\n    expect(wall.id).toBeTruthy()\r\n  })\r\n\r\n  it('deletes only the selected ?뗥룭獒쒎섭嶺?row', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n\r\n    const removeButtons = screen.getAllByRole('button', {\r\n      name: /獒쒎섭嶺뗣굮?딃솮$/,\r\n    })\r\n    expect(removeButtons).toHaveLength(2)\r\n    fireEvent.click(removeButtons[0])\r\n\r\n    const stored =\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .reinforcements!\r\n    expect(stored).toHaveLength(1)\r\n  })\r\n\r\n  it('drops the reinforcements key when the last transcription row is removed', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: '?뗥룭獒쒎섭嶺뗣굮瓦썲뒥' }),\r\n    )\r\n    fireEvent.click(\r\n      screen.getByRole('button', { name: /獒쒎섭嶺뗣굮?딃솮$/ }),\r\n    )\r\n\r\n    const stored =\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n    expect(stored).not.toHaveProperty('reinforcements')\r\n  })\r\n\r\n  it('marks an opening the clause does not deduct', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n\r\n    fireEvent.change(screen.getByLabelText(`W1 ${wall.id} 1 ?끾퀡亮?), {\r\n      target: { value: '700' },\r\n    })\r\n    fireEvent.change(screen.getByLabelText(`W1 ${wall.id} 1 ?끾퀡遙섅걬`), {\r\n      target: { value: '700' },\r\n    })\r\n\r\n    // 0.49???????뗦?壤볝걼?듿냵力뺡씊令?.5?▽빳訝뗣띲겒??겎轝좈솮?쀣겒?꾠?\r\n    expect(screen.getByText(/0\\.5?▽빳訝?)).toBeInTheDocument()\r\n  })\r\n\r\n  it('warns when an opening leaves the ?끾퀡 instead of trimming it', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n\r\n    fireEvent.change(screen.getByLabelText(`W1 ${wall.id} 1 ?끾퀡亮?), {\r\n      target: { value: '9000' },\r\n    })\r\n\r\n    // ?뉎굤屋겹굙??룛?묈룚?뗣겏?녜씊?ャ겒?꾢ㄷ?띲걬??뼀?ｃ굮獒썲뱚?뚧군?곥굥?볝겏?ャ겒?뗣?\r\n    expect(screen.getByTestId('opening-outside')).toBeInTheDocument()\r\n    expect(\r\n      useAppStore\r\n        .getState()\r\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\r\n        .widthMm,\r\n    ).toBe(9000)\r\n  })\r\n\r\n  it('drops the key entirely when the last opening is removed', () => {\r\n    const wall = selectWall()\r\n    render(<PlanEditor />)\r\n    fireEvent.click(screen.getByRole('button', { name: '?뗥룭?ⓦ굮瓦썲뒥' }))\r\n    fireEvent.click(screen.getByRole('button', { name: `W1 ${wall.id} 1 ?딃솮` }))\r\n\r\n    const stored = useAppStore\r\n      .getState()\r\n      .project.members.find(({ id }) => id === wall.id)!\r\n    expect(stored).not.toHaveProperty('openings')\r\n  })\r\n\r\n  it('draws a 佯딀씮 opening at its true position, not inside the drawn inset', () => {\r\n    const project = createSampleProject()\r\n    const slab = project.members.find(({ kind }) => kind === '佯딀씮')!\r\n    act(() => {\r\n      useAppStore.setState({\r\n        project: {\r\n          ...project,\r\n          members: project.members.map((member) =>\r\n            member.id === slab.id\r\n              ? {\r\n                  ...member,\r\n                  openings: [\r\n                    {\r\n                      id: 'op1',\r\n                      xMm: 2400,\r\n                      yMm: 2400,\r\n                      widthMm: 1200,\r\n                      heightMm: 1200,\r\n                    },\r\n                  ],\r\n                }\r\n              : member,\r\n          ),\r\n        },\r\n      })\r\n    })\r\n    const { container } = render(<PlanEditor />)\r\n\r\n    const rects = container.querySelectorAll('rect[class*=\"opening\"]')\r\n    expect(rects).toHaveLength(1)\r\n    // ?뗥룭????밧숱?ゃ겗?㎯곩뭄?㏂겎?귛퉭?③쳵?뺛걣嶺됥걮?뤷눣?뗰펷若잌??㎩넍?쀣겍?꾠굥鼇쇗떊竊됥?\r\n    const width = Number(rects[0].getAttribute('width'))\r\n    const height = Number(rects[0].getAttribute('height'))\r\n    expect(width).toBeCloseTo(height, 6)\r\n    expect(width).toBeGreaterThan(0)\r\n  })\r\n})\r\n\r\ndescribe('StoryTabs', () => {\r\n  beforeEach(() => {\r\n    capture.mockClear()\r\n    useAppStore.setState({\r\n      project: createSampleProject(),\r\n      sel: { group: null, memberId: null },\r\n      activeStoryId: '1F',\r\n      locale: 'ja',\r\n    })\r\n  })\r\n\r\n  it('changes activeStoryId when a story tab is clicked', () => {\r\n    render(<StoryTabs />)\r\n\r\n    fireEvent.click(screen.getByRole('tab', { name: '2?? }))\r\n  stroke: var(--text-muted-soft);\r\n  stroke-width: 1;\r\n  stroke-dasharray: 4 4;\r\n  vector-effect: non-scaling-stroke;\r\n}\r\n\r\n.memberSelected .slab {\r\n  fill: color-mix(in srgb, var(--color-primary) 12%, transparent);\r\n  stroke: var(--color-primary);\r\n}\r\n\r\n/* ?뗥룭?ⓦ겗?ε뒟 (?곈뇧令띸츞?뷸틬 1?싧뎴8))?귝뼪?㏂겎??겒?뤻깿?먦걫?ⓦ겗若잌쑉?⒲겒??겎\r\n   亮녜씊?싥궎?녈겓營?걦 ????씊訝誤㎯겓營?걦?ⓨ릪?섊Е?룔겗鶯곥걲?밤겍?ョ첆?뚪뼀?뤵?*/\r\n.openingFieldset {\r\n  margin: 0;\r\n  padding: var(--space-xs) var(--space-sm) var(--space-sm);\r\n  border: 1px solid var(--hairline-soft);\r\n  border-radius: 6px;\r\n}\r\n\r\n.openingHint {\r\n  margin: var(--space-xxs) 0;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.openingList {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--space-xxs);\r\n  margin: 0 0 var(--space-xs);\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.openingItem {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  gap: var(--space-xxs);\r\n}\r\n\r\n.openingField {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.openingFieldLabel {\r\n  color: var(--text-muted);\r\n  font-size: 10px;\r\n}\r\n\r\n.openingNote,\r\n.openingWarning {\r\n  align-self: center;\r\n  font-size: 10px;\r\n}\r\n\r\n.openingNote {\r\n  color: var(--text-muted);\r\n}\r\n