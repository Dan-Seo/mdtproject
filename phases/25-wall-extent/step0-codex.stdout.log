s/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:97:          \"mark\": \"FS2\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:98:          \"thickness\": 170,\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:103:          \"mark\": \"FS3\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:104:          \"thickness\": 200,\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:109:          \"mark\": \"FS4\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:110:          \"thickness\": 150,\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:120:      \"marks\": [\"B1\", \"B2\", \"B3\", \"FB1\", \"FB2\", \"FB3\", \"FB4\", \"FB5\", \"BW20\"],\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p4-walls-slabs.json:126:      \"marks\": [\"CG1\", \"FCG1\", \"CB1\"],\r\ntests/fixtures/section-import/expected\\yokohama-kanazawa-p14-girders.json:22:      \"mark\": \"G51\",\r\ntests/fixtures/section-import/expected\\yokohama-kanazawa-p14-girders.json:44:      \"mark\": \"G54\",\r\ntests/fixtures/section-import/expected\\yokohama-kanazawa-p14-girders.json:57:      \"mark\": \"G55\",\r\ntests/fixtures/section-import/expected\\yokohama-kanazawa-p14-girders.json:70:      \"mark\": \"G55A\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p3-girders.json:26:      \"mark\": \"G1\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p3-girders.json:79:      \"mark\": \"G1A\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p3-girders.json:92:      \"mark\": \"G2\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p3-girders.json:145:      \"mark\": \"G2A\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p3-girders.json:158:      \"mark\": \"G3\",\r\ntests/fixtures/section-import/expected\\ojkk-akamichi-p3-girders.json:211:      \"mark\": \"G4\",\r\ntests/fixtures/