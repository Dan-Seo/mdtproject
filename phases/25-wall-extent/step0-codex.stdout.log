rderMainDecomposition {\\\\r\\\\n' +\\n  '  throughCount: number\\\\r\\\\n' +\\n  '  startStubCount: number\\\\r\\\\n' +\\n  '  endStubCount: number\\\\r\\\\n' +\\n  '  centerOnlyCount: number\\\\r\\\\n' +\\n  '  oneSidedCount: number\\\\r\\\\n' +\\n  \\\"  oneSidedAnchor?: '始端' | '終端'\\\\r\\\\n\\\" +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export function decomposeGirderMainRow(\\\\r\\\\n' +\\n  '  row: GirderMainRow,\\\\r\\\\n' +\\n  '): GirderMainDecomposition {\\\\r\\\\n' +\\n  '  const startCount = row.startCount ?? row.endCount\\\\r\\\\n' +\\n  '  const throughCount = Math.min(startCount, row.centerCount, row.endCount)\\\\r\\\\n' +\\n  '  const startStubCount = Math.max(0, startCount - row.centerCount)\\\\r\\\\n' +\\n  '  const endStubCount = Math.max(0, row.endCount - row.centerCount)\\\\r\\\\n' +\\n  '  const centerOnlyCount = Math.max(\\\\r\\\\n' +\\n  '    0,\\\\r\\\\n' +\\n  '    row.centerCount - Math.max(startCount, row.endCount),\\\\r\\\\n' +\\n  '  )\\\\r\\\\n' +\\n  '  const oneSidedStartCount = Math.max(\\\\r\\\\n' +\\n  '    0,\\\\r\\\\n' +\\n  '    Math.min(startCount, row.centerCount) - row.endCount,\\\\r\\\\n' +\\n  '  )\\\\r\\\\n' +\\n  '  const oneSidedEndCount = Math.max(\\\\r\\\\n' +\\n  '    0,\\\\r\\\\n' +\\n  '    Math.min(row.centerCount, row.endCount) - startCount,\\\\r\\\\n' +\\n  '  )\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '  if (oneSidedStartCount > 0) {\\\\r\\\\n' +\\n  '    return {\\\\r\\\\n' +\\n  '      throughCount,\\\\r\\\\n' +\\n  '      startStubCount,\\\\r\\\\n' +\\n  '      endStubCount,\\\\r\\\\n' +\\n  '      centerOnlyCount,\\\\r\\\\n' +\\n  '      oneSidedCount: oneSidedStartCount,\\\\r\\\\n' +\\n  \\\"      oneSidedAnchor: '始端',\\\\r\\\\n\\\" +\\n  '    }\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '  if (oneSidedEndCount > 0) {\\\\r\\\\n' +\\n  '    return {\\\\r\\\\n' +\\n  '      throughCount,\\\\r\\\\n' +\\n  '      startStubCount,\\\\r\\\\n' +\\n  '      endStubCount,\\\\r\\\\n' +\\n  '      centerOnlyCount,\\\\r\\\\n' +\\n  '      oneSidedCount: oneSidedEndCount,\\\\r\\\\n' +\\n  \\\"      oneSidedAnchor: '終端',\\\\r\\\\n\\\" +\\n  '    }\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '  return {\\\\r\\\\n' +\\n  '    throughCount,\\\\r\\\\n' +\\n  '    startStubCount,\\\\r\\\\n' +\\n  '    endStubCount,\\\\r\\\\n' +\\n  '    centerOnlyCount,\\\\r\\\\n' +\\n  '    oneSidedCount: 0,\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export interface GirderSection {\\\\r\\\\n' +\\n  '  id: string\\\\r\\\\n' +\\n  \\\"  kind: '大梁'\\\\r\\\\n\\\" +\\n  '  mark: string\\\\r\\\\n' +\\n  '  /** ColumnSection.storyLabel과 같다. */\\\\r\\\\n' +\\n  '  storyLabel?: string\\\\r\\\\n' +\\n  '  b: number\\\\r\\\\n' +\\n  '  depth: number\\\\r\\\\n' +\\n  '  fc: number\\\\r\\\\n' +\\n  '  grade: SteelGrade\\\\r\\\\n' +\\n  '  exposure: Exposure\\\\r\\\\n' +\\n  '  finish: Finish\\\\r\\\\n' +\\n  '  /** ColumnSection.spliceMethod と同じ。通し筋の継手箇所数に効く */\\\\r\\\\n' +\\n  '  spliceMethod: SpliceMethod\\\\r\\\\n' +\\n  '  main: {\\\\r\\\\n' +\\n  '    size: BarSize\\\\r\\\\n' +\\n  '    /** 上端筋の位置別本数 — 断面リストの端部・中央行がそのまま入る */\\\\r\\\\n' +\\n  '    top: GirderMainRow\\\\r\\\\n' +\\n  '    /** 下端筋の位置別本数 */\\\\r\\\\n' +\\n  '    bottom: GirderMainRow\\\\r\\\\n' +\\n  '    /**\\\\r\\\\n' +\\n  '     * カットオフ筋を柱面から梁の内側へ何 mm で切り止めるか。\\\\r\\\\n' +\\n  '     *\\\\r\\\\n' +\\n  '     * 数量積算基準 2（３）梁1) が「トップ筋、ハンチ部分の主筋、補強筋等は設計図書\\\\r\\\\n' +\\n  '     * による」と委ねるので規準側に値がない — 断面一覧の入力である (ADR-012)。\\\\r\\\\n' +\\n  '     * 端部と中央が同数（カットオフ筋がない）断面では使われない。\\\\r\\\\n' +\\n  '     */\\\\r\\\\n' +\\n  '    cutoffFromSupportFaceMm: number\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '  stirrup: {\\\\r\\\\n' +\\n  '    size: ShearBarSize\\\\r\\\\n' +\\n  '    pitch: number\\\\r\\\\n' +\\n  '    /** 両端の柱面から第1・最終あばら筋をどれだけ離すか。規準に値はない — 断面一覧の入力である (ADR-012) */\\\\r\\\\n' +\\n  '    startOffsetMm: number\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '  /**\\\\r\\\\n' +\\n  '   * 幅止め筋。断面一覧に記載のない梁には無い配筋なので任意項目とし、\\\\r\\\\n' +\\n  '   * `undefined` は「配筋なし」を意味する — 製品が勝手に足さない (ADR-012)。\\\\r\\\\n' +\\n  '   * 設計長さは数量積算基準 1通則3) が断面の設計幅と定めるので入力は径とピッチだけ。\\\\r\\\\n' +\\n  '   */\\\\r\\\\n' +\\n  '  widthTie?: {\\\\r\\\\n' +\\n  '    size: BarSize\\\\r\\\\n' +\\n  '    pitch: number\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '  /**\\\\r\\\\n' +\\n  '   * 腹筋。`undefined` は「配筋なし」。本数は図面が「2-D10」と記載する数そのもの\\\\r\\\\n' +\\n  '   * なので 1通則7) の割付ではない。\\\\r\\\\n' +\\n  '   */\\\\r\\\\n' +\\n  '  sideBar?: {\\\\r\\\\n' +\\n  '    size: BarSize\\\\r\\\\n' +\\n  '    count: number\\\\r\\\\n' +\\n  '    /**\\\\r\\\\n' +\\n  '     * 梁の両端で内法を越えて伸びる余長 (mm)。数量積算基準 2（３）梁3) は\\\\r\\\\n' +\\n  '     * これを 1通則6) に委ね、同項は設計図書に記載がなければ JASS 5 準用と\\\\r\\\\n' +\\n  '     * する。JASS 5 は有料規格で未確保、標準仕様書5章には腹筋の記述が一切\\\\r\\\\n' +\\n  '     * ないため規準値を取れない — 設計図書の値を入力として受け取る (R9②)。\\\\r\\\\n' +\\n  '     */\\\\r\\\\n' +\\n  '    extraLengthMm: number\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 耐震壁 — ラーメン構造の壁である。壁式構造の壁ではない。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 数量積算基準 2（５）壁 は 1)「壁式構造以外」と 2)「壁式構造」を別条文で扱い、\\\\r\\\\n' +\\n  ' * 後者は端部筋・縦筋・壁梁筋・横筋・補強筋の5区分に分かれて条文の量がまるで違う。\\\\r\\\\n' +\\n  ' * ここが実装するのは 1) だけで、壁式構造は扱わない。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 幅止筋を持たないのは意図的だ。1通則3) は長さ（＝壁厚）を壁にも与えるが、\\\\r\\\\n' +\\n  ' * 本数を定める条文は 2（３）梁3) で梁しか名指しておらず、2（５）壁 に幅止筋の\\\\r\\\\n' +\\n  ' * 記述は一切ない。本数を製品が作らないと計上できない — 作らない (ADR-022 の腹筋と同じ判断)。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  'export interface WallSection {\\\\r\\\\n' +\\n  '  id: string\\\\r\\\\n' +\\n  \\\"  kind: '耐震壁'\\\\r\\\\n\\\" +\\n  '  mark: string\\\\r\\\\n' +\\n  '  /** ColumnSection.storyLabel と同じ。 */\\\\r\\\\n' +\\n  '  storyLabel?: string\\\\r\\\\n' +\\n  '  /**\\\\r\\\\n' +\\n  '   * 設計図書で判断した壁の区分。雑壁は別の MemberKind ではなく、壁の\\\\r\\\\n' +\\n  '   * かぶりと重ね継手下限だけを分ける。省略は既存案件との互換のため\\\\r\\\\n' +\\n  '   * 耐力壁として扱う (ADR-036)。\\\\r\\\\n' +\\n  '   */\\\\r\\\\n' +\\n  \\\"  wallClass?: '耐力壁' | '耐力壁以外'\\\\r\\\\n\\\" +\\n  '  /** 壁厚 (mm) */\\\\r\\\\n' +\\n  '  thickness: number\\\\r\\\\n' +\\n  '  fc: number\\\\r\\\\n' +\\n  '  grade: SteelGrade\\\\r\\\\n' +\\n  '  exposure: Exposure\\\\r\\\\n' +\\n  '  finish: Finish\\\\r\\\\n' +\\n  '  /** 縦筋・横筋の継手方式。継手箇所数と設計長さへの算入を決める */\\\\r\\\\n' +\\n  '  spliceMethod: SpliceMethod\\\\r\\\\n' +\\n  '  /**\\\\r\\\\n' +\\n  '   * 配筋の層数 — シングル(1) か ダブル(2) か。本数がそのまま倍違うが、\\\\r\\\\n' +\\n  '   * これを決める条文は規準にない。壁リストの「D13@200 ダブル」という記載\\\\r\\\\n' +\\n  '   * そのものであり、断面一覧の入力である (ADR-012)。\\\\r\\\\n' +\\n  '   */\\\\r\\\\n' +\\n  '  layers: 1 | 2\\\\r\\\\n' +\\n  '  /** 縦筋 — 上下の梁・床板へ定着する */\\\\r\\\\n' +\\n  '  vertical: {\\\\r\\\\n' +\\n  '    size: BarSize\\\\r\\\\n' +\\n  '    pitch: number\\\\r\\\\n' +\\n  '    /**\\\\r\\\\n' +\\n  '     * 内法端から第1・最終の縦筋をどれだけ離すか。柱の hoop・大梁の stirrup と\\\\r\\\\n' +\\n  '     * 同じ理由で規準に値がなく、断面一覧の入力である (ADR-012)。1通則7) は\\\\r\\\\n' +\\n  '     * 初期オフセットを見ないので数量には効かない — 3D 形状だけの値である。\\\\r\\\\n' +\\n  '     */\\\\r\\\\n' +\\n  '    startOffsetMm: number\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '  /** 横筋 — 両側の柱へ定着する */\\\\r\\\\n' +\\n  '  horizontal: {\\\\r\\\\n' +\\n  '    size: BarSize\\\\r\\\\n' +\\n  '    pitch: number\\\\r\\\\n' +\\n  '    /** 縦筋の startOffsetMm と同じ。こちらは内法高さの下端からの距離である。 */\\\\r\\\\n' +\\n  '    startOffsetMm: number\\\\r\\\\n' +\\n  '  }\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 床板（スラブ）の1方向・1面の主筋。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 径もピッチも断面リストの入力である。数量積算基準 2（４）床板1) が「トップ筋、\\\\r\\\\n' +\\n  ' * ハンチ部分の主筋、補強筋等は設計図書による」と委ね、規準側に本数を定める\\\\r\\\\n' +\\n  ' * 条文がない (ADR-012)。ここが規準から引くのは定着長さだけだ。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  'export interface SlabBarRow {\\\\r\\\\n' +\\n  '  size: BarSize\\\\r\\\\n' +\\n  '  pitch: number\\\\r\\\\n' +\\n  '  /**\\\\r\\\\n' +\\n  '   * 内法端から第1・最終の鉄筋をどれだけ離すか。柱の帯筋・大梁のあばら筋と\\\\r\\\\n' +\\n  '   * 同じ理由で規準に値がなく、断面一覧の入力である (ADR-012)。1通則7) は\\\\r\\\\n' +\\n  '   * 初期オフセットを見ないので数量には効かない — 3D 形状だけの値である。\\\\r\\\\n' +\\n  '   */\\\\r\\\\n' +\\n  '  startOffsetMm: number\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 床板（スラブ）— 数量積算基準 2（４）床板 で測る。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 測る対象は内法だ。躯体の区分（第4編第1章第2節（４））が床板を「柱、梁等に\\\\r\\\\n' +\\n  ' * 接する水平材の内法部分」と定めるので、長さは通り芯間ではなく両側の大梁の\\\\r\\\\n' +\\n  ' * 内側面の間である。柱・大梁と二重に計上しないのはこの定義による (ADR-028)。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * `exposure` を持たないのは表5.3.6 の構造そのものだ。同表の「スラブ、耐力壁\\\\r\\\\n' +\\n  ' * 以外の壁」行は仕上げの有無だけで分かれ、屋内・屋外の区別を**持たない** —\\\\r\\\\n' +\\n  ' * 「柱、梁、耐力壁」行と違う。入力に置くと画面に効かないつまみが並ぶ。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 幅止筋を持たないのは耐震壁と同じ理由である。1通則3) が長さを与える部材の\\\\r\\\\n' +\\n  ' * 列挙は「基礎梁、梁、壁梁、壁」で床板がなく、本数を定める条文もない。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  'export interface SlabSection {\\\\r\\\\n' +\\n  '  id: string\\\\r\\\\n' +\\n  \\\"  kind: '床板'\\\\r\\\\n\\\" +\\n  '  mark: string\\\\r\\\\n' +\\n  '  /** ColumnSection.storyLabel と同じ。 */\\\\r\\\\n' +\\n  '  storyLabel?: string\\\\r\\\\n' +\\n  '  /** 板厚 (mm) */\\\\r\\\\n' +\\n  '  thickness: number\\\\r\\\\n' +\\n  '  fc: number\\\\r\\\\n' +\\n  '  grade: SteelGrade\\\\r\\\\n' +\\n  '  finish: Finish\\\\r\\\\n' +\\n  '  /** 主筋の継手方式。継手箇所数と設計長さへの算入を決める */\\\\r\\\\n' +\\n  '  spliceMethod: SpliceMethod\\\\r\\\\n' +\\n  '  /** X通り方向（X軸に沿って伸びる）の主筋 */\\\\r\\\\n' +\\n  '  x: { top: SlabBarRow; bottom: SlabBarRow }\\\\r\\\\n' +\\n  '  /** Y通り方向の主筋 */\\\\r\\\\n' +\\n  '  y: { top: SlabBarRow; bottom: SlabBarRow }\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export type Section =\\\\r\\\\n' +\\n  '  | ColumnSection\\\\r\\\\n' +\\n  '  | GirderSection\\\\r\\\\n' +\\n  '  | WallSection\\\\r\\\\n' +\\n  '  | SlabSection\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 화면 표시·aria-label용 이름. 같은 符号이 階별로 여러 断面이 될 수 있으므로\\\\r\\\\n' +\\n  ' * 階를 여기서 붙인다 — 저장되는 `mark`는 도면의 符号 그대로 둔다.\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  'export function sectionMarkLabel(section: Section): string {\\\\r\\\\n' +\\n  '  return section.storyLabel\\\\r\\\\n' +\\n  '    ? `${section.mark}(${section.storyLabel})`\\\\r\\\\n' +\\n  '    : section.mark\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export interface ColumnPosition {\\\\r\\\\n' +\\n  '  ix: number\\\\r\\\\n' +\\n  '  iy: number\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export interface GirderPosition {\\\\r\\\\n' +\\n  \\\"  axis: 'X' | 'Y'\\\\r\\\\n\\\" +\\n  '  ix: number\\\\r\\\\n' +\\n  '  iy: number\\\\r\\\\n' +\\n  '}\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 耐震壁の位置。大梁と同じく通り芯の1スパン分の辺を占めるので形も同じである。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * TypeScript は構造的型付けなので、別名を作っても型としては GirderPosition と\\\\r\\\\n' +\\n  ' * 区別されない — どちらであるかを決めるのは常に `Member.kind` の方だ。位置だけを\\\\r\\\\n' +\\n  ' * 見て部材種別を判定するコードを書かないこと。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  'export type WallPosition = GirderPosition\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 床板の位置 — 通り芯で囲まれた1ベイを占める。(ix, iy) はそのベイの原点側\\\\r\\\\n' +\\n  ' * （X・Y とも小さい側）の格子点で、ベイは (ix, iy)〜(ix+1, iy+1) である。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 柱の ColumnPosition と形は同じ'... 1345 more characters\\n\"\n      ]\n    },\n    {\n      \"id\": \"no-auto-shape\",\n      \"status\": \"upheld\",\n      \"evidence\": [\n        \"SectionCandidate의 耐震壁 런타임 객체에는 thickness·layers만 있고 heightMm/lengthMm가 없다.\",\n        \"framing-plan의 MemberPlacement/PlanBlock에도 위치(ix/iy/axis)만 있고 벽 높이·길이 필드가 없다. spansMm는 그리드 스팬이며 특정 벽의 extent 치수가 아니다.\",\n        \"5개 실도면 expected 벽 레코드를 검사했으며 heightMm/lengthMm가 0건이다. 따라서 후보만으로 벽의 부분 높이·부분 길이를 자동 결정할 입력이 없다.\"\n      ]\n    },\n    {\n      \"id\": \"splice-rule-reusable\",\n      \"status\": \"upheld\",\n      \"evidence\": [\n        \"jpMlitRulePack의 measure.splice.wall.opening은 조건 {}에서 value=0箇所로 조회된다.\",\n        \"resolveWallSplice는 role=縦筋 && deducted일 때만 위 룰을 lookupRule(pack, key, {})로 호출한다. 벽 높이·길이/extent 조건이 없어 부분 높이 벽에서도 동일 행을 재사용할 수 있다.\"\n      ]\n    },\n    {\n      \"id\": \"no-overlap-guard\",\n      \"status\": \"upheld\",\n      \"evidence\": [\n        \"동일 story=1F, axis=Y, ix=0, iy=0에 벽 2개를 넣은 Project가 deserializeProject를 통과하고 같은 edge에 2개가 남는다.\",\n        \"project.ts의 hasIntactReferences는 section/story/grid 참조만 검사하고, PlanEditor도 배치·표시만 하며 같은 辺 중복 거부를 하지 않는다.\"\n      ]\n    }\n  ],\n  \"consumers\": [\n    {\n      \"file\": \"src/domain/model/project.ts\",\n      \"symbol\": \"wallSpan\",\n      \"reads\": \"Grid·양측 지지 柱·상부 大梁せい·Story 높이에서 wall clearLengthMm/clearHeightMm를 만든다. 현재 내법 영역 전체가 기준이다.\"\n    },\n    {\n      \"file\": \"src/domain/rebar/opening.ts\",\n      \"symbol\": \"openingDeduction\",\n      \"reads\": \"Opening.xMm/yMm/widthMm/heightMm를 clearXMm/clearYMm 원점 기준으로 읽고, 철근 배치 위치가 開口 내부일 때 欠除한다.\"\n    },\n    {\n      \"file\": \"src/domain/rebar/wall.ts\",\n      \"symbol\": \"wallLayerOffsets\",\n      \"reads\": \"壁厚·加工用かぶり에서 층별 z 오프셋만 읽는다. x/y 원점은 buildWallBars의 전체 내법 bodyLength/span에 남아 있다.\"\n    },\n    {\n      \"file\": \"src/lib/viewer/geometry.ts\",\n      \"symbol\": \"boxHoles / carveBox / clipSegments\",\n      \"reads\": \"boxHoles가 호출자가 준 inner-domain origin에 Opening.xMm/yMm를 더하고, carveBox와 clipSegments가 그 절대 2축 좌표로 솔리드·철근 표시를 자른다.\"\n    },\n    {\n      \"file\": \"src/lib/viewer/building.ts\",\n      \"symbol\": \"buildingLayout\",\n      \"reads\": \"wallSpan의 clear 치수·startFaceOffsetMm/elevation으로 벽 box와 world origin을 만들고, 같은 내법 원점의 openings를 geometry에 전달한다.\"\n    },\n    {\n      \"file\": \"src/components/plan/PlanEditor.tsx\",\n      \"symbol\": \"memberClearSize / OpeningEditor / slabOpeningRects\",\n      \"reads\": \"wallSpan/slabBay의 내법 크기로 입력을 제한하고, 평면 표시에서는 내법 원점 offset을 먼저 더한 뒤 Opening.xMm/yMm를 투영한다.\"\n    }\n  ],\n  \"verdict\": \"refuted\",\n  \"summary\": \"ADR-037 전제 중 하나 이상이 실행 검증에서 반증됐다. 각 check의 evidence를 후속 step의 입력으로 사용한다.\"\n}\n","exit_code":0,"status":"completed"}}
