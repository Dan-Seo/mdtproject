nsupported'\\r\\nimport { coverConditions, lookupRule } from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\nimport {\\r\\n  distributionCount,\\r\\n  intervalSpliceCount,\\r\\n  spliceCount,\\r\\n  spliceLengthMm,\\r\\n} from './measurement'\\r\\nimport { openingDeduction } from './opening'\\r\\nimport { stirrupPositions } from './stirrup-layout'\\r\\n\\r\\n/**\\r\\n * ?먬쐡鶯곻펷?⒲꺖?▲꺍礪뗩졼겗鶯곻펹??뀓嶺뗣귝빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯**1)**?뚦즯凉뤸쭓?졽빳鸚뽧?\\n * ?졼걨?믣츪獒끹걲????2)?뚦즯凉뤸쭓?졼띲겘塋?깿嶺뗣꺕鶯곫쥈嶺뗣겲?㎩뙷?녴걣罌쀣걟?뗥닪??씉?뉎겎?귙굥??\\n *\\r\\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬??\\n * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲쳵?뺛겘?롩쳵?㎯겘?ゃ걦?끾퀡遙섅걬?곲빓?뺛겘\\r\\n * ?긷퓘?볝겎??겒?뤷냵力뺡빓?뺛겓?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\\n *\\r\\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲????`Member.openings` ?뚦룛?묈룚?ｃ걼?끾퀡野멩퀡?졼걨??\\n * ?앫겗?뗥룭?믤Ø?뉎굥?с굮??걦?쀣곫쵟?ㅹ뇧?붵겏?ュ냵鼇녈겗烏뚣굮?녴걨?뗣귡뼀?ｃ굮與ゅ늾?ｃ걼\\r\\n * 潁?춮??텤?뗣겘?뚣걯 2竊덌폊竊됧즯1)????퐜?멥겎 0?뗦??ャ겒?뗣귡뼀?ｈ짒凉루춮??릪?끹걣\\r\\n * ?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겏冶붶뻣?쇻굥??겎獒썲뱚??퐳?됥겒??(ADR-029?팕14)??\\n */\\r\\nexport interface WallRebarInput {\\r\\n  member: Member\\r\\n  section: WallSection\\r\\n  span: WallSpan\\r\\n}\\r\\n\\r\\nfunction barDiameter(size: BarSize): number {\\r\\n  const diameter = Number(size.replace(/^D/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid BarSize: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\r\\n  if (rule.unit === 'mm') return rule.value\\r\\n  if (rule.unit === 'd' && diameter !== undefined) {\\r\\n    return rule.value * diameter\\r\\n  }\\r\\n\\r\\n  throw new Error(\\r\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function generateWallRebar(\\r\\n  input: WallRebarInput,\\r\\n  pack: RulePack,\\r\\n): Rebar[] {\\r\\n  const { member, section, span } = input\\r\\n  const conditions = { fc: section.fc, grade: section.grade, hook: false }\\r\\n\\r\\n  const coverQuery =\\r\\n    section.wallClass === '?먨뒟鶯곦빳鸚?\\r\\n      ? {\\r\\n          // 烏?.3.6 ??뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥띹죱??exposure ?믤똻?잆겒?꾠?\\n          // ?묈즯??닪??MemberKind ?㎯겘?ゃ걦?갮allSection ??뙷?녴겏?쀣겍?볝겗烏뚣굮?멥겤??\\n          memberKind: '?묈즯',\\r\\n          soilContact: false,\\r\\n          finish: section.finish,\\r\\n        }\\r\\n      : coverConditions(section)\\r\\n  const coverRule = lookupRule(pack, 'cover.minimum', coverQuery)\\r\\n  const fabricationCoverAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.fabrication.addition',\\r\\n    {},\\r\\n  )\\r\\n  // 若싩???〃5.3.4 ????у?L1?귛릪烏ⓦ겓鶯곩컗?ⓦ겗?쀣겘?ゃ걦?갟2 ??컦歟곥꺕L3 ??궧?⒲깣??\\n  // ?먦굢?뚣굥竊덅〃??걣?앫겗2?ㅳ걽?묆굮?띷뙁?숋펹??겎?곩즯嶺뗣겘訝?уㅳ굮凉뺛걦??\\n  const anchorageRule = lookupRule(pack, 'anchorage.L1', conditions)\\r\\n  const tableLapRule = lookupRule(pack, 'lap.L1', conditions)\\r\\n  // 5.3.4(3)(節? ??툔?먦겘?먨뒟鶯곥걽?묆겓?⑴뵪?쇻굥?귟먨뒟鶯곦빳鸚뽧겘\\r\\n  // 烏?.3.2 ??L1 ?졼걨?믢슴?꾠걄ookupRule ?ャ굚?γ굢?ゃ걚 (ADR-036 ??き????\\n  const wallLapMinimumRule =\\r\\n    section.wallClass === '?먨뒟鶯곦빳鸚?\\r\\n      ? undefined\\r\\n      : lookupRule(pack, 'lap.wall.minimum', {})\\r\\n  const spliceFactorRule = lookupRule(pack, 'measure.splice.length.factor', {\\r\\n    method: section.spliceMethod,\\r\\n  })\\r\\n  const distributionAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'measure.distribution.addition',\\r\\n    {},\\r\\n  )\\r\\n\\r\\n  const minimumCover = millimetres(coverRule)\\r\\n  const fabricationCover =\\r\\n    minimumCover + millimetres(fabricationCoverAdditionRule)\\r\\n  const layerOffsets = wallLayerOffsets(member, section, fabricationCover)\\r\\n\\r\\n  const shared = {\\r\\n    member,\\r\\n    section,\\r\\n    span,\\r\\n    layerOffsets,\\r\\n    anchorageRule,\\r\\n    tableLapRule,\\r\\n    wallLapMinimumRule,\\r\\n    spliceFactorRule,\\r\\n    distributionAdditionRule,\\r\\n    coverRule,\\r\\n    fabricationCoverAdditionRule,\\r\\n    fabricationCover,\\r\\n    pack,\\r\\n  }\\r\\n\\r\\n  return [\\r\\n    ...buildWallBars({\\r\\n      ...shared,\\r\\n      role: '潁?춮',\\r\\n      size: section.vertical.size,\\r\\n      pitchMm: section.vertical.pitch,\\r\\n      startOffsetMm: section.vertical.startOffsetMm,\\r\\n      // 潁?춮??즯??쳵?뺛굮歷с굤?곩냵力뺡빓?뺛겓?꿔굤餓섅걨?뗣?\\n      bodyLengthMm: span.clearHeightMm,\\r\\n      distributionOverMm: span.clearLengthMm,\\r\\n      bodyLabel: '?끾퀡遙섅걬',\\r\\n      distributionLabel: '?끾퀡?룔걬',\\r\\n      repeatAxis: 'x',\\r\\n      barAxis: 'y',\\r\\n    }),\\r\\n    ...buildWallBars({\\r\\n      ...shared,\\r\\n      role: '與ょ춮',\\r\\n      size: section.horizontal.size,\\r\\n      pitchMm: section.horizontal.pitch,\\r\\n      startOffsetMm: section.horizontal.startOffsetMm,\\r\\n      // 與ょ춮??즯??빓?뺛굮歷с굤?곩냵力뺡쳵?뺛겓?꿔굤餓섅걨?뗣?\\n      bodyLengthMm: span.clearLengthMm,\\r\\n      distributionOverMm: span.clearHeightMm,\\r\\n      bodyLabel: '?끾퀡?룔걬',\\r\\n      distributionLabel: '?끾퀡遙섅걬',\\r\\n      repeatAxis: 'y',\\r\\n      barAxis: 'x',\\r\\n    }),\\r\\n    ...openingReinforcementRebars(member),\\r\\n  ]\\r\\n}\\r\\n\\r\\nfunction openingReinforcementRebars(member: Member): Rebar[] {\\r\\n  return (member.openings ?? []).flatMap((opening) =>\\r\\n    (opening.reinforcements ?? []).flatMap((reinforcement, index) => {\\r\\n      // A zero length is the UI's persisted ?よ빪鼇?state. Do not expose it as\\r\\n      // a zero-quantity Rebar, which would make the row look transcribed.\\r\\n      if (reinforcement.lengthMm === 0) return []\\r\\n\\r\\n      return [{\\r\\n        id: `${member.id}|opening-${opening.id}|reinforcement-${index}`,\\r\\n        memberId: member.id,\\r\\n        role: '?뗥룭獒쒎섭嶺?,\\r\\n        size: reinforcement.size,\\r\\n        count: reinforcement.count,\\r\\n        length: reinforcement.lengthMm,\\r\\n        shape: 'straight',\\r\\n        points: [\\r\\n          [0, 0, 0],\\r\\n          [reinforcement.lengthMm, 0, 0],\\r\\n        ],\\r\\n        closed: false,\\r\\n        formula:\\r\\n          `鼇?쮫?룔걬 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.lengthMm}mm 竊?` +\\r\\n          `?ф빊 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.count}??竊?孃?竊?${reinforcement.size} ` +\\r\\n          `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ?ゃ걡?멥걤 ???뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑?ャ굠?딂쮫歷с꺕鼇덄츞竊?,\\r\\n        ruleHits: [],\\r\\n      }]\\r\\n    }),\\r\\n  )\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?띸춮??광?뚦즯?싥겗?⒲걪?ョ쳦?ㅳ걢 (mm)?귙??뽧꺂??륫?㏂겗?뗣겤?듾퐤營?곥궥?녈궛?ャ겘\\r\\n * ?싥걬??릎鸚?겎?귙굥??D 壤®듁?ャ걮?뗥듅?뗣겒?????곈뇧??광?겹걽?묆굮誤뗣굥??\\n */\\r\\nfunction wallLayerOffsets(\\r\\n  member: Member,\\r\\n  section: WallSection,\\r\\n  fabricationCover: number,\\r\\n): number[] {\\r\\n  if (section.layers === 1) return [section.thickness / 2]\\r\\n\\r\\n  const inner = section.thickness - fabricationCover\\r\\n\\r\\n  // ?졾램?ⓦ걢?뜰굤횞2 ?뚦즯?싥굮擁끹걟?뗣겏2掠ㅳ걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂?잌즯?ャ겒?뗣?\\n  // 容쇻겂?╊릎鸚?겓野꾠걵?싥곥걹??깿?먦걽?묋맼?ⓦ걲竊덃윶??뒥藥ε?力뺛궗?쇈깋?ⓨ릪?섉돮?꾬펹??\\n  if (inner <= fabricationCover) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?먬쐡鶯???뽧꺂?띸춮 must fit the 鶯곩럻: ${member.id} ` +\\r\\n        `(鶯곩럻 ${section.thickness} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCover})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return [fabricationCover, inner]\\r\\n}\\r\\n\\r\\ninterface WallBarInput {\\r\\n  member: Member\\r\\n  section: WallSection\\r\\n  span: WallSpan\\r\\n  role: '潁?춮' | '與ょ춮'\\r\\n  size: BarSize\\r\\n  pitchMm: number\\r\\n  startOffsetMm: number\\r\\n  bodyLengthMm: number\\r\\n  distributionOverMm: number\\r\\n  bodyLabel: string\\r\\n  distributionLabel: string\\r\\n  repeatAxis: 'x' | 'y'\\r\\n  /** ?꾤춮?뚩뎔?뗥릲????濚겹굤瓦붵걮邕멥겏?답벡?쇻굥?귡뼀?ｉ깿??쵟?ㅳ걣?볝굦?믦쫳??*/\\r\\n  barAxis: 'x' | 'y'\\r\\n  layerOffsets: number[]\\r\\n  anchorageRule: RuleHit\\r\\n  tableLapRule: RuleHit\\r\\n  wallLapMinimumRule: RuleHit | undefined\\r\\n  spliceFactorRule: RuleHit\\r\\n  distributionAdditionRule: RuleHit\\r\\n  coverRule: RuleHit\\r\\n  fabricationCoverAdditionRule: RuleHit\\r\\n  fabricationCover: number\\r\\n  pack: RulePack\\r\\n}\\r\\n\\r\\nfunction buildWallBars(input: WallBarInput): Rebar[] {\\r\\n  const {\\r\\n    member,\\r\\n    section,\\r\\n    span,\\r\\n    role,\\r\\n    size,\\r\\n    pitchMm,\\r\\n    startOffsetMm,\\r\\n    bodyLengthMm,\\r\\n    distributionOverMm,\\r\\n    bodyLabel,\\r\\n    distributionLabel,\\r\\n    repeatAxis,\\r\\n    barAxis,\\r\\n    layerOffsets,\\r\\n    anchorageRule,\\r\\n    tableLapRule,\\r\\n    wallLapMinimumRule,\\r\\n    spliceFactorRule,\\r\\n    distributionAdditionRule,\\r\\n    coverRule,\\r\\n    fabricationCoverAdditionRule,\\r\\n    fabricationCover,\\r\\n    pack,\\r\\n  } = input\\r\\n\\r\\n  const diameter = barDiameter(size)\\r\\n  const anchorageMm = millimetres(anchorageRule, diameter)\\r\\n  const tableLapMm = millimetres(tableLapRule, diameter)\\r\\n  const lapCandidates = [\\r\\n    tableLapMm,\\r\\n    ...(wallLapMinimumRule\\r\\n      ? [millimetres(wallLapMinimumRule, diameter)]\\r\\n      : []),\\r\\n  ]\\r\\n  const lapMm = Math.max(...lapCandidates)\\r\\n\\r\\n  // 1?싧뎴7) ??돯餓섉쑍?겹겘1掠ㅵ늽?졼귛광?곤펷?룔꺍?겹꺂竊뤵??뽧꺂竊됥겘誤뤸틬?㎯겘?ゃ걦\\r\\n  // 鶯곥꺁?밤깉??쮼雍됥겎?귙굤?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)??\\n  const perLayerCount = distributionCount(\\r\\n    distributionOverMm,\\r\\n    pitchMm,\\r\\n    distributionAdditionRule,\\r\\n  )\\r\\n  const layout = stirrupPositions(distributionOverMm, pitchMm, startOffsetMm)\\r\\n\\r\\n  // 1?싧뎴8) ???뗥룭?ⓦ굮與ゅ늾?뗦쑍?졼걨?뚪뼀?ｃ겗?끾퀡野멩퀡?졼걨??걦?ゃ굥?귝쵟?ㅹ뇧?붵겏??\\n  // ?낁㉢??죱?뚦늽?뗣굦?뗰펷1?싧뎴 ?띷뻼?뚩쫸?쇈곩숱?뜰곩?力뺟춬?붵겏?ャ랃펹??\\n  const deduction = openingDeduction(\\r\\n    {\\r\\n      openings: member.openings ?? [],\\r\\n      clearXMm: span.clearLengthMm,\\r\\n      clearYMm: span.clearHeightMm,\\r\\n      barAxis,\\r\\n      pitchMm,\\r\\n      totalCount: perLayerCount,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  const openingLayout = deduction.layout\\r\\n  const ignoredTerm =\\r\\n    deduction.ignored.length === 0\\r\\n      ? ''\\r\\n      : ` 竊?轝좈솮?쀣겒?꾦뼀??${deduction.ignored\\r\\n          .map(({ widthMm, heightMm }) => `${widthMm}횞${heightMm}`)\\r\\n          .join('??)}竊??싧뎴8) 鵝녷쎑 ??1?뗦?壤볝걼?듿냵力뺡씊令?.5?▽빳訝뗰펹`\\r\\n\\r\\n  // 3D ?ユ룒?뗣굦?뗧탪瓮?귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?ゃ걚竊덅〃5.3.3 ?뚦렅?뉎겎?삣깗竊됥?\\n  // ?뗥룭??쵟?묆굚?볝걪?ャ겘?얇굦?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝??겎?곮〃鹽븅깿??\\n  // `Member.openings` ?㎩늾??(ADR-029)??\\n  const pathLengthMm = bodyLengthMm + 2 * anchorageMm\\r\\n\\r\\n  const anchorageTarget = role === '潁?춮' ? '訝듾툔??ㄷ歟곥꺕佯딀씮' : '訝▼겢??윶'\\r\\n  const layerTerm =\\r\\n    section.layers === 1 ? '?룔꺍?겹꺂?띸춮 횞1' : `??뽧꺂?띸춮 횞${section.layers}`\\r\\n  const roleKey = role === '潁?춮' ? 'vertical' : 'horizontal'\\r\\n\\r\\n  const zones: RebarZone[] = [\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: anchorageRule.key,\\r\\n      pathFromMm: 0,\\r\\n      pathToMm: anchorageMm,\\r\\n    },\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: anchorageRule.key,\\r\\n      pathFromMm: pathLengthMm - anchorageMm,\\r\\n      pathToMm: pathLengthMm,\\r\\n    },\\r\\n  ]\\r\\n\\r\\n  // 餓ｈ〃1?с겘濚겹굤瓦붵걮邕멥겗?잏궧?ョ쉰????若잓슋??퐤營?겘 placement ?뚥툗?덀굥??\\n  // 躍?춮?삠걗?겹굢嶺뗣겏?뚣걯榮꾣씇?㎯곮〃鹽븅깿?뚧뼪?㏂걢?됥깞?껁긽?믤떮?꾤쎍?뺛겒?꾠걼?곥겎?귙굥??\\n  const z = layerOffsets[0]\\r\\n  const points: [number, number, number][] =\\r\\n    role === '潁?춮'\\r\\n      ? [\\r\\n          [0, -anchorageMm, z],\\r\\n          [0, bodyLengthMm + anchorageMm, z],\\r\\n        ]\\r\\n      : [\\r\\n          [-anchorageMm, 0, z],\\r\\n          [bodyLengthMm + anchorageMm, 0, z],\\r\\n        ]\\r\\n\\r\\n  return deduction.groups.map(({ deductionMm, count: groupCount }) => {\\r\\n    // 1?싧뎴4) ?뚨텤?뗧츋??겹굮黎귙굙?뗣뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띲겘轝좈솮孃뚣겗?룔걬?졼?\\n    const measuredLengthMm = bodyLengthMm - deductionMm + 2 * anchorageMm\\r\\n\\r\\n    const splice = resolveWallSplice({\\r\\n      role,\\r\\n      section,\\r\\n      size,\\r\\n      measuredLengthMm,\\r\\n      lapMm,\\r\\n      deducted: deductionMm > 0,\\r\\n      tableLapRule,\\r\\n      wallLapMinimumRule,\\r\\n      spliceFactorRule,\\r\\n      pack,\\r\\n    })\\r\\n\\r\\n    const designLengthMm = measuredLengthMm + splice.lengthMm\\r\\n    const count = groupCount * section.layers\\r\\n    const positionsMm = openingLayout\\r\\n      ? openingLayout.positionsMm.filter(\\r\\n          (_, index) => openingLayout.deductionsMm[index] === deductionMm,\\r\\n        )\\r\\n      : null\\r\\n\\r\\n    const deductionTerm =\\r\\n      deductionMm === 0\\r\\n        ? ''\\r\\n        : ` ???뗥룭?ⓦ겗轝좈솮 ${deductionMm}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??兩뷴끁窈욅춬` +\\r\\n          `?뗥룭?ⓦ겗?끾퀡野멩퀡?ャ굠?뗰펹`\\r\\n    const splitTerm =\\r\\n      deduction.groups.length === 1\\r\\n        ? ''\\r\\n        : ` ??걝??{\\r\\n            deductionMm === 0 ? '?뗥룭?믤Ø?뉎굢?ゃ걚' : `${deductionMm}?믤쵟??\\r\\n          } ${groupCount}??\\r\\n\\r\\n    return {\\r\\n      id: `${member.id}|${roleKey}${\\r\\n        deductionMm === 0 ? '' : `|轝좈솮${deductionMm}`\\r\\n      }`,\\r\\n      memberId: member.id,\\r\\n      role,\\r\\n      size,\\r\\n      shape: 'straight' as const,\\r\\n      points,\\r\\n      closed: false,\\r\\n      length: designLengthMm,\\r\\n      count,\\r\\n      placement: {\\r\\n        axis: repeatAxis,\\r\\n        clearMm: distributionOverMm,\\r\\n        pitchMm,\\r\\n        startOffsetMm,\\r\\n        lastGapMm: layout.lastGapMm,\\r\\n        positionCount: positionsMm\\r\\n          ? positionsMm.length\\r\\n          : layout.positionsMm.length,\\r\\n        ...(positionsMm ? { positionsMm } : {}),\\r\\n      },\\r\\n      splice,\\r\\n      zones,\\r\\n      ruleHits: [\\r\\n        coverRule,\\r\\n        fabricationCoverAdditionRule,\\r\\n        anchorageRule,\\r\\n        distributionAdditionRule,\\r\\n        ...deduction.rules,\\r\\n        ...splice.rules,\\r\\n      ],\\r\\n      formula:\\r\\n        `鼇?쮫?룔걬 竊?${bodyLabel} ${bodyLengthMm}${deductionTerm} 竊?若싩? L1 ` +\\r\\n        `${anchorageRule.value}d(${anchorageMm}) 횞 2竊덁륫塋???${anchorageTarget}?멨츣?竊? +\\r\\n        ` 竊?泳숁뎸 ${splice.formula} 竊?${designLengthMm} 竊?` +\\r\\n        `?ф빊 竊???{distributionLabel} ${distributionOverMm} 첨 ?붵긿??${pitchMm}??` +\\r\\n        `竊?${distributionAdditionRule.value}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴7)竊됵폓 ${perLayerCount}` +\\r\\n        `${splitTerm} 횞 ${layerTerm} 竊?${count} 竊?` +\\r\\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊??좂츞 ` +\\r\\n        `${fabricationCoverAdditionRule.value} 竊?${fabricationCover}竊?竊?` +\\r\\n        `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚竊덃룒?뗣굦?뗩빓??` +\\r\\n        `${pathLengthMm} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹${ignoredTerm}`,\\r\\n    }\\r\\n  })\\r\\n}\\r\\n\\r\\ninterface WallSpliceInput {\\r\\n  role: '潁?춮' | '與ょ춮'\\r\\n  section: WallSection\\r\\n  size: BarSize\\r\\n  /** 1?싧뎴4) ?뚩??녴뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띯??뗥룭?ⓦ겗轝좈솮?믣폊?꾠걼孃뚣겎?귙굥 */\\r\\n  measuredLengthMm: number\\r\\n  lapMm: number\\r\\n  /** ?볝겗獰ㅳ걣?뗥룭?ⓦ굮與ゅ늾?ｃ겍??걼?뚣겍?꾠굥??(2竊덌폊竊됧즯1)??鵝녷쎑) */\\r\\n  deducted: boolean\\r\\n  tableLapRule: RuleHit\\r\\n  wallLapMinimumRule: RuleHit | undefined\\r\\n  spliceFactorRule: RuleHit\\r\\n  pack: RulePack\\r\\n}\\r\\n\\r\\n/**\\r\\n * 2竊덌폊竊됧즯1)????潁?춮?ⓩØ嶺뗣겎?겹걟?밤걣?녴걢?뚣굥?????씉?뉎겎?귙굥??\\n * ?뚨를嶺뗣겗泳숁뎸??렅?뉎겏?쀣겍?꾦쉸?ワ폂?뗦??귙굥?귙겗?ⓦ걮?╈╉겲?잆곫Ø嶺뗣겗泳숁뎸???\\n *  竊묌싧뎴竊뷂펹?ャ굠?뗣띲?\\n */\\r\\nfunction resolveWallSplice(input: WallSpliceInput): RebarSplice {\\r\\n  const {\\r\\n    role,\\r\\n    section,\\r\\n    size,\\r\\n    measuredLengthMm,\\r\\n    lapMm,\\r\\n    deducted,\\r\\n    tableLapRule,\\r\\n    wallLapMinimumRule,\\r\\n    spliceFactorRule,\\r\\n    pack,\\r\\n  } = input\\r\\n\\r\\n  let countRule: RuleHit\\r\\n  let countPerBar: number\\r\\n  let countFormula: string\\r\\n\\r\\n  if (role === '潁?춮' && deducted) {\\r\\n    // ?뗥룭?믤Ø?뉎굥潁?춮??쉸遙섇뀲鵝볝겓?뤵걼?됥걳?곲뼀?ｉ깿?겼즯?삣엩?뚦즯??를嶺뗣겓?ゃ굥??\\n    // ?뚣걯?끹겗鵝녷쎑?뚣뚪뼀?ｉ깿?겼즯?곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗣띲겏若싥굙?뗣?\\n    countRule = lookupRule(pack, 'measure.splice.wall.opening', {})\\r\\n    countPerBar = spliceCount(countRule)\\r\\n    countFormula =\\r\\n      `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)??鵝녷쎑 ??` +\\r\\n      `?뗥룭?②뀺鶯곥곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗰펹`\\r\\n  } else if (role === '潁?춮') {\\r\\n    countRule = lookupRule(pack, 'measure.splice.wall.vertical', {})\\r\\n    countPerBar = spliceCount(countRule)\\r\\n    countFormula = `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????潁?춮??텤?뗣겘?꾦쉸???뗦?竊?\\r\\n  } else {\\r\\n    countRule = lookupRule(pack, 'measure.splice.interval', { size })\\r\\n    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\\r\\n    countFormula =\\r\\n      `?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏 竊?${countPerBar}?뗦?` +\\r\\n      `竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????1?싧뎴4) ?ユ댗?숋펹`\\r\\n  }\\r\\n\\r\\n  const lengthMm = spliceLengthMm(countPerBar, lapMm, spliceFactorRule)\\r\\n  const rules: RuleHit[] = [countRule, spliceFactorRule]\\r\\n  if (lengthMm > 0) {\\r\\n    rules.push(tableLapRule)\\r\\n    if (wallLapMinimumRule) rules.push(wallLapMinimumRule)\\r\\n  }\\r\\n\\r\\n  const lapTerm =\\r\\n    lengthMm > 0\\r\\n      ? wallLapMinimumRule\\r\\n        ? `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 5.3.4(3)(節? ??` +\\r\\n          `烏?.3.2 ??${tableLapRule.value}d ?②먨뒟鶯곥겗訝뗩솏 ` +\\r\\n          `${wallLapMinimumRule.value}d ??ㄷ?띲걚?뱄펹竊?${lengthMm}`\\r\\n        : `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 烏?.3.2 ` +\\r\\n          `??${tableLapRule.value}d ??겳??.3.4(3)(節? ??먨뒟鶯곲솏若???` +\\r\\n          `?먨뒟鶯곦빳鸚뽧겘烏?.3.2??겳竊뉯DR-036??き?울펹竊됵폓 ${lengthMm}`\\r\\n      : `${countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\\r\\n\\r\\n  return {\\r\\n    method: section.spliceMethod,\\r\\n    countPerBar,\\r\\n    lengthMm,\\r\\n    rules,\\r\\n    formula:\\r\\n      `泳숁뎸嶸뉑???竊?${countFormula} 竊??밧폀 竊?${section.spliceMethod} 竊?` +\\r\\n      `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${lapTerm} 竊?` +\\r\\n      `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\\r\\n  }\\r\\n}\\r\\n\\r\\n--- opening.ts ---\\r\\nimport type { Opening } from '../model/member'\\r\\nimport { MemberUnsupportedError } from '../model/unsupported'\\r\\nimport { lookupRule } from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\n\\r\\n/**\\r\\n * ?뗥룭?ⓦ겓?덀굥?꾤춮??쵟??(?곈뇧令띸츞?뷸틬 1?싧뎴8))??\\n *\\r\\n * ?뚨첆?곩눣?ε룭嶺됥겗?뗥룭?ⓦ겓?덀굥?꾤춮??쵟?ㅳ겘?곩렅?뉎겏?쀣겍兩뷴끁窈욅춬?뗥룭?ⓦ겗?끾퀡野멩퀡??\\n *   ?덀굥?귙걼?졼걮?곻폂?뗦?壤볝걼?듿냵力뺡씊令랃폁竊롳폊?▽빳訝뗣겗?뗥룭?ⓦ겓?덀굥?꾤춮??쵟?ㅳ겘\\r\\n *   ?잌뎴?ⓦ걮?╉겒?꾠굚??겏?쇻굥?귙겒?듽곲뼀?ｈ짒凉루춮??Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣귙?\\n *\\r\\n * ?→뻼?뚦츣?곥굥??겘**轝좈솮?쇻굥??*竊덆뼀?ｃ겗?끾퀡野멩퀡竊됥겏**轝좈솮?쀣겒?꾢ㄷ?띲걬**竊?.5?∽펹??\\n * 雅뚣겇?졼걨?㎯곥뚣겑??쑍?뚧쵟?묆굥?뗣띲겘鼇?뤵겒?꾠귟＝?곥겘?앫걪??1?싧뎴7) ??돯餓섅걢?됭き? ??\\n * ?뚪쟿?뚧쑍?겹굮?뚢뙂?앫겗?ⓨ늽??빓??첨 ?볣슂??竊?1?띲겏若싥굙?뗣겗?㎯곥걹??츞凉뤵겑?듽굤??\\n * i ?х쎅??`min(i횞?볣슂, ?앫겗?ⓨ늽??빓??` ?ョ쉰?띲곲뼀?ｃ겗?끾퀡野멩퀡??*?끻겢**?ユ씎?잍쑍\\r\\n * ?졼걨?믤쵟?묆걼?귙겗?ⓦ걲?뗣귛쥊?뚣겓?▲굟?녴겑雍됥굥?с겘轝졼걨?ゃ걚竊덂쨼?담겗?꾤춮?믤쵟?ㅳ걮?ゃ걚竊됥?\\n *\\r\\n * ?볝겗訝╉겧?밤겘 1?싧뎴7) ??き?욘뼶?㎯걗?ｃ겍?잍뻼?뚦쎋?㎫ㅊ?쇻굚??겎??겒??(ADR-029?팕2)??\\n * ??씊訝誤㎯겗?앮쐿?ゃ깢?삠긿?덀겘鵝욍굩?ゃ걚 ??令띸츞?뷸틬??걹?뚣굮?®윥?쀣겒?꾠걢?됥겎??\\n * `stirrupPositions` ??3D ??걼?곥겓營?걦鵝띸쉰?ⓦ겘?η돥?㎯걗??(ADR-019)??\\n *\\r\\n * ?뗥룭獒쒎섭嶺뗣겘?볝걪?ャ겒?꾠귛릪?끹걣?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겏冶붶뻣?쇻굥??겎??\\n * 2竊덌폆竊됪쥈1)??竊덌폇竊됧틞??) ??뚩짒凉루춮嶺됥겘鼇?쮫?녔쎑?ャ굠?뗣띲겏?뚣걯?뤺＝?곥겘鵝쒌굢?ゃ걚??\\n */\\r\\nexport interface OpeningDeductionGroup {\\r\\n  /** ?볝겗獰ㅳ겗1?с걗?잆굤轝좈솮?룔걬 (mm)?? ??뼀?ｃ굮與ゅ늾?됥겒?꾣쑍??쑈?㎯걗??*/\\r\\n  deductionMm: number\\r\\n  count: number\\r\\n}\\r\\n\\r\\nexport interface OpeningDeductionInput {\\r\\n  openings: Opening[]\\r\\n  /** ?ⓩ쓲?끾퀡?잆겗掠? x ?밧릲??빓??(mm) */\\r\\n  clearXMm: number\\r\\n  /** ?뚣걯?뤷?? y ?밧릲 (mm) */\\r\\n  clearYMm: number\\r\\n  /** ?꾤춮?뚩뎔?뗥릲?띲?x' ?ゃ굢掠? x ?ヤ섯?녈겍 y ?멧를??*/\\r\\n  barAxis: 'x' | 'y'\\r\\n  pitchMm: number\\r\\n  /** 1?싧뎴7) ?뚧빊?덀걼?꿜퍡?ф빊?귙걪??뼟?겹겘?겹걟?담걬?ゃ걚 */\\r\\n  totalCount: number\\r\\n}\\r\\n\\r\\nexport interface OpeningDeduction {\\r\\n  /** 轝좈솮?뤵겗?뉔젂?귡뼀?ｃ걣?ゃ걨?뚣겙?룔걬1竊덂뀲?겹걣轝좈솮 0竊?*/\\r\\n  groups: OpeningDeductionGroup[]\\r\\n  /** 鵝녷쎑?㎪쵟?ㅳ걮?ゃ걢?ｃ걼?뗥룭 ??嶸쀥눣凉뤵걣?볝굦?믣릫?뉎걲 */\\r\\n  ignored: Opening[]\\r\\n  /** 轝좈솮??닩若싥겓若잓슋?ュ듅?꾠걼烏뚣귡뼀?ｃ걣訝?ㅳ굚?ゃ걨?뚣겙令뷩겎?귙굥 */\\r\\n  rules: RuleHit[]\\r\\n  /**\\r\\n   * 若잓슋?ユ쵟?ㅳ걣壅룔걤?잆겏?띲걽?묆겗???싧뎴7) ??돯餓섅걣營?걦鵝띸쉰 (mm) ?ⓦ곥걹??퐤營?겗\\r\\n   * ?с걣轝졼걦?룔걬 (mm)?귛릪?섉렌耶쀣걣野얍퓶?쇻굥??\\n   *\\r\\n   * 3D ??겣?졼굯??씊訝誤㎯겗?앮쐿?ゃ깢?삠긿?덀걢?됦퐤營?굮鵝쒌굥 (`stirrupPositions`) ?뚣?\\n   * ?뗥룭??걗?뗩깿?먦겎??걪?▲굢?ユ룂?덀굥 ???곈뇧?뚣뚣겑??쑍?뚧쵟?묆걼?뗣띲굮鼇?ｃ겍?꾠굥\\r\\n   * ??겓??D ?뚣걹?뚣겏??닪??쑍?믤쵟?뗣걵?╉겘?삯씊?뚧빊?뤵굮沃ф삇?쀣겒?뤵겒?뗣걢?됥걽??\\n   * 轝좈솮?뚣겒?묆굦??null ?㎯곥걹??겏?띲겘訝╉겧?밤굮鸚됥걟?뗧릤?긱걣?ゃ걚 (ADR-029)??\\n   */\\r\\n  layout: { positionsMm: number[]; deductionsMm: number[] } | null\\r\\n}\\r\\n\\r\\n/** ???㎪쎑?뗣굦?잓씊令띲겗烏뚣굮 mm짼 ?ョ쎍?쇻귙꺂?쇈꺂?묆긿??겘?잍뻼??뜕鵝띲겗?얇겲?곥겇??*/\\r\\nfunction squareMillimetres(rule: RuleHit): number {\\r\\n  if (rule.unit !== '??) {\\r\\n    throw new Error(`Rule ${rule.key} must use ?? ${rule.unit}`)\\r\\n  }\\r\\n\\r\\n  return rule.value * 1_000_000\\r\\n}\\r\\n\\r\\nfunction assertInsideMember(\\r\\n  opening: Opening,\\r\\n  clearXMm: number,\\r\\n  clearYMm: number,\\r\\n): void {\\r\\n  const { id, xMm, yMm, widthMm, heightMm } = opening\\r\\n\\r\\n  if (widthMm <= 0 || heightMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?뗥룭?ⓦ겗?끾퀡野멩퀡?뚧??㎯겒?? ${id} (${widthMm}횞${heightMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  if (\\r\\n    xMm < 0 ||\\r\\n    yMm < 0 ||\\r\\n    xMm + widthMm > clearXMm ||\\r\\n    yMm + heightMm > clearYMm\\r\\n  ) {\\r\\n    // ?끾퀡?뗣굢??겳?뷩걲?뗥룭?믣늾?딂ŉ?곥겍?쀣걨?뽧굥?ⓦ곩쎋?㏂겓?ゃ걚鸚㎯걤?뺛겗?뗥룭??\\n    // 獒썲뱚?뚧군?곥굥?볝겏?ャ겒??(ADR-004)?귛뀯?쎼겗沃ㅳ굤?ⓦ걮??깿?먦걫?②맼?ⓦ걲??\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?뗥룭?ⓦ걣?ⓩ쓲??냵力뺛굮??겳?뷩걲: ${id} ` +\\r\\n        `(${xMm},${yMm})竊?{widthMm}횞${heightMm} > ${clearXMm}횞${clearYMm}`,\\r\\n    )\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function openingDeduction(\\r\\n  input: OpeningDeductionInput,\\r\\n  pack: RulePack,\\r\\n): OpeningDeduction {\\r\\n  const { openings, clearXMm, clearYMm, barAxis, pitchMm, totalCount } = input\\r\\n\\r\\n  if (openings.length === 0) {\\r\\n    return {\\r\\n      groups: [{ deductionMm: 0, count: totalCount }],\\r\\n      ignored: [],\\r\\n      rules: [],\\r\\n      layout: null,\\r\\n    }\\r\\n  }\\r\\n\\r\\n  const minimumAreaRule = lookupRule(\\r\\n    pack,\\r\\n    'measure.opening.deduction.minimum.area',\\r\\n    {},\\r\\n  )\\r\\n  const minimumAreaMm2 = squareMillimetres(minimumAreaRule)\\r\\n\\r\\n  const ignored: Opening[] = []\\r\\n  const deducting: Opening[] = []\\r\\n  for (const opening of openings) {\\r\\n    assertInsideMember(opening, clearXMm, clearYMm)\\r\\n\\r\\n    // ?뚳폂?뗦?壤볝걼?듿냵力뺡씊令랃폁竊롳폊?▽빳訝뗢╈╉겘轝좈솮?쀣겒?꾠띯?罌껆쎅?▲굟?녴겑??쵟?ㅳ걮?ゃ걚??\\n    if (opening.widthMm * opening.heightMm <= minimumAreaMm2) {\\r\\n      ignored.push(opening)\\r\\n      continue\\r\\n    }\\r\\n    deducting.push(opening)\\r\\n  }\\r\\n\\r\\n  // 壅겹굥?묆걤??x ?ゃ굢 y ?ヤ를?녈곫쵟?ㅳ걲?뗣겗??뼀?ｃ겗 x ?밧릲??냵力뺝?力뺛겎?귙굥??\\n  const alongClearMm = barAxis === 'x' ? clearXMm : clearYMm\\r\\n  const distributionClearMm = barAxis === 'x' ? clearYMm : clearXMm\\r\\n  const crossing = (opening: Opening): [number, number] =>\\r\\n    barAxis === 'x'\\r\\n      ? [opening.yMm, opening.yMm + opening.heightMm]\\r\\n      : [opening.xMm, opening.xMm + opening.widthMm]\\r\\n  const deductionOf = (opening: Opening): number =>\\r\\n    barAxis === 'x' ? opening.widthMm : opening.heightMm\\r\\n\\r\\n  const counts = new Map<number, number>()\\r\\n  const positionsMm: number[] = []\\r\\n  const deductionsMm: number[] = []\\r\\n  for (let index = 0; index < totalCount; index += 1) {\\r\\n    // 1?싧뎴7) ??뚢뙂?앫겗?ⓨ늽??빓??첨 ?볣슂??竊?1?띲굮鵝띸쉰?ⓦ걮??き??귝?孃뚣겗1?с겘\\r\\n    // ?ⓨ늽??탞?뤵굤?ョ쳦?ㅳ겗?㎯곲뼋?붵겗?띷빊?뚪빓?뺛굮擁듽걟?잆겏?볝굧?㎪??곥굥??\\n    const positionMm = Math.min(index * pitchMm, distributionClearMm)\\r\\n    let deductionMm = 0\\r\\n\\r\\n    for (const opening of deducting) {\\r\\n      const [fromMm, toMm] = crossing(opening)\\r\\n      if (positionMm > fromMm && positionMm < toMm) {\\r\\n        deductionMm += deductionOf(opening)\\r\\n      }\\r\\n    }\\r\\n\\r\\n    counts.set(deductionMm, (counts.get(deductionMm) ?? 0) + 1)\\r\\n    positionsMm.push(positionMm)\\r\\n    deductionsMm.push(deductionMm)\\r\\n  }\\r\\n\\r\\n  const groups = [...counts.entries()]\\r\\n    .map(([deductionMm, count]) => ({ deductionMm, count }))\\r\\n    .sort((left, right) => left.deductionMm - right.deductionMm)\\r\\n\\r\\n  const gone = groups.find(({ deductionMm }) => deductionMm >= alongClearMm)\\r\\n  if (gone) {\\r\\n    // 轝좈솮?쀣걤?ｃ걼?꾤춮??뚪빓????뎱嶺뗣띲겎??겒?뤵곥걹?볝겓?ⓩ쓲?뚣겒?꾠겏?꾠걝?볝겏?졼?\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?뗥룭?ⓦ겗轝좈솮?뚪뎱嶺뗣겗?룔걬?믢슴?꾢늾?? 轝좈솮 ${gone.deductionMm} mm ` +\\r\\n        `???끾퀡 ${alongClearMm} mm`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    groups,\\r\\n    ignored,\\r\\n    rules: [minimumAreaRule],\\r\\n    layout:\\r\\n      deducting.length === 0 ? null : { positionsMm, deductionsMm },\\r\\n  }\\r\\n}\\r\\n\\r\\n--- member.ts ---\\r\\n/** BAR_SIZES ?ⓨ릪?섅걦?곩츪烏뚧셽?ユ쩂?곥굢?뚣굥?덀걝?띶닓?뗣굢?뗣굮壅룔걪?쇻?*/\\r\\nexport const MEMBER_KINDS = ['??, '鸚㎪쥈', '?먬쐡鶯?, '佯딀씮'] as const\\r\\n\\r\\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\\r\\n\\r\\nexport type MemberClass = '翁?퐪'\\r\\n\\r\\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\\r\\nexport const BAR_SIZES = [\\r\\n  'D10',\\r\\n  'D13',\\r\\n  'D16',\\r\\n  'D19',\\r\\n  'D22',\\r\\n  'D25',\\r\\n  'D29',\\r\\n  'D32',\\r\\n] as const\\r\\n\\r\\nexport type BarSize = (typeof BAR_SIZES)[number]\\r\\n\\r\\n/**\\r\\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\\n *\\r\\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\\r\\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\\r\\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\\n *\\r\\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\\n *\\r\\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\\r\\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\\n */\\r\\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\\r\\n\\r\\nexport type HighStrengthShearBarSize =\\r\\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\\r\\n\\r\\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\\r\\nexport const SHEAR_BAR_SIZES = [\\r\\n  ...BAR_SIZES,\\r\\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\\r\\n] as const\\r\\n\\r\\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\\r\\n\\r\\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\\r\\n\\r\\n/**\\r\\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯겗?ε뒟?㎯걗?ｃ겍獒썲뱚?뚧군?곥겒??(ADR-012)??\\n *\\r\\n * ?곈뇧令띸츞?뷸틬 1?싧뎴4)??) ?뚦릫?뉎걲??겘?띲겖泳숁뎸?ⓦ궗?밧쑇?η텤?뗣걽?묆겒??겎??\\n * 艅잍ː凉뤵꺕繹뜻렏??돮?꾠겘?ャ꺖?ャ깙?껁궚?담겎 `inferred` ??죱?ャ겒?????멥겧?뗣걣\\r\\n * ?ょ▶沃띲겏?쀣겍鈺?몜?뚥퍡??(ADR-015)??\\n */\\r\\nexport const SPLICE_METHODS = [\\r\\n  '?띲겖泳숁뎸',\\r\\n  '?с궧?㎪렏',\\r\\n  '艅잍ː凉?,\\r\\n  '繹뜻렏',\\r\\n] as const\\r\\n\\r\\nexport type SpliceMethod = (typeof SPLICE_METHODS)[number]\\r\\n\\r\\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\\r\\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\\r\\n\\r\\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\\r\\n\\r\\n/**\\r\\n * ?긱겗??씊壤®듁??\\n *\\r\\n * ?녶숱?긱겘 b?팪 ?믡겏?귙겓?닷푶?ャ걲?뗣귛ㄷ歟곥겗?끾퀡?룔걬??3D ??윶?㏂굚 b?팪 ?뗣굢\\r\\n * 黎뷩겲?뗣겗?㎯곩쨼?ε?力뺛겏?쀣겍?뚣걯?ㅳ굮營?걨?겼숱?뜰겗瓦썲뒥?뚩쮫歷ц쫸?뉎굮?뷩굢?뺛겒?꾠?\\n * ?곈뇧?㎩숱?뜰굮誤뗣굥??겘 1?싧뎴2)?뚧뼪?㏂겗鼇?쮫野멩퀡?ャ굠?뗥뫅?룔띲걼?졽?嶸뉑??㎯?\\n * ?녶숱??씊?㎯겘?앫겗?③빓?뚦냶?ⓦ겓?ゃ굥 ??獒썲뱚?뚧뼭?쀣걚?ㅳ굮鵝쒌굥?뤵걨?㎯겘?ゃ걚 (ADR-027)??\\n *\\r\\n * ?밤깙?ㅳ꺀?ョ춮??돮?뤵겒?꾠귝쮽繹뽨퍞礪섉쎑 5.3.4(6)(節? ?뚣뚣궧?묆궎?⒲꺂嶺뗣겗泳숁뎸?듽겞若싩???\\n * ??.3.5 ?ャ굠?뗣띲겏?녈겓冶붵겖?╉걡?듽곥걹??쎋??렅?뉎겎?삣깗??(烏?.3.3 ?ⓨ릪????\\n * ??씊?ゃ궧?덀걣?똇OOP D13@100?띲겏?멥걚?╉걚?뚣겙?앫굦??깢?쇈깤?㎯걗?ｃ겍?곮＝?곥걣\\r\\n * ?밤깙?ㅳ꺀?ャ겏沃?겳?욍걟?뗣걪?ⓦ겘?쀣겒??(ADR-012)??\\n */\\r\\nexport type ColumnShape = '?⒴숱' | '?녶숱'\\r\\n\\r\\nexport interface ColumnSection {\\r\\n  id: string\\r\\n  kind: '??\\r\\n  mark: string\\r\\n  /**\\r\\n   * ??씊?ゃ궧?덉뿉??痍⑥엯?????대뒓 ???됱뿉???붾뒗吏. 寧?뤇(mark)??遺숈씠硫??꾨㈃???녿뒗\\r\\n   * 寧?뤇???낁㉢?몄뿉 洹몃?濡??섍?怨??낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\\r\\n   * ?쒗뭹??Story???鴉뤷쎋 痍⑥엯 ?붾㈃?먯꽌 ?뺥솗 ?쇱튂 ?먮룞 ?좏깮?쇰줈 ?뉖뒗??(ADR-035).\\r\\n   */\\r\\n  storyLabel?: string\\r\\n  /** ??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗?뗣?*/\\r\\n  shape: ColumnShape\\r\\n  b: number\\r\\n  d: number\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  exposure: Exposure\\r\\n  finish: Finish\\r\\n  /** 訝사춮??텤?뗦뼶凉???泳숁뎸嶸뉑??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 (令띸츞?뷸틬 1?싧뎴4)??)) */\\r\\n  spliceMethod: SpliceMethod\\r\\n  main: {\\r\\n    size: BarSize\\r\\n    count: number\\r\\n  }\\r\\n  hoop: {\\r\\n    size: ShearBarSize\\r\\n    pitch: number\\r\\n    /**\\r\\n     * ?띸쉰?븅뼋?????앸㈃?먯꽌 寧?쨌?永귛릭嶺뗭쓣 ?쇰쭏???꾩슦?붿?. 誤뤸틬??媛믪씠 ?녾퀬\\r\\n     * ?ф빊瑜?醫뚯슦?섎?濡??쒗뭹???뺥븯吏 ?딅뒗??????씊訝誤㏃쓽 ?낅젰?대떎 (ADR-012).\\r\\n     */\\r\\n    startOffsetMm: number\\r\\n  }\\r\\n}\\r\\n\\r\\n/** 鸚㎪쥈 訝사춮 1餘듸펷訝딁ク?얇걼??툔塋?펹??퐤營?닪?ф빊?귝뼪?㏂꺁?밤깉??ク?ⓦ꺕訝?ㄾ烏뚣겓野얍퓶?쇻굥??*/\\r\\nexport interface GirderMainRow {\\r\\n  /** 塋?깿竊덃뵱?밧겢竊됥겗?ф빊 */\\r\\n  endCount: number\\r\\n  /** 訝?ㄾ??쑍??*/\\r\\n  centerCount: number\\r\\n  /**\\r\\n   * 冶뗧ク?담겗?ф빊 ??藥?뤂?㏝걬?녴겏?띲걽?묉똻?ㅳ귞꽒?묆굦??endCount ?ⓨ릪?섓펷野양㎞竊됥?\\n   * 冶뗧ク??꺀?녈꺆?쇈궖?ワ펷GirderRun.memberOffsetsMm ??0 ?댐펹??\\n   */\\r\\n  startCount?: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鸚㎪쥈訝사춮??퐤營?닪?ф빊?믡곲뇥?ゃ굤?믢퓷?ㅳ궛?ャ꺖?쀣겦?녻㎗?쇻굥??\\n *\\r\\n * ?ф빊??눕令띺썓?덀겏?쀣겍鰲ｉ뇠?쇻굥?귡싥걮嶺뗣꺕冶뗧ク/永귞ク stub?삡릎鸚?춮?ュ뒥?덀겍??\\n * 訝?밤겗??궧?졼걨?㎩츣??쇻굥 ?몄륫洹쇈굮瓦붵걲?귛쭓塋?겏永귞ク??륫?밤겓若싩??쇻굥 ?몄륫洹쇈겘\\r\\n * ?뚧셽?ユ닇塋뗣걮?ゃ걚?잆굙??oneSidedAnchor` ????밤걽?묆굮?곥겇 (ADR-032)??\\n */\\r\\nexport interface GirderMainDecomposition {\\r\\n  throughCount: number\\r\\n  startStubCount: number\\r\\n  endStubCount: number\\r\\n  centerOnlyCount: number\\r\\n  oneSidedCount: number\\r\\n  oneSidedAnchor?: '冶뗧ク' | '永귞ク'\\r\\n}\\r\\n\\r\\nexport function decomposeGirderMainRow(\\r\\n  row: GirderMainRow,\\r\\n): GirderMainDecomposition {\\r\\n  const startCount = row.startCount ?? row.endCount\\r\\n  const throughCount = Math.min(startCount, row.centerCount, row.endCount)\\r\\n  const startStubCount = Math.max(0, startCount - row.centerCount)\\r\\n  const endStubCount = Math.max(0, row.endCount - row.centerCount)\\r\\n  const centerOnlyCount = Math.max(\\r\\n    0,\\r\\n    row.centerCount - Math.max(startCount, row.endCount),\\r\\n  )\\r\\n  const oneSidedStartCount = Math.max(\\r\\n    0,\\r\\n    Math.min(startCount, row.centerCount) - row.endCount,\\r\\n  )\\r\\n  const oneSidedEndCount = Math.max(\\r\\n    0,\\r\\n    Math.min(row.centerCount, row.endCount) - startCount,\\r\\n  )\\r\\n\\r\\n  if (oneSidedStartCount > 0) {\\r\\n    return {\\r\\n      throughCount,\\r\\n      startStubCount,\\r\\n      endStubCount,\\r\\n      centerOnlyCount,\\r\\n      oneSidedCount: oneSidedStartCount,\\r\\n      oneSidedAnchor: '冶뗧ク',\\r\\n    }\\r\\n  }\\r\\n\\r\\n  if (oneSidedEndCount > 0) {\\r\\n    return {\\r\\n      throughCount,\\r\\n      startStubCount,\\r\\n      endStubCount,\\r\\n      centerOnlyCount,\\r\\n      oneSidedCount: oneSidedEndCount,\\r\\n      oneSidedAnchor: '永귞ク',\\r\\n    }\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    throughCount,\\r\\n    startStubCount,\\r\\n    endStubCount,\\r\\n    centerOnlyCount,\\r\\n    oneSidedCount: 0,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport interface GirderSection {\\r\\n  id: string\\r\\n  kind: '鸚㎪쥈'\\r\\n  mark: string\\r\\n  /** ColumnSection.storyLabel怨?媛숇떎. */\\r\\n  storyLabel?: string\\r\\n  b: number\\r\\n  depth: number\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  exposure: Exposure\\r\\n  finish: Finish\\r\\n  /** ColumnSection.spliceMethod ?ⓨ릪?섅귡싥걮嶺뗣겗泳숁뎸嶸뉑??겹겓?밤걦 */\\r\\n  spliceMethod: SpliceMethod\\r\\n  main: {\\r\\n    size: BarSize\\r\\n    /** 訝딁ク嶺뗣겗鵝띸쉰?ζ쑍??????씊?ゃ궧?덀겗塋?깿?삡릎鸚?죱?뚣걹??겲?얍뀯??*/\\r\\n    top: GirderMainRow\\r\\n    /** 訝뗧ク嶺뗣겗鵝띸쉰?ζ쑍??*/\\r\\n    bottom: GirderMainRow\\r\\n    /**\\r\\n     * ?ャ긿?덀궕?뺟춮?믤윶?㏂걢?됪쥈??냵?담겦鵝?mm ?㎩늾?딀??곥굥?뗣?\\n     *\\r\\n     * ?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1) ?뚣뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑\\r\\n     * ?ャ굠?뗣띲겏冶붵겖?뗣겗?㎬쫸繹뽩겢?ュㅳ걣?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012)??\\n     * 塋?깿?ⓧ릎鸚?걣?뚧빊竊덀궖?껁깉?ゃ깢嶺뗣걣?ゃ걚竊됪뼪?㏂겎??슴?뤵굦?ゃ걚??\\n     */\\r\\n    cutoffFromSupportFaceMm: number\\r\\n  }\\r\\n  stirrup: {\\r\\n    size: ShearBarSize\\r\\n    pitch: number\\r\\n    /** 訝←ク??윶?㏂걢?됬К1?삥?永귙걗?겹굢嶺뗣굮?⒲굦?졼걨?㏂걲?뗣귟쫸繹뽧겓?ㅳ겘?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012) */\\r\\n    startOffsetMm: number\\r\\n  }\\r\\n  /**\\r\\n   * 亮끾??곭춮?귝뼪?㏘?誤㎯겓鼇섋펹??겒?꾣쥈?ャ겘?▲걚?띸춮?ゃ겗?㏛뻣?뤻쟿??겏?쀣?\\n   * `undefined` ??뚪뀓嶺뗣겒?쀣띲굮?뤷뫑?쇻굥 ??獒썲뱚?뚦떇?뗣겓擁녈걬?ゃ걚 (ADR-012)??\\n   * 鼇?쮫?룔걬??빊?뤹찉嶸쀥읃繹?1?싧뎴3) ?뚧뼪?㏂겗鼇?쮫亮끹겏若싥굙?뗣겗?㎩뀯?쎼겘孃꾠겏?붵긿?곥걽?묆?\\n   */\\r\\n  widthTie?: {\\r\\n    size: BarSize\\r\\n    pitch: number\\r\\n  }\\r\\n  /**\\r\\n   * ?밭춮??undefined` ??뚪뀓嶺뗣겒?쀣띲귝쑍?겹겘?녜씊?뚣?-D10?띲겏鼇섋펹?쇻굥?겹걹??굚??\\n   * ?ゃ겗??1?싧뎴7) ??돯餓섅겎??겒?꾠?\\n   */\\r\\n  sideBar?: {\\r\\n    size: BarSize\\r\\n    count: number\\r\\n    /**\\r\\n     * 歟곥겗訝←ク?㎩냵力뺛굮擁듽걟?╊섯?녈굥鵝숅빓 (mm)?귝빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈3) ??\\n     * ?볝굦??1?싧뎴6) ?ュ쭟??곩릪?끹겘鼇?쮫?녔쎑?ヨ쮼雍됥걣?ゃ걨?뚣겙 JASS 5 繹뽫뵪??\\n     * ?쇻굥?괟ASS 5 ??쐣?숃쫸?쇈겎?ょ▶岳앫곫쮽繹뽨퍞礪섉쎑5塋졼겓??끃嶺뗣겗鼇섋염?뚥???\\n     * ?ゃ걚?잆굙誤뤸틬?ㅳ굮?뽧굦?ゃ걚 ??鼇?쮫?녔쎑??ㅳ굮?ε뒟?ⓦ걮??룛?묈룚??(R9????\\n     */\\r\\n    extraLengthMm: number\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?먬쐡鶯????⒲꺖?▲꺍礪뗩졼겗鶯곥겎?귙굥?귛즯凉뤸쭓?졼겗鶯곥겎??겒?꾠?\\n *\\r\\n * ?곈뇧令띸츞?뷸틬 2竊덌폊竊됧즯 ??1)?뚦즯凉뤸쭓?졽빳鸚뽧띲겏 2)?뚦즯凉뤸쭓?졼띲굮?ζ씉?뉎겎?긱걚??\\n * 孃뚩끹겘塋?깿嶺뗣꺕潁?춮?삣즯歟곭춮?삥Ø嶺뗣꺕獒쒎섭嶺뗣겗5?뷴늽?ュ늽?뗣굦??씉?뉎겗?뤵걣?얇굥?㏝걬?녴?\\n * ?볝걪?뚦츪獒끹걲?뗣겗??1) ?졼걨?㎯곩즯凉뤸쭓?졼겘?긱굩?ゃ걚??\\n *\\r\\n * 亮끾?嶺뗣굮?곥걼?ゃ걚??겘?뤷쎋?꾠걽???싧뎴3) ??빓?뺧펷竊앭즯?싷펹?믣즯?ャ굚訝롢걟?뗣걣??\\n * ?ф빊?믣츣?곥굥?→뻼??2竊덌폆竊됪쥈3) ?㎪쥈?쀣걢?띷뙁?쀣겍?듽굢?싥?竊덌폊竊됧즯 ?ュ퉭閭®춮??\\n * 鼇섋염????뉎겒?꾠귝쑍?겹굮獒썲뱚?뚥퐳?됥겒?꾠겏鼇덁툓?㎯걤?ゃ걚 ??鵝쒌굢?ゃ걚 (ADR-022 ??끃嶺뗣겏?뚣걯?ㅶ뼪)??\\n */\\r\\nexport interface WallSection {\\r\\n  id: string\\r\\n  kind: '?먬쐡鶯?\\r\\n  mark: string\\r\\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\\r\\n  storyLabel?: string\\r\\n  /**\\r\\n   * 鼇?쮫?녔쎑?㎩닩??걮?잌즯??뙷?녴귡썞鶯곥겘?γ겗 MemberKind ?㎯겘?ゃ걦?곩즯??\\n   * ?뗣겤?듽겏?띲겖泳숁뎸訝뗩솏?졼걨?믣늽?묆굥?귞쐛?γ겘?℡춼旅덁뻑?ⓦ겗雅믤룢??걼??\\n   * ?먨뒟鶯곥겏?쀣겍?긱걝 (ADR-036)??\\n   */\\r\\n  wallClass?: '?먨뒟鶯? | '?먨뒟鶯곦빳鸚?\\r\\n  /** 鶯곩럻 (mm) */\\r\\n  thickness: number\\r\\n  fc: number\\r\\n  grade: SteelGrade\\r\\n  exposure: Exposure\\r\\n  finish: Finish\\r\\n  /** 潁?춮?삥Ø嶺뗣겗泳숁뎸?밧폀?귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\\r\\n  spliceMethod: SpliceMethod\\r\\n  /**\\r\\n   * ?띸춮??광?????룔꺍?겹꺂(1) ????뽧꺂(2) ?뗣귝쑍?겹걣?앫겗?얇겲?