,\r\n  yMm: number,\r\n  widthMm: number,\r\n  heightMm: number,\r\n  id = `${xMm}-${yMm}`,\r\n): Opening {\r\n  return { id, xMm, yMm, widthMm, heightMm }\r\n}\r\n\r\n// ?끾퀡 5200횞2400?곥깞?껁긽 200?귞를嶺?alongY)??27?с꺕與ょ춮(alongX)??13????\n// ?⒲걾?됥굚 1?싧뎴7) ???덆빓?빩룬뼋?붴뙃竊? ?㎯걗?뗣?\nfunction wall(\r\n  openings: Opening[],\r\n  barAxis: 'x' | 'y',\r\n  totalCount = barAxis === 'x' ? 13 : 27,\r\n) {\r\n  return openingDeduction(\r\n    {\r\n      openings,\r\n      clearXMm: 5200,\r\n      clearYMm: 2400,\r\n      barAxis,\r\n      pitchMm: 200,\r\n      totalCount,\r\n    },\r\n    jpMlitRulePack,\r\n  )\r\n}\r\n\r\ndescribe('openingDeduction ???곈뇧令띸츞?뷸틬 1?싧뎴8)', () => {\r\n  it('??뼀?ｃ걣?ゃ걨?뚣겙?ⓩ빊???ㅳ겗獰ㅳ겓?얇겏?곥굥', () => {\r\n    const result = wall([], 'y')\r\n\r\n    expect(result.groups).toEqual([{ deductionMm: 0, count: 27 }])\r\n    expect(result.ignored).toEqual([])\r\n    // ?뗥룭?뚣겒?꾦깿?먦겗嶸쀥눣凉뤵겓?얍ㅳ겗烏뚣굮?쇻걩?뗣겏?곩듅?꾠겍?꾠겒?꾣졊?졼굮鹽뷩걲?볝겏?ャ겒?뗣?\n    expect(result.rules).toEqual([])\r\n  })\r\n\r\n  it('??뼀?ｃ굮與ゅ늾?뗦쑍?졼걨?믧뼀?ｃ겗?끾퀡野멩퀡?졼걨??걦?쇻굥', () => {\r\n    const result = wall([opening(2000, 600, 1800, 1200)], 'y')\r\n\r\n    expect(result.groups).toEqual([\r\n      { deductionMm: 0, count: 19 },\r\n      { deductionMm: 1200, count: 8 },\r\n    ])\r\n  })\r\n\r\n  it('??뎔?뗥릲?띲겎轝좈솮?쇻굥野멩퀡?믣쨯?덀굥 ??與ょ춮??뼀?ｃ겗亮끹굮轝졼걦', () => {\r\n    const result = wall([opening(2000, 600, 1800, 1200)], 'x')\r\n\r\n    expect(result.groups).toEqual([\r\n      { deductionMm: 0, count: 8 },\r\n      { deductionMm: 1800, count: 5 },\r\n    ])\r\n  })\r\n\r\n  it('??쥊?뚣겓?▲굟?녴겑雍됥굥?с굮轝좈솮?쀣겒??, () => {\r\n    // ?뗥룭 x 竊?2000??800?귛돯餓섅겘 200 ?삠겳?ゃ겗??2000 ??3800 ?ユ쑍?뚩펹?뗣?\n    // ?앫겗2?с겲?㎪쵟?묆걼?볝겏?ャ걲?뗣겏?곲뼀?ｃ겗鸚뽧겓?귙굥?꾤춮?믤쵟?ㅳ걲?뗣걪?ⓦ겓?ゃ굥??\n    const result = wall([opening(2000, 600, 1800, 1200)], 'y')\r\n    const cut = result.groups.find(({ deductionMm }) => deductionMm > 0)\r\n\r\n    // 2000??800 ??냵?담겘 2200??600 ???с귛쥊?뚣굮?ャ굙?뚣겙10?с겓?ゃ굥??\n    expect(cut?.count).toBe(8)\r\n  })\r\n\r\n  it('??릪?섉쑍???ㅳ겗?뗥룭?믧싥굦?겻륫?밤굮擁