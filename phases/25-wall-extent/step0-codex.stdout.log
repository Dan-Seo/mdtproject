+\\n  \\\"export const MEMBER_KINDS = ['柱', '大梁', '耐震壁', '床板'] as const\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  'export type MemberKind = (typeof MEMBER_KINDS)[number]\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  \\\"export type MemberClass = '躯体'\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  '/** 허용 철근 경의 단일 출처 — UI 셀렉트·断面リスト 파서가 여기서 파생한다. */\\\\r\\\\n' +\\n  'export const BAR_SIZES = [\\\\r\\\\n' +\\n  \\\"  'D10',\\\\r\\\\n\\\" +\\n  \\\"  'D13',\\\\r\\\\n\\\" +\\n  \\\"  'D16',\\\\r\\\\n\\\" +\\n  \\\"  'D19',\\\\r\\\\n\\\" +\\n  \\\"  'D22',\\\\r\\\\n\\\" +\\n  \\\"  'D25',\\\\r\\\\n\\\" +\\n  \\\"  'D29',\\\\r\\\\n\\\" +\\n  \\\"  'D32',\\\\r\\\\n\\\" +\\n  '] as const\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export type BarSize = (typeof BAR_SIZES)[number]\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 高強度せん断補強筋の呼び名。フープ・スタラップ専用である。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 両原文に一度も現れない — 「高強度」「大臣認定」ともに標準仕様書 R7 全330頁・\\\\r\\\\n' +\\n  ' * 数量積算基準 全54頁で 0 件だ。規準が定める鉄筋ではなく大臣認定品だからである。\\\\r\\\\n' +\\n  ' * それでも数量を出せるのは、フープ・スタラップの設計長さを 1通則2) が断面周長と\\\\r\\\\n' +\\n  ' * 定めていて、径で引くルールパック行が一つもないからだ (ADR-026)。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 主筋には使えない。主筋は定着 (表5.3.4)・重ね継手 (表5.3.2) を径と鉄筋の種類で\\\\r\\\\n' +\\n  ' * 引くが、その表に高強度せん断補強筋の行はない — 型がそれを禁じる。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 一覧は収集した実図面が書いた呼び名そのものであって、製品カタログの網羅では\\\\r\\\\n' +\\n  ' * ない。K13 は沖縄県住宅供給公社、S13 は横浜市の図面にある (どちらも KSS785)。\\\\r\\\\n' +\\n  ' * 未知の呼び名は値を作らず空欄に落ちる — 断面リスト파서と同じ扱いだ (R10)。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  \\\"export const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  'export type HighStrengthShearBarSize =\\\\r\\\\n' +\\n  '  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/** せん断補強筋 (帯筋・あばら筋) に入れられる呼び名の全体。 */\\\\r\\\\n' +\\n  'export const SHEAR_BAR_SIZES = [\\\\r\\\\n' +\\n  '  ...BAR_SIZES,\\\\r\\\\n' +\\n  '  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\\\\r\\\\n' +\\n  '] as const\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export type ShearBarSize = BarSize | HighStrengthShearBarSize\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  \\\"export type SteelGrade = 'SD295' | 'SD345' | 'SD390'\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 主筋の継手方式。断面一覧の入力であって製品が決めない (ADR-012)。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 数量積算基準 1通則4)・5) が名指すのは重ね継手とガス圧接継手だけなので、\\\\r\\\\n' +\\n  ' * 機械式・溶接の扱いはルールパック側で `inferred` の行になる — 選べるが\\\\r\\\\n' +\\n  ' * 未確認として警告が付く (ADR-015)。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  'export const SPLICE_METHODS = [\\\\r\\\\n' +\\n  \\\"  '重ね継手',\\\\r\\\\n\\\" +\\n  \\\"  'ガス圧接',\\\\r\\\\n\\\" +\\n  \\\"  '機械式',\\\\r\\\\n\\\" +\\n  \\\"  '溶接',\\\\r\\\\n\\\" +\\n  '] as const\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  'export type SpliceMethod = (typeof SPLICE_METHODS)[number]\\\\r\\\\n' +\\n  '\\\\r\\\\n' +\\n  '/** 表5.3.6 のかぶり厚さセルを特定する入力 (屋内・屋外 × 仕上げの有無)。 */\\\\r\\\\n' +\\n  \\\"export type Exposure = '屋内' | '屋外'\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  \\\"export type Finish = '仕上げあり' | '仕上げなし'\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  '/**\\\\r\\\\n' +\\n  ' * 柱の断面形状。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * 円形柱は b・d をともに直径にする。大梁の内法長さも 3D の柱面も b・d から\\\\r\\\\n' +\\n  ' * 決まるので、外接寸法として同じ値を置けば形状の追加が計測規則を揺らさない。\\\\r\\\\n' +\\n  ' * 数量で形状を見るのは 1通則2)「断面の設計寸法による周長」ただ一箇所で、\\\\r\\\\n' +\\n  ' * 円形断面ではその周長が円周になる — 製品が新しい値を作るわけではない (ADR-027)。\\\\r\\\\n' +\\n  ' *\\\\r\\\\n' +\\n  ' * スパイラル筋は扱わない。標準仕様書 5.3.4(6)(ｲ) が「スパイラル筋の継手及び定着は\\\\r\\\\n' +\\n  ' * 図5.3.5 による」と図に委ねており、その図は原文で画像だ (表5.3.3 と同じ)。\\\\r\\\\n' +\\n  ' * 断面リストが「HOOP D13@100」と書いていればそれはフープであって、製品が\\\\r\\\\n' +\\n  ' * スパイラルと読み替えることはしない (ADR-012)。\\\\r\\\\n' +\\n  ' */\\\\r\\\\n' +\\n  \\\"export type ColumnShape = '矩形' | '円形'\\\\r\\\\n\\\" +\\n  '\\\\r\\\\n' +\\n  'export interface ColumnSection {\\\\r\\\\n' +\\n  '  id: string\\\\r\\\\n' +\\n  \\\"  kind: '柱'\\\\r\\\\n\\\" +\\n  '  mark: string\\\\r\\\\n' +\\n  '  /**\\\\r\\\\n' +\\n  '   * 断面リスト에서 취입할 때 어느 階 행에서 왔는지. 符号(mark)에 붙이면 도면에 없는\\\\r\\\\n' +\\n  '   * 符