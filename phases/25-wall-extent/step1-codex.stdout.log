rtOffsetMm: number\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됤??곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞???㎪릍?뗣?\r\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓\r\n * ?γ걲?뗦객亮녔쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲빓?뺛겘?싥굤??뼋?㎯겘?ゃ걦訝▼겢??ㄷ歟곥겗\r\n * ?끻겢?㏂겗?볝겎?귙굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠??(ADR-028)??\r\n *\r\n * `exposure` ?믤똻?잆겒?꾠겗??〃5.3.6 ??쭓?졼걹??굚??걽?귛릪烏ⓦ겗?뚣궧?⒲깣?곮먨뒟鶯?\r\n * 餓ε쨼??즯?띹죱??퍞訝듽걩??쐣?▲걽?묆겎?녴걢?뚣곩콏?끹꺕掠뗥쨼??뙷?γ굮**?곥걼?ゃ걚** ??\r\n * ?뚧윶?곫쥈?곮먨뒟鶯곥띹죱?③걬?녴귛뀯?쎼겓營?걦?①뵽?㏂겓?밤걢?ゃ걚?ㅳ겲?욍걣訝╉겤??\r\n *\r\n * 亮끾?嶺뗣굮?곥걼?ゃ걚??겘?먬쐡鶯곥겏?뚣걯?녺뵳?㎯걗?뗣??싧뎴3) ?뚪빓?뺛굮訝롢걟?뗩깿?먦겗\r\n * ?쀦뙔??뚦읃鹽롦쥈?곫쥈?곩즯歟곥곩즯?띲겎佯딀씮?뚣겒?뤵곫쑍?겹굮若싥굙?뗦씉?뉎굚?ゃ걚??\r\n */\r\nexport interface SlabSection {\r\n  id: string\r\n  kind: '佯딀씮'\r\n  mark: string\r\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\r\n  storyLabel?: string\r\n  /** ?욕럻 (mm) */\r\n  thickness: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉뤵귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\r\n  spliceMethod: SpliceMethod\r\n  /** X?싥굤?밧릲竊늌邕멥겓亦욍겂?╊섯?녈굥竊됥겗訝사춮 */\r\n  x: { top: SlabBarRow; bottom: SlabBarRow }\r\n  /** Y?싥굤?밧릲??말嶺?*/\r\n  y: { top: SlabBarRow; bottom: SlabBarRow }\r\n}\r\n\r\nexport type Section =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\n/**\r\n * ?붾㈃ ?쒖떆쨌aria-label???대쫫. 媛숈? 寧?뤇???롫퀎濡??щ윭 ??씊???????덉쑝誘濡?\r\n * ?롫? ?ш린??遺숈씤??????λ릺??`mark`???꾨㈃??寧?뤇 洹몃?濡??붾떎.\r\n */\r\nexport function sectionMarkLabel(section: Section): string {\r\n  return section.storyLabel\r\n    ? `${section.mark}(${section.storyLabel})`\r\n    : section.mark\r\n}\r\n\r\nexport interface ColumnPosition {\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\nexport interface GirderPosition {\r\n  axis: 'X' | 'Y'\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗鵝띸쉰?귛ㄷ歟곥겏?뚣걯?뤻싥굤??겗1?밤깙?녑늽??씌?믣뜝?곥굥??겎壤㏂굚?뚣걯?㎯걗?뗣?\r\n *\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?곩닪?띲굮鵝쒌겂?╉굚?뗣겏?쀣겍??GirderPosition ??\r\n * ?뷴닪?뺛굦?ゃ걚 ???⒲걾?됥겎?귙굥?뗣굮黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼귚퐤營?걽?묆굮\r\n * 誤뗣겍?ⓩ쓲葉?닪?믣닩若싥걲?뗣궠?쇈깋?믤쎑?뗣겒?꾠걪?ⓦ?\r\n */\r\nexport type WallPosition = GirderPosition\r\n\r\n/**\r\n * 佯딀씮??퐤營????싥굤??겎?꿔겲?뚣걼1?쇻궎?믣뜝?곥굥??ix, iy) ??걹??깧?ㅳ겗?잏궧??\r\n * 竊늌?팢 ?ⓦ굚弱뤵걬?꾢겢竊됥겗?쇔춴?밤겎?곥깧?ㅳ겘 (ix, iy)??ix+1, iy+1) ?㎯걗?뗣?\r\n *\r\n * ?긱겗 ColumnPosition ?ⓨ숱??릪?섅걽?뚧뙁?쇻굚??걣?뺛걝竊덃졏耶먪궧?뗣깧?ㅳ걢竊됥?\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?뗣겎??뙷?γ걬?뚣겒?????⒲걾?됥겎?귙굥?뗣굮\r\n * 黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼?\r\n */\r\nexport type SlabPosition = ColumnPosition\r\n\r\n/**\r\n * ?뗥룭??1?뗦? (?곈뇧令띸츞?뷸틬 1?싧뎴8))??\r\n *\r\n * ??씊?㎯겘?ゃ걦 **?ⓩ쓲** ?ヤ퍡?뤵귛릪?섊Е?룔겗鶯곥걣鵝뺞옔?귛뻠?ㅳ겗?ャ곭첆??걹???싥겓\r\n * ?뗣걚?╉걚?뗣걢?됥걽 ????씊?ユ똻?잆걵?뗣겏?녜씊?ャ겒?꾦뼀?ｃ굮獒썲뱚?뚥퍟??즯?ャ굚鵝쒌굥\r\n * ?볝겏?ャ겒??(ADR-004)??\r\n *\r\n * 佯㎪쮽??깿?먦겗掠?楹삠겎?곩렅?밤겘**?끾퀡?잆겗?잏궧**?㎯걗?뗣귟먬쐡鶯곥겒?됧쭓塋?겗?긱겗\r\n * ?끻겢?㏂꺕訝딃깿鸚㎪쥈??툔?㏂걢?됪릍?ｃ걼訝뗧ク?곩틞?욍겒?됥꺀?녈겗冶뗧ク??ㄷ歟곩냵?닻씊??\r\n * 掠? x?퍈 ??릲?띲겘?띸춮竊?Rebar.points`竊됥겏?뚣걯?ゃ겗?㎯곩즯?㎯겘 x ?뚦즯??빓?뺛?\r\n * y ?뚦즯??쳵?뺛곩틞?욍겎??x?퍈 ?뚣걹?뚣걻??X?싥굤?팢?싥굤?밧릲?ャ겒?뗣?\r\n *\r\n * 野멩퀡??뚦뻠?룬줊嶺됮뼀?ｉ깿??*?끾퀡野멩퀡**?띯??뚪쟿?뚣걹?녶츣?곥굥??\r\n */\r\nexport interface OpeningReinforcement {\r\n  size: BarSize\r\n  count: number\r\n  lengthMm: number\r\n}\r\n\r\nexport interface Opening {\r\n  id: string\r\n  /** ?끾퀡?잆겗?잏궧?뗣굢?뗥룭?얇겎???? x (mm) */\r\n  xMm: number\r\n  /** ?뚣걯?뤷?? y (mm) */\r\n  yMm: number\r\n  /** 掠? x ?밧릲??냵力뺝?力?(mm) */\r\n  widthMm: number\r\n  /** 掠? y ?밧릲??냵力뺝?力?(mm) */\r\n  heightMm: number\r\n  /** 1?싧뎴8) ?ゃ걡?멥걤?ュ읃?γ걦鼇?쮫?녔쎑邕?쮼??뼀?ｈ짒凉루춮 */\r\n  reinforcements?: OpeningReinforcement[]\r\n}\r\n\r\nexport interface Member {\r\n  id: string\r\n  kind: MemberKind\r\n  memberClass: MemberClass\r\n  sectionId: string\r\n  storyId: string\r\n  position: ColumnPosition | GirderPosition | WallPosition | SlabPosition\r\n  /**\r\n   * ?볝겗?ⓩ쓲?ラ뼀?꾠겍?꾠굥?뗥룭??(1?싧뎴8))?귝쑋?뉐츣??뚪뼀?ｃ겒?쀣띲겎?귙겂??\r\n   * ?뚧쑋?ε뒟?띲겎??겒????獒썲뱚??뼀?ｃ겗?됬꽒?믤렓若싥걮?ゃ걚??겎?곩냵鼇녔쎑??뼀?ｈ짒凉루춮??\r\n   * 鼇덁툓?쀣겍?꾠겒?꾠걪?ⓦ굮躍멩셽?딁윥?쇻굥 (R14)?귝윶?삣ㄷ歟곥겘?쀣걨?뽧굢?ゃ걚竊싧릪?끹걣\r\n   * ?쇻걩?뗣겗??첆?삣눣?ε룭嶺됥겎?곥걹?뚣걣?뗣걦??겘鶯곥겏佯딀씮?졼걢?됥겎?귙굥??\r\n   */\r\n  openings?: Opening[]\r\n}\r\n--- src/domain/model/project.ts\r\n  clearLengthMm: number\r\n  /** ?끾퀡遙섅걬 (mm) ???롩쳵 ??訝딃깿鸚㎪쥈?쎼걚 */\r\n  clearHeightMm: number\r\n  /** 冶뗧ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\r\n  startFaceOffsetMm: number\r\n  /** 永귞ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\r\n  endFaceOffsetMm: number\r\n  /** ?끾퀡遙섅걬?믤군?곥걼訝딃깿鸚㎪쥈??걵??(mm) */\r\n  girderDepthAboveMm: number\r\n}\r\n\r\n/**\r\n * 鶯곥겗訝듽겓雍됥굥鸚㎪쥈??걵?꾠귛즯?ⓨ릪?섋씌竊덂릪?섌싥굤??꺕?뚣걯?밤깙?놂펹??ㄷ歟곥굮誤뗣굥 ??\r\n * ?먬쐡鶯곥겘2?с겗?긱겗?볝겓塋뗣걾?곥걹??툓??ㄷ歟곥겎??굮閭㏂굙?됥굦?뗣걢?됥겎?귙굥??\r\n *\r\n * 誤뗣겇?뗣굢?ゃ걨?뚣겙?ε뒟??툖?닷릦?ゃ겗?㏝퍢?ｃ겍?롩쳵?믢슴?뤵겒?꾠귛ㄷ歟곥겗?ゃ걚渦뷩겓鶯곥굮\r\n * 營?걦?ⓨ냵力뺡쳵?뺛걣黎뷩겲?됥걳?곲쉸遙섅겎餓ｇ뵪?쇻굦?겼ㄷ歟곥겏?띲겒?ｃ걼鶯곥굮鼇덁툓?쀣겍?쀣겲?녴?\r\n */\r\nfunction girderDepthAboveWall(project: Project, wall: Member): number {\r\n  const position = wall.position\r\n  if (!isGirderPosition(position)) {\r\n    throw new Error(`girderDepthAboveWall requires an edge position: ${wall.id}`)\r\n  }\r\n\r\n  const girder = project.members.find(\r\n    (candidate) =>\r\n      candidate.kind === '鸚㎪쥈' &&\r\n      candidate.storyId === wall.storyId &&\r\n      isGirderPosition(candidate.position) &&\r\n      candidate.position.axis === position.axis &&\r\n      candidate.position.ix === position.ix &&\r\n      candidate.position.iy === position.iy,\r\n  )\r\n\r\n  if (!girder) {\r\n    throw new Error(`Missing 鸚㎪쥈 above ?먬쐡鶯? ${wall.id}`)\r\n  }\r\n\r\n  const section = findSection(project, girder.sectionId)\r\n  if (section.kind !== '鸚㎪쥈') {\r\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\r\n  }\r\n\r\n  return section.depth\r\n}\r\n\r\nexport function wallSpan(project: Project, member: Member): WallSpan {\r\n  if (member.kind !== '?먬쐡鶯? || !isGirderPosition(member.position)) {\r\n    throw new Error(`wallSpan requires a ?먬쐡鶯? ${member.id}`)\r\n  }\r\n\r\n  const story = project.stories.find(({ id }) => id === member.storyId)\r\n  if (!story) {\r\n    throw storyNotFound(member.storyId)\r\n  }\r\n\r\n  const { axis, ix, iy } = member.position\r\n  const endIx = axis === 'X' ? ix + 1 : ix\r\n  const endIy = axis === 'Y' ? iy + 1 : iy\r\n  const startPoint = gridPoint(project.grid, ix, iy)\r\n  const endPoint = gridPoint(project.grid, endIx, endIy)\r\n  const startSection = supportColumnSection(project, member, ix, iy, 'start')\r\n  const endSection = supportColumnSection(project, member, endIx, endIy, 'end')\r\n\r\n  const centerSpan =\r\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\r\n  const startFaceOffsetMm =\r\n    (axis === 'X' ? startSection.b : startSection.d) / 2\r\n  const endFaceOffsetMm = (axis === 'X' ? endSection.b : endSection.d) / 2\r\n  const clearLengthMm = centerSpan - startFaceOffsetMm - endFaceOffsetMm\r\n\r\n  if (clearLengthMm <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?먬쐡鶯??끾퀡?룔걬 must be positive: ${member.id} (${clearLengthMm} mm)`,\r\n    )\r\n  }\r\n\r\n  const girderDepthAboveMm = girderDepthAboveWall(project, member)\r\n  const clearHeightMm = story.height - girderDepthAboveMm\r\n\r\n  if (clearHeightMm <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?먬쐡鶯??끾퀡遙섅걬 must be positive: ${member.id} ` +\r\n        `(?롩쳵 ${story.height} ??訝딃깿鸚㎪쥈?쎼걚 ${girderDepthAboveMm})`,\r\n    )\r\n  }\r\n\r\n  return {\r\n    axis,\r\n    clearLengthMm,\r\n    clearHeightMm,\r\n    startFaceOffsetMm,\r\n    endFaceOffsetMm,\r\n    girderDepthAboveMm,\r\n  }\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊??쇻궎??냵力뺝?力뺛겏?곩썪渦뷩겎?쀣걨?뗥ㄷ歟곥?\r\n *\r\n * 翁?퐪??뙷?놅펷寧?渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲?뗦객亮녔쓲??냵力뺡깿?녴?\r\n * ?ⓨ츣?곥굥??겎?곫릍?뗣겗??싥굤??뼋?㎯겘?ゃ걦鸚㎪쥈??냵?닻씊??뼋?㎯걗?뗣귝윶?삣ㄷ歟곥겏\r\n * 雅뚪뇥鼇덁툓?쀣겒?꾠겗??걪??츣獰⒲걹??굚??겎?곩ㄷ歟곥걣?끾퀡?룔걬?삣즯?뚦냵力뺡깿?녴겒??겏?뚣걯壤㏂걽??\r\n */\r\nexport interface SlabBay {\r\n  /** ?싥굤??뼋?밤깙??(mm) */\r\n  centerSpanXMm: number\r\n  centerSpanYMm: number\r\n  id: isString,\r\n  xMm: isFiniteNumber,\r\n  yMm: isFiniteNumber,\r\n  widthMm: isFiniteNumber,\r\n  heightMm: isFiniteNumber,\r\n})\r\n\r\nconst isBarSize = (value: unknown): value is BarSize =>\r\n  BAR_SIZES.includes(value as BarSize)\r\n\r\nconst isPositiveInteger = (value: unknown): boolean =>\r\n  typeof value === 'number' && Number.isInteger(value) && value > 0\r\n\r\nconst isNonNegativeFiniteNumber = (value: unknown): boolean =>\r\n  typeof value === 'number' && Number.isFinite(value) && value >= 0\r\n\r\nconst isOpeningReinforcement = shapedAs({\r\n  size: isBarSize,\r\n  count: isPositiveInteger,\r\n  // 0 is the persisted ?よ빪鼇?state. The rebar generators omit it until the\r\n  // design-document transcription supplies a length.\r\n  lengthMm: isNonNegativeFiniteNumber,\r\n})\r\n\r\nconst isOpeningWithReinforcements = (value: unknown): boolean => {\r\n  if (!isOpening(value)) return false\r\n\r\n  const reinforcements = (value as { reinforcements?: unknown }).reinforcements\r\n  return (\r\n    reinforcements === undefined ||\r\n    (Array.isArray(reinforcements) &&\r\n      reinforcements.every(isOpeningReinforcement))\r\n  )\r\n}\r\n\r\nconst isMemberKind = (value: unknown): boolean =>\r\n  MEMBER_KINDS.includes(value as MemberKind)\r\n\r\n/**\r\n * 謠ⓩ졏?졼걨?믤쩂?곥굥?귛룚?딂씔?旅덁뻑??퍟雅뷩걣鵝쒌겂?잍뻼耶쀥닓?㎯걌chemaVersion ?쀣걢\r\n * 誤뗣걳?ラ싥걲?ⓨ숱??걬??JSON ??Project ?ⓦ걮??ⅴ?얇겎?γ굥 ???곈뇧??NaN ?ャ겒?뗣걢\r\n * ?삯씊?뚩맼?▲굥?뗣겎?곥겑?▲굢?귙뚩き?욤씔?곥겒?뗣겂?잆띲굠?딀궕?꾠?\r\n *\r\n * 濾쒌굙?뗣겗??＝?곥걣?쇻걧曆삣춻?믣폊?뤷졃? (stories?팵embers?퍀ections?팮rid) ?ⓦ?\r\n * ?낁㉢?멥겗?삠꺂?ャ걹??겲?얍눣?뗦뻼耶쀥닓?졼걨?졼귛ㅳ겗倻ε퐪??(孃꾠걣若잌쑉?쇻굥?뗣?\r\n * ?ф빊?뚧??? ??걪?볝겎??쫳?ゃ걚 ???앫굦??뼪?㏘?誤㎯겗?ε뒟濾쒏읅??똻?▼졃?㎯?\r\n * ?볝걪?㏛틠?띲겓?곥겇?②쫸繹뽧걣雅뚣걢??ュ늽?뗣굦?뗣?\r\n */\r\n/**\r\n * 壤㏂걽?묌싥겂?╊릎翁ャ겗?귞뀱?뚦늾?뚣겍?꾠굥鼇섌뙯?믣늾?뗣?\r\n *\r\n * ?볝걪?㎬쫳?ゃ걚?ⓦ곩풄?뗣굢?뤹뵽??붶릎?㎬맼?▲굥 ??useProjectPersistence ??\r\n * catch ??loadProject ?뚩㏄?ｃ걼? (??앫겗?? ?쀣걢誤뗣겒?꾠겗?㎯곩ㄷ歟곥겗??씊??\r\n * 轝졼걨?╉걚?뗨쮼?꿔겘?앫걪?믥킔?싥굤?쀣겍 PaneBoundary ?ュ눣?뗣?\r\n */\r\ninterface ReferencedPosition {\r\n  axis?: 'X' | 'Y'\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\nfunction hasIntactReferences(\r\n  grid: Grid,\r\n  sections: { id: string; kind: MemberKind }[],\r\n  stories: { id: string }[],\r\n  members: {\r\n    kind: MemberKind\r\n    sectionId: string\r\n    storyId: string\r\n    position: ReferencedPosition\r\n  }[],\r\n): boolean {\r\n  const sectionKinds = new Map(sections.map(({ id, kind }) => [id, kind]))\r\n  const storyIds = new Set(stories.map(({ id }) => id))\r\n  const { nx, ny } = gridPointCount(grid)\r\n\r\n  // 鸚㎪쥈?삭먬쐡鶯곥겘?ｃ겗雅ㅷ궧?얇겎鴉멥겞?뗣겗?㎯곥걹??뻗?졼걨訝?ㅶ뎸?띲겲?㎯걽?귛틞?욍겘\r\n  // ?쇻궎?ゃ겗?㏛륫邕멥겏?귚??ㅶ뎸????slabBay ??(ix+1, iy+1) ?믣폊?뤵?\r\n  const inGrid = (\r\n    kind: MemberKind,\r\n    { axis, ix, iy }: ReferencedPosition,\r\n  ): boolean => {\r\n    const spansX = kind === '佯딀씮' || axis === 'X'\r\n    const spansY = kind === '佯딀씮' || axis === 'Y'\r\n\r\n    return (\r\n      Number.isInteger(ix) &&\r\n      Number.isInteger(iy) &&\r\n      ix >= 0 &&\r\n      iy >= 0 &&\r\n      ix < nx - (spansX ? 1 : 0) &&\r\n      iy < ny - (spansY ? 1 : 0)\r\n    )\r\n  }\r\n\r\n  return members.every(\r\n    (member) =>\r\n      // 葉?닪?뺛걚?귛늾?뗣귛ㄷ歟곥걣?긱겗??씊?믤뙁?쇻겏 buildingLayout ?뚧뒘?믡굥??\r\n      sectionKinds.get(member.sectionId) === member.kind &&\r\n      storyIds.has(member.storyId) &&\r\n      // ?겹꺁?껁깋??쨼?믤뙁?쇾퐤營?겘 gridPoint ??RangeError ?㎪뒘?믡곩뀲?싥궎?녈걣?썬걾?뗣?\r\n      // ?앫겗旅덁뻑?믦눎?뺜퓷耶섅걣?멥걦??겎?곫А??Ø?뤵겎?귛릪?섉??㎬맼?▲굥??\r\n      inGrid(member.kind, member.position),\r\n  )\r\n}\r\n\r\nfunction hasGridLabels(grid: unknown): boolean {\r\n  if (!isRecord(grid)) return false\r\n  const { xSpans, ySpans, xLabels, yLabels } = grid\r\n  if (!Array.isArray(xSpans) || !Array.isArray(ySpans)) return false\r\n\r\n  return (\r\n    (xLabels === undefined || isGridLabels(xLabels, xSpans.length)) &&\r\n    (yLabels === undefined || isGridLabels(yLabels, ySpans.length))\r\n  )\r\n}\r\n\r\nfunction isProjectShape(value: unknown): boolean {\r\n  if (!isRecord(value)) return false\r\n\r\n  const { stories, sections, members, notes, unitMass } = value\r\n\r\n  return (\r\n    isString(value.name) &&\r\n    hasShape(value.grid, { xSpans: isNumberArray, ySpans: isNumberArray }) &&\r\n    // ?쇰꺼? ?놁뼱???섏?留? ?덉쑝硫?異뺤쓽 蹂몄닔? 留욎븘???쒕떎 ???닿툔??諛곗뿴?\r\n    // ?뚯뼱???싥굤??쓽 ?대쫫?멸??띾? ?껋? 湲곕줉?닿퀬, 洹몃?濡??먮㈃ ?붾㈃???됰슧??\r\n    // 異뺤뿉 ?대쫫??遺숈씤??\r\n    hasGridLabels(value.grid) &&\r\n    // 令뷩겗 stories ??뚪쉸?뚨꽒?꾣죭餓뜰띲겎??겒?뤷즸?뚣걼鼇섌뙯?졼귟＝?곥겘?녈굥???\r\n    // stories[0] ?믤뿢若싧ㅳ겓鵝욍걝??\r\n    Array.isArray(stories) &&\r\n    stories.length > 0 &&\r\n    stories.every((story) =>\r\n      hasShape(story, { id: isString, name: isString, height: isFiniteNumber }),\r\n    ) &&\r\n    Array.isArray(sections) &&\r\n    sections.every(\r\n      (section) =>\r\n        hasShape(section, {\r\n          id: isString,\r\n          // ?ㅵ닪耶먦겘?밧닪?졼귙걪?볝걣 union ??쨼??ㅳ걽?ⓦ곩숱??싥겂?잆겲??\r\n          // ??씊??옗?녴걢?뚣걣?멥겧?싥곭츞若싥겗?붶릎?㎬맼?▲굥??\r\n          kind: isMemberKind,\r\n          mark: isString,\r\n        }) &&\r\n        // ?쎼걚?귡뀓嶺뗣겗?ε뒟?귞Ŧ?γ겎?듐걣?뺛걝?귛뀻?싥겗?닸??졼걨?㎪툑?얇걵?뗣겏??\r\n        // ?쎼걚 ??쵟?묆걼??씊?뚪싥겂??릭嶺뗣겗?졾램野멩퀡??NaN ??겲?얍냵鼇녔쎑??릦鼇덀겲??\r\n        // 役곥굦?걅ain/hoop/stirrup ??쵟?묆걼??씊??generateColumnRebar ??릎??\r\n        // TypeError ?ャ겒?뗢붵겑?▲굢?귙걪??뼟?겹걣閭㏂굙?잆걢?ｃ걼永먩옖?앫겗?귙겗?졼?\r\n        // ?앫굮?멥겧?뗣겗??툓?㎩닩?ε춴?믤쩂?곥겍?귙굥?뗣굢?졼?\r\n        hasShape(section, SECTION_FIELDS[(section as Section).kind]),\r\n    ) &&\r\n    Array.isArray(members) &&\r\n    members.every(\r\n      (member) =>\r\n        hasShape(member, {\r\n          id: isString,\r\n          kind: isMemberKind,\r\n          sectionId: isString,\r\n          storyId: isString,\r\n        }) &&\r\n        // position ?뚨꽒?묆굦??buildingLayout ??`'axis' in member.position` ??\r\n        // ?앫겗?담겎 TypeError ?ャ겒?뗣귟뻗??'X'/'Y' 餓ε쨼?믧싥걬?ゃ걚 ??\r\n        // 訝됮쟿轢붺츞耶먦겎 Y ?ヨ맼?▲겍?곩쎋?㏂겓?▲걚?묆걤??ㄷ歟곥굮容쇻겂?╊퐳?뗣?\r\n        hasShape(member, {\r\n          position: shapedAs(POSITION_FIELDS[(member as Member).kind]),\r\n        }) &&\r\n        // ?뗥룭??꽒?뤵겍?덀걚 (?뚪뼀?ｃ겒?쀣띲겗?? ?뚣곫쐣?뗣겒?됮뀓?쀣겎?ゃ걨?뚣겙\r\n        // ?ゃ굢?ゃ걚 ??openingDeduction ?뚥릎?믦き?볝겎轝좈솮?뤵굮?뷩걲?뗣굢?졼?\r\n        ((member as { openings?: unknown }).openings === undefined ||\r\n          (Array.isArray((member as { openings?: unknown }).openings) &&\r\n            ((member as { openings: unknown[] }).openings).every(\r\n              isOpeningWithReinforcements,\r\n            ))),\r\n    ) &&\r\n    (notes === undefined ||\r\n      (isRecord(notes) && Object.values(notes).every(isString))) &&\r\n    (unitMass === undefined ||\r\n      (isRecord(unitMass) && Object.values(unitMass).every(isFiniteNumber))) &&\r\n    // ?볝걪?얇겎??3 ?ㅳ겗?띶닓??숱?뚧툑?볝겎?꾠굥?귝츐?뗣겗??틨?꾠겗?뉎걮?덀걚?졼?\r\n    hasIntactReferences(\r\n      value.grid as Grid,\r\n      sections as { id: string; kind: MemberKind }[],\r\n      stories as { id: string }[],\r\n      members as {\r\n        kind: MemberKind\r\n        sectionId: string\r\n        storyId: string\r\n        position: ReferencedPosition\r\n      }[],\r\n    )\r\n  )\r\n}\r\n\r\nexport function deserializeProject(json: string): Project {\r\n  const parsed: unknown = JSON.parse(json)\r\n\r\n  if (\r\n    typeof parsed !== 'object' ||\r\n    parsed === null ||\r\n    !('schemaVersion' in parsed) ||\r\n    parsed.schemaVersion !== PROJECT_SCHEMA_VERSION\r\n  ) {\r\n    throw new Error(\r\n      `Unsupported Project schemaVersion; expected ${PROJECT_SCHEMA_VERSION}`,\r\n    )\r\n  }\r\n\r\n  if (!isProjectShape(parsed)) {\r\n    throw new Error('Project shape mismatch')\r\n  }\r\n\r\n  return parsed as Project\r\n}\r\n--- src/domain/rebar/wall.ts\r\nimport type { BarSize, Member, WallSection } from '../model/member'\r\nimport type { WallSpan } from '../model/project'\r\nimport type { Rebar, RebarSplice, RebarZone } from '../model/rebar'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { coverConditions, lookupRule } from '../rules/lookup'\r\nimport type { RuleHit, RulePack } from '../rules/types'\r\nimport {\r\n  distributionCount,\r\n  intervalSpliceCount,\r\n  spliceCount,\r\n  spliceLengthMm,\r\n} from './measurement'\r\nimport { openingDeduction } from './opening'\r\nimport { stirrupPositions } from './stirrup-layout'\r\n\r\n/**\r\n * ?먬쐡鶯곻펷?⒲꺖?▲꺍礪뗩졼겗鶯곻펹??뀓嶺뗣귝빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯**1)**?뚦즯凉뤸쭓?졽빳鸚뽧?\r\n * ?졼걨?믣츪獒끹걲????2)?뚦즯凉뤸쭓?졼띲겘塋?깿嶺뗣꺕鶯곫쥈嶺뗣겲?㎩뙷?녴걣罌쀣걟?뗥닪??씉?뉎겎?귙굥??\r\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬??\r\n * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲쳵?뺛겘?롩쳵?㎯겘?ゃ걦?끾퀡遙섅걬?곲빓?뺛겘\r\n * ?긷퓘?볝겎??겒?뤷냵力뺡빓?뺛겓?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\r\n *\r\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲????`Member.openings` ?뚦룛?묈룚?ｃ걼?끾퀡野멩퀡?졼걨??\r\n * ?앫겗?뗥룭?믤Ø?뉎굥?с굮??걦?쀣곫쵟?ㅹ뇧?붵겏?ュ냵鼇녈겗烏뚣굮?녴걨?뗣귡뼀?ｃ굮與ゅ늾?ｃ걼\r\n * 潁?춮??텤?뗣겘?뚣걯 2竊덌폊竊됧즯1)????퐜?멥겎 0?뗦??ャ겒?뗣귡뼀?ｈ짒凉루춮??릪?끹걣\r\n * ?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겏冶붶뻣?쇻굥??겎獒썲뱚??퐳?됥겒??(ADR-029?팕14)??\r\n */\r\nexport interface WallRebarInput {\r\n  member: Member\r\n  section: WallSection\r\n  span: WallSpan\r\n}\r\n\r\nfunction barDiameter(size: BarSize): number {\r\n  const diameter = Number(size.replace(/^D/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid BarSize: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\nfunction millimetres(rule: RuleHit, diameter?: number): number {\r\n  if (rule.unit === 'mm') return rule.value\r\n  if (rule.unit === 'd' && diameter !== undefined) {\r\n    return rule.value * diameter\r\n  }\r\n\r\n  throw new Error(\r\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\r\n  )\r\n}\r\n\r\nexport function generateWallRebar(\r\n  input: WallRebarInput,\r\n  pack: RulePack,\r\n): Rebar[] {\r\n  const { member, section, span } = input\r\n  const conditions = { fc: section.fc, grade: section.grade, hook: false }\r\n\r\n  const coverQuery =\r\n    section.wallClass === '?먨뒟鶯곦빳鸚?\r\n      ? {\r\n          // 烏?.3.6 ??뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥띹죱??exposure ?믤똻?잆겒?꾠?\r\n          // ?묈즯??닪??MemberKind ?㎯겘?ゃ걦?갮allSection ??뙷?녴겏?쀣겍?볝겗烏뚣굮?멥겤??\r\n          memberKind: '?묈즯',\r\n          soilContact: false,\r\n          finish: section.finish,\r\n        }\r\n      : coverConditions(section)\r\n  const coverRule = lookupRule(pack, 'cover.minimum', coverQuery)\r\n  const fabricationCoverAdditionRule = lookupRule(\r\n    pack,\r\n    'cover.fabrication.addition',\r\n    {},\r\n  )\r\n  // 若싩???〃5.3.4 ????у?L1?귛릪烏ⓦ겓鶯곩컗?ⓦ겗?쀣겘?ゃ걦?갟2 ??컦歟곥꺕L3 ??궧?⒲깣??\r\n  // ?먦굢?뚣굥竊덅〃??걣?앫겗2?ㅳ걽?묆굮?띷뙁?숋펹??겎?곩즯嶺뗣겘訝?уㅳ굮凉뺛걦??\r\n  const anchorageRule = lookupRule(pack, 'anchorage.L1', conditions)\r\n  const tableLapRule = lookupRule(pack, 'lap.L1', conditions)\r\n  // 5.3.4(3)(節? ??툔?먦겘?먨뒟鶯곥걽?묆겓?⑴뵪?쇻굥?귟먨뒟鶯곦빳鸚뽧겘\r\n  // 烏?.3.2 ??L1 ?졼걨?믢슴?꾠걄ookupRule ?ャ굚?γ굢?ゃ걚 (ADR-036 ??き????\r\n  const wallLapMinimumRule =\r\n    section.wallClass === '?먨뒟鶯곦빳鸚?\r\n      ? undefined\r\n      : lookupRule(pack, 'lap.wall.minimum', {})\r\n  const spliceFactorRule = lookupRule(pack, 'measure.splice.length.factor', {\r\n    method: section.spliceMethod,\r\n  })\r\n  const distributionAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.distribution.addition',\r\n    {},\r\n  )\r\n\r\n  const minimumCover = millimetres(coverRule)\r\n  const fabricationCover =\r\n    minimumCover + millimetres(fabricationCoverAdditionRule)\r\n  const layerOffsets = wallLayerOffsets(member, section, fabricationCover)\r\n\r\n  const shared = {\r\n    member,\r\n    section,\r\n    span,\r\n    layerOffsets,\r\n    anchorageRule,\r\n    tableLapRule,\r\n    wallLapMinimumRule,\r\n    spliceFactorRule,\r\n    distributionAdditionRule,\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n    fabricationCover,\r\n    pack,\r\n  }\r\n\r\n  return [\r\n    ...buildWallBars({\r\n      ...shared,\r\n      role: '潁?춮',\r\n      size: section.vertical.size,\r\n      pitchMm: section.vertical.pitch,\r\n      startOffsetMm: section.vertical.startOffsetMm,\r\n      // 潁?춮??즯??쳵?뺛굮歷с굤?곩냵力뺡빓?뺛겓?꿔굤餓섅걨?뗣?\r\n      bodyLengthMm: span.clearHeightMm,\r\n      distributionOverMm: span.clearLengthMm,\r\n      bodyLabel: '?끾퀡遙섅걬',\r\n      distributionLabel: '?끾퀡?룔걬',\r\n      repeatAxis: 'x',\r\n      barAxis: 'y',\r\n    }),\r\n    ...buildWallBars({\r\n      ...shared,\r\n      role: '與ょ춮',\r\n      size: section.horizontal.size,\r\n      pitchMm: section.horizontal.pitch,\r\n      startOffsetMm: section.horizontal.startOffsetMm,\r\n      // 與ょ춮??즯??빓?뺛굮歷с굤?곩냵力뺡쳵?뺛겓?꿔굤餓섅걨?뗣?\r\n      bodyLengthMm: span.clearLengthMm,\r\n      distributionOverMm: span.clearHeightMm,\r\n      bodyLabel: '?끾퀡?룔걬',\r\n      distributionLabel: '?끾퀡遙섅걬',\r\n      repeatAxis: 'y',\r\n      barAxis: 'x',\r\n    }),\r\n    ...openingReinforcementRebars(member),\r\n  ]\r\n}\r\n\r\nfunction openingReinforcementRebars(member: Member): Rebar[] {\r\n  return (member.openings ?? []).flatMap((opening) =>\r\n    (opening.reinforcements ?? []).flatMap((reinforcement, index) => {\r\n      // A zero length is the UI's persisted ?よ빪鼇?state. Do not expose it as\r\n      // a zero-quantity Rebar, which would make the row look transcribed.\r\n      if (reinforcement.lengthMm === 0) return []\r\n\r\n      return [{\r\n        id: `${member.id}|opening-${opening.id}|reinforcement-${index}`,\r\n        memberId: member.id,\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: reinforcement.size,\r\n        count: reinforcement.count,\r\n        length: reinforcement.lengthMm,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [reinforcement.lengthMm, 0, 0],\r\n        ],\r\n        closed: false,\r\n        formula:\r\n          `鼇?쮫?룔걬 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.lengthMm}mm 竊?` +\r\n          `?ф빊 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.count}??竊?孃?竊?${reinforcement.size} ` +\r\n          `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ?ゃ걡?멥걤 ???뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑?ャ굠?딂쮫歷с꺕鼇덄츞竊?,\r\n        ruleHits: [],\r\n      }]\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * ?띸춮??광?뚦즯?싥겗?⒲걪?ョ쳦?ㅳ걢 (mm)?귙??뽧꺂??륫?㏂겗?뗣겤?듾퐤營?곥궥?녈궛?ャ겘\r\n * ?싥걬??릎鸚?겎?귙굥??D 壤®듁?ャ걮?뗥듅?뗣겒?????곈뇧??광?겹걽?묆굮誤뗣굥??\r\n */\r\nfunction wallLayerOffsets(\r\n  member: Member,\r\n  section: WallSection,\r\n  fabricationCover: number,\r\n): number[] {\r\n  if (section.layers === 1) return [section.thickness / 2]\r\n\r\n  const inner = section.thickness - fabricationCover\r\n\r\n  // ?졾램?ⓦ걢?뜰굤횞2 ?뚦즯?싥굮擁끹걟?뗣겏2掠ㅳ걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂?잌즯?ャ겒?뗣?\r\n  // 容쇻겂?╊릎鸚?겓野꾠걵?싥곥걹??깿?먦걽?묋맼?ⓦ걲竊덃윶??뒥藥ε?力뺛궗?쇈깋?ⓨ릪?섉돮?꾬펹??\r\n  if (inner <= fabricationCover) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?먬쐡鶯???뽧꺂?띸춮 must fit the 鶯곩럻: ${member.id} ` +\r\n        `(鶯곩럻 ${section.thickness} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCover})`,\r\n    )\r\n  }\r\n\r\n  return [fabricationCover, inner]\r\n}\r\n\r\ninterface WallBarInput {\r\n  member: Member\r\n  section: WallSection\r\n  span: WallSpan\r\n  role: '潁?춮' | '與ょ춮'\r\n  size: BarSize\r\n  pitchMm: number\r\n  startOffsetMm: number\r\n  bodyLengthMm: number\r\n  distributionOverMm: number\r\n  bodyLabel: string\r\n  distributionLabel: string\r\n  repeatAxis: 'x' | 'y'\r\n  /** ?꾤춮?뚩뎔?뗥릲????濚겹굤瓦붵걮邕멥겏?답벡?쇻굥?귡뼀?ｉ깿??쵟?ㅳ걣?볝굦?믦쫳??*/\r\n  barAxis: 'x' | 'y'\r\n  layerOffsets: number[]\r\n  anchorageRule: RuleHit\r\n  tableLapRule: RuleHit\r\n  wallLapMinimumRule: RuleHit | undefined\r\n  spliceFactorRule: RuleHit\r\n  distributionAdditionRule: RuleHit\r\n  coverRule: RuleHit\r\n  fabricationCoverAdditionRule: RuleHit\r\n  fabricationCover: number\r\n  pack: RulePack\r\n}\r\n\r\nfunction buildWallBars(input: WallBarInput): Rebar[] {\r\n  const {\r\n    member,\r\n    section,\r\n    span,\r\n    role,\r\n    size,\r\n    pitchMm,\r\n    startOffsetMm,\r\n    bodyLengthMm,\r\n    distributionOverMm,\r\n    bodyLabel,\r\n    distributionLabel,\r\n    repeatAxis,\r\n    barAxis,\r\n    layerOffsets,\r\n    anchorageRule,\r\n    tableLapRule,\r\n    wallLapMinimumRule,\r\n    spliceFactorRule,\r\n    distributionAdditionRule,\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n    fabricationCover,\r\n    pack,\r\n  } = input\r\n\r\n  const diameter = barDiameter(size)\r\n  const anchorageMm = millimetres(anchorageRule, diameter)\r\n  const tableLapMm = millimetres(tableLapRule, diameter)\r\n  const lapCandidates = [\r\n    tableLapMm,\r\n    ...(wallLapMinimumRule\r\n      ? [millimetres(wallLapMinimumRule, diameter)]\r\n      : []),\r\n  ]\r\n  const lapMm = Math.max(...lapCandidates)\r\n\r\n  // 1?싧뎴7) ??돯餓섉쑍?겹겘1掠ㅵ늽?졼귛광?곤펷?룔꺍?겹꺂竊뤵??뽧꺂竊됥겘誤뤸틬?㎯겘?ゃ걦\r\n  // 鶯곥꺁?밤깉??쮼雍됥겎?귙굤?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)??\r\n  const perLayerCount = distributionCount(\r\n    distributionOverMm,\r\n    pitchMm,\r\n    distributionAdditionRule,\r\n  )\r\n  const layout = stirrupPositions(distributionOverMm, pitchMm, startOffsetMm)\r\n\r\n  // 1?싧뎴8) ???뗥룭?ⓦ굮與ゅ늾?뗦쑍?졼걨?뚪뼀?ｃ겗?끾퀡野멩퀡?졼걨??걦?ゃ굥?귝쵟?ㅹ뇧?붵겏??\r\n  // ?낁㉢??죱?뚦늽?뗣굦?뗰펷1?싧뎴 ?띷뻼?뚩쫸?쇈곩숱?뜰곩?力뺟춬?붵겏?ャ랃펹??\r\n  const deduction = openingDeduction(\r\n    {\r\n      openings: member.openings ?? [],\r\n      clearXMm: span.clearLengthMm,\r\n      clearYMm: span.clearHeightMm,\r\n      barAxis,\r\n      pitchMm,\r\n      totalCount: perLayerCount,\r\n    },\r\n    pack,\r\n  )\r\n  const openingLayout = deduction.layout\r\n  const ignoredTerm =\r\n    deduction.ignored.length === 0\r\n      ? ''\r\n      : ` 竊?轝좈솮?쀣겒?꾦뼀??${deduction.ignored\r\n          .map(({ widthMm, heightMm }) => `${widthMm}횞${heightMm}`)\r\n          .join('??)}竊??싧뎴8) 鵝녷쎑 ??1?뗦?壤볝걼?듿냵力뺡씊令?.5?▽빳訝뗰펹`\r\n\r\n  // 3D ?ユ룒?뗣굦?뗧탪瓮?귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?ゃ걚竊덅〃5.3.3 ?뚦렅?뉎겎?삣깗竊됥?\r\n  // ?뗥룭??쵟?묆굚?볝걪?ャ겘?얇굦?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝??겎?곮〃鹽븅깿??\r\n  // `Member.openings` ?㎩늾??(ADR-029)??\r\n  const pathLengthMm = bodyLengthMm + 2 * anchorageMm\r\n\r\n  const anchorageTarget = role === '潁?춮' ? '訝듾툔??ㄷ歟곥꺕佯딀씮' : '訝▼겢??윶'\r\n  const layerTerm =\r\n    section.layers === 1 ? '?룔꺍?겹꺂?띸춮 횞1' : `??뽧꺂?띸춮 횞${section.layers}`\r\n  const roleKey = role === '潁?춮' ? 'vertical' : 'horizontal'\r\n\r\n  const zones: RebarZone[] = [\r\n    {\r\n      kind: '若싩?',\r\n      ruleKey: anchorageRule.key,\r\n      pathFromMm: 0,\r\n      pathToMm: anchorageMm,\r\n    },\r\n    {\r\n      kind: '若싩?',\r\n      ruleKey: anchorageRule.key,\r\n      pathFromMm: pathLengthMm - anchorageMm,\r\n      pathToMm: pathLengthMm,\r\n    },\r\n  ]\r\n\r\n  // 餓ｈ〃1?с겘濚겹굤瓦붵걮邕멥겗?잏궧?ョ쉰????若잓슋??퐤營?겘 placement ?뚥툗?덀굥??\r\n  // 躍?춮?삠걗?겹굢嶺뗣겏?뚣걯榮꾣씇?㎯곮〃鹽븅깿?뚧뼪?㏂걢?됥깞?껁긽?믤떮?꾤쎍?뺛겒?꾠걼?곥겎?귙굥??\r\n  const z = layerOffsets[0]\r\n  const points: [number, number, number][] =\r\n    role === '潁?춮'\r\n      ? [\r\n          [0, -anchorageMm, z],\r\n          [0, bodyLengthMm + anchorageMm, z],\r\n        ]\r\n      : [\r\n          [-anchorageMm, 0, z],\r\n          [bodyLengthMm + anchorageMm, 0, z],\r\n        ]\r\n\r\n  return deduction.groups.map(({ deductionMm, count: groupCount }) => {\r\n    // 1?싧뎴4) ?뚨텤?뗧츋??겹굮黎귙굙?뗣뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띲겘轝좈솮孃뚣겗?룔걬?졼?\r\n    const measuredLengthMm = bodyLengthMm - deductionMm + 2 * anchorageMm\r\n\r\n    const splice = resolveWallSplice({\r\n      role,\r\n      section,\r\n      size,\r\n      measuredLengthMm,\r\n      lapMm,\r\n      deducted: deductionMm > 0,\r\n      tableLapRule,\r\n      wallLapMinimumRule,\r\n      spliceFactorRule,\r\n      pack,\r\n    })\r\n\r\n    const designLengthMm = measuredLengthMm + splice.lengthMm\r\n    const count = groupCount * section.layers\r\n    const positionsMm = openingLayout\r\n      ? openingLayout.positionsMm.filter(\r\n          (_, index) => openingLayout.deductionsMm[index] === deductionMm,\r\n        )\r\n      : null\r\n\r\n    const deductionTerm =\r\n      deductionMm === 0\r\n        ? ''\r\n        : ` ???뗥룭?ⓦ겗轝좈솮 ${deductionMm}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??兩뷴끁窈욅춬` +\r\n          `?뗥룭?ⓦ겗?끾퀡野멩퀡?ャ굠?뗰펹`\r\n    const splitTerm =\r\n      deduction.groups.length === 1\r\n        ? ''\r\n        : ` ??걝??{\r\n            deductionMm === 0 ? '?뗥룭?믤Ø?뉎굢?ゃ걚' : `${deductionMm}?믤쵟??\r\n          } ${groupCount}??\r\n\r\n    return {\r\n      id: `${member.id}|${roleKey}${\r\n        deductionMm === 0 ? '' : `|轝좈솮${deductionMm}`\r\n      }`,\r\n      memberId: member.id,\r\n      role,\r\n      size,\r\n      shape: 'straight' as const,\r\n      points,\r\n      closed: false,\r\n      length: designLengthMm,\r\n      count,\r\n      placement: {\r\n        axis: repeatAxis,\r\n        clearMm: distributionOverMm,\r\n        pitchMm,\r\n        startOffsetMm,\r\n        lastGapMm: layout.lastGapMm,\r\n        positionCount: positionsMm\r\n          ? positionsMm.length\r\n          : layout.positionsMm.length,\r\n        ...(positionsMm ? { positionsMm } : {}),\r\n      },\r\n      splice,\r\n      zones,\r\n      ruleHits: [\r\n        coverRule,\r\n        fabricationCoverAdditionRule,\r\n        anchorageRule,\r\n        distributionAdditionRule,\r\n        ...deduction.rules,\r\n        ...splice.rules,\r\n      ],\r\n      formula:\r\n        `鼇?쮫?룔걬 竊?${bodyLabel} ${bodyLengthMm}${deductionTerm} 竊?若싩? L1 ` +\r\n        `${anchorageRule.value}d(${anchorageMm}) 횞 2竊덁륫塋???${anchorageTarget}?멨츣?竊? +\r\n        ` 竊?泳숁뎸 ${splice.formula} 竊?${designLengthMm} 竊?` +\r\n        `?ф빊 竊???{distributionLabel} ${distributionOverMm} 첨 ?붵긿??${pitchMm}??` +\r\n        `竊?${distributionAdditionRule.value}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴7)竊됵폓 ${perLayerCount}` +\r\n        `${splitTerm} 횞 ${layerTerm} 竊?${count} 竊?` +\r\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊??좂츞 ` +\r\n        `${fabricationCoverAdditionRule.value} 竊?${fabricationCover}竊?竊?` +\r\n        `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚竊덃룒?뗣굦?뗩빓??` +\r\n        `${pathLengthMm} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹${ignoredTerm}`,\r\n    }\r\n  })\r\n}\r\n\r\ninterface WallSpliceInput {\r\n  role: '潁?춮' | '與ょ춮'\r\n  section: WallSection\r\n  size: BarSize\r\n  /** 1?싧뎴4) ?뚩??녴뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띯??뗥룭?ⓦ겗轝좈솮?믣폊?꾠걼孃뚣겎?귙굥 */\r\n  measuredLengthMm: number\r\n  lapMm: number\r\n  /** ?볝겗獰ㅳ걣?뗥룭?ⓦ굮與ゅ늾?ｃ겍??걼?뚣겍?꾠굥??(2竊덌폊竊됧즯1)??鵝녷쎑) */\r\n  deducted: boolean\r\n  tableLapRule: RuleHit\r\n  wallLapMinimumRule: RuleHit | undefined\r\n  spliceFactorRule: RuleHit\r\n  pack: RulePack\r\n}\r\n\r\n/**\r\n * 2竊덌폊竊됧즯1)????潁?춮?ⓩØ嶺뗣겎?겹걟?밤걣?녴걢?뚣굥?????씉?뉎겎?귙굥??\r\n * ?뚨를嶺뗣겗泳숁뎸??렅?뉎겏?쀣겍?꾦쉸?ワ폂?뗦??귙굥?귙겗?ⓦ걮?╈╉겲?잆곫Ø嶺뗣겗泳숁뎸???\r\n *  竊묌싧뎴竊뷂펹?ャ굠?뗣띲?\r\n */\r\nfunction resolveWallSplice(input: WallSpliceInput): RebarSplice {\r\n  const {\r\n    role,\r\n    section,\r\n    size,\r\n    measuredLengthMm,\r\n    lapMm,\r\n    deducted,\r\n    tableLapRule,\r\n    wallLapMinimumRule,\r\n    spliceFactorRule,\r\n    pack,\r\n  } = input\r\n\r\n  let countRule: RuleHit\r\n  let countPerBar: number\r\n  let countFormula: string\r\n\r\n  if (role === '潁?춮' && deducted) {\r\n    // ?뗥룭?믤Ø?뉎굥潁?춮??쉸遙섇뀲鵝볝겓?뤵걼?됥걳?곲뼀?ｉ깿?겼즯?삣엩?뚦즯??를嶺뗣겓?ゃ굥??\r\n    // ?뚣걯?끹겗鵝녷쎑?뚣뚪뼀?ｉ깿?겼즯?곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗣띲겏若싥굙?뗣?\r\n    countRule = lookupRule(pack, 'measure.splice.wall.opening', {})\r\n    countPerBar = spliceCount(countRule)\r\n    countFormula =\r\n      `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)??鵝녷쎑 ??` +\r\n      `?뗥룭?②뀺鶯곥곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗰펹`\r\n  } else if (role === '潁?춮') {\r\n    countRule = lookupRule(pack, 'measure.splice.wall.vertical', {})\r\n    countPerBar = spliceCount(countRule)\r\n    countFormula = `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????潁?춮??텤?뗣겘?꾦쉸???뗦?竊?\r\n  } else {\r\n    countRule = lookupRule(pack, 'measure.splice.interval', { size })\r\n    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\r\n    countFormula =\r\n      `?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏 竊?${countPerBar}?뗦?` +\r\n      `竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????1?싧뎴4) ?ユ댗?숋펹`\r\n  }\r\n\r\n  const lengthMm = spliceLengthMm(countPerBar, lapMm, spliceFactorRule)\r\n  const rules: RuleHit[] = [countRule, spliceFactorRule]\r\n  if (lengthMm > 0) {\r\n    rules.push(tableLapRule)\r\n    if (wallLapMinimumRule) rules.push(wallLapMinimumRule)\r\n  }\r\n\r\n  const lapTerm =\r\n    lengthMm > 0\r\n      ? wallLapMinimumRule\r\n        ? `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 5.3.4(3)(節? ??` +\r\n          `烏?.3.2 ??${tableLapRule.value}d ?②먨뒟鶯곥겗訝뗩솏 ` +\r\n          `${wallLapMinimumRule.value}d ??ㄷ?띲걚?뱄펹竊?${lengthMm}`\r\n        : `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 烏?.3.2 ` +\r\n          `??${tableLapRule.value}d ??겳??.3.4(3)(節? ??먨뒟鶯곲솏若???` +\r\n          `?먨뒟鶯곦빳鸚뽧겘烏?.3.2??겳竊뉯DR-036??き?울펹竊됵폓 ${lengthMm}`\r\n      : `${countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\r\n\r\n  return {\r\n    method: section.spliceMethod,\r\n    countPerBar,\r\n    lengthMm,\r\n    rules,\r\n    formula:\r\n      `泳숁뎸嶸뉑???竊?${countFormula} 竊??밧폀 竊?${section.spliceMethod} 竊?` +\r\n      `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${lapTerm} 竊?` +\r\n      `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\r\n  }\r\n}\r\n--- src/domain/rebar/wall.test.ts\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { Member, WallSection } from '../model/member'\r\nimport type { WallSpan } from '../model/project'\r\nimport { lookupRule } from '../rules/lookup'\r\nimport { jpMlitRulePack } from '../../rulepack'\r\nimport { generateWallRebar, type WallRebarInput } from './wall'\r\n\r\nconst member: Member = {\r\n  id: '1F-W1-X1Y1-X',\r\n  kind: '?먬쐡鶯?,\r\n  memberClass: '翁?퐪',\r\n  sectionId: 'section-W1',\r\n  storyId: '1F',\r\n  position: { axis: 'X', ix: 0, iy: 0 },\r\n}\r\n\r\nconst section: WallSection = {\r\n  id: 'section-W1',\r\n  kind: '?먬쐡鶯?,\r\n  mark: 'W1',\r\n  thickness: 200,\r\n  fc: 24,\r\n  grade: 'SD345',\r\n  exposure: '掠뗥냵',\r\n  finish: '餓뺜툓?믡걗??,\r\n  spliceMethod: '?띲겖泳숁뎸',\r\n  layers: 2,\r\n  vertical: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n  horizontal: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n}\r\n\r\n// 6000 ?밤깙?녈꺕??800횞800 ??냵力?5200?곲쉸遙?4200 ?뗣굢鸚㎪쥈?쎼걚 750 ?믣폊?꾠걼?끾퀡 3450??\r\nconst span: WallSpan = {\r\n  axis: 'X',\r\n  clearLengthMm: 5200,\r\n  clearHeightMm: 3450,\r\n  startFaceOffsetMm: 400,\r\n  endFaceOffsetMm: 400,\r\n  girderDepthAboveMm: 750,\r\n}\r\n\r\nfunction input(overrides: Partial<WallRebarInput> = {}): WallRebarInput {\r\n  return { member, section, span, ...overrides }\r\n}\r\n\r\nconst diameter = 13\r\nconst conditions = { fc: section.fc, grade: section.grade, hook: false }\r\nconst anchorage =\r\n  lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * diameter\r\nconst tableLap =\r\n  lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * diameter\r\nconst wallLapMinimum =\r\n  lookupRule(jpMlitRulePack, 'lap.wall.minimum', {}).value * diameter\r\nconst lap = Math.max(tableLap, wallLapMinimum)\r\nconst distributionAddition = lookupRule(\r\n  jpMlitRulePack,\r\n  'measure.distribution.addition',\r\n  {},\r\n).value\r\n\r\nfunction byRole(\r\n  generated: ReturnType<typeof generateWallRebar>,\r\n  role: '潁?춮' | '與ょ춮',\r\n) {\r\n  const rebar = generated.find((candidate) => candidate.role === role)\r\n  expect(rebar, `${role} should be generated`).toBeDefined()\r\n  return rebar!\r\n}\r\n\r\ndescribe('generateWallRebar', () => {\r\n  it('generates 潁?춮 and 與ょ춮 only', () => {\r\n    // 亮끾?嶺뗣겘鵝쒌굢?ゃ걚 ??1?싧뎴3) ??빓?뺛굮鶯곥겓?귚툗?덀굥?뚣곫쑍?겹굮若싥굙?뗦씉?뉎겘\r\n    // 2竊덌폆竊됪쥈3) ?㎪쥈?쀣걢?띷뙁?뺛겒?꾠귝쑍?겹굮獒썲뱚?뚥퐳?됥겒?꾠겏鼇덁툓?㎯걤?ゃ걚??\r\n    expect(generateWallRebar(input(), jpMlitRulePack).map(({ role }) => role))\r\n      .toEqual(['潁?춮', '與ょ춮'])\r\n  })\r\n\r\n  describe('潁?춮 ??令띸츞?뷸틬 2竊덌폊竊됧즯1)??, () => {\r\n    it('measures ?끾퀡遙섅걬 plus 若싩? at both ends', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      // ?뚧렏泳싥걲?뗤퍟??깿?녴겓若싩??쇻굥?귙겗?ⓦ걮?곩즯??쳵?뺚╈╉겓若싩??룔걬?믣뒥?덀걼??\r\n      // 訝듽겘鸚㎪쥈?곦툔??틞?욍꺕鸚㎪쥈?멨츣??쇻굥??겎訝←ク?ヤ퍡?뤵?\r\n      expect(vertical.length).toBe(3450 + 2 * anchorage + lap)\r\n    })\r\n\r\n    it('counts 1?싧뎴7) over ?끾퀡?룔걬, doubled by ??뽧꺂?띸춮', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      const perLayer = Math.ceil(5200 / 200) + distributionAddition\r\n      expect(vertical.count).toBe(perLayer * 2)\r\n    })\r\n\r\n    it('halves the count for ?룔꺍?겹꺂?띸춮', () => {\r\n      const single = generateWallRebar(\r\n        input({ section: { ...section, layers: 1 } }),\r\n        jpMlitRulePack,\r\n      )\r\n      const perLayer = Math.ceil(5200 / 200) + distributionAddition\r\n\r\n      expect(byRole(single, '潁?춮').count).toBe(perLayer)\r\n    })\r\n\r\n    it('takes 泳숁뎸 as ?꾦쉸???뗦? (2竊덌폊竊됧즯1)??, not the 1?싧뎴4) interval', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      expect(vertical.splice?.countPerBar).toBe(1)\r\n      expect(vertical.splice?.rules.map(({ key }) => key)).toContain(\r\n        'measure.splice.wall.vertical',\r\n      )\r\n    })\r\n\r\n    it('draws 若싩? beyond both ends of the ?끾퀡 panel', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n      const [bottom, top] = vertical.points\r\n\r\n      expect(bottom[1]).toBe(-anchorage)\r\n      expect(top[1]).toBe(3450 + anchorage)\r\n    })\r\n  })\r\n\r\n  describe('與ょ춮 ??令띸츞?뷸틬 2竊덌폊竊됧즯1)??, () => {\r\n    it('measures ?끾퀡?룔걬 plus 若싩? at both ends', () => {\r\n      const horizontal = byRole(\r\n        generateWallRebar(input(), jpMlitRulePack),\r\n        '與ょ춮',\r\n      )\r\n      const beforeSplice = 5200 + 2 * anchorage\r\n      const interval = lookupRule(jpMlitRulePack, 'measure.splice.interval', {\r\n        size: 'D13',\r\n      }).value\r\n      const splices = Math.floor(beforeSplice / interval)\r\n\r\n      expect(horizontal.length).toBe(beforeSplice + splices * lap)\r\n    })\r\n\r\n    it('counts 1?싧뎴7) over ?끾퀡遙섅걬, doubled by ??뽧꺂?띸춮', () => {\r\n      const horizontal = byRole(\r\n        generateWallRebar(input(), jpMlitRulePack),\r\n        '與ょ춮',\r\n      )\r\n\r\n      const perLayer = Math.ceil(3450 / 200) + distributionAddition\r\n      expect(horizontal.count).toBe(perLayer * 2)\r\n    })\r\n\r\n    it('returns to 1?싧뎴4) for its 泳숁뎸, as 2竊덌폊竊됧즯1)??directs', () => {\r\n      const horizontal = byRole(\r\n        generateWallRebar(input(), jpMlitRulePack),\r\n        '與ょ춮',\r\n      )\r\n\r\n      expect(horizontal.splice?.rules.map(({ key }) => key)).toContain(\r\n        'measure.splice.interval',\r\n      )\r\n    })\r\n  })\r\n\r\n  describe('?먨뒟鶯곥겗?띲겖泳숁뎸?룔걬 ??與숁틬餓뺞쭣??5.3.4(3)(節?', () => {\r\n    it('takes the larger of 40d and 烏?.3.2', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      expect(vertical.splice?.lengthMm).toBe(lap)\r\n      expect(lap).toBeGreaterThanOrEqual(wallLapMinimum)\r\n      expect(lap).toBeGreaterThanOrEqual(tableLap)\r\n    })\r\n\r\n    it('cites 烏?.3.2 and the ?먨뒟鶯?lower bound together', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n      const keys = vertical.splice?.rules.map(({ key }) => key) ?? []\r\n\r\n      expect(keys).toContain('lap.L1')\r\n      expect(keys).toContain('lap.wall.minimum')\r\n    })\r\n  })\r\n\r\n  describe('?с궧?㎪렏 ??1?싧뎴5)', () => {\r\n    it('keeps the 嶸뉑???but adds no length', () => {\r\n      const generated = generateWallRebar(\r\n        input({ section: { ...section, spliceMethod: '?с궧?㎪렏' } }),\r\n        jpMlitRulePack,\r\n      )\r\n      const vertical = byRole(generated, '潁?춮')\r\n\r\n      expect(vertical.splice?.countPerBar).toBe(1)\r\n      expect(vertical.splice?.lengthMm).toBe(0)\r\n      expect(vertical.length).toBe(3450 + 2 * anchorage)\r\n    })\r\n  })\r\n\r\n  it('carries the ?뗣겤??and 若싩? rules it actually looked up', () => {\r\n    const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n    const keys = vertical.ruleHits.map(({ key }) => key)\r\n\r\n    expect(keys).toContain('cover.minimum')\r\n    expect(keys).toContain('anchorage.L1')\r\n  })\r\n})\r\n\r\ndescribe('generateWallRebar ???뗥룭獒쒎섭嶺뗣겗鼇?쮫?녔쎑邕?쮼 (1?싧뎴8) ?ゃ걡?멥걤', () => {\r\n  const reinforcementMember: Member = {\r\n    ...member,\r\n    openings: [\r\n      {\r\n        id: 'W1-op1',\r\n        xMm: 2000,\r\n        yMm: 900,\r\n        widthMm: 1800,\r\n        heightMm: 1200,\r\n        reinforcements: [\r\n          { size: 'D13', count: 4, lengthMm: 1800 },\r\n          { size: 'D10', count: 2, lengthMm: 1200 },\r\n        ],\r\n      },\r\n    ],\r\n  }\r\n\r\n  it('emits each transcribed value as a separate straight Rebar', () => {\r\n    const reinforcements = generateWallRebar(\r\n      input({ member: reinforcementMember }),\r\n      jpMlitRulePack,\r\n    ).filter(({ role }) => role === '?뗥룭獒쒎섭嶺?)\r\n\r\n    expect(reinforcements).toHaveLength(2)\r\n    expect(reinforcements).toMatchObject([\r\n      {\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: 'D13',\r\n        count: 4,\r\n        length: 1800,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [1800, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      },\r\n      {\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: 'D10',\r\n        count: 2,\r\n        length: 1200,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [1200, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      },\r\n    ])\r\n\r\n    for (const rebar of reinforcements) {\r\n      expect(rebar).not.toHaveProperty('zones')\r\n      expect(rebar).not.toHaveProperty('placement')\r\n      expect(rebar.formula).toContain('鼇?쮫?녔쎑邕?쮼')\r\n      expect(rebar.formula).toContain('1?싧뎴8)')\r\n      expect(rebar.formula).toContain(`${rebar.length}`)\r\n      expect(rebar.formula).toContain(`${rebar.count}`)\r\n    }\r\n  })\r\n\r\n  it('does not emit an untranscribed zero-length row', () => {\r\n    const reinforcements = generateWallRebar(\r\n      input({\r\n        member: {\r\n          ...reinforcementMember,\r\n          openings: [\r\n            {\r\n              ...reinforcementMember.openings![0],\r\n              reinforcements: [{ size: 'D13', count: 4, lengthMm: 0 }],\r\n            },\r\n          ],\r\n        },\r\n      }),\r\n      jpMlitRulePack,\r\n    ).filter(({ role }) => role === '?뗥룭獒쒎섭嶺?)\r\n\r\n    expect(reinforcements).toEqual([])\r\n  })\r\n})\r\n\r\ndescribe('generateWallRebar ???뗥룭?ⓦ겗轝좈솮 (?곈뇧令띸츞?뷸틬 1?싧뎴8))', () => {\r\n  // ?끾퀡 5200횞3450?곥깞?껁긽 200?귞를嶺?27?с꺕與ょ춮 19??(1?싧뎴7))??\r\n  // ?뗥룭 1800횞1200 ??(2000, 900) ?ョ쉰?뤵겏?곭를嶺뗣겘 x (2000,3800) ??냵??8?с걣\r\n  // 遙섅걬 1200 ?믡곫Ø嶺뗣겘 y (900,2100) ??냵??6?с걣 亮?1800 ?믤쵟?뤵?\r\n  const openi