edMarks = new Set(parsedList.candidates.map(({ mark }) => mark))\\\\n   for (const mark of expectedMarks) expect(parsedMarks.has(mark), mark).toBe(true)\\\\n }\\\\n \\\\n+function titlePage(title: string, mark: string): TextPage {\\\\n+  return {\\\\n+    widthPt: 300,\\\\n+    heightPt: 180,\\\\n+    items: [\\\\n+      { str: title, x: 10, y: 5, w: 260, h: 8 },\\\\n+      { str: '符号', x: 10, y: 20, w: 20, h: 8 },\\\\n+      { str: mark, x: 140, y: 20, w: 12, h: 8 },\\\\n+      { str: '断面', x: 10, y: 50, w: 20, h: 8 },\\\\n+      { str: '400×600', x: 120, y: 50, w: 50, h: 8 },\\\\n+    ],\\\\n+  }\\\\n+}\\\\n+\\\\n describe('parseSectionLists', () => {\\\\n   it('parses the horizontal ojkk 柱リスト without inventing unsupported hoop sizes', () => {\\\\n     const parsed = parseSectionLists(readPage('ojkk-p2.json'))\\\\n     const columns = list(parsed, '柱リスト')\\\\n \\\\n     expectMarksInclude(columns, ['C1', 'C2', 'C2A', 'FC1'])\\\\n     // 이 표에는 断面 라벨 행이 없다 — 근거는 스케치에 붙은 가로·세로 치수 두 개뿐이고,\\\\n     // 세로는 회전 문자열이라 행 복원에서 빠진다. 둘을 짝지어야 700×700이 나온다.\\\\n     const c1 = candidate(columns, 'C1', '6F')\\\\n     expect(c1).toMatchObject({\\\\n       kind: '柱',\\\\n       mark: 'C1',\\\\n       shape: '矩形',\\\\n       storyLabel: '6F',\\\\n       main: { count: 16, size: 'D25' },\\\\n       hoop: { size: 'D13', pitchMm: 100 },\\\\n     })\\\\n     expect([c1.b, c1.d]).toEqual([700, 700])\\\\n     expect(c1.raw['断面']).toBeUndefined()\\\\n     expect(c1.issues).toHaveLength(0)\\\\n     expect(candidate(columns, 'C2A', '2F')).toMatchObject({\\\\n       main: { count: 20, size: 'D29' },\\\\n     })\\\\n \\\\n     // 高強度せん断補強筋 K13。フープの数量は断面周長だけで決まるので\\\\n@@ -311,71 +325,150 @@ describe('parseSectionLists', () => {\\\\n     expect(fg1.sideBar).toBeUndefined()\\\\n     expect(fg1.widthTie).toBeUndefined()\\\\n     expect(fg1.issues).not.toContain('腹筋解釈不能')\\\\n     expect(fg1.raw['腹筋']).toBeUndefined()\\\\n   })\\\\n \\\\n   it('keeps an unexpected 腹筋 cell raw instead of inventing a value', () => {\\\\n     const parsed = parseSectionLists({\\\\n       widthPt: 300,\\\\n       heightPt: 180,\\\\n       items: [\\\\n         { str: '大梁リスト', x: 10, y: 5, w: 60, h: 8 },\\\\n         { str: '符号', x: 10, y: 20, w: 20, h: 8 },\\\\n         { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\\\\n         { str: '腹筋', x: 10, y: 50, w: 20, h: 8 },\\\\n         { str: '2-K13', x: 125, y: 50, w: 36, h: 8 },\\\\n       ],\\\\n     })\\\\n     const g1 = candidate(list(parsed, '大梁リスト'), 'G1')\\\\n \\\\n     expect(g1.sideBar).toBeUndefined()\\\\n     expect(g1.raw['腹筋']).toBe('2-K13')\\\\n     expect(g1.issues).toContain('腹筋解釈不能')\\\\n   })\\\\n \\\\n-  it('uses only the first 径 + ピッチ after 幅止 in a title 特記', () => {\\\\n+  it('separates a three-digit 幅止め筋 pitch from the next numbered title item', () => {\\\\n+    const parsed = parseSectionLists(\\\\n+      titlePage(\\\\n+        '大梁リスト特記なき限り1.巾止筋D10-@5002.中吊り筋受け筋D10-@1000',\\\\n+        'G1',\\\\n+      ),\\\\n+    )\\\\n+    const g1 = candidate(list(parsed, '大梁リスト'), 'G1')\\\\n+\\\\n+    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 500 })\\\\n+  })\\\\n+\\\\n+  it.each([\\\\n+    {\\\\n+      fixture: 'ojkk-p3',\\\\n+      title: '大梁リスト※幅止筋はD10@1000とする',\\\\n+      listKind: '大梁リスト',\\\\n+      mark: 'G1',\\\\n+      expected: { size: 'D10', pitchMm: 1000 },\\\\n+    },\\\\n+    {\\\\n+      fixture: 'yokohama-p14',\\\\n+      title:\\\\n+        '大梁断面リスト特記なき限り1.巾止筋D10-@10002.中吊り筋受け筋D10-@10003.［］内はｶｯﾄｵﾌの柱面からの寸法を示す。',\\\\n+      listKind: '大梁断面リスト',\\\\n+      mark: 'G1',\\\\n+      expected: { size: 'D10', pitchMm: 1000 },\\\\n+    },\\\\n+    {\\\\n+      fixture: 'yokohama-p13 柱',\\\\n+      title:\\\\n+        '柱断面リスト1/30特記なき限り1.巾止筋D10-@5002.S13はKSS785を示す。3.HOOPの…',\\\\n+      listKind: '柱断面リスト',\\\\n+      mark: 'C1',\\\\n+      expected: undefined,\\\\n+    },\\\\n+    {\\\\n+      fixture: 'yokohama-p13 小梁',\\\\n+      title:\\\\n+        '小梁断面リスト1/30特記なき限り1.巾止筋D10-@10002.中吊り筋受け筋D10-@1000',\\\\n+      listKind: '小梁断面リスト',\\\\n+      mark: 'B1',\\\\n+      expected: undefined,\\\\n+    },\\\\n+  ])('reads the restored $fixture title without crossing item boundaries', ({\\\\n+    title,\\\\n+    listKind,\\\\n+    mark,\\\\n+    expected,\\\\n+  }) => {\\\\n+    const parsedCandidate = candidate(\\\\n+      list(parseSectionLists(titlePage(title, mark)), listKind),\\\\n+      mark,\\\\n+    )\\\\n+\\\\n+    expect(parsedCandidate.widthTie).toEqual(expected)\\\\n+  })\\\\n+\\\\n+  it('recognizes a two-digit next item number only after splitting sequential items', () => {\\\\n+    const title =\\\\n+      '大梁リスト特記なき限り1.a2.b3.c4.d5.e6.f7.g8.h9.巾止筋D10-@50010.中吊り筋'\\\\n+    const g1 = candidate(\\\\n+      list(parseSectionLists(titlePage(title, 'G1')), '大梁リスト'),\\\\n+      'G1',\\\\n+    )\\\\n+\\\\n+    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 500 })\\\\n+  })\\\\n+\\\\n+  it('keeps an unbounded 幅止め筋 title item raw with an issue', () => {\\\\n+    const parsed = parseSectionLists(\\\\n+      titlePage(\\\\n+        '大梁リスト特記幅止め筋D10-@1000中吊り筋受け筋D13-@200',\\\\n+        'G1',\\\\n+      ),\\\\n+    )\\\\n+    const g1 = candidate(list(parsed, '大梁リスト'), 'G1')\\\\n+\\\\n+    expect(g1.widthTie).toBeUndefined()\\\\n+    expect(g1.raw['幅止筋']).toBe(\\\\n+      '幅止め筋D10-@1000中吊り筋受け筋D13-@200',\\\\n+    )\\\\n+    expect(g1.issues).toContain('幅止め筋解釈不能')\\\\n+  })\\\\n+\\\\n+  it('keeps the pre-phase-7 numeric pitch limit for table cells', () => {\\\\n     const parsed = parseSectionLists({\\\\n       widthPt: 300,\\\\n       heightPt: 180,\\\\n       items: [\\\\n-        {\\\\n-          str: '大梁リスト特記幅止め筋D10-@1000中吊り筋受け筋D13-@200',\\\\n-          x: 10,\\\\n-          y: 5,\\\\n-          w: 240,\\\\n-          h: 8,\\\\n-        },\\\\n+        { str: '大梁リスト', x: 10, y: 5, w: 60, h: 8 },\\\\n         { str: '符号', x: 10, y: 20, w: 20, h: 8 },\\\\n         { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\\\\n-        { str: '断面', x: 10, y: 50, w: 20, h: 8 },\\\\n-        { str: '400×600', x: 120, y: 50, w: 50, h: 8 },\\\\n+        { str: 'ST', x: 10, y: 40, w: 20, h: 8 },\\\\n+        { str: 'D13@0100', x: 120, y: 40, w: 50, h: 8 },\\\\n       ],\\\\n     })\\\\n     const g1 = candidate(list(parsed, '大梁リスト'), 'G1')\\\\n \\\\n-    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 1000 })\\\\n+    expect(g1.stirrup).toEqual({ size: 'D13', pitchMm: 100 })\\\\n   })\\\\n \\\\n })\\\\n \\\\n // ── 전사 픽스처 전 셀 대조 ────────────────────────────────────────────────\\\\n // expected/*.json은 도면을 눈으로 읽어 적은 원문 독립 전사다 (ADR-010).\\\\n // 규칙: 파서가 확정한 값은 전사와 일치해야 하고(지어내기 검출), 확정하지 않은\\\\n // 칸은 raw 원문이 전사와 모순되면 안 된다. 어느 칸을 확정할지는 파서 정책이므로\\\\n // 값이 아니라 확정 칸 수를 핀으로 박아 대량 미확정 회귀를 막는다.\\\\n \\\\n interface ExpectedColumnCell {\\\\n   b?: number\\\\n   d?: number\\\\n   /** 円形断面の直径。b・d の代わりにこれを持つ (ADR-027) */\\\\n   直径?: number\\\\n   断面raw?: string\\\\n   主筋: string | Record<string, string>\\\\n   帯筋?: string\\\\n   HOOP?: string\\\\n }\\\\n \\\\n interface ExpectedColumnsDoc {\\\\n   entries: Array<{ mark: string; stories: Record<string, ExpectedColumnCell> }>\\\\n }\\\\n \\\\n302f1d7 docs(phase-8): 값을 지어내는 표제 경로와 가드레일 드리프트를 넘긴다\\\\n phases/8-title-boundary/index.json |  10 ++++\\\\n phases/8-title-boundary/step0.md   | 101 +++++++++++++++++++++++++++++++++++++\\\\n phases/8-title-boundary/step1.md   |  71 ++++++++++++++++++++++++++\\\\n phases/8-title-boundary/step2.md   |  83 ++++++++++++++++++++++++++++++\\\\n phases/index.json                  |   6 ++-\\\\n 5 files changed, 270 insertions(+), 1 deletion(-)\\\\ncommit 302f1d7c132f67c85f2a3e7b6e8c85b912cf1666\\\\nAuthor:     Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\\\\nAuthorDate: Sun Aug 23 21:12:30 2026 +0900\\\\nCommit:     Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\\\\nCommitDate: Sun Aug 23 21:12:30 2026 +0900\\\\n\\\\n    docs(phase-8): 값을 지어내는 표제 경로와 가드레일 드리프트를 넘긴다\\\\n    \\\\n    phase 7 교차검증에서 나온 결함 하나와, 그 검증 과정에서 드러난 가드레일\\\\n    드리프트를 phase 8 로 묶는다.\\\\n    \\\\n    step 0 — 幅止め筋 표제 피치의 오른쪽 경계를 자릿수로 추측하던 것을 고친다.\\\\n      特記 가 「1. 2. 3.」 으로 번호 매김되어 있어 피치 뒤에 다음 항목 번호가\\\\n      붙는데, 자릿수 캡은 둘을 못 가른다. 実測: 「巾止筋 D10-@500」 뒤에 「2.」 가\\\\n      오면 pitchMm 5002 가 raw 도 issue 도 없이 나온다. 픽스처가 못 잡은 이유는\\\\n      大梁 에 걸리는 표제 둘이 우연히 @1000 이라 캡이 맞아떨어지기 때문이고,\\\\n      @500 표기 자체는 yokohama-p13 柱리스트에 이미 있다.\\\\n    \\\\n    step 1 — AGENTS.md 가 CLAUDE.md 의 사본이라는 계약을 테스트로 고정한다.\\\\n      손 규율은 두 번 졌고, 가드레일은 기동 시 1회만 읽히므로 실행 중에는\\\\n      갈라진 것을 알아챌 방법이 없다.\\\\n    \\\\n    step 2 — 검증 전용 스텝이다. Claude 가 통째로 다시 생성한 AGENTS.md 에서\\\\n      조용히 사라진 내용이 있는지 codex 가 반증한다. 고치지 말고 blocked 으로\\\\n      두게 한다 — 검증자가 고치면 그 수정을 아무도 검증하지 않는다.\\\\n    \\\\n    Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>\\\\n\\\\ndiff --git a/phases/8-title-boundary/step0.md b/phases/8-title-boundary/step0.md\\\\nnew file mode 100644\\\\nindex 0000000..da92cd8\\\\n--- /dev/null\\\\n+++ b/phases/8-title-boundary/step0.md\\\\n@@ -0,0 +1,101 @@\\\\n+# Step 0: title-pitch-boundary\\\\n+\\\\n+`幅止め筋`을 리스트 표제에서 읽는 경로(phase 7 step 1)가 **값을 지어낸다.**\\\\n+피치의 오른쪽 경계를 자릿수로 추측하기 때문이다. 그 경계를 증명 가능하게 바꾼다.\\\\n+\\\\n+## 무엇이 잘못됐는가 (실측)\\\\n+\\\\n+`src/lib/import/section-list/parse.ts`의 `parsePitch`에 `allowFourDigitPitch`가 붙으면서\\\\n+그 경로의 `pitchMm > 999` 상한이 사라졌다. 표제는 特記가 `1. 2. 3.`으로 번호 매김되어 있어\\\\n+피치 숫자 바로 뒤에 **다음 항목 번호**가 붙는다. 자릿수 캡은 그 둘을 못 가른다:\\\\n+\\\\n+```\\\\n+巾止筋 D10-@500 2.中吊り筋…   →  { size: 'D10', pitchMm: 5002 }   ← 지어낸 값\\\\n+巾止筋 D10-@1000 2.中吊り筋…  →  { size: 'D10', pitchMm: 1000 }   ← 우연히 맞음\\\\n+```\\\\n+\\\\n+`raw`도 `issues`도 없이 조용히 나온다. 픽스처 4부 중 어느 것도 이걸 못 잡는다 —\\\\n+大梁에 걸리는 표제 둘이 우연히 `@1000`이라 캡이 맞아떨어지기 때문이다.\\\\n+그런데 **`@500` 표기는 이미 픽스처에 있다** (`yokohama-p13`의 柱리스트).\\\\n+大梁 리스트가 3자리 피치를 쓰는 도면이 하나 들어오면 5002mm가 案件에 들어간다.\\\\n+\\\\n+이것은 이 트랙 전체가 막으려는 실패 모드다 (ADR-012·ADR-018 — 확신 없는 값을 지어내지 않는다).\\\\n+\\\\n+## 읽어야 할 파일\\\\n+\\\\n+- `AGENTS.md` — 아키텍처 규칙 전부. 특히 ADR-012(主筋 본수·피치는 입력)\\\\n+- `docs/ADR.md` — ADR-018 (확신 없는 셀은 빈칸 + 원문 참고 표시)\\\\n+- `src/lib/import/section-list/parse.ts` — `parsePitch`(:377), `widthTieFromTitle`(:397), 적용부(:1672)\\\\n+- `src/lib/import/section-list/types.ts` — `CANDIDATE_ISSUES`\\\\n+- `tests/section-import/parse.test.ts` — 기존 幅止め筋 테스트\\\\n+\\\\n+## 작업\\\\n+\\\\n+TDD로 진행하라. **먼저 위 반례(`@500` + `2.`)가 실패하는 테스트를 쓰고**, 그 다음 고쳐라.\\\\n+\\\\n+### 1. 特記를 항목으로 가른 뒤에 읽는다\\\\n+\\\\n+경계를 자릿수로 추측하지 말고, **번호 매김이 1부터 순차라는 것**을 이용해 표제 문자열을\\\\n+항목으로 나눠라. 그 다음 `幅止`/`巾止` 항목 **안에서만** 피치를 읽는다.\\\\n+\\\\n+실물 표제 4종(전부 픽스처에서 복원한 실제 문자열이다 — 이것이 테스트 입력이다):\\\\n+\\\\n+| 픽스처 | 복원된 표제 | 기대 |\\\\n+|---|---|---|\\\\n+| `ojkk-p3` | `※幅止筋はD10@1000とする` | `{D10, 1000}` — 번호 매김 없음. 전체가 한 항목이다 |\\\\n+| `yokohama-p14` | `特記なき限り1.巾止筋D10-@10002.中吊り筋受け筋D10-@10003.［］内はｶｯﾄｵﾌの柱面からの寸法を示す。` | `{D10, 1000}` |\\\\n+| `yokohama-p13` 柱 | `柱断面リスト1/30特記なき限り1.巾止筋D10-@5002.S13はKSS785を示す。3.HOOPの…` | 柱には싣지 않는다(현행 유지). 다만 **가르면 500이다** |\\\\n+| `yokohama-p13` 小梁 | `小梁断面リスト1/30特記なき限り1.巾止筋D10-@10002.中吊り筋受け筋D10-@1000` | 対象外라 싣지 않는다 |\\\\n+\\\\n+번호 매김이 없으면 전체가 한 항목이다 — 그것도 정상이다(ojkk).\\\\n+\\\\n+### 2. 경계가 증명되지 않으면 값을 내지 않는다\\\\n+\\\\n+항목으로 가른 뒤에도 피치 숫자의 오른쪽 끝이 확정되지 않는 표제가 있을 수 있다.\\\\n+그때는 **값을 내지 말고** `raw['幅止筋']`에 원문을 남기고 issue를 붙여라.\\\\n+\\\\n+- `types.ts`의 `CANDIDATE_ISSUES`에 `幅止め筋解釈不能`을 추가한다\\\\n+- `src/locales/ja.json`·`ko.json`에 `sectionImport.issue.幅止め筋解釈不能` 키를 넣는다\\\\n+  (기존 `sectionImport.issue.*` 문안과 같은 어투로 — 왜 빈칸인지 한 문장)\\\\n+- 지금 코드에 `raw['幅止筋']` 경로는 이미 있으나 issue가 없다. issue를 붙여라\\\\n+\\\\n+### 3. 표제 밖 경로는 원래대로 되돌린다\\\\n+\\\\n+`parsePitch`의 기본 경로(표 셀)는 phase 7 이전에 `pitchMm > 999`로 판정했는데\\\\n+지금은 `match[2].length > 3`이다. 이건 사양에 없던 동작 변경이고\\\\n+선행 0 표기(`@0100`)에서 갈린다. **표 셀 경로는 phase 7 이전 판정으로 되돌려라.**\\\\n+표제 경로에만 새 규칙이 걸리게 하라.\\\\n+\\\\n+## Acceptance Criteria\\\\n+\\\\n+```bash\\\\n+npm run lint\\\\n+npm run typecheck\\\\n+npm test\\\\n+npm run test:golden\\\\n+npm run build\\\\n+```\\\\n+\\\\n+## 검증 절차\\\\n+\\\\n+1. 위 AC 커맨드를 실행한다.\\\\n+2. **반증 확인** — 아래 넷이 전부 성립해야 한다:\\\\n+   - `巾止筋D10-@500` + 다음 항목 번호 → `pitchMm`이 **500**이다 (5002가 아니다)\\\\n+   - 위 표의 실물 표제 4종이 기대대로 나온다\\\\n+   - 경계를 확정할 수 없는 표제는 `widthTie`가 `undefined`이고 `raw['幅止筋']` + issue가 있다\\\\n+   - `columns.candidates`·`smallGirders.candidates`의 `widthTie`가 여전히 전부 `undefined`\\\\n+     (1通則3)의 열거에 柱가 없다 — phase 7이 세운 이 성질이 깨지면 회귀다)\\\\n+3. `phases/8-title-boundary/index.json`의 step 0을 업데이트한다\\\\n+   (`completed`/`error`/`blocked` 규칙은 이전 phase와 동일).\\\\n+\\\\n+## 금지사항\\\\n+\\\\n+- **피치의 경계를 자릿수 상한으로 정하지 마라.** 이유: 그것이 이 결함의 원인이다.\\\\n+  「4자리까지 허용」은 `@5002`를 5002로 만든다.\\\\n+- **番号가 붙어 있다는 이유로 마지막 한 자리를 무조건 떼지 마라.** 이유: 항목이 10개면\\\\n+  다음 번호가 `10.`이라 두 자리다. 항목으로 가른 뒤에 읽어야 그 함정이 없다.\\\\n+- **경계가 확정되지 않을 때 「그럴듯한 값」을 고르지 마라.** 이유: ADR-018 —\\\\n+  빈칸+원문이 정직한 실패이고, 지어낸 값은 승인 후 조용히 입력이 된다(ADR-012).\\\\n+- **柱·小梁에 幅止め筋을 싣지 마라.** 이유: `数量積算基準` 1通則3)의 열거에 柱가 없다.\\\\n+- **전사 픽스처(`tests/fixtures/section-import/expected/*.json`)의 `entries`를 고치지 마라.**\\\\n+  이유: ADR-010 — 독립 전사가 파서에 맞춰지면 검증이 순환이 된다.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"git show --unified=12 c91faf5 -- src/lib/import/section-list/parse.ts tests/section-import/parse.test.ts; 'STEP_OUTPUT_AC_REFERENCES'; foreach (\\\\\\\"'$n in 0..3) { $path = \\\\\\\"phases/7-section-fields/step$n-output.json\\\\\\\"; $raw = Get-Content -Raw $path; $obj = $raw | ConvertFrom-Json; \\\\\\\"STEP $n exit=$($obj.exitCode)\\\\\\\"; ($obj.stdout -split \\\\\\\"`n\\\\\\\") | Select-String -Pattern '\\\\\\\"'npm run lint|npm run typecheck|npm test|npm run test:golden|npm run build|passed|completed|status' | Select-Object -Last 20 | ForEach-Object { \\\\\\\"'$_.Line } }; '\\\\\\\"'BAD_PATH_AT_PHASE7_END'; git show d175892:src/lib/import/section-list/parse.ts | Select-String -Pattern 'function parsePitch|allowFourDigitPitch|widthTieFromTitle|parsePitch\\\\\\\\\\\\\\\\(' -Context 2,12\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"git show --unified=12 c91faf5 -- src/lib/import/section-list/parse.ts tests/section-import/parse.test.ts; 'STEP_OUTPUT_AC_REFERENCES'; foreach (\\\\\\\"'$n in 0..3) { $path = \\\\\\\"phases/7-section-fields/step$n-output.json\\\\\\\"; $raw = Get-Content -Raw $path; $obj = $raw | ConvertFrom-Json; \\\\\\\"STEP $n exit=$($obj.exitCode)\\\\\\\"; ($obj.stdout -split \\\\\\\"`n\\\\\\\") | Select-String -Pattern '\\\\\\\"'npm run lint|npm run typecheck|npm test|npm run test:golden|npm run build|passed|completed|status' | Select-Object -Last 20 | ForEach-Object { \\\\\\\"'$_.Line } }; '\\\\\\\"'BAD_PATH_AT_PHASE7_END'; git show d175892:src/lib/import/section-list/parse.ts | Select-String -Pattern 'function parsePitch|allowFourDigitPitch|widthTieFromTitle|parsePitch\\\\\\\\\\\\\\\\(' -Context 2,12\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"commit c91faf5a361f6ae9fe310918e941763e854d0ec5\\\\nAuthor: Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\\\\nDate:   Sun Aug 23 20:36:43 2026 +0900\\\\n\\\\n    feat(7-section-fields): step 1 — width-tie\\\\n\\\\ndiff --git a/src/lib/import/section-list/parse.ts b/src/lib/import/section-list/parse.ts\\\\nindex f0b78e5..e9d5936 100644\\\\n--- a/src/lib/import/section-list/parse.ts\\\\n+++ b/src/lib/import/section-list/parse.ts\\\\n@@ -366,36 +366,61 @@ function parseBar(value: string): ParsedBar | undefined {\\\\n   const match = stripDecoration(value).match(/^(\\\\\\\\d+)-?(D\\\\\\\\d+)$/i)\\\\n   if (!match) return undefined\\\\n   co