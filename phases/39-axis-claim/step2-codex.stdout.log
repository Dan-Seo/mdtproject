{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport json\nfrom pathlib import Path\npaths = {}\ndef walk(value, path, file):\n    if isinstance(value, dict):\n        for key, child in value.items():\n            walk(child, f'{path}.{key}' if path else key, file)\n    elif isinstance(value, list):\n        if not value: paths.setdefault(path + '[]', set()).add(file)\n        for child in value: walk(child, path + '[]', file)\n    else:\n        paths.setdefault(path, set()).add(file)\nfiles = sorted(Path('tests/fixtures/plan-import/expected').glob('*.json'))\nfor file in files:\n    data = json.loads(file.read_text(encoding='utf-8'))\n    walk(data, '', file.name)\n    if 'blocks' in data:\n        print(file.name, [b['title'] for b in data['blocks']])\nprint(json.dumps({'files':len(files), 'key_paths_total':len(paths), 'paths':sorted(paths)}, ensure_ascii=False, indent=2))\n'@ | python -X utf8 -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
