son',\r\n  'ojkk-p2.json',\r\n  'ojkk-p3.json',\r\n  'ojkk-p4.json',\r\n  'yokohama-p13.json',\r\n  'yokohama-p14.json',\r\n  'yokohama-p15.json',\r\n  'yokohama-p6.json',\r\n  'yokohama-p7.json',\r\n  'yokohama-p8.json',\r\n  'yokohama-p9.json',\r\n]\r\n\r\nfunction dimensionCandidates(page: TextPage): string[] {\r\n  const horizontal = recoverRows(page.items).flatMap((row) =>\r\n    row.segments.map((segment) => segment.compact),\r\n  )\r\n  const vertical = verticalRuns(page.items).map((run) => run.text)\r\n  return [...horizontal, ...vertical].filter((text) =>\r\n    DIMENSION_PATTERN.test(text),\r\n  )\r\n}\r\n\r\nit('?ㅻ룄硫?14硫댁쓽 媛濡쑣룹꽭濡?移섏닔 ?꾨낫?먮뒗 0mm ?댄븯媛 ?녿떎', () => {\r\n  // ??媛?쒕뒗 ?뚯꽌 異쒕젰???꾨땲??runs.ts???멸렇癒쇳듃 臾명꽦 遺덈??앹씠??\r\n  // ?ㅼ륫??湲곕낯 臾명꽦?먯꽌??14硫?紐⑤몢 0嫄댁씠怨? gapRatio瑜?0.5濡???텛硫?\r\n  // yokohama-p14????50x1000?띿씠 650쨌x쨌1쨌000?쇰줈 媛덈씪??000??4嫄??섏삩??\r\n  // 0.8쨌0.7쨌0.6?먯꽌??移⑤У?섎?濡?珥섏킌??寃쎄퀎媛 ?꾨땶 援듭? ?몃┰??댁뼱??\r\n  // ?몃줈 `VERTICAL_RUN_GAP_RATIO`??媛濡쒖? 媛숈? 援듭? ?몃┰??댁뼱?? 14硫??꾩껜??媛숈?\r\n  // ???몄젒 1,697?띿뿉??`gap / max(w)` 理쒖넖媛믪? 1.000000?닿퀬, 1.5~2.0 援ш컙?\r\n  // yokohama-p7??1?띾퓧?댁뿀?? 1 誘몃쭔???띿? 0媛쒖???\r\n  // (6?먮━ 諛섏삱由?湲곗?; ?먯떆 理쒖넖媛믪? 遺?숈냼??ULP ?붿감濡?0.9999999999999634).\r\n  // 0.99쨌0.8쨌0.5쨌0.3?먯꽌??紐⑤뱺 ?곗씠 1湲?먮줈 媛덈씪??`DIMENSION_PATTERN`\r\n  // ?듦낵媛 0嫄댁씠?? 諛곗닔媛 ?뺥솗??1.0???뚮뒗 李?`(1w, 2w)`???섎떒 紐⑥꽌由ъ뿉??\r\n  // `00`쨌`000` 議곌컖???앷꺼 0mm 媛?쒓? ?몃ŉ, 湲곗〈 8硫댁쓽 40嫄댁쓣 ?ы븿??kani-p38 3嫄?쨌\r\n  // kani-p39 11嫄?쨌 ojkk-p3 21嫄?쨌 ojkk-p4 1嫄?쨌 yokohama-p6 12嫄?쨌 p7 13嫄?쨌\r\n  // p8 3嫄?쨌 p9 5嫄? ?⑷퀎 69嫄댁씠??\r\n  const measured = DRAWING_FIXTURES.map((file) => {\r\n    const candidates = dimensionCandidates(readPage(file))\r\n    return {\r\n      file,\r\n      nonPositive: candidates.filter(\r\n        (text) => Number.parseInt(text.replaceAll(',', ''), 10) <= 0,\r\n      ),\r\n    }\r\n  })\r\n\r\n  expect(measured).toEqual(\r\n    DRAWING_FIXTURES.map((file) => ({ file, nonPositive: [] })),\r\n  )\r\n})\r\n\r\n// ?????섏씠吏 以?異??쇰꺼 紐⑥뼇???멸렇癒쇳듃瑜?媛吏?寃껋? yokohama-p14 ?섎굹肉먯씠??\r\n// (12媛? `X2塋?쨌`X3塋?쨌`Y2塋?쨌`Y3塋?쨌`Y4塋?쨌`Y5塋???諛섎났). yokohama-p13쨌ojkk-p2쨌\r\n// ojkk-p3? 媛곴컖 0媛쒕씪 ?쇰꺼 ?꾨낫 ?먯껜媛 ?녿떎. ??援щ퀎? ?먯????먮낯 ?뚯뒪?몄뿉??\r\n// 紐낆떆???덉뿀怨? ?ㅼ륫 洹쇨굅??fa5ab24??tests/section-import/plan-grid.test.ts???⑥븘 ?덈떎.\r\n//\r\n// ??grid-parse??X2쨌X3瑜?癒쇱? ?쇰꺼濡?李얠? ?? ?ㅽ뙩 1蹂?異뺤? 寃?곗씠\r\n// 怨듯쉶?꾪븳?ㅻ뒗 ?댁쑀濡?`?븅뼋?겻툖擁??쇰줈 嫄곗젅?덈떎. framing-plan? 湲곗쟾??\r\n// ?ㅻⅤ?? ?ㅼ젣 ?멸렇癒쇳듃??`X2塋?쨌`Y4塋?泥섎읆 ?쇰꺼 ?ㅼ뿉 `塋???遺숈뼱 ?덇퀬,\r\n// sticky AXIS_LABEL_PATTERN? X2瑜?留ㅼ튂?????⑥? 塋?퉴吏 ?뚮퉬?섏? 紐삵븳??\r\n// splitAxisLabels媛 ?멸렇癒쇳듃 ?꾩껜瑜??ㅻ챸?섏? 紐삵븳 寃껋쑝濡?蹂닿퀬 鍮?諛곗뿴??\r\n// 諛섑솚?섎?濡? framing-plan? ?쇰꺼??李얘린 ???④퀎?먯꽌 `?싥굤??꺀?쇻꺂?ゆ쩂?????몃떎.\r\ndescribe('??씊?ゃ궧??pages do not produce framing grids', () => {\r\n  it('does not invent grids from axis-like section marks', () => {\r\n    const files = [\r\n      'yokohama-p14.json',\r\n      'yokohama-p13.json',\r\n      'ojkk-p2.json',\r\n      'ojkk-p3.json',\r\n    ]\r\n\r\n    expect(\r\n      files.map((file) => {\r\n        const parsed = parseFramingPlan(readPage(file))\r\n        return {\r\n          file,\r\n          grids: parsed.grids.length,\r\n          issues: parsed.issues,\r\n        }\r\n      }),\r\n    ).toEqual([\r\n      {\r\n        file: 'yokohama-p14.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n      {\r\n        file: 'yokohama-p13.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n      {\r\n        file: 'ojkk-p2.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n      {\r\n        file: 'ojkk-p3.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n    ])\r\n  })\r\n})\r\n\r\nfunction grid(\r\n  candidates: PlanGridCandidate[],\r\n  direction: 'X' | 'Y',\r\n): PlanGridCandidate {\r\n  const found = candidates.find((entry) => entry.direction === direction)\r\n  expect(found, `missing ${direction} grid`).toBeDefined()\r\n  return found as PlanGridCandidate\r\n}\r\n\r\n// 湲곕?媛믪? ?꾨㈃?먯꽌 ?낅┰ ?꾩궗??媛믪씠??(?먮낯: tests/fixtures/section-import/SOURCES.md).\r\n// 異??꾩튂(pt)???꾨㈃ 醫뚰몴???ш린 諛뺤? ?딄퀬 ?⑥“ 利앷?留?蹂몃떎 ???꾨㈃??吏꾩떎?\r\n// ?쇰꺼 ?쒖꽌? ?ㅽ뙩 移섏닔(mm)??\r\n\r\ndescribe('yokohama p7 (2?롥틞鴉뤷쎋?팕?롥틞鴉뤷쎋)', () => {\r\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\r\n\r\n  it('??釉붾줉쨌?묐떒 以묐났???묓? X쨌Y 媛?1媛쒖쓽 ?꾨낫媛 ?⑤뒗??, () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.grids).toHaveLength(2)\r\n  })\r\n\r\n  it('X: bX1?밷X3쨌cX1, ?ㅽ뙩 8700쨌8700쨌1200', () => {\r\n    const x = grid(parsed.grids, 'X')\r\n    expect(x.axes.map((axis) => axis.label)).toEqual([\r\n      'bX1',\r\n      'bX2',\r\n      'bX3',\r\n      'cX1',\r\n    ])\r\n    expect(x.spansMm).toEqual([8700, 8700, 1200])\r\n    expect(x.totalConfirmed).toBe(false)\r\n  })\r\n\r\n  it('Y: bY6?뭕Y1 (?꾨㈃ 洹몃?濡쒖쓽 ?쒖꽌), ?ㅽ뙩 5000쨌6000쨌10000쨌6000쨌5000', () => {\r\n    const y = grid(parsed.grids, 'Y')\r\n    expect(y.axes.map((axis) => axis.label)).toEqual([\r\n      'bY6',\r\n      'bY5',\r\n      'bY4',\r\n      'bY3',\r\n      'bY2',\r\n      'bY1',\r\n    ])\r\n    expect(y.spansMm).toEqual([5000, 6000, 10000, 6000, 5000])\r\n    expect(y.totalConfirmed).toBe(false)\r\n  })\r\n\r\n  it('異??꾩튂???⑥“ 利앷??섍퀬 ?ㅼ륫 異뺤쿃? 1/100 遺洹쇱씠??, () => {\r\n    for (const candidate of parsed.grids) {\r\n      const positions = candidate.axes.map((axis) => axis.positionPt)\r\n      expect([...positions].sort((a, b) => a - b)).toEqual(positions)\r\n      // 1/100 ?꾨㈃??pt/mm = 72 / 25.4 / 100 ??0.02835\r\n      expect(candidate.scalePtPerMm).toBeGreaterThan(0.027)\r\n      expect(candidate.scalePtPerMm).toBeLessThan(0.03)\r\n    }\r\n  })\r\n})\r\n\r\ndescribe('kani p38 (?븀쨴鴉뤷쎋)', () => {\r\n  const parsed = parseFramingPlan(readPage('kani-p38.json'))\r\n\r\n  it('X: X1?밲4, ?ㅽ뙩 6000쨌6000쨌8000 ???꾩껜 移섏닔 20,000?쇰줈 ?뺤씤?쒕떎', () => {\r\n    const x = grid(parsed.grids, 'X')\r\n    expect(x.axes.map((axis) => axis.label)).toEqual(['X1', 'X2', 'X3', 'X4'])\r\n    expect(x.spansMm).toEqual([6000, 6000, 8000])\r\n    expect(x.totalConfirmed).toBe(true)\r\n  })\r\n\r\n  it('Y: ?꾨㈃ 醫뚢넂?곌? Y3쨌Y2쨌Y1 ???ㅽ뙩 6000쨌10500, ?꾩껜 16,500?쇰줈 ?뺤씤?쒕떎', () => {\r\n    const y = grid(parsed.grids, 'Y')\r\n    expect(y.axes.map((axis) => axis.label)).toEqual(['Y3', 'Y2', 'Y1'])\r\n    expect(y.spansMm).toEqual([6000, 10500])\r\n    expect(y.totalConfirmed).toBe(true)\r\n  })\r\n\r\n  it('?몃? 移섏닔 ?곗뇙(2,800+3,200 ????以묒젏 留ㅼ묶??諛곗젣?쒕떎', () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.grids).toHaveLength(2)\r\n  })\r\n})\r\n\r\n// ?꾨옒 湲곕?媛믪? ???쎌뒪泥섏쓽 ?먯떆 TextItem 臾몄옄 醫뚰몴?먯꽌 ?낅┰ ?꾩궗?덈떎\r\n// (?먮낯쨌履? tests/fixtures/section-import/SOURCES.md). ?뚯꽌 異쒕젰?먯꽌 蹂듭궗?섏? ?딆븯??\r\n// yokohama p6???꽷룹븘??異????뿉??bX1쨌bX2쨌bX3쨌cX1怨?8700쨌8700쨌1200??\r\n// 醫뚯슦 ?몃줈 移섏닔 ?댁뿉??bY6?뭕Y1怨?5000쨌6000쨌10000쨌6000쨌5000??諛섎났?쒕떎.\r\ndescribe('yokohama p6 (?븀쨴鴉뤷쎋???롥틞鴉뤷쎋)', () => {\r\n  const parsed = parseFramingPlan(readPage('yokohama-p6.json'))\r\n\r\n  it('諛섎났????鴉뤷쎋??X쨌Y 寃⑹옄 ?뺤쓽瑜?媛곴컖 ?섎굹濡??묐뒗??, () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(\r\n      parsed.grids.map((candidate) => ({\r\n        direction: candidate.direction,\r\n        labels: candidate.axes.map((axis) => axis.label),\r\n        spansMm: candidate.spansMm,\r\n        totalConfirmed: candidate.totalConfirmed,\r\n      })),\r\n    ).toEqual([\r\n      {\r\n        direction: 'X',\r\n        labels: ['bX1', 'bX2', 'bX3', 'cX1'],\r\n        spansMm: [8700, 8700, 1200],\r\n        totalConfirmed: false,\r\n      },\r\n      {\r\n        direction: 'Y',\r\n        labels: ['bY6', 'bY5', 'bY4', 'bY3', 'bY2', 'bY1'],\r\n        spansMm: [5000, 6000, 10000, 6000, 5000],\r\n        totalConfirmed: false,\r\n      },\r\n    ])\r\n  })\r\n})\r\n\r\n// kani p39 ?먯떆 TextItem??媛濡????? X1?뭎4? 6,000쨌6,000쨌8,000,\r\n// ?몃줈 ???? Y3?뭑1怨?6,000쨌10,500??紐낆떆?섍퀬 ???덅쮫(20,000쨌16,500)瑜?媛뽯뒗??\r\ndescribe('kani p39 (歟곦폀??', () => {\r\n  const parsed = parseFramingPlan(readPage('kani-p39.json'))\r\n\r\n  it('X쨌Y 寃⑹옄瑜??덅쮫 ?뺤씤 ?꾨낫濡??몃떎', () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(\r\n      parsed.grids.map((candidate) => ({\r\n        direction: candidate.direction,\r\n        labels: candidate.axes.map((axis) => axis.label),\r\n        spansMm: candidate.spansMm,\r\n        totalConfirmed: candidate.totalConfirmed,\r\n      })),\r\n    ).toEqual([\r\n      {\r\n        direction: 'X',\r\n        labels: ['X1', 'X2', 'X3', 'X4'],\r\n        spansMm: [6000, 6000, 8000],\r\n        totalConfirmed: true,\r\n      },\r\n      {\r\n        direction: 'Y',\r\n        labels: ['Y3', 'Y2', 'Y1'],\r\n        spansMm: [6000, 10500],\r\n        totalConfirmed: true,\r\n      },\r\n    ])\r\n  })\r\n})\r\n\r\n// kani p41 ?먯떆 TextItem?먮뒗 ??邕며탡?노쭏??X1?뭎4? 6,000쨌6,000쨌8,000,\r\n// ?덅쮫 20,000??諛섎났?쒕떎. Y異??댁? ?놁쑝誘濡?X ?뺤쓽 ?섎굹留??묓? ?섏삩??\r\ndescribe('kani p41 (Y1?팢2?싥굤邕며탡??', () => {\r\n  const parsed = parseFramingPlan(readPage('kani-p41.json'))\r\n\r\n  it('諛섎났??X 寃⑹옄 ?섎굹留??닿퀬 Y 寃⑹옄瑜?吏?대궡吏 ?딅뒗??, () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(\r\n      parsed.grids.map((candidate) => ({\r\n        direction: candidate.direction,\r\n        labels: candidate.axes.map((axis) => axis.label),\r\n        spansMm: candidate.spansMm,\r\n        totalConfirmed: candidate.totalConfirmed,\r\n      })),\r\n    ).toEqual([\r\n      {\r\n        direction: 'X',\r\n        labels: ['X1', 'X2', 'X3', 'X4'],\r\n        spansMm: [6000, 6000, 8000],\r\n        totalConfirmed: true,\r\n      },\r\n    ])\r\n  })\r\n})\r\n\r\n// yokohama p9 ?먯떆 TextItem?먮뒗 ?꾩そ bY1?뭕Y6 ???5000쨌6000쨌10000쨌6000쨌5000)怨?\r\n// ?놁쓽 bY1?뭕Y3 ???5000쨌6000)???덇퀬, ?꾨옒履?邕며탡?녹뿉?쒕룄 媛숈? ?뺤쓽媛 諛섎났?쒕떎.\r\ndescribe('yokohama p9 (邕며탡??2))??framing-plan ?ㅽ깭', () => {\r\n  const parsed = parseFramingPlan(readPage('yokohama-p9.json'))\r\n\r\n  it('Y 諛⑺뼢 ??寃⑹옄 ?뺤쓽瑜??꾨낫濡??닿퀬 ?덅쮫???뺤씤?섏? ?딅뒗??, () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(\r\n      parsed.grids.map((candidate) => ({\r\n        direction: candidate.direction,\r\n        labels: candidate.axes.map((axis) => axis.label),\r\n        spansMm: candidate.spansMm,\r\n        totalConfirmed: candidate.totalConfirmed,\r\n      })),\r\n    ).toEqual([\r\n      {\r\n        direction: 'Y',\r\n        labels: ['bY1', 'bY2', 'bY3', 'bY4', 'bY5', 'bY6'],\r\n        spansMm: [5000, 6000, 10000, 6000, 5000],\r\n        totalConfirmed: false,\r\n      },\r\n      {\r\n        direction: 'Y',\r\n        labels: ['bY1', 'bY2', 'bY3'],\r\n        spansMm: [5000, 6000],\r\n        totalConfirmed: false,\r\n      },\r\n    ])\r\n  })\r\n})\r\n\r\n// ?꾨옒 諛곗튂 湲곕?媛믪? ?쎌뒪泥?醫뚰몴瑜??먯쑝濡?寃?고빐 ?살뿀??(?뚯꽌 異쒕젰?먯꽌 ?좊룄?섏?\r\n// ?딅뒗????ADR-010). 寃??洹쇨굅: 醫뚮툝濡앹쓽 ?싥굤???ㅼ쥖?쒕뒗 bX1=510쨌bX2=757쨌\r\n// bX3=1003쨌cX1=1037(x), bY6=216쨌bY5=358쨌bY4=528쨌bY3=812쨌bY2=982쨌bY1=1123(y)?대떎.\r\n//   C51@(528,207)  ??x??bX1(510)?먯꽌 18pt, y??bY6(216)?먯꽌 9pt        ???쇔춴??0,0)\r\n//   G51@(880,335)  ??x??bX2?밷X3 以묒젏(880)???뺥솗?? y??bY5(358)?먯꽌 23 ??渦?X(1,1)\r\n//   C53@(528,519)  ??bX1(18) 쨌 bY4(9)                                    ???쇔춴??0,2)\r\n//   CB52@(476,669) ??bX1(34) 쨌 bY4?밷Y3 以묒젏(670)?먯꽌 1pt                 ??渦?Y(0,2)\r\ndescribe('yokohama p7 ??遺??諛곗튂', () => {\r\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\r\n\r\n  it('???μ쓽 鴉뤷쎋媛 媛곴컖 釉붾줉???섍퀬 ?쒕ぉ???먮Ц?濡?媛뽯뒗??, () => {\r\n    expect(parsed.blocks.map((block) => block.title)).toEqual([\r\n      '2?롥틞鴉뤷쎋1/100',\r\n      'R?롥틞鴉뤷쎋1/100',\r\n    ])\r\n  })\r\n\r\n  it('釉붾줉留덈떎 ?먭린 ?꾩튂???싥굤??쓣 媛뽯뒗?????쇰꺼? 媛숆퀬 醫뚰몴???ㅻⅤ??, () => {\r\n    const [left, right] = parsed.blocks\r\n    expect(left.xGrid.axes.map((axis) => axis.label)).toEqual(\r\n      right.xGrid.axes.map((axis) => axis.label),\r\n    )\r\n    expect(left.xGrid.axes[0].positionPt).toBeLessThan(\r\n      right.xGrid.axes[0].positionPt,\r\n    )\r\n    expect(left.yGrid.axes.map((axis) => axis.label)).toEqual([\r\n      'bY6',\r\n      'bY5',\r\n      'bY4',\r\n      'bY3',\r\n      'bY2',\r\n      'bY1',\r\n    ])\r\n  })\r\n\r\n  it('?깅뒗 ?쇔춴?? 鸚㎪