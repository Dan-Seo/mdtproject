json'\",\"aggregated_output\":\"--- elevation test ---\\r\\nimport { readFileSync } from 'node:fs'\\r\\nimport { resolve } from 'node:path'\\r\\n\\r\\nimport { describe, expect, it } from 'vitest'\\r\\n\\r\\nimport { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\\r\\nimport type { TextPage } from '@/lib/import/section-list/types'\\r\\n\\r\\ntype TextItemFixture = {\\r\\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\\r\\n  items: TextPage['items']\\r\\n}\\r\\n\\r\\nfunction readPage(file: string): TextPage {\\r\\n  const fixturePath = resolve(\\r\\n    process.cwd(),\\r\\n    'tests/fixtures/section-import/textitems',\\r\\n    file,\\r\\n  )\\r\\n  const fixture = JSON.parse(\\r\\n    readFileSync(fixturePath, 'utf8'),\\r\\n  ) as TextItemFixture\\r\\n\\r\\n  return { ...fixture.page, items: fixture.items }\\r\\n}\\r\\n\\r\\n// 기대값은 도면에서 독립 전사한 값이다 (원본: tests/fixtures/section-import/SOURCES.md).\\r\\n// 위 계열의 치수 열은 1400·4100·4480·2690이고, 그 경계에 적힌 라벨은 위에서부터\\r\\n// (없음)·中央棟RCL(水下)·2FL·中央棟1FL＋基準GL·基礎下端이다. 1FL과 GL은 190mm\\r\\n// 차이라 이 축척(1/100)에서 5pt이고, 도면상 같은 자리로 읽힌다.\\r\\ndescribe('yokohama p8 (軸組図)', () => {\\r\\n  const parsed = parseFrameElevations(readPage('yokohama-p8.json'))\\r\\n\\r\\n  it('위·아래 두 줄의 軸組図가 각각 계열이 된다', () => {\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.elevations).toHaveLength(2)\\r\\n  })\\r\\n\\r\\n  it('階高를 도면의 치수 그대로 낸다 — 1400·4100·4480·2690', () => {\\r\\n    for (const elevation of parsed.elevations) {\\r\\n      expect(elevation.heightsMm).toEqual([1400, 4100, 4480, 2690])\\r\\n      expect(elevation.levels).toHaveLength(5)\\r\\n    }\\r\\n  })\\r\\n\\r\\n  it('레벨 라벨을 원문 그대로 싣고, 같은 높이의 둘은 둘 다 남긴다', () => {\\r\\n    const labels = parsed.elevations[0].levels.map((level) => level.labels)\\r\\n    expect(labels[0]).toEqual([])\\r\\n    expect(labels[1]).toEqual(['中央棟RCL(水下)'])\\r\\n    expect(labels[2]).toEqual(['2FL'])\\r\\n    expect(labels[3]).toContain('中央棟1FL')\\r\\n    expect(labels[3]).toContain('基準GL')\\r\\n    expect(labels[4]).toEqual(['基礎下端'])\\r\\n  })\\r\\n\\r\\n  it('치수 열 하나가 여러 通り의 軸組図에 공통으로 걸린다', () => {\\r\\n    expect(parsed.elevations[0].titles).toEqual([\\r\\n      'bY1通り軸組図1/100',\\r\\n      'bY2通り軸組図1/100',\\r\\n      'bY3通り軸組図1/100',\\r\\n    ])\\r\\n    expect(parsed.elevations[1].titles).toEqual([\\r\\n      'bY4通り軸組図1/100',\\r\\n      'bY5通り軸組図1/100',\\r\\n      'bY6通り軸組図1/100',\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('유도 축척은 1/100 부근이다 — 도면 표기가 아니라 치수 관계에서 나온다', () => {\\r\\n    for (const elevation of parsed.elevations) {\\r\\n      expect(elevation.scalePtPerMm).toBeGreaterThan(0.027)\\r\\n      expect(elevation.scalePtPerMm).toBeLessThan(0.03)\\r\\n    }\\r\\n  })\\r\\n})\\r\\n\\r\\n/**\\r\\n * 읽지 **못한다**는 것도 고정해 둔다. 조용히 틀린 값을 내는 것이 이 제품이 가장\\r\\n * 못 견디는 실패이므로, 새 도면 형식을 붙일 때 이 페이지가 갑자기 「읽히기」\\r\\n * 시작하면 그것이 신호다 — 무엇이 읽히는지 사람이 봐야 한다.\\r\\n *\\r\\n * 원인은 전사 오류가 아니라 **토큰 분리**다. 이 도면의 階高 열은 위에서부터\\r\\n * 1,635·3,300·450·150인데, 마지막 둘의 글자 간격이 5.6pt로 숫자 안쪽 간격\\r\\n * 4.3pt와 거의 같아 「150450」 한 덩이로 붙는다. 그 1.3pt로 가르면 이 도면\\r\\n * 하나에 맞춘 것이 되므로 가르지 않는다 — 남는 연쇄가 치수 둘뿐이라 축척을\\r\\n * 대조할 상대가 없고, 계열로 서지 못한다 (R10).\\r\\n */\\r\\ndescribe('kani p40 (X1–X4通り軸組図)', () => {\\r\\n  const parsed = parseFrameElevations(readPage('kani-p40.json'))\\r\\n\\r\\n  it('값을 지어내지 않고 사유와 함께 빈 후보로 실패한다', () => {\\r\\n    expect(parsed.elevations).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['寸法列未検出'])\\r\\n  })\\r\\n})\\r\\n\\r\\n// 아래 기대값은 새 픽스처의 원시 TextItem 문자와 좌표에서 독립 전사했다\\r\\n// (원본·쪽: tests/fixtures/section-import/SOURCES.md). 파서 출력에서 복사하지 않았다.\\r\\n// p6·p39는 伏図이고 軸組図 제목이 없으며, p41의 階高 열은 원문 추출에서\\r\\n// 450과 150이 「150450」으로 붙어 반증 가능한 치수 연쇄가 서지 않는다.\\r\\ndescribe('새 형상 페이지의 빈 軸組図 후보', () => {\\r\\n  it.each(['yokohama-p6.json', 'kani-p39.json', 'kani-p41.json'])(\\r\\n    '%s는 값을 지어내지 않고 명시 사유로 실패한다',\\r\\n    (file) => {\\r\\n      const parsed = parseFrameElevations(readPage(file))\\r\\n      expect(parsed.elevations).toEqual([])\\r\\n      expect(parsed.issues).toEqual(['寸法列未検出'])\\r\\n    },\\r\\n  )\\r\\n})\\r\\n\\r\\n// yokohama p9의 세로쓰기 원시 TextItem은 위 계열 1400·4100·4480·2490,\\r\\n// 아래 계열 1400·4100·4480·2690이다. 각 경계의 원문 라벨과 제목도 함께 전사했다.\\r\\ndescribe('yokohama p9 (軸組図(2))', () => {\\r\\n  const parsed = parseFrameElevations(readPage('yokohama-p9.json'))\\r\\n\\r\\n  it('위·아래 두 줄의 階高 계열을 원문 치수대로 낸다', () => {\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.elevations.map((entry) => entry.heightsMm)).toEqual([\\r\\n      [1400, 4100, 4480, 2490],\\r\\n      [1400, 4100, 4480, 2690],\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('경계 라벨과 각 계열의 軸組図 제목을 원문 그대로 싣는다', () => {\\r\\n    for (const elevation of parsed.elevations) {\\r\\n      expect(elevation.levels.map((level) => level.labels)).toEqual([\\r\\n        [],\\r\\n        ['中央棟RCL(水下)'],\\r\\n        ['2FL'],\\r\\n        ['中央棟1FL', '基準GL'],\\r\\n        ['基礎下端'],\\r\\n      ])\\r\\n    }\\r\\n    expect(parsed.elevations.map((entry) => entry.titles)).toEqual([\\r\\n      ['bX1通り軸組図1/100', 'bX2A通り軸組図1/100'],\\r\\n      ['bX2通り軸組図1/100', 'bX3通り軸組図1/100'],\\r\\n    ])\\r\\n  })\\r\\n})\\r\\n--- corpus test ---\\r\\nimport { readFileSync } from 'node:fs'\\r\\nimport { resolve } from 'node:path'\\r\\n\\r\\nimport { describe, expect, it } from 'vitest'\\r\\n\\r\\nimport { parseFramingPlan } from '@/lib/import/framing-plan/parse'\\r\\nimport type { TextPage } from '@/lib/import/section-list/types'\\r\\n\\r\\ntype TextItemFixture = {\\r\\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\\r\\n  items: TextPage['items']\\r\\n}\\r\\n\\r\\ntype GridGolden = {\\r\\n  blocks: Array<{\\r\\n    x: { labels: string[]; spansMm: number[]; totalMm: number | null }\\r\\n    y: { labels: string[]; spansMm: number[]; totalMm: number | null }\\r\\n  }>\\r\\n}\\r\\n\\r\\nconst CASES = [\\r\\n  ['fuji-p17.json', 'fuji-kanritou-p17-grid.json'],\\r\\n  ['hirosaki-p21.json', 'hirosaki-kikyono-p21-grid.json'],\\r\\n  ['ina-p6.json', 'ina-pump-p6-grid.json'],\\r\\n  ['karatsu-fukuzu-p1.json', 'karatsu-fukuzu-p1-grid.json'],\\r\\n  ['karatsu-hashirashin-p1.json', 'karatsu-hashirashin-p1-grid.json'],\\r\\n  ['shibata-p1.json', 'shibata-fire-p1-grid.json'],\\r\\n  ['tsu-p16.json', 'tsu-kanritou-p16-grid.json'],\\r\\n] as const\\r\\n\\r\\ntype GridSnapshot = {\\r\\n  direction: 'X' | 'Y'\\r\\n  labels: string[]\\r\\n  spansMm: number[]\\r\\n  totalConfirmed: boolean\\r\\n}\\r\\n\\r\\nconst EXISTING_14 = [\\r\\n  ['kani-p38.json', [\\r\\n    { direction: 'X', labels: ['X1', 'X2', 'X3', 'X4'], spansMm: [6000, 6000, 8000], totalConfirmed: true },\\r\\n    { direction: 'Y', labels: ['Y3', 'Y2', 'Y1'], spansMm: [6000, 10500], totalConfirmed: true },\\r\\n  ], []],\\r\\n  ['kani-p39.json', [\\r\\n    { direction: 'X', labels: ['X1', 'X2', 'X3', 'X4'], spansMm: [6000, 6000, 8000], totalConfirmed: true },\\r\\n    { direction: 'Y', labels: ['Y3', 'Y2', 'Y1'], spansMm: [6000, 10500], totalConfirmed: true },\\r\\n  ], []],\\r\\n  ['kani-p40.json', [\\r\\n    { direction: 'Y', labels: ['Y1', 'Y2', 'Y3'], spansMm: [10500, 6000], totalConfirmed: true },\\r\\n  ], []],\\r\\n  ['kani-p41.json', [\\r\\n    { direction: 'X', labels: ['X1', 'X2', 'X3', 'X4'], spansMm: [6000, 6000, 8000], totalConfirmed: true },\\r\\n  ], []],\\r\\n  ['ojkk-p2.json', [], ['通り芯ラベル未検出']],\\r\\n  ['ojkk-p3.json', [], ['通り芯ラベル未検出']],\\r\\n  ['ojkk-p4.json', [], ['通り芯ラベル未検出']],\\r\\n  ['yokohama-p13.json', [], ['通り芯ラベル未検出']],\\r\\n  ['yokohama-p14.json', [], ['通り芯ラベル未検出']],\\r\\n  ['yokohama-p15.json', [], ['通り芯ラベル未検出']],\\r\\n  ['yokohama-p6.json', [\\r\\n    { direction: 'X', labels: ['bX1', 'bX2', 'bX3', 'cX1'], spansMm: [8700, 8700, 1200], totalConfirmed: false },\\r\\n    { direction: 'Y', labels: ['bY6', 'bY5', 'bY4', 'bY3', 'bY2', 'bY1'], spansMm: [5000, 6000, 10000, 6000, 5000], totalConfirmed: false },\\r\\n  ], []],\\r\\n  ['yokohama-p7.json', [\\r\\n    { direction: 'X', labels: ['bX1', 'bX2', 'bX3', 'cX1'], spansMm: [8700, 8700, 1200], totalConfirmed: false },\\r\\n    { direction: 'Y', labels: ['bY6', 'bY5', 'bY4', 'bY3', 'bY2', 'bY1'], spansMm: [5000, 6000, 10000, 6000, 5000], totalConfirmed: false },\\r\\n  ], []],\\r\\n  ['yokohama-p8.json', [\\r\\n    { direction: 'X', labels: ['bX1', 'bX2', 'bX3'], spansMm: [8700, 8700], totalConfirmed: false },\\r\\n  ], []],\\r\\n  ['yokohama-p9.json', [\\r\\n    { direction: 'Y', labels: ['bY1', 'bY2', 'bY3', 'bY4', 'bY5', 'bY6'], spansMm: [5000, 6000, 10000, 6000, 5000], totalConfirmed: false },\\r\\n    { direction: 'Y', labels: ['bY1', 'bY2', 'bY3'], spansMm: [5000, 6000], totalConfirmed: false },\\r\\n  ], []],\\r\\n] as const satisfies ReadonlyArray<readonly [string, readonly GridSnapshot[], readonly string[]]>\\r\\n\\r\\nfunction readPage(file: string): TextPage {\\r\\n  const fixturePath = resolve(\\r\\n    process.cwd(),\\r\\n    'tests/fixtures/section-import/textitems',\\r\\n    file,\\r\\n  )\\r\\n  const fixture = JSON.parse(\\r\\n    readFileSync(fixturePath, 'utf8'),\\r\\n  ) as TextItemFixture\\r\\n  return { ...fixture.page, items: fixture.items }\\r\\n}\\r\\n\\r\\nfunction readGolden(file: string): GridGolden {\\r\\n  return JSON.parse(\\r\\n    readFileSync(\\r\\n      resolve(process.cwd(), 'tests/fixtures/plan-import/expected', file),\\r\\n      'utf8',\\r\\n    ),\\r\\n  ) as GridGolden\\r\\n}\\r\\n\\r\\nfunction comparableExpectedGrid(\\r\\n  actual: {\\r\\n    axes: Array<{ label: string }>\\r\\n    spansMm: number[]\\r\\n    totalConfirmed: boolean\\r\\n  },\\r\\n  expected: { labels: string[]; spansMm: number[]; totalMm: number | null },\\r\\n  allowExtra: boolean,\\r\\n) {\\r\\n  const labels = allowExtra\\r\\n    ? actual.axes.slice(0, expected.labels.length).map((axis) => axis.label)\\r\\n    : actual.axes.map((axis) => axis.label)\\r\\n  const spansMm = allowExtra\\r\\n    ? actual.spansMm.slice(0, expected.spansMm.length)\\r\\n    : actual.spansMm\\r\\n\\r\\n  return {\\r\\n    labels,\\r\\n    spansMm,\\r\\n    totalMm: actual.totalConfirmed\\r\\n      ? spansMm.reduce((sum, span) => sum + span, 0)\\r\\n      : null,\\r\\n  }\\r\\n}\\r\\n\\r\\ndescribe('2차 7면 伏図 격자 골든', () => {\\r\\n  it.each(CASES)('%s', (textItemsFile, goldenFile) => {\\r\\n    const parsed = parseFramingPlan(readPage(textItemsFile))\\r\\n    const golden = readGolden(goldenFile)\\r\\n\\r\\n    expect(parsed.blocks).toHaveLength(golden.blocks.length)\\r\\n    for (const [index, expectedBlock] of golden.blocks.entries()) {\\r\\n      const actualBlock = parsed.blocks[index]\\r\\n      expect(actualBlock).toBeDefined()\\r\\n      if (!actualBlock) continue\\r\\n      const shibataExtra =\\r\\n        goldenFile === 'shibata-fire-p1-grid.json'\\r\\n      expect(\\r\\n        comparableExpectedGrid(actualBlock.xGrid, expectedBlock.x, shibataExtra),\\r\\n      ).toEqual(expectedBlock.x)\\r\\n      expect(\\r\\n        comparableExpectedGrid(actualBlock.yGrid, expectedBlock.y, false),\\r\\n      ).toEqual(expectedBlock.y)\\r\\n    }\\r\\n\\r\\n    for (const block of golden.blocks) {\\r\\n      for (const axis of [block.x, block.y]) {\\r\\n        if (axis.totalMm === null) continue\\r\\n        expect(axis.totalMm).toBe(\\r\\n          axis.spansMm.reduce((sum, span) => sum + span, 0),\\r\\n        )\\r\\n      }\\r\\n    }\\r\\n\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('伏図 격자 축 순서 규약', () => {\\r\\n  it.each(CASES)('%s의 모든 축 좌표는 페이지 순서로 단조 증가한다', (textItemsFile) => {\\r\\n    const parsed = parseFramingPlan(readPage(textItemsFile))\\r\\n\\r\\n    for (const grid of parsed.grids) {\\r\\n      const positions = grid.axes.map((axis) => axis.positionPt)\\r\\n      expect(positions).toEqual([...positions].sort((left, right) => left - right))\\r\\n    }\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('기존 14면 격자 회귀', () => {\\r\\n  it.each(EXISTING_14)('%s', (textItemsFile, expectedGrids, expectedIssues) => {\\r\\n    const parsed = parseFramingPlan(readPage(textItemsFile))\\r\\n    expect(\\r\\n      parsed.grids.map((grid) => ({\\r\\n        direction: grid.direction,\\r\\n        labels: grid.axes.map((axis) => axis.label),\\r\\n        spansMm: grid.spansMm,\\r\\n        totalConfirmed: grid.totalConfirmed,\\r\\n      })),\\r\\n    ).toEqual(expectedGrids)\\r\\n    expect(parsed.issues).toEqual(expectedIssues)\\r\\n  })\\r\\n})\\r\\n--- expected shape ---\\r\\n\\r\\n\\r\\nfile : fuji-kanritou-p17-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다. fuji 정정의 정정(2026-09-03 16:20): 문자 축 E〜A는 페이지에서 E(y 194)가 위·A(y 543)가 아래라 원래의 E→A가 이미\\r\\n        페이지 순서였다. 회전 치수 글리프 열을 y축 방향을 거꾸로 가정해 뒤집은 것이 Claude의 오류였고 되돌렸다(픽스처는 top-left 원점, y가 클수록 아래). 숫자 축 1·2는 왼→오 그대로.\\r\\n       \\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-fuji-kanritou.pdf\\\",\\\"sha256\\\":\\\"5cf1575f4b596b3e070257f1cc386abc98731d116b4b3f5891c128\\r\\n       74684d9e0d\\\",\\\"issuer\\\":\\\"富士河口湖町小立土地区画整理組合\\\",\\\"project\\\":\\\"平成22年度 新大堀配水場築造工事(建築工事) 管理棟\\\",\\\"sheet\\\":\\\"梁・床伏図\\\",\\\"page\\\":17,\\\"trans\\r\\n       cribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"伏図(하층 2블록 공통)\\\",\\\"x\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[\\r\\n       ]; totalMm=12150}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=}\\\",\\\"notes\\\":\\\"축 스팬 치수 바로 옆에 壁面 \\r\\n       치수 열(2,000·2,500·3,650·2,000 = 10,150)이 나란히 있다 — 合計 12,150과 맞는 쪽이 스팬이다 Y 스팬 5,150 아래에 2,575+2,575 소계가 있다\\\"},{\\\"tit\\r\\n       le\\\":\\\"屋根伏図\\\",\\\"x\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=6650}\\\",\\\"y\\\":\\\"@{labels=System.Object[];\\r\\n        spansMm=System.Object[]; totalMm=}\\\",\\\"notes\\\":\\\"屋根 블록은 C·B·A 세 축만 있다\\\"}],\\\"notes\\\":[\\\"축 라벨이 X·Y 접두 없는 라틴 대문자(E〜A)와 숫자(\\r\\n       1·2)다. 블록 제목 원문은 확정하지 못했다\\\",\\\"pdf.js CMap 없이는 텍스트 0건. 페이지 /Rotate 90\\\"]}\\r\\n\\r\\nfile : hirosaki-kikyono-p21-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-hirosaki-kikyono.pdf\\\",\\\"sha256\\\":\\\"f4dfcfab190970d8df305ce5\\r\\n       3319b98efb17873b81e77462b112a89978135fa8\\\",\\\"issuer\\\":\\\"青森県弘前市\\\",\\\"project\\\":\\\"令和7年度 桔梗野小学校等複合施設新築工事(建築工事) 構造図1\\\",\\\"sheet\\\"\\r\\n       :\\\"S-019 1階床梁伏図\\\",\\\"page\\\":21,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"1階床梁伏図\\\",\\\"x\\\":\\\"@{labels=System.Object[\\r\\n       ]; spansMm=System.Object[]; totalMm=88000}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=7500\\r\\n       0}\\\",\\\"notes\\\":\\\"치수에 천 단위 쉼표가 없다(8000·11000·88000·75000) Y10 바깥에 2000 치수가 하나 더 있다(外周 돌출) — 스팬이 아니다\\\"}],\\\"notes\\\":[\\\"설계 佐\\r\\n       藤総合計画・蟻塚設計共同体. 30면 PDF 22.9MB\\\"]}\\r\\n\\r\\nfile : hirosaki-kikyono-p25-elevation.json\\r\\nkeys : $comment,source,elevations,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-hirosaki-kikyono.pdf\\\",\\\"sha256\\\":\\\"f4df\\r\\n       cfab190970d8df305ce53319b98efb17873b81e77462b112a89978135fa8\\\",\\\"issuer\\\":\\\"青森県弘前市\\\",\\\"project\\\":\\\"令和7年度 桔梗野小学校等複合施設新築工事\\r\\n       (建築工事) 構造図1\\\",\\\"sheet\\\":\\\"S-023 軸組図(1)\\\",\\\"page\\\":25,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"elevations\\\":[{\\\"title\\\":\\\"X1通り\\\",\\\"level\\r\\n       s\\\":\\\"RFL PHFL 3FL 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\":\\\"3400 4000 4000 4500 100 2310\\\",\\\"axis\\\":\\\"@{labels=System.Object[];\\r\\n        spansMm=System.Object[]; totalMm=51000}\\\"},{\\\"title\\\":\\\"X2通り\\\",\\\"levels\\\":\\\"RFL PHFL 3FL 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\"\\r\\n       :\\\"3400 4000 4000 4500 100 2310\\\",\\\"axis\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=75000}\\\",\\\"note\\r\\n       \\\":\\\"2026-09-03 수정(Claude, phase 37): 초판(150dpi)은 X2通り의 RFL을 놓쳤다. 원시 TextItem에 RFL@(94,289)·PHFL@(96,321)이 있고 그 간격\\r\\n        32pt는 X1通り의 RFL→PHFL 32pt(3,400mm)와 같다. 그래서 X2도 RFL부터 6구간이다. X3通り는 PHFL@(96,557) 위에 RFL이 없다.\\\"},{\\\"title\\\":\\\"X3通り\\\",\\r\\n       \\\"levels\\\":\\\"PHFL 3FL 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\":\\\"4000 4000 4500 100 2310\\\",\\\"axis\\\":\\\"@{labels=System.Object[]; sp\\r\\n       ansMm=System.Object[]; totalMm=75000}\\\"}],\\\"notes\\\":[\\\"GL→RFL 합계 16,000(X1通り), GL→PHFL 12,600(X2通り)가 별도로 적혀 있다\\\",\\\"1FL\\r\\n       은 設計GL의 100 위 — 1/100에서 2.8pt\\\",\\\"Y10 바깥 2000·5,765 치수는 스팬이 아니다\\\"]}\\r\\n\\r\\nfile : ina-pump-p6-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-ina-pump.pdf\\\",\\\"sha256\\\":\\\"7caf348f1b590f68bcd8efe70efef4e6\\r\\n       3c7693ebe3fc05df7b5a5cb0e00aabca\\\",\\\"issuer\\\":\\\"長野県伊那市\\\",\\\"project\\\":\\\"令和4年度開発計画関連小黒原産業適地ポンプ施設築造工事\\\",\\\"sheet\\\":\\\"S-6 構造伏図・軸組\\r\\n       図\\\",\\\"page\\\":6,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"伏図(3블록 공통)\\\",\\\"x\\\":\\\"@{labels=System.Object[]; spansMm\\r\\n       =System.Object[]; totalMm=8100}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=}\\\",\\\"notes\\\":\\\"축 라\\r\\n       벨이 X·Y 접두 없는 숫자(1·2·3)와 라틴 대문자(A·B)다 伏図 블록 셋이 같은 격자를 공유한다\\\"}],\\\"notes\\\":[\\\"같은 페이지의 軸組図는 미전사\\\"]}\\r\\n\\r\\nfile : karatsu-fukuzu-p1-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-karatsu-fukuzu.pdf\\\",\\\"sha256\\\":\\\"a6712f907e4b17d787e9b1add3\\r\\n       e726d960d31340846139269127e9b3aceb068e\\\",\\\"issuer\\\":\\\"一般社団法人唐津東松浦薬剤師会\\\",\\\"project\\\":\\\"（仮称）救急・夜間対応会営薬局新築工事\\\",\\\"sheet\\\":\\\"S-3 \\r\\n       基礎伏図\\\",\\\"page\\\":1,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"基礎伏図\\\",\\\"x\\\":\\\"@{labels=System.Object[]; spansMm=Sy\\r\\n       stem.Object[]; totalMm=}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=}\\\",\\\"notes\\\":\\\"合計 치수가 없다.\\r\\n        대신 부분합 4,010(Y4→Y6 = 1806+2204)·4,165(Y0→Y2 = 1900+2265)이 적혀 있다 — 合計로 오인하면 合計不一致가 난다 Y6가 도면 위쪽이다(Y0가 아래)\\\"}],\\\"no\\r\\n       tes\\\":[\\\"같은 페이지에 A〜F·0 라벨과 205·3,020×5·205 / 5,694·4,572·4,373·4,373 치수를 가진 별개 블록이 있다 — 구조를 확정하지 못해 미전사. 파서가 이 블록으\\r\\n       로 격자를 지어내면 안 된다\\\",\\\"페이지 /Rotate 90\\\"]}\\r\\n\\r\\nfile : karatsu-hashirashin-p1-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-karatsu-hashirashin.pdf\\\",\\\"sha256\\\":\\\"f2a33838a377b9c072a64\\r\\n       3333cbbad1a9c775b13335772598068b14dc11a8792\\\",\\\"issuer\\\":\\\"一般社団法人唐津東松浦薬剤師会\\\",\\\"project\\\":\\\"（仮称）救急・夜間対応会営薬局新築工事\\\",\\\"sheet\\\":\\r\\n       \\\"S-7 1階柱芯線図\\\",\\\"page\\\":1,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"1階柱芯線図\\\",\\\"x\\\":\\\"@{labels=System.Object[]; s\\r\\n       pansMm=System.Object[]; totalMm=}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=}\\\",\\\"notes\\\":\\\"基\\r\\n       礎伏図(S-3)과 같은 격자다. 제목이 「伏図」가 아니라 「柱芯線図」다\\\"}],\\\"notes\\\":[\\\"페이지 /Rotate 90\\\"]}\\r\\n\\r\\nfile : karatsu-jikugumi1-p1-elevation.json\\r\\nkeys : $comment,source,levels,heightsMm,elevations,notes,levelTexts,levelNote\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래 순서의 인접 레벨 사이 mm다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-karatsu-jikugumi1.p\\r\\n       df\\\",\\\"sha256\\\":\\\"88cc5a750569d6c4e2e3517b3553c25ad123fe4647504f9417a0ea72b9e87ac9\\\",\\\"issuer\\\":\\\"一般社団法人唐津東松浦薬剤師会\\\",\\\"proj\\r\\n       ect\\\":\\\"（仮称）救急・夜間対応会営薬局新築工事\\\",\\\"sheet\\\":\\\"S-9 軸組図(1)\\\",\\\"page\\\":1,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"levels\\\":[\\\"RFL\\\",\\\"2FL\\\",\\\"1F\\r\\n       L\\\",\\\"GL\\\"],\\\"heightsMm\\\":[3500,3500,150],\\\"elevations\\\":[{\\\"title\\\":\\\"X2通り\\\",\\\"axis\\\":\\\"@{labels=System.Object[]; spansMm=Sys\\r\\n       tem.Object[]; totalMm=}\\\"},{\\\"title\\\":\\\"X3通り\\\",\\\"axis\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=}\\\"}\\r\\n       ,{\\\"title\\\":\\\"X4通り\\\",\\\"axis\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=}\\\"}],\\\"notes\\\":[\\\"네 블록 중 첫 블록(X\\r\\n       1·D通り)은 Y축과 A/B/C축이 섞여 있어 미전사\\\",\\\"1FL은 GL의 150 위다(基礎詳細図 S-4에도 같은 150) — 1/100 축척에서 4.25pt라 같은 자리로 읽힐 수 있다. 치수 열에 1\\r\\n       50이 적혀 있으므로 별 레벨이다\\\",\\\"Y3→Y6 8,079 = 4,069+1,806+2,204, Y3→Y5 5,875 = 4,069+1,806 (基礎伏図와 정합)\\\",\\\"제목의 정확한 원문 표기(「X2通り\\r\\n       軸組図」 등)는 확정하지 못했다 — 通り 이름만 적었다. 페이지 /Rotate 90\\\"],\\\"levelTexts\\\":[\\\"RFL水上\\\",\\\"2FL\\\",\\\"1FL\\\",\\\"GL\\\"],\\\"levelNote\\\":\\\"2026-09-03\\r\\n        추기(Claude, phase 37): 도면의 지붕 레벨 문자열은 「RFL水上」(수상 = 물매 높은 쪽)이고 levels의 「RFL」은 그 레벨명이다. 테스트는 levelTexts로 원문 문자열을 엄\\r\\n       격 대조한다. 원시 TextItem의 레벨 라벨 열은 셋 — x≈86〜100(y 84〜249, 4레벨), x≈111〜125(y 417〜582, 4레벨), x≈748(y 154〜249, 2FL·1FL·G\\r\\n       L 3레벨 — 같은 X2通り 블록의 오른쪽 물매 낮은 쪽으로 보이며 RFL水下 문자열은 텍스트에 없다). X4通り(제목 (900,664)) 옆에는 레벨 라벨 열이 텍스트에 없다 — 파서가 X4 계열을 \\r\\n       못 내면 골든 어긋남으로 보고해야지 골든을 두 계열로 읽어선 안 된다.\\\"}\\r\\n\\r\\nfile : shibata-fire-p1-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-shibata-fire.pdf\\\",\\\"sha256\\\":\\\"e9b5225f841e58d1434127e0d179\\r\\n       e45422d91a4246cf7c2b9175b37232daf985\\\",\\\"issuer\\\":\\\"新発田地域広域事務組合\\\",\\\"project\\\":\\\"新発田広域消防本部解体工事（既存建物 構造図一式）\\\",\\\"sheet\\\":\\\"S-1 \\r\\n       1F伏図\\\",\\\"page\\\":1,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"1F伏図\\\",\\\"x\\\":\\\"@{labels=System.Object[]; spansMm=Sy\\r\\n       stem.Object[]; totalMm=41000}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=15000}\\\",\\\"notes\\\":\\\"\\r\\n       5 오른쪽으로 1,000·6,000 스팬이 더 있고 라벨 6·7이 있는 것으로 보이나 1,000mm(28pt) 간격의 라벨 원을 확정하지 못했다 — 골든은 1〜5와 合計 41,000까지만 본다(파서가 \\r\\n       6·7을 더 내는 것은 반증이 아니다)\\\"}],\\\"notes\\\":[\\\"오른쪽에 X1·X2 / Y1·Y2 / A\\\\u0027〜C\\\\u0027 라벨의 별개 블록이 있다 — 미전사\\\",\\\"축 라벨이 숫자(1〜5)·라틴 대\\r\\n       문자(A〜C)다\\\",\\\"용지 A1(2384×1684pt), iText/ARCDRAW, 90msp-RKSJ-H — pdf.js CMap 없이는 텍스트 0건\\\"]}\\r\\n\\r\\nfile : tsu-kanritou-p16-grid.json\\r\\nkeys : $comment,source,blocks,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세\\r\\n       로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검\\r\\n       토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows\\r\\n       /makeSegments로 재고 큰 값이 아래다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-tsu-kanritou.pdf\\\",\\\"sha256\\\":\\\"e09d156150d191096b190283f455\\r\\n       e4e7c6875bb8000f89048aabda2326acfc7f\\\",\\\"issuer\\\":\\\"三重県津市\\\",\\\"project\\\":\\\"旧津市民プール跡地テニスコート整備工事 管理棟\\\",\\\"sheet\\\":\\\"S-16 杭・基礎・1階\\r\\n       伏図\\\",\\\"page\\\":16,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"blocks\\\":[{\\\"title\\\":\\\"伏図(공통)\\\",\\\"x\\\":\\\"@{labels=System.Object[]; spansMm=S\\r\\n       ystem.Object[]; totalMm=22000}\\\",\\\"y\\\":\\\"@{labels=System.Object[]; spansMm=System.Object[]; totalMm=13000}\\\",\\\"notes\\\":\\r\\n       \\\"杭·基礎·1階 伏図가 한 페이지에 있고 격자는 같다 — 블록 수는 확정하지 못했다\\\"}],\\\"notes\\\":[\\\"S造 관리동(RC는 基礎·地中梁). 용지 A1(1684×1191pt) /Rotate 90\\\"]}\\r\\n\\r\\nfile : tsu-kanritou-p21-elevation.json\\r\\nkeys : $comment,source,elevations,notes\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사\\r\\n       이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래. 이 페이지는 아래쪽 레벨만 확정했다. 2026-09-05 수정(Claude, phase 38 step6 반증 후속)\\r\\n       : axis.labels에서 마지막 통り芯 X5가 빠져 있었다 — 라벨 4개에 스팬 4개로 「라벨=스팬+1」 불변식을 깨고 있었고, 같은 건물의 tsu-kanritou-p16-grid.json x축(X\\r\\n       1..X5, 동일 스팬, 合計 22,000)과도 어긋났다. 원본 재확인: dwg-tsu-kanritou.pdf 21면은 軸組図 블록이 셋(Y1·Y2·Y3通り)이고 셋 다 전각 라벨 Ｘ１..Ｘ５ 다섯 개\\r\\n       를 가진다(회전 페이지라 표시 좌우는 fitz y 내림차순 = X1→X5). 스팬 배열과 totalMm은 원본과 일치했으므로 라벨만 보정했다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-tsu-\\r\\n       kanritou.pdf\\\",\\\"sha256\\\":\\\"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\\\",\\\"issuer\\\":\\\"三重県津市\\\",\\\"proj\\r\\n       ect\\\":\\\"旧津市民プール跡地テニスコート整備工事 管理棟\\\",\\\"sheet\\\":\\\"S-21 軸組図(1)\\\",\\\"page\\\":21,\\\"transcribedAt\\\":\\\"2026-09-03\\\"},\\\"elevations\\\":[{\\\"tit\\r\\n       le\\\":\\\"Y3通り軸組図 S=1/100\\\",\\\"levels\\\":\\\"パラペット天端 RFL(水下) 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\":\\\"600 3500 3500 150 1170\\\",\\\"levelsB\\r\\n       ottom\\\":\\\"2FL 1FL 設計GL 基礎下端\\\",\\\"heightsBottomMm\\\":\\\"3500 150 1170\\\",\\\"axis\\\":\\\"@{labels=System.Object[]; spansMm=System.Ob\\r\\n       ject[]; totalMm=22000}\\\",\\\"levelsBottomNote\\\":\\\"phase 37의 부분 전사다. phase 38(2026-09-04)에서 300dpi 크롭(위 블록 clip x80-340\\r\\n        y100-320, 아래 블록 y590-810)을 다시 읽어 최상단 두 레벨까지 확정했고, levels·heightsMm이 전 계열이다. levelsBottom·heightsBottomMm은 그 전 계\\r\\n       열의 뒤쪽 부분집합이라 그대로 참이다.\\\",\\\"titles\\\":\\\"Y3通り軸組図 S=1/100\\\"},{\\\"titles\\\":\\\"Y1通り軸組図 S=1/100 Y2通り軸組図 S=1/100\\\",\\\"levels\\\":\\\"パラペット天端\\r\\n        RFL(水下) 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\":\\\"600 3500 3500 150 1170\\\",\\\"note\\\":\\\"위 블록이다. 아래 블록(Y3)과 레벨 계열이 같다 — 300dpi 크\\r\\n       롭 두 장에서 각각 읽었다. 通り芯 스팬은 이 블록에서 전사하지 않았다.\\\"}],\\\"notes\\\":[\\\"2026-09-04 정정: 「2FL 위 최상단 레벨 라벨 미확정」은 해소됐다 — 300dpi 크롭에서 ▽\\r\\n       パラペット天端·▽RFL(水下)와 그 사이 600을 읽었다. 7,750은 パラペット天端→設計GL의 合計(600+3500+3500+150)이고 스팬이 아니다\\\",\\\"같은 열에 보조 레벨이 있다: 梁天端(水下)\\r\\n        = 2FL−270, 1SL = 1FL와 같은 높이, 基礎梁天端·B.PL下端은 1FL 아래 20〜250\\\",\\\"X1 왼쪽에 胴縁芯↔柱面 80 치수가 있다 — 스팬이 아니다. 용지 A1 /Rotate 90\\\"\\r\\n       ,\\\"위 블록(캡션 Y1·Y2)과 아래 블록(캡션 Y3)의 레벨 계열은 같다 — 두 크롭에서 각각 확인했다\\\"]}\\r\\n\\r\\nfile : tsu-kanritou-p22-elevation.json\\r\\nkeys : $comment,source,notes,elevations\\r\\ntop  : {\\\"$comment\\\":\\\"원문 독립 전사 (ADR-010 준용) — 300dpi 크롭(clip x80-420 y100-330)과 표제란 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 階高는\\r\\n        위→아래 인접 레벨 사이 mm다. 이 면은 레벨 계열만 전사했다 — 通り芯 스팬은 전사하지 않았다.\\\",\\\"source\\\":{\\\"cacheFile\\\":\\\"dwg-tsu-kanritou.pdf\\\",\\\"sha256\\\":\\r\\n       \\\"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\\\",\\\"issuer\\\":\\\"三重県津市\\\",\\\"project\\\":\\\"旧津市民プール跡地テニスコート整備\\r\\n       工事 管理棟\\\",\\\"sheet\\\":\\\"S-22 軸組図(2)\\\",\\\"page\\\":22,\\\"transcribedAt\\\":\\\"2026-09-04\\\"},\\\"notes\\\":[\\\"S-21(軸組図(1))과 같은 레벨 계열이다 — 600·3\\r\\n       ,500·3,500·150·1,170\\\",\\\"7,750은 パラペット天端→設計GL의 合計이고 스팬이 아니다\\\",\\\"같은 열 오른쪽에 보조 레벨이 있다: 1SL·基礎梁天端·B.PL下端(1FL 아래 20〜250).\\r\\n        用紙 A1 1/100\\\"],\\\"elevations\\\":[{\\\"titles\\\":\\\"X1通り軸組図 S=1/100 X2通り軸組図 S=1/100 X3通り軸組図 S=1/100\\\",\\\"levels\\\":\\\"パラペット天端 RFL(水\\r\\n       下) 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\":\\\"600 3500 3500 150 1170\\\"},{\\\"titles\\\":\\\"X4通り軸組図 S=1/100 X5通り軸組図 S=1/100\\\",\\\"levels\\\"\\r\\n       :\\\"パラペット天端 RFL(水下) 2FL 1FL 設計GL 基礎下端\\\",\\\"heightsMm\\\":\\\"600 3500 3500 150 1170\\\"}]}\\r\\n\\r\\n\\r\\n\\r\\n--- selected files ---\\r\\n{\\r\\n  \\\"$comment\\\": \\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래. 이 페이지는 아래쪽 레벨만 확정했다. 2026-09-05 수정(Claude, phase 38 step6 반증 후속): axis.labels에서 마지막 통り芯 X5가 빠져 있었다 — 라벨 4개에 스팬 4개로 「라벨=스팬+1」 불변식을 깨고 있었고, 같은 건물의 tsu-kanritou-p16-grid.json x축(X1..X5, 동일 스팬, 合計 22,000)과도 어긋났다. 원본 재확인: dwg-tsu-kanritou.pdf 21면은 軸組図 블록이 셋(Y1·Y2·Y3通り)이고 셋 다 전각 라벨 Ｘ１..Ｘ５ 다섯 개를 가진다(회전 페이지라 표시 좌우는 fitz y 내림차순 = X1→X5). 스팬 배열과 totalMm은 원본과 일치했으므로 라벨만 보정했다.\\\",\\r\\n  \\\"source\\\": {\\r\\n    \\\"cacheFile\\\": \\\"dwg-tsu-kanritou.pdf\\\",\\r\\n    \\\"sha256\\\": \\\"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\\\",\\r\\n    \\\"issuer\\\": \\\"三重県津市\\\",\\r\\n    \\\"project\\\": \\\"旧津市民プール跡地テニスコート整備工事 管理棟\\\",\\r\\n    \\\"sheet\\\": \\\"S-21 軸組図(1)\\\",\\r\\n    \\\"page\\\": 21,\\r\\n    \\\"transcribedAt\\\": \\\"2026-09-03\\\"\\r\\n  },\\r\\n  \\\"elevations\\\": [\\r\\n    {\\r\\n      \\\"title\\\": \\\"Y3通り軸組図 S=1/100\\\",\\r\\n      \\\"levels\\\": [\\r\\n        \\\"パラペット天端\\\",\\r\\n        \\\"RFL(水下)\\\",\\r\\n        \\\"2FL\\\",\\r\\n        \\\"1FL\\\",\\r\\n        \\\"設計GL\\\",\\r\\n        \\\"基礎下端\\\"\\r\\n      ],\\r\\n      \\\"heightsMm\\\": [\\r\\n        600,\\r\\n        3500,\\r\\n        3500,\\r\\n        150,\\r\\n        1170\\r\\n      ],\\r\\n      \\\"levelsBottom\\\": [\\r\\n        \\\"2FL\\\",\\r\\n        \\\"1FL\\\",\\r\\n        \\\"設計GL\\\",\\r\\n        \\\"基礎下端\\\"\\r\\n      ],\\r\\n      \\\"heightsBottomMm\\\": [\\r\\n        3500,\\r\\n        150,\\r\\n        1170\\r\\n      ],\\r\\n      \\\"axis\\\": {\\r\\n        \\\"labels\\\": [\\r\\n          \\\"X1\\\",\\r\\n          \\\"X2\\\",\\r\\n          \\\"X3\\\",\\r\\n          \\\"X4\\\",\\r\\n          \\\"X5\\\"\\r\\n        ],\\r\\n        \\\"spansMm\\\": [\\r\\n          5850,\\r\\n          5150,\\r\\n          7175,\\r\\n          3825\\r\\n        ],\\r\\n        \\\"totalMm\\\": 22000\\r\\n      },\\r\\n      \\\"levelsBottomNote\\\": \\\"phase 37의 부분 전사다. phase 38(2026-09-04)에서 300dpi 크롭(위 블록 clip x80-340 y100-320, 아래 블록 y590-810)을 다시 읽어 최상단 두 레벨까지 확정했고, levels·heightsMm이 전 계열이다. levelsBottom·heightsBottomMm은 그 전 계열의 뒤쪽 부분집합이라 그대로 참이다.\\\",\\r\\n      \\\"titles\\\": [\\r\\n        \\\"Y3通り軸組図 S=1/100\\\"\\r\\n      ]\\r\\n    },\\r\\n    {\\r\\n      \\\"titles\\\": [\\r\\n        \\\"Y1通り軸組図 S=1/100\\\",\\r\\n        \\\"Y2通り軸組図 S=1/100\\\"\\r\\n      ],\\r\\n      \\\"levels\\\": [\\r\\n        \\\"パラペット天端\\\",\\r\\n        \\\"RFL(水下)\\\",\\r\\n        \\\"2FL\\\",\\r\\n        \\\"1FL\\\",\\r\\n        \\\"設計GL\\\",\\r\\n        \\\"基礎下端\\\"\\r\\n      ],\\r\\n      \\\"heightsMm\\\": [\\r\\n        600,\\r\\n        3500,\\r\\n        3500,\\r\\n        150,\\r\\n        1170\\r\\n      ],\\r\\n      \\\"note\\\": \\\"위 블록이다. 아래 블록(Y3)과 레벨 계열이 같다 — 300dpi 크롭 두 장에서 각각 읽었다. 通り芯 스팬은 이 블록에서 전사하지 않았다.\\\"\\r\\n    }\\r\\n  ],\\r\\n  \\\"notes\\\": [\\r\\n    \\\"2026-09-04 정정: 「2FL 위 최상단 레벨 라벨 미확정」은 해소됐다 — 300dpi 크롭에서 ▽パラペット天端·▽RFL(水下)와 그 사이 600을 읽었다. 7,750은 パラペット天端→設計GL의 合計(600+3500+3500+150)이고 스팬이 아니다\\\",\\r\\n    \\\"같은 열에 보조 레벨이 있다: 梁天端(水下) = 2FL−270, 1SL = 1FL와 같은 높이, 基礎梁天端·B.PL下端은 1FL 아래 20〜250\\\",\\r\\n    \\\"X1 왼쪽에 胴縁芯↔柱面 80 치수가 있다 — 스팬이 아니다. 용지 A1 /Rotate 90\\\",\\r\\n    \\\"위 블록(캡션 Y1·Y2)과 아래 블록(캡션 Y3)의 레벨 계열은 같다 — 두 크롭에서 각각 확인했다\\\"\\r\\n  ]\\r\\n}\\r\\n\\r\\n{\\r\\n  \\\"$comment\\\": \\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows/makeSegments로 재고 큰 값이 아래다.\\\",\\r\\n  \\\"source\\\": {\\r\\n    \\\"cacheFile\\\": \\\"dwg-tsu-kanritou.pdf\\\",\\r\\n    \\\"sha256\\\": \\\"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\\\",\\r\\n    \\\"issuer\\\": \\\"三重県津市\\\",\\r\\n    \\\"project\\\": \\\"旧津市民プール跡地テニスコート整備工事 管理棟\\\",\\r\\n    \\\"sheet\\\": \\\"S-16 杭・基礎・1階伏図\\\",\\r\\n    \\\"page\\\": 16,\\r\\n    \\\"transcribedAt\\\": \\\"2026-09-03\\\"\\r\\n  },\\r\\n  \\\"blocks\\\": [\\r\\n    {\\r\\n      \\\"title\\\": \\\"伏図(공통)\\\",\\r\\n      \\\"x\\\": {\\r\\n        \\\"labels\\\": [\\r\\n          \\\"X1\\\",\\r\\n          \\\"X2\\\",\\r\\n          \\\"X3\\\",\\r\\n          \\\"X4\\\",\\r\\n          \\\"X5\\\"\\r\\n        ],\\r\\n        \\\"spansMm\\\": [\\r\\n          5850,\\r\\n          5150,\\r\\n          7175,\\r\\n          3825\\r\\n        ],\\r\\n        \\\"totalMm\\\": 22000\\r\\n      },\\r\\n      \\\"y\\\": {\\r\\n        \\\"labels\\\": [\\r\\n          \\\"Y3\\\",\\r\\n          \\\"Y2\\\",\\r\\n          \\\"Y1\\\"\\r\\n        ],\\r\\n        \\\"spansMm\\\": [\\r\\n          5825,\\r\\n          7175\\r\\n        ],\\r\\n        \\\"totalMm\\\": 13000\\r\\n      },\\r\\n      \\\"notes\\\": [\\r\\n        \\\"杭·基礎·1階 伏図가 한 페이지에 있고 격자는 같다 — 블록 수는 확정하지 못했다\\\"\\r\\n      ]\\r\\n    }\\r\\n  ],\\r\\n  \\\"notes\\\": [\\r\\n    \\\"S造 관리동(RC는 基礎·地中梁). 용지 A1(1684×1191pt) /Rotate 90\\\"\\r\\n  ]\\r\\n}\\r\\n\\r\\n{\\r\\n  \\\"$comment\\\": \\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows/makeSegments로 재고 큰 값이 아래다.\\\",\\r\\n  \\\"source\\\": {\\r\\n    \\\"cacheFile\\\": \\\"dwg-karatsu-fukuzu.pdf\\\",\\r\\n    \\\"sha256\\\": \\\"a6712f907e4b17d787e9b1add3e726d960d31340846139269127e9b3aceb068e\\\",\\r\\n    \\\"issuer\\\": \\\"一般社団法人唐津東松浦薬剤師会\\\",\\r\\n    \\\"project\\\": \\\"（仮称）救急・夜間対応会営薬局新築工事\\\",\\r\\n    \\\"sheet\\\": \\\"S-3 基礎伏図\\\",\\r\\n    \\\"page\\\": 1,\\r\\n    \\\"transcribedAt\\\": \\\"2026-09-03\\\"\\r\\n  },\\r\\n  \\\"blocks\\\": [\\r\\n    {\\r\\n      \\\"title\\\": \\\"基礎伏図\\\",\\r\\n      \\\"x\\\": {\\r\\n        \\\"labels\\\": [\\r\\n          \\\"X1\\\",\\r\\n          \\\"X2\\\",\\r\\n          \\\"X3\\\",\\r\\n          \\\"X4\\\",\\r\\n          \\\"X5\\\",\\r\\n          \\\"X6\\\",\\r\\n          \\\"X7\\\"\\r\\n        ],\\r\\n        \\\"spansMm\\\": [\\r\\n          2300,\\r\\n          3350,\\r\\n          5250,\\r\\n          4200,\\r\\n          7025,\\r\\n          5000\\r\\n        ],\\r\\n        \\\"totalMm\\\": null\\r\\n      },\\r\\n      \\\"y\\\": {\\r\\n        \\\"labels\\\": [\\r\\n          \\\"Y6\\\",\\r\\n          \\\"Y5\\\",\\r\\n          \\\"Y4\\\",\\r\\n          \\\"Y3\\\",\\r\\n          \\\"Y2\\\",\\r\\n          \\\"Y1\\\",\\r\\n          \\\"Y0\\\"\\r\\n        ],\\r\\n        \\\"spansMm\\\": [\\r\\n          2204,\\r\\n          1806,\\r\\n          4069,\\r\\n          6000,\\r\\n          2265,\\r\\n          1900\\r\\n        ],\\r\\n        \\\"totalMm\\\": null\\r\\n      },\\r\\n      \\\"notes\\\": [\\r\\n        \\\"合計 치수가 없다. 대신 부분합 4,010(Y4→Y6 = 1806+2204)·4,165(Y0→Y2 = 1900+2265)이 적혀 있다 — 合計로 오인하면 合計不一致가 난다\\\",\\r\\n        \\\"Y6가 도면 위쪽이다(Y0가 아래)\\\"\\r\\n      ]\\r\\n    }\\r\\n  ],\\r\\n  \\\"notes\\\": [\\r\\n    \\\"같은 페이지에 A〜F·0 라벨과 205·3,020×5·205 / 5,694·4,572·4,373·4,373 치수를 가진 별개 블록이 있다 — 구조를 확정하지 못해 미전사. 파서가 이 블록으로 격자를 지어내면 안 된다\\\",\\r\\n    \\\"페이지 /Rotate 90\\\"\\r\\n  ]\\r\\n}\\r\\n\\r\\n{\\r\\n  \\\"$comment\\\": \\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 2026-09-03 수정(Claude, phase 37): 축 순서는 **페이지 순서**다 — X는 왼→오, Y는 위→아래(라벨이 세로로 쌓인 축은 위→아래). 초판은 번호 오름차순(아래→위)으로 적어 기존 파서 규약(kani-p38 Y3,Y2,Y1)과 어긋났고, 파서가 골든에 맞추려 도면별 뒤집기 분기를 넣었다(phase 36 검토에서 발견). labels·spansMm를 함께 뒤집었으므로 인접 라벨 사이 mm 대응은 그대로다. 페이지 좌표 근거: 각 라벨 세그먼트의 centerY(top-left 원점)를 recoverRows/makeSegments로 재고 큰 값이 아래다.\\\",\\r\\n  \\\"source\\\": {\\r\\n    \\\"cacheFile\\\": \\\"dwg-hirosaki-kikyono.pdf\\\",\\r\\n    \\\"sha256\\\": \\\"f4dfcfab190970d8df305ce53319b98efb17873b81e77462b112a89978135fa8\\\",\\r\\n    \\\"issuer\\\": \\\"青森県弘前市\\\",\\r\\n    \\\"project\\\": \\\"令和7年度 桔梗野小学校等複合施設新築工事(建築工事) 構造図1\\\",\\r\\n    \\\"sheet\\\": \\\"S-019 1階床梁伏図\\\",\\r\\n    \\\"page\\\": 21,\\r\\n    \\\"transcribedAt\\\": \\\"2026-09-03\\\"\\r\\n  },\\r\\n  \\\"blocks\\\": [\\r\\n    {\\r\\n      \\\"title\\\": \\\"1階床梁伏図\\\",\\r\\n      \\\"x\\\": {\\r\\n        \\\"labels\\\": [\\r\\n          \\\"X1\\\",\\r\\n          \\\"X2\\\",\\r\\n          \\\"X3\\\",\\r\\n          \\\"X4\\\",\\r\\n          \\\"X5\\\",\\r\\n          \\\"X6\\\",\\r\\n          \\\"X7\\\",\\r\\n          \\\"X8\\\",\\r\\n          \\\"X9\\\",\\r\\n          \\\"X10\\\",\\r\\n          \\\"X11\\\",\\r\\n          \\\"X12\\\"\\r\\n        ],\\r\\n        \\\"spansMm\\\": [\\r\\n          8000,\\r\\n          8000,\\r\\n          8000,\\r\\n          8000,\\r\\n          8000,\\r\\n          8000,\\r\\n          8000,\\r\\n      