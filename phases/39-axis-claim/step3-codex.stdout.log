y: string]: JsonValue }\r\n\r\ntype ClaimedPath = {\r\n  path: string\r\n  test: string\r\n}\r\n\r\ntype ReferenceOnlyPath = {\r\n  path: string\r\n  reason: string\r\n}\r\n\r\nconst GOLDEN_DIR = resolve(\r\n  process.cwd(),\r\n  'tests/fixtures/plan-import/expected',\r\n)\r\n\r\n/**\r\n * 골든의 값 필드와 이를 실제로 대조하는 테스트를 함께 선언한다.\r\n * 배열 원소는 인덱스가 아니라 `[]`로 표기한다.\r\n */\r\nconst CLAIMED: readonly ClaimedPath[] = [\r\n  {\r\n    path: 'blocks[].x.labels[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].x.spansMm[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].x.totalMm',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].y.labels[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].y.spansMm[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].y.totalMm',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].axis.labels[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > axis 골든 상호검증',\r\n  },\r\n  {\r\n    path: 'elevations[].axis.spansMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > axis 골든 상호검증',\r\n  },\r\n  {\r\n    path: 'elevations[].axis.totalMm',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > axis 골든 상호검증',\r\n  },\r\n  {\r\n    path: 'elevations[].heightsBottomMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > levelsBottom·heightsBottomMm 꼬리 대조',\r\n  },\r\n  {\r\n    path: 'elevations[].heightsMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].levelsBottom[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > levelsBottom·heightsBottomMm 꼬리 대조',\r\n  },\r\n  {\r\n    path: 'elevations[].levels[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].title',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].titles[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'heightsMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'levelTexts[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'levels[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > levels·levelTexts 관계 대조',\r\n  },\r\n]\r\n\r\nconst REFERENCE_ONLY: readonly ReferenceOnlyPath[] = [\r\n  {\r\n    path: '$comment',\r\n    reason: '독립 전사 방법과 변경 경위를 설명하는 주석이다.',\r\n  },\r\n  {\r\n    path: 'blocks[].notes[]',\r\n    reason: '블록별 판독 주석이며 파서 값의 기대값이 아니다.',\r\n  },\r\n  {\r\n    path: 'blocks[].title',\r\n    reason:\r\n      '7개 grid 골든의 8개 title 중 도면 문자열 5건(예: 屋根伏図)과 전사자 주석 3건(예: 伏図(공통))이 섞여 있어 균일한 기대값으로 전체 대조할 수 없는 블록 설명 메타데이터다.',\r\n  },\r\n  {\r\n    path: 'elevations[].levelsBottomNote',\r\n    reason: '부분 전사 꼬리의 경위를 설명하는 주석이다.',\r\n  },\r\n**입력을 잘라 받지 않는다.** 内法을 벗어나는 개구는 切り詰めずに `MemberUnsupportedError('寸法不成立')`으로 그 부재를 떨어뜨리고, 화면에는 그 자리에서 ▲ 경고를 낸다. 잘라서 받으면 도면에 없는 크기의 개구를 제품이 정하는 것이 된다(ADR-004). 開口가 鉄筋의 길이를 다 써 버리는 경우(내법 전면 개구)도 「길이 0의 철근」이 아니라 「거기에 부재가 없다」이므로 같이 떨어뜨린다.\r\n\r\n**검증**: 골든 픽스처 `quantity-r5-ch3.json`의 `cases.openingDeduction`에 1通則8)과 1通則7) **둘만으로 손유도한** 6케이스를 박았다 — 개구 1개, 세로로 겹친 2개(같은 본이 둘 다 지남), 가로로 나란한 높이 다른 2개(欠除量이 다른 群으로 갈리고, 직교 방향에서는 겹쳐 2000을 欠く 본이 나온다), 0.49㎡(欠除 없음), **0.50㎡ 딱(「以下」이므로 欠除 없음)**, 床板 1개(같은 조항이 부재를 가리지 않는다). 뮤테이션으로 감도를 실측했다 — 경계를 `<=`로 무르게 하면 4케이스, 走る向き를 뒤바꾸면 3케이스, 0.5㎡의 「以下」를 「未満」으로 바꾸면 1케이스가 떨어진다. 1通則8)의 픽스처 항목이 `deferred`에서 `covered`로 넘어갔다. 브라우저 실검증은 `tests/e2e/uc21-opening.js`.\r\n\r\n**트레이드오프**: (1) 「어느 본이 欠けるか」의 판정이 조문에 없는 읽기다 — 위치를 어느 끝에서부터 세는지도 원문이 정하지 않으므로, 개구가 부재 중앙에 없을 때 1본 차이가 날 수 있다(R2). (2) 開口가 있는 부재만 3D의 배치 규칙이 바뀐다 — 같은 断面의 벽 두 장이 開口의 有無로 철근 위치가 미묘하게 달라 보인다. 数量과 그림을 일치시키기 위한 대가다. (3) 欠除量마다 행이 갈리므로 개구가 많은 벽은 内訳의 행이 늘어난다 — 前文의 「寸法等ごとに」가 그것을 요구하지만, 읽는 쪽에서는 같은 役割이 흩어져 보인다. (4) 開口補強筋을 받지 않으므로 개구가 있는 부재는 여전히 정확하지 않다 — 방향이 과대에서 과소로 바뀌었을 뿐이다. 닫으려면 「설계도서에서 읽은 補強筋을 그대로 옮겨 적는」 입력이 필요하고, 그것은 제품이 값을 만드는 것이 아니라 전사하는 일이다.\r\n\r\n### ADR-030: 伏図·軸組図의 텍스트 레이어에서 형상을 「후보」로 파싱한다 (ADR-004 재검토·ADR-018 확장)\r\n\r\n**맥락**: 도면 인식 트랙(ADR-018)은 断面リスト의 **값**만 파싱하고 형상(通り芯·스팬·階高·부재 배치)은 수동 입력이다 — ADR-004의 명시적 결정이었다. 그 기각 사유는 두 겹이었는데, 데이터 전제(「검증용 실도면 세트를 구할 수 없다」)는 ADR-018에서 이미 뒤집혔고, 남은 것은 기술 전제 — 伏図의 형상 정보가 断面リスト처럼 좌표 기반 결정적 파싱이 되는가 — 였다. 2026-08-23 스파이크로 실측했다.\r\n\r\n**스파이크 실측** (`.cache/`의 실물 도면, pdf.js 텍스트 레이어·operator list. 스크립트는 일회용이라 커밋하지 않았고 방법은 아래에 재현 가능하게 적는다 — `getTextContent()`의 item별 `transform` 원시 좌표를 그대로 쓴다):\r\n\r\n1. **通り芯 그리드가 텍스트만으로 복원된다.** yokohama p5·p6(杭伏図·基礎伏図/1階床伏図): 축 라벨(`bX1`–`bX3`·`cX1`, `bY1`–`bY6`)이 축 양단에 텍스트로 있고, 스팬 치수(`8700`·`1200`·`5000`·`6000`·`10000`)가 **인접 라벨 좌표의 중점**에 놓인다(예: bX1@y500–bX2@y746의 치수 8700@y623). 좌표 간격/치수값 비가 전 스팬에서 0.0283pt/mm로 일관 — 1/100 축척과 정합한다. 축척은 표기(「A3=1/200·A1=1/100」)가 용지 의존이라 믿지 않고 이 비율에서 유도한다.\r\n2. **부재 부호가 그리드에 스냅된다.** `FG51`@(235,1727): x가 bY6 축(216) 위, y가 bX1–bX2 중점(1727.5) — 大梁은 「한 축 위 ＋ 스팬 중점」. `S55`@(285,1730): 두 좌표 모두 중점 — 床板은 칸 중앙. `F`계 부호는 교점 부근이되 지시선 오프셋이 있다(스냅 허용오차 필요).\r\n3. **발주처가 달라도 구조가 같다.** kani-kids p38(基礎伏図): 라벨 `X1`–`X4`·`Y1`–`Y3`, 치수는 「6,000」 콤마 형식, **전체 치수 20,000 ＝ 6,000＋6,000＋8,000이라 합계가 검증식(checksum)이 된다.**\r\n4. **階高도 같은 방법이 선다.** yokohama p8(軸組図): 「bY1通り軸組図」 블록이 通り별로 반복되고, FL 라벨(`基準GL`·`中央棟1FL`·`2FL`)과 세로 치수(4480·4100)가 텍스트다.\r\n5. **벡터 선분은 쓰지 않는다.** 一点鎖線 축선은 CAD 출력에서 짧은 실선 조각으로 분해되고(>150pt 장선 156개 중 dashed 0), 경로 좌표는 CTM 공간이라 텍스트 좌표와 맞추려면 변환 추적이 따로 필요하다. 텍스트만으로 복원이 완결되므로 범위에서 뺀다 — 断面リスト 파서와 같은 교훈이다.\r\n6. **한계**: ojkk 확보분에는 伏図가 없어(리스트·断面図만) 실측은 발주처 2부다. 한 페이지에 伏図 블록이 여럿이고(p6: 基礎伏図·1階床伏図) 라벨·치수 세트가 블록마다 반복되므로 블록 분리가 선행한다 — 표제란 図面名称(「基礎伏図・1階床伏図」)이 타이틀로 오인되는 함정(issue #33)도 그대로 적용된다.\r\n\r\n","exit_code":0,"status":"completed"}}
