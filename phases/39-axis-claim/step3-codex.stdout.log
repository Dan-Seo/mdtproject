\\n * 寃껊낫???ル떎 (R10).\\r\\n */\\r\\nconst MINIMUM_CHAIN_DIMENSIONS = 3\\r\\n\\r\\ninterface Token {\\r\\n  text: string\\r\\n  x: number\\r\\n  y: number\\r\\n  leftX: number\\r\\n  rightX: number\\r\\n}\\r\\n\\r\\ninterface DimensionToken extends Token {\\r\\n  valueMm: number\\r\\n}\\r\\n\\r\\nfunction tokens(page: TextPage): Token[] {\\r\\n  const collected: Token[] = []\\r\\n  for (const row of recoverRows(page.items)) {\\r\\n    for (const segment of row.segments) {\\r\\n      collected.push({\\r\\n        text: segment.compact,\\r\\n        x: segment.centerX,\\r\\n        y: segment.centerY,\\r\\n        leftX: segment.x,\\r\\n        rightX: segment.endX,\\r\\n      })\\r\\n    }\\r\\n  }\\r\\n  for (const run of verticalRuns(page.items)) {\\r\\n    collected.push({\\r\\n      text: run.text,\\r\\n      x: run.x,\\r\\n      y: run.y,\\r\\n      leftX: run.x,\\r\\n      rightX: run.x,\\r\\n    })\\r\\n  }\\r\\n  return collected\\r\\n}\\r\\n\\r\\nfunction median(values: number[]): number {\\r\\n  return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\\r\\n}\\r\\n\\r\\nfunction dimensionScale(left: DimensionToken, right: DimensionToken): number {\\r\\n  return (\\r\\n    (2 * (right.y - left.y)) /\\r\\n    (left.valueMm + right.valueMm)\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction chainScales(chain: DimensionToken[]): number[] {\\r\\n  return chain.slice(1).map((dimension, i) =>\\r\\n    dimensionScale(chain[i], dimension),\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction isShortDimension(\\r\\n  dimension: DimensionToken,\\r\\n  previous: DimensionToken[],\\r\\n): boolean {\\r\\n  return (\\r\\n    previous.length >= MINIMUM_CHAIN_DIMENSIONS &&\\r\\n    dimension.valueMm < median(previous.map((entry) => entry.valueMm)) *\\r\\n      SHORT_DIMENSION_RATIO\\r\\n  )\\r\\n}\\r\\n\\r\\n/** 移섏닔瑜?x媛 怨㏐쾶 ???대줈 臾띕뒗??*/\\r\\nfunction dimensionColumns(dimensions: DimensionToken[]): DimensionToken[][] {\\r\\n  const sorted = [...dimensions].sort((a, b) => a.x - b.x || a.y - b.y)\\r\\n  const columns: DimensionToken[][] = []\\r\\n\\r\\n  for (const token of sorted) {\\r\\n    const column = columns.at(-1)\\r\\n    if (column && Math.abs(column[0].x - token.x) <= COLUMN_TOLERANCE_PT) {\\r\\n      column.push(token)\\r\\n    } else {\\r\\n      columns.push([token])\\r\\n    }\\r\\n  }\\r\\n\\r\\n  return columns.map((column) => [...column].sort((a, b) => a.y - b.y))\\r\\n}\\r\\n\\r\\nfunction horizontalDistance(token: Token, x: number): number {\\r\\n  if (token.rightX < x) return x - token.rightX\\r\\n  if (token.leftX > x) return token.leftX - x\\r\\n  return 0\\r\\n}\\r\\n\\r\\nfunction labelText(token: Token): string | undefined {\\r\\n  const text = token.text.replace(/^[?썩뼰?꿎뼹]+/, '')\\r\\n  return text.length > 0 ? text : undefined\\r\\n}\\r\\n\\r\\nfunction isLevelLabel(text: string): boolean {\\n  return /(?:FL|GL|RCL|(?:鸚⑴ク|訝뗧ク|訝딁ク)$)/.test(text)\\n}\\n\\r\\nfunction nearestLevelIndex(\\r\\n  levels: ElevationLevel[],\\r\\n  y: number,\\r\\n): { index: number; distance: number } {\\r\\n  let index = -1\\r\\n  let distance = Number.POSITIVE_INFINITY\\r\\n  for (let i = 0; i < levels.length; i++) {\\r\\n    const candidateDistance = Math.abs(levels[i].positionPt - y)\\r\\n    if (candidateDistance < distance) {\\r\\n      index = i\\r\\n      distance = candidateDistance\\r\\n    }\\r\\n  }\\r\\n  return { index, distance }\\r\\n}\\r\\n\\r\\n/**\\n * ???댁쓣 異뺤쿃???댁뼱吏??理쒕? 援ш컙?쇰줈 ?섎늿?? 媛숈? ?댁뿉 ?꽷룹븘????邕며탡?녠?\\r\\n * ?ㅻ━硫??ㅻЪ p8) 洹??ъ씠?먯꽌 ?좊룄 異뺤쿃???ш쾶 ?꾨떎 ???댁쓣 ?듭㎏濡?踰꾨━吏 ?딄퀬\\r\\n * 洹??먮━?먯꽌 ?먮Ⅸ??\\r\\n */\\r\\nfunction chains(column: DimensionToken[]): DimensionToken[][] {\\r\\n  const result: DimensionToken[][] = []\\r\\n  let current: DimensionToken[] = []\\r\\n  let reference: number | undefined\\r\\n\\r\\n  for (let i = 0; i + 1 < column.length; i++) {\\r\\n    const scale = dimensionScale(column[i], column[i + 1])\\r\\n    const continues =\\r\\n      reference !== undefined &&\\r\\n      Math.abs(scale / reference - 1) <= SCALE_TOLERANCE_RATIO\\r\\n    const shortDimension =\\r\\n      current.length >= MINIMUM_CHAIN_DIMENSIONS &&\\r\\n      isShortDimension(column[i + 1], current) &&\\r\\n      reference !== undefined &&\\r\\n      Math.abs(scale / reference - 1) <= SHORT_TAIL_SCALE_TOLERANCE_RATIO\\r\\n\\r\\n    if (continues || shortDimension) {\\r\\n      current.push(column[i + 1])\\r\\n    } else {\\r\\n      if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\\r\\n      current = [column[i], column[i + 1]]\\r\\n      reference = scale\\r\\n    }\\r\\n  }\\r\\n  if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\\r\\n\\r\\n  return result\\r\\n}\\r\\n\\r\\n/**\\r\\n * 吏㏃? 援ш컙 ?ㅼ쓽 留덉?留?移섏닔??媛숈? 二쇱꽍 ?댁쓽 ??씠 ?ㅻⅨ ?꾩튂???볦씪 ???덈떎.\\r\\n * 媛숈? x ?대쭔 怨좎쭛?섎㈃ Tsu??1170怨?Hirosaki??2310???덈씫?쒕떎. 癒쇱? ?곗뇙?먯꽌\\r\\n * ?좊룄??異뺤쿃怨?媛??媛源뚯슫 ?ㅼ쓬 ?レ옄 ?섎굹瑜?怨좊Ⅴ怨? x ?대룞쨌媛꾧꺽쨌異뺤쿃??紐⑤몢\\r\\n * 留뚯”???뚮쭔 遺숈씤?? ?≪쓬 ?レ옄瑜???쒓컪?쇰줈 怨좊Ⅴ吏 ?딅룄濡??꾨낫媛 ?놁쑝硫?硫덉텣??\\r\\n */\\r\\nfunction extendShortTail(\\r\\n  chain: DimensionToken[],\\r\\n  dimensions: DimensionToken[],\\r\\n): DimensionToken[] {\\r\\n  const extended = [...chain]\\r\\n  const used = new Set(chain)\\r\\n\\r\\n  while (extended.length >= MINIMUM_CHAIN_DIMENSIONS) {\\r\\n    const last = extended.at(-1)\\r\\n    if (!last || !isShortDimension(last, extended.slice(0, -1))) break\\r\\n\\r\\n    const scales = chainScales(extended)\\r\\n    if (scales.length === 0) break\\r\\n    const scale = median(scales)\\r\\n    const chainX = median(extended.map((entry) => entry.x))\\r\\n    const candidates = dimensions\\r\\n      .filter((candidate) => {\\r\\n        if (used.has(candidate) || candidate.y <= last.y) return false\\r\\n        if (\\r\\n          Math.abs(candidate.x - chainX) > SHORT_TAIL_COLUMN_WINDOW_PT\\r\\n        ) {\\r\\n          return false\\r\\n        }\\r\\n\\r\\n        const gap = candidate.y - last.y\\r\\n        if (gap > LABEL_WINDOW_PT) return false\\r\\n        const expectedGap =\\r\\n          ((last.valueMm + candidate.valueMm) / 2) * scale\\r\\n        if (expectedGap <= 0) return false\\r\\n        return (\\r\\n          Math.abs(gap / expectedGap - 1) <=\\r\\n          SHORT_TAIL_SCALE_TOLERANCE_RATIO\\r\\n        )\\r\\n      })\\r\\n      .sort((left, right) => {\\r\\n        const leftGap = left.y - last.y\\r\\n        const rightGap = right.y - last.y\\r\\n        const leftExpected =\\r\\n          ((last.valueMm + left.valueMm) / 2) * scale\\r\\n        const rightExpected =\\r\\n          ((last.valueMm + right.valueMm) / 2) * scale\\r\\n        return (\\r\\n          Math.abs(leftGap / leftExpected - 1) -\\r\\n            Math.abs(rightGap / rightExpected - 1) ||\\r\\n          leftGap - rightGap\\r\\n        )\\r\\n      })\\r\\n\\r\\n    const next = candidates[0]\\r\\n    if (!next) break\\r\\n    extended.push(next)\\r\\n    used.add(next)\\r\\n  }\\r\\n\\r\\n  return extended\\r\\n}\\r\\n\\r\\nfunction levelsOf(\\r\\n  chain: DimensionToken[],\\r\\n  scale: number,\\r\\n): Array<{ positionPt: number }> {\\r\\n  const first = chain[0].y - (chain[0].valueMm * scale) / 2\\r\\n  const positions = [first]\\r\\n  for (const dimension of chain) {\\r\\n    positions.push(positions[positions.length - 1] + dimension.valueMm * scale)\\r\\n  }\\r\\n  return positions.map((positionPt) => ({ positionPt }))\\r\\n}\\r\\n\\r\\nfunction verticalExtent(elevation: ElevationCandidate): {\\r\\n  top: number\\r\\n  bottom: number\\r\\n} {\\r\\n  return {\\r\\n    top: elevation.levels[0].positionPt,\\r\\n    bottom: elevation.levels[elevation.levels.length - 1].positionPt,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?몃줈 踰붿쐞媛 寃뱀튂??怨꾩뿴? **媛숈? 援ш컙???쒕줈 ?ㅻⅨ ?쎄린**?????ㅻЪ p8?먯꽌??\\n * ?롩쳵 ??1400쨌4100쨌4480쨌2690) ?놁뿉 ?ⓨ늽 移섏닔 ??190쨌150쨌2350)???섎????쒓퀬,\\r\\n * 洹?遺遺??대룄 洹쇱쿂 ?쇰꺼 ?섏쓣 二쇱썙 怨꾩뿴??議곌굔??留뚯”?쒕떎. ?????대㈃ ?ъ슜?먯뿉寃?\\n * ?쒕줈 ?닿툔?섎뒗 ?롩쳵媛 ?숈떆??蹂댁씤??\\r\\n *\\r\\n * 媛???볤쾶 ?쎌? 寃??섎굹留??④릿?? ?롩쳵 ?댁? 邕며탡?녹쓽 ?믪씠 ?꾩껜瑜??ш퀬\\r\\n * 遺遺??댁? 援?냼?곸씠?? ?몃줈 踰붿쐞媛 洹??섏쓣 媛???ш쾶 媛덈씪 ?볥뒗???ㅻЪ?먯꽌\\r\\n * 359pt ? 38쨌52pt). ?꾨㈃ ?뺤떇?????꾩젣瑜?源⑤㈃ 怨꾩뿴???섎굹 ?щ씪吏怨?\\r\\n * 媛믪쓣 吏?대궡??????ъ슜?먭? ?먯쑝濡??ｋ뒗??(R10).\\r\\n */\\r\\nfunction withoutOverlaps(\\r\\n  elevations: ElevationCandidate[],\\r\\n): ElevationCandidate[] {\\r\\n  const ranked = [...elevations].sort((a, b) => {\\r\\n    const left = verticalExtent(a)\\r\\n    const right = verticalExtent(b)\\r\\n    return (\\r\\n      right.bottom - right.top - (left.bottom - left.top) ||\\r\\n      b.levels.length - a.levels.length\\r\\n    )\\r\\n  })\\r\\n\\r\\n  const kept: ElevationCandidate[] = []\\r\\n  for (const elevation of ranked) {\\r\\n    const range = verticalExtent(elevation)\\r\\n    const overlaps = kept.some((accepted) => {\\r\\n      const other = verticalExtent(accepted)\\r\\n      return range.top <= other.bottom && other.top <= range.bottom\\r\\n    })\\r\\n    if (!overlaps) kept.push(elevation)\\r\\n  }\\r\\n\\r\\n  return kept\\r\\n}\\r\\n\\r\\nexport function parseFrameElevations(page: TextPage): ParsedFrameElevations {\\r\\n  const collected = tokens(page)\\r\\n\\r\\n  const dimensions: DimensionToken[] = []\\r\\n  const labels: Token[] = []\\r\\n  const titles: Token[] = []\\r\\n  for (const token of collected) {\\r\\n    if (DIMENSION_PATTERN.test(token.text)) {\\r\\n      dimensions.push({\\r\\n        ...token,\\r\\n        valueMm: Number.parseInt(token.text.replaceAll(',', ''), 10),\\r\\n      })\\r\\n      continue\\r\\n    }\\r\\n    if (ELEVATION_TITLE_PATTERN.test(token.text)) {\\r\\n      titles.push(token)\\r\\n      continue\\r\\n    }\\r\\n    labels.push(token)\\r\\n  }\\r\\n\\r\\n  const elevations: ElevationCandidate[] = []\\r\\n  for (const column of dimensionColumns(dimensions)) {\\r\\n    for (const baseChain of chains(column)) {\\r\\n      const chain = extendShortTail(baseChain, dimensions)\\r\\n      const scales = chainScales(chain)\\r\\n      const scale = median(scales)\\r\\n      const positions = levelsOf(chain, scale)\\r\\n\\r\\n      // ?쇰꺼? 媛??媛源뚯슫 ?덈꺼 ?섎굹?먮쭔 遺숇뒗????痢듭씠 ?뺤쑝硫??덉슜 踰붿쐞媛\\r\\n      // 寃뱀튂?붾뜲, 寃뱀튂??留뚰겮 ?묒そ???ｌ쑝硫??녿뒗 ?쇰꺼???앷릿??\\n      const levels: ElevationLevel[] = positions.map(({ positionPt }) => ({\\r\\n        labels: [],\\r\\n        positionPt,\\r\\n      }))\\n      const labelsAtLevels: Token[][] = levels.map(() => [])\\n      const labelCandidates = labels.filter(\\n        (label) => horizontalDistance(label, chain[0].x) <= LABEL_WINDOW_PT,\\n      )\\n      for (const label of labelCandidates) {\\n        const text = labelText(label)\\r\\n        if (text === undefined || !isLevelLabel(text)) continue\\r\\n        const nearest = nearestLevelIndex(levels, label.y)\\r\\n        if (nearest.index < 0 || nearest.distance > LEVEL_TOLERANCE_PT) {\\r\\n          continue\\r\\n        }\\r\\n        labelsAtLevels[nearest.index].push(label)\\r\\n      }\\r\\n\\r\\n      // 吏㏃? 移섏닔媛 ?ㅼ젣濡??곹? ?덉쑝硫? 洹??ъ씠?????덈꺼??媛숈? ?꾩튂濡??묒?\\r\\n      // ?딅뒗?? 移섏닔 ?쒓린媛 醫곸? 援ш컙???쒖そ??紐곕젮 ???쇰꺼?????덈꺼???④퍡\\r\\n      // 遺숇뒗 寃쎌슦?먮뒗, ?꾨㈃???꾟넂?꾨옒 ?쇰꺼 ?쒖꽌濡??ㅼ쓬 ?덈꺼???섎굹瑜?蹂대궦??\\r\\n      for (let i = 0; i + 1 < chain.length; i++) {\\r\\n        if (!isShortDimension(chain[i], chain.slice(0, i))) continue\\r\\n        if (\\r\\n          labelsAtLevels[i]?.length !== 2 ||\\r\\n          labelsAtLevels[i + 1]?.length !== 0\\r\\n        ) {\\r\\n          continue\\r\\n        }\\r\\n        const ordered = [...(labelsAtLevels[i] ?? [])].sort(\\r\\n          (left, right) => left.y - right.y || left.x - right.x,\\r\\n        )\\r\\n        const moved = ordered.pop()\\r\\n        if (!moved) continue\\r\\n        labelsAtLevels[i] = ordered\\r\\n        labelsAtLevels[i + 1] = [moved]\\r\\n      }\\r\\n\\r\\n      for (let i = 0; i < levels.length; i++) {\\r\\n        levels[i].labels = (labelsAtLevels[i] ?? [])\\r\\n          .sort((left, right) => left.y - right.y || left.x - right.x)\\r\\n          .flatMap((label) => {\\r\\n            const text = labelText(label)\\r\\n            return text === undefined ? [] : [text]\\r\\n          })\\r\\n      }\\r\\n\\r\\n      const labelled = levels.filter((level) => level.labels.length > 0).length\\r\\n      if (labelled < MINIMUM_LABELLED_LEVELS) continue\\r\\n\\r\\n      elevations.push({\\r\\n        titles: [],\\r\\n        levels,\\r\\n        heightsMm: chain.map((dimension) => dimension.valueMm),\\r\\n        scalePtPerMm: scale,\\r\\n      })\\r\\n    }\\r\\n  }\\r\\n\\r\\n  const overlapFree = withoutOverlaps(elevations)\\r\\n  overlapFree.sort((a, b) => a.levels[0].positionPt - b.levels[0].positionPt)\\r\\n\\r\\n  // ?쒕ぉ? 怨꾩뿴??遺숈씤??????怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃━誘濡?\\n  // (?ㅻЪ p8? 醫뚮떒 移섏닔 ???섎굹??bY1쨌bY2쨌bY3 ???? 1:1???꾨땲??\\r\\n  //\\r\\n  // ?⑥닚 理쒓렐?묒씠 ?꾨땲??**?쒕ぉ ?꾩뿉 ?덈뒗 怨꾩뿴???곗꽑?쒕떎.** 邕며탡?녹쓽 罹≪뀡?\\r\\n  // 洹몃┝ ?꾨옒???곹엳?붾뜲(?ㅻЪ p8??6???꾨?), ??洹몃┝??罹≪뀡? ??洹몃┝???섎떒怨?\\n  // ?꾨옒 洹몃┝???곷떒?먯꽌 嫄곗쓽 媛숈? 嫄곕━???볦씤??p8 ?ㅼ륫 170.4pt ? 167.7pt) ??\\n  // ?⑥닚 理쒓렐?묒? ??移쇰걹?먯꽌 媛덈━怨? ?ㅼ젣濡?VerticalRun.y 洹쒖빟 ?뺤젙(?뭮/2)??\\n  // 洹??먯젙???ㅼ쭛????怨꾩뿴???쒕ぉ 0?μ쑝濡??щ씪議뚮떎. ?꾩뿉 怨꾩뿴???섎굹???놁쓣\\r\\n  // ?뚮쭔(罹≪뀡??洹몃┝ ?꾩뿉 ?덈뒗 ?뺤떇) ?꾨옒?먯꽌 理쒓렐?묒쓣 李얜뒗??\\r\\n  for (const title of titles) {\\r\\n    let above: ElevationCandidate | undefined\\r\\n    let aboveDistance = Number.POSITIVE_INFINITY\\r\\n    let below: ElevationCandidate | undefined\\r\\n    let belowDistance = Number.POSITIVE_INFINITY\\r\\n    for (const elevation of overlapFree) {\\r\\n      const top = elevation.levels[0].positionPt\\r\\n      const bottom = elevation.levels[elevation.levels.length - 1].positionPt\\r\\n      if (title.y >= top) {\\r\\n        const distance = title.y > bottom ? title.y - bottom : 0\\r\\n        if (distance < aboveDistance) {\\r\\n          above = elevation\\r\\n          aboveDistance = distance\\r\\n        }\\r\\n      } else {\\r\\n        const distance = top - title.y\\r\\n        if (distance < belowDistance) {\\r\\n          below = elevation\\r\\n          belowDistance = distance\\r\\n        }\\r\\n      }\\r\\n    }\\r\\n    ;(above ?? below)?.titles.push(title.text)\\r\\n  }\\r\\n\\r\\n  // 邕며탡?녹쓽 ?믪씠 怨꾩뿴? 邕며탡?녹뿉 ?랁븳?????쒕ぉ??遺숈? ?딆? 移섏닔 ?댁? 洹멸쾬??\\n  // 臾댁뾿???믪씠?몄? 留먰븷 ???녿떎. ?ㅻЪ yokohama ??18履쎌쓣 ?듦낵?쒗궎硫?**?계나?긺듁??*媛\\r\\n  // 嫄몃┛??源딆씠 ?レ옄媛 ?댁쓣 ?대（怨??놁뿉 ?쇰꺼???좊떎) ??洹멸쾬???롩쳵濡??대㈃\\r\\n  // ?ъ슜?먯뿉寃??덉????딆? 痢듭씠 蹂댁씤??\\n  const resolved = overlapFree.filter((elevation) => elevation.titles.length > 0)\\r\\n\\r\\n  if (resolved.length === 0) {\\r\\n    return { elevations: [], issues: ['野멩퀡?쀦쑋濾쒎눣'] }\\r\\n  }\\r\\n\\r\\n  const issues: ElevationIssue[] = []\\r\\n  return { elevations: resolved, issues }\\r\\n}\\r\\n\\r\\nimport { describe, expect, it } from 'vitest'\\r\\n\\r\\nimport type { TextItem } from '../types'\\r\\nimport type { TextPage } from '../section-list/types'\\r\\n\\r\\nimport { parseFrameElevations } from './elevation'\\r\\n\\r\\n// ?ㅻЪ ?꾨㈃ ?쎌뒪泥??議곕뒗 tests/plan-import/elevation.test.ts???덈떎.\\r\\n\\r\\nfunction h(str: string, x: number, y: number): TextItem {\\r\\n  return { str, x, y, w: 0, h: 8 }\\r\\n}\\r\\n\\r\\nconst VERTICAL_GLYPH_WIDTH_PT = 8\\r\\n\\r\\n/** ?몃줈?곌린 移섏닔. 邕며탡?녹쓽 ?롩쳵 移섏닔???ㅻЪ?먯꽌 rot=-90?대떎.\\r\\n *  ?몄옄 y??臾몄옄?댁쓽 臾쇰━ 以묒떖?닿퀬, TextItem.y(?먯젏)??吏꾪뻾??w???덈컲留뚰겮\\r\\n *  洹??꾨옒????VerticalRun.y媛 諛붿슫??諛뺤뒪 以묒떖?대씪?쒕떎 (runs.ts) */\\r\\nfunction v(str: string, x: number, y: number): TextItem {\\r\\n  return {\\r\\n    str,\\r\\n    x,\\r\\n    y: y + VERTICAL_GLYPH_WIDTH_PT / 2,\\r\\n    w: VERTICAL_GLYPH_WIDTH_PT,\\r\\n    h: 0,\\r\\n    rot: -90,\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction page(items: TextItem[]): TextPage {\\r\\n  return { widthPt: 1000, heightPt: 1000, items }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 異뺤쿃 0.05pt/mm??4?덈꺼. 移섏닔???먭린媛 ?щ뒗 援ш컙??**以묒젏**???볦씠誘濡?\\n * ?몄젒 ??移섏닔??媛꾧꺽??(v0+v1)/2 횞 異뺤쿃???쒕떎 ???뚯꽌??洹?愿怨꾨줈 異뺤쿃???쇰떎.\\r\\n *\\r\\n * 移섏닔媛 ?뗭씤 寃껋? ?꾩슂議곌굔?대떎 ???섏씠硫??좊룄??異뺤쿃???議고븷 ?곷?媛 ?녿떎.\\r\\n */\\r\\nfunction fourLevels(): TextItem[] {\\r\\n  return [\\r\\n    v('2000', 50, 150),\\r\\n    v('2000', 50, 250),\\r\\n    v('2000', 50, 350),\\r\\n    h('RFL', 80, 100),\\r\\n    h('3FL', 80, 200),\\r\\n    h('2FL', 80, 300),\\r\\n    h('1FL', 80, 400),\\r\\n    // 怨꾩뿴? 邕며탡?녹뿉 ?랁븳?????쒕ぉ???놁쑝硫?臾댁뾿???믪씠?몄? 留먰븷 ???녿떎\\r\\n    h('bY1?싥굤邕며탡??/100', 300, 500),\\r\\n  ]\\r\\n}\\r\\n\\r\\ndescribe('parseFrameElevations', () => {\\r\\n  it('移섏닔 ?댁씠 ?놁쑝硫?野멩퀡?쀦쑋濾쒎눣', () => {\\r\\n    const parsed = parseFrameElevations(page([h('2FL', 80, 200)]))\\r\\n    expect(parsed.elevations).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\\r\\n  })\\r\\n\\r\\n  it('移섏닔 ?곗뇙?먯꽌 異뺤쿃怨??덈꺼 ?꾩튂瑜??怨? ?쇰꺼???먮Ц 洹몃?濡?遺숈씤??, () => {\\r\\n    const parsed = parseFrameElevations(page(fourLevels()))\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.elevations).toEqual([\\r\\n      {\\r\\n        titles: ['bY1?싥굤邕며탡??/100'],\\r\\n        levels: [\\r\\n          { labels: ['RFL'], positionPt: 100 },\\r\\n          { labels: ['3FL'], positionPt: 200 },\\r\\n          { labels: ['2FL'], positionPt: 300 },\\r\\n          { labels: ['1FL'], positionPt: 400 },\\r\\n        ],\\r\\n        heightsMm: [2000, 2000, 2000],\\r\\n        scalePtPerMm: 0.05,\\r\\n      },\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('媛숈? ?믪씠???쇰꺼???섏씠硫??????ｋ뒗?????대뒓 履쎌씠 ?롮씤吏 怨좊Ⅴ吏 ?딅뒗??, () => {\\r\\n    // ?ㅻЪ yokohama p8???뚥릎鸚?짘1FL?띻낵 ?뚦읃繹뺾L?띿씠 ??愿怨꾨떎 (190mm 李?竊?5pt)\\r\\n    const parsed = parseFrameElevations(\\r\\n      page([...fourLevels(), h('?뷸틬GL', 20, 403)]),\\r\\n    )\\r\\n    expect(parsed.elevations[0]?.levels.at(-1)).toEqual({\\r\\n      labels: ['1FL', '?뷸틬GL'],\\r\\n      positionPt: 400,\\r\\n    })\\r\\n  })\\r\\n\\r\\n  it('?쇰꺼??遺숈? ?덈꺼????誘몃쭔?대㈃ 怨꾩뿴濡?蹂댁? ?딅뒗??, () => {\\r\\n    // 遺遺?移섏닔 ???뗣겤?듏룡?藥???? ?쇰꺼??媛뽰? ?딅뒗????洹멸쾬???좎씪??援щ텇?대떎\\r\\n    const parsed = parseFrameElevations(\\r\\n      page(\\r\\n        fourLevels().filter(\\r\\n          (item) => !['RFL', '3FL', '2FL'].includes(item.str),\\r\\n        ),\\r\\n      ),\\r\\n    )\\r\\n    expect(parsed.elevations).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\\r\\n  })\\r\\n\\r\\n  it('移섏닔媛 ?섎퓧???댁? 怨꾩뿴濡?蹂댁? ?딅뒗?????좊룄??異뺤쿃???議고븷 ?곷?媛 ?녿떎', () => {\\r\\n    // ?ㅻЪ kani p40?먯꽌???꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔媛 ???대줈 ?댁뼱??\\n    // 異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???먮━??留덉묠 湲?먭? ?덉뼱 ?듦낵?덈떎\\r\\n    const parsed = parseFrameElevations(\\r\\n      // 354 = 以묒떖 350 + w/2 ??v()媛 ?먯젏??以묒떖 ?꾨옒濡??ｋ뒗??\\n      page(\\r\\n        fourLevels().filter(\\r\\n          (item) => item.y !== 350 + VERTICAL_GLYPH_WIDTH_PT / 2,\\r\\n        ),\\r\\n      ),\\r\\n    )\\r\\n    expect(parsed.elevations).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\\r\\n  })\\r\\n\\r\\n  it('異뺤쿃???딄린???먮━?먯꽌 怨꾩뿴???섎늿????媛숈? ?댁쓽 ?꽷룹븘????邕며탡??, () => {\\r\\n    const lower = fourLevels().map((item) => ({ ...item, y: item.y + 800 }))\\r\\n    const parsed = parseFrameElevations(page([...fourLevels(), ...lower]))\\r\\n    expect(parsed.elevations).toHaveLength(2)\\r\\n    expect(parsed.elevations.map((e) => e.levels[0].positionPt)).toEqual([\\r\\n      100, 900,\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('??怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃┛??, () => {\\r\\n    const parsed = parseFrameElevations(\\r\\n      page([...fourLevels(), h('bY2?싥굤邕며탡??/100', 600, 500)]),\\r\\n    )\\r\\n    expect(parsed.elevations[0]?.titles).toEqual([\\r\\n      'bY1?싥굤邕며탡??/100',\\r\\n      'bY2?싥굤邕며탡??/100',\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('?쒕ぉ???녿뒗 移섏닔 ?댁? 怨꾩뿴濡?蹂댁? ?딅뒗??, () => {\\r\\n    // ?ㅻЪ yokohama ??18履쎌쓣 ?듦낵?쒗궎硫?**?계나?긺듁??*媛 嫄몃┛????源딆씠 ?レ옄媛\\r\\n    // ?댁쓣 ?대（怨??놁뿉 ?쇰꺼???쒖꽌 ?ш린源뚯???議곌굔???꾨? 留뚯”?쒕떎\\r\\n    const parsed = parseFrameElevations(\\r\\n      page(fourLevels().filter((item) => !item.str.includes('邕며탡'))),\\r\\n    )\\r\\n    expect(parsed.elevations).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\\r\\n  })\\r\\n\\r\\n  it('?덈꺼 ?쇰꺼? 移섏닔 ??洹쇱쿂??寃껊쭔 蹂몃떎 ???꾨㈃ ?덉쓽 遺??遺?멸? ?욎씠吏 ?딅뒗??, () => {\\r\\n    const parsed = parseFrameElevations(\\r\\n      page([...fourLevels(), h('C51', 800, 200)]),\\r\\n    )\\r\\n    expect(parsed.elevations[0]?.levels[1].labels).toEqual(['3FL'])\\r\\n  })\\r\\n})\\r\\n\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"agent_message\",\"text\":\"현재 작업 트리에는 하네스 로그와 phase 인덱스의 기존 진행 기록이 이미 있어 이를 보존하겠습니다. 구현 전 기준선을 확인하고, 특히 기존 최근접 매칭과 짧은 치수 휴리스틱이 실제로 어디에 있는지 테스트 결과와 함께 대조하겠습니다.\"}}\r\n### C:\\Users\\emper\\mdtproject\\phases\\38-elevation-close\\step2-invoke.json\r\n{\r\n  \"step\": 2,\r\n  \"name\": \"label-level-order\",\r\n  \"exitCode\": 0,\r\n  \"timedOut\": false,\r\n  \"elapsed\": 701.7469458000269,\r\n  \"stdout_log\": \"phases\\\\38-elevation-close\\\\step2-codex.stdout.log\",\r\n  \"stderr_log\": \"phases\\\\38-elevation-close\\\\step2-codex.stderr.log\"\r\n### C:\\Users\\emper\\mdtproject\\phases\\38-elevation-close\\step2-report.json\r\n{\r\n  \"verdict\": \"completed\",\r\n  \"implementation\": {\r\n    \"rule\": \"창 안의 isLevelLabel 통과 라벨을 y 오름차순으로 훑고, 커서 이상에서 허용 범위에 드는 첫 레벨에 대응한다. 다음 레벨이 없을 때만 직전 레벨에 중첩한다.\",\r\n    \"removed\": [\r\n      \"nearestLevelIndex 최근접 대응\",\r\n      \"짧은 치수에서 두 라벨 중 하나를 다음 레벨로 미는 휴리스틱\"\r\n    ]\r\n### C:\\Users\\emper\\mdtproject\\phases\\38-elevation-close\\step2.md\r\n# Step 2: 레벨 라벨을 레벨과 **순서를 지켜** 대응시켜라\r\n\r\n## 배경\r\n\r\n지금은 라벨마다 독립적으로 최근접 레벨을 고른다(`nearestLevelIndex`). 라벨 문자는 레벨선\r\n**위쪽**에 놓이므로 도면마다 일정한 오프셋이 생기는데, 층 간격이 그 오프셋보다 좁으면\r\n최근접이 무너진다. tsu-p21 실측: 라벨은 전부 레벨선보다 8.3pt 위에 있고, `1FL`과 `設計GL`은\r\n150mm(=2.9pt) 차이라 **둘 다 같은 레벨**로 가고 그 아래 레벨은 빈다.\r\n\r\n오프셋 보정(라벨 오프셋의 중앙값을 빼는 방식)으로 풀지 **마라.** 실측 반례가 있다 —\r\nkaratsu-jikugumi1의 오프셋은 `RFL水上 −12.4 / 2FL −12.7 / 1FL −12.7 / GL +9.3`이라\r\n중앙값을 빼면 `GL`이 허용 범위 밖으로 밀려 라벨을 통째로 잃는다.\r\n\r\n대신 **순서**를 쓴다. 한 열의 레벨 라벨은 위에서 아래로 레벨과 같은 순서다.\r\n\r\n## 할 일 (테스트 먼저)\r\n\r\n1. 라벨 대응 규칙을 다음으로 바꿔라.\r\n   - 대상은 창 안에 있고 `isLevelLabel`을 통과하는 라벨뿐(step 1과 같다).\r\n   - 라벨을 y 오름차순으로 훑는다. 커서는 「아직 라벨이 붙지 않은 첫 레벨의 인덱스」이고 0에서 시작한다.\r\n   - 그 라벨에 대해 **커서 이상**의 레벨 중 `|레벨.positionPt − 라벨.y| <= LEVEL_TOLERANCE_PT`인\r\n     **첫** 레벨에 붙인다.\r\n   - 그런 레벨이 없고, **직전에 쓴 레벨**(커서−1)이 허용 범위 안이면 거기에 겹쳐 붙인다.\r\n     도면에 그 사이 치수가 없어 두 라벨이 같은 자리인 경우다 — yokohama p8의\r\n     `中央棟1FL`·`基準GL`(190mm 차)이 그것이고, **이 겹침은 유지돼야 한다.**\r\n   - 둘 다 아니면 그 라벨은 버린다.\r\n   - 붙였으면 커서를 `붙인 인덱스 + 1`로 올린다(내리지 않는다).\r\n2. 짧은 치수용 「두 라벨 중 하나를 아래 레벨로 미는」 휴리스틱(현행 ≈473-491, `labelsAtLevels[i].length !== 2`\r\n   조건으로 시작하는 블록)을 **삭제**하라. 위 규칙이 그 경우를 포함한다.\r\n3. 단위 테스트를 `src/lib/import/framing-plan/elevation.test.ts`에 합성 items로 더하라.\r\n   - ㉠ 라벨 넷이 모두 레벨선보다 일정하게 위에 있고 마지막 두 레벨이 좁을 때, 넷이 각각 다른 레벨에 붙는다.\r\n   - ㉡ 두 라벨 사이에 치수가 없으면(레벨이 하나면) 둘이 같은 레벨에 남는다.\r\n   두 테스트는 이 스텝 전 코드에서 각각 실패해야 한다(㉠은 실패, ㉡은 통과 — ㉡은 회귀 방지용이다).\r\n\r\n## 이 스텝을 끝냈을 때의 기대 출력 (Claude 실측)\r\n\r\n- tsu-p21 Y1·Y2 블록: 구간 `[600,3500,3500,150]`(1,170은 step 3에서 붙는다), 라벨\r\n  `[[\"パラペット天端\"],[\"RFL(水下)\"],[\"2FL\"],[\"1FL\"],[\"設計GL\",\"基礎下端\"]]`.\r\n- tsu-p21 Y3 블록: 구간 `[600,3500,3500,150,1170]`, 라벨은 6레벨 1:1\r\n  `[[\"パラペット天端\"],[\"RFL(水下)\"],[\"2FL\"],[\"1FL\"],[\"設計GL\"],[\"基礎下端\"]]`.\r\n- tsu-p22 두 블록: 라벨 `[[\"パラペット天端\"],[\"RFL(水下)\"],[\"2FL\"],[\"1FL\"],[\"設計GL\",\"基礎下端\"]]`.\r\n- **나머지 34면은 불변.** 특히 yokohama-p8·p9의 `[\"中央棟1FL\",\"基準GL\"]` 겹침과\r\n  karatsu-jikugumi1·2의 `GL` 라벨은 그대로여야 한다.\r\n\r\n기대와 다르면 **규칙을 흔들지 말고** `blocked`로 보고하라(어느 면·어느 레벨이 어떻게 다른지).\r\n\r\n## 하지 말 것\r\n\r\n- 오프셋(bias) 중앙값 보정, 도면별 분기, 새 상수 추가 금지. 쓰는 상수는 기존 `LEVEL_TOLERANCE_PT` 하나다.\r\n- 짧은 치수 허용(0.49)은 이 스텝에서 건드리지 마라 — step 3의 몫이다.\r\n- 골든·픽스처를 고치지 마라. `elevation.ts`와 그 단위 테스트 밖의 파일을 고치지 마라.\r\n- `scripts/execute.py`를 실행하지 마라. 하네스 프로세스를 죽이지 마라.\r\n\r\n## AC\r\n\r\n- `npx vitest run tests/plan-import src/lib/import/framing-plan tests/section-import` 통과.\r\n- 36면 스윕에서 **tsu-p21·tsu-p22 두 면만** 변한다. 다른 면이 변하면 `blocked`.\r\n- 위 기대 출력 그대로. `step2-report.json`에 세 면의 라벨 배열을 그대로 적어라.\r\n- `npm run lint`·`npx tsc --noEmit` 통과.\r\n--- step1 report full ---\r\n{\r\n  \"sweep\": {\r\n    \"pages\": 36,\r\n    \"differentPages\": 0,\r\n    \"command\": \"HEAD:src/lib/import/framing-plan/elevation.ts와 작업 트리의 parseFrameElevations를 각각 로드해 tests/fixtures/section-import/textitems 36면의 JSON.stringify 결과를 비교\"\r\n  },\r\n  \"removed\": [\r\n    \"labelColumns\",\r\n    \"selectLabelColumn\",\r\n    \"LABEL_COLUMN_GAP_PT\",\r\n    \"x 방향 라벨 열 군집 선택·재배치\"\r\n  ],\r\n  \"tests\": \"npx vitest run tests/plan-import src/lib/import/framing-plan: 8 files, 133 tests passed; npm run lint: 0 errors, 1 existing warning; npx tsc --noEmit: passed; rg forbidden symbols: 0 matches\"\r\n}\r\n","exit_code":0,"status":"completed"}}
