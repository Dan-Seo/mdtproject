{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Raw -Encoding UTF8 tests/plan-import/corpus2-elevation.test.ts; Get-Content -Raw -Encoding UTF8 tests/plan-import/key-coverage.test.ts; Get-Content -Encoding UTF8 src/lib/import/framing-plan/elevation.ts | Select-Object -First 120'","aggregated_output":"import { readdirSync, readFileSync } from 'node:fs'\nimport { resolve } from 'node:path'\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\r\nimport { compact } from '@/lib/import/runs'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\n  items: TextPage['items']\n}\n\ntype AxisFixture = {\n  labels: string[]\n  spansMm: number[]\n  totalMm: number | null\n}\n\ntype ElevationEntryFixture = {\n  title?: string\n  titles?: string[]\n  levels?: string[]\n  heightsMm?: number[]\n  levelsBottom?: string[]\n  heightsBottomMm?: number[]\n  axis?: AxisFixture\n}\n\ntype ElevationFixture = {\n  heightsMm?: number[]\n  levels?: string[]\n  levelTexts?: string[]\n  elevations: ElevationEntryFixture[]\n}\n\ntype GridFixture = {\n  blocks: Array<{\n    x: AxisFixture\n    y: AxisFixture\n  }>\n}\n\nconst GOLDEN_DIR = resolve(\n  process.cwd(),\n  'tests/fixtures/plan-import/expected',\n)\n\nfunction goldenFiles(suffix: '-elevation.json' | '-grid.json'): string[] {\n  return readdirSync(GOLDEN_DIR, { withFileTypes: true })\n    .filter((entry) => entry.isFile() && entry.name.endsWith(suffix))\n    .map((entry) => entry.name)\n    .sort()\n}\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readGolden(file: string): ElevationFixture {\n  return JSON.parse(\n    readFileSync(\n      resolve(GOLDEN_DIR, file),\n      'utf8',\n    ),\n  ) as ElevationFixture\n}\n\nfunction readGridGolden(file: string): GridFixture {\n  return JSON.parse(\n    readFileSync(resolve(GOLDEN_DIR, file), 'utf8'),\n  ) as GridFixture\n}\n\nfunction expectAxisSelfConsistent(axis: AxisFixture): void {\n  expect(axis.labels.length).toBe(axis.spansMm.length + 1)\n  if (axis.totalMm !== null) {\n    expect(axis.spansMm.reduce((sum, span) => sum + span, 0)).toBe(\n      axis.totalMm,\n    )\n  }\n}\n\nfunction orientedAxis(\n  axis: AxisFixture,\n  reverse: boolean,\n): AxisFixture {\n  return reverse\n    ? {\n        labels: [...axis.labels].reverse(),\n        spansMm: [...axis.spansMm].reverse(),\n        totalMm: axis.totalMm,\n      }\n    : axis\n}\n\nfunction axisIsOrderedSubsequence(\n  elevation: AxisFixture,\n  grid: AxisFixture,\n): boolean {\n  for (const reverse of [false, true]) {\n    const candidate = orientedAxis(grid, reverse)\n    let previousGridIndex = -1\n    let matches = true\n\n    for (const [elevationLabelIndex, label] of elevation.labels.entries()) {\n      const gridIndex = candidate.labels.indexOf(label)\n      if (gridIndex <= previousGridIndex) {\n        matches = false\n        break\n      }\n\n      if (elevationLabelIndex > 0) {\n        const gridSpan = candidate.spansMm\n          .slice(previousGridIndex, gridIndex)\n          .reduce((sum, span) => sum + span, 0)\n        if (elevation.spansMm[elevationLabelIndex - 1] !== gridSpan) {\n          matches = false\n          break\n        }\n      }\n\n      previousGridIndex = gridIndex\n    }\n\n    if (matches) return true\n  }\n\n  return false\n}\n\nconst AXIS_CROSSCHECKS = [\n  {\n    elevationFile: 'hirosaki-kikyono-p25-elevation.json',\n    gridFile: 'hirosaki-kikyono-p21-grid.json',\n    axis: 'y',\n  },\n  {\n    elevationFile: 'tsu-kanritou-p21-elevation.json',\n    gridFile: 'tsu-kanritou-p16-grid.json',\n    axis: 'x',\n  },\n  {\n    elevationFile: 'karatsu-jikugumi1-p1-elevation.json',\n    gridFile: 'karatsu-fukuzu-p1-grid.json',\n    axis: 'y',\n  },\n] as const\n\r\nfunction elevationForTitle(\r\n  parsed: ReturnType<typeof parseFrameElevations>,\r\n  title: string,\r\n): ReturnType<typeof parseFrameElevations>['elevations'][number] {\r\n  const normalized = compact(title)\r\n  const expectedTitle = normalized.includes('軸組図')\r\n    ? normalized\r\n    : `${normalized}軸組図`\r\n  const matches = parsed.elevations.filter((elevation) =>\r\n    elevation.titles.some(\r\n      (candidateTitle) =>\r\n        candidateTitle === expectedTitle ||\r\n        candidateTitle.startsWith(`${expectedTitle}S=`),\r\n    ),\r\n  )\r\n  expect(matches).toEqual([expect.anything()])\r\n  return matches[0]!\r\n}\r\n\r\nfunction labelsByLevel(\r\n  elevation: ReturnType<typeof parseFrameElevations>['elevations'][number],\r\n): string[][] {\r\n  return elevation.levels.map((level) => level.labels)\r\n}\r\n\r\nfunction titlesOf(\r\n  expected: ElevationFixture['elevations'][number],\r\n): string[] {\r\n  return (\r\n    expected.titles ??\r\n    (expected.title === undefined ? [] : [expected.title])\r\n  )\r\n}\r\n\r\nfunction expectCorpus2Elevations(\r\n  pageFile: string,\r\n  goldenFile: string,\r\n): ReturnType<typeof parseFrameElevations>['elevations'][] {\r\n  const golden = readGolden(goldenFile)\r\n  const parsed = parseFrameElevations(readPage(pageFile))\r\n\r\n  expect(parsed.issues).toEqual([])\r\n  const actualsByExpected = golden.elevations.map((expected) => {\r\n    const titles = titlesOf(expected)\r\n    expect(titles).not.toEqual([])\r\n    return titles.map((title) => elevationForTitle(parsed, title))\r\n  })\r\n  const actuals = actualsByExpected.flat()\r\n\r\n  // 모든 파서 계열은 골든 항목에서 청구되어야 한다. 골든 여러 항목이\r\n  // 하나의 계열을 공유하는 경우(예: karatsu X3·X4)도 허용하되,\r\n  // 파서만의 미청구 계열은 허용하지 않는다.\r\n  expect(new Set(parsed.elevations)).toEqual(new Set(actuals))\r\n\r\n  for (const [index, expected] of golden.elevations.entries()) {\r\n    const expectedActuals = actualsByExpected[index]!\r\n    expect(new Set(expectedActuals)).toEqual(new Set([expectedActuals[0]]))\r\n\r\n    const actual = expectedActuals[0]!\r\n    const expectedHeights = expected.heightsMm ?? golden.heightsMm\r\n    const expectedLabels = expected.levels ?? golden.levelTexts\r\n    expect(expectedHeights).toBeDefined()\r\n    expect(expectedLabels).toBeDefined()\r\n    expect(actual.heightsMm).toEqual(expectedHeights)\r\n    expect(labelsByLevel(actual)).toEqual(\r\n      expectedLabels!.map((label) => [label]),\r\n    )\r\n  }\r\n\r\n  return actualsByExpected\r\n}\r\n\r\ndescribe('階高 corpus 2 골든', () => {\n  it('karatsu: 골든의 모든 제목 항목을 대응 계열의 높이·레벨 라벨과 대조한다', () => {\r\n    const actualsByExpected = expectCorpus2Elevations(\r\n      'karatsu-jikugumi1-p1.json',\r\n      'karatsu-jikugumi1-p1-elevation.json',\r\n    )\r\n\r\n    // 골든의 X3·X4 항목은 도면의 같은 치수 열을 공유하므로 하나의\r\n    // 파서 계열로 묶여야 한다. 이 관계를 골든 순서에서 직접 검증한다.\r\n    expect(actualsByExpected[1]?.[0]).toBe(actualsByExpected[2]?.[0])\r\n  })\r\n\r\n  it('tsu: p21의 모든 제목 계열을 전체 골든 높이·레벨 라벨과 대조한다', () => {\r\n    expectCorpus2Elevations(\r\n      'tsu-p21.json',\r\n      'tsu-kanritou-p21-elevation.json',\r\n    )\r\n  })\r\n\r\n  it('tsu: p22의 모든 제목 계열을 전체 골든 높이·레벨 라벨과 대조한다', () => {\r\n    expectCorpus2Elevations(\r\n      'tsu-p22.json',\r\n      'tsu-kanritou-p22-elevation.json',\r\n    )\r\n  })\r\n\r\n  it('hirosaki: 골든의 모든 제목 계열을 높이·레벨 라벨과 대조한다', () => {\n    expectCorpus2Elevations(\n      'hirosaki-p25.json',\n      'hirosaki-kikyono-p25-elevation.json',\n    )\n  })\n\n  it('levels가 있으면 levelTexts와 순서·접두사 관계를 대조한다', () => {\n    let checked = 0\n\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      if (golden.levels === undefined) continue\n\n      expect(golden.levelTexts).toBeDefined()\n      expect(golden.levels).toHaveLength(golden.levelTexts!.length)\n      golden.levels.forEach((level, index) => {\n        expect(golden.levelTexts![index]!.startsWith(level)).toBe(true)\n      })\n      checked += 1\n    }\n\n    expect(checked).toBeGreaterThan(0)\n  })\n})\n\ndescribe('軸組図·伏図 axis 골든 상호검증', () => {\n  it('모든 골든의 axis가 라벨·스팬·합계에 대해 자기 정합성을 갖는다', () => {\n    let axisCount = 0\n\n    for (const file of goldenFiles('-grid.json')) {\n      const golden = readGridGolden(file)\n      for (const block of golden.blocks) {\n        for (const axis of [block.x, block.y]) {\n          expectAxisSelfConsistent(axis)\n          axisCount += 1\n        }\n      }\n    }\n\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      for (const elevation of golden.elevations) {\n        if (elevation.axis === undefined) continue\n        expectAxisSelfConsistent(elevation.axis)\n        axisCount += 1\n      }\n    }\n\n    expect(axisCount).toBeGreaterThan(0)\n  })\n\n  it('levelsBottom·heightsBottomMm이 있으면 전체 계열의 꼬리와 일치한다', () => {\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      for (const elevation of golden.elevations) {\n        if (elevation.levelsBottom !== undefined) {\n          expect(elevation.levels).toBeDefined()\n          if (elevation.levels !== undefined) {\n            expect(elevation.levelsBottom).toEqual(\n              elevation.levels.slice(\n                elevation.levels.length - elevation.levelsBottom.length,\n              ),\n            )\n          }\n        }\n\n        if (elevation.heightsBottomMm !== undefined) {\n          expect(elevation.heightsMm).toBeDefined()\n          if (elevation.heightsMm !== undefined) {\n            expect(elevation.heightsBottomMm).toEqual(\n              elevation.heightsMm.slice(\n                elevation.heightsMm.length -\n                  elevation.heightsBottomMm.length,\n              ),\n            )\n          }\n        }\n      }\n    }\n  })\n\n  it.each(AXIS_CROSSCHECKS)(\n    '$elevationFile의 axis가 $gridFile의 $axis 축 부분열이다',\n    ({ elevationFile, gridFile, axis }) => {\n      const elevationGolden = readGolden(elevationFile)\n      const gridGolden = readGridGolden(gridFile)\n      const gridAxis = gridGolden.blocks[0]?.[axis]\n      expect(gridAxis).toBeDefined()\n      if (gridAxis === undefined) return\n\n      for (const elevation of elevationGolden.elevations) {\n        if (elevation.axis === undefined) continue\n        expect(\n          axisIsOrderedSubsequence(elevation.axis, gridAxis),\n        ).toBe(true)\n      }\n    },\n  )\n\n  it('axis 없는 elevation 항목은 건너뛰되 그 수가 3개로 고정된다', () => {\n    let skippedAxisCount = 0\n\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      for (const elevation of golden.elevations) {\n        if (elevation.axis === undefined) skippedAxisCount += 1\n      }\n    }\n\n    expect(skippedAxisCount).toBe(3)\n  })\n})\n\r\nimport { readdirSync, readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\ntype JsonValue =\r\n  | null\r\n  | boolean\r\n  | number\r\n  | string\r\n  | JsonValue[]\r\n  | { [key: string]: JsonValue }\r\n\r\ntype ClaimedPath = {\r\n  path: string\r\n  test: string\r\n}\r\n\r\ntype ReferenceOnlyPath = {\r\n  path: string\r\n  reason: string\r\n}\r\n\r\nconst GOLDEN_DIR = resolve(\r\n  process.cwd(),\r\n  'tests/fixtures/plan-import/expected',\r\n)\r\n\r\n/**\r\n * 골든의 값 필드와 이를 실제로 대조하는 테스트를 함께 선언한다.\r\n * 배열 원소는 인덱스가 아니라 `[]`로 표기한다.\r\n */\r\nconst CLAIMED: readonly ClaimedPath[] = [\r\n  {\r\n    path: 'blocks[].x.labels[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].x.spansMm[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].x.totalMm',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].y.labels[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].y.spansMm[]',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'blocks[].y.totalMm',\r\n    test: 'tests/plan-import/corpus2.test.ts > 2차 7면 伏図 격자 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].axis.labels[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > axis 골든 상호검증',\r\n  },\r\n  {\r\n    path: 'elevations[].axis.spansMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > axis 골든 상호검증',\r\n  },\r\n  {\r\n    path: 'elevations[].axis.totalMm',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > axis 골든 상호검증',\r\n  },\r\n  {\r\n    path: 'elevations[].heightsBottomMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > levelsBottom·heightsBottomMm 꼬리 대조',\r\n  },\r\n  {\r\n    path: 'elevations[].heightsMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].levelsBottom[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > levelsBottom·heightsBottomMm 꼬리 대조',\r\n  },\r\n  {\r\n    path: 'elevations[].levels[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].title',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'elevations[].titles[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\r\n    path: 'heightsMm[]',\r\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\r\n  },\r\n  {\n    path: 'levelTexts[]',\n    test: 'tests/plan-import/corpus2-elevation.test.ts > 階高 corpus 2 골든',\n  },\n  {\n    path: 'levels[]',\n    test: 'tests/plan-import/corpus2-elevation.test.ts > levels·levelTexts 관계 대조',\n  },\n]\n\r\nconst REFERENCE_ONLY: readonly ReferenceOnlyPath[] = [\r\n  {\r\n    path: '$comment',\r\n    reason: '독립 전사 방법과 변경 경위를 설명하는 주석이다.',\r\n  },\r\n  {\r\n    path: 'blocks[].notes[]',\r\n    reason: '블록별 판독 주석이며 파서 값의 기대값이 아니다.',\r\n  },\r\n  {\r\n    path: 'blocks[].title',\r\n    reason:\r\n      '7개 grid 골든의 8개 title 중 도면 문자열 5건(예: 屋根伏図)과 전사자 주석 3건(예: 伏図(공통))이 섞여 있어 균일한 기대값으로 전체 대조할 수 없는 블록 설명 메타데이터다.',\r\n  },\r\n  {\r\n    path: 'elevations[].levelsBottomNote',\r\n    reason: '부분 전사 꼬리의 경위를 설명하는 주석이다.',\r\n  },\r\n  {\r\n    path: 'elevations[].note',\r\n    reason: '특정 계열의 원문 대조 메모이며 산출 기대값이 아니다.',\r\n  },\r\n  {\r\n    path: 'levelNote',\r\n    reason: '페이지 전체 레벨 전사의 주석이다.',\r\n  },\r\n  {\r\n    path: 'notes[]',\r\n    reason: '도면 판독 한계와 범위를 설명하는 주석이다.',\r\n  },\r\n  {\r\n    path: 'source.cacheFile',\r\n    reason: '원본 캐시 파일 식별자이며 파서 출력값이 아니다.',\r\n  },\r\n  {\r\n    path: 'source.issuer',\r\n    reason: '도면 발주처 메타데이터다.',\r\n  },\r\n  {\r\n    path: 'source.page',\r\n    reason: '원본 도면의 쪽 메타데이터다.',\r\n  },\r\n  {\r\n    path: 'source.project',\r\n    reason: '원본 프로젝트명 메타데이터다.',\r\n  },\r\n  {\r\n    path: 'source.sha256',\r\n    reason: '원본 무결성 확인용 해시다.',\r\n  },\r\n  {\r\n    path: 'source.sheet',\r\n    reason: '원본 도면명 메타데이터다.',\r\n  },\r\n  {\r\n    path: 'source.transcribedAt',\r\n    reason: '독립 전사 일자 메타데이터다.',\r\n  },\r\n]\r\n\r\nfunction addValuePath(\r\n  paths: Map<string, Set<string>>,\r\n  valuePath: string,\r\n  file: string,\r\n): void {\r\n  const files = paths.get(valuePath) ?? new Set<string>()\r\n  files.add(file)\r\n  paths.set(valuePath, files)\r\n}\r\n\r\nfunction collectValuePaths(\r\n  value: JsonValue,\r\n  currentPath: string,\r\n  file: string,\r\n  paths: Map<string, Set<string>>,\r\n): void {\r\n  if (Array.isArray(value)) {\r\n    const arrayPath = `${currentPath}[]`\r\n    if (value.length === 0) {\r\n      addValuePath(paths, arrayPath, file)\r\n      return\r\n    }\r\n\r\n    for (const item of value) {\r\n      if (item !== null && typeof item === 'object') {\r\n        collectValuePaths(item, arrayPath, file, paths)\r\n      } else {\r\n        addValuePath(paths, arrayPath, file)\r\n      }\r\n    }\r\n    return\r\n  }\r\n\r\n  if (value !== null && typeof value === 'object') {\r\n    for (const [key, child] of Object.entries(value)) {\r\n      const childPath = currentPath ? `${currentPath}.${key}` : key\r\n      if (child !== null && typeof child === 'object') {\r\n        collectValuePaths(child, childPath, file, paths)\r\n      } else {\r\n        addValuePath(paths, childPath, file)\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\nfunction goldenValuePaths(): Map<string, Set<string>> {\r\n  const paths = new Map<string, Set<string>>()\r\n  const files = readdirSync(GOLDEN_DIR, { withFileTypes: true })\r\n    .filter((entry) => entry.isFile() && entry.name.endsWith('.json'))\r\n    .map((entry) => entry.name)\r\n    .sort()\r\n\r\n  for (const file of files) {\r\n    const golden = JSON.parse(\r\n      readFileSync(resolve(GOLDEN_DIR, file), 'utf8'),\r\n    ) as JsonValue\r\n    collectValuePaths(golden, '', file, paths)\r\n  }\r\n\r\n  return paths\r\n}\r\n\r\nfunction listedPaths(entries: ReadonlyArray<{ path: string }>): Set<string> {\r\n  return new Set(entries.map((entry) => entry.path))\r\n}\r\n\r\ndescribe('plan-import 골든 값 키 커버리지', () => {\r\n  it('골든의 모든 값 경로가 대조 또는 명시적 참고 전용으로 등록된다', () => {\r\n    const actual = goldenValuePaths()\r\n    const claimed = listedPaths(CLAIMED)\r\n    const referenceOnly = listedPaths(REFERENCE_ONLY)\r\n    const covered = new Set([...claimed, ...referenceOnly])\r\n\r\n    const unclaimed = [...actual.entries()]\r\n      .filter(([path]) => !covered.has(path))\r\n      .map(([path, files]) => ({ path, files: [...files].sort() }))\r\n    expect(\r\n      unclaimed,\r\n      [\r\n        'unclaimed value paths: make an explicit claim or report the field as blocked',\r\n        ...unclaimed.map(({ path, files }) => `${path}: ${files.join(', ')}`),\r\n      ].join('\\n'),\r\n    ).toEqual([])\r\n  })\r\n\r\n  it('등록한 경로는 실제 골든에 존재하고 두 목록이 겹치지 않는다', () => {\r\n    const actual = goldenValuePaths()\r\n    const claimed = listedPaths(CLAIMED)\r\n    const referenceOnly = listedPaths(REFERENCE_ONLY)\r\n    const stale = [...new Set([...claimed, ...referenceOnly])]\r\n      .filter((path) => !actual.has(path))\r\n      .sort()\r\n\r\n    expect(\r\n      stale,\r\n      'CLAIMED/REFERENCE_ONLY contains a path absent from the golden',\r\n    ).toEqual([])\r\n    expect(\r\n      new Set([...claimed].filter((path) => referenceOnly.has(path))),\r\n      'a path cannot be both CLAIMED and REFERENCE_ONLY',\r\n    ).toEqual(new Set())\r\n  })\r\n})\r\n\r\nexport { CLAIMED, REFERENCE_ONLY }\r\n\r\nimport { recoverRows, verticalRuns } from '../runs' * 짧은 치수의 텍스트는 자기 구간이 좁아 중점에서 밀릴 수 있다. 이 허용비는\r\n * 그 밀림이 기대 간격 자체를 넘지 않는지 판정한다 — 짧은 치수 공통 규칙이다.\r\n * 코퍼스에서 실제로 짧은 치수 분기가 발동한 값은 tsu 150mm(편차 0.176)와\r\n * tsu 1170mm(편차 0.4879/0.4906)이고, 탈락시키는 경쟁 꼬리 후보는 hirosaki의\r\n * 30mm(편차 4.33〜5.33)다. `phases/38-elevation-close/step3-report.json`의\r\n * `counterexamples.ratio_0_45`에서 0.45는 실패했고, `corpus_sweep.comparison`과\r\n * `corpus_sweep.changed_pages`에서 0.49는 tsu-p21·p22의 결과를 바꿨으며,\r\n * `implementation.constant`에서 채택값 1.0을 확인했다. `counterexamples.ratio_5_0`\r\n * 에서는 5.0의 최종 출력이 1.0과 같았다.\r\n */\r\nconst SHORT_DIMENSION_SCALE_TOLERANCE_RATIO = 1.0\r\n/**\r\n * 계열이 되려면 치수가 이만큼 있어야 한다.\r\n *\r\n * **둘로는 반증이 안 된다.** 치수 두 개는 축척을 하나 유도하는데, 유도한 값이\r\n * 자기 자신과 어긋날 수는 없으므로 축척 일관성 검사가 공회전한다. 그러면 남는\r\n * 증거는 라벨 일치뿐인데, 글자가 빽빽한 도면에서는 그것이 **우연히** 맞는다 —\r\n * 실물 kani p40에서 위·아래 두 軸組図의 같은 치수(5,535 둘, 75 둘)가 한 열로\r\n * 이어져 축척이 3배·220배로 나왔는데도 계산된 레벨 자리에 마침 글자가 있어\r\n * 두 번 다 통과했다.\r\n *\r\n * 셋이면 축척이 둘 유도되어 서로를 반증할 수 있고, 그 검사가 위 두 경우를\r\n * 모두 잡는다. 대가로 치수가 둘뿐인 軸組図(3레벨)는 읽지 않는다 — 지어내는\r\n * 것보다 낫다 (R10).\r\n */\r\nconst MINIMUM_CHAIN_DIMENSIONS = 3\r\n\r\ninterface Token {\r\n  text: string\r\n  x: number\r\n  y: number\r\n  leftX: number\r\n  rightX: number\r\n}\r\n\r\ninterface DimensionToken extends Token {\r\n  valueMm: number\r\n}\r\n\r\nfunction tokens(page: TextPage): Token[] {\r\n  const collected: Token[] = []\r\n  for (const row of recoverRows(page.items)) {\r\n    for (const segment of row.segments) {\r\n      collected.push({\r\n        text: segment.compact,\r\n        x: segment.centerX,\r\n        y: segment.centerY,\r\n        leftX: segment.x,\r\n        rightX: segment.endX,\r\n      })\r\n    }\r\n  }\r\n  for (const run of verticalRuns(page.items)) {\r\n    collected.push({\r\n      text: run.text,\r\n      x: run.x,\r\n      y: run.y,\r\n      leftX: run.x,\r\n      rightX: run.x,\r\n    })\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Raw -Encoding UTF8 tests/fixtures/plan-import/expected/tsu-kanritou-p22-elevation.json; Get-Content -Raw -Encoding UTF8 phases/39-axis-claim/step0-report.json; Get-Content -Encoding UTF8 tests/fixtures/section-import/SOURCES.md | Select-Object -Last 35; Test-Path -PathType Leaf .cache/dwg-tsu-kanritou.pdf; Get-Content -Encoding UTF8 docs/ADR.md | Select-Object -Skip 535 -First 45'","aggregated_output":"{\r\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 300dpi 크롭(clip x80-420 y100-330)과 표제란 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 階高는 위→아래 인접 레벨 사이 mm다. 이 면은 레벨 계열만 전사했다 — 通り芯 스팬은 전사하지 않았다.\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-tsu-kanritou.pdf\",\r\n    \"sha256\": \"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\",\r\n    \"issuer\": \"三重県津市\",\r\n    \"project\": \"旧津市民プール跡地テニスコート整備工事 管理棟\",\r\n    \"sheet\": \"S-22 軸組図(2)\",\r\n    \"page\": 22,\r\n    \"transcribedAt\": \"2026-09-04\"\r\n  },\r\n  \"notes\": [\r\n    \"S-21(軸組図(1))과 같은 레벨 계열이다 — 600·3,500·3,500·150·1,170\",\r\n    \"7,750은 パラペット天端→設計GL의 合計이고 스팬이 아니다\",\r\n    \"같은 열 오른쪽에 보조 레벨이 있다: 1SL·基礎梁天端·B.PL下端(1FL 아래 20〜250). 用紙 A1 1/100\"\r\n  ],\r\n  \"elevations\": [\r\n    {\r\n      \"titles\": [\r\n        \"X1通り軸組図 S=1/100\",\r\n        \"X2通り軸組図 S=1/100\",\r\n        \"X3通り軸組図 S=1/100\"\r\n      ],\r\n      \"levels\": [\r\n        \"パラペット天端\",\r\n        \"RFL(水下)\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        600,\r\n        3500,\r\n        3500,\r\n        150,\r\n        1170\r\n      ]\r\n    },\r\n    {\r\n      \"titles\": [\r\n        \"X4通り軸組図 S=1/100\",\r\n        \"X5通り軸組図 S=1/100\"\r\n      ],\r\n      \"levels\": [\r\n        \"パラペット天端\",\r\n        \"RFL(水下)\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        600,\r\n        3500,\r\n        3500,\r\n        150,\r\n        1170\r\n      ]\r\n    }\r\n  ]\r\n}\r\n\r\n{\n  \"step\": 0,\n  \"name\": \"refute-transcription-fix\",\n  \"verdict\": \"not_refuted\",\n  \"claims\": [\n    {\n      \"id\": \"A1\",\n      \"holds\": true,\n      \"method\": \"PyMuPDF 1.28.0의 get_text('rawdict')로 .cache/dwg-tsu-kanritou.pdf 0-based page 20을 읽고, span의 전각 라벨을 NFKC로 정규화해 좌표 중심을 기록했다. page rotation은 90이고 라벨 span의 dir은 (0,-1)이다.\",\n      \"evidence\": {\n        \"pageIndex\": 20,\n        \"rotation\": 90,\n        \"sourceLabelForm\": \"Ｘ１〜Ｘ５\",\n        \"axisBlocks\": 3,\n        \"labelsByBlock\": {\n          \"Y1通り軸組図\": [\n            { \"label\": \"X1\", \"x\": 471.41, \"y\": 1231.26 },\n            { \"label\": \"X2\", \"x\": 471.41, \"y\": 1116.72 },\n            { \"label\": \"X3\", \"x\": 471.41, \"y\": 1015.86 },\n            { \"label\": \"X4\", \"x\": 471.41, \"y\": 875.34 },\n            { \"label\": \"X5\", \"x\": 471.41, \"y\": 800.58 }\n          ],\n          \"Y2通り軸組図\": [\n            { \"label\": \"X1\", \"x\": 471.41, \"y\": 601.98 },\n            { \"label\": \"X2\", \"x\": 471.41, \"y\": 487.44 },\n            { \"label\": \"X3\", \"x\": 471.41, \"y\": 386.58 },\n            { \"label\": \"X4\", \"x\": 471.41, \"y\": 246.06 },\n            { \"label\": \"X5\", \"x\": 471.41, \"y\": 171.18 }\n          ],\n          \"Y3通り軸組図\": [\n            { \"label\": \"X1\", \"x\": 952.43, \"y\": 1231.26 },\n            { \"label\": \"X2\", \"x\": 952.43, \"y\": 1116.72 },\n            { \"label\": \"X3\", \"x\": 952.43, \"y\": 1015.86 },\n            { \"label\": \"X4\", \"x\": 952.43, \"y\": 875.34 },\n            { \"label\": \"X5\", \"x\": 952.43, \"y\": 800.58 }\n          ]\n        },\n        \"counts\": [5, 5, 5]\n      }\n    },\n    {\n      \"id\": \"A2\",\n      \"holds\": true,\n      \"method\": \"같은 tsu PDF page 20의 rawdict span에서 치수 문자열을 원문 그대로 수집하고, 회전 방향에 맞춰 각 블록의 인접 라벨 사이 순서로 대조했다.\",\n      \"evidence\": {\n        \"spansMm\": [5850, 5150, 7175, 3825],\n        \"totalMm\": 22000,\n        \"spanSumMm\": 22000,\n        \"observedSpanTexts\": [\"5,850\", \"5,150\", \"7,175\", \"3,825\"],\n        \"observedTotalText\": \"22,000\",\n        \"occurrences\": {\n          \"Y1通り軸組図\": { \"spans\": 4, \"total\": 1 },\n          \"Y2通り軸組図\": { \"spans\": 4, \"total\": 1 },\n          \"Y3通り軸組図\": { \"spans\": 4, \"total\": 1 }\n        }\n      }\n    },\n    {\n      \"id\": \"A3\",\n      \"holds\": true,\n      \"method\": \"수정 전은 git show bd5ae60^:tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json으로 읽고, 수정 후는 현재 골든을 JSON으로 읽었다. 이어 expected 아래 모든 JSON의 elevations[].axis와 blocks[].x/blocks[].y를 순회해 labels.length === spansMm.length + 1을 계수했다.\",\n      \"evidence\": {\n        \"before\": {\n          \"source\": \"git show bd5ae60^:tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json\",\n          \"labels\": [\"X1\", \"X2\", \"X3\", \"X4\"],\n          \"spansMm\": [5850, 5150, 7175, 3825],\n          \"labelCount\": 4,\n          \"spanCount\": 4,\n          \"violations\": 1\n        },\n        \"afterTsu\": {\n          \"labels\": [\"X1\", \"X2\", \"X3\", \"X4\", \"X5\"],\n          \"spansMm\": [5850, 5150, 7175, 3825],\n          \"labelCount\": 5,\n          \"spanCount\": 4,\n          \"violations\": 0\n        },\n        \"allCurrentGoldens\": {\n          \"filesChecked\": 10,\n          \"axisBlocksChecked\": 23,\n          \"violations\": 0\n        }\n      }\n    },\n    {\n      \"id\": \"A4\",\n      \"holds\": true,\n      \"method\": \"파서 출력이 아니라 두 원본 PDF의 rawdict 텍스트를 공간 밴드별로 읽어 축 라벨·인접 치수·합계를 독립 전사하고, 대응 골든 JSON과 배열을 직접 비교했다.\",\n      \"evidence\": {\n        \"karatsu\": {\n          \"pdf\": \".cache/dwg-karatsu-jikugumi1.pdf\",\n          \"pageIndex\": 0,\n          \"rotation\": 90,\n          \"golden\": \"tests/fixtures/plan-import/expected/karatsu-jikugumi1-p1-elevation.json\",\n          \"blocks\": [\n            {\n              \"title\": \"X2通り\",\n              \"labels\": [\"Y0\", \"Y1\", \"Y2\", \"Y3\"],\n              \"spansMm\": [1900, 2265, 6000],\n              \"totalMm\": null,\n              \"matchesGolden\": true\n            },\n            {\n              \"title\": \"X3通り\",\n              \"labels\": [\"Y0\", \"Y1\", \"Y2\", \"Y3\", \"Y6\"],\n              \"spansMm\": [1900, 2265, 6000, 8079],\n              \"totalMm\": null,\n              \"matchesGolden\": true\n            },\n            {\n              \"title\": \"X4通り\",\n              \"labels\": [\"Y0\", \"Y1\", \"Y2\", \"Y3\", \"Y5\"],\n              \"spansMm\": [1900, 2265, 6000, 5875],\n              \"totalMm\": null,\n              \"matchesGolden\": true\n            }\n          ]\n        },\n        \"hirosaki\": {\n          \"pdf\": \".cache/dwg-hirosaki-kikyono.pdf\",\n          \"pageIndex\": 24,\n          \"rotation\": 0,\n          \"golden\": \"tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json\",\n          \"blocks\": [\n            {\n              \"title\": \"X1通り\",\n              \"labels\": [\"Y1\", \"Y2\", \"Y3\", \"Y4\", \"Y5\", \"Y6\", \"Y7\"],\n              \"spansMm\": [8000, 8000, 8000, 8000, 8000, 11000],\n              \"totalMm\": 51000,\n              \"matchesGolden\": true\n            },\n            {\n              \"title\": \"X2通り\",\n              \"labels\": [\"Y1\", \"Y2\", \"Y3\", \"Y4\", \"Y5\", \"Y6\", \"Y7\", \"Y8\", \"Y9\", \"Y10\"],\n              \"spansMm\": [8000, 8000, 8000, 8000, 8000, 11000, 8000, 8000, 8000],\n              \"totalMm\": 75000,\n              \"matchesGolden\": true\n            },\n            {\n              \"title\": \"X3通り\",\n              \"labels\": [\"Y1\", \"Y2\", \"Y3\", \"Y4\", \"Y5\", \"Y6\", \"Y7\", \"Y8\", \"Y9\", \"Y10\"],\n              \"spansMm\": [8000, 8000, 8000, 8000, 8000, 11000, 8000, 8000, 8000],\n              \"totalMm\": 75000,\n              \"matchesGolden\": true\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"A5\",\n      \"holds\": true,\n      \"method\": \"레포 루트에서 find 명령을 각각 실행하고 원문 stdout·stderr·exit code를 기록했다.\",\n      \"evidence\": {\n        \"commands\": [\n          {\n            \"command\": \"find tests -name \\\"karatsu-jikugumi1-p38.json\\\"\",\n            \"stdout\": \"\",\n            \"stderr\": \"\",\n            \"exitCode\": 0\n          },\n          {\n            \"command\": \"find tests -name \\\"hirosaki-jikugumi-p15.json\\\"\",\n            \"stdout\": \"\",\n            \"stderr\": \"\",\n            \"exitCode\": 0\n          },\n          {\n            \"command\": \"find tests -name \\\"tsu-jikugumi-p21.json\\\"\",\n            \"stdout\": \"\",\n            \"stderr\": \"\",\n            \"exitCode\": 0\n          }\n        ]\n      }\n    }\n  ],\n  \"paths_verified\": [\n    { \"path\": \".cache/dwg-tsu-kanritou.pdf\", \"exists\": true },\n    { \"path\": \".cache/dwg-karatsu-jikugumi1.pdf\", \"exists\": true },\n    { \"path\": \".cache/dwg-hirosaki-kikyono.pdf\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/fuji-kanritou-p17-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/hirosaki-kikyono-p21-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/ina-pump-p6-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/karatsu-fukuzu-p1-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/karatsu-hashirashin-p1-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/karatsu-jikugumi1-p1-elevation.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/shibata-fire-p1-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/tsu-kanritou-p16-grid.json\", \"exists\": true },\n    { \"path\": \"tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json\", \"exists\": true }\n  ],\n  \"paths_expected_absent\": [\n    { \"path\": \"tests/fixtures/plan-import/expected/karatsu-jikugumi1-p38.json\", \"exists\": false },\n    { \"path\": \"tests/fixtures/plan-import/expected/hirosaki-jikugumi-p15.json\", \"exists\": false },\n    { \"path\": \"tests/fixtures/plan-import/expected/tsu-jikugumi-p21.json\", \"exists\": false }\n  ],\n  \"summary\": \"A1~A5 독립 재현이 모두 성립했다. tsu 21면은 세 軸組図 블록 모두 X1~X5를 가지며, 수정 전 1건이던 labels/spans 불변식 위반이 수정 후 전체 23개 axis 블록에서 0건이다. A5의 세 부재 경로는 paths_expected_absent에서만 확인했다.\"\n}\n\r\n\r\n2차 22면의 표제란 제외 경계와 같은 대역의 표 내용 최대값은 위 표에 추가했다. 생성된 22개 픽스처를 인접 텍스트로 재조립해 `/TEL|FAX|℡|電話|一級建築士|設計事務所|株式会社|共同体/`를 검사한 결과는 0건이며, 표제란 밖 注記에서의 예외도 없었다.\r\n\r\n## 왜 이 코퍼스인가\r\n\r\n- **발주처 상이 10곳**(1차 3곳 ＋ 2차 7곳: 唐津·富士河口湖·伊那·佐伯·津·弘前·新発田) — 포맷 변동(작성 사무소·CAD·PDF 생성기)이 실제로 존재함을 보장한다\r\n- **표 방향 2종** — ojkk·yokohama는 가로형(부재가 열), kani 地中梁リスト는 세로형(항목이 행)\r\n- **엣지 케이스 포함** — 高強度筋 `K13`(BarSize 표현 불가)·`S13(KSS785)`, 원형 단면 `600φ`,\r\n  `2段筋` 주석, カットオフ 치수 `[2500]`(스코프 밖 값), 位置(端部/中央)·階별 상이값,\r\n  스코프 밖 부재 종별(基礎柱 FC·地中梁 FG·小梁 B)\r\n- **2차 추출·글리프 엣지 케이스** — CMap 결함·겹침 글자·회전 글리프는 위 `제2차 수집 도면의 특성` 절을 참조한다\r\n- **2차 형상 엣지 케이스** — 접두 없는 通り芯 라벨·合計 없음·部分合·나란한 치수 열·150·100 소구간은 위 `제2차 수집 도면의 특성` 절을 참조한다\r\n- **2차 리스트 엣지 케이스** — 両端·階 행·다부호 셀·축척 제목·피치 표기 변형·断面寸法 행은 위 `제2차 수집 도면의 특성` 절을 참조한다\r\n\r\n## 재현 절차\r\n\r\n```\r\n# PDF 재취득 후 해시 대조\r\nInvoke-WebRequest <url> -OutFile .cache\\<파일명>\r\nGet-FileHash .cache\\<파일명> -Algorithm SHA256\r\n\r\n# TextItem JSON 재생성 (phase 6 step 0의 스크립트)\r\nnpx tsx scripts/extract-textitems.mjs\r\n```\r\n\r\n### uc12 e2e (실물 PDF 브라우저 검증)\r\n\r\ndev-browser 샌드박스는 호스트 경로를 직접 열지 못하므로 PDF를 base64로 미러링한\r\n뒤 실행한다 (bash):\r\n\r\n```\r\nbase64 -w0 .cache/dwg-yokohama.pdf > ~/.dev-browser/tmp/uc12-dwg-yokohama.pdf.b64\r\nbase64 -w0 .cache/dwg-ojkk-zumen6.pdf > ~/.dev-browser/tmp/uc12-dwg-ojkk.pdf.b64\r\nnpx dev-browser --browser kijun --timeout 150 run tests/e2e/uc12-section-import.js\r\n```\r\nTrue\r\n2. **구분은 設計図書 판단의 전사 입력이다** — 어느 벽이 耐力壁인지는 두 원문에 판정 기준이 없다(構造設計의 몫). 실도면 2부의 壁リスト도 雑壁을 `W○` 부호＋자유 텍스트 備考로만 적으므로, 断面リスト 취입은 자동 판정하지 않고(備考 분류 금지 전사 주석 유지) 断面一覧에서 사용자가 고른다. 취입은 기존 단면의 `wallClass`를 덮지 않는다 — 전사 대상이 아니다.\r\n3. **かぶり** — 룰팩에 表5.3.6 「スラブ、耐力壁以外の壁」행을 `memberKind: 雑壁` 2행(仕上げあり20·仕上げなし30, soilContact:false, exposure 조건 없음 — 원문 구조)으로 싣는다. 값은 ADR-028이 床板용으로 이미 전사한 fixture 행에 있고, 이 행은 부재가 아니라 구분을 가르므로 제품 어휘 토큰 `雑壁`을 조건에 쓴다 — 기존 耐震壁 행과 조건이 배타라 조회 동점(ambiguous)을 만들지 않는다. かぶり는 設計長さ(kg)에 영향이 없고 3D 배치와 ダブル 성립 가드에만 미친다 — 지금 `寸法不成立`으로 떨어지는 얇은 벽이 계상되기 시작할 수 있고, 그것이 옳은 방향이다.\r\n4. **40d 하한은 雑壁에 적용하지 않는다 — 제품의 읽기다.** 5.3.4(3)(ｱ)는 耐力壁 한정이고 耐力壁以外의 하한을 정한 조문은 없으므로, 일반 규정(表5.3.2의 L1)만 남는다고 읽는다. ADR-029의 開口部腰壁 판정과 같은 성격으로 기록한다(R2). `wallClass: 耐力壁以外`이면 `lap.wall.minimum`을 조회하지 않고 ruleHits에도 싣지 않으며, 算出式에 그 사실을 적는다. **kg가 달라지는 유일한 지점이다** (L1 ＜ 40d인 조합에서만).\r\n5. **하지 않는 것**: 부분 높이·부분 길이 형상(腰壁·垂れ壁의 고유 높이, 袖壁)은 이 결정의 범위 밖이다 — 조문은 内法 준용만 말하고 경계 치수를 정하지 않아 형상 입력 신설이 따로 필요하다(후속 검토). 全高 벽＋開口 우회(ADR-029)는 현행 유지. 手すり壁은 정의절 열거(「袖壁、下り壁、腰壁等」)에 없고 ②의 但書에만 나온다 — 부재화하지 않는다. 幅止め筋 본수 조문 부재(ADR-025)도 그대로다. 内訳書 그룹은 `W` 그대로 두고 부호(mark)로 가른다.\r\n\r\n### ADR-037: 雑壁의 부분 높이·부분 길이는 部材 단위 内法 범위 전사 입력이다 — 자유단에는 定着이 없다\r\n\r\n**맥락**: ADR-036 §5가 남긴 것이다. `数量積算基準` 第4編第1章第2節（５）의 정의는 「袖壁、下り壁、腰壁等もこれらに準ずる」로 이들을 「柱、梁、床板等に接する垂直材の内法部分」에 준하게 하지만, **그 内法의 경계 치수는 조문에 없다** — 腰壁이 어디서 끝나는지는 設計図書에만 있다. 현행 제품의 벽은 언제나 全内法(柱면~柱면 × 階高−上部大梁せい)이고, 부분 벽은 全高 벽＋開口 우회(ADR-029)로만 근사된다. 그 우회에는 두 결함이 있다. ① `buildWallBars`는 범위와 무관하게 **항상 양단에 定着을 더한다** — 袖壁의 자유단(벽이 끝나고 아무것도 접속하지 않는 가장자리)에도 定着이 붙어 근거 없이 kg가 올라간다. 2（５）壁1)①은 「接続する他の部分に定着するものとし」라 접속하지 않는 가장자리에는 定着이 없다. ② 경계에 접한 「開口」는 建具類等의 開口部가 아니라 그냥 벽이 없는 부분인데, 그것을 開口로 적으면 1通則8)의 0.5㎡ 하한·②의 継手 但書·開口補強筋 고지가 함께 따라온다. 즉 開口 우회는 **다른 조문을 잘못 발화시킨다**.\r\n\r\n**결정**:\r\n1. **범위는 部材 단위 전사 입력이다** — `Member.wallExtent?: { vertical?: { anchor: '下端' | '上端'; heightMm: number }, horizontal?: { anchor: '始端' | '終端'; lengthMm: number } }`. 단면이 아니라 부재에 붙는 이유는 ADR-029의 `openings`와 같다 — 같은 符号의 벽이 여러 장 서는데 형상은 장마다 다르다. 축마다 optional이고 미지정은 「그 축은 全内法」이다. **schemaVersion을 올리지 않는다** — optional 추가이고 기본값이 현행과 같아 같은 案件의 数量이 변하지 않는다(ADR-034·036과 같은 판단 기준).\r\n2. **범위는 内法 안에서만 존재한다** — `heightMm`은 内法高さ 이하·양수, `lengthMm`은 内法長さ 이하·양수. 벗어나면 조용히 clamp하지 말고 `MemberUnsupportedError('寸法不成立')`로 떨어뜨린다(ADR-025의 얇은 벽 가드와 같은 취급).\r\n3. **자유단에는 定着을 더하지 않는다** — 2（５）壁1)①의 「接続する他の部分に定着するものとし」의 직접 적용이다. `anchor: '下端'`(腰壁)이면 縦筋의 上端이, `'上端'`(下り壁)이면 下端이, `'始端'`(袖壁)이면 横筋의 終端이 자유단이다. 定着은 접속하는 쪽에만 1회 붙고 算出式에 어느 쪽이 자유단인지 적는다. 범위를 지정하지 않은 축은 현행 그대로 양단 定着이다.\r\n4. **割付은 그 벽의 실제 범위로 한다** — 縦筋은 그 벽의 長さ에, 横筋은 그 벽의 高さ에 1通則7)로 割付한다. 규칙은 현행 그대로이고 들어가는 값만 범위가 된다.\r\n5. **부분 높이 벽의 縦筋 継手는 0か所로 읽는다 — 제품의 읽기다.** 2（５）壁1)②는 「縦筋の継手は原則として各階に１か所あるものとし、開口部腰壁、手すり壁等の継手はないものとする」인데, 但書가 이름으로 든 것은 開口部腰壁·手すり壁이고 下り壁은 이름이 없다. 그러나 원칙(各階1か所)은 縦筋이 階를 관통하는 것을 전제로 하고 부분 높이 벽의 縦筋은 관통하지 않으므로, **높이 범위가 지정된 벽**은 但書 쪽으로 읽는다. ADR-029·036과 같은 성격으로 R2에 적는다. 룰팩 신규는 **0행** — 이미 있는 `measure.splice.wall.opening`(0か所, ADR-029)을 그대로 조회한다. 부분 길이만인 벽(袖壁)은 縦筋이 관통하므로 현행대로 各階1か所이고, 横筋 継手는 어느 경우든 1通則4)라 길이가 짧아지면 저절로 줄어든다.\r\n6. **開口의 국소 좌표는 그 벽의 범위 원점을 쓴다** — `Opening.xMm/yMm`는 内法域의 원점 기준이고(ADR-029), 범위가 지정되면 内法域이 그 범위다. 부분 벽에도 開口는 뚫릴 수 있고 欠除은 같은 규약으로 계상된다. 3D의 콘크리트 상자·배근 원점도 같은 원점으로 옮긴다.\r\n7. **하지 않는 것**: 자동 판정(断面リスト 壁 후보는 厚·配筋만이고 伏図는 평면이라 높이가 없다 — 어느 트랙도 형상 치수를 주지 않는다), 手すり壁 부재화(정의절 열거에 없다 — ADR-036 §5 유지), 같은 辺에 선 벽들의 겹침 검사(제품에 다른 겹침 검사도 없다 — 새로 만들지 않는다), 全高 벽＋開口 우회의 폐지(기존 案件이 그대로 열려야 한다 — 새 입력은 대체지 강제가 아니다), 壁式構造の壁(2（５）壁2), 별건).\r\n\r\n**2026-08-27 보충**: `標準仕様書` 表5.3.1 注1은 「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」고 두 대상을 같은 자리에서 다룬다. 따라서 ADR-037 §3의 「자유단에는 定着을 더하지 않는다」는 판단은 원문이 자유단을 별도로 취급한다는 사실로 지지된다. 이 4d는 加工 형상에 관한 余長이고, 수량은 `数量積算基準` 1通則1)의 「先端で止まる鉄筋はコンクリートの設計寸法」에 따라 가산하지 않는다 — R12의 フック 미반영과 같은 자리다.\r\n\r\n### ADR-038: 平面 페인에서 벽·床板을 놓고 지운다 — 잴 수 없는 자리에는 놓지 않는다\r\n**맥락**: 지금 부재를 만드는 길은 셋뿐이다 — 샘플 案件, 伏図 취입(`apply.ts`), 그리고 없다. 平面 페인은 표시와 開口·범위 입력만 한다(ADR-029·037). 그래서 도면이 없는 사용자는 벽 하나를 더할 수도, 잘못 들어온 床板 하나를 지울 수도 없다. 한편 벽·床板의 内法은 다른 부재가 정한다 — 벽의 内法高さ는 그 辺의 大梁가(`girderDepthAboveWall`), 内法長さ는 양 끝 柱가(`supportColumnSection`), 床板의 内法은 네 변의 大梁가 정한다. 이 중 `girderDepthAboveWall`은 **`MemberUnsupportedError`가 아니라 plain `Error`**를 던지고 `useTakeoff`는 前者만 잡으므로(`src/lib/hooks/useTakeoff.ts:120`), 大梁 없는 辺의 벽은 부재 하나가 떨어지는 것이 아니라 **화면이 통째로 죽는다**.\r\n\r\n**결정**:\r\n1. **놓고 지우는 것은 벽·床板 둘뿐이다** — 柱·大梁는 平面에서 만들지도 지우지도 않는다. 그 둘은 격자와 다른 부재의 内法을 정하는 쪽이라, 놓거나 지우면 손대지 않은 부재의 数量이 조용히 바뀐다(ADR-030이 伏図 취입에서 같은 함정을 거부로 막은 것과 같은 이유). 柱·大梁 편집은 별건이다.\r\n2. **잴 수 없는 자리는 후보로 내지 않는다** — 벽은 그 辺에 大梁가 있고 양 끝에 柱가 있는 자리에만, 床板은 네 변의 大梁가 있는 ベイ에만 놓을 수 있다. 판정은 도메인의 순수 함수가 하고 UI는 그 결과만 그린다 — 「놓을 수 있는가」는 규준이 아니라 제품의 기하 지식이므로 룰팩이 아니라 코드다.\r\n3. **그래도 도메인이 부재 단위로 떨어뜨려야 한다** — 취입·손편집·과거 案件 어디서든 잴 수 없는 벽이 들어올 수 있으므로, `girderDepthAboveWall`의 plain `Error`를 `MemberUnsupportedError('寸法不成立')`로 바꿔 `useTakeoff`가 그 부재만 「未対応」으로 떨어뜨리게 한다. UI의 후보 제한(2)은 편의이고, 이것이 방어다.\r\n4. **부재 id는 伏図 취입과 같은 규약을 쓴다** — `${storyId}-${mark}-${ix}-${iy}[-${axis}]`. 같은 id가 이미 있으면 놓지 않는다(같은 자리에 같은 符号을 두 번 놓는 것이 그 경우다). 서로 다른 符号이 같은 辺에 서는 것은 막지 않는다 — 겹침 검사는 만들지 않는다(ADR-037 §7).\r\n5. **지우면 그 부재의 開口·범위도 함께 사라진다** — 둘 다 부재에 붙어 있다. 되돌리기는 만들지 않는다(제품에 undo가 없고, 이 결정으로 만들지 않는다).\r\n6. **하지 않는 것**: 柱·大梁 배치·삭제, 격자(通り芯) 편집(이미 `SpanEditor`가 있다), 겹침·중복 배치 검사, 되돌리기, 3D 뷰에서의 배치.\r\n\r\n### ADR-039: 片持床板을 만든다 — ADR-028의 「두 원문 0건」 전제는 틀렸다\r\n\r\n**맥락**: ADR-028은 `片持床板`과 `配力筋`을 「두 원문 0건」으로 묶어 둘 다 만들지 않았고, 그 서술이 `CLAUDE.md`·`docs/MILESTONES.md`에 그대로 실려 있다. 원문을 다시 세어 보니 **0건인 것은 `配力筋`뿐이다** — 「片持」는 `数量積算基準`에 6건(PDF p15·16·21·22×2·25), `標準仕様書`에 8건(p33·36×2·37×4·60) 있고 그중 넷은 片持床板에 직접 걸린다. 근거를 갖고 있으면서 만들지 않은 것이므로 전제를 고치고 만든다.\r\n\r\n**근거 조문(전사 확인)**:\r\n- `数量積算基準` 第4編第1章第2節（４）床板 — 「片持床板等もこれらに準ずる。」 즉 片持도 「柱、梁等に接する水平材の内法部分」이다.\r\n- 같은 기준 2（４）床板2) 但書 — 「単独床板及び片持床板の主筋の継手は、1通則4)による。」 連続床板의 区分表가 아니라 길이 기반이다.\r\n- `標準仕様書` 表5.3.4 L3 スラブ欄 — 「10d かつ150mm以上（**片持スラブの場合は25d**）」. 下端筋 直線定着이 갈린다.\r\n- 같은 표 5.3.5 注1·2 — La는 「基礎梁、片持梁及び**片持スラブを含む**」, Lb는 「片持小梁及び**片持スラブを除く**」. 上端筋 折曲げ定着의 投影 열이 Lb가 아니라 **La**다.\r\n- 같은 표 5.3.1 注1 — 「**片持ちスラブ先端**、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」 원문이 片持의 先端과 壁의 自由端을 같은 자리에서 다룬다 — ADR-037이 벽에 세운 자유단 판단을 원문이 지지한다.\r\n\r\n**결정**:\r\n1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로이고 片持床板은 `kind: '床板'`이다. 갈리는 것은 **지지 조건**이지 부재가 아니다(ADR-036이 雑壁을 区分으로 담은 것과 같은 형태).\r\n2. **위치는 지지하는 辺이고, 내미는 치수는 設計図書 전사다** — 片持床板의 `position`은 ベイ가 아니라 支持辺(`GirderPosition` 형태)이고, `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`가 내미는 쪽과 치수를 받는다(`正` ＝ 支持辺의 축에 직교하는 通り芯 index가 커지는 쪽). 조문은 内法 준용만 말하고 내미는 치수를 정하지 않으므로 전사 입력이다 — ADR-037과 같은 이유·같은 형태. `kind: '床板'`이면서 `axis`를 가진 position이 곧 片持이다. 스키마 버전은 올리지 않는다(optional 추가, 기존 案件 数量 불변).\r\n","exit_code":0,"status":"completed"}}
