\\\r\\\\n\\\\r\\\\nfunction readPage(file: string): TextPage {\\\\r\\\\n  const fixturePath = resolve(\\\\r\\\\n    process.cwd(),\\\\r\\\\n    'tests/fixtures/section-import/textitems',\\\\r\\\\n    file,\\\\r\\\\n  )\\\\r\\\\n  const fixture = JSON.parse(\\\\r\\\\n    readFileSync(fixturePath, 'utf8'),\\\\r\\\\n  ) as TextItemFixture\\\\r\\\\n\\\\r\\\\n  return { ...fixture.page, items: fixture.items }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction readGolden(file: string): ElevationFixture {\\\\r\\\\n  return JSON.parse(\\\\r\\\\n    readFileSync(\\\\r\\\\n      resolve(process.cwd(), 'tests/fixtures/plan-import/expected', file),\\\\r\\\\n      'utf8',\\\\r\\\\n    ),\\\\r\\\\n  ) as ElevationFixture\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction elevationForTitle(\\\\r\\\\n  parsed: ReturnType<typeof parseFrameElevations>,\\\\r\\\\n  title: string,\\\\r\\\\n): ReturnType<typeof parseFrameElevations>['elevations'][number] {\\\\r\\\\n  const normalized = compact(title)\\\\r\\\\n  const expectedTitle = normalized.includes('軸組図')\\\\r\\\\n    ? normalized\\\\r\\\\n    : `${normalized}軸組図`\\\\r\\\\n  const matches = parsed.elevations.filter((elevation) =>\\\\r\\\\n    elevation.titles.some(\\\\r\\\\n      (candidateTitle) =>\\\\r\\\\n        candidateTitle === expectedTitle ||\\\\r\\\\n        candidateTitle.startsWith(`${expectedTitle}S=`),\\\\r\\\\n    ),\\\\r\\\\n  )\\\\r\\\\n  expect(matches).toEqual([expect.anything()])\\\\r\\\\n  return matches[0]!\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction labelsByLevel(\\\\r\\\\n  elevation: ReturnType<typeof parseFrameElevations>['elevations'][number],\\\\r\\\\n): string[][] {\\\\r\\\\n  return elevation.levels.map((level) => level.labels)\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction titlesOf(\\\\r\\\\n  expected: ElevationFixture['elevations'][number],\\\\r\\\\n): string[] {\\\\r\\\\n  return (\\\\r\\\\n    expected.titles ??\\\\r\\\\n    (expected.title === undefined ? [] : [expected.title])\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction expectCorpus2Elevations(\\\\r\\\\n  pageFile: string,\\\\r\\\\n  goldenFile: string,\\\\r\\\\n): ReturnType<typeof parseFrameElevations>['elevations'][] {\\\\r\\\\n  const golden = readGolden(goldenFile)\\\\r\\\\n  const parsed = parseFrameElevations(readPage(pageFile))\\\\r\\\\n\\\\r\\\\n  expect(parsed.issues).toEqual([])\\\\r\\\\n  const actualsByExpected = golden.elevations.map((expected) => {\\\\r\\\\n    const titles = titlesOf(expected)\\\\r\\\\n    expect(titles).not.toEqual([])\\\\r\\\\n    return titles.map((title) => elevationForTitle(parsed, title))\\\\r\\\\n  })\\\\r\\\\n  const actuals = actualsByExpected.flat()\\\\r\\\\n\\\\r\\\\n  // 모든 파서 계열은 골든 항목에서 청구되어야 한다. 골든 여러 항목이\\\\r\\\\n  // 하나의 계열을 공유하는 경우(예: karatsu X3·X4)도 허용하되,\\\\r\\\\n  // 파서만의 미청구 계열은 허용하지 않는다.\\\\r\\\\n  expect(new Set(parsed.elevations)).toEqual(new Set(actuals))\\\\r\\\\n\\\\r\\\\n  for (const [index, expected] of golden.elevations.entries()) {\\\\r\\\\n    const expectedActuals = actualsByExpected[index]!\\\\r\\\\n    expect(new Set(expectedActuals)).toEqual(new Set([expectedActuals[0]]))\\\\r\\\\n\\\\r\\\\n    const actual = expectedActuals[0]!\\\\r\\\\n    const expectedHeights = expected.heightsMm ?? golden.heightsMm\\\\r\\\\n    const expectedLabels = expected.levels ?? golden.levelTexts\\\\r\\\\n    expect(expectedHeights).toBeDefined()\\\\r\\\\n    expect(expectedLabels).toBeDefined()\\\\r\\\\n    expect(actual.heightsMm).toEqual(expectedHeights)\\\\r\\\\n    expect(labelsByLevel(actual)).toEqual(\\\\r\\\\n      expectedLabels!.map((label) => [label]),\\\\r\\\\n    )\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return actualsByExpected\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\ndescribe('階高 corpus 2 골든', () => {\\\\r\\\\n  it('karatsu: 골든의 모든 제목 항목을 대응 계열의 높이·레벨 라벨과 대조한다', () => {\\\\r\\\\n    const actualsByExpected = expectCorpus2Elevations(\\\\r\\\\n      'karatsu-jikugumi1-p1.json',\\\\r\\\\n      'karatsu-jikugumi1-p1-elevation.json',\\\\r\\\\n    )\\\\r\\\\n\\\\r\\\\n    // 골든의 X3·X4 항목은 도면의 같은 치수 열을 공유하므로 하나의\\\\r\\\\n    // 파서 계열로 묶여야 한다. 이 관계를 골든 순서에서 직접 검증한다.\\\\r\\\\n    expect(actualsByExpected[1]?.[0]).toBe(actualsByExpected[2]?.[0])\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('tsu: p21의 모든 제목 계열을 전체 골든 높이·레벨 라벨과 대조한다', () => {\\\\r\\\\n    expectCorpus2Elevations(\\\\r\\\\n      'tsu-p21.json',\\\\r\\\\n      'tsu-kanritou-p21-elevation.json',\\\\r\\\\n    )\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('tsu: p22의 모든 제목 계열을 전체 골든 높이·레벨 라벨과 대조한다', () => {\\\\r\\\\n    expectCorpus2Elevations(\\\\r\\\\n      'tsu-p22.json',\\\\r\\\\n      'tsu-kanritou-p22-elevation.json',\\\\r\\\\n    )\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('hirosaki: 골든의 모든 제목 계열을 높이·레벨 라벨과 대조한다', () => {\\\\r\\\\n    expectCorpus2Elevations(\\\\r\\\\n      'hirosaki-p25.json',\\\\r\\\\n      'hirosaki-kikyono-p25-elevation.json',\\\\r\\\\n    )\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\"\\ntests/fixtures/plan-import/expected\\\\hirosaki-kikyono-p25-elevation.json:12:  \\\"elevations\\\": [\\r\\ntests/fixtures/plan-import/expected\\\\hirosaki-kikyono-p25-elevation.json:32:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\hirosaki-kikyono-p25-elevation.json:72:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\hirosaki-kikyono-p25-elevation.json:117:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\karatsu-jikugumi1-p1-elevation.json:23:  \\\"elevations\\\": [\\r\\ntests/fixtures/plan-import/expected\\\\karatsu-jikugumi1-p1-elevation.json:26:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\karatsu-jikugumi1-p1-elevation.json:43:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\karatsu-jikugumi1-p1-elevation.json:62:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\tsu-kanritou-p22-elevation.json:17:  \\\"elevations\\\": [\\r\\ntests/fixtures/plan-import/expected\\\\tsu-kanritou-p21-elevation.json:2:  \\\"$comment\\\": \\\"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래. 이 페이지는 아래쪽 레벨만 확정했다. 2026-09-05 수정(Claude, phase 38 step6 반증 후속): axis.labels에서 마지막 통り芯 X5가 빠져 있었다 — 라벨 4개에 스팬 4개로 「라벨=스팬+1」 불변식을 깨고 있었고, 같은 건물의 tsu-kanritou-p16-grid.json x축(X1..X5, 동일 스팬, 合計 22,000)과도 어긋났다. 원본 재확인: dwg-tsu-kanritou.pdf 21면은 軸組図 블록이 셋(Y1·Y2·Y3通り)이고 셋 다 전각 라벨 Ｘ１..Ｘ５ 다섯 개를 가진다(회전 페이지라 표시 좌우는 fitz y 내림차순 = X1→X5). 스팬 배열과 totalMm은 원본과 일치했으므로 라벨만 보정했다.\\\",\\r\\ntests/fixtures/plan-import/expected\\\\tsu-kanritou-p21-elevation.json:12:  \\\"elevations\\\": [\\r\\ntests/fixtures/plan-import/expected\\\\tsu-kanritou-p21-elevation.json:30:      \\\"levelsBottom\\\": [\\r\\ntests/fixtures/plan-import/expected\\\\tsu-kanritou-p21-elevation.json:41:      \\\"axis\\\": {\\r\\ntests/fixtures/plan-import/expected\\\\tsu-kanritou-p21-elevation.json:57:      \\\"levelsBottomNote\\\": \\\"phase 37의 부분 전사다. phase 38(2026-09-04)에서 300dpi 크롭(위 블록 clip x80-340 y100-320, 아래 블록 y590-810)을 다시 읽어 최상단 두 레벨까지 확정했고, levels·heightsMm이 전 계열이다. levelsBottom·heightsBottomMm은 그 전 계열의 뒤쪽 부분집합이라 그대로 참이다.\\\",\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nphases/39-axis-claim\\step1-codex.stdout.log-14-{\"type\":\"item.started\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command \\\"node - <<'NODE'\\nconst fs = require('fs');\\nconst dir='tests/fixtures/plan-import/expected';\\nfor (const name of fs.readdirSync(dir).filter(n=>n.endsWith('.json')).sort()) {\\n  const value=JSON.parse(fs.readFileSync(dir+'/'+name,'utf8'));\\n  if (name.endsWith('-grid.json')) {\\n    for (const [i,b] of (value.blocks||[]).entries()) for (const axis of ['x','y']) {\\n      const a=b[axis];\\n      console.log(name, \\\"'`block${i}.${axis}`, JSON.stringify({labels:a.labels,spansMm:a.spansMm,totalMm:a.totalMm}));\\n    }\\n  }\\n  if (name.endsWith('\\\"'-elevation.json')) {\\n    for (const [i,e] of (value.el