\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            { name: 'PH', height: '4000', kind: 'PENTHOUSE' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            { name: 'RFL', height: '8000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ).issues,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const invalidHeight = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: undefined, kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(invalidHeight.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(invalidHeight.issues).toEqual(['?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(JSON.stringify(invalidHeight)).not.toContain('heightMm\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":0')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const duplicate = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '2FL', height: '4000', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(duplicate.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(duplicate.issues).toEqual(['?롢꺃?쇻꺂?띹쨭'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const insufficient = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({ stories: [{ name: '1FL', height: '0', kind: 'GENERAL' }] }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(insufficient.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(insufficient.issues).toEqual(['?롣툖擁?])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const empty = toSkeletonCandidate(document({ stories: [] }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(empty.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(empty.issues).toEqual(['?롣툖擁?])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const negative = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'B1F', height: '-3000', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: '1FL', height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(negative.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(negative.issues).toEqual(['?겻툔?с깧?ユ쑋野얍퓶'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const missingName = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        stories: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: undefined, height: '0', kind: 'GENERAL' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          { name: 'RFL', height: '4000', kind: 'ROOF' },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(missingName.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(missingName.issues).toEqual(['?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('copies document failures and unsupported elements without producing candidates', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const failed = toSkeletonCandidate(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      document({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        issues: ['野얍퓶鸚뽧깘?쇈궦?㎯꺍'],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        unsupportedAxisKinds: [{ name: 'StbArcAxes', count: 2 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        unreadElements: [{ name: 'StbColumn', count: 3 }],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.grids).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.stories).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.issues).toEqual(['野얍퓶鸚뽧깘?쇈궦?㎯꺍'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(failed.unsupported).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: 'StbArcAxes', count: 2 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      { name: 'StbColumn', count: 3 },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('returns a JSON-only candidate', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidate = toSkeletonCandidate(document({ projectName: 'demo' }))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(JSON.parse(JSON.stringify(candidate))).toEqual(candidate)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- tests/stb-import/apply.test.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync } from 'node:fs'\\\\\\\\\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport { toSkeletonCandidate } from '@/lib/import/stb/candidates'\\\\\\\\\\\\\\\\nimport { applyStbGrid, applyStbStories } from '@/lib/import/stb/apply'\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  StbApplyRefusal,\\\\\\\\\\\\\\\\n  StbApplyResult,\\\\\\\\\\\\\\\\n  StbDocument,\\\\\\\\\\\\\\\\n  StbGridCandidate,\\\\\\\\\\\\\\\\n  StbSkeletonCandidate,\\\\\\\\\\\\\\\\n} from '@/lib/import/stb/types'\\\\\\\\\\\\\\\\nimport type { Project } from '@/domain/model/project'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst documentDirectory = resolve(\\\\\\\\\\\\\\\\n  process.cwd(),\\\\\\\\\\\\\\\\n  'tests/fixtures/stb-import/document',\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\nconst appliedDirectory = resolve(\\\\\\\\\\\\\\\\n  process.cwd(),\\\\\\\\\\\\\\\\n  'tests/fixtures/stb-import/applied',\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst fixtureFiles = [\\\\\\\\\\\\\\\\n  'mini.json',\\\\\\\\\\\\\\\\n  'dotnet-sample1.json',\\\\\\\\\\\\\\\\n  'diffchecker-filea.json',\\\\\\\\\\\\\\\\n  'hoaryfox-sample.json',\\\\\\\\\\\\\\\\n  'diffchecker-mini210.json',\\\\\\\\\\\\\\\\n] as const\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface AppliedFixture {\\\\\\\\\\\\\\\\n  _derivedFrom: string\\\\\\\\\\\\\\\\n  grid: {\\\\\\\\\\\\\\\\n    applied: boolean\\\\\\\\\\\\\\\\n    refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n    value: {\\\\\\\\\\\\\\\\n      xSpans: number[]\\\\\\\\\\\\\\\\n      ySpans: number[]\\\\\\\\\\\\\\\\n      xLabels: string[]\\\\\\\\\\\\\\\\n      yLabels: string[]\\\\\\\\\\\\\\\\n    } | null\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  stories: {\\\\\\\\\\\\\\\\n    applied: boolean\\\\\\\\\\\\\\\\n    refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n    value: { id: string; name: string; height: number }[] | null\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface RefusedFixture {\\\\\\\\\\\\\\\\n  applied: boolean\\\\\\\\\\\\\\\\n  refusal: StbApplyRefusal | null\\\\\\\\\\\\\\\\n  value: null\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction readJson<T>(directory: string, file: string): T {\\\\\\\\\\\\\\\\n  return JSON.parse(\\\\\\\\\\\\\\\\n    readFileSync(resolve(directory, file), 'utf8'),\\\\\\\\\\\\\\\\n  ) as T\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction withoutPrivateKeys<T>(value: T): T {\\\\\\\\\\\\\\\\n  return Object.fromEntries(\\\\\\\\\\\\\\\\n    Object.entries(value as Record<string, unknown>).filter(\\\\\\\\\\\\\\\\n      ([key]) => !key.startsWith('_'),\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\n  ) as T\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction candidateFor(file: (typeof fixtureFiles)[number]): StbSkeletonCandidate {\\\\\\\\\\\\\\\\n  return toSkeletonCandidate(\\\\\\\\\\\\\\\\n    withoutPrivateKeys(\\\\\\\\\\\\\\\\n      readJson<StbDocument>(documentDirectory, file),\\\\\\\\\\\\\\\\n    ),\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction resultShape(\\\\\\\\\\\\\\\\n  result: StbApplyResult,\\\\\\\\\\\\\\\\n): RefusedFixture {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    applied: result.applied,\\\\\\\\\\\\\\\\n    refusal: result.refusal ?? null,\\\\\\\\\\\\\\\\n    value: null,\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst emptyProject: Project = {\\\\\\\\\\\\\\\\n  schemaVersion: 11,\\\\\\\\\\\\\\\\n  name: '?ъ슜?먭? ?뺥븳 旅덁뻑??,\\\\\\\\\\\\\\\\n  grid: {\\\\\\\\\\\\\\\\n    xSpans: [6000, 6000],\\\\\\\\\\\\\\\\n    ySpans: [5000],\\\\\\\\\\\\\\\\n    xLabels: ['湲곗〈X1', '湲곗〈X2', '湲곗〈X3'],\\\\\\\\\\\\\\\\n    yLabels: ['湲곗〈Y1', '湲곗〈Y2'],\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\n  stories: [{ id: 'existing-story', name: '湲곗〈痢?, height: 3000 }],\\\\\\\\\\\\\\\\n  sections: [],\\\\\\\\\\\\\\\\n  members: [],\\\\\\\\\\\\\\\\n  notes: { 'existing-line': '蹂댁〈??硫붾え' },\\\\\\\\\\\\\\\\n  unitMass: { D10: 0.56 },\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nconst projectWithMember: Project = {\\\\\\\\\\\\\\\\n  ...emptyProject,\\\\\\\\\\\\\\\\n  members: [\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\n      id: 'member-1',\\\\\\\\\\\\\\\\n      kind: '??,\\\\\\\\\\\\\\\\n      memberClass: '翁?퐪',\\\\\\\\\\\\\\\\n      sectionId: 'section-1',\\\\\\\\\\\\\\\\n      storyId: 'existing-story',\\\\\\\\\\\\\\\\n      position: { ix: 0, iy: 0 },\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  ],\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction relabelCandidate(\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n  labels: { x: string[]; y: string[] },\\\\\\\\\\\\\\\\n): StbSkeletonCandidate {\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    ...candidate,\\\\\\\\\\\\\\\\n    grids: candidate.grids.map((grid) => ({\\\\\\\\\\\\\\\\n      ...grid,\\\\\\\\\\\\\\\\n      axes:\\\\\\\\\\\\\\\\n        grid.direction === 'X'\\\\\\\\\\\\\\\\n          ? labels.x.map((label) => ({ label }))\\\\\\\\\\\\\\\\n          : labels.y.map((label) => ({ label })),\\\\\\\\\\\\\\\\n    })),\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction gridCandidate(\\\\\\\\\\\\\\\\n  candidate: StbSkeletonCandidate,\\\\\\\\\\\\\\\\n): { x: StbGridCandidate; y: StbGridCandidate } {\\\\\\\\\\\\\\\\n  const x = candidate.grids.find(({ direction }) => direction === 'X')\\\\\\\\\\\\\\\\n  const y = candidate.grids.find(({ direction }) => direction === 'Y')\\\\\\\\\\\\\\\\n  if (x === undefined || y === undefined) {\\\\\\\\\\\\\\\\n    throw new Error('test candidate does not contain both grid directions')\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return { x, y }\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('ST-Bridge candidate application fixtures', () => {\\\\\\\\\\\\\\\\n  for (const file of fixtureFiles) {\\\\\\\\\\\\\\\\n    it(`${file} matches its independently derived applied fixture`, () => {\\\\\\\\\\\\\\\\n      const candidate = candidateFor(file)\\\\\\\\\\\\\\\\n      const expected = readJson<AppliedFixture>(appliedDirectory, file)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      const gridResult = applyStbGrid(emptyProject, candidate)\\\\\\\\\\\\\\\\n      const storiesResult = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n      const grid = gridResult.applied\\\\\\\\\\\\\\\\n        ? {\\\\\\\\\\\\\\\\n            applied: true,\\\\\\\\\\\\\\\\n            refusal: null,\\\\\\\\\\\\\\\\n            value: gridResult.project.grid,\\\\\\\\\\\\\\\\n          }\\\\\\\\\\\\\\\\n        : resultShape(gridResult)\\\\\\\\\\\\\\\\n      const stories = storiesResult.applied\\\\\\\\\\\\\\\\n        ? {\\\\\\\\\\\\\\\\n            applied: true,\\\\\\\\\\\\\\\\n            refusal: null,\\\\\\\\\\\\\\\\n            value: storiesResult.project.stories,\\\\\\\\\\\\\\\\n          }\\\\\\\\\\\\\\\\n        : resultShape(storiesResult)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n      expect(expected._derivedFrom).toBe(\\\\\\\\\\\\\\\\n        `tests/fixtures/stb-import/expected/${file}`,\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      expect(grid).toEqual(expected.grid)\\\\\\\\\\\\\\\\n      expect(stories).toEqual(expected.stories)\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('applyStbGrid', () => {\\\\\\\\\\\\\\\\n  it('rejects missing or non-unique X/Y candidates without touching the project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const missingDirection = {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      grids: candidate.grids.filter(({ direction }) => direction === 'X'),\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    const duplicateDirection = {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      grids: [...candidate.grids, candidate.grids[0]!],\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    for (const invalid of [missingDirection, duplicateDirection]) {\\\\\\\\\\\\\\\\n      const result = applyStbGrid(projectWithMember, invalid)\\\\\\\\\\\\\\\\n      expect(result.applied).toBe(false)\\\\\\\\\\\\\\\\n      expect(result.refusal).toBe('?싥굤??숃짒?ゃ걮')\\\\\\\\\\\\\\\\n      expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('rejects a changed grid while members exist, preserving the original reference', () => {\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidateFor('dotnet-sample1.json'))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?ⓩ쓲?귙굤?싥굤??쉰?쎽툖??,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('keeps members when only labels change on an otherwise equal grid', () => {\\\\\\\\\\\\\\\\n    const candidate = relabelCandidate(candidateFor('mini.json'), {\\\\\\\\\\\\\\\\n      x: ['X-A', 'X-B', 'X-C'],\\\\\\\\\\\\\\\\n      y: ['Y-A', 'Y-B'],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidate)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(result.project.members).toBe(projectWithMember.members)\\\\\\\\\\\\\\\\n    expect(result.project.stories).toBe(projectWithMember.stories)\\\\\\\\\\\\\\\\n    expect(result.project.grid).toEqual({\\\\\\\\\\\\\\\\n      xSpans: [6000, 6000],\\\\\\\\\\\\\\\\n      ySpans: [5000],\\\\\\\\\\\\\\\\n      xLabels: ['X-A', 'X-B', 'X-C'],\\\\\\\\\\\\\\\\n      yLabels: ['Y-A', 'Y-B'],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project.grid.xSpans).not.toBe(candidate.grids[0]!.spansMm)\\\\\\\\\\\\\\\\n    expect(result.project.grid.ySpans).not.toBe(candidate.grids[1]!.spansMm)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('discards members only when explicitly requested and preserves unrelated project data', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('dotnet-sample1.json')\\\\\\\\\\\\\\\\n    const before = {\\\\\\\\\\\\\\\\n      stories: projectWithMember.stories,\\\\\\\\\\\\\\\\n      sections: projectWithMember.sections,\\\\\\\\\\\\\\\\n      notes: projectWithMember.notes,\\\\\\\\\\\\\\\\n      unitMass: projectWithMember.unitMass,\\\\\\\\\\\\\\\\n      name: projectWithMember.name,\\\\\\\\\\\\\\\\n      schemaVersion: projectWithMember.schemaVersion,\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    const result = applyStbGrid(projectWithMember, candidate, {\\\\\\\\\\\\\\\\n      discardMembers: true,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(result.project.members).toEqual([])\\\\\\\\\\\\\\\\n    expect(result.project.stories).toBe(before.stories)\\\\\\\\\\\\\\\\n    expect(result.project.sections).toBe(before.sections)\\\\\\\\\\\\\\\\n    expect(result.project.notes).toBe(before.notes)\\\\\\\\\\\\\\\\n    expect(result.project.unitMass).toBe(before.unitMass)\\\\\\\\\\\\\\\\n    expect(result.project.name).toBe(before.name)\\\\\\\\\\\\\\\\n    expect(result.project.schemaVersion).toBe(before.schemaVersion)\\\\\\\\\\\\\\\\n    expect(JSON.parse(JSON.stringify(result.project))).toEqual(result.project)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('applyStbStories', () => {\\\\\\\\\\\\\\\\n  it('rejects an empty story candidate without touching the project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const result = applyStbStories(projectWithMember, {\\\\\\\\\\\\\\\\n      ...candidate,\\\\\\\\\\\\\\\\n      stories: [],\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?롥숃짒?ゃ걮',\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('rejects story replacement while members exist, preserving the original reference', () => {\\\\\\\\\\\\\\\\n    const result = applyStbStories(\\\\\\\\\\\\\\\\n      projectWithMember,\\\\\\\\\\\\\\\\n      candidateFor('dotnet-sample1.json'),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result).toEqual({\\\\\\\\\\\\\\\\n      project: projectWithMember,\\\\\\\\\\\\\\\\n      applied: false,\\\\\\\\\\\\\\\\n      refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖??,\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\n    expect(result.project).toBe(projectWithMember)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('applies the real candidate from bottom to top and leaves the grid unchanged', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('dotnet-sample1.json')\\\\\\\\\\\\\\\\n    const result = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(result.project.grid).toBe(emptyProject.grid)\\\\\\\\\\\\\\\\n    expect(result.project.stories).toEqual([\\\\\\\\\\\\\\\\n      { id: 'story-1', name: '1FL', height: 5000 },\\\\\\\\\\\\\\\\n      { id: 'story-2', name: '2FL', height: 4200 },\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\n    expect(result.project.stories[0]?.name).toBe('1FL')\\\\\\\\\\\\\\\\n    expect(result.project.name).toBe(emptyProject.name)\\\\\\\\\\\\\\\\n    expect(result.project.sections).toBe(emptyProject.sections)\\\\\\\\\\\\\\\\n    expect(result.project.notes).toBe(emptyProject.notes)\\\\\\\\\\\\\\\\n    expect(JSON.parse(JSON.stringify(result.project))).toEqual(result.project)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('does not block approval merely because the candidate carries an issue', () => {\\\\\\\\\\\\\\\\n    const candidate: StbSkeletonCandidate = {\\\\\\\\\\\\\\\\n      ...candidateFor('mini.json'),\\\\\\\\\\\\\\\\n      issues: ['?싥굤??퐤營?겏影?밤겗訝띴???],\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(applyStbGrid(emptyProject, candidate).applied).toBe(true)\\\\\\\\\\\\\\\\n    expect(applyStbStories(emptyProject, candidate).applied).toBe(true)\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it('does not share the candidate story array with the applied project', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const result = applyStbStories(emptyProject, candidate)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    expect(result.project.stories).not.toBe(candidate.stories)\\\\\\\\\\\\\\\\n    expect(result.project.stories[0]).not.toBe(candidate.stories[0])\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe('application result invariants', () => {\\\\\\\\\\\\\\\\n  it('maps exactly one X and one Y grid without assuming their input order', () => {\\\\\\\\\\\\\\\\n    const candidate = candidateFor('mini.json')\\\\\\\\\\\\\\\\n    const shuffled = { ...candidate, grids: [...candidate.grids].reverse() }\\\\\\\\\\\\\\\\n    const result = applyStbGrid(emptyProject, shuffled)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    const { x, y } = gridCandidate(shuffled)\\\\\\\\\\\\\\\\n    expect(result.project.grid.xSpans).toEqual(x.spansMm)\\\\\\\\\\\\\\\\n    expect(result.project.grid.ySpans).toEqual(y.spansMm)\\\\\\\\\\\\\\\\n    expect(result.project.grid.xLabels).toEqual(x.axes.map(({ label }) => label))\\\\\\\\\\\\\\\\n    expect(result.project.grid.yLabels).toEqual(y.axes.map(({ label }) => label))\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n--- vitest.config.ts\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { readFileSync } from 'node:fs'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { fileURLToPath } from 'node:url'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport react from '@vitejs/plugin-react'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { defineConfig } from 'vitest/config'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst yamlRawPlugin = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  name: 'yaml-raw',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  load(id: string) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const path = id.split('?', 1)[0]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    if (!path.endsWith('.yaml')) return null\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return `export default ${JSON.stringify(readFileSync(path, 'utf8'))}`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst aliases = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  '@': fileURLToPath(new URL('./src', import.meta.url)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nexport default defineConfig({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  resolve: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    alias: aliases,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  test: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    projects: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        plugins: [yamlRawPlugin],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        resolve: { alias: aliases },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        test: {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          name: 'domain',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          environment: 'node',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          include: [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            'src/domain/**/*.test.ts',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            'src/rulepack/**/*.test.ts',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            'src/app/api/**/*.test.ts', // API ?쇱슦?몃뒗 node ?섍꼍 (oncall alert ?몃뱾??\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            'tests/**/*.test.ts',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n            'evals/harness/**/*.test.ts',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\