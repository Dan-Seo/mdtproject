sed.issues).toEqual([])\r\n  const actualsByExpected = golden.elevations.map((expected) => {\r\n    const titles = titlesOf(expected)\r\n    expect(titles).not.toEqual([])\r\n    return titles.map((title) => elevationForTitle(parsed, title))\r\n  })\r\n  const actuals = actualsByExpected.flat()\r\n\r\n  // 모든 파서 계열은 골든 항목에서 청구되어야 한다. 골든 여러 항목이\r\n  // 하나의 계열을 공유하는 경우(예: karatsu X3·X4)도 허용하되,\r\n  // 파서만의 미청구 계열은 허용하지 않는다.\r\n  expect(new Set(parsed.elevations)).toEqual(new Set(actuals))\r\n\r\n  for (const [index, expected] of golden.elevations.entries()) {\r\n    const expectedActuals = actualsByExpected[index]!\r\n    expect(new Set(expectedActuals)).toEqual(new Set([expectedActuals[0]]))\r\n\r\n    const actual = expectedActuals[0]!\r\n    const expectedHeights = expected.heightsMm ?? golden.heightsMm\r\n    const expectedLabels = expected.levels ?? golden.levelTexts\r\n    expect(expectedHeights).toBeDefined()\r\n    expect(expectedLabels).toBeDefined()\r\n    expect(actual.heightsMm).toEqual(expectedHeights)\r\n    expect(labelsByLevel(actual)).toEqual(\r\n      expectedLabels!.map((label) => [label]),\r\n    )\r\n  }\r\n\r\n  return actualsByExpected\r\n}\r\n\r\ndescribe('階高 corpus 2 골든', () => {\n  it('karatsu: 골든의 모든 제목 항목을 대응 계열의 높이·레벨 라벨과 대조한다', () => {\r\n    const actualsByExpected = expectCorpus2Elevations(\r\n      'karatsu-jikugumi1-p1.json',\r\n      'karatsu-jikugumi1-p1-elevation.json',\r\n    )\r\n\r\n    // 골든의 X3·X4 항목은 도면의 같은 치수 열을 공유하므로 하나의\r\n    // 파서 계열로 묶여야 한다. 이 관계를 골든 순서에서 직접 검증한다.\r\n    expect(actualsByExpected[1]?.[0]).toBe(actualsByExpected[2]?.[0])\r\n  })\r\n\r\n  it('tsu: p21의 모든 제목 계열을 전체 골든 높이·레벨 라벨과 대조한다', () => {\r\n    expectCorpus2Elevations(\r\n      'tsu-p21.json',\r\n      'tsu-kanritou-p21-elevation.json',\r\n    )\r\n  })\r\n\r\n  it('tsu: p22의 모든 제목 계열을 전체 골든 높이·레벨 라벨과 대조한다', () => {\r\n    expectCorpus2Elevations(\r\n      'tsu-p22.json',\r\n      'tsu-kanritou-p22-elevation.json',\r\n    )\r\n  })\r\n\r\n  it('hirosaki: 골든의 모든 제목 계열을 높이·레벨 라벨과 대조한다', () => {\n    expectCorpus2Elevations(\n      'hirosaki-p25.json',\n      'hirosaki-kikyono-p25-elevation.json',\n    )\n  })\n\n  it('levels가 있으면 levelTexts와 순서·접두사 관계를 대조한다', () => {\n    let checked = 0\n\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      if (golden.levels === undefined) continue\n\n      expect(golden.levelTexts).toBeDefined()\n      expect(golden.levels).toHaveLength(golden.levelTexts!.length)\n      golden.levels.forEach((level, index) => {\n        expect(golden.levelTexts![index]!.startsWith(level)).toBe(true)\n      })\n      checked += 1\n    }\n\n    expect(checked).toBeGreaterThan(0)\n  })\n})\n\ndescribe('軸組図·伏図 axis 골든 상호검증', () => {\n  it('모든 골든의 axis가 라벨·스팬·합계에 대해 자기 정합성을 갖는다', () => {\n    let axisCount = 0\n\n    for (const file of goldenFiles('-grid.json')) {\n      const golden = readGridGolden(file)\n      for (const block of golden.blocks) {\n        for (const axis of [block.x, block.y]) {\n          expectAxisSelfConsistent(axis)\n          axisCount += 1\n        }\n      }\n    }\n\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      for (const elevation of golden.elevations) {\n        if (elevation.axis === undefined) continue\n        expectAxisSelfConsistent(elevation.axis)\n        axisCount += 1\n      }\n    }\n\n    expect(axisCount).toBeGreaterThan(0)\n  })\n\n  it('levelsBottom·heightsBottomMm이 있으면 전체 계열의 꼬리와 일치한다', () => {\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      for (const elevation of golden.elevations) {\n        if (elevation.levelsBottom !== undefined) {\n          expect(elevation.levels).toBeDefined()\n          if (elevation.levels !== undefined) {\n            expect(elevation.levelsBottom).toEqual(\n              elevation.levels.slice(\n                elevation.levels.length - elevation.levelsBottom.length,\n              ),\n            )\n          }\n        }\n\n        if (elevation.heightsBottomMm !== undefined) {\n          expect(elevation.heightsMm).toBeDefined()\n          if (elevation.heightsMm !== undefined) {\n            expect(elevation.heightsBottomMm).toEqual(\n              elevation.heightsMm.slice(\n                elevation.heightsMm.length -\n                  elevation.heightsBottomMm.length,\n              ),\n            )\n          }\n        }\n      }\n    }\n  })\n\n  it.each(AXIS_CROSSCHECKS)(\n    '$elevationFile의 axis가 $gridFile의 $axis 축 부분열이다',\n    ({ elevationFile, gridFile, axis }) => {\n      const elevationGolden = readGolden(elevationFile)\n      const gridGolden = readGridGolden(gridFile)\n      const gridAxis = gridGolden.blocks[0]?.[axis]\n      expect(gridAxis).toBeDefined()\n      if (gridAxis === undefined) return\n\n      for (const elevation of elevationGolden.elevations) {\n        if (elevation.axis === undefined) continue\n        expect(\n          axisIsOrderedSubsequence(elevation.axis, gridAxis),\n        ).toBe(true)\n      }\n    },\n  )\n\n  it('axis 없는 elevation 항목은 건너뛰되 그 수가 3개로 고정된다', () => {\n    let skippedAxisCount = 0\n\n    for (const file of goldenFiles('-elevation.json')) {\n      const golden = readGolden(file)\n      for (const elevation of golden.elevations) {\n        if (elevation.axis === undefined) skippedAxisCount += 1\n      }\n    }\n\n    expect(skippedAxisCount).toBe(3)\n  })\n})\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json -Encoding utf8 -Raw; Get-Content tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json -Encoding utf8 -Raw; Get-Content tests/fixtures/plan-import/expected/tsu-kanritou-p22-elevation.json -Encoding utf8 -Raw'","aggregated_output":"{\r\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래.\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-hirosaki-kikyono.pdf\",\r\n    \"sha256\": \"f4dfcfab190970d8df305ce53319b98efb17873b81e77462b112a89978135fa8\",\r\n    \"issuer\": \"青森県弘前市\",\r\n    \"project\": \"令和7年度 桔梗野小学校等複合施設新築工事(建築工事) 構造図1\",\r\n    \"sheet\": \"S-023 軸組図(1)\",\r\n    \"page\": 25,\r\n    \"transcribedAt\": \"2026-09-03\"\r\n  },\r\n  \"elevations\": [\r\n    {\r\n      \"title\": \"X1通り\",\r\n      \"levels\": [\r\n        \"RFL\",\r\n        \"PHFL\",\r\n        \"3FL\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        3400,\r\n        4000,\r\n        4000,\r\n        4500,\r\n        100,\r\n        2310\r\n      ],\r\n      \"axis\": {\r\n        \"labels\": [\r\n          \"Y1\",\r\n          \"Y2\",\r\n          \"Y3\",\r\n          \"Y4\",\r\n          \"Y5\",\r\n          \"Y6\",\r\n          \"Y7\"\r\n        ],\r\n        \"spansMm\": [\r\n          8000,\r\n          8000,\r\n          8000,\r\n          8000,\r\n          8000,\r\n          11000\r\n        ],\r\n        \"totalMm\": 51000\r\n      }\r\n    },\r\n    {\r\n      \"title\": \"X2通り\",\r\n      \"levels\": [\r\n        \"RFL\",\r\n        \"PHFL\",\r\n        \"3FL\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        3400,\r\n        4000,\r\n        4000,\r\n        4500,\r\n        100,\r\n        2310\r\n      ],\r\n      \"axis\": {\r\n        \"labels\": [\r\n          \"Y1\",\r\n          \"Y2\",\r\n          \"Y3\",\r\n          \"Y4\",\r\n          \"Y5\",\r\n          \"Y6\",\r\n          \"Y7\",\r\n          \"Y8\",\r\n          \"Y9\",\r\n          \"Y10\"\r\n        ],\r\n        \"spansMm\": [\r\n          8000,\r\n          8000,\r\n          8000,\r\n          8000,\r\n          8000,\r\n          11000,\r\n          8000,\r\n          8000,\r\n          8000\r\n        ],\r\n        \"totalMm\": 75000\r\n      },\r\n      \"note\": \"2026-09-03 수정(Claude, phase 37): 초판(150dpi)은 X2通り의 RFL을 놓쳤다. 원시 TextItem에 RFL@(94,289)·PHFL@(96,321)이 있고 그 간격 32pt는 X1通り의 RFL→PHFL 32pt(3,400mm)와 같다. 그래서 X2도 RFL부터 6구간이다. X3通り는 PHFL@(96,557) 위에 RFL이 없다.\"\r\n    },\r\n    {\r\n      \"title\": \"X3通り\",\r\n      \"levels\": [\r\n        \"PHFL\",\r\n        \"3FL\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        4000,\r\n        4000,\r\n        4500,\r\n        100,\r\n        2310\r\n      ],\r\n      \"axis\": {\r\n        \"labels\": [\r\n          \"Y1\",\r\n          \"Y2\",\r\n          \"Y3\",\r\n          \"Y4\",\r\n          \"Y5\",\r\n          \"Y6\",\r\n          \"Y7\",\r\n          \"Y8\",\r\n          \"Y9\",\r\n          \"Y10\"\r\n        ],\r\n        \"spansMm\": [\r\n          8000,\r\n          8000,\r\n          8000,\r\n          8000,\r\n          8000,\r\n          11000,\r\n          8000,\r\n          8000,\r\n          8000\r\n        ],\r\n        \"totalMm\": 75000\r\n      }\r\n    }\r\n  ],\r\n  \"notes\": [\r\n    \"GL→RFL 합계 16,000(X1通り), GL→PHFL 12,600(X2通り)가 별도로 적혀 있다\",\r\n    \"1FL은 設計GL의 100 위 — 1/100에서 2.8pt\",\r\n    \"Y10 바깥 2000·5,765 치수는 스팬이 아니다\"\r\n  ]\r\n}\r\n\r\n{\r\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다. 階高는 위→아래. 이 페이지는 아래쪽 레벨만 확정했다. 2026-09-05 수정(Claude, phase 38 step6 반증 후속): axis.labels에서 마지막 통り芯 X5가 빠져 있었다 — 라벨 4개에 스팬 4개로 「라벨=스팬+1」 불변식을 깨고 있었고, 같은 건물의 tsu-kanritou-p16-grid.json x축(X1..X5, 동일 스팬, 合計 22,000)과도 어긋났다. 원본 재확인: dwg-tsu-kanritou.pdf 21면은 軸組図 블록이 셋(Y1·Y2·Y3通り)이고 셋 다 전각 라벨 Ｘ１..Ｘ５ 다섯 개를 가진다(회전 페이지라 표시 좌우는 fitz y 내림차순 = X1→X5). 스팬 배열과 totalMm은 원본과 일치했으므로 라벨만 보정했다.\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-tsu-kanritou.pdf\",\r\n    \"sha256\": \"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\",\r\n    \"issuer\": \"三重県津市\",\r\n    \"project\": \"旧津市民プール跡地テニスコート整備工事 管理棟\",\r\n    \"sheet\": \"S-21 軸組図(1)\",\r\n    \"page\": 21,\r\n    \"transcribedAt\": \"2026-09-03\"\r\n  },\r\n  \"elevations\": [\r\n    {\r\n      \"title\": \"Y3通り軸組図 S=1/100\",\r\n      \"levels\": [\r\n        \"パラペット天端\",\r\n        \"RFL(水下)\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        600,\r\n        3500,\r\n        3500,\r\n        150,\r\n        1170\r\n      ],\r\n      \"levelsBottom\": [\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsBottomMm\": [\r\n        3500,\r\n        150,\r\n        1170\r\n      ],\r\n      \"axis\": {\r\n        \"labels\": [\r\n          \"X1\",\r\n          \"X2\",\r\n          \"X3\",\r\n          \"X4\",\r\n          \"X5\"\r\n        ],\r\n        \"spansMm\": [\r\n          5850,\r\n          5150,\r\n          7175,\r\n          3825\r\n        ],\r\n        \"totalMm\": 22000\r\n      },\r\n      \"levelsBottomNote\": \"phase 37의 부분 전사다. phase 38(2026-09-04)에서 300dpi 크롭(위 블록 clip x80-340 y100-320, 아래 블록 y590-810)을 다시 읽어 최상단 두 레벨까지 확정했고, levels·heightsMm이 전 계열이다. levelsBottom·heightsBottomMm은 그 전 계열의 뒤쪽 부분집합이라 그대로 참이다.\",\r\n      \"titles\": [\r\n        \"Y3通り軸組図 S=1/100\"\r\n      ]\r\n    },\r\n    {\r\n      \"titles\": [\r\n        \"Y1通り軸組図 S=1/100\",\r\n        \"Y2通り軸組図 S=1/100\"\r\n      ],\r\n      \"levels\": [\r\n        \"パラペット天端\",\r\n        \"RFL(水下)\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        600,\r\n        3500,\r\n        3500,\r\n        150,\r\n        1170\r\n      ],\r\n      \"note\": \"위 블록이다. 아래 블록(Y3)과 레벨 계열이 같다 — 300dpi 크롭 두 장에서 각각 읽었다. 通り芯 스팬은 이 블록에서 전사하지 않았다.\"\r\n    }\r\n  ],\r\n  \"notes\": [\r\n    \"2026-09-04 정정: 「2FL 위 최상단 레벨 라벨 미확정」은 해소됐다 — 300dpi 크롭에서 ▽パラペット天端·▽RFL(水下)와 그 사이 600을 읽었다. 7,750은 パラペット天端→設計GL의 合計(600+3500+3500+150)이고 스팬이 아니다\",\r\n    \"같은 열에 보조 레벨이 있다: 梁天端(水下) = 2FL−270, 1SL = 1FL와 같은 높이, 基礎梁天端·B.PL下端은 1FL 아래 20〜250\",\r\n    \"X1 왼쪽에 胴縁芯↔柱面 80 치수가 있다 — 스팬이 아니다. 용지 A1 /Rotate 90\",\r\n    \"위 블록(캡션 Y1·Y2)과 아래 블록(캡션 Y3)의 레벨 계열은 같다 — 두 크롭에서 각각 확인했다\"\r\n  ]\r\n}\r\n\r\n{\r\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 300dpi 크롭(clip x80-420 y100-330)과 표제란 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 階高는 위→아래 인접 레벨 사이 mm다. 이 면은 레벨 계열만 전사했다 — 通り芯 스팬은 전사하지 않았다.\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-tsu-kanritou.pdf\",\r\n    \"sha256\": \"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\",\r\n    \"issuer\": \"三重県津市\",\r\n    \"project\": \"旧津市民プール跡地テニスコート整備工事 管理棟\",\r\n    \"sheet\": \"S-22 軸組図(2)\",\r\n    \"page\": 22,\r\n    \"transcribedAt\": \"2026-09-04\"\r\n  },\r\n  \"notes\": [\r\n    \"S-21(軸組図(1))과 같은 레벨 계열이다 — 600·3,500·3,500·150·1,170\",\r\n    \"7,750은 パラペット天端→設計GL의 合計이고 스팬이 아니다\",\r\n    \"같은 열 오른쪽에 보조 레벨이 있다: 1SL·基礎梁天端·B.PL下端(1FL 아래 20〜250). 用紙 A1 1/100\"\r\n  ],\r\n  \"elevations\": [\r\n    {\r\n      \"titles\": [\r\n        \"X1通り軸組図 S=1/100\",\r\n        \"X2通り軸組図 S=1/100\",\r\n        \"X3通り軸組図 S=1/100\"\r\n      ],\r\n      \"levels\": [\r\n        \"パラペット天端\",\r\n        \"RFL(水下)\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        600,\r\n        3500,\r\n        3500,\r\n        150,\r\n        1170\r\n      ]\r\n    },\r\n    {\r\n      \"titles\": [\r\n        \"X4通り軸組図 S=1/100\",\r\n        \"X5通り軸組図 S=1/100\"\r\n      ],\r\n      \"levels\": [\r\n        \"パラペット天端\",\r\n        \"RFL(水下)\",\r\n        \"2FL\",\r\n        \"1FL\",\r\n        \"設計GL\",\r\n        \"基礎下端\"\r\n      ],\r\n      \"heightsMm\": [\r\n        600,\r\n        3500,\r\n        3500,\r\n        150,\r\n        1170\r\n      ]\r\n    }\r\n  ]\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
