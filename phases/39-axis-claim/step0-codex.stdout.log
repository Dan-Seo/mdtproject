{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport fitz, json, pathlib, unicodedata, re, subprocess\n\ndef center(b): return [round((b[0]+b[2])/2,2), round((b[1]+b[3])/2,2)]\ndef line_items(p):\n    out=[]\n    for bi,b in enumerate(p.get_text('dict')['blocks']):\n        for li,line in enumerate(b.get('lines',[])):\n            text=''.join(s.get('text','') for s in line.get('spans',[]))\n            if text.strip(): out.append({'block':bi,'line':li,'text':text,'bbox':tuple(line['bbox']),'center':center(line['bbox']),'dir':tuple(round(v,6) for v in line.get('dir',(0,0)))})\n    return out\n\n# A1/A2: independent raw PDF extraction on tsu page 21 (zero-based 20)\np=fitz.open('.cache/dwg-tsu-kanritou.pdf')[20]\nitems=line_items(p)\nlabels=[x for x in items if re.fullmatch(r'Ｘ[１２３４５]',x['text'])]\ntitles=[x for x in items if '通り軸組図' in x['text']]\nprint('A1 titles',[(x['text'],x['center']) for x in titles])\nprint('A1 labels',[(x['text'],x['center']) for x in labels])\n# group label columns by x/y drawing region, as observed from page geometry\nfor name,pred in [('Y1',lambda x:x['center'][0]<500 and x['center'][1]>700),('Y2',lambda x:x['center'][0]<500 and x['center'][1]<700),('Y3',lambda x:x['center'][0]>900)]:\n    g=sorted([x for x in labels if pred(x)],key=lambda x:x['center'][1],reverse=True)\n    print('A1',name,[(unicodedata.normalize('NFKC',x['text']),x['center']) for x in g])\nprint('A2 dims',[(x['text'],x['center'],x['dir']) for x in items if x['text'] in {'5,850','5,150','7,175','3,825','22,000'}])\n\n# A4: print expected and corresponding raw PDF text groups by known title/dimension region.\ndef expected_axis(path):\n    d=json.loads(pathlib.Path(path).read_text(encoding='utf-8'))\n    return [e['axis'] for e in d['elevations'] if 'axis' in e]\nprint('A4 expected karatsu',expected_axis('tests/fixtures/plan-import/expected/karatsu-jikugumi1-p1-elevation.json'))\nprint('A4 expected hirosaki',expected_axis('tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json'))\nfor path,pno in [('.cache/dwg-karatsu-jikugumi1.pdf',0),('.cache/dwg-hirosaki-kikyono.pdf',24)]:\n    it=line_items(fitz.open(path)[pno])\n    print('A4 source',path)\n    print(' titles',[(x['text'],x['center']) for x in it if '軸組図' in x['text']])\n    dims=[x for x in it if re.fullmatch(r'[0-9,]+',x['text'])]\n    # only report axis-range dimensions selected by known x/y bands\n    if 'karatsu' in path:\n        groups=[('X2',lambda x: x['center'][0]<350 and x['center'][1]<500),('X3',lambda x:x['center'][0]>600 and x['center'][1]>600),('X4',lambda x:x['center'][0]>600 and x['center'][1]<600)]\n        for name,pred in groups:\n            ls=[x for x in it if re.fullmatch(r'Ｙ[０１２３５６]',x['text']) and pred(x)]\n            ds=[x for x in it if re.fullmatch(r'[0-9,]+',x['text']) and pred(x) and x['center'][0]>250 and x['center'][0]<630]\n            print(' ',name,'labels',[unicodedata.normalize('NFKC',x['text']) for x in sorted(ls,key=lambda x:x['center'][1],reverse=True)],'dims',[x['text'] for x in sorted(ds,key=lambda x:x['center'][1],reverse=True)])\n    else:\n        groups=[('X1',lambda x:x['center'][0]<700 and x['center'][1]<300),('X2',lambda x:x['center'][0]<900 and x['center'][1]>300),('X3',lambda x:x['center'][0]<900 and x['center'][1]>700)]\n        for name,pred in groups:\n            ls=[x for x in it if re.fullmatch(r'Y(?:[1-9]|10)',x['text']) and pred(x)]\n            ds=[x for x in it if re.fullmatch(r'[0-9]+',x['text']) and pred(x) and x['center'][1]>200]\n            print(' ',name,'labels',[x['text'] for x in sorted(ls,key=lambda x:x['center'][0])],'dims',[x['text'] for x in sorted(ds,key=lambda x:x['center'][0])])\n\n# A3: all expected axis blocks and invariant count\nbase=pathlib.Path('tests/fixtures/plan-import/expected')\naxes=[]\nfor path in sorted(base.glob('*.json')):\n    d=json.loads(path.read_text(encoding='utf-8'))\n    for i,e in enumerate(d.get('elevations',[])):\n        if 'axis' in e: axes.append((str(path),f'elevations[{i}].axis',e['axis']))\n    for i,b in enumerate(d.get('blocks',[])):\n        for k in ('x','y'):\n            if k in b: axes.append((str(path),f'blocks[{i}].{k}',b[k]))\nviol=[{'path':p,'location':loc,'labels':len(a['labels']),'spans':len(a['spansMm'])} for p,loc,a in axes if len(a['labels']) \"'!= len(a['\"'spansMm'])+1]\nprint('A3 current',{'axis_blocks':len(axes),'violations':viol})\nold='tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json'\nold_d=json.loads(subprocess.check_output(['git','show','HEAD~1:'+old],text=True))\nold_a=old_d['elevations'][0]['axis']\nprint('A3 before',{'path':old,'labels':len(old_a['labels']),'spans':len(old_a['spansMm']),'violates':len(old_a['labels']) \"'!= len(old_a['\"'spansMm'])+1,'axis':old_a})\nprint('A3 after tsu',{'labels':len(json.loads(pathlib.Path(old).read_text(encoding='utf-8'))['elevations'][0]['axis']['labels']),'spans':len(json.loads(pathlib.Path(old).read_text(encoding='utf-8'))['elevations'][0]['axis']['spansMm'])})\n\n# A5 exact missing names from phase 38 report\nfor name in ['karatsu-jikugumi1-p38.json','hirosaki-jikugumi-p15.json','tsu-jikugumi-p21.json']:\n    cp=subprocess.run(['C:/Program Files/Git/usr/bin/find.exe','tests','-name',name],capture_output=True,text=True)\n    print('A5',name,repr(cp.stdout),cp.returncode)\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
