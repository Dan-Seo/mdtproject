{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'; @'\nimport json, re, subprocess, unicodedata\nfrom pathlib import Path\nimport fitz\n\nreport=json.loads(Path('phases/39-axis-claim/step0-report.json').read_text(encoding='utf-8'))\nassert report['verdict']=='not_refuted'\nassert [c['id'] for c in report['claims']]==['A1','A2','A3','A4','A5']\nassert all(c['holds'] is True for c in report['claims'])\nassert all(item['exists'] is True and Path(item['path']).is_file() for item in report['paths_verified'])\nassert all(item['exists'] is False and not Path(item['path']).exists() for item in report['paths_expected_absent'])\n\ndef rows(path, page_index):\n    page=fitz.open(path)[page_index]\n    out=[]\n    for b in page.get_text('rawdict')['blocks']:\n      for line in b.get('lines',[]):\n       for s in line.get('spans',[]):\n        text=''.join(c.get('c','') for c in s.get('chars',[]))\n        if text:\n          out.append((unicodedata.normalize('NFKC',text),s['bbox']))\n    return page,out\n\n# A1/A2: source PDF, not parser output.\npage, tsu=rows('.cache/dwg-tsu-kanritou.pdf',20)\nlabels=[(t,round((b[0]+b[2])/2,2),round((b[1]+b[3])/2,2)) for t,b in tsu if re.fullmatch(r'X[1-5]',t)]\nassert len(labels)==15 and page.rotation==90\nfor x in (471.41,952.43):\n    block=[t for t,xx,y in labels if abs(xx-x)<0.01 and ((x==471.41 and y>700) or (x==471.41 and y<700) or x==952.43)]\n    # x=471.41 contains two blocks; split below.\nassert len([t for t,x,y in labels if x==471.41 and y>700])==5\nassert len([t for t,x,y in labels if x==471.41 and y<700])==5\nassert len([t for t,x,y in labels if x==952.43])==5\nwant={'5,850','5,150','7,175','3,825','22,000'}\ndims=[t for t,b in tsu if t in want]\nassert dims.count('5,850')==3 and dims.count('5,150')==3 and dims.count('7,175')==3 and dims.count('3,825')==3 and dims.count('22,000')==3\nassert sum([5850,5150,7175,3825])==22000\n\n# A3: current expected goldens.\ndef axes(d):\n    out=[]\n    for e in d.get('elevations',[]):\n        if isinstance(e.get('axis'),dict): out.append(e['axis'])\n    for b in d.get('blocks',[]):\n        for k in ('x','y'):\n            if isinstance(b.get(k),dict): out.append(b[k])\n    return out\nall_axes=[]\nfor p in Path('tests/fixtures/plan-import/expected').glob('*.json'):\n    all_axes.extend(axes(json.loads(p.read_text(encoding='utf-8'))))\nassert len(all_axes)==23\nassert sum(len(a.get('labels',[])) \"'!= len(a.get('\"'spansMm',[]))+1 for a in all_axes)==0\nbefore=json.loads(subprocess.check_output(['git','show','bd5ae60\"'^:tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json'\"'],text=True))['elevations'][0]['axis']\nassert len(before['labels'])==4 and len(before['spansMm'])==4\ncurrent=json.loads(Path('tests/fixtures/plan-import/expected/tsu-kanritou-p21-elevation.json').read_text(encoding='utf-8'))['elevations'][0]['axis']\nassert current['labels']==['X1','X2','X3','X4','X5'] and len(current['spansMm'])==4\n\n# A4: selected rawdict coordinate bands and direct golden comparison.\nkaratsu_g=json.loads(Path('tests/fixtures/plan-import/expected/karatsu-jikugumi1-p1-elevation.json').read_text(encoding='utf-8'))\nhirosaki_g=json.loads(Path('tests/fixtures/plan-import/expected/hirosaki-kikyono-p25-elevation.json').read_text(encoding='utf-8'))\n# The relevant original-PDF bands are anchored by rawdict label x/y and dimension x/y.\npage,k=rows('.cache/dwg-karatsu-jikugumi1.pdf',0)\nfor expected, lx, yrange, dx, drange in [\n    (karatsu_g['elevations'][0],306.96,(150,500),281.72,(200,400)),\n    (karatsu_g['elevations'][1],639.42,(600,1060),614.18,(600,1040)),\n    (karatsu_g['elevations'][2],639.42,(100,550),614.18,(100,550)),\n]:\n    got_labels=[t for t,b in k if re.fullmatch(r'Y\\\\d+',t) and abs((b[0]+b[2])/2-lx)<0.02 and yrange[0]<(b[1]+b[3])/2<yrange[1]]\n    got_dims=[int(t.replace(',','')) for t,b in k if t.replace(',','').isdigit() and abs((b[0]+b[2])/2-dx)<0.02 and drange[0]<(b[1]+b[3])/2<drange[1]]\n    assert got_labels==expected['axis']['labels']\n    assert got_dims==expected['axis']['spansMm']\n    assert expected['axis']['totalMm'] is None\npage,h=rows('.cache/dwg-hirosaki-kikyono.pdf',24)\nfor expected, band in zip(hirosaki_g['elevations'], [(250,280),(500,540),(740,780)]):\n    got_labels=[t for t,b in h if re.fullmatch(r'Y\\\\d+',t) and band[0]<(b[1]+b[3])/2<band[1] and (b[0]+b[2])/2<900]\n    got_dims=[int(t.replace(',','')) for t,b in h if t.replace(',','').isdigit() and band[0]-40<(b[1]+b[3])/2<band[1]-5 and (b[0]+b[2])/2>180]\n    # Exclude non-axis dimensions by using the horizontal dimension row nearest the labels.\n    assert got_labels==expected['axis']['labels']\n    assert got_dims==expected['axis']['spansMm']\n\n# A5 exact command contract.\nfor name in ['karatsu-jikugumi1-p38.json','hirosaki-jikugumi-p15.json','tsu-jikugumi-p21.json']:\n    cp=subprocess.run(['bash','-lc',f'find tests -name \\\"{name}\\\"'],text=True,capture_output=True)\n    assert cp.returncode==0 and cp.stdout=='' and cp.stderr==''\nprint('AC PASS: report, source-PDF counts, before/after invariant, A4 golden comparisons, and A5 absence commands')\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
