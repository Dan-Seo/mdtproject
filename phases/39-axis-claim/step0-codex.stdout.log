{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'; @'\nimport fitz, json, unicodedata, re\nfrom pathlib import Path\n\n# Compact independent observation of the requested PDF regions.\ndef raw_spans(path, page_index):\n    page=fitz.open(path)[page_index]\n    rows=[]\n    for b in page.get_text('rawdict')['blocks']:\n      for line in b.get('lines',[]):\n       for s in line.get('spans',[]):\n        text=''.join(c.get('c','') for c in s.get('chars',[]))\n        if text:\n          bbox=s['bbox']; rows.append({'text':unicodedata.normalize('NFKC',text), 'bbox':bbox, 'dir':line.get('dir')})\n    return page,rows\n\npage, rows=raw_spans(Path('.cache/dwg-tsu-kanritou.pdf'),20)\nlabels=[]\nfor r in rows:\n  if re.fullmatch(r'X[1-5]',r['text']):\n    labels.append({'label':r['text'],'x':round((r['bbox'][0]+r['bbox'][2])/2,2),'y':round((r['bbox'][1]+r['bbox'][3])/2,2)})\nprint('A1',json.dumps({'pageIndex':20,'rotation':page.rotation,'dir':'(0,-1)','labels':labels},ensure_ascii=False))\n# Match dimensions by exact source text; show all occurrences to establish the repeated 3 blocks.\nwant={'5,850','5,150','7,175','3,825','22,000'}\nvals=[]\nfor r in rows:\n  if r['text'] in want:\n    vals.append({'text':r['text'],'x':round((r['bbox'][0]+r['bbox'][2])/2,2),'y':round((r['bbox'][1]+r['bbox'][3])/2,2)})\nprint('A2',json.dumps({'dimensions':vals},ensure_ascii=False))\n\nfor fn,pi in [('dwg-karatsu-jikugumi1.pdf',0),('dwg-hirosaki-kikyono.pdf',24)]:\n  page, rows=raw_spans(Path('.cache')/fn,pi)\n  labels=[]\n  for r in rows:\n    if re.fullmatch(r'Y\\\\d+',r['text']):\n      labels.append({'label':r['text'],'x':round((r['bbox'][0]+r['bbox'][2])/2,2),'y':round((r['bbox'][1]+r['bbox'][3])/2,2)})\n  dims=[]\n  for r in rows:\n    t=r['text'].replace(',','')\n    if t.isdigit() and len(t)>=4:\n      dims.append({'text':r['text'],'x':round((r['bbox'][0]+r['bbox'][2])/2,2),'y':round((r['bbox'][1]+r['bbox'][3])/2,2)})\n  print('A4-'+fn,json.dumps({'pageIndex':pi,'rotation':page.rotation,'axisLabelCandidates':labels,'dimensionCandidates':dims},ensure_ascii=False))\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
