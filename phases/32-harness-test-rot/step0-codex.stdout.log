ata)\r\n123:        loaded = ex.StepExecutor._read_json(p)\r\n124:        assert loaded == data\r\n125:\r\n126:    def test_save_ensures_ascii_false(self, tmp_path):\r\n127:        p = tmp_path / \"test.json\"\r\n128:        ex.StepExecutor._write_json(p, {\"한글\": \"테스트\"})\r\n129:        raw = p.read_text(encoding=\"utf-8\")\r\n130:        assert \"한글\" in raw\r\n131:        assert \"\\\\u\" not in raw\r\n132:\r\n133:    def test_save_indented(self, tmp_path):\r\n134:        p = tmp_path / \"test.json\"\r\n135:        ex.StepExecutor._write_json(p, {\"a\": 1})\r\n136:        raw = p.read_text(encoding=\"utf-8\")\r\n137:        assert \"\\n\" in raw\r\n138:\r\n139:    def test_load_nonexistent_raises(self, tmp_path):\r\n140:        with pytest.raises(FileNotFoundError):\r\n141:            ex.StepExecutor._read_json(tmp_path / \"nope.json\")\r\n142:\r\n143:\r\n144:# ---------------------------------------------------------------------------\r\n145:# _load_guardrails\r\n--- phase 13 relevant commit c709c22 ---\r\ncommit c709c22ef8b31dcdadef04a74d84ed68674c6579\r\nAuthor:     Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\r\nAuthorDate: Tue Aug 25 20:29:14 2026 +0900\r\nCommit:     Dan-Seo <310402442+Dan-Seo@users.noreply.github.com>\r\nCommitDate: Tue Aug 25 20:29:14 2026 +0900\r\n\r\n    feat(13-harness-fixes): step 0 — codex-invoke-io\r\n\r\ndiff --git a/scripts/execute.py b/scripts/execute.py\r\nindex 28c7e3d..f10e5a2 100644\r\n--- a/scripts/execute.py\r\n+++ b/scripts/execute.py\r\n@@ -10,6 +10,7 @@ import argparse\r\n import contextlib\r\n import json\r\n import os\r\n+import signal\r\n import shutil\r\n import subprocess\r\n import sys\r\n@@ -23,6 +24,51 @@ from typing import Optional\r\n ROOT = Path(__file__).resolve().parent.parent\r\n \r\n \r\n+def run_codex_process(cmd, prompt, stdout_path, stderr_path, timeout_sec, cwd):\r\n+    \"\"\"Run a Codex command with file-backed output and whole-tree timeout cleanup.\"\"\"\r\n+    started = time.monotonic()\r