executor, tmp_project):\r\n158:        with patch.object(ex, \"ROOT\", tmp_project):\r\n159:            result = executor._load_guardrails()\r\n160:        assert \"---\" in result\r\n161:\r\n162:    def test_docs_sorted_alphabetically(self, executor, tmp_project):\r\n163:        with patch.object(ex, \"ROOT\", tmp_project):\r\n164:            result = executor._load_guardrails()\r\n165:        arch_pos = result.index(\"arch\")\r\n166:        guide_pos = result.index(\"guide\")\r\n167:        assert arch_pos < guide_pos\r\n168:\r\n169:    def test_no_agents_md(self, executor, tmp_project):\r\n170:        (tmp_project / \"AGENTS.md\").unlink()\r\n171:        with patch.object(ex, \"ROOT\", tmp_project):\r\n172:            result = executor._load_guardrails()\r\n173:        assert \"AGENTS.md\" not in result\r\n174:        assert \"Architecture\" in result\r\n175:\r\n176:    def test_no_docs_dir(self, executor, tmp_project):\r\n177:        import shutil\r\n178:        shutil.rmtree(tmp_project / \"docs\")\r\n179:        with patch.object(ex, \"ROOT\", tmp_project):\r\n180:            result = executor._load_guardrails()\r\n181:        assert \"Rules\" in result\r\n182:        assert \"Architecture\" not in result\r\n183:\r\n184:    def test_empty_project(self, tmp_path):\r\n185:        with patch.object(ex, \"ROOT\", tmp_path):\r\n186:            # executor가 필요 없는 static-like 동작이므로 임시 인스턴스\r\n187:            phases_dir = tmp_path / \"phases\" / \"dummy\"\r\n188:            phases_dir.mkdir(parents=True)\r\n189:            idx = {\"project\": \"T\", \"phase\": \"t\", \"steps\": []}\r\n190:            (phases_dir / \"index.json\").write_text(json.dumps(idx))\r\n191:            inst = ex.StepExecutor.__new__(ex.StepExecutor)\r\n192:            result = inst._load_guardrails()\r\n193:        assert result == \"\"\r\n194:\r\n195:\r\n196:# ---------------------------------------------------------------------------\r\n197:# _build_step_context\r\n198:# ---------------------------------------------------------------------------\r\n199:\r\n200:class TestBuildStepContext:\r\n--- test_execute invocation 420-525 ---\r\n420:\r\n421:\r\n422:# ---------------------------------------------------------------------------\r\n423:# _invoke_codex (mocked)\r\n424:# ---------------------------------------------------------------------------\r\n425:\r\n426:class TestInvokeCodex:\r\n427:    def test_invokes_codex_with_correct_args(self, executor):\r\n428:        mock_result = MagicMock(returncode=0, stdout='{\"result\": \"ok\"}', stderr=\"\")\r\n429:        step = {\"step\": 2, \"name\": \"ui\"}\r\n430:\r\n431:        with patch(\"subprocess.run\", return_value=mock_result) as mock_run:\r\n432:            executor._invoke_codex(step, \"PREAMBLE\\n\")\r\n433:\r\n434:        cmd = mock_run.call_args[0][0]\r\n435:        assert os.path.basename(cmd[0]).lower().startswith(\"codex\")\r\n436:        assert cmd[1] == \"exec\"\r\n437:        assert \"--dangerously-bypass-approvals-and-sandbox\" in cmd\r\n438:        assert \"--json\" in cmd\r\n439:\r\n440:    def test_resolves_executable_through_pathext(self, executor):\r\n441:        \"\"\"Windows에서 codex는 npm이 깐 셔뱅(codex.CMD)이다. CreateProcess는 PATHEXT를\r\n442:        적용하지 않으므로 이름만 넘기면 FileNotFoundError로 죽는다.\"\"\"\r\n443:        mock_result = MagicMock(returncode=0, stdout=\"{}\", stderr=\"\")\r\n444:        step = {\"step\": 2, \"name\": \"ui\"}\r\n445:        resolved = r\"C:\\Users\\x\\AppData\\Roaming\\npm\\codex.CMD\"\r\n446:\r\n447:        with patch(\"shutil.which\", return_value=resolved) as mock_which, \\\r\n448:             patch(\"subprocess.run\", return_value=mock_result) as mock_run:\r\n449:            executor._invoke_codex(step, \"preamble\")\r\n450:\r\n451:        mock_which.assert_called_once_with(\"codex\")\r\n452:        assert mock_run.call_args[0][0][0] == resolved\r\n453:\r\n454:    def test_falls_back_to_bare_name_when_not_resolvable(self, executor):\r\n455:        \"\"\"PATH에 없으면 이름 그대로 넘겨 codex가 없다는 에러가 그대로 드러나게 한다.\"\"\"\r\n456:        mock_result = MagicMock(returncode=0, stdout=\"{}\", stderr=\"\")\r\n457:        step = {\"step\": 2, \"name\": \"ui\"}\r\n458:\r\n459:        with patch(\"shutil.which\", return_value=None), \\\r\n460:             patch(\"subprocess.run\", return_value=mock_result) as mock_run:\r\n461:            executor._invoke_codex(step, \"preamble\")\r\n462:\r\n463:        assert mock_run.call_args[0][0][0] == \"codex\"\r\n464:\r\n465:    def test_hooks_are_not_skipped(self, executor):\r\n466:        \"\"\".codex/hooks.json은 파일이 바뀔 때마다 untrusted로 돌아간다.\r\n467:        trust를 우회하지 않으면 하네스 실행에서 TDD 가드가 조용히 안 걸린다.\"\"\"\r\n468:        mock_result = MagicMock(returncode=0, stdout=\"{}\", stderr=\"\")\r\n469:        step = {\"step\": 2, \"name\": \"ui\"}\r\n470:\r\n471:        with patch(\"subprocess.run\", return_value=mock_result) as mock_run:\r\n472:            executor._invoke_codex(step, \"preamble\")\r\n473:\r\n474:        assert \"--dangerously-bypass-hook-trust\" in mock_run.call_args[0][0]\r\n475:\r\n476:    def test_prompt_goes_through_stdin(self, executor):\r\n477:        \"\"\"가드레일(AGENTS.md + docs/*.md)이 수만 자라 argv로는 Windows 길이 제한에 걸린다.\"\"\"\r\n478:        mock_result = MagicMock(returncode=0, stdout=\"{}\", stderr=\"\")\r\n479:        step = {\"step\": 2, \"name\": \"ui\"}\r\n480:\r\n481:        with patch(\"subprocess.run\", return_value=mock_result) as mock_run:\r\n482:            executor._invoke_codex(step, \"PREAMBLE\\n\")\r\n483:\r\n484:        cmd = mock_run.call_args[0][0]\r\n485:        assert cmd[-1] == \"-\"\r\n486:        stdin_text = mock_run.call_args[1][\"input\"]\r\n487:        assert \"PREAMBLE\" in stdin_text\r\n488:        assert \"UI를 구현하세요\" in stdin_text\r\n489:\r\n490:    def test_saves_output_json(self, executor):\r\n491:        mock_result = MagicMock(returncode=0, stdout='{\"ok\": true}', stderr=\"\")\r\n492:        step = {\"step\": 2, \"name\": \"ui\"}\r\n493:\r\n494:        with patch(\"subprocess.run\", return_value=mock_result):\r\n495:            executor._invoke_codex(step, \"preamble\")\r\n496:\r\n497:        output_file = executor._phase_dir / \"step2-output.json\"\r\n498:        assert output_file.exists()\r\n499:        data = json.loads(output_file.read_text(encoding=\"utf-8\"))\r\n500:        assert data[\"step\"] == 2\r\n501:        assert data[\"name\"] == \"ui\"\r\n502:        assert data[\"exitCode\"] == 0\r\n503:\r\n504:    def test_nonexistent_step_file_exits(self, executor):\r\n505:        step = {\"step\": 99, \"name\": \"nonexistent\"}\r\n506:        with pytest.raises(SystemExit) as exc_info:\r\n507:            executor._invoke_codex(step, \"preamble\")\r\n508:        assert exc_info.value.code == 1\r\n509:\r\n510:    def test_timeout_is_1800(self, executor):\r\n511:        mock_result = MagicMock(returncode=0, stdout=\"{}\", stderr=\"\")\r\n512:        step = {\"step\": 2, \"name\": \"ui\"}\r\n513:\r\n514:        with patch(\"subprocess.run\", return_value=mock_result) as mock_run:\r\n515:            executor._invoke_codex(step, \"preamble\")\r\n516:\r\n517:        assert mock_run.call_args[1][\"timeout\"] == 1800\r\n518:\r\n519:\r\n520:# ---------------------------------------------------------------------------\r\n521:# progress_indicator (= 이전 Spinner)\r\n522:# ---------------------------------------------------------------------------\r\n523:\r\n524:class TestProgressIndicator:\r\n525:    def test_context_manager(self):\r\n--- execute_test 1-180 ---\r\n1:#!/usr/bin/env python3\r\n2:\"\"\"Regression tests for the harness process and artifact boundaries.\"\"\"\r\n3:\r\n4:import importlib.util\r\n5:import json\r\n6:import os\r\n7:import signal\r\n8:import subprocess\r\n9:import sys\r\n10:import tempfile\r\n11:import threading\r\n12:import time\r\n13:import unittest\r\n14:from pathlib import Path\r\n15:from unittest import mock\r\n16:\r\n17:\r\n18:SCRIPT_DIR = Path(__file__).resolve().parent\r\n19:SPEC = importlib.util.spec_from_file_location(\"execute\", SCRIPT_DIR / \"execute.py\")\r\n20:if SPEC is None or SPEC.loader is None:\r\n21:    raise RuntimeError(\"could not load scripts/execute.py\")\r\n22:execute = importlib.util.module_from_spec(SPEC)\r\n23:SPEC.loader.exec_module(execute)\r\n24:\r\n25:\r\n26:def pid_alive(pid: int) -> bool:\r\n27:    if os.name == \"nt\":\r\n28:        # tasklist는 콘솔 코드페이지(cp949 등)로 출력한다 — 특히 해당 PID가 없을 때의\r\n29:        # 한국어 안내문이 UTF-8 strict 디코드를 깨뜨린다. 찾는 토큰은 ASCII이므로\r\n30:        # 디코드 없이 바이트로 비교한다.\r\n31:        result = subprocess.run(\r\n32:            [\"tasklist\", \"/FI\", f\"PID eq {pid}\", \"/FO\", \"CSV\", \"/NH\"],\r\n33:            capture_output=True,\r\n34:            check=False,\r\n35:        )\r\n36:        return f'\"{pid}\"'.encode(\"ascii\") in result.stdout\r\n37:\r\n38:    try:\r\n39:        os.kill(pid, 0)\r\n40:    except ProcessLookupError:\r\n41:        return False\r\n42:    except PermissionError:\r\n43:        return True\r\n44:    return True\r\n45:\r\n46:\r\n47:def kill_pid(pid: int) -> None:\r\n48:    if not pid_alive(pid):\r\n49:        return\r\n50:    if os.name == \"nt\":\r\n51:        subprocess.run(\r\n52:            [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)],\r\n53:            capture_output=True,\r\n54:            check=False,\r\n55:        )\r\n56:        return\r\n57:    try:\r\n58:        os.kill(pid, signal.SIGKILL)\r\n59:    except ProcessLookupError:\r\n60:        pass\r\n61:\r\n62:\r\n63:def wait_for_dead(pids: list[int], timeout: float = 5.0) -> None:\r\n64:    deadline = time.monotonic() + timeout\r\n65:    while time.monotonic() < deadline:\r\n66:        if all(not pid_alive(pid) for pid in pids):\r\n67:            return\r\n68:        time.sleep(0.05)\r\n69:\r\n70:\r\n71:class RunCodexProcessTests(unittest.TestCase):\r\n72:    def test_normal_path_writes_stdout_and_stderr_to_logs(self) -> None:\r\n73:        with tempfile.TemporaryDirectory() as temp_dir:\r\n74:            root = Path(temp_dir)\r\n75:            stdout_path = root / \"stdout.log\"\r\n76:            stderr_path = root / \"stderr.log\"\r\n77:            result = execute.run_codex_process(\r\n78:                [\r\n79:                    sys.executable,\r\n80:                    \"-c\",\r\n81:                    (\r\n82:                        \"import sys; value = sys.stdin.read(); \"\r\n83:                        \"print('stdout:' + value); \"\r\n84:                        \"print('stderr:' + value, file=sys.stderr)\"\r\n85:                    ),\r\n86:                ],\r\n87:                \"hello\",\r\n88:                stdout_path,\r\n89:                stderr_path,\r\n90:                10,\r\n91:                root,\r\n92:            )\r\n93:\r\n94:            self.assertEqual(result[\"exitCode\"], 0)\r\n95:            self.assertFalse(result[\"timedOut\"])\r\n96:            self.assertIn(\"stdout:hello\", stdout_path.read_text(encoding=\"utf-8\"))\r\n97:            self.assertIn(\"stderr:hello\", stderr_path.read_text(encoding=\"utf-8\"))\r\n98:\r\n99:    def test_timeout_kills_child_and_grandchild_without_hanging(self) -> None:\r\n100:        with tempfile.TemporaryDirectory() as temp_dir:\r\n101:            root = Path(temp_dir)\r\n102:            child_pid_path = root / \"child.pid\"\r\n103:            grandchild_pid_path = root / \"grandchild.pid\"\r\n104:            stdout_path = root / \"stdout.log\"\r\n105:            stderr_path = root / \"stderr.log\"\r\n106:            child_code = (\r\n107:                \"import os, subprocess, sys, time; \"\r\n108:                \"print('child-started', flush=True); \"\r\n109:                \"open(sys.argv[1], 'w', encoding='utf-8').write(str(os.getpid())); \"\r\n110:                \"grandchild = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(300)']); \"\r\n111:                \"open(sys.argv[2], 'w', encoding='utf-8').write(str(grandchild.pid)); \"\r\n112:                \"time.sleep(300)\"\r\n113:            )\r\n114:            result_holder: dict[str, object] = {}\r\n115:\r\n116:            def invoke() -> None:\r\n117:                try:\r\n118:                    result_holder[\"result\"] = execute.run_codex_process(\r\n119:                        [\r\n120:                            sys.executable,\r\n121:                            \"-c\",\r\n122:                            child_code,\r\n123:                            str(child_pid_path),\r\n124:                            str(grandchild_pid_path),\r\n125:                        ],\r\n126:                        \"\",\r\n127:                        stdout_path,\r\n128:                        stderr_path,\r\n129:                        3,\r\n130:                        root,\r\n131:                    )\r\n132:                except BaseException as error:  # pragma: no cover - assertion below reports it\r\n133:                    result_holder[\"error\"] = error\r\n134:\r\n135:            thread = threading.Thread(target=invoke)\r\n136:            thread.start()\r\n137:            pids: list[int] = []\r\n138:            try:\r\n139:                deadline = time.monotonic() + 10\r\n140:                while time.monotonic() < deadline:\r\n141:                    if child_pid_path.exists() and grandchild_pid_path.exists():\r\n142:                        pids = [\r\n143:                            int(child_pid_path.read_text(encoding=\"utf-8\")),\r\n144:                            int(grandchild_pid_path.read_text(encoding=\"utf-8\")),\r\n145:                        ]\r\n146:                        break\r\n147:                    time.sleep(0.05)\r\n148:\r\n149:                thread.join(30)\r\n150:                self.assertFalse(thread.is_alive(), \"timeout handling hung after killing the parent\")\r\n151:                self.assertNotIn(\"error\", result_holder, result_holder.get(\"error\"))\r\n152:                result = result_holder[\"result\"]\r\n153:                self.assertIsInstance(result, dict)\r\n154:                self.assertTrue(result[\"timedOut\"])\r\n155:                self.assertTrue(pids, \"child PID files were not written\")\r\n156:                self.assertIn(\"child-started\", stdout_path.read_text(encoding=\"utf-8\"))\r\n157:                wait_for_dead(pids)\r\n158:                self.assertTrue(all(not pid_alive(pid) for pid in pids))\r\n159:            finally:\r\n160:                thread.join(timeout=1)\r\n161:                for pid_path in (child_pid_path, grandchild_pid_path):\r\n162:                    if pid_path.exists():\r\n163:                        try:\r\n164:                            pid = int(pid_path.read_text(encoding=\"utf-8\"))\r\n165:                        except ValueError:\r\n166:                            continue\r\n167:                        if pid not in pids:\r\n168:                            pids.append(pid)\r\n169:                for pid in pids:\r\n170:                    kill_pid(pid)\r\n171:\r\n172:\r\n173:class InvokeArtifactTests(unittest.TestCase):\r\n174:    def test_invoke_uses_new_artifact_names_and_does_not_write_output_json(self) -> None:\r\n175:        with tempfile.TemporaryDirectory() as temp_dir:\r\n176:            root = Path(temp_dir)\r\n177:            phase_dir = root / \"phases\" / \"t\"\r\n178:            phase_dir.mkdir(parents=True)\r\n179:            (phase_dir / \"index.json\").write_text(\r\n180:                json.dumps({\"project\": \"test\", \"phase\": \"t\", \"steps\": [{\"step\": 0, \"name\": \"sample\"}]}),\r\n--- test_stop_verify 1-120 ---\r\n1:\"\"\"\r\n2:hooks/stop-verify.sh 동작 테스트.\r\n3:\r\n4:Codex Stop 이벤트는 exit 0일 때 stdout이 JSON이어야 한다 (plain text는 invalid).\r\n5:npm 출력이 stdout으로 새지 않고, 실패 시에만 block JSON이 나오는지 검증한다.\r\n6:\"\"\"\r\n7:\r\n8:import json\r\n9:import shutil\r\n10:import subprocess\r\n11:from pathlib import Path\r\n12:\r\n13:import pytest\r\n14:\r\n15:HOOK = (Path(__file__).parent / \"hooks\" / \"stop-verify.sh\").as_posix()\r\n16:BASH = shutil.which(\"bash\")\r\n17:NPM = shutil.which(\"npm\")\r\n18:\r\n19:pytestmark = pytest.mark.skipif(BASH is None, reason=\"bash가 필요하다\")\r\n20:\r\n21:NOOP = \"node -e \\\"\\\"\"\r\n22:FAIL = \"node -e \\\"console.log('LINT_OUTPUT_MARKER'); process.exit(1)\\\"\"\r\n23:\r\n24:\r\n25:def run_hook(cwd: Path, *, stop_hook_active: bool = False):\r\n26:    payload = {\r\n27:        \"hook_event_name\": \"Stop\",\r\n28:        \"session_id\": \"thr_test\",\r\n29:        \"cwd\": str(cwd),\r\n30:        \"stop_hook_active\": stop_hook_active,\r\n31:    }\r\n32:    r = subprocess.run(\r\n33:        [BASH, HOOK], cwd=str(cwd),\r\n34:        input=json.dumps(payload), capture_output=True, text=True, encoding=\"utf-8\",\r\n35:    )\r\n36:    assert r.returncode == 0, f\"hook이 비정상 종료: {r.stderr}\"\r\n37:    return r\r\n38:\r\n39:\r\n40:def write_package_json(project: Path, lint: str, build: str, test: str):\r\n41:    (project / \"package.json\").write_text(\r\n42:        json.dumps({\"name\": \"t\", \"scripts\": {\"lint\": lint, \"build\": build, \"test\": test}}),\r\n43:        encoding=\"utf-8\",\r\n44:    )\r\n45:\r\n46:\r\n47:@pytest.fixture\r\n48:def project(tmp_path):\r\n49:    return tmp_path\r\n50:\r\n51:\r\n52:class TestSkips:\r\n53:    def test_no_package_json_is_silent(self, project):\r\n54:        \"\"\"스캐폴딩 전에는 검증 대상이 없다.\"\"\"\r\n55:        r = run_hook(project)\r\n56:        assert r.stdout.strip() == \"\"\r\n57:\r\n58:    def test_incomplete_scripts_is_silent(self, project):\r\n59:        \"\"\"package.json은 생겼지만 lint·build·test가 아직 다 없는 스캐폴딩 도중 구간.\"\"\"\r\n60:        (project / \"package.json\").write_text(\r\n61:            json.dumps({\"name\": \"t\", \"scripts\": {\"lint\": NOOP}}), encoding=\"utf-8\")\r\n62:        r = run_hook(project)\r\n63:        assert r.stdout.strip() == \"\"\r\n64:\r\n65:    def test_no_scripts_field_is_silent(self, project):\r\n66:        (project / \"package.json\").write_text('{\"name\": \"t\"}', encoding=\"utf-8\")\r\n67:        r = run_hook(project)\r\n68:        assert r.stdout.strip() == \"\"\r\n69:\r\n70:    def test_already_continued_is_silent(self, project):\r\n71:        \"\"\"stop_hook_active면 다시 이어붙이지 않는다 — 무한 루프 방지.\"\"\"\r\n72:        write_package_json(project, FAIL, NOOP, NOOP)\r\n73:        r = run_hook(project, stop_hook_active=True)\r\n74:        assert r.stdout.strip() == \"\"\r\n75:\r\n76:\r\n77:@pytest.mark.skipif(NPM is None, reason=\"npm이 필요하다\")\r\n78:class TestVerification:\r\n79:    def test_success_emits_nothing(self, project):\r\n80:        write_package_json(project, NOOP, NOOP, NOOP)\r\n81:        r = run_hook(project)\r\n82:        assert r.stdout.strip() == \"\"\r\n83:\r\n84:    def test_failure_emits_block_json(self, project):\r\n85:        write_package_json(project, FAIL, NOOP, NOOP)\r\n86:        r = run_hook(project)\r\n87:        out = json.loads(r.stdout)          # stdout은 반드시 유효한 JSON\r\n88:        assert out[\"decision\"] == \"block\"\r\n89:        assert out[\"reason\"]\r\n90:\r\n91:    def test_failure_reason_carries_npm_output(self, project):\r\n92:        write_package_json(project, FAIL, NOOP, NOOP)\r\n93:        out = json.loads(run_hook(project).stdout)\r\n94:        assert \"LINT_OUTPUT_MARKER\" in out[\"reason\"]\r\n95:\r\n96:    def test_stdout_never_leaks_plain_text(self, project):\r\n97:        \"\"\"npm 출력이 stdout으로 새면 Stop 이벤트에서 invalid로 처리된다.\"\"\"\r\n98:        write_package_json(project, NOOP, NOOP, NOOP)\r\n99:        r = run_hook(project)\r\n100:        assert \"npm\" not in r.stdout\r\n101:        if r.stdout.strip():\r\n102:            json.loads(r.stdout)\r\n--- stop hook 20-32 ---\r\n20:  exit 0\r\n21:fi\r\n22:\r\n23:ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\r\n24:\r\n25:# CI(GitHub Actions)에서는 검증을 걸지 않는다 — 리뷰·트리아지 잡의 체크아웃에는\r\n26:# node_modules가 없어 exit 127로만 끝나고, 결정적 검증은 verify 잡이 따로 한다.\r\n27:# 이 훅이 CI 에이전트를 붙잡으면 턴 소진으로 리뷰 게시가 유실된다 (PR #5에서 재현).\r\n28:if [ \"${CI:-}\" = \"true\" ] || [ ! -d \"$ROOT/node_modules\" ]; then\r\n29:  exit 0\r\n30:fi\r\n31:\r\n32:# 스캐폴딩 도중에는 게이트를 걸지 않는다. 걸면 M0~M1 내내 매 턴이 막힌다.\r\n--- ci workflow pytest region ---\r\n72:\r\n73:      - run: npm ci\r\n74:      - run: npm run lint\r\n75:      - run: npm run typecheck\r\n76:      - run: npm test\r\n77:\r\n78:      # 게이트·리뷰 파이프라인의 결정적 검증. npm test 는 vitest 라 node:test 로 쓴\r\n79:      # .claude/workflows/review-code.test.js 도, scripts/ci/*.spec.sh 도 잡지 않는다 —\r\n80:      # 자동 승인·머지를 좌우하는 코드가 CI 에서 한 번도 안 돌고 있었다 (PR #41 리뷰의 major).\r\n81:      - run: npm run test:ci-scripts\r\n82:\r\n83:      # 머지 게이트 판정의 상세 실패 모드(커밋 불일치·작성자 위조·마커 파손·다중 마커)는\r\n84:      # pytest 가 덮고 review-verdict.spec.sh 는 계약의 뼈대만 본다. 여기에 연결하지 않으면\r\n85:      # fail-closed 경로가 회귀해도 CI 가 초록으로 지나간다 (PR #41 4차 리뷰의 major).\r\n86:      - uses: actions/setup-python@v5\r\n87:        with:\r\n88:          python-version: '3.13'\r\n89:      - run: pip install --quiet pytest\r\n90:      - run: python -m pytest scripts/test_review_verdict.py -q\r\n91:      - run: npm run build\r\n92:      # three が `/` の遮断経路に戻っていないか (ADR-024 §5)。Lighthouse 予算は\r\n93:      # これを通してしまう — 転送量が動かないからだ。build 直後にしか見られない。\r\n94:      - run: node scripts/perf/blocking-graph.mjs\r\n95:\r\n96:      # 브라우저 실측 회귀 게이트. PR CI(review.yml의 verify)에는 넣지 않는다 — PR은\r\n97:      # 그대로 빠르게 두고, 회귀는 머지 후 여기서 잡아 oncall이 깨어나게 한다.\r\n98:      # 예산과 그 근거는 lighthouserc.cjs에 있다. 게이트는 러너 속도와 무관한 값에만 걸려 있다.\r\n99:      # 별도 워크플로로 빼지 않는 이유: oncall.yml이 `workflow_run: [ci]`만 보므로\r\n100:      # 여기 있어야 회귀가 사고 대응으로 이어진다.\r\n--- review workflow pytest region ---\r\n168:      - run: npm ci\r\n169:      - run: npm run lint\r\n170:      - run: npm run typecheck\r\n171:      - run: npm test\r\n172:\r\n173:      # 게이트·리뷰 파이프라인의 결정적 검증. npm test 는 vitest 라 node:test 로 쓴\r\n174:      # .claude/workflows/review-code.test.js 도, scripts/ci/*.spec.sh 도 잡지 않는다 —\r\n175:      # 자동 승인·머지를 좌우하는 코드가 CI 에서 한 번도 안 돌고 있었다 (PR #41 리뷰의 major).\r\n176:      - run: npm run test:ci-scripts\r\n177:\r\n178:      # 머지 게이트 판정의 상세 실패 모드(커밋 불일치·작성자 위조·마커 파손·다중 마커)는\r\n179:      # pytest 가 덮고 review-verdict.spec.sh 는 계약의 뼈대만 본다. 여기에 연결하지 않으면\r\n180:      # fail-closed 경로가 회귀해도 CI 가 초록으로 지나간다 (PR #41 4차 리뷰의 major).\r\n181:      - uses: actions/setup-python@v5\r\n182:        with:\r\n183:          python-version: '3.13'\r\n184:      - run: pip install --quiet pytest\r\n185:      - run: python -m pytest scripts/test_review_verdict.py -q\r\n186:      - run: npm run build\r\n187:      # three が `/` の遮断経路に戻っていないか (ADR-024 §5)。Lighthouse 予算は\r\n188:      # これを通してしまう — 転送量が動かないからだ。build 直後にしか見られない。\r\n189:      - run: node scripts/perf/blocking-graph.mjs\r\n190:\r\n191:  # 리뷰가 남긴 게이트 마커로 승인·머지를 결정한다.\r\n192:  # 리뷰 잡과 분리한 이유는 권한이다 — 머지 권한(contents: write)을 LLM 잡에 주지 않는다.\r\n193:  # 알고 남기는 한계 — 이 게이트는 자기 자신을 지키지 못한다.\r\n194:  # `pull_request` 이벤트의 워크플로는 base 가 아니라 **PR 브랜치의 파일**로 실행된다\r\n--- oncall workflow pytest region ---\r\n218:          else\r\n219:            echo \"changed=false\" >> \"$GITHUB_OUTPUT\"\r\n220:          fi\r\n221:\r\n222:      - name: 수정 재검증\r\n223:        id: verify\r\n224:        if: steps.changes.outputs.changed == 'true'\r\n225:        continue-on-error: true # 검증 실패도 PR 본문에 기록하고 PR은 연다\r\n226:        # ci.yml verify 잡의 실패 게이트를 같은 순서로 그대로 밟는다. 넷만 돌리던 때는\r\n227:        # test:ci-scripts·pytest·lighthouse 로 깨진 main 에 「✅ 통과」를 단 PR 이 열렸다 —\r\n228:        # 정작 깨진 게이트를 한 번도 다시 돌리지 않은 채였다.\r\n229:        # ci.yml 에 게이트를 추가하면 여기에도 같이 추가할 것.\r\n230:        run: |\r\n231:          npm run lint\r\n232:          npm run typecheck\r\n233:          npm test\r\n234:          npm run test:ci-scripts\r\n235:          python -m pytest scripts/test_review_verdict.py -q\r\n236:          npm run build\r\n237:          npm run lighthouse\r\n238:\r\n239:      - name: 제목·본문 구성\r\n240:        id: body\r\n241:        env:\r\n242:          CHANGED: ${{ steps.changes.outputs.changed }}\r\n--- package scripts ---\r\n{\r\n    \"dev\":  \"next dev\",\r\n    \"build\":  \"next build\",\r\n    \"lint\":  \"eslint .\",\r\n    \"typecheck\":  \"tsc --noEmit\",\r\n    \"test\":  \"vitest run\",\r\n    \"test:golden\":  \"vitest run tests/golden\",\r\n    \"rulepack:review-sheet\":  \"tsx scripts/rulepack/review-sheet.ts\",\r\n    \"lighthouse\":  \"lhci autorun --config=lighthouserc.cjs\",\r\n    \"perf:measure\":  \"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\",\r\n    \"eval\":  \"tsx --env-file-if-exists=.env evals/harness/run.ts\",\r\n    \"test:hooks\":  \"bash scripts/hooks/tdd-guard.spec.sh\",\r\n    \"hooks:install\":  \"git config core.hooksPath scripts/githooks\",\r\n    \"test:ci-scripts\":  \"bash scripts/ci/scrub-secrets.spec.sh \\u0026\\u0026 bash scripts/ci/review-scope.spec.sh \\u0026\\u0026 bash scripts/ci/review-carryforward.spec.sh \\u0026\\u0026 bash scripts/ci/review-verdict.spec.sh \\u0026\\u0026 bash scripts/ci/distill-failure-log.spec.sh \\u0026\\u0026 node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts/perf/blocking-graph.test.mjs\"\r\n}\r\n","exit_code":0,"status":"completed"}}
