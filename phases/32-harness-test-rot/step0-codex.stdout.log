    outcome = choices[min(attempt, len(choices) - 1)]\r\n220:        index = self._read_json(self._index_file)\r\n221:        for candidate in index[\"steps\"]:\r\n222:            if candidate[\"step\"] == step_num:\r\n223:                candidate[\"status\"] = outcome[\"status\"]\r\n224:                if \"summary\" in outcome:\r\n225:                    candidate[\"summary\"] = outcome[\"summary\"]\r\n226:                if \"error_message\" in outcome:\r\n227:                    candidate[\"error_message\"] = outcome[\"error_message\"]\r\n228:        self._write_json(self._index_file, index)\r\n229:        return {\"step\": step_num}\r\n230:\r\n231:\r\n232:def make_harness_fixture(root: Path, steps: list[dict], *, top_index: bool = False) -> None:\r\n233:    phase_dir = root / \"phases\" / \"fixture\"\r\n234:    phase_dir.mkdir(parents=True)\r\n235:    (phase_dir / \"index.json\").write_text(\r\n236:        json.dumps({\"project\": \"test\", \"phase\": \"fixture\", \"steps\": steps}),\r\n237:        encoding=\"utf-8\",\r\n238:    )\r\n239:    for step in steps:\r\n240:        (phase_dir / f\"step{step['step']}.md\").write_text(\"test prompt\", encoding=\"utf-8\")\r\n241:    if top_index:\r\n242:        (root / \"phases\" / \"index.json\").write_text(\r\n243:            json.dumps({\"phases\": [{\"dir\": \"fixture\", \"status\": \"pending\"}]}),\r\n244:            encoding=\"utf-8\",\r\n245:        )\r\n246:    subprocess.run([\"git\", \"init\"], cwd=root, capture_output=True, check=True)\r\n247:    subprocess.run([\"git\", \"config\", \"user.name\", \"Test\"], cwd=root, check=True)\r\n248:    subprocess.run([\"git\", \"config\", \"user.email\", \"test@example.com\"], cwd=root, check=True)\r\n249:\r\n250:\r\n251:class RefutedProtocolTests(unittest.TestCase):\r\n252:    def test_gate_refuted_stops_before_next_pending_step(self) -> None:\r\n253:        with tempfile.TemporaryDirectory() as temp_dir:\r\n254:            root = Path(temp_dir)\r\n255:            steps = [\r\n256:                {\"step\": 0, \"name\": \"gate\", \"kind\": \"verify\", \"gate\": True, \"status\": \"pending\"},\r\n257:                {\"step\": 1, \"name\": \"implementation\", \"status\": \"pending\"},\r\n258:            ]\r\n259:            make_harness_fixture(root, steps)\r\n260:            executor = FakeStepExecutor(\r\n261:                \"fixture\",\r\n262:                {\r\n263:                    0: [{\"status\": \"refuted\", \"summary\": \"전제가 반증됨\"}],\r\n264:                    1: [{\"status\": \"completed\", \"summary\": \"구현 완료\"}],\r\n265:                },\r\n266:                root=root,\r\n267:            )\r\n268:\r\n269:            executor._execute_all_steps(\"guards\")\r\n270:\r\n--- execute.py 27-70 ---\r\n27:def run_codex_process(cmd, prompt, stdout_path, stderr_path, timeout_sec, cwd):\r\n28:    \"\"\"Run a Codex command with file-backed output and whole-tree timeout cleanup.\"\"\"\r\n29:    started = time.monotonic()\r\n30:    popen_kwargs = {\r\n31:        \"cwd\": cwd,\r\n32:        \"stdin\": subprocess.PIPE,\r\n33:        \"text\": True,\r\n34:        \"encoding\": \"utf-8\",\r\n35:    }\r\n36:    if os.name != \"nt\":\r\n37:        popen_kwargs[\"start_new_session\"] = True\r\n38:\r\n39:    stdout_path = Path(stdout_path)\r\n40:    stderr_path = Path(stderr_path)\r\n41:    with stdout_path.open(\"w\", encoding=\"utf-8\") as stdout_file, stderr_path.open(\r\n42:        \"w\", encoding=\"utf-8\"\r\n43:    ) as stderr_file:\r\n44:        popen_kwargs[\"stdout\"] = stdout_file\r\n45:        popen_kwargs[\"stderr\"] = stderr_file\r\n46:        proc = subprocess.Popen(cmd, **popen_kwargs)\r\n47:        timed_out = False\r\n48:        try:\r\n49:            proc.communicate(input=prompt, timeout=timeout_sec)\r\n50:        except subprocess.TimeoutExpired:\r\n51:            timed_out = True\r\n52:            if os.name == \"nt\":\r\n53:                subprocess.run(\r\n54:                    [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(proc.pid)],\r\n55:                    capture_output=True,\r\n56:                    check=False,\r\n57:                )\r\n58:            else:\r\n59:                try:\r\n60:                    os.killpg(proc.pid, signal.SIGKILL)\r\n61:                except ProcessLookupError:\r\n62:                    pass\r\n63:            proc.wait()\r\n64:\r\n65:    return {\r\n66:        \"exitCode\": proc.returncode,\r\n67:        \"timedOut\": timed_out,\r\n68:        \"elapsed\": time.monotonic() - started,\r\n69:    }\r\n70:\r\n--- execute.py 301-352 ---\r\n301:    def _invoke_codex(self, step: dict, preamble: str) -> dict:\r\n302:        step_num, step_name = step[\"step\"], step[\"name\"]\r\n303:        step_file = self._phase_dir / f\"step{step_num}.md\"\r\n304:\r\n305:        if not step_file.exists():\r\n306:            print(f\"  ERROR: {step_file} not found\")\r\n307:            sys.exit(1)\r\n308:\r\n309:        prompt = preamble + step_file.read_text(encoding=\"utf-8\")\r\n310:        # 프롬프트는 stdin(`-`)으로 넘긴다. 가드레일(AGENTS.md + docs/*.md)만 수만 자라\r\n311:        # argv로 넘기면 Windows 명령줄 길이 제한(32767자)에 걸린다.\r\n312:        # --dangerously-bypass-hook-trust: .codex/hooks.json은 내용이 바뀔 때마다 untrusted로\r\n313:        # 돌아가고, untrusted 훅은 조용히 건너뛴다. 우회하지 않으면 TDD 가드가 안 걸린다.\r\n314:        # Windows에서 codex는 npm이 깐 셔뱅(codex.CMD)이다. CreateProcess는 PATHEXT를\r\n315:        # 적용하지 않으므로 \"codex\"만 넘기면 FileNotFoundError로 죽는다. which로 해석한다.\r\n316:        # 못 찾으면 이름 그대로 넘겨 \"codex가 없다\"는 에러가 그대로 드러나게 둔다.\r\n317:        codex_bin = shutil.which(\"codex\") or \"codex\"\r\n318:        stdout_path = self._phase_dir / f\"step{step_num}-codex.stdout.log\"\r\n319:        stderr_path = self._phase_dir / f\"step{step_num}-codex.stderr.log\"\r\n320:        result = run_codex_process(\r\n321:            [codex_bin, \"exec\", \"--dangerously-bypass-approvals-and-sandbox\",\r\n322:             \"--dangerously-bypass-hook-trust\", \"--json\", \"-\"],\r\n323:            prompt,\r\n324:            stdout_path,\r\n325:            stderr_path,\r\n326:            1800,\r\n327:            self._root,\r\n328:        )\r\n329:\r\n330:        if result[\"exitCode\"] not in (0, None) or result[\"timedOut\"]:\r\n331:            print(f\"\\n  WARN: Codex가 비정상 종료됨 (code {result['exitCode']})\")\r\n332:            stderr = stderr_path.read_text(encoding=\"utf-8\", errors=\"replace\")\r\n333:            if stderr:\r\n334:                print(f\"  stderr: {stderr[-500:]}\")\r\n335:\r\n336:        output = {\r\n337:            \"step\": step_num,\r\n338:            \"name\": step_name,\r\n339:            \"exitCode\": result[\"exitCode\"],\r\n340:            \"timedOut\": result[\"timedOut\"],\r\n341:            \"elapsed\": result[\"elapsed\"],\r\n342:            \"stdout_log\": str(stdout_path.relative_to(self._root_path)),\r\n343:            \"stderr_log\": str(stderr_path.relative_to(self._root_path)),\r\n344:        }\r\n345:        out_path = self._phase_dir / f\"step{step_num}-invoke.json\"\r\n346:        with out_path.open(\"w\", encoding=\"utf-8\") as f:\r\n347:            json.dump(output, f, indent=2, ensure_ascii=False)\r\n348:\r\n349:        return output\r\n350:\r\n351:    # --- 헤더 & 검증 ---\r\n352:\r\n--- test_execute fixtures and imports 1-145 ---\r\n1:\"\"\"\r\n2:execute.py 리팩터링 안전망 테스트.\r\n3:리팩터링 전후 동작이 동일한지 검증한다.\r\n4:\"\"\"\r\n5:\r\n6:import json\r\n7:import os\r\n8:import subprocess\r\n9:import sys\r\n10:import textwrap\r\n11:from datetime import datetime, timezone, timedelta\r\n12:from pathlib import Path\r\n13:from unittest.mock import patch, MagicMock\r\n14:\r\n15:import pytest\r\n16:\r\n17:sys.path.insert(0, str(Path(__file__).parent))\r\n18:import execute as ex\r\n19:\r\n20:\r\n21:# ---------------------------------------------------------------------------\r\n22:# Fixtures\r\n23:# ---------------------------------------------------------------------------\r\n24:\r\n25:@pytest.fixture\r\n26:def tmp_project(tmp_path):\r\n27:    \"\"\"