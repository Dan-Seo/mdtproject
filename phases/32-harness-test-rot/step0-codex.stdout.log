 import os\r\n   7: import signal\r\n   8: import subprocess\r\n   9: import sys\r\n  10: import tempfile\r\n  11: import threading\r\n  12: import time\r\n  13: import unittest\r\n  14: from pathlib import Path\r\n  15: from unittest import mock\r\n  16: \r\n  17: \r\n  18: SCRIPT_DIR = Path(__file__).resolve().parent\r\n  19: SPEC = importlib.util.spec_from_file_location(\"execute\", SCRIPT_DIR / \"execute.py\")\r\n  20: if SPEC is None or SPEC.loader is None:\r\n  21:     raise RuntimeError(\"could not load scripts/execute.py\")\r\n  22: execute = importlib.util.module_from_spec(SPEC)\r\n  23: SPEC.loader.exec_module(execute)\r\n  24: \r\n  25: \r\n  26: def pid_alive(pid: int) -> bool:\r\n  27:     if os.name == \"nt\":\r\n  28:         # tasklist??肄섏넄 肄붾뱶?섏씠吏(cp949 ??濡?異쒕젰?쒕떎 ???뱁엳 ?대떦 PID媛 ?놁쓣 ?뚯쓽\r\n  29:         # ?쒓뎅???덈궡臾몄씠 UTF-8 strict ?붿퐫?쒕? 源⑤쑉由곕떎. 李얜뒗 ?좏겙? ASCII?대?濡?\r\n  30:         # ?붿퐫???놁씠 諛붿씠?몃줈 鍮꾧탳?쒕떎.\r\n  31:         result = subprocess.run(\r\n  32:             [\"tasklist\", \"/FI\", f\"PID eq {pid}\", \"/FO\", \"CSV\", \"/NH\"],\r\n  33:             capture_output=True,\r\n  34:             check=False,\r\n  35:         )\r\n  36:         return f'\"{pid}\"'.encode(\"ascii\") in result.stdout\r\n  37: \r\n  38:     try:\r\n  39:         os.kill(pid, 0)\r\n  40:     except ProcessLookupError:\r\n  41:         return False\r\n  42:     except PermissionError:\r\n  43:         return True\r\n  44:     return True\r\n  45: \r\n  46: \r\n  47: def kill_pid(pid: int) -> None:\r\n  48:     if not pid_alive(pid):\r\n  49:         return\r\n  50:     if os.name == \"nt\":\r\n  51:         subprocess.run(\r\n  52:             [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)],\r\n  53:             capture_output=True,\r\n  54:             check=False,\r\n  55:         )\r\n  56:         return\r\n  57:     try:\r\n  58:         os.kill(pid, signal.SIGKILL)\r\n  59:     except ProcessLookupError:\r\n  60:         pass\r\n  61: \r\n  62: \r\n  63: def wait_for_dead(pids: list[int], timeout: float = 5.0) -> None:\r\n  64:     deadline = time.monotonic() + timeout\r\n  65:     while time.monotonic() < deadline:\r\n  66:         if all(not pid_alive(pid) for pid in pids):\r\n  67:             return\r\n  68:         time.sleep(0.05)\r\n  69: \r\n  70: \r\n  71: class RunCodexProcessTests(unittest.TestCase):\r\n  72:     def test_normal_path_writes_stdout_and_stderr_to_logs(self) -> None:\r\n  73:         with tempfile.TemporaryDirectory() as temp_dir:\r\n  74:             root = Path(temp_dir)\r\n  75:             stdout_path = root / \"stdout.log\"\r\n  76:             stderr_path = root / \"stderr.log\"\r\n  77:             result = execute.run_codex_process(\r\n  78:                 [\r\n  79:                     sys.executable,\r\n  80:                     \"-c\",\r\n  81:                     (\r\n  82:                         \"import sys; value = sys.stdin.read(); \"\r\n  83:                         \"print('stdout:' + value); \"\r\n  84:                         \"print('stderr:' + value, file=sys.stderr)\"\r\n  85:                     ),\r\n  86:                 ],\r\n  87:                 \"hello\",\r\n  88:                 stdout_path,\r\n  89:                 stderr_path,\r\n  90:                 10,\r\n  91:                 root,\r\n  92:             )\r\n  93: \r\n  94:             self.assertEqual(result[\"exitCode\"], 0)\r\n  95:             self.assertFalse(result[\"timedOut\"])\r\n  96:             self.assertIn(\"stdout:hello\", stdout_path.read_text(encoding=\"utf-8\"))\r\n  97:             self.assertIn(\"stderr:hello\", stderr_path.read_text(encoding=\"utf-8\"))\r\n  98: \r\n  99:     def test_timeout_kills_child_and_grandchild_without_hanging(self) -> None:\r\n 100:         with tempfile.TemporaryDirectory() as temp_dir:\r\n 101:             root = Path(temp_dir)\r\n 102:             child_pid_path = root / \"child.pid\"\r\n 103:             grandchild_pid_path = root / \"grandchild.pid\"\r\n 104:             stdout_path = root / \"stdout.log\"\r\n 105:             stderr_path = root / \"stderr.log\"\r\n 106:             child_code = (\r\n 107:                 \"import os, subprocess, sys, time; \"\r\n 108:                 \"print('child-started', flush=True); \"\r\n 109:                 \"open(sys.argv[1], 'w', encoding='utf-8').write(str(os.getpid())); \"\r\n 110:                 \"grandchild = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(300)']); \"\r\n 111:                 \"open(sys.argv[2], 'w', encoding='utf-8').write(str(grandchild.pid)); \"\r\n 112:                 \"time.sleep(300)\"\r\n 113:             )\r\n 114:             result_holder: dict[str, object] = {}\r\n 115: \r\n 116:             def invoke() -> None:\r\n 117:                 try:\r\n 118:                     result_holder[\"result\"] = execute.run_codex_process(\r\n 119:                         [\r\n 120:                             sys.executable,\r\n 121:                             \"-c\",\r\n 122:                             child_code,\r\n 123:                             str(child_pid_path),\r\n 124:                             str(grandchild_pid_path),\r\n 125:                         ],\r\n 126:                         \"\",\r\n 127:                         stdout_path,\r\n 128:                         stderr_path,\r\n 129:                         3,\r\n 130:                         root,\r\n 131:                     )\r\n 132:                 except BaseException as error:  # pragma: no cover - assertion below reports it\r\n 133:                     result_holder[\"error\"] = error\r\n 134: \r\n 135:             thread = threading.Thread(target=invoke)\r\n 136:             thread.start()\r\n 137:             pids: list[int] = []\r\n 138:             try:\r\n 139:                 deadline = time.monotonic() + 10\r\n 140:                 while time.monotonic() < deadline:\r\n 141:                     if child_pid_path.exists() and grandchild_pid_path.exists():\r\n 142:                         pids = [\r\n 143:                             int(child_pid_path.read_text(encoding=\"utf-8\")),\r\n 144:                             int(grandchild_pid_path.read_text(encoding=\"utf-8\")),\r\n 145:                         ]\r\n 146:                         break\r\n 147:                     time.sleep(0.05)\r\n 148: \r\n 149:                 thread.join(30)\r\n 150:                 self.assertFalse(thread.is_alive(), \"timeout handling hung after killing the parent\")\r\n 151:                 self.assertNotIn(\"error\", result_holder, result_holder.get(\"error\"))\r\n 152:                 result = result_holder[\"result\"]\r\n 153:                 self.assertIsInstance(result, dict)\r\n 154:                 self.assertTrue(result[\"timedOut\"])\r\n 155:                 self.assertTrue(pids, \"child PID files were not written\")\r\n 156:                 self.assertIn(\"child-started\", stdout_path.read_text(encoding=\"utf-8\"))\r\n 157:                 wait_for_dead(pids)\r\n 158:                 self.assertTrue(all(not pid_alive(pid) for pid in pids))\r\n 159:             finally:\r\n 160:                 thread.join(timeout=1)\r\n 161:                 for pid_path in (child_pid_path, grandchild_pid_path):\r\n 162:                     if pid_path.exists():\r\n 163:                         try:\r\n 164:                             pid = int(pid_path.read_text(encoding=\"utf-8\"))\r\n 165:                         except ValueError:\r\n 166:                             continue\r\n 167:                         if pid not in pids:\r\n 168:                             pids.append(pid)\r\n 169:                 for pid in pids:\r\n 170:                     kill_pid(pid)\r\n 171: \r\n 172: \r\n 173: class InvokeArtifactTests(unittest.TestCase):\r\n 174:     def test_invoke_uses_new_artifact_names_and_does_not_write_output_json(self) -> None:\r\n 175:         with tempfile.TemporaryDirectory() as temp_dir:\r\n 176:             root = Path(temp_dir)\r\n 177:             phase_dir = root / \"phases\" / \"t\"\r\n 178:             phase_dir.mkdir(parents=True)\r\n 179:             (phase_dir / \"index.json\").write_text(\r\n 180:                 json.dumps({\"project\": \"test\", \"phase\": \"t\", \"steps\": [{\"step\": 0, \"name\": \"sample\"}]}),\r\n 181:                 encoding=\"utf-8\",\r\n 182:             )\r\n 183:             (phase_dir / \"step0.md\").write_text(\"test prompt\", encoding=\"utf-8\")\r\n 184:             subprocess.run([\"git\", \"init\"], cwd=root, capture_output=True, check=True)\r\n 185:             subprocess.run([\"git\", \"config\", \"user.name\", \"Test\"], cwd=root, check=True)\r\n 186:             subprocess.run([\"git\", \"config\", \"user.email\", \"test@example.com\"], cwd=root, check=True)\r\n 187: \r\n 188:             executor = execute.StepExecutor(\"t\", root=root)\r\n 189:             with mock.patch.object(execute.shutil, \"which\", return_value=sys.executable):\r\n 190:                 result = executor._invoke_codex({\"step\": 0, \"name\": \"sample\"}, \"preamble\\n\")\r\n 191: \r\n 192:             self.assertTrue((phase_dir / \"step0-invoke.json\").exists())\r\n 193:             self.assertTrue((phase_dir / \"step0-codex.stdout.log\").exists())\r\n 194:             self.assertTrue((phase_dir / \"step0-codex.stderr.log\").exists())\r\n 195:             self.assertFalse((phase_dir / \"step0-output.json\").exists())\r\n 196:             self.assertEqual(result[\"stdout_log\"], str(Path(\"phases\") / \"t\" / \"step0-codex.stdout.log\"))\r\n 197:             self.assertEqual(result[\"stderr_log\"], str(Path(\"phases\") / \"t\" / \"step0-codex.stderr.log\"))\r\n 198:             saved = json.loads((phase_dir / \"step0-invoke.json\").read_text(encoding=\"utf-8\"))\r\n 199:             self.assertNotIn(\"stdout\", saved)\r\n 200:             self.assertNotIn(\"stderr\", saved)\r\n 201:             self.assertIn(\"timedOut\", saved)\r\n 202: \r\n 203: \r\n 204: class FakeStepExecutor(execute.StepExecutor):\r\n 205:     \"\"\"Write predetermined step outcomes instead of invoking Codex.\"\"\"\r\n 206: \r\n 207:     def __init__(self, phase_dir_name: str, outcomes: dict[int, list[dict]], *, root: Path):\r\n 208:         self.outcomes = outcomes\r\n 209:         self.calls_by_step: dict[int, int] = {}\r\n 210:         self.preambles: list[str] = []\r\n 211:         super().__init__(phase_dir_name, root=root)\r\n 212: \r\n 213:     def _invoke_codex(self, step: dict, preamble: str) -> dict:\r\n 214:         step_num = step[\"step\"]\r\n 215:         attempt = self.calls_by_step.get(step_num, 0)\r\n 216:         self.calls_by_step[step_num] = attempt + 1\r\n 217:         self.preambles.append(preamble)\r\n 218:         choices = self.outcomes[step_num]\r\n 219:         outcome = choices[min(attempt, len(choices) - 1)]\r\n 220:         index = self._read_json(self._index_file)\r\n 221:         for candidate in index[\"steps\"]:\r\n 222:             if candidate[\"step\"] == step_num:\r\n 223:                 candidate[\"status\"] = outcome[\"status\"]\r\n 224:                 if \"summary\" in outcome:\r\n 225:                     candidate[\"summary\"] = outcome[\"summary\"]\r\n=== package scripts ===\r\n{\n  \"dev\": \"next dev\",\n  \"build\": \"next build\",\n  \"lint\": \"eslint .\",\n  \"typecheck\": \"tsc --noEmit\",\n  \"test\": \"vitest run\",\n  \"test:golden\": \"vitest run tests/golden\",\n  \"rulepack:review-sheet\": \"tsx scripts/rulepack/review-sheet.ts\",\n  \"lighthouse\": \"lhci autorun --config=lighthouserc.cjs\",\n  \"perf:measure\": \"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\",\n  \"eval\": \"tsx --env-file-if-exists=.env evals/harness/run.ts\",\n  \"test:hooks\": \"bash scripts/hooks/tdd-guard.spec.sh\",\n  \"hooks:install\": \"git config core.hooksPath scripts/githooks\",\n  \"test:ci-scripts\": \"bash scripts/ci/scrub-secrets.spec.sh && bas