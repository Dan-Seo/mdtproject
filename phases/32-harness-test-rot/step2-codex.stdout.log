import shutil\\r\\n  10: import subprocess\\r\\n  11: from pathlib import Path\\r\\n  12: \\r\\n  13: import pytest\\r\\n  14: \\r\\n  15: HOOK = (Path(__file__).parent / \\\"hooks\\\" / \\\"stop-verify.sh\\\").as_posix()\\r\\n  16: BASH = shutil.which(\\\"bash\\\")\\r\\n  17: NPM = shutil.which(\\\"npm\\\")\\r\\n  18: \\r\\n  19: pytestmark = pytest.mark.skipif(BASH is None, reason=\\\"bash가 필요하다\\\")\\r\\n  20: \\r\\n  21: NOOP = \\\"node -e \\\\\\\"\\\\\\\"\\\"\\r\\n  22: FAIL = \\\"node -e \\\\\\\"console.log('LINT_OUTPUT_MARKER'); process.exit(1)\\\\\\\"\\\"\\r\\n  23: \\r\\n  24: \\r\\n  25: def run_hook(cwd: Path, *, stop_hook_active: bool = False):\\r\\n  26:     payload = {\\r\\n  27:         \\\"hook_event_name\\\": \\\"Stop\\\",\\r\\n  28:         \\\"session_id\\\": \\\"thr_test\\\",\\r\\n  29:         \\\"cwd\\\": str(cwd),\\r\\n  30:         \\\"stop_hook_active\\\": stop_hook_active,\\r\\n  31:     }\\r\\n  32:     r = subprocess.run(\\r\\n  33:         [BASH, HOOK], cwd=str(cwd),\\r\\n  34:         input=json.dumps(payload), capture_output=True, text=True, encoding=\\\"utf-8\\\",\\r\\n  35:     )\\r\\n  36:     assert r.returncode == 0, f\\\"hook이 비정상 종료: {r.stderr}\\\"\\r\\n  37:     return r\\r\\n  38: \\r\\n  39: \\r\\n  40: def write_package_json(project: Path, lint: str, build: str, test: str):\\r\\n  41:     (project / \\\"package.json\\\").write_text(\\r\\n  42:         json.dumps({\\\"name\\\": \\\"t\\\", \\\"scripts\\\": {\\r\\n  43:             \\\"lint\\\": lint,\\r\\n  44:             \\\"typecheck\\\": NOOP,\\r\\n  45:             \\\"build\\\": build,\\r\\n  46:             \\\"test\\\": test,\\r\\n  47:         }}),\\r\\n  48:         encoding=\\\"utf-8\\\",\\r\\n  49:     )\\r\\n  50: \\r\\n  51: \\r\\n  52: @pytest.fixture\\r\\n  53: def project(tmp_path):\\r\\n  54:     # stop-verify.sh intentionally exits before validation when dependencies are absent.\\r\\n  55:     (tmp_path / \\\"node_modules\\\").mkdir()\\r\\n  56:     return tmp_path\\r\\n  57: \\r\\n  58: \\r\\n  59: class TestSkips:\\r\\n  60:     def test_no_package_json_is_silent(self, project):\\r\\n  61:         \\\"\\\"\\\"스캐폴딩 전에는 검증 대상이 없다.\\\"\\\"\\\"\\r\\n  62:         r = run_hook(project)\\r\\n  63:         assert r.stdout.strip() == \\\"\\\"\\r\\n  64: \\r\\n  65:     def test_incomplete_scripts_is_silent(self, project):\\r\\n  66:         \\\"\\\"\\\"package.json은 생겼지만 lint·build·test가 아직 다 없는 스캐폴딩 도중 구간.\\\"\\\"\\\"\\r\\n  67:         (project / \\\"package.json\\\").write_text(\\r\\n  68:             json.dumps({\\\"name\\\": \\\"t\\\", \\\"scripts\\\": {\\\"lint\\\": NOOP}}), encoding=\\\"utf-8\\\")\\r\\n  69:         r = run_hook(project)\\r\\n  70:         assert r.stdout.strip() == \\\"\\\"\\r\\n  71: \\r\\n  72:     def test_no_scripts_field_is_silent(self, project):\\r\\n  73:         (project / \\\"package.json\\\").write_text('{\\\"name\\\": \\\"t\\\"}', encoding=\\\"utf-8\\\")\\r\\n  74:         r = run_hook(project)\\r\\n  75:         assert r.stdout.strip() == \\\"\\\"\\r\\n  76: \\r\\n  77:     def test_already_continued_is_silent(self, project):\\r\\n  78:         \\\"\\\"\\\"stop_hook_active면 다시 이어붙이지 않는다 — 무한 루프 방지.\\\"\\\"\\\"\\r\\n  79:         write_package_json(project, FAIL, NOOP, NOOP)\\r\\n  80:         r = run_hook(project, stop_hook_active=True)\\r\\n  81:         assert r.stdout.strip() == \\\"\\\"\\r\\n  82: \\r\\n  83: \\r\\n  84: @pytest.mark.skipif(NPM is None, reason=\\\"npm이 필요하다\\\")\\r\\n  85: class TestVerification:\\r\\n  86:     def test_success_emits_nothing(self, project):\\r\\n  87:         write_package_json(project, NOOP, NOOP, NOOP)\\r\\n  88:         r = run_hook(project)\\r\\n  89:         assert r.stdout.strip() == \\\"\\\"\\r\\n  90: \\r\\n  91:     def test_failure_emits_block_json(self, project):\\r\\n  92:         write_package_json(project, FAIL, NOOP, NOOP)\\r\\n  93:         r = run_hook(project)\\r\\n  94:         out = json.loads(r.stdout)          # stdout은 반드시 유효한 JSON\\r\\n  95:         assert out[\\\"decision\\\"] == \\\"block\\\"\\r\\n  96:         assert out[\\\"reason\\\"]\\r\\n  97: \\r\\n  98:     def test_failure_reason_carries_npm_output(self, project):\\r\\n  99:         write_package_json(project, FAIL, NOOP, NOOP)\\r\\n 100:         out = json.loads(run_hook(project).stdout)\\r\\n 101:         assert \\\"LINT_OUTPUT_MARKER\\\" in out[\\\"reason\\\"]\\r\\n 102: \\r\\n 103:     def test_stdout_never_leaks_plain_text(self, project):\\r\\n 104:         \\\"\\\"\\\"npm 출력이 stdout으로 새면 Stop 이벤트에서 invalid로 처리된다.\\\"\\\"\\\"\\r\\n 105:         write_package_json(project, NOOP, NOOP, NOOP)\\r\\n 106:         r = run_hook(project)\\r\\n 107:         assert \\\"npm\\\" not in r.stdout\\r\\n 108:         if r.stdout.strip():\\r\\n 109:             json.loads(r.stdout)\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command '$p='\\\"'docs/MILESTONES.md'; \\\"'$l=Get-Content -Encoding UTF8 $p; $start=[Math]::Max(1,$l.Count-35); for($i=$start;$i -le $l.Count;$i++){ '\\\"'{0,4}: {1}' -f \\\"'$i,$l[$i-1] }'\",\"aggregated_output\":\"   1: # 마일스톤 현황\\r\\n   2: \\r\\n   3: > `CLAUDE.md`에서 옮겨온 절이다. **수치는 손으로 갱신하므로 코드보다 뒤처진다** — 인용 전에 `git log --oneline -3`으로 실제 HEAD를 확인하고 코드로 대조할 것.\\r\\n   4: \\r\\n   5: - **M2 보강 (2026-08-27, phase 30 step 2)**: 룰팩 243행(`transcribed` 240행, `inferred` 3행)을 8개 표＋17개 단발항＝25개 대조 단위·135칸으로 확인한다. 생성은 `npm run rulepack:review-sheet`; 검토는 ①表5.3.2·5.3.4 L1/L1h ②表5.3.6 柱＝大梁 ③단발항·결번 순이다. 사람이 단위별 전 칸 일치를 회신한 뒤 해당 행의 `confidence`를 `stated`로 올리고 `note`의 「独立検討待ち」를 지우며, `src/rulepack/index.test.ts`의 「`stated`는 0행」 고정을 같은 커밋에서 함께 고친다. 그 전까지 `stated` 0행이며 M2와 R6은 각각 진행 중·열림이다. 아래 기존 M2 항목의 이전 대조 수치 「198행」·「원문 94칸·8곳」은 이 수치로 대체한다.\\r\\n   6: \\r\\n   7: - **M3c 보충 (2026-08-27, phase 28 step 3)**: `表5.3.1 注1`의 「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d 以上とする。」를 `spec-r7-ch5.json`에 `transcribed` 전사했다(인쇄 28쪽). 이는 설계도서 조건이므로 片持床板 선단과 壁 자유단의 훅을 추정하지 않는 골든 회귀를 추가했고, 룰팩 행은 만들지 않았다. 加工長 대장은 `bendRadius`만 남도록 정리했으며 R12는 부분 상태를 유지한다.\\r\\n   8: \\r\\n   9: - [x] **M0** — 완료 (2026-08-09). 標準仕様書 R7 5章에서 MVP 관련 텍스트 수치 ~92개, 이미지 수치 8개(フック余長 4·継手位置 4)를 특정. 標準詳細図에는 구조 배근 상세가 없음을 확인 — 배근 근거는 5章이 유일하다 (docs/M0-FINDINGS.md)\\r\\n  10: - [x] **M1** — 완료. 워킹 스켈레톤: 柱 1종 + 플레이스홀더 룰로 입력→철근→물량→3D→Excel 관통. 전 룰이 inferred이므로 M2 전 산출값은 정식 물량이 아니다\\r\\n  11: - [ ] **M2** — 룰팩 정식화 + 골든테스트 전 셀 통과. 골든 기대값은 원문 독립 전사(lookupRule 유도 금지, ADR-010). **M2a 착수분(2026-08-12)**: `数量積算基準` 第4編第3章을 전사해 `tests/golden/fixtures/quantity-r5-ch3.json`에 박고, 数量의 길이·본수를 1通則2)·7)에 맞췄다 — フープ/スタラップ 길이가 かぶり 공제+フック에서 **断面周長**으로 바뀌어 한 본당 244mm 늘었다(ADR-019). 미적용 조항은 R9. **추가 완료**(2026-08-20): 단위질량을 룰팩에서 빼고 **프로젝트 입력**(`Project.unitMass`)으로 받는다. 積算基準 1通則 前文은 質量을 「設計長さ × JIS G 3112 の単位質量」으로 정의할 뿐 값을 JIS에 위임하는데, JIS는 유료라 미확보다 — 읽지 않은 문헌을 出典에 세울 수 없으므로(ADR-003) `unit-mass.yaml`(inferred 8행)과 `sources.yaml`의 `jis` 항목을 지웠다. 미입력 径은 line·小計·合計의 kg이 전부 `null`이고 内訳書·Excel에 「—」로 나간다(0으로 두면 합계에 섞여 과소 계상으로 보인다). **추가 완료**(2026-08-21, 加工長 골든): 선결 조건이던 R7 端部条件 ①②③이 전부 닫혀 착수 가능해졌다 — `tests/golden/fixtures/fabrication-length.json`에 表5.3.4(L1)·表5.3.5(La)·5.3.4(5)(ｲ)(a)(b)(c)·表5.3.6·5.3.5(2)·表5.3.1(hook135, 이미지 판독) + `数量積算基準` 1通則1)(tipNoAddition)을 전사하고, 그 항들만으로 손유도한 加工長을 9케이스에 박았다(柱主筋 定着/통과, 柱帯筋, 大梁 折曲げ 全長下限支配/折曲げ 余長下限支配/直線/2스팬 通し筋, あばら筋, 定着不成立 throw). 재는 값은 `Rebar.length`가 아니라 **`points`가 그리는 折れ線 실장**이다 — 設計長さ를 읽으면 数量 골든과 중복되고 3D 형상은 아무도 고정하지 않는 채로 남는다(ADR-019). 근거 문서가 둘이라 `sources`는 배열이고 각 항이 `sourceId`로 어느 문서인지 가리킨다. 어느 케이스도 구속하지 않는 항은 `terms`에 남지 못한다 — 실제로 L1h가 그랬다. 뮤테이션으로 감도 확인함(cover 加算·余長下限·L1·中間柱せい 누적을 각각 흔들면 해당 케이스만 실패). **2026-08-21 재점검**: 예전에 적어둔 잔여 4개 중 셋은 이미 끝나 있었다 — 加工用かぶり는 `cover.fabrication.addition`으로 분리돼 골든 대조 중이고, 근거 없는 `rounding.length`는 룰팩에 없으며, 선결 조건이던 R7③(端部条件)도 `girder-ends.ts`가 直線↔折曲げ 분기와 `定着不成立` 판정으로 처리한다. 같은 날 折曲げ定着 全長의 하한이 조문(L1)이 아니라 L1h였던 것을 고쳤다(R7③-1) — 그 결과 (a)가 지배할 때 折曲げ와 直線의 全長이 같아지고, (b) 余長下限이 이기는 사례는 D13·柱560 하나로 좁혀졌다. **남은 것은 두 원문에서 전사된 수치의 `stated` 승격이다**: 標準仕様書 5章 211행과 数量積算基準 29행 모두 전사자와 승인자가 같아 **사람의 독립 검토**가 남았다(R6·ADR-023). `独立検討待ち` note는 일부 행에만 있는 장식이고 `confidence: transcribed`가 검토 대기의 기준이다. 에이전트는 코드로 이를 닫을 수 없으며, 사람 검토자가 원문 PDF와 대조해야 한다. 그 대조를 싸게 만드는 표별 대조 시트가 이 항목의 실제 작업이고, 대조 단위는 룰팩 243행이 아니라 **원문 표 8개＋단발항 17개＝25개 단위·135칸**이다(원문 표가 帯 구조라 룰팩이 fc·径으로 전개해 둔 것이고, 帯 내부 전개 불일치는 0으로 확인됐다)\\r\\n  12: - [x] **M3a** — 완료 (2026-08-12). 단일 스팬 大梁: girderSpan·단부 조건(직선/折曲げ定着 수용성 검사)·あばら筋 위치 배열 생성기 + 部材/建物 뷰 표시 + 뷰어 기능 4종(레이어 토글·단면 컷·호버 툴팁·정착 범례). 브라우저 실검증은 `tests/e2e/uc10-viewer-features.js`. **M2가 미완이므로 大梁 산출값도 아직 정식 물량이 아니다**\\r\\n  13: - [x] **M3b** — 완료 (2026-08-21). **다스팬 通し筋**(2026-08-12): 산정 단위가 부재에서 **런**(같은 通り芯 위 인접 大梁의 최대 연쇄)으로 바뀌었고 단일 스팬은 길이 1인 런이다. 通し筋은 중간 접합부를 관통해 定着이 양 끝에만 붙는다 → R7② 해소. `girderSupport`와 `UnsupportedReason`의 `'連続スパン'`은 함께 제거됐다. **継手箇所数 계상과 수량 단위 유니온(kg·箇所)**(2026-08-18) → R8 해소. **カットオフ筋과 継手方式 입력**(2026-08-21): 大梁 主筋을 位置別(端部·中央)로 받고 差를 カットオフ筋으로 낸다 — 外側支点은 定着＋切り止め位置, 中間支点은 位置×2＋中間柱せい(관통), 中央은 内法−位置×2다. 근거는 積算基準 2（３）梁1)「トップ筋、ハンチ部分の主筋、補強筋等は設計図書による」이고 切り止め位置는 그래서 입력이다(ADR-021). 継手方式은 断面一覧에서 고른다 — 이제 `重ね継手` 고정이 아니다. 실검증 `tests/e2e/uc11-continuous-girder.js`·`uc13-cutoff-splice.js`. **넘긴 것**: 継手位置는 表5.3.3이 원문에서 이미지라 미확정이라 3D에 그리지 않고 고지로 상시 표시한다(M0에서 닫힌 사실이라 M3b가 풀 수 없다). あばら筋의 位置別 피치(端部@100/中央@200)는 主筋과 달리 아직 단일 값이다 — M3c 이후. **M2가 미완이므로 大梁 산출값은 아직 정식 물량이 아니다**\\r\\n  14: - [ ] **M3c** — 진행 중. 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다\\r\\n  15: - [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `girderMainAsymmetric` 후보로 보존하고 phase 21에서 Grid 축 순서 자동 또는 사용자 선택으로 始端/終端에 반영한다. 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 좌우 상이 8칸은 방향 미선택을 기본으로 유지한 비대칭 후보로 반영 단계에 넘겼다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 고강도 전단보강근·円形柱 표현, `カットオフ` 값 반영 — 位置 열이 있는 3란 표는 phase 21에서 취입까지 닫혔고, 위치 없는 반폭 표기는 원문 `raw` 보존까지. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\\r\\n  16:    - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — 断面リスト 취입에서 좌우 비대칭 主筋의 始端/終端 대응에 사용한다. ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조). **끝난 것**(2026-08-26, ADR-035·phase 23): 階 라벨↔`Story` 대응 — 伏図 제목과 `Story`/断面의 정확 일치 자동 선택, 미일치 시 사용자 선택, stale `storyId` 리셋을 고정했다.\\r\\n  17: - [x] **부재 확장(耐震壁·床板)** — 완료 (2026-08-27, ADR-025·ADR-028·ADR-039). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **끝난 것**(開口補強筋 전사 입력, 2026-08-26, ADR-034·phase 22): 開口마다 `径・本数・設計長さ(mm)`를 설계도서에서 전사해 입력하고, 내역서에는 `開口補強筋`으로 계상한다. 3D는 위치·형상을 제품이 만들지 않도록 해당 role을 건물·부재 뷰에서 건너뛴다. 미전사 開口의 과소 계상은 상시 고지가 안내한다. **끝난 것**(片持床板, 2026-08-27, ADR-039): `数量積算基準` 躯体の区分（４）床板의 「片持床板等もこれらに準ずる。」, 같은 기준 2（４）床板2) 但書의 「単独床板及び片持床板の主筋の継手は、1通則4)による。」, `標準仕様書` 表5.3.4 L3의 「片持スラブの場合は25d」 예외(150mm 하한은 적용하지 않음), 表5.3.5 注1·2의 La·Lb(「片持スラブを含む」·「片持スラブを除く」)를 근거로 지원을 완료했다. 平面 뷰의 壁·床板 배치·삭제 입력은 phase 26(ADR-038)에서 완료\\r\\n  18: - [ ] **일본 고유 형태·제품 확장** — 진행 중 (2026-08-22 착수). 후보를 두 원문 전수 검색으로 재고 4개를 골랐다. **끝난 것**: ① **高強度せん断補強筋**(K13·S13, ADR-026) — `帯筋`·`あばら筋` 전용 呼び名이다. 두 원문에 「高強度」·「大臣認定」이 **0건**인데도 만들 수 있는 이유는 1通則2)가 フープ 長さ를 断面周長으로 정해 **径으로 引는 룰팩 행이 帯筋에 하나도 없기** 때문이다 — 룰팩 신규 행 0. 主筋·壁筋은 定着·重ね継手를 径으로 引으므로 타입(`ShearBarSize`)이 막는다. 断面リスト 파서도 읽는다. ② **円形柱**(ADR-027) — 1通則2)의 「断面の設計寸法による周長」이 円形에서는 원주 π×直径이다. 조문이 형상을 矩形으로 한정하지 않으므로 여기서도 룰팩 신규 행이 0이다. `ColumnSection.shape`(스키마 v9)로 받고 b·d를 둘 다 直径으로 둔다 — 大梁 内法·3D 柱面·平面 히트영역이 전부 b·d에서 나오므로 外接寸法을 그대로 두면 형상 추가가 계측을 흔들지 않는다. 3D는 円柱와 円形フープ(24각형 作図規則)다. `600φ`도 파싱한다. **スパイラル筋은 만들지 않는다** — 継手·定着이 図5.3.5＝이미지다. **끝난 것**: ③ **雑壁** — 区分(`wallClass`)·かぶり·40d 하한은 phase 24(ADR-036)로 완료. 부분 높이·부분 길이 형상은 phase 25(ADR-037)로 완료. **만들지 않는다 — 별개 마일스톤(ADR-042)**: **壁式構造の壁**(積算基準 2（５）壁**2)**의 端部筋·縦筋·壁梁筋·横筋·補強筋 5구분). **만들지 않는 것**: `免震`(0건, ADR-025)·スパイラル筋의 継手·定着(図5.3.5＝**이미지**라 表5.3.3과 같은 함정)·機械式定着(標準仕様書 5.3.4(ｳ)가 전부 「特記による」라 제품이 가질 값이 없다). `ガス圧接`·`機械式継手`는 M3b에서 이미 끝났다\\r\\n  19: - [x] **M4** — 완료 (2026-08-22). 네 갈래다. ① **재방문 경로**: `src/lib/persist/`(IndexedDB 자동저장 500ms 디바운스 ＋ 案件 JSON 저장/불러오기)와 `useProjectPersistence`. 복원 불가한 기록(옛 schemaVersion·끊긴 문자열)은 조용히 버리고 샘플로 착지한다 — 기동 경로라 던지면 지울 방법 없이 화면이 하얘진다. 반대로 사용자가 고른 파일이 안 읽히면 **말한다**(지금 案件은 남긴 채). ② **내역서 양식**: xlsx에 층별 小計 행과 `径別集計` 시트를 넣었다(`sizeSubtotals`는 径마다 독립해서 null이 된다 — 「어느 径이 아직 発注 불가인가」가 이 표의 용도라 欠損이 다른 径을 물들이면 안 된다). ③ **PDF**: 라이브러리 대신 브라우저 인쇄 경로(`@media print` ＋ `window.print()`). 종이도 같은 `WorkbookSpec`에서 나오고, 出典·算出式 두 열은 열 정의의 `printed` 플래그로 뺀다(PDL1.0 의무는 算出根拠 블록이 진다). ④ **glTF(glb)**: `EXT_mesh_gpu_instancing`으로 案件 전체를 낸다. **화면의 표시 반경이 아니라 実寸이다** — `rebarRadius`는 가독성용으로 최소 ⌀14·1.6배로 부풀린 값이라 그대로 내면 D25가 ⌀40으로 실측된다(ADR-024). 스트레스는 `tests/stress/multi-story.test.ts`(5층 45,885 인스턴스)와 실브라우저 `tests/e2e/uc17-stress-building.js`로 잰다. glb에도 出典·改変·ADR-015 경고가 `scene.userData`(＝extras)로 실린다 — 書き出し 경로마다 표시 의무가 면제되지 않는다. **3D를 쓰는 코드는 押した時에 받는다**: 헤더 상주 釦이 `gltf.ts`를 정적 import하면 three가 `/`의 차단 경로로 돌아오는데, Lighthouse 예산은 이것을 통과시킨다(뷰어가 어차피 three를 받으므로 총량이 안 변한다). 확인은 `.next/app-build-manifest.json`의 `pages['/page']`로 한다\\r\\n  20: - **2026-08-27 정정 (ADR-042)**: 위 일본 고유 형태·제품 항의 이전 「남은 것」 표기는 정정한다. 壁式構造の壁은 조문을 전사했으나 만들지 않는다 — 별개 마일스톤(ADR-042)이며 해당 항의 잔여 항목으로 세지 않는다. 이전 서술은 변경 경위 보존용이다.\\r\\n  21: - [ ] **M5** — 한국 실무자 UX 리뷰 반영\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command '$p='\\\"'scripts/test_execute.py'; \\\"'$l=Get-Content -Encoding UTF8 $p; for($i=1;$i -le $l.Count;$i++){ if($i -ge 1 -and $i -le 80 -or $i -ge 235 -and $i -le 290 -or $i -ge 405 -and $i -le 470){ '\\\"'{0,4}: {1}' -f \\\"'$i,$l[$i-1] } }'\",\"aggregated_output\":\"   1: \\\"\\\"\\\"\\r\\n   2: execute.py 리팩터링 안전망 테스트.\\r\\n   3: 리팩터링 전후 동작이 동일한지 검증한다.\\r\\n   4: \\\"\\\"\\\"\\r\\n   5: \\r\\n   6: import json\\r\\n   7: import os\\r\\n   8: import subprocess\\r\\n   9: import sys\\r\\n  10: import textwrap\\r\\n  11: from datetime import datetime, timezone, timedelta\\r\\n  12: from pathlib import Path\\r\\n  13: from unittest.mock import patch, MagicMock\\r\\n  14: \\r\\n  15: import pytest\\r\\n  16: \\r\\n  17: sys.path.insert(0, str(Path(__file__).parent))\\r\\n  18: import execute as ex\\r\\n  19: \\r\\n  20: \\r\\n  21: # ---------------------------------------------------------------------------\\r\\n  22: # Fixtures\\r\\n  23: # ---------------------------------------------------------------------------\\r\\n  24: \\r\\n  25: @pytest.fixture\\r\\n  26: def tmp_project(tmp_path):\\r\\n  27:     \\\"\\\"\\\"phases/, AGENTS.md, docs/ 를 갖춘 임시 프로젝트 구조.\\\"\\\"\\\"\\r\\n  28:     phases_dir = tmp_path / \\\"phases\\\"\\r\\n  29:     phases_dir.mkdir()\\r\\n  30: \\r\\n  31:     agents_md = tmp_path / \\\"AGENTS.md\\\"\\r\\n  32:     agents_md.write_text(\\\"# Rules\\\\n- rule one\\\\n- rule two\\\", encoding=\\\"utf-8\\\")\\r\\n  33: \\r\\n 285:         assert mvp[\\\"status\\\"] == \\\"completed\\\"\\r\\n 439:         assert \\\"--json\\\" in cmd\\r\\n 440: \\r\\n 441:     def test_resolves_executable_through_pathext(self, executor):\\r\\n 442:         \\\"\\\"\\\"Windows에서 codex는 npm이 깐 셔뱅(codex.CMD)이다. CreateProcess는 PATHEXT를\\r\\n 443:         적용하지 않으므로 이름만 넘기면 FileNotFoundError로 죽는다.\\\"\\\"\\\"\\r\\n 444:         step = {\\\"step\\\": 2, \\\"name\\\": \\\"ui\\\"}\\r\\n 445:         resolved = r\\\"C:\\\\Users\\\\x\\\\AppData\\\\Roaming\\\\npm\\\\codex.CMD\\\"\\r\\n 446: \\r\\n 447:         with patch(\\\"shutil.which\\\", return_value=resolved) as mock_which, \\\\\\r\\n 448:              patch.object(ex, \\\"run_codex_process\\\", return_value={\\r\\n 449:                  \\\"exitCode\\\": 0, \\\"timedOut\\\": False, \\\"elapsed\\\": 0.01,\\r\\n 450:              }) as mock_run:\\r\\n 451:             executor._invoke_codex(step, \\\"preamble\\\")\\r\\n 452: \\r\\n 453:         mock_which.assert_called_once_with(\\\"codex\\\")\\r\\n 454:         assert mock_run.call_args.args[0][0] == resolved\\r\\n 455: \\r\\n 456:     def test_falls_back_to_bare_name_when_not_resolvable(self, executor):\\r\\n 457:         \\\"\\\"\\\"PATH에 없으면 이름 그대로 넘겨 codex가 없다는 에러가 그대로 드러나게 한다.\\\"\\\"\\\"\\r\\n 458:         step = {\\\"step\\\": 2, \\\"name\\\": \\\"ui\\\"}\\r\\n 459: \\r\\n 460:         with patch(\\\"shutil.which\\\", return_value=None), \\\\\\r\\n 461:              patch.object(ex, \\\"run_codex_process\\\", return_value={\\r\\n 462:                  \\\"exitCode\\\": 0, \\\"timedOut\\\": False, \\\"elapsed\\\": 0.01,\\r\\n 463:              }) as mock_run:\\r\\n 464:             executor._invoke_codex(step, \\\"preamble\\\")\\r\\n 465: \\r\\n 466:         assert mock_run.call_args.args[0][0] == \\\"codex\\\"\\r\\n 467: \\r\\n 468:     def test_hooks_are_not_skipped(self, executor):\\r\\n 469:         \\\"\\\"\\\".codex/hooks.json은 파일이 바뀔 때마다 untrusted로 돌아간다.\\r\\n 470:         trust를 우회하지 않으면 하네스 실행에서 TDD 가드가 조용히 안 걸린다.\\\"\\\"\\\"\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'git diff -- phases/32-harness-test-rot/index.json; git ls-files phases/32-harness-test-rot/*log phases/32-harness-test-rot/*report.json phases/32-harness-test-rot/index.json'\",\"aggregated_output\":\"diff --git a/phases/32-harness-test-rot/index.json b/phases/32-harness-test-rot/index.json\\nindex 3e65ec9..7c96579 100644\\n--- a/phases/32-harness-test-rot/index.json\\n+++ b/phases/32-harness-test-rot/index.json\\n@@ -23,7 +23,8 @@\\n     {\\n       \\\"step\\\": 2,\\n       \\\"name\\\": \\\"wire-into-ci\\\",\\n-      \\\"status\\\": \\\"pending\\\"\\n+      \\\"status\\\": \\\"pending\\\",\\n+      \\\"started_at\\\": \\\"2026-08-27T17:35:27+0900\\\"\\n     },\\n     {\\n       \\\"step\\\": 3,\\nphases/32-harness-test-rot/index.json\\nphases/32-harness-test-rot/step0-codex.stderr.log\\nphases/32-harness-test-rot/step0-codex.stdout.log\\nphases/32-harness-test-rot/step0-report.json\\nphases/32-harness-test-rot/step0a-report.json\\nphases/32-harness-test-rot/step1-codex.stderr.log\\nphases/32-harness-test-rot/step1-codex.stdout.log\\nphases/32-harness-test-rot/step1-report.json\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command '$p='\\\"'docs/ARCHITECTURE.md'; \\\"'$l=Get-Content -Encoding UTF8 $p; for($i=1;$i -le [Math]::Min(95,$l.Count);$i++){ '\\\"'{0,4}: {1}' -f \\\"'$i,$l[$i-1] }; Write-Output '\\\"'--- docs headers'; rg -n '\\\"'^#|''^##'\\\"' docs --glob '*.md'\\\"\",\"aggregated_output\":\"   1: # 아키텍처   2: \\r\\n   3: ## 디렉토리 구조\\r\\n   4: ```\\r\\n   5: src/\\r\\n   6: ├── app/                  # Next.js App Router — 페이지 셸만. 전부 클라이언트 컴포넌트\\r\\n   7: │   └── api/oncall/       #   유일한 예외: 운영 알림 수신 라우트 (ADR-017)\\r\\n   8: ├── components/\\r\\n   9: │   ├── plan/             # 평면 입력 에디터\\r\\n  10: │   ├── section/          # 부재 단면일람 테이블\\r\\n  11: │   ├── viewer/           # three.js 3D 뷰어\\r\\n  12: │   └── quantity/         # 물량 내역서 테이블\\r\\n  13: ├── domain/               # 순수 TypeScript. React·DOM·three.js 의존 금지\\r\\n  14: │   ├── model/            # Project / Member / Rebar 타입\\r\\n  15: │   ├── rules/            # 룰팩 로더 + 조회 엔진\\r\\n  16: │   ├── rebar/            # 철근 생성기 (柱, 大梁)\\r\\n  17: │   └── quantity/         # 물량 집계 (設計数量 → 할증률 조회 → 所要数量)\\r\\n  18: ├── rulepack/\\r\\n  19: │   └── jp-mlit/          # YAML 룰팩 (定着·重ね継手·折曲げ·かぶり·할증률)\\r\\n  20: ├── lib/                  # 직렬화, IndexedDB, exceljs, glTF, i18n\\r\\n  21: └── locales/              # ja.json (기본), ko.json (fallback → ja)\\r\\n  22: tests/\\r\\n  23: └── golden/               # 標準仕様書·수량적산기준 표 ↔ 엔진 출력 대조\\r\\n  24: ```\\r\\n  25: \\r\\n  26: 템플릿에 있던 `services/`(외부 API 래퍼)는 두지 않는다.\\r\\n  27: \\r\\n  28: 외부 API 호출은 둘뿐이다. **서버 쪽**은 운영 알림 수신 라우트(`app/api/oncall`)의\\r\\n  29: GitHub API 호출이다 (ADR-017). **브라우저 쪽**은 `src/lib/telemetry.ts`의\\r\\n  30: PostHog 계측이다 (ADR-020) — `capture()`·`captureException()`은 룰팩 key·화면\\r\\n  31: 이름·개수 같은 정적 라벨만 싣는다. `before_send`가 모든 이벤트의 유일한 관문으로\\r\\n  32: 서되 **허용목록으로 동작한다** — 이름을 아는 키만 통과시키고 나머지는 값을 보지\\r\\n  33: 않고 버린다. 예외 message(`$exception_list[].value`)는 아예 싣지 않는다:\\r\\n  34: `src/domain/rebar/`의 조회 실패 메시지가 도면 유래 mm 치수를 문자열 보간으로\\r\\n  35: 담고(예: `clearMm must be finite: ${clearMm}`), 라벨과 값이 한 문자열에 섞여\\r\\n  36: 있어 값만 골라낼 방법이 없기 때문이다. 위치는 스택 프레임이 대신한다. 도면\\r\\n  37: 데이터를 서버로 보내지 않는다는 CLAUDE.md CRITICAL 규칙은 이 경로에도 그대로\\r\\n  38: 적용된다.\\r\\n  39: \\r\\n  40: `types/`를 따로 두지 않고 `domain/model/`에 둔다. 타입과 그 타입을 다루는 순수 함수가 붙어 있는 편이 낫다.\\r\\n  41: \\r\\n  42: ## 패턴\\r\\n  43: \\r\\n  44: **도메인은 UI를 모른다.** `src/domain/`은 React·DOM·three.js·Next.js를 import하지 않는다. Node에서 그대로 실행되고, 그래서 골든테스트가 브라우저 없이 돈다. 이 경계가 이 프로젝트에서 가장 중요한 규칙이다.\\r\\n  45: \\r\\n  46: **`src/lib/`는 `src/components/`를 import하지 않는다.** 화면 배치 계산(`buildingLayout`·`rebarSegments`)은 순수 TS인데 처음엔 소비자가 뷰어 하나뿐이라 `src/components/viewer/`에 있었다. M4에서 glTF 書き出し라는 두 번째 소비자가 생기면서 그 위치가 「배포물 생성기가 UI 계층을 끌어온다」는 역참조를 만들었으므로 `src/lib/viewer/`로 내렸다. 판정 기준은 폴더가 아니라 **의존 방향**이다 — 그 모듈이 React·DOM을 쓰지 않는다면 컴포넌트 폴더에 둘 이유는 「지금 소비자가 UI뿐」이라는 사정뿐이고, 그 사정은 바뀐다.\\r\\n  47: \\r\\n  48: **룰 로직은 코드, 룰 수치는 데이터.** 어느 표를 볼지 결정하고 길이를 조합하는 것은 평범한 TS 함수로 쓴다. 그 함수가 읽는 **수치**는 `.ts` 파일에 리터럴로 나타나면 안 되고 전부 `rulepack/`의 YAML에서 조회한다.\\r\\n  49: \\r\\n  50: 이 분리는 취향이 아니다. 수치가 코드에 박히면 **항목 단위로 `confidence`를 붙일 수 없고** `inferred` 경고와 워터마크가 성립하지 않는다. 반대로 룰 DSL이나 평가기를 만들지도 않는다 — 로직은 함수로 충분하다.\\r\\n  51: \\r\\n  52: 룰팩 항목의 형태:\\r\\n  53: \\r\\n  54: ```yaml\\r\\n  55: - key: teichaku.L2\\r\\n  56:   conditions: { fc: 24, grade: SD345, hook: false }\\r\\n  57:   value: 35            # 배수(d)\\r\\n  58:   unit: d\\r\\n  59:   source:\\r\\n  60:     doc: 公共建築工事標準仕様書（建築工事編）令和7年版\\r\\n  61:     edition: 令和7年3月21日 国営建技第5号\\r\\n  62:     url: https://www.mlit.go.jp/gobuild/content/001888816.pdf\\r\\n  63:     page: null         # 원문 대조로 쪽을 특정하면 채운다\\r\\n  64:   confidence: inferred # stated | inferred — page가 null이면 stated일 수 없다\\r\\n  65: ```\\r\\n  66: \\r\\n  67: M0 이전에는 모든 항목이 `inferred`다. 쪽을 특정한 항목만 `stated`로 올린다.\\r\\n  68: \\r\\n  69: `confidence: inferred`는 원문에 명시되지 않아 추론으로 채운 값이거나, 원문 대조를 아직 하지 않은 값이다. 이 목록이 곧 \\\"일본 실무자를 만나면 물어볼 질문 목록\\\"이다. `source.page`가 없는 항목이 `stated`일 수는 없다 — 로더가 이를 검사한다.\\r\\n  70: \\r\\n  71: **할증률 룰은 부재 구분을 인자로 받는다.** 수량적산기준은 躯体 철근 4%(15쪽/PDF 20)와 별개로 흙막이벽 3%(8쪽/PDF 13)·말뚝 3%(9쪽/PDF 14)를 정한다. \\\"모든 철근 4%\\\"로 일반화하면 조용히 틀린 값이 나가므로, 지원 범위 밖의 부재 구분이 들어오면 값을 반환하지 않고 실패한다.\\r\\n  72: \\r\\n  73: **출처 표시는 법적 의무다.** 근거 자료는 PDL1.0(공공데이터이용규약 제1.0판) 준거로 상업적 이용·가공이 가능하나, 출처 표시와 개변 사실 표시가 요구된다. 룰팩의 `source` 필드와 UI 하단 고지가 이 의무를 충족한다. `source.url`은 UI에서 **클릭 가능한 링크**로 노출한다 — 원문 대조 비용을 0으로 만드는 것이 ADR-003이 이 문서를 고른 이유다.\\r\\n  74: \\r\\n  75: **서버 컴포넌트를 쓰지 않는다.** Next.js를 선택했지만 MVP에서 서버 렌더링의 이점이 없고, 캔버스·상태 중심 앱에서 RSC 경계는 방해만 된다. 계정·DB가 필요해지는 시점에 서버 컴포넌트를 도입한다.\\r\\n  76: \\r\\n  77: ## 데이터 흐름\\r\\n  78: ```\\r\\n  79: 평면 입력 + 단면일람\\r\\n  80:       ↓\\r\\n  81: Project (직렬화 가능한 순수 JSON)\\r\\n  82:       ↓\\r\\n  83: RebarGenerator(Member, RulePack) → Rebar[]           ← 규준 수치는 전부 룰팩 조회\\r\\n  84:       ↓\\r\\n  85: QuantityAggregator(Rebar[], RulePack) → QuantityLine[]\\r\\n  86:       設計数量 → 부재 구분별 할증률 조회 → 所要数量\\r\\n  87:       ↓\\r\\n  88: ┌─────────────┬──────────────────┬─────────────┐\\r\\n  89: │ 내역서 테이블 │ three.js         │ exceljs      │\\r\\n  90: │              │ InstancedMesh    │ glTF export  │\\r\\n  91: └─────────────┴──────────────────┴─────────────┘\\r\\n  92: ```\\r\\n  93: \\r\\n  94: 전 구간이 브라우저에서 돈다. 사용자 도면 데이터는 서버로 전송되지 않는다. 이는 성능 선택이 아니라 신뢰 선택이다 — 건설 도면과 물량은 기밀이다.\\r\\n  95: \\r\\n--- docs headers\\r\\ndocs\\\\ARCHITECTURE.md:1:# 아키텍처\\r\\ndocs\\\\ARCHITECTURE.md:3:## 디렉토리 구조\\r\\ndocs\\\\ARCHITECTURE.md:42:## 패턴\\r\\ndocs\\\\ARCHITECTURE.md:77:## 데이터 흐름\\r\\ndocs\\\\ARCHITECTURE.md:100:## 상태 관리\\r\\ndocs\\\\ADR.md:1:# Architecture Decision Records\\r\\ndocs\\\\ADR.md:3:## 철학\\r\\ndocs\\\\ADR.md:19:### ADR-001: 일본 기준으로 직행 (한국 기준을 거치지 않음)\\r\\ndocs\\\\ADR.md:24:### ADR-002: 룰 로직은 코드, 룰 수치는 데이터(룰팩)\\r\\ndocs\\\\ADR.md:29:### ADR-003: 근거 문서를 国交省 공개 자료로 고정 (`建築工事標準詳細図`는 제외)\\r\\ndocs\\\\ADR.md:36:### ADR-004: DWG 자동인식을 하지 않고 웹 간이 평면 입력을 받는다\\r\\ndocs\\\\ADR.md:41:### ADR-005: 철근 산정 범위를 柱 + 大梁으로 한정\\r\\ndocs\\\\ADR.md:48:### ADR-006: 계산을 전부 클라이언트에서 하고 서버 상태를 두지 않는다\\r\\ndocs\\\\ADR.md:53:### ADR-007: Vite가 아니라 Next.js App Router를 쓴다\\r\\ndocs\\\\ADR.md:58:### ADR-008: 기본 로케일은 `ja`, `ko`는 fallback 보조 로케일\\r\\ndocs\\\\ADR.md:63:### ADR-009: ~~設計数量만 산출하고 적산 할증은 사용자 계수로 받는다~~ (ADR-013으로 대체됨)\\r\\ndocs\\\\ADR.md:68:### ADR-010: 검증을 골든테스트(숫자)와 사람(UX)으로 분리한다\\r\\ndocs\\\\ADR.md:75:### ADR-011: 룰팩보다 워킹 스켈레톤을 먼저 만든다\\r\\ndocs\\\\ADR.md:80:### ADR-012: 主筋·帯筋 사양은 입력이며 제품이 바꾸지 않는다\\r\\ndocs\\\\ADR.md:85:### ADR-013: 設計数量과 所要数量을 모두 산출한다 (ADR-009 대체)\\r\\ndocs\\\\ADR.md:92:### ADR-014: 할증률 룰은 부재 구분을 인자로 받고 범위 밖이면 실패한다\\r\\ndocs\\\\ADR.md:97:### ADR-015: 미검증 수치는 차단하지 않고 경고 + 워터마크로 처리한다\\r\\ndocs\\\\ADR.md:102:### ADR-016: 3D 뷰어를 MVP에 유지한다\\r\\ndocs\\\\ADR.md:107:### ADR-017: 운영 알림 수신에 한해 서버 라우트를 둔다 (ADR-006 예외)\\r\\ndocs\\\\ADR.md:112:### ADR-018: 断面リスト 값을 PDF에서 브라우저 로컬로 파싱한다 (ADR-004 보완)\\r\\ndocs\\\\ADR.md:120:### ADR-019: 数量의 길이·본수는 数量積算基準을 따르고 3D 형상과 분리한다\\r\\ndocs\\\\ADR.md:132:### ADR-020: 프로덕션 관측에 한해 브라우저 텔레메트리를 둔다\\r\\ndocs\\\\ADR.md:154:### ADR-021: 大梁 主筋을 位置別(端部·中央)로 받고 差를 カットオフ筋으로 낸다 (ADR-012·ADR-019 적용)\\r\\ndocs\\\\ADR.md:164:### ADR-022: M3c의 일본 고유 상세는 근거가 있는 것만 산정하고, 나머지는 만들지 않는다\\r\\ndocs\\\\ADR.md:185:### ADR-023: `confidence`를 3단계로 나눈다 — 「원문에 없음」과 「검토가 1인」은 다른 사실이다\\r\\ndocs\\\\ADR.md:203:### ADR-024: M4의 산출물 — PDF는 브라우저 인쇄, glTF는 実寸, 내역서 양식은 하나의 spec에서 갈린다\\r\\ndocs\\\\ADR.md:227:### ADR-025: 부재 범위에 `耐震壁`을 넣는다 — 근거를 먼저 재고, 근거가 있는 하나만 (ADR-005 부분 대체)\\r\\ndocs\\\\ADR.md:269:### ADR-026: 高強度せん断補強筋を「呼び名」として受け取る — 規準にない製品を、規準を引かずに数える\\r\\ndocs\\\\ADR.md:293:### ADR-027: 円形柱を断面形状として持つ — 条文は形状を矩形に限っていない\\r\\ndocs\\\\ADR.md:311:### ADR-028: 부재 범위에 `床板（スラブ）`을 넣는다 — 조문이 가장 잘 갖춰진 나머지 하나 (ADR-005 추가 대체)\\r\\ndocs\\\\ADR.md:360:### ADR-029: 開口部를 部材 입력으로 받아 1通則8)로 欠除한다 — R14의 「틀린 채로 완성된 것」을 닫는다\\r\\ndocs\\\\ADR.md:395:### ADR-030: 伏図·軸組図의 텍스트 레이어에서 형상을 「후보」로 파싱한다 (ADR-004 재검토·ADR-018 확장)\\r\\ndocs\\\\ADR.md:419:### ADR-031: 伏図에서 通り芯과 스팬 치수만 읽는다 — ADR-018이 그은 「형상은 수동」의 경계를 옮긴다\\r\\ndocs\\\\ADR.md:456:### ADR-032: 大梁 主筋の左右非対称 端部를 모델·산정이 담는다 — R13의 모델 제약 해소\\r\\ndocs\\\\ADR.md:479:### ADR-033: 断面リスト 취입의 「도면 라벨↔始端/終端」 대응 — 정확 일치 자동, 그 외는 사용자 선택\\r\\ndocs\\\\ADR.md:494:### ADR-034: 開口補強筋은 設計図書 전사 입력으로 계상한다 — R14 잔여 해소\\r\\ndocs\\\\ADR.md:510:### ADR-035: 階 라벨↔`Story` 대응 — 정확 일치 자동, 그 외는 사용자 선택 (ADR-033 절차의 재적용)\\r\\ndocs\\\\ADR.md:524:### ADR-036: 雑壁은 부재가 아니라 壁의 区分으로 담는다 — 表5.3.6 かぶり와 40d 하한의 근거 정비\\r\\ndocs\\\\ADR.md:535:### ADR-037: 雑壁의 부분 높이·부분 길이는 部材 단위 内法 범위 전사 입력이다 — 자유단에는 定着이 없다\\r\\ndocs\\\\ADR.md:550:### ADR-038: 平面 페인에서 벽·床板을 놓고 지운다 — 잴 수 없는 자리에는 놓지 않는다\\r\\ndocs\\\\ADR.md:561:### ADR-039: 片持床板을 만든다 — ADR-028의 「두 원문 0건」 전제는 틀렸다\\r\\ndocs\\\\ADR.md:583:### ADR-040: 帯筋·あばら筋의 135°フック 余長을 3D 형상에 그린다 (R12)\\r\\ndocs\\\\ADR.md:711:### ADR-041: 룰팩 `stated` 승격을 위한 원문 대조 시트를 룰팩에서 생성한다 (R6)\\r\\ndocs\\\\ADR.md:797:### ADR-042: 壁式構造の壁은 별개의 마일스톤이다 — 조문을 전사하고 만들지 않는 것을 못박는다\\r\\ndocs\\\\M0-FINDINGS.md:1:# M0 조사 결과 — 배근 상세 근거의 공백 측정\\ndocs\\\\M0-FINDINGS.md:15:## 1. 判定 — 표는 텍스트다\\ndocs\\\\M0-FINDINGS.md:43:### 수치 개수\\ndocs\\\\M0-FINDINGS.md:75:### 실무상 가장 중요한 발견 — 「特記による」\\ndocs\\\\M0-FINDINGS.md:84:### DESIGN §10-4의 `r10`에 대하여\\ndocs\\\\M0-FINDINGS.md:93:## 2. 判定 — `標準詳細図`에는 배근 상세도가 없다 (R1 종결)\\ndocs\\\\M0-FINDINGS.md:126:## 3. 정오표\\ndocs\\\\M0-FINDINGS.md:133:## 4. M2로 넘어가는 것\\ndocs\\\\M0-FINDINGS.md:145:## 5. 재현 방법\\ndocs\\\\MILESTONES.md:1:# 마일스톤 현황\\r\\ndocs\\\\DESIGN.md:1:# DESIGN: Kijun UI 사양\\r\\ndocs\\\\DESIGN.md:7:## 0. 반입 경위와 출처\\r\\ndocs\\\\DESIGN.md:25:## 1. 디자인 토큰\\r\\ndocs\\\\DESIGN.md:49:## 2. 화면 구조\\r\\ndocs\\\\DESIGN.md:82:## 3. 상호 선택 모델\\r\\ndocs\\\\DESIGN.md:86:### 3.1 부재 그룹 선택 — `sel`\\r\\ndocs\\\\DESIGN.md:102:### 3.2 철근 행 강조 — `hoverRow`\\r\\ndocs\\\\DESIGN.md:118:## 4. 내역서 양식\\r\\ndocs\\\\DESIGN.md:146:### 4.1 算出式 디스클로저\\r\\ndocs\\\\DESIGN.md:158:### 4.2 CSV 내보내기\\r\\ndocs\\\\DESIGN.md:166:## 5. inferred 경고와 워터마크\\r\\ndocs\\\\DESIGN.md:182:## 6. 출처 표시 UI\\r\\ndocs\\\\DESIGN.md:206:## 7. 3D 뷰어\\r\\ndocs\\\\DESIGN.md:227:## 8. i18n\\r\\ndocs\\\\DESIGN.md:237:## 9. 디자인 시스템 자체의 불일치\\r\\ndocs\\\\DESIGN.md:250:## 10. 반입물이 프로젝트 규칙과 충돌하는 지점\\r\\ndocs\\\\DESIGN.md:269:## 11. 마일스톤 매핑\\r\\ndocs\\\\DESIGN.md:281:## 부록: 프로토타입 소재\\r\\ndocs\\\\ONCALL-ALERT.md:1:# oncall prod alert 1차 방어선 — 구성과 활성화 절차\\r\\ndocs\\\\ONCALL-ALERT.md:25:## 구성 현황 (2026-08-13 활성화 완료)\\r\\ndocs\\\\ONCALL-ALERT.md:31:### 1. Vercel 환경변수 (Production) — 설정됨\\r\\ndocs\\\\ONCALL-ALERT.md:46:### 2. GitHub Actions secret (판정 에이전트용)\\r\\ndocs\\\\ONCALL-ALERT.md:56:### 3. PostHog alert 목적지 3개 — 생성됨\\r\\ndocs\\\\ONCALL-ALERT.md:90:### 4. 관통 검증 (2026-08-13)\\r\\ndocs\\\\ONCALL-ALERT.md:98:## 판정 기준 요약\\r\\ndocs\\\\PRD.md:1:# PRD: Kijun (基準)\\r\\ndocs\\\\PRD.md:3:## 목표\\r\\ndocs\\\\PRD.md:6:### 이 제품이 자동으로 정하는 것과 정하지 않는 것\\r\\ndocs\\\\PRD.md:16:## 사용자\\r\\ndocs\\\\PRD.md:30:## 핵심 기능\\r\\ndocs\\\\PRD.md:37:## MVP 제외 사항\\r\\ndocs\\\\PRD.md:50:## 디자인\\r\\ndocs\\\\RISKS.md:1:# 열린 리스크\\r\\ndocs\\\\UX.md:1:# UX: Kijun 인터랙션 원칙과 사용자 이동 경로\\r\\ndocs\\\\UX.md:9:## 0. 전제와 적용 시점\\r\\ndocs\\\\UX.md:20:## 1. 근거 원칙 (Figma, 요약)\\r\\ndocs\\\\UX.md:34:## 2. 이 제품이 일반 웹앱과 다른 5가지\\r\\ndocs\\\\UX.md:46:## 3. 7원칙 → Kijun 규칙\\r\\ndocs\\\\UX.md:50:### 3.1 계층 구조 — 화면의 주인공은 `所要数量` 하나다\\r\\ndocs\\\\UX.md:60:### 3.2 점진적 공개 — 라우팅이 아니라 깊이로 한다\\r\\ndocs\\\\UX.md:80:### 3.3 일관성 — 벗어난 곳은 문서에 적힌 2건뿐\\r\\ndocs\\\\UX.md:94:### 3.4 대비 — 색은 장식이 아니라 경고 채널이다\\r\\ndocs\\\\UX.md:110:### 3.5 접근성 — 이 도구에서는 키보드가 주 입력이다\\r\\ndocs\\\\UX.md:128:### 3.6 근접성 — 비교할 것은 붙이고, 되돌릴 수 없는 것은 뗀다\\r\\ndocs\\\\UX.md:137:### 3.7 정렬 — 숫자의 소수점이 세로로 일직선이다\\r\\ndocs\\\\UX.md:148:## 4. 사용자 이동 경로 — 6단계 사다리\\r\\ndocs\\\\UX.md:163:### 4.1 단계 0의 결정: 빈 화면으로 시작하지 않는다\\r\\ndocs\\\\UX.md:175:### 4.2 단계 2의 결정: 저장 버튼이 없다\\r\\ndocs\\\\UX.md:185:### 4.3 단계 4의 결정: 내보내기를 조건부로 잠그지 않는다\\r\\ndocs\\\\UX.md:191:## 5. 막힘 처리 — 전역 배너 금지\\r\\ndocs\\\\UX.md:207:### 5.1 실패는 페인 안에서 끝난다\\r\\ndocs\\\\UX.md:228:## 6. 점진적 공개와 반복 사용의 충돌 처리\\r\\ndocs\\\\UX.md:236:## 7. 신뢰 장치를 유치 자산으로 (M2부터)\\r\\ndocs\\\\UX.md:251:## 8. 유치 퍼널 (M2부터)\\r\\ndocs\\\\UX.md:265:## 9. 하지 말 것\\r\\ndocs\\\\UX.md:281:## 10. 구현 체크리스트\\r\\ndocs\\\\UX.md:315:## 11. 현재 구현과의 대조 (2026-08-09 기준)\\r\\ndocs\\\\UX.md:319:### 11.1 남은 갭\\r\\ndocs\\\\UX.md:330:### 11.2 닫힌 갭 (2026-08-09)\\r\\ndocs\\\\UX.md:354:## 12. 마일스톤 게이트\\r\\ndocs\\\\SOURCES.md:1:# 근거 문서\\r\\ndocs\\\\SOURCES.md:6:## 정본 목록 (2026-08-09 확인)\\r\\ndocs\\\\SOURCES.md:30:## 수량적산기준에서 직접 확인한 값\\r\\ndocs\\\\SOURCES.md:46:### 第4編第3章 鉄筋の計測・計算 — 전문 전사 (2026-08-12, M2a)\\r\\ndocs\\\\SOURCES.md:66:## 제외 — 건축공사 표준상세도 (令和4年改定)\\r\\ndocs\\\\SOURCES.md:97:## 아직 확보하지 못한 것\\r\\ndocs\\\\SOURCES.md:105:## 적용 범위의 한계\\r\\ndocs\\\\SOURCES.md:114:## 골든테스트 픽스처\\r\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:1:# 토큰 사용 감사 — 2026-08-25\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:15:## 지금 적용할 3가지\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:29:## 1. 측정\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:31:### 1.1 비용의 성분\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:47:### 1.2 턴 단가 — 이 감사의 기준 단위\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:60:### 1.3 매 세션 자동 로드되는 파일 — 상시 비용\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:92:### 1.4 같은 파일을 2회 이상 통째로 읽은 사례 — 상위 10\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:113:### 1.5 단일 툴 결과가 컸던 상위 10\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:143:## 2. 진단\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:145:### (a) 상시 비용 — 매 세션 무조건 실리는 것\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:165:### (b) 반복 비용 — 같은 것을 다시 읽는 것\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:175:### (c) 폭발 비용 — 한 번에 크게 터지는 것\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:202:### (c)를 지배하는 것은 개별 출력이 아니라 세션 길이다\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:221:## 3. 처방\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:223:### 처방 1 — CLAUDE.md의 「지시」와 「이력」을 가른다\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:250:### 처방 2 — 파일 통째 읽기를 grep·범위 읽기로 바꿀 자리\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:262:### 처방 3 — 긴 출력에 거는 필터\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:282:### 처방 4 — codex 하네스로 넘겨 이쪽 컨텍스트를 안 먹게 할 작업 유형\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:304:## 4. 처방하지 않는 것\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:316:## 5. 미확인 / 미측정\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:327:## 부록 — 재현 명령\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:330:# 1. 스킬 집계\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:332:# → %TEMP%\\\\session_analysis.json  (161 세션, $3577.08, cache hit 98.2%)\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:334:# 2. 대시보드(선택)\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:338:# 3. 직접 스캔 (스크래치패드에 보존)\\ndocs\\\\reports\\\\TOKEN-AUDIT-2026-08-25.md:344:# 4. 지침 파일 크기\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:1:# 코드 구조 감사 — 2026-08-25\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:14:## 지금 손대야 할 3가지\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:16:### ① 도면 인식의 핵심 상수가 전 스위트 1411 테스트에 대해 무구속이다\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:35:### ② `src/domain/rebar/`에 같은 코드가 5~6벌 있고, 그중 하나는 같은 조문의 이중 구현이다\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:50:### ③ 지도가 코드와 어긋나 있고, 유일한 파이프라인이 React 훅 안에 있다\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:60:## 1. 지도\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:62:### 1.1 계층 판정 — **역참조 0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:73:### 1.2 디렉터리 × 디렉터리 (프로덕션만, 223엣지)\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:123:### 1.3 fan-in 상위 15 (파일 : 줄수 : 피참조수)\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:169:### 1.4 순환 의존 — **0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:176:## 2. 경계 위반 — 6항목\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:178:### 2-1. `src/domain/`이 react·next·three·DOM을 import하는가 → **0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:197:### 2-2. `.ts`에 규준 수치 리터럴이 있는가 → **0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:218:### 2-3. zustand 스토어에 파생 상태가 저장되는가 → **0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:230:### 2-4. `Project`에 클래스 인스턴스·함수·Date가 들어가는가 → **0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:241:### 2-5. 도면 데이터를 서버로 보내는 경로가 있는가 → **허용 예외 2개 외 0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:256:### 2-6. `src/rulepack/` 항목 중 source·confidence가 빠진 것 → **0건**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:276:## 3. 중복\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:280:### 3-1. `barDiameter` — 6벌 (domain 5 + lib 1) · **합쳐야 함(단, lib 쪽 1벌은 남긴다)**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:295:### 3-2. `millimetres` — 6벌, 바이트 동일 · **합쳐야 함**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:300:### 3-3. 5.3.4(5)(ｲ)(a)(b) 折曲げ定着 — 2벌 · **합쳐야 함 (①의 세 번째 항목)**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:307:### 3-4. `uniqueRuleHits` — 2벌 · **합쳐야 함**\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:311:### 3-5. `median` — 3벌, **그중 하나만 동작이 다르다** · 합쳐야 함\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:321:### 3-6. `SCALE_TOLERANCE_RATIO = 0.03` — 2벌 · 합쳐야 함(약함)\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:325:### 3-7. `translate(point, offset)` — 2벌 · 합쳐야 함(약함)\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:329:### 3-8. 브라우저 다운로드 앵커 6줄 — 2벌 · 판단 유보\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:333:### 3-9. 합치면 안 되는 것 — 부재별 산정 본체\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:342:### 3-10. 참고 — `src/components/` 쪽 쌍둥이 (요청 범위 밖이나 눈에 띔)\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:348:## 4. 테스트 반증력\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:352:### 골든테스트 (`tests/golden/`)\\ndocs\\\\reports\\\\AUDIT-2026-08-25.md:3