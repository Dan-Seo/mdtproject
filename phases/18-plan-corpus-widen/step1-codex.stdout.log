section-import/textitems/yokohama-p8.json'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nsrc\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\plan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\PlanImport.tsx:12:import { parseFramingPlan } from '@/lib/import/framing-plan/parse'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nsrc\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\plan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\PlanImport.tsx:214:    () => (pages ?? []).map((page) => parseFramingPlan(page)),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\r\\\\\\\\nphases\\\\\\\\\\\\\\\\17-total-unconfirmed-risk\\\\\\\\\\\\\\\\step0-codex.stdout.log:25:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_13\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"agent_message\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"저장소에는 이전 하네스 실행이 남긴 `index.json` 변경과 로그가 이미 있습니다. 로그는 건드리지 않고, 이번 step이 요구한 phase index 갱신만 반영하겠습니다. 현재 파서 코퍼스에는 8개 fixture가 있고, 이제 동일한 `parseFramingPlan` 경로로 파일·방향별 결과를 직접 재측정하겠습니다.\\\\\\\\\\\\\\\"}}\\\\\\\\r\\\\\\\\nphases\\\\\\\\\\\\\\\\17-total-unconfirmed-risk\\\\\\\\\\\\\\\\step0-codex.stdout.log:30:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_14\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Encoding utf8 phases/16-span1-record/step1-report.json'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"{\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"claims\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"A\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"verdict\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"refuted\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"measured\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"파일 | direction | labels | spansMm | totalConfirmed | issues\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n kani-p38.json | X | 4 (X1,X2,X3,X4) | [6000,6000,8000] | true | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n kani-p38.json | Y | 3 (Y3,Y2,Y1) | [6000,10500] | true | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n kani-p40.json | X | 0 (candidate 없음) | — | — | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n kani-p40.json | Y | 3 (Y1,Y2,Y3) | [10500,6000] | true | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n ojkk-p2.json | X | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n ojkk-p2.json | Y | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n ojkk-p3.json | X | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n ojkk-p3.json | Y | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p13.json | X | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p13.json | Y | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p14.json | X | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p14.json | Y | 0 (candidate 없음) | — | — | [通り芯ラベル未検出]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p7.json | X | 4 (bX1,bX2,bX3,cX1) | [8700,8700,1200] | false | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p7.json | Y | 6 (bY6,bY5,bY4,bY3,bY2,bY1) | [5000,6000,10000,6000,5000] | false | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p8.json | X | 3 (bX1,bX2,bX3) | [8700,8700] | false | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n yokohama-p8.json | Y | 0 (candidate 없음) | — | — | []\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"two_label_candidates\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"none — 8개 TextItem fixture에 parseFramingPlan을 실행한 grids 7건 모두 labels 수가 3 이상이며, 2개 후보는 0건이다.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tightening_breaks\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"합성 단위 테스트: src/lib/import/framing-plan/parse.test.ts에서 22개 중 7개 실패. 실패 경로는 X/Y 2라벨 후보, 쉼표 치수 2라벨 후보, 치수 누락 오류 보고, 반복 블록 접기, X·Y 혼재 오류 보고, 2라벨 격자의 미배치 부호 경로다. 실도면 대조: tests/plan-import/parse.test.ts 13개 모두 통과. 즉 실도면 후보 커버리지를 깨는 테스트는 none이고, 합성 입력에서만 2라벨 수용 계약이 깨진다.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"restored\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": true,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"why\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"코퍼스에는 라벨 2개짜리 후보가 없으므로 이 코퍼스에서 1본 축 수용을 제거해도 잃는 실도면 후보가 없다. 다만 기존 합성 테스트 7건이 2라벨 수용을 명시적으로 고정하므로 파서 일반 계약까지 없애는 것은 별도 변경이며, 실험 뒤 대상 코드는 원복했다.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"refuted_count\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"8부 코퍼스의 parseFramingPlan 그리드 후보는 모두 라벨 3개 이상이고 2개 후보가 0건이라, 이 코퍼스에서 1본 축 수용을 없애도 실도면 커버리지가 줄어든다는 주장은 반증됐다. 임시 차단은 합성 테스트 7건만 깨뜨렸고 실도면 대조 13건은 통과했으며 코드는 원복했다.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\r\\\\\\\\nphases\\\\\\\\\\\\\\\\17-total-unconfirmed-risk\\\\\\\\\\\\\\\\step0-codex.stdout.log:31:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_15\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Encoding utf8 phases/17-total-unconfirmed-risk/step0.md'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"# Step 0: R15가 가리키는 대상을 바꿔라 — 「1본 축」이 아니라 「合計이 확인되지 않은 축」\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nphase 16 step 1이 「1본 축을 거절하면 실도면 커버리지를 잃는다」를 반증했다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n그 측정을 교차검증하면서 R15의 전제가 어긋난 것이 드러났다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nR15는 이렇게 서 있다:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> **R15 (열림 — 스팬 1본 축의 검산 공회전)** framing-plan은 라벨 2개인 스팬\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> 1본 축도 후보를 내므로, 그 축에서는 合計와 스팬 합의 대조가 원리상 아무것도\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n> 배제하지 못한다. 남는 검증은 중점 매칭(±15pt) 하나라서 (...)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**노출의 서술은 맞다. 대상이 틀렸다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`totalConfirmed`는 `parse.ts:378`에서 `total !== undefined`다. 불일치는\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`parse.ts:369`에서 `合計不一致`로 **먼저 거절**되므로 `true`는 「찾았고 또\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n맞았다」는 뜻이고, `false`는 **合計이 아예 없어 검산이 돌지 않았다**는 뜻이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n즉 「검산이 공회전하고 중점 매칭만 남는다」는 상태는 1본 축의 전유물이 아니라\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**`totalConfirmed === false`인 축 전부**다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 힌트 — 그대로 베끼지 말고 직접 재라\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n교차검증에서 나온 값이다. **네 손으로 다시 재서 확인한 뒤에 쓰라.** 숫자가\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n다르면 네 측정을 믿고, 무엇이 어떻게 달랐는지 report에 적어라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n8부 코퍼스에 `parseFramingPlan`을 돌린 결과:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nkani-p38     X(축4) Y(축3)   totalConfirmed = true,  true\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nkani-p40     Y(축3)          totalConfirmed = true\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nyokohama-p7  X(축4) Y(축6)   totalConfirmed = false, false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nyokohama-p8  X(축3)          totalConfirmed = false\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nojkk-p2·p3, yokohama-p13·p14 → grids 0 (通り芯ラベル未検出)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 격자 **6건**. 축 2개(＝스팬 1본)짜리 **0건**.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- `totalConfirmed === false` **3건** — yokohama-p7 X·Y, yokohama-p8 X.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n즉 R15가 이름으로 단 경로는 코퍼스에 **0/6**이고, 같은 노출이 실제로\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n일어나는 경로는 **3/6**이다. 조이기 판단의 근거도 뒤집힌다 — 1본 축은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n조여도 잃는 것이 없지만(phase 16 step 1이 반증), 合計 없는 축을 조이면\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**yokohama 두 장을 통째로 잃는다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n**셈 정정 하나.** `phases/16-span1-record/step1-report.json`의 서술문은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n「grids 7건」이라 적었으나 실제는 **6건**이다. 같은 보고서의 표는 정확했고\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n서술문의 셈만 어긋났으며, 축 2개짜리가 0건이라는 **반증 판정은 그대로다.**\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n지난 phase의 보고서 파일은 기록이므로 **고치지 마라.** 새 문서에 7이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n흘러 들어가지 않게만 하고, 네 측정으로 6을 확인했다는 것을 report에 적어라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 할 일\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n### 1. `docs/RISKS.md`의 R15를 다시 써라\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n제목의 대상을 바꾸고(「스팬 1본 축」 → 合計이 확인되지 않은 축), 본문에\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n아래를 담아라. 문장은 네가 쓰되 기존 R 항목들의 어투를 따를 것.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 노출의 정의: `totalConfirmed === false`면 合計 검산이 돌지 않고 남는\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  검증은 중점 매칭(`MIDPOINT_TOLERANCE_PT = 15`) 하나다. 축척 일관성은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  스팬이 둘 이상이면 대조 상대가 있으므로 1본 축과 다르다 — 구분해서 써라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 코퍼스 실측: 격자 6건 중 3건이 `false`(yokohama-p7 X·Y, p8 X).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 1본 축은 **0/6**이고 phase 16 step 1이 「조여도 잃는 것이 없다」를\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  측정으로 확정했다. 그러나 **合計 없는 축을 조이면 yokohama 두 장을 잃는다** —\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  대상이 다르므로 그 반증을 이쪽 판단의 근거로 쓰지 마라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n한 줄 요약이므로 「合計이 확인되지 않은 축」과 「코퍼스 6건 중 3건」이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n들어가게 고쳐 쓰되, 표의 다른 행과 길이·어투를 맞춰라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 하지 말 것\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **코드를 고치지 마라.** 이 스텝은 문서뿐이다. `src/`·`tests/`에 변경이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  있으면 잘못된 것이다. `MIDPOINT_TOLERANCE_PT`도 그대로 15다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **`合計` 없는 축을 거절하게 만들지 마라.** 이 스텝은 기록이고, 조일지\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  말지는 step 1의 측정 뒤에 사람이 정한다. 근거 없이 조이면 실도면\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  커버리지가 조용히 줄어든다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **다른 R 항목을 손대지 마라.** R11이 순서에서 벗어나 끝에 있는 것도\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  그대로 둔다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- 지난 phase의 `step*-report.json`을 고치지 마라 — 기록이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n- **`scripts/execute.py`를 실행하지 마라** — 재귀다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## AC\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n1. `npm run test`·`npm run test:golden` 통과.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n2. `npx tsc --noEmit` 무출력, `npm run lint` 0 errors\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   (`route.test.ts:161`의 `_omitted` warning은 기존 것이다).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n3. `git diff -- src/ tests/`가 **비어 있다.** 확인하고 report에 적어라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n4. `docs/RISKS.md`에서 **R15 외의 항목이 바뀌지 않았다** — `git diff`로\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   hunk가 R15 하나인지 확인하고 report에 적어라.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n5. `CLAUDE.md`·`AGENTS.md` 둘 다 R15 행이 갱신됐고, 두 파일의 R15 행이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n   서로 같다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n## 산출물\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n`phases/17-total-unconfirmed-risk/step0-report.json`:\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```json\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n{\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"remeasured\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"grids\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"파일·방향별 축 수와 totalConfirmed, 그리고 총 격자 수\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"two_axis\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"축 2개짜리 후보 수\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"total_unconfirmed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"totalConfirmed=false인 격자와 그 소속 페이지\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"hint_mismatch\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"힌트와 다른 값이 나왔다면 무엇이 어떻게 달랐는가, 없으면 none\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"edits\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": [\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"고친 파일과 무엇을 고쳤는지\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"diff_check\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"AC3·AC4·AC5를 git diff로 확인한 결과\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"gates\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"golden\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tsc\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lint\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"},\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"index.json의 summary와 같은 요지\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\r\\\\\\\\nphases\\\\\\\\\\\\\\\\17-total-unconfirmed-risk\\\\\\\\\\\\\\\\step0-codex.stdout.log:33:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_16\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command 'Get-Content -Encoding utf8 tests/plan-import/parse.test.ts -TotalCount 125; Get-Content -Encoding utf8 tests/plan-import/parse.test.ts | Select-Object -Skip 125 -First 145'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"import { readFileSync } from 'node:fs'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  DIMENSION_PATTERN,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  parseFramingPlan,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n} from '@/lib/import/framing-plan/parse'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { PlanGridCandidate } from '@/lib/import/framing-plan/types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport type { TextPage } from '@/lib/import/section-list/types'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nimport { recoverRows, verticalRuns } from '@/lib/import/runs'\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// TextItem 픽스처 코퍼스는 section-import와 공유한다 — 좌표 규약과 표제란 제외를\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 한 파이프라인(scripts/extract-textitems.mjs)이 보증하기 때문이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ntype TextItemFixture = {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  items: TextPage['items']\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction readPage(file: string): TextPage {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const fixturePath = resolve(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    process.cwd(),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    'tests/fixtures/section-import/textitems',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    file,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const fixture = JSON.parse(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    readFileSync(fixturePath, 'utf8'),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  ) as TextItemFixture\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return { ...fixture.page, items: fixture.items }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nconst DRAWING_FIXTURES = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'kani-p38.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'kani-p40.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'ojkk-p2.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'ojkk-p3.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'yokohama-p13.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'yokohama-p14.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'yokohama-p7.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  'yokohama-p8.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction dimensionCandidates(page: TextPage): string[] {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const horizontal = recoverRows(page.items).flatMap((row) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    row.segments.map((segment) => segment.compact),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const vertical = verticalRuns(page.items).map((run) => run.text)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return [...horizontal, ...vertical].filter((text) =>\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    DIMENSION_PATTERN.test(text),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nit('실도면 8부의 가로·세로 치수 후보에는 0mm 이하가 없다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 이 가드는 파서 출력이 아니라 runs.ts의 세그먼트 문턱 불변식이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 실측상 기본 문턱에서는 8부 모두 0건이고, gapRatio를 0.5로 낮추면\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // yokohama-p14의 「650x1000」이 650·x·1·000으로 갈라져 000이 4건 나온다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 0.8·0.7·0.6에서는 침묵하므로 촘촘한 경계가 아닌 굵은 트립와이어다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 세로 `VERTICAL_RUN_GAP_RATIO`도 가로와 같은 굵은 트립와이어다. 8부 전체의 같은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 열 인접쌍에서 `gap / max(w)` 최솟값은 1.000000이고, 1 미만인 쌍은 0개였다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // (6자리 반올림 기준; 원시 최솟값은 부동소수 ULP 잔차로 0.9999999999999634).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 0.99·0.8·0.5·0.3에서는 모든 런이 1글자로 갈라져 `DIMENSION_PATTERN`\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // 통과가 0건이다. 배수가 정확히 1.0일 때는 창 `(1w, 2w)`의 하단 모서리에서\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // `00`·`000` 조각이 생겨 0mm 가드가 울며, kani-p38 3건 · ojkk-p3 21건 ·\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  // yokohama-p7 13건 · yokohama-p8 3건이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const measured = DRAWING_FIXTURES.map((file) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const candidates = dimensionCandidates(readPage(file))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      file,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      nonPositive: candidates.filter(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        (text) => Number.parseInt(text.replaceAll(',', ''), 10) <= 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  expect(measured).toEqual(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    DRAWING_FIXTURES.map((file) => ({ file, nonPositive: [] })),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 이 네 페이지 중 축 라벨 모양의 세그먼트를 가진 것은 yokohama-p14 하나뿐이다\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// (12개: `X2端`·`X3端`·`Y2端`·`Y3端`·`Y4端`·`Y5端`의 반복). yokohama-p13·ojkk-p2·\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// ojkk-p3은 각각 0개라 라벨 후보 자체가 없다. 이 구별은 폐지된 원본 테스트에도\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 명시돼 있었고, 실측 근거는 fa5ab24의 tests/section-import/plan-grid.test.ts에 남아 있다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 옛 grid-parse는 X2·X3를 먼저 라벨로 찾은 뒤, 스팬 1본 축은 검산이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 공회전한다는 이유로 `区間数不足`으로 거절했다. framing-plan은 기전이\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 다르다. 실제 세그먼트는 `X2端`·`Y4端`처럼 라벨 뒤에 `端`이 붙어 있고,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// sticky AXIS_LABEL_PATTERN은 X2를 매치한 뒤 남은 端까지 소비하지 못한다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// splitAxisLabels가 세그먼트 전체를 설명하지 못한 것으로 보고 빈 배열을\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 반환하므로, framing-plan은 라벨을 찾기 전 단계에서 `通り芯ラベル未検出`을 낸다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('断面リスト pages do not produce framing grids', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('does not invent grids from axis-like section marks', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const files = [\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'yokohama-p14.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'yokohama-p13.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'ojkk-p2.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'ojkk-p3.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ]\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      files.map((file) => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        const parsed = parseFramingPlan(readPage(file))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        return {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          file,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          grids: parsed.grids.length,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n          issues: parsed.issues,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      }),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        file: 'yokohama-p14.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        grids: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        issues: ['通り芯ラベル未検出'],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        file: 'yokohama-p13.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        grids: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        issues: ['通り芯ラベル未検出'],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        file: 'ojkk-p2.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        grids: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        issues: ['通り芯ラベル未検出'],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        file: 'ojkk-p3.json',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        grids: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n        issues: ['通り芯ラベル未検出'],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\nfunction grid(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  candidates: PlanGridCandidate[],\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  direction: 'X' | 'Y',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n): PlanGridCandidate {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const found = candidates.find((entry) => entry.direction === direction)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  expect(found, `missing ${direction} grid`).toBeDefined()\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  return found as PlanGridCandidate\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 기대값은 도면에서 독립 전사한 값이다 (원본: tests/fixtures/section-import/SOURCES.md).\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 축 위치(pt)는 도면 좌표라 여기 박지 않고 단조 증가만 본다 — 도면의 진실은\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 라벨 순서와 스팬 치수(mm)다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('yokohama p7 (2階床伏図・R階床伏図)', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('두 블록·양단 중복이 접혀 X·Y 각 1개의 후보가 남는다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.issues).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.grids).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('X: bX1–bX3·cX1, 스팬 8700·8700·1200', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const x = grid(parsed.grids, 'X')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(x.axes.map((axis) => axis.label)).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bX1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bX2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bX3',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'cX1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(x.spansMm).toEqual([8700, 8700, 1200])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(x.totalConfirmed).toBe(false)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('Y: bY6→bY1 (도면 그대로의 순서), 스팬 5000·6000·10000·6000·5000', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const y = grid(parsed.grids, 'Y')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(y.axes.map((axis) => axis.label)).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY6',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY5',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY4',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY3',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(y.spansMm).toEqual([5000, 6000, 10000, 6000, 5000])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(y.totalConfirmed).toBe(false)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('축 위치는 단조 증가하고 실측 축척은 1/100 부근이다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    for (const candidate of parsed.grids) {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      const positions = candidate.axes.map((axis) => axis.positionPt)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expect([...positions].sort((a, b) => a - b)).toEqual(positions)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      // 1/100 도면의 pt/mm = 72 / 25.4 / 100 ≈ 0.02835\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expect(candidate.scalePtPerMm).toBeGreaterThan(0.027)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      expect(candidate.scalePtPerMm).toBeLessThan(0.03)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('kani p38 (基礎伏図)', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const parsed = parseFramingPlan(readPage('kani-p38.json'))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('X: X1–X4, 스팬 6000·6000·8000 — 전체 치수 20,000으로 확인된다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const x = grid(parsed.grids, 'X')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(x.axes.map((axis) => axis.label)).toEqual(['X1', 'X2', 'X3', 'X4'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(x.spansMm).toEqual([6000, 6000, 8000])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(x.totalConfirmed).toBe(true)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('Y: 도면 좌→우가 Y3·Y2·Y1 — 스팬 6000·10500, 전체 16,500으로 확인된다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const y = grid(parsed.grids, 'Y')\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(y.axes.map((axis) => axis.label)).toEqual(['Y3', 'Y2', 'Y1'])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(y.spansMm).toEqual([6000, 10500])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(y.totalConfirmed).toBe(true)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('세부 치수 연쇄(2,800+3,200 등)는 중점 매칭이 배제한다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.issues).toEqual([])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.grids).toHaveLength(2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n})\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 아래 배치 기대값은 픽스처 좌표를 손으로 검산해 얻었다 (파서 출력에서 유도하지\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// 않는다 — ADR-010). 검산 근거: 좌블록의 通り芯 실좌표는 bX1=510·bX2=757·\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n// bX3=1003·cX1=1037(x), bY6=216·bY5=358·bY4=528·bY3=812·bY2=982·bY1=1123(y)이다.\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n//   C51@(528,207)  → x는 bX1(510)에서 18pt, y는 bY6(216)에서 9pt        → 格子点(0,0)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n//   G51@(880,335)  → x는 bX2–bX3 중점(880)에 정확히, y는 bY5(358)에서 23 → 辺 X(1,1)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n//   C53@(528,519)  → bX1(18) · bY4(9)                                    → 格子点(0,2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n//   CB52@(476,669) → bX1(34) · bY4–bY3 중점(670)에서 1pt                 → 辺 Y(0,2)\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\ndescribe('yokohama p7 — 부재 배치', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('두 장의 伏図가 각각 블록이 되고 제목을 원문대로 갖는다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(parsed.blocks.map((block) => block.title)).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      '2階床伏図1/100',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'R階床伏図1/100',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('블록마다 자기 위치의 通り芯을 갖는다 — 라벨은 같고 좌표는 다르다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const [left, right] = parsed.blocks\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(left.xGrid.axes.map((axis) => axis.label)).toEqual(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      right.xGrid.axes.map((axis) => axis.label),\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(left.xGrid.axes[0].positionPt).toBeLessThan(\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      right.xGrid.axes[0].positionPt,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(left.yGrid.axes.map((axis) => axis.label)).toEqual([\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY6',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY5',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY4',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY3',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY2',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      'bY1',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    ])\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n  it('柱는 格子点, 大梁는 辺으로 붙는다', () => {\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    const placements = parsed.blocks[0].placements\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(placements).toContainEqual({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      mark: 'C51',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      role: '格子点',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ix: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      iy: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(placements).toContainEqual({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      mark: 'C53',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      role: '格子点',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ix: 0,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      iy: 2,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    })\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n    expect(placements).toContainEqual({\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      mark: 'G51',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      role: '辺',\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      ix: 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n      iy: 1,\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\"}}\\\\\\\\r\\\\\\\\nphases\\\\\\\\\\\\\\\\17-total-unconfirmed-risk\\\\\\\\\\\\\\\\step0-codex.stdout.log:34:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item.started\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"item_18\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"npx tsx -e \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"import { readFileSync } from 'node:fs'; import { join } from 'node:path'; import { parseFramingPlan } from './src/lib/import/framing-plan/parse.ts'; const files=['kani-p38.json','kani-p40.json','ojkk-p2.json','ojkk-p3.json','yokohama-p13.json','yokohama-p14.json','yokohama-p7.json','yokohama-p8.json']; const rows=[]; for (const file of files) { const f=JSON.parse(readFileSync(join(process.cwd(),'tests/fixtures/section-import/textitems',file),'utf8')); const parsed=parseFramingPl