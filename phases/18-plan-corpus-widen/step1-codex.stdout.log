art = Math.min(...current.map(({ x }) => x))\\r\\n      const end = Math.max(...current.map((item) => item.x + horizontalWidth(item)))\\r\\n      clusters.push({\\r\\n        str: current.map(({ str }) => str).join(''),\\r\\n        x: (start + end) / 2,\\r\\n        y: current[0].y,\\r\\n        w: end - start,\\r\\n        h: Math.max(...current.map(({ h }) => h)),\\r\\n      })\\r\\n      current = []\\r\\n    }\\r\\n\\r\\n    for (const item of sorted) {\\r\\n      const previous = current[current.length - 1]\\r\\n      // ??湲????낫??踰뚯뼱吏硫??ㅻⅨ ?⑹씠????媛숈? ?됱쓽 臾닿???湲?먭퉴吏 ?댁쑝硫?      // 以묒떖??萸됯컻???대뒓 ?몃줈以꾩뿉??遺숈? ?딅뒗??洹멸굔 ?대? joinedRows媛 蹂몃떎)\\r\\n      const separated =\\r\\n        previous !== undefined &&\\r\\n        item.x - (previous.x + horizontalWidth(previous)) >\\r\\n          Math.max(horizontalWidth(previous), horizontalWidth(item))\\r\\n      if (separated) flush()\\r\\n      current.push(item)\\r\\n    }\\r\\n    flush()\\r\\n  }\\r\\n\\r\\n  return clusters\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뚯쟾 湲?먯쓽 w???몃줈 諛⑺뼢 ?대룞?됱씠??媛濡???씠 ?꾨땲????洹몃?濡??뷀븯硫?以묒떖?? * 諛??媛숈? ?몃줈以꾩쓽 ?⑹씠? ?댁씠 媛덈┛??\\r\\n */\\r\\nfunction horizontalWidth(item: TextItemFixture['items'][number]): number {\\r\\n  return item.rot !== undefined && item.rot !== 0 ? 0 : item.w\\r\\n}\\r\\n\\r\\nfunction columnRuns(\\r\\n  items: TextItemFixture['items'],\\r\\n  upward: boolean,\\r\\n): string[] {\\r\\n  // ?뺤닔 諛섏삱由?踰꾪궥? 媛믪씠 寃쎄퀎??嫄몃━硫?媛숈? ?몃줈以꾩쓣 媛덈씪?볥뒗?????뚯쟾 湲??  // x? ?⑹씠 以묒떖???ㅼ륫 ?닿툔?⑥? 0.1pt 誘몃쭔?댁?留?洹??ъ씠???뺤닔 寃쎄퀎媛 ?덈뒗吏??  // ?댁씠?? x ?ㅻ쫫李⑥닚 ?듭빱 泥댁씤? 洹?寃쎄퀎瑜??놁븻?? ?낅젰 ?쒖꽌(PDF ?먮낯 ?쒖꽌)??  // 醫뚯슦?섏? ?딄퀬 ????룄 ?듭빱+?덉슜?ㅼ감濡?媛뉙엺??\\r\\n  // ?ㅻ쭔 ?듭빱 泥댁씤? 諛섏삱由?臾띠쓬??珥덉쭛?⑹씠 **?꾨땲??* ???쇱そ 1pt ?덉뿉 臾닿???  // 湲?먭? ?섎굹 ?덉쑝硫??듭빱媛 洹몃━濡??뚮젮媛 ?ㅼそ??媛덈┛??99.0쨌99.6쨌100.4?먯꽌\\r\\n  // 諛섏삱由쇱? ???섏쓣 ?④퍡 100???ｌ?留??듭빱??99.6源뚯?留?臾띕뒗??. ?대뒓 履쎈룄\\r\\n  // ?쒕줈瑜??ы븿?섏? ?딆쑝誘濡??????몃떎 ???꾨씫? PII媛 洹몃?濡?而ㅻ컠?쒕떎\\r\\n  const columnTolerancePt = 1\\r\\n  const anchored = new Map<number, TextItemFixture['items']>()\\r\\n  const rounded = new Map<number, TextItemFixture['items']>()\\r\\n  let anchor: number | undefined\\r\\n\\r\\n  for (const item of [...items].sort((left, right) => left.x - right.x)) {\\r\\n    if (anchor === undefined || item.x - anchor > columnTolerancePt) {\\r\\n      anchor = item.x\\r\\n    }\\r\\n    anchored.set(anchor, [...(anchored.get(anchor) ?? []), item])\\r\\n\\r\\n    const key = Math.round(item.x)\\r\\n    rounded.set(key, [...(rounded.get(key) ?? []), item])\\r\\n  }\\r\\n\\r\\n  return [...anchored.values(), ...rounded.values()].flatMap((columnItems) => {\\r\\n    const sorted = [...columnItems].sort((left, right) =>\\r\\n      upward ? left.y - right.y : right.y - left.y,\\r\\n    )\\r\\n    const runs: string[] = []\\r\\n    let current: string[] = []\\r\\n    let previous: TextItemFixture['items'][number] | undefined\\r\\n\\r\\n    for (const item of sorted) {\\r\\n      const adjacent =\\r\\n        previous !== undefined &&\\r\\n        Math.abs(previous.y - item.y) <= Math.max(previous.h, item.h) * 2\\r\\n      if (!adjacent && current.length > 0) {\\r\\n        runs.push(current.join(''))\\r\\n        current = []\\r\\n      }\\r\\n      current.push(item.str)\\r\\n      previous = item\\r\\n    }\\r\\n    if (current.length > 0) runs.push(current.join(''))\\r\\n\\r\\n    return runs\\r\\n  })\\r\\n}\\r\\n\\r\\ndescribe('section-import TextItem fixtures', () => {\\r\\n  it.each(fixtures)('$file preserves dense, positioned drawing text', (spec) => {\\r\\n    const fixture = readFixture(spec.file)\\r\\n\\r\\n    expect(fixture.source).toEqual({\\r\\n      cacheFile: spec.cacheFile,\\r\\n      sha256: spec.sha256,\\r\\n      page: spec.page,\\r\\n    })\\r\\n    expect(fixture.page.widthPt).toBeGreaterThan(0)\\r\\n    expect(fixture.page.heightPt).toBeGreaterThan(0)\\r\\n    // ?쒖젣?(媛쒖씤 ?ㅻ챸쨌?곕씫泥?? 異붿텧 ?쒖젏???쒖쇅?쒕떎 ??諛???섑븳? 洹??쒖쇅 ?꾩쓽\\r\\n    // 理쒖냼 ?ㅼ륫(ojkk-p2 707)蹂대떎 ??쾶 ?≪븘, 鍮??쎌뒪泥샕룹젅???뚭?留?嫄몃윭?몃떎\\r\\n    expect(fixture.items.length).toBeGreaterThanOrEqual(600)\\r\\n\\r\\n    for (const item of fixture.items) {\\r\\n      expect(item.x).toBeGreaterThanOrEqual(0)\\r\\n      expect(item.x).toBeLessThan(fixture.page.widthPt)\\r\\n      expect(item.y).toBeGreaterThanOrEqual(0)\\r\\n      expect(item.y).toBeLessThan(fixture.page.heightPt)\\r\\n    }\\r\\n\\r\\n    // 諛???섑븳留뚯쑝濡쒕뒗 ?뚰몴?쒕? 泥?湲?먭? 寃쎄퀎 諛뽰뿉 ?⑥븘 而ㅻ컠?먮떎?띾? 紐??〓뒗????    // ?쒖쇅 ?ш컖???덉뿉 ?꾩씠?쒖씠 ?섎굹???놁뼱???쒕떎 (寃쎄퀎???앹꽦湲곗? 媛숈? ?뚯씪)\\r\\n    const excludeFrom = exclusions.pages[spec.file]\\r\\n    const leaked = fixture.items.filter(\\r\\n      ({ x, y }) => x >= excludeFrom.x && y >= excludeFrom.y,\\r\\n    )\\r\\n    // ?꾨옒 PII ?ㅼ틪怨?媛숈? 洹쒖빟 ???ㅽ뙣 硫붿떆吏???먮Ц???ｌ? ?딅뒗??\\r\\n    // ?댁꽌????곷룄 諛곗뿴???꾨땲??媛쒖닔?? 諛곗뿴???섍린硫?vitest媛 received濡?    // ?꾩씠???꾩껜(str ?ы븿)瑜?李띿뼱 硫붿떆吏留?怨좎퀜???먮Ц??濡쒓렇???⑤뒗??    expect(\\r\\n      leaked.length,\\r\\n      `title-block leak: ${leaked.length}餓?(?덆젺 x=${leaked[0]?.x}, y=${leaked[0]?.y})`,\\r\\n    ).toBe(0)\\r\\n\\r\\n    const rows = joinedRows(fixture.items)\\r\\n    // 醫뚰몴 寃?щ뒗 ?앹꽦湲곗? 媛숈? ?좎뼱???뚭꼍怨?諛뽰뿉 ?⑥? 媛쒖씤?뺣낫?띾? ?먮━??紐??〓뒗??\\r\\n    // 臾몄옄???꾩씠???⑥쐞濡?履쇨컻???덉쑝誘濡?媛濡쑣룹꽭濡??묒そ?쇰줈 ?댁뼱遺숈씤 ??蹂몃떎\\r\\n    const scanned = [...rows, ...joinedColumns(fixture.items)].map(\\r\\n      normalizedForScan,\\r\\n    )\\r\\n    for (const [label, pattern] of PII_MARKERS) {\\r\\n      // 留ㅼ튂???먮Ц? 李띿? ?딅뒗????而ㅻ컠??留됱븘??CI 濡쒓렇쨌?꾪떚?⑺듃???됰Ц?쇰줈\\r\\n      // ?⑥쑝硫??좎텧? 洹몃?濡쒕떎. ?꾩튂留??뚮젮二쇨퀬 ?ㅻЪ? 濡쒖뺄?먯꽌 蹂닿쾶 ?쒕떎\\r\\n      const hitIndex = scanned.findIndex((text) => pattern.test(text))\\r\\n      expect(hitIndex, `PII marker (${label}) at index ${hitIndex}`).toBe(-1)\\r\\n    }\\r\\n\\r\\n    for (const alternatives of spec.needles) {\\r\\n      expect(\\r\\n        alternatives.some((needle) =>\\r\\n          rows.some((row) => row.includes(needle)),\\r\\n        ),\\r\\n        `missing same-row text: ${alternatives.join(' or ')}`,\\r\\n      ).toBe(true)\\r\\n    }\\r\\n  })\\r\\n\\r\\n  it('reconstructs 潁?쎑??text so the PII scan is not bypassed by rotation', () => {\\r\\n    // 留덉빱 0嫄댁? ?뚯꽭濡쒕룄 遊ㅻ떎?띿쓽 利앷굅媛 紐??쒕떎 ???몃줈 梨꾨꼸???ㅼ젣濡?湲?먮?\\r\\n    // ?댁뼱遺숈씠?붿? 怨좎젙?쒕떎. ??0-D13?띿? ???쎌뒪泥섏뿉???몃줈濡쒕쭔 ?섑??쒕떎\\r\\n    const fixture = readFixture('kani-p38.json')\\r\\n\\r\\n    expect(joinedRows(fixture.items).some((row) => row.includes('10-D13'))).toBe(\\r\\n      false,\\r\\n    )\\r\\n    expect(joinedColumns(fixture.items)).toContain('10-D13')\\r\\n  })\\r\\n\\r\\n  it('reads 潁?쎑??in either rotation direction', () => {\\r\\n    // ?꾪뻾 ?쎌뒪泥섎뒗 ?꾨? rot=-90?대씪 +90? ?⑹꽦?쇰줈 怨좎젙?쒕떎 ????諛⑺뼢留??댁쑝硫?    // 諛섎? ?뚯쟾 臾몄옄?댁씠 ??닚???섏뼱 留덉빱媛 ?듭㎏濡?鍮좎졇?섍컙??    const vertical = (rot: number) =>\\r\\n      [...'TEL'].map((str, index) => ({\\r\\n        str,\\r\\n        x: 100,\\r\\n        y: rot > 0 ? 100 + index * 10 : 100 - index * 10,\\r\\n        w: 8,\\r\\n        h: 8,\\r\\n        rot,\\r\\n      }))\\r\\n\\r\\n    expect(joinedColumns(vertical(-90))).toContain('TEL')\\r\\n    expect(joinedColumns(vertical(90))).toContain('TEL')\\r\\n  })\\r\\n\\r\\n  it('keeps both directions readable when one x column holds both rotations', () => {\\r\\n    // 諛⑺뼢??x 踰꾪궥 ?⑥쐞濡?異붿륫?섎㈃ +90 湲???섎굹媛 媛숈? 踰꾪궥??-90 臾몄옄?댁쓣\\r\\n    // ?듭㎏濡??ㅼ쭛??留덉빱媛 鍮좎졇?섍컙??    const items = [\\r\\n      ...[...'TEL'].map((str, index) => ({\\r\\n        str,\\r\\n        x: 100,\\r\\n        y: 200 - index * 10,\\r\\n        w: 8,\\r\\n        h: 8,\\r\\n        rot: -90,\\r\\n      })),\\r\\n      ...[...'FAX'].map((str, index) => ({\\r\\n        str,\\r\\n        x: 100,\\r\\n        y: 100 + index * 10,\\r\\n        w: 8,\\r\\n        h: 8,\\r\\n        rot: 90,\\r\\n      })),\\r\\n    ]\\r\\n\\r\\n    const joined = joinedColumns(items)\\r\\n    expect(joined).toContain('TEL')\\r\\n    expect(joined).toContain('FAX')\\r\\n  })\\r\\n\\r\\n  it('does not let an unrotated glyph break a 潁?쎑??run in the same column', () => {\\r\\n    // ?뚯쟾 ?녿뒗 湲?먮? 媛숈? ???뿉 ?욎쑝硫??몃줈 ??媛?대뜲濡??쇱뼱?ㅼ뼱\\r\\n    // ?똖EL?띿씠 ?똖XEL?띿씠 ?섍퀬 留덉빱媛 洹몃?濡?鍮좎졇?섍컙??    const items = [\\r\\n      ...[...'TEL'].map((str, index) => ({\\r\\n        str,\\r\\n        x: 100,\\r\\n        y: 200 - index * 10,\\r\\n        w: 8,\\r\\n        h: 8,\\r\\n        rot: -90,\\r\\n      })),\\r\\n      { str: 'X', x: 100, y: 195, w: 8, h: 8 },\\r\\n    ]\\r\\n\\r\\n    expect(joinedColumns(items)).toContain('TEL')\\r\\n  })\\r\\n\\r\\n  it('reads unrotated 潁?쎑??stacked either way', () => {\\r\\n    // 醫뚰몴怨꾧? ?뚯쥖???먯젏, +y ?꾨옒?띾씪 ?꾟넂?꾨옒媛 y ?ㅻ쫫李⑥닚?대떎 ??臾댄쉶??    // ?몃줈?곌린瑜???諛⑺뼢?쇰줈留??댁쑝硫??듭㎏濡??ㅼ쭛? 留덉빱媛 鍮좎졇?섍컙??    const stacked = (step: number) =>\\r\\n      [...'TEL'].map((str, index) => ({\\r\\n        str,\\r\\n        x: 100,\\r\\n        y: 100 + index * step,\\r\\n        w: 8,\\r\\n        h: 8,\\r\\n      }))\\r\\n\\r\\n    expect(joinedColumns(stacked(10))).toContain('TEL')\\r\\n    expect(joinedColumns(stacked(-10))).toContain('TEL')\\r\\n  })\\r\\n\\r\\n  it('keeps the rounded grouping that the anchor chain would split', () => {\\r\\n    // ?듭빱 泥댁씤? ?쇱そ 1pt ?덉쓽 臾닿???湲?먯뿉 ?뚮젮媛꾨떎 ??99.0???듭빱媛 ?섎㈃\\r\\n    // 99.6源뚯?留?臾띠뿬 100.4媛 ?⑥뼱???섍컙?? 諛섏삱由쇱? 99.6怨?100.4瑜??④퍡\\r\\n    // 100???ｋ뒗?? ?대뒓 履쎈룄 ?쒕줈瑜??ы븿?섏? ?딆쑝誘濡??????댁빞 ?쒕떎\\r\\n    const items = [\\r\\n      { str: 'X', x: 99.0, y: 210, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'T', x: 99.6, y: 200, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'E', x: 100.4, y: 190, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'L', x: 100.4, y: 180, w: 8, h: 8, rot: -90 },\\r\\n    ]\\r\\n\\r\\n    expect(joinedColumns(items)).toContain('TEL')\\r\\n  })\\r\\n\\r\\n  it('joins a drifting column that stays inside the tolerance', () => {\\r\\n    // ?듭빱 泥댁씤???섎뒗 ???먯껜瑜?紐삳컯?붾떎 ??0.4pt??諛由щ뒗 ?몃줈以꾩? ?뺤닔\\r\\n    // 寃쎄퀎(100.5, 100.4? 100.8 ?ъ씠)瑜??섏뼱媛誘濡?諛섏삱由?踰꾪궥留뚯쑝濡쒕뒗 媛덈┛??\\r\\n    // ?낅젰 ?쒖꽌瑜??ㅼ쭛?대룄 媛숈? 臾몄옄?댁씠 ?섏????쒕떎\\r\\n    const items = [\\r\\n      { str: 'T', x: 100.4, y: 200, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'E', x: 100.8, y: 190, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'L', x: 101.2, y: 180, w: 8, h: 8, rot: -90 },\\r\\n    ]\\r\\n\\r\\n    expect(joinedColumns(items)).toContain('TEL')\\r\\n    expect(joinedColumns([...items].reverse())).toContain('TEL')\\r\\n  })\\r\\n\\r\\n  it('groups columns identically however the items are ordered', () => {\\r\\n    // ?쎌뒪泥섏쓽 ?꾩씠???쒖꽌??PDF ?먮낯 ?쒖꽌??x ?뺣젹???꾨땲?? ?뚮㉫? 留뚮뱾?댁쭊\\r\\n    // ?담띿뿉 遺숈씠硫?媛숈? ?몃줈以꾩씠 ?쎌엯 ?쒖꽌???곕씪 ?ㅻⅤ寃?媛덈젮, ?대뼡 ?꾨㈃?먯꽌??    // ?댁뼱吏怨??대뼡 ?꾨㈃?먯꽌???딄릿?????딄릿 履쎌? PII媛 洹몃?濡??듦낵?쒕떎.\\r\\n    // ?ш린??蹂대뒗 寃껋? ?뚭컳? 遺꾪븷???섏삤?붽??띾떎. 寃고빀 ?먯껜????耳?댁뒪媛\\r\\n    // 紐삳컯?붾떎 ???쒖꽌 ?섏〈? ?쒕━?꾪듃媛 ?덉슜?ㅼ감瑜??섏쓣 ?뚮쭔 ?쒕윭?섎뒗??洹?    // 援ш컙?먯꽌???대뒓 臾띔린濡쒕룄 ?곗씠 ?댁뼱吏吏 ?딆븘 ??耳?댁뒪濡?????蹂????녿떎\\r\\n    const items = [\\r\\n      { str: 'T', x: 100, y: 200, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'E', x: 100.9, y: 190, w: 8, h: 8, rot: -90 },\\r\\n      { str: 'L', x: 101.7, y: 180, w: 8, h: 8, rot: -90 },\\r\\n    ]\\r\\n\\r\\n    const forward = joinedColumns(items)\\r\\n    expect(forward.length).toBeGreaterThan(0)\\r\\n    expect([...joinedColumns([...items].reverse())].sort()).toEqual(\\r\\n      [...forward].sort(),\\r\\n    )\\r\\n  })\\r\\n\\r\\n  it('catches ?②쭜 contact strings that half-width markers would miss', () => {\\r\\n    // 留덉빱留덈떎 ?②쭜 ?댄삎???섏뿴?섎뒗 諛⑹떇? 諛섎뱶???섎굹瑜?鍮좊쑉由곕떎 ??CP932??    // 0x815C쨌0x817C留??대룄 U+2014쨌U+2015쨌U+2212濡?媛덈┛?? 留덉빱???딂쭜?쇰줈 ?먭퀬\\r\\n    // ?ㅼ틪 ??곸쓣 ?뺢퇋?뷀븳???꾨줈?뺤뀡 ?뚯꽌??`normalized`? 媛숈? 諛⑹떇)\\r\\n    const samples = [\\r\\n      '竊먲폆竊랃폂竊믭폆竊뷂펾竊뺧폋竊쀯폍', // ?②쭜?뤵궎?뺛꺍?욁궎?듽궧 U+FF0D\\r\\n      '竊먲폆?뷂폂竊믭폆竊붴뷂폊竊뽳폌竊?, // em dash U+2014\\r\\n      '竊먲폆?믭폂竊믭폆竊붴닋竊뺧폋竊쀯폍', // minus sign U+2212\\r\\n      '竊먲폆?볩폂竊믭폆竊붴볩폊竊뽳폌竊?, // en dash U+2013\\r\\n      '竊먲폆節곤폂竊믭폆竊뷂쉼竊뺧폋竊쀯폍', // ?딂쭜?룬윹 U+FF70\\r\\n      '節곻퐘節껓폖節섓퐯竊롳퐙節륅펿節딉퐧', // ?②쭜 硫붿씪 二쇱냼\\r\\n      '竊댐샵竊?竊먲폆竊덌폂竊믭폆竊뷂펹竊뺧폋竊쀯폍', // ?②쭜 ?쇰꺼 ??留덉빱???②쭜 遺꾧린媛 ?놁뼱??嫄몃┛??    ]\\r\\n\\r\\n    samples.forEach((sample, index) => {\\r\\n      const scanned = normalizedForScan(sample)\\r\\n      expect(\\r\\n        PII_MARKERS.some(([, pattern]) => pattern.test(scanned)),\\r\\n        `?②쭜 sample #${index} slipped through`,\\r\\n      ).toBe(true)\\r\\n    })\\r\\n  })\\r\\n\\r\\n  it('joins a rotated column that holds a single unrotated glyph', () => {\\r\\n    // ?뚯쟾쨌臾댄쉶?꾩쓣 ?욎? ?꾩닔 ?⑥뒪瑜?怨좎젙?쒕떎. 臾댄쉶??湲???섎굹???⑹씠 以묒떖??    // x+w/2濡?諛???⑹씠 ?⑥뒪濡쒕뒗 ?뚯쟾 ?댁뿉 遺숈? ?딄퀬, ?뚯쟾/臾댄쉶???꾩슜 ?⑥뒪??    // ?쒕줈?뚮씪 ?대뒓 履쎈룄 ?뉗? 紐삵븳?????꾩닔 ?⑥뒪瑜?吏?곕㈃ ??耳?댁뒪媛 源⑥쭊??    const items = [\\r\\n      ...[...'TE'].map((str, index) => ({\\r\\n        str,\\r\\n        x: 100,\\r\\n        y: 200 - index * 10,\\r\\n        w: 8,\\r\\n        h: 8,\\r\\n        rot: -90,\\r\\n      })),\\r\\n      { str: 'L', x: 100, y: 180, w: 8, h: 8 },\\r\\n    ]\\r\\n\\r\\n    expect(joinedColumns(items)).toContain('TEL')\\r\\n  })\\r\\n\\r\\n  it('reads a 潁╊릎與?run whose digits sit horizontally', () => {\\r\\n    // ?몃줈?곌린 ?덉쓽 ?レ옄留?媛濡쒕줈 ?뺣뒗 ?쒓린(?쒖젣? ?꾪솕踰덊샇媛 ???뺥깭??.\\r\\n    // ?レ옄??湲?먮쭏??x媛 媛덈┛ 梨??몃줈以?以묒떖??留욎떠 ?볦씤???????ㅺ? 湲??x??    // ?⑥뒪濡쒕뒗 ??移몃룄 ?댁뼱吏吏 ?딅뒗?? ?レ옄瑜?媛숈? x???몃줈濡??볦븘 ?먮㈃ ??    // 諛곗튂瑜??ы쁽?섏? 紐삵빐 ?뚯뒪?멸? ?듦낵?대룄 諛⑹뼱?좎씠 ?녿떎\\r\\n    const lineX = 100.4\\r\\n    const digits = (text: string, y: number) =>\\r\\n      [...text].map((str, index) => ({\\r\\n        str,\\r\\n        x: lineX - (text.length * 5) / 2 + index * 5,\\r\\n        y,\\r\\n        w: 5,\\r\\n        h: 10,\\r\\n      }))\\r\\n    // ?뚯쟾 湲?먯쓽 w???몃줈 諛⑺뼢 ?대룞?됱씠??x媛 怨??몃줈以?以묒떖?대떎. ?⑹씠 以묒떖怨쇰뒗\\r\\n    // 0.2pt ?닿툔???덇퀬 洹??ъ씠???뺤닔 寃쎄퀎媛 ?덈떎 ???ㅼ륫?먯꽌???닿툔?⑥? 0.1pt\\r\\n    // 誘몃쭔?댁뿀?쇰?濡? ???ㅻ? ?뺤닔濡?諛섏삱由쇳븯硫????곗? ?댁뿉 ?곕씪 ?딄릿??    const separator = (y: number) => ({\\r\\n      str: '-',\\r\\n      x: lineX + 0.2,\\r\\n      y,\\r\\n      w: 10,\\r\\n      h: 10,\\r\\n      rot: -90,\\r\\n    })\\r\\n    const items = [\\r\\n      ...digits('03', 100),\\r\\n      separator(110),\\r\\n      ...digits('1234', 120),\\r\\n      separator(130),\\r\\n      ...digits('5678', 140),\\r\\n    ]\\r\\n\\r\\n    // ?ㅼ틪怨?媛숈? 洹쒖튃?쇰줈 蹂몃떎 ???묎린瑜?嫄대꼫?곕㈃ ?뚯씠?대텤??ㅳ띿? ?뚭구由곕떎?띻?\\r\\n   