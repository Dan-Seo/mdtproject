) => ({ labels: level.labels, positionPt: level.positionPt })),\n    ),\n    titles: elevation.elevations.map((series) => series.titles),\n    issues: elevation.issues,\n  })\n}\n\nconst ratios = []\nconst ratiosByFile = {}\nconst firesAtOne = {}\nfor (const file of files) {\n  const page = pages.get(file)\n  const rotated = page.items\n    .filter((item) => item.str.trim().length > 0 && item.rot \"'!== undefined && Math.abs(item.rot + 90) < 0.01)\n    .sort((left, right) => left.x - right.x || right.y - left.y)\n  const fileRatios = []\n  for (let i = 1; i < rotated.length; i++) {\n    const previous = rotated[i - 1]\n    const item = rotated[i]\n    const gap = previous.y - item.y\n    if (Math.abs(previous.x - item.x) <= 1 && gap >= 0) {\n      fileRatios.push(gap / Math.max(previous.w, item.w))\n    }\n  }\n  ratios.push(...fileRatios)\n  ratiosByFile[file] = {\n    pairs: fileRatios.length,\n    min: fileRatios.length === 0 ? null : Math.min(...fileRatios),\n    pairs_1_5_to_2: fileRatios.filter((ratio) => ratio >= 1.5 && ratio <= 2).length,\n  }\n  const horizontal = runs.recoverRows(page.items).flatMap((row) => row.segments.map((segment) => segment.compact))\n  const vertical = runs.verticalRuns(page.items, 1).map((run) => run.text)\n  firesAtOne[file] = [...horizontal, ...vertical]\n    .filter((text) => parser15.DIMENSION_PATTERN.test(text))\n    .filter((text) => Number.parseInt(text.replaceAll('\"',', ''), 10) <= 0).length\n}\nconst oldFireTotal = Object.entries(firesAtOne).filter(([file]) => oldFiles.has(file)).reduce((sum, [, count]) => sum + count, 0)\nif (oldFireTotal \"'!== 40) throw new Error(`vertical 1.0 did not reach execution path: expected old total 40, got ${oldFireTotal}`)\n\nfunction concise(parsed) {\n  return {\n    grids: parsed.grids.map((grid) => ({\n      direction: grid.direction,\n      axes: grid.axes.length,\n      labels: grid.axes.map((axis) => axis.label),\n      spansMm: grid.spansMm,\n      scalePtPerMm: grid.scalePtPerMm,\n  