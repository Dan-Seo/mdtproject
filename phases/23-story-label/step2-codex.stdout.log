{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$files = @('\"'phases/23-story-label/index.json','src/components/plan/PlanImport.tsx','src/components/plan/PlanImport.test.tsx','src/components/section/SectionImport.tsx','tests/e2e/uc22-plan-import.js','src/locales/ja.json','src/locales/ko.json'); foreach (\"'$f in $files) { if (Test-Path $f) { Write-Output \"===== $f =====\"; Get-Content -LiteralPath $f -Raw } else { Write-Output \"===== $f (missing) =====\" } }'","aggregated_output":"===== phases/23-story-label/index.json =====\r\n{\r\n  \"project\": \"Kijun\",\r\n  \"phase\": \"23-story-label\",\r\n  \"steps\": [\r\n    {\r\n      \"step\": 0,\r\n      \"name\": \"verify-adr035-premises\",\r\n      \"kind\": \"verify\",\r\n      \"status\": \"refuted\",\r\n      \"started_at\": \"2026-08-26T16:10:02+0900\",\r\n      \"summary\": \"elevation ??stale storyId濡??롦쑋?뉐츣???꾨떖?섍퀬 PlanBlock.title??compact ?뺢퇋?붾릺硫?RF/R??吏곸젒 ?뚭? ?뚯뒪?멸? ?놁뼱 ADR-035 ?꾩젣瑜?諛섏쬆??\r\n    },\r\n    {\r\n      \"step\": 1,\r\n      \"name\": \"story-key-helpers\",\r\n      \"status\": \"completed\",\r\n      \"started_at\": \"2026-08-26T16:21:49+0900\",\r\n      \"completed_at\": \"2026-08-26T16:25:32+0900\",\r\n      \"summary\": \"compact() 湲곕컲 storyKey쨌storyLabelFromTitle ?쒖닔 ?ы띁? ?뚭? ?뚯뒪?몃? 異붽??섍퀬 test쨌typecheck쨌lint瑜??듦낵??,\r\n      \"report\": \"phases/23-story-label/step1-report.json\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"name\": \"plan-import-auto-select\",\r\n      \"status\": \"pending\",\r\n      \"started_at\": \"2026-08-26T16:28:08+0900\"\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"name\": \"filter-fallback-ledger\",\r\n      \"status\": \"pending\"\r\n    }\r\n  ],\r\n  \"created_at\": \"2026-08-26T16:10:00+0900\"\r\n}\r\n===== src/components/plan/PlanImport.tsx =====\r\n'use client'\r\n\r\nimport { useMemo, useRef, useState, type ChangeEvent } from 'react'\r\n\r\nimport {\r\n  applyElevation,\r\n  applyFramingPlan,\r\n  type ElevationApplyResult,\r\n  type PlanApplyResult,\r\n} from '@/lib/import/framing-plan/apply'\r\nimport { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\r\nimport { parseFramingPlan } from '@/lib/import/framing-plan/parse'\r\nimport type {\r\n  ElevationCandidate,\r\n  PlanBlock,\r\n  PlanGridCandidate,\r\n} from '@/lib/import/framing-plan/types'\r\nimport { extractTextPages } from '@/lib/import/pdf-text'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\nimport { useAppStore } from '@/lib/store'\r\nimport { t } from '@/lib/i18n'\r\n\r\nimport styles from './PlanImport.module.css'\r\n\r\n/**\r\n * 鴉뤷쎋쨌邕며탡?녹뿉???쎌? ?뺤긽??**?꾨낫濡?* 蹂댁뿬二쇨퀬, ?ъ슜?먭? ?뱀씤?섎㈃ 旅덁뻑??\n * ?ｋ뒗??(ADR-030). ??씊?ゃ궧??痍⑥엯(ADR-018)怨?媛숈? 洹쒖빟?대떎 ???뱀씤 ?꾩뿉??\n * ?뺤긽???섏? ?딄퀬, 紐??쎌? 寃껋? 吏?대궡吏 ?딄퀬 ?ъ쑀瑜?留먰븳??\r\n *\r\n * 媛꾩씠 ?됰㈃ ?먮뵒?곕? ?泥댄븯吏 ?딅뒗?? ?섏뒪???꾨㈃쨌誘몄? ?뺤떇?먯꽌?????붾㈃??\n * 鍮??꾨낫濡??뺤쭅?섍쾶 ?ㅽ뙣?섍퀬, 洹몃븣 ?뺤긽???ｋ뒗 湲몄? ?먯엯?λ퓧?대떎 (ADR-004).\r\n */\r\n\r\ninterface PlanImportProps {\r\n  /** ?뚯뒪?몄뿉??PDF 異붿텧??嫄대꼫?곌퀬 ?섏씠吏瑜?吏곸젒 ?ｋ뒗??*/\r\n  initialPages?: TextPage[]\r\n  extractPages?: (file: File) => Promise<TextPage[]>\r\n}\r\n\r\nfunction Axes({\r\n  candidate,\r\n  label,\r\n  testId,\r\n}: {\r\n  candidate: PlanGridCandidate\r\n  label: string\r\n  testId: string\r\n}) {\r\n  return (\r\n    <div className={styles.group} data-testid={testId}>\r\n      <h4 className={styles.groupTitle}>{label}</h4>\r\n      <p className={styles.axes}>\r\n        {candidate.axes.map((axis, index) => (\r\n          <span key={`${axis.label}-${index}`}>\r\n            <span className={styles.axis}>{axis.label}</span>\r\n            {index < candidate.spansMm.length ? (\r\n              <span className={styles.span}>\r\n                {` ??${candidate.spansMm[index]} ??`}\r\n              </span>\r\n            ) : null}\r\n          </span>\r\n        ))}\r\n      </p>\r\n    </div>\r\n  )\r\n}\r\n\r\nfunction Elevation({\r\n  candidate,\r\n  index,\r\n  locale,\r\n  onApply,\r\n  result,\r\n  discardMembers,\r\n  onDiscardMembersChange,\r\n}: {\r\n  candidate: ElevationCandidate\r\n  index: number\r\n  locale: 'ja' | 'ko'\r\n  onApply: (topLevelIndex: number, bottomLevelIndex: number) => void\r\n  result: ElevationApplyResult | null\r\n  discardMembers: boolean\r\n  onDiscardMembersChange: (next: boolean) => void\r\n}) {\r\n  // ?뚯뼱???덈꺼???롮쓽 寃쎄퀎?멸??띾뒗 議곕Ц???꾨땲???ㅺ퀎 ?섎룄???щ엺??怨좊Ⅸ??\n  // (ADR-030). 湲곕낯媛믪? ???????쒗뭹? ?묆꺀?싥긿?덉씠???븀쨴瑜??뚯븘蹂????놁쑝誘濡?\n  // 媛???볤쾶 ?≪븘 ?먭퀬 ?ъ슜?먭? 醫곹엺??\n  const [top, setTop] = useState(0)\r\n  const [bottom, setBottom] = useState(candidate.levels.length - 1)\r\n\r\n  const levelLabel = (levelIndex: number) => {\r\n    const level = candidate.levels[levelIndex]\r\n    return level.labels.length > 0\r\n      ? level.labels.join('竊?)\r\n      : t(locale, 'planImport.levelUnlabelled')\r\n  }\r\n\r\n  return (\r\n    <div\r\n      className={styles.elevation}\r\n      data-testid={`plan-import-elevation-${index}`}\r\n    >\r\n      <div className={styles.blockHeading}>\r\n        <strong>\r\n          {candidate.titles.join('??) ||\r\n            t(locale, 'planImport.elevationUntitled')}\r\n        </strong>\r\n        <button\r\n          type=\"button\"\r\n          className={styles.applyButton}\r\n          data-testid={`plan-import-apply-elevation-${index}`}\r\n          onClick={() => onApply(top, bottom)}\r\n        >\r\n          {t(locale, 'planImport.applyStories')}\r\n        </button>\r\n      </div>\r\n      <p className={styles.axes}>\r\n        {candidate.levels.map((level, levelIndex) => (\r\n          <span key={levelIndex}>\r\n            <span className={styles.axis}>\r\n              {level.labels.join('竊?) || '??}\r\n            </span>\r\n            {levelIndex < candidate.heightsMm.length ? (\r\n              <span className={styles.span}>\r\n                {` ??${candidate.heightsMm[levelIndex]} ??`}\r\n              </span>\r\n            ) : null}\r\n          </span>\r\n        ))}\r\n      </p>\r\n      <div className={styles.storyPicker}>\r\n        <label className={styles.storyPicker}>\r\n          {t(locale, 'planImport.topLevel')}\r\n          <select\r\n            data-testid={`plan-import-level-top-${index}`}\r\n            value={top}\r\n            onChange={(event) => setTop(Number(event.target.value))}\r\n          >\r\n            {candidate.levels.map((level, levelIndex) => (\r\n              <option key={levelIndex} value={levelIndex}>\r\n                {levelLabel(levelIndex)}\r\n              </option>\r\n            ))}\r\n          </select>\r\n        </label>\r\n        <label className={styles.storyPicker}>\r\n          {t(locale, 'planImport.bottomLevel')}\r\n          <select\r\n            data-testid={`plan-import-level-bottom-${index}`}\r\n            value={bottom}\r\n            onChange={(event) => setBottom(Number(event.target.value))}\r\n          >\r\n            {candidate.levels.map((level, levelIndex) => (\r\n              <option key={levelIndex} value={levelIndex}>\r\n                {levelLabel(levelIndex)}\r\n              </option>\r\n            ))}\r\n          </select>\r\n        </label>\r\n      </div>\r\n      {/* ?숈쓽??嫄곕?瑜???踰?蹂??ㅼ뿉留?臾쇱뼱蹂몃떎 */}\r\n      {result?.refusal === '?ⓩ쓲?귙굤?롧쉰?쎽툖?? ? (\r\n        <label className={styles.storyPicker}>\r\n          <input\r\n            type=\"checkbox\"\r\n            data-testid={`plan-import-discard-members-${index}`}\r\n            checked={discardMembers}\r\n            onChange={(event) => onDiscardMembersChange(event.target.checked)}\r\n          />\r\n          {t(locale, 'planImport.discardMembers')}\r\n        </label>\r\n      ) : null}\r\n      {result ? (\r\n        <p\r\n          className={styles.muted}\r\n          data-testid={`plan-import-elevation-result-${index}`}\r\n        >\r\n          {result.refusal\r\n            ? t(locale, `planImport.elevationRefusal.${result.refusal}`)\r\n            : `${t(locale, 'planImport.appliedStories')}: ${result.applied}`}\r\n        </p>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n\r\nexport function PlanImport({\r\n  initialPages,\r\n  extractPages = extractTextPages,\r\n}: PlanImportProps) {\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const stories = useAppStore(({ project }) => project.stories)\r\n  const sections = useAppStore(({ project }) => project.sections)\r\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n  const inputRef = useRef<HTMLInputElement>(null)\r\n  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\r\n  const [open, setOpen] = useState(initialPages !== undefined)\r\n  const [loading, setLoading] = useState(false)\r\n  const [failed, setFailed] = useState(false)\r\n  const [storyId, setStoryId] = useState<string>(stories[0]?.id ?? '')\r\n  const [sectionStoryLabel, setSectionStoryLabel] = useState<\r\n    string | undefined\r\n  >(undefined)\r\n  const [result, setResult] = useState<PlanApplyResult | null>(null)\r\n  const [discardOtherStories, setDiscardOtherStories] = useState(false)\r\n  const [discardMembers, setDiscardMembers] = useState(false)\r\n  const [elevationResults, setElevationResults] = useState<\r\n    Record<number, ElevationApplyResult>\r\n  >({})\r\n  // ?곗냽 ?좏깮 ????쾶 ?앸궃 ?댁쟾 ?뚯씪??寃곌낵媛 理쒖떊 寃곌낵瑜???? ?딄쾶 ?쒕떎\r\n  const requestRef = useRef(0)\r\n\r\n  const plans = useMemo(\r\n    () => (pages ?? []).map((page) => parseFramingPlan(page)),\r\n    [pages],\r\n  )\r\n  const elevations = useMemo(\r\n    () => (pages ?? []).flatMap((page) => parseFrameElevations(page).elevations),\r\n    [pages],\r\n  )\r\n  const grids = plans.flatMap((plan) => plan.grids)\r\n  const gridIndexes = { X: 0, Y: 0 }\r\n  const displayedGrids = grids.map((candidate) => ({\r\n    candidate,\r\n    index: gridIndexes[candidate.direction]++,\r\n  }))\r\n  const blocks: PlanBlock[] = plans.flatMap((plan) => plan.blocks)\r\n  const sectionStoryLabels = useMemo(() => {\r\n    const labels: string[] = []\r\n    const seen = new Set<string>()\r\n    for (const section of sections) {\r\n      if (!section.storyLabel || seen.has(section.storyLabel)) continue\r\n      seen.add(section.storyLabel)\r\n      labels.push(section.storyLabel)\r\n    }\r\n    return labels\r\n  }, [sections])\r\n  // ?ъ쑀???섏씠吏留덈떎 ?섏삤誘濡??묐뒗????媛숈? 留먯씠 ?섏씠吏 ?섎쭔???섏뼱?쒕㈃ ?쏀엳吏 ?딅뒗??\n  const issues = [...new Set(plans.flatMap((plan) => plan.issues))]\r\n\r\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n    const input = event.currentTarget\r\n    const file = input.files?.[0]\r\n    if (!file) return\r\n\r\n    const requestId = ++requestRef.current\r\n    setOpen(true)\r\n    setLoading(true)\r\n    setFailed(false)\r\n    setResult(null)\r\n    setElevationResults({})\r\n    try {\r\n      const next = await extractPages(file)\r\n      if (requestRef.current !== requestId) return\r\n      setPages(next)\r\n    } catch {\r\n      if (requestRef.current !== requestId) return\r\n      setPages(null)\r\n      setFailed(true)\r\n    } finally {\r\n      if (requestRef.current === requestId) setLoading(false)\r\n      input.value = ''\r\n    }\r\n  }\r\n\r\n  const apply = (block: PlanBlock) => {\r\n    let applied: PlanApplyResult | undefined\r\n    updateProject((project) => {\r\n      applied = applyFramingPlan(project, {\r\n        block,\r\n        storyId,\r\n        sectionStoryLabel,\r\n        discardOtherStories,\r\n      })\r\n      return applied.project\r\n    })\r\n    if (applied) setResult(applied)\r\n  }\r\n\r\n  const applyStories = (\r\n    candidate: ElevationCandidate,\r\n    index: number,\r\n    topLevelIndex: number,\r\n    bottomLevelIndex: number,\r\n  ) => {\r\n    let applied: ElevationApplyResult | undefined\r\n    updateProject((project) => {\r\n      applied = applyElevation(project, {\r\n        candidate,\r\n        topLevelIndex,\r\n        bottomLevelIndex,\r\n        discardMembers,\r\n      })\r\n      return applied.project\r\n    })\r\n    if (applied) {\r\n      const next = applied\r\n      setElevationResults((current) => ({ ...current, [index]: next }))\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.control}>\r\n      <button\r\n        type=\"button\"\r\n        className={styles.openButton}\r\n        onClick={() => {\r\n          if (pages) setOpen(true)\r\n          else inputRef.current?.click()\r\n        }}\r\n      >\r\n        {t(locale, 'planImport.open')}\r\n      </button>\r\n      <input\r\n        ref={inputRef}\r\n        className={styles.fileInput}\r\n        data-testid=\"plan-import-file\"\r\n        type=\"file\"\r\n        accept=\"application/pdf\"\r\n        aria-label={t(locale, 'planImport.file')}\r\n        onChange={(event) => void selectFile(event)}\r\n      />\r\n      {open ? (\r\n        <section\r\n          className={styles.panel}\r\n          role=\"dialog\"\r\n          aria-modal=\"false\"\r\n          aria-labelledby=\"plan-import-title\"\r\n        >\r\n          <header className={styles.panelHeader}>\r\n            <h3 id=\"plan-import-title\">{t(locale, 'planImport.title')}</h3>\r\n            <div className={styles.panelActions}>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.chooseButton}\r\n                onClick={() => inputRef.current?.click()}\r\n              >\r\n                {t(locale, 'planImport.chooseAnother')}\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.closeButton}\r\n                onClick={() => setOpen(false)}\r\n              >\r\n                {t(locale, 'planImport.close')}\r\n              </button>\r\n            </div>\r\n          </header>\r\n          <div className={styles.panelBody}>\r\n            {loading ? (\r\n              <p role=\"status\">{t(locale, 'planImport.loading')}</p>\r\n            ) : failed ? (\r\n              <p role=\"alert\">{t(locale, 'planImport.error')}</p>\r\n            ) : (\r\n              <>\r\n                {issues.length > 0 ? (\r\n                  <ul className={styles.issues} data-testid=\"plan-import-issues\">\r\n                    {issues.map((issue) => (\r\n                      <li key={issue}>\r\n                        {t(locale, `planImport.issue.${issue}`)}\r\n                      </li>\r\n                    ))}\r\n                  </ul>\r\n                ) : null}\r\n\r\n                {displayedGrids.map(({ candidate, index }) => (\r\n                  <Axes\r\n                    key={`${candidate.direction}-${index}`}\r\n                    candidate={candidate}\r\n                    label={t(\r\n                      locale,\r\n                      candidate.direction === 'X'\r\n                        ? 'planImport.gridX'\r\n                        : 'planImport.gridY',\r\n                    )}\r\n                    testId={`plan-import-grid-${candidate.direction}-${index}`}\r\n                  />\r\n                ))}\r\n\r\n                {sectionStoryLabels.length > 0 ? (\r\n                  <label className={styles.storyPicker}>\r\n                    {t(locale, 'planImport.sectionStory')}\r\n                    <select\r\n                      data-testid=\"plan-import-section-story\"\r\n                      value={sectionStoryLabel ?? ''}\r\n                      onChange={(event) =>\r\n                        setSectionStoryLabel(\r\n                          event.target.value === ''\r\n                            ? undefined\r\n                            : event.target.value,\r\n                        )\r\n                      }\r\n                    >\r\n                      <option value=\"\">\r\n                        {t(locale, 'planImport.sectionStoryAny')}\r\n                      </option>\r\n                      {sectionStoryLabels.map((label) => (\r\n                        <option key={label} value={label}>\r\n                          {label}\r\n                        </option>\r\n                      ))}\r\n                    </select>\r\n                  </label>\r\n                ) : null}\r\n\r\n                {blocks.length > 0 ? (\r\n                  <label className={styles.storyPicker}>\r\n                    {t(locale, 'planImport.story')}\r\n                    <select\r\n                      data-testid=\"plan-import-story\"\r\n                      value={storyId}\r\n                      onChange={(event) => setStoryId(event.target.value)}\r\n                    >\r\n                      {stories.map((story) => (\r\n                        <option key={story.id} value={story.id}>\r\n                          {story.name}\r\n                        </option>\r\n                      ))}\r\n                    </select>\r\n                  </label>\r\n                ) : null}\r\n\r\n                {blocks.map((block, index) => (\r\n                  <div\r\n                    key={`${block.title ?? 'block'}-${index}`}\r\n                    className={styles.block}\r\n                  >\r\n                    <div className={styles.blockHeading}>\r\n                      <strong>\r\n                        {block.title ?? t(locale, 'planImport.blockUntitled')}\r\n                      </strong>\r\n                      <button\r\n                        type=\"button\"\r\n                        className={styles.applyButton}\r\n                        data-testid={`plan-import-apply-${index}`}\r\n                        onClick={() => apply(block)}\r\n                      >\r\n                        {t(locale, 'planImport.apply')}\r\n                      </button>\r\n                    </div>\r\n                    <p className={styles.muted}>\r\n                      {`${t(locale, 'planImport.placements')}: ${block.placements.length}`}\r\n                      {block.unplacedMarks.length > 0\r\n                        ? ` / ${t(locale, 'planImport.unplaced')}: ${block.unplacedMarks.join('??)}`\r\n                        : ''}\r\n                    </p>\r\n                    <Axes\r\n                      candidate={block.xGrid}\r\n                      label={t(locale, 'planImport.gridX')}\r\n                      testId={`plan-import-block-grid-${index}-X`}\r\n                    />\r\n                    <Axes\r\n                      candidate={block.yGrid}\r\n                      label={t(locale, 'planImport.gridY')}\r\n                      testId={`plan-import-block-grid-${index}-Y`}\r\n                    />\r\n                  </div>\r\n                ))}\r\n\r\n                {elevations.map((candidate, index) => (\r\n                  <Elevation\r\n                    key={index}\r\n                    candidate={candidate}\r\n                    index={index}\r\n                    locale={locale}\r\n                    result={elevationResults[index] ?? null}\r\n                    discardMembers={discardMembers}\r\n                    onDiscardMembersChange={setDiscardMembers}\r\n                    onApply={(topLevel, bottomLevel) =>\r\n                      applyStories(candidate, index, topLevel, bottomLevel)\r\n                    }\r\n                  />\r\n                ))}\r\n\r\n                {/* ?숈쓽??嫄곕?瑜???踰?蹂??ㅼ뿉留?臾쇱뼱蹂몃떎 ??泥섏쓬遺???대넃?쇰㈃\r\n                    ?뚮Т???살씤吏 紐⑤Ⅸ 梨?耳??먮뒗 移멥띿씠 ?쒕떎 */}\r\n                {result?.refusal === '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖?? ? (\r\n                  <label className={styles.storyPicker}>\r\n                    <input\r\n                      type=\"checkbox\"\r\n                      data-testid=\"plan-import-discard\"\r\n                      checked={discardOtherStories}\r\n                      onChange={(event) =>\r\n                        setDiscardOtherStories(event.target.checked)\r\n                      }\r\n                    />\r\n                    {t(locale, 'planImport.discardOtherStories')}\r\n                  </label>\r\n                ) : null}\r\n\r\n                {result ? (\r\n                  <p className={styles.muted} data-testid=\"plan-import-result\">\r\n                    {result.refusal\r\n                      ? t(locale, `planImport.refusal.${result.refusal}`)\r\n                      : `${t(locale, 'planImport.applied')}: ${result.applied}`}\r\n                    {result.skipped.length > 0\r\n                      ? ` / ${result.skipped\r\n                          .map(\r\n                            ({ mark, reason }) =>\r\n                              `${mark}(${t(locale, `planImport.skip.${reason}`)})`,\r\n                          )\r\n                          .join('??)}`\r\n                      : ''}\r\n                  </p>\r\n                ) : null}\r\n              </>\r\n            )}\r\n          </div>\r\n        </section>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n\r\n===== src/components/plan/PlanImport.test.tsx =====\r\nimport { act, fireEvent, render, screen, waitFor } from '@testing-library/react'\nimport { beforeEach, describe, expect, it, vi } from 'vitest'\n\nimport { createSampleProject } from '@/domain/model/sample-project'\nimport type { TextItem } from '@/lib/import/types'\nimport type { TextPage } from '@/lib/import/section-list/types'\nimport { useAppStore } from '@/lib/store'\n\nimport planFixture from '../../../tests/fixtures/section-import/textitems/yokohama-p7.json'\nimport elevationFixture from '../../../tests/fixtures/section-import/textitems/yokohama-p8.json'\n\nimport { PlanImport } from './PlanImport'\n\nconst planPage: TextPage = { ...planFixture.page, items: planFixture.items }\nconst elevationPage: TextPage = {\n  ...elevationFixture.page,\n  items: elevationFixture.items,\n}\n\nfunction h(str: string, x: number, y: number): TextItem {\n  return { str, x, y, w: 0, h: 8 }\n}\n\nfunction v(str: string, x: number, y: number): TextItem {\n  return { str, x, y, w: 8, h: 0, rot: -90 }\n}\n\nfunction framingPage(xSpanMm: number, ySpanMm: number): TextPage {\n  return {\n    widthPt: 1000,\n    heightPt: 1000,\n    items: [\n      h('X1', 0, -40),\n      h('X2', 200, -40),\n      h(String(xSpanMm), 100, -20),\n      h('Y1', -40, 0),\n      h('Y2', -40, 200),\n      v(String(ySpanMm), -20, 100),\n    ],\n  }\n}\n\nbeforeEach(() => {\n  act(() => {\n    useAppStore.setState({ project: createSampleProject() })\n  })\n})\n\nfunction open(pages: TextPage[]) {\n  render(<PlanImport initialPages={pages} />)\n}\n\ndescribe('PlanImport', () => {\n  it('鴉뤷쎋?먯꽌 ?쎌? ?싥굤??쓣 ?쇰꺼怨??ㅽ뙩?쇰줈 蹂댁뿬以??, () => {\n    open([planPage])\n\n    const grid = screen.getByTestId('plan-import-grid-X-0')\n    expect(grid.textContent).toContain('bX1')\n    expect(grid.textContent).toContain('cX1')\n    expect(grid.textContent).toContain('8700')\n    expect(screen.getByTestId('plan-import-grid-Y-0').textContent).toContain(\n      '10000',\n    )\n    expect(screen.queryByTestId('plan-import-section-story')).toBeNull()\n  })\n\n  it('??씊訝誤㏃쓽 ???꾨낫瑜?泥??깆옣 ?쒖꽌濡?蹂댁뿬二쇨퀬 湲곕낯媛믪? 怨좊Ⅴ吏 ?딆쓬?대떎', () => {\n    const base = createSampleProject()\n    const source = base.sections.find((section) => section.kind === '??)\n    if (!source) throw new Error('sample has no ??section')\n\n    act(() => {\n      useAppStore.setState({\n        project: {\n          ...base,\n          sections: [\n            { ...source, id: 'section-C1-2??, mark: 'C1', storyLabel: '2?? },\n            { ...source, id: 'section-C1-1??, mark: 'C1', storyLabel: '1?? },\n            { ...source, id: 'section-C2-2??, mark: 'C2', storyLabel: '2?? },\n          ],\n        },\n      })\n    })\n\n    open([framingPage(6000, 5000)])\n\n    const picker = screen.getByTestId('plan-import-section-story')\n    expect(picker).toHaveValue('')\n    expect(\n      [...picker.querySelectorAll('option')].map((option) => option.value),\n    ).toEqual(['', '2??, '1??])\n  })\n\n  it('紐⑤뱺 ?싥굤???꾨낫? 釉붾줉留덈떎 吏앹??댁쭊 ?먭린 ?싥굤??쓣 蹂댁뿬以??, () => {\n    open([framingPage(6000, 5000), framingPage(8000, 7000)])\n\n    expect(screen.getByTestId('plan-import-grid-X-0').textContent).toContain(\n      '6000',\n    )\n    expect(screen.getByTestId('plan-import-grid-X-1').textContent).toContain(\n      '8000',\n    )\n    expect(screen.getByTestId('plan-import-grid-Y-0').textContent).toContain(\n      '5000',\n    )\n    expect(screen.getByTestId('plan-import-grid-Y-1').textContent).toContain(\n      '7000',\n    )\n    expect(\n      screen.getByTestId('plan-import-block-grid-0-X').textContent,\n    ).toContain('6000')\n    expect(\n      screen.getByTestId('plan-import-block-grid-0-Y').textContent,\n    ).toContain('5000')\n    expect(\n      screen.getByTestId('plan-import-block-grid-1-X').textContent,\n    ).toContain('8000')\n    expect(\n      screen.getByTestId('plan-import-block-grid-1-Y').textContent,\n    ).toContain('7000')\n    expect(\n      [\n        ...document.querySelectorAll(\n          '[data-testid^=\"plan-import-block-grid-0-\"]',\n        ),\n      ].map(\n        (node) => node.getAttribute('data-testid'),\n      ),\n    ).toEqual(['plan-import-block-grid-0-X', 'plan-import-block-grid-0-Y'])\n  })\n\n  it('鴉뤷쎋 ???λ쭏??釉붾줉???쒕ぉ怨??④퍡 蹂댁뿬以??, () => {\n    open([planPage])\n\n    expect(screen.getByText('2?롥틞鴉뤷쎋1/100')).toBeTruthy()\n    expect(screen.getByText('R?롥틞鴉뤷쎋1/100')).toBeTruthy()\n  })\n\n  it('邕며탡?녹쓽 ?롩쳵瑜??쇰꺼怨??④퍡 蹂댁뿬以??, () => {\n    open([elevationPage])\n\n    const elevation = screen.getByTestId('plan-import-elevation-0')\n    expect(elevation.textContent).toContain('4480')\n    expect(elevation.textContent).toContain('2FL')\n    // 媛숈? ?믪씠???쇰꺼 ?섏? ????蹂댁씤?????대뒓 履쎌씠 ?롮씤吏 ?쒗뭹??怨좊Ⅴ吏 ?딅뒗??    expect(elevation.textContent).toContain('訝?ㄾ汝?FL')\n    expect(elevation.textContent).toContain('?뷸틬GL')\n  })\n\n  it('沃?굙?ゃ걢?ｃ걼?꾨㈃? ?ъ쑀瑜?留먰븳????鍮??붾㈃?쇰줈 ?먯? ?딅뒗??, () => {\n    open([{ widthPt: 100, heightPt: 100, items: [] }])\n\n    expect(screen.getByTestId('plan-import-issues').textContent).toBeTruthy()\n  })\n\n  it('?ㅻⅨ 痢듭뿉 遺?ш? ?덉쑝硫??싥굤??쓣 留먯뾾??諛붽씀吏 ?딅뒗??, async () => {\n    // ?섑뵆 旅덁뻑?먮뒗 ?대? ?щ윭 痢듭쓽 遺?ш? ?덈떎. 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬\n    // ?덉뼱?? ?ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭씠 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎\n    const before = useAppStore.getState().project\n    open([planPage])\n\n    fireEvent.click(screen.getByTestId('plan-import-apply-0'))\n\n    await waitFor(() => {\n      expect(screen.getByTestId('plan-import-result').textContent).toBeTruthy()\n    })\n    expect(useAppStore.getState().project.grid).toEqual(before.grid)\n    // ?숈쓽瑜?臾삳뒗 移몄? 嫄곕?瑜?蹂??ㅼ뿉 ?섏삩??    expect(screen.getByTestId('plan-import-discard')).toBeTruthy()\n  })\n\n  it('?숈쓽?섎㈃ ?싥굤??낵 遺?ш? 旅덁뻑???ㅼ뼱媛꾨떎', async () => {\n    open([planPage])\n\n    fireEvent.click(screen.getByTestId('plan-import-apply-0'))\n    await waitFor(() => screen.getByTestId('plan-import-discard'))\n    fireEvent.click(screen.getByTestId('plan-import-discard'))\n    fireEvent.click(screen.getByTestId('plan-import-apply-0'))\n\n    await waitFor(() => {\n      const { project } = useAppStore.getState()\n      expect(project.grid.xSpans).toEqual([8700, 8700, 1200])\n      expect(project.grid.ySpans).toEqual([5000, 6000, 10000, 6000, 5000])\n    })\n  })\n\n  it('?뽩뀯 寃곌낵瑜??ｌ? 紐삵븳 寧?뤇怨??ъ쑀濡?蹂닿퀬?쒕떎', async () => {\n    open([planPage])\n\n    fireEvent.click(screen.getByTestId('plan-import-apply-0'))\n    await waitFor(() => screen.getByTestId('plan-import-discard'))\n    fireEvent.click(screen.getByTestId('plan-import-discard'))\n    fireEvent.click(screen.getByTestId('plan-import-apply-0'))\n\n    await waitFor(() => {\n      // ?섑뵆 旅덁뻑????씊訝誤㏃뿉?????꾨㈃??寧?뤇???녿떎 ??吏?대궡吏 ?딄퀬 ?ъ쑀瑜?留먰븳??      expect(screen.getByTestId('plan-import-result').textContent).toContain(\n        'C51',\n      )\n    })\n  })\n\n  it('?롩쳵瑜?旅덁뻑???롫줈 ?ｋ뒗?????대뒓 ?덈꺼???롮씤吏???щ엺??怨좊Ⅸ??, async () => {\n    open([elevationPage])\n\n    // 訝?ㄾ汝?FL(index 3)?먯꽌 訝?ㄾ汝웂CL(index 1)源뚯? ??1??4480쨌2??4100.\n    // ?묆꺀?싥긿??1400)? ?븀쨴(2690)???롪? ?꾨땲誘濡?踰붿쐞 諛뽰씠??    fireEvent.change(screen.getByTestId('plan-import-level-top-0'), {\n      target: { value: '1' },\n    })\n    fireEvent.change(screen.getByTestId('plan-import-level-bottom-0'), {\n      target: { value: '3' },\n    })\n    fireEvent.click(screen.getByTestId('plan-import-apply-elevation-0'))\n\n    // ?섑뵆 旅덁뻑??遺?ш? ?덉뼱 ??踰?嫄곕??쒕떎 ???숈쓽??洹??ㅼ뿉留??섏삩??    await waitFor(() =>\n      screen.getByTestId('plan-import-discard-members-0'),\n    )\n    fireEvent.click(screen.getByTestId('plan-import-discard-members-0'))\n    fireEvent.click(screen.getByTestId('plan-import-apply-elevation-0'))\n\n    await waitFor(() => {\n      const { stories } = useAppStore.getState().project\n      expect(stories.map((story) => story.height)).toEqual([4480, 4100])\n      expect(stories.map((story) => story.name)).toEqual([\n        '訝?ㄾ汝?FL竊뤷읃繹뺾L',\n        '2FL',\n      ])\n    })\n  })\n\n  it('?롩쳵 諛섏쁺 ?꾩뿉??旅덁뻑???롫? 嫄대뱶由ъ? ?딅뒗??, () => {\n    const before = useAppStore.getState().project.stories\n    open([elevationPage])\n\n    expect(useAppStore.getState().project.stories).toBe(before)\n  })\n\n  it('PDF ?쎄린???ㅽ뙣?섎㈃ 旅덁뻑??嫄대뱶由ъ? ?딄퀬 留먰븳??, async () => {\n    const before = useAppStore.getState().project\n    render(\n      <PlanImport\n        extractPages={vi.fn().mockRejectedValue(new Error('broken'))}\n      />,\n    )\n\n    fireEvent.change(screen.getByTestId('plan-import-file'), {\n      target: { files: [new File(['x'], 'a.pdf', { type: 'application/pdf' })] },\n    })\n\n    await waitFor(() => {\n      expect(screen.getByRole('alert')).toBeTruthy()\n    })\n    expect(useAppStore.getState().project).toBe(before)\n  })\n})\n\r\n===== src/components/section/SectionImport.tsx =====\r\n'use client'\r\n\r\nimport {\r\n  useMemo,\r\n  useRef,\r\n  useState,\r\n  type ChangeEvent,\r\n} from 'react'\r\n\r\nimport {\r\n  sectionMarkLabel,\r\n  type ColumnSection,\r\n  type GirderSection,\r\n  type SlabSection,\r\n  type Section,\r\n  type WallSection,\r\n} from '@/domain/model/member'\r\nimport type { Project } from '@/domain/model/project'\r\nimport { extractTextPages } from '@/lib/import/pdf-text'\r\nimport { parseSectionLists } from '@/lib/import/section-list/parse'\r\nimport type {\r\n  ListIssue,\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from '@/lib/import/section-list/types'\r\nimport { t } from '@/lib/i18n'\r\nimport { compact } from '@/lib/import/runs'\r\nimport { useAppStore, type Locale } from '@/lib/store'\r\n\r\nimport styles from './SectionImport.module.css'\r\n\r\ninterface SectionImportProps {\r\n  /** pdf.js ?놁씠 TextPage ?쎌뒪泥섎? 二쇱엯?섎뒗 而댄룷?뚰듃 ?뚯뒪?몄슜 寃쎄퀎. */\r\n  initialPages?: TextPage[]\r\n  extractPages?(file: File): Promise<TextPage[]>\r\n}\r\n\r\ninterface CandidateRow {\r\n  id: string\r\n  candidate: SectionCandidate\r\n}\r\n\r\nfunction parsedCandidates(lists: ParsedSectionList[]): CandidateRow[] {\r\n  return lists.flatMap((list, listIndex) =>\r\n    list.candidates.map((candidate, candidateIndex) => ({\r\n      id: `${listIndex}-${candidateIndex}`,\r\n      candidate,\r\n    })),\r\n  )\r\n}\r\n\r\n/**\r\n * ?롫퀎 ?꾨낫媛 媛숈? Section????뼱?곕㈃ 癒쇱? 諛섏쁺??痢듭쓽 諛곌렐???щ씪吏꾨떎 ??留ㅼ묶 ?ㅻ뒗\r\n * (寧?뤇, ?ⓩ쓲, ???? ?롫? 寧?뤇??遺숈씠吏???딅뒗?? ?꾨㈃???녿뒗 寧?뤇???낁㉢?몄뿉 洹몃?濡?\n * ?섍?怨? ?낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n */\r\ntype ImportableSection =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\ntype SlabDirection = 'x' | 'y'\r\ntype GirderDirection = 'first' | 'second'\r\n\r\n/**\r\n * ?똜2塋?띲겗?덀걝?よ뻗?띴퍡?띲꺀?쇻꺂?졼걨?믦눎?뺝?恙쒌겗野얕괌?ャ걲?뗣귛쨼塋?꺕?끿ク??\n * Grid??꺀?쇻꺂?ⓨ겤?뜸??담걮?╉굚?곮뻗?띲겏?쀣겍鰲ｉ뇠?쀣겍??겒?됥겒??(ADR-033) ??\n */\r\nfunction axisNameFromEndLabel(label: string): string | undefined {\r\n  const value = compact(label)\r\n  if (!value.endsWith('塋?)) return undefined\r\n  const axisName = value.slice(0, -1)\r\n  return axisName === '' || axisName === '鸚? || axisName === '??\r\n    ? undefined\r\n    : axisName\r\n}\r\n\r\n/**\r\n * ??씊?ゃ궧?덀겗塋?깿?⒲깧?ャ겏?뚣걯邕멥겗Grid?⒲깧?ャ걣訝→뼶誤뗣겇?뗣겂?잆겏?띲걽?묆?\n * 邕멥궎?녈깈?껁궚?밤겗鵝롢걚?담굮冶뗧ク?ャ걲?뗣귝캈雍껁겗訝↑씌??compact() ?믧싥걲 ??\n * framing-plan ?담굚?뚣걯閭ｈ쫸?뽧굮鵝욍걝?잆굙?곥걪?뚣겘?뉐춻?쀣겗若뚦뀲訝?담겎?귙겂??\n * ?꾨㈃ 諛⑺뼢??異붿젙?섎뒗 ?대━?ㅽ떛???꾨땲??(ADR-033) ??\n */\r\nfunction automaticGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): GirderDirection | undefined {\r\n  const asymmetric = candidate.girderMainAsymmetric\r\n  if (!asymmetric) return undefined\r\n\r\n  const axisNames = asymmetric.labels.map(axisNameFromEndLabel)\r\n  if (axisNames.some((axisName) => axisName === undefined)) return undefined\r\n\r\n  for (const labels of [project.grid.xLabels, project.grid.yLabels]) {\r\n    if (!labels) continue\r\n    const indexes = axisNames.map((axisName) =>\r\n      labels.findIndex((label) => compact(label) === axisName),\r\n    )\r\n    if (indexes.every((index) => index >= 0) && indexes[0] !== indexes[1]) {\r\n      return indexes[0] < indexes[1] ? 'first' : 'second'\r\n    }\r\n  }\r\n  return undefined\r\n}\r\n\r\nfunction resolvedGirderDirection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  selected?: GirderDirection,\r\n): GirderDirection | undefined {\r\n  return selected ?? automaticGirderDirection(project, candidate)\r\n}\r\n\r\nfunction isImportableSection(section: Section): section is ImportableSection {\r\n  return (\r\n    section.kind === '?? ||\r\n    section.kind === '鸚㎪쥈' ||\r\n    section.kind === '?먬쐡鶯? ||\r\n    section.kind === '佯딀씮'\r\n  )\r\n}\r\n\r\nfunction matchingSection(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  return project.sections\r\n    .filter(isImportableSection)\r\n    .find(\r\n      (section) =>\r\n        section.mark === candidate.mark &&\r\n        section.kind === candidate.kind &&\r\n        section.storyLabel === candidate.storyLabel,\r\n    )\r\n}\r\n\r\nfunction cloneSource(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n): ImportableSection | undefined {\r\n  if (candidate.kind === '野얕괌鸚?) return undefined\r\n  const sameKind = project.sections\r\n    .filter(isImportableSection)\r\n    .filter((section) => section.kind === candidate.kind)\r\n  // 媛숈? 寧?뤇???ㅻⅨ ?롪? ?대? ?덉쑝硫?洹몄そ??蹂듭젣?먯씠?????뚯떛?섏? ?딅뒗\r\n  // fc쨌媛뺤쥌쨌?몄텧쨌餓뺜툓?뮻룟닜?잆궕?뺛궩?껁깉? 臾닿???遺?щ낫??媛숈? 寧?뤇 履쎌씠 留욌떎\r\n  return (\r\n    sameKind.find((section) => section.mark === candidate.mark) ?? sameKind[0]\r\n  )\r\n}\r\n\r\n/**\r\n * ?좉퇋 寧?뤇??紐⑤뱺 諛곌렐쨌?⑤㈃ 移몄씠 ?뚯떛?먯쓣 ?뚮쭔 諛섏쁺???덉슜?쒕떎 ??鍮덉뭏??臾닿???\n * 遺?ъ쓽 蹂듭젣媛믪쑝濡?梨꾩썙 臾쇰웾???ｌ쑝硫??뚯꽌媛 吏???뚯??대궡吏 ?딅뒗?ㅳ?ADR-012)媛\r\n * UI?먯꽌 臾대꼫吏꾨떎. 湲곗〈 Section?먮뒗 鍮덉뭏??湲곗〈媛??좎????대떦?섏? ?딅뒗??\r\n */\r\nfunction missingParsedFields(\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  girderDirection?: GirderDirection,\r\n): boolean {\r\n  if (candidate.kind === '??) {\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.d === undefined ||\r\n      candidate.main === undefined ||\r\n      candidate.hoop === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '鸚㎪쥈') {\r\n    const mainAvailable =\r\n      candidate.girderMain !== undefined ||\r\n      (candidate.girderMainAsymmetric !== undefined &&\r\n        girderDirection !== undefined)\r\n    return (\r\n      candidate.b === undefined ||\r\n      candidate.depth === undefined ||\r\n      !mainAvailable ||\r\n      candidate.stirrup === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    return (\r\n      candidate.thickness === undefined ||\r\n      candidate.layers === undefined ||\r\n      candidate.vertical === undefined ||\r\n      candidate.horizontal === undefined\r\n    )\r\n  }\r\n  if (candidate.kind === '佯딀씮') {\r\n    return (\r\n      slabDirection === undefined ||\r\n      candidate.thickness === undefined ||\r\n      candidate.shortSide?.top === undefined ||\r\n      candidate.shortSide?.bottom === undefined ||\r\n      candidate.longSide?.top === undefined ||\r\n      candidate.longSide?.bottom === undefined\r\n    )\r\n  }\r\n  return true\r\n}\r\n\r\nfunction uniqueSectionId(project: Project, mark: string): string {\r\n  const base = `section-${mark}`\r\n  if (!project.sections.some(({ id }) => id === base)) return base\r\n\r\n  let suffix = 2\r\n  while (project.sections.some(({ id }) => id === `${base}-${suffix}`)) {\r\n    suffix += 1\r\n  }\r\n  return `${base}-${suffix}`\r\n}\r\n\r\nfunction applyParsedFields(\r\n  section: Section,\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  girderDirection?: GirderDirection,\r\n): Section {\r\n  if (section.kind === '?? && candidate.kind === '??) {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      // 壤®듁???力뺛겏訝永꾠겎?γ굥?귙?00??띲굮 b횞d ??옞?ヨ맼?ⓦ걲?①쎍孃꾠걣渦븅빓??\n      // ?ゃ겂??뫅?룔걣鸚됥굩?????뉑뼶?졼걨?띷삝?쀣겒??(ADR-027)\r\n      ...(candidate.shape === undefined ? {} : { shape: candidate.shape }),\r\n      ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n      ...(candidate.d === undefined ? {} : { d: candidate.d }),\r\n      ...(candidate.main === undefined\r\n        ? {}\r\n        : { main: { ...section.main, ...candidate.main } }),\r\n      ...(candidate.hoop === undefined\r\n        ? {}\r\n        : {\r\n            hoop: {\r\n              ...section.hoop,\r\n              size: candidate.hoop.size,\r\n              pitch: candidate.hoop.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '鸚㎪쥈' && candidate.kind === '鸚㎪쥈') {\r\n    const parsedMain = candidate.girderMainAsymmetric && girderDirection\r\n      ? (() => {\r\n          const startIndex = girderDirection === 'first' ? 0 : 1\r\n          const endIndex = 1 - startIndex\r\n          return {\r\n            ...section.main,\r\n            size: candidate.girderMainAsymmetric.size,\r\n            top: {\r\n              startCount: candidate.girderMainAsymmetric.topCounts[startIndex],\r\n              centerCount: candidate.girderMainAsymmetric.topCenterCount,\r\n              endCount: candidate.girderMainAsymmetric.topCounts[endIndex],\r\n            },\r\n            bottom: {\r\n              startCount:\r\n                candidate.girderMainAsymmetric.bottomCounts[startIndex],\r\n              centerCount: candidate.girderMainAsymmetric.bottomCenterCount,\r\n              endCount: candidate.girderMainAsymmetric.bottomCounts[endIndex],\r\n            },\r\n          }\r\n        })()\r\n      : candidate.girderMain === undefined\r\n        ? undefined\r\n        : {\r\n            ...section.main,\r\n            size: candidate.girderMain.size,\r\n            top: {\r\n              endCount:\r\n                candidate.girderMain.endTopCount ??\r\n                candidate.girderMain.topCount,\r\n              centerCount: candidate.girderMain.topCount,\r\n            },\r\n            bottom: {\r\n              endCount:\r\n                candidate.girderMain.endBottomCount ??\r\n                candidate.girderMain.bottomCount,\r\n              centerCount: candidate.girderMain.bottomCount,\r\n            },\r\n          }\r\n    const nextMain =\r\n      candidate.cutoffFromSupportFaceMm === undefined\r\n        ? parsedMain\r\n        : {\r\n            ...(parsedMain ?? section.main),\r\n            cutoffFromSupportFaceMm: candidate.cutoffFromSupportFaceMm,\r\n          }\r\n\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.b === undefined ? {} : { b: candidate.b }),\r\n      ...(candidate.depth === undefined ? {} : { depth: candidate.depth }),\r\n      ...(nextMain === undefined ? {} : { main: nextMain }),\r\n      ...(candidate.stirrup === undefined\r\n        ? {}\r\n        : {\r\n            stirrup: {\r\n              ...section.stirrup,\r\n              size: candidate.stirrup.size,\r\n              pitch: candidate.stirrup.pitchMm,\r\n            },\r\n          }),\r\n      ...(candidate.sideBar === undefined\r\n        ? {}\r\n        : {\r\n            sideBar: {\r\n              size: candidate.sideBar.size,\r\n              count: candidate.sideBar.count,\r\n              // ?밭춮??퐰?룔겘?녜씊?ャ굚與숁틬餓뺞쭣??塋졼겓?귙겒?뤵??싧뎴6) ?뚦쭟??굥\r\n              // JASS 5 ?귝쐣?쇻꺕?ょ▶岳앫겎?귙굥?? ??쫸繹뽩ㅳ겎??겒?뤸쑋?ε뒟?뜻뀑?㎯?\n              // ?℡춼?ㅳ걣?귙굦?겼닶?②끹겗?ε뒟?ⓦ걮?╊퓷??(R9???괪ectionTable ??\n              // extraLengthMm ?? 0 ?ⓨ릪?섉돮?꾠겎?귙굥??\n              extraLengthMm: section.sideBar?.extraLengthMm ?? 0,\r\n            },\r\n          }),\r\n      ...(candidate.widthTie === undefined\r\n        ? {}\r\n        : {\r\n            widthTie: {\r\n              size: candidate.widthTie.size,\r\n              pitch: candidate.widthTie.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '?먬쐡鶯? && candidate.kind === '?먬쐡鶯?) {\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.thickness === undefined\r\n        ? {}\r\n        : { thickness: candidate.thickness }),\r\n      ...(candidate.layers === undefined ? {} : { layers: candidate.layers }),\r\n      ...(candidate.vertical === undefined\r\n        ? {}\r\n        : {\r\n            vertical: {\r\n              ...section.vertical,\r\n              size: candidate.vertical.size,\r\n              pitch: candidate.vertical.pitchMm,\r\n            },\r\n          }),\r\n      ...(candidate.horizontal === undefined\r\n        ? {}\r\n        : {\r\n            horizontal: {\r\n              ...section.horizontal,\r\n              size: candidate.horizontal.size,\r\n              pitch: candidate.horizontal.pitchMm,\r\n            },\r\n          }),\r\n    }\r\n  }\r\n\r\n  if (section.kind === '佯딀씮' && candidate.kind === '佯딀씮') {\r\n    if (slabDirection === undefined) return section\r\n\r\n    const xSource =\r\n      slabDirection === 'x' ? candidate.shortSide : candidate.longSide\r\n    const ySource =\r\n      slabDirection === 'x' ? candidate.longSide : candidate.shortSide\r\n\r\n    return {\r\n      ...section,\r\n      mark: candidate.mark,\r\n      ...(candidate.thickness === undefined\r\n        ? {}\r\n        : { thickness: candidate.thickness }),\r\n      x: {\r\n        ...section.x,\r\n        ...(xSource?.top === undefined\r\n          ? {}\r\n          : {\r\n              top: {\r\n                ...section.x.top,\r\n                size: xSource.top.size,\r\n                pitch: xSource.top.pitchMm,\r\n              },\r\n            }),\r\n        ...(xSource?.bottom === undefined\r\n          ? {}\r\n          : {\r\n              bottom: {\r\n                ...section.x.bottom,\r\n                size: xSource.bottom.size,\r\n                pitch: xSource.bottom.pitchMm,\r\n              },\r\n            }),\r\n      },\r\n      y: {\r\n        ...section.y,\r\n        ...(ySource?.top === undefined\r\n          ? {}\r\n          : {\r\n              top: {\r\n                ...section.y.top,\r\n                size: ySource.top.size,\r\n                pitch: ySource.top.pitchMm,\r\n              },\r\n            }),\r\n        ...(ySource?.bottom === undefined\r\n          ? {}\r\n          : {\r\n              bottom: {\r\n                ...section.y.bottom,\r\n                size: ySource.bottom.size,\r\n                pitch: ySource.bottom.pitchMm,\r\n              },\r\n            }),\r\n      },\r\n    }\r\n  }\r\n\r\n  return section\r\n}\r\n\r\n/** 筽뉓＝?껋쓽 ???쒓린媛 ?꾨낫???몃젮?ㅼ? ?딄쾶 ?쒕떎 ???롮쓽 洹쇨굅???꾨낫 履쎈퓧?대떎. */\r\nfunction withCandidateStory(\r\n  section: Section,\r\n  candidate: SectionCandidate,\r\n): Section {\r\n  const next = { ...section }\r\n  if (candidate.storyLabel === undefined) delete next.storyLabel\r\n  else next.storyLabel = candidate.storyLabel\r\n  return next\r\n}\r\n\r\nfunction applyCandidate(\r\n  project: Project,\r\n  candidate: SectionCandidate,\r\n  slabDirection?: SlabDirection,\r\n  selectedGirderDirection?: GirderDirection,\r\n): Project {\r\n  if (candidate.kind === '野얕괌鸚?) return project\r\n  if (candidate.kind === '佯딀씮' && slabDirection === undefined) return project\r\n  const girderDirection = resolvedGirderDirection(\r\n    project,\r\n    candidate,\r\n    selectedGirderDirection,\r\n  )\r\n  if (\r\n    candidate.girderMainAsymmetric !== undefined &&\r\n    girderDirection === undefined\r\n  ) {\r\n    return project\r\n  }\r\n\r\n  const existing = matchingSection(project, candidate)\r\n  if (existing) {\r\n    return {\r\n      ...project,\r\n      sections: project.sections.map((section) =>\r\n        section.id === existing.id\r\n          ? applyParsedFields(\r\n              section,\r\n              candidate,\r\n              slabDirection,\r\n              girderDirection,\r\n            )\r\n          : section,\r\n      ),\r\n    }\r\n  }\r\n\r\n  const source = cloneSource(project, candidate)\r\n  if (\r\n    !source ||\r\n    missingParsedFields(candidate, slabDirection, girderDirection)\r\n  ) {\r\n    return project\r\n  }\r\n  // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎 ???롫? ?욎뼱 癒쇱? 醫곹엺??\n  const id = uniqueSectionId(\r\n    project,\r\n    candidate.storyLabel\r\n      ? `${candidate.mark}-${candidate.storyLabel}`\r\n      : candidate.mark,\r\n  )\r\n  const clonedSource: ImportableSection =\r\n    source.kind === '??\r\n      ? { ...source, id, main: { ...source.main }, hoop: { ...source.hoop } }\r\n      : source.kind === '鸚㎪쥈'\r\n        ? {\r\n            ...source,\r\n            id,\r\n            main: { ...source.main },\r\n            stirrup: { ...source.stirrup },\r\n          }\r\n        : source.kind === '?먬쐡鶯?\r\n          ? {\r\n              ...source,\r\n              id,\r\n              vertical: { ...source.vertical },\r\n              horizontal: { ...source.horizontal },\r\n            }\r\n          : {\r\n              ...source,\r\n              id,\r\n              x: {\r\n                top: { ...source.x.top },\r\n                bottom: { ...source.x.bottom },\r\n              },\r\n              y: {\r\n                top: { ...source.y.top },\r\n                bottom: { ...source.y.bottom },\r\n              },\r\n            }\r\n  const cloned = withCandidateStory(\r\n    applyParsedFields(\r\n      clonedSource,\r\n      candidate,\r\n      slabDirection,\r\n      girderDirection,\r\n    ),\r\n    candidate,\r\n  )\r\n\r\n  return { ...project, sections: [...project.sections, cloned] }\r\n}\r\n\r\nfunction sectionSummary(section: ImportableSection): string {\r\n  if (section.kind === '??) {\r\n    const dimension =\r\n      section.shape === '?녶숱' ? `${section.b}?` : `${section.b}횞${section.d}`\r\n    return `${sectionMarkLabel(section)} / ${dimension} / ${section.main.count}-${section.main.size} / ${section.hoop.size}@${section.hoop.pitch}`\r\n  }\r\n  if (section.kind === '鸚㎪쥈') {\r\n    const { top, bottom } = section.main\r\n    const topCounts =\r\n      top.startCount === undefined\r\n        ? `${top.endCount}竊?{top.centerCount}`\r\n        : `${top.startCount}竊?{top.centerCount}竊?{top.endCount}`\r\n    const bottomCounts =\r\n      bottom.startCount === undefined\r\n        ? `${bottom.endCount}竊?{bottom.centerCount}`\r\n        : `${bottom.startCount}竊?{bottom.centerCount}竊?{bottom.endCount}`\r\n    return `${sectionMarkLabel(section)} / ${section.b}횞${section.depth} / 訝?{topCounts}?삡툔${bottomCounts}-${section.main.size} / ${section.stirrup.size}@${section.stirrup.pitch}`\r\n  }\r\n  if (section.kind === '?먬쐡鶯?) {\r\n    return `${sectionMarkLabel(section)} / 鶯곩럻${section.thickness} / ${section.layers}掠?/ 潁?춮 ${section.vertical.size}@${section.vertical.pitch} / 與ょ춮 ${section.horizontal.size}@${section.horizontal.pitch}`\r\n  }\r\n  return `${sectionMarkLabel(section)} / ?욕럻${section.thickness} / X 訝?{section.x.top.size}@${section.x.top.pitch}?삡툔${section.x.bottom.size}@${section.x.bottom.pitch} / Y 訝?{section.y.top.size}@${section.y.top.pitch}?삡툔${section.y.bottom.size}@${section.y.bottom.pitch}`\r\n}\r\n\r\nfunction candidateFields(candidate: SectionCandidate, locale: Locale): string[] {\r\n  const fields: string[] = []\r\n  if (candidate.shape === '?녶숱' && candidate.b !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}?`)\r\n  } else if (candidate.b !== undefined && candidate.d !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}횞${candidate.d}`)\r\n  } else if (candidate.b !== undefined && candidate.depth !== undefined) {\r\n    fields.push(`??씊 ${candidate.b}횞${candidate.depth}`)\r\n  }\r\n  if (candidate.main) {\r\n    fields.push(`訝사춮 ${candidate.main.count}-${candidate.main.size}`)\r\n  }\r\n  if (candidate.hoop) {\r\n    fields.push(`躍?춮 ${candidate.hoop.size}@${candidate.hoop.pitchMm}`)\r\n  }\r\n  if (candidate.girderMain) {\r\n    const { topCount, bottomCount, size, endTopCount, endBottomCount } =\r\n      candidate.girderMain\r\n    fields.push(`訝사춮 訝?{topCount}?삡툔${bottomCount}-${size}`)\r\n    if (endTopCount !== undefined || endBottomCount !== undefined) {\r\n      fields.push(\r\n        `塋?깿 訝?{endTopCount ?? topCount}?삡툔${endBottomCount ?? bottomCount}`,\r\n      )\r\n    }\r\n  }\r\n  if (candidate.girderMainAsymmetric) {\r\n    const asymmetric = candidate.girderMainAsymmetric\r\n    fields.push(\r\n      `訝사춮 訝?{asymmetric.topCenterCount}?삡툔${asymmetric.bottomCenterCount}-${asymmetric.size}`,\r\n    )\r\n    fields.push(\r\n      `塋?깿 ${asymmetric.labels[0]} 訝?{asymmetric.topCounts[0]}?삡툔${asymmetric.bottomCounts[0]} / ${asymmetric.labels[1]} 訝?{asymmetric.topCounts[1]}?삡툔${asymmetric.bottomCounts[1]}`,\r\n    )\r\n  }\r\n  if (candidate.stirrup) {\r\n    fields.push(\r\n      `?귙겙?됬춮 ${candidate.stirrup.size}@${candidate.stirrup.pitchMm}`,\r\n    )\r\n  }\r\n  if (candidate.sideBar) {\r\n    fields.push(\r\n      `${t(locale, 'sectionImport.field.sideBar')} ${candidate.sideBar.count}-${candidate.sideBar.size}`,\r\n    )\r\n  }\r\n  if (candidate.widthTie) {\r\n    fields.push(\r\n      `${t(locale, 'sectionImport.field.widthTie')} ${candidate.widthTie.size}@${candidate.widthTie.pitchMm}`,\r\n    )\r\n  }\r\n  if (candidate.kind === '?먬쐡鶯?) {\r\n    if (candidate.thickness !== undefined) {\r\n      fields.push(`鶯곩럻 ${candidate.thickness}`)\r\n    }\r\n    if (candidate.layers !== undefined) fields.push(`?띸춮 ${candidate.layers}掠?)\r\n    if (candidate.vertical) {\r\n      fields.push(`潁?춮 ${candidate.vertical.size}@${candidate.vertical.pitchMm}`)\r\n    }\r\n    if (candidate.horizontal) {\r\n      fields.push(\r\n        `與ょ춮 ${candidate.horizontal.size}@${candidate.horizontal.pitchMm}`,\r\n      )\r\n    }\r\n  }\r\n  if (candidate.kind === '佯딀씮') {\r\n    if (candidate.thickness !== undefined) {\r\n      fields.push(`?욕럻 ${candidate.thickness}`)\r\n    }\r\n    for (const [label, side] of [\r\n      ['??씌', candidate.shortSide],\r\n      ['?룩씌', candidate.longSide],\r\n    ] as const) {\r\n      if (side?.top) fields.push(`${label}訝?${side.top.size}@${side.top.pitchMm}`)\r\n      if (side?.bottom) {\r\n        fields.push(`${label}訝?${side.bottom.size}@${side.bottom.pitchMm}`)\r\n      }\r\n    }\r\n  }\r\n  return fields\r\n}\r\n\r\nfunction cloneSourceSummary(source: ImportableSection): string {\r\n  const offset =\r\n    source.kind === '??\r\n      ? source.hoop.startOffsetMm\r\n      : source.kind === '鸚㎪쥈'\r\n        ? source.stirrup.startOffsetMm\r\n        : source.kind === '?먬쐡鶯?\r\n          ? source.vertical.startOffsetMm\r\n          : source.x.top.startOffsetMm\r\n  const exposure = source.kind === '佯딀씮' ? '' : `${source.exposure}/`\r\n  return `fc${source.fc}??{source.grade}??{exposure}${source.finish}?삣닜?잆궕?뺛궩?껁깉${offset}mm`\r\n}\r\n\r\nfunction Candidate({\r\n  row,\r\n  ignored,\r\n  slabDirection,\r\n  girderDirection,\r\n  onIgnore,\r\n  onSlabDirectionChange,\r\n  onGirderDirectionChange,\r\n  onApply,\r\n}: {\r\n  row: CandidateRow\r\n  ignored: boolean\r\n  slabDirection?: SlabDirection\r\n  girderDirection?: GirderDirection\r\n  onIgnore(): void\r\n  onSlabDirectionChange(direction: SlabDirection | undefined): void\r\n  onGirderDirectionChange(direction: GirderDirection | undefined): void\r\n  onApply(): void\r\n}) {\r\n  const { candidate } = row\r\n  const project = useAppStore(({ project }) => project)\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const existing = matchingSection(project, candidate)\r\n  const source = existing ? undefined : cloneSource(project, candidate)\r\n  const automaticDirection = automaticGirderDirection(project, candidate)\r\n  const resolvedDirection =\r\n    girderDirection ?? automaticDirection\r\n  const incomplete =\r\n    !existing &&\r\n    missingParsedFields(candidate, slabDirection, resolvedDirection)\r\n  const directionMissing =\r\n    (candidate.kind === '佯딀씮' && slabDirection === undefined) ||\r\n    (candidate.girderMainAsymmetric !== undefined &&\r\n      resolvedDirection === undefined)\r\n  const story = candidate.storyLabel ?? t(locale, 'sectionImport.noStory')\r\n  // ?뚯꽌???댁뒋 肄붾뱶留??ｋ뒗????臾몄옣? ?ш린??locale濡??쇰떎\r\n  const issueMessages = candidate.issues.map((issue) =>\r\n    t(locale, `sectionImport.issue.${issue}`),\r\n  )\r\n  const issueText = issueMessages.join('\\n')\r\n\r\n  return (\r\n    <li\r\n      className={styles.candidate}\r\n      data-testid={`section-import-candidate-${candidate.mark}-${candidate.storyLabel ?? 'none'}`}\r\n      hidden={ignored}\r\n    >\r\n      <div className={styles.candidateHeading}>\r\n        <strong>{candidate.mark}</strong>\r\n        <span>{story}</span>\r\n      </div>\r\n      <dl className={styles.diff}>\r\n        <div>\r\n          <dt>{t(locale, 'sectionImport.current')}</dt>\r\n          <dd>\r\n            {existing\r\n              ? sectionSummary(existing)\r\n              : t(locale, 'sectionImport.new')}\r\n          </dd>\r\n        </div>\r\n        <div>\r\n          <dt>{t(locale, 'sectionImport.parsed')}</dt>\r\n          <dd>{candidateFields(candidate, locale).join(' / ') || '??}</dd>\r\n        </div>\r\n      </dl>\r\n      {Object.keys(candidate.raw).length > 0 ? (\r\n        <div className={styles.raw} title={issueText || undefined}>\r\n          {Object.entries(candidate.raw).map(([label, value]) => (\r\n            <span key={label}>\r\n              {label}: {value}\r\n            </span>\r\n          ))}\r\n        </div>\r\n      ) : null}\r\n      {issueMessages.length > 0 ? (\r\n        <ul className={styles.issues}>\r\n          {issueMessages.map((issue) => (\r\n            <li key={issue}>{issue}</li>\r\n          ))}\r\n        </ul>\r\n      ) : null}\r\n      {!existing && source && incomplete ? (\r\n        <p className={styles.cloneNotice}>\r\n          {t(locale, 'sectionImport.incomplete')}\r\n        </p>\r\n      ) : null}\r\n      {!existing && source && !incomplete ? (\r\n        <>\r\n          <p className={styles.cloneNotice}>\r\n            {t(locale, 'sectionImport.clonePrefix')}\r\n            {sectionMarkLabel(source)}\r\n            {`竊?{cloneSourceSummary(source)}竊?}\r\n            {t(locale, 'sectionImport.cloneSuffix')}\r\n          </p>\r\n          <p className={styles.cloneNotice}>\r\n            {t(locale, 'sectionImport.newSectionUnassigned')}\r\n          </p>\r\n        </>\r\n      ) : null}\r\n      {candidate.kind === '佯딀씮' ? (\r\n        <div className={styles.directionChoice}>\r\n          <label htmlFor={`section-import-slab-direction-${row.id}`}>\r\n            {t(locale, 'sectionImport.slabDirection')}\r\n          </label>\r\n          <select\r\n            id={`section-import-slab-direction-${row.id}`}\r\n            data-testid={`section-import-slab-direction-${candidate.mark}`}\r\n            value={slabDirection ?? ''}\r\n            onChange={(event) => {\r\n              const value = event.currentTarget.value\r\n              onSlabDirectionChange(value === 'x' || value === 'y' ? value : undefined)\r\n            }}\r\n          >\r\n            <option value=\"\">\r\n              {t(locale, 'sectionImport.slabDirectionPlaceholder')}\r\n            </option>\r\n            <option value=\"x\">\r\n              {t(locale, 'sectionImport.slabDirection.shortToX')}\r\n            </option>\r\n            <option value=\"y\">\r\n              {t(locale, 'sectionImport.slabDirection.shortToY')}\r\n            </option>\r\n          </select>\r\n        </div>\r\n      ) : null}\r\n      {candidate.kind === '鸚㎪쥈' && candidate.girderMainAsymmetric ? (\r\n        <div className={styles.directionChoice}>\r\n          <label htmlFor={`section-import-girder-direction-${row.id}`}>\r\n            {t(locale, 'sectionImport.girderDirection')}\r\n          </label>\r\n          <select\r\n            id={`section-import-girder-direction-${row.id}`}\r\n            data-testid={`section-import-girder-direction-${candidate.mark}`}\r\n            value={resolvedDirection ?? ''}\r\n            onChange={(event) => {\r\n              const value = event.currentTarget.value\r\n              onGirderDirectionChange(\r\n                value === 'first' || value === 'second' ? value : undefined,\r\n              )\r\n            }}\r\n          >\r\n            <option value=\"\">\r\n              {t(locale, 'sectionImport.girderDirectionPlaceholder')}\r\n            </option>\r\n            <option value=\"first\">\r\n              {candidate.girderMainAsymmetric.labels[0]}=冶뗧ク\r\n            </option>\r\n            <option value=\"second\">\r\n              {candidate.girderMainAsymmetric.labels[1]}=冶뗧ク\r\n            </option>\r\n          </select>\r\n          <span>\r\n            {automaticDirection !== undefined\r\n              ? `${t(locale, 'sectionImport.girderDirection.auto')}竊?{candidate.girderMainAsymmetric.labels[resolvedDirection === 'first' ? 0 : 1]}=冶뗧ク竊?\r\n              : t(locale, 'sectionImport.girderDirection.manual')}\r\n          </span>\r\n        </div>\r\n      ) : null}\r\n      <div className={styles.rowActions}>\r\n        <button\r\n          type=\"button\"\r\n          className={styles.applyButton}\r\n          disabled={\r\n            directionMissing || (!existing && (!source || incomplete))\r\n          }\r\n          onClick={onApply}\r\n        >\r\n          {t(locale, 'sectionImport.apply')}\r\n        </button>\r\n        <button type=\"button\" className={styles.ignoreButton} onClick={onIgnore}>\r\n          {t(locale, 'sectionImport.ignore')}\r\n        </button>\r\n      </div>\r\n    </li>\r\n  )\r\n}\r\n\r\nexport function SectionImport({\r\n  initialPages,\r\n  extractPages = extractTextPages,\r\n}: SectionImportProps) {\r\n  const locale = useAppStore(({ locale }) => locale)\r\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n  const inputRef = useRef<HTMLInputElement>(null)\r\n  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\r\n  const [open, setOpen] = useState(initialPages !== undefined)\r\n  const [loading, setLoading] = useState(false)\r\n  const [failed, setFailed] = useState(false)\r\n  const [ignored, setIgnored] = useState<Set<string>>(() => new Set())\r\n  const [slabDirections, setSlabDirections] = useState<\r\n    Record<string, SlabDirection>\r\n  >({})\r\n  const [girderDirections, setGirderDirections] = useState<\r\n    Record<string, GirderDirection>\r\n  >({})\r\n  // ?곗냽 ?좏깮 ????쾶 ?앸궃 ?댁쟾 ?뚯씪??寃곌낵媛 理쒖떊 寃곌낵瑜???? ?딄쾶 ?쒕떎\r\n  const requestRef = useRef(0)\r\n  const lists = useMemo(\r\n    () => (pages ?? []).flatMap((page) => parseSectionLists(page)),\r\n    [pages],\r\n  )\r\n  const rows = useMemo(() => parsedCandidates(lists), [lists])\r\n  // ?ъ쑀蹂꾨줈 ?대뒓 由ъ뒪?멸? 嫄몃졇?붿? 臾띕뒗?????꾨낫媛 ?섎굹?쇰룄 ?덉쑝硫??ㅽ뙣???쒓?\r\n  // ?붾㈃?먯꽌 ?щ씪吏??臾몄젣瑜?留됱쑝?ㅻ㈃ ???덈궡媛 ?꾨낫 紐⑸줉怨??④퍡 ??蹂댁뿬???쒕떎\r\n  const listIssues = useMemo(() => {\r\n    const grouped = new Map<ListIssue, string[]>()\r\n    for (const { issue, listKind } of lists) {\r\n      if (issue === undefined) continue\r\n      const kinds = grouped.get(issue) ?? []\r\n      if (!kinds.includes(listKind)) kinds.push(listKind)\r\n      grouped.set(issue, kinds)\r\n    }\r\n    return [...grouped]\r\n  }, [lists])\r\n  const supported = rows.filter(({ candidate }) => candidate.kind !== '野얕괌鸚?)\r\n  const outOfScope = rows.filter(({ candidate }) => candidate.kind === '野얕괌鸚?)\r\n\r\n  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n    const input = event.currentTarget\r\n    const file = input.files?.[0]\r\n    if (!file) return\r\n\r\n    const requestId = ++requestRef.current\r\n    setOpen(true)\r\n    setLoading(true)\r\n    setFailed(false)\r\n    setIgnored(new Set())\r\n    setSlabDirections({})\r\n    setGirderDirections({})\r\n    try {\r\n      const next = await extractPages(file)\r\n      if (requestRef.current !== requestId) return\r\n      setPages(next)\r\n    } catch {\r\n      if (requestRef.current !== requestId) return\r\n      setPages(null)\r\n      setFailed(true)\r\n    } finally {\r\n      if (requestRef.current === requestId) setLoading(false)\r\n      input.value = ''\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.control}>\r\n      <button\r\n        type=\"button\"\r\n        className={styles.openButton}\r\n        onClick={() => {\r\n          if (pages) setOpen(true)\r\n          else inputRef.current?.click()\r\n        }}\r\n      >\r\n        {t(locale, 'sectionImport.open')}\r\n      </button>\r\n      <input\r\n        ref={inputRef}\r\n        className={styles.fileInput}\r\n        data-testid=\"section-import-file\"\r\n        type=\"file\"\r\n        accept=\"application/pdf\"\r\n        aria-label={t(locale, 'sectionImport.file')}\r\n        onChange={(event) => void selectFile(event)}\r\n      />\r\n      {open ? (\r\n        <section\r\n          className={styles.panel}\r\n          role=\"dialog\"\r\n          aria-modal=\"false\"\r\n          aria-labelledby=\"section-import-title\"\r\n        >\r\n          <header className={styles.panelHeader}>\r\n            <h3 id=\"section-import-title\">\r\n              {t(locale, 'sectionImport.title')}\r\n            </h3>\r\n            <div className={styles.panelActions}>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.chooseButton}\r\n                onClick={() => inputRef.current?.click()}\r\n              >\r\n                {t(locale, 'sectionImport.chooseAnother')}\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.closeButton}\r\n                onClick={() => setOpen(false)}\r\n              >\r\n                {t(locale, 'sectionImport.close')}\r\n              </button>\r\n            </div>\r\n          </header>\r\n          <div className={styles.panelBody}>\r\n            {loading ? (\r\n              <p role=\"status\">{t(locale, 'sectionImport.loading')}</p>\r\n            ) : failed ? (\r\n              <p role=\"alert\">{t(locale, 'sectionImport.error')}</p>\r\n            ) : pages && rows.length === 0 && listIssues.length === 0 ? (\r\n              <p>{t(locale, 'sectionImport.empty')}</p>\r\n            ) : (\r\n              <>\r\n                {listIssues.map(([issue, kinds]) => (\r\n                  <p key={issue} className={styles.listIssue}>\r\n                    {`${t(locale, `sectionImport.listIssue.${issue}`)}竊?{kinds.join('??)}竊?}\r\n                  </p>\r\n                ))}\r\n                <ul className={styles.candidateList}>\r\n                  {supported.map((row) => (\r\n                    <Candidate\r\n                      key={row.id}\r\n                      row={row}\r\n                      ignored={ignored.has(row.id)}\r\n                      slabDirection={slabDirections[row.id]}\r\n                      girderDirection={girderDirections[row.id]}\r\n                      onIgnore={() =>\r\n                        setIgnored((current) => new Set(current).add(row.id))\r\n                      }\r\n                      onSlabDirectionChange={(direction) =>\r\n                        setSlabDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onGirderDirectionChange={(direction) =>\r\n                        setGirderDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onApply={() =>\r\n                        updateProject((project) =>\r\n                          applyCandidate(\r\n                            project,\r\n                            row.candidate,\r\n                            slabDirections[row.id],\r\n                            girderDirections[row.id],\r\n                          ),\r\n                        )\r\n                      }\r\n                    />\r\n                  ))}\r\n                </ul>\r\n                {outOfScope.length > 0 ? (\r\n                  <details\r\n                    className={styles.outOfScope}\r\n                    data-testid=\"section-import-out-of-scope\"\r\n                  >\r\n                    <summary>\r\n                      {t(locale, 'sectionImport.outOfScope')} ({outOfScope.length})\r\n                    </summary>\r\n                    <ul className={styles.candidateList}>\r\n                      {outOfScope.map((row) => (\r\n                        <li\r\n                          key={row.id}\r\n                          className={styles.candidate}\r\n                          data-testid={`section-import-candidate-${row.candidate.mark}-${row.candidate.storyLabel ?? 'none'}`}\r\n                        >\r\n                          <div className={styles.candidateHeading}>\r\n                            <strong>{row.candidate.mark}</strong>\r\n                            <span>\r\n                              {row.candidate.storyLabel ??\r\n                                t(locale, 'sectionImport.noStory')}\r\n                            </span>\r\n                          </div>\r\n                          <p>\r\n                            {candidateFields(row.candidate, locale).join(' / ') ||\r\n                              '??}\r\n                          </p>\r\n                        </li>\r\n                      ))}\r\n                    </ul>\r\n                  </details>\r\n                ) : null}\r\n              </>\r\n            )}\r\n          </div>\r\n        </section>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n\r\n===== tests/e2e/uc22-plan-import.js =====\r\n// UC-22: 鴉뤷쎋쨌邕며탡??PDF?먯꽌 ?뺤긽(?싥굤??룸???諛곗튂쨌?롩쳵)???쎄퀬, ?뱀씤?댁빞留?\n// 旅덁뻑???ㅼ뼱媛꾨떎 (ADR-030). ??씊?ゃ궧??痍⑥엯(uc12)怨?媛숈? 洹쒖빟?대릺 媛?쒓? ?섎굹 ??\n// ?덈떎 ???쇔춴 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덉뼱?? ?싥굤??쓣 諛붽씀硫??먮?吏 ?딆? 痢듭쓽\r\n// 遺?ш? 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. 洹몃옒???ㅻⅨ 痢듭뿉 遺?ш? ?덉쑝硫??듭㎏濡?\n// 嫄곕??섍퀬, 嫄곕?瑜???踰?蹂댁뿬以 ?ㅼ뿉留??뚮떎瑜?痢듭쓣 踰꾨┛?ㅳ띾뒗 ?숈쓽 移몄쓣 ?몃떎.\r\n// ???ㅼ륫 p7????釉붾줉? Y ?ㅽ뙩쨌?쇰꺼???숈씪?섎?濡?釉붾줉蹂?Y 洹몃━??洹?띿?\r\n// ?ш린??寃利앸릺吏 ?딅뒗?? 洹멸쾬? ?⑥쐞 ?뚯뒪???뚰븳 ?섏씠吏???ㅽ뙩???ㅻⅨ 鴉뤷쎋\r\n// ???μ? 媛?釉붾줉??X쨌Y ?싥굤??쑝濡?痍⑥엯?쒕떎?띻? ??뒗??\r\nconst pdfPath = \".cache/dwg-yokohama.pdf\";\r\nconst sandboxFixture = \"uc22-dwg-yokohama.pdf.b64\";\r\nlet pdfBase64;\r\ntry {\r\n  // dev-browser??QuickJS?먯꽌 ?몄뒪??寃쎈줈瑜?吏곸젒 ?????녿떎. AC ?ㅽ뻾 ?꾩뿉 濡쒖뺄\r\n  // .cache PDF瑜?寃⑸━ temp??base64濡?誘몃윭留곹븯硫? ?놁쑝硫?泥ル㉧由ъ뿉??紐낆떆?곸쑝濡??ㅽ뙣?쒕떎.\r\n  pdfBase64 = await readFile(sandboxFixture);\r\n} catch (error) {\r\n  throw new Error(\r\n    `LOCAL FIXTURE MISSING: ${pdfPath} ??癒쇱? ?ㅽ뻾: ` +\r\n      `base64 -w0 ${pdfPath} > ~/.dev-browser/tmp/${sandboxFixture} ` +\r\n      `(?ы쁽 ?덉감: tests/fixtures/section-import/SOURCES.md) (${String(error)})`,\r\n  );\r\n}\r\n\r\nconst page = await browser.getPage(\"kijun\");\r\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"domcontentloaded\" });\r\n// ?ゅ땿岳앭춼 (M4) ?뚦뎺??춮?멥걤??랬?녴굮孃⒴뀇?쇻굥?귙겑??춮?멥걤?귙궢?녈깤?ユ죭餓뜰걢??\n// 冶뗣굙?잆걚??겎?곫??앫겗??겹겎鼇섌뙯?믤텋?쀣겍?뗣굢沃?겳?담걲??\nawait page.evaluate(\r\n  () =>\r\n    new Promise((resolve) => {\r\n      const request = indexedDB.deleteDatabase(\"kijun\");\r\n      request.onsuccess = resolve;\r\n      request.onerror = resolve;\r\n      request.onblocked = resolve;\r\n    }),\r\n);\r\nawait page.reload({ waitUntil: \"domcontentloaded\" });\r\nawait page.waitForSelector(\"[data-testid='grand-total']\");\r\nawait page.waitForSelector(\"canvas\");\r\n\r\n// 旅덁뻑???싥굤??? DOM?먯꽌 ?쎈뒗?????뚯뒪?몃쭔???꾪븳 ?꾩뿭 ?낆쓣 ?쒗뭹???ъ?\r\n// ?딅뒗??(?ㅻⅨ UC? 媛숈? 洹쒖빟). ?대쫫???꾨땲??data-testid濡?吏묐뒗 ?댁쑀媛 ?덈떎:\r\n// ?꾨㈃?먯꽌 ?싥굤???대쫫???쎌뼱?ㅻ㈃ aria-label???똟X1-bX2?띾줈 諛붾먮떎.\r\nconst readSpans = () =>\r\n  page.evaluate(() => {\r\n    const spans = (axis) =>\r\n      [...document.querySelectorAll(`input[data-testid^='span-${axis}-']`)]\r\n        .map((input) => input.value)\r\n        .join(\",\");\r\n    return { x: spans(\"x\"), y: spans(\"y\") };\r\n  });\r\n\r\nconst beforeGrid = await readSpans();\r\n\r\nawait page.setInputFiles(\"[data-testid='plan-import-file']\", {\r\n  name: \"dwg-yokohama.pdf\",\r\n  mimeType: \"application/pdf\",\r\n  buffer: Buffer.from(pdfBase64, \"base64\"),\r\n});\r\nawait page.waitForSelector(\"[data-testid='plan-import-grid-X-0']\", {\r\n  timeout: 120000,\r\n});\r\n\r\nconst read = await page.evaluate(() => {\r\n  const text = (testId) =>\r\n    document.querySelector(`[data-testid='${testId}']`)?.textContent ?? \"\";\r\n  return {\r\n    // ?싥굤?? ?쇰꺼怨??ㅽ뙩???꾨㈃ 洹몃?濡?\n    gridX: text(\"plan-import-grid-X-0\"),\r\n    gridY: text(\"plan-import-grid-Y-0\"),\r\n    // 邕며탡?? ?롩쳵? ?덈꺼 ?쇰꺼 (媛숈? ?믪씠???섏? ?????⑤뒗??\r\n    elevation: text(\"plan-import-elevation-0\"),\r\n    // 鴉뤷쎋 ???λ쭏??釉붾줉 ????PDF??5?μ씠????룟읃鹽렺??롥틞쨌2?롥틞쨌R?롥틞)\r\n    blockTitles: [...document.querySelectorAll(\"strong\")]\r\n      .map((node) => node.textContent.trim())\r\n      .filter((label) => label.includes(\"鴉뤷쎋\")),\r\n  };\r\n});\r\n\r\n// 諛섏쁺? ???롥틞鴉뤷쎋??釉붾줉?쇰줈 ?쒕떎 ??index媛 ?꾨땲???쒕ぉ?쇰줈 怨좊Ⅸ??\r\n// 0踰덉? ??폀?녹씠怨?洹?寧?뤇(P51 ??? ?쒗뭹??遺?ш? ?꾨땲???꾨Т寃껊룄 ???ㅼ뼱媛꾨떎.\r\nconst targetApply = await page.evaluate(() => {\r\n  const blocks = [...document.querySelectorAll(\"[data-testid^='plan-import-apply-']\")];\r\n  const index = blocks.findIndex((button) =>\r\n    button.closest(\"div\")?.textContent.includes(\"2?롥틞鴉뤷쎋\"),\r\n  );\r\n  return index < 0 ? null : blocks[index].getAttribute(\"data-testid\");\r\n});\r\nif (!targetApply) throw new Error(\"2?롥틞鴉뤷쎋 釉붾줉??李얠? 紐삵뻽??);\r\n\r\n// 1) ?뱀씤 ?꾩뿉??旅덁뻑??諛붾뚯? ?딅뒗??\nconst untouched = await readSpans();\r\n\r\n// 2) 泥?諛섏쁺? 嫄곕??쒕떎 ???섑뵆 旅덁뻑???ㅻⅨ 痢?遺?ш? ?덈떎\r\nawait page.click(`[data-testid='${targetApply}']`);\r\nawait page.waitForSelector(\"[data-testid='plan-import-result']\");\r\nconst refusedPanel = await page.evaluate(() => ({\r\n  message:\r\n    document.querySelector(\"[data-testid='plan-import-result']\")?.textContent ??\r\n    \"\",\r\n  consentOffered:\r\n    document.querySelector(\"[data-testid='plan-import-discard']\") !== null,\r\n}));\r\nconst refused = { ...refusedPanel, spans: await readSpans() };\r\n\r\n// 3) ?숈쓽?섎㈃ ?ㅼ뼱媛꾨떎\r\nawait page.click(\"[data-testid='plan-import-discard']\");\r\nawait page.click(`[data-testid='${targetApply}']`);\r\nawait page.waitForTimeout(500);\r\nconst appliedPanel = await page.evaluate(() => ({\r\n  // ??씊訝誤㏃뿉 ?녿뒗 寧?뤇? 吏?대궡吏 ?딄퀬 ?ъ쑀瑜?留먰븳??\n  result:\r\n    document.querySelector(\"[data-testid='plan-import-result']\")?.textContent ??\r\n    \"\",\r\n  grandTotal:\r\n    document.querySelector(\"[data-testid='grand-total']\")?.textContent ?? null,\r\n  paneFailures: [...document.querySelectorAll(\"[role='alert']\")].map(\r\n    (node) => node.textContent,\r\n  ),\r\n}));\r\nconst applied = { ...appliedPanel, spans: await readSpans() };\r\n// ?싥굤??쓽 ?대쫫??旅덁뻑???ㅼ뼱媛붾뒗媛 ??R13???좉껐 議곌굔?대떎\r\nconst spanNames = await page.evaluate(() =>\r\n  [...document.querySelectorAll(\"input[data-testid^='span-x-']\")].map((input) =>\r\n    input.getAttribute(\"aria-label\"),\r\n  ),\r\n);\r\n\r\n// 4) ?롩쳵瑜?旅덁뻑???롫줈 ?ｋ뒗?????대뒓 ?덈꺼???롮씤吏???щ엺??怨좊Ⅸ??\r\n// 訝?ㄾ汝?FL(index 3)?먯꽌 訝?ㄾ汝웂CL(index 1)源뚯? ??1??4480쨌2??4100.\r\n// ?묆꺀?싥긿??1400)? ?븀쨴(2690)???롪? ?꾨땲誘濡?踰붿쐞 諛뽰씠??\nawait page.selectOption(\"[data-testid='plan-import-level-top-0']\", \"1\");\r\nawait page.selectOption(\"[data-testid='plan-import-level-bottom-0']\", \"3\");\r\nawait page.click(\"[data-testid='plan-import-apply-elevation-0']\");\r\nawait page.waitForSelector(\"[data-testid='plan-import-elevation-result-0']\");\r\nconst storyRefused = await page.evaluate(() => ({\r\n  message:\r\n    document.querySelector(\"[data-testid='plan-import-elevation-result-0']\")\r\n      ?.textContent ?? \"\",\r\n  consentOffered:\r\n    document.querySelector(\"[data-testid='plan-import-discard-members-0']\") !==\r\n    null,\r\n}));\r\nif (storyRefused.consentOffered) {\r\n  await page.click(\"[data-testid='plan-import-discard-members-0']\");\r\n  await page.click(\"[data-testid='plan-import-apply-elevation-0']\");\r\n  await page.waitForTimeout(500);\r\n}\r\n// ???대쫫? 掠???role=tab)?먯꽌 ?쎈뒗?????ㅽ뙩怨?媛숈씠 DOM???좎씪??李쎄뎄??\r\n// 酉곗뼱 ???ⓩ쓲쨌兩븀돥)??role=tab?대씪 紐⑸줉?먮뒗 洹멸쾬?ㅻ룄 ?욎씤????媛쒖닔媛 ?꾨땲??\n// ?뚮룄硫댁뿉?????대쫫??嫄곌린 ?덈뒗媛?띾? 蹂몃떎\r\nconst stories = await page.evaluate(() =>\r\n  [...document.querySelectorAll(\"[role='tab']\")].map((node) =>\r\n    node.textContent.trim(),\r\n  ),\r\n);\r\n\r\n// 5) ???먮쫫: 媛숈? PDF????씊?ゃ궧?덈? 癒쇱? ?뱀씤?쒕떎. ?댄썑 鴉뤷쎋 痍⑥엯?먯꽌\r\n// ??씊 ?롫? 怨좊Ⅴ吏 ?딆쑝硫?媛숈? 寧?뤇???꾨낫瑜?吏?대궡吏 ?딄퀬 硫덉떠???쒕떎.\r\nawait page.evaluate(\r\n  () =>\r\n    new Promise((resolve) => {\r\n      const request = indexedDB.deleteDatabase(\"kijun\");\r\n      request.onsuccess = resolve;\r\n      request.onerror = resolve;\r\n      