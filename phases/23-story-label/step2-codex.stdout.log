 사이를 재지 않고도 옳은 짝을 고른다.\r\n 476:  *\r\n 477:  * 같은 블록의 위·아래 라벨 띠는 축 위치가 같으므로 그 자리에서 하나로 접힌다.\r\n 478:  */\r\n 479: function buildBlocks(\r\n 480:   xSequences: ValidatedSequence[],\r\n 481:   ySequences: ValidatedSequence[],\r\n 482:   marks: PositionedToken[],\r\n 483:   titles: PositionedToken[],\r\n 484:   issue: (code: PlanGridIssue) => void,\r\n 485: ): PlanBlock[] {\r\n 486:   const blocks: PlanBlock[] = []\r\n 487:   if (xSequences.length === 0 || ySequences.length === 0) return blocks\r\n 488: \r\n 489:   const seen = new Set<string>()\r\n 490:   const claimedY = new Map<ValidatedSequence, string>()\r\n 491: \r\n 492:   for (const xSequence of xSequences) {\r\n 493:     const xExtent = extent(xSequence.axes)\r\n 494:     const xKey = xSequence.axes\r\n 495:       .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\r\n 496:       .join(',')\r\n 497:     const pairingLimit =\r\n 498:       median(spanLengths(xSequence.axes)) * GRID_PAIRING_DISTANCE_RATIO\r\n 499:     let paired: ValidatedSequence | undefined\r\n 500:     let pairedDistance = Number.POSITIVE_INFINITY\r\n 501:     let tied = false\r\n 502:     for (const ySequence of ySequences) {\r\n 503:       const claimedBy = claimedY.get(ySequence)\r\n 504:       if (claimedBy !== undefined && claimedBy !== xKey) continue\r\n 505:       const distance = distanceToRange(\r\n 506:         ySequence.across,\r\n 507:         xExtent.min,\r\n 508:         xExtent.max,\r\n 509:       )\r\n 510:       if (distance < pairedDistance) {\r\n 511:         paired = ySequence\r\n 584:       a.xGrid.axes[0].positionPt - b.xGrid.axes[0].positionPt ||\r\n 585:       a.yGrid.axes[0].positionPt - b.yGrid.axes[0].positionPt,\r\n 586:   )\r\n 587: }\r\n 588: \r\n 589: export function parseFramingPlan(page: TextPage): ParsedFramingPlan {\r\n 590:   const { labels, dimensions, marks, titles } = collectTokens(page)\r\n 591: \r\n 592:   const issues: PlanGridIssue[] = []\r\n 593:   const issue = (code: PlanGridIssue) => {\r\n 594:     if (!issues.includes(code)) issues.push(code)\r\n 595:   }\r\n 596: \r\n 597:   if (labels.length === 0) {\r\n 598:     return { grids: [], blocks: [], issues: ['通り芯ラベル未検出'] }\r\n 599:   }\r\n 600: \r\n 601:   // 라벨 문자열이 가로로 놓여도 밴드(축의 늘어선 방향)는 세로일 수 있다 —\r\n 602:   // 두 방향 다 묶어 보고, 검증(중점 치수·축척)이 가짜 밴드를 걸러낸다.\r\n 603:   const validated = [\r\n 604:     ...axisSequences(labels, 'x'),\r\n 605:     ...axisSequences(labels, 'y'),\r\n 606:   ].flatMap((sequence) => {\r\n 607:     const result = validateSequence(sequence, dimensions, issue)\r\n 608:     return result ? [result] : []\r\n 609:   })\r\n 610: \r\n 611:   const grids: PlanGridCandidate[] = []\r\n 612:   const seen = new Set<string>()\r\n 613:   for (const sequence of validated) {\r\n 614:     const candidate = gridCandidate(sequence)\r\n 615:     const key = [\r\n 616:       candidate.direction,\r\n 617:       candidate.axes.map((axis) => axis.label).join(','),\r\n 618:       candidate.spansMm.join(','),\r\n 619:     ].join('|')\r\n 620:     if (seen.has(key)) continue\r\n","exit_code":0,"status":"completed"}}
