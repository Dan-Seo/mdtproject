{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$p='\"'tests/e2e/uc22-plan-import.js'; \"'$lines=Get-Content -LiteralPath $p -Encoding utf8; for($i=1;$i -le $lines.Length;$i++){ '\"'{0,4}: {1}' -f \"'$i,$lines[$i-1] }'","aggregated_output":"   1: // UC-22: 伏図·軸組図 PDF에서 형상(通り芯·부재 배치·階高)을 읽고, 승인해야만\r\n\r\n 145:   await page.click(\"[data-testid='plan-import-discard-members-0']\");\r\n 146:   await page.click(\"[data-testid='plan-import-apply-elevation-0']\");\r\n 147:   await page.waitForTimeout(500);\r\n 148: }\r\n 149: // 階 이름은 層 탭(role=tab)에서 읽는다 — 스팬과 같이 DOM이 유일한 창구다.\r\n 150: // 뷰어 탭(部材·建物)도 role=tab이라 목록에는 그것들도 섞인다 — 개수가 아니라\r\n 151: // 「도면에서 온 이름이 거기 있는가」를 본다\r\n 152: const stories = await page.evaluate(() =>\r\n 153:   [...document.querySelectorAll(\"[role='tab']\")].map((node) =>\r\n 154:     node.textContent.trim(),\r\n 155:   ),\r\n 156: );\r\n 157: \r\n 158: // 5) 새 흐름: 같은 PDF의 断面リスト를 먼저 승인한다. 이후 伏図 취입에서\r\n 159: // 断面 階를 고르지 않으면 같은 符号의 후보를 지어내지 않고 멈춰야 한다.\r\n 160: await page.evaluate(\r\n 161:   () =>\r\n 162:     new Promise((resolve) => {\r\n 163:       const request = indexedDB.deleteDatabase(\"kijun\");\r\n 164:       request.onsuccess = resolve;\r\n 165:       request.onerror = resolve;\r\n 166:       request.onblocked = resolve;\r\n 167:     }),\r\n 168: );\r\n 169: await page.reload({ waitUntil: \"domcontentloaded\" });\r\n 170: await page.waitForSelector(\"[data-testid='grand-total']\");\r\n 171: const sectionStoryAbsentAtSample = await page.evaluate(\r\n 172:   () => document.querySelector(\"[data-testid='plan-import-section-story']\") === null,\r\n 173: );\r\n 174: await page.setInputFiles(\"[data-testid='section-import-file']\", {\r\n 175:   name: \"dwg-yokohama.pdf\",\r\n 176:   mimeType: \"application/pdf\",\r\n 177:   buffer: Buffer.from(pdfBase64, \"base64\"),\r\n 178: });\r\n 179: await page.waitForSelector(\"[data-testid='section-import-candidate-C51-2階']\", {\r\n 180:   timeout: 120000,\r\n 181: });\r\n 182: await page.locator(\r\n 183:   \"[data-testid='section-import-candidate-C51-2階'] button:nth-of-type(1)\",\r\n 184: ).click();\r\n 185: await page.locator(\r\n 186:   \"[data-testid='section-import-candidate-C51-1階'] button:nth-of-type(1)\",\r\n 187: ).click();\r\n 188: await page.waitForFunction(\r\n 189:   () =>\r\n 190:     window.__kijunStore?.getState().project.sections.filter(\r\n 191:       (section) => section.mark === \"C51\" && section.storyLabel,\r\n 192:     ).length === 2,\r\n 193: );\r\n 194: \r\n 195: await page.setInputFiles(\"[data-testid='plan-import-file']\", {\r\n 196:   name: \"dwg-yokohama.pdf\",\r\n 197:   mimeType: \"application/pdf\",\r\n 198:   buffer: Buffer.from(pdfBase64, \"base64\"),\r\n 199: });\r\n 200: await page.waitForSelector(\"[data-testid='plan-import-section-story']\", {\r\n 201:   timeout: 120000,\r\n 202: });\r\n 203: const sectionStoryPickerBefore = await page.evaluate(() => ({\r\n 204:   value: document.querySelector(\"[data-testid='plan-import-section-story']\")?.value ?? null,\r\n 205:   options: [...document.querySelectorAll(\"[data-testid='plan-import-section-story'] option\")].map(\r\n 206:     (option) => option.value,\r\n 207:   ),\r\n 208: }));\r\n 209: const targetApplyWithSections = await page.evaluate(() => {\r\n 210:   const blocks = [...document.querySelectorAll(\"[data-testid^='plan-import-apply-']\")];\r\n 211:   const index = blocks.findIndex((button) =>\r\n 212:     button.closest(\"div\")?.textContent.includes(\"2階床伏図\"),\r\n 213:   );\r\n 214:   return index < 0 ? null : blocks[index].getAttribute(\"data-testid\");\r\n 215: });\r\n 216: if (!targetApplyWithSections) throw new Error(\"断面選択 흐름의 2階床伏図 블록을 찾지 못했다\");\r\n 217: \r\n 218: // 격자 변경 동의를 먼저 보여준 뒤, 断面 階를 고르지 않은 채 다시 반영한다.\r\n 219: await page.click(`[data-testid='${targetApplyWithSections}']`);\r\n 220: await page.waitForSelector(\"[data-testid='plan-import-discard']\");\r\n 221: await page.click(\"[data-testid='plan-import-discard']\");\r\n 222: await page.click(`[data-testid='${targetApplyWithSections}']`);\r\n 223: await page.waitForTimeout(500);\r\n 224: const ambiguousApply = await page.evaluate(() => {\r\n 225:   const state = window.__kijunStore?.getState().project;\r\n 226:   return {\r\n 227:     result: document.querySelector(\"[data-testid='plan-import-result']\")?.textContent ?? \"\",\r\n 228:     c51MemberCount:\r\n 229:       state?.members.filter((member) => member.id.includes(\"-C51-\")).length ?? -1,\r\n 230:   };\r\n 231: });\r\n 232: \r\n 233: await page.selectOption(\"[data-testid='plan-import-section-story']\", \"2階\");\r\n 234: await page.click(`[data-testid='${targetApplyWithSections}']`);\r\n 235: await page.waitForTimeout(500);\r\n 236: const selectedApply = await page.evaluate(() => {\r\n 237:   const project = window.__kijunStore?.getState().project;\r\n 238:   const member = project?.members.find((candidate) => candidate.id.includes(\"-C51-\"));\r\n 239:   const section = project?.sections.find((candidate) => candidate.id === member?.sectionId);\r\n 240:   return {\r\n 241:     sectionStoryLabel: section?.storyLabel ?? null,\r\n 242:     mainCount: section?.kind === \"柱\" ? section.main.count : null,\r\n 243:   };\r\n 244: });\r\n 245: \r\n 246: const checks = {\r\n 247:   gridXLabelsRead:\r\n 248:     read.gridX.includes(\"bX1\") && read.gridX.includes(\"cX1\"),\r\n 249:   gridXSpansRead: read.gridX.includes(\"8700\") && read.gridX.includes(\"1200\"),\r\n 250:   gridYSpansRead: read.gridY.includes(\"10000\"),\r\n 251:   allPlanBlocksRead: read.blockTitles.length === 5,\r\n 252:   elevationHeightsRead: read.elevation.includes(\"4480\"),\r\n 253:   // 같은 높이의 라벨 둘은 둘 다 보인다 — 어느 쪽이 階인지 제품이 고르지 않는다\r\n 254:   elevationAmbiguousLevelsKept:\r\n 255:     read.elevation.includes(\"中央棟1FL\") && read.elevation.includes(\"基準GL\"),\r\n 256:   untouchedBeforeApproval:\r\n 257:     untouched.x === beforeGrid.x && untouched.y === beforeGrid.y,\r\n 258:   firstApplyRefused:\r\n 259:     refused.spans.x === beforeGrid.x && refused.spans.y === beforeGrid.y,\r\n 260:   consentOfferedAfterRefusal: refused.consentOffered === true,\r\n 261:   gridAppliedAfterConsent:\r\n 262:     applied.spans.x === \"8700,8700,1200\" &&\r\n 263:     applied.spans.y === \"5000,6000,10000,6000,5000\",\r\n 264:   // 샘플 案件의 断面一覧에는 이 도면의 符号이 없다 — 지어내지 않고 사유를 말한다\r\n 265:   missingSectionsReported:\r\n 266:     applied.result.includes(\"C51\") && applied.result.includes(\"断面一覧\"),\r\n 267:   // 部材가 0본이 되어도 화면은 선다 — 割増는 引く 대상이 없을 뿐 오류가 아니다\r\n 268:   takeoffStillRenders: applied.grandTotal !== null,\r\n 269:   noPaneFailure: applied.paneFailures.length === 0,\r\n 270:   gridLabelsApplied: spanNames.join(\",\") === \"bX1-bX2,bX2-bX3,bX3-cX1\",\r\n 271:   // 階高: 고른 범위(1FL→RCL)의 두 칸만 階가 된다. パラペット·基礎는 범위 밖이다.\r\n 272:   // 이 시점에는 앞의 通り芯 반영이 이미 부재를 비웠으므로 거부가 나지 않는다 —\r\n 273:   // 부재가 남아 있을 때의 거부는 단위 테스트가 고정한다\r\n 274:   storiesApplied: storyRefused.message.includes(\"2\"),\r\n 275:   // 이름은 그 階의 바닥이 되는 레벨의 원문 그대로다 — 지어내지 않고,\r\n 276:   // 같은 높이의 라벨 둘은 둘 다 남는다\r\n 277:   storiesNamedFromDrawing:\r\n 278:     stories.includes(\"中央棟1FL／基準GL\") && stories.includes(\"2FL\"),\r\n 279:   sectionStoryPickerHiddenWithoutLabels: sectionStoryAbsentAtSample,\r\n 280:   sectionStoryPickerDefaultsToAny: sectionStoryPickerBefore.value === \"\",\r\n 281:   sectionStoryOptionsKeepFirstAppearance:\r\n 282:     sectionStoryPickerBefore.options.join(\",\") === \",2階,1階\",\r\n 283:   ambiguousSectionStorySkipsC51:\r\n 284:     ambiguousApply.c51MemberCount === 0 &&\r\n 285:     ambiguousApply.result.includes(\"同じ符号の断面が複数\") &&\r\n 286:     ambiguousApply.result.includes(\"どの階のものか選んでください\"),\r\n 287:   selectedSectionStoryApplied:\r\n 288:     selectedApply.sectionStoryLabel === \"2階\" && selectedApply.mainCount === 18,\r\n 289: };\r\n 290: \r\n 291: console.log(JSON.stringify({ read, refused, applied, spanNames, storyRefused, stories, checks }, null, 2));\r\n 292: console.log(\r\n 293:   \"SHOT \" + (await saveScreenshot(await page.screenshot(), \"uc22-plan-import.png\")),\r\n 294: );\r\n 295: \r\n 296: const failed = Object.entries(checks)\r\n 297:   .filter(([, ok]) => !ok)\r\n 298:   .map(([name]) => name);\r\n 299: if (failed.length) throw new Error(\"FAILED CHECKS: \" + failed.join(\", \"));\r\n 300: console.log(\"ALL CHECKS PASSED\");\r\n","exit_code":0,"status":"completed"}}
