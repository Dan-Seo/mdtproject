pattern.exec(value)) !== null) {\n    const label = match[0]\n    const index = match.index\n    if (!isStandaloneStoryToken(value, index)) continue\n\n    const key = storyKey(label)\n    if (key !== undefined) tokens.push({ label, key })\n  }\n\n  if (tokens.length === 0) return undefined\n\n  const keys = new Set(tokens.map((token) => token.key))\n  return keys.size === 1 ? tokens[0].label : undefined\n}\n\r\nimport { describe, expect, it } from 'vitest'\n\nimport { storyKey, storyLabelFromTitle } from '@/lib/import/story-label'\n\ndescribe('storyKey', () => {\n  it('normalizes numeric floor labels and the roof aliases', () => {\n    expect(storyKey('2??)).toBe('2')\n    expect(storyKey('2F')).toBe('2')\n    expect(storyKey('竊믧쉸')).toBe('2')\n    expect(storyKey(' RF ')).toBe('R')\n    expect(storyKey('R??)).toBe('R')\n    expect(storyKey('01F')).toBe('1')\n  })\n\n  it('does not infer keys from unsupported or non-label text', () => {\n    expect(storyKey('B1F')).toBeUndefined()\n    expect(storyKey('?겻툔1??)).toBeUndefined()\n    expect(storyKey('PH')).toBeUndefined()\n    expect(storyKey('櫻붷콏')).toBeUndefined()\n    expect(storyKey('')).toBeUndefined()\n    expect(storyKey('X1')).toBeUndefined()\n    expect(storyKey('2?롥틞鴉뤷쎋')).toBeUndefined()\n  })\n})\n\ndescribe('storyLabelFromTitle', () => {\n  it('returns the first supported floor token from a compacted title', () => {\n    expect(storyLabelFromTitle('2?롥틞鴉뤷쎋1/100')).toBe('2??)\n    expect(storyLabelFromTitle('R?롥틞鴉뤷쎋')).toBe('R??)\n    expect(storyLabelFromTitle('竊믧쉸 佯듾폀??)).toBe('2??)\n  })\n\n  it('returns undefined when no supported floor token exists', () => {\n    expect(storyLabelFromTitle('??폀??)).toBeUndefined()\n    expect(storyLabelFromTitle('?겻툔1?롥뭄?℡쎋')).toBeUndefined()\n  })\n\n  it('rejects titles containing different canonical floor keys', () => {\n    expect(storyLabelFromTitle('2?롢겏3?롢겗佯듾폀??)).toBeUndefined()\n    expect(storyLabelFromTitle('2F?팕?롥틞鴉뤷쎋')).toBeUndefined()\n  })\n\n  it('kee