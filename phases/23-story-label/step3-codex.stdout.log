k: string; reason: PlanApplySkip }>\r\n  /** ?듭㎏濡?嫄곕????ъ쑀. ?덉쑝硫?project???먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\r\n  refusal?: PlanApplyRefusal\r\n}\r\n\r\nfunction gridOf(block: PlanBlock): Grid {\r\n  const { xGrid, yGrid } = block\r\n  return {\r\n    xSpans: [...xGrid.spansMm],\r\n    ySpans: [...yGrid.spansMm],\r\n    // ?싥굤??쓽 ?대쫫? ?꾨㈃???덈뒗 寃껋씠怨? ?닿쾬???덉뼱???똜3塋?폀Y4塋?띿쿂??\r\n    // 醫뚯슦媛 ?ㅻⅨ ??씊?ゃ궧?덈? ?곗쓽 ?ㅼ젣 諛⑺뼢怨?留욎텧 ???덈떎 (R13???좉껐 議곌굔)\r\n    xLabels: xGrid.axes.map((axis) => axis.label),\r\n    yLabels: yGrid.axes.map((axis) => axis.label),\r\n  }\r\n}\r\n\r\n/**\r\n * ?ㅽ뙩留?蹂몃떎 ???쇰꺼? ?곈뇧??寃⑹옄 index??諛붽씀吏 ?딆쑝誘濡? ?대쫫留??щ씪吏?\r\n * 洹몃━?쒕? ?뚮컮?뚯뿀?ㅳ띾줈 蹂대㈃ ?ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━?쇰뒗 臾쇱쓬???댁쑀 ?놁씠 ?щ떎.\r\n */\r\nfunction sameGrid(left: Grid, right: Grid): boolean {\r\n  return (\r\n    left.xSpans.length === right.xSpans.length &&\r\n    left.ySpans.length === right.ySpans.length &&\r\n    left.xSpans.every((span, i) => span === right.xSpans[i]) &&\r\n    left.ySpans.every((span, i) => span === right.ySpans[i])\r\n  )\r\n}\r\n\r\nfunction positionOf(placement: MemberPlacement) {\r\n  return placement.role === '渦?\r\n    ? { axis: placement.axis, ix: placement.ix, iy: placement.iy }\r\n    : { ix: placement.ix, iy: placement.iy }\r\n}\r\n\r\n/**\r\n * 諛곗튂媛 寃⑹옄 ?덉쓣 媛由ы궎?붽?. 渦븐? 遺?ш? 六쀫뒗 履쎌쑝濡???移????꾩슂?섍퀬,\r\n * ?쇻궎???먯젏 履?寃⑹옄?먯씠誘濡??묒そ?쇰줈 ??移몄뵫 ?⑥븘???쒕떎.\r\n */\r\nfunction withinGrid(placement: MemberPlacement, grid: Grid): boolean {\r\n  const nx = grid.xSpans.length + 1\r\n  const ny = grid.ySpans.length + 1\r\n  const lastIx =\r\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'X')\r\n      ? nx - 2\r\n      : nx - 1\r\n  const lastIy =\r\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'Y')\r\n      ? ny - 2\r\n      : ny - 1\r\n\r\n  return (\r\n    placement.ix >= 0 &&\r\n    placement.ix <= lastIx &&\r\n    placement.iy >= 0 &&\r\n    placement.iy <= lastIy\r\n  )\r\n}\r\n\r\nexport function applyFramingPlan(\r\n  project: Project,\r\n  {\r\n    block,\r\n    storyId,\r\n    sectionStoryLabel,\r\n    discardOtherStories = false,\r\n  }: PlanApplyOptions,\r\n): PlanApplyResult {\r\n  if (!project.stories.some((story) => story.id === storyId)) {\r\n    return { project, applied: 0, skipped: [], refusal: '?롦쑋?뉐츣' }\r\n  }\r\n\r\n  const grid = gridOf(block)\r\n  const changesGrid = !sameGrid(project.grid, grid)\r\n  const otherStoryMembers = project.members.some(\r\n    (member) => member.storyId !== storyId,\r\n  )\r\n  // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽 遺?ш?\r\n  // 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫??뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠\r\n  // ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?대뒓 履쎌쓣 踰꾨┫吏???ъ슜?먭? ?뺥븳??\r\n  if (changesGrid && otherStoryMembers && !discardOtherStories) {\r\n    return {\r\n      project,\r\n      applied: 0,\r\n      skipped: [],\r\n      refusal: '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\r\n    }\r\n  }\r\n\r\n  const sections = new Map<string, Section[]>()\r\n  for (const section of project.sections) {\r\n    const candidates = sections.get(section.mark)\r\n    if (candidates) candidates.push(section)\r\n    else sections.set(section.mark, [section])\r\n  }\r\n\r\n  const members: Member[] = []\r\n  const skipped: PlanApplyResult['skipped'] = []\r\n  for (const placement of block.placements) {\r\n    const candidates = (sections.get(placement.mark) ?? []).filter(\r\n      (section) =>\r\n        sectionStoryLabel === undefined ||\r\n        section.storyLabel === sectionStoryLabel,\r\n    )\r\n    if (candidates.length === 0) {\r\n      skipped.push({ mark: placement.mark, reason: '??씊?ょ쇉?? })\r\n      continue\r\n    }\r\n    if (candidates.length > 1) {\r\n      skipped.push({ mark: placement.mark, reason: '??씊筽뉑빊屋꿨퐪' })\r\n      continue\r\n    }\r\n    const section = candidates[0]\r\n    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\r\n      skipped.push({ mark: placement.mark, reason: '?ⓩ쓲葉?닪?면걬' })\r\n      continue\r\n    }\r\n    if (!withinGrid(placement, grid)) {\r\n      skipped.push({ mark: placement.mark, reason: '?쇔춴鸚? })\r\n      continue\r\n    }\r\n\r\n    members.push({\r\n      // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎. 媛숈? ?먮━??媛숈? 寧?뤇??\r\n      // ??踰?諛섏쁺?대룄 ?섎굹濡??묓엳?꾨줉 ?먮━瑜?id???ｋ뒗??\r\n      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}${placement.role === '渦? ? `-${placement.axis}` : ''}`,\r\n      kind: section.kind,\r\n      memberClass: '翁?퐪',\r\n      sectionId: section.id,\r\n      storyId,\r\n      position: positionOf(placement),\r\n    })\r\n  }\r\n\r\n  const deduped = new Map<string, Member>()\r\n  for (const member of members) deduped.set(member.id, member)\r\n\r\n  return {\r\n    project: {\r\n      ...project,\r\n      grid,\r\n      // 痍⑥엯?섎뒗 痢듭? 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딆븘???섍퀬, ?꾨㈃?먯꽌\r\n      // ?щ씪吏?遺?ш? 旅덁뻑???⑥븘 ?덉쑝硫?洹멸쾬???뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠??\r\n      members: [\r\n        // ?듐굤??씠 諛붾뚮㈃ ?⑥? 遺?ъ쓽 index媛 ?ㅻⅨ ?먮━瑜?媛由ы궎寃??섎?濡?\r\n        // ?숈쓽瑜?諛쏆븯???뚮뒗 ?④린吏 ?딄퀬 ?꾨? 踰꾨┛????諛섏? ??꺼 ?볥뒓??鍮꾩슫??\r\n        ...(changesGrid && discardOtherStories\r\n          ? []\r\n          : project.members.filter((member) => member.storyId !== storyId)),\r\n        ...deduped.values(),\r\n      ],\r\n    },\r\n    applied: deduped.size,\r\n    skipped,\r\n  }\r\n}\r\n\r\nexport interface ElevationApplyOptions {\r\n  candidate: ElevationCandidate\r\n  /**\r\n   * ?롮쓽 寃쎄퀎濡????덈꺼??踰붿쐞. index??**?꾨㈃ ?쒖꽌**(?꾩뿉???꾨옒)??\r\n   * ????top)??理쒖긽?롮쓽 泥쒖옣, ?꾨옒 ??bottom)??理쒗븯?롮쓽 諛붾떏???쒕떎 ??\r\n   * ?묆꺀?싥긿??泥쒕떒?대굹 ?븀쨴訝뗧ク泥섎읆 ?롪? ?꾨땶 ?덈꺼? 踰붿쐞 諛뽰뿉 ?붾떎.\r\n   */\r\n  topLevelIndex: number\r\n  bottomLevelIndex: number\r\n  /** ?롫? 媛덈㈃ 遺?ш? 媛?怨녹쓣 ?껊뒗?? ?붾㈃? 嫄곕?瑜?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 */\r\n  discardMembers?: boolean\r\n}\r\n\r\nexport interface ElevationApplyResult {\r\n  project: Project\r\n  /** 留뚮뱺 ????*/\r\n  applied: number\r\n  refusal?: ElevationApplyRefusal\r\n}\r\n\r\n/**\r\n * 邕며탡?녹뿉???쎌? ?믪씠瑜?旅덁뻑???롫줈 諛섏쁺?쒕떎 (ADR-030).\r\n *\r\n * ?뚯뼱???덈꺼???롮쓽 寃쎄퀎?멸??띾뒗 ?뚯꽌媛 ?뺥븯吏 ?딆쑝誘濡?FL쨌GL쨌?븀쨴訝뗧ク쨌RCL??\r\n * ?욎뿬 ?덈떎) ?ш린???ъ슜?먯쓽 ?좏깮??諛쏅뒗?? ?롮쓽 ?대쫫??吏?대궡吏 ?딄퀬 洹??롮쓽\r\n * **諛붾떏???섎뒗 ?덈꺼???먮Ц**??洹몃?濡??대떎 ??媛숈? ?믪씠???쇰꺼???섏씠硫?????\r\n * ?④릿???ㅻЪ???뚥릎鸚?짘1FL?띻낵 ?뚦읃繹뺾L?띿씠 洹몃젃??.\r\n */\r\nexport function applyElevation(\r\n  project: Project,\r\n  {\r\n    candidate,\r\n    topLevelIndex,\r\n    bottomLevelIndex,\r\n    discardMembers = false,\r\n  }: ElevationApplyOptions,\r\n): ElevationApplyResult {\r\n  const valid =\r\n    Number.isInteger(topLevelIndex) &&\r\n    Number.isInteger(bottomLevelIndex) &&\r\n    topLevelIndex >= 0 &&\r\n    bottomLevelIndex > topLevelIndex &&\r\n    bottomLevelIndex < candidate.levels.length\r\n  if (!valid) {\r\n    return { project, applied: 0, refusal: '?롧칱?꿜툖閭? }\r\n  }\r\n\r\n  // ?롫? 媛덈㈃ 遺?ъ쓽 storyId媛 媛由ы궎???롪? ?щ씪吏꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫?\r\n  // ?뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠 ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?ъ슜?먭? ?뺥븳??\r\n  if (project.members.length > 0 && !discardMembers) {\r\n    return { project, applied: 0, refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖?? }\r\n  }\r\n\r\n  const stories: Story[] = []\r\n  // ?꾨㈃? ?꾩뿉???꾨옒, `Project.stories`???꾨옒?먯꽌 ?꾨떎 (columnEnds媛\r\n  // stories[level - 1]???뚯븘???롢띾줈 ?쎈뒗??\r\n  for (let i = bottomLevelIndex - 1; i >= topLevelIndex; i--) {\r\n    const floor = candidate.levels[i + 1]\r\n    const name =\r\n      floor.labels.length > 0\r\n        ? floor.labels.join('竊?)\r\n        : `${bottomLevelIndex - i}`\r\n    stories.push({\r\n      id: `story-${bottomLevelIndex - i}`,\r\n      name,\r\n      height: candidate.heightsMm[i],\r\n    })\r\n  }\r\n\r\n  return {\r\n    project: { ...project, stories, members: [] },\r\n    applied: stories.length,\r\n  }\r\n}\r\n--- apply.test.ts ---\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { Section } from '@/domain/model/member'\r\nimport type { Project } from '@/domain/model/project'\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\n\r\nimport type { TextItem } from '../types'\r\nimport type { TextPage } from '../section-list/types'\r\n\r\nimport { applyElevation, applyFramingPlan } from './apply'\r\nimport { parseFramingPlan } from './parse'\r\nimport type {\r\n  ElevationCandidate,\r\n  PlanBlock,\r\n  PlanGridCandidate,\r\n} from './types'\r\n\r\n// ??씊? ?먯쑝濡?吏볦? ?딄퀬 ?섑뵆 旅덁뻑?먯꽌 鍮뚮┛?????먯쑝濡?吏?쇰㈃ ?ㅽ궎留덇? ?먮씪????// ???뚯뒪?몃쭔 ??紐⑥뼇?쇰줈 ?④퀬, 洹??ъ떎??vitest???뚮젮二쇱? ?딅뒗??(tsc媛 ?〓뒗??\r\nconst sample = createSampleProject()\r\n\r\nfunction sectionOf(kind: Section['kind'], mark: string): Section {\r\n  const source = sample.sections.find((section) => section.kind === kind)\r\n  if (!source) throw new Error(`sample has no ${kind} section`)\r\n  return { ...source, id: `sec-${mark}`, mark }\r\n}\r\n\r\nfunction sectionWithStory(\r\n  kind: Section['kind'],\r\n  mark: string,\r\n  storyLabel: string | undefined,\r\n  id = `sec-${mark}-${storyLabel ?? 'none'}`,\r\n): Section {\r\n  return { ...sectionOf(kind, mark), id, storyLabel }\r\n}\r\n\r\nconst columnSection = (mark: string) => sectionOf('??, mark)\r\nconst girderSection = (mark: string) => sectionOf('鸚㎪쥈', mark)\r\n\r\nfunction h(str: string, x: number, y: number): TextItem {\r\n  return { str, x, y, w: 0, h: 8 }\r\n}\r\n\r\nfunction v(str: string, x: number, y: number): TextItem {\r\n  return { str, x, y, w: 8, h: 0, rot: -90 }\r\n}\r\n\r\nfunction framingItems(\r\n  xSpanMm: number,\r\n  ySpanMm: number,\r\n  xOffsetPt = 0,\r\n): TextItem[] {\r\n  return [\r\n    h('X1', xOffsetPt, -40),\r\n    h('X2', xOffsetPt + 200, -40),\r\n    h(String(xSpanMm), xOffsetPt + 100, -20),\r\n    h('Y1', xOffsetPt - 40, 0),\r\n    h('Y2', xOffsetPt - 40, 200),\r\n    v(String(ySpanMm), xOffsetPt - 20, 100),\r\n  ]\r\n}\r\n\r\nfunction framingPage(xSpanMm: number, ySpanMm: number): TextPage {\r\n  return {\r\n    widthPt: 1000,\r\n    heightPt: 1000,\r\n    items: framingItems(xSpanMm, ySpanMm),\r\n  }\r\n}\r\n\r\nfunction project(overrides: Partial<Project> = {}): Project {\r\n  return {\r\n    schemaVersion: 11,\r\n    name: 'test',\r\n    grid: { xSpans: [6000], ySpans: [6000] },\r\n    stories: [{ id: 'story-1', name: '1F', height: 4000 }],\r\n    sections: [],\r\n    members: [],\r\n    ...overrides,\r\n  }\r\n}\r\n\r\nconst xGrid: PlanGridCandidate = {\r\n  direction: 'X',\r\n  axes: [\r\n    { label: 'X1', positionPt: 0 },\r\n    { label: 'X2', positionPt: 200 },\r\n    { label: 'X3', positionPt: 400 },\r\n  ],\r\n  spansMm: [7000, 7000],\r\n  scalePtPerMm: 200 / 7000,\r\n  totalConfirmed: false,\r\n}\r\n\r\nconst yGrid: PlanGridCandidate = {\r\n  direction: 'Y',\r\n  axes: [\r\n    { label: 'Y1', positionPt: 0 },\r\n    { label: 'Y2', positionPt: 200 },\r\n  ],\r\n  spansMm: [5000],\r\n  scalePtPerMm: 200 / 5000,\r\n  totalConfirmed: false,\r\n}\r\n\r\nfunction block(overrides: Partial<PlanBlock> = {}): PlanBlock {\r\n  return {\r\n    xGrid,\r\n    yGrid,\r\n    placements: [],\r\n    unplacedMarks: [],\r\n    ...overrides,\r\n  }\r\n}\r\n\r\ndescribe('applyFramingPlan', () => {\r\n  it('?뚣걯寧?뤇??뼪?㏂걣筽뉑빊?롢겓?귙굦?곈쉸?뉐츣?ゃ걮?㎩룏?졼걮?ゃ걚', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', '1??),\r\n          sectionWithStory('??, 'C1', '2??),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([\r\n      { mark: 'C1', reason: '??씊筽뉑빊屋꿨퐪' },\r\n    ])\r\n  })\r\n\r\n  it('??씊??쉸?⒲깧?ャ굮?녑칳?ユ뙁若싥걲?뚣겙屋꿨퐪?쇻굥??씊?졼걨?믣룏?졼걲??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', '1??),\r\n          sectionWithStory('??, 'C1', '2??),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(1)\r\n    expect(result.project.members[0]?.sectionId).toBe('sec-C1-2??)\r\n  })\r\n\r\n  it('?뉐츣?쀣걼?롢꺀?쇻꺂??뼪?㏂걣?ゃ걨?뚣겙?ょ쇉?꿔겏?쀣겍餘뗣걲', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [sectionWithStory('??, 'C1', '1??)],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '3??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '??씊?ょ쇉?? }])\r\n  })\r\n\r\n  it('?뚣걯寧?뤇?ⓨ릪?섌쉸?⒲깧?ャ겗?띹쨭??씊?귡겦?밤겒??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', '2??, 'sec-C1-2??a'),\r\n          sectionWithStory('??, 'C1', '2??, 'sec-C1-2??b'),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([\r\n      { mark: 'C1', reason: '??씊筽뉑빊屋꿨퐪' },\r\n    ])\r\n  })\r\n\r\n  it('?롢꺀?쇻꺂?믤?誤뤷뙑?쎼걳?잍뻼?⒲걡?듽겓驪붻펱?쇻굥', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [sectionWithStory('??, 'C1', '2??)],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2F',\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '??씊?ょ쇉?? }])\r\n  })\r\n\r\n  it('?롢꺀?쇻꺂???녿뒗 ?⑤㈃? 吏?뺣맂 痢듭쓽 ?꾨낫濡?痍④툒?섏? ?딅뒗??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', undefined, 'sec-C1-no-story'),\r\n          sectionWithStory('??, 'C1', '2??),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(1)\r\n    expect(result.project.members[0]?.sectionId).toBe('sec-C1-2??)\r\n  })\r\n\r\n  it('?щ윭 鴉뤷쎋 以???踰덉㎏ 釉붾줉? ??踰덉㎏ ?꾨㈃??X쨌Y ?싥굤??쓣 援щ퀎??痍⑥엯?쒕떎', () => {\r\n    const plans = [framingPage(6000, 5000), framingPage(8000, 7000)].map(\r\n      parseFramingPlan,\r\n    )\r\n    const blocks = plans.flatMap((plan) => plan.blocks)\r\n    if (!blocks[1]) {\r\n      throw new Error('synthetic framing plans were not parsed')\r\n    }\r\n\r\n    const result = applyFramingPlan(project(), {\r\n      block: blocks[1],\r\n      storyId: 'story-1',\r\n    })\r\n\r\n    expect(result.project.grid.xSpans).toEqual([8000])\r\n    expect(result.project.grid.ySpans).toEqual([7000])\r\n    expect(result.refusal).toBeUndefined()\r\n    expect(result.skipped).toEqual([])\r\n  })\r\n\r\n  it('???섏씠吏???ㅽ뙩???ㅻⅨ 鴉뤷쎋 ???μ? 媛?釉붾줉??X쨌Y ?싥굤??쑝濡?痍⑥엯?쒕떎', () => {\r\n    const parsed = parseFramingPlan({\r\n      widthPt: 1400,\r\n      heightPt: 1000,\r\n      items: [\r\n        ...framingItems(6000, 5000),\r\n        ...framingItems(8000, 7000, 600),\r\n      ],\r\n    })\r\n\r\n    expect(parsed.blocks).toHaveLength(2)\r\n    expect(parsed.blocks.map((candidate) => candidate.xGrid.spansMm)).toEqual([\r\n      [6000],\r\n      [8000],\r\n    ])\r\n    expect(parsed.blocks.map((candidate) => candidate.yGrid.spansMm)).toEqual([\r\n      [5000],\r\n      [7000],\r\n    ])\r\n\r\n    const appliedGrids = parsed.blocks.map(\r\n      (candidate) =>\r\n        applyFramingPlan(project(), {\r\n          block: candidate,\r\n          storyId: 'story-1',\r\n        }).project.grid,\r\n    )\r\n    expect(appliedGrids).toEqual([\r\n     