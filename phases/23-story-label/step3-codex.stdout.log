 typeof(System.IO.DirectoryInfo) }, ProviderCmdlet = \\\\\\\"Get-Item\\\\\\\")] [System.Management.Automation.OutputTypeAttribute(new Type[5] { typeof(System.Boolean), typeof(System.String), typeof(System.DateTime), typeof(System.IO.FileInfo), typeof(System.IO.DirectoryInfo) }, ProviderCmdlet = \\\\\\\"Get-ItemProperty\\\\\\\")] [System.Management.Automation.Provider.CmdletProviderAttribute(\\\\\\\"FileSystem\\\\\\\", (System.Management.Automation.Provider.ProviderCapabilities)52)]\\\"},\\\"HelpFile\\\":\\\"System.Management.Automation.dll-Help.xml\\\",\\\"Name\\\":\\\"FileSystem\\\",\\\"PSSnapIn\\\":{\\\"Name\\\":\\\"Microsoft.PowerShell.Core\\\",\\\"IsDefault\\\":true,\\\"ApplicationBase\\\":\\\"C:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\",\\\"AssemblyName\\\":\\\"System.Management.Automation, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35, ProcessorArchitecture=MSIL\\\",\\\"ModuleName\\\":\\\"C:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\System.Management.Automation.dll\\\",\\\"PSVersion\\\":\\\"5.1.26100.9168\\\",\\\"Version\\\":\\\"3.0.0.0\\\",\\\"Types\\\":\\\"types.ps1xml typesv3.ps1xml\\\",\\\"Formats\\\":\\\"Certificate.format.ps1xml DotNetTypes.format.ps1xml FileSystem.format.ps1xml Help.format.ps1xml HelpV3.format.ps1xml PowerShellCore.format.ps1xml PowerShellTrace.format.ps1xml Registry.format.ps1xml\\\",\\\"Description\\\":\\\"이 Windows PowerShell 스냅인에는 Windows PowerShell 구성 요소를 관리하는 데 사용되는 cmdlet이 포함되어 있습니다.\\\",\\\"Vendor\\\":\\\"Microsoft Corporation\\\",\\\"LogPipelineExecutionDetails\\\":false},\\\"ModuleName\\\":\\\"Microsoft.PowerShell.Core\\\",\\\"Module\\\":null,\\\"Description\\\":\\\"\\\",\\\"Capabilities\\\":52,\\\"Home\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\",\\\"Drives\\\":[\\\"C\\\",\\\"D\\\",\\\"G\\\"]},\\\"ReadCount\\\":11}\\r\\n{\\\"value\\\":\\\"   - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — 断面リスト 취입에서 좌우 비대칭 主筋의 始端/終端 대응에 사용한다. ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조)\\\",\\\"PSPath\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\docs\\\\\\\\MILESTONES.md\\\",\\\"PSParentPath\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\docs\\\",\\\"PSChildName\\\":\\\"MILESTONES.md\\\",\\\"PSDrive\\\":{\\\"CurrentLocation\\\":\\\"Users\\\\\\\\emper\\\\\\\\mdtproject\\\",\\\"Name\\\":\\\"C\\\",\\\"Provider\\\":{\\\"ImplementingType\\\":\\\"Microsoft.PowerShell.Commands.FileSystemProvider\\\",\\\"HelpFile\\\":\\\"System.Management.Automation.dll-Help.x