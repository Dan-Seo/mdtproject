ult.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\r\n    expect(result.project.members).toHaveLength(1)\r\n  })\r\n\r\n  it('?ㅻⅨ 痢듭뿉 遺?ш? ?덈뒗???싥굤??씠 諛붾뚮㈃ ?듭㎏濡?嫄곕??쒕떎', () => {\r\n    // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽\r\n    // 遺?ш? 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. ???쒗뭹??紐?寃щ뵒???ㅽ뙣??    const existing = project({\r\n      sections: [columnSection('C1')],\r\n      members: [\r\n        {\r\n          id: 'm1',\r\n          kind: '??,\r\n          memberClass: '翁?퐪',\r\n          sectionId: 'sec-C1',\r\n          storyId: 'story-2',\r\n          position: { ix: 1, iy: 1 },\r\n        },\r\n      ],\r\n      stories: [\r\n        { id: 'story-1', name: '1F', height: 4000 },\r\n        { id: 'story-2', name: '2F', height: 4000 },\r\n      ],\r\n    })\r\n\r\n    const result = applyFramingPlan(existing, {\r\n      block: block(),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.refusal).toBe('餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??)\r\n    expect(result.project).toBe(existing)\r\n  })\r\n\r\n  it('痍⑥엯?섎뒗 痢듭쓽 遺?щ뒗 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딅뒗??, () => {\r\n    const base = project({ sections: [columnSection('C1')] })\r\n    const options = {\r\n      block: block({\r\n        placements: [{ mark: 'C1', role: '?쇔춴?? as const, ix: 1, iy: 1 }],\r\n      }),\r\n      storyId: 'story-1',\r\n    }\r\n\r\n    const once = applyFramingPlan(base, options)\r\n    const twice = applyFramingPlan(once.project, options)\r\n    expect(once.project.members).toHaveLength(1)\r\n    expect(twice.project.members).toHaveLength(1)\r\n    expect(once.applied).toBe(1)\r\n  })\r\n\r\n  it('媛숈? 寃⑹옄?먯뿉??X쨌Y 諛⑺뼢?쇰줈 六쀫뒗 媛숈? 寧?뤇??鸚㎪쥈??紐⑤몢 ?④릿??, () => {\r\n    const result = applyFramingPlan(project({ sections: [girderSection('G1')] }), {\r\n      block: block({\r\n        placements: [\r\n          { mark: 'G1', role: '渦?, ix: 0, iy: 0, axis: 'X' },\r\n          { mark: 'G1', role: '渦?, ix: 0, iy: 0, axis: 'Y' },\r\n        ],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n\r\n