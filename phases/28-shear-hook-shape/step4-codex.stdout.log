\n    // 3D ??뀓營?쑍?겹겘 placement ?뚧똻?ㅳ귝빊?뤸쑍??count ??찉嶸쀥읃繹?1?싧뎴7) ??\r\n    // ?γ겓黎뷩겲?뗣겗?㎯곥걪?볝겎訝↑끹굮?뚥?誤뽧걮?╉겘?ゃ굢?ゃ걚??\r\n    expect(stirrup.placement?.positionCount).toBe(positions.length)\r\n    expect(positions.every((position) => position >= 0)).toBe(true)\r\n    expect(positions.every((position) => position <= span.clear)).toBe(true)\r\n  })\r\n\r\n  it('keeps both 訝사춮 counts exactly as supplied by the section list (ADR-012)', () => {\r\n    const changedSection: GirderSection = {\r\n      ...section,\r\n      main: {\r\n        ...section.main,\r\n        top: { endCount: 7, centerCount: 7 },\r\n        bottom: { endCount: 9, centerCount: 9 },\r\n      },\r\n    }\r\n    const generated = generateGirderRebar(\r\n      input({ section: changedSection }),\r\n      jpMlitRulePack,\r\n    )\r\n\r\n    expect(byRole(generated, '訝딁ク嶺?).count).toBe(7)\r\n    expect(byRole(generated, '訝뗧ク嶺?).count).toBe(9)\r\n  })\r\n\r\n  it('explains a 0?뗦? splice by the count, not by the method', () => {\r\n    // ?룔걬?뚦쥥?덀겒?꾠겗??뼶凉뤵겗?쎼걚?㎯겘?ゃ걚??겓?뚪뇥??텤?뗣겘?룔걬??쨯?뽧겒?쀣띲겏\r\n    // ?멥걦?ⓦ곩릪?섋죱?뚦눣?멥겓?쇻걩??measure.splice.length.factor{?띲겖泳숁뎸}=1\r\n    // 竊덄츞?γ걲?뗰펹?③짘?꾦걬?녴괗25 ??7.0m ?붵겏?ゃ겗?㎯곥걹?뚣겓繹?잆겒?꾣쥈?믢슴?녴?\r\n    const shortSpan: GirderSpan = { ...span, centerSpan: 5600, clear: 4800 }\r\n    const generated = generateGirderRebar(\r\n      input({ run: runWithSpan(shortSpan) }),\r\n      jpMlitRulePack,\r\n    )\r\n    const { formula } = byRole(generated, '訝딁ク嶺?)\r\n\r\n    expect(formula).toContain('泳숁뎸 0?뗦? 竊?0')\r\n    expect(formula).not.toContain('?룔걬??쨯?뽧겒??)\r\n  })\r\n\r\n  it('tracks only existing rules in a stable contribution order', () => {\r\n    const generated = generateGirderRebar(input(), jpMlitRulePack)\r\n    // 留덉?留?cover.minimum ? 塋?깿?▽뻑???먯젙??吏???깆쓽 ?됱씠????鸚㎪쥈 ?됯낵\r\n    // 議곌굔???ㅻⅤ誘濡??ㅻ쭔?쇰줈??援щ텇?섏? ?딅뒗??\r\n    const bentMainRules = [\r\n      'cover.minimum',\r\n      'cover.fabrication.addition',\r\n      'anchorage.L1',\r\n      // anchorage.L1h ??펹?됥겒???