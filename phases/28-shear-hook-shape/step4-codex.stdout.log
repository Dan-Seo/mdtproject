{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Raw src/domain/rebar/stirrup-layout.ts; Get-Content src/domain/rebar/column.ts | Select-Object -First 430; Get-Content src/domain/rebar/girder.ts | Select-Object -Skip 680 -First 155; Get-Content -Raw src/domain/rebar/column.test.ts; Get-Content -Raw src/domain/rebar/girder.test.ts; Get-Content -Raw package.json'","aggregated_output":"export interface StirrupLayout {\r\n  /** ?끾퀡 醫뚰몴怨?醫뚯륫 ?깁씊 = 0)???꾩튂 諛곗뿴 (mm) */\r\n  positionsMm: number[]\r\n  /** 留덉?留??붿뿬 媛꾧꺽 (mm) ??踰붾? ?쒖떆??*/\r\n  lastGapMm: number\r\n}\r\n\r\ntype PlanarDirection = [number, number]\r\n\r\n/**\r\n * 135째?뺛긿??겗烏①ㅊ?ⓩ뼶?묆굮?곫뼪?℡냵?묆걤??릎恙껆퇉?뗣굢藥?뤂野양㎞?ュ늽?묆굥??\n * ?딃뼀?띹쭜??45째 ??렅?뉎겗野멩퀡?㎯겘?ゃ걦?곥걪??깛?γ꺖?㏂겗鵝쒎쎋誤뤷뎴?㎯걗?뗣?\n * ?곈뇧??`Rebar.length` ?뚧똻?ㅶ뼪?℡뫅?룔굮鵝욍걝?잆굙?곥걪??쭜佯╉겘?곈뇧?ュ쉽?욍걮?ゃ걚??\n */\r\nexport function symmetricInwardDirections(\r\n  inwardAngleRadians: number,\r\n): [PlanarDirection, PlanarDirection] {\r\n  const halfSpreadRadians = Math.PI / 4\r\n  return [\r\n    inwardAngleRadians - halfSpreadRadians,\r\n    inwardAngleRadians + halfSpreadRadians,\r\n  ].map((angle) => [Math.cos(angle), Math.sin(angle)]) as [\r\n    PlanarDirection,\r\n    PlanarDirection,\r\n  ]\r\n}\r\n\r\nexport function stirrupPositions(\r\n  clearMm: number,\r\n  pitchMm: number,\r\n  startOffsetMm: number,\r\n): StirrupLayout {\r\n  if (!Number.isFinite(clearMm)) {\r\n    throw new Error(`clearMm must be finite: ${clearMm}`)\r\n  }\r\n  if (!Number.isFinite(pitchMm) || pitchMm <= 0) {\r\n    throw new Error(`pitchMm must be positive and finite: ${pitchMm}`)\r\n  }\r\n  if (!Number.isFinite(startOffsetMm) || startOffsetMm < 0) {\r\n    throw new Error(\r\n      `startOffsetMm must be non-negative and finite: ${startOffsetMm}`,\r\n    )\r\n  }\r\n  if (clearMm <= 2 * startOffsetMm) {\r\n    throw new Error(\r\n      `clearMm must exceed twice startOffsetMm: ${clearMm} <= ` +\r\n        `${2 * startOffsetMm}`,\r\n    )\r\n  }\r\n\r\n  const intervalStartMm = startOffsetMm\r\n  const intervalEndMm = clearMm - startOffsetMm\r\n  const positionsMm = [intervalStartMm]\r\n\r\n  for (let index = 1; ; index += 1) {\r\n    const positionMm = intervalStartMm + index * pitchMm\r\n    if (positionMm >= intervalEndMm) break\r\n    positionsMm.push(positionMm)\r\n  }\r\n\r\n  positionsMm.push(intervalEndMm)\r\n\r\n  for (let index = 0; index < positionsMm.length; index += 1) {\r\n    const positionMm = positionsMm[index]\r\n    if (positionMm < intervalStartMm || positionMm > intervalEndMm) {\r\n      throw new Error(`?귙겙?됬춮 position outside placement interval: ${positionMm}`)\r\n    }\r\n\r\n    if (index > 0) {\r\n      const gapMm = positionMm - positionsMm[index - 1]\r\n      if (gapMm <= 0 || gapMm > pitchMm) {\r\n        throw new Error(`Invalid ?귙겙?됬춮 gap: ${gapMm}`)\r\n      }\r\n    }\r\n  }\r\n\r\n  return {\r\n    positionsMm,\r\n    lastGapMm:\r\n      positionsMm[positionsMm.length - 1] -\r\n      positionsMm[positionsMm.length - 2],\r\n  }\r\n}\r\n\r\nimport type {\r\n  BarSize,\r\n  ColumnSection,\r\n  Member,\r\n  ShearBarSize,\r\n} from '../model/member'\r\nimport type { Rebar, RebarZone, Vec3 } from '../model/rebar'\r\nimport type { ColumnEnds, Story } from '../model/project'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { coverConditions, lookupRule } from '../rules/lookup'\r\nimport type { RuleHit, RulePack } from '../rules/types'\r\nimport {\r\n  distributionCount,\r\n  circularHoopDesignLengthMm,\r\n  hoopDesignLengthMm,\r\n  spliceCount,\r\n  spliceLengthMm,\r\n} from './measurement'\r\nimport {\r\n  stirrupPositions,\r\n  symmetricInwardDirections,\r\n} from './stirrup-layout'\r\n\r\nexport interface ColumnRebarInput {\r\n  member: Member\r\n  section: ColumnSection\r\n  story: Story\r\n  beamDepthAbove: number\r\n  /** ?ㅽ깮 ?덉뿉?쒖쓽 ?⑤? 議곌굔. `columnEnds()`媛 ?먯젙?쒕떎 (R7). */\r\n  ends: ColumnEnds\r\n}\r\n\r\nfunction barDiameter(size: BarSize | ShearBarSize): number {\r\n  const diameter = Number(size.replace(/^[A-Z]+/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid BarSize: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\n/**\r\n * ?녶숱?뺛꺖?쀣겗?졾램壤®듁?믤뒛?뚨퇉?㎬〃?쇿늽?꿩빊??*鵝쒎쎋誤뤷뎴?㎯걗?ｃ겍誤뤸틬?ㅳ겎??겒??* ??\r\n * ?곈뇧??1?싧뎴2) ??냶?⑨펷?횞?닷푶竊됥굮鵝욍걚?곥걪??뒛?뚨퇉??빓?뺛겘鵝욍굩?ゃ걚 (ADR-019)??\r\n * 24 ??600? ??1 渦?78mm 葉뗥벧?곮〃鹽뷴뜇孃?22mm ????㎯겇?ゃ걚?㎩냶?ヨ쫳?덀굥?弱뤻솏?졼?\r\n */\r\nconst CIRCULAR_HOOP_SEGMENTS = 24\r\n\r\n/** ?뗣겤?딃씊?ユ렏?쇻굥?녴굮?곲뻾?섅걼?섅굦渶싥겎瓦붵걲?귚릎恙껁겘??씊??릎恙껁겎?귙굥??*/\r\nfunction circularHoopPoints(\r\n  diameterMm: number,\r\n  fabricationCoverMm: number,\r\n): [number, number, number][] {\r\n  const centre = diameterMm / 2\r\n  const radius = centre - fabricationCoverMm\r\n\r\n  return Array.from(\r\n    { length: CIRCULAR_HOOP_SEGMENTS },\r\n    (_, index): [number, number, number] => {\r\n      const angle = (2 * Math.PI * index) / CIRCULAR_HOOP_SEGMENTS\r\n      return [centre + radius * Math.cos(angle), 0, centre + radius * Math.sin(angle)]\r\n    },\r\n  )\r\n}\r\n\r\nfunction millimetres(rule: RuleHit, diameter?: number): number {\r\n  if (rule.unit === 'mm') return rule.value\r\n  if (rule.unit === 'd' && diameter !== undefined) {\r\n    return rule.value * diameter\r\n  }\r\n\r\n  throw new Error(\r\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\r\n  )\r\n}\r\n\r\nfunction hookTailLengthMm(rule: RuleHit, size: ShearBarSize): number {\r\n  return millimetres(rule, barDiameter(size))\r\n}\r\n\r\nfunction twoInwardTails(\r\n  origin: Vec3,\r\n  lengthMm: number,\r\n  directions: [[number, number], [number, number]],\r\n): [Vec3, Vec3] {\r\n  return directions.map(([first, second]) => {\r\n    const magnitude = Math.hypot(first, second)\r\n    return [\r\n      origin[0] + (lengthMm * first) / magnitude,\r\n      origin[1],\r\n      origin[2] + (lengthMm * second) / magnitude,\r\n    ]\r\n  }) as [Vec3, Vec3]\r\n}\r\n\r\nexport function generateColumnRebar(\r\n  input: ColumnRebarInput,\r\n  pack: RulePack,\r\n): Rebar[] {\r\n  const { member, section, story, beamDepthAbove, ends } = input\r\n  const commonConditions = {\r\n    fc: section.fc,\r\n    grade: section.grade,\r\n    hook: false,\r\n  }\r\n  const coverRule = lookupRule(\r\n    pack,\r\n    'cover.minimum',\r\n    coverConditions(section),\r\n  )\r\n  const fabricationCoverAdditionRule = lookupRule(\r\n    pack,\r\n    'cover.fabrication.addition',\r\n    {},\r\n  )\r\n  // ?긴말嶺뗣겗若싩???〃5.3.4????у?L1 (力? ??力???餓ε쨼)?괢2 ??뚦돯獒귞졃鶯듽겗\r\n  // ?듽걹?뚣겗?ゃ걚嶸뉑??띺솏若?(力?) ?㎯곥걹??닩若싨쓲?쇻굮獒썲뱚??똻?잆겒?꾠걼?곦??уㅳ굮鵝욍걝??\r\n  const anchorageRule = lookupRule(\r\n    pack,\r\n    'anchorage.L1',\r\n    commonConditions,\r\n  )\r\n  const lapRule = lookupRule(pack, 'lap.L1', commonConditions)\r\n  // 泳숁뎸嶸뉑??겹겘 2竊덌폃竊됪윶2)?뚦릢?롢걫?ⓦ겓1?뗦??띲귟Þ鼇덆빓?뺛겓鵝뺛굮嶸쀥뀯?쇻굥?뗣겘\r\n  // 泳숁뎸?밧폀?붵겏?ラ걬?꾠곥궗?밧쑇?γ겘 1?싧뎴5) ??0 ?ャ겒?뗣?\r\n  const spliceCountRule = lookupRule(pack, 'measure.splice.column', {})\r\n  const spliceFactorRule = lookupRule(pack, 'measure.splice.length.factor', {\r\n    method: section.spliceMethod,\r\n  })\r\n  // 躍?춮??빊?뤵굮黎뷩굙?뗣겗??찉嶸쀥읃繹뽧겗2?↓쟿?졼괷end.hook135 ?믣폊?뗣겒?꾠겗??\r\n  // 1?싧뎴2) ?뚣뚣깢?껁궚??겒?꾠굚??겏?쇻굥?띲겏若싥굙?뗣걢?됥겎?곥걹??틟若잒눎鵝볝굮\r\n  // measure.hoop.length.addition ?뚦눣?멧퍡?띲겎?곥겇??\r\n  const hoopLengthAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.hoop.length.addition',\r\n    {},\r\n  )\r\n  const distributionAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.distribution.addition',\r\n    {},\r\n  )\r\n  const hook135Rule = lookupRule(pack, 'bend.hook135', {})\r\n  // 訝사춮??툓塋?겘若싩??쀣겒?????밤궭?껁궚?訝딁ク竊덂뀍塋?펹??1?싧뎴1)?뚦뀍塋?겎閭㏂겲??\r\n  // ?꾤춮??궠?녈궚?ゃ꺖?덀겗鼇?쮫野멩퀡?랃펻竊덌폃竊됪윶1) 鵝녷쎑?뚧?訝딃쉸?긴말嶺뗣굮?볝겗?↓쟿??\r\n  // ?롧ㅊ?꾠겓冶붵겖??(R9????\r\n  const tipLengthAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.tip.length.addition',\r\n    {},\r\n  )\r\n\r\n  const minimumCover = millimetres(coverRule)\r\n  const fabricationCoverAddition = millimetres(\r\n    fabricationCoverAdditionRule,\r\n  )\r\n  const fabricationCover = minimumCover + fabricationCoverAddition\r\n  const mainDiameter = barDiameter(section.main.size)\r\n  const anchorageLength = millimetres(anchorageRule, mainDiameter)\r\n  const lapLength = millimetres(lapRule, mainDiameter)\r\n\r\n  // 塋?깿?▽뻑?붵겏??섯??(R7?졼꺕R9???귛츣???궧?욍긿??겗訝뗧ク(?븀쨴)?ャ걮?뗤퍡?뗣겒?꾠?\r\n  // 訝딁ク??만??0 ??訝?뼋??렏?덆깿??뎱嶺뗣걣?싥굤?쒌걨(泳숁뎸??ク?ⓩ씉餓뜰겎??겒??\r\n  // 2竊덌폃竊됪윶2) ?뚧빊?덀굥)?곥궧?욍긿???訝딁ク(?덄ク)??1?싧뎴1) ?뚦츣??믣뒥?덀겒?꾠?\r\n  const bottomExtension = ends.bottom === '若싩?' ? anchorageLength : 0\r\n  const topExtension = 0\r\n  // 3D ?ユ룒?뗣굦?뗩빓?뺛귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?싥곮Þ鼇덆빓?뺛겓?졼걨?γ굥??\r\n  const drawnLength = story.height + bottomExtension + topExtension\r\n  const spliceCountPerBar = spliceCount(spliceCountRule)\r\n  const spliceLength = spliceLengthMm(\r\n    spliceCountPerBar,\r\n    lapLength,\r\n    spliceFactorRule,\r\n  )\r\n  const mainLength = drawnLength + spliceLength\r\n  const mainZones: RebarZone[] = []\r\n\r\n  if (ends.bottom === '若싩?') {\r\n    mainZones.push({\r\n      kind: '若싩?',\r\n      ruleKey: anchorageRule.key,\r\n      pathFromMm: 0,\r\n      pathToMm: bottomExtension,\r\n    })\r\n  }\r\n\r\n  // 訝딁ク??츣??쀣겒???ゃ걮?삣뀍塋?걚?싥굦????겎?곥걪?볝겓?얇꺖?녈겘?▲걚(R9????\r\n\r\n  const endTerms: string[] = []\r\n  const mainRuleHits: RuleHit[] = [\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n  ]\r\n\r\n  if (ends.bottom === '若싩?') {\r\n    endTerms.push(\r\n      `訝뗧ク 若싩??룔걬 L1 ${anchorageRule.value}d(${anchorageLength})`,\r\n    )\r\n    mainRuleHits.push(anchorageRule)\r\n  } else {\r\n    endTerms.push('訝뗧ク 訝뗩쉸?긱걢?됮싥굥 0')\r\n  }\r\n\r\n  if (ends.top === '?덄ク') {\r\n    endTerms.push('訝딁ク ?덄ク竊덀궠?녈궚?ゃ꺖?덅Þ鼇덂?力뺛겲?㏆펹0')\r\n    mainRuleHits.push(tipLengthAdditionRule)\r\n  } else {\r\n    endTerms.push('訝딁ク 訝딃쉸?긱겦?싥굥 0')\r\n  }\r\n\r\n  // 泳숁뎸??Þ鼇덆빓?뺛겗訝?ⓦ겒??겎?곮나?뤺죱??눣?멥겓?귟펹?쎼굥?귡뇥??텤?뗩빓?뺛겘\r\n  // 嶸쀥뀯?뺛굦?뗣겏?띲걽?묋펹?쎼굥 ??0 ??겏?띹펹?쎼굥?①츞?뷴폀?ョ뤎?뚣겒?꾣졊?졼겓?ゃ굥??\r\n  const spliceRules: RuleHit[] = [spliceCountRule, spliceFactorRule]\r\n  if (spliceLength > 0) spliceRules.push(lapRule)\r\n  mainRuleHits.push(...spliceRules)\r\n\r\n  const spliceLengthTerm =\r\n    spliceLength > 0\r\n      ? `${spliceCountPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 L1 ${lapRule.value}d(${lapLength}) 竊?${spliceLength}`\r\n      : `${spliceCountPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\r\n\r\n  const hoopWidth = section.b - 2 * fabricationCover\r\n  const hoopDepth = section.d - 2 * fabricationCover\r\n\r\n  // ?졾램?ⓦ걢?뜰굤횞2 蹂대떎 ?묒? ?⑤㈃? ?뚯닔 ?졾램野멩퀡??留뚮뱾怨? 洹?媛믪? 3D ?뺤긽?먯꽌\r\n  // ?ㅼ쭛???ш컖?뺤씠 ?쒕떎 ??議곗슜???由?媛?????ㅽ뙣?쒕떎 (ADR-014).\r\n  if (hoopWidth <= 0 || hoopDepth <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `躍?춮 ?졾램野멩퀡 must be positive: ${member.id} ` +\r\n        `(${section.b}횞${section.d} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCover})`,\r\n    )\r\n  }\r\n\r\n  // ?곈뇧??찉嶸쀥읃繹?1?싧뎴2) ????씊??Þ鼇덂?力뺛겓?덀굥?③빓?곥깢?껁궚??쮫訝듽걮?ゃ걚??\r\n  // ?뗣겤?듽굮?㏝솮?쀣걼訝듽겗 hoopWidth쨌hoopDepth ??3D 壤®듁 (points) 弱귞뵪?㎯걗?뗣?\r\n  // ?녶숱?긱겎??릪?섉씉?뉎겗?뚦뫅?룔띲걣?녶뫅?ャ겒??(ADR-027)??\r\n  const circular = section.shape === '?녶숱'\r\n  const hoopLength = circular\r\n    ? circularHoopDesignLengthMm(section.b, hoopLengthAdditionRule)\r\n    : hoopDesignLengthMm(section.b, section.d, hoopLengthAdditionRule)\r\n  const hoopPoints: Vec3[] = circular\r\n    ? circularHoopPoints(section.b, fabricationCover)\r\n    : [\r\n        [fabricationCover, 0, fabricationCover],\r\n        [section.b - fabricationCover, 0, fabricationCover],\r\n        [\r\n          section.b - fabricationCover,\r\n          0,\r\n          section.d - fabricationCover,\r\n        ],\r\n        [fabricationCover, 0, section.d - fabricationCover],\r\n      ]\r\n  const hookTailLength = hookTailLengthMm(hook135Rule, section.hoop.size)\r\n  const hookTails = twoInwardTails(\r\n    hoopPoints[0],\r\n    hookTailLength,\r\n    symmetricInwardDirections(circular ? Math.PI : Math.PI / 4),\r\n  )\r\n\r\n  // 訝딃깿鸚㎪쥈?쎼걚媛 ?롩쳵 ?댁긽?대㈃ 3D 諛곗튂 援ш컙???щ씪吏꾨떎. ?곈뇧留뚯씠?쇰㈃\r\n  // ?롩쳵濡?怨꾩궛?섏?留?1?싧뎴7)), 洹몃윴 遺?щ뒗 歟곸씠 痢듬낫???믩떎???살씠???뺤긽??\r\n  // ?깅┰?섏? ?딅뒗?????낅젰 ?ㅻ쪟濡?蹂닿퀬 ?졾램野멩퀡 媛?쒖? 媛숈씠 ?ㅽ뙣?쒗궓??\r\n  const hoopSpan = story.height - beamDepthAbove\r\n  if (hoopSpan <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `躍?춮 ?띸쉰?븅뼋 must be positive: ${member.id} ` +\r\n        `(?롩쳵 ${story.height} ??訝딃깿鸚㎪쥈?쎼걚 ${beamDepthAbove})`,\r\n    )\r\n  }\r\n\r\n  // 誤뤸틬??媛믪씠 ?녿뒗 諛곗튂媛믪씠??????씊訝誤㏃쓽 ?낅젰??洹몃?濡??대떎 (ADR-012)\r\n  const hoopStartOffsetMm = section.hoop.startOffsetMm\r\n\r\n  if (hoopSpan <= 2 * hoopStartOffsetMm) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `躍?춮 ?띸쉰?븅뼋 must be positive: ${member.id} ` +\r\n        `(?띸쉰?븅뼋 ${hoopSpan} ??2횞?앮쐿?ゃ깢?삠긿??${hoopStartOffsetMm})`,\r\n    )\r\n  }\r\n\r\n  const hoopLayout = stirrupPositions(\r\n    hoopSpan,\r\n    section.hoop.pitch,\r\n    hoopStartOffsetMm,\r\n  )\r\n  // ?곈뇧??찉嶸쀥읃繹?竊덌폃竊됪윶3)竊??싧뎴7) ???꾦쉸?붵겏?ャ곥걹??깿?녴겗?룔걬첨?볣슂??\r\n  // ?뚦릢?롦윶?띲겘翁?퐪??뙷?녴겎?꾦쉸佯딀씮訝딃씊?볝겒??겎?곩돯?뗣겗??냵力뺛겎??겒?뤻쉸遙섅겎?귙굥??\r\n  // ?띸쉰?븅뼋 hoopSpan ?ⓨ닜?잆궕?뺛궩?껁깉??3D 壤®듁 (placement) 弱귞뵪??\r\n  const hoopCount = distributionCount(\r\n    story.height,\r\n    section.hoop.pitch,\r\n    distributionAdditionRule,\r\n  )\r\n  const fabricationCoverFormula =\r\n    `?졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${minimumCover} 竊?` +\r\n    `?좂츞 ${fabricationCoverAddition} 竊?${fabricationCover}竊?\r\n\r\n  const main: Rebar = {\r\n    id: `${member.id}|main`,\r\n    memberId: member.id,\r\n    role: '訝사춮',\r\n    size: section.main.size,\r\n    shape: 'straight',\r\n    // 餓ｈ〃1?с겗鵝띸쉰?귞윪壤㏂겘?끹곩냶壤㏂겘?뗣겤?듿냶訝듽겗訝?밤겎?곮〃鹽븅깿??걪?볝걢??\r\n    // ?ⓦ굮嶺됮뼋?붵겓閭⒲걚??츪?ф빊?믤룒??(ADR-019 ???띸쉰??퐳?녘쫸?뉎겎?귙굥)??\r\n    points: circular\r\n      ? [\r\n          [fabricationCover, -bottomExtension, section.d / 2],\r\n          [fabricationCover, story.height + topExtension, section.d / 2],\r\n        ]\r\n      : [\r\n          [fabricationCover, -bottomExtension, fabricationCover],\r\n          [\r\n            fabricationCover,\r\n            story.height + topExtension,\r\n            fabricationCover,\r\n          ],\r\n        ],\r\n    closed: false,\r\n    length: mainLength,\r\n    count: section.main.count,\r\n    zones: mainZones,\r\n    splice: {\r\n      method: section.spliceMethod,\r\n      countPerBar: spliceCountPerBar,\r\n      lengthMm: spliceLength,\r\n      rules: spliceRules,\r\n      formula:\r\n        `泳숁뎸嶸뉑???竊?訝사춮1?с걗?잆굤 ${spliceCountPerBar}?뗦?` +\r\n        `竊덃빊?뤹찉嶸쀥읃繹?2竊덌폃竊됪윶2) ???꾦쉸?긱겗?③빓?ャ굩?잆굥訝사춮??릢?롢걫?ⓦ겓1?뗦?竊?竊?` +\r\n        `?밧폀 竊?${section.spliceMethod} 竊?` +\r\n        `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm} 竊?` +\r\n        `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\r\n    },\r\n    ruleHits: mainRuleHits,\r\n    formula:\r\n      `鼇?쮫?룔걬 竊??롩쳵 ${story.height} 竊?${endTerms.join(' 竊?')} ` +\r\n      `竊?泳숁뎸 ${spliceLengthTerm} 竊?${mainLength} 竊?` +\r\n      `?띸쉰?뷸틬 竊?${fabricationCoverFormula} 竊?` +\r\n      `?ф빊 竊???씊訝誤㎯겗訝사춮?ф빊 ${section.main.count} 竊?` +\r\n      `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚` +\r\n      `竊덃룒?뗣굦?뗩빓??${drawnLength} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹`,\r\n  }\r\n\r\n  const hoop: Rebar = {\r\n    id: `${member.id}|hoop`,\r\n    memberId: member.id,\r\n    role: '躍?춮',\r\n    size: section.hoop.size,\r\n    shape: 'hoop',\r\n    points: hoopPoints,\r\n    closed: true,\r\n    hookTails,\r\n    length: hoopLength,\r\n    count: hoopCount,\r\n    placement: {\r\n      axis: 'y',\r\n      clearMm: hoopSpan,\r\n      pitchMm: section.hoop.pitch,\r\n      startOffsetMm: hoopStartOffsetMm,\r\n      lastGapMm: hoopLayout.lastGapMm,\r\n      positionCount: hoopLayout.positionsMm.length,\r\n    },\r\n    // 鼇?쮫?룔걬?삭Þ鼇덃쑍?겹굮黎뷩굙?잆겗??걪???↓쟿?졼걨?졼귙걢?뜰굤??3D 壤®듁\r\n    // (points) ?ャ걮?뗥듅?뗣겒?꾠겗?㎯곮펹?쎼굥?①츞?뷴폀?ョ뤎?뚣겒?꾥죱?믤졊?졼겏?쀣겍\r\n    // 鹽뷩걲?볝겏?ャ겒?????앫겗?긱겗?뗣겤?듿눣?멥겘訝사춮??죱?뚧똻?ㅳ?\r\n    ruleHits: [hoopLengthAdditionRule, distributionAdditionRule],\r\n    // ?낁㉢烏뚣겘筽뉑빊??윶?믤씇??굥?귡깿?먦걫?ⓦ겓?뺛걝 3D ?띸쉰??쟿?믡걪?볝겓?멥걦?ⓦ?\r\n    // ?잆겖?됥굦?잋퍟??윶?ャ겇?꾠겍雅뗥츪?㎯겒?꾣졊?졼굮烏①ㅊ?쇻굥?볝겏?ャ겒????\r\n    // ?곈뇧?믤군?곥걼?끹걽?묆굮雍됥걵?곲뀓營?겘 placement ?뚧똻?ㅳ?\r\n    formula:\r\n      `鼇?쮫?룔걬 竊???씊??Þ鼇덂?力뺛겓?덀굥?③빓 ${\r\n        circular ? `?횞${section.b}` : `2횞(${section.b}竊?{section.d})`\r\n      } ` +\r\n      `竊?${hoopLength}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴2) ???뗣겤?듽굮?㏝솮?쎼걳?뺛긿??굚鼇덁툓?쀣겒?꾬펹 竊?` +\r\n      `鼇?쮫?ф빊 竊??덆쉸遙?${story.height} 첨 ?붵긿??${section.hoop.pitch}??竊?1 ` +\r\n      `竊?${hoopCount}竊덂릪 竊덌폃竊됪윶3)???싧뎴7) ???꾦쉸?붵겏竊?竊?` +\r\n      `3D 壤®듁 竊?若잓뀓嶺뗰펷?뗣겤?듽굮?㏝솮?쀥닜?잆궕?뺛궩?껁깉?믦쫳渦쇈??잆굙?? +\r\n      `烏①ㅊ?뺛굦?뗩빓?뺛꺕?ф빊??Þ鼇덂ㅳ겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹 竊?` +\r\n      `135째?뺛긿??퐰??竊?${hook135Rule.expr} 횞 ${section.hoop.size} 竊?` +\r\n      `${hookTailLength}mm?굋oints[0] ?뗣굢??씊?끻릲?띲겗?밧릲?믢릎恙껁겓?? +\r\n      `?뚣걯鰲믣벧?㎩랩?녑?燁겹겗雅뚧뼶?묆겦?녴걨??룒??,\r\n  }\r\n\r\n  return [main, hoop]\r\n}\r\n      count,\r\n      axisOffsetsMm: positions.map(({ fromMm }) => fromMm),\r\n      axisSlotStart: first.slotStart,\r\n      splice: {\r\n        method: section.spliceMethod,\r\n        countPerBar: splice.countPerBar,\r\n        lengthMm: splice.lengthMm,\r\n        rules: splice.rules,\r\n        formula:\r\n          `泳숁뎸嶸뉑???竊?${firstRow.role}1?с걗?잆굤 ${splice.countPerBar}?뗦?` +\r\n          `竊?{splice.basis}竊?竊?` +\r\n          `?밧폀 竊?${section.spliceMethod} 竊?` +\r\n          `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm} 竊?` +\r\n          `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\r\n      },\r\n      ruleHits: uniqueRuleHits([\r\n        coverRule,\r\n        fabricationCoverAdditionRule,\r\n        ...positions.flatMap(({ rules }) => rules),\r\n        ...splice.rules,\r\n      ]),\r\n      formula:\r\n        `鼇?쮫?룔걬 竊?${basis} 竊?泳숁뎸 ${spliceLengthTerm} 竊?${length} 竊?` +\r\n        `?ф빊 竊?1?뗦??귙걼??${first.count}竊덃뼪?㏘?誤㎯겗塋?깿?삡릎鸚?겗藥???` +\r\n        `?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1)?뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑` +\r\n        `?ャ굠?뗣랃펹 횞 ${positions.length}?뗦? 竊?${count} 竊?` +\r\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬 ${fabricationCoverMm} 竊?` +\r\n        `3D 壤®듁 竊??깁씊?뗣굢?끻겢?졼걨?믤룒?륅펷若싩???릲?띲걣塋?겎?띹빪?쇻굥??겎?뤵걢?싥? +\r\n        `鼇?쮫?룔걬?ャ걽?묊츞?γ걲?뗣꺕?뤵걢?뚣굥?룔걬 ${first.drawnMm} ??빊?뤵겓??뵪?꾠겒?꾬펹`,\r\n    }\r\n  })\r\n}\r\n\r\nfunction generateStirrup(\r\n  member: Member,\r\n  span: GirderSpan,\r\n  section: GirderSection,\r\n  coverRule: RuleHit,\r\n  fabricationCoverAdditionRule: RuleHit,\r\n  fabricationCoverMm: number,\r\n  hoopLengthAdditionRule: RuleHit,\r\n  distributionAdditionRule: RuleHit,\r\n  hook135Rule: RuleHit,\r\n): Rebar {\r\n  // 誤뤸틬??媛믪씠 ?녿뒗 諛곗튂媛믪씠??????씊訝誤㏃쓽 ?낅젰??洹몃?濡??대떎 (ADR-012)\r\n  const startOffsetMm = section.stirrup.startOffsetMm\r\n  const stirrupWidthMm = section.b - 2 * fabricationCoverMm\r\n  const stirrupDepthMm = section.depth - 2 * fabricationCoverMm\r\n\r\n  if (stirrupWidthMm <= 0 || stirrupDepthMm <= 0) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?귙겙?됬춮 ?졾램野멩퀡 must be positive: ${member.id} ` +\r\n        `(${section.b}횞${section.depth} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCoverMm})`,\r\n    )\r\n  }\r\n\r\n  if (span.clear <= 2 * startOffsetMm) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `?귙겙?됬춮 ?띸쉰?븅뼋 must be positive: ${member.id} ` +\r\n        `(?끾퀡 ${span.clear} ??2횞?앮쐿?ゃ깢?삠긿??${startOffsetMm})`,\r\n    )\r\n  }\r\n\r\n  const layout = stirrupPositions(\r\n    span.clear,\r\n    section.stirrup.pitch,\r\n    startOffsetMm,\r\n  )\r\n  // ?곈뇧??찉嶸쀥읃繹?1?싧뎴2) ????씊??Þ鼇덂?力뺛겓?덀굥?③빓?곥깢?껁궚??쮫訝듽걮?ゃ걚??\r\n  // ?뗣겤?듽굮?㏝솮?쀣걼 stirrupWidthMm쨌stirrupDepthMm ??3D 壤®듁 (points) 弱귞뵪??\r\n  const stirrupLengthMm = hoopDesignLengthMm(\r\n    section.b,\r\n    section.depth,\r\n    hoopLengthAdditionRule,\r\n  )\r\n  // ??竊덌폆竊됪쥈3)竊??싧뎴7) ???꾣쥈?붵겏?ャ곥걹??깿?녴겗?룔걬첨?볣슂?귙뚦ㄷ歟곥띲겘翁?퐪??\r\n  // ?뷴늽?㎪윶?ユ렏?쇻굥?끾퀡?ⓨ늽?ゃ겗?㎯곩돯?뗣겗??냵力뺡빓?뺛귛닜?잆궕?뺛궩?껁깉??뼟訝롢걮?ゃ걚??\r\n  const stirrupCount = distributionCount(\r\n    span.clear,\r\n    section.stirrup.pitch,\r\n    distributionAdditionRule,\r\n  )\r\n  const points: Vec3[] = [\r\n    [0, fabricationCoverMm, fabricationCoverMm],\r\n    [0, section.depth - fabricationCoverMm, fabricationCoverMm],\r\n    [\r\n      0,\r\n      section.depth - fabricationCoverMm,\r\n      section.b - fabricationCoverMm,\r\n    ],\r\n    [0, fabricationCoverMm, section.b - fabricationCoverMm],\r\n  ]\r\n  const hookTailLength = hookTailLengthMm(\r\n    hook135Rule,\r\n    section.stirrup.size,\r\n  )\r\n  const hookTails = twoInwardTails(\r\n    points[0],\r\n    hookTailLength,\r\n    symmetricInwardDirections(Math.PI / 4),\r\n  )\r\n  return {\r\n    id: `${member.id}|stirrup`,\r\n    memberId: member.id,\r\n    role: '?귙겙?됬춮',\r\n    size: section.stirrup.size,\r\n    shape: 'hoop',\r\n    points,\r\n    closed: true,\r\n    hookTails,\r\n    length: stirrupLengthMm,\r\n    count: stirrupCount,\r\n    placement: {\r\n      axis: 'x',\r\n      clearMm: span.clear,\r\n      pitchMm: section.stirrup.pitch,\r\n      startOffsetMm,\r\n      lastGapMm: layout.lastGapMm,\r\n      positionCount: layout.positionsMm.length,\r\n    },\r\n    // 鼇?쮫?룔걬?삭Þ鼇덃쑍?겹굮黎뷩굙?잆겗??걪???↓쟿?졼걨?졼귙걢?뜰굤??3D 壤®듁\r\n    // (points) ?ャ걮?뗥듅?뗣겒?꾠겗?㎯곮펹?쎼굥?①츞?뷴폀?ョ뤎?뚣겒?꾥죱?믤졊?졼겏?쀣겍\r\n    // 鹽뷩걲?볝겏?ャ겒?????앫겗歟곥겗?뗣겤?듿눣?멥겘訝딁ク嶺뗣꺕訝뗧ク嶺뗣겗烏뚣걣?곥겇??\r\n    ruleHits: [hoopLengthAdditionRule, distributionAdditionRule],\r\n    // ?낁㉢烏뚣겘?뚣걯寧?뤇??쥈?믤씇??굥?귛냵力뺡빓?뺛걣?뺛겂?╉굚?꿜퍡?ф빊?뚦릪?섅겒??\r\n    // 訝烏뚣겓?ゃ굥??겎?곩냵力뺡빓?뺛겘餓ｈ〃?ㅳ걽?ⓩ뼪?뗣귡깿?먦걫?ⓦ겓?뺛걝 3D ?띸쉰??쟿??\r\n    // ?잆겖?됥굦?잋퍟??쥈?ャ겇?꾠겍雅뗥츪?㎯겒?뤵겒?뗣걼?곥곥걪?볝겓??펹?쎼겒?꾠?\r\n    formula:\r\n      `鼇?쮫?룔걬 竊???씊??Þ鼇덂?力뺛겓?덀굥?③빓 2횞(${section.b}竊?{section.depth}) ` +\r\n      `竊?${stirrupLengthMm}` +\r\n      `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴2) ???뗣겤?듽굮?㏝솮?쎼걳?뺛긿??굚鼇덁툓?쀣겒?꾬펹 竊?` +\r\n      `鼇?쮫?ф빊 竊??덂냵力뺡빓??${span.clear} 첨 ?붵긿??` +\r\n      `${section.stirrup.pitch}??竊?1 竊?${stirrupCount}` +\r\n      `竊덂릪 竊덌폆竊됪쥈3)???싧뎴7) ???꾣쥈?붵겏?곩냵力뺡빓?뺛겘餓ｈ〃?ㅿ펹 竊?` +\r\n      `3D 壤®듁 竊?若잓뀓嶺뗰펷?뗣겤?듽굮?㏝솮?쀥닜?잆궕?뺛궩?껁깉?믦쫳渦쇈??잆굙?? +\r\n      `烏①ㅊ?뺛굦?뗩빓?뺛꺕?ф빊??Þ鼇덂ㅳ겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹 竊?` +\r\n      `135째?뺛긿??퐰??竊?${hook135Rule.expr} 횞 ${section.stirrup.size} 竊?` +\r\n      `${hookTailLength}mm?굋oints[0] ?뗣굢??씊?끻릲?띲겗?밧릲?믢릎恙껁겓?? +\r\n      `?뚣걯鰲믣벧?㎩랩?녑?燁겹겗雅뚧뼶?묆겦?녴걨??룒??,\r\n  }\r\n}\r\n\r\n/**\r\n * 亮끾??곭춮 (?곈뇧令띸츞?뷸틬 1?싧뎴3)??竊덌폆竊됪쥈3))??\r\n *\r\n * 鼇?쮫?룔걬??뼪?㏂겗鼇?쮫亮끹걹??굚??곮Þ鼇덃쑍?겹겘?꾣쥈?붵겏??돯餓섅겎?귙굥?귡슔??\r\n * 1?싧뎴2)竊덀깢?쇈깤?삠궧?욍꺀?껁깤竊앭뫅?뤄펹?ⓨ룚?딃걬?덀겒?꾠굠?녴곲빓?뺛겘弱귞뵪??\r\n * `widthTieDesignLengthMm` ?믧싥걲??\r\n */\r\nfunction generateWidthTie(\r\n  member: Member,\r\n  span: GirderSpan,\r\n  section: GirderSection,\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { ColumnSection, Member } from '../model/member'\r\nimport type { ColumnEnds, Story } from '../model/project'\r\nimport type { RebarRole, RebarZone } from '../model/rebar'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { lookupRule } from '../rules/lookup'\r\nimport { jpMlitRulePack } from '../../rulepack'\r\nimport { generateColumnRebar, type ColumnRebarInput } from './column'\r\nimport { stirrupPositions } from './stirrup-layout'\r\n\r\nconst member: Member = {\r\n  id: '1F-X2Y2',\r\n  kind: '??,\r\n  memberClass: '翁?퐪',\r\n  sectionId: 'section-C1',\r\n  storyId: '1F',\r\n  position: { ix: 1, iy: 1 },\r\n}\r\n\r\nconst section: ColumnSection = {\r\n  id: 'section-C1',\r\n  kind: '??,\r\n  mark: 'C1',\r\n  shape: '?⒴숱',\r\n  b: 800,\r\n  d: 800,\r\n  fc: 24,\r\n  grade: 'SD345',\r\n  exposure: '掠뗥쨼',\r\n  finish: '餓뺜툓?믡겒??,\r\n  spliceMethod: '?띲겖泳숁뎸',\r\n  main: { size: 'D25', count: 12 },\r\n  hoop: { size: 'D13', pitch: 100, startOffsetMm: 0 },\r\n}\r\n\r\nconst story: Story = { id: '1F', name: '1??, height: 4200 }\r\n\r\nfunction input(\r\n  overrides: Partial<ColumnRebarInput> = {},\r\n): ColumnRebarInput {\r\n  return {\r\n    member,\r\n    section,\r\n    story,\r\n    beamDepthAbove: 750,\r\n    // ?℡츣??뚥툔??싥걮?삡툓??뀍塋?랃폓 訝뗣겓?긱걣?귙굥?밤궭?껁궚?訝딀???윶\r\n    // 竊??싧뎴1)竊뗰펷竊믭펹??) 鵝녷쎑?ャ굠?듿뀍塋?겘若싩??믣뒥?덀겒?꾠갧9?좑펹??\n    ends: { bottom: '?ゃ걮', top: '?덄ク' },\r\n    ...overrides,\r\n  }\r\n}\r\n\r\nconst mainDiameter = Number(section.main.size.replace(/^D/, ''))\r\nconst conditions = { fc: section.fc, grade: section.grade, hook: false }\r\nconst anchorage =\r\n  lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * mainDiameter\r\nconst lap =\r\n  lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * mainDiameter\r\nconst minimumCover = lookupRule(jpMlitRulePack, 'cover.minimum', {\r\n  memberKind: section.kind,\r\n  soilContact: false,\r\n  exposure: section.exposure,\r\n  finish: section.finish,\r\n}).value\r\nconst fabricationAddition = lookupRule(\r\n  jpMlitRulePack,\r\n  'cover.fabrication.addition',\r\n  {},\r\n).value\r\nconst fabricationCover = minimumCover + fabricationAddition\r\n\r\nfunction byRole(\r\n  generated: ReturnType<typeof generateColumnRebar>,\r\n  role: '訝사춮' | '躍?춮',\r\n) {\r\n  const rebar = generated.find((candidate) => candidate.role === role)\r\n  expect(rebar, `${role} should be generated`).toBeDefined()\r\n  return rebar!\r\n}\r\n\r\ndescribe('Rebar model', () => {\r\n  it('accepts the standard 鸚㎪쥈 row roles', () => {\r\n    const roles: RebarRole[] = ['訝딁ク嶺?, '訝뗧ク嶺?, '?귙겙?됬춮']\r\n\r\n    expect(roles).toEqual(['訝딁ク嶺?, '訝뗧ク嶺?, '?귙겙?됬춮'])\r\n  })\r\n})\r\n\r\ndescribe('generateColumnRebar', () => {\r\n  it('generates the fixed C1 input as one 訝사춮 row and one 躍?춮 row', () => {\r\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\r\n    const main = byRole(generated, '訝사춮')\r\n    const hoop = byRole(generated, '躍?춮')\r\n    const expectedHoops = stirrupPositions(\r\n      story.height - input().beamDepthAbove,\r\n      section.hoop.pitch,\r\n      0,\r\n    )\r\n\r\n    expect(generated).toHaveLength(2)\r\n    expect(main).toMatchObject({\r\n      memberId: member.id,\r\n      size: 'D25',\r\n      shape: 'straight',\r\n      closed: false,\r\n      count: 12,\r\n    })\r\n    expect(hoop).toMatchObject({\r\n      memberId: member.id,\r\n      size: 'D13',\r\n      shape: 'hoop',\r\n      closed: true,\r\n      // 鼇?쮫?ф빊??찉嶸쀥읃繹?1?싧뎴7)竊덆쉸遙?4200 첨 ?붵긿??100 竊?1竊됥?\n      // 3D ??뀓營?쑍??36 ?ⓦ겘?η돥?㎯곩풄?끹겘 placement ?뚧똻?ㅳ?\n      count: 43,\r\n      placement: {\r\n        axis: 'y',\r\n        clearMm: story.height - input().beamDepthAbove,\r\n        pitchMm: section.hoop.pitch,\r\n        startOffsetMm: 0,\r\n        lastGapMm: expectedHoops.lastGapMm,\r\n        positionCount: expectedHoops.positionsMm.length,\r\n      },\r\n    })\r\n    expect(expectedHoops.positionsMm).toHaveLength(36)\r\n  })\r\n\r\n  it('records only rows that came from the rule pack on every generated Rebar', () => {\r\n    const generated = generateColumnRebar(input(), jpMlitRulePack)\r\n\r\n    for (const rebar of generated) {\r\n      expect(rebar.ruleHits.length).toBeGreaterThan(0)\r\n      for (const hit of rebar.ruleHits) {\r\n        expect(\r\n          jpMlitRulePack.entries.includes(hit),\r\n          `${hit.key} should be a row of the rule pack`,\r\n        ).toBe(true)\r\n      }\r\n    }\r\n\r\n    // 塋?깿??젂竊덁툔塋???訝딁ク竊됥겗?귙겏?ョ텤?뗣귝뿢若싧뀯?쎼겘 訝뗧ク ?싥걮?삡툓塋??덄ク?㎯?\n    // 泳숁뎸??ク?ⓩ씉餓뜰겏?㏘퓗?ゃ걦 竊덌폃竊됪윶2) ?뚦릢?롢겓1?뗦?營?걦??\n    expect(byRole(generated, '訝사춮').ruleHits.map(({ key }) => key)).toEqual([\r\n      'cover.minimum',\r\n      'cover.fabrication.addition',\r\n      'measure.tip.length.addition',\r\n      'measure.splice.column',\r\n      'measure.splice.length.factor',\r\n      'lap.L1',\r\n    ])\r\n    // 躍?춮??Þ鼇덆빓?뺛꺕鼇?쮫?ф빊?믤군?곥굥??겘令띸츞?뷸틬??걪???↓쟿?졼걨?졼?\n    // ?뗣겤?듽겘 3D 壤®듁 (points) ?ャ걮?뗥듅?뗣겒?꾠겗?㎯곩냵鼇녘죱??졊?졼겓曆룔걶?뗣겏\r\n    // 嶸쀥눣凉뤵겓訝佯╉굚?얇굦?ゃ걚烏뚣굮?뷴끂?ⓦ걮??ㅊ?쇻걪?ⓦ겓?ゃ굥??\n    expect(byRole(generated, '躍?춮').ruleHits.map(({ key }) => key)).toEqual([\r\n      'measure.hoop.length.addition',\r\n      'measure.distribution.addition',\r\n    ])\r\n  })\r\n\r\n  it('anchors the base of the stack but adds nothing at the roof, and gives every storey one 泳숁뎸 (R7?졼꺕R9?졼꺕竊덌폃竊됪윶2))', () => {\r\n    const base = byRole(\r\n      generateColumnRebar(\r\n        input({ ends: { bottom: '若싩?', top: '?ゃ걮' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n    const roof = byRole(\r\n      generateColumnRebar(\r\n        input({ ends: { bottom: '?ゃ걮', top: '?덄ク' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n\r\n    // ?ε릦?ⓦ겓??츣??뚥퍡?뗣겒?꾠귛콏訝딉펷?덄ク竊됥겓?귛츣???퍡?뗣겒????\n    // 1?싧뎴1)竊뗰펷竊믭펹??) 鵝녷쎑?ャ굠?딀?訝딃쉸?긴말嶺뗣겘?녈꺍??꺁?쇈깉鼇?쮫野멩퀡?얇겎??\n    // 閭㏂겲?뗣귙겑?▲굢?ャ굚?꾦쉸1?뗦???텤?뗣걽?묆걣餓섅걦??\n    expect(base.zones).toHaveLength(1)\r\n    expect(roof.zones).toHaveLength(0)\r\n    expect(base.splice?.countPerBar).toBe(1)\r\n    expect(roof.splice?.countPerBar).toBe(1)\r\n    expect(base.length).toBe(story.height + anchorage + lap)\r\n    expect(roof.length).toBe(story.height + lap)\r\n  })\r\n\r\n  it('anchors only the base ??not the roof ??when the column stands alone in its stack (R9??', () => {\r\n    const main = byRole(\r\n      generateColumnRebar(\r\n        input({ ends: { bottom: '若싩?', top: '?덄ク' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n\r\n    expect(main.length).toBe(story.height + anchorage + lap)\r\n  })\r\n\r\n  it('extends the 3D geometry by exactly what each end contributes', () => {\r\n    const main = byRole(\r\n      generateColumnRebar(\r\n        input({ ends: { bottom: '若싩?', top: '?ゃ걮' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n\r\n    // 泳숁뎸??퐤營?걣黎뷩겲?됥겒?꾠겗?㎪룒?뗣겒????鼇?쮫?룔걬?ャ걽?묈뀯?뗣?\n    expect(main.points[0][1]).toBe(-anchorage)\r\n    expect(main.points[1][1]).toBe(story.height)\r\n    expect(main.length - (main.points[1][1] - main.points[0][1])).toBe(lap)\r\n  })\r\n\r\n  it.each(\r\n    [\r\n      { ends: { bottom: '若싩?', top: '?ゃ걮' }, bottomAnchored: true },\r\n      { ends: { bottom: '若싩?', top: '?덄ク' }, bottomAnchored: true },\r\n      { ends: { bottom: '?ゃ걮', top: '?ゃ걮' }, bottomAnchored: false },\r\n      { ends: { bottom: '?ゃ걮', top: '?덄ク' }, bottomAnchored: false },\r\n    ] satisfies {\r\n      ends: ColumnEnds\r\n      bottomAnchored: boolean\r\n    }[],\r\n  )(\r\n    // 訝딁ク???ゃ걮?삣뀍塋?걚?싥굦?귛츣??쀣겒??R9?? ???얇꺖?녈겘訝뗧ク??츣??졼걨?뚧군?곥굥??\n    'emits a path-distance zone only for a 若싩? bottom, never for the top ($ends.bottom/$ends.top)',\r\n    ({ ends, bottomAnchored }) => {\r\n      const main = byRole(\r\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\r\n        '訝사춮',\r\n      )\r\n      const anchorageKey = lookupRule(\r\n        jpMlitRulePack,\r\n        'anchorage.L1',\r\n        conditions,\r\n      ).key\r\n      const expected: RebarZone[] = []\r\n\r\n      if (bottomAnchored) {\r\n        expected.push({\r\n          kind: '若싩?',\r\n          ruleKey: anchorageKey,\r\n          pathFromMm: 0,\r\n          pathToMm: anchorage,\r\n        })\r\n      }\r\n\r\n      expect(main.zones).toEqual(expected)\r\n    },\r\n  )\r\n\r\n  it('keeps every zone within the drawn 訝사춮 path, not the 鼇?쮫?룔걬', () => {\r\n    const endCombinations: ColumnEnds[] = [\r\n      { bottom: '若싩?', top: '?덄ク' },\r\n      { bottom: '若싩?', top: '?ゃ걮' },\r\n      { bottom: '?ゃ걮', top: '?덄ク' },\r\n      { bottom: '?ゃ걮', top: '?ゃ걮' },\r\n    ]\r\n\r\n    for (const ends of endCombinations) {\r\n      const main = byRole(\r\n        generateColumnRebar(input({ ends }), jpMlitRulePack),\r\n        '訝사춮',\r\n      )\r\n      const drawnLength = main.points[1][1] - main.points[0][1]\r\n\r\n      expect(main.zones).toBeDefined()\r\n      for (const zone of main.zones ?? []) {\r\n        expect(zone.pathFromMm).toBeGreaterThanOrEqual(0)\r\n        expect(zone.pathFromMm).toBeLessThan(zone.pathToMm)\r\n        expect(zone.pathToMm).toBeLessThanOrEqual(drawnLength)\r\n      }\r\n    }\r\n  })\r\n\r\n  it('does not emit a zone for an end whose condition is ?ゃ걮', () => {\r\n    const main = byRole(\r\n      generateColumnRebar(\r\n        input({ ends: { bottom: '若싩?', top: '?ゃ걮' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n\r\n    expect(main.zones).toEqual([\r\n      {\r\n        kind: '若싩?',\r\n        ruleKey: lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).key,\r\n        pathFromMm: 0,\r\n        pathToMm: anchorage,\r\n      },\r\n    ])\r\n  })\r\n\r\n  it('cites ?띲겖泳숁뎸?룔걬 only when the 泳숁뎸?밧폀 puts it into the 鼇?쮫?룔걬', () => {\r\n    const lapped = byRole(\r\n      generateColumnRebar(input(), jpMlitRulePack),\r\n      '訝사춮',\r\n    )\r\n    const pressureWelded = byRole(\r\n      generateColumnRebar(\r\n        input({ section: { ...section, spliceMethod: '?с궧?㎪렏' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n\r\n    // ?с궧?㎪렏??1?싧뎴5)?뚪빓?뺛겗鸚됧뙑??겒?꾠굚??겏?쇻굥?띯?嶸뉑??겹겘餘뗣굥?뚩나?뤵겘鸚됥굩?됥겒?꾠?\n    expect(lapped.ruleHits.map(({ key }) => key)).toContain('lap.L1')\r\n    expect(pressureWelded.ruleHits.map(({ key }) => key)).not.toContain('lap.L1')\r\n    expect(pressureWelded.splice?.countPerBar).toBe(1)\r\n    expect(pressureWelded.splice?.lengthMm).toBe(0)\r\n    expect(lapped.length - pressureWelded.length).toBe(lap)\r\n  })\r\n\r\n  it('cites 若싩? only on the rows that actually reach a stack end', () => {\r\n    const interior = byRole(\r\n      generateColumnRebar(\r\n        input({ ends: { bottom: '?ゃ걮', top: '?ゃ걮' } }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝사춮',\r\n    )\r\n\r\n    expect(interior.ruleHits.map(({ key }) => key)).not.toContain(\r\n      'anchorage.L1',\r\n    )\r\n    expect(interior.formula).not.toContain('若싩?')\r\n    expect(interior.length).toBe(story.height + lap)\r\n  })\r\n\r\n  it('uses the supplied 訝사춮 count without structurally recalculating it', () => {\r\n    const changedSection: ColumnSection = {\r\n      ...section,\r\n      main: { ...section.main, count: 16 },\r\n    }\r\n\r\n    const main = byRole(\r\n      generateColumnRebar(input({ section: changedSection }), jpMlitRulePack),\r\n      '訝사춮',\r\n    )\r\n\r\n    expect(main.count).toBe(changedSection.main.count)\r\n  })\r\n\r\n  it('fails fast when the section cannot contain the 躍?춮 fabrication cover', () => {\r\n    // ?졾램?ⓦ걢?뜰굤횞2 ?댄븯???⑤㈃? ?뚯닔 ?졾램?룹쓣 留뚮뱾怨?留덉씠?덉뒪 kg濡?\n    // 議곗슜??吏묎퀎?쒕떎 ??throw濡?留됰뒗??(ADR-014).\r\n    const tiny: ColumnSection = { ...section, b: 100, d: 100 }\r\n\r\n    expect(() =>\r\n      generateColumnRebar(input({ section: tiny }), jpMlitRulePack),\r\n    ).toThrow(/positive/)\r\n  })\r\n\r\n  it('fails fast when the 訝딃깿鸚㎪쥈 depth consumes the whole storey height', () => {\r\n    expect(() =>\r\n      generateColumnRebar(\r\n        input({ beamDepthAbove: story.height }),\r\n        jpMlitRulePack,\r\n      ),\r\n    ).toThrow(/positive/)\r\n  })\r\n\r\n  it('uses the supplied beamDepthAbove instead of a global constant', () => {\r\n    const baseHoop = byRole(\r\n      generateColumnRebar(input(), jpMlitRulePack),\r\n      '躍?춮',\r\n    )\r\n    const changedHoop = byRole(\r\n      generateColumnRebar(input({ beamDepthAbove: 800 }), jpMlitRulePack),\r\n      '躍?춮',\r\n    )\r\n\r\n    // 訝딃깿鸚㎪쥈?쎼걚?뚦듅?뤵겗??3D ??뀓營?뙷?볝걽?묆걽?귝빊?뤸쑍?겹겘令띸츞?뷸틬 1?싧뎴7)\r\n    // ?ャ굠?딃쉸遙섅겎黎뷩겲?뗣겗?㎩땿?뗣겒?????뺛걚?잆굢?곈뇧?뚦숱?뜰겓凉뺛걤?싥굢?뚣겍?꾠굥??\n    expect(changedHoop.placement?.clearMm).toBe(\r\n      (baseHoop.placement?.clearMm ?? 0) - 50,\r\n    )\r\n    expect(changedHoop.placement?.positionCount).toBe(\r\n      (baseHoop.placement?.positionCount ?? 0) - 1,\r\n    )\r\n    expect(changedHoop.count).toBe(baseHoop.count)\r\n  })\r\n\r\n  it('keeps mm geometry and reproducible calculations on each row', () => {\r\n    // 若싩??룔걬??뻼鼇?믤쩂鼇쇈걲?뗥퓚誤곥걣?귙굥??겎?곫뿢若??덄ク)?㎯겘?ゃ걦訝뗧ク若싩??㏛퐳?뗣?\n    const generated = generateColumnRebar(\r\n      input({ ends: { bottom: '若싩?', top: '?ゃ걮' } }),\r\n      jpMlitRulePack,\r\n    )\r\n    const main = byRole(generated, '訝사춮')\r\n    const hoop = byRole(generated, '躍?춮')\r\n    const anchorage = lookupRule(jpMlitRulePack, 'anchorage.L1', {\r\n      fc: section.fc,\r\n      grade: section.grade,\r\n      hook: false,\r\n    })\r\n    const lap = lookupRule(jpMlitRulePack, 'lap.L1', {\r\n      fc: section.fc,\r\n      grade: section.grade,\r\n      hook: false,\r\n    })\r\n    const mainDiameter = Number(section.main.size.replace(/^D/, ''))\r\n    // 令띸츞?뷸틬 1?싧뎴2) ????씊??Þ鼇덂?力뺛겓?덀굥?③빓?귙걢?뜰굤?㏝솮?귙깢?껁궚?귙겒?꾠?\n    const expectedHoopLength = 2 * (section.b + section.d)\r\n\r\n    expect(main.points).toHaveLength(2)\r\n    expect(hoop.points).toHaveLength(4)\r\n    expect(main.points[0][0]).toBe(fabricationCover)\r\n    expect(main.points[0][2]).toBe(fabricationCover)\r\n    expect(hoop.points[0]).toEqual([fabricationCover, 0, fabricationCover])\r\n    expect(hoop.length).toBe(expectedHoopLength)\r\n    expect(main.formula).toContain(\r\n      `若싩??룔걬 L1 ${anchorage.value}d(${anchorage.value * mainDiameter})`,\r\n    )\r\n    expect(main.formula).toContain(\r\n      `?띲겖泳숁뎸?룔걬 L1 ${lap.value}d(${lap.value * mainDiameter})`,\r\n    )\r\n    const fabricationCoverFormula =\r\n      `?졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${minimumCover} 竊?` +\r\n      `?좂츞 ${fabricationAddition} 竊?${fabricationCover}竊?\r\n    expect(main.formula).toContain(fabricationCoverFormula)\r\n    expect(main.formula).not.toContain('?뉏툓??)\r\n    // 烏①ㅊ?뺛굦?뗩쟿?졼걨?㎪빊?뤵굮?띸뤎?㎯걤?ゃ걨?뚣겙嶸쀥눣?방떊??が?롢겓?ゃ굢?ゃ걚??\n    expect(hoop.formula).toContain(\r\n      `鼇?쮫?룔걬 竊???씊??Þ鼇덂?力뺛겓?덀굥?③빓 2횞(${section.b}竊?{section.d}) ` +\r\n        `竊?${expectedHoopLength}`,\r\n    )\r\n    expect(hoop.formula).toContain(\r\n      '鼇?쮫?ф빊 竊??덆쉸遙?4200 첨 ?붵긿??100??竊?1 竊?43',\r\n    )\r\n    // ?낁㉢烏뚣겘訝딃깿鸚㎪쥈?쎼걚??걬?녷윶?믤씇??굥?귡깿?먦걫?ⓦ겓?뺛걝 3D ?띸쉰??쟿??\n    // ?곈뇧??츞?뷴폀?ヨ펹?쎼굥?ⓦ곫씇??굢?뚣걼餓뽧겗?긱겓?ㅳ걚??삓?ャ겒?뗣?\n    expect(hoop.formula).not.toContain('?띸쉰?븅뼋')\r\n    expect(hoop.formula).not.toContain('訝딃깿鸚㎪쥈?쎼걚')\r\n    expect(hoop.formula).not.toContain(fabricationCoverFormula)\r\n  })\r\n\r\n  it.each([\r\n    {\r\n      label: '?앮쐿?ゃ깢?삠긿??,\r\n      section: {\r\n        ...section,\r\n        hoop: { ...section.hoop, startOffsetMm: 5000 },\r\n      },\r\n      beamDepthAbove: input().beamDepthAbove,\r\n    },\r\n    {\r\n      label: '訝딃깿鸚㎪쥈?쎼걚',\r\n      section,\r\n      beamDepthAbove: 4200,\r\n    },\r\n    {\r\n      label: '??씊野멩퀡',\r\n      section: { ...section, b: 50, d: 50 },\r\n      beamDepthAbove: input().beamDepthAbove,\r\n    },\r\n  ])(\r\n    'reports a non-viable 躍?춮 ?띸쉰?븅뼋 from $label as a member-level failure',\r\n    ({ section: columnSection, beamDepthAbove }) => {\r\n      // ??????씊訝誤??낅젰?쇰줈 ?꾨떖 媛?ν븳 ?뺤긽 遺덉꽦由쎌씠????遺???섎굹瑜?\n      // 誘몄??먯쑝濡?鍮쇱빞 ?섍퀬, ?섏씤??二쎌씠??寃고븿?쇰줈 ?ㅻ（硫????쒕떎.\r\n      expect(() =>\r\n        generateColumnRebar(\r\n          { ...input(), section: columnSection, beamDepthAbove },\r\n          jpMlitRulePack,\r\n        ),\r\n      ).toThrow(MemberUnsupportedError)\r\n    },\r\n  )\r\n})\r\n\r\ndescribe('遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗躍?춮', () => {\r\n  // 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겘訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚鸚㎬눂沃띶츣?곥걽?귙걹?뚣겎?귝돮?덀굥??겘\r\n  // 1?싧뎴2) ?뚣깢?쇈깤??빓?뺛굮??씊?③빓?ⓨ츣?곥곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚦릭嶺뗣겓\r\n  // 訝?ㅳ굚?ゃ걚?뗣굢?㎯걗?뗣귙걪???ㅳ겗?녴궧?덀걣?앫겗?띷룓?믣쎓若싥걲?????띷룓?뚦누?뚣걼\r\n  // ?ч뼋?ャ뚩쫸繹뽧겓?ゃ걚?ㅳ굮凉뺛걦?띲걪?ⓦ겓?ゃ굥 (ADR-026)??\n  const highStrength: ColumnSection = {\r\n    ...section,\r\n    hoop: { ...section.hoop, size: 'K13' },\r\n  }\r\n\r\n  it('??D13 ?ⓨ릪?섋Þ鼇덆빓?뺛꺕?ф빊?ャ겒??????씊?③빓??푶?믦쫳?ゃ걚', () => {\r\n    const plain = byRole(generateColumnRebar(input(), jpMlitRulePack), '躍?춮')\r\n    const generated = byRole(\r\n      generateColumnRebar(input({ section: highStrength }), jpMlitRulePack),\r\n      '躍?춮',\r\n    )\r\n\r\n    expect(generated.size).toBe('K13')\r\n    expect(generated.length).toBe(plain.length)\r\n    expect(generated.count).toBe(plain.count)\r\n    expect(generated.points).toEqual(plain.points)\r\n  })\r\n\r\n  it('??푶?㎩폊?뤵꺂?쇈꺂?믢??ㅳ굚鵝욍굩?ゃ걚', () => {\r\n    const generated = byRole(\r\n      generateColumnRebar(input({ section: highStrength }), jpMlitRulePack),\r\n      '躍?춮',\r\n    )\r\n\r\n    expect(generated.ruleHits.length).toBeGreaterThan(0)\r\n    for (const hit of generated.ruleHits) {\r\n      expect(hit.unit, `${hit.key} ??푶?띸럤?㎩듅?꾠겍?꾠굥`).not.toBe('d')\r\n      expect(\r\n        Object.keys(hit.conditions ?? {}),\r\n        `${hit.key} ??푶?㎩졃?덂늽?묆걮?╉걚??,\r\n      ).not.toContain('size')\r\n    }\r\n  })\r\n})\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { ColumnSection, GirderSection, Member } from '../model/member'\r\nimport type { GirderRun, GirderSpan } from '../model/project'\r\nimport type { Rebar } from '../model/rebar'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { coverConditions, lookupRule } from '../rules/lookup'\r\nimport { jpMlitRulePack } from '../../rulepack'\r\nimport { resolveGirderEnd } from './girder-ends'\r\nimport {\r\n  generateGirderRebar,\r\n  type GirderRebarInput,\r\n} from './girder'\r\nimport { stirrupPositions } from './stirrup-layout'\r\n\r\nconst member: Member = {\r\n  id: '1F-G1-X1Y1-X',\r\n  kind: '鸚㎪쥈',\r\n  memberClass: '翁?퐪',\r\n  sectionId: 'section-G1',\r\n  storyId: '1F',\r\n  position: { axis: 'X', ix: 0, iy: 0 },\r\n}\r\n\r\nconst section: GirderSection = {\r\n  id: 'section-G1',\r\n  kind: '鸚㎪쥈',\r\n  mark: 'G1',\r\n  b: 400,\r\n  depth: 750,\r\n  fc: 24,\r\n  grade: 'SD345',\r\n  exposure: '掠뗥쨼',\r\n  finish: '餓뺜툓?믡겒??,\r\n  spliceMethod: '?띲겖泳숁뎸',\r\n  main: {\r\n    size: 'D25',\r\n    top: { endCount: 4, centerCount: 4 },\r\n    bottom: { endCount: 4, centerCount: 4 },\r\n    cutoffFromSupportFaceMm: 0,\r\n  },\r\n  stirrup: { size: 'D13', pitch: 100, startOffsetMm: 50 },\r\n}\r\n\r\nconst supportColumnSection: ColumnSection = {\r\n  id: 'section-C1',\r\n  kind: '??,\r\n  mark: 'C1',\r\n  shape: '?⒴숱',\r\n  b: 800,\r\n  d: 800,\r\n  fc: 24,\r\n  grade: 'SD345',\r\n  exposure: '掠뗥쨼',\r\n  finish: '餓뺜툓?믡겒??,\r\n  spliceMethod: '?띲겖泳숁뎸',\r\n  main: { size: 'D25', count: 12 },\r\n  hoop: { size: 'D13', pitch: 100, startOffsetMm: 0 },\r\n}\r\n\r\nconst supportCover = coverConditions(supportColumnSection)\r\n\r\nconst span: GirderSpan = {\r\n  axis: 'X',\r\n  centerSpan: 6000,\r\n  clear: 5200,\r\n  startFaceOffsetMm: 400,\r\n  endFaceOffsetMm: 400,\r\n  startSupportLengthAlongAxisMm: 800,\r\n  endSupportLengthAlongAxisMm: 800,\r\n  startSupportCover: supportCover,\r\n  endSupportCover: supportCover,\r\n}\r\n\r\nconst run: GirderRun = {\r\n  axis: 'X',\r\n  members: [member],\r\n  ownerId: member.id,\r\n  spans: [span],\r\n  memberOffsetsMm: [0],\r\n  coreLengthMm: span.clear,\r\n}\r\n\r\nfunction input(\r\n  overrides: Partial<GirderRebarInput> = {},\r\n): GirderRebarInput {\r\n  return { run, section, ...overrides }\r\n}\r\n\r\nfunction runWithSpan(nextSpan: GirderSpan): GirderRun {\r\n  return { ...run, spans: [nextSpan], coreLengthMm: nextSpan.clear }\r\n}\r\n\r\nfunction byRole(\r\n  generated: ReturnType<typeof generateGirderRebar>,\r\n  role: '訝딁ク嶺? | '訝뗧ク嶺? | '?귙겙?됬춮' | '亮끾??곭춮' | '?밭춮',\r\n) {\r\n  const rebar = generated.find((candidate) => candidate.role === role)\r\n  expect(rebar, `${role} should be generated`).toBeDefined()\r\n  return rebar!\r\n}\r\n\r\nfunction polylineLength(points: Rebar['points'], closed: boolean): number {\r\n  const pairs = points.slice(1).map((point, index) => [points[index], point])\r\n  if (closed) pairs.push([points.at(-1)!, points[0]])\r\n\r\n  return pairs.reduce((total, [from, to]) => {\r\n    const [dx, dy, dz] = to.map((value, index) => value - from[index])\r\n    return total + Math.hypot(dx, dy, dz)\r\n  }, 0)\r\n}\r\n\r\nconst coverRule = lookupRule(\r\n  jpMlitRulePack,\r\n  'cover.minimum',\r\n  coverConditions(section),\r\n)\r\nconst fabricationAdditionRule = lookupRule(\r\n  jpMlitRulePack,\r\n  'cover.fabrication.addition',\r\n  {},\r\n)\r\nconst fabricationCover = coverRule.value + fabricationAdditionRule.value\r\n\r\ndescribe('generateGirderRebar', () => {\r\n  it('generates [訝딁ク嶺? 訝뗧ク嶺? ?귙겙?됬춮] as representative rows', () => {\r\n    const expectedStirrups = stirrupPositions(\r\n      span.clear,\r\n      section.stirrup.pitch,\r\n      section.stirrup.startOffsetMm,\r\n    )\r\n    const generated = generateGirderRebar(input(), jpMlitRulePack)\r\n\r\n    expect(generated.map(({ role }) => role)).toEqual([\r\n      '訝딁ク嶺?,\r\n      '訝뗧ク嶺?,\r\n      '?귙겙?됬춮',\r\n    ])\r\n    expect(byRole(generated, '訝딁ク嶺?)).toMatchObject({\r\n      shape: 'hook90',\r\n      closed: false,\r\n      count: 4,\r\n    })\r\n    expect(byRole(generated, '訝뗧ク嶺?)).toMatchObject({\r\n      shape: 'hook90',\r\n      closed: false,\r\n      count: 4,\r\n    })\r\n    expect(byRole(generated, '?귙겙?됬춮')).toMatchObject({\r\n      shape: 'hoop',\r\n      closed: true,\r\n      // 鼇?쮫?ф빊??찉嶸쀥읃繹?1?싧뎴7)竊덂냵力?5200 첨 ?붵긿??100 竊?1竊됥?\n      // 3D ??뀓營?쑍??52 ?ⓦ겘?η돥?㎯곩풄?끹겘 placement ?뚧똻?ㅳ?\n      count: 53,\r\n      placement: {\r\n        axis: 'x',\r\n        clearMm: span.clear,\r\n        pitchMm: section.stirrup.pitch,\r\n        startOffsetMm: section.stirrup.startOffsetMm,\r\n        lastGapMm: expectedStirrups.lastGapMm,\r\n        positionCount: expectedStirrups.positionsMm.length,\r\n      },\r\n    })\r\n  })\r\n\r\n  it('adds both ?섉쎊?믣츣? lengths to the sample G1 訝딁ク嶺?without rounding', () => {\r\n    const endInput = {\r\n      barSize: section.main.size,\r\n      supportCover,\r\n      fc: section.fc,\r\n      grade: section.grade,\r\n      bendDirection: '訝? as const,\r\n    }\r\n    const start = resolveGirderEnd(\r\n      {\r\n        ...endInput,\r\n        supportLengthMm: span.startSupportLengthAlongAxisMm,\r\n      },\r\n      jpMlitRulePack,\r\n    )\r\n    const end = resolveGirderEnd(\r\n      {\r\n        ...endInput,\r\n        supportLengthMm: span.endSupportLengthAlongAxisMm,\r\n      },\r\n      jpMlitRulePack,\r\n    )\r\n    const top = byRole(generateGirderRebar(input(), jpMlitRulePack), '訝딁ク嶺?)\r\n\r\n    expect(start.kind).toBe('?섉쎊?믣츣?')\r\n    expect(end.kind).toBe('?섉쎊?믣츣?')\r\n    // 鼇?쮫?룔걬?ャ겘泳숁뎸?뚦뀯?듽?D ??뒥藥ι빓?ャ겘?γ굢?ゃ걚 (ADR-019)?귚륫塋?겗?섉쎊??\n    // 若싩??뚦뒥嶸쀣걬?뚣걼?볝겏?믦쫳?잆걚??겎?곭텤?뗥늽?믣쨼?쀣겍囹곥걤?덀굩?쎼굥??\n    const drawnLengthMm = span.clear + start.lengthMm + end.lengthMm\r\n    expect(top.length - (top.splice?.lengthMm ?? 0)).toBe(drawnLengthMm)\r\n    expect(polylineLength(top.points, top.closed)).toBe(drawnLengthMm)\r\n    expect(top.formula).not.toContain('?뉏툓??)\r\n  })\r\n\r\n  it('uses ?당퇉若싩? at both ends when virtual supports are large enough', () => {\r\n    const largeSupportSpan: GirderSpan = {\r\n      ...span,\r\n      centerSpan: 6600,\r\n      startFaceOffsetMm: 700,\r\n      endFaceOffsetMm: 700,\r\n      startSupportLengthAlongAxisMm: 1400,\r\n      endSupportLengthAlongAxisMm: 1400,\r\n    }\r\n    const endInput = {\r\n      supportLengthMm: 1400,\r\n      supportCover,\r\n      barSize: section.main.size,\r\n      fc: section.fc,\r\n      grade: section.grade,\r\n      bendDirection: '訝? as const,\r\n    }\r\n    const detail = resolveGirderEnd(endInput, jpMlitRulePack)\r\n    const top = byRole(\r\n      generateGirderRebar(\r\n        input({ run: runWithSpan(largeSupportSpan) }),\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝딁ク嶺?,\r\n    )\r\n\r\n    expect(detail.kind).toBe('?당퇉若싩?')\r\n    expect(top.shape).toBe('straight')\r\n    expect(top.length).toBe(\r\n      largeSupportSpan.clear +\r\n        2 * detail.lengthMm +\r\n        (top.splice?.lengthMm ?? 0),\r\n    )\r\n    expect(top.points).toEqual([\r\n      [-detail.lengthMm, section.depth - fabricationCover, fabricationCover],\r\n      [\r\n        largeSupportSpan.clear + detail.lengthMm,\r\n        section.depth - fabricationCover,\r\n        fabricationCover,\r\n      ],\r\n    ])\r\n  })\r\n\r\n  it('records two path-distance 若싩? zones within each 訝사춮 ?졾램??, () => {\r\n    const generated = generateGirderRebar(input(), jpMlitRulePack)\r\n\r\n    for (const role of ['訝딁ク嶺?, '訝뗧ク嶺?] as const) {\r\n      const main = byRole(generated, role)\r\n\r\n      const bendDirection: '訝? | '訝? = role === '訝딁ク嶺? ? '訝? : '訝?\r\n      const endInput = {\r\n        barSize: section.main.size,\r\n        supportCover,\r\n        fc: section.fc,\r\n        grade: section.grade,\r\n        bendDirection,\r\n      }\r\n      const start = resolveGirderEnd(\r\n        {\r\n          ...endInput,\r\n          supportLengthMm: span.startSupportLengthAlongAxisMm,\r\n        },\r\n        jpMlitRulePack,\r\n      )\r\n      const end = resolveGirderEnd(\r\n        {\r\n          ...endInput,\r\n          supportLengthMm: span.endSupportLengthAlongAxisMm,\r\n        },\r\n        jpMlitRulePack,\r\n      )\r\n\r\n      const drawnLengthMm = main.length - (main.splice?.lengthMm ?? 0)\r\n\r\n      expect(main.zones).toEqual([\r\n        {\r\n          kind: '若싩?',\r\n          ruleKey: start.lengthRule,\r\n          pathFromMm: 0,\r\n          pathToMm: start.lengthMm,\r\n        },\r\n        {\r\n          kind: '若싩?',\r\n          // zone ??3D ??뒥藥ι빓??벨與숂내?ャ걗????泳숁뎸??퐤營?걣黎뷩겲?됥걳?뤵걢?뚣겒??\n          // ??겎?곮Þ鼇덆빓??main.length)?㎯겘?ゃ걦泳숁뎸?믧솮?꾠걼?룔걬?㎪릍??(ADR-019)??\n          ruleKey: end.lengthRule,\r\n          pathFromMm: drawnLengthMm - end.lengthMm,\r\n          pathToMm: drawnLengthMm,\r\n        },\r\n      ])\r\n\r\n      for (const zone of main.zones ?? []) {\r\n        expect(zone.pathFromMm).toBeGreaterThanOrEqual(0)\r\n        expect(zone.pathFromMm).toBeLessThan(zone.pathToMm)\r\n        expect(zone.pathToMm).toBeLessThanOrEqual(main.length)\r\n      }\r\n    }\r\n  })\r\n\r\n  it('generates one continuous pair of 訝사춮 and one ?귙겙?됬춮 row per span', () => {\r\n    const secondMember: Member = {\r\n      ...member,\r\n      id: '1F-G1-X2Y1-X',\r\n      position: { axis: 'X', ix: 1, iy: 0 },\r\n    }\r\n    const secondSpan: GirderSpan = { ...span }\r\n    const continuousRun: GirderRun = {\r\n      axis: 'X',\r\n      members: [member, secondMember],\r\n      ownerId: member.id,\r\n      spans: [span, secondSpan],\r\n      memberOffsetsMm: [0, span.clear + span.endSupportLengthAlongAxisMm],\r\n      coreLengthMm: span.clear + span.endSupportLengthAlongAxisMm + secondSpan.clear,\r\n    }\r\n    const generated = generateGirderRebar(\r\n      input({ run: continuousRun }),\r\n      jpMlitRulePack,\r\n    )\r\n    const top = byRole(generated, '訝딁ク嶺?)\r\n    const endInput = {\r\n      barSize: section.main.size,\r\n      supportCover,\r\n      fc: section.fc,\r\n      grade: section.grade,\r\n      bendDirection: '訝? as const,\r\n    }\r\n    const start = resolveGirderEnd(\r\n      {\r\n        ...endInput,\r\n        supportLengthMm: span.startSupportLengthAlongAxisMm,\r\n      },\r\n      jpMlitRulePack,\r\n    )\r\n    const end = resolveGirderEnd(\r\n      {\r\n        ...endInput,\r\n        supportLengthMm: secondSpan.endSupportLengthAlongAxisMm,\r\n      },\r\n      jpMlitRulePack,\r\n    )\r\n    const stirrups = generated.filter(({ role }) => role === '?귙겙?됬춮')\r\n\r\n    // ?뤵걢?뚣굥?졾램?룔귟Þ鼇덆빓?뺛겘?볝걪?ョ텤?뗧츋??겼늽?뚥퉿??(竊덌폆竊됪쥈2))??\n    const drawnLength =\r\n      continuousRun.coreLengthMm + start.lengthMm + end.lengthMm\r\n\r\n    expect(top.memberId).toBe(continuousRun.ownerId)\r\n    expect(top.length).toBe(drawnLength + (top.splice?.lengthMm ?? 0))\r\n    expect(top.zones).toEqual([\r\n      {\r\n        kind: '若싩?',\r\n        ruleKey: start.lengthRule,\r\n        pathFromMm: 0,\r\n        pathToMm: start.lengthMm,\r\n      },\r\n      {\r\n        kind: '若싩?',\r\n        ruleKey: end.lengthRule,\r\n        pathFromMm: drawnLength - end.lengthMm,\r\n        pathToMm: drawnLength,\r\n      },\r\n    ])\r\n    expect(top.formula).toContain(\r\n      `?끾퀡?룔걬 ${span.clear}竊?{secondSpan.clear} 竊?訝?뼋?긱걵??${span.endSupportLengthAlongAxisMm}`,\r\n    )\r\n    // ?ｇ텥?쇻굥?⒲꺍?ゃ겗??竊덌폆竊됪쥈2) ??뙷?녻〃?㎪빊?덀굥 ??1?싧뎴4) ??빓?뺝돯?듽겎??겒?꾠?\n    expect(top.splice?.rules.map(({ key }) => key)).toContain(\r\n      'measure.splice.girder.continuous',\r\n    )\r\n    expect(top.formula).toContain('泳숁뎸')\r\n    expect(stirrups.map(({ memberId }) => memberId)).toEqual([\r\n      member.id,\r\n      secondMember.id,\r\n    ])\r\n  })\r\n\r\n  it('changes the ?싥걮嶺?鼇?쮫?룔걬 with the 泳숁뎸?밧폀 but never the drawn shape', () => {\r\n    const secondMember: Member = {\r\n      ...member,\r\n      id: '1F-G1-X2Y1-X',\r\n      position: { axis: 'X', ix: 1, iy: 0 },\r\n    }\r\n    const twoSpans = input({\r\n      run: {\r\n        axis: 'X',\r\n        members: [member, secondMember],\r\n        ownerId: member.id,\r\n        spans: [span, { ...span }],\r\n        memberOffsetsMm: [0, span.clear + span.endSupportLengthAlongAxisMm],\r\n        coreLengthMm:\r\n          span.clear * 2 + span.endSupportLengthAlongAxisMm,\r\n      },\r\n    })\r\n    const lapped = byRole(\r\n      generateGirderRebar(twoSpans, jpMlitRulePack),\r\n      '訝딁ク嶺?,\r\n    )\r\n    const welded = byRole(\r\n      generateGirderRebar(\r\n        {\r\n          ...twoSpans,\r\n          section: { ...section, spliceMethod: '?с궧?㎪렏' },\r\n        },\r\n        jpMlitRulePack,\r\n      ),\r\n      '訝딁ク嶺?,\r\n    )\r\n\r\n    expect(lapped.splice?.countPerBar).toBe(welded.splice?.countPerBar)\r\n    expect(welded.splice?.lengthMm).toBe(0)\r\n    expect(lapped.length - welded.length).toBe(lapped.splice?.lengthMm)\r\n    // 泳숁뎸鵝띸쉰??졊?졼걣?ゃ걚竊덅〃5.3.3 ??뵽?륅펹??겎壤®듁?ャ겘?뷩겒?꾠?\n    expect(lapped.points).toEqual(welded.points)\r\n    expect(lapped.zones).toEqual(welded.zones)\r\n  })\r\n\r\n  it('bounds the ?귙겙?됬춮 placement array inside the span', () => {\r\n    const positions = stirrupPositions(\r\n      span.clear,\r\n      section.stirrup.pitch,\r\n      section.stirrup.startOffsetMm,\r\n    ).positionsMm\r\n    const stirrup = byRole(\r\n      generateGirderRebar(input(), jpMlitRulePack),\r\n      '?귙겙?됬춮',\r\n    )\r\n\r\n    // 3D ??뀓營?쑍?겹겘 placement ?뚧똻?ㅳ귝빊?뤸쑍??count ??찉嶸쀥읃繹?1?싧뎴7) ??\n    // ?γ겓黎뷩겲?뗣겗?㎯곥걪?볝겎訝↑끹굮?뚥?誤뽧걮?╉겘?ゃ굢?ゃ걚??\n    expect(stirrup.placement?.positionCount).toBe(positions.length)\r\n    expect(positions.every((position) => position >= 0)).toBe(true)\r\n    expect(positions.every((position) => position <= span.clear)).toBe(true)\r\n  })\r\n\r\n  it('keeps both 訝사춮 counts exactly as supplied by the section list (ADR-012)', () => {\r\n    const changedSection: GirderSection = {\r\n      ...section,\r\n      main: {\r\n        ...section.main,\r\n        top: { endCount: 7, centerCount: 7 },\r\n        bottom: { endCount: 9, centerCount: 9 },\r\n      },\r\n    }\r\n    const generated = generateGirderRebar(\r\n      input({ section: changedSection }),\r\n      jpMlitRulePack,\r\n    )\r\n\r\n    expect(byRole(generated, '訝딁ク嶺?).count).toBe(7)\r\n    expect(byRole(generated, '訝뗧ク嶺?).count).toBe(9)\r\n  })\r\n\r\n  it('explains a 0?뗦? splice by the count, not by the method', () => {\r\n    // ?룔걬?뚦쥥?덀겒?꾠겗??뼶凉뤵겗?쎼걚?㎯겘?ゃ걚??겓?뚪뇥??텤?뗣겘?룔걬??쨯?뽧겒?쀣띲겏\r\n    // ?멥걦?ⓦ곩릪?섋죱?뚦눣?멥겓?쇻걩??measure.splice.length.factor{?띲겖泳숁뎸}=1\r\n    // 竊덄츞?γ걲?뗰펹?③짘?꾦걬?녴괗25 ??7.0m ?붵겏?ゃ겗?㎯곥걹?뚣겓繹?잆겒?꾣쥈?믢슴?녴?\n    const shortSpan: GirderSpan = { ...span, centerSpan: 5600, clear: 4800 }\r\n    const generated = generateGirderRebar(\r\n      input({ run: runWithSpan(shortSpan) }),\r\n      jpMlitRulePack,\r\n    )\r\n    const { formula } = byRole(generated, '訝딁ク嶺?)\r\n\r\n    expect(formula).toContain('泳숁뎸 0?뗦? 竊?0')\r\n    expect(formula).not.toContain('?룔걬??쨯?뽧겒??)\r\n  })\r\n\r\n  it('tracks only existing rules in a stable contribution order', () => {\r\n    const generated = generateGirderRebar(input(), jpMlitRulePack)\r\n    // 留덉?留?cover.minimum ? 塋?깿?▽뻑???먯젙??吏???깆쓽 ?됱씠????鸚㎪쥈 ?됯낵\r\n    // 議곌굔???ㅻⅤ誘濡??ㅻ쭔?쇰줈??援щ텇?섏? ?딅뒗??\r\n    const bentMainRules = [\r\n      'cover.minimum',\r\n      'cover.fabrication.addition',\r\n      'anchorage.L1',\r\n      // anchorage.L1h ??펹?됥겒????5.3.4(5)(節?(a) ??뀲?룝툔?먦겘?당퇉若싩? L1 ?㎯?\n      // L1h ??릪?▲겗?⑴뵪?▽뻑?ャ걲?롢걳?곥겑??ㅳ굚黎뷩굙?ゃ걚??\n      'anchorage.La',\r\n      'anchorage.bent.tail.minimum',\r\n      'anchorage.bent.projection.minimum',\r\n      'cover.minimum',\r\n      // 泳숁뎸??Þ鼇덆빓?뺛겗訝?ⓦ겒??겎蘊ら뇧烏뚣겗?뷴끂?ャ굚雍됥굥?귙걪??뜕?ф쥈??\n      // 訝←ク??뒛?꿔걩若싩??믣맜?곥겍 7.2m ?귙굤?갆25 ??7.0m ?믦텈?덀굥??겎 1?뗦???\n      'measure.splice.interval',\r\n      'measure.splice.length.factor',\r\n      'lap.L1',\r\n    ]\r\n\r\n    expect(\r\n      byRole(generated, '訝딁ク嶺?).ruleHits.map(({ key }) => key),\r\n    ).toEqual(bentMainRules)\r\n    expect(\r\n      byRole(generated, '訝뗧ク嶺?).ruleHits.map(({ key }) => key),\r\n    ).toEqual(bentMainRules)\r\n    // ?귙겙?됬춮??Þ鼇덆빓?뺛꺕鼇?쮫?ф빊?믤군?곥굥??겘令띸츞?뷸틬??걪???↓쟿?졼걨?졼?\n    // ?뗣겤?듽겘 3D 壤®듁 (points) ?ャ걮?뗥듅?뗣겒?꾠겗?㎯곩냵鼇녘죱??졊?졼겓曆룔걶?뗣겏\r\n    // 嶸쀥눣凉뤵겓訝佯╉굚?얇굦?ゃ걚烏뚣굮?뷴끂?ⓦ걮??ㅊ?쇻걪?ⓦ겓?ゃ굥??\n    expect(\r\n      byRole(generated, '?귙겙?됬춮').ruleHits.map(({ key }) => key),\r\n    ).toEqual([\r\n      'measure.hoop.length.addition',\r\n      'measure.distribution.addition',\r\n    ])\r\n\r\n    for (const rebar of generated) {\r\n      expect(new Set(rebar.ruleHits).size).toBe(rebar.ruleHits.length)\r\n      for (const hit of rebar.ruleHits) {\r\n        expect(\r\n          jpMlitRulePack.entries.includes(hit),\r\n          `${hit.key} should be a row of the rule pack`,\r\n        ).toBe(true)\r\n      }\r\n    }\r\n  })\r\n\r\n  it('shows both end methods and the ?졾램?ⓦ걢?뜰굤 calculation in formulas', () => {\r\n    const generated = generateGirderRebar(input(), jpMlitRulePack)\r\n    const coverFormula =\r\n      `?졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊?` +\r\n      `?좂츞 ${fabricationAdditionRule.value} 竊?${fabricationCover}竊?\r\n\r\n    for (const role of ['訝딁ク嶺?, '訝뗧ク嶺?] as const) {\r\n      const main = byRole(generated, role)\r\n      expect(main.formula).toContain('冶뗧ク ?섉쎊?믣츣?')\r\n      expect(main.formula).toContain('永귞ク ?섉쎊?믣츣?')\r\n      expect(main.formula).toContain(coverFormula)\r\n    }\r\n\r\n    // ?귙겙?됬춮??빊?뤵겓?뗣겤?듽겘?밤걢?ゃ걚竊??싧뎴2)竊됥귛냵鼇녘죱??냵力뺡빓?뺛겗?뺛걝歟곥굮\r\n    // ?잆겖?녴굥??겎?곲깿?먦걫?ⓦ겓?뺛걝 3D ?띸쉰??쟿?귝빊?뤵겗嶸쀥눣凉뤵겓??펹?쎼겒?꾠?\n    const stirrupFormula = byRole(generated, '?귙겙?됬춮').formula\r\n    expect(stirrupFormula).not.toContain(coverFormula)\r\n    expect(stirrupFormula).toContain(\r\n      '鼇?쮫?룔걬 竊???씊??Þ鼇덂?力뺛겓?덀굥?③빓 2횞(400竊?50) 竊?2300',\r\n    )\r\n    expect(stirrupFormula).toContain(\r\n      '鼇?쮫?ф빊 竊??덂냵力뺡빓??5200 첨 ?붵긿??100??竊?1 竊?53',\r\n    )\r\n    expect(stirrupFormula).toContain('?끾퀡?룔걬??빰烏ⓨ?)\r\n  })\r\n\r\n  it('carries the ???뗣겤??row that decided the end condition, not just the 鸚㎪쥈 one', () => {\r\n    // 塋?깿?▽뻑? 吏???깆쓽 ?뗣겤?딅줈 ?먯젙?쒕떎. ??臾몄옄?대쭔 ?④린硫?吏묎퀎遺媛 鸚㎪쥈\r\n    // 議곌굔?쇰줈 cover.minimum ???섏쭦???ㅼ젣濡??곗? ?딆? ?됱쓣 洹쇨굅濡??쒖떆?쒕떎 ??\n    // ?뷴끂 ?쒖떆? inferred 湲곗뿬 紐⑸줉???곗텧媛믨낵 ?닿툔?쒕떎 (ADR-015).\r\n    const generated = generateGirderRebar(input(), jpMlitRulePack)\r\n    const top = byRole(generated, '訝딁ク嶺?)\r\n    const columnCovers = top.ruleHits.filter(\r\n      ({ key, conditions }) =>\r\n        key === 'cover.minimum' && conditions.memberKind === '??,\r\n    )\r\n\r\n    expect(columnCovers).toHaveLength(1)\r\n    expect(columnCovers[0].value).toBe(\r\n      lookupRule(jpMlitRulePack, 'cover.minimum', {\r\n        memberKind: '??,\r\n        soilContact: false,\r\n        exposure: '掠뗥쨼',\r\n        finish: '餓뺜툓?믡겒??,\r\n      }).value,\r\n    )\r\n    expect(\r\n      top.ruleHits.some(\r\n        ({ key, conditions }) =>\r\n          key === 'cover.minimum' && conditions.memberKind === '鸚㎪쥈',\r\n      ),\r\n    ).toBe(true)\r\n  })\r\n\r\n  it('reports an unbuildable ?귙겙?됬춮 section as a member-level unsupported reason', () => {\r\n    // ??씊 b 瑜??졾램?ⓦ걢?뜰굤 ??寃밸낫???묎쾶 以꾩씠硫??ъ슜???낅젰留뚯쑝濡??꾨떖?쒕떎.\r\n    const narrow: GirderSection = { ...section, b: 2 * fabricationCover }\r\n\r\n    expect(() =>\r\n      generateGirderRebar(input({ section: narrow }), jpMlitRulePack),\r\n    ).toThrow(MemberUnsupportedError)\r\n    try {\r\n      generateGirderRebar(input({ section: narrow }), jpMlitRulePack)\r\n    } catch (error) {\r\n      expect((error as MemberUnsupportedError).reason).toBe('野멩퀡訝띷닇塋?)\r\n    }\r\n  })\r\n})\r\n\r\ndescribe('亮끾??곭춮 (M3c)', () => {\r\n  const withWidthTie: GirderSection = {\r\n    ...section,\r\n    widthTie: { size: 'D10', pitch: 1000 },\r\n  }\r\n\r\n  it('draws across the width between the ?졾램?ⓦ걢?뜰굤 faces', () => {\r\n    const generated = generateGirderRebar(\r\n      input({ section: withWidthTie }),\r\n      jpMlitRulePack,\r\n    )\r\n    const tie = byRole(generated, '亮끾??곭춮')\r\n\r\n    // ?졾램?룔겘亮끹걢?됥걢?뜰굤2?℡늽?믣폊?꾠걼若잌??곮Þ鼇덆빓?뺛겘亮끹걹??굚?????뤵걭??\n    // 繇잆걚?뺛걝 (ADR-019)?귙걪?볝걣訝?담걮?╉걮?얇걝??1?싧뎴3) ?믣룚?딃걬?덀겍?꾠굥??\n    expect(polylineLength(tie.points, tie.closed)).toBeLessThan(tie.length)\r\n    expect(tie.length).toBe(withWidthTie.b)\r\n    expect(tie.closed).toBe(false)\r\n  })\r\n\r\n  // 誤뤸틬?ュ퉭閭㏂굙嶺뗣겗?붵긿?곥겘?ゃ걚??겎?곫쑋?ε뒟?믧걪?룔걣?뗣굙?뗣걪?ⓦ겘?㎯걤?ゃ걚??\n  // ?뗣굙?뚣겙?⑴뵪?끹걣?γ굦?╉걚?ゃ걚?겼춻?뚣걹??겲??1?싧뎴7) ??돯餓섉쑍?겹겓?ゃ굥??\n  it('?ゅ뀯?쎼겗?붵긿?곥굮容쇻겂??윀?곥걳野멩퀡訝띷닇塋뗣겎?썬겏??, () => {\r\n    try {\r\n      generateGirderRebar(\r\n        input({ section: { ...section, widthTie: { size: 'D10', pitch: 0 } } }),\r\n        jpMlitRulePack,\r\n      )\r\n      expect.unreachable('should have thrown')\r\n    } catch (error) {\r\n      expect(error).toBeInstanceOf(MemberUnsupportedError)\r\n      expect((error as MemberUnsupportedError).reason).toBe('野멩퀡訝띷닇塋?)\r\n      expect((error as Error).message).toContain('亮끾??곭춮 ?붵긿??)\r\n    }\r\n  })\r\n\r\n  it('repeats along the span from the same start offset as the ?귙겙?됬춮', () => {\r\n    const generated = generateGirderRebar(\r\n      input({ section: withWidthTie }),\r\n      jpMlitRulePack,\r\n    )\r\n    const tie = byRole(generated, '亮끾??곭춮')\r\n    const stirrup = byRole(generated, '?귙겙?됬춮')\r\n\r\n    expect(tie.placement?.axis).toBe('x')\r\n    expect(tie.placement?.startOffsetMm).toBe(stirrup.placement?.startOffsetMm)\r\n    expect(tie.placement?.pitchMm).toBe(1000)\r\n    expect(tie.placement?.positionCount).toBe(\r\n      stirrupPositions(span.clear, 1000, section.stirrup.startOffsetMm)\r\n        .positionsMm.length,\r\n    )\r\n  })\r\n\r\n  it('rejects a section too narrow for the fabrication cover', () => {\r\n    const narrow: GirderSection = {\r\n      ...withWidthTie,\r\n      b: 2 * coverRule.value,\r\n    }\r\n\r\n    expect(() =>\r\n      generateGirderRebar(input({ section: narrow }), jpMlitRulePack),\r\n    ).toThrow(MemberUnsupportedError)\r\n  })\r\n})\r\n\r\ndescribe('?밭춮 (M3c)', () => {\r\n  const withSideBar: GirderSection = {\r\n    ...section,\r\n    sideBar: { size: 'D10', count: 2, extraLengthMm: 150 },\r\n  }\r\n\r\n  it('draws exactly the 鼇?쮫?룔걬 ???끾퀡 plus the input 鵝숅빓 at both ends', () => {\r\n    const generated = generateGirderRebar(\r\n      input({ section: withSideBar }),\r\n      jpMlitRulePack,\r\n    )\r\n    const sideBar = byRole(generated, '?밭춮')\r\n\r\n    // 鵝숅빓??뀯?쎼겒??겎?졾램壤®듁?②Þ鼇덆빓?뺛걣繇잆걚?뺛걝?녺뵳?뚣겒?꾠귙걗?겹굢嶺뗣겗?덀걝??\n    // ?곈뇧?담겗怜←븼?뽧걣?γ굢?ゃ걚?볝겏?믣쎓若싥걲?뗣?\n    expect(polylineLength(sideBar.points, sideBar.closed)).toBe(sideBar.length)\r\n    expect(sideBar.length).toBe(span.clear + 2 * 150)\r\n    expect(sideBar.placement).toBeUndefined()\r\n  })\r\n\r\n  it('rejects a negative 鵝숅빓 rather than shortening the bar', () => {\r\n    const negative: GirderSection = {\r\n      ...section,\r\n      sideBar: { size: 'D10', count: 2, extraLengthMm: -50 },\r\n    }\r\n\r\n    expect(() =>\r\n      generateGirderRebar(input({ section: negative }), jpMlitRulePack),\r\n    ).toThrow(MemberUnsupportedError)\r\n  })\r\n})\r\n\r\ndescribe('generateGirderRebar ???ャ긿?덀궕?뺟춮', () => {\r\n  // ?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1)?뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑??\n  // ?덀굥?띯?鵝띸쉰?ζ쑍?겹겗藥?걣?ャ긿?덀궕?뺟춮?㎯곩늾?딀??곦퐤營?겘?ε뒟?㎯걗?뗣?\n  const cutoffMm = 1500\r\n\r\n  function withMain(\r\n    overrides: Partial<GirderSection['main']>,\r\n  ): GirderSection {\r\n    return {\r\n      ...section,\r\n      main: {\r\n        ...section.main,\r\n        cutoffFromSupportFaceMm: cutoffMm,\r\n        ...overrides,\r\n      },\r\n    }\r\n  }\r\n\r\n  function topEnd(supportLengthMm: number) {\r\n    return resolveGirderEnd(\r\n      {\r\n        barSize: section.main.size,\r\n        supportCover,\r\n        fc: section.fc,\r\n        grade: section.grade,\r\n        bendDirection: '訝?,\r\n        supportLengthMm,\r\n      },\r\n      jpMlitRulePack,\r\n    )\r\n  }\r\n\r\n  function byCutoffRole(\r\n    generated: Rebar[],\r\n    role: '訝딁ク?ャ긿?덀궕?뺟춮' | '訝뗧ク?ャ긿?덀궕?뺟춮',\r\n  ): Rebar[] {\r\n    return generated.filter((rebar) => rebar.role === role)\r\n  }\r\n\r\n  const twoSpanRun: GirderRun = {\r\n    axis: 'X',\r\n    members: [\r\n      member,\r\n      { ...member, id: '1F-G1-X2Y1-X', position: { axis: 'X', ix: 1, iy: 0 } },\r\n    ],\r\n    ownerId: member.id,\r\n    spans: [span, { ...span }],\r\n    memberOffsetsMm: [0, span.clear + span.endSupportLengthAlongAxisMm],\r\n    coreLengthMm:\r\n      span.clear + span.endSupportLengthAlongAxisMm + span.clear,\r\n  }\r\n\r\n  it('塋?깿?뚦쩀?꾣뼪?㏂겘?싥걮嶺뗣굮訝?ㄾ?ф빊?㎪빊?덀곩량?믣쨼?닸뵱?밤겗?ャ긿?덀궕?뺟춮?ャ걲??, () => {\r\n    const generated = generateGirderRebar(\r\n      input({ section: withMain({ top: { endCount: 6, centerCount: 4 } }) }),\r\n      jpMlitRulePack,\r\n    )\r\n    const cutoffs = byCutoffRole(generated, '訝딁ク?ャ긿?덀궕?뺟춮')\r\n    const start = topEnd(span.startSupportLengthAlongAxisMm)\r\n\r\n    expect(byRole(generated, '訝딁ク嶺?).count).toBe(4)\r\n    expect(cutoffs).toHaveLength(1)\r\n    expect(cutoffs[0]).toMatchObject({\r\n      memberId: run.ownerId,\r\n      size: section.main.size,\r\n      // 2??횞 鸚뽩겢??궧2?뗦??귚륫塋?겗若싩??룔걬?뚦릪?섅겒??겎1烏뚣겓?잆겖??\n      count: 4,\r\n      axisOffsetsMm: [0, span.clear - cutoffMm],\r\n    })\r\n    expect(cutoffs[0].length).toBe(start.lengthMm + cutoffMm)\r\n    // 若싩???Þ鼇덆빓?뺛겓?γ굥??3D ?ャ겘?뤵걢?ゃ걚竊덁륫塋?겎?묆걤?뚦룏邕㏂걲?뗣걼?곻펹\r\n    expect(polylineLength(cutoffs[0].points, cutoffs[0].closed)).toBe(cutoffMm)\r\n  })\r\n\r\n  it('訝?ㄾ?뚦쩀?꾣뼪?㏂겘?밤깙?녈걫?ⓦ겓訝?ㄾ??궖?껁깉?ゃ깢嶺뗣굮?뷩걲', () => {\r\n    const generated = generateGirderRebar(\r\n      input({\r\n        section: withMain({ bottom: { endCount: 2, centerCount: 4 } }),\r\n      }),\r\n      jpMlitRulePack,\r\n    )\r\n    const cutoffs = byCutoffRole(generated, '訝뗧ク?ャ긿?덀궕?뺟춮')\r\n\r\n    expect(byRole(generated, '訝뗧ク嶺?).count).toBe(2)\r\n    expect(cutoffs).toHaveLength(1)\r\n    expect(cutoffs[0]).toMatchObject({\r\n      memberId: member.id,\r\n      count: 2,\r\n      length: span.clear - 2 * cutoffMm,\r\n      axisOffsetsMm: [cutoffMm],\r\n    })\r\n  })\r\n\r\n  it('訝?ㄾ嶺뗣겏?뉐겢嶺뗣걣?긷춼?쀣겍?귙궖?껁깉?ゃ깢嶺뗣겗slot?믧뇥??겒??, () => {\r\n    const generated = generateGirderRebar(\r\n      input({\r\n        section: withMain({\r\n          top: { startCount: 2, centerCount: 9, endCount: 5 },\r\n        }),\r\n      }),\r\n      jpMlitRulePack,\r\n    )\r\n    const cutoffs = byCutoffRole(generated, '訝딁ク?ャ긿?덀궕?뺟춮')\r\n\r\n    expect(byRole(generated, '訝딁ク嶺?).count).toBe(2)\r\n    expect(cutoffs).toHaveLength(2)\r\n\r\n    const slotRanges = cutoffs\r\n      .map(({ axisSlotStart, count }) => {\r\n        expect(axisSlotStart).toBeDefined()\r\n        return Array.from(\r\n          { length: count },\r\n          (_, index) => axisSlotStart! + index,\r\n        )\r\n      })\r\n      .sort((left, right) => left[0] - right[0])\r\n\r\n    expect(slotRanges).toEqual([\r\n      [2, 3, 4, 5],\r\n      [6, 7, 8],\r\n    ])\r\n    expect(new Set(slotRanges.flat()).size).toBe(7)\r\n  })\r\n\r\n  it('?ｇ텥?밤깙?녈겎??릎?볠뵱?밤굮?싥걲?ャ긿?덀궕?뺟춮?뚦닪烏뚣겓?ゃ굥', () => {\r\n    const generated = generateGirderRebar(\r\n      input({\r\n        run: twoSpanRun,\r\n        section: withMain({ top: { endCount: 6, centerCount: 4 } }),\r\n      }),\r\n      jpMlitRulePack,\r\n    )\r\n    const cutoffs = byCutoffRole(generated, '訝딁ク?ャ긿?덀궕?뺟춮')\r\n    const outer = topEnd(span.startSupportLengthAlongAxisMm)\r\n    const interiorLength =\r\n      2 * cutoffMm + span.endSupportLengthAlongAxisMm\r\n\r\n    expect(cutoffs).toHaveLength(2)\r\n    expect(cutoffs[0]).toMatchObject({\r\n      count: 4,\r\n      length: outer.lengthMm + cutoffMm,\r\n      axisOffsetsMm: [0, twoSpanRun.coreLengthMm - cutoffMm],\r\n    })\r\n    expect(cutoffs[1]).toMatchObject({\r\n      // 訝?뼋??궧??껀?싥걲?뗣겗?㎩츣??뚣겇?뗣겒????2??횞 1?뗦?\r\n      count: 2,\r\n      length: interiorLength,\r\n      axisOffsetsMm: [span.clear - cutoffMm],\r\n    })\r\n    expect(\r\n      polylineLength(cutoffs[1].points, cutoffs[1].closed),\r\n    ).toBe(interiorLength)\r\n  })\r\n\r\n  it('?ャ긿?덀궕?뺟춮??텤?뗧츋??겹겘?ｇ텥歟곥겗?뷴늽烏ⓦ겎??겒??1?싧뎴4) ?㎪빊?덀굥', () => {\r\n    const wideSpan: GirderSpan = { ...span, centerSpan: 7800, clear: 7000 }\r\n    const wideRun: GirderRun = {\r\n      ...twoSpanRun,\r\n      spans: [wideSpan, { ...wideSpan }],\r\n      memberOffsetsMm: [0, wideSpan.clear + wideSpan.endSupportLengthAlongAxisMm],\r\n      coreLengthMm:\r\n        wideSpan.clear + wideSpan.endSupportLengthAlongAxisMm + wideSpan.clear,\r\n    }\r\n    const generated = generateGirderRebar(\r\n      input({\r\n        run: wideRun,\r\n        section: withMain({ bottom: { endCount: 2, centerCount: 4 } }),\r\n      }),\r\n      jpMlitRulePack,\r\n    )\r\n    const [cutoff] = byCutoffRole(generated, '訝뗧ク?ャ긿?덀궕?뺟춮')\r\n\r\n    // 4.0m ??뎱嶺뗣귡ｇ텥歟곥겗?뷴늽烏ⓦ겒??5.0m ?ゆ???0.5?뗦??ャ겒?뗣걣??\n    // ?ャ긿?덀궕?뺟춮??뚧쥈??뀲?룔겓?뤵걼?뗤말嶺뗣띲겎??겒?꾠겗??1?싧뎴4) ?ユ댗?뗣?\n    expect(cutoff.length).toBe(wideSpan.clear - 2 * cutoffMm)\r\n    expect(cutoff.splice?.countPerBar).toBe(0)\r\n    expect(cutoff.splice?.formula).toContain('1?싧뎴4)')\r\n  })\r\n\r\n  // ?담걮?⒲걪?띲걣?뺛걝??겎??씊?삣냵力뺛겗野멩퀡訝띷닇塋뗣겏??닪??릤?긱겓?쇻굥 ??\n  // ?담걲??겘??궧?긱겎?귙궧?묆꺍?㎯굚?ゃ걦??씊訝誤㎯겗?ャ긿?덀궕?뺜퐤營?겎?귙굥??\n  it.each([\r\n    ['?밤깙?녈겓榮띲겲?됥겒??, 2700],\r\n    ['?ゅ뀯??, 0],\r\n  ])('?ャ긿?덀궕?뺜퐤營?걣%s?ゃ굢容쇻겂???ャ걵?싥궖?껁깉?ゃ깢鵝띸쉰訝띷닇塋뗣겎?썬겏??, (_label, cutoffFromSupportFaceMm) => {\r\n    const broken = withMain({\r\n      top: { endCount: 6, centerCount: 4 },\r\n      cutoffFromSupportFaceMm,\r\n    })\r\n\r\n    try {\r\n      generateGirderRebar(input({ section: broken }), jpMlitRulePack)\r\n      expect.unreachable('should have thrown')\r\n    } catch (error) {\r\n      expect(error).toBeInstanceOf(MemberUnsupportedError)\r\n      expect((error as MemberUnsupportedError).reason).toBe(\r\n        '?ャ긿?덀궕?뺜퐤營?툖?먪쳦',\r\n      )\r\n    }\r\n  })\r\n\r\n  // 若싩? 竊??ャ긿?덀궕?뺜퐤營?竊?訝?뼋?긱걵???졼겏鸚뽩겢??궧?ⓧ릎?볠뵱?밤겗鼇?쮫?룔걬??\n  // 訝?담걲?뗰펷D25?삥윶800 ??츣???1000 ?ゃ겗???ャ긿?덀궕?뺜퐤營?200 ?㎯겤?ㅳ걢?뗰펹??\n  // 鼇?쮫?룔걬?졼걨?㎪씇??겍?꾠걼?껁겘?곦릎?볠뵱?밤굮縕ャ걦?꾤춮?뚦쨼?닸뵱?밤겗??걚?뤹뵽?룔걬??\n  // ?뤵걢?뚣겍?꾠걼 ???곈뇧????쀣걚?얇겲 3D ?졼걨?뚦삓?믡겇?뤵?\n  it('鼇?쮫?룔걬?뚣겤?ㅳ걢?ｃ겍?귚릎?볠뵱?밤굮縕ャ걦?꾤춮?믣쨼?담겗?뤹뵽?룔걬?㎪룒?뗣겒??, () => {\r\n    const collidingCutoffMm = 200\r\n    const generated = generateGirderRebar(\r\n      input({\r\n        run: twoSpanRun,\r\n        section: withMain({\r\n          top: { endCount: 6, centerCount: 4 },\r\n          cutoffFromSupportFaceMm: collidingCutoffMm,\r\n        }),\r\n      }),\r\n      jpMlitRulePack,\r\n    )\r\n    const cutoffs = byCutoffRole(generated, '訝딁ク?ャ긿?덀궕?뺟춮')\r\n    const outer = topEnd(span.startSupportLengthAlongAxisMm)\r\n    const interiorLength =\r\n      2 * collidingCutoffMm + span.endSupportLengthAlongAxisMm\r\n\r\n    // ?띷룓??▶沃????뜰겇?뗣겂?╉걚?ゃ걨?뚣겙?볝겗?녴궧?덀겘鵝뺛굚若덀겂?╉걚?ゃ걚\r\n    expect(outer.lengthMm + collidingCutoffMm).toBe(interiorLength)\r\n\r\n    expect(cutoffs).toHaveLength(2)\r\n    expect(cutoffs[0]).toMatchObject({\r\n      count: 4,\r\n      axisOffsetsMm: [0, twoSpanRun.coreLengthMm - collidingCutoffMm],\r\n    })\r\n    expect(cutoffs[1]).toMatchObject({\r\n      count: 2,\r\n      axisOffsetsMm: [span.clear - collidingCutoffMm],\r\n    })\r\n    // 鼇?쮫?룔걬??릪?섅귡걬?녴겗??룒?삯빓?뺛겗?삠걝??\n    expect(cutoffs[0].length).toBe(cutoffs[1].length)\r\n    expect(polylineLength(cutoffs[0].points, cutoffs[0].closed)).toBe(\r\n      collidingCutoffMm,\r\n    )\r\n    expect(polylineLength(cutoffs[1].points, cutoffs[1].closed)).toBe(\r\n      interiorLength,\r\n    )\r\n  })\r\n\r\n  it('塋?깿?ⓧ릎鸚?걣?뚧빊?ゃ굢?ャ긿?덀궕?뺟춮?믣눣?뺛겒??, () => {\r\n    const generated = generateGirderRebar(\r\n      input({ section: withMain({}) }),\r\n      jpMlitRulePack,\r\n    )\r\n\r\n    expect(generated.map(({ role }) => role)).toEqual([\r\n      '訝딁ク嶺?,\r\n      '訝뗧ク嶺?,\r\n      '?귙겙?됬춮',\r\n    ])\r\n  })\r\n})\r\n\r\n{\r\n  \"name\": \"kijun\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"next dev\",\r\n    \"build\": \"next build\",\r\n    \"lint\": \"eslint .\",\r\n    \"typecheck\": \"tsc --noEmit\",\r\n    \"test\": \"vitest run\",\r\n    \"