\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"△\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"柱\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"面\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"F\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"G\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"F\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"G\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"5\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"8\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"5\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"5\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"7\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"5\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"6\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"5\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"6\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\n... 12103325 bytes omitted ...\ntures/quantity-r5-ch3.json`의 1通則1) 항목도 `deferred`에서 `covered`로 옮겼다. **②** 1通則6)은 定着·重ね継手 길이가 設計図書에 없으면 **JASS 5 준용**이라고 한다(標準仕様書가 아니다). 公共建築工事에서는 標準仕様書가 設計図書의 일부이므로 「기재 없음」에 해당하지 않는다고 해석해 5章 값을 쓰고 있으나, 이 해석 자체가 미검증이고 JASS 5는 유료라 미확보다 (R2). **2026-08-21 추가**: 같은 조항이 `腹筋の余長`의 유일한 근거인데, 여기서는 標準仕様書 5章에도 대체값이 없다 — 「腹筋」이 R7 전 330쪽에 0건이라 해석으로도 메울 수 없다. 그래서 余長은 룰팩이 아니라 `断面一覧` 입력이고, 미입력이면 0으로 계상된다(과소 계상이지만 算出式에 그 사실이 적힌다). JASS 5를 확보하면 룰팩 행으로 옮길 수 있다 (ADR-021)\\r\\ndocs/RISKS.md-14-- **R10 (断面リスト 파서 포맷 과적합)** 파서가 실물 3부의 표 형식에 과적합돼 있다. 미지 형식은 값을 지어내지 않고 빈 후보 배열로 정직하게 실패하지만, 사용자에게는 단순히 「인식 불가」로 보인다. 도면 수집을 계속해 커버리지를 넓혀야 하나 실패 도면은 사용자 동의 없이 수집할 수 없으므로, R3(일본 사용자 접점 0)과 결합된 리스크다. 주기형(스케치 인출선) 壁リスト(yokohama-p15)는 표 파서 범위 밖이라 후보를 내지 않는다\\r\\ndocs/RISKS.md-15-- **R12 (帯筋·あばら筋 加工形状에 フック 미반영)** `column.ts`·`girder.ts`가 그리는 帯筋/あばら筋 `points`는 加工用かぶり만 공제한 사각형이라 135°フック余長(`bend.hook135` 6d)이 없다. **数量은 영향 없다** — 1通則2)가 「フックはないものとする」로 정하므로 設計長さ는 断面周長이고 그게 옳다(ADR-019). 문제는 3D다: `points`는 実形状의 유일한 출처인데(`src/domain/model/rebar.ts`) 실물에 있는 フック이 화면에 없다. `bend.hook135`는 룰팩에 실려 있으나 프로덕션 코드가 조회하지 않는다(테스트와 설명 주석만 참조). 加工長 픽스처가 두 케이스를 `status: deviation-from-source`로 대장에 올리고(`quantity-r5-ch3.json`의 status 대장과 같은 방식) `deviation`에 빠진 항(`hook135`)·차액(156mm)·余長까지 넣은 값(柱帯筋 2956·あばら筋 2056)을 적는다 — 그 픽스처가 고정하는 것은 「지금 그려지는 폐합 둘레」이지 「옳은 実形状」이 아니다. 골든테스트가 `expected + missingMm == withHookTailMm`를 확인하므로 대장이 구현과 따로 놀 수 없다. 다만 `withHookTailMm`는 余長만 더한 하한이고 表5.3.1 折曲げ内法直径에 따른 曲げ部 신장은 별도다. 그리기로 결정하더라도 근거값이 M0 이미지 판독(`imageRead: true`)이라 `inferred` ▲가 붙는다 (2026-08-21 식별)\\r\\ndocs/RISKS.md:16:- **R13 (해소 — 端部 좌우 비대칭 입력 경로)** 「Y3端／Y4端」·「外端／内端」처럼 좌우 端部의 主筋 本数가 다른 표를 `girderMainAsymmetric` 후보로 보존하고, `Grid` 축 라벨의 정확 일치·축 순서 자동 결정 또는 사용자 선택으로 断面リスト 취입에 반영한다. 断面一覧 편집에서도 始端·終端을 직접 입력할 수 있다(ADR-032·ADR-033, phase 21). **잔여**: 다스팬×비대칭은 의도적 불성립, カットオフ 좌우 상이 치수는 미지원, 始端/終端 본수의 누적 집합(nesting) 해석은 조문 밖 판단이므로 `inferred` 성격의 R2로 남긴다\\r\\ndocs/RISKS.md:17:- **R14 (해소 — 開口部 欠除·開口補強筋 전사)** `数量積算基準` 1通則8)은 開口部에 의한 鉄筋의 欠除를 「建具類等開口部の内法寸法による、ただし1か所当たり内法面積0.5㎡以下は欠除なし」로 정하고 開口補強筋은 「設計図書により計測・計算する」로 위임한다. 2026-08-22까지는 開口의 위치·치수를 받는 입력이 없어 개구가 있는 벽·床板이 **과대 계상**됐고, `Member.openings` 입력과 `openingDeduction`으로 欠除을 닫았다(ADR-029). **2026-08-26, ADR-034·phase 22에서 開口補強筋을 開口 단위의 設計図書 전사 입력으로 계상하도록 닫았다** — 径·本数·設計長さ를 그대로 `Rebar`로 만들고, 3D에서는 제품이 위치·형상을 지어내지 않도록 건너뛴다. 고지는 지우지 않고 **「전사한 입력은 계상하며, 미전사 開口는 그만큼 과소 계상」**으로 문면을 갱신했다. **판정에 남은 읽기**: 「어느 본이 欠けるか」를 원문이 말하지 않아 1通則7)의 割付을 위치로 읽었다 — 세는 시작 끝이 정해져 있지 않아 개구가 부재 중앙에 없을 때 1본 차가 날 수 있다 (R2). 미전사 보강근의 완전성은 제품이 알 수 없으므로 상시 고지가 안내한다.\\r\\ndocs/RISKS.md-18-- **R15 (열림 — 合計이 확인되지 않은 축의 검산 공회전)** `totalConfirmed === false`인 축은 合計 검산이 없지만, 모두 스팬이 둘 이상이라 남는 방어는 **실측된 창의 중점 매칭(±15pt) ＋ 축척 일관성**이다. 14면으로 넓힌 sweep에서 유효 격자는 13축, 그중 `false`는 7축(yokohama-p6 X·Y, p7 X·Y, p8 X, p9 Y 2축)이었고 안전 창은 이전과 같은 **6pt 이상 30pt 미만**이었다: 4pt에서는 kani-p38·p39·yokohama-p6·p7의 Y 치수가 빠져 `寸法欠落`, 30pt부터는 yokohama-p7의 오탐이 들어와 `合計不一致`가 발생했다. 채택 치수의 `alongDistance` 최댓값은 5.803722pt(yokohama-p6 Y)로 조금 늘었고, `false` 7축의 최근접 미사용 경쟁 치수 최솟값은 140.325470pt(yokohama-p7 X)로 유지됐다. 세로 문턱도 같은 열 인접 1,697쌍의 최솟값이 1.000000이고 1.5~2.0 구간은 1쌍뿐이었으며, 배수 1.0의 0mm 가드는 기존 40건을 포함해 69건 발화했다. 가로 gapRatio 0.5의 0mm 발화는 여전히 yokohama-p14의 4건뿐이다. 따라서 R15를 닫지 않는다 — 면은 14개로 늘었지만 伏図를 가진 발주처는 여전히 2곳뿐이므로, 다른 발주처의 실도면에서도 이 여유와 창이 유지되는지 확인해야 한다\\r\\ndocs/RISKS.md-19-- **R11 (리뷰 게이트가 자기를 못 지킨다)** `pull_request` 워크플로는 PR 브랜치 판으로 실행되므로 `.github/workflows/review.yml` 과 `scripts/ci/*` 를 고치는 PR 은 자기 게이트를 무력화해 무리뷰 자동 머지를 낼 수 있다. **워크플로 안의 수정으로는 닫히지 않는다** — `ref: base.sha` 든 `git checkout base -- scripts/ci/` 든 그 줄 자체가 PR 통제 파일에 있다. 실질 방어는 단독 writer 라는 사실 하나뿐이다(포크 PR 은 읽기 전용 토큰이라 무해). main 브랜치 보호에 `required_pull_request_reviews` 는 걸려 있지 않고 `enforce_admins: false` 다. 닫으려면 gate 와 scope 를 **함께** `workflow_run` 으로 옮겨 기본 브랜치 판 고정 실행해야 한다 — gate 만 옮기면 PR 이 통제하는 scope 잡이 봇 명의·같은 커밋의 위조 마커를 게시해 `review-verdict.sh` 의 작성자·커밋 검사를 그대로 통과한다. **두 번째 writer 가 생기는 시점의 조건부 과제**로 둔다 (2026-08-19 판단)\\r\\n--\\ndocs/ADR.md-306-\\r\\ndocs/ADR.md-307-**트레이드오프**: (1) `shape`를 필수 필드로 했으므로 스키마가 v9로 올라가고 v8 JSON은 게이트에서 거부된다 — optional로 두면 「기재 없음＝矩形」이라는 조용한 기본값이 되기 때문이다. (2) 円形柱 한 개의 帯筋은 사각형 4세그먼트 대신 24세그먼트를 그린다. 円形柱은 드물지만 R4(층당 1만 개)의 여유를 조금 먹는다. (3) `b !== d`인 円形은 타입으로 막지 못한다 — UI와 파서가 항상 한 조로 넣지만, 손으로 편집한 JSON은 타원을 만들 수 있다. 그 대가로 46곳의 分岐를 사지 않았다.\\r\\ndocs/ADR.md-308-\\r\\ndocs/ADR.md:309:### ADR-028: 부재 범위에 `床板（スラブ）`을 넣는다 — 조문이 가장 잘 갖춰진 나머지 하나 (ADR-005 추가 대체)\\r\\ndocs/ADR.md-310-\\r\\ndocs/ADR.md-311-**결정**: 부재를 `柱`·`大梁`·`耐震壁`·**`床板`** 넷으로 넓힌다. `数量積算基準` 2（４）床板 을 구현하고, X방향·Y방향 각각의 上端筋·下端筋 넷을 산정한다. 스키마 v10. 여전히 만들지 않는 것: `壁式構造の壁`·`基礎`·`小梁`·`雑壁`, 그리고 콘크리트·거푸집 물량.\\r\\ndocs/ADR.md-312-\\r\\n--\\ndocs/ADR.md-320-| 表5.3.4 L3(スラブ欄) | 紙面 p.30 「10d かつ150mm以上」 | — | **下端筋의 定着** |\\r\\ndocs/ADR.md-321-| 表5.3.5 Lb | 紙面 p.31 「小梁及びスラブの**上端筋**の梁内折曲げ定着」 | — | **上端筋의 折曲げ 投影** |\\r\\ndocs/ADR.md-322-| 表5.3.6 「スラブ、耐力壁以外の壁」 | 紙面 p.33 (仕上げあり20・なし30) | — | **かぶり** |\\r\\ndocs/ADR.md:323:| トップ筋 / 配力筋 | 0건 / **0건** | 2쪽 / **0건** | 「設計図書による」＝입력 |\\r\\ndocs/ADR.md-324-| 合成スラブ / デッキ / ボイド | 0건 / 12쪽(仕上·防水) / **0건** | 0건 / 3쪽(第4章 鉄骨) / **0건** | 별건·근거 없음 |\\r\\ndocs/ADR.md-325-| 片持スラブ | 表5.3.1 注1·表5.3.5 注1 | 2（４）床板2) 但書 | **만들지 않는다**(형상 입력이 없다) |\\r\\ndocs/ADR.md-326-\\r\\n--\\ndocs/ADR.md-345-\\r\\ndocs/ADR.md-346-**만들지 않은 것과 그 이유**:\\r\\ndocs/ADR.md-347-- **開口部** — 1通則8)은 窓·出入口뿐 아니라 床板의 開口(階段·設備)에도 같이 걸린다. 조문은 있으나 開口를 받는 입력이 없어 **개구가 있는 床板은 과대 계상**된다. 耐震壁과 같은 자리이므로 같은 상시 고지에 床板을 명시적으로 넣었다 (R14).\\r\\ndocs/ADR.md:348:- **片持床板** — 表5.3.4의 「（片持スラブの場合は25d）」도 表5.3.5 注1·注2의 但書도 원문에 있지만, 제품에 「한쪽만 지지된 床板」이라는 형상 입력이 없다. 형상을 먼저 받아야 값이 의미를 갖는다.\\r\\ndocs/ADR.md:349:- **配力筋** — 두 원문에 **0건**. 실무 용어이지 규준 용어가 아니다. 방향별 主筋으로 받으면 그대로 담긴다.\\r\\ndocs/ADR.md-350-- **合成スラブ·デッキプレート** — 「デッキ」는 標準仕様書에 12쪽 있으나 전부 仕上·防水·型枠 쪽이고, 積算基準의 3쪽은 **第4編第4章 鉄骨**이다. ブレース와 같은 이유로 다른 축이다 (ADR-025).\\r\\ndocs/ADR.md-351-- **統計値(2（４）床板3))** — 「することができる」＝허용이지 요구가 아니다. 1장씩 재서 합산한다.\\r\\ndocs/ADR.md-352-- **スラブリスト 파서** — 耐震壁과 같이 지금은 손입력 전용이다 (R10에 얹힌다).\\r\\n--\\ndocs/ADR.md-355-\\r\\ndocs/ADR.md-356-### ADR-029: 開口部를 部材 입력으로 받아 1通則8)로 欠除한다 — R14의 「틀린 채로 완성된 것」을 닫는다\\r\\ndocs/ADR.md-357-\\r\\ndocs/ADR.md:358:**맥락**: `耐震壁`(ADR-025)과 `床板`(ADR-028)을 내면서 두 번 다 같은 자리에 구멍을 남겼다 — 開口部다. 두 부재 모두 개구가 있어도 縦筋·横筋·2방향 主筋을 통째로 계상했으므로, 창이나 계단이 뚫린 벽·바닥은 **과대 계상**됐다. 이 프로젝트가 못 견디는 실패는 「빠진 것」이 아니라 「틀린 채로 완성된 것」이고, R14가 그 첫 자리였다. 빈칸으로 두지 않고 内訳書에 상시 고지를 세워 두었지만 고지는 사실을 알릴 뿐 값을 고치지 못한다.\\r\\ndocs/ADR.md-359-\\r\\ndocs/ADR.md-360-**근거는 조문 하나로 닫힌다.** `公共建築数量積算基準` 第4編第3章 안에서 鉄筋의 欠除를 정하는 조항은 **1通則8) 단 하나**다(전수 검색: 「開口」 79건·「欠除」 52건 중 第3章에 걸리는 것은 이 항과, 壁式構造의 開口補強筋을 다루는 2（５）壁**2)**뿐이며 후자는 미착수 범위다).\\r\\ndocs/ADR.md-361-\\r\\n--\\ndocs/ADR.md-368-\\r\\ndocs/ADR.md-369-**開口는 断面이 아니라 部材에 붙인다.** `Member.openings?: Opening[]`이고 좌표는 부재 内法域의 원점을 0으로 하는 국소계다(壁이면 x＝벽 길이·y＝벽 높이, 床板이면 x·y가 X通り·Y通り). 断面(符号)에 두면 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫려 있다는 사실을 지우게 되고, 도면에 없는 개구를 제품이 다른 벽에도 만든다(ADR-004). 그래서 입력 자리도 断面一覧이 아니라 **平面 페인**이다 — 「어디에 무엇이 있는가」를 다루는 페인이 개구도 다룬다. 柱·大梁은 받지 않는다(같은 항이 드는 것은 窓·出入口 등이고 그것이 뚫리는 것은 壁과 床板이다). 스키마 v11.\\r\\ndocs/ADR.md-370-\\r\\ndocs/ADR.md:371:**「어느 본이 欠けるか」는 1通則7)의 割付을 위치로 읽어 정한다.** 같은 항이 本数를 「⌈その部分の長さ ÷ 鉄筋の間隔⌉ ＋ 1」로 정하므로, 그 산식 그대로 i 번째 본을 `min(i×間隔, その部分の長さ)`에 놓고 개구의 内法寸法 **안쪽**에 들어온 본만 欠けたもの로 본다. 경계에 딱 얹힌 본은 欠かない — 개구 바깥의 철근을 欠除하지 않기 위해서다. **이 「늘어놓는 법」은 1通則7)의 읽기이지 원문이 그림으로 보여 주는 것이 아니다** (R2·inferred). 대안 둘을 물리친 이유를 남긴다 — ⌈開口幅÷ピッチ⌉＋1로 개구 자체에 1通則7)을 적용하면 「その部分」이 아닌 것에 부분의 산식을 쓰게 되고 끝의 1본을 여분으로 欠く, 開口幅÷ピッチ로 면적으로 나누면 本数가 정수가 되지 않는다. 위치로 읽으면 개구가 여럿일 때 **같은 본이 두 개구를 지나는 경우**까지 정확히 나온다(欠除量을 더한다).\\r\\ndocs/ADR.md-372-\\r\\ndocs/ADR.md-373-**断面一覧의 初期オフセット은 쓰지 않는다.** 積算基準은 그것을 관지하지 않으므로(`measurement.ts`가 이미 그렇게 적어 두었다) 数量의 欠除 판정이 그 값에 좌우되어서는 안 된다. 대신 **開口가 있는 부재에서는 3D의 되풀이 위치도 積算 割付에 맞춘다**(`RebarPlacement.positionsMm`) — 数量이 「어느 본이 欠けたか」를 말하고 있는데 화면이 다른 본을 欠かせ면 그림이 数量을 설명하지 못한다. 開口가 없으면 지금까지대로 `stirrupPositions`다.\\r\\ndocs/ADR.md-374-\\r\\n--\\ndocs/ADR.md-387-\\r\\ndocs/ADR.md-388-**검증**: 골든 픽스처 `quantity-r5-ch3.json`의 `cases.openingDeduction`에 1通則8)과 1通則7) **둘만으로 손유도한** 6케이스를 박았다 — 개구 1개, 세로로 겹친 2개(같은 본이 둘 다 지남), 가로로 나란한 높이 다른 2개(欠除量이 다른 群으로 갈리고, 직교 방향에서는 겹쳐 2000을 欠く 본이 나온다), 0.49㎡(欠除 없음), **0.50㎡ 딱(「以下」이므로 欠除 없음)**, 床板 1개(같은 조항이 부재를 가리지 않는다). 뮤테이션으로 감도를 실측했다 — 경계를 `<=`로 무르게 하면 4케이스, 走る向き를 뒤바꾸면 3케이스, 0.5㎡의 「以下」를 「未満」으로 바꾸면 1케이스가 떨어진다. 1通則8)의 픽스처 항목이 `deferred`에서 `covered`로 넘어갔다. 브라우저 실검증은 `tests/e2e/uc21-opening.js`.\\r\\ndocs/ADR.md-389-\\r\\ndocs/ADR.md:390:**트레이드오프**: (1) 「어느 본이 欠けるか」의 판정이 조문에 없는 읽기다 — 위치를 어느 끝에서부터 세는지도 원문이 정하지 않으므로, 개구가 부재 중앙에 없을 때 1본 차이가 날 수 있다(R2). (2) 開口가 있는 부재만 3D의 배치 규칙이 바뀐다 — 같은 断面의 벽 두 장이 開口의 有無로 철근 위치가 미묘하게 달라 보인다. 数量과 그림을 일치시키기 위한 대가다. (3) 欠除量마다 행이 갈리므로 개구가 많은 벽은 内訳의 행이 늘어난다 — 前文의 「寸法等ごとに」가 그것을 요구하지만, 읽는 쪽에서는 같은 役割이 흩어져 보인다. (4) 開口補強筋을 받지 않으므로 개구가 있는 부재는 여전히 정확하지 않다 — 방향이 과대에서 과소로 바뀌었을 뿐이다. 닫으려면 「설계도서에서 읽은 補強筋을 그대로 옮겨 적는」 입력이 필요하고, 그것은 제품이 값을 만드는 것이 아니라 전사하는 일이다.\\r\\ndocs/ADR.md-391-\\r\\ndocs/ADR.md-392-### ADR-030: 伏図·軸組図의 텍스트 레이어에서 형상을 「후보」로 파싱한다 (ADR-004 재검토·ADR-018 확장)\\r\\ndocs/ADR.md-393-\\r\\n--\\ndocs/ADR.md-470-   - s＝e이면 현행 `splitGirderMainRow`와 동치다(스텁 양측 ＝ 기존 端部 카ットオフ, 中央筋 ＝ 기존 中央 카ットオフ, 편측근 0).\\r\\ndocs/ADR.md-471-4. **길이는 전부 기존 규칙의 재사용이다** — 스텁 ＝ 定着＋カットオフ位置, 中央筋 ＝ 内法−2×位置, 편측근 ＝ (内法−位置)＋定着. 定着은 resolveGirderEnd(룰팩), 継手는 1通則4) 간격 계상(intervalSplice) 그대로. 새 규준 수치는 없다. カットオフ位置(`cutoffFromSupportFaceMm`)는 断面 하나에 하나 — 실물 G51도 값이 内端 [2500] 하나뿐이고, 좌우 다른 값이 실물에 나타나면 그때 넓힌다.\\r\\ndocs/ADR.md-472-5. **다스팬 런 × 비대칭은 불성립으로 끊는다.** 리스트의 外端/内端이 다스팬 런의 어느 支点인지 조문·모델로 정할 수 없고, 정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004 원리). `MemberUnsupportedError`로 정직하게 실패한다. 대칭 다스팬은 현행 그대로.\\r\\ndocs/ADR.md:473:6. nesting 해석 자체는 조문이 아니라 판단이다 — 積算基準 2（３）梁1)은 全長にわたる主筋 외의 길이를 設計図書에 위임할 뿐, 位置別 本数를 본 단위로 잇는 규칙은 주지 않는다. R2 꼬리표(inferred)를 단다. 현행 min/差 분해도 같은 해석을 암묵으로 쓰고 있었다 — 이 ADR은 그것을 명시하고 일반화한다.\\r\\ndocs/ADR.md-474-7. 이 ADR의 범위는 모델·산정·数量·3D까지다. **입력 경로는 별건이다** — 断面一覧 편집 UI와 断面リスト 취입(8칸)의 「도면 라벨(外端/Y2端)↔始端/終端 대응」은 다음 phase이고, R13은 그때 닫힌다.\\r\\ndocs/ADR.md-475-\\r\\ndocs/ADR.md-476-### ADR-033: 断面リスト 취입의 「도면 라벨↔始端/終端」 대응 — 정확 일치 자동, 그 외는 사용자 선택\\r\\n--\\ndocs/ADR.md-525-**결정**:\\r\\ndocs/ADR.md-526-1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로다(ADR-025의 「雑壁 부재 금지」는 부재로서는 유지). 조문이 雑壁을 壁에 준하게 하므로 갈림은 부재 축이 아니라 단면 축이다: `WallSection.wallClass?: '耐力壁' | '耐力壁以外'`, 없으면 `耐力壁`(기존 案件 무변경 — schemaVersion 유지, 판단 기준 「같은 案件의 数量이 달라지는가」).\\r\\ndocs/ADR.md-527-2. **구분은 設計図書 판단의 전사 입력이다** — 어느 벽이 耐力壁인지는 두 원문에 판정 기준이 없다(構造設計의 몫). 실도면 2부의 壁リスト도 雑壁을 `W○` 부호＋자유 텍스트 備考로만 적으므로, 断面リスト 취입은 자동 판정하지 않고(備考 분류 금지 전사 주석 유지) 断面一覧에서 사용자가 고른다. 취입은 기존 단면의 `wallClass`를 덮지 않는다 — 전사 대상이 아니다.\\r\\ndocs/ADR.md:528:3. **かぶり** — 룰팩에 表5.3.6 「スラブ、耐力壁以外の壁」행을 `memberKind: 雑壁` 2행(仕上げあり20·仕上げなし30, soilContact:false, exposure 조건 없음 — 원문 구조)으로 싣는다. 값은 ADR-028이 床板용으로 이미 전사한 fixture 행에 있고, 이 행은 부재가 아니라 구분을 가르므로 제품 어휘 토큰 `雑壁`을 조건에 쓴다 — 기존 耐震壁 행과 조건이 배타라 조회 동점(ambiguous)을 만들지 않는다. かぶり는 設計長さ(kg)에 영향이 없고 3D 배치와 ダブル 성립 가드에만 미친다 — 지금 `寸法不成立`으로 떨어지는 얇은 벽이 계상되기 시작할 수 있고, 그것이 옳은 방향이다.\\r\\ndocs/ADR.md:529:4. **40d 하한은 雑壁에 적용하지 않는다 — 제품의 읽기다.** 5.3.4(3)(ｱ)는 耐力壁 한정이고 耐力壁以外의 하한을 정한 조문은 없으므로, 일반 규정(表5.3.2의 L1)만 남는다고 읽는다. ADR-029의 開口部腰壁 판정과 같은 성격으로 기록한다(R2). `wallClass: 耐力壁以外`이면 `lap.wall.minimum`을 조회하지 않고 ruleHits에도 싣지 않으며, 算出式에 그 사실을 적는다. **kg가 달라지는 유일한 지점이다** (L1 ＜ 40d인 조합에서만).\\r\\ndocs/ADR.md-530-5. **하지 않는 것**: 부분 높이·부분 길이 형상(腰壁·垂れ壁의 고유 높이, 袖壁)은 이 결정의 범위 밖이다 — 조문은 内法 준용만 말하고 경계 치수를 정하지 않아 형상 입력 신설이 따로 필요하다(후속 검토). 全高 벽＋開口 우회(ADR-029)는 현행 유지. 手すり壁은 정의절 열거(「袖壁、下り壁、腰壁等」)에 없고 ②의 但書에만 나온다 — 부재화하지 않는다. 幅止め筋 본수 조문 부재(ADR-025)도 그대로다. 内訳書 그룹은 `W` 그대로 두고 부호(mark)로 가른다.\\r\\ndocs/ADR.md-531-\\ndocs/ADR.md:532:### ADR-037: 雑壁의 부분 높이·부분 길이는 部材 단위 内法 범위 전사 입력이다 — 자유단에는 定着이 없다\\ndocs/ADR.md-533-\\ndocs/ADR.md-534-**맥락**: ADR-036 §5가 남긴 것이다. `数量積算基準` 第4編第1章第2節（５）의 정의는 「袖壁、下り壁、腰壁等もこれらに準ずる」로 이들을 「柱、梁、床板等に接する垂直材の内法部分」에 준하게 하지만, **그 内法의 경계 치수는 조문에 없다** — 腰壁이 어디서 끝나는지는 設計図書에만 있다. 현행 제품의 벽은 언제나 全内法(柱면~柱면 × 階高−上部大梁せい)이고, 부분 벽은 全高 벽＋開口 우회(ADR-029)로만 근사된다. 그 우회에는 두 결함이 있다. ① `buildWallBars`는 범위와 무관하게 **항상 양단에 定着을 더한다** — 袖壁의 자유단(벽이 끝나고 아무것도 접속하지 않는 가장자리)에도 定着이 붙어 근거 없이 kg가 올라간다. 2（５）壁1)①은 「接続する他の部分に定着するものとし」라 접속하지 않는 가장자리에는 定着이 없다. ② 경계에 접한 「開口」는 建具類等의 開口部가 아니라 그냥 벽이 없는 부분인데, 그것을 開口로 적으면 1通則8)의 0.5㎡ 하한·②의 継手 但書·開口補強筋 고지가 함께 따라온다. 즉 開口 우회는 **다른 조문을 잘못 발화시킨다**.\\ndocs/ADR.md-535-\\n--\\ndocs/ADR.md-538-2. **범위는 内法 안에서만 존재한다** — `heightMm`은 内法高さ 이하·양수, `lengthMm`은 内法長さ 이하·양수. 벗어나면 조용히 clamp하지 말고 `MemberUnsupportedError('寸法不成立')`로 떨어뜨린다(ADR-025의 얇은 벽 가드와 같은 취급).\\ndocs/ADR.md-539-3. **자유단에는 定着을 더하지 않는다** — 2（５）壁1)①의 「接続する他の部分に定着するものとし」의 직접 적용이다. `anchor: '下端'`(腰壁)이면 縦筋의 上端이, `'上端'`(下り壁)이면 下端이, `'始端'`(袖壁)이면 横筋의 終端이 자유단이다. 定着은 접속하는 쪽에만 1회 붙고 算出式에 어느 쪽이 자유단인지 적는다. 범위를 지정하지 않은 축은 현행 그대로 양단 定着이다.\\ndocs/ADR.md-540-4. **割付은 그 벽의 실제 범위로 한다** — 縦筋은 그 벽의 長さ에, 横筋은 그 벽의 高さ에 1通則7)로 割付한다. 규칙은 현행 그대로이고 들어가는 값만 범위가 된다.\\ndocs/ADR.md:541:5. **부분 높이 벽의 縦筋 継手는 0か所로 읽는다 — 제품의 읽기다.** 2（５）壁1)②는 「縦筋の継手は原則として各階に１か所あるものとし、開口部腰壁、手すり壁等の継手はないものとする」인데, 但書가 이름으로 든 것은 開口部腰壁·手すり壁이고 下り壁은 이름이 없다. 그러나 원칙(各階1か所)은 縦筋이 階를 관통하는 것을 전제로 하고 부분 높이 벽의 縦筋은 관통하지 않으므로, **높이 범위가 지정된 벽**은 但書 쪽으로 읽는다. ADR-029·036과 같은 성격으로 R2에 적는다. 룰팩 신규는 **0행** — 이미 있는 `measure.splice.wall.opening`(0か所, ADR-029)을 그대로 조회한다. 부분 길이만인 벽(袖壁)은 縦筋이 관통하므로 현행대로 各階1か所이고, 横筋 継手는 어느 경우든 1通則4)라 길이가 짧아지면 저절로 줄어든다.\\ndocs/ADR.md-542-6. **開口의 국소 좌표는 그 벽의 범위 원점을 쓴다** — `Opening.xMm/yMm`는 内法域의 원점 기준이고(ADR-029), 범위가 지정되면 内法域이 그 범위다. 부분 벽에도 開口는 뚫릴 수 있고 欠除은 같은 규약으로 계상된다. 3D의 콘크리트 상자·배근 원점도 같은 원점으로 옮긴다.\\ndocs/ADR.md-543-7. **하지 않는 것**: 자동 판정(断面リスト 壁 후보는 厚·配筋만이고 伏図는 평면이라 높이가 없다 — 어느 트랙도 형상 치수를 주지 않는다), 手すり壁 부재화(정의절 열거에 없다 — ADR-036 §5 유지), 같은 辺에 선 벽들의 겹침 검사(제품에 다른 겹침 검사도 없다 — 새로 만들지 않는다), 全高 벽＋開口 우회의 폐지(기존 案件이 그대로 열려야 한다 — 새 입력은 대체지 강제가 아니다), 壁式構造の壁(2（５）壁2), 별건).\\ndocs/ADR.md-544-\\n--\\ndocs/ADR.md-550-1. **놓고 지우는 것은 벽·床板 둘뿐이다** — 柱·大梁는 平面에서 만들지도 지우지도 않는다. 그 둘은 격자와 다른 부재의 内法을 정하는 쪽이라, 놓거나 지우면 손대지 않은 부재의 数量이 조용히 바뀐다(ADR-030이 伏図 취입에서 같은 함정을 거부로 막은 것과 같은 이유). 柱·大梁 편집은 별건이다.\\ndocs/ADR.md-551-2. **잴 수 없는 자리는 후보로 내지 않는다** — 벽은 그 辺에 大梁가 있고 양 끝에 柱가 있는 자리에만, 床板은 네 변의 大梁가 있는 ベイ에만 놓을 수 있다. 판정은 도메인의 순수 함수가 하고 UI는 그 결과만 그린다 — 「놓을 수 있는가」는 규준이 아니라 제품의 기하 지식이므로 룰팩이 아니라 코드다.\\ndocs/ADR.md-552-3. **그래도 도메인이 부재 단위로 떨어뜨려야 한다** — 취입·손편집·과거 案件 어디서든 잴 수 없는 벽이 들어올 수 있으므로, `girderDepthAboveWall`의 plain `Error`를 `MemberUnsupportedError('寸法不成立')`로 바꿔 `useTakeoff`가 그 부재만 「未対応」으로 떨어뜨리게 한다. UI의 후보 제한(2)은 편의이고, 이것이 방어다.\\ndocs/ADR.md:553:4. **부재 id는 伏図 취입과 같은 규약을 쓴다** — `${storyId}-${mark}-${ix}-${iy}[-${axis}]`. 같은 id가 이미 있으면 놓지 않는다(같은 자리에 같은 符号을 두 번 놓는 것이 그 경우다). 서로 다른 符号이 같은 辺에 서는 것은 막지 않는다 — 겹침 검사는 만들지 않는다(ADR-037 §7).\\ndocs/ADR.md-554-5. **지우면 그 부재의 開口·범위도 함께 사라진다** — 둘 다 부재에 붙어 있다. 되돌리기는 만들지 않는다(제품에 undo가 없고, 이 결정으로 만들지 않는다).\\ndocs/ADR.md-555-6. **하지 않는 것**: 柱·大梁 배치·삭제, 격자(通り芯) 편집(이미 `SpanEditor`가 있다), 겹침·중복 배치 검사, 되돌리기, 3D 뷰에서의 배치.\\ndocs/ADR.md-556-\\ndocs/ADR.md:557:### ADR-039: 片持床板을 만든다 — ADR-028의 「두 원문 0건」 전제는 틀렸다\\ndocs/ADR.md-558-\\ndocs/ADR.md:559:**맥락**: ADR-028은 `片持床板`과 `配力筋`을 「두 원문 0건」으로 묶어 둘 다 만들지 않았고, 그 서술이 `CLAUDE.md`·`docs/MILESTONES.md`에 그대로 실려 있다. 원문을 다시 세어 보니 **0건인 것은 `配力筋`뿐이다** — 「片持」는 `数量積算基準`에 6건(PDF p15·16·21·22×2·25), `標準仕様書`에 8건(p33·36×2·37×4·60) 있고 그중 넷은 片持床板에 직접 걸린다. 근거를 갖고 있으면서 만들지 않은 것이므로 전제를 고치고 만든다.\\ndocs/ADR.md-560-\\ndocs/ADR.md-561-**근거 조문(전사 확인)**:\\ndocs/ADR.md:562:- `数量積算基準` 第4編第1章第2節（４）床板 — 「片持床板等もこれらに準ずる。」 즉 片持도 「柱、梁等に接する水平材の内法部分」이다.\\ndocs/ADR.md:563:- 같은 기준 2（４）床板2) 但書 — 「単独床板及び片持床板の主筋の継手は、1通則4)による。」 連続床板의 区分表가 아니라 길이 기반이다.\\ndocs/ADR.md-564-- `標準仕様書` 表5.3.4 L3 スラブ欄 — 「10d かつ150mm以上（**片持スラブの場合は25d**）」. 下端筋 直線定着이 갈린다.\\ndocs/ADR.md-565-- 같은 표 5.3.5 注1·2 — La는 「基礎梁、片持梁及び**片持スラブを含む**」, Lb는 「片持小梁及び**片持スラブを除く**」. 上端筋 折曲げ定着의 投影 열이 Lb가 아니라 **La**다.\\ndocs/ADR.md:566:- 같은 표 5.3.1 注1 — 「**片持ちスラブ先端**、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」 원문이 片持의 先端과 壁의 自由端을 같은 자리에서 다룬다 — ADR-037이 벽에 세운 자유단 판단을 원문이 지지한다.\\ndocs/ADR.md-567-\\ndocs/ADR.md-568-**결정**:\\ndocs/ADR.md:569:1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로이고 片持床板은 `kind: '床板'`이다. 갈리는 것은 **지지 조건**이지 부재가 아니다(ADR-036이 雑壁을 区分으로 담은 것과 같은 형태).\\ndocs/ADR.md:570:2. **위치는 지지하는 辺이고, 내미는 치수는 設計図書 전사다** — 片持床板의 `position`은 ベイ가 아니라 支持辺(`GirderPosition` 형태)이고, `Member.cantilever?: { side: '正' | '負'; projectionMm: number }`가 내미는 쪽과 치수를 받는다(`正` ＝ 支持辺의 축에 직교하는 通り芯 index가 커지는 쪽). 조문은 内法 준용만 말하고 내미는 치수를 정하지 않으므로 전사 입력이다 — ADR-037과 같은 이유·같은 형태. `kind: '床板'`이면서 `axis`를 가진 position이 곧 片持이다. 스키마 버전은 올리지 않는다(optional 추가, 기존 案件 数量 불변).\\ndocs/ADR.md-571-3. **잰다** — 長さ 방향(내미는 방향)은 `projectionMm`, 폭 방향은 支持辺의 内法長さ(柱면~柱면)다. 부분 폭은 만들지 않는다 — 조문에 근거가 없고 필요해지면 그때 넓힌다.\\ndocs/ADR.md:572:4. **자유단에는 定着이 없다** — 네 변 중 접속하는 것은 支持辺 하나뿐이다. 내미는 방향의 철근은 支持辺 쪽에만 定着하고 先端은 1通則1)「先端で止まる鉄筋はコンクリートの設計寸法」으로 加算이 없다(`measure.tip.length.addition`, ADR-025의 柱 최상단과 같은 행). 支持辺과 나란한 방향의 철근은 **양 끝이 다 자유단이라 定着이 0회**다 — 2（４）床板1)의 「接続する梁、壁等」이 없기 때문이고, ADR-037 §3과 같은 읽기다(R2).\\ndocs/ADR.md:573:5. **定着 값이 갈리는 두 곳** — 下端筋의 L3은 `片持スラブ` 조건으로 25d(＋같은 칸의 150mm 하한을 그대로 딸린다), 上端筋 折曲げ의 投影은 `Lb`가 아니라 `La`다. 5.3.4(5)(ｲ)(c)의 「柱せいの3/4以上」은 **끌어오지 않는다** — 그 하한이 재는 것은 柱せい인데 片持床板은 柱에 정착하지 않는다(제품의 읽기, R2). 룰팩 신규는 L3의 片持 행뿐이고 La는 기존 행을 그대로 조회한다.\\ndocs/ADR.md:574:6. **継手는 1通則4)다** — 2（４）床板2) 但書가 片持를 連続床板 区分表에서 빼므로, 13.5m 상한의 `継手箇所数不明`(ADR-028)에 걸리지 않는다.\\ndocs/ADR.md-575-7. **하지 않는 것**: 断面リスト 파서의 片持スラブリスト 대응(전사 픽스처가 「値は転写省略」이라 골든이 설 자리가 없다 — 재전사가 선결이다), 先端筋·開口補強筋 이외의 補強筋(2（４）床板1)이 設計図書에 위임), 부분 폭 片持, 片持梁·片持小梁(小梁은 ADR-005로 만들지 않는다), 表5.3.1 注1의 4d 余長(加工 형상이고 数量은 1通則1)로 정해진다 — R12와 같은 자리에 둔다).\\ndocs/ADR.md-576-\\ndocs/ADR.md-577-**2026-08-27 정정 (phase 27 step 0의 반증을 받아들임)**: §5의 「25d(＋같은 칸의 150mm 하한을 그대로 딸린다)」는 틀렸다. `表5.3.4`의 L3 スラブ欄은 세로로 병합된 **단일 셀**이고, 그 셀 안의 span 배치가 「10d」(y=265) → 「150mm」(y=293) → 「（片持」(y=336) → 「は25d）」(y=377) 순이므로 괄호는 「10d」만이 아니라 **「10d かつ150mm以上」 전체의 예외값**이다. 따라서 片持スラブ의 L3은 **25d 하나이고 150mm 하한은 딸리지 않는다.** 룰팩에도 片持용 `anchorage.L3.minimum` 행을 만들지 않고, 조회 시 그 행을 끌어오지도 않는다. 이 정정은 값을 바꾸지 않는다 — 제품이 다루는 가장 가는 径이 D10이라 25d ＝ 250mm ＞ 150mm이고, 두 읽기가 모든 径에서 같은 수를 낸다. 그래도 고치는 이유는 근거의 문면이 다르기 때문이다.\\n--\\nCLAUDE.md-18-- CRITICAL: **사용자 도면 데이터를 서버로 보내지 말 것.** 모든 계산은 브라우저에서. 서버 저장·전송 코드를 만들지 않는다. 예외는 둘이며 둘 다 도면 데이터와 무관하다 — 운영 알림 수신 라우트 `src/app/api/oncall/alert`(ADR-017)와 브라우저 텔레메트리 `src/lib/telemetry.ts`(ADR-020, `before_send`가 허용목록으로 동작해 예외 메시지 자체를 싣지 않는다).\\r\\nCLAUDE.md-19-- CRITICAL: **출처 표시는 법적 의무다.** 근거 자료는 PDL1.0 준거로 출처 표시와 개변 사실 표시가 요구된다. UI 하단 고지와 룰팩 `source` 필드를 제거하지 말 것.\\r\\nCLAUDE.md-20-- 도메인 용어는 일본어 원어를 그대로 쓴다: `柱`, `大梁`, `主筋`, `帯筋`, `あばら筋`, `定着`, `重ね継手`, `かぶり厚さ`, `SD345`, `Fc24`, `D13`. 한국어로 번역하지 말 것 (ADR-008).\\r\\nCLAUDE.md:21:- 부재는 `柱`·`大梁`·`耐震壁`·`床板` 넷. `耐震壁`은 `数量積算基準` 2（５）壁 **1)「壁式構造以外」**만이고 縦筋·横筋 둘뿐이다 — 壁의 幅止め筋(本数 조문 없음)·`壁式構造の壁`(2))은 만들지 않았다 (ADR-025). `床板`은 2（４）床板으로 재고 X·Y 방향의 上端筋·下端筋 넷을 낸다 — 片持床板·配力筋(두 원문 0건)은 없다 (ADR-028). **開口部는 두 부재 모두 1通則8)로 欠除한다** — `Member.openings` 입력이고, 開口補強筋만 「設計図書により計測・計算する」라 만들지 않는다 (ADR-029). `基礎`·`小梁`·`雑壁` 코드는 여전히 미리 만들지 말 것. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다 (ADR-005·ADR-025·ADR-028).\\r\\nCLAUDE.md-22-- 할증률 조회는 부재 구분을 인자로 받는다. 躯体 4%이고 흙막이벽·말뚝은 3%이므로, 범위 밖이 들어오면 기본값 4%를 주지 말고 실패시킬 것 (ADR-014).\\r\\nCLAUDE.md-23-- 파생 상태(`Rebar[]`, `QuantityLine[]`)를 스토어에 저장하지 말 것. `Project`에서 계산한다.\\r\\nCLAUDE.md-24-- `Project`는 순수 JSON으로 직렬화 가능해야 한다. 클래스 인스턴스·함수·Date 객체를 넣지 말 것.\\r\\n--\\nCLAUDE.md-53-| M3b 다스팬·継手 | 완료 | — |\\r\\nCLAUDE.md-54-| M3c 고유 상세 | **진행 중** | 幅止め筋·腹筋 완료. パネルゾーン帯筋·溶接閉鎖フープ는 두 원문 0건이라 만들지 않는다 |\\r\\nCLAUDE.md-55-| 도면 인식(로컬) | **진행 중** | 断面リスト 트랙(값)·형상 트랙(伏図·軸組図) 둘. 잔여: 표 형식 커버리지, 주기형(스케치 인출선) 壁リスト 미지원, 위치 없는 `カットオフ` 표기 반영, kani p40 미지원(R10). ADR-018·ADR-030 |\\r\\nCLAUDE.md:56:| 부재 확장(耐震壁·床板) | **진행 중** | 平面 뷰의 벽·床板 배치·삭제 입력, 片持床板 |\\r\\nCLAUDE.md-57-| 일본 고유 형태·제품 | **진행 중** | 高強度せん断補強筋·円形柱 완료. 남은 것은 壁式構造の壁 |\\r\\nCLAUDE.md-58-| M4 재방문·내역서·PDF·glTF | 완료 | — |\\r\\nCLAUDE.md-59-| M5 한국 실무자 UX 리뷰 | 미착수 | — |\\r\\n--\\nCLAUDE.md-67-| | 상태 | 한 줄 |\\r\\nCLAUDE.md-68-|---|---|---|\\r\\nCLAUDE.md-69-| R1 | 종결 | `標準詳細図`에 구조 배근 상세가 없다 → 근거는 `標準仕様書 5章`이 유일 |\\r\\nCLAUDE.md:70:| R2 | 열림 | 조문에 없는 관행(暗黙知)은 영구 미검증 → `confidence: inferred`로 축적 |\\r\\nCLAUDE.md-71-| R3 | 열림 | 일본 사용자 접점 0 |\\r\\nCLAUDE.md-72-| R4 | 해소 | 층당 1만 개 규모를 `InstancedMesh`가 견딘다(5층 45,885 실측). 계측 조건에 함정 둘 |\\r\\nCLAUDE.md-73-| R5 | 열림 | 근거가 공공건축 기준이라 민간 관행과 다를 수 있다 → UI 하단 고지 (ADR-003) |\\r\\n--\\nCLAUDE.md-78-| R10 | 열림 | 断面リスト 파서가 실물 3부 형식에 과적합. 형상 트랙에도 걸린다 |\\r\\nCLAUDE.md-79-| R11 | 조건부 | 리뷰 게이트가 자기를 못 지킨다. 두 번째 writer가 생기는 시점의 과제 |\\r\\nCLAUDE.md-80-| R12 | 열림 | 帯筋·あばら筋 `points`에 135°フック이 없다. **数量은 무영향**, 3D 형상만 |\\r\\nCLAUDE.md:81:| R13 | 해소 | `GirderMainRow`의 좌우 비대칭 입력 경로(断面一覧 편집·断面リスト 취입)를 닫았다. `Grid` 축 순서와 사용자 선택으로 도면 라벨을 始端/終端에 대응한다. 다스팬×비대칭은 의도적 불성립, カットオフ 좌우 상이 치수는 미지원, nesting 해석은 조문 밖이라 R2로 남긴다 |\\r\\nCLAUDE.md-82-| R14 | 해소 | 開口部 欠除과 開口補強筋 設計図書 전사 입력을 구현. 미전사 開口의 과소 계상은 상시 고지로 안내 |\\r\\nCLAUDE.md-83-| R15 | 열림 | 合計 없는 7축은 중점 매칭(±15pt)＋축척 일관성이 남는다 — 14면에서도 창 6~30pt 유지, 伏図 발주처 2곳이라 더 넓은 코퍼스 필요 |\\r\\nCLAUDE.md-84-\\r\\n--\\nAGENTS.md-21-- CRITICAL: **사용자 도면 데이터를 서버로 보내지 말 것.** 모든 계산은 브라우저에서. 서버 저장·전송 코드를 만들지 않는다. 예외는 둘이며 둘 다 도면 데이터와 무관하다 — 운영 알림 수신 라우트 `src/app/api/oncall/alert`(ADR-017)와 브라우저 텔레메트리 `src/lib/telemetry.ts`(ADR-020, `before_send`가 허용목록으로 동작해 예외 메시지 자체를 싣지 않는다).\\r\\nAGENTS.md-22-- CRITICAL: **출처 표시는 법적 의무다.** 근거 자료는 PDL1.0 준거로 출처 표시와 개변 사실 표시가 요구된다. UI 하단 고지와 룰팩 `source` 필드를 제거하지 말 것.\\r\\nAGENTS.md-23-- 도메인 용어는 일본어 원어를 그대로 쓴다: `柱`, `大梁`, `主筋`, `帯筋`, `あばら筋`, `定着`, `重ね継手`, `かぶり厚さ`, `SD345`, `Fc24`, `D13`. 한국어로 번역하지 말 것 (ADR-008).\\r\\nAGENTS.md:24:- 부재는 `柱`·`大梁`·`耐震壁`·`床板` 넷. `耐震壁`은 `数量積算基準` 2（５）壁 **1)「壁式構造以外」**만이고 縦筋·横筋 둘뿐이다 — 壁의 幅止め筋(本数 조문 없음)·`壁式構造の壁`(2))은 만들지 않았다 (ADR-025). `床板`은 2（４）床板으로 재고 X·Y 방향의 上端筋·下端筋 넷을 낸다 — 片持床板·配力筋(두 원문 0건)은 없다 (ADR-028). **開口部는 두 부재 모두 1通則8)로 欠除한다** — `Member.openings` 입력이고, 開口補強筋만 「設計図書により計測・計算する」라 만들지 않는다 (ADR-029). `基礎`·`小梁`·`雑壁` 코드는 여전히 미리 만들지 말 것. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다 (ADR-005·ADR-025·ADR-028).\\r\\nAGENTS.md-25-- 할증률 조회는 부재 구분을 인자로 받는다. 躯体 4%이고 흙막이벽·말뚝은 3%이므로, 범위 밖이 들어오면 기본값 4%를 주지 말고 실패시킬 것 (ADR-014).\\r\\nAGENTS.md-26-- 파생 상태(`Rebar[]`, `QuantityLine[]`)를 스토어에 저장하지 말 것. `Project`에서 계산한다.\\r\\nAGENTS.md-27-- `Project`는 순수 JSON으로 직렬화 가능해야 한