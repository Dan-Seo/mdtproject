yTestId('opening-editor-hint')).toBeInTheDocument()\\\\r\\\\n    expect(screen.queryByTestId('opening-editor')).not.toBeInTheDocument()\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('does not offer openings for 柱 — 1通則8) names 窓・出入口', () => {\\\\r\\\\n    render(<PlanEditor />)\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: 'C1 1F-X2Y2' }))\\\\r\\\\n\\\\r\\\\n    expect(screen.queryByTestId('opening-editor')).not.toBeInTheDocument()\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('adds an opening that fits inside the 内法 of the selected wall', () => {\\\\r\\\\n    const wall = selectWall()\\\\r\\\\n    render(<PlanEditor />)\\\\r\\\\n\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: '開口部を追加' }))\\\\r\\\\n\\\\r\\\\n    const stored = useAppStore\\\\r\\\\n      .getState()\\\\r\\\\n      .project.members.find(({ id }) => id === wall.id)!.openings!\\\\r\\\\n    expect(stored).toHaveLength(1)\\\\r\\\\n    // 内法 5200×3450 の中央に 1/3 の大きさ — 置いた瞬間にはみ出さない。\\\\r\\\\n    const [opening] = stored\\\\r\\\\n    expect(opening.xMm).toBeGreaterThanOrEqual(0)\\\\r\\\\n    expect(opening.yMm).toBeGreaterThanOrEqual(0)\\\\r\\\\n    expect(opening.xMm + opening.widthMm).toBeLessThanOrEqual(5200)\\\\r\\\\n    expect(opening.yMm + opening.heightMm).toBeLessThanOrEqual(3450)\\\\r\\\\n    expect(capture).toHaveBeenCalledWith('opening_edited', {\\\\r\\\\n      memberKind: '耐震壁',\\\\r\\\\n    })\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('edits an opening dimension through updateProject', () => {\\\\r\\\\n    const wall = selectWall()\\\\r\\\\n    render(<PlanEditor />)\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: '開口部を追加' }))\\\\r\\\\n\\\\r\\\\n    const width = screen.getByLabelText(`W1 ${wall.id} 1 内法幅`)\\\\r\\\\n    fireEvent.change(width, { target: { value: '1800' } })\\\\r\\\\n\\\\r\\\\n    expect(\\\\r\\\\n      useAppStore\\\\r\\\\n        .getState()\\\\r\\\\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\\\\r\\\\n        .widthMm,\\\\r\\\\n    ).toBe(1800)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('marks an opening the clause does not deduct', () => {\\\\r\\\\n    const wall = selectWall()\\\\r\\\\n    render(<PlanEditor />)\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: '開口部を追加' }))\\\\r\\\\n\\\\r\\\\n    fireEvent.change(screen.getByLabelText(`W1 ${wall.id} 1 内法幅`), {\\\\r\\\\n      target: { value: '700' },\\\\r\\\\n    })\\\\r\\\\n    fireEvent.change(screen.getByLabelText(`W1 ${wall.id} 1 内法高さ`), {\\\\r\\\\n      target: { value: '700' },\\\\r\\\\n    })\\\\r\\\\n\\\\r\\\\n    // 0.49㎡ — 「1か所当たり内法面積0.5㎡以下」なので欠除しない。\\\\r\\\\n    expect(screen.getByText(/0\\\\\\\\.5㎡以下/)).toBeInTheDocument()\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('warns when an opening leaves the 内法 instead of trimming it', () => {\\\\r\\\\n    const wall = selectWall()\\\\r\\\\n    render(<PlanEditor />)\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: '開口部を追加' }))\\\\r\\\\n\\\\r\\\\n    fireEvent.change(screen.getByLabelText(`W1 ${wall.id} 1 内法幅`), {\\\\r\\\\n      target: { value: '9000' },\\\\r\\\\n    })\\\\r\\\\n\\\\r\\\\n    // 切り詰めて受け取ると図面にない大きさの開口を製品が決めることになる。\\\\r\\\\n    expect(screen.getByTestId('opening-outside')).toBeInTheDocument()\\\\r\\\\n    expect(\\\\r\\\\n      useAppStore\\\\r\\\\n        .getState()\\\\r\\\\n        .project.members.find(({ id }) => id === wall.id)!.openings![0]\\\\r\\\\n        .widthMm,\\\\r\\\\n    ).toBe(9000)\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('drops the key entirely when the last opening is removed', () => {\\\\r\\\\n    const wall = selectWall()\\\\r\\\\n    render(<PlanEditor />)\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: '開口部を追加' }))\\\\r\\\\n    fireEvent.click(screen.getByRole('button', { name: `W1 ${wall.id} 1 削除` }))\\\\r\\\\n\\\\r\\\\n    const stored = useAppStore\\\\r\\\\n      .getState()\\\\r\\\\n      .project.members.find(({ id }) => id === wall.id)!\\\\r\\\\n    expect(stored).not.toHaveProperty('openings')\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('draws a 床板 opening at its true position, not inside the drawn inset', () => {\\\\r\\\\n    const project = createSampleProject()\\\\r\\\\n    const slab = project.members.find(({ kind }) => kind === '床板')!\\\\r\\\\n    act(() => {\\\\r\\\\n      useAppStore.setState({\\\\r\\\\n        project: {\\\\r\\\\n          ...project,\\\\r\\\\n          members: project.members.map((member) =>\\\\r\\\\n            member.id === slab.id\\\\r\\\\n              ? {\\\\r\\\\n                  ...member,\\\\r\\\\n                  openings: [\\\\r\\\\n                    {\\\\r\\\\n                      id: 'op1',\\\\r\\\\n                      xMm: 2400,\\\\r\\\\n                      yMm: 2400,\\\\r\\\\n                      widthMm: 1200,\\\\r\\\\n                      heightMm: 1200,\\\\r\\\\n                    },\\\\r\\\\n                  ],\\\\r\\\\n                }\\\\r\\\\n              : member,\\\\r\\\\n          ),\\\\r\\\\n        },\\\\r\\\\n      })\\\\r\\\\n    })\\\\r\\\\n    const { container } = render(<PlanEditor />)\\\\r\\\\n\\\\r\\\\n    const rects = container.querySelectorAll('rect[class*=\\\\\\\"opening\\\\\\\"]')\\\\r\\\\n    expect(rects).toHaveLength(1)\\\\r\\\\n    // 開口は正方形なので、平面でも幅と高さが等しく出る（実寸で写している証拠）。\\\\r\\\\n    const width = Number(rects[0].getAttribute('width'))\\\\r\\\\n    const height = Number(rects[0].getAttribute('height'))\\\\r\\\\n    expect(width).toBeCloseTo(height, 6)\\\\r\\\\n    expect(width).toBeGreaterThan(0)\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\ndescribe('StoryTabs', () => {\\\\r\\\\n  beforeEach(() => {\\\\r\\\\n    capture.mockClear()\\\\r\\\\n    useAppStore.setState({\\\\r\\\\n      project: createSampleProject(),\\\\r\\\\n      sel: { group: null, memberId: null },\\\\r\\\\n      activeStoryId: '1F',\\\\r\\\\n      locale: 'ja',\\\\r\\\\n    })\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('changes activeStoryId when a story tab is clicked', () => {\\\\r\\\\n    render(<StoryTabs />)\\\\r\\\\n\\\\r\\\\n    fireEvent.click(screen.getByRole('tab', { name: '2階' }))\\\\r\\\\n\\\\r\\\\n    expect(useAppStore.getState().activeStoryId).toBe('2F')\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('reports the story switch', () => {\\\\r\\\\n    render(<StoryTabs />)\\\\r\\\\n\\\\r\\\\n    fireEvent.click(screen.getByRole('tab', { name: '2階' }))\\\\r\\\\n\\\\r\\\\n    expect(capture).toHaveBeenCalledWith('story_selected')\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  // ViewerTabs·member_selected와 같은 기준 — 이미 활성인 층을 다시\\\\r\\\\n  // 눌러도 전환이 아니다 (10차 리뷰 minor).\\\\r\\\\n  it('does not report when clicking the already-active story tab', () => {\\\\r\\\\n    render(<StoryTabs />)\\\\r\\\\n\\\\r\\\\n    fireEvent.click(screen.getByRole('tab', { name: '1階' }))\\\\r\\\\n\\\\r\\\\n    expect(capture).not.toHaveBeenCalled()\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_20\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '$p='\\\\\\\"'src/lib/export/index.ts'; \\\\\\\"'$lines=Get-Content -Encoding utf8 $p; $lines[240..350]; $p='\\\\\\\"'src/lib/export/workbook.ts'; if (Test-Path \\\\\\\"'$p) { Get-Content -Encoding utf8 $p | Select-Object -First 260 }'\\\",\\\"aggregated_output\\\":\\\"    source.edition ?? copy.unavailableEdition,\\\\r\\\\n    source.publisher,\\\\r\\\\n    source.url ?? copy.unavailableUrl,\\\\r\\\\n  ].join(' / ')\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction workbookHeaders(locale: Locale): string[] {\\\\r\\\\n  return [\\\\r\\\\n    t(locale, 'export.story'),\\\\r\\\\n    t(locale, 'export.member'),\\\\r\\\\n    t(locale, 'export.mark'),\\\\r\\\\n    t(locale, 'takeoff.rebar'),\\\\r\\\\n    t(locale, 'takeoff.diameter'),\\\\r\\\\n    t(locale, 'takeoff.shape'),\\\\r\\\\n    t(locale, 'takeoff.length'),\\\\r\\\\n    t(locale, 'takeoff.count'),\\\\r\\\\n    t(locale, 'takeoff.places'),\\\\r\\\\n    t(locale, 'takeoff.totalLength'),\\\\r\\\\n    t(locale, 'takeoff.unitMass'),\\\\r\\\\n    t(locale, 'takeoff.designQuantity'),\\\\r\\\\n    t(locale, 'takeoff.requiredQuantity'),\\\\r\\\\n    t(locale, 'takeoff.unit'),\\\\r\\\\n    t(locale, 'takeoff.source'),\\\\r\\\\n    t(locale, 'takeoff.note'),\\\\r\\\\n    t(locale, 'export.formula'),\\\\r\\\\n  ]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/** 内訳の役割セルに付ける等級マーク — 画面の ▲/△ と同じ意味にそろえる。 */\\\\r\\\\nfunction confidenceMark(confidence: QuantityLine['confidence']): string {\\\\r\\\\n  if (confidence === 'inferred') return '▲ '\\\\r\\\\n  if (confidence === 'transcribed') return '△ '\\\\r\\\\n  return ''\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction dataRow(\\\\r\\\\n  line: QuantityLine,\\\\r\\\\n  locale: Locale,\\\\r\\\\n  note: string,\\\\r\\\\n): WorkbookRowSpec {\\\\r\\\\n  // 継手行は箇所で数えるので、長さ・質量の列は空欄にする。0 を書くと\\\\r\\\\n  // 集計されて質量が過小に見える。\\\\r\\\\n  const measured = isMassLine(line)\\\\r\\\\n    ? [\\\\r\\\\n        cell(shapeLabel(locale, line.shape)),\\\\r\\\\n        cell(line.lengthMm / 1000, { numberFormat: THREE_DECIMALS }),\\\\r\\\\n        cell(line.countPerMember, { numberFormat: '0' }),\\\\r\\\\n        cell(line.places, { numberFormat: '0' }),\\\\r\\\\n        cell(line.totalLengthMm / 1000, { numberFormat: THREE_DECIMALS }),\\\\r\\\\n        cell(line.unitMassKgPerM, { numberFormat: THREE_DECIMALS }),\\\\r\\\\n        cell(line.designKg, { numberFormat: THREE_DECIMALS }),\\\\r\\\\n        cell(line.requiredKg, { numberFormat: THREE_DECIMALS }),\\\\r\\\\n      ]\\\\r\\\\n    : [\\\\r\\\\n        cell(null),\\\\r\\\\n        cell(null),\\\\r\\\\n        cell(line.countPerMember, { numberFormat: SPLICE_COUNT_FORMAT }),\\\\r\\\\n        cell(line.places, { numberFormat: '0' }),\\\\r\\\\n        cell(null),\\\\r\\\\n        cell(null),\\\\r\\\\n        cell(line.totalCount, { numberFormat: SPLICE_COUNT_FORMAT }),\\\\r\\\\n        cell(null),\\\\r\\\\n      ]\\\\r\\\\n\\\\r\\\\n  return row(\\\\r\\\\n    'data',\\\\r\\\\n    [\\\\r\\\\n      cell(line.storyName),\\\\r\\\\n      cell(line.memberKind),\\\\r\\\\n      cell(line.mark),\\\\r\\\\n      cell(\\\\r\\\\n        `${confidenceMark(line.confidence)}${line.role}${\\\\r\\\\n          isMassLine(line) ? '' : `　${t(locale, 'takeoff.splice')}（${line.method}）`\\\\r\\\\n        }`,\\\\r\\\\n      ),\\\\r\\\\n      cell(line.size),\\\\r\\\\n      ...measured,\\\\r\\\\n      cell(line.unit),\\\\r\\\\n      cell(lineSources(line, locale)),\\\\r\\\\n      cell(note),\\\\r\\\\n      cell(line.formula),\\\\r\\\\n    ],\\\\r\\\\n    line.id,\\\\r\\\\n  )\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * 「原文に値がない規準値を使った」警告と PDL1.0 の出典・改変表示。シートは\\\\r\\\\n * 単独でコピーされて発注に回るので、質量が載るシートには両方付ける。\\\\r\\\\n */\\\\r\\\\nfunction watermarkRows(\\\\r\\\\n  lines: QuantityLine[],\\\\r\\\\n  locale: Locale,\\\\r\\\\n): WorkbookRowSpec[] {\\\\r\\\\n  if (!hasUnverified(lines)) return []\\\\r\\\\n\\\\r\\\\n  // 警告は2行のままにする（DESIGN §4.2 — ヘッダ行の位置が動くと読み手側の\\\\r\\\\n  // 参照が全部ずれる）。1行目でどちらの等級が混ざっているかを言い、2行目には\\\\r\\\\n  // **原文に値がない項目だけ**を挙げる — 独立検討待ちは今ほぼ全行に付くので\\\\r\\\\n  // 並べても読み手の作業リストにならない。\\\\r\\\\n  const copy = exportCopy[locale]\\\\r\\\\n  const inferred = inferredRules(lines)\\\\r\\\\n\\\\r\\\\n  return [\\\\r\\\\n    row('watermark', [cell(copy.unverifiedWarning)]),\\\\r\\\\n    row('watermark', [\\\\r\\\\n      cell(\\\\r\\\\n        inferred.length === 0\\\\r\\\\n          ? copy.transcribedOnly\\\\r\\\\n          : `${copy.inferredList}: ${inferred\\\\r\\\\n              .map((rule) => sourceLocation(rule, locale, true))\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_19\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '$p='\\\\\\\"'src/components/quantity/TakeoffPane.tsx'; \\\\\\\"'$lines=1..220 | ForEach-Object {$lines}; $lines=Get-Content -Encoding utf8 $p; $lines[560..660]'\\\",\\\"aggregated_output\\\":\\\"  setHoverRow,\\\\r\\\\n}: {\\\\r\\\\n  line: QuantityLine\\\\r\\\\n  representative: string\\\\r\\\\n  expanded: boolean\\\\r\\\\n  toggleLine(line: QuantityLine, memberId: string): void\\\\r\\\\n  setHoverRow(rowId: string | null): void\\\\r\\\\n}) {\\\\r\\\\n  const toggle = () => toggleLine(line, representative)\\\\r\\\\n\\\\r\\\\n  return (\\\\r\\\\n    <>\\\\r\\\\n      <tr\\\\r\\\\n        className={styles.lineRow}\\\\r\\\\n        data-testid={`quantity-line-${line.id}`}\\\\r\\\\n        onClick={toggle}\\\\r\\\\n        onMouseEnter={() => setHoverRow(line.id)}\\\\r\\\\n        onMouseLeave={() => setHoverRow(null)}\\\\r\\\\n        onFocus={() => setHoverRow(line.id)}\\\\r\\\\n        onBlur={() => setHoverRow(null)}\\\\r\\\\n      >\\\\r\\\\n        <td className={styles.rebarCell}>\\\\r\\\\n          {/* 행 어디를 눌러도 펼쳐지지만, 펼침 상태는 여기에 둔다 — role=row의\\\\r\\\\n              aria-expanded는 treegrid 안에서만 유효해 평범한 table에서는 읽히지 않는다.\\\\r\\\\n              onFocus/onBlur는 focusin/focusout이라 이 버튼에 포커스가 와도 tr에서 잡힌다. */}\\\\r\\\\n          <button\\\\r\\\\n            type=\\\\\\\"button\\\\\\\"\\\\r\\\\n            className={styles.disclosure}\\\\r\\\\n            aria-expanded={expanded}\\\\r\\\\n            onClick={(event) => {\\\\r\\\\n              event.stopPropagation() // tr의 onClick으로 번지면 두 번 토글돼 아무 일도 안 일어난다\\\\r\\\\n              toggle()\\\\r\\\\n            }}\\\\r\\\\n          >\\\\r\\\\n            {isMassLine(line)\\\\r\\\\n              ? line.role\\\\r\\\\n              : `${line.role}　継手（${line.method}）`}\\\\r\\\\n          </button>\\\\r\\\\n          <ConfidenceWarning line={line} />\\\\r\\\\n        </td>\\\\r\\\\n        <td className={styles.numericCell}>{line.size}</td>\\\\r\\\\n        {isMassLine(line) ? (\\\\r\\\\n          <>\\\\r\\\\n            <td>\\\\r\\\\n              <ShapeIcon shape={line.shape} />\\\\r\\\\n            </td>\\\\r\\\\n            <td className={styles.numericCell}>\\\\r\\\\n              {formatLength(line.lengthMm)}\\\\r\\\\n            </td>\\\\r\\\\n            <td className={styles.numericCell}>{line.countPerMember}</td>\\\\r\\\\n            <td className={styles.numericCell}>{line.places}</td>\\\\r\\\\n            <td className={styles.numericCell}>\\\\r\\\\n              {formatLength(line.totalLengthMm)}\\\\r\\\\n            </td>\\\\r\\\\n            <td className={`${styles.numericCell} ${styles.unitMass}`}>\\\\r\\\\n              {formatMass(line.unitMassKgPerM)}\\\\r\\\\n            </td>\\\\r\\\\n            <td className={styles.numericCell}>{formatMass(line.designKg)}</td>\\\\r\\\\n            <td className={`${styles.numericCell} ${styles.requiredColumn}`}>\\\\r\\\\n              {formatMass(line.requiredKg)}\\\\r\\\\n            </td>\\\\r\\\\n          </>\\\\r\\\\n        ) : (\\\\r\\\\n          // 継手は箇所で数える。長さ・質量の列は空欄ではなく「値がない」と示す —\\\\r\\\\n          // 割増（1通則9)）も設計「数量」＝質量への規定なので所要数量は出ない。\\\\r\\\\n          <>\\\\r\\\\n            <td>{NOT_APPLICABLE}</td>\\\\r\\\\n            <td className={styles.numericCell}>{NOT_APPLICABLE}</td>\\\\r\\\\n            <td className={styles.numericCell}>\\\\r\\\\n              {formatCount(line.countPerMember)}\\\\r\\\\n            </td>\\\\r\\\\n            <td className={styles.numericCell}>{line.places}</td>\\\\r\\\\n            <td className={styles.numericCell}>{NOT_APPLICABLE}</td>\\\\r\\\\n            <td className={`${styles.numericCell} ${styles.unitMass}`}>\\\\r\\\\n              {NOT_APPLICABLE}\\\\r\\\\n            </td>\\\\r\\\\n            <td className={styles.numericCell}>\\\\r\\\\n              {formatCount(line.totalCount)}\\\\r\\\\n            </td>\\\\r\\\\n            <td className={`${styles.numericCell} ${styles.requiredColumn}`}>\\\\r\\\\n              {NOT_APPLICABLE}\\\\r\\\\n            </td>\\\\r\\\\n          </>\\\\r\\\\n        )}\\\\r\\\\n        <td>{line.unit}</td>\\\\r\\\\n        <td>\\\\r\\\\n          <SourceChips rules={line.rules} />\\\\r\\\\n        </td>\\\\r\\\\n        <td>\\\\r\\\\n          <NoteInput lineId={line.id} />\\\\r\\\\n        </td>\\\\r\\\\n      </tr>\\\\r\\\\n      {expanded && (\\\\r\\\\n        <tr className={styles.formulaRow} data-testid={`formula-${line.id}`}>\\\\r\\\\n          <td colSpan={13}>\\\\r\\\\n            <pre>{line.formula}</pre>\\\\r\\\\n          </td>\\\\r\\\\n        </tr>\\\\r\\\\n      )}\\\\r\\\\n    </>\\\\r\\\\n  )\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_22\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '$p='\\\\\\\"'src/locales/ja.json'; \\\\\\\"'$lines=Get-Content -Encoding utf8 $p; $lines[145..180]; $p='\\\\\\\"'src/locales/ko.json'; \\\\\\\"'$lines=Get-Content -Encoding utf8 $p; $lines[145..180]'\\\",\\\"aggregated_output\\\":\\\"  \\\\\\\"domain.cover\\\\\\\": \\\\\\\"かぶり厚さ\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.sd345\\\\\\\": \\\\\\\"SD345\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.fc24\\\\\\\": \\\\\\\"Fc24\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.d13\\\\\\\": \\\\\\\"D13\\\\\\\",\\\\r\\\\n  \\\\\\\"warning.m1.title\\\\\\\": \\\\\\\"独立検討待ち\\\\\\\",\\\\r\\\\n  \\\\\\\"warning.m1.body\\\\\\\": \\\\\\\"ルールパックの数値は原文から転写済みですが、転写者と承認者が同一で独立検討が済んでいません（△）。原文に値がなく推論した項目もあります（▲）。検収・発注には使用しないでください。\\\\\\\",\\\\r\\\\n  \\\\\\\"notice.source\\\\\\\": \\\\\\\"算出根拠: 公共建築工事標準仕様書・公共建築数量積算基準（国土交通省公開資料を加工・改変して利用）\\\\\\\",\\\\r\\\\n  \\\\\\\"notice.scope\\\\\\\": \\\\\\\"官庁施設向けの基準であり、民間工事では異なる場合があります。\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.unit\\\\\\\": \\\\\\\"単位\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.splice\\\\\\\": \\\\\\\"継手\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.splicePosition\\\\\\\": \\\\\\\"継手位置は標準仕様書 表5.3.3 が原文で画像のため未確定です — 箇所数と設計長さのみ計上し、3D には描いていません\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.wallOpening\\\\\\\": \\\\\\\"開口部は入力された内法寸法だけ鉄筋を欠除します（数量積算基準 1通則8)・1か所当たり内法面積0.5㎡以下は欠除なし）。開口補強筋は同項が「設計図書により計測・計算する」と定めるため計上していません — 開口のある耐震壁・床板はその分だけ過小計上になります\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.cutoffAnchorage\\\\\\\": \\\\\\\"カットオフ筋の定着は 3D に描いていません — 端で向きが反転するため、設計長さにのみ算入しています（切り止め位置は数量積算基準 2（３）梁1) により設計図書によります）\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.title\\\\\\\": \\\\\\\"開口部\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.hint\\\\\\\": \\\\\\\"選んだ耐震壁・床板の開口部です。寸法は建具類等開口部の内法寸法（数量積算基準 1通則8)）で、位置は部材の内法域の原点から測ります\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.empty\\\\\\\": \\\\\\\"開口部なし\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.add\\\\\\\": \\\\\\\"開口部を追加\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.remove\\\\\\\": \\\\\\\"削除\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.x\\\\\\\": \\\\\\\"位置 X\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.y\\\\\\\": \\\\\\\"位置 Y\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.width\\\\\\\": \\\\\\\"内法幅\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.height\\\\\\\": \\\\\\\"内法高さ\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.select\\\\\\\": \\\\\\\"耐震壁または床板を選ぶと開口部を入力できます\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.ignored\\\\\\\": \\\\\\\"内法面積 0.5㎡以下 — 欠除なし\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.通り芯ラベル未検出\\\\\\\": \\\\\\\"通り芯のラベルが読めませんでした\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.寸法欠落\\\\\\\": \\\\\\\"通り芯の間の寸法が読めませんでした\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.縮尺不整合\\\\\\\": \\\\\\\"スパンごとの実測縮尺が食い違います\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.合計不一致\\\\\\\": \\\\\\\"全体寸法がスパンの合計と一致しません\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.ラベル文字混在\\\\\\\": \\\\\\\"一つの並びに X と Y のラベルが混じっています\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.通り芯対応不明\\\\\\\": \\\\\\\"どの X・Y 通り芯が一組か特定できませんでした\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.role.格子点\\\\\\\": \\\\\\\"格子点\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.role.辺\\\\\\\": \\\\\\\"辺\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.role.ベイ\\\\\\\": \\\\\\\"ベイ\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.寸法列未検出\\\\\\\": \\\\\\\"高さ方向の寸法列が読めませんでした\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.refusal.階未指定\\\\\\\": \\\\\\\"取り込む階を選んでください\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.refusal.他階部材あり通り芯変更不可\\\\\\\": \\\\\\\"他の階に部材があるため通り芯を変えられません\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.cover\\\\\\\": \\\\\\\"かぶり厚さ\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.sd345\\\\\\\": \\\\\\\"SD345\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.fc24\\\\\\\": \\\\\\\"Fc24\\\\\\\",\\\\r\\\\n  \\\\\\\"domain.d13\\\\\\\": \\\\\\\"D13\\\\\\\",\\\\r\\\\n  \\\\\\\"warning.m1.title\\\\\\\": \\\\\\\"독립 검토 대기\\\\\\\",\\\\r\\\\n  \\\\\\\"warning.m1.body\\\\\\\": \\\\\\\"룰팩 수치는 원문에서 전사를 마쳤으나 전사자와 승인자가 같아 독립 검토가 남아 있습니다(△). 원문에 값이 없어 추론한 항목도 있습니다(▲). 검수·발주에 사용하지 마십시오.\\\\\\\",\\\\r\\\\n  \\\\\\\"notice.source\\\\\\\": \\\\\\\"산출 근거: 公共建築工事標準仕様書·公共建築数量積算基準(국토교통성 공개 자료를 가공·개변하여 이용)\\\\\\\",\\\\r\\\\n  \\\\\\\"notice.scope\\\\\\\": \\\\\\\"관청시설용 기준이며, 민간공사에서는 다를 수 있습니다.\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.unit\\\\\\\": \\\\\\\"단위\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.splice\\\\\\\": \\\\\\\"継手\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.splicePosition\\\\\\\": \\\\\\\"継手 위치는 標準仕様書 表5.3.3이 원문에서 이미지라 미확정입니다 — 개소수와 설계길이만 계상하고 3D에는 그리지 않습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.wallOpening\\\\\\\": \\\\\\\"開口部는 입력된 内法寸法만큼 철근을 欠除합니다(数量積算基準 1通則8)・1개소당 内法面積 0.5㎡ 이하는 欠除 없음). 開口補強筋은 같은 항이 「設計図書により計測・計算する」로 위임하므로 계상하지 않습니다 — 개구부가 있는 耐震壁·床板은 그만큼 과소 계상됩니다\\\\\\\",\\\\r\\\\n  \\\\\\\"takeoff.cutoffAnchorage\\\\\\\": \\\\\\\"カットオフ筋의 定着은 3D에 그리지 않습니다 — 끝에서 방향이 뒤집혀 설계길이에만 산입합니다(切り止め 위치는 数量積算基準 2（３）梁1)에 따라 設計図書에 의합니다)\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.title\\\\\\\": \\\\\\\"開口部(개구부)\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.hint\\\\\\\": \\\\\\\"선택한 耐震壁·床板의 개구부입니다. 치수는 건구류 등 개구부의 内法寸法(数量積算基準 1通則8))이고, 위치는 부재 内法 영역의 원점에서 잰 값입니다\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.empty\\\\\\\": \\\\\\\"개구부 없음\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.add\\\\\\\": \\\\\\\"개구부 추가\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.remove\\\\\\\": \\\\\\\"삭제\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.x\\\\\\\": \\\\\\\"위치 X\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.y\\\\\\\": \\\\\\\"위치 Y\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.width\\\\\\\": \\\\\\\"内法 폭\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.height\\\\\\\": \\\\\\\"内法 높이\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.select\\\\\\\": \\\\\\\"耐震壁 또는 床板을 선택하면 개구부를 입력할 수 있습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"plan.openings.ignored\\\\\\\": \\\\\\\"内法面積 0.5㎡ 이하 — 欠除 없음\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.通り芯ラベル未検出\\\\\\\": \\\\\\\"通り芯(기준선) 라벨을 읽지 못했습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.寸法欠落\\\\\\\": \\\\\\\"通り芯 사이 치수를 읽지 못했습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.縮尺不整合\\\\\\\": \\\\\\\"스팬별 실측 축척이 어긋납니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.合計不一致\\\\\\\": \\\\\\\"전체 치수가 스팬 합과 맞지 않습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.ラベル文字混在\\\\\\\": \\\\\\\"한 열에 X와 Y 라벨이 섞여 있습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.通り芯対応不明\\\\\\\": \\\\\\\"어느 X·Y 通り芯이 한 짝인지 정할 수 없었습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.role.格子点\\\\\\\": \\\\\\\"격자점\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.role.辺\\\\\\\": \\\\\\\"변\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.role.ベイ\\\\\\\": \\\\\\\"베이\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.issue.寸法列未検出\\\\\\\": \\\\\\\"높이 방향 치수 열을 읽지 못했습니다\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.refusal.階未指定\\\\\\\": \\\\\\\"취입할 층을 골라 주세요\\\\\\\",\\\\r\\\\n  \\\\\\\"planImport.refusal.他階部材あり通り芯変更不可\\\\\\\": \\\\\\\"다른 층에 부재가 있어 通り芯(기준선)을 바꿀 수 없습니다\\\\\\\",\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_21\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'rg -n \\\\\\\"RebarRole|QuantityLine|roleLabel|display.*role|to.*rol