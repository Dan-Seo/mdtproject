c/locales/ko.json:156:  \\\\\\\"takeoff.splicePosition\\\\\\\": \\\\\\\"継手 위치는 標準仕様書 表5.3.3이 원문에서 이미지라 미확정입니다 — 개소수와 설계길이만 계상하고 3D에는 그리지 않습니다\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:157:  \\\\\\\"takeoff.wallOpening\\\\\\\": \\\\\\\"開口部는 입력된 内法寸法만큼 철근을 欠除합니다(数量積算基準 1通則8)・1개소당 内法面積 0.5㎡ 이하는 欠除 없음). 開口補強筋은 같은 항이 「設計図書により計測・計算する」로 위임하므로 계상하지 않습니다 — 개구부가 있는 耐震壁·床板은 그만큼 과소 계상됩니다\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:158:  \\\\\\\"takeoff.cutoffAnchorage\\\\\\\": \\\\\\\"カットオフ筋의 定着은 3D에 그리지 않습니다 — 끝에서 방향이 뒤집혀 설계길이에만 산입합니다(切り止め 위치는 数量積算基準 2（３）梁1)에 따라 設計図書에 의합니다)\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:159:  \\\\\\\"plan.openings.title\\\\\\\": \\\\\\\"開口部(개구부)\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:160:  \\\\\\\"plan.openings.hint\\\\\\\": \\\\\\\"선택한 耐震壁·床板의 개구부입니다. 치수는 건구류 등 개구부의 内法寸法(数量積算基準 1通則8))이고, 위치는 부재 内法 영역의 원점에서 잰 값입니다\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:161:  \\\\\\\"plan.openings.empty\\\\\\\": \\\\\\\"개구부 없음\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:162:  \\\\\\\"plan.openings.add\\\\\\\": \\\\\\\"개구부 추가\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:163:  \\\\\\\"plan.openings.remove\\\\\\\": \\\\\\\"삭제\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:164:  \\\\\\\"plan.openings.x\\\\\\\": \\\\\\\"위치 X\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:165:  \\\\\\\"plan.openings.y\\\\\\\": \\\\\\\"위치 Y\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:166:  \\\\\\\"plan.openings.width\\\\\\\": \\\\\\\"内法 폭\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:167:  \\\\\\\"plan.openings.height\\\\\\\": \\\\\\\"内法 높이\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:168:  \\\\\\\"plan.openings.select\\\\\\\": \\\\\\\"耐震壁 또는 床板을 선택하면 개구부를 입력할 수 있습니다\\\\\\\",\\\\r\\\\nsrc/locales/ko.json:169:  \\\\\\\"plan.openings.ignored\\\\\\\": \\\\\\\"内法面積 0.5㎡ 이하 — 欠除 없음\\\\\\\",\\\\r\\\\nsrc/locales/ja.json:65:  \\\\\\\"takeoff.rebar\\\\\\\": \\\\\\\"鉄筋\\\\\\\",\\\\r\\\\nsrc/locales/ja.json:66:  \\\\\\\"takeoff.diameter\\\\\\\": \\\\\\\"径\\\\\\\",\\\\r\\\\nsrc/locales/ja.json:67:  \\\\\\\"takeoff.shape\\\\\\\": \\\\\\\"形状\\\\\\\",\\\\r\\\\nsrc/local