entry.label}`,\\\\r\\\\n      grid: { xSpans: [6000], ySpans: [6000] },\\\\r\\\\n      stories: [STORY],\\\\r\\\\n      sections: [section],\\\\r\\\\n      members: [member],\\\\r\\\\n      unitMass: entry.unitMassKgPerM,\\\\r\\\\n    }\\\\r\\\\n    const span: WallSpan = {\\\\r\\\\n      axis: 'X',\\\\r\\\\n      clearLengthMm: 5200,\\\\r\\\\n      clearHeightMm: 3450,\\\\r\\\\n      startFaceOffsetMm: 400,\\\\r\\\\n      endFaceOffsetMm: 400,\\\\r\\\\n      girderDepthAboveMm: 750,\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    return {\\\\r\\\\n      project,\\\\r\\\\n      rebars: generateWallRebar({ member, section, span }, jpMlitRulePack),\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  function slabInput(entry: OpeningReinforcementCase) {\\\\r\\\\n    const base = slabRunFor([6000], 'X', slabSection())\\\\r\\\\n    const original = base.project.members.find(({ kind }) => kind === '床板')!\\\\r\\\\n    const project: Project = {\\\\r\\\\n      ...base.project,\\\\r\\\\n      unitMass: entry.unitMassKgPerM,\\\\r\\\\n      members: base.project.members.map((member) =>\\\\r\\\\n        member.id === original.id\\\\r\\\\n          ? {\\\\r\\\\n              ...member,\\\\r\\\\n              openings: [\\\\r\\\\n                {\\\\r\\\\n                  id: `${entry.id}-opening`,\\\\r\\\\n                  xMm: 2400,\\\\r\\\\n                  yMm: 2400,\\\\r\\\\n                  widthMm: 1200,\\\\r\\\\n                  heightMm: 1200,\\\\r\\\\n                  reinforcements: entry.reinforcements,\\\\r\\\\n                },\\\\r\\\\n              ],\\\\r\\\\n            }\\\\r\\\\n          : member,\\\\r\\\\n      ),\\\\r\\\\n    }\\\\r\\\\n    const member = project.members.find(({ kind }) => kind === '床板')!\\\\r\\\\n\\\\r\\\\n    return {\\\\r\\\\n      project,\\\\r\\\\n      rebars: generateSlabRebar(\\\\r\\\\n        { run: slabRun(project, member, 'X'), section: slabSection() },\\\\r\\\\n        jpMlitRulePack,\\\\r\\\\n      ),\\\\r\\\\n    }\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  it.each(openingReinforcementCases)('$id — $handDerivation', (entry) => {\\\\r\\\\n    const generated =\\\\r\\\\n      entry.memberKind === '耐震壁' ? wallInput(entry) : slabInput(entry)\\\\r\\\\n    const reinforcementRebars = generated.rebars.filter(\\\\r\\\\n      ({ role }) => role === '開口補強筋',\\\\r\\\\n    )\\\\r\\\\n    const reinforcementLines = massLines(\\\\r\\\\n      aggregateQuantity(generated.project, generated.rebars, jpMlitRulePack),\\\\r\\\\n    ).filter(({ role }) => role === '開口補強筋')\\\\r\\\\n\\\\r\\\\n    expect(reinforcementRebars).toHaveLength(entry.expected.length)\\\\r\\\\n    expect(reinforcementLines).toHaveLength(entry.expected.length)\\\\r\\\\n\\\\r\\\\n    for (const expected of entry.expected) {\\\\r\\\\n      const rebar = reinforcementRebars.find(\\\\r\\\\n        ({ size }) => size === expected.size,\\\\r\\\\n      )!\\\\r\\\\n      const line = reinforcementLines.find(\\\\r\\\\n        ({ size }) => size === expected.size,\\\\r\\\\n      )!\\\\r\\\\n\\\\r\\\\n      expect(rebar).toMatchObject({\\\\r\\\\n        role: '開口補強筋',\\\\r\\\\n        size: expected.size,\\\\r\\\\n        count: expected.count,\\\\r\\\\n        length: expected.lengthMm,\\\\r\\\\n        shape: 'straight',\\\\r\\\\n        points: [\\\\r\\\\n          [0, 0, 0],\\\\r\\\\n          [expected.lengthMm, 0, 0],\\\\r\\\\n        ],\\\\r\\\\n        closed: false,\\\\r\\\\n        ruleHits: [],\\\\r\\\\n      })\\\\r\\\\n      expect(rebar).not.toHaveProperty('zones')\\\\r\\\\n      expect(rebar).not.toHaveProperty('placement')\\\\r\\\\n      expect(roleToLayer(rebar.role)).toBe('hidden')\\\\r\\\\n      expect(rebarSegments(rebar, columnSection())).toEqual([])\\\\r\\\\n      expect(\\\\r\\\\n        rebarBatches(\\\\r\\\\n          [{ rowId: rebar.id, rebar }],\\\\r\\\\n          columnSection(),\\\\r\\\\n        ),\\\\r\\\\n      ).toEqual([])\\\\r\\\\n      expect(rebar.formula).toContain('設計図書転記')\\\\r\\\\n      expect(rebar.formula).toContain('1通則8)')\\\\r\\\\n      expect(line.countPerMember).toBe(expected.count)\\\\r\\\\n      expect(line.lengthMm).toBe(expected.lengthMm)\\\\r\\\\n      expect(line.unitMassKgPerM).toBe(\\\\r\\\\n        entry.unitMassKgPerM[expected.size] ?? null,\\\\r\\\\n      )\\\\r\\\\n      if (expected.designKg === null) {\\\\r\\\\n        expect(line.designKg, entry.handDerivation).toBeNull()\\\\r\\\\n      } else {\\\\r\\\\n        expect(line.designKg, entry.handDerivation).toBeCloseTo(\\\\r\\\\n          expected.designKg,\\\\r\\\\n          10,\\\\r\\\\n        )\\\\r\\\\n      }\\\\r\\\\n      if (expected.requiredKg === null) {\\\\r\\\\n        expect(line.requiredKg, entry.handDerivation).toBeNull()\\\\r\\\\n      } else {\\\\r\\\\n        expect(line.requiredKg, entry.handDerivation).toBeCloseTo(\\\\r\\\\n          expected.requiredKg,\\\\r\\\\n          10,\\\\r\\\\n        )\\\\r\\\\n      }\\\\r\\\\n    }\\\\r\\\\n  })\\\\r\\\\n\\\\r\\\\n  it('does not add a rule-pack entry for transcribed reinforcement values', () => {\\\\r\\\\n    expect(\\\\r\\\\n      jpMlitRulePack.entries.filter(({ key }) =>\\\\r\\\\n        key.startsWith('measure.opening.reinforcement'),\\\\r\\\\n      ),\\\\r\\\\n    ).toEqual([])\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_45\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '$p='\\\\\\\"'src/lib/hooks/useTakeoff.ts'; \\\\\\\"'$lines=Get-Content -Encoding utf8 $p; $lines[1..160]'\\\",\\\"aggregated_output\\\":\\\"\\\\r\\\\nimport { useMemo } from 'react'\\\\r\\\\n\\\\r\\\\nimport type { Rebar } from '@/domain/model/rebar'\\\\r\\\\nimport {\\\\r\\\\n  beamDepthAbove,\\\\r\\\\n  columnEnds,\\\\r\\\\n  findSection,\\\\r\\\\n  girderRun,\\\\r\\\\n  slabRun,\\\\r\\\\n  storyNotFound,\\\\r\\\\n  wallSpan,\\\\r\\\\n  type GirderRun,\\\\r\\\\n  type Project,\\\\r\\\\n  type SlabRun,\\\\r\\\\n} from '@/domain/model/project'\\\\r\\\\nimport {\\\\r\\\\n  MemberUnsupportedError,\\\\r\\\\n  type UnsupportedReason,\\\\r\\\\n} from '@/domain/model/unsupported'\\\\r\\\\nimport {\\\\r\\\\n  aggregateQuantity,\\\\r\\\\n  hasUnverified as getHasUnverified,\\\\r\\\\n  inferredRules as getInferredRules,\\\\r\\\\n  unverifiedRules as getUnverifiedRules,\\\\r\\\\n  type QuantityLine,\\\\r\\\\n} from '@/domain/quantity'\\\\r\\\\nimport { generateColumnRebar } from '@/domain/rebar/column'\\\\r\\\\nimport { generateGirderRebar } from '@/domain/rebar/girder'\\\\r\\\\nimport { generateSlabRebar } from '@/domain/rebar/slab'\\\\r\\\\nimport { generateWallRebar } from '@/domain/rebar/wall'\\\\r\\\\nimport type { RuleHit } from '@/domain/rules/types'\\\\r\\\\nimport { useAppStore } from '@/lib/store'\\\\r\\\\nimport { jpMlitRulePack } from '@/rulepack'\\\\r\\\\n\\\\r\\\\nexport interface TakeoffResult {\\\\r\\\\n  rebars: Rebar[]\\\\r\\\\n  lines: QuantityLine[]\\\\r\\\\n  /** `stated` 가 아닌 근거가 하나라도 있는가 — 워터마크·경고의 스위치 (ADR-015) */\\\\r\\\\n  hasUnverified: boolean\\\\r\\\\n  /** 独立検討 대기분까지 포함한 전부 */\\\\r\\\\n  unverifiedRules: RuleHit[]\\\\r\\\\n  /** 그중 원문에 값이 아예 없는 것만 — 텔레메트리가 쓰는 좁은 목록 */\\\\r\\\\n  inferredRules: RuleHit[]\\\\r\\\\n  unsupportedMembers: UnsupportedMember[]\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport interface UnsupportedMember {\\\\r\\\\n  memberId: string\\\\r\\\\n  mark: string\\\\r\\\\n  storyName: string\\\\r\\\\n  reason: UnsupportedReason\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/**\\\\r\\\\n * `Project`는 갱신될 때마다 통째로 교체되므로 참조가 곧 버전이다. 직전 결과 하나만\\\\r\\\\n * 들고 있으면 같은 버전을 보는 모든 소비자(TakeoffPane·TakeoffActions·Viewer3D)가\\\\r\\\\n * 한 번의 계산을 나눠 쓴다. `useMemo`만으로는 컴포넌트마다 따로 계산한다.\\\\r\\\\n */\\\\r\\\\nlet lastComputed: { project: Project; result: TakeoffResult } | null = null\\\\r\\\\n\\\\r\\\\nfunction computeTakeoff(project: Project): TakeoffResult {\\\\r\\\\n  if (lastComputed !== null && lastComputed.project === project) {\\\\r\\\\n    return lastComputed.result\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const result = buildTakeoff(project)\\\\r\\\\n  lastComputed = { project, result }\\\\r\\\\n  return result\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nexport function useTakeoff(): TakeoffResult {\\\\r\\\\n  const project = useAppStore(({ project }) => project)\\\\r\\\\n\\\\r\\\\n  return useMemo(() => computeTakeoff(project), [project])\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction buildTakeoff(project: Project): TakeoffResult {\\\\r\\\\n  const rebars: Rebar[] = []\\\\r\\\\n  const unsupportedMembers: UnsupportedMember[] = []\\\\r\\\\n  const processedGirderMemberIds = new Set<string>()\\\\r\\\\n  // 床板は方向ごとに別のランを持つ — X で処理済みでも Y はこれからだ。\\\\r\\\\n  const processedSlabRunKeys = new Set<string>()\\\\r\\\\n\\\\r\\\\n  for (const member of project.members) {\\\\r\\\\n    if (\\\\r\\\\n      member.kind === '大梁' &&\\\\r\\\\n      processedGirderMemberIds.has(member.id)\\\\r\\\\n    ) {\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    const section = findSection(project, member.sectionId)\\\\r\\\\n    const story = project.stories.find(({ id }) => id === member.storyId)\\\\r\\\\n    if (!story) {\\\\r\\\\n      throw storyNotFound(member.storyId)\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    if (member.kind === '柱') {\\\\r\\\\n      if (section.kind !== '柱') {\\\\r\\\\n        throw new Error(`柱 member references a non-柱 section: ${member.id}`)\\\\r\\\\n      }\\\\r\\\\n\\\\r\\\\n      // 柱도 大梁과 같다 — 성립 불가 형상은 그 부재만 빼고 계속한다.\\\\r\\\\n      try {\\\\r\\\\n        rebars.push(\\\\r\\\\n          ...generateColumnRebar(\\\\r\\\\n            {\\\\r\\\\n              member,\\\\r\\\\n              section,\\\\r\\\\n              story,\\\\r\\\\n              beamDepthAbove: beamDepthAbove(project, member),\\\\r\\\\n              ends: columnEnds(project, member),\\\\r\\\\n            },\\\\r\\\\n            jpMlitRulePack,\\\\r\\\\n          ),\\\\r\\\\n        )\\\\r\\\\n      } catch (error) {\\\\r\\\\n        if (!(error instanceof MemberUnsupportedError)) throw error\\\\r\\\\n\\\\r\\\\n        unsupportedMembers.push({\\\\r\\\\n          memberId: member.id,\\\\r\\\\n          mark: section.mark,\\\\r\\\\n          storyName: story.name,\\\\r\\\\n          reason: error.reason,\\\\r\\\\n        })\\\\r\\\\n      }\\\\r\\\\n      continue\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    if (member.kind === '床板') {\\\\r\\\\n      if (section.kind !== '床板') {\\\\r\\\\n        throw new Error(`床板 member references a non-床板 section: ${member.id}`)\\\\r\\\\n      }\\\\r\\\\n\\\\r\\\\n      // 床板は X方向・Y方向で別々のランになる。大梁と同じくランごとに1回だけ\\\\r\\\\n      // 生成し、成立しない寸法・定着はそのラン全体を落として続ける。\\\\r\\\\n      for (const axis of ['X', 'Y'] as const) {\\\\r\\\\n        if (processedSlabRunKeys.has(`${axis}|${member.id}`)) continue\\\\r\\\\n\\\\r\\\\n        let run: SlabRun | undefined\\\\r\\\\n        try {\\\\r\\\\n          run = slabRun(project, member, axis)\\\\r\\\\n          for (const runMember of run.members) {\\\\r\\\\n            processedSlabRunKeys.add(`${axis}|${runMember.id}`)\\\\r\\\\n          }\\\\r\\\\n\\\\r\\\\n          rebars.push(\\\\r\\\\n            ...generateSlabRebar({ run, section }, jpMlitRulePack),\\\\r\\\\n          )\\\\r\\\\n        } catch (error) {\\\\r\\\\n          if (!(error instanceof MemberUnsupportedError)) throw error\\\\r\\\\n\\\\r\\\\n          for (const runMember of run?.members ?? [member]) {\\\\r\\\\n            processedSlabRunKeys.add(`${axis}|${runMember.id}`)\\\\r\\\\n            unsupportedMembers.push({\\\\r\\\\n              memberId: runMember.id,\\\\r\\\\n              mark: section.mark,\\\\r\\\\n              storyName: story.name,\\\\r\\\\n              reason: error.reason,\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_46\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command '$p='\\\\\\\"'src/lib/viewer/geometry.test.ts'; \\\\\\\"'$lines=Get-Content -Encoding utf8 $p; $lines[1290..1340]; $p='\\\\\\\"'src/lib/viewer/building.test.ts'; \\\\\\\"'$lines=Get-Content -Encoding utf8 $p; $lines[1..120]'\\\",\\\"aggregated_output\\\":\\\"   */\\\\r\\\\n  it('makes no segment out of a path whose points coincide', () => {\\\\r\\\\n    const stuck: Rebar = {\\\\r\\\\n      ...main,\\\\r\\\\n      id: 'stuck',\\\\r\\\\n      points: [main.points[0], main.points[0]],\\\\r\\\\n    }\\\\r\\\\n\\\\r\\\\n    expect(rebarSegments(stuck, section)).toHaveLength(0)\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\ndescribe('roleToLayer', () => {\\\\r\\\\n  it.each([\\\\r\\\\n    ['主筋', 'main'],\\\\r\\\\n    ['上端筋', 'main'],\\\\r\\\\n    ['下端筋', 'main'],\\\\r\\\\n    ['上端カットオフ筋', 'main'],\\\\r\\\\n    ['下端カットオフ筋', 'main'],\\\\r\\\\n    ['帯筋', 'hoop'],\\\\r\\\\n    ['あばら筋', 'hoop'],\\\\r\\\\n    ['幅止め筋', 'hoop'],\\\\r\\\\n    ['腹筋', 'main'],\\\\r\\\\n    ['X方向上端筋', 'main'],\\\\r\\\\n    ['X方向下端筋', 'main'],\\\\r\\\\n    ['Y方向上端筋', 'main'],\\\\r\\\\n    ['Y方向下端筋', 'main'],\\\\r\\\\n  ] satisfies [RebarRole, 'main' | 'hoop'][])(\\\\r\\\\n    'maps %s to %s',\\\\r\\\\n    (role, expected) => {\\\\r\\\\n      expect(roleToLayer(role)).toBe(expected)\\\\r\\\\n    },\\\\r\\\\n  )\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\ndescribe('easeOutCubic', () => {\\\\r\\\\n  it('eases from 0 to 1 and clamps outside the range', () => {\\\\r\\\\n    expect(easeOutCubic(0)).toBe(0)\\\\r\\\\n    expect(easeOutCubic(1)).toBe(1)\\\\r\\\\n    expect(easeOutCubic(0.5)).toBeCloseTo(0.875)\\\\r\\\\n    expect(easeOutCubic(-1)).toBe(0)\\\\r\\\\n    expect(easeOutCubic(2)).toBe(1)\\\\r\\\\n  })\\\\r\\\\n})\\\\r\\\\n\\\\r\\\\ndescribe('lerpCameraFit', () => {\\\\r\\\\n  const from: CameraFit = { position: [0, 0, 0], target: [10, 10, 10] }\\\\r\\\\n  const to: CameraFit = { position: [100, 200, 300], target: [30, 10, 50] }\\\\r\\\\n\\\\r\\\\n  it('returns the endpoints at t=0 and t=1 and blends between', () => {\\\\r\\\\n    expect(lerpCameraFit(from, to, 0)).toEqual(from)\\\\r\\\\n\\\\r\\\\nimport type { GirderSection, Member } from '@/domain/model/member'\\\\r\\\\nimport { createSampleProject } from '@/domain/model/sample-project'\\\\r\\\\nimport {\\\\r\\\\n  findSection,\\\\r\\\\n  girderRun,\\\\r\\\\n  girderSpan,\\\\r\\\\n  gridPoint,\\\\r\\\\n  gridPointCount,\\\\r\\\\n  storyElevation,\\\\r\\\\n  type Project,\\\\r\\\\n} from '@/domain/model/project'\\\\r\\\\nimport type { Rebar } from '@/domain/model/rebar'\\\\r\\\\nimport { generateGirderRebar } from '@/domain/rebar/girder'\\\\r\\\\nimport { jpMlitRulePack } from '@/rulepack'\\\\r\\\\n\\\\r\\\\nimport {\\\\r\\\\n  buildingLayout,\\\\r\\\\n  groupInstancesByLayerAndRadius,\\\\r\\\\n  type RebarInstance,\\\\r\\\\n} from './building'\\\\r\\\\nimport { rebarRadius, rebarSegments } from './geometry'\\\\r\\\\n\\\\r\\\\nconst project = createSampleProject()\\\\r\\\\nconst noUnsupportedMembers = new Set<string>()\\\\r\\\\n\\\\r\\\\n// geometry.test.ts와 같은 대표 배근 픽스처 — memberId만 X2Y2(그리드 중앙)로 잡는다.\\\\r\\\\nconst main: Rebar = {\\\\r\\\\n  id: '1F-X2Y2|main',\\\\r\\\\n  memberId: '1F-X2Y2',\\\\r\\\\n  role: '主筋',\\\\r\\\\n  size: 'D25',\\\\r\\\\n  shape: 'straight',\\\\r\\\\n  points: [\\\\r\\\\n    [40, -875, 40],\\\\r\\\\n    [40, 5200, 40],\\\\r\\\\n  ],\\\\r\\\\n  closed: false,\\\\r\\\\n  length: 6080,\\\\r\\\\n  count: 12,\\\\r\\\\n  ruleHits: [],\\\\r\\\\n  formula: 'test',\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nconst hoop: Rebar = {\\\\r\\\\n  id: '1F-X2Y2|hoop',\\\\r\\\\n  memberId: '1F-X2Y2',\\\\r\\\\n  role: '帯筋',\\\\r\\\\n  size: 'D13',\\\\r\\\\n  shape: 'hoop',\\\\r\\\\n  points: [\\\\r\\\\n    [40, 0, 40],\\\\r\\\\n    [760, 0, 40],\\\\r\\\\n    [760, 0, 760],\\\\r\\\\n    [40, 0, 760],\\\\r\\\\n  ],\\\\r\\\\n  closed: true,\\\\r\\\\n  length: 3040,\\\\r\\\\n  // 帯筋 전개는 도메인 배치를 따르므로 本数와 内法이 서로 맞아야 한다\\\\r\\\\n  // (@100 × 内法 200 → 0·100·200의 3본).\\\\r\\\\n  count: 3,\\\\r\\\\n  placement: {\\\\r\\\\n    axis: 'y',\\\\r\\\\n    clearMm: 200,\\\\r\\\\n    pitchMm: 100,\\\\r\\\\n    startOffsetMm: 0,\\\\r\\\\n    lastGapMm: 100,\\\\r\\\\n    positionCount: 3,\\\\r\\\\n  },\\\\r\\\\n  ruleHits: [],\\\\r\\\\n  formula: 'test',\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction girderFixture(\\\\r\\\\n  source: Project,\\\\r\\\\n  memberId: string,\\\\r\\\\n): { member: Member; section: GirderSection; rebars: Rebar[] } {\\\\r\\\\n  const member = source.members.find(({ id }) => id === memberId)\\\\r\\\\n  if (\\\\r\\\\n    member?.kind !== '大梁' ||\\\\r\\\\n    !('axis' in member.position)\\\\r\\\\n  ) {\\\\r\\\\n    throw new Error(`大梁 not found: ${memberId}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  const section = findSection(source, member.sectionId)\\\\r\\\\n  if (section.kind !== '大梁') {\\\\r\\\\n    throw new Error(`大梁 member references a non-大梁 section: ${memberId}`)\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  return {\\\\r\\\\n    member,\\\\r\\\\n    section,\\\\r\\\\n    rebars: generateGirderRebar(\\\\r\\\\n      { run: girderRun(source, member), section },\\\\r\\\\n      jpMlitRulePack,\\\\r\\\\n    ),\\\\r\\\\n  }\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\nfunction roleRebar(rebars: Rebar[], role: Rebar['role']): Rebar {\\\\r\\\\n  const rebar = rebars.find((candidate) => candidate.role === role)\\\\r\\\\n  if (!rebar) throw new Error(`${role} not found`)\\\\r\\\\n  return rebar\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\ndescribe('buildingLayout', () => {\\\\r\\\\n  it('creates one concrete box per member of the sample project', () => {\\\\r\\\\n    const layout = buildingLayout(project, [], noUnsupportedMembers)\\\\r\\\\n    const { nx, ny } = gridPointCount(project.grid)\\\\r\\\\n    const columnCount = nx * ny * project.stories.length\\\\r\\\\n    const girderCount =\\\\r\\\\n      ((nx - 1) * ny + nx * (ny - 1)) * project.stories.length\\\\r\\\\n    // 床板は通り芯で囲まれたベイの数だけある (ADR-028)。\\\\r\\\\n    const slabCount = (nx - 1) * (ny - 1) * project.stories.length\\\\r\\\\n    // 耐震壁はグリッドから導けない — サンプルが1階あたり1枚だけ置いているので\\\\r\\\\n    // (ADR-025)、実際に置かれた数を数える。\\\\r\\\\n    const wallCount = project.members.filter(\\\\r\\\\n      ({ kind }) => kind === '耐震壁',\\\\r\\\\n    ).length\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_47\\\",\\\"type\\\":\\\"todo_list\\\",\\\"items\\\":[{\\\"text\\\":\\\"이전 step 및 대상 경로 대조\\\",\\\"completed\\\":true},{\\\"text\\\":\\\"開口補強筋 입력 UI와 locale/test 추가\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"고지 문면 전환 및 표시 경로 점검\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"R14 대장·phase 보고서·index 갱신\\\",\\\"completed\\\":false},{\\\"text\\\":\\\"전체 게이트 실행 및 커밋\\\",\\\"completed\\\":false}]}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_48\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'rg -n -C 3 \\\\\\\"R14|開口補強筋 입력|남은 것.*開口|잔여.*開口|開口補強筋을\\\\\\\" AGENTS.md CLAUDE.md docs/RISKS.md docs/MILESTONES.md'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_49\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'rg -n -C 2 \\\\\\\"roleToLayer|role.*hidden|開口補強筋\\\\\\\" src/lib/viewer/building.test.ts src/components/viewer/Viewer3D.test.tsx src/lib/viewer/geometry.test.ts'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_48\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'rg -n -C 3 \\\\\\\"R14|開口補強筋 입력|남은 것.*開口|잔여.*開口|開口補強筋을\\\\\\\" AGENTS.md CLAUDE.md docs/RISKS.md docs/MILESTONES.md'\\\",\\\"aggregated_output\\\":\\\"docs/RISKS.md-14-- **R10 (断面リスト 파서 포맷 과적합)** 파서가 실물 3부의 표 형식에 과적합돼 있다. 미지 형식은 값을 지어내지 않고 빈 후보 배열로 정직하게 실패하지만, 사용자에게는 단순히 「인식 불가」로 보인다. 도면 수집을 계속해 커버리지를 넓혀야 하나 실패 도면은 사용자 동의 없이 수집할 수 없으므로, R3(일본 사용자 접점 0)과 결합된 리스크다. 주기형(스케치 인출선) 壁リスト(yokohama-p15)는 표 파서 범위 밖이라 후보를 내지 않는다\\\\r\\\\ndocs/RISKS.md-15-- **R12 (帯筋·あばら筋 加工形状에 フック 미반영)** `column.ts`·`girder.ts`가 그리는 帯筋/あばら筋 `points`는 加工用かぶり만 공제한 사각형이라 135°フック余長(`bend.hook135` 6d)이 없다. **数量은 영향 없다** — 1通則2)가 「フックはないものとする」로 정하므로 設計長さ는 断面周長이고 그게 옳다(ADR-019). 문제는 3D다: `points`는 実形状의 유일한 출처인데(`src/domain/model/rebar.ts`) 실물에 있는 フック이 화면에 없다. `bend.hook135`는 룰팩에 실려 있으나 프로덕션 코드가 조회하지 않는다(테스트와 설명 주석만 참조). 加工長 픽스처가 두 케이스를 `status: deviation-from-source`로 대장에 올리고(`quantity-r5-ch3.json`의 status 대장과 같은 방식) `deviation`에 빠진 항(`hook135`)·차액(156mm)·余長까지 넣은 값(柱帯筋 2956·あばら筋 2056)을 적는다 — 그 픽스처가 고정하는 것은 「지금 그려지는 폐합 둘레」이지 「옳은 実形状」이 아니다. 골든테스트가 `expected + missingMm == withHookTailMm`를 확인하므로 대장이 구현과 따로 놀 수 없다. 다만 `withHookTailMm`는 余長만 더한 하한이고 表5.3.1 折曲げ内法直径에 따른 曲げ部 신장은 별도다. 그리기로 결정하더라도 근거값이 M0 이미지 판독(`imageRead: true`)이라 `inferred` ▲가 붙는다 (2026-08-21 식별)\\\\r\\\\ndocs/RISKS.md-16-- **R13 (해소 — 端部 좌우 비대칭 입력 경로)** 「Y3端／Y4端」·「外端／内端」처럼 좌우 端部의 主筋 本数가 다른 표를 `girderMainAsymmetric` 후보로 보존하고, `Grid` 축 라벨의 정확 일치·축 순서 자동 결정 또는 사용자 선택으로 断面リスト 취입에 반영한다. 断面一覧 편집에서도 始端·終端을 직접 입력할 수 있다(ADR-032·ADR-033, phase 21). **잔여**: 다스팬×비대칭은 의도적 불성립, カットオフ 좌우 상이 치수는 미지원, 始端/終端 본수의 누적 집합(nesting) 해석은 조문 밖 판단이므로 `inferred` 성격의 R2로 남긴다\\\\r\\\\ndocs/RISKS.md:17:- **R14 (해소 — 開口部 欠除)** `数量積算基準` 1通則8)은 開口部에 의한 鉄筋의 欠除를 「建具類等開口部の内法寸法による、ただし1か所当たり内法面積0.5㎡以下は欠除なし」로 정하고 開口補強筋은 「設計図書により計測・計算する」로 위임한다. 2026-08-22까지는 開口의 위치·치수를 받는 입력이 없어 개구가 있는 벽·床板이 **과대 계상**됐다 — 이 프로젝트가 못 견디는 실패(「틀린 채로 완성된 것」)의 첫 자리라 빈칸으로 두지 않고 内訳書에 상시 고지를 세워 두었다. **`Member.openings` 입력과 `openingDeduction`으로 닫혔다 (ADR-029)** — 픽스처의 `1通則8)`이 `deferred`에서 `covered`로 넘어갔고, 고지는 지우지 않고 **문면을 뒤집었다**. **잔여 하나**: 開口補強筋을 계상하지 않으므로 개구가 있는 부재는 이제 **과소** 계상이다. 조문이 값을 주지 않고 設計図書에 위임하므로 제품이 지어낼 수 없고(2（３）梁1)·2（４）床板1)의 「補強筋等は設計図書による」와 같은 취급), 닫으려면 도면에서 읽은 補強筋을 그대로 옮겨 적는 입력이 필요하다. **판정에 남은 읽기**: 「어느 본이 欠けるか」를 원문이 말하지 않아 1通則7)의 割付을 위치로 읽었다 — 세는 시작 끝이 정해져 있지 않아 개구가 부재 중앙에 없을 때 1본 차가 날 수 있다 (R2)\\\\r\\\\ndocs/RISKS.md-18-- **R15 (열림 — 合計이 확인되지 않은 축의 검산 공회전)** `totalConfirmed === false`인 축은 合計 검산이 없지만, 모두 스팬이 둘 이상이라 남는 방어는 **실측된 창의 중점 매칭(±15pt) ＋ 축척 일관성**이다. 14면으로 넓힌 sweep에서 유효 격자는 13축, 그중 `false`는 7축(yokohama-p6 X·Y, p7 X·Y, p8 X, p9 Y 2축)이었고 안전 창은 이전과 같은 **6pt 이상 30pt 미만**이었다: 4pt에서는 kani-p38·p39·yokohama-p6·p7의 Y 치수가 빠져 `寸法欠落`, 30pt부터는 yokohama-p7의 오탐이 들어와 `合計不一致`가 발생했다. 채택 치수의 `alongDistance` 최댓값은 5.803722pt(yokohama-p6 Y)로 조금 늘었고, `false` 7축의 최근접 미사용 경쟁 치수 최솟값은 140.325470pt(yokohama-p7 X)로 유지됐다. 세로 문턱도 같은 열 인접 1,697쌍의 최솟값이 1.000000이고 1.5~2.0 구간은 1쌍뿐이었으며, 배수 1.0의 0mm 가드는 기존 40건을 포함해 69건 발화했다. 가로 gapRatio 0.5의 0mm 발화는 여전히 yokohama-p14의 4건뿐이다. 따라서 R15를 닫지 않는다 — 면은 14개로 늘었지만 伏図를 가진 발주처는 여전히 2곳뿐이므로, 다른 발주처의 실도면에서도 이 여유와 창이 유지되는지 확인해야 한다\\\\r\\\\ndocs/RISKS.md-19-- **R11 (리뷰 게이트가 자기를 못 지킨다)** `pull_request` 워크플로는 PR 브랜치 판으로 실행되므로 `.github/workflows/review.yml` 과 `scripts/ci/*` 를 고치는 PR 은 자기 게이트를 무력화해 무리뷰 자동 머지를 낼 수 있다. **워크플로 안의 수정으로는 닫히지 않는다** — `ref: base.sha` 든 `git checkout base -- scripts/ci/` 든 그 줄 자체가 PR 통제 파일에 있다. 실질 방어는 단독 writer 라는 사실 하나뿐이다(포크 PR 은 읽기 전용 토큰이라 무해). main 브랜치 보호에 `required_pull_request_reviews` 는 걸려 있지 않고 `enforce_admins: false` 다. 닫으려면 gate 와 scope 를 **함께** `workflow_run` 으로 옮겨 기본 브랜치 판 고정 실행해야 한다 — gate 만 옮기면 PR 이 통제하는 scope 잡이 봇 명의·같은 커밋의 위조 마커를 게시해 `review-verdict.sh` 의 작성자·커밋 검사를 그대로 통과한다. **두 번째 writer 가 생기는 시점의 조건부 과제**로 둔다 (2026-08-19 판단)\\\\r\\\\n--\\\\ndocs/MILESTONES.md-10-- [ ] **M3c** — 진행 중. 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다\\\\ndocs/MILESTONES.md-11-- [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `girderMainAsymmetric` 후보로 보존하고 phase 21에서 Grid 축 순서 자동 또는 사용자 선택으로 始端/終端에 반영한다. 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 좌우 상이 8칸은 방향 미선택을 기본으로 유지한 비대칭 후보로 반영 단계에 넘겼다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 고강도 전단보강근·円形柱 표현, 階 라벨과 제품 Story 대응, `カットオフ` 값 반영 — 位置 열이 있는 3란 표는 phase 21에서 취입까지 닫혔고, 위치 없는 반폭 표기는 원문 `raw` 보존까지. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\\\\ndocs/MILESTONES.md-12-   - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — 断面リスト 취입에서 좌우 비대칭 主筋의 始端/終端 대응에 사용한다. ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조)\\\\ndocs/MILESTONES.md:13:- [ ] **부재 확장(耐震壁·床板)** — 진행 중 (2026-08-22 착수, ADR-025·ADR-028). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **남은 것**: 開口補強筋 입력(1通則8)이 設計図書에 위임 — 지금은 계상하지 않아 개구가 있는 부재가 과소 계상되고 内訳書가 상시 고지한다), 断面リスト 파서의 壁リスト·スラブリスト 대응(현재 손입력 전용), 平面 뷰에서 벽·床板을 놓고 지우는 입력(지금은 표시만), 片持床板(형상 입력이 선결)\\\\ndocs/MILESTONES.md-14-- [ ] **일본 고유 형태·제품 확장** — 진행 중 (2026-08-22 착수). 후보를 두 원문 전수 검색으로 재고 4개를 골랐다. **끝난 것**: ① **高強度せん断補強筋**(K13·S13, ADR-026) — `帯筋`·`あばら筋` 전용 呼び名이다. 두 원문에 「高強度」·「大臣認定」이 **0건**인데도 만들 수 있는 이유는 1通則2)가 フープ 長さ를 断面周長으로 정해 **径으로 引는 룰팩 행이 帯筋에 하나도 없기** 때문이다 — 룰팩 신규 행 0. 主筋·壁筋은 定着·重ね継手를 径으로 引으므로 타입(`ShearBarSize`)이 막는다. 断面リスト 파서도 읽는다. ② **円形柱**(ADR-027) — 1通則2)의 「断面の設計寸法による周長」이 円形에서는 원주 π×直径이다. 조문이 형상을 矩形으로 한정하지 않으므로 여기서도 룰팩 신규 행이 0이다. `ColumnSection.shape`(스키마 v9)로 받고 b·d를 둘 다 直径으로 둔다 — 大梁 内法·3D 柱面·平面 히트영역이 전부 b·d에서 나오므로 外接寸法을 그대로 두면 형상 추가가 계측을 흔들지 않는다. 3D는 円柱와 円形フープ(24각형 作図規則)다. `600φ`도 파싱한다. **スパイラル筋은 만들지 않는다** — 継手·定着이 図5.3.5＝이미지다. **남은 것**: ③ 雑壁(腰壁·垂れ壁·袖壁), ④ 壁式構造の壁(積算基準 2（５）壁**2)**의 端部筋·縦筋·壁梁筋·横筋·補強筋 5구분). **만들지 않는 것**: `免震`(0건, ADR-025)·スパイラル筋의 継手·定着(図5.3.5＝**이미지**라 表5.3.3과 같은 함정)·機械式定着(標準仕様書 5.3.4(ｳ)가 전부 「特記による」라 제품이 가질 값이 없다). `ガス圧接`·`機械式継手`는 M3b에서 이미 끝났다\\\\ndocs/MILESTONES.md-15-- [x] **M4** — 완료 (2026-08-22). 네 갈래다. ① **재방문 경로**: `src/lib/persist/`(IndexedDB 자동저장 500ms 디바운스 ＋ 案件 JSON 저장/불러오기)와 `useProjectPersistence`. 복원 불가한 기록(옛 schemaVersion·끊긴 문자열)은 조용히 버리고 샘플로 착지한다 — 기동 경로라 던지면 지울 방법 없이 화면이 하얘진다. 반대로 사용자가 고른 파일이 안 읽히면 **말한다**(지금 案件은 남긴 채). ② **내역서 양식**: xlsx에 층별 小計 행과 `径別集計` 시트를 넣었다(`sizeSubtotals`는 径마다 독립해서 null이 된다 — 「어느 径이 아직 発注 불가인가」가 이 표의 용도라 欠損이 다른 径을 물들이면 안 된다). ③ **PDF**: 라이브러리 대신 브라우저 인쇄 경로(`@media print` ＋ `window.print()`). 종이도 같은 `WorkbookSpec`에서 나오고, 出典·算出式 두 열은 열 정의의 `printed` 플래그로 뺀다(PDL1.0 의무는 算出根拠 블록이 진다). ④ **glTF(glb)**: `EXT_mesh_gpu_instancing`으로 案件 전체를 낸다. **화면의 표시 반경이 아니라 実寸이다** — `rebarRadius`는 가독성용으로 최소 ⌀14·1.6배로 부풀린 값이라 그대로 내면 D25가 ⌀40으로 실측된다(ADR-024). 스트레스는 `tests/stress/multi-story.test.ts`(5층 45,885 인스턴스)와 실브라우저 `tests/e2e/uc17-stress-building.js`로 잰다. glb에도 出典·改変·ADR-015 경고가 `scene.userData`(＝extras)로 실린다 — 書き出し 경로마다 표시 의무가 면제되지 않는다. **3D를 쓰는 코드는 押した時에 받는다**: 헤더 상주 釦이 `gltf.ts`를 정적 import하면 three가 `/`의 차단 경로로 돌아오는데, Lighthouse 예산은 이것을 통과시킨다(뷰어가 어차피 three를 받으므로 총량이 안 변한다). 확인은 `.next/app-build-manifest.json`의 `pages['/page']`로 한다\\\\ndocs/MILESTONES.md-16-- [ ] **M5** — 한국 실무자 UX 리뷰 반영\\\\n--\\\\nCLAUDE.md-53-| M3b 다스팬·継手 | 완료 | — |\\\\nCLAUDE.md-54-| M3c 고유 상세 | **진행 중** | 幅止め筋·腹筋 완료. パネルゾーン帯筋·溶接閉鎖フープ는 두 원문 0건이라 만들지 않는다 |\\\\nCLAUDE.md-55-| 도면 인식(로컬) | **진행 중** | 断面リスト 트랙(값)·형상 트랙(伏図·軸組図) 둘. 잔여: 표 형식 커버리지, 주기형(스케치 인출선) 壁リスト 미지원, 階 라벨↔`Story` 대응, 위치 없는 `カットオフ` 표기 반영, kani p40 미지원(R10). ADR-018·ADR-030 |\\\\nCLAUDE.md:56:| 부재 확장(耐震壁·床板) | **진행 중** | 開口補強筋 입력, 平面 뷰의 벽·床板 배치·삭제 입력, 片持床板 |\\\\nCLAUDE.md-57-| 일본 고유 형태·제품 | **진행 중** | 高強度せん断補強筋·円形柱 완료. 남은 것은 雑壁·壁式構造の壁 |\\\\nCLAUDE.md-58-| M4 재방문·내역서·PDF·glTF | 완료 | — |\\\\nCLAUDE.md-59-| M5 한국 실무자 UX 리뷰 | 미착수 | — |\\\\n--\\\\nCLAUDE.md-79-| R11 | 조건부 | 리뷰 게이트가 자기를 못 지킨다. 두 번째 writer가 생기는 시점의 과제 |\\\\nCLAUDE.md-80-| R12 | 열림 | 帯筋·あばら筋 `points`에 135°