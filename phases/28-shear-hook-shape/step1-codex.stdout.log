\n    },\r\n    {\r\n      \"id\": \"hook-mandatory-for-shear-bars\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \".cache/001888816.pdf p.32-33 (printed p.27-28), 5.3.2(2)(ｶ): 「帯筋、あばら筋及び幅止め筋」; the clause enumerates these as members whose ends receive hooks\",\r\n      \"note\": \"The standard specification explicitly lists the shear-bar types.\"\r\n    },\r\n    {\r\n      \"id\": \"hook135-tail-is-6d\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \"src/rulepack/jp-mlit/bend.yaml:221-229; tests/golden/fixtures/spec-r7-ch5.json:101-108; bend.hook135 has value 6, unit d, and imageRead true\",\r\n      \"note\": \"The typed part of Table 5.3.1 supplies inside diameters; 6d is recorded as a reading of the image drawing, not a typed-cell transcription.\"\r\n    },\r\n    {\r\n      \"id\": \"note1-text-exists\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \".cache/001888816.pdf p.33 (printed p.28), Table 5.3.1 Note 1: 「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d 以上とする。」\",\r\n      \"note\": \"The note is present in the extractable PDF text.\"\r\n    },\r\n    {\r\n      \"id\": \"note1-is-conditional\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \".cache/001888816.pdf p.33 (printed p.28), Table 5.3.1 Note 1 contains 「用いる場合には」\",\r\n      \"note\": \"The note is conditional on using a 90-degree or 135-degree hook; it does not prescribe that a hook exists at every such location.\"\r\n    },\r\n    {\r\n      \"id\": \"note1-untranscribed\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \"docs/ADR.md:546,615-619 records the note; searches of src/rulepack/** and tests/golden/fixtures/spec-r7-ch5.json found no match for the note wording\",\r\n      \"note\": \"The note is documented in ADR-040 context but is absent from the rulepack and spec-r7-ch5 fixture.\"\r\n    },\r\n    {\r\n      \"id\": \"rect-hoop-closed-today\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \"src/domain/rebar/column.ts:303-321 constructs rectangular hoops from four points and sets closed: true; src/domain/rebar/girder.ts:732-748 does the same for stirrups; circular hoops use the same closed path\",\r\n      \"note\": \"Rectangular shear bars are four-point closed paths, and circular column hoops are also closed.\"\r\n    },\r\n    {\r\n      \"id\": \"deviation-ledger-matches\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \"tests/golden/fixtures/fabrication-length.json:253-260 and :576-583 record missingMm 156, withHookTailMm 2956/2056, and expected 2800/1900; tests/golden/fabrication-length.test.ts:216-228 asserts expected plus missing equals withHookTail\",\r\n      \"note\": \"156mm equals 2 x 6d x 13mm; 2956 = 2800 + 156 and 2056 = 1900 + 156.\"\r\n    },\r\n    {\r\n      \"id\": \"cantilever-rect-single-source\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \"src/domain/model/project.ts:1160-1188 contains cantileverSlabRect; PlanEditor.tsx:17,82,236,512 and src/lib/viewer/building.ts:9,80-86 call it; a temporary freeEdge mutation made both PlanEditor.test.tsx and building.test.ts fail, then the original expression was restored\",\r\n      \"note\": \"Plan and 3D have no duplicate rectangle calculation, and the mutation check showed both consumers depend on the shared function.\"\r\n    },\r\n    {\r\n      \"id\": \"tail-direction-unspecified\",\r\n      \"verdict\": \"upheld\",\r\n      \"evidence\": \".cache/001888816.pdf p.32-33 (printed p.27-28): 5.3.2(2) lists hook targets and Table 5.3.1 lists angle, inside diameter, and Note 1; neither passage specifies which corner or direction receives the hook\",\r\n      \"note\": \"The source specifies hook applicability and dimensions, but not the corner or orientation of a shear-bar hook.\"\r\n    }\r\n  ],\r\n  \"verdict\": \"refuted\"\r\n}\r\n--- fabrication fixture top ---\r\n{\r\n  \"sources\": [\r\n    {\r\n      \"id\": \"spec\",\r\n      \"doc\": \"公共建築工事標準仕様書（建築工事編）\",\r\n      \"edition\": \"令和7年版\",\r\n      \"sha256\": \"8fd3c83ca92b01a26e53071efdb3e871e4b5672583f8473ba062cbcc45759acc\",\r\n      \"url\": \"https://www.mlit.go.jp/gobuild/content/001888816.pdf\",\r\n      \"pageNote\": \"printedPage は紙面の頁番号、pdfPage は PDF の通し頁。この文書では pdfPage ＝ printedPage ＋ 6。\"\r\n    },\r\n    {\r\n      \"id\": \"quantity\",\r\n      \"doc\": \"公共建築数量積算基準\",\r\n      \"edition\": \"令和5年3月29日改定（国営積第8号）\",\r\n      \"sha256\": \"801d7917e81369dd4eac551af76f00aba6fa7d7e8224703f162a0435b46d9a30\",\r\n      \"url\": \"https://www.mlit.go.jp/common/001178206.pdf\",\r\n      \"pageNote\": \"pdfPage ＝ printedPage ＋ 5。加工長そのものは標準仕様書が定めるが、柱主筋の上端で定着を加えないという判定だけはこちらが根拠（R9①）。\"\r\n    }\r\n  ],\r\n  \"scope\": \"3D に描かれる加工形状の長さ（加工長）＝ Rebar.points が描く折れ線の実長。数量積算基準の設計長さ（Rebar.length）とは別物で、一致する必要もない（ADR-019）。設計長さ側は tests/golden/quantity*.test.ts が固定する。継手は位置が未確定なので描かれず、この加工長には入らない。\",\r\n  \"derivedBy\": \"各期待値は下の terms（原文表の独立転写）だけを使った手計算である。lookupRule を通していない（ADR-010）。\",\r\n  \"terms\": [\r\n    {\r\n      \"id\": \"L1\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"表5.3.4\",\r\n      \"printedPage\": 30,\r\n      \"pdfPage\": 36,\r\n      \"label\": \"一般の直線定着長さ L1（注1 — 注2〜4以外の定着）\",\r\n      \"conditions\": {\r\n        \"fc\": 24,\r\n        \"grade\": \"SD345\",\r\n        \"hook\": false\r\n      },\r\n      \"value\": 40,\r\n      \"unit\": \"d\"\r\n    },\r\n    {\r\n      \"id\": \"La\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"表5.3.5\",\r\n      \"printedPage\": 31,\r\n      \"pdfPage\": 37,\r\n      \"label\": \"投影定着長さ La\",\r\n      \"conditions\": {\r\n        \"fc\": 24,\r\n        \"grade\": \"SD345\"\r\n      },\r\n      \"value\": 20,\r\n      \"unit\": \"d\"\r\n    },\r\n    {\r\n      \"id\": \"bentStraightFloor\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"5.3.4(5)(ｲ)(a)\",\r\n      \"printedPage\": 31,\r\n      \"pdfPage\": 37,\r\n      \"label\": \"折曲げ定着の全長は表5.3.4の直線定着の長さ以上\",\r\n      \"quote\": \"折曲げ定着とする場合の全長は、表5.3.4 の直線定着の長さ以上とする。\",\r\n      \"conditions\": {\r\n        \"detail\": \"折曲げ定着\"\r\n      },\r\n      \"referencesTerm\": \"L1\",\r\n      \"value\": 0,\r\n      \"unit\": \"reference\"\r\n    },\r\n    {\r\n      \"id\": \"tailMinimum\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"5.3.4(5)(ｲ)(b)\",\r\n      \"printedPage\": 31,\r\n      \"pdfPage\": 37,\r\n      \"label\": \"仕口内折曲げ定着の余長下限（8d以上）\",\r\n      \"conditions\": {},\r\n      \"value\": 8,\r\n      \"unit\": \"d\"\r\n    },\r\n    {\r\n      \"id\": \"projectionMinimum\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"5.3.4(5)(ｲ)(c)\",\r\n      \"printedPage\": 31,\r\n      \"pdfPage\": 37,\r\n      \"label\": \"梁主筋の柱内定着の投影長下限（柱せいの3/4倍以上）\",\r\n      \"conditions\": {\r\n        \"detail\": \"梁主筋の柱内定着\"\r\n      },\r\n      \"value\": 0.75,\r\n      \"unit\": \"ratio\"\r\n    },\r\n    {\r\n      \"id\": \"minimumCover\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"表5.3.6\",\r\n      \"printedPage\": 33,\r\n      \"pdfPage\": 39,\r\n      \"label\": \"最小かぶり厚さ（屋外・仕上げなし）\",\r\n      \"conditions\": {\r\n        \"soilContact\": false,\r\n        \"exposure\": \"屋外\",\r\n        \"finish\": \"仕上げなし\"\r\n      },\r\n      \"value\": 40,\r\n      \"unit\": \"mm\"\r\n    },\r\n    {\r\n      \"id\": \"fabricationCoverAddition\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"5.3.5(2)\",\r\n      \"printedPage\": 33,\r\n      \"pdfPage\": 39,\r\n      \"label\": \"加工用かぶり厚さの加算（最小かぶり厚さ＋10mm）\",\r\n      \"conditions\": {},\r\n      \"value\": 10,\r\n      \"unit\": \"mm\"\r\n    },\r\n    {\r\n      \"id\": \"tipNoAddition\",\r\n      \"sourceId\": \"quantity\",\r\n      \"table\": \"第4編第3章第2節 1通則1)・2（２）柱1)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"label\": \"先端で止まる鉄筋には定着長さを加えない\",\r\n      \"quote\": \"基礎、柱、梁、床板、壁等の先端で止まる鉄筋は、コンクリートの設計寸法をその部分の鉄筋の長さとし、これに設計図書等で指定された場合はフックの長さを加える。／（２）柱1)「最上階柱の主筋については、１通則１）による」（printedPage 16・pdfPage 21）\",\r\n      \"conditions\": {\r\n        \"end\": \"先端\"\r\n      },\r\n      \"value\": 0,\r\n      \"unit\": \"mm\"\r\n    },\r\n    {\r\n      \"id\": \"hook135\",\r\n      \"sourceId\": \"spec\",\r\n      \"table\": \"表5.3.1 折曲げ図\",\r\n      \"printedPage\": 27,\r\n      \"pdfPage\": 33,\r\n      \"label\": \"135°フックの余長（6d）\",\r\n      \"conditions\": {\r\n        \"bend\": \"135°\"\r\n      },\r\n      \"imageRead\": true,\r\n      \"value\": 6,\r\n      \"unit\": \"d\"\r\n    }\r\n  ],\r\n  \"cases\": [\r\n    {\r\n      \"id\": \"column-main-anchored-at-foundation\",\r\n      \"title\": \"柱主筋 — スタック最下段（基礎に定着）・最上段（先端）\",\r\n      \"role\": \"主筋\",\r\n      \"given\": {\r\n        \"kind\": \"柱\",\r\n        \"section\": {\r\n          \"b\": 800,\r\n          \"d\": 800,\r\n          \"fc\": 24,\r\n          \"grade\": \"SD345\",\r\n          \"exposure\": \"屋外\",\r\n          \"finish\": \"仕上げなし\",\r\n          \"main\": {\r\n            \"size\": \"D25\",\r\n            \"count\": 12\r\n          },\r\n          \"hoop\": {\r\n            \"size\": \"D13\",\r\n            \"pitch\": 100,\r\n            \"startOffsetMm\": 0\r\n          }\r\n        },\r\n        \"storyHeightMm\": 3500,\r\n        \"beamDepthAboveMm\": 750,\r\n        \"ends\": {\r\n          \"bottom\": \"定着\",\r\n          \"top\": \"先端\"\r\n        }\r\n      },\r\n      \"uses\": [\r\n        \"L1\",\r\n        \"tipNoAddition\"\r\n      ],\r\n--- rule loader matching ---\r\nimport type { MemberClass, Section } from '../model/member'\r\nimport type { RuleHit, RulePack } from './types'\r\n\r\n/**\r\n * 表5.3.6 のかぶり厚さセルを特定する共通条件 — 생성기(column.ts)와\r\n * 집계기(quantity/index.ts)가 반드시 같은 셀을 봐야 하므로 단일 출처로 둔다.\r\n * 地上躯体のみを扱う (基礎・地中部材は ADR-005 でスコープ外) — 土に接しない。\r\n */\r\nexport function coverConditions(\r\n  section: Section,\r\n): Record<string, string | boolean> {\r\n  const cell = {\r\n    memberKind: section.kind,\r\n    soilContact: false,\r\n    finish: section.finish,\r\n  }\r\n\r\n  // 表5.3.6 の「スラブ、耐力壁以外の壁」行は仕上げの有無だけで分かれ、屋内・\r\n  // 屋外の区別を持たない — 同じ表の「柱、梁、耐力壁」行と構造が違う。だから\r\n  // 床板は exposure を入力に持たず、ここでも渡さない (ADR-028)。\r\n  return section.kind === '床板'\r\n    ? cell\r\n    : { ...cell, exposure: section.exposure }\r\n}\r\n\r\nfunction matches(\r\n  ruleConditions: Record<string, string | number | boolean>,\r\n  queryConditions: Record<string, unknown>,\r\n): boolean {\r\n  return Object.entries(ruleConditions).every(\r\n    ([name, value]) => queryConditions[name] === value,\r\n  )\r\n}\r\n\r\nexport function lookupRule(\r\n  pack: RulePack,\r\n  key: string,\r\n  conditions: Record<string, unknown>,\r\n): RuleHit {\r\n  const candidates = pack.entries.filter(\r\n    (entry) => entry.key === key && matches(entry.conditions, conditions),\r\n  )\r\n\r\n  if (candidates.length === 0) {\r\n    throw new Error(\r\n      `Rule not found: ${key} for ${JSON.stringify(conditions)}`,\r\n    )\r\n  }\r\n\r\n  const specificity = Math.max(\r\n    ...candidates.map((entry) => Object.keys(entry.conditions).length),\r\n  )\r\n  const mostSpecific = candidates.filter(\r\n    (entry) => Object.keys(entry.conditions).length === specificity,\r\n  )\r\n\r\n  if (mostSpecific.length !== 1) {\r\n    throw new Error(\r\n      `Rule lookup is ambiguous: ${key} for ${JSON.stringify(conditions)}`,\r\n    )\r\n  }\r\n\r\n  return mostSpecific[0]\r\n}\r\n\r\n/**\r\n * 같은 key의 행 전부를 `orderBy` 조건값의 오름차순으로 돌려준다.\r\n *\r\n * 区分表(（３）梁2))처럼 **행의 개수와 순서 자체가 규준**인 룰에 쓴다. 코드가\r\n * 「区分은 3개」라고 알면 룰팩을 바꿔도 코드가 따라오지 않으므로, 조회 쪽이\r\n * 표 전체를 읽는다.\r\n */\r\nexport function lookupRuleSeries(\r\n  pack: RulePack,\r\n  key: string,\r\n  orderBy: string,\r\n): RuleHit[] {\r\n  const rows = pack.entries.filter((entry) => entry.key === key)\r\n\r\n  if (rows.length === 0) {\r\n    throw new Error(`Rule series not found: ${key}`)\r\n  }\r\n\r\n  return [...rows]\r\n    .map((entry) => {\r\n      const order = entry.conditions[orderBy]\r\n      if (typeof order !== 'number') {\r\n        throw new Error(\r\n          `Rule ${key} must carry a numeric ${orderBy} condition to be ordered`,\r\n        )\r\n      }\r\n      return { entry, order }\r\n    })\r\n    .sort((left, right) => left.order - right.order)\r\n    .map(({ entry }) => entry)\r\n}\r\n\r\nexport function lookupMarkup(\r\n  pack: RulePack,\r\n  memberClass: MemberClass | string,\r\n): RuleHit {\r\n  return lookupRule(pack, 'markup.rate', { memberClass })\r\n}\r\n--- project sample and export input types ---\r\nsrc/domain/model/sample-project.ts-233-        position: { axis: 'Y', ix, iy },\r\nsrc/domain/model/sample-project.ts-234-      })\r\nsrc/domain/model/sample-project.ts-235-    }\r\nsrc/domain/model/sample-project.ts-236-  }\r\nsrc/domain/model/sample-project.ts-237-\r\nsrc/domain/model/sample-project.ts-238-  return girders\r\nsrc/domain/model/sample-project.ts-239-}\r\nsrc/domain/model/sample-project.ts-240-\r\nsrc/domain/model/sample-project.ts-241-export function createSampleProject(): Project {\r\nsrc/domain/model/sample-project.ts-242-  return {\r\nsrc/domain/model/sample-project.ts:243:    schemaVersion: PROJECT_SCHEMA_VERSION,\r\nsrc/domain/model/sample-project.ts-244-    name: 'サンプル案件 / RC 2階建て',\r\nsrc/domain/model/sample-project.ts-245-    grid: sampleGrid,\r\nsrc/domain/model/sample-project.ts-246-    stories: sampleStories,\r\nsrc/domain/model/sample-project.ts-247-    sections: [columnSection, ...girderSections, wallSection, slabSection],\r\nsrc/domain/model/sample-project.ts-248-    members: sampleStories.flatMap(({ id }) => [\r\nsrc/domain/model/sample-project.ts-249-      ...createColumns(id),\r\nsrc/domain/model/sample-project.ts-250-      ...createGirders(id),\r\nsrc/domain/model/sample-project.ts-251-      ...createWalls(id),\r\nsrc/domain/model/sample-project.ts-252-      ...createSlabs(id),\r\nsrc/domain/model/sample-project.ts-253-    ]),\r\nsrc/domain/model/sample-project.ts-254-  }\r\nsrc/domain/model/sample-project.ts-255-}\r\n--\r\nsrc/domain/model/project.ts-65-export const PROJECT_SCHEMA_VE