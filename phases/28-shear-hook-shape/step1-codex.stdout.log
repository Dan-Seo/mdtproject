\\\\\\\"bend\\\\\\\": \\\\\\\"135°\\\\\\\"\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-140-      },\\\\r\\\\n--\\\\ntests/golden/fixtures/fabrication-length.json-252-      \\\\\\\"derivation\\\\\\\": \\\\\\\"加工用かぶり ＝ 最小かぶり 40 ＋ 加算 10 ＝ 50 ／ 加工寸法 ＝ (800 − 2×50) × (800 − 2×50) ＝ 700 × 700 ／ 閉合周長 ＝ 2 × (700 ＋ 700) ＝ 2800\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-253-      \\\\\\\"status\\\\\\\": \\\\\\\"deviation-from-source\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-254-      \\\\\\\"deviation\\\\\\\": {\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:255:        \\\\\\\"term\\\\\\\": \\\\\\\"hook135\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-256-        \\\\\\\"missingMm\\\\\\\": 156,\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-257-        \\\\\\\"withHookTailMm\\\\\\\": 2956,\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:258:        \\\\\\\"note\\\\\\\": \\\\\\\"135°フック余長 6d × D13 ＝ 78 が両端に付くので 2800 ＋ 2 × 78 ＝ 2956。実装の points は閉合矩形のままで余長を描かない（R12）。数量側は 1通則2) が「フックはないものとする」と定めるので影響しない。withHookTailMm は余長だけを足した下限であり、表5.3.1 の折曲げ内法直径による曲げ部の伸びは別途 — その表自体が画像判読（imageRead）で inferred のままなので、実装するときも ▲ が付く。\\\\\\\"\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-259-      },\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-260-      \\\\\\\"expectedFabricationLengthMm\\\\\\\": 2800\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-261-    },\\\\r\\\\n--\\\\ntests/golden/fixtures/fabrication-length.json-314-        \\\\\\\"L1\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-315-        \\\\\\\"bentStraightFloor\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-316-        \\\\\\\"La\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:317:        \\\\\\\"tailMinimum\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-318-        \\\\\\\"projectionMinimum\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-leng