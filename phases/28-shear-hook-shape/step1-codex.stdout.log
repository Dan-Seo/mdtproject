ceMethod,\\r\\n   8: } from '../model/member'\\r\\n   9: import {\\r\\n  10:   findSection,\\r\\n  11:   memberGroupKey,\\r\\n  12:   storyNotFound,\\r\\n  13:   type Project,\\r\\n  14: } from '../model/project'\\r\\n  15: import type { Rebar, RebarRole, RebarShape } from '../model/rebar'\\r\\n  16: import { lookupMarkup } from '../rules/lookup'\\r\\n  17: import {\\r\\n  18:   CONFIDENCE_ORDER,\\r\\n  19:   type RuleConfidence,\\r\\n  20:   type RuleHit,\\r\\n  21:   type RulePack,\\r\\n  22: } from '../rules/types'\\r\\n  23: \\r\\n  24: /**\\r\\n  25:  * 内訳書の単位。鉄筋そのものは質量で、継手は箇所で数える — 数量積算基準が\\r\\n  26:  * 1通則4)・（２）柱2)・（３）梁2) で「継手箇所数」を求めさせるからだ。\\r\\n  27:  * 両者は足せないので行の型ごと分ける。\\r\\n  28:  */\\r\\n  29: export type QuantityUnit = 'kg' | '箇所'\\r\\n  30: \\r\\n  31: interface QuantityLineBase {\\r\\n  32:   id: string\\r\\n  33:   groupId: string\\r\\n  34:   storyName: string\\r\\n  35:   memberKind: MemberKind\\r\\n  36:   mark: string\\r\\n  37:   sectionLabel: string\\r\\n  38:   role: RebarRole\\r\\n  39:   size: ShearBarSize\\r\\n  40:   /** この行が束ねた部材の数 */\\r\\n  41:   places: number\\r\\n  42:   rules: RuleHit[]\\r\\n  43:   /**\\r\\n  44:    * 이 행이 기댄 근거 중 **가장 약한** 등급. 한 행이라도 약한 근거를 쓰면\\r\\n  45:    * 그 행 전체가 그만큼만 확실하다 — 강한 쪽으로 반올림하지 않는다.\\r\\n  46:    */\\r\\n  47:   confidence: RuleConfidence\\r\\n  48:   formula: string\\r\\n  49: }\\r\\n  50: \\r\\n  51: /**\\r\\n  52:  * 質量の3列は「まだ分からない」を持つ。積算基準 1通則 前文は質量を\\r\\n  53:  * 「設計長さ × JIS G 3112 の単位質量」と定めるが、値そのものは JIS に委ねる。\\r\\n  54:  * その JIS を確保できていないので、利用者が単位質量を入れるまで kg は出ない —\\r\\n  55:  * 0 を入れると内訳書で合計され、質量が過小に見える。\\r\\n  56:  */\\r\\n  57: export interface MassQuantityLine extends QuantityLineBase {\\r\\n  58:   unit: 'kg'\\r\\n  59:   shape: RebarShape\\r\\n  60:   lengthMm: number\\r\\n  61:   countPerMember: number\\r\\n  62:   totalLengthMm: number\\r\\n  63:   unitMassKgPerM: number | null\\r\\n  64:   designKg: number | null\\r\\n  65:   requiredKg: number | null\\r\\n  66: }\\r\\n  67: \\r\\n  68: export interface SpliceQuantityLine extends QuantityLineBase {\\r\\n  69:   unit: '箇所'\\r\\n  70:   method: SpliceMethod\\r\\n  71:   /** 1部材あたりの継手箇所数 ＝ 1本あたり箇所数 × 本数 */\\r\\n  72:   countPerMember: number\\r\\n  73:   /** 箇所数の合計 ＝ countPerMember × places */\\r\\n  74:   totalCount: number\\r\\n  75: }\\r\\n  76: \\r\\n  77: export type QuantityLine = MassQuantityLine | SpliceQuantityLine\\r\\n  78: \\r\\n  79: export function isMassLine(line: QuantityLine): line is MassQuantityLine {\\r\\n  80:   return line.unit === 'kg'\\r\\n  81: }\\r\\n  82: \\r\\n  83: export function isSpliceLine(line: QuantityLine): line is SpliceQuantityLine {\\r\\n  84:   return line.unit === '箇所'\\r\\n  85: }\\r\\n  86: \\r\\n  87: export function massLines(lines: QuantityLine[]): MassQuantityLine[] {\\r\\n  88:   return lines.filter(isMassLine)\\r\\n  89: }\\r\\n  90: \\r\\n  91: export function spliceLines(lines: QuantityLine[]): SpliceQuantityLine[] {\\r\\n  92:   return lines.filter(isSpliceLine)\\r\\n  93: }\\r\\n  94: \\r\\n  95: /** 単位質量が一つでも欠けたら小計・合計も出ない — 入った径だけの和は合計ではない。 */\\r\\n  96: export interface StorySubtotal {\\r\\n  97:   storyName: string\\r\\n  98:   designKg: number | null\\r\\n  99:   requiredKg: number | null\\r\\n 100: }\\r\\n 101: \\r\\n 102: /**\\r\\n 103:  * 径別の質量。発注は径ごとに出すので、階も部材も跨いで一本にまとめる。\\r\\n 104:  * 階小計と違って **径ごとに独立して** null になる — この表の用途は\\r\\n 105:  * 「どの径がまだ発注できないか」を見せることなので、欠けた径が他の径まで\\r\\n 106:  * 巻き込むと、その情報が消える。\\r\\n 107:  */\\r\\n 108: export interface SizeSubtotal {\\r\\n 109:   size: ShearBarSize\\r\\n 110:   designKg: number | null\\r\\n 111:   requiredKg: number | null\\r\\n 112: }\\r\\n 113: \\r\\n 114: export interface QuantityTotal {\\r\\n 115:   designKg: number | null\\r\\n 116:   requiredKg: number | null\\r\\n 117: }\\r\\n 118: \\r\\n 119: export interface SpliceTotal {\\r\\n 120:   method: SpliceMethod\\r\\n 121:   totalCount: number\\r\\n 122: }\\r\\n 123: \\r\\n 124: type GroupedLine =\\r\\n 125:   | { kind: 'kg'; line: MassQuantityLine; memberIds: Set<string>; markupRate: number }\\r\\n 126:   | { kind: '箇所'; line: SpliceQuantityLine; memberIds: Set<string> }\\r\\n 127: \\r\\n 128: function storyName(project: Project, member: Member): string {\\r\\n 129:   const story = project.stories.find(({ id }) => id === member.storyId)\\r\\n 130:   if (!story) {\\r\\n 131:     throw storyNotFound(member.storyId)\\r\\n 132:   }\\r\\n 133:   return story.name\\r\\n 134: }\\r\\n 135: \\r\\n 136: function sectionLabel(section: Section): string {\\r\\n 137:   // 円形柱は図面と同じ「600φ」で書く。b×d と書くと図面にない矩形断面に見える。\\r\\n 138:   if (section.kind === '柱') {\\r\\n 139:     return section.shape === '円形'\\r\\n 140:       ? `${section.b}φ`\\r\\n 141:       : `${section.b}×${section.d}`\\r\\n 142:   }\\r\\n 143:   if (section.kind === '大梁') return `${section.b}×${section.depth}`\\r\\n 144: \\r\\n 145:   // 壁も床板も断面が厚さ1つなので図面と同じ「t180」の書き方にする。\\r\\n 146:   // どちらの部材かはグループ見出しの部材種別が言う。\\r\\n 147:   return `t${section.thickness}`\\r\\n 148: }\\r\\n 149: \\r\\n 150: function ruleIdentity(rule: RuleHit): string {\\r\\n 151:   const conditions = Object.entries(rule.conditions).sort(\\r\\n 152:     ([left], [right]) => left.localeCompare(right),\\r\\n 153:   )\\r\\n 154:   return `${rule.key}\\\\u0000${JSON.stringify(conditions)}`\\r\\n 155: }\\r\\n 156: \\r\\n 157: function uniqueRules(rules: RuleHit[]): RuleHit[] {\\r\\n 158:   const seen = new Set<string>()\\r\\n 159:   return rules.filter((rule) => {\\r\\n 160:     const identity = ruleIdentity(rule)\\r\\n 161:     if (seen.has(identity)) return false\\r\\n 162:     seen.add(identity)\\r\\n 163:     return true\\r\\n 164:   })\\r\\n 165: }\\r\\n 166: \\r\\n 167: function contributingRules(\\r\\n 168:   pack: RulePack,\\r\\n 169:   member: Member,\\r\\n 170:   rebar: Rebar,\\r\\n 171: ): { rules: RuleHit[]; markup: RuleHit } {\\r\\n 172:   // 산정부가 실제로 조회한 행을 그대로 쓴다 — 키에서 조회 조건을 되짚으면\\r\\n 173:   // 되짚을 수 없는 조회(지점 柱의 かぶり)가 근거에서 사라진다.\\r\\n 174:   const rebarRules = rebar.ruleHits\\r\\