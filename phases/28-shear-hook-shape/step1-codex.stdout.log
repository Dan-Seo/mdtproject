viewer\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\"\\\\r\\\\n    },\\\\r\\\\n    {\\\\r\\\\n      \\\\\\\"step\\\\\\\": 3,\\\\r\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"note1-transcription-ledger\\\\\\\",\\\\r\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\"\\\\r\\\\n    }\\\\r\\\\n  ],\\\\r\\\\n  \\\\\\\"created_at\\\\\\\": \\\\\\\"2026-08-27T11:46:55+0900\\\\\\\"\\\\r\\\\n}\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n-{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"python -c \\\\\\\\\\\\\\\"import fitz; paths=['.cache/001888816.pdf','.cache/001178206.pdf']; terms=['帯筋、あばら筋及び幅止め筋','片持ちスラブ先端','用いる場合には','フック','断面の設計寸法による周長','フックはないものとする','コーナー','隅'];\\\\\\\\\\\\\\\\nfor path in paths:\\\\\\\\\\\\\\\\n d=fitz.open(path); print('PDF',path,'pages',len(d));\\\\\\\\\\\\\\\\n for term in terms:\\\\\\\\\\\\\\\\n  hits=[]\\\\\\\\\\\\\\\\n  for i,p in enumerate(d):\\\\\\\\\\\\\\\\n   t=p.get_text()\\\\\\\\\\\\\\\\n   if term in t: hits.append(i+1)\\\\\\\\\\\\\\\\n  if hits: print(repr(term),hits)\\\\\\\\\\\\\\\"\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"  File \\\\\\\"<string>\\\\\\\", line 1\\\\r\\\\n    import fitz; paths=['.cache/001888816.pdf','.cache/001178206.pdf']; terms=['帯筋、あばら筋及び幅止め筋','片持ちスラブ先端','用いる場合には','フック','断面の設計寸法による周長','フックはないものとする','コーナー','隅'];\\\\\\\\nfor path in paths:\\\\\\\\n d=fitz.open(path); print('PDF',path,'pages',len(d));\\\\\\\\n for term in terms:\\\\\\\\n  hits=[]\\\\\\\\n  for i,p in enumerate(d):\\\\\\\\n   t=p.get_text()\\\\\\\\n   if term in t: hits.append(i+1)\\\\\\\\n  if hits: print(repr(term),hits)\\\\r\\\\n                                                                                                                                                                    ^\\\\r\\\\nSyntaxError: unexpected character after line continuation character\\\\r\\\\n\\\",\\\"exit_code\\\":1,\\\"status\\\":\\\"failed\\\"}}\\n-{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_3\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'rg -n -C 3 \\\\\\\"ADR-040|ADR-019|ADR-023|片持ちスラブ先端|自由端側の先端|用いる場合には|hook135|tail|フック|位置\\\\\\\" docs/ADR.md src/rulepack/jp-mlit/bend.yaml tests/golden/fixtures/fabrication-length.json'\\\",\\\"aggregated_output\\\":\\\"docs/ADR.md-113-**결정**: 構造図 PDF의 텍스트 레이어에서 **断面リスト 값만** 파싱해 部材断面一覧의 **후보**로 제시한다. 후보는 부재 행 단위 승인(反映/無視)을 거쳐야만 입력에 반영된다. 형상(通り芯·스팬·階高·부재 배치)은 계속 평면 에디터 수동 입력이다 — ADR-004의 핵심(도면에서 형상을 인식하지 않는다)은 유지되고, 이 ADR은 断面一覧 표 입력의 타이핑을 줄이는 보완이다. 파싱은 pdf.js로 브라우저 안에서만 수행하고 외부 전송은 없다(ADR-006·ADR-017 예외 없음). LLM·OCR을 쓰지 않는 결정적 파싱이다(ADR-015의 추출자=승인자 문제를 만들지 않는다 — 승인자는 항상 사용자다).\\\\ndocs/ADR.md-114-**이유**: ADR-004의 기각 사유는 「검증용 실도면 세트를 구할 수 없다」는 데이터 문제였다. 공공 발주기관이 공개하는 설계도서에서 텍스트 레이어가 있는 構造図를 수집할 수 있음이 확인되어(발주처 상이 3부: 沖縄県住宅供給公社·横浜市建築局·可児市, `tests/fixtures/section-import/SOURCES.md`) 그 전제가 바뀌었다. 断面リスト는 표 형식 텍스트라 좌표 기반 결정적 파싱이 성립하고, 제품 근거(공공건축 기준)와 데이터 출처(공공 발주 도면)가 일치한다.\\\\ndocs/ADR.md-115-**구현 규율**: ① 파서는 2단 분리 — PDF→TextItem[](pdf.js, 통합 테스트는 `.cache` 로컬 전용)과 TextItem[]→후보(순수 TS, CI 상시). PDF 원본은 커밋하지 않고 URL·SHA-256만 기록한다. ② 기대값 픽스처는 도면을 눈으로 읽은 독립 전사다(ADR-010 준용). ③ 파싱값은 승인 전에는 어떤 계산에도 기여하지 않는다. 확신 없는 셀(파싱 실패·위치별 상이값·표현 불가 값 K13·600φ 등)은 빈칸으로 남기고 원본 문자열을 참고 표시한다 — 파서가 값을 지어내면 ADR-012(主筋 본수는 입력이고 제품이 바꾸지 않는다)를 입력 단계에서 무너뜨리는 것이다. ④ `pdfjs-dist`는 캐럿 범위가 아니라 **정확 버전으로 고정**한다. 신뢰할 수 없는 사용자 PDF를 파싱하는 유일한 의존이라, 설치 시점에 따라 파서가 조용히 바뀌면 픽스처 대조의 재현성과 취약점 대응 시점을 함께 잃는다 — 갱신은 lockfile이 아니라 눈에 보이는 커밋으로 한다.\\\\ndocs/ADR.md:116:**트레이드오프**: 실물 3부 기반이라 포맷 과적합 위험이 남는다(발주처·CAD별 변동은 이후 수집으로 계속 넓힌다). 位置(端部/中央)별 상이값은 현행 스키마(단일 top/bottom)로 받을 수 없어 빈칸이 된다 — M3b의 カットオフ 입력이 생기면 그때 흡수한다. 형상 인식이 없으므로 이중 작업(배치는 수동)은 여전하다.\\\\ndocs/ADR.md-117-\\\\ndocs/ADR.md-118-**구현 결과 (2026-08-23, phase 7-section-fields)**: `腹筋: 2-D10`과 리스트 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 행 단위 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 「배근 없음」과 「인식 실패」를 구분하지 못하므로 기존 수기값을 지우지 않는다. 腹筋의 `extraLengthMm`은 기존값을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력 상태)이다. `カットオフ` 치수는 원문 `raw` 보존까지만 완료했고, 좌우 端部를 담지 못하는 R13 본체가 닫히기 전에는 값으로 반영하지 않는다. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이어서 이번 phase에서 제외했다 — 없는 것을 읽지 못하는 것은 파서 결함이 아니다.\\\\ndocs/ADR.md-119-\\\\ndocs/ADR.md:120:### ADR-019: 数量의 길이·본수는 数量積算基準을 따르고 3D 형상과 분리한다\\\\ndocs/ADR.md-121-\\\\ndocs/ADR.md-122-**결정**: `Rebar.length`·`Rebar.count`는 `公共建築数量積算基準` 第4編第3章의 **設計長さ·設計本数**이고, 3D가 그리는 加工形状은 `Rebar.points`·`Rebar.placement`가 따로 가진다. 둘은 일치하지 않아도 된다.\\\\ndocs/ADR.md:123:**이유**: 같은 「길이」라는 말이 두 문서에서 다른 것을 가리킨다. `標準仕様書 5章`은 실제로 가공되는 철근의 치수를 정하고, `数量積算基準`은 **수량을 세는 방법**을 정한다. 후자는 의도적으로 단순화되어 있다 — 1通則2)는 フープ·スタラップ의 길이를 「断面の設計寸法による周長」으로 정하고 「フックはないものとする」고 못박는다. かぶり를 빼지도, フック을 더하지도 않는다. 1通則7)의 割付本数도 마찬가지로 初期オフセット을 보지 않는다.\\\\ndocs/ADR.md-124-\\\\ndocs/ADR.md:125:한 값에 두 의미를 담으면 반드시 한쪽이 틀린다. 실제로 M3a까지의 구현은 `2×{(b−2·加工用かぶり)＋(D−2·加工用かぶり)} ＋ 2×フック余長`을 양쪽에 썼고, 그 결과 G1(400×750)의 あばら筋이 2,056mm로 나왔다 — 積算基準의 2,300mm보다 **한 본당 244mm(11.9%) 적다.** 부재마다 50본 넘게 들어가는 철근이므로 内訳書 전체가 조용히 과소 계상되고 있었다.\\\\ndocs/ADR.md-126-\\\\ndocs/ADR.md-127-内訳書는 発注에 쓰이므로 積算基準이 정답이고, 3D는 사용자가 「입력한 게 맞나」를 확인하는 수단이므로 実形状이 정답이다(ADR-016). 그래서 분리한다.\\\\ndocs/ADR.md-128-**트레이드오프**: 3D에 그려진 あばら筋 개수와 内訳書의 本数가 다르게 보인다(샘플 G1: 52본 대 53본). 이 어긋남 자체가 설명되어야 하므로 `formula`에 「設計長さ ／ 設計本数 ／ 3D 形状（数量には用いない）」를 모두 적는다. 숨기는 대신 근거와 함께 드러내는 쪽을 택한다(UC4).\\\\n--\\\\ndocs/ADR.md-151-\\\\ndocs/ADR.md-152-허용목록은 유지보수 대상이다. posthog-js가 유용한 필드를 새로 추가해도 목록에 넣기 전까지는 버려진다. 이 비용은 의도적이다 — 목록에 넣는 것은 사람이 한 번 판단해서 하는 일이고, 안 넣었을 때의 결과가 유출이 아니라 누락이다. 회귀 방지는 `src/lib/telemetry.test.ts`·`PaneBoundary.test.tsx`.\\\\ndocs/ADR.md-153-\\\\ndocs/ADR.md:154:### ADR-021: 大梁 主筋을 位置別(端部·中央)로 받고 差를 カットオフ筋으로 낸다 (ADR-012·ADR-019 적용)\\\\ndocs/ADR.md-155-\\\\ndocs/ADR.md:156:**결정**: `GirderSection.main`은 上端·下端 각각 `{ endCount, centerCount }`와 切り止め位置 `cutoffFromSupportFaceMm` 하나를 받는다. 적은 쪽이 通し筋이고 差가 カットオフ筋이다. カットオフ筋의 設計長さ는 **외측 지점** 定着 ＋ 切り止め位置, **중간 지점** 切り止め位置×2 ＋ 中間柱せい(관통하므로 定着 없음), **中央** 内法 − 切り止め位置×2로 조립한다. 継手箇所数는 1通則4)로 세고, 3D는 柱面에서 안쪽만 그린다.\\\\ndocs/ADR.md-157-\\\\ndocs/ADR.md:158:**이유**: `数量積算基準` 2（３）梁1)이 「梁の全長にわたる主筋の長さは、梁の長さにその定着長さを加えたものとする」에 이어 「トップ筋、ハンチ部分の主筋、補強筋等は**設計図書による**」라고 못박는다. 두 가지가 따라 나온다 — ① 全長にわたる主筋과 그렇지 않은 主筋을 나누지 않으면 어느 쪽도 조문대로 잴 수 없고, ② 나누는 값은 規準에 없으므로 룰팩이 아니라 입력이다(ADR-012 자리). 断面リスト가 이미 端部·中央 두 행으로 주는 정보를 스키마가 그대로 받으면, ADR-018의 트레이드오프 항목(「位置별 상이값은 현행 스키마로 받을 수 없어 빈칸이 된다」)도 같은 자리에서 풀린다.\\\\ndocs/ADR.md-159-\\\\ndocs/ADR.md:160:**구현 규율**: ① 内訳 행은 **設計長さ**로 묶는다(1通則 前文 「規格、形状、寸法等ごとに」). 한 부재가 같은 길이의 카ット오프 위치를 둘 이상 가지면(단일 스팬의 양단) 本数를 합쳐 **한 행**으로 낸다 — 같은 부재가 같은 (역할·길이·본수) 행을 두 번 내면 집계가 부재 수(`places`)로 세면서 조용히 절반을 잃는다. ② 継手는 「連続する梁の全長にわたる主筋」이 아니므로 （３）梁2)의 区分表가 아니라 같은 조 단서를 따라 1通則4)(6.0/7.0m ごと)로 돌아간다. ③ **3D는 定着을 그리지 않는다.** 한 내역 행이 떨어진 여러 지점에 서고 그 지점들을 대표 1본의 평행이동(`Rebar.axisOffsetsMm`)으로 덮는데, 定着 형상은 런의 양 끝에서 좌우가 뒤집혀 평행이동으로 덮이지 않는다. ADR-019가 이미 「그려지는 加工長 ≠ 設計長さ」를 허용하므로 定着은 設計長さ에만 넣고, 그 사실을 `formula`와 内訳 상단 상시 고지에 함께 적는다. ④ 切り止め位置가 미입력(0)이거나 内法 ≤ 切り止め位置×2이면 조용히 0을 쓰지 않고 그 부재를 뺀다. 이유는 처음에 기존 `寸法不成立`에 얹었으나 전용 이유 **`カットオフ位置不成立`**으로 갈랐다 — `寸法不成立`은 断面·内法 치수가 틀렸다는 뜻이라 사용자가 그 칸을 보러 가는데, 여기서 고쳐야 할 칸은 `カットオフ位置`다. 이유 문자열이 곧 「어디를 고치라」는 안내이므로 둘을 합치면 그 안내가 틀린다.\\\\ndocs/ADR.md-161-\\\\ndocs/ADR.md:162:**트레이드오프**: 3D의 カットオフ筋은 柱面에서 끊겨 보인다 — 定着이 없어서가 아니라 그리지 않아서라는 사실이 고지에 있어야만 오해가 안 생긴다. 位置別 상이값은 主筋에만 들어왔고 **あばら筋 피치(端部@100/中央@200)는 여전히 단일 값**이다. 「1か所당 本数 × 位置数」 모델은 段(2段筋)을 구분하지 않으므로, 같은 段에 몰아 그린다. 断面リスト 취입은 端部欄이 **좌우 동값일 때만** `endCount`를 채운다 — 「Y3端／Y4端」처럼 좌우가 다른 표는 값을 지어내지 않고 `主筋端部左右相違`로 빈칸＋원문에 남긴다. 제품의 `Grid`에 通り芯 라벨이 없어 어느 쪽이 런의 始端인지 정할 수 없고, 정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004). `GirderMainRow`도 양단 동값만 담으므로 **비대칭은 손으로도 입력할 수 없다** (R13).\\\\ndocs/ADR.md-163-\\\\ndocs/ADR.md-164-### ADR-022: M3c의 일본 고유 상세는 근거가 있는 것만 산정하고, 나머지는 만들지 않는다\\\\ndocs/ADR.md-165-**결정**: M3c 4항목을 원문 전수 검색으로 근거를 재본 뒤 셋으로 갈랐다.\\\\ndocs/ADR.md:166:- **幅止め筋 — 산정한다.** `数量積算基準` 1通則3)이 設計長さ를 「コンクリートの設計幅又は厚さ、フックはないものとする」로, 2（３）梁3)이 本数를 1通則7)에 걸어 두 값이 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`stated`)로 싣고 大梁에만 붙인다 — 1通則3)이 열거하는 부재는 基礎梁·梁·壁梁·壁이고 柱가 없다. 径·ピッチ는 `断面一覧`의 입력이다(ADR-012).\\\\ndocs/ADR.md-167-- **腹筋 — 산정하되 余長은 입력이다.** 2（３）梁3)이 余長을 1通則6)에 위임하고, 1通則6)은 設計図書에 기재가 없으면 JASS 5 준용이라 한다. JASS 5는 유료라 미확보이고 `標準仕様書 R7`에는 「腹筋」이 **전 330쪽 0건**이다. 값을 만들 근거가 없으므로 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다. 그래서 `腹筋` 철근의 `ruleHits`는 **비어 있다** — 출처 없는 수치에 출처를 붙이지 않는다.\\\\ndocs/ADR.md-168-- **パネルゾーン帯筋·溶接閉鎖フープ — 만들지 않는다.** 두 항목은 근거가 0건이다(아래 표). 게다가 溶接閉鎖フープ는 1通則2)가 フープ 設計長さ를 제작방식과 무관하게 断面 周長으로 정하므로 **数量이 애초에 변하지 않는다** — 남는 것은 3D 형상과 라벨뿐이다. パネルゾーン帯筋은 2（２）柱4)가 「柱頭、柱脚等の補強筋は設計図書による」로 設計図書에 위임한다. 둘 다 3D 참고 표현조차 두지 않는다: 그리려면 형상과 本数를 제품이 지어내야 하고, 그 그림은 「참고」라는 꼬리표가 붙어도 사용자에게는 산출 결과로 보인다.\\\\ndocs/ADR.md-169-\\\\n--\\\\ndocs/ADR.md-182-```\\\\ndocs/ADR.md-183-**트레이드오프**: 실무 도면에는 パネルゾーン帯筋이 실제로 들어간다. 그것을 그리지 않는 뷰어는 실물과 다르다. 그러나 이 프로젝트가 못 견디는 실패는 「빠진 것」이 아니라 「틀린 채로 완성된 것」이므로(철학), 근거가 생길 때까지 빈칸으로 둔다. 근거가 생기는 경로는 둘이다 — JASS 5 확보(腹筋 余長·R9②), 그리고 設計図書 입력을 받는 UI(パネルゾーン·R7 대장의 「特記による」).\\\\ndocs/ADR.md-184-\\\\ndocs/ADR.md:185:### ADR-023: `confidence`를 3단계로 나눈다 — 「원문에 없음」과 「검토가 1인」은 다른 사실이다\\\\ndocs/ADR.md-186-**결정**: 룰팩 행의 `confidence`를 `stated`(원문 명시 ＋ **독립 검토 완료**) / `transcribed`(원문 명시, **전사자＝승인자**) / `inferred`(원문에 그 값이 없음)의 세 등급으로 나눈다. 한 축의 순서이며 위로 갈수록 강하다. 내역 행의 등급은 그 행이 기댄 근거 중 **가장 약한 것**이다 — 강한 쪽으로 반올림하지 않는다. 화면·엑셀은 ▲(원문에 값 없음)와 △(독립 검토 대기)를 갈라 붙이고, 등급이 `stated`가 아닌 행이 하나라도 있으면 워터마크를 세운다.\\\\ndocs/ADR.md-187-\\\\ndocs/ADR.md-188-**이유**: 이전 2단계는 **거짓말을 하고 있었다.** `定着長さ 40d`는 `表5.3.4`(紙面30)에 명시된 값인데 `inferred`(추론)로 표시됐다. 실제 이유는 추론이 아니라 R6 — 전사자와 승인자가 같아서 독립 검토가 안 끝났다는 것이고, 룰팩 note에도 그대로 `LLM転写 — 独立検討待ち`라고 적혀 있었다. 그 결과 「원문에 명시된 값(178행)」과 「원문에 없어 지어낸 값(11행)」이 같은 통에 들어가 **전 행에 ▲가 붙었고, ▲는 아무것도 가리키지 못했다.** 등급을 나누자 ▲는 실제로 근거가 없는 곳만 가리킨다.\\\\n--\\\\ndocs/ADR.md-278-\\\\ndocs/ADR.md-279-`免震`(ADR-025)도 0건이라 만들지 않았는데 왜 이것은 다른가. **제품이 지어내야 하는 값이 있느냐**가 갈림길이다.\\\\ndocs/ADR.md-280-\\\\ndocs/ADR.md:281:**만들 수 있는 이유는 조문 하나다.** `数量積算基準` 1通則2)가 「フープ、スタラップの長さは……断面の設計寸法による周長を鉄筋の長さとし、フックはないものとする」로 정한다. 그래서 帯筋의 設計長さ는 **径을 보지 않는다**. 실제로 `generateColumnRebar`가 帯筋에 대해 引는 룰은 `measure.hoop.length.addition`과 `measure.distribution.addition` 둘뿐이고 **어느 쪽도 `size` 조건도 `d` 단위도 갖지 않는다** — `column.test.ts`의 「径で引くルールを一つも使わない」가 그 사실을 고정한다. 本数는 1通則7)의 割付, 質量은 `Project.unitMass`(이미 사용자 입력, ADR-023 이후)이다. 즉 高強度せん断補強筋을 넣어도 **제품이 새로 지어내는 규준값이 0개**다.\\\\ndocs/ADR.md-282-\\\\ndocs/ADR.md-283-**主筋에 넣을 수 없는 이유도 같은 형태다.** 主筋은 定着(表5.3.4)·重ね継手(表5.3.2)를 **径과 鉄筋の種類로** 引는다. 그 표에 高強度せん断補強筋의 행은 없다 — 넣으면 SD345 칸을 785급 철근에 적용하게 되고, 그것은 근거 없는 값을 조용히 쓰는 것이다. `ShearBarSize = BarSize | HighStrengthShearBarSize`로 나누고 `main.size`는 `BarSize`인 채 둔다. 壁筋도 定着 L1을 引으므로 `BarSize`다.\\\\ndocs/ADR.md-284-\\\\n--\\\\ndocs/ADR.md-294-\\\\ndocs/ADR.md-295-**계기**: 「일본에만 있는 특수한 형태·제품」 요구의 네 항목 중 하나. 실측 도면 3부에서 파서가 못 읽던 마지막 断面 칸이 横浜市 도면의 `600φ`(C56) 하나였다.\\\\ndocs/ADR.md-296-\\\\ndocs/ADR.md:297:**왜 지어내는 값이 없는가**: 1通則2)는 「フープ、スタラップの長さは……**断面の設計寸法による周長**を鉄筋の長さとし、フックはないものとする」이다. **형상을 矩形으로 한정하지 않는다.** 円形 断面의 設計寸法은 直径이고 그 周長은 원주다 — 제품이 새 값을 만드는 게 아니라 같은 조문을 그 단면에 적용할 뿐이다. 主筋 길이(階高＋定着＋継手)·割付本数(1通則7))·かぶり(表5.3.6)는 형상과 무관하므로 손대지 않았다. **룰팩 신규 행은 0이다.**\\\\ndocs/ADR.md-298-\\\\ndocs/ADR.md:299:**단수는 버리지 않는다**: π×600 ＝ 1884.9556mm를 그대로 싣는다. 1通則6)이 四捨五入을 정하는 것은 フック·定着·余長·重ね継手의 **길이**이지 周長이 아니다 — 반올림할 근거가 없다. 골든 픽스처에 원주의 정의로 손유도한 값을 박고 `toBeCloseTo(…, 3)`로 대조한다.\\\\ndocs/ADR.md-300-\\\\ndocs/ADR.md-301-**b·d를 둘 다 直径으로 두는 이유**: 大梁의 内法長さ도, 3D의 柱面도, 平面 뷰의 히트 영역도 전부 `b`·`d`에서 나온다. 外接寸法을 그대로 두면 **형상 추가가 계측 규칙을 흔들지 않는다** — 円形 전용 필드를 새로 만들면 그 46곳이 전부 분기점이 된다. 대신 断面一覧은 円形일 때 입력 칸을 「直径」 하나로 바꿔 두 값이 어긋나지 않게 하고, 断面リスト 취입도 形状과 寸法을 **한 조로만** 반영한다.\\\\ndocs/ADR.md-302-\\\\ndocs/ADR.md:303:**スパイラル筋은 만들지 않는다.** 標準仕様書 5.3.4(6)(ｲ)가 「スパイラル筋の継手及び定着は**図5.3.5 による**」로 도면에 위임하는데, 그 図는 원문에서 **이미지**다 — 表5.3.3(継手位置)이 M0에서 걸린 것과 같은 함정이고 값을 읽을 수 없다. 그래서 断面リスト가 「HOOP D13@100」이라고 적으면 그것은 フープ이고, 제품이 スパイラル로 읽어 바꾸지 않는다 (ADR-012). 실제로 검증에 쓴 横浜市 도면의 600φ 칸이 그렇게 적혀 있다.\\\\ndocs/ADR.md-304-\\\\ndocs/ADR.md:305:**3D는 作図規則이다.** 円形フープの `points`는 かぶり円 위의 24각형이고, 主筋은 그 안쪽 원을 등간격으로 돈다. 分割数 24도, 「帯筋 바깥면이 かぶり면에·主筋 표면이 帯筋 안쪽면에 접한다」는 약속도 **規準値가 아니라 作図規則**이며 矩形柱가 이미 쓰던 것과 같다 (ADR-019). 数量은 이 折れ線 길이를 쓰지 않는다 — 24각형 둘레는 원주보다 짧고, 그 차이는 R12가 帯筋의 フック에 대해 적어둔 것과 같은 성질의 「형상과 数量의 정당한 불일치」다.\\\\ndocs/ADR.md-306-\\\\ndocs/ADR.md-307-**트레이드오프**: (1) `shape`를 필수 필드로 했으므로 스키마가 v9로 올라가고 v8 JSON은 게이트에서 거부된다 — optional로 두면 「기재 없음＝矩形」이라는 조용한 기본값이 되기 때문이다. (2) 円形柱 한 개의 帯筋은 사각형 4세그먼트 대신 24세그먼트를 그린다. 円形柱은 드물지만 R4(층당 1만 개)의 여유를 조금 먹는다. (3) `b !== d`인 円形은 타입으로 막지 못한다 — UI와 파서가 항상 한 조로 넣지만, 손으로 편집한 JSON은 타원을 만들 수 있다. 그 대가로 46곳의 分岐를 사지 않았다.\\\\ndocs/ADR.md-308-\\\\n--\\\\ndocs/ADR.md-351-- **統計値(2（４）床板3))** — 「することができる」＝허용이지 요구가 아니다. 1장씩 재서 합산한다.\\\\ndocs/ADR.md-352-- **スラブリスト 파서** — 耐震壁과 같이 지금은 손입력 전용이다 (R10에 얹힌다).\\\\ndocs/ADR.md-353-\\\\ndocs/ADR.md:354:**트레이드오프**: (1) 부재가 또 하나 늘어 `Section` 유니온의 분기가 4갈래가 됐고, `Member.position`에 **격자점이 아니라 베이를 가리키는** 좌표가 처음 들어왔다 — `ColumnPosition`과 구조가 같아 타입으로 구별되지 않으므로 판정은 항상 `Member.kind`가 한다. (2) 런 안에서 **직교 방향의 内法이 다르면** 1通則7)의 割付本数 한 개가 어느 베이에서도 맞지 않는다 — 일부만 통과하는 철근을 제품이 표현할 수 없으므로 그 런을 `寸法不成立`으로 떨어뜨린다. 조용히 한쪽 값을 쓰는 것보다 낫지만, 불규칙한 격자에서는 계상되지 않는 床板이 생긴다. (3) 部材 뷰는 선택한 베이가 속한 **두 런을 함께** 그리므로, 런의 원점이 베이와 다를 때 철근을 프레임 쪽으로 옮긴다 — 大梁의 `originOffsetMm`가 국소 x만 옮기는 것과 달리 x·y 두 방향이 필요해서, 표시부에서 `points`를 옮긴 사본을 만든다. (4) 板厚 방향의 4층(2방향×2면) 표시 반경은 실제 지름을 과장하므로 **板厚 200·かぶり 30의 평범한 슬래브에서도 그대로는 들어가지 않는다** — 壁과 같이 들어가는 크기까지 일률로 줄인다. 数量에는 영향이 없다 (ADR-019).\\\\ndocs/ADR.md-355-\\\\ndocs/ADR.md-356-**2026-08-26 정정**: 「0건」은 `配力筋`에만 해당한다. `片持床板`은 원문 근거를 확인해 ADR-039로 들어왔다.\\\\ndocs/ADR.md-357-\\\\n--\\\\ndocs/ADR.md-382-\\\\ndocs/ADR.md-383-**開口補強筋은 만들지 않는다.** 같은 항이 「設計図書により計測・計算する」로 위임한다. 2（３）梁1)·2（４）床板1)의 「トップ筋、ハンチ部分の主筋、補強筋等は設計図書による」와 **같은 말·같은 취급**이고, 제품은 이미 그 補強筋들을 만들지 않는다. 룰팩에 開口에 관해 실은 행은 「欠除しない大きさ」 하나뿐이고, 골든테스트가 `measure.opening*`이 1행임을 고정한다. 그 결과 **개구가 있는 부재는 그만큼 과소 계상**되므로 R14의 상시 고지를 지우지 않고 **문면을 뒤집었다** — 「欠除를 계상하지 않는다(과대)」에서 「欠除는 계상하고 開口補強筋을 계상하지 않는다(과소)」로.\\\\ndocs/ADR.md-384-\\\\ndocs/ADR.md:385:**3D는 표시부에서 끊는다.** `Rebar.points`는 개구를 모르는 全長의 경로 그대로다 — 欠ける위치는 본마다 다르므로 대표 1본의 折れ線에 담을 수 없기 때문이다. 대신 표시부가 `Member.openings`(床板은 `SlabRun.openings`＝런 좌표로 옮긴 것)로 세그먼트를 자르고(`clipSegments`), 콘크리트 상자를 최대 4장으로 도려낸다(`carveBox`). 部材 뷰와 建物 뷰 둘 다에 걸린다. 数量은 `Rebar.length`가 따로 갖고 있으므로 자르기가 質量을 움직이지 않는다 (ADR-019).\\\\ndocs/ADR.md-386-\\\\ndocs/ADR.md-387-**입력을 잘라 받지 않는다.** 内法을 벗어나는 개구는 切り詰めずに `MemberUnsupportedError('寸法不成立')`으로 그 부재를 떨어뜨리고, 화면에는 그 자리에서 ▲ 경고를 낸다. 잘라서 받으면 도면에 없는 크기의 개구를 제품이 정하는 것이 된다(ADR-004). 開口가 鉄筋의 길이를 다 써 버리는 경우(내법 전면 개구)도 「길이 0의 철근」이 아니라 「거기에 부재가 없다」이므로 같이 떨어뜨린다.\\\\ndocs/ADR.md-388-\\\\n--\\\\ndocs/ADR.md-464-2. 始端/終端은 런 로컬이다 — `GirderRun.memberOffsetsMm`의 0 쪽이 始端.\\\\ndocs/ADR.md-465-3. **분해는 nesting 해석으로 한다**: 위치별 本数는 누적 집합이다 — i번째 本은 「本数 ≥ i」인 모든 위치에 선다. s = startCount ?? endCount, e = endCount, c = centerCount로:\\\\ndocs/ADR.md-466-   - 通し筋 ＝ min(s, c, e)\\\\ndocs/ADR.md:467:   - 始端스텁 ＝ max(0, s − c)、終端스텁 ＝ max(0, e − c) — 그쪽 支点에 定着하고 柱面에서 カットオフ位置까지\\\\ndocs/ADR.md:468:   - 中央筋 ＝ max(0, c − max(s, e)) — 양쪽 支点 앞 カットオフ位置에서 끊는다\\\\ndocs/ADR.md:469:   - 편측근(始端定着) ＝ max(0, min(s, c) − e)、편측근(終端定着) ＝ max(0, min(c, e) − s) — 한쪽 支点에 定着하고 반대쪽 支点 앞 カットオフ位置에서 끊는다. 둘은 동시에 양수일 수 없다(전자는 e<s, 후자는 s<e를 요구).\\\\ndocs/ADR.md-470-   - **불변식(각 지점 단면의 본수 보존)**: s ＝ 通し＋始端스텁＋편측(始) ／ c ＝ 通し＋中央＋편측(始)＋편측(終) ／ e ＝ 通し＋終端스텁＋편측(終).\\\\ndocs/ADR.md-471-   - s＝e이면 현행 `splitGirderMainRow`와 동치다(스텁 양측 ＝ 기존 端部 카ットオフ, 中央筋 ＝ 기존 中央 카ットオフ, 편측근 0).\\\\ndocs/ADR.md:472:4. **길이는 전부 기존 규칙의 재사용이다** — 스텁 ＝ 定着＋カットオフ位置, 中央筋 ＝ 内法−2×位置, 편측근 ＝ (内法−位置)＋定着. 定着은 resolveGirderEnd(룰팩), 継手는 1通則4) 간격 계상(intervalSplice) 그대로. 새 규준 수치는 없다. カットオフ位置(`cutoffFromSupportFaceMm`)는 断面 하나에 하나 — 실물 G51도 값이 内端 [2500] 하나뿐이고, 좌우 다른 값이 실물에 나타나면 그때 넓힌다.\\\\ndocs/ADR.md-473-5. **다스팬 런 × 비대칭은 불성립으로 끊는다.** 리스트의 外端/内端이 다스팬 런의 어느 支点인지 조문·모델로 정할 수 없고, 정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004 원리). `MemberUnsupportedError`로 정직하게 실패한다. 대칭 다스팬은 현행 그대로.\\\\ndocs/ADR.md:474:6. nesting 해석 자체는 조문이 아니라 판단이다 — 積算基準 2（３）梁1)은 全長にわたる主筋 외의 길이를 設計図書에 위임할 뿐, 位置別 本数를 본 단위로 잇는 규칙은 주지 않는다. R2 꼬리표(inferred)를 단다. 현행 min/差 분해도 같은 해석을 암묵으로 쓰고 있었다 — 이 ADR은 그것을 명시하고 일반화한다.\\\\ndocs/ADR.md-475-7. 이 ADR의 범위는 모델·산정·数量·3D까지다. **입력 경로는 별건이다** — 断面一覧 편집 UI와 断面リスト 취입(8칸)의 「도면 라벨(外端/Y2端)↔始端/終端 대응」은 다음 phase이고, R13은 그때 닫힌다.\\\\ndocs/ADR.md-476-\\\\ndocs/ADR.md-477-### ADR-033: 断面リスト 취입의 「도면 라벨↔始端/終端」 대응 — 정확 일치 자동, 그 외는 사용자 선택\\\\ndocs/ADR.md-478-\\\\ndocs/ADR.md:479:**맥락**: ADR-032가 大梁 主筋의 좌우 비대칭을 모델·산정에 담았다. 남은 입력 경로는 둘 — 断面一覧 편집과 断面リスト 취입이다. 취입에는 결정이 하나 있다: 도면의 位置 라벨(「外端／内端」·「Y2端／Y3端」)을 런 로컬 始端/終端으로 잇는 **방향 결정**. 슬래브 短辺=X/Y(phase 19)와 같은 구조의 문제다 — 자동으로 한쪽을 고르면 도면에 없는 방향을 제품이 만든다 (ADR-004).\\\\ndocs/ADR.md-480-\\\\ndocs/ADR.md-481-**결정**:\\\\ndocs/ADR.md-482-\\\\ndocs/ADR.md-483-1. **파서는 해석하지 않는다.** 비대칭 칸은 위치별 본수와 **도면 원문 라벨 그대로**를 후보에 담는다. 端部/中央 재해석·좌우 정규화를 하지 않는다.\\\\ndocs/ADR.md-484-2. **대응은 두 갈래다**:\\\\ndocs/ADR.md:485:   - **通り芯형 자동**: 두 端 라벨이 「〈軸名〉端」 꼴이고 그 軸名 둘이 프로젝트 `Grid`의 **같은 축** 라벨(`xLabels`/`yLabels`)에 정확히 존재하면, 축 순서로 결정한다 — **始端 ＝ 축 인덱스가 낮은 쪽**. 근거는 코드 사실이다: `girderRun`이 부재를 축 인덱스 오름차순으로 정렬하므로 런의 始端은 항상 인덱스 낮은 支点이다. 伏図의 `Grid` 라벨과 断面リスト의 位置 라벨은 **같은 `compact()` 정규화**(NFKC·공백 제거, `src/lib/import/runs.ts`)를 거치므로, 이 대응은 동일 정규화를 지난 도면 문자열끼리의 정확 일치이지 추정이 아니다.\\\\ndocs/ADR.md-486-   - **그 외는 사용자 선택**: 「外端／内端」처럼 축 이름이 아닌 라벨, 軸名이 Grid에 없거나 부분 일치인 경우는 취입 화면에서 사용자가 「〈라벨〉=始端 / 〈라벨〉=終端」을 고른다. **기본은 미선택·미선택이면 반영 불가.** 建物의 外/内로 추정하는 자동은 만들지 않는다.\\\\ndocs/ADR.md-487-3. 자동 결정한 행은 **근거를 화면에 밝힌다**(어느 축 라벨 순서로 정했는지). 사용자가 수동으로 뒤집을 수 있어야 한다.\\\\ndocs/ADR.md-488-4. **カットオフ 치수는 한 값이다** (ADR-032 §4). 도면이 한쪽 端에만 치수를 주면 그 값을 `cutoffFromSupportFaceMm` 후보로 담고, 좌우가 다른 치수를 주면 결정하지 않는다 — 빈칸+원문.\\\\n--\\\\ndocs/ADR.md-543-6. **開口의 국소 좌표는 그 벽의 범위 원점을 쓴다** — `Opening.xMm/yMm`는 内法域의 원점 기준이고(ADR-029), 범위가 지정되면 内法域이 그 범위다. 부분 벽에도 開口는 뚫릴 수 있고 欠除은 같은 규약으로 계상된다. 3D의 콘크리트 상자·배근 원점도 같은 원점으로 옮긴다.\\\\ndocs/ADR.md-544-7. **하지 않는 것**: 자동 판정(断面リスト 壁 후보는 厚·配筋만이고 伏図는 평면이라 높이가 없다 — 어느 트랙도 형상 치수를 주지 않는다), 手すり壁 부재화(정의절 열거에 없다 — ADR-036 §5 유지), 같은 辺에 선 벽들의 겹침 검사(제품에 다른 겹침 검사도 없다 — 새로 만들지 않는다), 全高 벽＋開口 우회의 폐지(기존 案件이 그대로 열려야 한다 — 새 입력은 대체지 강제가 아니다), 壁式構造の壁(2（５）壁2), 별건).\\\\ndocs/ADR.md-545-\\\\ndocs/ADR.md:546:**2026-08-27 보충**: `標準仕様書` 表5.3.1 注1은 「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」고 두 대상을 같은 자리에서 다룬다. 따라서 ADR-037 §3의 「자유단에는 定着을 더하지 않는다」는 판단은 원문이 자유단을 별도로 취급한다는 사실로 지지된다. 이 4d는 加工 형상에 관한 余長이고, 수량은 `数量積算基準` 1通則1)의 「先端で止まる鉄筋はコンクリートの設計寸法」에 따라 가산하지 않는다 — R12의 フック 미반영과 같은 자리다.\\\\ndocs/ADR.md-547-\\\\ndocs/ADR.md-548-### ADR-038: 平面 페인에서 벽·床板을 놓고 지운다 — 잴 수 없는 자리에는 놓지 않는다\\\\ndocs/ADR.md-549-**맥락**: 지금 부재를 만드는 길은 셋뿐이다 — 샘플 案件, 伏図 취입(`apply.ts`), 그리고 없다. 平面 페인은 표시와 開口·범위 입력만 한다(ADR-029·037). 그래서 도면이 없는 사용자는 벽 하나를 더할 수도, 잘못 들어온 床板 하나를 지울 수도 없다. 한편 벽·床板의 内法은 다른 부재가 정한다 — 벽의 内法高さ는 그 辺의 大梁가(`girderDepthAboveWall`), 内法長さ는 양 끝 柱가(`supportColumnSection`), 床板의 内法은 네 변의 大梁가 정한다. 이 중 `girderDepthAboveWall`은 **`MemberUnsupportedError`가 아니라 plain `Error`**를 던지고 `useTakeoff`는 前者만 잡으므로(`src/lib/hooks/useTakeoff.ts:120`), 大梁 없는 辺의 벽은 부재 하나가 떨어지는 것이 아니라 **화면이 통째로 죽는다**.\\\\n--\\\\ndocs/ADR.md-565-- 같은 기준 2（４）床板2) 但書 — 「単独床板及び片持床板の主筋の継手は、1通則4)による。」 連続床板의 区分表가 아니라 길이 기반이다.\\\\ndocs/ADR.md-566-- `標準仕様書` 表5.3.4 L3 スラブ欄 — 「10d かつ150mm以上（**片持スラブの場合は25d**）」. 下端筋 直線定着이 갈린다.\\\\ndocs/ADR.md-567-- 같은 표 5.3.5 注1·2 — La는 「基礎梁、片持梁及び**片持スラブを含む**」, Lb는 「片持小梁及び**片持スラブを除く**」. 上端筋 折曲げ定着의 投影 열이 Lb가 아니라 **La**다.\\\\ndocs/ADR.md:568:- 같은 표 5.3.1 注1 — 「**片持ちスラブ先端**、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d以上とする。」 원문이 片持의 先端과 壁의 自由端을 같은 자리에서 다룬다 — ADR-037이 벽에 세운 자유단 판단을 원문이 지지한다.\\\\ndocs/ADR.md-569-\\\\ndocs/ADR.md-570-**결정**:\\\\ndocs/ADR.md-571-1. **부재를 늘리지 않는다** — `MemberKind`는 넷 그대로이고 片持床板은 `kind: '床板'`이다. 갈리는 것은 **지지 조건**이지 부재가 아니다(ADR-036이 雑壁을 区分으로 담은 것과 같은 형태).\\\\n--\\\\ndocs/ADR.md-578-\\\\ndocs/ADR.md-579-**2026-08-27 정정 (phase 27 step 0의 반증을 받아들임)**: §5의 「25d(＋같은 칸의 150mm 하한을 그대로 딸린다)」는 틀렸다. `表5.3.4`의 L3 スラブ欄은 세로로 병합된 **단일 셀**이고, 그 셀 안의 span 배치가 「10d」(y=265) → 「150mm」(y=293) → 「（片持」(y=336) → 「は25d）」(y=377) 순이므로 괄호는 「10d」만이 아니라 **「10d かつ150mm以上」 전체의 예외값**이다. 따라서 片持スラブ의 L3은 **25d 하나이고 150mm 하한은 딸리지 않는다.** 룰팩에도 片持용 `anchorage.L3.minimum` 행을 만들지 않고, 조회 시 그 행을 끌어오지도 않는다. 이 정정은 값을 바꾸지 않는다 — 제품이 다루는 가장 가는 径이 D10이라 25d ＝ 250mm ＞ 150mm이고, 두 읽기가 모든 径에서 같은 수를 낸다. 그래도 고치는 이유는 근거의 문면이 다르기 때문이다.\\\\ndocs/ADR.md-580-\\\\ndocs/ADR.md:581:### ADR-040: 帯筋·あばら筋의 135°フック 余長을 3D 형상에 그린다 (R12)\\\\ndocs/ADR.md-582-\\\\ndocs/ADR.md:583:**맥락**: R12는 「帯筋·あばら筋 `points`에 135°フック이 없다. 数量은 無影響,\\\\ndocs/ADR.md-584-3D 형상만」으로 열려 있다. 実物의 せん断補強筋은 標準仕様書 5.3.2(2)(ｶ)로\\\\ndocs/ADR.md:585:末端部にフックを付ける가 의무이고, 折曲げ形状·寸法은 表5.3.1이 정한다.\\\\ndocs/ADR.md-586-그런데 제품의 `points`는 かぶり를 控除한 닫힌 사각형(`closed: true`)이라\\\\ndocs/ADR.md-587-꼬리가 없다. `tests/golden/fixtures/fabrication-length.json`의 두 케이스\\\\ndocs/ADR.md-588-(`column-hoop-closed-shape`·`girder-stirrup-closed-shape`)가 이 차이를\\\\ndocs/ADR.md-589-`status: deviation-from-source`와 `missingMm: 156`으로 대장에 적어 두고 있다.\\\\ndocs/ADR.md-590-\\\\ndocs/ADR.md-591-数量은 이 변경에 닿지 않는다 — 数量積算基準 1通則2)가 「その鉄筋の断面の設計\\\\ndocs/ADR.md:592:寸法による周長とし、フックは計上しない」이므로 `Rebar.length`·`count`는 그대로다.\\\\ndocs/ADR.md-593-\\\\ndocs/ADR.md-594-**결정**:\\\\ndocs/ADR.md-595-\\\\ndocs/ADR.md-596-1. 帯筋(矩形·円形)·あばら筋의 `points`에 양 끝 **余長**을 그린다. 余長 길이는\\\\ndocs/ADR.md:597:   룰팩 `bend.hook135`(6d)를 呼び名径에 곱해서 얻는다. `.ts`에 수치를 쓰지 않는다.\\\\ndocs/ADR.md-598-2. 두 꼬리는 **같은 한 코너**에 붙는다. 矩形은 코너 A에서 출발해 A로 돌아오는\\\\ndocs/ADR.md-599-   폴리라인(A→B→C→D→A)에 A 바깥쪽 양 끝점을 더한 7점이 되고, `closed`는\\\\ndocs/ADR.md-600-   **`false`**가 된다. 닫힌 사각형의 둘레는 그대로 남으므로 폴리라인 실장은\\\\n--\\\\ndocs/ADR.md-602-3. 꼬리 방향은 **단면 안쪽 대각**이다 — 인접 두 변 어느 쪽에서 보아도 135°가\\\\ndocs/ADR.md-603-   되는 유일한 방향이다. **어느 코너에 붙일지와 꼬리가 놓이는 면은 원문에 없다**.\\\\ndocs/ADR.md-604-   表5.3.1은 형상을 주지 그 위치를 주지 않으므로 이것은 제품의 작도 규칙이고\\\\ndocs/ADR.md:605:   (ADR-019와 같은 부류), R2·R12에 남긴다.\\\\ndocs/ADR.md-606-4. **折曲げ内法直径(D)에 의한 曲げ部の伸び는 그리지 않는다.** 表5.3.1의 折曲げ図는\\\\ndocs/ADR.md-607-   원문에서 이미지이고, 内法直径은 組立 치수라 중심선 폴리라인 길이로 곧바로\\\\ndocs/ADR.md-608-   환산되지 않는다. 加工長 골든의 기대값은 「직선부 ＋ 余長」이며, 남은 차액은\\\\ndocs/ADR.md-609-   케이스의 `deviation`을 지우지 말고 term을 `bendRadius`로 **좁혀서** 대장에\\\\ndocs/ADR.md:610:   남긴다. 즉 R12는 「フック이 없다」에서 「曲げ部の伸び가 없다」로 줄어들며 닫히지\\\\ndocs/ADR.md-611-   않는다.\\\\ndocs/ADR.md-612-5. 幅止め筋·主筋·壁筋·床板筋의 형상은 건드리지 않는다. 幅止め筋도\\\\ndocs/ADR.md-613-   5.3.2(2)(ｶ)의 대상이지만 이미 `closed: false`의 열린 폴리라인이고 R12의\\\\ndocs/ADR.md-614-   문언 밖이다 — 범위를 넓히면 이 phase의 회귀 범위가 부재 전체가 된다.\\\\ndocs/ADR.md:615:6. **表5.3.1 注1**(「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°\\\\ndocs/ADR.md:616:   フックを用いる場合には、余長は4d 以上とする」)은 **설계도서 조건**이다.\\\\ndocs/ADR.md:617:   「用いる場合には」이므로 그 자리에 훅이 있는지 자체가 特記 사항이고, 제품은\\\\ndocs/ADR.md-618-   훅의 유무를 추정하지 않는다(ADR-029의 開口補強筋과 같은 원리). 따라서\\\\ndocs/ADR.md-619-   그리지 않고 룰팩 행도 만들지 않는다. 대신 원문 전사 대장\\\\ndocs/ADR.md-620-   `tests/golden/fixtures/spec-r7-ch5.json`에 조문을 싣고, 「片持床板 先端과\\\\n--\\\\ntests/golden/fixtures/fabrication-length.json-17-      \\\\\\\"pageNote\\\\\\\": \\\\\\\"pdfPage ＝ printedPage ＋ 5。加工長そのものは標準仕様書が定めるが、柱主筋の上端で定着を加えないという判定だけはこちらが根拠（R9①）。\\\\\\\"\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-18-    }\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-19-  ],\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:20:  \\\\\\\"scope\\\\\\\": \\\\\\\"3D に描かれる加工形状の長さ（加工長）＝ Rebar.points が描く折れ線の実長。数量積算基準の設計長さ（Rebar.length）とは別物で、一致する必要もない（ADR-019）。設計長さ側は tests/golden/quantity*.test.ts が固定する。継手は位置が未確定なので描かれず、この加工長には入らない。\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-21-  \\\\\\\"derivedBy\\\\\\\": \\\\\\\"各期待値は下の terms（原文表の独立転写）だけを使った手計算である。lookupRule を通していない（ADR-010）。\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-22-  \\\\\\\"terms\\\\\\\": [\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-23-    {\\\\r\\\\n--\\\\ntests/golden/fixtures/fabrication-length.json-58-      \\\\\\\"label\\\\\\\": \\\\\\\"折曲げ定着の全長は表5.3.4の直線定着の長さ以上\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-59-      \\\\\\\"quote\\\\\\\": \\\\\\\"折曲げ定着とする場合の全長は、表5.3.4 の直線定着の長さ以上とする。\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-60-      \\\\\\\"conditions\\\\\\\": {\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:61:        \\\\\\\"detail\\\\\\\": \\\\\\\"折曲げ定着\\\\\\\"\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-62-      },\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-63-      \\\\\\\"referencesTerm\\\\\\\": \\\\\\\"L1\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-64-      \\\\\\\"value\\\\\\\": 0,\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-65-      \\\\\\\"unit\\\\\\\": \\\\\\\"reference\\\\\\\"\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-66-    },\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-67-    {\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:68:      \\\\\\\"id\\\\\\\": \\\\\\\"tailMinimum\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-69-      \\\\\\\"sourceId\\\\\\\": \\\\\\\"spec\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-70-      \\\\\\\"table\\\\\\\": \\\\\\\"5.3.4(5)(ｲ)(b)\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-71-      \\\\\\\"printedPage\\\\\\\": 31,\\\\r\\\\n--\\\\ntests/golden/fixtures/fabrication-length.json-83-      \\\\\\\"pdfPage\\\\\\\": 37,\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-84-      \\\\\\\"label\\\\\\\": \\\\\\\"梁主筋の柱内定着の投影長下限（柱せいの3/4倍以上）\\\\\\\",\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-85-      \\\\\\\"conditions\\\\\\\": {\\\\r\\\\ntests/golden/fixtures/fabrication-length.json:86:        \\\\\\\"detail\\\\\\\": \\\\\\\"梁主筋の柱内定着\\\\\\\"\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-87-      },\\\\r\\\\ntests/golden/fixtures/fabrication-length.json-88-      \\\\\\\"value\\\\\\\": 0.75,