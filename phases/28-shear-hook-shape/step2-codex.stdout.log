 38:   page.evaluate(() => ({\\r\\n  39:     renderer: window.__kijunViewerRuntime.getRendererInfo(),\\r\\n  40:     rebuild: window.__kijunViewerRuntime.getRebuildStats(),\\r\\n  41:   }));\\r\\n  42: \\r\\n  43: // rAF を待たずに、編集が内訳書に出るまでを測る。requestAnimationFrame は\\r\\n  44: // 可視でないページで 1Hz に絞られるので、待つと計測が全部1秒になる。\\r\\n  45: const editLatencyMs = (pitch) =>\\r\\n  46:   page.evaluate(async (nextPitch) => {\\r\\n  47:     const input = document.querySelector(\\\"input[aria-label='C1 帯筋 ピッチ']\\\");\\r\\n  48:     // 単位質量は利用者入力なので、未入力だと合計は「—」のまま動かない。\\r\\n  49:     // ピッチで動くのは本数と総延長だ — 表ぜんぶの文字を見る。\\r\\n  50:     const table = document\\r\\n  51:       .querySelector(\\\"[data-testid='grand-total']\\\")\\r\\n  52:       .closest(\\\"table\\\");\\r\\n  53:     const before = table.textContent;\\r\\n  54:     const setter = Object.getOwnPropertyDescriptor(\\r\\n  55:       window.HTMLInputElement.prototype,\\r\\n  56:       \\\"value\\\",\\r\\n  57:     ).set;\\r\\n  58: \\r\\n  59:     const start = performance.now();\\r\\n  60:     setter.call(input, String(nextPitch));\\r\\n  61:     input.dispatchEvent(new Event(\\\"input\\\", { bubbles: true }));\\r\\n  62: \\r\\n  63:     for (let attempt = 0; attempt < 600; attempt += 1) {\\r\\n  64:       if (table.textContent !== before) {\\r\\n  65:         return Math.round(performance.now() - start);\\r\\n  66:       }\\r\\n  67:       await new Promise((resolve) => setTimeout(resolve, 10));\\r\\n  68:     }\\r\\n  69:     return null;\\r\\n  70:   }, pitch);\\r\\n  71: \\r\\n  72: // 自動保存 (IndexedDB) は前の走行を持ち越す。消してから始めないと、この筋書きは\\r\\n  73: // 「一度目だけ通る」ものになる — 再訪経路そのものを見る uc15 だけは自分で管理する。\\r\\n  74: await page.goto(\\\"http://localhost:3000\\\", { waitUntil: \\\"domcontentloaded\\\" });\\r\\n  75: await page.evaluate(\\r\\n  76:   () =>\\r\\n  77:     new Promise((resolve) => {\\r\\n  78:       const request = indexedDB.deleteDatabase(\\\"kijun\\\");\\r\\n  79:       request.onsuccess = resolve;\\r\\n  80:       request.onerr