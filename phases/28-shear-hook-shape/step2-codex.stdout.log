n    }),\r\n);\r\n\r\nconsole.log(JSON.stringify({ environment, sample, stressed }, null, 2));\r\nconsole.log(\r\n  \"SHOT \" + (await saveScreenshot(await page.screenshot(), \"uc17-stress.png\")),\r\n);\r\n","exit_code":0,"status":"completed"}}
