> 1) {\r\n    edges.push({\r\n      from: rebar.points[rebar.points.length - 1],\r\n      to: rebar.points[0],\r\n    })\r\n  }\r\n\r\n  if (rebar.hookTails !== undefined && rebar.points.length > 0) {\r\n    for (const tail of rebar.hookTails) {\r\n      edges.push({ from: rebar.points[0], to: tail })\r\n    }\r\n  }\r\n\r\n  const zones = rebar.zones ?? []\r\n  const boundaries = zones.flatMap(({ pathFromMm, pathToMm }) => [\r\n    pathFromMm,\r\n    pathToMm,\r\n  ])\r\n  const runs: PathRun[] = []\r\n  let walked = 0\r\n\r\n  for (const edge of edges) {\r\n    const length = pointDistance(edge.from, edge.to)\r\n    if (length === 0) continue\r\n\r\n    const edgeEnd = walked + length\r\n    const cuts = [\r\n===== src/components/viewer/Viewer3D.tsx =====\r\n  } satisfies Record<'core' | NonNullable<RebarBatch['zone']>, THREE.MeshStandardMaterial>\r\n  const pickableMeshes: THREE.Mesh[] = []\r\n  const bounds = memberBounds(view)\r\n\r\n  addMemberConcrete(content, view, runtime)\r\n  addGround(content, bounds, runtime)\r\n\r\n  // ?싥걮嶺뗭? ???먯젏 湲곗?, ?귙겙?됬춮? ?먭린 ?ㅽ뙩 ?먯젏 湲곗??쇰줈 留뚮뱾?댁쭊?? ?곗쓣 ??\r\n  // ?꾨젅?꾩뿉 洹몃━誘濡?遺?щ퀎 ?ㅽ봽?뗭쓣 嫄몄뼱 留욎텣?????싥걮嶺뗭쓽 memberId???????\r\n  // 遺?щ씪 ?ㅽ봽??0???섏뼱 媛숈? 議고쉶濡??④퍡 泥섎━?쒕떎.\r\n  // 佯딀씮??꺀?녈겗?잏궧?뚪겦?볝걽?쇻궎?③걬?녴겗?㎯곲뎱嶺뗣걹??굚??굮?졼겦野꾠걵?뗣?\r\n  // 鸚㎪쥈??originOffsetMm ???? x ?쀣걢?뺛걢?쎼걳?곩틞?욍겘 x?퍈 ???밧릲?뚩쫨?뗣?\r\n  const toBayFrame = (rebar: Rebar): Rebar => {\r\n    if (view.kind !== '佯딀씮') return rebar\r\n\r\n    const shiftX = rebar.role.startsWith('X?밧릲') ? view.x.offsetMm : 0\r\n    const shiftY = rebar.role.startsWith('Y?밧릲') ? view.y.offsetMm : 0\r\n    if (shiftX === 0 && shiftY === 0) return rebar\r\n\r\n    const shiftPoint = ([pointX, pointY, pointZ]: Point3): Point3 => [\r\n      pointX - shiftX,\r\n      pointY - shiftY,\r\n      pointZ,\r\n    ]\r\n\r\n    return {\r\n      ...rebar,\r\n      points: rebar.points.map(shiftPoint),\r\n      ...(rebar.hookTails === undefined\r\n        ? {}\r\n        : {\r\n            hookTails: rebar.hookTails.map(shiftPoint) as Rebar['hookTails'],\r\n          }),\r\n    }\r\n  }\r\n\r\n  // ?뗥룭?ⓦ겘?꾤춮?ⓨ릪?섉옞?멨칱?쎼굥 (1?싧뎴8))?귛즯??깿?먨???앫겗?얇겲?곩틞?욍겘\r\n  // ?⒲꺍佯㎪쮽?뗣굢?좑펷?멥굯?졼깧?ㅿ펹?멥걎oBayFrame ?ⓨ릪?섇늽?졼걨?삠걲??\r\n  const openingsFor = (rebar: Rebar): Opening[] => {\r\n    if (view.kind === '?먬쐡鶯?) return view.member.openings ?? []\r\n    if (view.kind !== '佯딀씮') return []\r\n          view.run.members.length,\r\n          view.run.coreLengthMm,\r\n          view.run.members.map(({ id }) => id),\r\n          view.run.spans.map((span) => [\r\n            span.clear,\r\n            span.startSupportLengthAlongAxisMm,\r\n            span.endSupportLengthAlongAxisMm,\r\n          ]),\r\n          view.supportSections.map(({ b, d }) => [b, d]),\r\n        ]\r\n\r\n  return JSON.stringify([\r\n    view.member.id,\r\n    sectionGeometry,\r\n    view.story.height,\r\n    // placement??諛곗튂???좎씪??異쒖쿂????鍮쇰㈃ ?ф빊媛 媛숈? 諛곗튂 蹂寃?訝딃깿鸚㎪쥈?쎼걚\r\n    // 誘몄꽭 議곗젙)???ъ쓣 ???꾩튂濡??④릿??\r\n    view.rebars.map(\r\n      ({ role, size, count, closed, points, hookTails, zones, placement }) => [\r\n        role,\r\n        size,\r\n        count,\r\n        closed,\r\n        points,\r\n        hookTails,\r\n        zones,\r\n        placement,\r\n      ],\r\n    ),\r\n    [...view.rowIds],\r\n  ])\r\n===== src/components/viewer/stress-scale.test.ts =====\r\n\r\nimport type { ColumnSection, GirderSection } from '@/domain/model/member'\r\nimport {\r\n  beamDepthAbove,\r\n  columnEnds,\r\n  findSection,\r\n  girderRun,\r\n  type Project,\r\n} from '@/domain/model/project'\r\nimport type { Rebar } from '@/domain/model/rebar'\r\nimport { aggregateQuantity } from '@/domain/quantity'\r\nimport { createStressProject } from '@/domain/model/stress-project'\r\nimport { generateColumnRebar } from '@/domain/rebar/column'\r\nimport { generateGirderRebar } from '@/domain/rebar/girder'\r\nimport { jpMlitRulePack } from '@/rulepack'\r\n\r\nimport { buildingLayout } from '@/lib/viewer/building'\r\n\r\n/**\r\n * useTakeoff.ts??buildTakeoff? 媛숈? 遺???쒗쉶?? 遺???쒗뿕 ?쎌뒪泥섎뒗 ??긽\r\n * ?깅┰?섎뒗 洹좎씪 ?뺤긽?대?濡?誘몄꽦由?遺??MemberUnsupportedError) 泥섎━???앸왂?쒕떎 ??\r\n * ?ш린???섏졇吏硫??쎌뒪泥??먯껜媛 ?섎せ?먮떎???좏샇?대?濡??뚯뒪?멸? 洹몃?濡??ㅽ뙣?댁빞 ?쒕떎.\r\n */\r\nfunction generateAllRebar(project: Project): Rebar[] {\r\n  const rebars: Rebar[] = []\r\n  const processedGirderMemberIds = new Set<string>()\r\n\r\n  for (const member of project.members) {\r\n    if (member.kind === '鸚㎪쥈' && processedGirderMemberIds.has(member.id)) {\r\n      continue\r\n    }\r\n\r\n    const section = findSection(project, member.sectionId)\r\n    const story = project.stories.find(({ id }) => id === member.storyId)\r\n    if (!story) throw new Error(`Story not found: ${member.storyId}`)\r\n\r\n    if (member.kind === '??) {\r\n      rebars.push(\r\n        ...generateColumnRebar(\r\n          {\r\n            member,\r\n            section: section as ColumnSection,\r\n            story,\r\n            beamDepthAbove: beamDepthAbove(project, member),\r\n            ends: columnEnds(project, member),\r\n          },\r\n          jpMlitRulePack,\r\n        ),\r\n      )\r\n      continue\r\n    }\r\n\r\n    const run = girderRun(project, member)\r\n    for (const runMember of run.members) {\r\n      processedGirderMemberIds.add(runMember.id)\r\n    }\r\n    rebars.push(\r\n      ...generateGirderRebar(\r\n        { run, section: section as GirderSection },\r\n        jpMlitRulePack,\r\n      ),\r\n    )\r\n  }\r\n\r\n  return rebars\r\n}\r\n\r\ndescribe('createStressProject at building-view scale (R4)', () => {\r\n  it('reaches on the order of 10,000 rebar instances in one story', () => {\r\n    const project = createStressProject({\r\n      xSpanCount: 4,\r\n      ySpanCount: 3,\r\n      storyCount: 1,\r\n    })\r\n\r\n    const rebars = generateAllRebar(project)\r\n    const layout = buildingLayout(project, rebars, new Set())\r\n\r\n    // R4: \"痢듬떦 泥좉렐 1留?媛?洹쒕え\". InstancedMesh.setMatrixAt ?몄텧 ?섏? 吏곴껐?섎뒗\r\n    // ?ㅼ젣 ?뚮뜑 ?몄뒪?댁뒪 ??RebarInstance)瑜?湲곗??쇰줈 ?쇰뒗?????뺥솗??10,000??\r\n    // ?꾩슂???녾퀬, 洹몃룞??誘몄륫?뺤씠???먮┸???섏쿇~?섎쭔)???ㅼ젣濡??ㅼ뼱?ㅻ뒗吏媛 紐⑹쟻?대떎.\r\n    console.log(`building-view rebar instances (1 story): ${layout.rebar.length}`)\r\n    expect(layout.rebar.length).toBeGreaterThanOrEqual(8000)\r\n    expect(layout.rebar.length).toBeLessThanOrEqual(12000)\r\n  })\r\n\r\n  // dev-browser濡?痢≪젙???ㅼ젣 ?몄쭛?믪옱?뚮뜑 吏????120~190ms)??rebuildScene??\r\n  // ?숆린 ?ㅽ뻾?쒓컙(??7~9ms)蹂대떎 ?⑥뵮 ?щ떎??寃??섏솕????buildTakeoff媛 project瑜?\r\n  // ?듭㎏濡?硫ㅻ쾭 ?⑥쐞 罹먯떆 ?놁씠) ?ㅼ떆 ?꾨뒗 寃?洹?寃⑹감???먯씤?몄? ?ш린??遺꾨━?댁꽌 ?곕떎.\r\n  it('profiles buildTakeoff-equivalent recomputation cost at stress scale', () => {\r\n    const project = createStressProject({\r\n      xSpanCount: 4,\r\n      ySpanCount: 3,\r\n      storyCount: 1,\r\n    })\r\n\r\n    const time = (label: string, fn: () => void, iterations = 5): number[] => {\r\n      const samples: number[] = []\r\n      for (let i = 0; i < iterations; i += 1) {\r\n        const start = performance.now()\r\n        fn()\r\n        samples.push(performance.now() - start)\r\n      }\r\n      samples.sort((left, right) => left - right)\r\n      console.log(\r\n        `${label}: median=${samples[Math.floor(iterations / 2)].toFixed(2)}ms ` +\r\n          `min=${samples[0].toFixed(2)}ms max=${samples[iterations - 1].toFixed(2)}ms`,\r\n      )\r\n      return samples\r\n    }\r\n\r\n    let rebars: Rebar[] = []\r\n    const rebarSamples = time('generateAllRebar', () => {\r\n      rebars = generateAllRebar(project)\r\n    })\r\n    console.log(`rebar entity count: ${rebars.length}`)\r\n\r\n    const quantitySamples = time('aggregateQuantity', () => {\r\n      aggregateQuantity(project, rebars, jpMlitRulePack)\r\n    })\r\n\r\n    const layoutSamples = time('buildingLayout', () => {\r\n      buildingLayout(project, rebars, new Set())\r\n    })\r\n\r\n    // ?뺣쭚 臾대꼫吏?寃??꾨땶吏留??〓뒗 ?먯뒯???곹븳?대떎 ???뺥솗???섏튂??肄섏넄 濡쒓렇瑜?蹂몃떎.\r\n    expect(Math.max(...rebarSamples)).toBeLessThan(2000)\r\n    expect(Math.max(...quantitySamples)).toBeLessThan(2000)\r\n    expect(Math.max(...layoutSamples)).toBeLessThan(2000)\r\n  })\r\n})\r\n===== package.json =====\r\n  \"name\": \"kijun\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"next dev\",\r\n    \"build\": \"next build\",\r\n    \"lint\": \"eslint .\",\r\n    \"typecheck\": \"tsc --noEmit\",\r\n    \"test\": \"vitest run\",\r\n    \"test:golden\": \"vitest run tests/golden\",\r\n    \"lighthouse\": \"lhci autorun --config=lighthouserc.cjs\",\r\n    \"perf:measure\": \"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\",\r\n    \"eval\": \"tsx --env-file-if-exists=.env evals/harness/run.ts\",\r\n    \"test:hooks\": \"bash scripts/hooks/tdd-guard.spec.sh\",\r\n    \"hooks:install\": \"git config core.hooksPath scripts/githooks\",\r\n    \"test:ci-scripts\": \"bash scripts/ci/scrub-secrets.spec.sh && bash scripts/ci/review-scope.spec.sh && bash scripts/ci/review-carryforward.spec.sh && bash scripts/ci/review-verdict.spec.sh && bash scripts/ci/distill-failure-log.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts/perf/blocking-graph.test.mjs\"\r\n  },\r\n  \"dependencies\": {\r\n    \"exceljs\": \"^4.4.0\",\r\n    \"js-yaml\": \"^5.2.3\",\r\n    \"next\": \"^15.5.23\",\r\n    \"pdfjs-dist\": \"6.2.108\",\r\n    \"posthog-js\": \"1.417.4\",\r\n    \"react\": \"^19.2.8\",\r\n    \"react-dom\": \"^19.2.8\",\r\n    \"three\": \"^0.185.1\",\r\n    \"zustand\": \"^5.0.14\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@anthropic-ai/sdk\": \"^0.116.0\",\r\n    \"@lhci/cli\": \"0.15.1\",\r\n    \"@testing-library/jest-dom\": \"^7.0.0\",\r\n    \"@testing-library/react\": \"^16.3.2\",\r\n    \"@types/js-yaml\": \"^4.0.9\",\r\n    \"@types/node\": \"^26.2.0\",\r\n    \"@types/react\": \"^19.2.18\",\r\n    \"@types/react-dom\": \"^19.2.4\",\r\n    \"@types/three\": \"^0.185.4\",\r\n    \"@vitejs/plugin-react\": \"^6.0.5\",\r\n    \"autoprefixer\": \"^10.5.4\",\r\n    \"eslint\": \"^8.57.1\",\r\n    \"eslint-config-next\": \"^15.5.23\",\r\n    \"fake-indexeddb\": \"6.2.5\",\r\n    \"jsdom\": \"^30.0.1\",\r\n    \"postcss\": \"^8.5.26\",\r\n    \"raw-loader\": \"^4.0.2\",\r\n    \"tailwindcss\": \"^3.4.17\",\r\n    \"tsx\": \"^4.23.12\",\r\n    \"typescript\": \"^5.9.3\",\r\n    \"vitest\": \"^4.1.10\"\r\n  },\r\n  \"overrides\": {\r\n    \"posthog-js\": \"1.417.4\"\r\n  }\r\n}\r\n===== tests/e2e/uc10-viewer-features.js =====\r\n// 3D ?대? ?곹깭(mesh.visible쨌clippingPlanes)???좊떅?뚯뒪?멸? 蹂몃떎. ?ш린?쒕뒗\r\n// ??釉뚮씪?곗??먯꽌留??뺤씤?섎뒗 寃???而⑦듃濡ㅼ씠 DOM??遺숈뿀?붿?, ?ㅼ젣 WebGL ?ъ뿉\r\n// ?덉씠罹먯뒪?멸? 嫄몃젮 ?댄똻???⑤뒗吏, 踰붾? ?섏튂媛 ?뚮뜑?섎뒗吏 ??留?蹂몃떎.\r\nconst page = await browser.getPage(\"kijun\");\r\n// ?ゅ땿岳앭춼 (IndexedDB) ??뎺??뎔烏뚣굮?곥걾擁듽걲?귝텋?쀣겍?뗣굢冶뗣굙?ゃ걚?ⓦ곥걪??춮?멥걤??\r\n// ?뚥?佯?쎅?졼걨?싥굥?띲굚??겓?ゃ굥 ???띹Ø永뚩러?앫겗?귙겗?믦쫳??uc15 ?졼걨??눎?녴겎嶸←릤?쇻굥??\r\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"domcontentloaded\" });\r\nawait page.evaluate(\r\n  () =>\r\n    new Promise((resolve) => {\r\n      const request = indexedDB.deleteDatabase(\"kijun\");\r\n      request.onsuccess = resolve;\r\n      request.onerror = resolve;\r\n      request.onblocked = resolve;\r\n    }),\r\n);\r\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"domcontentloaded\" });\r\n// ?ゅ땿岳앭춼 (M4) ?뚦뎺??춮?멥걤??랬?녴굮孃⒴뀇?쇻굥?귙겑??춮?멥걤?귙궢?녈깤?ユ죭餓뜰걢??\r\n// 冶뗣굙?잆걚??겎?곫??앫겗??겹겎鼇섌뙯?믤텋?쀣겍?뗣굢沃?겳?담걲??\r\nawait page.evaluate(\r\n  () =>\r\n    new Promise((resolve) => {\r\n      const request = indexedDB.deleteDatabase(\"kijun\");\r\n      request.onsuccess = resolve;\r\n      request.onerror = resolve;\r\n      request.onblocked = resolve;\r\n    }),\r\n);\r\nawait page.reload({ waitUntil: \"domcontentloaded\" });\r\nawait page.waitForSelector(\"[data-testid='grand-total']\");\r\nawait page.waitForSelector(\"canvas\");\r\n\r\nconst checks = {};\r\n\r\n// 鸚㎪쥈 G1 ?좏깮 ????똻 ?ㅽ뙩?대씪 zones媛 ?덇퀬 踰붾?媛 ?щ떎\r\ncon