} from '@/lib/import/runs'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\ntype ElevationFixture = {\r\n  heightsMm?: number[]\r\n  levels?: string[]\r\n  levelTexts?: string[]\r\n  elevations: Array<{\r\n    title?: string\r\n    levels?: string[]\r\n    levelsBottom?: string[]\r\n    heightsMm?: number[]\r\n    heightsBottomMm?: number[]\r\n  }>\r\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readGolden(file: string): ElevationFixture {\r\n  return JSON.parse(\r\n    readFileSync(\r\n      resolve(process.cwd(), 'tests/fixtures/plan-import/expected', file),\r\n      'utf8',\r\n    ),\r\n  ) as ElevationFixture\r\n}\r\n\r\nfunction elevationForTitle(\r\n  parsed: ReturnType<typeof parseFrameElevations>,\r\n  title: string,\r\n): ReturnType<typeof parseFrameElevations>['elevations'][number] {\r\n  const normalized = compact(title)\r\n  const expectedTitle = normalized.includes('邕며탡??)\r\n    ? normalized\r\n    : `${normalized}邕며탡??\r\n  const matches = parsed.elevations.filter((elevation) =>\r\n    elevation.titles.some(\r\n      (candidateTitle) =>\r\n        candidateTitle === expectedTitle ||\r\n        candidateTitle.startsWith(`${expectedTitle}S=`),\r\n    ),\r\n  )\r\n  expect(matches).toHaveLength(1)\r\n  return matches[0]!\r\n}\r\n\r\nfunction labelsByLevel(\r\n  elevation: ReturnType<typeof parseFrameElevations>['elevations'][number],\r\n): string[][] {\r\n  return elevation.levels.map((level) => level.labels)\r\n}\r\n\r\ndescribe('?롩쳵 corpus 2 怨⑤뱺', () => {\r\n  it('karatsu: ?쒕ぉ?쇰줈 ??묓븳 X2쨌X3 ??釉붾줉???믪씠? ?덈꺼 ?쇰꺼??怨⑤뱺怨??議고븳??, () => {\r\n    const golden = readGolden('karatsu-jikugumi1-p1-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('karatsu-jikugumi1-p1.json'))\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(2)\r\n    const expectedElevations = golden.elevations.filter((entry) =>\r\n      entry.title === 'X2?싥굤' || entry.title === 'X3?싥굤',\r\n    )\r\n\r\n    // X4?싥굤???띿뒪?몄뿉 ?덈꺼 ?쇰꺼 ?댁씠 ?놁뼱 怨⑤뱺 ?議곗뿉???쒖쇅?쒕떎.\r\n    // X2쨌X3? ?쒕ぉ???뺥솗??邕며탡???멸렇癒쇳듃濡?怨꾩뿴????묓븳??\r\n    expect(expectedElevations).toHaveLength(2)\r\n    for (const expected of expectedElevations) {\r\n      const actual = elevationForTitle(parsed, expected.title!)\r\n      expect(actual.heightsMm).toEqual(golden.heightsMm)\r\n      expect(labelsByLevel(actual)).toEqual(\r\n        golden.levelTexts!.map((label) => [label]),\r\n      )\r\n    }\r\n  })\r\n\r\n  it('tsu: ?쒕ぉ?쇰줈 ??묓븳 Y3 釉붾줉??怨⑤뱺 遺遺??꾩궗 ?믪씠? ?쇰꺼 ?댁쓣 ?議고븳??, () => {\r\n    const golden = readGolden('tsu-kanritou-p21-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('tsu-p21.json'))\r\n    const expected = golden.elevations[0]!\r\n    const actual = elevationForTitle(parsed, expected.title!)\r\n    const expectedHeights = expected.heightsBottomMm!\r\n    const expectedLabels = expected.levelsBottom!.map((label) => [label])\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    // 2FL ?꾩そ? 理쒖긽???덈꺼 ?쇰꺼???뺤젙?섏? ?딆? 怨⑤뱺 遺遺??꾩궗?대?濡?\n    // ?믪씠? ?쇰꺼 紐⑤몢 ?꾨옒履?怨⑤뱺 援ш컙留??議고븳??\r\n    expect(actual.heightsMm.slice(-expectedHeights.length)).toEqual(\r\n      expectedHeights,\r\n    )\r\n    expect(labelsByLevel(actual).slice(-expectedLabels.length)).toEqual(\r\n      expectedLabels,\r\n    )\r\n  })\r\n\r\n  it('hirosaki: ?쒕ぉ?쇰줈 ??묓븳 X1쨌X2쨌X3 ??釉붾줉???믪씠? ?덈꺼 ?쇰꺼??怨⑤뱺怨??議고븳??, () => {\r\n    const golden = readGolden('hirosaki-kikyono-p25-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('hirosaki-p25.json'))\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(3)\r\n    expect(golden.elevations).toHaveLength(3)\r\n    for (const expected of golden.elevations) {\r\n      const actual = elevationForTitle(parsed, expected.title!)\r\n      expect(actual.heightsMm).toEqual(expected.heightsMm)\r\n      expect(labelsByLevel(actual)).toEqual(\r\n        expected.levels!.map((label) => [label]),\r\n      )\r\n    }\r\n  })\r\n})\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { TextItem } from '../types'\r\nimport type { TextPage } from '../section-list/types'\r\n\r\nimport { parseFrameElevations } from './elevation'\r\n\r\n// ?ㅻЪ ?꾨㈃ ?쎌뒪泥??議곕뒗 tests/plan-import/elevation.test.ts???덈떎.\r\n\r\nfunction h(str: string, x: number, y: number): TextItem {\r\n  return { str, x, y, w: 0, h: 8 }\r\n}\r\n\r\nconst VERTICAL_GLYPH_WIDTH_PT = 8\r\n\r\n/** ?몃줈?곌린 移섏닔. 邕며탡?녹쓽 ?롩쳵 移섏닔???ㅻЪ?먯꽌 rot=-90?대떎.\r\n *  ?몄옄 y??臾몄옄?댁쓽 臾쇰━ 以묒떖?닿퀬, TextItem.y(?먯젏)??吏꾪뻾??w???덈컲留뚰겮\r\n *  洹??꾨옒????VerticalRun.y媛 諛붿슫??諛뺤뒪 以묒떖?대씪?쒕떎 (runs.ts) */\r\nfunction v(str: string, x: number, y: number): TextItem {\r\n  return {\r\n    str,\r\n    x,\r\n    y: y + VERTICAL_GLYPH_WIDTH_PT / 2,\r\n    w: VERTICAL_GLYPH_WIDTH_PT,\r\n    h: 0,\r\n    rot: -90,\r\n  }\r\n}\r\n\r\nfunction page(items: TextItem[]): TextPage {\r\n  return { widthPt: 1000, heightPt: 1000, items }\r\n}\r\n\r\n/**\r\n * 異뺤쿃 0.05pt/mm??4?덈꺼. 移섏닔???먭린媛 ?щ뒗 援ш컙??**以묒젏**???볦씠誘濡?\n * ?몄젒 ??移섏닔??媛꾧꺽??(v0+v1)/2 횞 異뺤쿃???쒕떎 ???뚯꽌??洹?愿怨꾨줈 異뺤쿃???쇰떎.\r\n *\r\n * 移섏닔媛 ?뗭씤 寃껋? ?꾩슂議곌굔?대떎 ???섏씠硫??좊룄??異뺤쿃???議고븷 ?곷?媛 ?녿떎.\r\n */\r\nfunction fourLevels(): TextItem[] {\r\n  return [\r\n    v('2000', 50, 150),\r\n    v('2000', 50, 250),\r\n    v('2000', 50, 350),\r\n    h('RFL', 80, 100),\r\n    h('3FL', 80, 200),\r\n    h('2FL', 80, 300),\r\n    h('1FL', 80, 400),\r\n    // 怨꾩뿴? 邕며탡?녹뿉 ?랁븳?????쒕ぉ???놁쑝硫?臾댁뾿???믪씠?몄? 留먰븷 ???녿떎\r\n    h('bY1?싥굤邕며탡??/100', 300, 500),\r\n  ]\r\n}\r\n\r\ndescribe('parseFrameElevations', () => {\r\n  it('移섏닔 ?댁씠 ?놁쑝硫?野멩퀡?쀦쑋濾쒎눣', () => {\r\n    const parsed = parseFrameElevations(page([h('2FL', 80, 200)]))\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('移섏닔 ?곗뇙?먯꽌 異뺤쿃怨??덈꺼 ?꾩튂瑜??怨? ?쇰꺼???먮Ц 洹몃?濡?遺숈씤??, () => {\r\n    const parsed = parseFrameElevations(page(fourLevels()))\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toEqual([\r\n      {\r\n        titles: ['bY1?싥굤邕며탡??/100'],\r\n        levels: [\r\n          { labels: ['RFL'], positionPt: 100 },\r\n          { labels: ['3FL'], positionPt: 200 },\r\n          { labels: ['2FL'], positionPt: 300 },\r\n          { labels: ['1FL'], positionPt: 400 },\r\n        ],\r\n        heightsMm: [2000, 2000, 2000],\r\n        scalePtPerMm: 0.05,\r\n      },\r\n    ])\r\n  })\r\n\r\n  it('媛숈? ?믪씠???쇰꺼???섏씠硫??????ｋ뒗?????대뒓 履쎌씠 ?롮씤吏 怨좊Ⅴ吏 ?딅뒗??, () => {\r\n    // ?ㅻЪ yokohama p8???뚥릎鸚?짘1FL?띻낵 ?뚦읃繹뺾L?띿씠 ??愿怨꾨떎 (190mm 李?竊?5pt)\r\n    const parsed = parseFrameElevations(\r\n      page([...fourLevels(), h('?뷸틬GL', 20, 403)]),\r\n    )\r\n    expect(parsed.elevations[0]?.levels.at(-1)).toEqual({\r\n      labels: ['1FL', '?뷸틬GL'],\r\n      positionPt: 400,\r\n    })\r\n  })\r\n\r\n  it('?쇰꺼??遺숈? ?덈꺼????誘몃쭔?대㈃ 怨꾩뿴濡?蹂댁? ?딅뒗??, () => {\r\n    // 遺遺?移섏닔 ???뗣겤?듏룡?藥???? ?쇰꺼??媛뽰? ?딅뒗????洹멸쾬???좎씪??援щ텇?대떎\r\n    const parsed = parseFrameElevations(\r\n      page(\r\n        fourLevels().filter(\r\n          (item) => !['RFL', '3FL', '2FL'].includes(item.str),\r\n        ),\r\n      ),\r\n    )\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('移섏닔媛 ?섎퓧???댁? 怨꾩뿴濡?蹂댁? ?딅뒗?????좊룄??異뺤쿃???議고븷 ?곷?媛 ?녿떎', () => {\r\n    // ?ㅻЪ kani p40?먯꽌???꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔媛 ???대줈 ?댁뼱??\n    // 異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???먮━??留덉묠 湲?먭? ?덉뼱 ?듦낵?덈떎\r\n    const parsed = parseFrameElevations(\r\n      // 354 = 以묒떖 350 + w/2 ??v()媛 ?먯젏??以묒떖 ?꾨옒濡??ｋ뒗??\n      page(\r\n        fourLevels().filter(\r\n          (item) => item.y !== 350 + VERTICAL_GLYPH_WIDTH_PT / 2,\r\n        ),\r\n      ),\r\n    )\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('異뺤쿃???딄린???먮━?먯꽌 怨꾩뿴???섎늿????媛숈? ?댁쓽 ?꽷룹븘????邕며탡??, () => {\r\n    const lower = fourLevels().map((item) => ({ ...item, y: item.y + 800 }))\r\n    const parsed = parseFrameElevations(page([...fourLevels(), ...lower]))\r\n    expect(parsed.elevations).toHaveLength(2)\r\n    expect(parsed.elevations.map((e) => e.levels[0].positionPt)).toEqual([\r\n      100, 900,\r\n    ])\r\n  })\r\n\r\n  it('??怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃┛??, () => {\r\n    const parsed = parseFrameElevations(\r\n      page([...fourLevels(), h('bY2?싥굤邕며탡??/100', 600, 500)]),\r\n    )\r\n    expect(parsed.elevations[0]?.titles).toEqual([\r\n      'bY1?싥굤邕며탡??/100',\r\n      'bY2?싥굤邕며탡??/100',\r\n    ])\r\n  })\r\n\r\n  it('?쒕ぉ???녿뒗 移섏닔 ?댁? 怨꾩뿴濡?蹂댁? ?딅뒗??, () => {\r\n    // ?ㅻЪ yokohama ??18履쎌쓣 ?듦낵?쒗궎硫?**?계나?긺듁??*媛 嫄몃┛????源딆씠 ?レ옄媛\r\n    // ?댁쓣 ?대（怨??놁뿉 ?쇰꺼???쒖꽌 ?ш린源뚯???議곌굔???꾨? 留뚯”?쒕떎\r\n    const parsed = parseFrameElevations(\r\n      page(fourLevels().filter((item) => !item.str.includes('邕며탡'))),\r\n    )\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('?덈꺼 ?쇰꺼? 移섏닔 ??洹쇱쿂??寃껊쭔 蹂몃떎 ???꾨㈃ ?덉쓽 遺??遺?멸? ?욎씠吏 ?딅뒗??, () => {\r\n    const parsed = parseFrameElevations(\r\n      page([...fourLevels(), h('C51', 800, 200)]),\r\n    )\r\n    expect(parsed.elevations[0]?.levels[1].labels).toEqual(['3FL'])\r\n  })\r\n})\r\n\r\nimport type {\r\n  BarSize,\r\n  ColumnShape,\r\n  ShearBarSize,\r\n} from '@/domain/model/member'\r\n\r\nimport type { TextItem } from '@/lib/import/types'\r\n\r\nexport interface TextPage {\r\n  widthPt: number\r\n  heightPt: number\r\n  items: TextItem[]\r\n}\r\n\r\n/**\r\n * ???鍮덉뭏?쇰줈 ?④릿 ?ъ쑀 肄붾뱶. ?뚯꽌???꾩꽦 臾몄옣???꾨땲??肄붾뱶留??ｊ퀬,\r\n * ?쒖떆遺媛 `sectionImport.issue.*` ?ㅻ줈 踰덉뿭?쒕떎 (Unsupported