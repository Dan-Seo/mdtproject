el[],\r\n230-  axisX: number,\r\n231-): Token[] {\r\n232:  const ranked = labelColumns(labels, axisX)\r\n233-    .map((column) => {\r\n234-      const usable = column.filter((token) => {\r\n235:        const text = labelText(token)\r\n236:        return text !== undefined && isLevelLabel(text)\r\n237-      })\r\n238-      const labelledLevels = new Set(\r\n239-        usable\r\n240:          .map((token) => nearestLevelIndex(levels, token.y))\r\n241-          .filter(({ distance }) => distance <= LEVEL_TOLERANCE_PT)\r\n242-          .map(({ index }) => index),\r\n243-      )\r\n244-      const distance = Math.min(\r\n245:        ...column.map((token) => horizontalDistance(token, axisX)),\r\n246-      )\r\n247-      return { column, labelledLevels, usable, distance }\r\n248-    })\r\n249-    .sort(\r\n250-      (left, right) =>\r\n251-        right.labelledLevels.size - left.labelledLevels.size ||\r\n252-        right.usable.length - left.usable.length ||\r\n253-        left.distance - right.distance,\r\n254-    )\r\n255-\r\n256-  const selected = ranked[0]?.column ?? []\r\n257-  const selectedSet = new Set(selected)\r\n258-  const displaced = ranked.flatMap(({ column }) =>\r\n259-    column.filter((token) => {\r\n260-      if (selectedSet.has(token)) return false\r\n261:      const text = labelText(token)\r\n262:      if (text === undefined || !isLevelLabel(text)) return false\r\n263:      const nearest = nearestLevelIndex(levels, token.y)\r\n264-      return nearest.distance <= LEVEL_TOLERANCE_PT\r\n265-    }),\r\n266-  )\r\n267-\r\n268-  return [...selected, ...displaced]\r\n269-}\r\n270-\r\n271-/**\r\n--\n328-        if (used.has(candidate) || candidate.y <= last.y) return false\r\n329-        if (\r\n330-          Math.abs(candidate.x - chainX) > SHORT_TAIL_COLUMN_WINDOW_PT\r\n331-        ) {\r\n332-          return false\r\n333-        }\r\n334-\r\n335-        const gap = candidate.y - last.y\r\n336:        if (gap > LABEL_WINDOW_PT) return false\r\n337-        const expectedGap =\r\n338-          ((last.valueMm + candidate.valueMm) / 2) * scale\r\n339-        if (expectedGap <= 0) return false\r\n340-        return (\r\n341-          Math.abs(gap / expectedGap - 1) <=\r\n342-          SHORT_TAIL_SCALE_TOLERANCE_RATIO\r\n343-        )\r\n344-      })\r\n--\n454-\r\n455-      // 라벨은 가장 가까운 레벨 하나에만 붙는다 — 층이 얕으면 허용 범위가\r\n456-      // 겹치는데, 겹치는 만큼 양쪽에 싣으면 없는 라벨이 생긴다\r\n457-      const levels: ElevationLevel[] = positions.map(({ positionPt }) => ({\r\n458-        labels: [],\r\n459-        positionPt,\r\n460-      }))\r\n461-      const labelsAtLevels: Token[][] = levels.map(() => [])\r\n462:      const labelColumn = selectLabelColumn(labels, levels, chain[0].x)\r\n463-      for (const label of labelColumn) {\r\n464:        const text = labelText(label)\r\n465:        if (text === undefined || !isLevelLabel(text)) continue\r\n466:        const nearest = nearestLevelIndex(levels, label.y)\r\n467-        if (nearest.index < 0 || nearest.distance > LEVEL_TOLERANCE_PT) {\r\n468-          continue\r\n469-        }\r\n470-        labelsAtLevels[nearest.index].push(label)\r\n471-      }\r\n472-\r\n473-      // 짧은 치수가 실제로 적혀 있으면, 그 사이의 두 레벨을 같은 위치로 접지\r\n474-      // 않는다. 치수 표기가 좁은 구간의 한쪽에 몰려 두 라벨이 앞 레벨에 함께\r\n--\n489-        labelsAtLevels[i] = ordered\r\n490-        labelsAtLevels[i + 1] = [moved]\r\n491-      }\r\n492-\r\n493-      for (let i = 0; i < levels.length; i++) {\r\n494-        levels[i].labels = (labelsAtLevels[i] ?? [])\r\n495-          .sort((left, right) => left.y - right.y || left.x - right.x)\r\n496-          .flatMap((label) => {\r\n497:            const text = labelText(label)\r\n498-            return text === undefined ? [] : [text]\r\n499-          })\r\n500-      }\r\n501-\r\n502-      const labelled = levels.filter((level) => level.labels.length > 0).length\r\n503-      if (labelled < MINIMUM_LABELLED_LEVELS) continue\r\n504-\r\n505-      elevations.push({\r\n110-**트레이드오프**: 클라이언트 온리 전제가 처음으로 깨지고, contents:write PAT를 쥔 공개 엔드포인트가 생긴다. 대신 시크릿 검증을 본문 파싱보다 앞에 두고, 페이로드를 필드 화이트리스트로 재구성하며, ESLint 네트워크 가드 예외를 이 디렉터리의 fetch에만 한정해 확장을 막는다. 세부 구성은 docs/ONCALL-ALERT.md.\r\n111-\r\n112-### ADR-018: 断面リスト 값을 PDF에서 브라우저 로컬로 파싱한다 (ADR-004 보완)\r\n113:**결정**: 構造図 PDF의 텍스트 레이어에서 **断面リスト 값만** 파싱해 部材断面一覧의 **후보**로 제시한다. 후보는 부재 행 단위 승인(反映/無視)을 거쳐야만 입력에 반영된다. 형상(通り芯·스팬·階高·부재 배치)은 계속 평면 에디터 수동 입력이다 — ADR-004의 핵심(도면에서 형상을 인식하지 않는다)은 유지되고, 이 ADR은 断面一覧 표 입력의 타이핑을 줄이는 보완이다. 파싱은 pdf.js로 브라우저 안에서만 수행하고 외부 전송은 없다(ADR-006·ADR-017 예외 없음). LLM·OCR을 쓰지 않는 결정적 파싱이다(ADR-015의 추출자=승인자 문제를 만들지 않는다 — 승인자는 항상 사용자다).\r\n114-**이유**: ADR-004의 기각 사유는 「검증용 실도면 세트를 구할 수 없다」는 데이터 문제였다. 공공 발주기관이 공개하는 설계도서에서 텍스트 레이어가 있는 構造図를 수집할 수 있음이 확인되어(발주처 상이 3부: 沖縄県住宅供給公社·横浜市建築局·可児市, `tests/fixtures/section-import/SOURCES.md`) 그 전제가 바뀌었다. 断面リスト는 표 형식 텍스트라 좌표 기반 결정적 파싱이 성립하고, 제품 근거(공공건축 기준)와 데이터 출처(공공 발주 도면)가 일치한다.\r\n115-**구현 규율**: ① 파서는 2단 분리 — PDF→TextItem[](pdf.js, 통합 테스트는 `.cache` 로컬 전용)과 TextItem[]→후보(순수 TS, CI 상시). PDF 원본은 커밋하지 않고 URL·SHA-256만 기록한다. ② 기대값 픽스처는 도면을 눈으로 읽은 독립 전사다(ADR-010 준용). ③ 파싱값은 승인 전에는 어떤 계산에도 기여하지 않는다. 확신 없는 셀(파싱 실패·위치별 상이값·표현 불가 값 K13·600φ 등)은 빈칸으로 남기고 원본 문자열을 참고 표시한다 — 파서가 값을 지어내면 ADR-012(主筋 본수는 입력이고 제품이 바꾸지 않는다)를 입력 단계에서 무너뜨리는 것이다. ④ `pdfjs-dist`는 캐럿 범위가 아니라 **정확 버전으로 고정**한다. 신뢰할 수 없는 사용자 PDF를 파싱하는 유일한 의존이라, 설치 시점에 따라 파서가 조용히 바뀌면 픽스처 대조의 재현성과 취약점 대응 시점을 함께 잃는다 — 갱신은 lockfile이 아니라 눈에 보이는 커밋으로 한다.\r\n116-**트레이드오프**: 실물 3부 기반이라 포맷 과적합 위험이 남는다(발주처·CAD별 변동은 이후 수집으로 계속 넓힌다). 位置(端部/中央)별 상이값은 현행 스키마(단일 top/bottom)로 받을 수 없어 빈칸이 된다 — M3b의 カットオフ 입력이 생기면 그때 흡수한다. 형상 인식이 없으므로 이중 작업(배치는 수동)은 여전하다.\r\n--\r\n250-\r\n251-**ADR-005의 전제가 절반 틀렸다는 것**: ADR-005는 「壁의 開口補強筋은 관행 덩어리라 검증 불가」라고 적었다. 실제로는 開口補強筋이야말로 1通則8)이 「設計図書により計測・計算する」로 못박아 **제품이 지어낼 필요가 없는 입력**이고, 欠除 규칙(1か所 内法面積 0.5㎡ 이하는 欠除 없음)과 壁 본체 배근(縦筋·横筋의 길이·본수·継手)은 전부 조문에 있다. ADR-005는 「검증 불가」가 아니라 **범위 절제**로 다시 세워야 하는 결정이었다. R8(継手箇所数를 「근거 없음」이라 단정했다가 積算基準에 있었음이 드러난 건)과 같은 오류를 한 번 더 한 셈이고, 두 번 다 원인은 **`標準仕様書 5章`만 뒤진 것**이었다.\r\n252-\r\n253:**측정 단위는 内法이다.** 第4編第1章第2節（５）가 壁을 「柱、梁、床板等に接する垂直材の**内法部分**をいい、開口部を除く」로 정의한다. 그래서 縦筋이 재는 것은 階高가 아니라 `階高 − 上部大梁せい`이고, 横筋이 재는 것은 柱心間이 아니라 両側柱面間이다. **柱·大梁와 이중 계상되지 않는 근거가 이 정의 하나**이며, 大梁가 内法長さ인 것과 같은 형태다.\r\n254-\r\n255-**룰팩에 새로 실은 것은 둘뿐이다.**\r\n256-- `cover.minimum`의 `memberKind: 耐震壁` 5행 — 값을 새로 만든 게 아니라 表5.3.6이 「**柱、梁、耐力壁**」을 한 행으로 묶고 있어 기존 柱·大梁와 같은 칸을 가리킨다. 같은 표의 다른 행 「スラブ、耐力壁**以外**の壁」(仕上げあり20·仕上げなし30)은 싣지 않았다 — 雑壁을 다루게 될 때 그 행이 필요하고, **耐震壁 값으로 대용해서는 안 된다**.\r\n--\r\n300-\r\n301-**계기**: 「일본에만 있는 특수한 형태·제품」 요구의 네 항목 중 하나. 실측 도면 3부에서 파서가 못 읽던 마지막 断面 칸이 横浜市 도면의 `600φ`(C56) 하나였다.\r\n302-\r\n303:**왜 지어내는 값이 없는가**: 1通則2)는 「フープ、スタラップの長さは……**断面の設計寸法による周長**を鉄筋の長さとし、フックはないものとする」이다. **형상을 矩形으로 한정하지 않는다.** 円形 断面의 設計寸法은 直径이고 그 周長은 원주다 — 제품이 새 값을 만드는 게 아니라 같은 조문을 그 단면에 적용할 뿐이다. 主筋 길이(階高＋定着＋継手)·割付本数(1通則7))·かぶり(表5.3.6)는 형상과 무관하므로 손대지 않았다. **룰팩 신규 행은 0이다.**\r\n304-\r\n305-**단수는 버리지 않는다**: π×600 ＝ 1884.9556mm를 그대로 싣는다. 1通則6)이 四捨五入을 정하는 것은 フック·定着·余長·重ね継手의 **길이**이지 周長이 아니다 — 반올림할 근거가 없다. 골든 픽스처에 원주의 정의로 손유도한 값을 박고 `toBeCloseTo(…, 3)`로 대조한다.\r\n306-\r\n--\r\n382-**欠除量마다 内訳의 행이 갈린다.** 1通則 前文이 「規格、形状、寸法等ごとに」이므로, 같은 役割이라도 欠ける長さ가 다르면 다른 행이다. 한 벽의 縦筋이 「개구를 지나지 않는 19본」과 「1200을 欠く 8본」으로 갈린다.\r\n383-\r\n384-**継手는 부재마다 다르게 반응한다 — 조문이 그렇게 되어 있다.**\r\n385:- **耐震壁 縦筋** → 2（５）壁1)②의 但書 「開口部腰壁、手すり壁等の継手はないものとする」가 걸린다. 개구를 가로질러 끊긴 縦筋은 階高全体에 걸치지 않고 開口部腰壁·垂れ壁의 縦筋이 되므로, 本文의 「各階に1か所」 대신 但書가 적용돼 **0か所**다. 룰팩 `measure.splice.wall.opening`(value 0)이 그 출처를 갖는다. **어느 본이 그에 해당하는지를 원문이 말하지 않으므로 이 판정은 제품의 읽기다** — 하지만 같은 항의 前半만 구현하고 但書를 버리는 쪽이 더 나쁘다.\r\n386-- **耐震壁 横筋·単独床板** → 1通則4)의 「計測・計算した鉄筋の長さ」는 欠除한 뒤의 길이이므로 箇所数가 줄어든다.\r\n387-- **連続床板** → 2（４）床板2)의 区分表는 「床板の長さ」로 引는다. 개구가 뚫려도 床板의 길이는 변하지 않으므로 **箇所数는 그대로다.** 壁과 달리 但書가 없다는 것이 근거다.\r\n388-\r\n--\r\n396-\r\n397-**트레이드오프**: (1) 「어느 본이 欠けるか」의 판정이 조문에 없는 읽기다 — 위치를 어느 끝에서부터 세는지도 원문이 정하지 않으므로, 개구가 부재 중앙에 없을 때 1본 차이가 날 수 있다(R2). (2) 開口가 있는 부재만 3D의 배치 규칙이 바뀐다 — 같은 断面의 벽 두 장이 開口의 有無로 철근 위치가 미묘하게 달라 보인다. 数量과 그림을 일치시키기 위한 대가다. (3) 欠除量마다 행이 갈리므로 개구가 많은 벽은 内訳의 행이 늘어난다 — 前文의 「寸法等ごとに」가 그것을 요구하지만, 읽는 쪽에서는 같은 役割이 흩어져 보인다. (4) 開口補強筋을 받지 않으므로 개구가 있는 부재는 여전히 정확하지 않다 — 방향이 과대에서 과소로 바뀌었을 뿐이다. 닫으려면 「설계도서에서 읽은 補強筋을 그대로 옮겨 적는」 입력이 필요하고, 그것은 제품이 값을 만드는 것이 아니라 전사하는 일이다.\r\n398-\r\n399:### ADR-030: 伏図·軸組図의 텍스트 레이어에서 형상을 「후보」로 파싱한다 (ADR-004 재검토·ADR-018 확장)\r\n400-\r\n401:**맥락**: 도면 인식 트랙(ADR-018)은 断面リスト의 **값**만 파싱하고 형상(通り芯·스팬·階高·부재 배치)은 수동 입력이다 — ADR-004의 명시적 결정이었다. 그 기각 사유는 두 겹이었는데, 데이터 전제(「검증용 실도면 세트를 구할 수 없다」)는 ADR-018에서 이미 뒤집혔고, 남은 것은 기술 전제 — 伏図의 형상 정보가 断面リスト처럼 좌표 기반 결정적 파싱이 되는가 — 였다. 2026-08-23 스파이크로 실측했다.\r\n402-\r\n403-**스파이크 실측** (`.cache/`의 실물 도면, pdf.js 텍스트 레이어·operator list. 스크립트는 일회용이라 커밋하지 않았고 방법은 아래에 재현 가능하게 적는다 — `getTextContent()`의 item별 `transform` 원시 좌표를 그대로 쓴다):\r\n404-\r\n405-1. **通り芯 그리드가 텍스트만으로 복원된다.** yokohama p5·p6(杭伏図·基礎伏図/1階床伏図): 축 라벨(`bX1`–`bX3`·`cX1`, `bY1`–`bY6`)이 축 양단에 텍스트로 있고, 스팬 치수(`8700`·`1200`·`5000`·`6000`·`10000`)가 **인접 라벨 좌표의 중점**에 놓인다(예: bX1@y500–bX2@y746의 치수 8700@y623). 좌표 간격/치수값 비가 전 스팬에서 0.0283pt/mm로 일관 — 1/100 축척과 정합한다. 축척은 표기(「A3=1/200·A1=1/100」)가 용지 의존이라 믿지 않고 이 비율에서 유도한다.\r\n406-2. **부재 부호가 그리드에 스냅된다.** `FG51`@(235,1727): x가 bY6 축(216) 위, y가 bX1–bX2 중점(1727.5) — 大梁은 「한 축 위 ＋ 스팬 중점」. `S55`@(285,1730): 두 좌표 모두 중점 — 床板은 칸 중앙. `F`계 부호는 교점 부근이되 지시선 오프셋이 있다(스냅 허용오차 필요).\r\n407-3. **발주처가 달라도 구조가 같다.** kani-kids p38(基礎伏図): 라벨 `X1`–`X4`·`Y1`–`Y3`, 치수는 「6,000」 콤마 형식, **전체 치수 20,000 ＝ 6,000＋6,000＋8,000이라 합계가 검증식(checksum)이 된다.**\r\n408:4. **階高도 같은 방법이 선다.** yokohama p8(軸組図): 「bY1通り軸組図」 블록이 通り별로 반복되고, FL 라벨(`基準GL`·`中央棟1FL`·`2FL`)과 세로 치수(4480·4100)가 텍스트다.\r\n409-5. **벡터 선분은 쓰지 않는다.** 一点鎖線 축선은 CAD 출력에서 짧은 실선 조각으로 분해되고(>150pt 장선 156개 중 dashed 0), 경로 좌표는 CTM 공간이라 텍스트 좌표와 맞추려면 변환 추적이 따로 필요하다. 텍스트만으로 복원이 완결되므로 범위에서 뺀다 — 断面リスト 파서와 같은 교훈이다.\r\n410-6. **한계**: ojkk 확보분에는 伏図가 없어(리스트·断面図만) 실측은 발주처 2부다. 한 페이지에 伏図 블록이 여럿이고(p6: 基礎伏図·1階床伏図) 라벨·치수 세트가 블록마다 반복되므로 블록 분리가 선행한다 — 표제란 図面名称(「基礎伏図・1階床伏図」)이 타이틀로 오인되는 함정(issue #33)도 그대로 적용된다.\r\n411-\r\n412:**결정**: 伏図·軸組図의 텍스트 레이어에서 형상 — 通り芯 그리드(라벨·스팬 치수), 부재 부호 배치, 階高 — 을 **후보**로 파싱한다. ADR-018과 같은 원칙이다: 후보는 사람 승인(反映/無視)을 거쳐야만 입력이 되고, 승인 전에 제품이 형상을 만들지 않는다. 못 읽으면 값을 지어내지 않고 빈 후보로 정직하게 실패한다. LLM·OCR 없는 결정적 파싱, 전부 브라우저 로컬(ADR-006·017 예외 없음). ADR-004의 핵심 문장은 「도면에서 형상을 인식하지 않는다」에서 **「도면에서 읽은 형상을 확인 없이 쓰지 않는다」로 좁혀진다** — 간이 평면 에디터는 계속 존재하고, 파서는 그 에디터를 채우는 보조다(래스터 도면·미지 형식 사용자의 유일한 경로이기도 하다).\r\n413-\r\n414:단계와 검증: **B1** 그리드(라벨＋치수 중점 대응＋합계 checksum) → **B2** 부재 배치(부호 스냅) → **B3** 階高(軸組図). 각 단계는 실물 전사 대조 픽스처(TDD)와 e2e로 고정한다. B1이 `Grid`에 通り芯 라벨을 넣으므로 **R13(端部 좌우 비대칭 8칸)의 선결 조건이 이 트랙에서 풀린다** — 도면의 「Y3端／Y4端」을 제품 그리드의 실제 방향과 맞출 수 있게 된다.\r\n415-\r\n416:**구현 결과 (2026-08-23)**: B1·B2·B3과 취입까지 닫았다. 스냅 허용은 인접 스팬이 아니라 **중앙값 스팬의 1/4**이다 — 인접 기준이면 yokohama의 1200mm 띠(34pt)에서 허용이 8pt로 좁아져 引出線으로 20pt쯤 비켜 적힌 柱 부호가 통째로 떨어지고, 1/4을 넘기면 격자점과 중점 중 어느 쪽인지 제품이 고르게 된다. 붙어버린 라벨(`bX3`＋`cX1`)은 등분·보간이 아니라 **문자 좌표에서** 되가른다. 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 치수 열이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. **취입에는 가드가 하나 있다**: 격자 index가 스팬 배열에 매여 있어 스팬을 바꾸면 손대지 않은 층의 부재가 조용히 다른 자리로 옮겨간다 — 다른 층에 부재가 있으면 통째로 거부하고, 거부를 한 번 보여준 뒤에만 「다른 층을 버린다」는 동의 칸을 낸다. 동의하면 남기지 않고 전부 버린다(반쯤 옮겨 놓느니 비운다).\r\n417-\r\n418:**뒤에 붙은 것 (2026-08-23)**: ⑥ **階高 → Story 취입** — 「어느 레벨이 階의 경계인가」를 파서가 정하지 않으므로 최상階의 천단과 최하階의 바닥을 사람이 고른다. 階의 이름은 그 階의 **바닥이 되는 레벨의 원문**이고, 같은 높이의 라벨 둘은 둘 다 남긴다(실물의 「中央棟1FL」과 「基準GL」은 190mm 차라 도면상 같은 자리다). ⑦ **`Grid`의 通り芯 라벨** — `xLabels`·`yLabels`는 optional이고 미지정은 「도면에서 읽은 이름이 없다」다. schemaVersion은 올리지 않는다: 版을 올리는 기준은 「같은 案件의 数量이 달라지는가」인데(v11 주석) 이름은 数量을 바꾸지 않는다. 이것이 R13의 선결 조건이다 — 도면의 「Y3端／Y4端」을 런의 실제 방향과 맞추려면 제품이 通り芯의 이름을 알아야 한다. ⑧ **軸組図 계열의 반증 가능성** — 발주처를 하나 더 넣자(kani p40) 파서가 두 번 연속으로 없는 층을 지어냈다. 치수 둘짜리 연쇄는 축척을 하나 유도하는데 유도한 값이 자기 자신과 어긋날 수 없어 일관성 검사가 공회전하고, 남는 증거인 라벨 일치가 글자 빽빽한 도면에서 **우연히** 맞는다. 셋을 요구해 축척이 서로를 반증하게 하고, 레벨 라벨의 가로 창도 150pt에서 80pt로 좁혔다(실측 최대 67pt, 오검출은 128pt).\r\n419-\r\n420-**트레이드오프**: 지시선 오프셋 때문에 스냅에 허용오차가 들어간다 — 허용오차를 넘는 애매한 부호는 후보에서 빼고 「未配置」로 남긴다(값을 지어내지 않는다). 실물에서 未配置의 대부분은 小梁으로 잘게 나뉜 칸 안의 スラブ·小梁 부호인데, 제품이 小梁을 모델링하지 않으므로(ADR-005) 붙일 자리 자체가 없다. 래스터(스캔) 도면은 원리상 못 읽고 빈 후보다. 실측이 발주처 2부라 R10(형식 과적합)이 형상에도 생긴다. 「어느 레벨이 階의 경계인가」도 정하지 않는다 — 원문에 FL·GL·基礎下端·RCL이 섞여 있고 그중 무엇이 階인지는 조문이 아니라 설계 의도다.\r\n421-**트랙 정리 (2026-08-25)**: 伏図 트랙은 `src/lib/import/framing-plan/` 하나로 정리했고, 경쟁 구현이었던 ADR-031은 폐지했다. 그 대가로 framing-plan은 合計를 선택적 검산으로 사용한다(`totalConfirmed`). 단, 合計가 있으면 스팬 합과 대조하고 어긋날 때 `合計不一致`로 후보를 거절한다. 따라서 合計가 없는 도면도 위치 정합과 축척 일관성이 성립하면 그리드 후보를 낸다 — ADR-031이 合計 없는 도면을 막던 자리가 열려 있다는 사실을 남긴다. ADR-031 ③-2의 관측, 즉 스팬 1본 축에서는 「스팬의 합 ＝ 合計」가 원리상 아무것도 배제하지 못한다는 점은 framing-plan에도 그대로 성립한다. 다만 옛 `grid-parse`는 合計 검산이 유일한 장치라 1본 축을 통째로 `区間数不足`으로 거절할 수밖에 없었고, framing-plan에는 중점 매칭(±15pt)과 축척 일관성이 있어 1본에서도 확인하는 것이 남는다. 축척 일관성은 스팬이 하나면 대조 상대가 없으므로, 1본 축에서 실제로 남는 검증은 중점 매칭 하나다. `断面リスト` 페이지가 격자를 내지 않는 이유도 스팬 수가 아니라 세그먼트 전체를 설명하지 못하는 sticky 라벨 패턴(`X2端` 등) 때문이다. 근거 없이 문턱을 조이는 변경은 이 결정의 범위가 아니다.\r\n422-\r\n423:**구현 결과 (2026-09-03, phase 36·37)**: 형상 골든은 격자 7/7면, 階高 3/3면을 통과시켰다. 通り芯 라벨은 접두 없는 숫자·문자 표기까지 일반화했고, 合計 없음·部分合·나란한 치수 열은 `寸法列曖昧` 규약으로 보존했다. 階高는 명시 치수 소구간 150·100을 다뤘다. 원문 대조에서 fuji의 rot −90 회전 글리프는 같은 x 열로 이어야 했고, 이를 놓친 반증 방법은 phase 37에서 재대조로 바로잡았다.\r\n424-\r\n425-### ADR-031: 伏図에서 通り芯과 스팬 치수만 읽는다 — ADR-018이 그은 「형상은 수동」의 경계를 옮긴다\r\n426-\r\n427:> **폐지(2026-08-25 사용자 결정, ADR-030으로 대체)**: 이 항은 폐지되었다(superseded by ADR-030). 병렬 세션 둘이 같은 번호로 각자 ADR-030을 썼고, 머지 때 이 항을 ADR-031로 개번했다. 구현(`src/lib/import/plan/`)은 삭제했지만, ① 「合計와 맞는 조합만 채택한다」는 자기 검산의 아이디어, ② 「스팬 1본 축은 검산이 원리상 아무것도 배제하지 못한다」는 ③-2 정정의 관측, ③ 좌표 규약을 한 곳에 두는 원칙(④)은 framing-plan의 `runs.ts`에 실제로 반영되어 남아 있다. 이 항은 그 근거 문서로 보존한다.\r\n428-\r\n429-**맥락**: ADR-004는 도면 자동인식을 거부했고, 그 근거는 원칙이 아니라 **데이터 가용성**이었다(\"표본이 없으니 무엇을 인식할 수 있는지조차 모른다\"). ADR-018이 실도면 3부를 확보하며 그 전제가 이미 뒤집혔음을 기록하고 **断面リスト 값에 한해** 열었지만, 같은 항이 「형상(通り芯·스팬·부재 배치)은 계속 수동 입력」이라고 못박았다. 이 항은 그 경계를 옮긴다 — **옮기는 만큼만**, 그리고 왜 옮길 수 있는지의 실측을 함께 남긴다.\r\n430-\r\n--\r\n441-\r\n442-**결정**\r\n443-\r\n444:**① 伏図에서 읽는 것은 通り芯 라벨과 스팬 치수 둘뿐이다.** 부재 배치(어느 격자칸에 무엇이 서는가)·断面 형상·階高는 계속 平面 페인의 수동 입력이다. 그리고 **텍스트 레이어만 읽는다** — 도형(선분·해치)은 읽지 않는다. 「이 칸에 C1이 선다」는 도면의 **그림**에 있지 텍스트에 없고, 그것을 추정하는 순간 도면에 없는 것을 제품이 만들게 된다(ADR-004의 본래 논지는 여기에 그대로 남는다).\r\n445-\r\n446-**② 취입은 「후보 제시 → 사용자 승인」이다** (ADR-018과 같은 규율). 파서는 `Grid`를 갈아엎지 않고 `GridCandidate`를 낸다. 자동 반영은 없다.\r\n447-\r\n--\r\n513-\r\n514-**보충 (2026-08-26, phase 22 교차검증)**: §1의 「양의 유한수」 검증과 平面 입력의 행 추가 기본값이 충돌했다 — 제품이 값을 발명하지 않으려면 추가 직후의 設計長さ는 0일 수밖에 없는데, 검증기가 0을 거부하면 자동저장된 案件이 재로드에서 통째로 버려진다(기동 경로는 복원 불가 기록을 조용히 버리고 샘플로 착지한다 — M4). 그래서 **設計長さ 0은 未転記 상태로 저장을 허용하고, 산정은 0 행을 `Rebar`로 내지 않는다** — 質量 0의 행을 内訳에 세우면 전사된 것처럼 보이므로, 未転記은 계상하지 않고 과소는 상시 고지가 안내한다(§5). 平面 입력은 0 행에 未転記 표식을 단다. 재현 기록은 phase 22 step 3.\r\n515-\r\n516:### ADR-035: 階 라벨↔`Story` 대응 — 정확 일치 자동, 그 외는 사용자 선택 (ADR-033 절차의 재적용)\r\n517-\r\n518-**맥락**: 断面リスト는 階 행(`2階`·`RF` 등)을 읽어 `Section.storyLabel`에 원문으로 싣지만, 그 라벨은 표시·취입 매칭용일 뿐 제품 `Story`와는 연결되지 않는다(`src/domain/model/member.ts`의 주석이 명시). `Member.storyId`가 정해지는 유일한 자동 경로는 伏図 취입인데, 대상 Story는 화면 드롭다운의 **조용한 기본값 `stories[0]`**으로 들어가고, 断面の階 필터(`sectionStoryLabel`)와 대상 Story 사이에는 아무 대응도 없다. 또한 壁リスト·スラブリスト 파서는 階 행을 읽지 않아 壁·床板 `Section.storyLabel`이 항상 없고, 断面の階를 고르면 이들 符号이 전부 `断面未登録`으로 탈락하는 함정이 있다. 절차 선례는 ADR-033 — 정확 일치만 자동, 그 외는 사용자 선택, 기본은 미선택, 자동 결정은 근거를 화면에 밝힌다.\r\n519-\r\n--\r\n540-\r\n541-### ADR-037: 雑壁의 부분 높이·부분 길이는 部材 단위 内法 범위 전사 입력이다 — 자유단에는 定着이 없다\r\n542-\r\n543:**맥락**: ADR-036 §5가 남긴 것이다. `数量積算基準` 第4編第1章第2節（５）의 정의는 「袖壁、下り壁、腰壁等もこれらに準ずる」로 이들을 「柱、梁、床板等に接する垂直材の内法部分」에 준하게 하지만, **그 内法의 경계 치수는 조문에 없다** — 腰壁이 어디서 끝나는지는 設計図書에만 있다. 현행 제품의 벽은 언제나 全内法(柱면~柱면 × 階高−上部大梁せい)이고, 부분 벽은 全高 벽＋開口 우회(ADR-029)로만 근사된다. 그 우회에는 두 결함이 있다. ① `buildWallBars`는 범위와 무관하게 **항상 양단에 定着을 더한다** — 袖壁의 자유단(벽이 끝나고 아무것도 접속하지 않는 가장자리)에도 定着이 붙어 근거 없이 kg가 올라간다. 2（５）壁1)①은 「接続する他の部分に定着するものとし」라 접속하지 않는 가장자리에는 定着이 없다. ② 경계에 접한 「開口」는 建具類等의 開口部가 아니라 그냥 벽이 없는 부분인데, 그것을 開口로 적으면 1通則8)의 0.5㎡ 하한·②의 継手 但書·開口補強筋 고지가 함께 따라온다. 즉 開口 우회는 **다른 조문을 잘못 발화시킨다**.\r\n544-\r\n545-**결정**:\r\n546-1. **범위는 部材 단위 전사 입력이다** — `Member.wallExtent?: { vertical?: { anchor: '下端' | '上端'; heightMm: number }, horizontal?: { anchor: '始端' | '終端'; lengthMm: number } }`. 단면이 아니라 부재에 붙는 이유는 ADR-029의 `openings`와 같다 — 같은 符号의 벽이 여러 장 서는데 형상은 장마다 다르다. 축마다 optional이고 미지정은 「그 축은 全内法」이다. **schemaVersion을 올리지 않는다** — optional 추가이고 기본값이 현행과 같아 같은 案件의 数量이 변하지 않는다(ADR-034·036과 같은 판단 기준).\r\n--\r\n557-**맥락**: 지금 부재를 만드는 길은 셋뿐이다 — 샘플 案件, 伏図 취입(`apply.ts`), 그리고 없다. 平面 페인은 표시와 開口·범위 입력만 한다(ADR-029·037). 그래서 도면이 없는 사용자는 벽 하나를 더할 수도, 잘못 들어온 床板 하나를 지울 수도 없다. 한편 벽·床板의 内法은 다른 부재가 정한다 — 벽의 内法高さ는 그 辺의 大梁가(`girderDepthAboveWall`), 内法長さ는 양 끝 柱가(`supportColumnSection`), 床板의 内法은 네 변의 大梁가 정한다. 이 중 `girderDepthAboveWall`은 **`MemberUnsupportedError`가 아니라 plain `Error`**를 던지고 `useTakeoff`는 前者만 잡으므로(`src/lib/hooks/useTakeoff.ts:120`), 大梁 없는 辺의 벽은 부재 하나가 떨어지는 것이 아니라 **화면이 통째로 죽는다**.\r\n558-\r\n559-**결정**:\r\n560:1. **놓고 지우는 것은 벽·床板 둘뿐이다** — 柱·大梁는 平面에서 만들지도 지우지도 않는다. 그 둘은 격자와 다른 부재의 内法을 정하는 쪽이라, 놓거나 지우면 손대지 않은 부재의 数量이 조용히 바뀐다(ADR-030이 伏図 취입에서 같은 함정을 거부로 막은 것과 같은 이유). 柱·大梁 편집은 별건이다.\r\n561-2. **잴 수 없는 자리는 후보로 내지 않는다** — 벽은 그 辺에 大梁가 있고 양 끝에 柱가 있는 자리에만, 床板은 네 변의 大梁가 있는 ベイ에만 놓을 수 있다. 판정은 도메인의 순수 함수가 하고 UI는 그 결과만 그린다 — 「놓을 수 있는가」는 규준이 아니라 제품의 기하 지식이므로 룰팩이 아니라 코드다.\r\n562-3. **그래도 도메인이 부재 단위로 떨어뜨려야 한다** — 취입·손편집·과거 案件 어디서든 잴 수 없는 벽이 들어올 수 있으므로, `girderDepthAboveWall`의 plain `Error`를 `MemberUnsupportedError('寸法不成立')`로 바꿔 `useTakeoff`가 그 부재만 「未対応」으로 떨어뜨리게 한다. UI의 후보 제한(2)은 편의이고, 이것이 방어다.\r\n563-4. **부재 id는 伏図 취입과 같은 규약을 쓴다** — `${storyId}-${mark}-${ix}-${iy}[-${axis}]`. 같은 id가 이미 있으면 놓지 않는다(같은 자리에 같은 符号을 두 번 놓는 것이 그 경우다). 서로 다른 符号이 같은 辺에 서는 것은 막지 않는다 — 겹침 검사는 만들지 않는다(ADR-037 §7).\r\n--\r\n860-   「만들지 않는다 — 별개 마일스톤(ADR-042)」로 통일한다. ADR-025 본문은 고치지\r\n861-   말고 날짜를 붙인 참조를 덧붙인다.\r\n862-\r\n863:### ADR-043: ST-Bridge(.stb)의 通り芯·階만을 브라우저 로컬로 「후보」로 읽는다 (ADR-004 재검토·ADR-018·ADR-030 확장)\r\n864-\r\n865:**맥락**: ADR-004의 결정문은 두 가지를 한 줄에 묶었다 — 「DWG/DXF 도면 인식」과 「IFC 업로드」. 앞의 절반은 ADR-018·ADR-030이 실측을 붙여 좁혔지만, **뒤의 절반에는 논거가 붙은 적이 없다**. ADR-004의 이유절과 트레이드오프절(`docs/ADR.md:38-39`)에 `IFC`는 0회 등장하고, 두 절의 논증은 전부 도면 인식에 관한 것이다. 레포에서 IFC가 나오는 나머지 한 곳인 `docs/PRD.md:43`의 사유(「Revit/Navisworks 호환성을 검증할 방법이 없음」)도 취입이 아니라 **내보내기**에 대한 것이다. 그러므로 이 항은 기존 결정을 뒤집는 항이 아니라, **논증이 없던 절반에 처음 답하는 항**이다.\r\n866-\r\n867-그리고 ST-Bridge는 IFC가 아니다. buildingSMART Japan 構造設計小委員会의 일본 구조 전용 XML이며, 도면이 아니라 一貫構造計算 소프트의 출력이다. 인식할 픽셀도 좌표 추정도 없다 — 通り芯이 `StbParallelAxis@distance`로, 階가 `StbStory@height`로 명시돼 있다.\r\n868-\r\n--\r\n881-\r\n882-1. **.stb에서 通り芯 그리드와 階 레벨 스택만을 「후보」로 읽는다.** 전부 브라우저 로컬이며 서버 왕복이 없다(ADR-006·ADR-017 예외 없음). 파일 → 중간표현(`DOMParser`) → 후보(순수 TS)의 2단 분리는 ADR-018의 그것과 같다.\r\n883-2. **후보는 사람 승인을 거쳐야만 입력이 된다.** .stb가 사람이 만든 확정 데이터이므로 자동 반영해도 된다는 반론이 있으나 채택하지 않는다 — 그러면 ADR-015의 승인자가 「Kijun 사용자」에서 「.stb를 만든 제3자 構造設計者」로 바뀌고, 사용자는 자기가 승인하지 않은 값으로 物量을 내게 된다. 승인 단위는 블록이다.\r\n884:3. **ADR-004의 핵심 문장을 다시 좁힌다.** ADR-030이 「도면에서 형상을 인식하지 않는다」를 「도면에서 읽은 형상을 확인 없이 쓰지 않는다」로 좁힌 것과 같은 방향으로, 「외부 형식을 취입하지 않는다」는 **「외부 형식에서 읽은 값을 확인 없이 쓰지 않는다」로 좁혀진다.** ADR-004 본문은 고치지 않는다.\r\n885-4. **定着·重ね継手·折曲げ·かぶり厚さは 계속 `src/rulepack/`의 YAML이 정한다.** ST-Bridge가 `depth_cover_*`를 숫자로 담는다는 사실(실측 3)에도 불구하고 **읽지 않기로 결정한다** — 버전을 내려서 충돌을 피한 것이 아니다. `StbApply_*`·`StbSec*` 계열 전부가 이 항의 범위 밖이다.\r\n886:5. **담을 수 없는 것은 근사하지 않고 사유 코드와 함께 거부한다.** 비직교·원호·방사 通り芯과 `BASEMENT`·`ISOLATION`·`DEPENDENCE` 階가 대상이다. 특히 **미대응 階를 부분 제거하지 않고 층 스택을 통짜로 거부한다** — 중간 레벨을 빼고 인접 차분을 하면 그 아래층이 빠진 구간을 흡수해 階高가 조용히 부풀고, 사유 코드는 「그 층을 못 읽었다」로만 읽혀 사용자가 오염을 알 수 없다(`FileA`에서 `RFL`이 `PENTHOUSE`이며, 그것만 빼면 3FL이 4000이 아니라 7800이 된다).\r\n887:6. **ADR-035 §6과의 관계**: §6은 「階 라벨을 근거로 한 Story 신규 생성·개명·정렬은 하지 않는다」인데, .stb의 `StbStory@height`는 **라벨 근거의 추정이 아니라 명시적 레벨 데이터**이므로 §6의 사정 밖이다. 다만 이 항이 여는 것은 후보 생성까지이고, `Project.stories`를 만드는 것은 이 항의 범위가 아니다.\r\n888:7. **마일스톤 위치**: ST-Bridge 취입은 断面リスト(ADR-018)·伏図(ADR-030) 트랙과 코드 영역이 겹치지 않는(공용층 `textitems`·`runs`·`pdf-text`를 하나도 쓰지 않는) 또 하나의 입력 파이프라인 트랙이며, M2·M3c의 잔여와 병행한다.\r\n889-8. **하지 않는 것**: 断面(`StbSec*`)·배근·부재 배치·開口·かぶり·定着을 읽지 않는다 / 芯(중심선) 모델을 볼륨으로 해석하지 않는다(`StbMemberOffsetList` 미대응) / `kind_structure=\"LOAD\"`(壁式構造の壁)는 ADR-025·ADR-042대로 후보를 내지 않고 미대응으로 표시한다 / 버전 어댑터·요소 매핑 테이블·룰 DSL을 만들지 않는다(ADR-002) / .stb 원본과 XSD를 커밋하지 않고 런타임에 받지도 않는다 / 基礎·小梁·雑壁·杭 코드를 만들지 않는다(ADR-005) / .stb 쓰기(export)를 하지 않는다 / 재취입·차분 갱신을 하지 않는다(`Member.id`가 (階,符号,격자자리)뿐이라 매칭 키가 없다) / XML 파서·인코딩 변환 라이브러리를 추가하지 않는다.\r\n890-\r\n891-**판정 장치**: 이 취입의 출력이 맞았는지는 **제3자 MIT 실물 .stb 4건의 通り芯·階를 파서와 무관한 수단(python 정규식)으로 재계산한 값과 CI가 상시 대조하는 것**이 판정한다. 기대값은 파서 출력이 아니라 `phases/33-stbridge-skeleton-import/step0-report.json`의 실측에서 유도한다.\r\n--\r\n894-\r\n895-**전제 검증 결과 (2026-08-28, phase 33 step 0·4)**: 전제 7건이 전부 `upheld`였다 — ADR-004 이유·트레이드오프절의 IFC 0회, RC 범위의 길이형 정착 속성 0개, 골격 요소의 네 버전 동일, `Grid`·`Story`가 회전각·`kind`·절대 표고를 담지 못함, node/jsdom의 `DOMParser` 분리, `TextDecoder('shift_jis')` 가용. **정정 1건**: 위 실측 4의 코드검색 수치는 초안에서 「둘 다 0건」이라고 적었으나 실측은 9건/0건이었다(결론은 유지 — 9건이 전부 토이 파일과 생성기다). step 4가 오라클의 공허함을 반증 시도해 뮤테이션 6곳이 서로 다른 테스트를 깨뜨렸고, 후보가 `Project`에 닿는 경로가 0건임을 확인했다. 코퍼스의 한계는 `tests/fixtures/stb-import/SOURCES.md`의 「이 코퍼스가 대표하지 못하는 것」에 실측으로 남겼다.\r\n896-\r\n897:### ADR-044: ST-Bridge 골격 후보의 반영은 伏図·軸組図와 같은 승인 규약을 따른다 (ADR-043 결정 6의 유보를 푼다)\r\n898-\r\n899:**맥락**: ADR-043은 후보 생성까지만 열고 「이 항이 여는 것은 후보 생성까지이고, `Project.stories`를 만드는 것은 이 항의 범위가 아니다」(결정 6 후단)로 반영을 유보했다. phase 33이 후보를 냈으므로 그 유보를 여기서 푼다. 지금 상태는 코드가 값을 내는데 화면에서 닿을 수 없는 것이며, 그것은 완성이 아니라 미완이다. 이 항은 ADR-043 결정 2(「후보는 사람 승인을 거쳐야만 입력이 된다」)를 뒤집지 않고 **그 승인이 무엇을 하는지**를 정한다.\r\n900-\r\n901-**실측** (2026-08-28, 코드 대조)\r\n902-\r\n903:1. **선례가 이미 있다.** `applyElevation`(`src/lib/import/framing-plan/apply.ts:243`)이 軸組図 후보로 `project.stories`를 통짜 교체하고 `members`를 비운다. 부재가 있으면 `discardMembers` 없이는 `部材あり階置換不可`로 거부한다. ADR-035 §6이 막은 것은 「階 라벨을 근거로 한 추정」이고 `StbStory@height`는 명시 레벨이므로 §6의 사정 밖이다 (ADR-043 결정 6 전단).\r\n904:2. **값의 단위가 맞는다.** `StbSkeletonCandidate.stories[].heightMm`는 인접 레벨의 차분(`src/lib/import/stb/candidates.ts:250`)이라 `Story.height`(階高)와 같은 뜻이고, 오름차순이라 `Project.stories`의 아래→위 순서와도 같다. 최상단 레벨은 지붕으로 소비돼 레벨 n개가 階 n−1개가 된다 — `applyElevation`과 같은 셈법이다.\r\n905-3. **그리드도 맞는다.** `StbGridCandidate.axes.length === spansMm.length + 1`이고 `Grid.xLabels`의 길이 규약(`isGridLabels`)도 `spans.length + 1`이다. `direction`은 距離가 재어지는 축이므로 `X`→`xSpans`, `Y`→`ySpans`다.\r\n906:4. **그런데 `applyFramingPlan`을 재사용할 수 없다.** 그것은 부재 배치까지 든 `PlanBlock`을 받아 部材를 놓는데, .stb 후보에는 배치가 없다(ADR-043 「하지 않는 것」). 같은 규약을 따르는 것과 같은 함수를 부르는 것은 다르다.\r\n907-\r\n908-**결정**\r\n909-\r\n910-1. **`src/lib/import/stb/apply.ts`를 새로 만든다.** 순수 TS이고 `Project`를 받아 새 `Project`를 돌려준다. `applyFramingPlan`·`applyElevation`을 부르지 않고 그 코드를 옮기지도 않는다 — 입력 타입이 다르다.\r\n911:2. **승인 단위는 「通り芯 그리드」와 「階 스택」 둘이고 서로 독립이다.** ADR-043 결정 2의 「블록」은 .stb에 블록이 하나뿐이므로 이 둘로 내려온다. 한쪽만 승인할 수 있다.\r\n912-3. **부재가 있으면 거부한다.** 그리드 교체와 階 교체 둘 다, 부재가 하나라도 있으면 사용자가 명시적으로 「버리고 진행」을 고르기 전에는 거부한다 — `applyElevation`의 `部材あり階置換不可`와 같은 규약이고, 조용한 기본값을 두지 않는다. 화면은 거부를 한 번 보여준 뒤에만 그 선택지를 낸다 (`PlanImport`와 같다).\r\n913-4. **`issues`가 비어 있지 않아도 승인은 막지 않는다. 다만 화면이 그것을 지우지 않는다.** 사유 코드와 `unsupported` 목록은 승인 뒤에도 화면에 남는다 — 「.stb에서 못 읽은 것이 있다」는 사실이 승인으로 사라지면 ADR-015의 승인이 형해화한다. 반대로 후보가 비어 있으면(`grids`·`stories`가 `[]`) 승인 자체를 낼 수 없다.\r\n914:5. **하지 않는 것**: 案件名을 `projectName`으로 덮어쓰지 않는다(사용자가 지은 이름이다) / 후보를 자동 승인하지 않는다 / 부분 승인(축 하나·階 하나)을 만들지 않는다 — 스팬 배열의 일부만 받으면 나머지 스팬이 근거 없이 남는다 / 재취입·차분 갱신을 하지 않는다(ADR-043) / 반영을 계기로 断面·부재·開口를 읽지 않는다 / `Grid`에 회전각·원점 필드를 더하지 않는다(ADR-043 실측 8의 결손은 거부로 다루고 근사하지 않는다).\r\n915-\r\n916-**판정 장치**: 실물 코퍼스 4건의 기대 후보(`tests/fixtures/stb-import/expected/`)를 그대로 반영해 나온 `Project`의 `grid`·`stories`를 픽스처로 고정하고, 반영 함수를 흔들면 그 픽스처가 깨진다. 즉 판정의 뿌리는 여전히 파서가 아니라 step0의 파서 무관 실측이다.\r\n917-\r\n918:**트레이드오프**: 그리드를 갈면 부재를 버려야 하므로 「.stb로 골격을 넣고 그 위에 손으로 부재를 놓는」 순서만 성립한다. 반대 순서(부재를 놓은 뒤 .stb로 골격을 보정)는 이 항이 열지 않는다 — 매칭 키가 없다(ADR-043 「하지 않는 것」). 그리고 이 항이 열어도 .stb 案件은 여전히 開口 정보가 없어 欠除이 반영되지 않는다(ADR-029의 상시 고지가 그대로 적용된다).\r\n919-\r\n920-### ADR-045: 2段筋과 빈 셀은 값을 지어내지 않고 원문 상태를 보존한다\r\n921-\r\n","exit_code":0,"status":"completed"}}
