den-2\\step2-codex.stdout.log\r\nphases\\36-corpus-widen-2\\step2-codex.stderr.log\r\nphases\\36-corpus-widen-2\\step1.md\r\nphases\\36-corpus-widen-2\\step1-report.json\r\nphases\\36-corpus-widen-2\\step1-invoke.json\r\nphases\\10-plan-import-fixes\\step1.md\r\nphases\\10-plan-import-fixes\\step0.md\r\nphases\\10-plan-import-fixes\\index.json\r\nphases\\11-plan-import-hardening\\step3.md\r\nphases\\11-plan-import-hardening\\step2.md\r\nphases\\11-plan-import-hardening\\step1.md\r\nphases\\11-plan-import-hardening\\step0.md\r\nphases\\11-plan-import-hardening\\index.json\r\nphases\\18-plan-corpus-widen\\step1.md\r\nphases\\18-plan-corpus-widen\\step1-report.json\r\nphases\\18-plan-corpus-widen\\step1-invoke.json\r\nphases\\18-plan-corpus-widen\\step1-codex.stdout.log\r\nphases\\18-plan-corpus-widen\\step1-codex.stderr.log\r\nphases\\18-plan-corpus-widen\\step0.md\r\nphases\\18-plan-corpus-widen\\step0-report.json\r\nphases\\18-plan-corpus-widen\\step0-invoke.json\r\nphases\\18-plan-corpus-widen\\step0-codex.stdout.log\r\nphases\\18-plan-corpus-widen\\step0-codex.stderr.log\r\nphases\\18-plan-corpus-widen\\index.json\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\r\nimport { compact } from '@/lib/import/runs'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\ntype ElevationFixture = {\r\n  heightsMm?: number[]\r\n  levels?: string[]\r\n  levelTexts?: string[]\r\n  elevations: Array<{\r\n    title?: string\r\n    levels?: string[]\r\n    levelsBottom?: string[]\r\n    heightsMm?: number[]\r\n    heightsBottomMm?: number[]\r\n  }>\r\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readGolden(file: string): ElevationFixture {\r\n  return JSON.parse(\r\n    readFileSync(\r\n      resolve(process.cwd(), 'tests/fixtures/plan-import/expected', file),\r\n      'utf8',\r\n    ),\r\n  ) as ElevationFixture\r\n}\r\n\r\nfunction elevationForTitle(\r\n  parsed: ReturnType<typeof parseFrameElevations>,\r\n  title: string,\r\n): ReturnType<typeof parseFrameElevations>['elevations'][number] {\r\n  const normalized = compact(title)\r\n  const expectedTitle = normalized.includes('軸組図')\r\n    ? normalized\r\n    : `${normalized}軸組図`\r\n  const matches = parsed.elevations.filter((elevation) =>\r\n    elevation.titles.some(\r\n      (candidateTitle) =>\r\n        candidateTitle === expectedTitle ||\r\n        candidateTitle.startsWith(`${expectedTitle}S=`),\r\n    ),\r\n  )\r\n  expect(matches).toHaveLength(1)\r\n  return matches[0]!\r\n}\r\n\r\nfunction labelsByLevel(\r\n  elevation: ReturnType<typeof parseFrameElevations>['elevations'][number],\r\n): string[][] {\r\n  return elevation.levels.map((level) => level.labels)\r\n}\r\n\r\ndescribe('階高 corpus 2 골든', () => {\r\n  it('karatsu: 제목으로 대응한 X2·X3 두 블록의 높이와 레벨 라벨을 골든과 대조한다', () => {\r\n    const golden = readGolden('karatsu-jikugumi1-p1-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('karatsu-jikugumi1-p1.json'))\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(2)\r\n    const expectedElevations = golden.elevations.filter((entry) =>\r\n      entry.title === 'X2通り' || entry.title === 'X3通り',\r\n    )\r\n\r\n    // X4通り는 텍스트에 레벨 라벨 열이 없어 골든 대조에서 제외한다.\r\n    // X2·X3은 제목의 정확한 軸組図 세그먼트로 계열을 대응한다.\r\n    expect(expectedElevations).toHaveLength(2)\r\n    for (const expected of expectedElevations) {\r\n      const actual = elevationForTitle(parsed, expected.title!)\r\n      expect(actual.heightsMm).toEqual(golden.heightsMm)\r\n      expect(labelsByLevel(actual)).toEqual(\r\n        golden.levelTexts!.map((label) => [label]),\r\n      )\r\n    }\r\n  })\r\n\r\n  it('tsu: 제목으로 대응한 Y3 블록의 골든 부분 전사 높이와 라벨 열을 대조한다', () => {\r\n    const golden = readGolden('tsu-kanritou-p21-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('tsu-p21.json'))\r\n    const expected = golden.elevations[0]!\r\n    const actual = elevationForTitle(parsed, expected.title!)\r\n    const expectedHeights = expected.heightsBottomMm!\r\n    const expectedLabels = expected.levelsBottom!.map((label) => [label])\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    // 2FL 위쪽은 최상단 레벨 라벨을 확정하지 않은 골든 부분 전사이므로\r\n    // 높이와 라벨 모두 아래쪽 골든 구간만 대조한다.\r\n    expect(actual.heightsMm.slice(-expectedHeights.length)).toEqual(\r\n      expectedHeights,\r\n    )\r\n    expect(labelsByLevel(actual).slice(-expectedLabels.length)).toEqual(\r\n      expectedLabels,\r\n    )\r\n  })\r\n\r\n  it('hirosaki: 제목으로 대응한 X1·X2·X3 세 블록의 높이와 레벨 라벨을 골든과 대조한다', () => {\r\n    const golden = readGolden('hirosaki-kikyono-p25-elevation.json')\r\n    const parsed = parseFrameElevations(readPage('hirosaki-p25.json'))\r\n\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(3)\r\n    expect(golden.elevations).toHaveLength(3)\r\n    for (const expected of golden.elevations) {\r\n      const actual = elevationForTitle(parsed, expected.title!)\r\n      expect(actual.heightsMm).toEqual(expected.heightsMm)\r\n      expect(labelsByLevel(actual)).toEqual(\r\n        expected.levels!.map((label) => [label]),\r\n      )\r\n    }\r\n  })\r\n})\r\n{\r\n  \"verdict\": \"completed\",\r\n  \"items\": {\r\n    \"1_falsifiability\": {\r\n      \"holds\": false,\r\n      \"goldens_checked\": 16,\r\n      \"mutated_tests_failed\": 16\r\n    },\r\n    \"2_label_position\": {\r\n      \"holds\": false,\r\n      \"evidence\": [\r\n        \"CASES 7 + EXISTING_14 14개 페이지, 33개 grid를 raw TextItem 입력으로 확인했다.\",\r\n        \"모든 grid에서 axes[i].positionPt가 엄격히 증가했고, 독립 전사 골든의 label 순서(X 왼쪽→오른쪽, Y 위→아래)와 일치했다. nonMonotonic=0.\"\r\n      ]\r\n    },\r\n    \"3_regression\": {\r\n      \"holds\": false,\r\n      \"evidence\": [\r\n        \"parseSectionLists를 main worktree와 14개 기존 페이지에서 cell-level 필드로 비교: 예상된 ojkk-p4 12개 대상외 셀만 차이, 그 밖의 차이 0.\",\r\n        \"기존 grid 14개와 기존 階高 6개를 main과 비교: 양쪽 모두 차이 0.\"\r\n      ]\r\n    },\r\n    \"4_sweep\": {\r\n      \"holds\": false,\r\n      \"midpoint_sweep\": {\r\n        \"4\": \"36면, gridPages=23; kani-p38·kani-p39·yokohama-p6·yokohama-p7 모두 寸法欠落 재현.\",\r\n        \"6\": \"36면, gridPages=23; T=4에서만 사라지는 4면이 복원됨.\",\r\n        \"15\": \"36면, gridPages=26; 기준값.\",\r\n        \"30\": \"36면, gridPages=26; T=15 대비 gridPages 변화 없음.\",\r\n        \"40\": \"36면, gridPages=26; 넓은 문턱에서만 fuji-p17의 寸法列曖昧이 추가됨.\"\r\n      }\r\n    },\r\n    \"5_specialization\": {\r\n      \"holds\": false,\r\n      \"evidence\": [\r\n        \"git diff main...HEAD -- src/lib/import에서 file/issuer/sheet 분기·process.env·labels/spansMm reverse 분기·단일 면 전용 상수를 찾지 못했다.\",\r\n        \"현재 소스의 reverse() 2건은 section-list의 wall mark/value 탐색이며 grid labels/spansMm를 뒤집지 않는다.\"\r\n      ]\r\n    },\r\n    \"6_level_labels\": {\r\n      \"holds\": false,\r\n      \"evidence\": [\r\n        \"階高 corpus 3면 + 기존 elevation 4개 계열(실제 7개 페이지)을 확인했고 /^(?:[A-Z]{1,3}\\\\d)|▽|▲|△/ 위반 labels=0.\"\r\n      ]\r\n    },\r\n    \"7_title_block\": {\r\n      \"holds\": false,\r\n      \"matches\": 0\r\n    },\r\n    \"8_two_layer_and_defaults\": {\r\n      \"holds\": false,\r\n      \"evidence\": [\r\n        \"saiki 2段筋 후보 8개 모두 girderMain 본수 필드가 없고 2段筋未対応로 남아, 확정 본수 0.\",\r\n        \"ina G1·GA의 빈 STP 셀은 stirrup/default를 만들지 않고 raw에도 STP 기본값을 주지 않는 것을 확인했다. targeted 3 tests passed.\"\r\n      ]\r\n    },\r\n    \"9_typecheck_lint\": {\r\n      \"holds\": false,\r\n      \"typecheck_errors\": 0,\r\n      \"lint_errors\": 0\r\n    },\r\n    \"10_short_tail_constant\": {\r\n      \"holds\": false,\r\n      \"only_tsu_breaks_at_0_25\": true,\r\n      \"tsu_1170_layout\": \"SHORT_TAIL...=0.25에서 corpus2-elevation 3건 + 기존 elevation 6건 중 tsu만 실패했다. raw VerticalRun은 마지막 150mm를 x=180.100928,y=753.419685, 1170mm를 별도 왼쪽 치수열 x=160.540936,y=772.619669에 둔다. 따라서 실제 gap은 19.199984pt이고, 앞선 chain의 median scale과 ((150+1170)/2)×scale 모델이 기대하는 gap은 12.903797pt이다. 1170 문자열은 인접 레벨 구간의 중점이 아니라 왼쪽 치수열의 별도 치수선 위치에 놓여 있어 6.296187pt 아래로 어긋난다.\"\r\n    }\r\n  },\r\n  \"git_status_clean\": true,\r\n  \"summary\": \"Step 5 반증 항목 1~10이 모두 불성립했다. 16개 골든 변조가 모두 실패했고, main 대비 기존 결과·문턱 회귀·레벨/표제란 순도·타입체크/린트를 통과했으며 SHORT_TAIL 0.25에서는 tsu만 깨졌다.\"\r\n}\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
