eMm)\r\n  )\r\n}\r\n\r\nfunction chainScales(chain: DimensionToken[]): number[] {\r\n  return chain.slice(1).map((dimension, i) =>\r\n    dimensionScale(chain[i], dimension),\r\n  )\r\n}\r\n\r\nfunction isShortDimension(\r\n  dimension: DimensionToken,\r\n  previous: DimensionToken[],\r\n): boolean {\r\n  return (\r\n    previous.length >= MINIMUM_CHAIN_DIMENSIONS &&\r\n    dimension.valueMm < median(previous.map((entry) => entry.valueMm)) *\r\n      SHORT_DIMENSION_RATIO\r\n  )\r\n}\r\n\r\n/** 치수를 x가 곧게 선 열로 묶는다 */\r\nfunction dimensionColumns(dimensions: DimensionToken[]): DimensionToken[][] {\r\n  const sorted = [...dimensions].sort((a, b) => a.x - b.x || a.y - b.y)\r\n  const columns: DimensionToken[][] = []\r\n\r\n  for (const token of sorted) {\r\n    const column = columns.at(-1)\r\n    if (column && Math.abs(column[0].x - token.x) <= COLUMN_TOLERANCE_PT) {\r\n      column.push(token)\r\n    } else {\r\n      columns.push([token])\r\n    }\r\n  }\r\n\r\n  return columns.map((column) => [...column].sort((a, b) => a.y - b.y))\r\n}\r\n\r\nfunction horizontalDistance(token: Token, x: number): number {\r\n  if (token.rightX < x) return x - token.rightX\r\n  if (token.leftX > x) return token.leftX - x\r\n  return 0\r\n}\r\n\r\nfunction labelText(token: Token): string | undefined {\r\n  const text = token.text.replace(/^[▽△▲▼]+/, '')\r\n  return text.length > 0 ? text : undefined\r\n}\r\n{\r\n  \"$comment\": \"Schema: source{cacheFile,sha256,page}; page{widthPt,heightPt}; items[{str,x,y,w,h,rot?}]. Coordinates: top-left origin, +y downward, pt.\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-tsu-kanritou.pdf\",\r\n    \"sha256\": \"e09d156150d191096b190283f455e4e7c6875bb8000f89048aabda2326acfc7f\",\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport { readFileSync, readdirSync } from 'node:fs'\nimport { resolve } from 'node:path'\nimport { recoverRows, verticalRuns } from './src/lib/import/runs'\nconst dir=resolve('tests/fixtures/section-import/textitems')\nconst files=readdirSync(dir).filter(n=>n.endsWith('.json')).sort()\nconst texts:string[]=[]\nfor(const file of files){const f=JSON.parse(readFileSync(resolve(dir,file),'utf8')); const rows=recoverRows(f.items); texts.push(...rows.flatMap(r=>r.segments.map(s=>s.compact))); texts.push(...verticalRuns(f.items).map(r=>r.text))}\nconst isLevel=(s:string)=>/(?:FL|GL|RCL|(?:天端|下端|上端)\"'$)/.test(s)\nconst strip=(s:string)=>s.replace(/''^[▽△▲▼]+/,'\"'')\nconst probes=['梁天端','基礎梁天端','1SL','2SL','SL+756.70','RSL+760.00','5.B.PL下端は基礎梁天端+50とする。','・基礎梁天端から1FLまでは打増しとする。','支持地盤は、GL-900以下の弱風化花崗岩層とする']\nconst found=Object.fromEntries(probes.map(p=>[p,[...new Set(texts.filter(t=>t.includes(p)).map(t=>({text:t,labelText:strip(t),passes:isLevel(strip(t))})))] ]))\nconst counts={梁天端:texts.filter(t=>t==='梁天端').length,基礎梁天端:texts.filter(t=>t==='基礎梁天端').length,oneSL:texts.filter(t=>t.includes('1SL')).length,twoSL:texts.filter(t=>t.includes('2SL')).length,slPlus:texts.filter(t=>t.includes('SL+756.70')).length,rslPlus:texts.filter(t=>t.includes('RSL+760.00')).length}\nconst passSentences=texts.filter(t=>t.includes('基礎梁天端から1FLまでは打増しとする')||t.includes('支持地盤は、GL-900以下の弱風化花崗岩層とする'))\nconst failSl=texts.filter(t=>t.includes('1SL')||t.includes('2SL')||t.includes('SL+756.70')||t.includes('RSL+760.00'))\nconsole.log(JSON.stringify({files:files.length,totalStrings:texts.length,counts,found,passSentences,failSl:failSl.slice(0,20),passCount:texts.filter(t=>isLevel(strip(t))).length,failCount:texts.filter(t=>\"'!isLevel(strip(t))).length}))\n'\"'@ | npx tsx -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
