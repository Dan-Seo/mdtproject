W_PT = LABEL_WINDOW_PT / 4\r\n/** 吏㏃? 移섏닔???띿뒪???꾩튂 ?몄감瑜??덉슜?섎릺, 媛源뚯슫 ?≪쓬 移섏닔??嫄곗젅?쒕떎. */\r\n/**\r\n * ?ㅼ젣 吏㏃? 瑗щ━ ?ㅼ감??tsu 1170mm媛 0.4879329, hirosaki 2310mm媛 0.0005626?대떎.\r\n * 理쒕?媛믪쓣 ?ы븿?섎릺 50% 李쎈낫??醫곹엳湲??꾪빐 0.49瑜??대떎.\r\n */\r\nconst SHORT_TAIL_SCALE_TOLERANCE_RATIO = 0.49\r\n/**\r\n * 怨꾩뿴???섎젮硫?移섏닔媛 ?대쭔???덉뼱???쒕떎.\r\n *\r\n * **?섎줈??諛섏쬆?????쒕떎.** 移섏닔 ??媛쒕뒗 異뺤쿃???섎굹 ?좊룄?섎뒗?? ?좊룄??媛믪씠\r\n * ?먭린 ?먯떊怨??닿툔???섎뒗 ?놁쑝誘濡?異뺤쿃 ?쇨???寃?ш? 怨듯쉶?꾪븳?? 洹몃윭硫??⑤뒗\r\n * 利앷굅???쇰꺼 ?쇱튂肉먯씤?? 湲?먭? 鍮쎈뭣???꾨㈃?먯꽌??洹멸쾬??**?곗뿰??* 留욌뒗????\n * ?ㅻЪ kani p40?먯꽌 ?꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔(5,535 ?? 75 ??媛 ???대줈\r\n * ?댁뼱??異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???덈꺼 ?먮━??留덉묠 湲?먭? ?덉뼱\r\n * ??踰????듦낵?덈떎.\r\n *\r\n * ?뗭씠硫?異뺤쿃?????좊룄?섏뼱 ?쒕줈瑜?諛섏쬆?????덇퀬, 洹?寃?ш? ????寃쎌슦瑜?\n * 紐⑤몢 ?〓뒗?? ?媛濡?移섏닔媛 ?섎퓧??邕며탡??3?덈꺼)???쎌? ?딅뒗????吏?대궡??\n * 寃껊낫???ル떎 (R10).\r\n */\r\nconst MINIMUM_CHAIN_DIMENSIONS = 3\r\n\r\ninterface Token {\r\n  text: string\r\n  x: number\r\n  y: number\r\n  leftX: number\r\n  rightX: number\r\n}\r\n\r\ninterface DimensionToken extends Token {\r\n  valueMm: number\r\n}\r\n\r\nfunction tokens(page: TextPage): Token[] {\r\n  const collected: Token[] = []\r\n  for (const row of recoverRows(page.items)) {\r\n    for (const segment of row.segments) {\r\n      collected.push({\r\n        text: segment.compact,\r\n        x: segment.centerX,\r\n        y: segment.centerY,\r\n        leftX: segment.x,\r\n        rightX: segment.endX,\r\n      })\r\n    }\r\n  }\r\n  for (const run of verticalRuns(page.items)) {\r\n    collected.push({\r\n      text: run.text,\r\n      x: run.x,\r\n      y: run.y,\r\n      leftX: run.x,\r\n      rightX: run.x,\r\n    })\r\n  }\r\n  return collected\r\n}\r\n\r\nfunction median(values: number[]): number {\r\n  return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\r\n}\r\n\r\nfunction dimensionScale(left: DimensionToken, right: DimensionToken): number {\r\n  return (\r\n    (2 * (right.y - left.y)) /\r\n    (left.valueMm + right.valueMm)\r\n  )\r\n}\r\n\r\nfunction chainScales(chain: DimensionToken[]): number[] {\r\n  return chain.slice(1).map((dimension, i) =>\r\n    dimensionScale(chain[i], dimension),\r\n  )\r\n}\r\n\r\nfunction isShortDimension(\r\n  dimension: DimensionToken,\r\n  previous: DimensionToken[],\r\n): boolean {\r\n  return (\r\n    previous.length >= MINIMUM_CHAIN_DIMENSIONS &&\r\n    dimension.valueMm < median(previous.map((entry) => entry.valueMm)) *\r\n      SHORT_DIMENSION_RATIO\r\n  )\r\n}\r\n\r\n/** 移섏닔瑜?x媛 怨㏐쾶 ???대줈 臾띕뒗??*/\r\nfunction dimensionColumns(dimensions: DimensionToken[]): DimensionToken[][] {\r\n  const sorted = [...dimensions].sort((a, b) => a.x - b.x || a.y - b.y)\r\n  const columns: DimensionToken[][] = []\r\n\r\n  for (const token of sorted) {\r\n    const column = columns.at(-1)\r\n    if (column && Math.abs(column[0].x - token.x) <= COLUMN_TOLERANCE_PT) {\r\n      column.push(token)\r\n    } else {\r\n      columns.push([token])\r\n    }\r\n  }\r\n\r\n  return columns.map((column) => [...column].sort((a, b) => a.y - b.y))\r\n}\r\n\r\nfunction horizontalDistance(token: Token, x: number): number {\r\n  if (token.rightX < x) return x - token.rightX\r\n  if (token.leftX > x) return token.leftX - x\r\n  return 0\r\n}\r\n\r\nfunction labelText(token: Token): string | undefined {\r\n  const text = token.text.replace(/^[?썩뼰?꿎뼹]+/, '')\r\n  return text.length > 0 ? text : undefined\r\n}\r\n\r\nfunction isLevelLabel(text: string): boolean {\r\n  return /(?:FL|GL|RCL|(?:鸚⑴ク|訝뗧ク|訝딁ク)$)/.test(text)\r\n}\r\n\r\nfunction labelColumns(labels: Token[], axisX: number): Token[][] {\r\n  const candidates = labels\r\n    .filter((label) => horizontalDistance(label, axisX) <= LABEL_WINDOW_PT)\r\n    .sort(\r\n      (left, right) =>\r\n        left.leftX - right.leftX ||\r\n        left.y - right.y ||\r\n        left.rightX - right.rightX,\r\n    )\r\n  const columns: Token[][] = []\r\n\r\n  for (const candidate of candidates) {\r\n    const column = columns.at(-1)\r\n    const columnRight = column?.reduce(\r\n      (right, token) => Math.max(right, token.rightX),\r\n      Number.NEGATIVE_INFINITY,\r\n    )\r\n    if (\r\n      column &&\r\n      candidate.leftX - columnRight! <= LABEL_COLUMN_GAP_PT\r\n    ) {\r\n      column.push(candidate)\r\n    } else {\r\n      columns.push([candidate])\r\n    }\r\n  }\r\n\r\n  return columns\r\n}\r\n\r\nfunction nearestLevelIndex(\r\n  levels: ElevationLevel[],\r\n  y: number,\r\n): { index: number; distance: number } {\r\n  let index = -1\r\n  let distance = Number.POSITIVE_INFINITY\r\n  for (let i = 0; i < levels.length; i++) {\r\n    const candidateDistance = Math.abs(levels[i].positionPt - y)\r\n    if (candidateDistance < distance) {\r\n      index = i\r\n      distance = candidateDistance\r\n    }\r\n  }\r\n  return { index, distance }\r\n}\r\n\r\nfunction selectLabelColumn(\r\n  labels: Token[],\r\n  levels: ElevationLevel[],\r\n  axisX: number,\r\n): Token[] {\r\n  const ranked = labelColumns(labels, axisX)\r\n    .map((column) => {\r\n      const usable = column.filter((token) => {\r\n        const text = labelText(token)\r\n        return text !== undefined && isLevelLabel(text)\r\n      })\r\n      const labelledLevels = new Set(\r\n        usable\r\n          .map((token) => nearestLevelIndex(levels, token.y))\r\n          .filter(({ distance }) => distance <= LEVEL_TOLERANCE_PT)\r\n          .map(({ index }) => index),\r\n      )\r\n      const distance = Math.min(\r\n        ...column.map((token) => horizontalDistance(token, axisX)),\r\n      )\r\n      return { column, labelledLevels, usable, distance }\r\n    })\r\n    .sort(\r\n      (left, right) =>\r\n        right.labelledLevels.size - left.labelledLevels.size ||\r\n        right.usable.length - left.usable.length ||\r\n        left.distance - right.distance,\r\n    )\r\n\r\n  const selected = ranked[0]?.column ?? []\r\n  const selectedSet = new Set(selected)\r\n  const displaced = ranked.flatMap(({ column }) =>\r\n    column.filter((token) => {\r\n      if (selectedSet.has(token)) return false\r\n      const text = labelText(token)\r\n      if (text === undefined || !isLevelLabel(text)) return false\r\n      const nearest = nearestLevelIndex(levels, token.y)\r\n      return nearest.distance <= LEVEL_TOLERANCE_PT\r\n    }),\r\n  )\r\n\r\n  return [...selected, ...displaced]\r\n}\r\n\r\n/**\r\n * ???댁쓣 異뺤쿃???댁뼱吏??理쒕? 援ш컙?쇰줈 ?섎늿?? 媛숈? ?댁뿉 ?꽷룹븘????邕며탡?녠?\r\n * ?ㅻ━硫??ㅻЪ p8) 洹??ъ씠?먯꽌 ?좊룄 異뺤쿃???ш쾶 ?꾨떎 ???댁쓣 ?듭㎏濡?踰꾨━吏 ?딄퀬\r\n * 洹??먮━?먯꽌 ?먮Ⅸ??\r\n */\r\nfunction chains(column: DimensionToken[]): DimensionToken[][] {\r\n  const result: DimensionToken[][] = []\r\n  let current: DimensionToken[] = []\r\n  let reference: number | undefined\r\n\r\n  for (let i = 0; i + 1 < column.length; i++) {\r\n    const scale = dimensionScale(column[i], column[i + 1])\r\n    const continues =\r\n      reference !== undefined &&\r\n      Math.abs(scale / reference - 1) <= SCALE_TOLERANCE_RATIO\r\n    const shortDimension =\r\n      current.length >= MINIMUM_CHAIN_DIMENSIONS &&\r\n      isShortDimension(column[i + 1], current) &&\r\n      reference !== undefined &&\r\n      Math.abs(scale / reference - 1) <= SHORT_TAIL_SCALE_TOLERANCE_RATIO\r\n\r\n    if (continues || shortDimension) {\r\n      current.push(column[i + 1])\r\n    } else {\r\n      if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\r\n      current = [column[i], column[i + 1]]\r\n      reference = scale\r\n    }\r\n  }\r\n  if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\r\n\r\n  return result\r\n}\r\n\r\n/**\r\n * 吏㏃? 援ш컙 ?ㅼ쓽 留덉?留?移섏닔??媛숈? 二쇱꽍 ?댁쓽 ??씠 ?ㅻⅨ ?꾩튂???볦씪 ???덈떎.\r\n * 媛숈? x ?대쭔 怨좎쭛?섎㈃ Tsu??1170怨?Hirosaki??2310???덈씫?쒕떎. 癒쇱? ?곗뇙?먯꽌\r\n * ?좊룄??異뺤쿃怨?媛??媛源뚯슫 ?ㅼ쓬 ?レ옄 ?섎굹瑜?怨좊Ⅴ怨? x ?대룞쨌媛꾧꺽쨌異뺤쿃??紐⑤몢\r\n * 留뚯”???뚮쭔 遺숈씤?? ?≪쓬 ?レ옄瑜???쒓컪?쇰줈 怨좊Ⅴ吏 ?딅룄濡??꾨낫媛 ?놁쑝硫?硫덉텣??\r\n */\r\nfunction extendShortTail(\r\n  chain: DimensionToken[],\r\n  dimensions: DimensionToken[],\r\n): DimensionToken[] {\r\n  const extended = [...chain]\r\n  const used = new Set(chain)\r\n\r\n  while (extended.length >= MINIMUM_CHAIN_DIMENSIONS) {\r\n    const last = extended.at(-1)\r\n    if (!last || !isShortDimension(last, extended.slice(0, -1))) break\r\n\r\n    const scales = chainScales(extended)\r\n    if (scales.length === 0) break\r\n    const scale = median(scales)\r\n    const chainX = median(extended.map((entry) => entry.x))\r\n    const candidates = dimensions\r\n      .filter((candidate) => {\r\n        if (used.has(candidate) || candidate.y <= last.y) return false\r\n        if (\r\n          Math.abs(candidate.x - chainX) > SHORT_TAIL_COLUMN_WINDOW_PT\r\n        ) {\r\n          return false\r\n        }\r\n\r\n        const gap = candidate.y - last.y\r\n        if (gap > LABEL_WINDOW_PT) return false\r\n        const expectedGap =\r\n          ((last.valueMm + candidate.valueMm) / 2) * scale\r\n        if (expectedGap <= 0) return false\r\n        return (\r\n          Math.abs(gap / expectedGap - 1) <=\r\n          SHORT_TAIL_SCALE_TOLERANCE_RATIO\r\n        )\r\n      })\r\n      .sort((left, right) => {\r\n        const leftGap = left.y - last.y\r\n        const rightGap = right.y - last.y\r\n        const leftExpected =\r\n          ((last.valueMm + left.valueMm) / 2) * scale\r\n        const rightExpected =\r\n          ((last.valueMm + right.valueMm) / 2) * scale\r\n        return (\r\n          Math.abs(leftGap / leftExpected - 1) -\r\n            Math.abs(rightGap / rightExpected - 1) ||\r\n          leftGap - rightGap\r\n        )\r\n      })\r\n\r\n    const next = candidates[0]\r\n    if (!next) break\r\n    extended.push(next)\r\n    used.add(next)\r\n  }\r\n\r\n  return extended\r\n}\r\n\r\nfunction levelsOf(\r\n  chain: DimensionToken[],\r\n  scale: number,\r\n): Array<{ positionPt: number }> {\r\n  const first = chain[0].y - (chain[0].valueMm * scale) / 2\r\n  const positions = [first]\r\n  for (const dimension of chain) {\r\n    positions.push(positions[positions.length - 1] + dimension.valueMm * scale)\r\n  }\r\n  return positions.map((positionPt) => ({ positionPt }))\r\n}\r\n\r\nfunction verticalExtent(elevation: ElevationCandidate): {\r\n  top: number\r\n  bottom: number\r\n} {\r\n  return {\r\n    top: elevation.levels[0].positionPt,\r\n    bottom: elevation.levels[elevation.levels.length - 1].positionPt,\r\n  }\r\n}\r\n\r\n/**\r\n * ?몃줈 踰붿쐞媛 寃뱀튂??怨꾩뿴? **媛숈? 援ш컙???쒕줈 ?ㅻⅨ ?쎄린**?????ㅻЪ p8?먯꽌??\n * ?롩쳵 ??1400쨌4100쨌4480쨌2690) ?놁뿉 ?ⓨ늽 移섏닔 ??190쨌150쨌2350)???섎????쒓퀬,\r\n * 洹?遺遺??대룄 洹쇱쿂 ?쇰꺼 ?섏쓣 二쇱썙 怨꾩뿴??議곌굔??留뚯”?쒕떎. ?????대㈃ ?ъ슜?먯뿉寃?\n * ?쒕줈 ?닿툔?섎뒗 ?롩쳵媛 ?숈떆??蹂댁씤??\r\n *\r\n * 媛???볤쾶 ?쎌? 寃??섎굹留??④릿?? ?롩쳵 ?댁? 邕며탡?녹쓽 ?믪씠 ?꾩껜瑜??ш퀬\r\n * 遺遺??댁? 援?냼?곸씠?? ?몃줈 踰붿쐞媛 洹??섏쓣 媛???ш쾶 媛덈씪 ?볥뒗???ㅻЪ?먯꽌\r\n * 359pt ? 38쨌52pt). ?꾨㈃ ?뺤떇?????꾩젣瑜?源⑤㈃ 怨꾩뿴???섎굹 ?щ씪吏怨?\r\n * 媛믪쓣 吏?대궡??????ъ슜?먭? ?먯쑝濡??ｋ뒗??(R10).\r\n */\r\nfunction withoutOverlaps(\r\n  elevations: ElevationCandidate[],\r\n): ElevationCandidate[] {\r\n  const ranked = [...elevations].sort((a, b) => {\r\n    const left = verticalExtent(a)\r\n    const right = verticalExtent(b)\r\n    return (\r\n      right.bottom - right.top - (left.bottom - left.top) ||\r\n      b.levels.length - a.levels.length\r\n    )\r\n  })\r\n\r\n  const kept: ElevationCandidate[] = []\r\n  for (const elevation of ranked) {\r\n    const range = verticalExtent(elevation)\r\n    const overlaps = kept.some((accepted) => {\r\n      const other = verticalExtent(accepted)\r\n      return range.top <= other.bottom && other.top <= range.bottom\r\n    })\r\n    if (!overlaps) kept.push(elevation)\r\n  }\r\n\r\n  return kept\r\n}\r\n\r\nexport function parseFrameElevations(page: TextPage): ParsedFrameElevations {\r\n  const collected = tokens(page)\r\n\r\n  const dimensions: DimensionToken[] = []\r\n  const labels: Token[] = []\r\n  const titles: Token[] = []\r\n  for (const token of collected) {\r\n    if (DIMENSION_PATTERN.test(token.text)) {\r\n      dimensions.push({\r\n        ...token,\r\n        valueMm: Number.parseInt(token.text.replaceAll(',', ''), 10),\r\n      })\r\n      continue\r\n    }\r\n    if (ELEVATION_TITLE_PATTERN.test(token.text)) {\r\n      titles.push(token)\r\n      continue\r\n    }\r\n    labels.push(token)\r\n  }\r\n\r\n  const elevations: ElevationCandidate[] = []\r\n  for (const column of dimensionColumns(dimensions)) {\r\n    for (const baseChain of chains(column)) {\r\n      const chain = extendShortTail(baseChain, dimensions)\r\n      const scales = chainScales(chain)\r\n      const scale = median(scales)\r\n      const positions = levelsOf(chain, scale)\r\n\r\n      // ?쇰꺼? 媛??媛源뚯슫 ?덈꺼 ?섎굹?먮쭔 遺숇뒗????痢듭씠 ?뺤쑝硫??덉슜 踰붿쐞媛\r\n      // 寃뱀튂?붾뜲, 寃뱀튂??留뚰겮 ?묒そ???ｌ쑝硫??녿뒗 ?쇰꺼???앷릿??\n      const levels: ElevationLevel[] = positions.map(({ positionPt }) => ({\r\n        labels: [],\r\n        positionPt,\r\n      }))\r\n      const labelsAtLevels: Token[][] = levels.map(() => [])\r\n      const labelColumn = selectLabelColumn(labels, levels, chain[0].x)\r\n      for (const label of labelColumn) {\r\n        const text = labelText(label)\r\n        if (text === undefined || !isLevelLabel(text)) continue\r\n        const nearest = nearestLevelIndex(levels, label.y)\r\n        if (nearest.index < 0 || nearest.distance > LEVEL_TOLERANCE_PT) {\r\n          continue\r\n        }\r\n        labelsAtLevels[nearest.index].push(label)\r\n      }\r\n\r\n      // 吏㏃? 移섏닔媛 ?ㅼ젣濡??곹? ?덉쑝硫? 洹??ъ씠?????덈꺼??媛숈? ?꾩튂濡??묒?\r\n      // ?딅뒗?? 移섏닔 ?쒓린媛 醫곸? 援ш컙???쒖そ??紐곕젮 ???쇰꺼?????덈꺼???④퍡\r\n      // 遺숇뒗 寃쎌슦?먮뒗, ?꾨㈃???꾟넂?꾨옒 ?쇰꺼 ?쒖꽌濡??ㅼ쓬 ?덈꺼???섎굹瑜?蹂대궦??\r\n      for (let i = 0; i + 1 < chain.length; i++) {\r\n        if (!isShortDimension(chain[i], chain.slice(0, i))) continue\r\n        if (\r\n          labelsAtLevels[i]?.length !== 2 ||\r\n          labelsAtLevels[i + 1]?.length !== 0\r\n        ) {\r\n          continue\r\n        }\r\n        const ordered = [...(labelsAtLevels[i] ?? [])].sort(\r\n          (left, right) => left.y - right.y || left.x - right.x,\r\n        )\r\n        const moved = ordered.pop()\r\n        if (!moved) continue\r\n        labelsAtLevels[i] = ordered\r\n        labelsAtLevels[i + 1] = [moved]\r\n      }\r\n\r\n      for (let i = 0; i < levels.length; i++) {\r\n        levels[i].labels = (labelsAtLevels[i] ?? [])\r\n          .sort((left, right) => left.y - right.y || left.x - right.x)\r\n          .flatMap((label) => {\r\n            const text = labelText(label)\r\n            return text === undefined ? [] : [text]\r\n          })\r\n      }\r\n\r\n      const labelled = levels.filter((level) => level.labels.length > 0).length\r\n      if (labelled < MINIMUM_LABELLED_LEVELS) continue\r\n\r\n      elevations.push({\r\n        titles: [],\r\n        levels,\r\n        heightsMm: chain.map((dimension) => dimension.valueMm),\r\n        scalePtPerMm: scale,\r\n      })\r\n    }\r\n  }\r\n\r\n  const overlapFree = withoutOverlaps(elevations)\r\n  overlapFree.sort((a, b) => a.levels[0].positionPt - b.levels[0].positionPt)\r\n\r\n  // ?쒕ぉ? 怨꾩뿴??遺숈씤??????怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃━誘濡?\n  // (?ㅻЪ p8? 醫뚮떒 移섏닔 ???섎굹??bY1쨌bY2쨌bY3 ???? 1:1???꾨땲??\r\n  //\r\n  // ?⑥닚 理쒓렐?묒씠 ?꾨땲??**?쒕ぉ ?꾩뿉 ?덈뒗 怨꾩뿴???곗꽑?쒕떎.** 邕며탡?녹쓽 罹≪뀡?\r\n  // 洹몃┝ ?꾨옒???곹엳?붾뜲(?ㅻЪ p8??6???꾨?), ??洹몃┝??罹≪뀡? ??洹몃┝???섎떒怨?\n  // ?꾨옒 洹몃┝???곷떒?먯꽌 嫄곗쓽 媛숈? 嫄곕━???볦씤??p8 ?ㅼ륫 170.4pt ? 167.7pt) ??\n  // ?⑥닚 理쒓렐?묒? ??移쇰걹?먯꽌 媛덈━怨? ?ㅼ젣濡?VerticalRun.y 洹쒖빟 ?뺤젙(?뭮/2)??\n  // 洹??먯젙???ㅼ쭛????怨꾩뿴???쒕ぉ 0?μ쑝濡??щ씪議뚮떎. ?꾩뿉 怨꾩뿴???섎굹???놁쓣\r\n  // ?뚮쭔(罹≪뀡??洹몃┝ ?꾩뿉 ?덈뒗 ?뺤떇) ?꾨옒?먯꽌 理쒓렐?묒쓣 李얜뒗??\r\n  for (const title of titles) {\r\n    let above: ElevationCandidate | undefined\r\n    let aboveDistance = Number.POSITIVE_INFINITY\r\n    let below: ElevationCandidate | undefined\r\n    let belowDistance = Number.POSITIVE_INFINITY\r\n    for (const elevation of overlapFree) {\r\n      const top = elevation.levels[0].positionPt\r\n      const bottom = elevation.levels[elevation.levels.length - 1].positionPt\r\n      if (title.y >= top) {\r\n        const distance = title.y > bottom ? title.y - bottom : 0\r\n        if (distance < aboveDistance) {\r\n          above = elevation\r\n          aboveDistance = distance\r\n        }\r\n      } else {\r\n        const distance = top - title.y\r\n        if (distance < belowDistance) {\r\n          below = elevation\r\n          belowDistance = distance\r\n        }\r\n      }\r\n    }\r\n    ;(above ?? below)?.titles.push(title.text)\r\n  }\r\n\r\n  // 邕며탡?녹쓽 ?믪씠 怨꾩뿴? 邕며탡?녹뿉 ?랁븳?????쒕ぉ??遺숈? ?딆? 移섏닔 ?댁? 洹멸쾬??\n  // 臾댁뾿???믪씠?몄? 留먰븷 ???녿떎. ?ㅻЪ yokohama ??18履쎌쓣 ?듦낵?쒗궎硫?**?계나?긺듁??*媛\r\n  // 嫄몃┛??源딆씠 ?レ옄媛 ?댁쓣 ?대（怨??놁뿉 ?쇰꺼???좊떎) ??洹멸쾬???롩쳵濡??대㈃\r\n  // ?ъ슜?먯뿉寃??덉????딆? 痢듭씠 蹂댁씤??\n  const resolved = overlapFree.filter((elevation) => elevation.titles.length > 0)\r\n\r\n  if (resolved.length === 0) {\r\n    return { elevations: [], issues: ['野멩퀡?쀦쑋濾쒎눣'] }\r\n  }\r\n\r\n  const issues: ElevationIssue[] = []\r\n  return { elevations: resolved, issues }\r\n}\r\n\r\nimport {\r\n  BAR_SIZES,\r\n  SHEAR_BAR_SIZES,\r\n  type BarSize,\r\n  type ShearBarSize,\r\n} from '@/domain/model/member'\r\n\r\nimport {\r\n  compact,\r\n  makeSegments,\r\n  normalized,\r\n  PROXIMITY_MULTIPLIER,\r\n  recoverRows,\r\n  verticalRuns,\r\n  type TextRow,\r\n  type TextSegment,\r\n  type VerticalRun,\r\n} from '../runs'\r\n\r\nimport type {\r\n  CandidateIssue,\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from './types'\r\n\r\ninterface MarkColumn {\r\n  mark: string\r\n  centerX: number\r\n  /** 媛숈? ?먮Ц ??먯꽌 ?쇱퀜吏?遺?몃? 媛?諛곗젙 ???섎굹濡?臾띕뒗?? */\r\n  groupKey: string\r\n  rawCell: string\r\n}\r\n\r\ninterface PositionColumn {\r\n  label: string\r\n  rawLabel: string\r\n  centerX: number\r\n  mark: string\r\n}\r\n\r\ninterface StoryRow {\r\n  label: string\r\n  row: TextRow\r\n}\r\n\r\ninterface TitleAnchor {\r\n  listKind: string\r\n  /** 罹≪쿂媛 ?꾨땶 ??댄? ?멸렇癒쇳듃 ?먮Ц ??野얕괌鸚??먯젙? ?ш린瑜?蹂몃떎 */\r\n  titleText: string\r\n  row: TextRow\r\n  x: number\r\n}\r\n\r\ninterface ParsedBar {\r\n  size: BarSize\r\n  count: number\r\n}\r\n\r\nconst barSizes = new Set<BarSize>(BAR_SIZES)\r\n// 躍?춮?삠걗?겹굢嶺뗣걽?묆걣遙섇섭佯╉걵?볠뼪獒쒎섭嶺?(K13?팗13) ?믣룚?뚣굥?귚말嶺뗣겗 barSizes ??\n// ?녴걨?╉걚?뗣겗??곦말嶺뗣겓?γ굥?②〃5.3.4?삭〃5.3.2 ?ャ겒?꾢푶?믣폊?뤵걢?됥걽 (ADR-026)??\nconst shearBarSizes = new Set<ShearBarSize>(SHEAR_BAR_SIZES)\r\n\r\nconst TITLE_PATTERN =\r\n  /(?길뼪?㏂꺁?밤깉|鸚㎪쥈??씊?ゃ궧??弱뤸쥈??씊?ゃ궧??弱뤸쥈?ゃ궧???뉑똻歟곥꺁?밤깉|?뉑똻?밤꺀?뽧꺁?밤깉|?먨쑇?덀꺁?밤깉|鶯곥꺁?밤깉|?밤꺀?뽧꺁?밤깉|?겻릎歟곥꺁?밤깉|?긱꺁?밤깉|鸚㎪쥈?ゃ궧??歟곥꺁?밤깉)/\r\nconst STORY_PATTERN = /^(?:RF|R??\\d+F|\\d+???곈쉸)$/\r\nconst MARK_PATTERN = /^(?:(?:[A-Z]?\\d*)?(?:FCG|CG|EW|BW|FS|CS|FC|FG|FB|CB|C|G|B|S|W)(?:\\d+[A-Z]?|[A-Z])?|fg)$/i\r\n\r\n/** ?몃줈 ?곗쓣 痢??щ씪?댁뒪??諛곗젙???뚯쓽 嫄곕━ ?곹븳 = ?щ씪?댁뒪 ??횞 ??媛?\r\n *  諛곗젙 ?듭빱媛 痢??쇰꺼?대뜕 ?숈븞?먮뒗 ??寃?ш? 以묎컙 痢듭뿉????긽 李몄씠?덈떎 ??\n *  ?щ씪?댁뒪媛 留욌떯???덉뼱(endY[i] == startY[i+1]) ?쇰꺼 理쒓렐?묒쓽 蹂대줈?몄씠 寃쎄퀎媛\r\n *  span/2? ?뺥솗???쇱튂?덇린 ?뚮Ц?대떎. ?듭빱瑜??쒖쓽 ?됱쑝濡?諛붽퓭 ?곹븳???ㅼ젣濡?\n *  ?묐룞?섍쾶 ?먮떎 (#32?? verticalsBySlice 李멸퀬) */\r\nconst SLICE_DISTANCE_LIMIT_RATIO = 0.5\r\n\r\n/**\r\n * ?쒖젣?(?꾨㈃ ?고븯??釉붾줉)???녜씊?띸㎞ 移몄뿉??洹??꾨㈃???대쫫???ㅼ뼱媛꾨떎 ??\n * ?뚧쥈?ゃ궧?덀띿쿂??由ъ뒪????댄?怨?湲?먭? 媛숇떎. ?닿쾬???듭빱濡??≪쑝硫????쒓? 嫄곌린??\n * ?딄꺼 留덉?留?痢?釉붾줉???곗씠???됱씠 ?듭㎏濡??щ씪吏꾨떎: ?ㅻЪ ojkk p3?먯꽌 2F 7移몄씠\r\n * 議곗슜???놁뼱議뚭퀬(寧?뤇 ?됱? 寃쎄퀎 ?? ?곗씠???됱? 諛?, ?꾨낫 0媛쒖쭨由??좊졊 由ъ뒪?멸?\r\n * ?뚯씤??紐????쒓? ?덈떎?띾줈 ?쒖떆?먮떎.\r\n *\r\n * ?쇰꺼? 媛믨낵 ?곕줈 ?⑥뼱吏湲곕룄 ?섍퀬(ojkk: ?뚦쎋?℡릫燁겹??ㅼ쓬 ?멸렇癒쇳듃媛 ?뚧쥈?ゃ궧?덀?\r\n * ???⑹씠媛 ?섍린???쒕떎(yokohama: ?똀1=1/30?녜씊?띸㎞鸚㎪쥈??씊?ゃ궧?덀? ??????蹂몃떎.\r\n * ???꾩껜瑜?蹂댁????딅뒗?? ?쒖젣? ?좊뒗 ?꾨㈃ ??쓣 媛濡쒖?瑜대?濡?ojkk ?ㅼ륫 x=893~1150)\r\n * 媛숈? y???볦씤 吏꾩쭨 ??댄?源뚯? ?④퍡 吏?뚯쭊??\r\n */\r\nconst TITLE_BLOCK_LABELS = ['?녜씊?띸㎞', '?녜씊葉?닪'] as const\r\n\r\nfunction isTitleBlockField(\r\n  rows: TextRow[],\r\n  rowIndex: number,\r\n  segmentIndex: number,\r\n): boolean {\r\n  const row = rows[rowIndex]\r\n  const segment = row.segments[segmentIndex]\r\n  if (\r\n    TITLE_BLOCK_LABELS.some((label) => segment.compact.includes(label)) ||\r\n    row.segments[segmentIndex - 1]?.compact.endsWith('?녜씊?띸㎞') === true\r\n  ) {\r\n    return true\r\n  }\r\n\r\n  // ?쒖젣?? ?꾨㈃ ?뺤떇???곕씪 ?뚦쎋?℡릫燁겹띉룔뚦쎋?®Ŧ?γ??쇰꺼怨?媛믪씠 ?쒕줈 ?ㅻⅨ\r\n  // ?됱쑝濡?遺꾨━?쒕떎. 媛숈? y ?됰쭔 蹂대㈃ 媛??덉쓽 ?뚣궧?⒲깣?ゃ궧?덀띾? ?ㅼ젣 由ъ뒪??\n  // ??댄?濡??ㅼ씤?섎?濡? 諛붾줈 ?꾩쓽 媛源뚯슫 ?쇰꺼怨?媛숈? ?쒖젣? ?댁씤吏 ?뺤씤?쒕떎.\r\n  for (let index = rowIndex - 1; index >= 0; index -= 1) {\r\n    const labelRow = rows[index]\r\n    const distance = row.y - labelRow.y\r\n    const rowBand = Math.max(row.height, labelRow.height) * 3\r\n    if (distance > rowBand) break\r\n    if (\r\n      labelRow.segments.some(\r\n        (label) =>\r\n          TITLE_BLOCK_LABELS.includes(label.compact as (typeof TITLE_BLOCK_LABELS)[number]) &&\r\n          segment.x >= label.x,\r\n      )\r\n    ) {\r\n      return true\r\n    }\r\n  }\r\n  return false\r\n}\r\n\r\nfunction titleAnchors(rows: TextRow[]): TitleAnchor[] {\r\n  const anchors: TitleAnchor[] = []\r\n\r\n  // ???됱뿉 ??댄????щ윭 媛쒕㈃(醫뚯슦 蹂묒튂) ?꾨? ?듭빱濡??〓뒗??\n  for (const [rowIndex, row] of rows.entries()) {\r\n    for (const [index, segment] of row.segments.entries()) {\r\n      const match = segment.compact.match(TITLE_PATTERN)\r\n      if (!match || isTitleBlockField(rows, rowIndex, index)) continue\r\n      anchors.push({\r\n        listKind: match[1],\r\n        titleText: segment.compact,\r\n        row,\r\n        x: segment.x,\r\n      })\r\n    }\r\n  }\r\n\r\n  return anchors.sort(\r\n    (left, right) => left.row.y - right.row.y || left.x - right.x,\r\n  )\r\n}\r\n\r\nfunction exactLabel(row: TextRow, aliases: readonly string[]): TextSegment | undefined {\r\n  const normalizedAliases = aliases.map(compact)\r\n  const direct = row.segments.find((segment) =>\r\n    normalizedAliases.includes(segment.compact),\r\n  )\r\n  if (direct) return direct\r\n\r\n  // ???뺤떇???꾨땶 PDF?먯꽌???뚩끃嶺?-D10?띿쿂???쇰꺼怨?媛믪쓣 ???멸렇癒쇳듃??\n  // 遺숈뿬 異쒕젰?쒕떎. ?쇰꺼??紐?李얠븯?ㅺ퀬 ???꾩껜瑜?踰꾨━吏 ?딅룄濡??쇰꺼 ?묐몢留?\n  // ?몄떇?섍퀬, ?ㅼ젣 媛믪? dataSegments媛 ?묐?瑜??곕줈 留뚮뱺??\r\n  for (const segment of row.segments) {\r\n    const alias = normalizedAliases.find(\r\n      (candidate) =>\r\n        segment.compact.startsWith(candidate) &&\r\n        segment.compact.length > candidate.length,\r\n    )\r\n    if (alias) {\r\n      return {\r\n        ...segment,\r\n        text: segment.text.slice(alias.length),\r\n        compact: alias,\r\n        endX: segment.x,\r\n      }\r\n    }\r\n  }\r\n\r\n  // PDF留덈떎 ?뚨Е?룔띉룔뚨츋??띉룔똕TP.?띻? ?몄젒 湲由ы봽 ?멸렇癒쇳듃濡?媛덈씪吏꾨떎.\r\n  // ??蹂듭썝 ?④퀎?먯꽌 臾대━?섍쾶 遺숈씠硫??ㅻⅨ ?源뚯? ?⑹퀜吏????덉쑝誘濡? ?ш린?쒕쭔\r\n  // ?몄젒 ?멸렇癒쇳듃???쇰꺼 ?꾨낫瑜?議고빀?섍퀬 ?ㅼ젣 ? 媛믪쓽 諛곗젙? 湲곗〈 醫뚰몴瑜??대떎.\r\n  for (let start = 0; start < row.segments.length; start += 1) {\r\n    let value = ''\r\n    for (let end = start; end < row.segments.length; end += 1) {\r\n      value += row.segments[end].compact\r\n      if (normalizedAliases.includes(value)) {\r\n        const first = row.segments[start]\r\n        const last = row.segments[end]\r\n        return {\r\n          text: row.segments\r\n            .slice(start, end + 1)\r\n            .map((segment) => segment.text)\r\n            .join(''),\r\n          compact: value,\r\n          items: row.segments\r\n            .slice(start, end + 1)\r\n            .flatMap((segment) => segment.items),\r\n          x: first.x,\r\n          endX: last.endX,\r\n          centerX: (first.x + last.endX) / 2,\r\n          centerY: (first.centerY + last.centerY) / 2,\r\n        }\r\n      }\r\n      if (value.length >= Math.max(...normalizedAliases.map((alias) => alias.length))) {\r\n        break\r\n      }\r\n    }\r\n  }\r\n  return undefined\r\n}\r\n\r\n/** 媛믪씠 媛숈? ?멸렇癒쇳듃??遺숈? ?뚦퉭閭㏂굙嶺뗣겘?╉?媛숈? ?숃껊? 援ъ“?붾맂 ????곭춮\r\n * ?됱쑝濡??ㅼ씤?섏? ?딅룄濡? ???ы띁?????덉쓽 ?낅┰ ?쇰꺼留?李얜뒗?? */\r\nfunction standaloneLabel(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n): TextSegment | undefined {\r\n  const normalizedAliases = aliases.map(compact)\r\n  return row.segments.find((segment) =>\r\n    normalizedAliases.includes(segment.compact),\r\n  )\r\n}\r\n\r\nfunction canonicalMark(value: string): string | undefined {\r\n  const mark = compact(value)\r\n  if (!MARK_PATTERN.test(mark)) return undefined\r\n  return mark === 'fg' ? mark : mark.toUpperCase()\r\n}\r\n\r\nfunction markParts(value: string): string[] {\r\n  return compact(value)\r\n    .split(/[,??/u)\r\n    .map((part) => canonicalMark(part))\r\n    .filter((part): part is string => part !== undefined)\r\n}\r\n\r\nfunction markColumns(row: TextRow): MarkColumn[] {\r\n  const label = exactLabel(row, ['寧?뤇'])\r\n  if (!label) return []\r\n\r\n  return row.segments\r\n    .filter((segment) => segment.centerX > label.endX)\r\n    .flatMap((segment) => {\r\n      const marks = markParts(segment.text)\r\n      const groupKey = `${segment.x}:${segment.endX}`\r\n      return marks.map((mark) => ({\r\n        mark,\r\n        centerX: segment.centerX,\r\n        groupKey,\r\n        rawCell: segment.text,\r\n      }))\r\n    })\r\n}\r\n\r\nfunction storyFromRow(row: TextRow): string | undefined {\r\n  return row.segments\r\n    .map((segment) => segment.compact)\r\n    .find((value) => STORY_PATTERN.test(value))\r\n}\r\n\r\n/**\r\n * ?뚯쟾??由ъ뒪?몄뿉?쒕뒗 ?똓?띉룔??띿? ?뚪쉸?띻? 媛숈? ?됱씠 ?꾨땲??媛숈? ?댁쓽\r\n * ?곗냽 ?됱쑝濡?蹂듭썝?쒕떎. ??議곌컖???섎굹??story ?됱쑝濡쒕쭔 ?⑹튂怨? 洹?諛뽰쓽\r\n * ?レ옄쨌臾몄옄??痢듭쑝濡??밴꺽?섏? ?딅뒗?????쒖쓽 移섏닔??踰붾?瑜?痢듭쑝濡?留뚮뱾硫?\n * ?꾨옒 ?곗씠?곌? ?ㅻⅨ 痢듭뿉 議곗슜??洹?띾맂??\r\n */\r\nfunction storyRows(rows: TextRow[]): StoryRow[] {\r\n  const result: StoryRow[] = []\r\n  const seen = new Set<number>()\r\n\r\n  rows.forEach((row, index) => {\r\n    const direct = storyFromRow(row)\r\n    if (direct !== undefined) {\r\n      result.push({ label: direct, row })\r\n      seen.add(index)\r\n      return\r\n    }\r\n\r\n    const fragment = row.segments.find((segment) => /^(?:R|\\d+)$/.test(segment.compact))\r\n    // ?ㅼ?移섏? 二쇨린 ?띿뒪?멸? 媛숈? ???ъ씠???쇱뼱?? 媛숈? x ?댁뿉??媛??媛源뚯슫\r\n    // ?뚪쉸??議곌컖留?寃고빀?쒕떎. ?ㅼ쓬 ?됰쭔 蹂대뒗 諛⑹떇? saiki ?긱꺁?밤깉泥섎읆\r\n    // ?ε릦?ⓨ릭嶺떷룸쾾???쒓린媛 痢?議곌컖怨?suffix ?ъ씠???볦씤 ?뺤떇???볦튇??\r\n    const suffixIndex = rows.findIndex(\r\n      (candidate, candidateIndex) =>\r\n        candidateIndex > index &&\r\n        candidate.segments.some(\r\n          (segment) =>\r\n            segment.compact === '?? &&\r\n            fragment !== undefined &&\r\n            Math.abs(fragment.x - segment.x) <= 1,\r\n        ),\r\n    )\r\n    const suffix =\r\n      suffixIndex >= 0\r\n        ? rows[suffixIndex].segments.find((segment) => segment.compact === '??)\r\n        : undefined\r\n    if (\r\n      fragment === undefined ||\r\n      suffix === undefined ||\r\n      Math.abs(fragment.x - suffix.x) > 1\r\n    ) {\r\n      return\r\n    }\r\n\r\n    const label = `${fragment.compact}??\r\n    if (!STORY_PATTERN.test(label) || seen.has(suffixIndex)) return\r\n    result.push({ label, row })\r\n    seen.add(index)\r\n    seen.add(suffixIndex)\r\n  })\r\n\r\n  return result.sort((left, right) => left.row.y - right.row.y)\r\n}\r\n\r\n/**\r\n * 弱뤸쥈쨌?겻릎歟겶룟읃鹽?由ъ뒪?몃뒗 諛섏쁺 ??곸씠 ?꾨땲??(ADR-005). 罹≪쿂(listKind)??\n * ?뚦읃鹽롦쥈?ゃ궧?덀띿뿉???뚧쥈?ゃ궧?덀띾줈 ?섎━誘濡???댄? ?먮Ц??蹂몃떎.\r\n * ?꾨낫 遺꾨쪟? ?몄떇 ?ㅽ뙣 ?덈궡媛 媛숈? ?먯젙??遊먯빞 ?쒕떎 ???쒖そ留?怨좎튂硫?\n * ?뚰썑蹂대뒗 野얕괌鸚뽰씤???ㅽ뙣 ?덈궡???щ떎?띾줈 議곗슜??媛덈씪吏꾨떎\r\n */\r\nfunction isOutOfScopeList(titleText: string): boolean {\r\n  return /弱뤸쥈|?겻릎歟??븀쨴|?뉑똻歟??뉑똻?밤꺀???먨쑇??.test(titleText)\r\n}\r\n\r\nfunction kindFromMark(mark: string, titleText: string): SectionCandidate['kind'] {\r\n  if (isOutOfScopeList(titleText)) return '野얕괌鸚?\r\n  // C1 怨꾩뿴? 痢??묐몢(2C1, B1C1)源뚯? ?덉슜?섎릺, FC1 媛숈? ?븀쨴??遺?몃뒗\r\n  // 湲곗〈 踰붿쐞 ?먯젙泥섎읆 ?긷숃짒濡??밴꺽?섏? ?딅뒗??\r\n  if (/^(?:C\\d|\\d+C\\d|[A-EG-Z]\\d+C\\d)/i.test(mark)) return '??\r\n  // 鸚㎪쥈? ?덉슜??痢??묐몢留?踰쀪릿 ??G濡??쒖옉?섎뒗 遺?몃떎. FG1쨌FCG1泥섎읆\r\n  // 遺??以묎컙??G媛 ?덈뒗 ?븀쨴楹?遺?몃? 鸚㎪쥈?쇰줈 ?밴꺽?섏? ?딅뒗??\r\n  const markWithoutStoryPrefix = mark.replace(/^(?:R|\\d+|B\\d*)/i, '')\r\n  if (/^G/i.test(markWithoutStoryPrefix)) return '鸚㎪쥈'\r\n  return '野얕괌鸚?\r\n}\r\n\r\nfunction median(values: number[]): number {\r\n  if (values.length === 0) return 1\r\n  const sorted = [...values].sort((left, right) => left - right)\r\n  return sorted[Math.floor(sorted.length / 2)]\r\n}\r\n\r\nfunction positionColumns(row: TextRow, marks: MarkColumn[]): PositionColumn[] {\r\n  const label = exactLabel(row, ['鵝띸쉰'])\r\n  if (!label || marks.length === 0) return []\r\n\r\n  // 寧?뤇?삠꺂?믦쨭?겹겗寧?뤇?멨콝?뗣걮?╉굚?곦퐤營?닓??돯壤볟뜕鵝띲겘?잍뻼?삠꺂??겲?얇?\n  // 6寧?뤇???쀣겦 DP ?ユ륫?쇻겏令뷴닓???ㅴ퐳?듽곩ㅳ굮 FG2/FG4/FB ?ャ걽?묈칱?쎼겍\r\n  // FG1/FG3 ??말嶺뗣굮?εㅳ겏?쀣겍?긱걝?잆굙?곩릪??groupKey ?믢??쀣겓?삠걲??\n  const markGroups = marks.filter(\r\n    (mark, index) =>\r\n      marks.findIndex((candidate) => candidate.groupKey === mark.groupKey) ===\r\n      index,\r\n  )\r\n\r\n  const positions = row.segments\r\n    .filter((segment) => segment.centerX > label.endX)\r\n    .map((segment) => ({\r\n      label: segment.compact,\r\n      rawLabel: segment.text,\r\n      centerX: segment.centerX,\r\n    }))\r\n    .filter((position) => position.label.length > 0)\r\n\r\n  if (positions.length === 0) return []\r\n\r\n  const spacings = positions\r\n    .slice(1)\r\n    .map((position, index) => position.centerX - positions[index].centerX)\r\n    .filter((spacing) => spacing > 0)\r\n  const emptyPenalty = Math.pow(median(spacings) * 0.75, 2)\r\n  const costs = Array.from({ length: markGroups.length + 1 }, () =>\r\n    Array<number>(positions.length + 1).fill(Number.POSITIVE_INFINITY),\r\n  )\r\n  const choices = Array.from({ length: markGroups.length + 1 }, () =>\r\n    Array<number>(positions.length + 1).fill(0),\r\n  )\r\n  costs[0][0] = 0\r\n\r\n  for (let markIndex = 0; markIndex < markGroups.length; markIndex += 1) {\r\n    for (let used = 0; used <= positions.length; used += 1) {\r\n      if (!Number.isFinite(costs[markIndex][used])) continue\r\n      for (let count = 0; used + count <= positions.length; count += 1) {\r\n        const group = positions.slice(used, used + count)\r\n        const mean =\r\n          count === 0\r\n            ? markGroups[markIndex].centerX\r\n            : group.reduce((total, position) => total + position.centerX, 0) /\r\n              count\r\n        const spread =\r\n          count === 0\r\n            ? 0\r\n            : group.reduce(\r\n                (total, position) => total + Math.pow(position.centerX - mean, 2),\r\n                0,\r\n              ) / count\r\n        const groupCost =\r\n          count === 0\r\n            ? emptyPenalty\r\n            : Math.pow(mean - markGroups[markIndex].centerX, 2) + spread * 0.1\r\n        const nextCost = costs[markIndex][used] + groupCost\r\n        if (nextCost < costs[markIndex + 1][used + count]) {\r\n          costs[markIndex + 1][used + count] = nextCost\r\n          choices[markIndex + 1][used + count] = count\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  const counts = Array<number>(markGroups.length).fill(0)\r\n  let used = positions.length\r\n  for (let markIndex = markGroups.length; markIndex > 0; markIndex -= 1) {\r\n    const count = choices[markIndex][used]\r\n    counts[markIndex - 1] = count\r\n    used -= count\r\n  }\r\n\r\n  const result: PositionColumn[] = []\r\n  let positionIndex = 0\r\n  counts.forEach((count, markIndex) => {\r\n    for (let index = 0; index < count; index += 1) {\r\n      const position = positions[positionIndex]\r\n      result.push({ ...position, mark: markGroups[markIndex].mark })\r\n      positionIndex += 1\r\n    }\r\n  })\r\n  return result\r\n}\r\n\r\nfunction dataSegments(row: TextRow, aliases: readonly string[]): TextSegment[] {\r\n  const label = exactLabel(row, aliases)\r\n  if (!label) return []\r\n  const normalizedAliases = aliases.map(compact)\r\n  const inlineSegments = row.segments.flatMap((segment) => {\r\n    const alias = normalizedAliases.find(\r\n      (candidate) =>\r\n        segment.compact.startsWith(candidate) &&\r\n        segment.compact.length > candidate.length,\r\n    )\r\n    if (!alias) return []\r\n    const value = segment.compact.slice(alias.length)\r\n    return [{ source: segment, value: { ...segment, text: value, compact: value } }]\r\n  })\r\n  return [\r\n    ...row.segments\r\n      .filter((segment) => segment.centerX > label.endX)\r\n      .filter(\r\n        (segment) => !inlineSegments.some(({ source }) => source === segment),\r\n      ),\r\n    ...inlineSegments.map(({ value }) => value),\r\n  ]\r\n}\r\n\r\nfunction isDimensionRow(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n  marks: MarkColumn[],\r\n): boolean {\r\n  const label = exactLabel(row, aliases)\r\n  const cells = dataSegments(row, aliases)\r\n  if (label === undefined || cells.length === 0) return false\r\n\r\n  // ?꾨㈃ ?ㅻⅨ履쎌쓽 ?⑤㈃?꽷룹쿋怨??쒓? 媛숈? y?됱뿉 嫄몄퀜 ?덉뼱?? ?꾩옱 遺???댁쓽\r\n  // 嫄곕━ ?곹븳 ?덉뿉??諛곗젙?섎뒗 ?留???씊 ?됱쓽 媛믪쑝濡?蹂몃떎. ?대? ?앸왂?섎㈃\r\n  // ?똁.PL-36*460*460??媛숈? ?ㅻⅨ ?꾨㈃??移섏닔媛 ???됱쑝濡??ㅼ씤?섏뼱 痢?釉붾줉??\n  // 以묐났?쇰줈 ?먯젙?쒕떎.\r\n  const targets = [\r\n    ...new Map(\r\n      marks.map(({ groupKey, centerX }) => [groupKey, { id: groupKey, centerX }]),\r\n    ).values(),\r\n  ]\r\n  const scopedCells = [...valuesAtTargets(cells, targets).values()]\r\n  if (scopedCells.length === 0) return false\r\n\r\n  // ?뚧뼪?㏂띿? ?ㅼ?移섏쓽 ?쒕ぉ?쇰줈???곗씤?? ?ㅼ젣 ?⑤㈃ ?됱? 寧?뤇 ???섎쭔??\n  // ???媛吏吏留? ?ㅼ?移섏쓽 X/Y쨌?답벡歟??쒓린???쇰? ?留?媛吏誘濡?洹??됱쓣\r\n  // ??씊 ?곗씠?곕줈 ?몄? ?딅뒗?? 媛??먯껜媛 遺덈챸?뺥빐???먮Ц??raw濡?蹂댁〈?댁빞\r\n  // ?섎?濡? ???먯젙? 媛믪쓽 ?뚯떛 ?깃났 ?щ?? 遺꾨━?쒕떎.\r\n  if (label.compact !== '??씊') return true\r\n  return (\r\n    scopedCells.some(\r\n      (cell) =>\r\n        parseDimension(cell) !== undefined ||\r\n        parseCircularDimension(cell) !== undefined,\r\n    ) || scopedCells.length >= targets.length\r\n  )\r\n}\r\n\r\nfunction valuesAtTargets(\r\n  segments: TextSegment[],\r\n  targets: Array<{ id: string; centerX: number }>,\r\n): Map<string, string> {\r\n  const assigned = new Map<string, TextSegment[]>()\r\n  if (targets.length === 0) return new Map()\r\n  const bounded = boundedAnchors(targets)\r\n\r\n  for (const segment of segments) {\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    // ??媛꾧꺽???섏뼱 ?⑥뼱吏??멸렇癒쇳듃?????쒖쓽 移몄씠 ?꾨땲?? ?ㅻⅨ履????댁? ??\n    // 諛붽묑??湲?먮? ?꾨? ?쇳궓?????쒖젣????쒖? 媛숈? ?됱뿉 嫄몄튂硫???-D22?띻?\r\n    // ??-D22訝榮싧뻠影됧＋雅뗥떃??╉띻? ?섏뼱 ?뺤젙?대뜕 移몄씠 鰲ｉ뇠訝띹꺗?쇰줈 ?ㅼ쭛?뚮떎\r\n    // (?ㅻЪ ojkk p3 G5/2F). ?댁씠 ?섎굹肉먯씠硫??곹븳???녿떎(limit=Infinity)\r\n    if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n    const existing = assigned.get(target.id) ?? []\r\n    existing.push(segment)\r\n    assigned.set(target.id, existing)\r\n  }\r\n\r\n  return new Map(\r\n    [...assigned.entries()].map(([id, targetSegments]) => [\r\n      id,\r\n      targetSegments\r\n        .sort((left, right) => left.x - right.x)\r\n        .map((segment) => segment.text)\r\n        .join(''),\r\n    ]),\r\n  )\r\n}\r\n\r\nfunction valuesByMark(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  const groups = [...new Map(\r\n    marks.map(({ groupKey, centerX }) => [groupKey, { id: groupKey, centerX }]),\r\n  ).values()]\r\n  const values = valuesAtTargets(\r\n    dataSegments(row, aliases),\r\n    groups,\r\n  )\r\n  return new Map(\r\n    marks.flatMap(({ mark, groupKey }) => {\r\n      const value = values.get(groupKey)\r\n      return value === undefined ? [] : [[mark, value] as const]\r\n    }),\r\n  )\r\n}\r\n\r\nfunction segmentsByMark(\r\n  segments: TextSegment[],\r\n  marks: MarkColumn[],\r\n): Map<string, TextSegment[]> {\r\n  const grouped = new Map<string, TextSegment[]>()\r\n  if (marks.length === 0) return grouped\r\n\r\n  for (const segment of segments) {\r\n    const target = marks.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    const existing = grouped.get(target.mark) ?? []\r\n    existing.push(segment)\r\n    grouped.set(target.mark, existing)\r\n  }\r\n  return grouped\r\n}\r\n\r\n/**\r\n * 鵝띸쉰蹂?? 媛믪쓣 鵝띸쉰 ?몃뜳?ㅻ줈 ?섎룎由곕떎. 鵝띸쉰 ?댁쓣 ?섎굹??諛곗젙諛쏆? 紐삵븳 寧?뤇????\r\n * 諛곗젙 ??곸뿉??類????洹몃?濡??먮㈃ 洹????理쒓렐??鵝띸쉰(??寧?뤇??????遺숈뼱 ?⑥쓽 媛믪쓣\r\n * ?ㅼ뿼?쒗궓?? 鍮좎쭊 寧?뤇? valuesByMark濡??곕줈 ?쎈뒗??\r\n *\r\n * 寧?뤇 ???쑝濡?癒쇱? 媛瑜댁????딅뒗?? ?ㅻЪ ?꾨㈃(yokohama G54)?먯꽌 寧?뤇 ?ㅻ뜑 以묒떖??\n * ??寃쎄퀎? ?닿툔???댁썐 ??媛믪씠 ????덉쑝濡??ㅼ뼱?ㅻ뒗 寃쎌슦媛 ?덉뼱, ????곗꽑 諛곗젙?\r\n * 鵝띸쉰瑜?媛吏?寧?뤇???源뚯? 萸됯컿??\r\n */\r\nfunction valuesByPosition(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n  positions: PositionColumn[],\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  const positionless = new Set(\r\n    marks\r\n      .filter(({ mark }) => !positions.some((position) => position.mark === mark))\r\n      .map(({ mark }) => mark),\r\n  )\r\n  const segments = dataSegments(row, aliases)\r\n  const assignable =\r\n    positionless.size === 0\r\n      ? segments\r\n      : [...segmentsByMark(segments, marks)]\r\n          .filter(([mark]) => !positionless.has(mark))\r\n          .flatMap(([, group]) => group)\r\n\r\n  return valuesAtTargets(\r\n    assignable,\r\n    positions.map((position, index) => ({\r\n      id: String(index),\r\n      centerX: position.centerX,\r\n    })),\r\n  )\r\n}\r\n\r\n/** ?꾪봽 ?뺤긽 湲고샇(?≤룐뼡쨌?┑룐뼢)? ?댁쓬 ?섏씠????? 癒몃━???μ떇留?踰쀪릿?? */\r\nfunction stripDecoration(value: string): string {\r\n  return compact(value).replace(/^[-?△뼡?╈뼢?잂뒢]+/, '')\r\n}\r\n\r\nfunction decorationPrefix(value: string): string | undefined {\r\n  return compact(value).match(/^([?△뼡?╈뼢?잂뒢]+)/)?.[1]\r\n}\r\n\r\nfunction isTwoLayerBar(value: string): boolean {\r\n  const match = stripDecoration(value).match(/^\\d+\\/\\d+-?(D\\d+)$/i)\r\n  return match !== null && barSizes.has(match[1].toUpperCase() as BarSize)\r\n}\r\n\r\nfunction parseBar(value: string): ParsedBar | undefined {\r\n  // parsePitch? 媛숈? 洹쒖빟: ?μ떇??踰쀪릿 ? ?꾩껜媛 ?⑥씪 ?뚧쑍??孃꾠띿씪 ?뚮쭔 ?뺤젙?쒕떎 ??\n  // 蹂듭닔 ?쒓린(??-D25+2-D22???? ?〓Ц?먭? 遺숈? ??0016-D25?띾룄 鍮덉뭏+?먮Ц 寃쎈줈濡?蹂대궦??\n  const match = stripDecoration(value).match(/^(\\d+)-?(D\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[2].toUpperCase() as BarSize\r\n  if (!barSizes.has(size)) return undefined\r\n  const count = Number(match[1])\r\n  // ?ф빊 3?먮━???몄젒 移섏닔???レ옄媛 遺숈? ? 蹂묓빀 ?붿옱(??0016-D25???닿퀬,\r\n  // 0蹂몄? 臾쇰웾 0??遺?щ? 留뚮뱺?????대뒓 履쎈룄 ?뺤젙?섏? ?딅뒗??\n  return count > 99 || count <= 0 ? undefined : { count, size }\r\n}\r\n\r\nfunction parsePitch(\r\n  value: string,\r\n): { size: ShearBarSize; pitchMm: number } | undefined {\r\n  // ? ?꾩껜媛 ?⑥씪 ?뚦푶@?붵긿?곥띿씪 ?뚮쭔 梨꾪깮?쒕떎 ??遺遺?留ㅼ튂瑜??덉슜?섎㈃\r\n  // 永꾣빊 ?묐몢????-D13@100??媛 議곗슜???⑥뼱??1永꾨줈 ?덈컲 怨꾩긽?쒕떎.\r\n  // ?쇈겞?띿쓽 ?묐몢 ?곷Ц?먮? D濡??쒖젙?섏? ?딅뒗 寃껋? 遙섇섭佯╉걵?볠뼪獒쒎섭嶺??뚮Ц?닿퀬,\r\n  // 紐⑸줉???녿뒗 ?쇈겞?띿? ?꾨옒 吏묓빀 寃?ъ뿉??鍮덉뭏+?먮Ц?쇰줈 ?⑥뼱吏꾨떎 (R10)\r\n  const match = stripDecoration(value).match(\r\n    /^([A-Z]\\d+(?:\\.\\d+)?)(?:-?@([\\d,]+)|-?([\\d,]+)@)$/i,\r\n  )\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as ShearBarSize\r\n  if (!shearBarSizes.has(size)) return undefined\r\n  const pitchText = match[2] ?? match[3]\r\n  const pitchMm = Number(pitchText.replace(/,/g, ''))\r\n  // ?쇳몴媛 ?덈뒗 ???먮━ ?쇱튂??紐낆떆?곸씤 ?먮┸??援щ텇(?? 1,000)?대떎. ?쇳몴 ?녿뒗\r\n  // ???먮━ 媛믪? 湲곗〈怨?媛숈씠 ?몄젒 ?멸렇癒쇳듃媛 遺숈? ?붿옱濡?蹂댁븘 ?뺤젙?섏? ?딅뒗??\r\n  if (pitchMm <= 0 || (pitchMm > 999 && !pitchText.includes(','))) return undefined\r\n  return { size, pitchMm }\r\n}\r\n\r\n/**\r\n * compact???배쮼瑜???.?띾????쒖감??踰덊샇?대줈 癒쇱? 媛瑜몃떎. ?レ옄媛 ?쇱튂??遺숈뼱\r\n * ??5002.?띻? ?섏뼱???ㅼ쓬 踰덊샇媛 2?쇰뒗 ?ъ떎???ㅻⅨ履?寃쎄퀎瑜?利앸챸?쒕떎.\r\n * 踰덊샇?댁씠 ?놁쑝硫??쒖젣 ?꾩껜媛 ????ぉ?대ŉ, 鍮???ぉ? 踰덊샇?댁쓽 利앸챸???꾨땲誘濡?\n * 遺꾨━?섏? ?딅뒗??\r\n */\r\nfunction sequentialTitleItems(titleText: string): string[] {\r\n  const text = compact(titleText)\r\n  const firstMarker = text.indexOf('1.')\r\n  if (firstMarker < 0) return [text]\r\n\r\n  const items: string[] = []\r\n  let itemStart = firstMarker + '1.'.length\r\n  let nextNumber = 2\r\n\r\n  while (true) {\r\n    const marker = `${nextNumber}.`\r\n    const boundary = text.indexOf(marker, itemStart)\r\n    if (boundary < 0) {\r\n      const lastItem = text.slice(itemStart)\r\n      return lastItem.length > 0 ? [...items, lastItem] : [text]\r\n    }\r\n\r\n    const item = text.slice(itemStart, boundary)\r\n    const nextStart = boundary + marker.length\r\n    if (item.length === 0 || nextStart >= text.length) return [text]\r\n\r\n    items.push(item)\r\n    itemStart = nextStart\r\n    nextNumber += 1\r\n  }\r\n}\r\n\r\nfunction widthTieFromTitle(\r\n  titleText: string,\r\n): { value?: SectionCandidate['widthTie']; raw?: string } | undefined {\r\n  const item = sequentialTitleItems(titleText).find((candidate) =>\r\n    /(?:亮?藥?閭??:???嶺?.test(candidate),\r\n  )\r\n  if (!item) return undefined\r\n\r\n  const label = item.match(/(?:亮?藥?閭??:???嶺?)\r\n  if (!label || label.index === undefined) return undefined\r\n\r\n  const raw = item.slice(label.index)\r\n  // ??ぉ 寃쎄퀎瑜?利앸챸???ㅼ뿉???먮┸?섎줈 ?쇱튂 ?앹쓣 異붿륫?섏? ?딅뒗?? 亮끾??곭춮 ??ぉ\r\n  // ?꾩껜媛 ??臾몃쾿???뚮쭔 ?뺤젙?섍퀬, ?ㅼ뿉 ?ㅻⅨ ?배쮼媛 遺숈쑝硫?raw 寃쎈줈濡?蹂대궦??\r\n  const match = raw.match(\r\n    /^(?:亮?藥?閭??:???嶺??:???([A-Z]\\d+(?:\\.\\d+)?)-?@(\\d+)(?:?ⓦ걲???[??]*$/i,\r\n  )\r\n  if (!match) return { raw }\r\n\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  if (!barSizes.has(size) || pitchMm <= 0) return { raw }\r\n\r\n  return {\r\n    value: { size, pitchMm },\r\n  }\r\n}\r\n\r\n// 4?먮━ 珥덇낵??? 蹂묓빀 ?붿옱, ???먮━???뚯닔 ?쒓린(??.8횞0.8?띯넂8횞0)???붿옱????\n// ?대뒓 履쎈룄 ?뺤젙?섏? ?딅뒗??\nfunction inDimensionRange(b: number, depth: number): boolean {\r\n  return b >= 10 && b <= 9999 && depth >= 10 && depth <= 9999\r\n}\r\n\r\n/**\r\n * ?녶숱??씊???00??띲궾녴꺕過?삠렂烏②쮼??굞?뚣걽?묆굮誤뗣굥 ???겼ㅳ겛?ⓦ겇?졼걨??\n * ?삠꺂竊덀궧?긱긿?곥겗野멩퀡渶싷펹??냶?②き?얇겒?꾠귞쎍孃꾥쮼?룔걣?귙굥?볝겏?뚧졊?졼겎?귙굥??\n */\r\nfunction parseCircularDimension(value: string): { diameter: number } | undefined {\r\n  const match = normalized(value).match(/^(\\d[\\d,]*)\\s*[?過]$|^[?過]\\s*(\\d[\\d,]*)$/)\r\n  if (!match) return undefined\r\n  const diameter = Number((match[1] ?? match[2]).replace(/,/g, ''))\r\n  return inDimensionRange(diameter, diameter) ? { diameter } : undefined\r\n}\r\n\r\nfunction parseDimension(value: string): { b: number; depth: number } | undefined {\r\n  // ?댁썐 ???遺숈? ??00횞800 900횞900?띿뿉??泥?留ㅼ튂瑜?痍⑦븯硫???踰덉㎏ 洹몃９??\n  // 怨듬갚 ?덈㉧ ?レ옄源뚯? ?쇱폒 b=800쨌depth=800900???쒕떎 ???ㅼ쨷 留ㅼ튂??嫄곕??쒕떎\r\n  const matches = [\r\n    ...normalized(value).matchAll(/[\\d,]+\\s*[x횞*]\\s*[\\d,]+/gi),\r\n  ]\r\n  if (matches.length !== 1) return undefined\r\n  const [bText, depthText] = matches[0][0].split(/[x횞*]/i)\r\n  const b = Number(bText.replace(/,/g, '').trim())\r\n  const depth = Number(depthText.replace(/,/g, '').trim())\r\n  return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n}\r\n\r\n/**\r\n * ?ㅼ?移섏뿉 遺숈? 媛濡쑣룹꽭濡?移섏닔瑜?吏앹???b횞d瑜??쎈뒗?? ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖뿉?쒕뒗\r\n * ???섏씠 ?좎씪??洹쇨굅?? ?쒖そ留뚯쑝濡쒕뒗 ?뺤젙?섏? ?딅뒗?????⑤룆 ?レ옄瑜??뺤궗媛곹삎?쇰줈\r\n * ?밴꺽?섎뒗 寃껋? ?꾨㈃???녿뒗 媛믪쓣 留뚮뱶??寃껋씠??\r\n */\r\nfunction pairedDimension(\r\n  horizontal: string,\r\n  vertical: string,\r\n): { b: number; depth: number } | undefined {\r\n  if (!/^\\d+$/.test(horizontal) || !/^\\d+$/.test(vertical)) return undefined\r\n  const b = Number(horizontal)\r\n  const depth = Number(vertical)\r\n  return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n}\r\n\r\n/**\r\n * ?뺤젙?섏? 紐삵븳 ????④린???먮Ц 李멸퀬 ?쒖떆. 癒몃━???μ떇留?踰쀪린怨??섎㉧吏??洹몃?濡?\n * ?붾떎 ???좏겙留?戮묒븘 以꾩씠硫???-D13@100?띿쓽 @100泥섎읆 ?먮Ц ?뺣낫媛 ?щ씪吏꾨떎.\r\n *\r\n * ?μ떇留뚯쑝濡??대（?댁쭊 ?? 踰쀪린硫?鍮?臾몄옄?댁씠 ?섎?濡??섏궡由곕떎. ?뚢뺛띾뒗 ?뚰빐???놁쓬?띿쓣\r\n * ?삵븯??媛믪씤??yokohama p13 ?밭춮 ??, 鍮덉뭏?쇰줈 ?대낫?대㈃ ?붾㈃?먯꽌 ?뚯씫吏 紐삵븳 ??띻낵\r\n * 援щ퀎?섏? ?딅뒗??\r\n */\r\nfunction cleanedRebarRaw(value: string): string {\r\n  return stripDecoration(value) || compact(value)\r\n}\r\n\r\nfunction addIssue(candidate: SectionCandidate, issue: CandidateIssue): void {\r\n  if (!candidate.issues.includes(issue)) candidate.issues.push(issue)\r\n}\r\n\r\nfunction setDimension(\r\n  candidate: SectionCandidate,\r\n  value: string | undefined,\r\n  column: boolean,\r\n  vertical?: string,\r\n): void {\r\n  if (!value) {\r\n    // ?몃줈留??쏀엺 移몃룄 ?먮Ц???④릿????議곗슜??踰꾨━硫??ъ슜?먮뒗 ????씊??鍮꾩뿀?붿?\r\n    // ?????녿떎. ?뺤젙?섏? 紐삵븳 移몄? 鍮덉뭏+?먮Ц 李멸퀬媛 ???뚯꽌??洹쒖빟?대떎\r\n    if (vertical !== undefined) {\r\n      candidate.raw['??씊'] = compact(vertical)\r\n      addIssue(candidate, '??씊?⒴숱訝띷닇塋?)\r\n    }\r\n    return\r\n  }\r\n  // ?녶숱??윶?ャ걮?뗣겒?꾠귛ㄷ歟곥겗??씊轝꾠겓??뚧씎?잆굢?앫굦??き?욥걬?덀겒??겎閻뷴츣?쀣겒?꾠?\n  const circular = column ? parseCircularDimension(value) : undefined\r\n  if (circular) {\r\n    candidate.shape = '?녶숱'\r\n    candidate.b = circular.diameter\r\n    candidate.d = circular.diameter\r\n    return\r\n  }\r\n\r\n  const parsed =\r\n    parseDimension(value) ??\r\n    (vertical !== undefined ? pairedDimension(value, vertical) : undefined)\r\n  if (parsed) {\r\n    if (column) candidate.shape = '?⒴숱'\r\n    candidate.b = parsed.b\r\n    if (column) candidate.d = parsed.depth\r\n    else candidate.depth = parsed.depth\r\n    return\r\n  }\r\n\r\n  // ?⑤룆 ?レ옄??b횞d濡??뺤젙?????녿떎 ???ㅼ?移?移섏닔???レ옄瑜??뺤궗媛곹삎?쇰줈\r\n  // ?밴꺽?섎㈃ 媛믪쓣 吏?대궡??寃껋씠 ?쒕떎 (ADR-012 怨꾩뿴). 鍮덉뭏+?먮Ц?쇰줈 ?④릿??\r\n  // ?몃줈???쎌뿀?붾뜲 吏앹쭞湲?pairedDimension)媛 嫄곕???寃쎌슦, 媛濡쒕쭔 ?④린硫?\n  // ?먮Ц ?몃줈媛믪씠 議곗슜???щ씪吏꾨떎 ???④퍡 ?④릿??\n  candidate.raw['??씊'] = compact(value)\r\n  if (vertical !== undefined) candidate.raw['??씊(潁?'] = compact(vertical)\r\n  addIssue(candidate, '??씊?⒴숱訝띷닇塋?)\r\n}\r\n\r\nfunction setColumnMain(\r\n  candidate: SectionCandidate,\r\n  cells: Array<{ position?: string; raw: string }>,\r\n  expectedCellCount: number,\r\n): void {\r\n  if (cells.length === 0) return\r\n  const parsed = cells.map(({ raw }) => parseBar(raw))\r\n  const allParsed = parsed.every((entry): entry is ParsedBar => entry !== undefined)\r\n  const allEqual =\r\n    allParsed &&\r\n    parsed.every(\r\n      (entry) => entry.count === parsed[0].count && entry.size === parsed[0].size,\r\n    )\r\n  const complete =\r\n    expectedCellCount === 0 || cells.length === expectedCellCount\r\n\r\n  if (allEqual && complete) {\r\n    candidate.main = parsed[0]\r\n    return\r\n  }\r\n\r\n  for (const cell of cells) {\r\n    const key = cell.position ? `訝사춮(${cell.position})` : '訝사춮'\r\n    candidate.raw[key] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  addIssue(\r\n    candidate,\r\n    !allParsed\r\n      ? cells.some(({ raw }) => isTwoLayerBar(raw))\r\n        ? '2餘든춮?ゅ?恙?\r\n        : '訝사춮鰲ｉ뇠訝띹꺗'\r\n      : !complete\r\n        ? '訝사춮鵝띸쉰轝좄맼'\r\n        : '訝사춮鵝띸쉰?면걬',\r\n  )\r\n}\r\n\r\n/**\r\n * 鵝띸쉰轝꾠겗?⒲깧?ャ걣?뉎걲?븅뼋?귙똜3塋?띲뚦쨼塋?띲겗?덀걝?ラ싥굤??릫?꾢릲?띲걣餓섅걦烏ⓦ굚?귙굥?뚣?\n * ?ュ갼??뚨ク?띲걣塋?깿?믤뙁?쇻겗??뀻?싥걲?뗣귟き?곥겒?꾠꺀?쇻꺂??undefined ?ャ걮?╉?\n * 塋?깿?삡릎鸚?겓沃?겳?욍걟?ゃ걚 ??沃?겳?욍걟?뚣겙?녜씊?ャ겒?꾣뼪?㏂굮鵝쒌굥??\n */\r\nfunction positionZone(label: string): '塋?깿' | '訝?ㄾ' | undefined {\r\n  const normalizedLabel = compact(label)\r\n  if (normalizedLabel.includes('訝?ㄾ')) return '訝?ㄾ'\r\n  if (normalizedLabel.includes('塋?)) return '塋?깿'\r\n  return undefined\r\n}\r\n\r\nfunction isThreePositionLayout(\r\n  cells: Array<{ position: string }>,\r\n): boolean {\r\n  const zones = cells.map(({ position }) => positionZone(position))\r\n  return (\r\n    cells.length === 3 &&\r\n    zones[0] === '塋?깿' &&\r\n    zones[1] === '訝?ㄾ' &&\r\n    zones[2] === '塋?깿'\r\n  )\r\n}\r\n\r\nfunction uniqueCount(bars: ParsedBar[]): number | undefined {\r\n  const first = bars[0]\r\n  if (first === undefined) return undefined\r\n  return bars.every((bar) => bar.count === first.count)\r\n    ? first.count\r\n    : undefined\r\n}\r\n\r\n/**\r\n * 鵝띸쉰?㎪쑍?겹굮?녴걨?╉걚?뗨〃?믡곭ク?ⓩ쵂?ⓧ릎鸚?쵂????ⓦ걮??き???\n *\r\n * ?똜3塋?폀Y4塋?띲겗?덀걝?ヤ륫塋?걣?뺛걝訝됪쵂烏ⓦ겘?곦퐤營?꺀?쇻꺂?ⓨ랩?녈겗?ф빊??\n * ?앫겗?얇겲?숃짒?ヨ펹?쎼굥?귚틠轝꾠겗塋?깿?삡릎鸚?〃??풏?γ겑?듽굤?섆???ク?ⓩ쑍?겹겓\r\n * ?녈겳渦쇈??귛푶??뀲轝꾠겎訝?ㅳ겓?껁겂?╉걚?뗨〃?졼걨?믥▶若싥걲?뗣?\n */\r\nfunction positionalGirderMain(\r\n  cells: Array<{ position: string; rawPosition?: string }>,\r\n  top: ParsedBar[],\r\n  bottom: ParsedBar[],\r\n):\r\n  | { girderMain: NonNullable<SectionCandidate['girderMain']> }\r\n  | {\r\n      girderMainAsymmetric: NonNullable<\r\n        SectionCandidate['girderMainAsymmetric']\r\n      >\r\n    }\r\n  | { issue: CandidateIssue }\r\n  | undefined {\r\n  const zones = cells.map(({ position }) => positionZone(position))\r\n  if (zones.some((zone) => zone === undefined)) return undefined\r\n\r\n  // 藥?ク?삡릎鸚?꺕?녕ク??툒轝꾠겎?ゃ걚烏ⓦ겘?곩랩?녜씆野양㎞??ク?ⓦ겏?쀣겍?띹㎗?덀걮?ゃ걚??\n  // 塋?깿?삡릎鸚?겗雅뚧쵂??풏?γ겑?듽굤?곩뜕訝??ク?ⓩ쑍?겹겏?쀣겍?긱걝??\n  const asymmetricLayout = isThreePositionLayout(cells)\r\n  if (cells.length === 3 && !asymmetricLayout) return undefined\r\n\r\n  const pick = (bars: ParsedBar[], zone: '塋?깿' | '訝?ㄾ') =>\r\n    bars.filter((_, index) => zones[index] === zone)\r\n  const endTop = pick(top, '塋?깿')\r\n  const endBottom = pick(bottom, '塋?깿')\r\n  const centerTopCount = uniqueCount(pick(top, '訝?ㄾ'))\r\n  const centerBottomCount = uniqueCount(pick(bottom, '訝?ㄾ'))\r\n  if (\r\n    centerTopCount === undefined ||\r\n    centerBottomCount === undefined ||\r\n    endTop.length === 0 ||\r\n    endBottom.length === 0\r\n  ) {\r\n    if (\r\n      endTop.length > 0 &&\r\n      uniqueCount(endTop) === undefined &&\r\n      !asymmetricLayout\r\n    ) {\r\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\r\n    }\r\n    if (\r\n      endBottom.length > 0 &&\r\n      uniqueCount(endBottom) === undefined &&\r\n      !asymmetricLayout\r\n    ) {\r\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\r\n    }\r\n    return undefined\r\n  }\r\n\r\n  const size = top[0]?.size\r\n  if (size === undefined) return undefined\r\n  if (![...top, ...bottom].every((bar) => bar.size === size)) return undefined\r\n\r\n  if (!asymmetricLayout) {\r\n    const endTopCount = uniqueCount(endTop)\r\n    const endBottomCount = uniqueCount(endBottom)\r\n    if (endTopCount === undefined || endBottomCount === undefined) {\r\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\r\n    }\r\n    return {\r\n      girderMain: {\r\n        size,\r\n        topCount: centerTopCount,\r\n        bottomCount: centerBottomCount,\r\n        endTopCount,\r\n        endBottomCount,\r\n      },\r\n    }\r\n  }\r\n\r\n  const endTopCounts = [top[0]?.count, top[2]?.count] as const\r\n  const endBottomCounts = [bottom[0]?.count, bottom[2]?.count] as const\r\n  if (\r\n    endTopCounts[0] === undefined ||\r\n    endTopCounts[1] === undefined ||\r\n    endBottomCounts[0] === undefined ||\r\n    endBottomCounts[1] === undefined\r\n  ) {\r\n    return undefined\r\n  }\r\n\r\n  const labels = [cells[0]?.position, cells[2]?.position] as const\r\n  if (labels[0] === undefined || labels[1] === undefined) return undefined\r\n\r\n  const asymmetric =\r\n    endTopCounts[0] !== endTopCounts[1] ||\r\n    endBottomCounts[0] !== endBottomCounts[1]\r\n  if (asymmetric) {\r\n    return {\r\n      girderMainAsymmetric: {\r\n        size,\r\n        labels: [labels[0], labels[1]],\r\n        topCounts: [endTopCounts[0], endTopCounts[1]],\r\n        bottomCounts: [endBottomCounts[0], endBottomCounts[1]],\r\n        topCenterCount: centerTopCount,\r\n        bottomCenterCount: centerBottomCount,\r\n      },\r\n    }\r\n  }\r\n\r\n  return {\r\n    girderMain: {\r\n      size,\r\n      topCount: centerTopCount,\r\n      bottomCount: centerBottomCount,\r\n      endTopCount: endTopCounts[0],\r\n      endBottomCount: endBottomCounts[0],\r\n    },\r\n  }\r\n}\r\n\r\nfunction setGirderMain(\r\n  candidate: SectionCandidate,\r\n  topLabel: string,\r\n  bottomLabel: string,\r\n  topCells: Array<{ position: string; rawPosition?: string; raw: string }>,\r\n  bottomCells: Array<{\r\n    position: string\r\n    rawPosition?: string\r\n    raw: string\r\n  }>,\r\n  expectedCellCount: number,\r\n): void {\r\n  if (topCells.length === 0 && bottomCells.length === 0) return\r\n  const top = topCells.map(({ raw }) => parseBar(raw))\r\n  const bottom = bottomCells.map(({ raw }) => parseBar(raw))\r\n  const allParsed = [...top, ...bottom].every(\r\n    (entry): entry is ParsedBar => entry !== undefined,\r\n  )\r\n  const complete =\r\n    top.length > 0 &&\r\n    bottom.length > 0 &&\r\n    (expectedCellCount === 0 ||\r\n      (top.length === expectedCellCount && bottom.length === expectedCellCount))\r\n  // 鵝띸쉰??洹좎씪?쒕뜲 訝듾툔 孃꾨쭔 ?ㅻⅨ(?ㅻТ?먯꽌 ?뷀븳) ????뚥퐤營?쎑?뺛띾줈 紐곕㈃\r\n  // ?ъ슜?먭? ?먯씤???ㅼ씤?쒕떎 ???꾩슜 ?ъ쑀 肄붾뱶濡?援щ텇?쒕떎\r\n  let sizeMismatch = false\r\n  let positionalIssue: CandidateIssue | undefined\r\n  if (complete && allParsed) {\r\n    const parsedTop = top as ParsedBar[]\r\n    const parsedBottom = bottom as ParsedBar[]\r\n    const firstTop = parsedTop[0]\r\n    const firstBottom = parsedBottom[0]\r\n    const topUniform =\r\n      firstTop !== undefined &&\r\n      parsedTop.every(\r\n        (entry) =>\r\n          entry.count === firstTop.count && entry.size === firstTop.size,\r\n      )\r\n    const bottomUniform =\r\n      firstBottom !== undefined &&\r\n      parsedBottom.every(\r\n        (entry) =>\r\n          entry.count === firstBottom.count && entry.size === firstBottom.size,\r\n      )\r\n\r\n    if (topUniform && bottomUniform && firstTop.size === firstBottom.size) {\r\n      candidate.girderMain = {\r\n        size: firstTop.size,\r\n        topCount: firstTop.count,\r\n        bottomCount: firstBottom.count,\r\n      }\r\n      return\r\n    }\r\n    sizeMismatch =\r\n      topUniform && bottomUniform && firstTop.size !== firstBottom.size\r\n\r\n    // 鵝띸쉰?㎪쑍?겹걣?녴걢?뚣걼烏ⓦ귚툓訝뗣겗鵝띸쉰轝꾠걣?껁겂?╉걚?뗨〃?졼걨?믣??ⓦ걮??き?\r\n    const aligned =\r\n      topCells.length === bottomCells.length &&\r\n      topCells.every(\r\n        (cell, index) => cell.position === bottomCells[index].position,\r\n      )\r\n    const positional = aligned\r\n      ? positionalGirderMain(topCells, parsedTop, parsedBottom)\r\n      : undefined\r\n    if (positional && 'girderMain' in positional) {\r\n      candidate.girderMain = positional.girderMain\r\n      return\r\n    }\r\n    if (positional && 'girderMainAsymmetric' in positional) {\r\n      candidate.girderMainAsymmetric = positional.girderMainAsymmetric\r\n      // step 2 ?꾩뿉?????꾨낫瑜?諛섏쁺?섏? ?딆?留? ?뺤젙???꾩튂蹂?媛믪쓣 ?붾㈃?먯꽌\r\n      // ?먮Ц怨??④퍡 ?議고븷 ???덉뼱???쒕떎. 媛??먯껜??蹂꾨룄 ?꾨뱶媛 ?뺣낯?대떎.\r\n      for (const cell of topCells) {\r\n        candidate.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n          cell.raw,\r\n        )\r\n      }\r\n      for (const cell of bottomCells) {\r\n        candidate.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n          cell.raw,\r\n        )\r\n      }\r\n      // 鍮꾨?移?媛믪? ???꾨뱶??蹂댁〈?덉?留? 諛⑺뼢???좏깮?섍린 ?꾩씤 ???④퀎?먯꽌??\n      // girderMain?쇰줈 諛섏쁺?????녿떎. 湲곗〈 痍⑥엯 ?붾㈃??李⑤떒 ?덈궡瑜??좎??쒕떎.\r\n      addIssue(candidate, '訝사춮塋?깿藥?뤂?면걬')\r\n      return\r\n    }\r\n    positionalIssue = positional?.issue\r\n  }\r\n\r\n  for (const cell of topCells) {\r\n    candidate.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  for (const cell of bottomCells) {\r\n    candidate.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  const twoLayerMain = [...topCells, ...bottomCells].some(({ raw }) =>\r\n    isTwoLayerBar(raw),\r\n  )\r\n  addIssue(\r\n    candidate,\r\n    positionalIssue ??\r\n      (sizeMismatch\r\n        ? '訝사춮訝듾툔孃꾤쎑??\r\n        : allParsed && complete\r\n          ? '訝사춮鵝띸쉰?면걬'\r\n          : !allParsed\r\n            ? twoLayerMain\r\n              ? '2餘든춮?ゅ?恙?\r\n              : '訝사춮鰲ｉ뇠訝띹꺗'\r\n            : '訝사춮鵝띸쉰轝좄맼'),\r\n  )\r\n}\r\n\r\nfunction setPitch(\r\n  candidate: SectionCandidate,\r\n  key: 'hoop' | 'stirrup',\r\n  label: string,\r\n  raw: string | undefined,\r\n  folded: string | undefined,\r\n): void {\r\n  // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????躍?춮 ?붵긿?곴? 以꾨쭏???ㅻⅤ硫??ф빊媛 ?由곕떎.\r\n  // 訝사춮怨?媛숈? 洹쒖빟?쇰줈 泥?以꾩씠 ?녿뒗 寃쎌슦瑜??섎늿?????묓옒 ?놁씠???댁븘?⑤뒗 寧?뤇??\n  // ?앷릿 ?ㅻ줈???뚯뾾???섏㎏ 以꾩쓣 李얠븘蹂대씪?띾뒗 ?덈궡媛 ?ㅼ젣濡??꾨떖?쒕떎\r\n  if (folded !== undefined) {\r\n    const wrapped = raw !== undefined && raw.length > 0\r\n    if (wrapped) candidate.raw[label] = cleanedRebarRaw(raw as string)\r\n    candidate.raw[`${label}(${wrapped ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`] =\r\n      cleanedRebarRaw(folded)\r\n    addIssue(candidate, wrapped ? '躍?춮?섋퓭?? : '躍?춮?⒲깧?ヨ죱鸚?)\r\n    return\r\n  }\r\n  if (!raw) return\r\n  const parsed = parsePitch(raw)\r\n  if (parsed) {\r\n    const shape = decorationPrefix(raw)\r\n    if (shape !== undefined) candidate.raw[`${label}壤®듁`] = shape\r\n    candidate[key] = parsed\r\n    return\r\n  }\r\n\r\n  candidate.raw[label] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '躍?춮鰲ｉ뇠訝띹꺗')\r\n}\r\n\r\nfunction setSideBar(\r\n  candidate: SectionCandidate,\r\n  raw: string | undefined,\r\n): void {\r\n  if (raw === undefined) return\r\n  const value = compact(raw)\r\n  // 令뷸쵂?삥Ø渶싥겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲겏?꾠걝閭ｅ만?ゅ쎋?℡ㅳ겎?귙굤?곮き?뽩ㅁ?쀣겎??겒?꾠?\n  if (value === '' || /^[-??+$/.test(value)) return\r\n\r\n  // 訝사춮?ⓨ릪???ф빊-孃??뉑퀡?믢슴?녴귟끃嶺뗣겘遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣굮?뽧굢?ゃ걚??\n  const parsed = parseBar(raw)\r\n  if (parsed) {\r\n    candidate.sideBar = parsed\r\n    return\r\n  }\r\n\r\n  candidate.raw['?밭춮'] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '?밭춮鰲ｉ뇠訝띹꺗')\r\n}\r\n\r\nfunction setWidthTie(\r\n  candidate: SectionCandidate,\r\n  label: string,\r\n  raw: string | undefined,\r\n): void {\r\n  if (raw === undefined) return\r\n  const parsed = parsePitch(raw)\r\n  if (parsed && barSizes.has(parsed.size as BarSize)) {\r\n    candidate.widthTie = {\r\n      size: parsed.size as BarSize,\r\n      pitchMm: parsed.pitchMm,\r\n    }\r\n    return\r\n  }\r\n  candidate.raw[label] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '亮끾??곭춮鰲ｉ뇠訝띹꺗')\r\n}\r\n\r\ninterface WallMarkGroup {\r\n  marks: string[]\r\n  centerX: number\r\n}\r\n\r\nconst WALL_MARK_PATTERN = /(?:EW\\d+[A-Z]?|W\\d+[A-Z]?)/gi\r\nconst SLAB_MARK_PATTERN = /^(?:S|FS|CS)\\d+[A-Z]?$/i\r\n\r\nfunction marksInText(value: string): string[] {\r\n  return [...value.matchAll(WALL_MARK_PATTERN)].map((match) =>\r\n    match[0].toUpperCase(),\r\n  )\r\n}\r\n\r\nfunction wallMarkGroups(row: TextRow): WallMarkGroup[] {\r\n  const labels = row.segments.filter((segment) => segment.compact === '寧?뤇')\r\n  for (const label of [...labels].reverse()) {\r\n    const groups = row.segments\r\n      .filter((segment) => segment.x > label.endX)\r\n      .flatMap((segment) => {\r\n        const marks = marksInText(segment.compact)\r\n        return marks.length > 0 ? [{ marks, centerX: segment.centerX }] : []\r\n      })\r\n    if (groups.length > 0) return groups\r\n  }\r\n  return []\r\n}\r\n\r\nfunction valuesForWallGroups(\r\n  row: TextRow,\r\n  labelText: string,\r\n  groups: WallMarkGroup[],\r\n  split: (text: string) => string[],\r\n  valueRow: TextRow = row,\r\n): Map<string, string> {\r\n  const label = [...row.segments]\r\n    .reverse()\r\n    .find((segment) => segment.compact === labelText)\r\n  if (!label) return new Map()\r\n\r\n  const values = valueRow.segments.filter((segment) =>\r\n    valueRow === row ? segment.x > label.endX : true,\r\n  )\r\n  const result = new Map<string, string>()\r\n  for (const segment of values) {\r\n    const covered = groups.filter(\r\n      (group) => group.centerX >= segment.x && group.centerX <= segment.endX,\r\n    )\r\n    if (covered.length === 0) continue\r\n    const parts = split(segment.text)\r\n    if (covered.length === parts.length) {\r\n      covered.forEach((group, index) => {\r\n        for (const mark of group.marks) result.set(mark, parts[index])\r\n      })\r\n      continue\r\n    }\r\n    if (covered.length === 1 && parts.length === covered[0].marks.length) {\r\n      covered[0].marks.forEach((mark, index) => result.set(mark, parts[index]))\r\n      continue\r\n    }\r\n    // A single mark with two thicknesses is ambiguous. Keep the complete cell\r\n    // for every mark in the group; the caller will leave the typed field empty.\r\n    for (const group of covered) {\r\n      for (const mark of group.marks) result.set(mark, segment.text)\r\n    }\r\n  }\r\n  return result\r\n}\r\n\r\nfunction wallThicknessParts(text: string): string[] {\r\n  return normalized(text)\r\n    .split(',')\r\n    .map((value) => value.trim())\r\n    .filter((value) => value.length > 0)\r\n}\r\n\r\nfunction wallBarParts(text: string): string[] {\r\n  const value = compact(text)\r\n  if (/[?삼쉈]/.test(value) || /[A-Z]\\d+[A-Z]\\d+/i.test(value)) return []\r\n  return value.match(/[A-Z]\\d+-?@\\d+(?:\\([^)]*\\))?/gi) ?? []\r\n}\r\n\r\nfunction parseWallBar(value: string):\r\n  | { size: BarSize; pitchMm: number; layers: 1 | 2 }\r\n  | undefined {\r\n  const match = compact(value).match(\r\n    /^([A-Z]\\d+)-?@(\\d+)(?:\\(([^)]*)\\))?$/i,\r\n  )\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  if (!barSizes.has(size) || pitchMm <= 0) return undefined\r\n  const note = match[3]\r\n  if (!note) return undefined\r\n  const layers = /??뽧꺂|絶絶욑풄絶욑풖/.test(normalized(note)) ? 2 : /?룔꺍?겹꺂/.test(note) ? 1 : undefined\r\n  return layers === undefined ? undefined : { size, pitchMm, layers }\r\n}\r\n\r\nfunction parseWallBlock(\r\n  rows: TextRow[],\r\n  titleText: string,\r\n  endY: number,\r\n): SectionCandidate[] {\r\n  const header = rows.find((row) => wallMarkGroups(row).length > 0)\r\n  if (!header) return []\r\n  const groups = wallMarkGroups(header)\r\n  const bodyRows = rows.filter((row) => row.y > header.y && row.y < endY)\r\n  const dimensionRow = bodyRows\r\n    .filter((row) =>\r\n      row.segments.some((segment) => segment.compact === '??씊'),\r\n    )\r\n    .at(-1)\r\n  const verticalRow = bodyRows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '潁?춮'),\r\n  )\r\n  const horizontalRow = bodyRows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '與ょ춮'),\r\n  )\r\n  if (!dimensionRow && !verticalRow && !horizontalRow) return []\r\n\r\n  const dimensionValueRow = dimensionRow\r\n    ? bodyRows.find(\r\n        (row) =>\r\n          row.y > dimensionRow.y &&\r\n          row.y < (verticalRow?.y ?? endY) &&\r\n          row.segments.some((segment) =>\r\n            groups.some(\r\n              (group) =>\r\n                group.centerX >= segment.x && group.centerX <= segment.endX,\r\n            ),\r\n          ),\r\n      )\r\n    : undefined\r\n  const thicknesses = dimensionRow\r\n    ? valuesForWallGroups(\r\n        dimensionRow,\r\n        '??씊',\r\n        groups,\r\n        wallThicknessParts,\r\n        dimensionValueRow,\r\n      )\r\n    : new Map<string, string>()\r\n  const verticals = verticalRow\r\n    ? valuesForWallGroups(verticalRow, '潁?춮', groups, wallBarParts)\r\n    : new Map<string, string>()\r\n  const horizontals = horizontalRow\r\n    ? valuesForWallGroups(horizontalRow, '與ょ춮', groups, wallBarParts)\r\n    : new Map<string, string>()\r\n\r\n  return groups.flatMap(({ marks }) =>\r\n    marks.map((mark): SectionCandidate => {\r\n      const candidate: SectionCandidate = {\r\n        kind: isOutOfScopeList(titleText) ? '野얕괌鸚? : '?먬쐡鶯?,\r\n        mark,\r\n        raw: {},\r\n        issues: [],\r\n      }\r\n      const thickness = thicknesses.get(mark)\r\n      if (thickness && /^\\d+$/.test(thickness)) {\r\n        candidate.thickness = Number(thickness)\r\n      } else if (thickness) {\r\n        candidate.raw['??씊'] = thickness\r\n        addIssue(candidate, '鶯곩럻?면걬')\r\n      }\r\n\r\n      const setBar = (\r\n        role: 'vertical' | 'horizontal',\r\n        value: string | undefined,\r\n      ) => {\r\n        if (value === undefined) return\r\n        const parsed = parseWallBar(value)\r\n        if (!parsed) {\r\n          candidate.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'] = value\r\n          addIssue(candidate, '鶯곭춮鰲ｉ뇠訝띹꺗')\r\n          return\r\n        }\r\n        if (candidate.layers !== undefined && candidate.layers !== parsed.layers) {\r\n          candidate.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'] = value\r\n          addIssue(candidate, '鶯곭춮鰲ｉ뇠訝띹꺗')\r\n          return\r\n        }\r\n        candidate[role] = { size: parsed.size, pitchMm: parsed.pitchMm }\r\n        candidate.layers = parsed.layers\r\n      }\r\n      setBar('vertical', verticals.get(mark))\r\n      setBar('horizontal', horizontals.get(mark))\r\n      return candidate\r\n    }),\r\n  )\r\n}\r\n\r\nfunction slabMark(row: TextRow): { mark: string; centerX: number } | undefined {\r\n  const segment = row.segments.find((candidate) =>\r\n    SLAB_MARK_PATTERN.test(candidate.compact),\r\n  )\r\n  return segment\r\n    ? { mark: segment.compact.toUpperCase(), centerX: segment.centerX }\r\n    : undefined\r\n}\r\n\r\nfunction slabBarCell(row: TextRow, centerX: number): TextSegment | undefined {\r\n  return row.segments\r\n    .filter((segment) => /@\\d+/.test(compact(segment.text)))\r\n    .sort(\r\n      (left, right) =>\r\n        Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n    )[0]\r\n}\r\n\r\nfunction parseSlabBar(value: string): { size: BarSize; pitchMm: number } | undefined {\r\n  const match = compact(value).match(/^([A-Z]\\d+)-?@(\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  return barSizes.has(size) && pitchMm > 0 ? { size, pitchMm } : undefined\r\n}\r\n\r\nfunction slabThickness(row: TextRow, centerX: number): number | undefined {\r\n  const value = row.segments\r\n    .filter((segment) => /^\\d[\\d,]*$/.test(compact(segment.text)))\r\n    .sort(\r\n      (left, right) =>\r\n        Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n    )[0]\r\n    ?.compact\r\n  return value === undefined ? undefined : Number(value.replace(/,/g, ''))\r\n}\r\n\r\nfunction nextHeaderY(rows: TextRow[], endY: number): number | undefined {\r\n  return rows.find(\r\n    (row) =>\r\n      row.y >= endY &&\r\n      row.segments.some((segment) => segment.compact.startsWith('寧?뤇')) &&\r\n      !row.segments.some((segment) =>\r\n        /??씌?밧릲|?룩씌?밧릲/.test(segment.compact),\r\n      ),\r\n  )?.y\r\n}\r\n\r\nfunction parseSlabBlock(\r\n  rows: TextRow[],\r\n  anchor: TitleAnchor,\r\n  endY: number,\r\n): SectionCandidate[] {\r\n  const directionHeader = rows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '??씌?밧릲') &&\r\n    row.segments.some((segment) => segment.compact === '?룩씌?밧릲'),\r\n  )\r\n  const shortX = directionHeader?.segments.find(\r\n    (segment) => segment.compact === '??씌?밧릲',\r\n  )?.centerX\r\n  const longX = directionHeader?.segments.find(\r\n    (segment) => segment.compact === '?룩씌?밧릲',\r\n  )?.centerX\r\n  if (shortX === undefined || longX === undefined) return []\r\n\r\n  const initialRows = rows.filter((row) => row.y > anchor.row.y)\r\n  const firstMark = initialRows.map(slabMark).find(\r\n    (mark): mark is { mark: string; centerX: number } => mark !== undefined,\r\n  )\r\n  if (!firstMark) return []\r\n  const markRows = initialRows\r\n    .map((row) => ({ row, mark: slabMark(row) }))\r\n    .filter(\r\n      (entry): entry is { row: TextRow; mark: { mark: string; centerX: number } } =>\r\n        entry.mark !== undefined &&\r\n        Math.abs(entry.mark.centerX - firstMark.centerX) <\r\n          Math.max(20, Math.abs(shortX - firstMark.centerX)),\r\n    )\r\n  const bridgeTitle = rows.find(\r\n    (row) =>\r\n      Math.abs(row.y - endY) < 0.01 &&\r\n      row.segments.some((segment) => /鶯곥꺁?밤깉/.test(segment.compact)),\r\n  )\r\n  const scanEnd = bridgeTitle ? nextHeaderY(rows, endY) ?? endY : endY\r\n  const candidates = markRows.filter(({ row }) => row.y < scanEnd)\r\n  if (candidates.length === 0) return []\r\n\r\n  const thicknessHeader = rows.find((row) =>\r\n    row.segments.some((segment) => /佯듿럻|?밤꺀?뽩럻/.test(segment.compact)),\r\n  )\r\n  const thicknessX =\r\n    thicknessHeader?.segments.find((segment) =>\r\n      /佯듿럻|?밤꺀?뽩럻/.test(segment.compact),\r\n    )?.centerX ?? firstMark.centerX\r\n  const outOfScope = isOutOfScopeList(anchor.titleText)\r\n\r\n  return candidates.map(({ row, mark }, index) => {\r\n    const nextY = candidates[index + 1]?.row.y ?? scanEnd\r\n    const cantilever =\r\n      mark.mark.startsWith('CS') &&\r\n      rows.some(\r\n        (candidateRow) =>\r\n          candidateRow.y >= row.y - 1 &&\r\n          candidateRow.y < nextY &&\r\n          candidateRow.segments.some((segment) =>\r\n            segment.compact.includes('?뉑똻?▲궧?⒲깣'),\r\n          ),\r\n      )\r\n    const candidate: SectionCandidate = {\r\n      kind: outOfScope || cantilever ? '野얕괌鸚? : '佯딀씮',\r\n      mark: mark.mark,\r\n      raw: {},\r\n      issues: [],\r\n    }\r\n    const sectionRows = rows.filter(\r\n      (candidateRow) => candidateRow.y > row.y - 20 && candidateRow.y < nextY,\r\n    )\r\n    const thickness = slabThickness(row, thicknessX)\r\n    if (!outOfScope && thickness !== undefined) candidate.thickness = thickness\r\n\r\n    if (outOfScope || cantilever) return candidate\r\n\r\n    const faceRows = new Map<'top' | 'bottom', TextRow>()\r\n    for (const face of ['top', 'bottom'] as const) {\r\n      const labels = face === 'top' ? ['訝딁ク嶺?, '訝딁춮'] : ['訝뗧ク嶺?, '訝뗧춮']\r\n      const faceRow = sectionRows\r\n        .filter((candidateRow) =>\r\n          candidateRow.segments.some((segment) =>\r\n            labels.includes(segment.compact),\r\n          ),\r\n        )\r\n        .sort((left, right) => Math.abs(left.y - row.y) - Math.abs(right.y - row.y))[0]\r\n      if (faceRow) faceRows.set(face, faceRow)\r\n    }\r\n\r\n    for (const [face, faceRow] of faceRows) {\r\n      for (const [axis, centerX] of [\r\n        ['??씌?밧릲', shortX],\r\n        ['?룩씌?밧릲', longX],\r\n      ] as const) {\r\n        const cell = slabBarCell(faceRow, centerX)\r\n        const key = axis === '??씌?밧릲' ? 'shortSide' : 'longSide'\r\n        const rawKey = `${axis}(${face})`\r\n        if (!cell) continue\r\n        const parsed = parseSlabBar(cell.text)\r\n        if (!parsed) {\r\n          candidate.raw[rawKey] = cell.text\r\n          addIssue(candidate, '佯딀씮嶺뗨㎗?덁툖??)\r\n          continue\r\n        }\r\n        candidate[key] = {\r\n          ...candidate[key],\r\n          [face]: parsed,\r\n        }\r\n      }\r\n    }\r\n    return candidate\r\n  })\r\n}\r\n\r\nfunction rowsBetween(rows: TextRow[], startY: number, endY: number): TextRow[] {\r\n  return rows.filter((row) => row.y > startY && row.y < endY)\r\n}\r\n\r\n// ?굿룟ㄷ歟?釉붾줉???뚮젮吏??쇰꺼 ???꾨? ???묓옒 媛먯????뚮떎???쇰꺼 ?됥??먯젙???대떎.\r\nconst ROW_LABELS = [\r\n  '訝사춮',\r\n  '躍?춮',\r\n  'HOOP',\r\n  '?뺛꺖??,\r\n  '?ε릦?ⓨ릭嶺?,\r\n  '??씊',\r\n  '鵝띸쉰',\r\n  '訝딁춮',\r\n  '訝딁ク嶺?,\r\n  '訝뗧춮',\r\n  '訝뗧ク嶺?,\r\n  'ST',\r\n  'STP',\r\n  'STP.',\r\n  '?귙겙?됬춮',\r\n  '?밤궭?쇈꺀?껁깤',\r\n  'B횞D',\r\n  'b횞D',\r\n  '壤®듁??씊',\r\n  '野멩퀡',\r\n  '?밭춮',\r\n  '亮끾?嶺?,\r\n  '藥얏?嶺?,\r\n  '亮끾??곭춮',\r\n  '?숃?,\r\n] as const\r\n\r\n/** ?ф빊-孃??좏겙(訝사춮 ?)怨?孃??붵긿???좏겙(躍?춮쨌?귙겙?됬춮 ?)??援щ텇???묓옒??李얜뒗?? */\r\nconst BAR_TOKEN = /\\d+-?D\\d+/i\r\n\r\nconst PITCH_TOKEN = /D\\d+-?@\\d+/i\r\n\r\n/**\r\n * ?쇰꺼 ?됯낵 ?ㅼ쓬 ?쇰꺼 ???ъ씠??臾대씪踰??됱뿉???꾤춮 ?좏겙??留덊겕蹂꾨줈 紐⑥???\r\n * ? ?댁슜??以꾨컮轅덉쑝濡??묓엳硫??섏㎏ 以꾩? 蹂꾨룄 ?됱씠 ?섏뼱 ?쇰꺼 ?됰쭔 ?쎈뒗 寃쎈줈?먯꽌\r\n * 議곗슜???щ씪吏꾨떎 ??泥?以꾨쭔?쇰줈 ?뺤젙?섎㈃ 2餘든춮 嫄곕? 諛⑹묠??以꾨컮轅?蹂?뺤뿉???뚮떎.\r\n */\r\nfunction barContinuationByMark(\r\n  dataRows: TextRow[],\r\n  labelRow: TextRow,\r\n  endY: number,\r\n  marks: MarkColumn[],\r\n  token: RegExp,\r\n): Map<string, string> {\r\n  const nextLabelY = dataRows\r\n    .filter((row) => row.y > labelRow.y && exactLabel(row, ROW_LABELS))\r\n    .reduce((min, row) => Math.min(min, row.y), endY)\r\n  const merged = new Map<string, string>()\r\n\r\n  for (const row of dataRows) {\r\n    if (row.y <= labelRow.y || row.y >= nextLabelY) continue\r\n    if (exactLabel(row, ROW_LABELS)) continue\r\n    const barSegments = row.segments.filter((segment) =>\r\n      token.test(segment.compact),\r\n    )\r\n    if (barSegments.length === 0) continue\r\n    const values = valuesAtTargets(\r\n      barSegments,\r\n      marks.map(({ mark, centerX }) => ({ id: mark, centerX })),\r\n    )\r\n    for (const [mark, value] of values) {\r\n      const existing = merged.get(mark)\r\n      merged.set(mark, existing ? `${existing}/${value}` : value)\r\n    }\r\n  }\r\n\r\n  return merged\r\n}\r\n\r\nfunction lastPositionRow(\r\n  rows: TextRow[],\r\n  headerY: number,\r\n  beforeY: number,\r\n): TextRow | undefined {\r\n  return rows\r\n    .filter(\r\n      (row) =>\r\n        row.y > headerY && row.y < beforeY && exactLabel(row, ['鵝띸쉰']),\r\n    )\r\n    .at(-1)\r\n}\r\n\r\n/**\r\n * ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖쓽 ?ㅼ?移?媛濡?移섏닔. 李쎌쓽 ?섑븳? ?몄떇???곗씠???쇰꺼 ??以?\n * 媛???꾨떎 ???쇰꺼 ?섎굹?먮쭔 留ㅼ뼱 ?먮㈃ 洹??쇰꺼??紐??쎌? ?쒖뿉??李쎌씠 ?щ씪?댁뒪 ?꾩껜濡?\n * ?대젮 ?꾨옒 ???숃??????⑤룆 ?レ옄媛 移섏닔濡??뺤젙?쒕떎. ?쇰꺼 ?됱쓣 ?섎굹???몄떇?섏?\r\n * 紐삵뻽?쇰㈃ 洹??쒖뿉???쎌? 寃껋씠 ?녿떎???살씠誘濡??대갚???뚮━吏 ?딅뒗??\r\n *\r\n * ?곹븳???щ씪?댁뒪??endY瑜???諛쏆? ?딅뒗????labelRows???꾨? rowsBetween(rows,\r\n * slice.startY, slice.endY)?먯꽌 ?섏삤誘濡???긽 y < slice.endY?? 洹?endY瑜??ㅼ떆\r\n * Math.min???ｌ뼱???덈? ?좏깮?????놁뼱 ?덉????딆? ?곹븳 蹂댄샇泥섎읆 ?쏀삍??(#35)\r\n */\r\nfunction sketchDimensions(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  labelRows: Array<TextRow | undefined>,\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  const labelYs = labelRows.flatMap((row) => (row ? [row.y] : []))\r\n  if (labelYs.length === 0) return new Map()\r\n  return scalarDimensions(rows, startY, Math.min(...labelYs), anchors)\r\n}\r\n\r\n/**\r\n * ?ㅼ?移?移섏닔瑜?諛곗젙?????듭빱. 鵝띸쉰 ?댁씠 ?덉쑝硫?洹멸쾬?대떎 ??寧?뤇 ?쇰꺼? 移?以묒븰??\n * ?볦씠吏留?移???? 遺?щ쭏???щ씪?? 以묒떖 ?ъ씠 以묒젏??寃쎄퀎濡??곕㈃ 醫곸? 移몄씠 ?볦? 移몄쓽\r\n * ?앹쓣 癒밸뒗?? ?ㅻЪ ojkk 鸚㎪쥈?먯꽌 G3(??85) ??G4(??42.5)媛 G3???몃줈 移섏닔瑜?\n * 媛?멸컮?? 鵝띸쉰 ?댁? 移몄쓣 ?ㅼ젣濡???쇰쭅?섎?濡???씠 ?ㅻⅨ ?댁썐怨?遺숈뼱???닿툔?섏? ?딅뒗??\r\n */\r\nfunction markAnchors(\r\n  marks: MarkColumn[],\r\n  positions: PositionColumn[],\r\n): MarkColumn[] {\r\n  const seenGroups = new Set<string>()\r\n  return marks.flatMap(({ mark, centerX, groupKey, rawCell }) => {\r\n    if (seenGroups.has(groupKey)) return []\r\n    seenGroups.add(groupKey)\r\n    const own = positions.filter((position) => position.mark === mark)\r\n    return own.length > 0\r\n      ? own.map((position) => ({ mark, centerX: position.centerX, groupKey, rawCell }))\r\n      : [{ mark, centerX, groupKey, rawCell }]\r\n  })\r\n}\r\n\r\n/** ?뚣걯寧?뤇?삠꺂?뗣굢 ?쇱튇 遺?몃뒗 ?ㅼ?移?移섏닔???섎굹???듭빱瑜?怨듭쑀?쒕떎. ?듭빱 ?⑥닔媛\r\n * 泥?遺???섎굹留?諛섑솚?섎?濡? 洹?寃곌낵瑜??ㅼ젣 ?꾨낫 ?꾨???蹂듭젣?쒕떎. ??????쎈뒗\r\n * valuesByMark???대? ???꾧컻瑜??섑뻾?섎?濡??ㅼ?移?寃쎈줈?먮쭔 ?곸슜?쒕떎.\r\n */\r\nfunction expandMarkGroups(\r\n  values: Map<string, string>,\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  const firstByGroup = new Map<string, string>()\r\n  for (const { mark, groupKey } of marks) {\r\n    if (!firstByGroup.has(groupKey)) firstByGroup.set(groupKey, mark)\r\n  }\r\n  return new Map(\r\n    marks.flatMap(({ mark, groupKey }) => {\r\n      const first = firstByGroup.get(groupKey)\r\n      const value = first === undefined ? undefined : values.get(first)\r\n      return value === undefined ? [] : [[mark, value] as const]\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * ?듭빱蹂?嫄곕━ ?곹븳. 移?寃쎄퀎?????듭빱 ?ъ씠???덉쑝誘濡??듭빱?먯꽌 寃쎄퀎源뚯???嫄곕━??洹?\n * ?댁썐源뚯???媛꾧꺽蹂대떎 吏㏓떎 ???곹븳???댁썐 媛꾧꺽?쇰줈 ?〓뒗?? ?댁썐蹂꾨줈 ?щ뒗 ?댁쑀??移???씠\r\n * ?대쭏???щ씪?쒕떎: 媛꾧꺽??以묒븰媛믪쓣 ?곕㈃ ?먭린 移몄씠 ?⑤뱾蹂대떎 ?볦? ?댁뿉???ㅻЪ 媛믪씠\r\n * ?섎━怨?ojkk ??FC1? ?댁썐 媛꾧꺽 85.1???ㅼ륫 51.7), 醫뚯슦 以???履쎌쓣 ?곕㈃ 珥섏킌???댁씠\r\n * 諛섎???癒??댁쓽 ?곹븳??臾쇰젮諛쏆븘 ?????ъ씠 鍮????퉴吏 癒밸뒗??\r\n *\r\n * ?듭빱媛 ?섎굹肉먯씠硫?媛꾧꺽???놁뼱 ?곹븳??Infinity媛 ?쒕떎 ???몃줈 吏앹쭞湲곕뒗 寧?뤇 2媛?\n * ?댁긽???곕줈 ?붽뎄?섍퀬, 媛濡쒕뒗 ?쇰꺼 ?????쑝濡??대? 醫곹????덉쑝硫? ? 媛믪? ?댁씠\r\n * ?섎굹硫?洹??댁씠 ???꾩껜瑜?諛쏅뒗 寃껋씠 留욌떎.\r\n */\r\nfunction boundedAnchors<T extends { centerX: number }>(\r\n  anchors: T[],\r\n): Array<T & { limit: number }> {\r\n  const sorted = [...anchors].sort(\r\n    (left, right) => left.centerX - right.centerX,\r\n  )\r\n  return sorted.map((anchor, index) => {\r\n    const gaps = [\r\n      index > 0 ? anchor.centerX - sorted[index - 1].centerX : undefined,\r\n      index + 1 < sorted.length\r\n        ? sorted[index + 1].centerX - anchor.centerX\r\n        : undefined,\r\n    ].filter((gap): gap is number => gap !== undefined)\r\n    return { ...anchor, limit: Math.min(...gaps) }\r\n  })\r\n}\r\n\r\nfunction scalarDimensions(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  endY: number,\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  if (marks.length === 0) return new Map()\r\n  const numericSegments = rows\r\n    .filter((row) => row.y > startY && row.y < endY)\r\n    .flatMap((row) => row.segments)\r\n    .filter((segment) => /^\\d[\\d\\s,]*$/.test(normalized(segment.text)))\r\n\r\n  // ?대떦 ?レ옄 ?멸렇癒쇳듃媛 ?뺥솗??1媛쒖씪 ?뚮쭔 ?섍릿????2媛??댁긽???댁뼱遺숈씠硫?\n  // ??00????00?띿씠 700900mm媛 ?쒕떎. ?섍릿 媛믩룄 b횞d濡??뺤젙?섏????딄퀬\r\n  // setDimension?먯꽌 鍮덉뭏+?먮Ц 李멸퀬濡??⑤뒗??\r\n  const perMark = new Map<string, string[]>()\r\n  const bounded = boundedAnchors(marks)\r\n  for (const segment of numericSegments) {\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    // ?몃줈 ?곌낵 媛숈? ?곹븳??嫄대떎 ???쒖そ留??곹븳???놁쑝硫??ㅼ?移????쓽 ?꾨Т ?レ옄??\n    // 理쒓렐???댁뿉 遺숈뼱 ?댁뒋 ?녿뒗 ?뺤젙 b媛 ?쒕떎\r\n    if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n    const existing = perMark.get(target.mark) ?? []\r\n    existing.push(segment.compact)\r\n    perMark.set(target.mark, existing)\r\n  }\r\n\r\n  // 肄ㅻ쭏???먮┸??援щ텇?대떎(parseDimension??踰쀪꺼 諛쏅뒗?? verticalsByMark? 媛숈? 洹쒖빟) ??\n  // ?ш린????,200?띿쓣 ?レ옄媛 ?꾨땲?쇨퀬 踰꾨━硫???1,000mm ?댁긽??遺?щ? ?볦튇??\n  return new Map(\r\n    [...perMark.entries()].flatMap(([mark, values]) => {\r\n      const text = values[0].replace(/,/g, '')\r\n      return values.length === 1 && /^\\d+$/.test(text)\r\n        ? [[mark, text] as const]\r\n        : []\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * ?몃줈 移섏닔瑜??대퀎濡?紐⑥??? scalarDimensions? 媛숈? 洹쒖빟 ???대떦 ?뺥솗??1媛쒖씪 ?뚮쭔\r\n * ?섍릿?? ??????몃줈 ?レ옄媛 ?섏씠硫??대뒓 履쎌씠 ??씊?몄? ?먯젙??洹쇨굅媛 ?녿떎.\r\n */\r\nfunction verticalsByMark(\r\n  runs: VerticalRun[],\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  // ?쇰꺼 ?됱뿉 留ㅼ씤 媛濡?媛믨낵 ?щ━ ?몃줈 ?곗? ???대뵒?먮굹 ?덉쓣 ???덉뼱, ?곹븳???놁쑝硫?\n  // ?⑥쓽 ???レ옄媛 ???댁쓽 d濡??뺤젙?쒕떎. 寧?뤇???섎굹硫???媛꾧꺽???????녿떎 ??\n  // ?곹븳???몄슱 洹쇨굅媛 ?놁쑝??吏앹쭞吏 ?딅뒗?? ?듭빱 ?섎줈 ?щ㈃ ???쒕떎: 鵝띸쉰 ?댁씠\r\n  // ??寧?뤇???щ윭 ?듭빱濡??섎━誘濡??⑥씪 寧?뤇 ?쒖뿉?쒕룄 ?듦낵?쒕떎\r\n  if (new Set(anchors.map(({ mark }) => mark)).size < 2) return new Map()\r\n  const bounded = boundedAnchors(anchors)\r\n  const perMark = new Map<string, string[]>()\r\n\r\n  for (const run of runs) {\r\n    // 肄ㅻ쭏???먮┸??援щ텇?대떎(parseDimension??踰쀪꺼 諛쏅뒗??. ?ш린????,200?띿쓣\r\n    // ?レ옄媛 ?꾨땲?쇨퀬 踰꾨━硫?移댁슫?몄뿉?쒕룄 鍮좎졇 ?뚯뿴???뺥솗??1媛쒌?諛⑹뼱媛 ?ル┛??\n    const text = run.text.replace(/,/g, '')\r\n    if (!/^\\d+$/.test(text)) continue\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - run.x) < Math.abs(closest.centerX - run.x)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    if (Math.abs(target.centerX - run.x) > target.limit) continue\r\n    const bucket = perMark.get(target.mark)\r\n    if (bucket) bucket.push(text)\r\n    else perMark.set(target.mark, [text])\r\n  }\r\n\r\n  return new Map(\r\n    [...perMark.entries()].flatMap(([mark, values]) =>\r\n      values.length === 1 ? [[mark, values[0]] as const] : [],\r\n    ),\r\n  )\r\n}\r\n\r\n/**\r\n * ?뚦숱?뜻뼪?㏂띲걽?묆굮誤뗥눣?쀣겓?쀣걼?밤궞?껁긽?뗣겗?김〃?뗣굢?곫Ø?ヤ를??b 野멩퀡?믤떮?녴?\n * ?싧만??scalarDimensions ??꺀?쇻꺂烏뚣겏訝사춮?삠깢?쇈깤烏뚣겗?볝굮沃???잆굙?곩숱?뜻뼪??\n * ?뚨떖塋뗣걮?잒죱?ャ걗?뗨〃?㎯겘野멩퀡?믤뜥?╉겍?쀣겲?녴귛ㅳ겘?꾤Е?룔겗?瓦묉렏?뗣겇?ｅ닓??\n * 罌껆븣?끹겓?먦굤?곩릪?섇닓??닪野멩퀡?믧ｇ탳?쀣겒?꾠?\n */\r\nfunction sketchColumnHorizontalValues(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  endY: number,\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  const numeric = rows\r\n    .filter((row) => row.y > startY && row.y <= endY)\r\n    .flatMap((row) => row.segments)\r\n    .filter((segment) => /^\\d[\\d,]*$/.test(normalized(segment.text)))\r\n\r\n  return new Map(\r\n    boundedAnchors(anchors).flatMap((anchor) => {\r\n      const candidates = numeric.filter(\r\n        (segment) => Math.abs(segment.centerX - anchor.centerX) <= anchor.limit,\r\n      )\r\n      const nearest = candidates.sort(\r\n        (left, right) =>\r\n          Math.abs(left.centerX - anchor.centerX) -\r\n          Math.abs(right.centerX - anchor.centerX),\r\n      )[0]\r\n      if (!nearest) return []\r\n      return [[anchor.mark, normalized(nearest.text).replace(/,/g, '')] as const]\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * Fuji ??윶?밤궞?껁긽??를野멩퀡?뚣뚦숱?뜻뼪?㏂띹죱??쎍訝듽겓塋뗣겇?귝Ø野멩퀡?ⓨ릪?섇닓??\n * 營?걢?뚣걼?겼ㅳ겗?녴걾?곩숱?뜻뼪?㏂겓??귟퓩?꾣객亮녈꺀?녈걽?묆굮寧?뤇?멨?恙쒌걬?쎼굥??\n * ?γ겗野멩퀡?쀣굮?뚣걯 d ?ヤ슴?뤵겒?꾠걼?곥걓 ???瓦묉렏?믣뀍?ュ쎓若싥걲?뗣?\n */\r\nfunction sketchColumnVerticalValues(\r\n  verticals: VerticalRun[],\r\n  shapeY: number,\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  const numeric = verticals.filter((run) => /^\\d[\\d,]*$/.test(run.text))\r\n  if (numeric.length === 0) return new Map()\r\n  const nearestDistance = Math.min(\r\n    ...numeric.map((run) => Math.abs(run.y - shapeY)),\r\n  )\r\n  const nearestRows = numeric.filter(\r\n    (run) => Math.abs(Math.abs(run.y - shapeY) - nearestDistance) < 0.01,\r\n  )\r\n\r\n  return new Map(\r\n    boundedAnchors(anchors).flatMap((anchor) => {\r\n      const candidates = nearestRows.filter(\r\n        (run) => Math.abs(run.x - anchor.centerX) <= anchor.limit,\r\n      )\r\n      const nearest = candidates.sort(\r\n        (left, right) =>\r\n          Math.abs(left.x - anchor.centerX) - Math.abs(right.x - anchor.centerX),\r\n      )[0]\r\n      if (!nearest) return []\r\n      return [[anchor.mark, nearest.text.replace(/,/g, '')] as const]\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * ?몃줈 移섏닔瑜?痢??щ씪?댁뒪??諛곗젙?쒕떎. ?ㅼ?移섏쓽 ?몃줈 移섏닔??痢??쇰꺼 ?됰낫???꾩뿉\r\n * ?볦씠湲곕룄 ?댁꽌 ?щ씪?댁뒪??y????쇰꺼 ??~ ?ㅼ쓬 ?쇰꺼 ???쇰줈 ?먮Ⅴ硫??듭㎏濡?鍮좎쭊??\r\n *\r\n * 諛곗젙 ?듭빱??**?쒖쓽 ??以??곗뿉 媛??媛源뚯슫 寃?*?닿퀬, 洹??됱씠 ???щ씪?댁뒪媛 ?꾩옄??\r\n * 痢??쇰꺼???듭빱濡??곕㈃ ?섏씠 ?④퍡 留앷?議뚮떎 (#32??:\r\n *   - ?щ씪?댁뒪媛 留욌떯???덉뼱(endY[i] == startY[i+1]) ?쇰꺼 理쒓렐?묒쓽 蹂대줈?몄씠 寃쎄퀎媛\r\n *     span/2? ?뺥솗???쇱튂?쒕떎 ???꾨옒 嫄곕━ ?곹븳??以묎컙 痢듭뿉????긽 李몄씠 ?먮떎.\r\n *   - ?먭린 痢??곗씠?????ъ씠???덈뒗 ?곗씠 ??媛源뚯슫 ?꾨옒 痢??쇰꺼濡??섏뼱媛, 洹?痢듭씠\r\n *     ?⑥쓽 移섏닔濡??뺤젙?먮떎.\r\n * ?됱쓣 ?듭빱濡??곕㈃ ?쇰꺼源뚯???嫄곕━媛 span/2瑜??섏쓣 ???덉뼱 ?곹븳???ㅼ젣濡??묐룞?쒕떎.\r\n *\r\n * rows????諛??됱쓣 ?섍린吏 留?寃????ㅻЪ ojkk p3??2F ?ㅼ?移섏뿉?쒕뒗 ?쒖젣???\n * ?녜씊?띸㎞ ?됱씠 ?몃줈 移섏닔?먯꽌 0.6pt 嫄곕━??痢??쇰꺼(12.3pt)蹂대떎 媛源앸떎.\r\n *\r\n * ?ㅻЪ 5硫?70嫄댁뿉????諛곗젙? 痢??쇰꺼 理쒓렐?묎낵 寃곌낵媛 媛숇떎(?꾩닔 ?議?. 諛붾뚮뒗 寃껋?\r\n * ?????ㅽ뙣肉먯씠??\r\n */\r\nfunction verticalsBySlice(\r\n  runs: VerticalRun[],\r\n  slices: Array<{ startY: number; endY: number }>,\r\n  rows: TextRow[],\r\n): VerticalRun[][] {\r\n  const buckets: VerticalRun[][] = slices.map(() => [])\r\n  if (slices.length === 0) return buckets\r\n\r\n  for (const run of runs) {\r\n    const anchorY =\r\n      rows.length > 0\r\n        ? rows.reduce((closest, row) =>\r\n            Math.abs(row.y - run.y) < Math.abs(closest.y - run.y) ? row : closest,\r\n          ).y\r\n        : run.y\r\n    // ?щ씪?댁뒪??留욌떯???뺣젹???덉쑝誘濡? startY媛 ?듭빱 ?댄븯??留덉?留??щ씪?댁뒪媛\r\n    // 洹??됱쓣 ?댁? ?щ씪?댁뒪?? 泥??щ씪?댁뒪蹂대떎 ??癒몃━????硫?泥??щ씪?댁뒪濡?蹂몃떎\r\n    let best = 0\r\n    slices.forEach((slice, index) => {\r\n      if (slice.startY <= anchorY) best = index\r\n    })\r\n    // ?먭린 釉붾줉??留덉?留??됰낫???꾨옒???덈뒗 ?곗? ?대뒓 痢듭쓽 寃껊룄 ?꾨땲?? 洹?\n    // 釉붾줉???댁슜? 嫄곌린???앸굹怨??ㅼ쓬 痢??쇰꺼源뚯???鍮덉뭏?몃뜲, ???쭔 蹂대㈃ 洹?\n    // 鍮덉뭏???꾩쭅 ???щ씪?댁뒪???꾨옒 嫄곕━媛 0???섏뼱 ?⑥쓽 移섏닔媛 議곗슜???뺤젙?쒕떎.\r\n    // ?ㅻЪ?먯꽌 ?몃줈 移섏닔??鍮덉뭏??**?꾨옒履?*, ?먭린 痢??쇰꺼 諛붾줈 ?꾩뿉 ?볦씠誘濡?\n    // (?ㅼ륫 7.68~13.46pt, 5硫?51嫄? ?먭린 釉붾줉??泥??됰낫?ㅻ룄 ?꾨떎 ????洹쒖튃??\n    // 嫄몃━吏 ?딅뒗?? 鍮덉뭏 ?꾩そ?????レ옄???꾩옄瑜?媛由?洹쇨굅媛 ?놁쑝???뺤젙?섏?\r\n    // ?딄퀬 ?먮Ц?쇰줈 ?④릿??(R10, PR #61 由щ럭 major)\r\n    // ?먭린 ?됱쓽 踰붿쐞??endY 媛 ?꾨땲??**?ㅼ쓬 ?щ씪?댁뒪??startY** 濡??딅뒗??\r\n    // ?몄텧遺媛 留덉?留??щ씪?댁뒪??endY 瑜?tableBottom(= ??諛붾떏 ???먯떊??y)?쇰줈\r\n    // ?먮Ⅴ誘濡? endY 瑜?諛고? ?곹븳?쇰줈 ?곕㈃ 洹??됱씠 鍮좎졇 理쒗븯痢듭뿉?쒕쭔 lastRowY 媛\r\n    // ?????꾨줈 諛由곕떎 (PR #61 由щ럭 major)\r\n    const bandEnd = slices[best + 1]?.startY ?? Number.POSITIVE_INFINITY\r\n    const lastRowY = rows.reduce(\r\n      (last, row) =>\r\n        row.y >= slices[best].startY && row.y < bandEnd && row.y > last\r\n          ? row.y\r\n          : last,\r\n      slices[best].startY,\r\n    )\r\n    if (run.y > lastRowY) continue\r\n\r\n    // ?먭린 痢??ㅼ?移섍? ?꾨땶 ?곗? 踰꾨┛?? 嫄곕━ ?쒗븳 ?놁씠 ?ｌ쑝硫??대뼡 ?レ옄???대뒓\r\n    // 痢듭뿏媛 遺숈뼱 ?댁뒋 ?녿뒗 ?뺤젙 d媛 ?쒕떎 ??誘몄? ?뺤떇?먯꽌???뺤젙?섏? ?딄퀬 ?먮Ц?쇰줈\r\n    // ?⑤뒗 履쎌씠 ?노떎 (R10)\r\n    //\r\n    // 嫄곕━???쇰꺼(startY) ???먯씠 ?꾨땲???щ씪?댁뒪 **???*源뚯?濡??곕떎. ?듭빱媛 ?됱씤??\n    // ?곹븳留??쇰꺼 湲곗??대㈃ ?꾩옄 ?щ씪?댁뒪媛 ?먭린 ?곗쓣 踰꾨┛????????섎컲遺???볦씤\r\n    // ?곗? ?녠쾶 諛곗젙?섍퀬??startY ?먯꽌 span/2 瑜??섏뼱 ?먭린?쒕떎 (PR #61 由щ럭 major)\r\n    const { startY, endY } = slices[best]\r\n    const span = endY - startY\r\n    const distance = Math.max(startY - run.y, run.y - endY, 0)\r\n    if (distance <= span * SLICE_DISTANCE_LIMIT_RATIO) buckets[best].push(run)\r\n  }\r\n\r\n  return buckets\r\n}\r\n\r\n/**\r\n * ?쒖쓽 ?ㅼ젣 諛붾떏 y瑜?援ы븳?? 留덉?留?釉붾줉??endY???ㅼ쓬 ??댄????놁쑝硫??섏씠吏\r\n * 諛붾떏源뚯? ?대젮 ?덉뼱, blockRows.at(-1)????諛??쒖젣? ?띿뒪???꾨㈃踰덊샇쨌異뺤쿃 ??媛\r\n * ?????덈떎 ??寧?뤇 ?댁쓽 x?????tableRight) ?덉뿉 ?멸렇癒쇳듃媛 ?덈뒗 ?됱쑝濡?癒쇱?\r\n * 醫곹?????諛??띿뒪?멸? ?섏쭛 李쎌쓣 諛?대궡吏 ?딅뒗??(#37, #33??遺?묒슜)\r\n */\r\nfunction tableBottomY(\r\n  blockRows: TextRow[],\r\n  marks: MarkColumn[],\r\n  endY: number,\r\n): number {\r\n  return rowsWithinTable(blockRows, marks).at(-1)?.y ?? endY\r\n}\r\n\r\n/**\r\n * ?????됰쭔 ?④릿????寧?뤇 ?댁쓽 x?????tableRight) ?덉뿉 ?멸렇癒쇳듃媛 ?덈뒗 ?됱씠??\r\n * ?쒖젣?(?녜씊?띸㎞쨌嶸←릤兩븀칹鶯???? ?쒖? 媛숈? y???뿉 嫄몄퀜 ?덉뼱 y濡쒕뒗 紐?媛瑜몃떎.\r\n */\r\nfunction rowsWithinTable(blockRows: TextRow[], marks: MarkColumn[]): TextRow[] {\r\n  const tableRight = Math.max(...marks.map(({ centerX }) => centerX))\r\n  return blockRows.filter((row) =>\r\n    row.segments.some((segment) => segment.centerX <= tableRight),\r\n  )\r\n}\r\n\r\nfunction parseColumnBlock(\r\n  rows: TextRow[],\r\n  headerIndex: number,\r\n  endY: number,\r\n  titleText: string,\r\n  verticals: VerticalRun[],\r\n): SectionCandidate[] {\r\n  const header = rows[headerIndex]\r\n  const marks = markColumns(header)\r\n  if (marks.length === 0) return []\r\n  const blockRows = rowsBetween(rows, header.y, endY)\r\n  const stories = storyRows(blockRows)\r\n  // 亮녑콏 ?????쇰꺼???녿뒗 ?쒕뒗 鸚㎪쥈 釉붾줉怨?媛숈? ?대갚?쇰줈 ???щ씪?댁뒪 泥섎━?쒕떎 ??\n  // 議곌린 諛섑솚?섎㈃ ?쒓? ?듭㎏濡??뚯씤??遺덇??띾줈 ?щ씪吏꾨떎\r\n  const slices: Array<{\r\n    storyLabel: string | undefined\r\n    startY: number\r\n    endY: number\r\n  }> =\r\n    stories.length > 0\r\n      ? stories.map((story, index) => ({\r\n          storyLabel: story.label,\r\n          startY: story.row.y,\r\n          endY: stories[index + 1]?.row.y ?? endY,\r\n        }))\r\n      : [{ storyLabel: undefined, startY: header.y, endY }]\r\n  // ?섏쭛 李쎌쓣 ?쒖쓽 ?ㅼ젣 ??踰붿쐞濡??ル뒗?? 媛濡?移섏닔???쇰꺼 ???ъ씠濡?醫곴쾶 ?섎━誘濡?\n  // 媛숈? ?몄텧???녿떎\r\n  const tableBottom = tableBottomY(blockRows, marks, endY)\r\n  const blockVerticals = verticalsBySlice(\r\n    verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n    // 留덉?留??щ씪?댁뒪??endY???쒖쓽 ?앹씠 ?꾨땲???ㅼ쓬 ??댄?쨌?섏씠吏 諛붾떏?대떎.\r\n    // 洹몃?濡??먮㈃ 洹?痢듭뿉?쒕쭔 嫄곕━ ?곹븳??痢?媛꾧꺽??紐?諛곕줈 踰뚯뼱吏꾨떎\r\n    slices.map((slice) => ({\r\n      startY: slice.startY,\r\n      endY: Math.min(slice.endY, tableBottom),\r\n    })),\r\n    rowsWithinTable(blockRows, marks),\r\n  )\r\n\r\n  const candidates: SectionCandidate[] = []\r\n  const preTableRows =\r\n    stories.length > 0\r\n      ? rows.filter(\r\n          (row) => row.y > header.y && row.y < stories[0].row.y,\r\n        )\r\n      : []\r\n  for (const [sliceIndex, slice] of slices.entries()) {\r\n    const dataRows = rowsBetween(rows, slice.startY, slice.endY)\r\n    const shapeRow =\r\n      preTableRows\r\n        .filter((row) => exactLabel(row, ['壤®듁??씊']))\r\n        .at(-1) ??\r\n      dataRows.find((row) => exactLabel(row, ['壤®듁??씊']))\r\n    const mainRows = dataRows.filter((row) => exactLabel(row, ['訝사춮']))\r\n    const hoopRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['躍?춮', 'HOOP', '?뺛꺖??]),\r\n    )\r\n    // ?쇰꺼 議댁옱留?蹂대㈃ 媛??멸렇癒쇳듃媛 ?녿뒗 ?쇰꺼 ?됱씠 scalarDimensions ?대갚源뚯?\r\n    // 留됱븘 ?먮Ц 李멸퀬 ?쒖떆媛 ?듭㎏濡??щ씪吏꾨떎 ??鸚㎪쥈 釉붾줉怨?媛숈? 議곌굔???대떎\r\n    const inSliceDimensionRows = dataRows.filter(\r\n      (row) => isDimensionRow(row, ['??씊', 'B횞D', 'b횞D'], marks),\r\n    )\r\n    // ?쇰? 諛쒖＜泥섎뒗 ???됰낫??癒쇱? 怨듯넻 ??씊 ?됱쓣 ?붾떎. ?대떦 ?됱쓣 ?볦튂硫?\n    // 3.5k ?섏튂留??⑥븘 b횞d媛 議곗슜???щ씪吏誘濡? ?щ씪?댁뒪 吏곸쟾??媛??媛源뚯슫\r\n    // ??씊 ?됱쓣 ?곕릺 ?댁쟾 痢듭쓽 ?됱쓣 ?щ윭 媛??욎뼱 ?뺤젙?섏? ?딅뒗??\r\n    const dimensionRows =\r\n      inSliceDimensionRows.length > 0\r\n        ? inSliceDimensionRows\r\n        : preTableRows\r\n            .filter((row) => isDimensionRow(row, ['??씊', 'B횞D', 'b횞D'], marks))\r\n            .slice(-1)\r\n    // ???щ씪?댁뒪??媛숈? ?쇰꺼 ?됱씠 寃뱀쑝濡??덉쑝硫??щ윭 痢?釉붾줉???⑹퀜吏?寃껋씠????\n    // ???쇰꺼???섎굹???몄떇?섏? ?딆? ???뚥??ч쉸?????쇰?留??몄떇??????F???똁1F????\n    // 泥???媛믪쓣 ?뺤젙?섎㈃ ?섎㉧吏 痢?媛믪씠 ?ъ쑀???먮Ц???놁씠 ?щ씪吏꾨떎\r\n    const storyAmbiguous =\r\n      mainRows.length > 1 || hoopRows.length > 1 || dimensionRows.length > 1\r\n    const mainRow = storyAmbiguous ? undefined : mainRows[0]\r\n    const hoopRow = storyAmbiguous ? undefined : hoopRows[0]\r\n    const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n    const positionRow =\r\n      lastPositionRow(rows, header.y, slice.startY) ??\r\n      dataRows.find((row) => exactLabel(row, ['鵝띸쉰']))\r\n    const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n    const mainContinuations = mainRow\r\n      ? barContinuationByMark(dataRows, mainRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const hoopContinuations = hoopRow\r\n      ? barContinuationByMark(dataRows, hoopRow, slice.endY, marks, PITCH_TOKEN)\r\n      : new Map<string, string>()\r\n    // ?ㅼ?移?移섏닔??媛濡쑣룹꽭濡?紐⑤몢 媛숈? ???듭빱濡?諛곗젙?쒕떎 ???쒖そ留?寧?뤇 以묒떖?대㈃\r\n    // 洹몄そ?먯꽌留?醫곸? ?댁썐 移몄씠 媛믪쓣 媛?멸컙??\n    const anchors = markAnchors(marks, positions)\r\n    const rawDimensionValues = storyAmbiguous\r\n      ? new Map<string, string>()\r\n      : dimensionRow\r\n        ? valuesByMark(dimensionRow, ['??씊', 'B횞D', 'b횞D'], marks)\r\n        : shapeRow\r\n          ? sketchColumnHorizontalValues(\r\n              rows,\r\n              header.y,\r\n              shapeRow.y,\r\n              anchors,\r\n            )\r\n          : sketchDimensions(\r\n              rows,\r\n              slice.startY,\r\n              [mainRow, hoopRow],\r\n              anchors,\r\n            )\r\n    const dimensionValues = expandMarkGroups(rawDimensionValues, marks)\r\n    // ??씊 ?쇰꺼 ?됱씠 ?덉쑝硫??몃줈 移섏닔??蹂댁? ?딅뒗?????쇰꺼 ??媛믪씠 ???뺤떎??洹쇨굅??\n    const rawVerticalValues =\r\n      storyAmbiguous || dimensionRow\r\n        ? new Map<string, string>()\r\n        : shapeRow\r\n          ? sketchColumnVerticalValues(\r\n              verticals,\r\n              shapeRow.y,\r\n              anchors,\r\n            )\r\n          : verticalsByMark(blockVerticals[sliceIndex], anchors)\r\n    const verticalValues = expandMarkGroups(rawVerticalValues, marks)\r\n    const mainByPosition =\r\n      mainRow && positions.length > 0\r\n        ? valuesByPosition(mainRow, ['訝사춮'], positions, marks)\r\n        : new Map<string, string>()\r\n    // 鵝띸쉰 ?댁쓣 ?섎굹??諛곗젙諛쏆? 紐삵븳 寧?뤇(DP媛 ??寧?뤇??紐곗븘以 寃쎌슦)?먮룄 ?? ?덈떎 ??\n    // ?대갚 ?놁씠 ?먮㈃ 洹?寧?뤇??訝사춮???뺤젙???먮Ц???댁뒋???놁씠 ?щ씪吏꾨떎\r\n    const mainByMark = mainRow\r\n      ? valuesByMark(mainRow, ['訝사춮'], marks)\r\n      : new Map<string, string>()\r\n    const hoopLabel = hoopRow\r\n      ? exactLabel(hoopRow, ['躍?춮', 'HOOP', '?뺛꺖??])?.compact\r\n      : undefined\r\n    const hoopValues =\r\n      hoopRow && hoopLabel ? valuesByMark(hoopRow, [hoopLabel], marks) : new Map()\r\n\r\n    marks.forEach(({ mark, rawCell }) => {\r\n      if (storyAmbiguous) {\r\n        // 媛??놁씠 ?ъ쑀留??ㅼ? ?꾨낫瑜??④릿?????쒓? 議곗슜???щ씪吏硫??ъ슜?먮뒗\r\n        // ?몄떇 ?ㅽ뙣? 援щ텇?????녿떎. ?롫? 紐??쎌? 寃껉낵 ?롫뒗 ?쎌뿀?쇰굹 ?됱씠 寃뱀씤 寃껋?\r\n        // ?ъ슜?먭? ?먮룄?먯꽌 ?뺤씤??怨녹씠 ?ㅻⅤ誘濡??ъ쑀瑜??섎늿??\n        candidates.push({\r\n          kind: kindFromMark(mark, titleText),\r\n          mark,\r\n          storyLabel: slice.storyLabel,\r\n          raw: { 寧?뤇: rawCell },\r\n          issues: [slice.storyLabel === undefined ? '?롣툖?? : '?끿쎅烏뚪뇥筽?],\r\n        })\r\n        return\r\n      }\r\n      const markPositions = positions\r\n        .map((position, index) => ({ ...position, index }))\r\n        .filter((position) => position.mark === mark)\r\n      const mainCells =\r\n        markPositions.length > 0\r\n          ? markPositions\r\n              .map((position) => ({\r\n                position: position.label,\r\n                raw: mainByPosition.get(String(position.index)),\r\n              }))\r\n              .filter(\r\n                (cell): cell is { position: string; raw: string } =>\r\n                  cell.raw !== undefined,\r\n              )\r\n          : mainByMark.has(mark)\r\n            ? [{ raw: mainByMark.get(mark) as string }]\r\n            : []\r\n      const dimension = dimensionValues.get(mark)\r\n      const hoop = hoopValues.get(mark)\r\n      // ?묓옒 寃?щ낫??癒쇱? ?⑥뼱?⑤━硫? 媛믪씠 ?묓엺 ?섏㎏ 以꾩뿉留??덈뒗 寧?뤇??\n      // ?ъ쑀???먮Ц???놁씠 ?щ씪吏꾨떎 ???묓옒???뚯씫? 寃껋씠 ?덈떎?띿뿉 ?ｋ뒗??\n      if (\r\n        !dimension &&\r\n        mainCells.length === 0 &&\r\n        !hoop &&\r\n        !mainContinuations.has(mark) &&\r\n        !hoopContinuations.has(mark)\r\n      ) {\r\n        return\r\n      }\r\n\r\n      const result: SectionCandidate = {\r\n        kind: kindFromMark(mark, titleText),\r\n        mark,\r\n        storyLabel: slice.storyLabel,\r\n        raw: { 寧?뤇: rawCell },\r\n        issues: [],\r\n      }\r\n      setDimension(result, dimension, true, verticalValues.get(mark))\r\n      const continuation = mainContinuations.get(mark)\r\n      if (continuation !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗??????以꾩쓣 ?먮Ц 李멸퀬濡??④릿??\n        for (const cell of mainCells) {\r\n          const key =\r\n            'position' in cell ? `訝사춮(${cell.position})` : '訝사춮'\r\n          result.raw[key] = cleanedRebarRaw(cell.raw)\r\n        }\r\n        // 泥?以꾩씠 ?꾩삁 ?놁쑝硫??뚯젒? ?덈떎?띻? ?꾨땲?????녿뒗 ?묓옒???뚮━硫?\n        // ?ъ슜?먮뒗 ?먮룄?먯꽌 議댁옱?섏? ?딅뒗 ?섏㎏ 以꾩쓣 李얜뒗??\n        const folded = mainCells.length > 0\r\n        result.raw[folded ? '訝사춮(?섋퓭??' : '訝사춮(?▲꺀?쇻꺂烏?'] =\r\n          cleanedRebarRaw(continuation)\r\n        addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n      } else {\r\n        setColumnMain(result, mainCells, markPositions.length)\r\n      }\r\n      if (hoopLabel) {\r\n        setPitch(result, 'hoop', hoopLabel, hoop, hoopContinuations.get(mark))\r\n      }\r\n      candidates.push(result)\r\n    })\r\n  }\r\n\r\n  return candidates\r\n}\r\n\r\nfunction cellsForMark(\r\n  values: Map<string, string>,\r\n  positions: Array<PositionColumn & { index: number }>,\r\n  mark: string,\r\n): Array<{ position: string; rawPosition: string; raw: string }> {\r\n  return positions\r\n    .filter((position) => position.mark === mark)\r\n    .map((position) => ({\r\n      position: position.label,\r\n      rawPosition: position.rawLabel,\r\n      raw: values.get(String(position.index)),\r\n    }))\r\n    .filter(\r\n      (cell): cell is {\r\n        position: string\r\n        rawPosition: string\r\n        raw: string\r\n      } => cell.raw !== undefined,\r\n    )\r\n}\r\n\r\nfunction cutoffCellsByMark(\r\n  rows: TextRow[],\r\n  positions: PositionColumn[],\r\n  marks: MarkColumn[],\r\n): Map<string, Array<{ position?: string; raw: string }>> {\r\n  const result = new Map<\r\n    string,\r\n    Array<{ position?: string; raw: string }>\r\n  >()\r\n  const positionTargets = positions.map((position, index) => ({\r\n    id: String(index),\r\n    centerX: position.centerX,\r\n  }))\r\n  const markTargets = marks.map(({ mark, centerX }) => ({\r\n    id: mark,\r\n    centerX,\r\n  }))\r\n\r\n  for (const segment of rows.flatMap((row) => row.segments)) {\r\n    // NFKC濡??②쭜 竊삼섹瑜??딂쭜 []???묐릺, raw?먮뒗 ?먮Ц 湲?먮? 洹몃?濡??④릿??\r\n    // ?덉씠 鍮?烏③죱???뚳섶竊썲냵??╉띾뒗 ?レ옄 議곌굔???듦낵?섏? ?딅뒗??\r\n    if (!/^\\[\\d+\\]$/.test(compact(segment.text))) continue\r\n\r\n    const positionIndex = valuesAtTargets(\r\n      [segment],\r\n      positionTargets,\r\n    ).keys().next().value as string | undefined\r\n    const position =\r\n      positionIndex === undefined ? undefined : positions[Number(positionIndex)]\r\n    const mark =\r\n      position?.mark ??\r\n      (valuesAtTargets([segment], markTargets).keys().next().value as\r\n        | string\r\n        | undefined)\r\n    if (mark === undefined) continue\r\n\r\n    const cells = result.get(mark) ?? []\r\n    cells.push({ position: position?.label, raw: segment.text })\r\n    result.set(mark, cells)\r\n  }\r\n\r\n  return result\r\n}\r\n\r\nfunction cutoffFromSupportFace(\r\n  cells: Array<{ position?: string; raw: string }>,\r\n  positions: PositionColumn[],\r\n): number | undefined {\r\n  if (\r\n    cells.length === 0 ||\r\n    !isThreePositionLayout(positions.map(({ label }) => ({ position: label })))\r\n  ) {\r\n    return undefined\r\n  }\r\n\r\n  const leftLabel = positions[0]?.label\r\n  const rightLabel = positions[2]?.label\r\n  if (leftLabel === undefined || rightLabel === undefined) return undefined\r\n\r\n  const values: number[] = []\r\n  for (const cell of cells) {\r\n    if (cell.position !== leftLabel && cell.position !== rightLabel) {\r\n      return undefined\r\n    }\r\n    const match = compact(cell.raw).match(/^\\[(\\d+)\\]$/)\r\n    if (!match) return undefined\r\n    const value = Number(match[1])\r\n    if (!Number.isFinite(value)) return undefined\r\n    values.push(value)\r\n  }\r\n\r\n  const first = values[0]\r\n  return first !== undefined && values.every((value) => value === first)\r\n    ? first\r\n    : undefined\r\n}\r\n\r\nfunction parseGirderBlock(\r\n  rows: TextRow[],\r\n  headerIndex: number,\r\n  endY: number,\r\n  titleText: string,\r\n  verticals: VerticalRun[],\r\n): SectionCandidate[] {\r\n  const header = rows[headerIndex]\r\n  const marks = markColumns(header)\r\n  if (marks.length === 0) return []\r\n  const blockRows = rowsBetween(rows, header.y, endY)\r\n  const stories = storyRows(blockRows)\r\n  const slices =\r\n    stories.length > 0\r\n      ? stories.map((story, index) => ({\r\n          storyLabel: story.label,\r\n          startY: story.row.y,\r\n          endY: stories[index + 1]?.row.y ?? endY,\r\n        }))\r\n      : [{ storyLabel: undefined, startY: header.y, endY }]\r\n  // ??釉붾줉怨?媛숈? ?댁쑀濡??섏쭛 李쎄낵 ?щ씪?댁뒪 ?곹븳???쒖쓽 ?ㅼ젣 ??踰붿쐞濡??ル뒗??\n  const tableBottom = tableBottomY(blockRows, marks, endY)\r\n  const blockVerticals = verticalsBySlice(\r\n    verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n    slices.map((slice) => ({\r\n      startY: slice.startY,\r\n      endY: Math.min(slice.endY, tableBottom),\r\n    })),\r\n    rowsWithinTable(blockRows, marks),\r\n  )\r\n  const candidates: SectionCandidate[] = []\r\n  const preTableRows =\r\n    stories.length > 0\r\n      ? rows.filter(\r\n          (row) => row.y > header.y && row.y < stories[0].row.y,\r\n        )\r\n      : []\r\n\r\n  for (const [sliceIndex, slice] of slices.entries()) {\r\n    const dataRows = rowsBetween(rows, slice.startY, slice.endY)\r\n    const inSliceDimensionRows = dataRows.filter(\r\n      (row) => isDimensionRow(row, ['??씊', 'B횞D', 'b횞D', '野멩퀡'], marks),\r\n    )\r\n    const dimensionRows =\r\n      inSliceDimensionRows.length > 0\r\n        ? inSliceDimensionRows\r\n        : preTableRows\r\n            .filter((row) =>\r\n              isDimensionRow(row, ['??씊', 'B횞D', 'b횞D', '野멩퀡'], marks),\r\n            )\r\n            .slice(-1)\r\n    const topRows = dataRows.filter((row) => exactLabel(row, ['訝딁춮', '訝딁ク嶺?]))\r\n    const bottomRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['訝뗧춮', '訝뗧ク嶺?]),\r\n    )\r\n    const stirrupRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['ST', 'STP', 'STP.', '?귙겙?됬춮', '?밤궭?쇈꺀?껁깤']),\r\n    )\r\n    const inSliceSideBarRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['?밭춮']),\r\n    )\r\n    const sideBarRows =\r\n      inSliceSideBarRows.length > 0\r\n        ? inSliceSideBarRows\r\n        : preTableRows\r\n            .filter((row) => exactLabel(row, ['?밭춮']))\r\n            .slice(-1)\r\n    const widthTieRows = dataRows.filter((row) =>\r\n      standaloneLabel(row, ['亮끾?嶺?, '藥얏?嶺?, '亮끾??곭춮']),\r\n    )\r\n    const remarkRows = dataRows.filter((row) => exactLabel(row, ['?숃?]))\r\n    // ??釉붾줉怨?媛숈? 諛⑹뼱 ???쇰꺼 ?됱씠 寃뱀씠硫??щ윭 痢?釉붾줉???⑹퀜吏?寃껋씠??\n    const storyAmbiguous =\r\n      topRows.length > 1 ||\r\n      bottomRows.length > 1 ||\r\n      stirrupRows.length > 1 ||\r\n      sideBarRows.length > 1 ||\r\n      widthTieRows.length > 1 ||\r\n      remarkRows.length > 1 ||\r\n      dimensionRows.length > 1\r\n    const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n    const topRow = storyAmbiguous ? undefined : topRows[0]\r\n    const bottomRow = storyAmbiguous ? undefined : bottomRows[0]\r\n    const stirrupRow = storyAmbiguous ? undefined : stirrupRows[0]\r\n    const sideBarRow = storyAmbiguous ? undefined : sideBarRows[0]\r\n    const widthTieRow = storyAmbiguous ? undefined : widthTieRows[0]\r\n    const remarkRow = storyAmbiguous ? undefined : remarkRows[0]\r\n    const positionRow =\r\n      lastPositionRow(rows, header.y, slice.startY) ??\r\n      dataRows.find((row) => exactLabel(row, ['鵝띸쉰']))\r\n    const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n    const indexedPositions = positions.map((position, index) => ({\r\n      ...position,\r\n      index,\r\n    }))\r\n    const cutoffCells = cutoffCellsByMark(dataRows, positions, marks)\r\n    const dimensionLabel = dimensionRow\r\n      ? exactLabel(dimensionRow, ['??씊', 'B횞D', 'b횞D', '野멩퀡'])?.compact\r\n      : undefined\r\n    // ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ??ojkk 鸚㎪쥈?ゃ궧????洹쇨굅???ㅼ?移?移섏닔肉먯씠??????釉붾줉怨?\n    // 媛숈? ?대갚?쇰줈 媛濡?移섏닔瑜?以띻퀬, ?몃줈(?뚯쟾 臾몄옄??? 吏앹??댁빞 b횞D媛 ?섏삩??\n    const anchors = markAnchors(marks, positions)\r\n    const rawDimensionValues = storyAmbiguous\r\n      ? new Map<string, string>()\r\n      : dimensionRow && dimensionLabel\r\n        ? valuesByMark(dimensionRow, [dimensionLabel], marks)\r\n        : sketchDimensions(\r\n            rows,\r\n            slice.startY,\r\n            [topRow, bottomRow, stirrupRow],\r\n            anchors,\r\n          )\r\n    const dimensionValues = expandMarkGroups(rawDimensionValues, marks)\r\n    // ??씊 ?쇰꺼 ?됱씠 ?덉쑝硫??몃줈 移섏닔??蹂댁? ?딅뒗?????쇰꺼 ??媛믪씠 ???뺤떎??洹쇨굅??\n    const rawVerticalValues =\r\n      storyAmbiguous || dimensionRow\r\n        ? new Map<string, string>()\r\n        : verticalsByMark(blockVerticals[sliceIndex], anchors)\r\n    const verticalValues = expandMarkGroups(rawVerticalValues, marks)\r\n    const topLabel = topRow\r\n      ? exactLabel(topRow, ['訝딁춮', '訝딁ク嶺?])?.compact\r\n      : undefined\r\n    const bottomLabel = bottomRow\r\n      ? exactLabel(bottomRow, ['訝뗧춮', '訝뗧ク嶺?])?.compact\r\n      : undefined\r\n    // ??釉붾줉怨?媛숈? ?대갚 ??鵝띸쉰 ?댁쓣 諛곗젙諛쏆? 紐삵븳 寧?뤇??????④릿??\n    const topByPosition =\r\n      topRow && topLabel && positions.length > 0\r\n        ? valuesByPosition(topRow, [topLabel], positions, marks)\r\n        : new Map<string, string>()\r\n    const topByMark =\r\n      topRow && topLabel\r\n        ? valuesByMark(topRow, [topLabel], marks)\r\n        : new Map<string, string>()\r\n    const bottomByPosition =\r\n      bottomRow && bottomLabel && positions.length > 0\r\n        ? valuesByPosition(bottomRow, [bottomLabel], positions, marks)\r\n        : new Map<string, string>()\r\n    const bottomByMark =\r\n      bottomRow && bottomLabel\r\n        ? valuesByMark(bottomRow, [bottomLabel], marks)\r\n        : new Map<string, string>()\r\n    const stirrupLabel = stirrupRow\r\n      ? exactLabel(stirrupRow, ['ST', 'STP', 'STP.', '?귙겙?됬춮', '?밤궭?쇈꺀?껁깤'])?.compact\r\n      : undefined\r\n    const stirrupValues =\r\n      stirrupRow && stirrupLabel\r\n        ? valuesByMark(stirrupRow, [stirrupLabel], marks)\r\n        : new Map<string, string>()\r\n    const sideBarValues = sideBarRow\r\n      ? valuesByMark(sideBarRow, ['?밭춮'], marks)\r\n      : new Map<string, string>()\r\n    const widthTieLabel = widthTieRow\r\n      ? standaloneLabel(widthTieRow, ['亮끾?嶺?, '藥얏?嶺?, '亮끾??곭춮'])?.compact\r\n      : undefined\r\n    const widthTieValues =\r\n      widthTieRow && widthTieLabel\r\n        ? valuesByMark(widthTieRow, [widthTieLabel], marks)\r\n        : new Map<string, string>()\r\n    const remarkValues = remarkRow\r\n      ? valuesByMark(remarkRow, ['?숃?], marks)\r\n      : new Map<string, string>()\r\n    // ?묓엺 ?(以꾨컮轅? 媛먯? ????釉붾줉怨?媛숈? 諛⑹뼱瑜?訝딁춮/訝뗧춮/?귙겙?됬춮?먮룄 嫄대떎\r\n    const topContinuations = topRow\r\n      ? barContinuationByMark(dataRows, topRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const bottomContinuations = bottomRow\r\n      ? barContinuationByMark(dataRows, bottomRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const stirrupContinuations = stirrupRow\r\n      ? barContinuationByMark(\r\n          dataRows,\r\n          stirrupRow,\r\n          slice.endY,\r\n          marks,\r\n          PITCH_TOKEN,\r\n        )\r\n      : new Map<string, string>()\r\n\r\n    for (const { mark, rawCell } of marks) {\r\n      if (storyAmbiguous) {\r\n        candidates.push({\r\n          kind: kindFromMark(mark, titleText),\r\n          mark,\r\n          storyLabel: slice.storyLabel,\r\n          raw: { 寧?뤇: rawCell },\r\n          issues: [slice.storyLabel === undefined ? '?롣툖?? : '?끿쎅烏뚪뇥筽?],\r\n        })\r\n        continue\r\n      }\r\n      const markPositions = indexedPositions.filter(\r\n        (position) => position.mark === mark,\r\n      )\r\n      const topCells =\r\n        markPositions.length > 0\r\n          ? cellsForMark(topByPosition, indexedPositions, mark)\r\n          : topByMark.has(mark)\r\n            ? [{ position: '?ⓩ뼪??, raw: topByMark.get(mark) as string }]\r\n            : []\r\n      const bottomCells =\r\n        markPositions.length > 0\r\n          ? cellsForMark(bottomByPosition, indexedPositions, mark)\r\n          : bottomByMark.has(mark)\r\n            ? [{ position: '?ⓩ뼪??, raw: bottomByMark.get(mark) as string }]\r\n            : []\r\n      const dimension = dimensionValues.get(mark)\r\n      const stirrup = stirrupValues.get(mark)\r\n      const sideBar = sideBarValues.get(mark)\r\n      // ??釉붾줉怨?媛숈? ?댁쑀 ???묓옒???뚯씫? 寃껋씠 ?덈떎?띿뿉 ?ｋ뒗??\n      if (\r\n        !dimension &&\r\n        topCells.length === 0 &&\r\n        bottomCells.length === 0 &&\r\n        !stirrup &&\r\n        sideBar === undefined &&\r\n        !cutoffCells.has(mark) &&\r\n        !topContinuations.has(mark) &&\r\n        !bottomContinuations.has(mark) &&\r\n        !stirrupContinuations.has(mark)\r\n      ) {\r\n        continue\r\n      }\r\n\r\n      const result: SectionCandidate = {\r\n        kind: kindFromMark(mark, titleText),\r\n        mark,\r\n        storyLabel: slice.storyLabel,\r\n        raw: { 寧?뤇: rawCell },\r\n        issues: [],\r\n      }\r\n      const cutoffMm = cutoffFromSupportFace(\r\n        cutoffCells.get(mark) ?? [],\r\n        markPositions,\r\n      )\r\n      setDimension(result, dimension, false, verticalValues.get(mark))\r\n      const topFold = topContinuations.get(mark)\r\n      const bottomFold = bottomContinuations.get(mark)\r\n      if (topFold !== undefined || bottomFold !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????以꾨뱾???먮Ц 李멸퀬濡??④릿??\n        if (topLabel) {\r\n          for (const cell of topCells) {\r\n            result.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        if (bottomLabel) {\r\n          for (const cell of bottomCells) {\r\n            result.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        // 訝듾툔瑜????ㅼ뿉 紐곕㈃ ?묒そ???묓엺 ?쒖뿉??訝뗧춮 以꾩씠 訝딁춮 以꾩쓣 ??뒗??\r\n        // 躍?춮쨌ST? 媛숈? ?쇰꺼 洹쒖빟?????대뒓 ?됱씠 ?묓삍?붿????④릿??\r\n        // ??釉붾줉怨?媛숈? ?댁쑀濡?泥?以꾩씠 ?녿뒗 履쎌? ?묓옒?대씪 遺瑜댁? ?딅뒗??\n        if (topFold !== undefined) {\r\n          const folded = topCells.length > 0\r\n          result.raw[\r\n            `${topLabel ?? '訝딁춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(topFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n        if (bottomFold !== undefined) {\r\n          const folded = bottomCells.length > 0\r\n          result.raw[\r\n            `${bottomLabel ?? '訝뗧춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(bottomFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n      } else if (topLabel || bottomLabel) {\r\n        // ?쒖そ ?쇰꺼留??몄떇?쇰룄 ?쎌뼱???? ?④릿????setGirderMain??訝듾툔 ?묒そ??\n        // ?붽뎄?섎?濡??뚥말嶺뗤퐤營?쵟?썬띿씠 遺숆퀬, ?뺤젙 ?놁씠 ?먮Ц??蹂댁〈?쒕떎\r\n        setGirderMain(\r\n          result,\r\n          topLabel ?? '訝딁춮',\r\n          bottomLabel ?? '訝뗧춮',\r\n          topCells,\r\n          bottomCells,\r\n          markPositions.length,\r\n        )\r\n      }\r\n      if (cutoffMm !== undefined) result.cutoffFromSupportFaceMm = cutoffMm\r\n      if (stirrupLabel) {\r\n        setPitch(\r\n          result,\r\n          'stirrup',\r\n          stirrupLabel,\r\n          stirrup,\r\n          stirrupContinuations.get(mark),\r\n        )\r\n      }\r\n      setSideBar(result, sideBar)\r\n      setWidthTie(result, widthTieLabel ?? '亮끾?嶺?, widthTieValues.get(mark))\r\n      const remark = remarkValues.get(mark)\r\n      if (remark !== undefined) result.raw.?숃?= compact(remark)\r\n      for (const cell of cutoffCells.get(mark) ?? []) {\r\n        const key = cell.position\r\n          ? `?ャ긿?덀궕??${cell.position})`\r\n          : '?ャ긿?덀궕??\r\n        result.raw[key] = cell.raw\r\n      }\r\n      candidates.push(result)\r\n    }\r\n  }\r\n\r\n  return candidates\r\n}\r\n\r\nfunction parseTableRegion(\r\n  rows: TextRow[],\r\n  anchor: TitleAnchor,\r\n  endY: number,\r\n  xStart: number,\r\n  xEnd: number,\r\n  verticals: Ve