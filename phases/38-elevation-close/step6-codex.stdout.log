GL? 190mm\r\n// 李⑥씠????異뺤쿃(1/100)?먯꽌 5pt?닿퀬, ?꾨㈃??媛숈? ?먮━濡??쏀엺??\r\ndescribe('yokohama p8 (邕며탡??', () => {\r\n  const parsed = parseFrameElevations(readPage('yokohama-p8.json'))\r\n\r\n  it('?꽷룹븘????以꾩쓽 邕며탡?녠? 媛곴컖 怨꾩뿴???쒕떎', () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toHaveLength(2)\r\n  })\r\n\r\n  it('?롩쳵瑜??꾨㈃??移섏닔 洹몃?濡??몃떎 ??1400쨌4100쨌4480쨌2690', () => {\r\n    for (const elevation of parsed.elevations) {\r\n      expect(elevation.heightsMm).toEqual([1400, 4100, 4480, 2690])\r\n      expect(elevation.levels).toHaveLength(5)\r\n    }\r\n  })\r\n\r\n  it('?덈꺼 ?쇰꺼???먮Ц 洹몃?濡??ｊ퀬, 媛숈? ?믪씠???섏? ?????④릿??, () => {\r\n    const labels = parsed.elevations[0].levels.map((level) => level.labels)\r\n    expect(labels[0]).toEqual([])\r\n    expect(labels[1]).toEqual(['訝?ㄾ汝웂CL(麗답툔)'])\r\n    expect(labels[2]).toEqual(['2FL'])\r\n    expect(labels[3]).toContain('訝?ㄾ汝?FL')\r\n    expect(labels[3]).toContain('?뷸틬GL')\r\n    expect(labels[4]).toEqual(['?븀쨴訝뗧ク'])\r\n  })\r\n\r\n  it('移섏닔 ???섎굹媛 ?щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃┛??, () => {\r\n    expect(parsed.elevations[0].titles).toEqual([\r\n      'bY1?싥굤邕며탡??/100',\r\n      'bY2?싥굤邕며탡??/100',\r\n      'bY3?싥굤邕며탡??/100',\r\n    ])\r\n    expect(parsed.elevations[1].titles).toEqual([\r\n      'bY4?싥굤邕며탡??/100',\r\n      'bY5?싥굤邕며탡??/100',\r\n      'bY6?싥굤邕며탡??/100',\r\n    ])\r\n  })\r\n\r\n  it('?좊룄 異뺤쿃? 1/100 遺洹쇱씠?????꾨㈃ ?쒓린媛 ?꾨땲??移섏닔 愿怨꾩뿉???섏삩??, () => {\r\n    for (const elevation of parsed.elevations) {\r\n      expect(elevation.scalePtPerMm).toBeGreaterThan(0.027)\r\n      expect(elevation.scalePtPerMm).toBeLessThan(0.03)\r\n    }\r\n  })\r\n})\r\n\r\n/**\r\n * ?쎌? **紐삵븳??*??寃껊룄 怨좎젙???붾떎. 議곗슜???由?媛믪쓣 ?대뒗 寃껋씠 ???쒗뭹??媛??\n * 紐?寃щ뵒???ㅽ뙣?대?濡? ???꾨㈃ ?뺤떇??遺숈씪 ?????섏씠吏媛 媛묒옄湲??뚯씫?덇린??\n * ?쒖옉?섎㈃ 洹멸쾬???좏샇????臾댁뾿???쏀엳?붿? ?щ엺??遊먯빞 ?쒕떎.\r\n *\r\n * ?먯씤? ?꾩궗 ?ㅻ쪟媛 ?꾨땲??**?좏겙 遺꾨━**?? ???꾨㈃???롩쳵 ?댁? ?꾩뿉?쒕???\n * 1,635쨌3,300쨌450쨌150?몃뜲, 留덉?留??섏쓽 湲??媛꾧꺽??5.6pt濡??レ옄 ?덉そ 媛꾧꺽\r\n * 4.3pt? 嫄곗쓽 媛숈븘 ??5