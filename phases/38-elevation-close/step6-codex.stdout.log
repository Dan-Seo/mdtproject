.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts/perf/blocking-graph.test.mjs\"\r\n  },\r\n  \"dependencies\": {\r\n    \"exceljs\": \"^4.4.0\",\r\n    \"js-yaml\": \"^5.2.3\",\r\n    \"next\": \"^15.5.23\",\r\n    \"pdfjs-dist\": \"6.2.108\",\r\n    \"posthog-js\": \"1.417.4\",\r\n    \"react\": \"^19.2.8\",\r\n    \"react-dom\": \"^19.2.8\",\r\n    \"three\": \"^0.185.1\",\r\n    \"zustand\": \"^5.0.14\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@anthropic-ai/sdk\": \"^0.116.0\",\r\n    \"@lhci/cli\": \"0.15.1\",\r\n    \"@testing-library/jest-dom\": \"^7.0.0\",\r\n    \"@testing-library/react\": \"^16.3.2\",\r\n    \"@types/js-yaml\": \"^4.0.9\",\r\n    \"@types/node\": \"^26.2.0\",\r\n    \"@types/react\": \"^19.2.18\",\r\n    \"@types/react-dom\": \"^19.2.4\",\r\n    \"@types/three\": \"^0.185.4\",\r\n    \"@vitejs/plugin-react\": \"^6.0.5\",\r\n    \"autoprefixer\": \"^10.5.4\",\r\n    \"eslint\": \"^8.57.1\",\r\n    \"eslint-config-next\": \"^15.5.23\",\r\n    \"fake-indexeddb\": \"6.2.5\",\r\n    \"jsdom\": \"^30.0.1\",\r\n    \"postcss\": \"^8.5.26\",\r\n    \"raw-loader\": \"^4.0.2\",\r\n    \"tailwindcss\": \"^3.4.17\",\r\n    \"tsx\": \"^4.23.12\",\r\n    \"typescript\": \"^5.9.3\",\r\n    \"vitest\": \"^4.1.10\"\r\n  },\r\n  \"overrides\": {\r\n    \"posthog-js\": \"1.417.4\"\r\n  }\r\n}\r\n\r\nimport { readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\r\nimport { compact } from '@/lib/import/runs'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\ntype ElevationFixture = {\r\n  heightsMm?: number[]\r\n  levels?: string[]\r\n  levelTexts?: string[]\r\n  elevations: Array<{\n    title?: string\n    titles?: string[]\n    levels?: string[]\n    heightsMm?: number[]\n  }>\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readGolden(file: string): ElevationFixture {\r\n  return JSON.parse(\r\n    readFileSync(\r\n      resolve(process.cwd(), 'tests/fixtures/plan-import/expected', file),\r\n      'utf8',\r\n    ),\r\n  ) as ElevationFixture\r\n}\r\n\r\nfunction elevationForTitle(\r\n  parsed: ReturnType<typeof parseFrameElevations>,\r\n  title: string,\r\n): ReturnType<typeof parseFrameElevations>['elevations'][number] {\r\n  const normalized = compact(title)\r\n  const expectedTitle = normalized.includes('邕며탡??)\r\n    ? normalized\r\n    : `${normalized}邕며탡??\r\n  const matches = parsed.elevations.filter((elevation) =>\n    elevation.titles.some(\n      (candidateTitle) =>\n        candidateTitle === expectedTitle ||\n        candidateTitle.startsWith(`${expectedTitle}S=`),\n    ),\n  )\n  expect(matches).toEqual([expect.anything()])\n  return matches[0]!\n}\n\r\nfunction labelsByLevel(\n  elevation: ReturnType<typeof parseFrameElevations>['elevations'][number],\n): string[][] {\n  return elevation.levels.map((level) => level.labels)\n}\n\nfunction titlesOf(\n  expected: ElevationFixture['elevations'][number],\n): string[] {\n  return (\n    expected.titles ??\n    (expected.title === undefined ? [] : [expected.title])\n  )\n}\n\nfunction expectCorpus2Elevations(\n  pageFile: string,\n  goldenFile: string,\n): ReturnType<typeof parseFrameElevations>['elevations'][] {\n  const golden = readGolden(goldenFile)\n  const parsed = parseFrameElevations(readPage(pageFile))\n\n  expect(parsed.issues).toEqual([])\n  const actualsByExpected = golden.elevations.map((expected) => {\n    const titles = titlesOf(expected)\n    expect(titles).not.toEqual([])\n    return titles.map((title) => elevationForTitle(parsed, title))\n  })\n  const actuals = actualsByExpected.flat()\n\n  // 紐⑤뱺 ?뚯꽌 怨꾩뿴? 怨⑤뱺 ??ぉ?먯꽌 泥?뎄?섏뼱???쒕떎. 怨⑤뱺 ?щ윭 ??ぉ??  // ?섎굹??怨꾩뿴??怨듭쑀?섎뒗 寃쎌슦(?? karatsu X3쨌X4)???덉슜?섎릺,\n  // ?뚯꽌留뚯쓽 誘몄껌援?怨꾩뿴? ?덉슜?섏? ?딅뒗??\n  expect(new Set(parsed.elevations)).toEqual(new Set(actuals))\n\n  for (const [index, expected] of golden.elevations.entries()) {\n    const expectedActuals = actualsByExpected[index]!\n    expect(new Set(expectedActuals)).toEqual(new Set([expectedActuals[0]]))\n\n    const actual = expectedActuals[0]!\n    const expectedHeights = expected.heightsMm ?? golden.heightsMm\n    const expectedLabels = expected.levels ?? golden.levelTexts\n    expect(expectedHeights).toBeDefined()\n    expect(expectedLabels).toBeDefined()\n    expect(actual.heightsMm).toEqual(expectedHeights)\n    expect(labelsByLevel(actual)).toEqual(\n      expectedLabels!.map((label) => [label]),\n    )\n  }\n\n  return actualsByExpected\n}\n\ndescribe('?롩쳵 corpus 2 怨⑤뱺', () => {\n  it('karatsu: 怨⑤뱺??紐⑤뱺 ?쒕ぉ ??ぉ?????怨꾩뿴???믪씠쨌?덈꺼 ?쇰꺼怨??議고븳??, () => {\n    const actualsByExpected = expectCorpus2Elevations(\n      'karatsu-jikugumi1-p1.json',\n      'karatsu-jikugumi1-p1-elevation.json',\n    )\n\n    // 怨⑤뱺??X3쨌X4 ??ぉ? ?꾨㈃??媛숈? 移섏닔 ?댁쓣 怨듭쑀?섎?濡??섎굹??    // ?뚯꽌 怨꾩뿴濡?臾띠뿬???쒕떎. ??愿怨꾨? 怨⑤뱺 ?쒖꽌?먯꽌 吏곸젒 寃利앺븳??\n    expect(actualsByExpected[1]?.[0]).toBe(actualsByExpected[2]?.[0])\n  })\n\n  it('tsu: p21??紐⑤뱺 ?쒕ぉ 怨꾩뿴???꾩껜 怨⑤뱺 ?믪씠쨌?덈꺼 ?쇰꺼怨??議고븳??, () => {\n    expectCorpus2Elevations(\n      'tsu-p21.json',\n      'tsu-kanritou-p21-elevation.json',\n    )\n  })\n\n  it('tsu: p22??紐⑤뱺 ?쒕ぉ 怨꾩뿴???꾩껜 怨⑤뱺 ?믪씠쨌?덈꺼 ?쇰꺼怨??議고븳??, () => {\n    expectCorpus2Elevations(\n      'tsu-p22.json',\n      'tsu-kanritou-p22-elevation.json',\n    )\n  })\n\n  it('hirosaki: 怨⑤뱺??紐⑤뱺 ?쒕ぉ 怨꾩뿴???믪씠쨌?덈꺼 ?쇰꺼怨??議고븳??, () => {\n    expectCorpus2Elevations(\n      'hirosaki-p25.json',\n      'hirosaki-kikyono-p25-elevation.json',\n    )\n  })\n})\n\r\nimport { recoverRows, verticalRuns } from '../runs'\r\nimport type { TextPage } from '../section-list/types'\r\n\r\nimport type {\r\n  ElevationCandidate,\r\n  ElevationIssue,\r\n  ElevationLevel,\r\n  ParsedFrameElevations,\r\n} from './types'\r\n\r\n/**\r\n * 邕며탡?녹쓽 ?믪씠 諛⑺뼢???띿뒪???덉씠?대쭔?쇰줈 蹂듭썝?쒕떎 (ADR-030).\r\n *\r\n * 鴉뤷쎋? ?щ━ ?쇰꺼 諛대뱶瑜??듭빱濡??????녿떎 ???ㅻЪ yokohama p8???덈꺼 ?쇰꺼?\r\n * 醫뚮떒 x媛 108~198濡??⑹뼱吏怨?以묒떖 x??123~221濡??⑹뼱吏꾨떎(湲???섏뿉 ?곕씪\r\n * ?ㅼ뿬?곌린媛 ?щ씪吏꾨떎). ???移섏닔 ?댁? x媛 ??媛믪쑝濡?怨㏐쾶 ?좊떎.\r\n *\r\n * 洹몃옒???듭빱??移섏닔 ?댁씠怨? ?뚯튂?섎뒗 ?먭린媛 ?щ뒗 援ш컙??以묒젏???볦씤?ㅳ띾뒗\r\n * 愿怨꾨줈 異뺤쿃怨??덈꺼 ?꾩튂瑜??④퍡 ?쇰떎. ?몄젒 ??移섏닔 v0쨌v1??媛꾧꺽?\r\n * (v0+v1)/2 횞 異뺤쿃?대?濡? 異뺤쿃? ?꾨㈃ ?쒓린瑜?誘우? ?딄퀬 ?ш린???좊룄?쒕떎.\r\n */\r\n\r\nconst DIMENSION_PATTERN = /^(?:\\d{1,3}(?:,\\d{3})+|\\d{2,})$/\r\nconst ELEVATION_TITLE_PATTERN = /邕며탡/\r\n/** 移섏닔 ?대줈 蹂대뒗 x ?덉슜?ㅼ감(pt). ?ㅻЪ p8???댁? x媛 ??媛믪쑝濡?怨㏓떎 */\r\nconst COLUMN_TOLERANCE_PT = 4\r\n/** ?덈꺼 ?쇰꺼怨????덈꺼 ?꾩튂???닿툔???덉슜(pt). ?ㅻЪ 理쒕? 4.1pt */\r\nconst LEVEL_TOLERANCE_PT = 15\r\n/**\n * ?덈꺼 ?쇰꺼 ?꾨낫瑜?李얜뒗 媛濡?李?pt) ??移섏닔 ??以묒떖?먯꽌??嫄곕━.\n *\n * ??李쎌쑝濡??꾨낫瑜?嫄곕Ⅸ ??`isLevelLabel` ?붿씠?몃━?ㅽ듃?\n * y ?쒖꽌 而ㅼ꽌 留ㅼ묶???덈꺼 ?덉슜 踰붿쐞瑜??곸슜?쒕떎. x 諛⑺뼢 ??援곗쭛? ?ъ슜?섏?\n * ?딅뒗?? 移섏닔 ?닿낵 ?ㅼ젣 ?덈꺼 ?쇰꺼??x媛 ?꾨㈃留덈떎 ?щ씪吏????덇린 ?뚮Ц?대떎.\n *\n * ?ㅻЪ kani p40?먯꽌 洹??쇱씠 ?쇱뼱?щ떎 ???꽷룹븘????邕며탡?녹쓽 **?꾩껜 移섏닔**\n * 5,535 ?섏씠 ???대줈 ?댁뼱??異뺤쿃??3諛곕줈 ?섏솕?붾뜲, 李쎌씠 150pt?대뜕 ?숈븞?먮뒗\n * 128pt ?⑥뼱吏?**?싥굤???쇰꺼 `Y1`**???덈꺼 ?쇰꺼濡?二쇱썙 寃利앹쓣 ?듦낵?덈떎.\n * 吏湲?洹??ㅼ씤??留됰뒗 寃껋? ??援곗쭛???꾨땲??`isLevelLabel` ?붿씠?몃━?ㅽ듃??\n *\n * ?ㅼ륫???쇰꺼 嫄곕━??yokohama p8??理쒕? 62pt, kani p40??理쒕? 67pt?? 80?\n * 洹??꾩씠怨?128 ?꾨옒?? ??踰뚯뼱吏???꾨㈃? 鍮??꾨낫濡??ㅽ뙣?쒕떎 (R10).\n */\nconst LABEL_WINDOW_PT = 80\n/** 怨꾩뿴???댁뼱吏?붿? 蹂대뒗 異뺤쿃 ?몄감. 鴉뤷쎋 ?뚯꽌? 媛숈? 媛믪씠??*/\nconst SCALE_TOLERANCE_RATIO = 0.03\n/** ?쇰꺼??遺숈? ?덈꺼???대낫???곸쑝硫?怨꾩뿴濡?蹂댁? ?딅뒗????遺遺?移섏닔 ?닿낵???좎씪??援щ텇 */\r\nconst MINIMUM_LABELLED_LEVELS = 2\r\n/**\r\n * 吏㏃? 援ш컙? 移섏닔 ?쒓린媛 援ш컙 以묒젏?먯꽌 踰쀬뼱?섍린 ?쎈떎. 湲곗〈 ?곗뇙媛 異⑸텇??湲멸퀬,\r\n * ?ㅼ쓬 移섏닔媛 ?욎꽑 媛믩뱾??以묒븰媛믩낫????鍮꾩쑉蹂대떎 ?묒쑝硫?洹?移섏닔瑜??곗뇙??蹂댁〈?쒕떎.\r\n * ?대뒗 洹쒖?媛믪씠 ?꾨땲??PDF ?띿뒪??諛곗튂 ?먯젙?대떎.\r\n */\r\nconst SHORT_DIMENSION_RATIO = 0.25\r\n/**\r\n * 吏㏃? 移섏닔 ?ㅼ쓽 ?ㅼ쓬 ?レ옄????씠 ?ㅻⅨ 移섏닔 ?댁뿉 ?볦씪 ???덈떎. 湲곗〈 ?덈꺼 ?쇰꺼\r\n * 李쎌뿉???좊룄??踰붿쐞 ?덉뿉?쒕쭔 ???대룞???덉슜?쒕떎 ???뚯씪紐낅퀎 x 醫뚰몴瑜??곗? ?딅뒗??\r\n */\r\nconst SHORT_TAIL_COLUMN_WINDOW_PT = LABEL_WINDOW_PT / 4\r\n/**\n * 吏㏃? 移섏닔???띿뒪?몃뒗 ?먭린 援ш컙??醫곸븘 以묒젏?먯꽌 諛由????덈떎. ???덉슜鍮꾨뒗\n * 洹?諛由쇱씠 湲곕? 媛꾧꺽 ?먯껜瑜??섏? ?딅뒗吏 ?먯젙?쒕떎 ??吏㏃? 移섏닔 怨듯넻 洹쒖튃?대떎.\n * 肄뷀띁?ㅼ뿉???ㅼ젣濡?吏㏃? 移섏닔 遺꾧린媛 諛쒕룞??媛믪? tsu 150mm(?몄감 0.176)?\n * tsu 1170mm(?몄감 0.4879/0.4906)?닿퀬, ?덈씫?쒗궎??寃쎌웳 瑗щ━ ?꾨낫??hirosaki?? * 30mm(?몄감 4.33??.33)?? 0.5??0.0?먯꽌 36硫?異쒕젰? 紐⑤몢 媛숈븯?쇰?濡?\n * ?ㅼ륫 理쒕뙎媛믪뿉 留욎텛吏 ?딄퀬 洹?援ш컙 ?덉뿉???살씠 ?덈뒗 1.0???ъ슜?쒕떎.\n */\nconst SHORT_DIMENSION_SCALE_TOLERANCE_RATIO = 1.0\n/**\r\n * 怨꾩뿴???섎젮硫?移섏닔媛 ?대쭔???덉뼱???쒕떎.\r\n *\r\n * **?섎줈??諛섏쬆?????쒕떎.** 移섏닔 ??媛쒕뒗 異뺤쿃???섎굹 ?좊룄?섎뒗?? ?좊룄??媛믪씠\r\n * ?먭린 ?먯떊怨??닿툔???섎뒗 ?놁쑝誘濡?異뺤쿃 ?쇨???寃?ш? 怨듯쉶?꾪븳?? 洹몃윭硫??⑤뒗\r\n * 利앷굅???쇰꺼 ?쇱튂肉먯씤?? 湲?먭? 鍮쎈뭣???꾨㈃?먯꽌??洹멸쾬??**?곗뿰??* 留욌뒗????\n * ?ㅻЪ kani p40?먯꽌 ?꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔(5,535 ?? 75 ??媛 ???대줈\r\n * ?댁뼱??異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???덈꺼 ?먮━??留덉묠 湲?먭? ?덉뼱\r\n * ??踰????듦낵?덈떎.\r\n *\r\n * ?뗭씠硫?異뺤쿃?????좊룄?섏뼱 ?쒕줈瑜?諛섏쬆?????덇퀬, 洹?寃?ш? ????寃쎌슦瑜?\n * 紐⑤몢 ?〓뒗?? ?媛濡?移섏닔媛 ?섎퓧??邕며탡??3?덈꺼)???쎌? ?딅뒗????吏?대궡??\n * 寃껊낫???ル떎 (R10).\r\n */\r\nconst MINIMUM_CHAIN_DIMENSIONS = 3\r\n\r\ninterface Token {\r\n  text: string\r\n  x: number\r\n  y: number\r\n  leftX: number\r\n  rightX: number\r\n}\r\n\r\ninterface DimensionToken extends Token {\r\n  valueMm: number\r\n}\r\n\r\nfunction tokens(page: TextPage): Token[] {\r\n  const collected: Token[] = []\r\n  for (const row of recoverRows(page.items)) {\r\n    for (const segment of row.segments) {\r\n      collected.push({\r\n        text: segment.compact,\r\n        x: segment.centerX,\r\n        y: segment.centerY,\r\n        leftX: segment.x,\r\n        rightX: segment.endX,\r\n      })\r\n    }\r\n  }\r\n  for (const run of verticalRuns(page.items)) {\r\n    collected.push({\r\n      text: run.text,\r\n      x: run.x,\r\n      y: run.y,\r\n      leftX: run.x,\r\n      rightX: run.x,\r\n    })\r\n  }\r\n  return collected\r\n}\r\n\r\nfunction median(values: number[]): number {\r\n  return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\r\n}\r\n\r\nfunction dimensionScale(left: DimensionToken, right: DimensionToken): number {\r\n  return (\r\n    (2 * (right.y - left.y)) /\r\n    (left.valueMm + right.valueMm)\r\n  )\r\n}\r\n\r\nfunction chainScales(chain: DimensionToken[]): number[] {\r\n  return chain.slice(1).map((dimension, i) =>\r\n    dimensionScale(chain[i], dimension),\r\n  )\r\n}\r\n\r\nfunction isShortDimension(\r\n  dimension: DimensionToken,\r\n  previous: DimensionToken[],\r\n): boolean {\r\n  return (\r\n    previous.length >= MINIMUM_CHAIN_DIMENSIONS &&\r\n    dimension.valueMm < median(previous.map((entry) => entry.valueMm)) *\r\n      SHORT_DIMENSION_RATIO\r\n  )\r\n}\r\n\r\n/** 移섏닔瑜?x媛 怨㏐쾶 ???대줈 臾띕뒗??*/\r\nfunction dimensionColumns(dimensions: DimensionToken[]): DimensionToken[][] {\r\n  const sorted = [...dimensions].sort((a, b) => a.x - b.x || a.y - b.y)\r\n  const columns: DimensionToken[][] = []\r\n\r\n  for (const token of sorted) {\r\n    const column = columns.at(-1)\r\n    if (column && Math.abs(column[0].x - token.x) <= COLUMN_TOLERANCE_PT) {\r\n      column.push(token)\r\n    } else {\r\n      columns.push([token])\r\n    }\r\n  }\r\n\r\n  return columns.map((column) => [...column].sort((a, b) => a.y - b.y))\r\n}\r\n\r\nfunction horizontalDistance(token: Token, x: number): number {\r\n  if (token.rightX < x) return x - token.rightX\r\n  if (token.leftX > x) return token.leftX - x\r\n  return 0\r\n}\r\n\r\nfunction labelText(token: Token): string | undefined {\n  const text = token.text.replace(/^[?썩뼰?꿎뼹]+/, '')\n  return text.length > 0 ? text : undefined\n}\n\n/**\n * 36硫??쒕쿋?댁뿉??愿痢≫븳 ?덈꺼 ?쇰꺼???붿씠?몃━?ㅽ듃??\n *\n * `SL` 怨꾩뿴? ?ｌ? ?딅뒗?? tsu-p21??`1SL`? `1FL`怨?媛숈? ?믪씠???볦?怨?\n * 洹??꾨㈃???덈꺼 ?대쫫 泥닿퀎??FL/GL?대떎. ?ш린??`SL`???ｌ쑝硫????덈꺼?? * ???쇰꺼???앷릿?? SL??吏?먰븯?ㅻ㈃ 癒쇱? 洹??꾨㈃ 怨꾩뿴??怨⑤뱺???꾩슂?섎떎.\n *\n * ???먯젙? ?묐??닿? ?ы븿??臾몄옄?대룄 ?듦낵?쒗궎誘濡? 36硫댁뿉?? * `?삣읃鹽롦쥈鸚⑴ク?뗣굢1FL?얇겎??돀罌쀣걮?ⓦ걲?뗣??대굹\n * `??똻?곁썶??갍L-900餓δ툔??선窯ⓨ뙑?긷킋略⒴광?ⓦ걲?? 媛숈? 臾몄옣???듦낵?쒕떎.\n * ?쒕쿋?댁뿉????臾몄옣?ㅼ? `LABEL_WINDOW_PT`? ?덈꺼 ?꾩튂 ?덉슜 踰붿쐞 諛뽰씠?? * 寃곌낵???우? ?딆븯?? ?ш린??臾몄옣 諛곗젣 洹쒖튃???덈줈 留뚮뱾吏 ?딅뒗?? ?꾩옱\n * 肄뷀띁?ㅻ뒗 洹?洹쒖튃???④낵瑜?諛섏쬆?????녾퀬, 洹?洹쇨굅??R10???꾩냽 怨쇱젣??\n */\nfunction isLevelLabel(text: string): boolean {\n  return /(?:FL|GL|RCL|(?:鸚⑴ク|訝뗧ク|訝딁ク)$)/.test(text)\n}\n\r\n/**\n * ???댁쓣 異뺤쿃???댁뼱吏??理쒕? 援ш컙?쇰줈 ?섎늿?? 媛숈? ?댁뿉 ?꽷룹븘????邕며탡?녠?\r\n * ?ㅻ━硫??ㅻЪ p8) 洹??ъ씠?먯꽌 ?좊룄 異뺤쿃???ш쾶 ?꾨떎 ???댁쓣 ?듭㎏濡?踰꾨━吏 ?딄퀬\r\n * 洹??먮━?먯꽌 ?먮Ⅸ??\r\n */\r\nfunction chains(column: DimensionToken[]): DimensionToken[][] {\r\n  const result: DimensionToken[][] = []\r\n  let current: DimensionToken[] = []\r\n  let reference: number | undefined\r\n\r\n  for (let i = 0; i + 1 < column.length; i++) {\r\n    const scale = dimensionScale(column[i], column[i + 1])\r\n    const continues =\r\n      reference !== undefined &&\r\n      Math.abs(scale / reference - 1) <= SCALE_TOLERANCE_RATIO\r\n    const shortDimension =\n      current.length >= MINIMUM_CHAIN_DIMENSIONS &&\n      isShortDimension(column[i + 1], current) &&\n      reference !== undefined &&\n      Math.abs(scale / reference - 1) <=\n        SHORT_DIMENSION_SCALE_TOLERANCE_RATIO\n\n    if (continues || shortDimension) {\r\n      current.push(column[i + 1])\r\n    } else {\r\n      if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\r\n      current = [column[i], column[i + 1]]\r\n      reference = scale\r\n    }\r\n  }\r\n  if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\r\n\r\n  return result\r\n}\r\n\r\n/**\r\n * 吏㏃? 援ш컙 ?ㅼ쓽 留덉?留?移섏닔??媛숈? 二쇱꽍 ?댁쓽 ??씠 ?ㅻⅨ ?꾩튂???볦씪 ???덈떎.\r\n * 媛숈? x ?대쭔 怨좎쭛?섎㈃ Tsu??1170怨?Hirosaki??2310???덈씫?쒕떎. 癒쇱? ?곗뇙?먯꽌\r\n * ?좊룄??異뺤쿃怨?媛??媛源뚯슫 ?ㅼ쓬 ?レ옄 ?섎굹瑜?怨좊Ⅴ怨? x ?대룞쨌媛꾧꺽쨌異뺤쿃??紐⑤몢\r\n * 留뚯”???뚮쭔 遺숈씤?? ?≪쓬 ?レ옄瑜???쒓컪?쇰줈 怨좊Ⅴ吏 ?딅룄濡??꾨낫媛 ?놁쑝硫?硫덉텣??\r\n */\r\nfunction extendShortTail(\r\n  chain: DimensionToken[],\r\n  dimensions: DimensionToken[],\r\n): DimensionToken[] {\r\n  const extended = [...chain]\r\n  const used = new Set(chain)\r\n\r\n  while (extended.length >= MINIMUM_CHAIN_DIMENSIONS) {\r\n    const last = extended.at(-1)\r\n    if (!last || !isShortDimension(last, extended.slice(0, -1))) break\r\n\r\n    const scales = chainScales(extended)\r\n    if (scales.length === 0) break\r\n    const scale = median(scales)\r\n    const chainX = median(extended.map((entry) => entry.x))\r\n    const candidates = dimensions\r\n      .filter((candidate) => {\r\n        if (used.has(candidate) || candidate.y <= last.y) return false\r\n        if (\r\n          Math.abs(candidate.x - chainX) > SHORT_TAIL_COLUMN_WINDOW_PT\r\n        ) {\r\n          return false\r\n        }\r\n\r\n        const gap = candidate.y - last.y\r\n        if (gap > LABEL_WINDOW_PT) return false\r\n        const expectedGap =\n          ((last.valueMm + candidate.valueMm) / 2) * scale\n        if (expectedGap <= 0) return false\n        return (\n          Math.abs(gap / expectedGap - 1) <=\n          SHORT_DIMENSION_SCALE_TOLERANCE_RATIO\n        )\n      })\n      .sort((left, right) => {\r\n        const leftGap = left.y - last.y\r\n        const rightGap = right.y - last.y\r\n        const leftExpected =\r\n          ((last.valueMm + left.valueMm) / 2) * scale\r\n        const rightExpected =\r\n          ((last.valueMm + right.valueMm) / 2) * scale\r\n        return (\r\n          Math.abs(leftGap / leftExpected - 1) -\r\n            Math.abs(rightGap / rightExpected - 1) ||\r\n          leftGap - rightGap\r\n        )\r\n      })\r\n\r\n    const next = candidates[0]\r\n    if (!next) break\r\n    extended.push(next)\r\n    used.add(next)\r\n  }\r\n\r\n  return extended\r\n}\r\n\r\nfunction levelsOf(\r\n  chain: DimensionToken[],\r\n  scale: number,\r\n): Array<{ positionPt: number }> {\r\n  const first = chain[0].y - (chain[0].valueMm * scale) / 2\r\n  const positions = [first]\r\n  for (const dimension of chain) {\r\n    positions.push(positions[positions.length - 1] + dimension.valueMm * scale)\r\n  }\r\n  return positions.map((positionPt) => ({ positionPt }))\r\n}\r\n\r\nfunction verticalExtent(elevation: ElevationCandidate): {\r\n  top: number\r\n  bottom: number\r\n} {\r\n  return {\r\n    top: elevation.levels[0].positionPt,\r\n    bottom: elevation.levels[elevation.levels.length - 1].positionPt,\r\n  }\r\n}\r\n\r\n/**\r\n * ?몃줈 踰붿쐞媛 寃뱀튂??怨꾩뿴? **媛숈? 援ш컙???쒕줈 ?ㅻⅨ ?쎄린**?????ㅻЪ p8?먯꽌??\n * ?롩쳵 ??1400쨌4100쨌4480쨌2690) ?놁뿉 ?ⓨ늽 移섏닔 ??190쨌150쨌2350)???섎????쒓퀬,\r\n * 洹?遺遺??대룄 洹쇱쿂 ?쇰꺼 ?섏쓣 二쇱썙 怨꾩뿴??議곌굔??留뚯”?쒕떎. ?????대㈃ ?ъ슜?먯뿉寃?\n * ?쒕줈 ?닿툔?섎뒗 ?롩쳵媛 ?숈떆??蹂댁씤??\r\n *\r\n * 媛???볤쾶 ?쎌? 寃??섎굹留??④릿?? ?롩쳵 ?댁? 邕며탡?녹쓽 ?믪씠 ?꾩껜瑜??ш퀬\r\n * 遺遺??댁? 援?냼?곸씠?? ?몃줈 踰붿쐞媛 洹??섏쓣 媛???ш쾶 媛덈씪 ?볥뒗???ㅻЪ?먯꽌\r\n * 359pt ? 38쨌52pt). ?꾨㈃ ?뺤떇?????꾩젣瑜?源⑤㈃ 怨꾩뿴???섎굹 ?щ씪吏怨?\r\n * 媛믪쓣 吏?대궡??????ъ슜?먭? ?먯쑝濡??ｋ뒗??(R10).\r\n */\r\nfunction withoutOverlaps(\r\n  elevations: ElevationCandidate[],\r\n): ElevationCandidate[] {\r\n  const ranked = [...elevations].sort((a, b) => {\r\n    const left = verticalExtent(a)\r\n    const right = verticalExtent(b)\r\n    return (\r\n      right.bottom - right.top - (left.bottom - left.top) ||\r\n      b.levels.length - a.levels.length\r\n    )\r\n  })\r\n\r\n  const kept: ElevationCandidate[] = []\r\n  for (const elevation of ranked) {\r\n    const range = verticalExtent(elevation)\r\n    const overlaps = kept.some((accepted) => {\r\n      const other = verticalExtent(accepted)\r\n      return range.top <= other.bottom && other.top <= range.bottom\r\n    })\r\n    if (!overlaps) kept.push(elevation)\r\n  }\r\n\r\n  return kept\r\n}\r\n\r\nexport function parseFrameElevations(page: TextPage): ParsedFrameElevations {\r\n  const collected = tokens(page)\r\n\r\n  const dimensions: DimensionToken[] = []\r\n  const labels: Token[] = []\r\n  const titles: Token[] = []\r\n  for (const token of collected) {\r\n    if (DIMENSION_PATTERN.test(token.text)) {\r\n      dimensions.push({\r\n        ...token,\r\n        valueMm: Number.parseInt(token.text.replaceAll(',', ''), 10),\r\n      })\r\n      continue\r\n    }\r\n    if (ELEVATION_TITLE_PATTERN.test(token.text)) {\r\n      titles.push(token)\r\n      continue\r\n    }\r\n    labels.push(token)\r\n  }\r\n\r\n  const elevations: ElevationCandidate[] = []\r\n  for (const column of dimensionColumns(dimensions)) {\r\n    for (const baseChain of chains(column)) {\r\n      const chain = extendShortTail(baseChain, dimensions)\r\n      const scales = chainScales(chain)\r\n      const scale = median(scales)\r\n      const positions = levelsOf(chain, scale)\r\n\r\n      // ?쇰꺼? y ?ㅻ쫫李⑥닚?쇰줈 ?꾩쭅 遺숈? ?딆? 泥??덈꺼??遺숈씤?? ?덉슜 踰붿쐞媛\n      // 寃뱀튂??醫곸? 援ш컙?먯꽌???꾨㈃???쒖꽌瑜?蹂댁〈?섍퀬, ?ㅼ쓬 ?덈꺼???놁쓣 ?뚮쭔\n      // 吏곸쟾 ?덈꺼??以묒꺽?쒕떎.\n      const levels: ElevationLevel[] = positions.map(({ positionPt }) => ({\r\n        labels: [],\r\n        positionPt,\r\n      }))\n      const labelsAtLevels: Token[][] = levels.map(() => [])\n      const labelCandidates = labels.filter(\n        (label) => horizontalDistance(label, chain[0].x) <= LABEL_WINDOW_PT,\n      ).sort((left, right) => left.y - right.y || left.x - right.x)\n      let cursor = 0\n      for (const label of labelCandidates) {\n        const text = labelText(label)\n        if (text === undefined || !isLevelLabel(text)) continue\n\n        let matchedIndex = -1\n        for (let index = cursor; index < levels.length; index++) {\n          if (\n            Math.abs(levels[index].positionPt - label.y) <=\n            LEVEL_TOLERANCE_PT\n          ) {\n            matchedIndex = index\n            break\n          }\n        }\n        if (matchedIndex < 0 && cursor > 0) {\n          const previousIndex = cursor - 1\n          if (\n            Math.abs(levels[previousIndex].positionPt - label.y) <=\n            LEVEL_TOLERANCE_PT\n          ) {\n            matchedIndex = previousIndex\n          }\n        }\n        if (matchedIndex < 0) {\n          continue\n        }\n        labelsAtLevels[matchedIndex].push(label)\n        cursor = matchedIndex + 1\n      }\n\r\n      for (let i = 0; i < levels.length; i++) {\r\n        levels[i].labels = (labelsAtLevels[i] ?? [])\r\n          .sort((left, right) => left.y - right.y || left.x - right.x)\r\n          .flatMap((label) => {\r\n            const text = labelText(label)\r\n            return text === undefined ? [] : [text]\r\n          })\r\n      }\r\n\r\n      const labelled = levels.filter((level) => level.labels.length > 0).length\r\n      if (labelled < MINIMUM_LABELLED_LEVELS) continue\r\n\r\n      elevations.push({\r\n        titles: [],\r\n        levels,\r\n        heightsMm: chain.map((dimension) => dimension.valueMm),\r\n        scalePtPerMm: scale,\r\n      })\r\n    }\r\n  }\r\n\r\n  const overlapFree = withoutOverlaps(elevations)\r\n  overlapFree.sort((a, b) => a.levels[0].positionPt - b.levels[0].positionPt)\r\n\r\n  // ?쒕ぉ? 怨꾩뿴??遺숈씤??????怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃━誘濡?\n  // (?ㅻЪ p8? 醫뚮떒 移섏닔 ???섎굹??bY1쨌bY2쨌bY3 ???? 1:1???꾨땲??\r\n  //\r\n  // ?⑥닚 理쒓렐?묒씠 ?꾨땲??**?쒕ぉ ?꾩뿉 ?덈뒗 怨꾩뿴???곗꽑?쒕떎.** 邕며탡?녹쓽 罹≪뀡?\r\n  // 洹몃┝ ?꾨옒???곹엳?붾뜲(?ㅻЪ p8??6???꾨?), ??洹몃┝??罹≪뀡? ??洹몃┝???섎떒怨?\n  // ?꾨옒 洹몃┝???곷떒?먯꽌 嫄곗쓽 媛숈? 嫄곕━???볦씤??p8 ?ㅼ륫 170.4pt ? 167.7pt) ??\n  // ?⑥닚 理쒓렐?묒? ??移쇰걹?먯꽌 媛덈━怨? ?ㅼ젣濡?VerticalRun.y 洹쒖빟 ?뺤젙(?뭮/2)??\n  // 洹??먯젙???ㅼ쭛????怨꾩뿴???쒕ぉ 0?μ쑝濡??щ씪議뚮떎. ?꾩뿉 怨꾩뿴???섎굹???놁쓣\r\n  // ?뚮쭔(罹≪뀡??洹몃┝ ?꾩뿉 ?덈뒗 ?뺤떇) ?꾨옒?먯꽌 理쒓렐?묒쓣 李얜뒗??\r\n  for (const title of titles) {\r\n    let above: ElevationCandidate | undefined\r\n    let aboveDistance = Number.POSITIVE_INFINITY\r\n    let below: ElevationCandidate | undefined\r\n    let belowDistance = Number.POSITIVE_INFINITY\r\n    for (const elevation of overlapFree) {\r\n      const top = elevation.levels[0].positionPt\r\n      const bottom = elevation.levels[elevation.levels.length - 1].positionPt\r\n      if (title.y >= top) {\r\n        const distance = title.y > bottom ? title.y - bottom : 0\r\n        if (distance < aboveDistance) {\r\n          above = elevation\r\n          aboveDistance = distance\r\n        }\r\n      } else {\r\n        const distance = top - title.y\r\n        if (distance < belowDistance) {\r\n          below = elevation\r\n          belowDistance = distance\r\n        }\r\n      }\r\n    }\r\n    ;(above ?? below)?.titles.push(title.text)\r\n  }\r\n\r\n  // 邕며탡?녹쓽 ?믪씠 怨꾩뿴? 邕며탡?녹뿉 ?랁븳?????쒕ぉ??遺숈? ?딆? 移섏닔 ?댁? 洹멸쾬??\n  // 臾댁뾿???믪씠?몄? 留먰븷 ???녿떎. ?ㅻЪ yokohama ??18履쎌쓣 ?듦낵?쒗궎硫?**?계나?긺듁??*媛\r\n  // 嫄몃┛??源딆씠 ?レ옄媛 ?댁쓣 ?대（怨??놁뿉 ?쇰꺼???좊떎) ??洹멸쾬???롩쳵濡??대㈃\r\n  // ?ъ슜?먯뿉寃??덉????딆? 痢듭씠 蹂댁씤??\n  const resolved = overlapFree.filter((elevation) => elevation.titles.length > 0)\r\n\r\n  if (resolved.length === 0) {\r\n    return { elevations: [], issues: ['野멩퀡?쀦쑋濾쒎눣'] }\r\n  }\r\n\r\n  const issues: ElevationIssue[] = []\r\n  return { elevations: resolved, issues }\r\n}\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { TextItem } from '../types'\r\nimport type { TextPage } from '../section-list/types'\r\n\r\nimport { parseFrameElevations } from './elevation'\r\n\r\n// ?ㅻЪ ?꾨㈃ ?쎌뒪泥??議곕뒗 tests/plan-import/elevation.test.ts???덈떎.\r\n\r\nfunction h(str: string, x: number, y: number): TextItem {\r\n  return { str, x, y, w: 0, h: 8 }\r\n}\r\n\r\nconst VERTICAL_GLYPH_WIDTH_PT = 8\r\n\r\n/** ?몃줈?곌린 移섏닔. 邕며탡?녹쓽 ?롩쳵 移섏닔???ㅻЪ?먯꽌 rot=-90?대떎.\r\n *  ?몄옄 y??臾몄옄?댁쓽 臾쇰━ 以묒떖?닿퀬, TextItem.y(?먯젏)??吏꾪뻾??w???덈컲留뚰겮\r\n *  洹??꾨옒????VerticalRun.y媛 諛붿슫??諛뺤뒪 以묒떖?대씪?쒕떎 (runs.ts) */\r\nfunction v(str: string, x: number, y: number): TextItem {\r\n  return {\r\n    str,\r\n    x,\r\n    y: y + VERTICAL_GLYPH_WIDTH_PT / 2,\r\n    w: VERTICAL_GLYPH_WIDTH_PT,\r\n    h: 0,\r\n    rot: -90,\r\n  }\r\n}\r\n\r\nfunction page(items: TextItem[]): TextPage {\r\n  return { widthPt: 1000, heightPt: 1000, items }\r\n}\r\n\r\n/**\r\n * 異뺤쿃 0.05pt/mm??4?덈꺼. 移섏닔???먭린媛 ?щ뒗 援ш컙??**以묒젏**???볦씠誘濡?\n * ?몄젒 ??移섏닔??媛꾧꺽??(v0+v1)/2 횞 異뺤쿃???쒕떎 ???뚯꽌??洹?愿怨꾨줈 異뺤쿃???쇰떎.\r\n *\r\n * 移섏닔媛 ?뗭씤 寃껋? ?꾩슂議곌굔?대떎 ???섏씠硫??좊룄??異뺤쿃???議고븷 ?곷?媛 ?녿떎.\r\n */\r\nfunction fourLevels(): TextItem[] {\r\n  return [\r\n    v('2000', 50, 150),\r\n    v('2000', 50, 250),\r\n    v('2000', 50, 350),\r\n    h('RFL', 80, 100),\r\n    h('3FL', 80, 200),\r\n    h('2FL', 80, 300),\r\n    h('1FL', 80, 400),\r\n    // 怨꾩뿴? 邕며탡?녹뿉 ?랁븳?????쒕ぉ???놁쑝硫?臾댁뾿???믪씠?몄? 留먰븷 ???녿떎\r\n    h('bY1?싥굤邕며탡??/100', 300, 500),\r\n  ]\r\n}\r\n\r\ndescribe('parseFrameElevations', () => {\r\n  it('移섏닔 ?댁씠 ?놁쑝硫?野멩퀡?쀦쑋濾쒎눣', () => {\r\n    const parsed = parseFrameElevations(page([h('2FL', 80, 200)]))\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('移섏닔 ?곗뇙?먯꽌 異뺤쿃怨??덈꺼 ?꾩튂瑜??怨? ?쇰꺼???먮Ц 洹몃?濡?遺숈씤??, () => {\r\n    const parsed = parseFrameElevations(page(fourLevels()))\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.elevations).toEqual([\r\n      {\r\n        titles: ['bY1?싥굤邕며탡??/100'],\r\n        levels: [\r\n          { labels: ['RFL'], positionPt: 100 },\r\n          { labels: ['3FL'], positionPt: 200 },\r\n          { labels: ['2FL'], positionPt: 300 },\r\n          { labels: ['1FL'], positionPt: 400 },\r\n        ],\r\n        heightsMm: [2000, 2000, 2000],\r\n        scalePtPerMm: 0.05,\r\n      },\r\n    ])\r\n  })\r\n\r\n  it('媛숈? ?믪씠???쇰꺼???섏씠硫??????ｋ뒗?????대뒓 履쎌씠 ?롮씤吏 怨좊Ⅴ吏 ?딅뒗??, () => {\r\n    // ?ㅻЪ yokohama p8???뚥릎鸚?짘1FL?띻낵 ?뚦읃繹뺾L?띿씠 ??愿怨꾨떎 (190mm 李?竊?5pt)\r\n    const parsed = parseFrameElevations(\r\n      page([...fourLevels(), h('?뷸틬GL', 20, 403)]),\r\n    )\r\n    expect(parsed.elevations[0]?.levels.at(-1)).toEqual({\r\n      labels: ['1FL', '?뷸틬GL'],\r\n      positionPt: 400,\r\n    })\r\n  })\r\n\r\n  it('?쇰꺼??遺숈? ?덈꺼????誘몃쭔?대㈃ 怨꾩뿴濡?蹂댁? ?딅뒗??, () => {\r\n    // 遺遺?移섏닔 ???뗣겤?듏룡?藥???? ?쇰꺼??媛뽰? ?딅뒗????洹멸쾬???좎씪??援щ텇?대떎\r\n    const parsed = parseFrameElevations(\r\n      page(\r\n        fourLevels().filter(\r\n          (item) => !['RFL', '3FL', '2FL'].includes(item.str),\r\n        ),\r\n      ),\r\n    )\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('移섏닔媛 ?섎퓧???댁? 怨꾩뿴濡?蹂댁? ?딅뒗?????좊룄??異뺤쿃???議고븷 ?곷?媛 ?녿떎', () => {\r\n    // ?ㅻЪ kani p40?먯꽌???꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔媛 ???대줈 ?댁뼱??\n    // 異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???먮━??留덉묠 湲?먭? ?덉뼱 ?듦낵?덈떎\r\n    const parsed = parseFrameElevations(\r\n      // 354 = 以묒떖 350 + w/2 ??v()媛 ?먯젏??以묒떖 ?꾨옒濡??ｋ뒗??\n      page(\r\n        fourLevels().filter(\r\n          (item) => item.y !== 350 + VERTICAL_GLYPH_WIDTH_PT / 2,\r\n        ),\r\n      ),\r\n    )\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('異뺤쿃???딄린???먮━?먯꽌 怨꾩뿴???섎늿????媛숈? ?댁쓽 ?꽷룹븘????邕며탡??, () => {\r\n    const lower = fourLevels().map((item) => ({ ...item, y: item.y + 800 }))\r\n    const parsed = parseFrameElevations(page([...fourLevels(), ...lower]))\r\n    expect(parsed.elevations).toHaveLength(2)\r\n    expect(parsed.elevations.map((e) => e.levels[0].positionPt)).toEqual([\r\n      100, 900,\r\n    ])\r\n  })\r\n\r\n  it('??怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃┛??, () => {\r\n    const parsed = parseFrameElevations(\r\n      page([...fourLevels(), h('bY2?싥굤邕며탡??/100', 600, 500)]),\r\n    )\r\n    expect(parsed.elevations[0]?.titles).toEqual([\r\n      'bY1?싥굤邕며탡??/100',\r\n      'bY2?싥굤邕며탡??/100',\r\n    ])\r\n  })\r\n\r\n  it('?쒕ぉ???녿뒗 移섏닔 ?댁? 怨꾩뿴濡?蹂댁? ?딅뒗??, () => {\r\n    // ?ㅻЪ yokohama ??18履쎌쓣 ?듦낵?쒗궎硫?**?계나?긺듁??*媛 嫄몃┛????源딆씠 ?レ옄媛\r\n    // ?댁쓣 ?대（怨??놁뿉 ?쇰꺼???쒖꽌 ?ш린源뚯???議곌굔???꾨? 留뚯”?쒕떎\r\n    const parsed = parseFrameElevations(\r\n      page(fourLevels().filter((item) => !item.str.includes('邕며탡'))),\r\n    )\r\n    expect(parsed.elevations).toEqual([])\r\n    expect(parsed.issues).toEqual(['野멩퀡?쀦쑋濾쒎눣'])\r\n  })\r\n\r\n  it('?덈꺼 ?쇰꺼? 移섏닔 ??洹쇱쿂??寃껊쭔 蹂몃떎 ???꾨㈃ ?덉쓽 遺??遺?멸? ?욎씠吏 ?딅뒗??, () => {\n    const parsed = parseFrameElevations(\n      page([...fourLevels(), h('C51', 800, 200)]),\n    )\n    expect(parsed.elevations[0]?.levels[1].labels).toEqual(['3FL'])\n  })\n\n  it('?쇰꺼???쇱젙???꾩そ ?ㅽ봽?뗪낵 醫곸? 留덉?留?媛꾧꺽?먯꽌???꾩뿉?쒕????쒖꽌?濡???묓븳??, () => {\n    const parsed = parseFrameElevations(\n      page([\n        v('2000', 50, 150),\n        v('2000', 50, 250),\n        v('2000', 50, 350),\n        v('200', 50, 379),\n        h('RFL', 80, 89),\n        h('3FL', 80, 189),\n        h('2FL', 80, 389),\n        h('1FL', 80, 399),\n        h('bY1?싥굤邕며탡??, 300, 500),\n      ]),\n    )\n\n    expect(parsed.elevations[0]?.levels.map((level) => level.labels)).toEqual([\n      ['RFL'],\n      ['3FL'],\n      [],\n      ['2FL'],\n      ['1FL'],\n    ])\n  })\n\n  it('?ъ씠????묓븷 ?덈꺼???놁쑝硫?吏곸쟾????묓븳 ?덈꺼???쇰꺼 以묒꺽???좎??쒕떎', () => {\n    const parsed = parseFrameElevations(\n      page([\n        v('2000', 50, 150),\n        v('2000', 50, 250),\n        v('2000', 50, 350),\n        h('RFL', 80, 92),\n        h('2FL', 80, 192),\n        h('1FL', 80, 292),\n        h('鼇?쮫GL', 80, 295),\n        h('bY1?싥굤邕며탡??, 300, 500),\n      ]),\n    )\n\n    expect(parsed.elevations[0]?.levels[2].labels).toEqual(['1FL', '鼇?쮫GL'])\n  })\n\n  it('SL 怨꾩뿴? ?덈꺼 ?쇰꺼濡?痍④툒?섏? ?딅뒗??, () => {\n    const parsed = parseFrameElevations(\n      page(\n        fourLevels().map((item) =>\n          item.str === '1FL' ? { ...item, str: '1SL' } : item,\n        ),\n      ),\n    )\n\n    expect(parsed.elevations).toHaveLength(1)\n    expect(parsed.elevations[0]?.levels.map((level) => level.labels)).toEqual([\n      ['RFL'],\n      ['3FL'],\n      ['2FL'],\n      [],\n    ])\n  })\n\n  it('鸚⑴ク ?대????덈꺼 ?쇰꺼濡?痍④툒?쒕떎', () => {\n    const parsed = parseFrameElevations(\n      page(\n        fourLevels().map((item) =>\n          item.str === '1FL' ? { ...item, str: '歟곩ㄹ塋? } : item,\n        ),\n      ),\n    )\n\n    expect(parsed.elevations[0]?.levels.at(-1)?.labels).toEqual(['歟곩ㄹ塋?])\n  })\n})\n\r\n","exit_code":0,"status":"completed"}}
