\"^26.2.0\\\",\\r\\n    \\\"@types/react\\\": \\\"^19.2.18\\\",\\r\\n    \\\"@types/react-dom\\\": \\\"^19.2.4\\\",\\r\\n    \\\"@types/three\\\": \\\"^0.185.4\\\",\\r\\n    \\\"@vitejs/plugin-react\\\": \\\"^6.0.5\\\",\\r\\n    \\\"autoprefixer\\\": \\\"^10.5.4\\\",\\r\\n    \\\"eslint\\\": \\\"^8.57.1\\\",\\r\\n    \\\"eslint-config-next\\\": \\\"^15.5.23\\\",\\r\\n    \\\"fake-indexeddb\\\": \\\"6.2.5\\\",\\r\\n    \\\"jsdom\\\": \\\"^30.0.1\\\",\\r\\n    \\\"postcss\\\": \\\"^8.5.26\\\",\\r\\n    \\\"raw-loader\\\": \\\"^4.0.2\\\",\\r\\n    \\\"tailwindcss\\\": \\\"^3.4.17\\\",\\r\\n    \\\"tsx\\\": \\\"^4.23.12\\\",\\r\\n    \\\"typescript\\\": \\\"^5.9.3\\\",\\r\\n    \\\"vitest\\\": \\\"^4.1.10\\\"\\r\\n  },\\r\\n  \\\"overrides\\\": {\\r\\n    \\\"posthog-js\\\": \\\"1.417.4\\\"\\r\\n  }\\r\\n}\\r\\n--- CURRENT DIFF ---\\r\\ndiff --git a/phases/38-elevation-close/index.json b/phases/38-elevation-close/index.json\\nindex 72ae105..171d385 100644\\n--- a/phases/38-elevation-close/index.json\\n+++ b/phases/38-elevation-close/index.json\\n@@ -31,7 +31,8 @@\\n     {\\n       \\\"step\\\": 3,\\n       \\\"name\\\": \\\"short-dimension-tolerance\\\",\\n-      \\\"status\\\": \\\"pending\\\"\\n+      \\\"status\\\": \\\"pending\\\",\\n+      \\\"started_at\\\": \\\"2026-09-04T23:04:05+0900\\\"\\n     },\\n     {\\n       \\\"step\\\": 4,\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nphases/38-elevation-close/step3-codex.stdout.log:13:{\"type\":\"item.started\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'Get-Content -Encoding utf8 phases/38-elevation-close/step3.md; Write-Output \\\"--- PHASE 37 REPORT SHAPE ---\\\"; Get-Content -Encoding utf8 phases/37-corpus-widen-2-close/step5-report.json; Write-Output \\\"--- ELEVATION FIXTURE NAMES ---\\\"; Get-ChildItem tests/fixtures/section-import/textitems -Filter *.json | Select-Object -ExpandProperty Name; Write-Output \\\"--- STEP 2 REPORT ---\\\"; Get-Content -Encoding utf8 phases/38-elevation-close/step2-report.json'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\nphases/38-elevation-close/step3-codex.stdout.log:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'Get-Content -Encoding utf8 phases/38-elevation-close/step3.md; Write-Output \\\"--- PHASE 37 REPORT SHAPE ---\\\"; Get-Content -Encoding utf8 phases/37-corpus-widen-2-close/step5-report.json; Write-Output \\\"--- ELEVATION FIXTURE NAMES ---\\\"; Get-ChildItem tests/fixtures/section-import/textitems -Filter *.json | Select-Object -ExpandProperty Name; Write-Output \\\"--- STEP 2 REPORT ---\\\"; Get-Content -Encoding utf8 phases/38-elevation-close/step2-report.json'\",\"aggregated_output\":\"# Step 3: 짧은 치수 허용을 한 면에 맞춘 값에서 떼어내라\\r\\n\\r\\n## 배경\\r\\n\\r\\n`SHORT_TAIL_SCALE_TOLERANCE_RATIO = 0.49`는 주석이 스스로 밝히듯 **실측 최댓값(tsu 1,170의\\r\\n0.4879)에 맞춘 값**이다. R15에 「tsu 한 면 상수」로 열려 있다. 이 상수는 두 곳에서 쓰인다 —\\r\\n`chains()`의 짧은 치수 분기(tsu의 150, 편차 0.176)와 `extendShortTail()`의 꼬리 후보 판정.\\r\\n\\r\\nClaude 실측(변경 후보값을 바꿔가며 36면을 돌린 결과):\\r\\n\\r\\n| 값 | 36면 결과 |\\r\\n|---|---|\\r\\n| 0.45 | tsu-p21·p22가 1,170 꼬리를 잃는다(골든 불일치) |\\r\\n| 0.5 〜 20.0 | **전부 동일** — 출력 해시가 같다 |\\r\\n\\r\\n즉 실측 상한(0.4906)과 그 위 넓은 구간이 무차별이다. 값 자체를 없앨 수는 없다 —\\r\\n1.0에서 hirosaki-p25의 꼬리 후보 `30`(편차 4.33·4.71·5.33)이 **후보 자격에서 탈락**하고,\\r\\n5.0이면 자격을 얻어 순위 경쟁에 들어온다(그 면은 2,310이 더 좋아 결과는 같다).\\r\\n\\r\\n## 할 일\\r\\n\\r\\n1. 상수를 **1.0**으로 바꾸고 이름을 `SHORT_DIMENSION_SCALE_TOLERANCE_RATIO`로 고쳐라\\r\\n   (꼬리 전용이 아니라 짧은 치수 공통 규칙이다).\\r\\n2. 주석을 다시 써라. 담을 것: ① 뜻 — 「짧은 치수의 텍스트는 자기 구간이 좁아 중점에서\\r\\n   밀리는데, 그 **밀림이 기대 간격 자체를 넘지 않는다**」. ② 실측 — 코퍼스의 실제 짧은 치수는\\r\\n   tsu 150(0.176)·tsu 1,170(0.4879/0.4906)이고, 탈락시키는 후보는 hirosaki `30`(4.33〜5.33)이다.\\r\\n   ③ 무차별 구간 — 0.5〜20.0에서 36면 결과가 같으며, 1.0은 그 구간 안에서 뜻이 있는 값이다.\\r\\n   실측 최댓값에 붙여 놓지 않는다.\\r\\n3. 골든 테스트를 더하라 — `tests/plan-import/corpus2-elevation.test.ts`에 tsu 두 면을 넣는다.\\r\\n   - `tsu-kanritou-p21-elevation.json`·`tsu-kanritou-p22-elevation.json`의 **모든** `elevations`\\r\\n     항목에 대해, `titles`의 각 제목이 붙은 계열을 찾아 `heightsMm`와 레벨 라벨 배열을\\r\\n     통째로 `toEqual`로 대조한다(라벨은 골든 `levels`의 각 항목을 `[label]` 한 칸으로).\\r\\n   - 골든 항목 하나가 여러 계열에 걸리면 실패시켜라(제목 하나는 계열 하나에 붙는다).\\r\\n   - `toHaveLength(리터럴)`을 쓰지 마라. 계열 수는 골든 항목 수에서 나온다.\\r\\n\\r\\n## 이 스텝을 끝냈을 때의 기대 출력 (Claude 실측)\\r\\n\\r\\ntsu-p21의 **두 블록 모두**, tsu-p22의 **두 블록 모두**:\\r\\n구간 `[600,3500,3500,150,1170]`, 라벨 6레벨 1:1\\r\\n`[[\\\"パラペット天端\\\"],[\\\"RFL(水下)\\\"],[\\\"2FL\\\"],[\\\"1FL\\\"],[\\\"設計GL\\\"],[\\\"基礎下端\\\"]]`.\\r\\n나머지 34면은 step 2 이후와 불변이다.\\r\\n\\r\\n## 반증 (이 스텝 안에서 직접 확인하고 report에 적을 것)\\r\\n\\r\\n- 상수를 0.45로 낮추면 tsu 골든 4항목이 실패한다 → 확인 후 원복.\\r\\n- 상수를 5.0으로 올리면 hirosaki-p25의 꼬리 후보 `30`이 **자격을 얻는다**(최종 출력은 같다).\\r\\n  자격 판정 지점에 임시 로그를 넣어 확인하고, 로그는 커밋하지 마라.\\r\\n- 36면 중 짧은 치수 분기·꼬리 후보가 실제로 발동한 면과 그 편차값을 표로 report에 적어라.\\r\\n\\r\\n## 하지 말 것\\r\\n\\r\\n- 도면·발주처·시트 이름으로 갈라지는 분기, 새 상수 추가 금지.\\r\\n- 골든·픽스처를 고치지 마라. 골든이 어긋나면 `blocked`＋report.\\r\\n- `elevation.ts`·`corpus2-elevation.test.ts`·`elevation.test.ts` 밖의 파일을 고치지 마라.\\r\\n- `scripts/execute.py`를 실행하지 마라. 하네스 프로세스를 죽이지 마라.\\r\\n\\r\\n## AC\\r\\n\\r\\n- `npx vitest run tests/plan-import src/lib/import/framing-plan tests/section-import` 통과.\\r\\n- 36면 스윕에서 step 2 이후 대비 tsu-p21·p22만 변한다.\\r\\n- `rg -n \\\"SHORT_TAIL_SCALE_TOLERANCE_RATIO\\\" src` 0건.\\r\\n- `npm run lint`·`npx tsc --noEmit` 통과.\\r\\n--- PHASE 37 REPORT SHAPE ---\\r\\n{\\r\\n  \\\"verdict\\\": \\\"completed\\\",\\r\\n  \\\"items\\\": {\\r\\n    \\\"1_falsifiability\\\": {\\r\\n      \\\"holds\\\": false,\\r\\n      \\\"goldens_checked\\\": 16,\\r\\n      \\\"mutated_tests_failed\\\": 16\\r\\n    },\\r\\n    \\\"2_label_position\\\": {\\r\\n      \\\"holds\\\": false,\\r\\n      \\\"evidence\\\": [\\r\\