onents/review/ReviewPane.test.tsx:198:    const findings = screen.getByTestId('review-findings')\nsrc/components/review/ReviewPane.test.tsx:209:    fireEvent.click(screen.getByTestId('review-findings').querySelector('tbody tr') as HTMLElement)\nsrc/components/review/ReviewPane.test.tsx:276:    const rows = screen.getByTestId('review-findings').querySelectorAll('tbody tr')\nsrc/components/review/ReviewPane.test.tsx:815:      within(screen.getByTestId('review-findings')).getAllByRole('button', {\nsrc/components/review/ReviewPane.test.tsx:834:    it('renders default filter bar with all kinds selected, reset disabled via aria-disabled, and full row count', () => {\nsrc/components/review/ReviewPane.test.tsx:839:      const filterBar = screen.getByTestId('review-findings-filter')\nsrc/components/review/ReviewPane.test.tsx:840:      const findingsTable = screen.getByTestId('review-findings')\nsrc/components/review/ReviewPane.test.tsx:842:      // Verify filter bar renders above review-findings table\nsrc/components/review/ReviewPane.test.tsx:861:      // Verify reset button has aria-disabled=\"true\" and disabled === false\nsrc/components/review/ReviewPane.test.tsx:863:      expect(resetButton).toHaveAttribute('aria-disabled', 'true')\nsrc/components/review/ReviewPane.test.tsx:875:      // Initial state: reset button has aria-disabled=\"true\"\nsrc/components/review/ReviewPane.test.tsx:876:      expect(resetButton).toHaveAttribute('aria-disabled', 'true')\nsrc/components/review/ReviewPane.test.tsx:882:      // Verify reset button becomes aria-disabled=\"false\" (structural check M1 succeeds)\nsrc/components/review/ReviewPane.test.tsx:883:      expect(resetButton).toHaveAttribute('aria-disabled', 'false')\nsrc/components/review/ReviewPane.test.tsx:891:      // After reset: aria-disabled is \"true\", disabled is false, activeElement preserved, chip re-selected\nsrc/components/review/ReviewPane.test.tsx:892:      expect(resetButton).toHaveAttribute('aria-disabled', 'true')\ns