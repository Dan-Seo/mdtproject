{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; \"'$OutputEncoding = [Console]::OutputEncoding; Write-Output '\"'--- ledger test ---'; Get-Content -LiteralPath tests/docs/ledger-sync.test.ts -Encoding utf8; Write-Output '--- guardrail test ---'; Get-Content -LiteralPath tests/docs/guardrail-sync.test.ts -Encoding utf8; Write-Output '--- phase step3 spec ---'; Get-Content -LiteralPath phases/35-ledger-reconciliation/step3.md -Encoding utf8; Write-Output '--- milestone tables/checkboxes ---'; rg -n --encoding UTF-8 'M0|M1|M2|M3a|M3b|M3c|도면 인식|ST-Bridge|부재 확장|일본 고유|M4|M5|\"'^- '\"\\\\[[ x]\\\\]' CLAUDE.md docs/MILESTONES.md; Write-Output '--- risk ids ---'; rg -o --encoding UTF-8 '\\\\bR(?:1[0-6]|[1-9])\\\\b' CLAUDE.md docs/RISKS.md | Sort-Object -Unique; Write-Output '--- closed-track terms src/tests ---'; rg -n --encoding UTF-8 'パネルゾーン|溶接閉鎖|機械式定着|免震|スパイラル|壁式構造|StbRadialAxes|BASEMENT|ISOLATION|DEPENDENCE|unsupportedAxisKinds|hasUnsupportedKind|hasBasement' src tests\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; \"'$OutputEncoding = [Console]::OutputEncoding; Write-Output '\"'--- ledger test ---'; Get-Content -LiteralPath tests/docs/ledger-sync.test.ts -Encoding utf8; Write-Output '--- guardrail test ---'; Get-Content -LiteralPath tests/docs/guardrail-sync.test.ts -Encoding utf8; Write-Output '--- phase step3 spec ---'; Get-Content -LiteralPath phases/35-ledger-reconciliation/step3.md -Encoding utf8; Write-Output '--- milestone tables/checkboxes ---'; rg -n --encoding UTF-8 'M0|M1|M2|M3a|M3b|M3c|도면 인식|ST-Bridge|부재 확장|일본 고유|M4|M5|\"'^- '\"\\\\[[ x]\\\\]' CLAUDE.md docs/MILESTONES.md; Write-Output '--- risk ids ---'; rg -o --encoding UTF-8 '\\\\bR(?:1[0-6]|[1-9])\\\\b' CLAUDE.md docs/RISKS.md | Sort-Object -Unique; Write-Output '--- closed-track terms src/tests ---'; rg -n --encoding UTF-8 'パネルゾーン|溶接閉鎖|機械式定着|免震|スパイラル|壁式構造|StbRadialAxes|BASEMENT|ISOLATION|DEPENDENCE|unsupportedAxisKinds|hasUnsupportedKind|hasBasement' src tests\"","aggregated_output":"--- ledger test ---\r\nimport { readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nconst REMEDIATION =\r\n  'CLAUDE.md와 docs/MILESTONES.md·docs/RISKS.md의 대장을 확인하고, 이 테스트의 명시적 매핑표와 양쪽 문서를 함께 갱신하라.'\r\n\r\ntype MilestoneMapping = {\r\n  claudeRow: string\r\n  milestonesName: string\r\n}\r\n\r\n// 이름이 비슷하다는 이유로 대응시키지 않는다. 문서의 실제 행을 사람이 직접 짝지은 표다.\r\nconst MILESTONE_MAPPING: readonly MilestoneMapping[] = [\r\n  { claudeRow: 'M0 스파이크', milestonesName: 'M0' },\r\n  { claudeRow: 'M1 워킹 스켈레톤', milestonesName: 'M1' },\r\n  { claudeRow: 'M2 룰팩', milestonesName: 'M2' },\r\n  { claudeRow: 'M3a 단일 스팬 大梁·뷰어', milestonesName: 'M3a' },\r\n  { claudeRow: 'M3b 다스팬·継手', milestonesName: 'M3b' },\r\n  { claudeRow: 'M3c 고유 상세', milestonesName: 'M3c' },\r\n  { claudeRow: '도면 인식(로컬)', milestonesName: '도면 인식(로컬)' },\r\n  { claudeRow: 'ST-Bridge 취입', milestonesName: 'ST-Bridge 취입' },\r\n  {\r\n    claudeRow: '부재 확장(耐震壁·床板)',\r\n    milestonesName: '부재 확장(耐震壁·床板)',\r\n  },\r\n  {\r\n    claudeRow: '일본 고유 형태·제품',\r\n    milestonesName: '일본 고유 형태·제품 확장',\r\n  },\r\n  {\r\n    claudeRow: 'M4 재방문·내역서·PDF·glTF',\r\n    milestonesName: 'M4',\r\n  },\r\n  { claudeRow: 'M5 한국 실무자 UX 리뷰', milestonesName: 'M5' },\r\n]\r\n\r\nfunction parsePipeCells(line: string): string[] | undefined {\r\n  if (!line.trim().startsWith('|') || !line.trim().endsWith('|')) {\r\n    return undefined\r\n  }\r\n\r\n  return line\r\n    .trim()\r\n    .split('|')\r\n    .slice(1, -1)\r\n    .map((cell) => cell.trim())\r\n}\r\n\r\nfunction parseClaudeMilestones(markdown: string): Array<{\r\n  name: string\r\n  status: string\r\n}> {\r\n  const lines = markdown.split(/\\r?\\n/)\r\n  const headerIndex = lines.findIndex(\r\n    (line) => line.trim() === '| | 상태 | 남은 것 |',\r\n  )\r\n\r\n  expect(\r\n    headerIndex,\r\n    `CLAUDE.md의 마일스톤 표를 찾지 못했다. ${REMEDIATION}`,\r\n  ).toBeGreaterThanOrEqual(0)\r\n\r\n  const rows: Array<{ name: string; status: string }> = []\r\n  for (const line of lines.slice(headerIndex + 2)) {\r\n    if (!line.trim().startsWith('|')) break\r\n\r\n    const cells = parsePipeCells(line)\r\n    if (!cells || cells.length !== 3 || cells[0] === '') continue\r\n    rows.push({ name: cells[0], status: cells[1].replaceAll('**', '') })\r\n  }\r\n\r\n  return rows\r\n}\r\n\r\nfunction parseMilestonesCheckboxes(markdown: string): Array<{\r\n  checked: boolean\r\n  name: string\r\n}> {\r\n  const rows: Array<{ checked: boolean; name: string }> = []\r\n\r\n  for (const line of markdown.split(/\\r?\\n/)) {\r\n    const match = line.match(/^\\s*- \\[([ xX])\\] \\*\\*(.+?)\\*\\*(?:\\s+—|\\s*$)/)\r\n    if (!match) {\r\n      if (/^\\s*- \\[[ xX]\\]/.test(line)) {\r\n        expect(\r\n          match,\r\n          `docs/MILESTONES.md의 체크박스 행에서 굵은 이름을 읽지 못했다: ${line}. ${REMEDIATION}`,\r\n        ).not.toBeNull()\r\n      }\r\n      continue\r\n    }\r\n\r\n    rows.push({ checked: match[1].toLowerCase() === 'x', name: match[2] })\r\n  }\r\n\r\n  return rows\r\n}\r\n\r\nfunction parseClaudeRiskTable(markdown: string): string[] {\r\n  const lines = markdown.split(/\\r?\\n/)\r\n  const headerIndex = lines.findIndex(\r\n    (line) => line.trim() === '| | 상태 | 한 줄 |',\r\n  )\r\n\r\n  expect(\r\n    headerIndex,\r\n    `CLAUDE.md의 열린 리스크 표를 찾지 못했다. ${REMEDIATION}`,\r\n  ).toBeGreaterThanOrEqual(0)\r\n\r\n  const ids: string[] = []\r\n  for (const line of lines.slice(headerIndex + 2)) {\r\n    if (!line.trim().startsWith('|')) break\r\n\r\n    const cells = parsePipeCells(line)\r\n    if (cells && cells.length === 3 && /^R\\d+$/.test(cells[0])) {\r\n      ids.push(cells[0])\r\n    }\r\n  }\r\n\r\n  return ids\r\n}\r\n\r\nfunction extractRiskIds(markdown: string): string[] {\r\n  return [...new Set(markdown.match(/R\\d+/g) ?? [])]\r\n}\r\n\r\nfunction assertExactItems(\r\n  actual: readonly string[],\r\n  expected: readonly string[],\r\n  message: string,\r\n): void {\r\n  expect(actual.length, message).toBe(expected.length)\r\n  expect([...new Set(actual)].sort(), message).toEqual(\r\n    [...new Set(expected)].sort(),\r\n  )\r\n}\r\n\r\ndescribe('문서 대장 동기화', () => {\r\n  const claude = readFileSync(resolve(process.cwd(), 'CLAUDE.md'), 'utf8')\r\n  const milestones = readFileSync(\r\n    resolve(process.cwd(), 'docs/MILESTONES.md'),\r\n    'utf8',\r\n  )\r\n  const risks = readFileSync(resolve(process.cwd(), 'docs/RISKS.md'), 'utf8')\r\n\r\n  it('마일스톤 표와 체크박스가 명시적 매핑 및 상태를 공유한다', () => {\r\n    const claudeRows = parseClaudeMilestones(claude)\r\n    const milestoneRows = parseMilestonesCheckboxes(milestones)\r\n    const mappingClaudeNames = MILESTONE_MAPPING.map((item) => item.claudeRow)\r\n    const mappingMilestoneNames = MILESTONE_MAPPING.map(\r\n      (item) => item.milestonesName,\r\n    )\r\n\r\n    assertExactItems(\r\n      mappingClaudeNames,\r\n      [...new Set(mappingClaudeNames)],\r\n      `테스트 매핑표의 CLAUDE.md 이름이 중복되었다. ${REMEDIATION}`,\r\n    )\r\n    assertExactItems(\r\n      mappingMilestoneNames,\r\n      [...new Set(mappingMilestoneNames)],\r\n      `테스트 매핑표의 docs/MILESTONES.md 이름이 중복되었다. ${REMEDIATION}`,\r\n    )\r\n    assertExactItems(\r\n      claudeRows.map((row) => row.name),\r\n      mappingClaudeNames,\r\n      `CLAUDE.md 마일스톤 행이 매핑표와 다르다. 새 항목을 추가하거나 이름을 바꾸면 매핑표를 명시적으로 갱신하라. ${REMEDIATION}`,\r\n    )\r\n    assertExactItems(\r\n      milestoneRows.map((row) => row.name),\r\n      mappingMilestoneNames,\r\n      `docs/MILESTONES.md 체크박스가 매핑표와 다르다. 새 항목을 추가하거나 이름을 바꾸면 매핑표를 명시적으로 갱신하라. ${REMEDIATION}`,\r\n    )\r\n\r\n    for (const mapping of MILESTONE_MAPPING) {\r\n      const claudeRow = claudeRows.find((row) => row.name === mapping.claudeRow)\r\n      const milestoneRow = milestoneRows.find(\r\n        (row) => row.name === mapping.milestonesName,\r\n      )\r\n\r\n      expect(claudeRow, `매핑된 CLAUDE.md 행이 없다: ${mapping.claudeRow}. ${REMEDIATION}`).toBeDefined()\r\n      expect(milestoneRow, `매핑된 docs/MILESTONES.md 행이 없다: ${mapping.milestonesName}. ${REMEDIATION}`).toBeDefined()\r\n\r\n      const normalizedStatus = claudeRow!.status.trim()\r\n      if (milestoneRow!.checked) {\r\n        expect(\r\n          normalizedStatus,\r\n          `${mapping.claudeRow}: 체크된 항목은 CLAUDE.md에서 완료여야 한다. ${REMEDIATION}`,\r\n        ).toBe('완료')\r\n      } else {\r\n        expect(\r\n          ['진행 중', '미착수'],\r\n          `${mapping.claudeRow}: 체크되지 않은 항목은 진행 중 또는 미착수여야 한다. ${REMEDIATION}`,\r\n        ).toContain(normalizedStatus)\r\n      }\r\n    }\r\n  })\r\n\r\n  it('두 리스크 대장이 같은 번호 집합을 가진다', () => {\r\n    const risksMdIds = extractRiskIds(risks)\r\n    const claudeMdIds = parseClaudeRiskTable(claude)\r\n\r\n    // R번호의 상태 문언은 문서마다 경위·보강 문구가 달라 원래 다르다.\r\n    // 여기서 상태까지 비교하면 정상적인 대장 갱신도 깨져 다음 사람이 검사를 지우게 된다.\r\n    assertExactItems(\r\n      risksMdIds,\r\n      claudeMdIds,\r\n      `docs/RISKS.md와 CLAUDE.md 열린 리스크 표의 R번호가 다르다. 상태 문언은 비교하지 말고 번호 집합을 먼저 맞춰라. ${REMEDIATION}`,\r\n    )\r\n  })\r\n})\r\n--- guardrail test ---\r\nimport { existsSync, readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { expect, it } from 'vitest'\r\n\r\nconst REMEDIATION =\r\n  'AGENTS.md의 본문을 CLAUDE.md에서 다시 생성하라. 한쪽만 고치면 codex가 낡은 규칙을 받는다'\r\n\r\nfunction normalizeNewlines(value: string): string {\r\n  return value.replace(/\\r\\n?/g, '\\n')\r\n}\r\n\r\nit('AGENTS.md가 자체 헤더 뒤에 CLAUDE.md 본문 전체를 그대로 담는다', () => {\r\n  const agentsPath = resolve(process.cwd(), 'AGENTS.md')\r\n  const claudePath = resolve(process.cwd(), 'CLAUDE.md')\r\n\r\n  expect(\r\n    existsSync(agentsPath),\r\n    `AGENTS.md 파일이 없습니다. ${REMEDIATION}`,\r\n  ).toBe(true)\r\n  expect(\r\n    existsSync(claudePath),\r\n    `CLAUDE.md 파일이 없습니다. ${REMEDIATION}`,\r\n  ).toBe(true)\r\n\r\n  const agents = normalizeNewlines(readFileSync(agentsPath, 'utf8'))\r\n  const claude = normalizeNewlines(readFileSync(claudePath, 'utf8'))\r\n  const claudeTitleEnd = claude.indexOf('\\n')\r\n\r\n  expect(\r\n    claudeTitleEnd,\r\n    `CLAUDE.md 제목 줄 뒤에 본문이 없습니다. ${REMEDIATION}`,\r\n  ).toBeGreaterThan(0)\r\n\r\n  const claudeTitle = claude.slice(0, claudeTitleEnd)\r\n  const claudeBody = claude.slice(claudeTitleEnd + 1)\r\n\r\n  expect(\r\n    claudeTitle,\r\n    `CLAUDE.md 제목이 Markdown H1 규약을 따르지 않습니다. ${REMEDIATION}`,\r\n  ).toMatch(/^# \\S/)\r\n  expect(\r\n    claudeBody.length,\r\n    `CLAUDE.md 본문이 비어 있습니다. ${REMEDIATION}`,\r\n  ).toBeGreaterThan(0)\r\n  expect(\r\n    agents.endsWith(claudeBody),\r\n    `AGENTS.md와 CLAUDE.md의 본문이 다릅니다. ${REMEDIATION}`,\r\n  ).toBe(true)\r\n\r\n  const agentsHeader = agents.slice(0, agents.length - claudeBody.length)\r\n  const headerLines = agentsHeader.split('\\n')\r\n  const noticeLines = headerLines.slice(2, -1)\r\n\r\n  expect(\r\n    headerLines[0],\r\n    `AGENTS.md 제목이 CLAUDE.md 제목과 다릅니다. ${REMEDIATION}`,\r\n  ).toBe(claudeTitle)\r\n  expect(\r\n    headerLines[1],\r\n    `AGENTS.md 제목과 사본 고지 사이의 빈 줄이 없습니다. ${REMEDIATION}`,\r\n  ).toBe('')\r\n  expect(\r\n    headerLines.at(-1),\r\n    `AGENTS.md 사본 고지와 본문 사이의 빈 줄이 없습니다. ${REMEDIATION}`,\r\n  ).toBe('')\r\n  expect(\r\n    noticeLines.length,\r\n    `AGENTS.md에 사본 고지가 없습니다. ${REMEDIATION}`,\r\n  ).toBeGreaterThan(0)\r\n  expect(\r\n    noticeLines.every((line) => line.startsWith('> ')),\r\n    `AGENTS.md 사본 고지가 Markdown 인용문 규약을 따르지 않습니다. ${REMEDIATION}`,\r\n  ).toBe(true)\r\n  expect(\r\n    noticeLines.join('\\n'),\r\n    `AGENTS.md 사본 고지가 CLAUDE.md를 가리키지 않습니다. ${REMEDIATION}`,\r\n  ).toContain('`CLAUDE.md`')\r\n  expect(\r\n    noticeLines.join('\\n'),\r\n    `AGENTS.md 헤더가 사본임을 고지하지 않습니다. ${REMEDIATION}`,\r\n  ).toContain('사본')\r\n})\r\n--- phase step3 spec ---\r\n# Step 3: 반증하라 (검증 전용)\r\n\r\n이 스텝은 **구현이 아니다.** 대상 코드·문서를 고치지 마라. 어긋난 것을 **고치지 말고 기록하라**.\r\n\r\n**반증이 성립하면 status를 `refuted`로 두어라.** `error`가 아니다.\r\n\r\n앞 스텝의 보고서(`step0-report.json`·`step1-report.json`·`step2-report.json`)는 **자기 보고**다. 「돌려봤다」·「통과했다」는 근거가 아니다. **전부 다시 확인하라.**\r\n\r\n## 전제 목록 (이것들만 `refuted`를 낼 수 있다)\r\n\r\n| id | 무엇을 반증하는가 |\r\n|---|---|\r\n| `sync-test-is-falsifiable` | `tests/docs/ledger-sync.test.ts`가 항진명제가 아니다. 아래 뮤테이션 1~5 각각에서 **실제로 실패**해야 한다. 하나라도 통과하면 **`refuted`**. **이것이 이 스텝에서 가장 중요한 항목이다** — 이 검사가 헐거우면 phase 전체가 아무것도 막지 못한 것이다. |\r\n| `guardrail-test-still-bites` | `tests/docs/guardrail-sync.test.ts`가 여전히 문다 — `AGENTS.md`의 본문 한 줄을 고치면 실패한다(확인 뒤 되돌려라). 실패하지 않으면 **`refuted`**. |\r\n| `no-code-change` | `git diff main...HEAD --stat -- src/ tests/` 에 나오는 파일이 **`tests/docs/ledger-sync.test.ts` 하나뿐**이다. 그 밖에 하나라도 있으면 **`refuted`**. 이 phase는 문서와 테스트 하나다. |\r\n| `risks-untouched` | `git diff main...HEAD -- docs/RISKS.md` 가 **빈 출력**이다. 아니면 **`refuted`**. |\r\n| `closed-tracks-really-closed` | step 2가 닫은 트랙 각각에 대해, **step 0 보고서를 읽지 말고 직접** 다시 재라. ① `パネルゾーン`·`溶接閉鎖`·`機械式定着`·`免震`이 `src/`·`tests/`에 **0건**이다. ② `スパイラル`·`壁式構造`의 매칭 줄이 **전부 주석**이다. ③ ADR-043 결정 5의 거부가 사유 코드와 함께 구현돼 있고 그 분기를 무력화하면 테스트가 실패한다(확인 뒤 되돌려라). 어느 하나라도 어긋나면 **`refuted`**. |\r\n| `open-tracks-untouched` | `M2 룰팩`·`도면 인식(로컬)`·`M5` 세 행이 `CLAUDE.md`와 `docs/MILESTONES.md` 양쪽에서 **바뀌지 않았다**(`git diff main...HEAD`로 확인). 그리고 `src/rulepack/index.test.ts`의 「`stated`는 0행」 고정이 살아 있고 현재 룰팩의 `stated`가 0행이다. 어긋나면 **`refuted`**. |\r\n| `decisions-preserved` | 닫힌 트랙의 **「만들지 않기로 한 것」 서술이 `docs/MILESTONES.md`에 그대로 남아 있다.** `git diff main...HEAD -- docs/MILESTONES.md` 에서 **삭제된 줄(`-`)이 체크박스 줄 자체의 교체 말고는 없다**는 것으로 확인하라. 결정의 기록이 요약되거나 지워졌으면 **`refuted`**. |\r\n| `ledgers-agree` | `CLAUDE.md`·`docs/MILESTONES.md`·`docs/RISKS.md`·`AGENTS.md` 넷이 정합이다 — 두 sync 테스트가 통과하고, `docs/RISKS.md`의 `R번호` 집합과 `CLAUDE.md` 리스크 표의 `R번호` 집합이 **양방향으로 같다**(직접 세어 대조하라). 어긋나면 **`refuted`**. |\r\n| `test-count-not-reduced` | `npm run test`의 테스트 수가 step 0 보고서의 기준선보다 **줄지 않았다**. 줄었으면 무엇이 사라졌는지 찾아 적고 **`refuted`**. |\r\n\r\n## 뮤테이션 스윕 (반증 도구)\r\n아래 각각을 **하나씩** 넣고 해당 테스트를 돌린 뒤 **반드시 되돌려라.** 각 뮤테이션이 **어떤 테스트를 깨뜨렸는지** 파일명과 테스트 이름으로 적어라.\r\n\r\n1. `CLAUDE.md` 마일스톤 표에서 **완료**인 행 하나의 상태를 `진행 중`으로 바꾼다.\r\n2. `docs/MILESTONES.md`에서 `- [x]`인 체크박스 하나를 `- [ ]`로 바꾼다.\r\n3. `docs/RISKS.md`에서 `R번호` 하나가 나오는 줄을 지운다.\r\n4. `CLAUDE.md` 열린 리스크 표에서 `R번호` 행 하나를 지운다.\r\n5. `CLAUDE.md` 마일스톤 표에 **매핑표에 없는 행**을 하나 추가한다.\r\n6. `AGENTS.md` 본문의 한 줄을 고친다.\r\n\r\n**아무 테스트도 깨뜨리지 못한 뮤테이션이 하나라도 있으면** 그 지점은 오라클이 비어 있는 것이다 — `broke: []`로 적고 `sync-test-is-falsifiable`(6번은 `guardrail-test-still-bites`)을 **`refuted`**로 두어라.\r\n\r\n**전 구간이 「동일」로 나오면 그것은 성공이 아니라 값이 닿지 않은 것이다.**\r\n\r\n## 그 밖에 확인할 것 (기록 항목 — 반증 아님)\r\n- `git diff main...HEAD --stat` 전문. 사양에 없는 파일이 있으면 목록으로 적어라.\r\n- `tests/docs/ledger-sync.test.ts`의 매핑표에 실린 쌍의 수와, `CLAUDE.md` 표의 행 수·`docs/MILESTONES.md`의 체크박스 수. 셋이 맞는지 적어라.\r\n- 닫히지 않고 남은 트랙 목록과 그 이유.\r\n\r\n## 산출물\r\n`phases/35-ledger-reconciliation/step3-report.json`\r\n\r\n```json\r\n{\r\n  \"verdict\": \"upheld|refuted\",\r\n  \"premises\": [{\"id\":\"\", \"verdict\":\"upheld|refuted\", \"evidence\":\"\", \"note\":\"\"}],\r\n  \"mutation_sweep\": [{\"mutation\":\"\", \"broke\":[], \"note\":\"\"}],\r\n  \"test_counts\": {\"files\": 0, \"tests\": 0, \"delta_files\": 0, \"delta_tests\": 0},\r\n  \"mapping_counts\": {\"pairs\": 0, \"claude_rows\": 0, \"milestones_checkboxes\": 0},\r\n  \"still_open\": [],\r\n  \"diffstat\": \"\",\r\n  \"unexpected_files\": [],\r\n  \"noticed\": []\r\n}\r\n```\r\n\r\n## 완료 조건\r\n- 전제 9건 각각에 `upheld`/`refuted`와 **증거**가 있다.\r\n- 뮤테이션 6건 각각에 `broke`가 있다.\r\n- 되돌리지 않은 뮤테이션이 없다 — 마지막에 `git status`를 확인하고 결과를 적어라.\r\n- `refuted`가 하나라도 있으면 step status를 **`refuted`**로. 없으면 `completed`.\r\n\r\n## 금지\r\n- 대상 코드·문서를 고치지 마라. 뮤테이션은 넣고 **반드시 되돌린다**.\r\n- 테스트를 더하거나 고치지 마라. 약한 검사를 발견하면 **적기만** 하라.\r\n- 앞 스텝의 보고서를 근거로 판정하지 마라 — 그것이 이 스텝이 재는 대상이다.\r\n- 전제에 없는 것으로 `refuted`를 내지 마라. 그건 `noticed`다.\r\n--- milestone tables/checkboxes ---\r\nCLAUDE.md:33:- 마일스톤 순서를 건너뛰지 말 것. M0(스파이크) → M1(워킹 스켈레톤) → M2(룰팩) → M3a(단일 스팬 大梁·뷰어) → M3b(다스팬·継手) → M3c(고유 상세) → M4(확장) → M5(UX 리뷰). 도면 인식(로컬)은 M3a 이후 병행 가능한 별도 트랙 — 입력 파이프라인이라 산정 로직 마일스톤과 코드 영역이 겹치지 않는다 (ADR-018)\r\nCLAUDE.md:50:| M0 스파이크 | 완료 | — |\r\nCLAUDE.md:51:| M1 워킹 스켈레톤 | 완료 | — |\r\nCLAUDE.md:52:| M2 룰팩 | **진행 중** | 標準仕様書 5章·数量積算基準의 `stated` 승격. **두 원문 모두 사람의 독립 검토**라 에이전트가 코드로 닫을 수 없다 (R6) |\r\nCLAUDE.md:53:| M3a 단일 스팬 大梁·뷰어 | 완료 | — |\r\nCLAUDE.md:54:| M3b 다스팬·継手 | 완료 | — |\r\nCLAUDE.md:55:| M3c 고유 상세 | 완료 | 幅止め筋·腹筋 완료. パネルゾーン帯筋·溶接閉鎖フープ는 두 원문 0건이거나 제품이 형상·本数를 지어내야 하므로 만들지 않는다(ADR-022) |\nCLAUDE.md:56:| 도면 인식(로컬) | **진행 중** | 断面リスト 트랙(값)·형상 트랙(伏図·軸組図) 둘. 잔여: 표 형식 커버리지, 주기형(스케치 인출선) 壁リスト 미지원, 위치 없는 `カットオフ` 표기 반영, kani p40 미지원(R10). ADR-018·ADR-030 |\r\nCLAUDE.md:57:| ST-Bridge 취입 | 완료 | 사용자 `.stb` 0건과 ver 2.1 계열 현실 규모 파일 0건은 코퍼스 문제로 R16에 남김. 비직교·원호·방사 通り芯과 `BASEMENT`·`ISOLATION`·`DEPENDENCE` 階는 ADR-043 결정 5에 따라 거부하며 만들지 않음 |\nCLAUDE.md:58:| 부재 확장(耐震壁·床板) | 완료 | — |\nCLAUDE.md:59:| 일본 고유 형태·제품 | **진행 중** | 高強度せん断補強筋·円形柱 완료. 壁式構造の壁은 만들지 않는다 — 별개 마일스톤(ADR-042) |\r\nCLAUDE.md:60:| M4 재방문·내역서·PDF·glTF | 완료 | — |\r\nCLAUDE.md:61:| M5 한국 실무자 UX 리뷰 | 미착수 | — |\nCLAUDE.md:63:마일스톤 순서를 건너뛰지 말 것. 도면 인식은 M3a 이후 병행 가능한 별도 트랙이다 (ADR-018).\r\nCLAUDE.md:64:**M2가 미완이므로 산출값은 아직 정식 물량이 아니다.**\r\nCLAUDE.md:86:| R16 | 열림 | ST-Bridge 코퍼스는 오픈소스 테스트 픽스처이고 사용자 `.stb`는 0건이며, RC 배근 파일·현실 규모 ver 2.1 파일이 부족하다 |\r\ndocs/MILESTONES.md:7:- **M2 보강 (2026-08-27, phase 30 step 2)**: 룰팩 243행(`transcribed` 240행, `inferred` 3행)을 8개 표＋17개 단발항＝25개 대조 단위·135칸으로 확인한다. 생성은 `npm run rulepack:review-sheet`; 검토는 ①表5.3.2·5.3.4 L1/L1h ②表5.3.6 柱＝大梁 ③단발항·결번 순이다. 사람이 단위별 전 칸 일치를 회신한 뒤 해당 행의 `confidence`를 `stated`로 올리고 `note`의 「独立検討待ち」를 지우며, `src/rulepack/index.test.ts`의 「`stated`는 0행」 고정을 같은 커밋에서 함께 고친다. 그 전까지 `stated` 0행이며 M2와 R6은 각각 진행 중·열림이다. 아래 기존 M2 항목의 이전 대조 수치 「198행」·「원문 94칸·8곳」은 이 수치로 대체한다.\r\ndocs/MILESTONES.md:9:- **M3c 보충 (2026-08-27, phase 28 step 3)**: `表5.3.1 注1`의 「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d 以上とする。」를 `spec-r7-ch5.json`에 `transcribed` 전사했다(인쇄 28쪽). 이는 설계도서 조건이므로 片持床板 선단과 壁 자유단의 훅을 추정하지 않는 골든 회귀를 추가했고, 룰팩 행은 만들지 않았다. 加工長 대장은 `bendRadius`만 남도록 정리했으며 R12는 부분 상태를 유지한다.\r\ndocs/MILESTONES.md:11:- [x] **M0** — 완료 (2026-08-09). 標準仕様書 R7 5章에서 MVP 관련 텍스트 수치 ~92개, 이미지 수치 8개(フック余長 4·継手位置 4)를 특정. 標準詳細図에는 구조 배근 상세가 없음을 확인 — 배근 근거는 5章이 유일하다 (docs/M0-FINDINGS.md)\r\ndocs/MILESTONES.md:12:- [x] **M1** — 완료. 워킹 스켈레톤: 柱 1종 + 플레이스홀더 룰로 입력→철근→물량→3D→Excel 관통. 전 룰이 inferred이므로 M2 전 산출값은 정식 물량이 아니다\r\ndocs/MILESTONES.md:13:- [ ] **M2** — 룰팩 정식화 + 골든테스트 전 셀 통과. 골든 기대값은 원문 독립 전사(lookupRule 유도 금지, ADR-010). **M2a 착수분(2026-08-12)**: `数量積算基準` 第4編第3章을 전사해 `tests/golden/fixtures/quantity-r5-ch3.json`에 박고, 数量의 길이·본수를 1通則2)·7)에 맞췄다 — フープ/スタラップ 길이가 かぶり 공제+フック에서 **断面周長**으로 바뀌어 한 본당 244mm 늘었다(ADR-019). 미적용 조항은 R9. **추가 완료**(2026-08-20): 단위질량을 룰팩에서 빼고 **프로젝트 입력**(`Project.unitMass`)으로 받는다. 積算基準 1通則 前文은 質量을 「設計長さ × JIS G 3112 の単位質量」으로 정의할 뿐 값을 JIS에 위임하는데, JIS는 유료라 미확보다 — 읽지 않은 문헌을 出典에 세울 수 없으므로(ADR-003) `unit-mass.yaml`(inferred 8행)과 `sources.yaml`의 `jis` 항목을 지웠다. 미입력 径은 line·小計·合計의 kg이 전부 `null`이고 内訳書·Excel에 「—」로 나간다(0으로 두면 합계에 섞여 과소 계상으로 보인다). **추가 완료**(2026-08-21, 加工長 골든): 선결 조건이던 R7 端部条件 ①②③이 전부 닫혀 착수 가능해졌다 — `tests/golden/fixtures/fabrication-length.json`에 表5.3.4(L1)·表5.3.5(La)·5.3.4(5)(ｲ)(a)(b)(c)·表5.3.6·5.3.5(2)·表5.3.1(hook135, 이미지 판독) + `数量積算基準` 1通則1)(tipNoAddition)을 전사하고, 그 항들만으로 손유도한 加工長을 9케이스에 박았다(柱主筋 定着/통과, 柱帯筋, 大梁 折曲げ 全長下限支配/折曲げ 余長下限支配/直線/2스팬 通し筋, あばら筋, 定着不成立 throw). 재는 값은 `Rebar.length`가 아니라 **`points`가 그리는 折れ線 실장**이다 — 設計長さ를 읽으면 数量 골든과 중복되고 3D 형상은 아무도 고정하지 않는 채로 남는다(ADR-019). 근거 문서가 둘이라 `sources`는 배열이고 각 항이 `sourceId`로 어느 문서인지 가리킨다. 어느 케이스도 구속하지 않는 항은 `terms`에 남지 못한다 — 실제로 L1h가 그랬다. 뮤테이션으로 감도 확인함(cover 加算·余長下限·L1·中間柱せい 누적을 각각 흔들면 해당 케이스만 실패). **2026-08-21 재점검**: 예전에 적어둔 잔여 4개 중 셋은 이미 끝나 있었다 — 加工用かぶり는 `cover.fabrication.addition`으로 분리돼 골든 대조 중이고, 근거 없는 `rounding.length`는 룰팩에 없으며, 선결 조건이던 R7③(端部条件)도 `girder-ends.ts`가 直線↔折曲げ 분기와 `定着不成立` 판정으로 처리한다. 같은 날 折曲げ定着 全長의 하한이 조문(L1)이 아니라 L1h였던 것을 고쳤다(R7③-1) — 그 결과 (a)가 지배할 때 折曲げ와 直線의 全長이 같아지고, (b) 余長下限이 이기는 사례는 D13·柱560 하나로 좁혀졌다. **남은 것은 두 원문에서 전사된 수치의 `stated` 승격이다**: 標準仕様書 5章 211행과 数量積算基準 29행 모두 전사자와 승인자가 같아 **사람의 독립 검토**가 남았다(R6·ADR-023). `独立検討待ち` note는 일부 행에만 있는 장식이고 `confidence: transcribed`가 검토 대기의 기준이다. 에이전트는 코드로 이를 닫을 수 없으며, 사람 검토자가 원문 PDF와 대조해야 한다. 그 대조를 싸게 만드는 표별 대조 시트가 이 항목의 실제 작업이고, 대조 단위는 룰팩 243행이 아니라 **원문 표 8개＋단발항 17개＝25개 단위·135칸**이다(원문 표가 帯 구조라 룰팩이 fc·径으로 전개해 둔 것이고, 帯 내부 전개 불일치는 0으로 확인됐다)\r\ndocs/MILESTONES.md:14:- [x] **M3a** — 완료 (2026-08-12). 단일 스팬 大梁: girderSpan·단부 조건(직선/折曲げ定着 수용성 검사)·あばら筋 위치 배열 생성기 + 部材/建物 뷰 표시 + 뷰어 기능 4종(레이어 토글·단면 컷·호버 툴팁·정착 범례). 브라우저 실검증은 `tests/e2e/uc10-viewer-features.js`. **M2가 미완이므로 大梁 산출값도 아직 정식 물량이 아니다**\r\ndocs/MILESTONES.md:15:- [x] **M3b** — 완료 (2026-08-21). **다스팬 通し筋**(2026-08-12): 산정 단위가 부재에서 **런**(같은 通り芯 위 인접 大梁의 최대 연쇄)으로 바뀌었고 단일 스팬은 길이 1인 런이다. 通し筋은 중간 접합부를 관통해 定着이 양 끝에만 붙는다 → R7② 해소. `girderSupport`와 `UnsupportedReason`의 `'連続スパン'`은 함께 제거됐다. **継手箇所数 계상과 수량 단위 유니온(kg·箇所)**(2026-08-18) → R8 해소. **カットオフ筋과 継手方式 입력**(2026-08-21): 大梁 主筋을 位置別(端部·中央)로 받고 差를 カットオフ筋으로 낸다 — 外側支点은 定着＋切り止め位置, 中間支点은 位置×2＋中間柱せい(관통), 中央은 内法−位置×2다. 근거는 積算基準 2（３）梁1)「トップ筋、ハンチ部分の主筋、補強筋等は設計図書による」이고 切り止め位置는 그래서 입력이다(ADR-021). 継手方式은 断面一覧에서 고른다 — 이제 `重ね継手` 고정이 아니다. 실검증 `tests/e2e/uc11-continuous-girder.js`·`uc13-cutoff-splice.js`. **넘긴 것**: 継手位置는 表5.3.3이 원문에서 이미지라 미확정이라 3D에 그리지 않고 고지로 상시 표시한다(M0에서 닫힌 사실이라 M3b가 풀 수 없다). あばら筋의 位置別 피치(端部@100/中央@200)는 主筋과 달리 아직 단일 값이다 — M3c 이후. **M2가 미완이므로 大梁 산출값은 아직 정식 물량이 아니다**\r\ndocs/MILESTONES.md:16:- [x] **M3c** — 완료 (2026-08-28, ADR-022). 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **완료 판정**: 남은 것은 두 원문 0건이거나 제품이 형상·本数를 지어내야 하는 `パネルゾーン帯筋`·`溶接閉鎖フープ`뿐이며, 후자는 1通則2)에 따라 제작방식과 무관하게 断面周長으로 산정되어 수량도 변하지 않으므로 만들지 않기로 했다.\ndocs/MILESTONES.md:17:- [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `girderMainAsymmetric` 후보로 보존하고 phase 21에서 Grid 축 순서 자동 또는 사용자 선택으로 始端/終端에 반영한다. 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 좌우 상이 8칸은 방향 미선택을 기본으로 유지한 비대칭 후보로 반영 단계에 넘겼다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 고강도 전단보강근·円形柱 표현, `カットオフ` 값 반영 — 位置 열이 있는 3란 표는 phase 21에서 취입까지 닫혔고, 위치 없는 반폭 표기는 원문 `raw` 보존까지. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\r\ndocs/MILESTONES.md:19:- [x] **ST-Bridge 취입** — 완료 (2026-08-28, ADR-043·ADR-044). **끝난 것**: `.stb` → 중간표현 → 후보 → 승인 반영. 通り芯 그리드와 階 스택만 다루며 전부 브라우저 로컬이다. 실물 코퍼스 4건(전부 MIT)의 파서 무관 실측 대조가 CI에 상시로 걸려 있다. 검증 픽스처는 `document`·`expected`·`applied`가 각각 5건이고 합성 `.stb`는 2건이며, `STB_ISSUES`는 18개·`STB_APPLY_REFUSALS`는 4개다. **하지 않는 것**: 断面(`StbSec*`)·부재 배치·開口·かぶり·定着, `.stb` 쓰기, 재취입·차분 갱신, 버전 어댑터. **남은 것**: 사용자에게서 온 `.stb` 0건과 ver 2.1 계열 현실 규모 파일 0건은 대표성 없는 코퍼스 문제로 `R16`에 남기고, 비직교·원호·방사 通り芯과 `BASEMENT`·`ISOLATION`·`DEPENDENCE` 階는 ADR-043 결정 5에 따라 근사하지 않고 거부로 남긴다. **완료 판정**: 남은 것은 구현 누락이 아니라 `R16`이 받는 코퍼스 결손과 ADR-043·ADR-044가 의도적으로 거부하는 입력 범위다.\ndocs/MILESTONES.md:20:- [x] **부재 확장(耐震壁·床板)** — 완료 (2026-08-27, ADR-025·ADR-028·ADR-039). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **끝난 것**(開口補強筋 전사 입력, 2026-08-26, ADR-034·phase 22): 開口마다 `径・本数・設計長さ(mm)`를 설계도서에서 전사해 입력하고, 내역서에는 `開口補強筋`으로 계상한다. 3D는 위치·형상을 제품이 만들지 않도록 해당 role을 건물·부재 뷰에서 건너뛴다. 미전사 開口의 과소 계상은 상시 고지가 안내한다. **끝난 것**(片持床板, 2026-08-27, ADR-039): `数量積算基準` 躯体の区分（４）床板의 「片持床板等もこれらに準ずる。」, 같은 기준 2（４）床板2) 但書의 「単独床板及び片持床板の主筋の継手は、1通則4)による。」, `標準仕様書` 表5.3.4 L3의 「片持スラブの場合は25d」 예외(150mm 하한은 적용하지 않음), 表5.3.5 注1·2의 La·Lb(「片持スラブを含む」·「片持スラブを除く」)를 근거로 지원을 완료했다. 平面 뷰의 壁·床板 배치·삭제 입력은 phase 26(ADR-038)에서 완료\r\ndocs/MILESTONES.md:21:- [ ] **일본 고유 형태·제품 확장** — 진행 중 (2026-08-22 착수). 후보를 두 원문 전수 검색으로 재고 4개를 골랐다. **끝난 것**: ① **高強度せん断補強筋**(K13·S13, ADR-026) — `帯筋`·`あばら筋` 전용 呼び名이다. 두 원문에 「高強度」·「大臣認定」이 **0건**인데도 만들 수 있는 이유는 1通則2)가 フープ 長さ를 断面周長으로 정해 **径으로 引는 룰팩 행이 帯筋에 하나도 없기** 때문이다 — 룰팩 신규 행 0. 主筋·壁筋은 定着·重ね継手를 径으로 引으므로 타입(`ShearBarSize`)이 막는다. 断面リスト 파서도 읽는다. ② **円形柱**(ADR-027) — 1通則2)의 「断面の設計寸法による周長」이 円形에서는 원주 π×直径이다. 조문이 형상을 矩形으로 한정하지 않으므로 여기서도 룰팩 신규 행이 0이다. `ColumnSection.shape`(스키마 v9)로 받고 b·d를 둘 다 直径으로 둔다 — 大梁 内法·3D 柱面·平面 히트영역이 전부 b·d에서 나오므로 外接寸法을 그대로 두면 형상 추가가 계측을 흔들지 않는다. 3D는 円柱와 円形フープ(24각형 作図規則)다. `600φ`도 파싱한다. **スパイラル筋은 만들지 않는다** — 継手·定着이 図5.3.5＝이미지다. **끝난 것**: ③ **雑壁** — 区分(`wallClass`)·かぶり·40d 하한은 phase 24(ADR-036)로 완료. 부분 높이·부분 길이 형상은 phase 25(ADR-037)로 완료. **만들지 않는다 — 별개 마일스톤(ADR-042)**: **壁式構造の壁**(積算基準 2（５）壁**2)**의 端部筋·縦筋·壁梁筋·横筋·補強筋 5구분). **만들지 않는 것**: `免震`(0건, ADR-025)·スパイラル筋의 継手·定着(図5.3.5＝**이미지**라 表5.3.3과 같은 함정)·機械式定着(標準仕様書 5.3.4(ｳ)가 전부 「特記による」라 제품이 가질 값이 없다). `ガス圧接`·`機械式継手`는 M3b에서 이미 끝났다\r\ndocs/MILESTONES.md:22:- [x] **M4** — 완료 (2026-08-22). 네 갈래다. ① **재방문 경로**: `src/lib/persist/`(IndexedDB 자동저장 500ms 디바운스 ＋ 案件 JSON 저장/불러오기)와 `useProjectPersistence`. 복원 불가한 기록(옛 schemaVersion·끊긴 문자열)은 조용히 버리고 샘플로 착지한다 — 기동 경로라 던지면 지울 방법 없이 화면이 하얘진다. 반대로 사용자가 고른 파일이 안 읽히면 **말한다**(지금 案件은 남긴 채). ② **내역서 양식**: xlsx에 층별 小計 행과 `径別集計` 시트를 넣었다(`sizeSubtotals`는 径마다 독립해서 null이 된다 — 「어느 径이 아직 発注 불가인가」가 이 표의 용도라 欠損이 다른 径을 물들이면 안 된다). ③ **PDF**: 라이브러리 대신 브라우저 인쇄 경로(`@media print` ＋ `window.print()`). 종이도 같은 `WorkbookSpec`에서 나오고, 出典·算出式 두 열은 열 정의의 `printed` 플래그로 뺀다(PDL1.0 의무는 算出根拠 블록이 진다). ④ **glTF(glb)**: `EXT_mesh_gpu_instancing`으로 案件 전체를 낸다. **화면의 표시 반경이 아니라 実寸이다** — `rebarRadius`는 가독성용으로 최소 ⌀14·1.6배로 부풀린 값이라 그대로 내면 D25가 ⌀40으로 실측된다(ADR-024). 스트레스는 `tests/stress/multi-story.test.ts`(5층 45,885 인스턴스)와 실브라우저 `tests/e2e/uc17-stress-building.js`로 잰다. glb에도 出典·改変·ADR-015 경고가 `scene.userData`(＝extras)로 실린다 — 書き出し 경로마다 표시 의무가 면제되지 않는다. **3D를 쓰는 코드는 押した時에 받는다**: 헤더 상주 釦이 `gltf.ts`를 정적 import하면 three가 `/`의 차단 경로로 돌아오는데, Lighthouse 예산은 이것을 통과시킨다(뷰어가 어차피 three를 받으므로 총량이 안 변한다). 확인은 `.next/app-build-manifest.json`의 `pages['/page']`로 한다\r\ndocs/MILESTONES.md:23:- **2026-08-27 정정 (ADR-042)**: 위 일본 고유 형태·제품 항의 이전 「남은 것」 표기는 정정한다. 壁式構造の壁은 조문을 전사했으나 만들지 않는다 — 별개 마일스톤(ADR-042)이며 해당 항의 잔여 항목으로 세지 않는다. 이전 서술은 변경 경위 보존용이다.\r\ndocs/MILESTONES.md:24:- [ ] **M5** — 한국 실무자 UX 리뷰 반영\r\n--- risk ids ---\r\nCLAUDE.md:R1\r\nCLAUDE.md:R10\r\nCLAUDE.md:R11\r\nCLAUDE.md:R12\r\nCLAUDE.md:R13\r\nCLAUDE.md:R14\r\nCLAUDE.md:R15\r\nCLAUDE.md:R16\r\nCLAUDE.md:R2\r\nCLAUDE.md:R3\r\nCLAUDE.md:R4\r\nCLAUDE.md:R5\r\nCLAUDE.md:R6\r\nCLAUDE.md:R7\r\nCLAUDE.md:R8\r\nCLAUDE.md:R9\r\ndocs/RISKS.md:R1\r\ndocs/RISKS.md:R10\r\ndocs/RISKS.md:R11\r\ndocs/RISKS.md:R12\r\ndocs/RISKS.md:R13\r\ndocs/RISKS.md:R14\r\ndocs/RISKS.md:R15\r\ndocs/RISKS.md:R16\r\ndocs/RISKS.md:R2\r\ndocs/RISKS.md:R3\r\ndocs/RISKS.md:R4\r\ndocs/RISKS.md:R5\r\ndocs/RISKS.md:R6\r\ndocs/RISKS.md:R7\r\ndocs/RISKS.md:R8\r\ndocs/RISKS.md:R9\r\n--- closed-track terms src/tests ---\r\ntests\\fixtures\\stb-import\\document\\mini.json:130:  \"unsupportedAxisKinds\": [],\r\ntests\\golden\\quantity-measurement.test.ts:2119:    roles: 'ADR-042 2) — 壁式構造の壁の役割を3つに限定する',\r\ntests\\golden\\quantity-measurement.test.ts:2126:      '壁式構造の壁筋は、端部筋、縦筋、壁梁筋、横筋及び補強筋に区分して計測・計算する。なお、設計図書に鉄筋本数の記載がある場合はその本数とする。',\r\ntests\\fixtures\\stb-import\\document\\hoaryfox-sample.json:1270:  \"unsupportedAxisKinds\": [],\ntests\\fixtures\\stb-import\\document\\dotnet-sample1.json:492:  \"unsupportedAxisKinds\": [],\ntests\\fixtures\\stb-import\\document\\diffchecker-mini210.json:33:  \"unsupportedAxisKinds\": [],\ntests\\fixtures\\stb-import\\document\\diffchecker-filea.json:1434:  \"unsupportedAxisKinds\": [],\ntests\\golden\\fixtures\\quantity-r5-ch3.json:32:      \"quote\": \"床板とは、柱、梁等に接する水平材の内法部分をいう。ただし、壁式構造については、壁、壁梁等に接する水平材の内法部分をいう。片持床板等もこれらに準ずる。\",\r\ntests\\golden\\fixtures\\quantity-r5-ch3.json:33:      \"usedFor\": \"2（４）床板1) の「床板の長さ」と 1通則7) の「その部分の長さ」— 床板は柱・梁に接する内法部分なので、長さは通り芯間ではなく両側の大梁の内側面の間である。大梁・柱と二重計上しないのはこの定義による（大梁が内法長さ、壁が内法部分なのと同じ形）。ただし書きの壁式構造は扱わない (ADR-025)\"\r\ntests\\golden\\fixtures\\quantity-r5-ch3.json:39:      \"quote\": \"壁とは、柱、梁、床板等に接する垂直材の内法部分をいい、開口部を除く。ただし、壁式構造については、基礎上面から屋上床板上面までの垂直材をいい、開口部を除く。袖壁、下り壁、腰壁等もこれらに準ずる。\",\r\ntests\\golden\\fixtures\\quantity-r5-ch3.json:40:      \"usedFor\": \"2（５）壁1)① の「壁の高さ又は長さ」と 1通則7) の「その部分の長さ」— 壁式構造以外の壁は内法部分なので、高さは階高から上部大梁せいを引いた内法高さ、長さは両側の柱面間の内法長さである。柱・大梁と二重計上しないのはこの定義による（大梁が内法長さなのと同じ形）。「開口部を除く」は 1通則8) の欠除規定に対応する\"\r\ntests\\golden\\fixtures\\quantity-r5-ch3.json:233:      \"quote\": \"壁式構造の壁筋は、端部筋、縦筋、壁梁筋、横筋及び補強筋に区分して計測・計算する。なお、設計図書に鉄筋本数の記載がある場合はその本数とする。\",\r\ntests\\golden\\fixtures\\quantity-r5-ch3.json:237:      \"reason\": \"ADR-042 §1-2。壁式構造の壁は5区分と布基礎・壁梁を伴う別のマイルストーンであり、現行製品の耐震壁は2（５）壁1)「壁式構造以外」だけを実装するため、部分実装で不足数量を出さない。\",\r\ntests\\golden\\fixtures\\quantity-r5-ch