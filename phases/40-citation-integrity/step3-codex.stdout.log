tep6-report.json')\nold = json.loads(old_path.read_text(encoding='utf-8'))\nmutations = old['items']['2_golden_falsifiability']['evidence'][0]['mutations']\nassert [entry['fixture'] for entry in mutations] == report['historical_incident']['fabricated_paths']\ntracked = subprocess.run(['git', 'ls-files', '-z'], capture_output=True, text=True, encoding='utf-8', check=True).stdout.split('\\\\0')\nabsences = [{'fixture': entry['fixture'], 'matching_tracked_paths': [name for name in tracked if name.rsplit('/', 1)[-1] == entry['fixture']]} for entry in mutations]\nassert all(not entry['matching_tracked_paths'] for entry in absences)\nreport['historical_incident']['tracked_file_check'] = absences\nassert len(list(sources(old))) == 0\nresult = subprocess.run([sys.executable, 'scripts/check-citations.py', old_path.as_posix()], capture_output=True, text=True, encoding='utf-8')\nassert result.returncode == 0 and not result.stdout and not result.stderr\nreport['historical_incident'].update(exit_code=result.returncode, stdout=result.stdout, stderr=result.stderr)\npath.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\\\\n', encoding='utf-8')\nprint(json.dumps({'reports': checks, 'all_reports': report['validation']['all_reports'], 'historical_incident': report['historical_incident']}, ensure_ascii=False))\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
