,'total_tests':data.get('numTotalTests',0),'passed':data.get('numPassedTests',0),'failed':data.get('numFailedTests',0),'failures':failures,'valid':bool(assertions) and (outcome['exit_code']==0 or bool(failures))}\r\n\r\nbaseline=test()\r\nR['mutation_baseline']=baseline\r\nsave()\r\nassert baseline['valid'] and baseline['exit_code']==0\r\n\r\ndef mutation(file,field,operation,edit,category,pattern=None):\r\n assert file in paths\r\n original=Path(file).read_bytes()\r\n entry={'category':category,'file':file,'field':field,'operation':operation}\r\n try:\r\n  if file.endswith('.json'):\r\n   data=json.loads(original.decode('utf8'))\r\n   edit(data)\r\n   mutated=(json.dumps(data,ensure_ascii=False,indent=2)+'\\n').encode('utf8')\r\n  else: mutated=edit(original.decode('utf8')).encode('utf8')\r\n  assert mutated!=original\r\n  Path(file).write_bytes(mutated)\r\n  result=test(pattern)\r\n  entry.update(result)\r\n finally:\r\n  Path(file).write_bytes(original)\r\n  entry['restored_byte_identical']=Path(file).read_bytes()==original\r\n  restore=git('diff','--stat','--','tests/','src/','docs/')\r\n  entry['git_diff_stat_after_restore']=restore['stdout']\r\n  assert restore['exit_code']==0 and restore['stdout']=='' and entry['restored_byte_identical']\r\n entry['detected']=entry.get('valid',False) and entry['exit_code']!=0 and entry['failed']>0\r\n c=R['mutation_census']\r\n if entry.get('valid',False):\r\n  c['attempted']+=1\r\n  c['detected']+=int(entry['detected'])\r\n else: c['invalid_attempts']+=1\r\n c['records'].append(entry)\r\n save()\r\n if len(c['records'])%10==0: print(json.dumps({'progress':len(c['records']),'attempted':c['attempted'],'detected':c['detected'],'invalid':c['invalid_attempts']}),flush=True)\r\n return entry\r\n\r\np22=next(p for p in elevfiles if p.endswith('tsu-kanritou-p22-elevation.json'))\r\np16=next(p for p in gridfiles if p.endswith('tsu-kanritou-p16-grid.json'))\r\nleft=mutation(p22,'/elevations/0/axis/labels/0','replace with absent label',lambda d:d['elevations'][0]['axis']['labels'].__setitem__(0,'__phase40_absent_axis__'),'p22_crosscheck', 'tsu-kanritou-p22-elevation.json')\r\nright=mutation(p16,'/blocks/0/y/labels/0','replace with absent label',lambda d:d['blocks'][0]['y']['labels'].__setitem__(0,'__phase40_absent_axis__'),'p22_crosscheck','tsu-kanritou-p22-elevation.json')\r\nR['items']['3_p22_crosscheck_bites']={'holds':left['detected'] and right['detected'],'records':[0,1],'method':'Only named p22 crosscheck runs. Label replacement preserves label count, spans, and total, so self consistency cannot cause the failure.'}\r\nfor file,i,axis in axes:\r\n for j in range(len(axis['spansMm'])):\r\n  mutation(file,f'/elevations/{i}/axis/spansMm/{j}','+1',lambda d,i=i,j=j:d['elevations'][i]['axis']['spansMm'].__setitem__(j,d['elevations'][i]['axis']['spansMm'][j]+1),'axis_required')\r\n for j in range(len(axis['labels'])):\r\n  mutation(file,f'/elevations/{i}/axis/labels/{j}','delete one label',lambda d,i=i,j=j:d['elevations'][i]['axis']['labels'].pop(j),'axis_required')\r\n if axis['totalMm'] is not None:\r\n  mutation(file,f'/elevations/{i}/axis/totalMm','+1',lambda d,i=i:d['elevations'][i]['axis'].__setitem__('totalMm',d['elevations'][i]['axis']['totalMm']+1),'axis_required')\r\n# Additional label substitutions preserve self-consistency and exercise cross-document value claims.\r\nfor file,i,axis in axes:\r\n for j in range(len(axis['labels'])):\r\n  mutation(file,f'/elevations/{i}/axis/labels/{j}','replace with absent label',lambda d,i=i,j=j:d['elevations'][i]['axis']['labels'].__setitem__(j,'__phase40_absent_axis__'),'axis_label_substitution')\r\nrequired=[r for r in R['mutation_census']['records'] if r['category']=='axis_required']\r\nsubs=[r for r in R['mutation_census']['records'] if r['category']=='axis_label_substitution']\r\nR['items']['4_axis_all_claimed']={'holds':all(r['detected'] for r in required+subs),'required':{'attempted':len(required),'detected':sum(r['detected'] for r in required)},'supplemental_self_consistency_preserving_label_substitutions':{'attempted':len(subs),'detected':sum(r['detected'] for r in subs)},'inventory':R['axis_inventory'],'prior_claim':'The supplied 26 counts grid plus elevation axes. This gate enumerates all 10 elevation axes directly; the earlier 375 count is not copied as this run measurement.'}\r\nneedle='expect(skippedAxisCount).toBe(0)'\r\nassert Path(TEST).read_text(encoding='utf8').count(needle)==1\r\ncountcheck=mutation(TEST,'expect(skippedAxisCount).toBe(0)','change expected 0 to 1',lambda s:s.replace(needle,'expect(skippedAxisCount).toBe(1)'),'no_untranscribed_axis')\r\nR['items']['5_no_untranscribed_axis']={'holds':missing==0 and countcheck['detected'],'actual_missing':missing,'expected_count_mutation_detected':countcheck['detected'],'mutation_record':len(R['mutation_census']['records'])-1}\r\nR['post_restore_regression']=test()\r\nassert R['post_restore_regression']['exit_code']==0\r\nsave()\r\nprint('MUTATIONS COMPLETE',flush=True)\r\nimport concurrent.futures, datetime, hashlib, json, os, re, subprocess\r\nfrom pathlib import Path\r\nROOT=Path.cwd()\r\nTEMP=Path(os.environ['TEMP'])/'kijun-phase40-step4'\r\nEVIDENCE=TEMP/'evidence.json'\r\nR=json.loads(EVIDENCE.read_text(encoding='utf8'))\r\n\r\ndef run(args):\r\n started=datetime.datetime.now(datetime.timezone.utc).isoformat()\r\n p=subprocess.run(args,cwd=ROOT,capture_output=True,encoding='utf8',errors='replace')\r\n return {'command':subprocess.list2cmdline(args),'started_at':started,'exit_code':p.returncode,'stdout':p.stdout,'stderr':p.stderr}\r\ndef save(): EVIDENCE.write_text(json.dumps(R,ensure_ascii=False,indent=2)+'\\n',encoding='utf8')\r\n\r\nreport='phases/40-citation-integrity/step2-report.json'\r\nchecker=['python','scripts/check-citations.py','phases/40-citation-integrity/step*-report.json']\r\npositive=run(checker)\r\nassert any(p['path']==report and p['exit_code']==0 for p in R['paths_verified'])\r\noriginal=Path(report).read_bytes()\r\nd=json.loads(original.decode('utf8'))\r\noriginal_citation=d['numbers_used'][0]['source']\r\nsourcefile,_,ptr=original_citation.partition('#')\r\nroot=json.loads(Path(sourcefile).read_text(encoding='utf8'))\r\nkey='__phase40_step4_missing__'\r\nassert key not in root\r\ntry:\r\n d['numbers_used'][0]['source']=sourcefile+'#/'+key\r\n Path(report).write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\\n',encoding='utf8')\r\n negative=run(checker)\r\nfinally:\r\n Path(report).write_bytes(original)\r\nrestore=run(['git','diff','--stat','--','tests/','src/','docs/'])\r\nidentical=Path(report).read_bytes()==original\r\nassert identical and restore['stdout']=='' and restore['exit_code']==0\r\nnegative_valid=negative['exit_code']!=0 and key in negative['stdout'] and 'missing_key' in negative['stdout']\r\npost_restore=run(checker)\r\nR['items']['7_checker_works']={'holds':positive['exit_code']==0 and negative_valid and post_restore['exit_code']==0,'normal_reports':positive,'mutated_report':report,'mutated_field':'/numbers_used/0/source','original_source':original_citation,'negative_mutation':'replace pointer with a single nonexistent root key; no invalid citation is retained in this report','missing_key':key,'negative':negative,'restored':post_restore,'restored_byte_identical':identical,'restored_sha256':hashlib.sha256(original).hexdigest()}\r\nc=R['mutation_census']\r\nc['attempted']+=1\r\nc['detected']+=int(negative_valid)\r\nc['records'].append({'category':'checker_missing_pointer','file':report,'field':'/numbers_used/0/source','operation':'point to verified absent root key','missing_key':key,'valid':True,'detected':negative_valid,'exit_code':negative['exit_code'],'restored_byte_identical':identical,'git_diff_stat_after_restore':restore['stdout']})\r\nsave()\r\n\r\ncommands=[['npx.cmd','vitest','run'],['npm.cmd','run','lint'],['npx.cmd','tsc','--noEmit']]\r\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:\r\n futures={pool.submit(run,args):i for i,args in enumerate(commands)}\r\n results={}\r\n for f in concurrent.futures.as_completed(futures):\r\n  i=futures[f]\r\n  results[i]=f.result()\r\n  (TEMP/('gate'+str(i)+'.json')).write_text(json.dumps(results[i],ensure_ascii=False,indent=2),encoding='utf8')\r\n  print(json.dumps({'gate':results[i]['command'],'exit_code':results[i]['exit_code']}),flush=True)\r\nquery=\"$items = @(Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -match '(next[\\\\\\\\/]dist[\\\\\\\\/]bin[\\\\\\\\/]next|next dev|start-server)' } | Select-Object ProcessId,ParentProcessId,CommandLine); ConvertTo-Json -InputObject $items -Depth 3 -Compress\"\r\nprebuild=run(['powershell','-NoProfile','-Command',query])\r\nassert prebuild['exit_code']==0\r\nprocesses=json.loads(prebuild['stdout'])\r\nif processes:\r\n build={'command':'npm run build','exit_code':None,'not_run_reason':'next process is present; shared .next must not be overwritten'}\r\nelse:\r\n build=run(['npm.cmd','run','build'])\r\n(TEMP/'gate3.json').write_text(json.dumps(build,ensure_ascii=False,indent=2),encoding='utf8')\r\nprint(json.dumps({'gate':'npm run build','exit_code':build['exit_code']}),flush=True)\r\nR['items']['9_full_gates']={'holds':all(results[i]['exit_code']==0 for i in results) and build['exit_code']==0,'vitest':results[0],'lint':results[1],'tsc':results[2],'prebuild_process_check':prebuild,'next_processes':processes,'build':build}\r\nrestore=run(['git','diff','--stat','--','tests/','src/','docs/'])\r\nR['restoration'].update({'command':restore['command'],'exit_code':restore['exit_code'],'git_diff_stat_after_restore':restore['stdout'],'checked_after_every_mutation':True,'checks':len(c['records'])})\r\nassert restore['stdout']=='' and restore['exit_code']==0\r\nsave()\r\nprint('GATES COMPLETE',flush=True)\r\nimport collections, datetime, hashlib, json, os, re, subprocess\r\nfrom pathlib import Path\r\nTEMP=Path(os.environ['TEMP'])/'kijun-phase40-step4'\r\nR=json.loads((TEMP/'evidence.json').read_text(encoding='utf8'))\r\nassert len(R['items'])==9\r\nR['items']=dict(sorted(R['items'].items()))\r\nR['verdict']='refuted' if any(not x['holds'] for x in R['items'].values()) else 'upheld'\r\nR['summary']='comment_clean 반증 성립: elevation.ts 주석에 150mm가 남아 step 4 금지 조건 위반. 인용 근거는 존재하며, 나머지 8항목·172/172 변조·1809 테스트·lint·tsc·build 통과.'\r\nR['completed_at']=datetime.datetime.now(datetime.timezone.utc).isoformat()\r\nR['mutation_census']['counting_policy']='attempted/detected include valid, actually applied single-cell mutations only; setup failures and no-test runs would be invalid_attempts and are not detections.'\r\ncounts=collections.defaultdict(lambda:{'attempted':0,'detected':0,'invalid_attempts':0})\r\nfor r in R['mutation_census']['records']:\r\n c=counts[r['category']]\r\n if r['valid']:\r\n  c['attempted']+=1\r\n  c['detected']+=int(r['detected'])\r\n else: c['invalid_attempts']+=1\r\n # Keep assertion text without machine-specific stack traces; test names and messages still identify each detection.\r\n for failure in r.get('failures',[]):\r\n  failure['messages']=[m.split('\\n')[0] for m in failure['messages']]\r\nR['mutation_census']['by_category']=dict(counts)\r\nR['verification_method']='Fresh Vitest CLI process for each fixture/test mutation. JSON reporter must contain executed assertion results and assertion failures; a nonzero exit without an assertion failure is invalid. Restore original bytes in finally and run git diff --stat -- tests/ src/ docs/ after each mutation.'\r\n\r\npattern=re.compile(r'[A-Za-z0-9_.\\-/]+\\.json#/[^\\s`\\\"\\'<>\\\\),;]+')\r\ndef citations(value):\r\n if isinstance(value,dict):\r\n  for x in value.values(): yield from citations(x)\r\n elif isinstance(value,list):\r\n  for x in value: yield from citations(x)\r\n elif isinstance(value,str):\r\n  yield from pattern.findall(value)\r\n\r\ndef resolve(citation):\r\n file,ptr=citation.split('#',1)\r\n assert Path(file).is_file(),file\r\n value=json.loads(Path(file).read_text(encoding='utf-8-sig'))\r\n for raw in ptr[1:].split('/'):\r\n  assert not re.search(r'~(?![01])',raw)\r\n  key=raw.replace('~1','/').replace('~0','~')\r\n  if isinstance(value,list):\r\n   assert re.fullmatch(r'0|[1-9][0-9]*',key)\r\n   value=value[int(key)]\r\n  else:\r\n   assert isinstance(value,dict)\r\n   value=value[key]\r\n return value\r\n\r\nallcitations=sorted(set(citations(R)))\r\nregistered={p['citation'] for p in R['pointers_verified']}\r\nfor citation in allcitations:\r\n value=resolve(citation)\r\n if citation not in registered:\r\n  row={'citation':citation,'usage':'final full-report string scan','file_exists':True,'resolved':True,'value_type':type(value).__name__}\r\n  if isinstance(value,(str,int,float,bool)) or value is None: row['value']=value\r\n  else: row['size']=len(value)\r\n  R['pointers_verified'].append(row)\r\nR['pointer_audit']={'method':'Independent Python JSON traversal: object keys, zero-based array indices, RFC 6901 escape decoding. Every file-qualified pointer anywhere in report strings is resolved directly, including pointers repeated in evidence and in this registry. This does not rely on check-citations.py.','unique_pointers':len(allcitations),'checked_occurrences_before_registry_completion':len(list(citations(R))),'failed':0}\r\nassert all(p['resolved'] for p in R['pointers_verified'])\r\nassert allcitations==sorted(set(citations(R)))\r\nassert R['restoration']['git_diff_stat_after_restore']==''\r\nassert R['mutation_census']['attempted']==172 and R['mutation_census']['detected']==172\r\nreport=Path('phases/40-citation-integrity/step4-report.json')\r\nreport.write_text(json.dumps(R,ensure_ascii=False,indent=2)+'\\n',encoding='utf8')\r\n# Re-read the delivered bytes, resolve every pointer again, and verify registry coverage.\r\nsaved=json.loads(report.read_text(encoding='utf8'))\r\nfor citation in set(citations(saved)): resolve(citation)\r\nassert set(citations(saved)) <= {p['citation'] for p in saved['pointers_verified']}\r\nassert all(r['git_diff_stat_after_restore']=='' and r['restored_byte_identical'] for r in saved['mutation_census']['records'])\r\nprint(json.dumps({'verdict':saved['verdict'],'report_bytes':report.stat().st_size,'unique_pointers':len(set(citations(saved))),'registered_occurrences':len(saved['pointers_verified']),'items':{k:v['holds'] for k,v in saved['items'].items()},'mutations':saved['mutation_census']['by_category']},ensure_ascii=False))\r\n","exit_code":0,"status":"completed"}}
