ed\": true\r\n      },\r\n      {\r\n        \"file\": \"karatsu-jikugumi1-p1.json\",\r\n        \"sha256\": \"a617ac8945d26bde0ad9b3546ffd04c3d4c5a1622bfdc8e8c73d293fec56563b\",\r\n        \"output_unchanged\": true\r\n      },\r\n      {\r\n        \"file\": \"karatsu-jikugumi2-p1.json\",\r\n        \"sha256\": \"4ca1a6ede495e00d16020d1f4a14bdd15fcaded12492dbd11ce534fa9626ebde\",\r\n        \"output_unchanged\": true\r\n      },\r\n      {\r\n        \"file\": \"karatsu-shousai-p1.json\",\r\n        \"sha256\": \"48540a95fa0df72ff79da0ce122e4a746297296a8cc4cccaacfafbc4835d06f5\",\r\n        \"output_unchanged\": true\r\n      },\r\n      {\r\n        \"file\": \"ojkk-p2.json\",\r\n        \"sha256\": \"016373e5b0e16bb1d949da91c59dd0edf89f9615ebe3f6c61e82f6b5b1cacf9d\",\r\n        \"output_unchanged\": true\r\n      },\r\n      {\r\n        \"file\": \"ojkk-p3.json\",\r\n        \"sha256\": \"b51cc8dbc2ce7ea519a6cbf086037ccd774dc4fc321a283c4d0f7cbe63fcaccc\",\r\n        \"output_unchanged\": true\r\n      },\r\n      {\r\n        \"file\": \"ojkk-p4.json\",\r\n        \"sha256\": \"48c9f95abf2132556c6b85bd7d8606ba492722a48e91d456ba89919e444f618b\",\r\n        \"output_unchanged\": true\r\n      },\r\n      {\r\n        \"file\": \"saiki-p1.json\",\r\n{\r\n  \"phase\": \"40-citation-integrity\",\r\n  \"step\": 3,\r\n  \"step_name\": \"citation-checker\",\r\n  \"status\": \"completed\",\r\n  \"implementation\": {\r\n    \"source\": \"scripts/check-citations.py\",\r\n    \"scope\": \"report 내부를 재귀 순회해 문자열 source만 검사한다. 파일 존재와 JSON 포인터 해석 여부만 판정하며 인용 내용의 진실성이나 실제 테스트의 대조 효력은 판정하지 않는다.\",\r\n    \"paths\": \"입력 report와 glob은 실행 디렉터리 기준, 상대 source 경로는 저장소 루트 기준이다. 절대 경로도 허용한다.\",\r\n    \"pointer\": \"object key, 배열의 0 기반 인덱스, ~0/~1 escape와 빈 포인터를 해석한다. 현재 report에서 쓰는 로컬 경로#포인터 형식만 다룬다.\",\r\n    \"diagnostics\": [\r\n      \"file_missing\",\r\n      \"missing_key\",\r\n      \"array_index\",\r\n      \"json_parse_error\",\r\n      \"invalid_pointer\",\r\n      \"pointer_type\",\r\n      \"file_read_error\"\r\n    ],\r\n    \"dependencies\": \"Python 표준 라이브러리만 사용\",\r\n    \"line_count\": 90\r\n  },\r\n  \"validation\": {\r\n    \"tdd\": {\r\n      \"method\": \"임시 디렉터리에 JSON/일반 파일을 만든 표준 라이브러리 subprocess assertion 검사를 구현 전에 실행하고 구현 후 같은 검사를 재실행했다. 임시 파일은 정리했으며 별도 테스트 파일이나 기존 테스트 변경은 없다.\",\r\n      \"red_exit_code\": 1,\r\n      \"red_stdout\": \"Traceback (most recent call last):\\r\\n  File \\\"<stdin>\\\", line 36, in <module>\\r\\n  File \\\"<stdin>\\\", line 26, in check\\r\\nAssertionError: ('nested object-array pointer resolves null', 2, '', \\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\anaconda3\\\\\\\\python.exe: can't open file 'C:\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\emper\\\\\\\\\\\\\\\\mdtproject\\\\\\\\\\\\\\\\scripts\\\\\\\\\\\\\\\\check-citations.py': [Errno 2] No such file or directory\\\\n\\\")\\r\\n\",\r\n      \"green_exit_code\": 0,\r\n      \"passed\": 26,\r\n      \"cases\": [\r\n        {\r\n          \"name\": \"nested object-array pointer resolves null\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n          \"name\": \"escaped slash and tilde resolve false\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n          \"name\": \"empty key resolves zero\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n          \"name\": \"numeric object key is not an array index\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n          \"name\": \"empty pointer resolves root\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n          \"name\": \"plain file need not be JSON\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n          \"name\": \"repository relative source\",\r\n          \"exit_code\": 0,\r\n          \"stdout\": \"\"\r\n        },\r\n        {\r\n  