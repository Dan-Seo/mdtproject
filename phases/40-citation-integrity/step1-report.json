    "option": "a",
    "reason": "36면을 재계측하여 기존 편차와 치수의 대응을 확인했다. 150mm 귀속은 새 계측 근거를 인용하고 반올림 편차 표기는 인용 report의 정확한 값으로 교체했다."
  },
  "measured": {
    "method": "현재 elevation.ts의 소스를 메모리에서만 계측했다. chains()의 shortDimension이 참일 때 다음 치수 토큰·좌표·기준 축척·관측 축척을 기록했다. 제품 파일에 계측 코드를 쓰지 않았고, 36면 모두 계측 전후 parseFrameElevations 전체 JSON 출력이 동일했다.",
    "source": "src/lib/import/framing-plan/elevation.ts",
    "source_sha256_before_comment_edit": "bc08eb054437274d1d36bbb10f432342bbb8827ccc75cd4c420e26fc40071ed2",
    "command": "node --import tsx --input-type=module (아래 script를 stdin으로 전달)",
    "script": "import fs from 'node:fs';\nimport path from 'node:path';\nimport crypto from 'node:crypto';\nimport ts from 'typescript';\nimport { pathToFileURL } from 'node:url';\nimport { parseFrameElevations } from './src/lib/import/framing-plan/elevation.ts';\nconst sourcePath = 'src/lib/import/framing-plan/elevation.ts';\nconst source = fs.readFileSync(sourcePath, 'utf8');\nconst marker = '    if (continues || shortDimension) {';\nif (source.split(marker).length !== 2) throw new Error('Instrumentation site changed');\nconst instrumented = source.replace(marker,\n  '    if (shortDimension) globalThis.__kijunShortProbe.push({ dimension: column[i + 1], previous: column[i], referenceScale: reference, observedScale: scale, deviation: Math.abs(scale / reference - 1), roundedDeviation: Number(Math.abs(scale / reference - 1).toFixed(6)), ordinaryContinues: continues });\\n' + marker\n).replace(\"from '../runs'\", \"from '\" + pathToFileURL(path.resolve('src/lib/import/runs.ts')).href + \"'\");\nconst js = ts.transpileModule(instrumented, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } }).outputText;\nconst probe = await import('data:text/javascript;base64,' + Buffer.from(js).toString('base64'));\nconst directory = 'tests/fixtures/section-import/textitems';\nconst files = fs.readdirSync(directory).filter(file => file.endsWith('.json')).sort();\nconst pages = [];\nfor (const file of files) {\n  const bytes = fs.readFileSync(path.join(directory, file));\n  const fixture = JSON.parse(bytes);\n  const page = { ...fixture.page, items: fixture.items };\n  globalThis.__kijunShortProbe = [];\n  const baseline = parseFrameElevations(page);\n  const measured = probe.parseFrameElevations(page);\n  if (JSON.stringify(baseline) !== JSON.stringify(measured)) throw new Error('Probe changed output: ' + file);\n  pages.push({ file, sha256: crypto.createHash('sha256').update(bytes).digest('hex'), observations: globalThis.__kijunShortProbe, outputUnchanged: true });\n}\ndelete globalThis.__kijunShortProbe;\nconst prior = JSON.parse(fs.readFileSync('phases/38-elevation-close/step3-report.json', 'utf8'));\nconst matches = prior.short_dimension_sweep.observed.map(entry => {\n const actual = pages.find(page => page.file === entry.page);\n const observed = actual.observations.map(item => item.roundedDeviation);\n return { file: entry.page, expected: entry.short_dimension_deviations, actual: observed, matches: JSON.stringify(observed) === JSON.stringify(entry.short_dimension_deviations) };\n});\nif (pages.length !== prior.short_dimension_sweep.pages || matches.some(item => !item.matches)) throw new Error('Survey does not reproduce prior report');\nconsole.log(JSON.stringify({ source: sourcePath, sourceSha256: crypto.createHash('sha256').update(source).digest('hex'), pageCount: pages.length, pages, priorReportMatches: matches }));",
