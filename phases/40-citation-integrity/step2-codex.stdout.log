"]\r\n      }\r\n    ],\r\n    \"acceptedSentences\": [\r\n      {\r\n        \"text\": \"・基礎梁天端から1FLまでは打増しとする。\",\r\n        \"pages\": [\"tsu-p21.json\", \"tsu-p22.json\"]\r\n      },\r\n      {\r\n        \"text\": \"支持地盤は、GL-900以下の弱風化花崗岩層とする\",\r\n        \"pages\": [\"karatsu-fukuzu-p1.json\"]\r\n      },\r\n      {\r\n        \"text\": \"特記なき地中梁天端は、GL-100とする\",\r\n        \"pages\": [\"karatsu-fukuzu-p1.json\"]\r\n      },\r\n      {\r\n        \"text\": \"特記なき1階土間床天端は、GL+150とする\",\r\n        \"pages\": [\"karatsu-fukuzu-p1.json\"]\r\n      }\r\n    ],\r\n    \"rejectedLevelLikeStrings\": [\r\n      {\r\n        \"text\": \"1SL\",\r\n        \"pages\": [\"tsu-p21.json\", \"tsu-p22.json\"],\r\n        \"occurrences\": 4\r\n      },\r\n      {\r\n        \"text\": \"2SL\",\r\n        \"pages\": [\"saiki-p2.json\"],\r\n        \"occurrences\": 1\r\n      },\r\n      {\r\n        \"text\": \"2SL(水下)\",\r\n        \"pages\": [\"saiki-p2.json\"],\r\n        \"occurrences\": 1\r\n      },\r\n      {\r\n        \"text\": \"SL+756.70\",\r\n        \"pages\": [\"ina-p6.json\"],\r\n        \"occurrences\": 3\r\n      },\r\n      {\r\n        \"text\": \"RSL+760.00\",\r\n        \"pages\": [\"ina-p6.json\"],\r\n        \"occurrences\": 3\r\n      }\r\n    ],\r\n    \"interpretation\": \"화이트리스트는 문자열을 통과시키는 1차 후보 판정일 뿐이며, 실제 결과는 LABEL_WINDOW_PT와 레벨 위치 허용 범위·y 순서 대응을 모두 통과해야 한다.\"\r\n  },\r\n  \"kindFromMark\": {\r\n    \"pattern\": \"story prefix 제거 후 ^G\",\r\n    \"census\": {\r\n      \"scope\": \"tests/fixtures/section-import/expected/*.json의 12개 전사 목록\",\r\n      \"pattern\": \"^G[A-Z]\",\r\n      \"matches\": [\r\n        {\r\n          \"file\": \"ina-pump-p7-lists.json\",\r\n          \"mark\": \"GA\",\r\n          \"kind\": \"大梁\"\r\n        }\r\n      ],\r\n      \"uniqueMatchCount\": 1,\r\n      \"GB1Count\": 0,\r\n      \"GW1Count\": 0\r\n    }\r\n  },\r\n  \"verification\": {\r\n    \"behaviorChange\": false,\r\n    \"addedTests\": [\r\n      \"1SL is not a leve