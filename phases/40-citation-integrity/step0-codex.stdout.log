ing='utf-8-sig')) for p in files}\naxes=[]\nelevations=[]\ndef walk(value,pointer,path):\n    if isinstance(value,dict):\n        if 'labels' in value and 'spansMm' in value:\n            labels=value['labels']; ds=value['spansMm']; total=value.get('totalMm')\n            axes.append({'source':path+'#'+pointer,'labels':labels,'spansMm':ds,'totalMm':total,'label_count':len(labels),'span_count':len(ds),'sumMm':sum(ds),'label_count_matches':len(labels)==len(ds)+1,'total_matches':None if total is None else sum(ds)==total})\n        if 'elevations' in value:\n            for i,e in enumerate(value['elevations']):\n                elevations.append({'source':path+'#'+pointer+'/elevations/'+str(i),'has_axis':isinstance(e.get('axis'),dict)})\n        for k,v in value.items(): walk(v,pointer+'/'+k.replace('~','~0').replace('/','~1'),path)\n    elif isinstance(value,list):\n        for i,v in enumerate(value): walk(v,pointer+'/'+str(i),path)\nfor path,data in loaded.items(): walk(data,'',path)\n\nf16=(expected_root/'tsu-kanritou-p16-grid.json').as_posix()\nf21=(expected_root/'tsu-kanritou-p21-elevation.json').as_posix()\nf22=(expected_root/'tsu-kanritou-p22-elevation.json').as_posix()\ngrid=loaded[f16]['blocks'][0]['y']\nreversed_grid={'labels':list(reversed(grid['labels'])),'spansMm':list(reversed(grid['spansMm'])),'totalMm':grid['totalMm']}\nb4pdf=all(b['label_list']==grid['labels'] and [d['mm'] for d in b['dimensions']]==grid['spansMm'] and [d['between'] for d in b['dimensions']]==[list(p) for p in zip(grid['labels'],grid['labels'][1:])] and [d['mm'] for d in b['totals']]==[grid['totalMm']] for b in p16blocks)\nb4=b2 and b4pdf and all(e['axis']==reversed_grid for e in loaded[f22]['elevations'])\n\norientation=[]\nfor observed,page_index,letter in [(p21,20,'Ｘ'),(p22,21,'Ｙ')]:\n    page=doc[page_index]\n    all_labels=[l for b in observed['blocks'] for l in b['labels']]\n    orientation.append({'page':page_index+1,'pdf_rotation_degrees':page.rotation,'media_box':list(page.me