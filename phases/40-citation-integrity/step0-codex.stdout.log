{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport json, re, hashlib, fitz\nfrom pathlib import Path\nfrom urllib.parse import unquote\nreport_file=Path('phases/40-citation-integrity/step0-report.json')\nr=json.loads(report_file.read_text(encoding='utf-8'))\nassert r['verdict'] in ('not_refuted','refuted')\nassert [c['id'] for c in r['claims']]==['B1','B2','B3','B4','B5','B6']\nfor c in r['claims']:\n assert {'id','holds','method','evidence'} <= c.keys()\n assert isinstance(c['holds'],bool) and c['method'] and c['evidence']\nfor item in r['paths_verified']:\n p=Path(item['path'])\n assert item['exists'] is True and p.is_file()\n assert hashlib.sha256(p.read_bytes()).hexdigest()==item['sha256']\n\n# Independently find every fragment, including strings in the verification registry.\nrefs=set()\ndef strings(v):\n if isinstance(v,str):yield v\n elif isinstance(v,dict):\n  for k,w in v.items():\n   yield k\n   yield from strings(w)\n elif isinstance(v,list):\n  for w in v:yield from strings(w)\nfor s in strings(r):\n if '#/' in s:\n  assert re.fullmatch(r'[\"'^#]+'\"\\\\.json#/.*',s),s\n  refs.add(s)\nregistered=[p['reference'] for p in r['pointers_verified']]\nassert len(registered)==len(set(registered))\nassert refs==set(registered)\nfor ref in refs:\n path,frag=ref.split('#',1)\n node=json.loads(Path(path).read_text(encoding='utf-8-sig'))\n for segment in unquote(frag)[1:].split('/'):\n  assert not re.search(r'~(?\"'![01])'\"',segment)\n  key=segment.replace('~1','/').replace('~0','~')\n  if isinstance(node,list):\n   assert re.fullmatch(r'0|[1-9][0-9]*',key)\n   node=node[int(key)]\n  else:\n   assert isinstance(node,dict)\n   node=node[key]\n assert next(p for p in r['pointers_verified'] if p['reference']==ref)['resolved'] is True\n\n# Match every reported raw coordinate directly to the PDF, not to fixtures or Kijun output.\nd=fitz.open('.cache/dwg-tsu-kanritou.pdf')\nverified_spans=0\nfor ci,pageno in [(0,20),(1,21),(3,15)]:\n p=d[pageno]\n original=[dict(s,dir=l['dir']) for b in p.get_text('dict')['blocks'] for l in b.get('lines',[]) for s in l['spans']]\n for b in r['claims'][ci]['evidence']['blocks']:\n  for rec in [b['caption'],*b['labels'],*b['dimensions'],*b['totals']]:\n   matching=[s for s in original if s['text']==rec['raw'] and round(s['origin'][0],6)==rec['x'] and round(s['origin'][1],6)==rec['y'] and list(s['dir'])==rec['dir']]\n   assert len(matching)==1,rec\n   pt=fitz.Point(matching[0]['origin'])*p.rotation_matrix\n   assert [round(pt.x,6),round(pt.y,6)]==rec['display_xy']\n   verified_spans+=1\n  assert b['label_list']==[v['text'] for v in b['labels']]\n  assert [v['between'] for v in b['dimensions']]==[list(pair) for pair in zip(b['label_list'],b['label_list'][1:])]\n  assert len(b['labels'])==len(b['dimensions'])+1\n  assert len(b['totals'])==1 and sum(s['mm'] for s in b['dimensions'])==b['totals'][0]['mm']\n\n# Re-enumerate all fixtures via their explicit grid/elevation containers.\naxis_refs=set(); elevation_refs=set()\nfor f in Path('tests/fixtures/plan-import/expected').rglob('*.json'):\n v=json.loads(f.read_text(encoding='utf-8-sig'))\n for i,b in enumerate(v.get('blocks',[])):\n  for axis in ('x','y'):\n   if axis in b:axis_refs.add(f.as_posix()+f'#/blocks/{i}/{axis}')\n for i,e in enumerate(v.get('elevations',[])):\n  elevation_refs.add(f.as_posix()+f'#/elevations/{i}')\n  assert isinstance(e['axis'],dict)\n  axis_refs.add(f.as_posix()+f'#/elevations/{i}/axis')\nassert axis_refs=={v['source'] for v in r['claims'][4]['evidence']['axes']}\nassert elevation_refs=={v['source'] for v in r['claims'][5]['evidence']['items']}\nassert len(axis_refs)==r['claims'][4]['evidence']['axis_block_count']==26\nassert len(elevation_refs)==r['claims'][5]['evidence']['elevation_item_count']==10\nassert all(c['holds'] for c in r['claims']) and r['verdict']=='not_refuted'\nprint(json.dumps({'AC':'passed','claims':6,'paths_verified':len(r['paths_verified']),'all_json_pointers_resolved':len(refs),'original_pdf_spans_verified':verified_spans,'axes':len(axis_refs),'elevations':len(elevation_refs)}))\n'@ | python -X utf8 -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
