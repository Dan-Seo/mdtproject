{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'git status --porcelain --untracked-files=all; git log --oneline -3; Get-Content src/lib/import/story-label.ts; Get-Content src/lib/import/story-label.test.ts; Get-Content phases/44-drawing-set-assembly/index.json; Write-Output \"HERDR_ENV=$env:HERDR_ENV\"'","aggregated_output":" M phases/44-drawing-set-assembly/index.json\n?? phases/44-drawing-set-assembly/step2-codex.stderr.log\n?? phases/44-drawing-set-assembly/step2-codex.stdout.log\n26e9da1 chore(44-drawing-set-assembly): step 1 output\nbf77002 feat(44-drawing-set-assembly): step 1 — overlap-census\nd29b73a chore(44-drawing-set-assembly): step 0 output\nimport { compact } from './runs'\r\n\r\nconst STORY_TOKEN_PATTERN = /(?:RF|R??\\d+(?:F|??)/g\r\n\r\nfunction canonicalNumber(value: string): string {\r\n  return value.replace(/^0+(?=\\d)/, '')\r\n}\r\n\r\n/**\r\n * Return the canonical key for a supported story label.\r\n *\r\n * The input is compacted before the exact match so labels from PDF text such\r\n * as full-width digits or separated glyphs follow the same rule as the\r\n * framing-plan parser. Unsupported labels deliberately return undefined.\r\n */\r\nexport function storyKey(label: string): string | undefined {\r\n  const value = compact(label)\r\n  if (value === 'RF' || value === 'R??) return 'R'\r\n\r\n  const numeric = value.match(/^(\\d+)(?:F|??$/)?.[1]\r\n  return numeric === undefined ? undefined : canonicalNumber(numeric)\r\n}\r\n\r\nfunction isStandaloneStoryToken(text: string, index: number): boolean {\r\n  const previous = text[index - 1]\r\n  if (previous !== undefined && /[A-Za-z0-9]/.test(previous)) return false\r\n\r\n  // ?뚦쑑訝??롢?is an unsupported basement label, not the supported token\r\n  // ???롢?embedded in a longer label.\r\n  return text.slice(Math.max(0, index - 2), index) !== '?겻툔'\r\n}\r\n\r\n/**\r\n * Extract a supported story token from a framing-plan title.\r\n *\r\n * A title may repeat an equivalent token (for example, ????... 2F??, but\r\n * different canonical keys make the title ambiguous and are rejected.\r\n */\r\nexport function storyLabelFromTitle(title: string): string | undefined {\r\n  const value = compact(title)\r\n  const tokens: Array<{ label: string; key: string }> = []\r\n  const pattern = new RegExp(STORY_TOKEN_PATTERN.source, 'g')\r\n  let match: RegExpExecArray | null\r\n\r\n  while ((match = pattern.exec(value)) !== null) {\r\n    const label = match[0]\r\n    const index = match.index\r\n    if (!isStandaloneStoryToken(value, index)) continue\r\n\r\n    const key = storyKey(label)\r\n    if (key !== undefined) tokens.push({ label, key })\r\n  }\r\n\r\n  if (tokens.length === 0) return undefined\r\n\r\n  const keys = new Set(tokens.map((token) => token.key))\r\n  return keys.size === 1 ? tokens[0].label : undefined\r\n}\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { storyKey, storyLabelFromTitle } from '@/lib/import/story-label'\r\n\r\ndescribe('storyKey', () => {\r\n  it('normalizes numeric floor labels and the roof aliases', () => {\r\n    expect(storyKey('2??)).toBe('2')\r\n    expect(storyKey('2F')).toBe('2')\r\n    expect(storyKey('竊믧쉸')).toBe('2')\r\n    expect(storyKey(' RF ')).toBe('R')\r\n    expect(storyKey('R??)).toBe('R')\r\n    expect(storyKey('01F')).toBe('1')\r\n  })\r\n\r\n  it('does not infer keys from unsupported or non-label text', () => {\r\n    expect(storyKey('B1F')).toBeUndefined()\r\n    expect(storyKey('?겻툔1??)).toBeUndefined()\r\n    expect(storyKey('PH')).toBeUndefined()\r\n    expect(storyKey('櫻붷콏')).toBeUndefined()\r\n    expect(storyKey('')).toBeUndefined()\r\n    expect(storyKey('X1')).toBeUndefined()\r\n    expect(storyKey('2?롥틞鴉뤷쎋')).toBeUndefined()\r\n  })\r\n})\r\n\r\ndescribe('storyLabelFromTitle', () => {\r\n  it('returns the first supported floor token from a compacted title', () => {\r\n    expect(storyLabelFromTitle('2?롥틞鴉뤷쎋1/100')).toBe('2??)\r\n    expect(storyLabelFromTitle('R?롥틞鴉뤷쎋')).toBe('R??)\r\n    expect(storyLabelFromTitle('竊믧쉸 佯듾폀??)).toBe('2??)\r\n  })\r\n\r\n  it('returns undefined when no supported floor token exists', () => {\r\n    expect(storyLabelFromTitle('??폀??)).toBeUndefined()\r\n    expect(storyLabelFromTitle('?겻툔1?롥뭄?℡쎋')).toBeUndefined()\r\n  })\r\n\r\n  it('rejects titles containing different canonical floor keys', () => {\r\n    expect(storyLabelFromTitle('2?롢겏3?롢겗佯듾폀??)).toBeUndefined()\r\n    expect(storyLabelFromTitle('2F?팕?롥틞鴉뤷쎋')).toBeUndefined()\r\n  })\r\n\r\n  it('keeps the first token when repeated tokens share one canonical key', () => {\r\n    expect(storyLabelFromTitle('2?롥틞鴉뤷쎋(2F)')).toBe('2??)\r\n  })\r\n})\r\n{\r\n  \"project\": \"Kijun\",\r\n  \"phase\": \"44-drawing-set-assembly\",\r\n  \"steps\": [\r\n    {\r\n      \"step\": 0,\r\n      \"name\": \"refute-adr-and-goldens\",\r\n      \"kind\": \"verify\",\r\n      \"gate\": true,\r\n      \"status\": \"completed\",\r\n      \"model\": \"gpt-6-astra\",\r\n      \"reasoning_effort\": \"medium\",\r\n      \"started_at\": \"2026-09-10T11:46:18+0900\",\r\n      \"summary\": \"ADR-046쨌?명듃 怨⑤뱺 5媛??낅┰ 寃利? A1~A11 ?깅┰(upheld), knownGaps 19媛?諛⑺뼢 ?뺤씤, 66媛??뚯씪 ?숆껐 ?댁떆? ?먮Ц 洹쇨굅 湲곕줉, ?몄슜 寃???듦낵.\",\r\n      \"completed_at\": \"2026-09-10T12:00:52+0900\"\r\n    },\r\n    {\r\n      \"step\": 1,\r\n      \"name\": \"overlap-census\",\r\n      \"status\": \"completed\",\r\n      \"model\": \"gpt-6-astra\",\r\n      \"reasoning_effort\": \"medium\",\r\n      \"started_at\": \"2026-09-10T12:00:53+0900\",\r\n      \"summary\": \"36-page census: list 13 / block 16 / elevation 8 / multi-role 4; 66 regions, no-title margin fails, title-inclusive margin holds; parser bytes and 36 output hashes restored; 190 tests pass.\",\r\n      \"completed_at\": \"2026-09-10T12:09:05+0900\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"name\": \"level-story-key\",\r\n      \"status