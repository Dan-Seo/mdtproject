{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nexec(open(__import__('os').environ['TEMP']+'/kijun-p44-step0/raw.py',encoding='utf-8-sig').read().split(\\\"print('checks'\\\")[0])\nP=read(TMP/'parser.json')\ndef key(s):\n s=norm(s);s=re.sub(r'[+±-]?\\\\d+(?:\\\\.\\\\d+)?\"'$'\"','',s);s=re.sub(r'\\\\([\"'^)]*'\"\\\\)','',s)\n m=re.fullmatch(r'(\\\\d+)(?:FL|SL|F|階)',s)\n return m[1] if m else ('R' if re.fullmatch(r'R|RF|RFL|RSL|R階',s) else None)\ndef sk(s):\n ks=[key(a) for a in s.split('／')];return ks[0] if ks and ks[0] is not None and len(set(ks))==1 else None\ndef bk(s):\n s=norm(s);ks=[]\n for m in re.finditer(r'RF|R階|\\\\d+(?:F|階)',s):\n  if m.start()>0 and (re.match('[A-Za-z0-9]',s[m.start()-1]) or s[max(0,m.start()-2):m.start()]=='地下'):continue\n  t=m.group();ks.append('R' if t in ['RF','R階'] else str(int(re.match(r'\\\\d+',t).group())))\n return ks[0] if len(set(ks))==1 else None\n\ndef leaf(x,path=''):\n if isinstance(x,dict):return {k:v for a,b in x.items() for k,v in leaf(b,f'{path}.{a}' if path else a).items()}\n if isinstance(x,list):return {k:v for i,b in enumerate(x) for k,v in leaf(b,f'{path}[{i}]').items()}\n if x is None:return {}\n if isinstance(x,str):x=title(x) if ('Title' in path or 'titles[' in path or path.endswith('blockTitle')) else norm(x)\n return {path:x}\ndef under(p,q):return p==q or p.startswith(q+'.') or p.startswith(q+'[')\nA9=[]; projections={};A8=[]\nfor sn,g in sets.items():\n o={'pages':[],'grid':None,'stories':None,'storiesReference':None,'blockToStory':[],'unmatchedBlocks':[],'conflicts':[]}; bs=[];es=[]\n for pg in g['pages']:\n  f=pg['fixture'];p=P[f]; roles=[]\n  if p['lists']:roles+=['断面リスト']\n  if p['plan']['blocks']:roles+=['伏図']\n  if p['elevations']['elevations']:roles+=['軸組図']\n  o['pages'].append({'roles':roles,'listKinds':[l['listKind'] for l in p['lists']],'blockTitles':[b['title'] for b in p['plan']['blocks'] if 'title' in b]})\n  bs.extend((pg,b) for b in p['plan']['blocks']);es.extend((pg,i,e) for i,e in enumerate(p['elevations']['elevations']))\n def br(pg,b):return {'fixture':pg['fixture'],**({'blockTitle':b['title']} if 'title'in b else {})}\n def er(pg,e):return {'fixture':pg['fixture'],'titles':e['titles']}\n def ev(pg):return {'source':pg['source'],'pageNumber':pg['pageNumber']}\n def grid(b):return {a+k: ([x['label'] for x in b[a+'Grid']['axes']] if k=='Labels' else b[a+'Grid']['spansMm']) for a in ['x','y'] for k in ['Labels','SpansMm']}\n if bs:\n  gs=[grid(b) for _,b in bs]\n  if all(x==gs[0] for x in gs):o['grid']=gs[0]\n  else:o['conflicts'].append({'code':'通り芯不一致','blocking':True,'evidence':[ev(pg) for pg,_ in bs],'payload':{'blocks':[br(pg,b) for pg,b in bs]}})\n eligible=[v for v in es if sum(bool(l['labels']) for l in v[2]['levels'])>=2]\n eligible.sort(key=lambda v:-sum(bool(l['labels']) for l in v[2]['levels']))\n if eligible:\n  rp,ri,r=eligible[0];o['stories']={'levels':['／'.join(l['labels']) for l in r['levels']],'heightsMm':r['heightsMm']};o['storiesReference']=er(rp,r)\n  def labelmap(e):\n   d={}\n   for i,l in enumerate(e['levels']):\n    for label in set(norm(x) for x in l['labels']):d.setdefault(label,[]).append(i)\n   return d\n  rm=labelmap(r)\n  for pg,idx,e in es:\n   if pg==rp and idx==ri:continue\n   sm=labelmap(e);pairs=[]\n   for j,l in enumerate(e['levels']):\n    ids={rm[z][0] for z in set(norm(x) for x in l['labels']) if len(rm.get(z,[]))==1 and len(sm.get(z,[]))==1}\n    if len(ids)==1:pairs.append((next(iter(ids)),j))\n    elif l['labels']:o['conflicts'].append({'code':'階未収録レベル','blocking':False,'evidence':[ev(rp),ev(pg)],'payload':{'series':er(pg,e),'level':'／'.join(l['labels'])}})\n   for (a,x),(b,y) in zip(pairs,pairs[1:]):\n    rv=sum(r['heightsMm'][a:b]);sv=sum(e['heightsMm'][x:y])\n    if rv\"'!=sv:o['\"'conflicts'].append({'code':'階高不一致','blocking':False,'evidence':[ev(rp),ev(pg)],'payload':{'reference':er(rp,r),'series':er(pg,e),'levelA':'／'.join(r['levels'][a]['labels']),'levelB':'／'.join(r['levels'][b]['labels']),'referenceMm':rv,'seriesMm':sv}})\n for pg,b in bs:\n  k=bk(b.get('title',''));matches=[]\n  if o['stories'] and k:\n   matches=[n for n in o['stories']['levels'][1:] if sk(n)==k]\n  if len(matches)==1:o['blockToStory'].append({**br(pg,b),'storyName':matches[0]})\n  else:o['unmatchedBlocks'].append(br(pg,b))\n gl=leaf({k:g[k] for k in o if k\"'!='\"'pages'}|{'pages':[{k:p[k] for k in ['roles','listKinds','blockTitles']} for p in g['pages']]});ol=leaf(o)\n missing={p:{'expected':v,'actual':ol.get(p)} for p,v in gl.items() if ol.get(p)\"'!=v};extra={p:{'\"'expected':gl.get(p),'actual':v} for p,v in ol.items() if gl.get(p)\"'!=v}\n gaps=[]\n for gap in g['\"'knownGaps']:\n  mm={p:v for p,v in missing.items() if under(p,gap['path'])};ee={p:v for p,v in extra.items() if under(p,gap['path'])}\n  actual='both' if mm and ee else 'missing' if mm else 'extra' if ee else 'none'\n  gaps.append({'path':gap['path'],'direction':gap['direction'],'actual_direction':actual,'holds':actual==gap['direction'],'missing_witness':next(iter(mm.items()),None),'extra_witness':next(iter(ee.items()),None),'ref':gap['ref']})\n uncoveredM={p:v for p,v in missing.items() if not any(under(p,q['path']) and q.get('direction') in ['missing','both'] for q in g['knownGaps']) and not any(under(p,q['path']) for q in g['unsure'])}\n uncoveredE={p:v for p,v in extra.items() if not any(under(p,q['path']) and q.get('direction') in ['extra','both'] for q in g['knownGaps'])}\n A9.append({'set':sn,'gaps':gaps,'unregistered_missing':uncoveredM,'unregistered_extra':uncoveredE});projections[sn]=o\n # Independent rule application to handwritten golden (not parser output).\n assignments=[];unmatched=[]\n for pg in g['pages']:\n  for t in pg['blockTitles']:\n   k=bk(t);ms=[n for n in g['stories']['levels'][1:] if k is not None and sk(n)==k] if g['stories'] else []\n   ref={'fixture':pg['fixture'],'blockTitle':t}\n   (assignments if len(ms)==1 else unmatched).append(ref|({'storyName':ms[0]} if len(ms)==1 else {}))\n A8.append({'set':sn,'assignments':assignments,'unmatched':unmatched,'holds':assignments==g['blockToStory'] and unmatched==g['unmatchedBlocks']})\nTMP.joinpath('a9.json').write_text(json.dumps(A9,ensure_ascii=False,indent=2),encoding='utf8');TMP.joinpath('projection.json').write_text(json.dumps(projections,ensure_ascii=False,indent=2),encoding='utf8');TMP.joinpath('a8.json').write_text(json.dumps(A8,ensure_ascii=False,indent=2),encoding='utf8')\nprint(json.dumps({'A8':A8,'A9':A9},ensure_ascii=False,indent=2))\n'@ | Set-Content -Encoding UTF8 \"'$env:TEMP/kijun-p44-step0/gaps.py\n$env:PYTHONIOENCODING='\"'utf-8'; python \"'$env:TEMP/kijun-p44-step0/gaps.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
