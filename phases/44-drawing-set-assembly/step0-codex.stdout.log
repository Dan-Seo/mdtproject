   * undefined???뚭퀬瑜댁? ?딆븯?ㅳ띿씠吏 ?똲toryLabel???녿뒗 ??씊?띿씠 ?꾨땲??\r\n   */\r\n  sectionStoryLabel?: string\r\n  /**\r\n   * ?싥굤??씠 諛붾????ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━怨?吏꾪뻾?쒕떎. 湲곕낯? false?닿퀬,\r\n   * ?붾㈃? 嫄곕?瑜???踰?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 ??議곗슜??湲곕낯媛믪쑝濡?\r\n   * ?먮㈃ ?ъ슜?먭? 紐⑤Ⅴ???ъ씠???ㅻⅨ 痢듭씠 ?щ씪吏꾨떎\r\n   */\r\n  discardOtherStories?: boolean\r\n}\r\n\r\nexport interface PlanApplyResult {\r\n  project: Project\r\n  /** 諛섏쁺??遺????*/\r\n  applied: number\r\n  /** 諛섏쁺?섏? 紐삵븳 遺?몄? ?ъ쑀 ???먮Ц ?? 媛숈? 遺?멸? ?щ윭 踰?嫄몃━硫??щ윭 踰?*/\r\n  skipped: Array<{ mark: string; reason: PlanApplySkip }>\r\n  /** ?듭㎏濡?嫄곕????ъ쑀. ?덉쑝硫?project???먮?吏 ?딆? ?먮낯 洹몃?濡쒕떎 */\r\n  refusal?: PlanApplyRefusal\r\n}\r\n\r\nfunction gridOf(block: PlanBlock): Grid {\r\n  const { xGrid, yGrid } = block\r\n  return {\r\n    xSpans: [...xGrid.spansMm],\r\n    ySpans: [...yGrid.spansMm],\r\n    // ?싥굤??쓽 ?대쫫? ?꾨㈃???덈뒗 寃껋씠怨? ?닿쾬???덉뼱???똜3塋?폀Y4塋?띿쿂??\r\n    // 醫뚯슦媛 ?ㅻⅨ ??씊?ゃ궧?덈? ?곗쓽 ?ㅼ젣 諛⑺뼢怨?留욎텧 ???덈떎 (R13???좉껐 議곌굔)\r\n    xLabels: xGrid.axes.map((axis) => axis.label),\r\n    yLabels: yGrid.axes.map((axis) => axis.label),\r\n  }\r\n}\r\n\r\n/**\r\n * ?ㅽ뙩留?蹂몃떎 ???쇰꺼? ?곈뇧??寃⑹옄 index??諛붽씀吏 ?딆쑝誘濡? ?대쫫留??щ씪吏?\r\n * 洹몃━?쒕? ?뚮컮?뚯뿀?ㅳ띾줈 蹂대㈃ ?ㅻⅨ 痢듭쓽 遺?щ? 踰꾨━?쇰뒗 臾쇱쓬???댁쑀 ?놁씠 ?щ떎.\r\n */\r\nfunction sameGrid(left: Grid, right: Grid): boolean {\r\n  return (\r\n    left.xSpans.length === right.xSpans.length &&\r\n    left.ySpans.length === right.ySpans.length &&\r\n    left.xSpans.every((span, i) => span === right.xSpans[i]) &&\r\n    left.ySpans.every((span, i) => span === right.ySpans[i])\r\n  )\r\n}\r\n\r\nfunction positionOf(placement: MemberPlacement) {\r\n  return placement.role === '渦?\r\n    ? { axis: placement.axis, ix: placement.ix, iy: placement.iy }\r\n    : { ix: placement.ix, iy: placement.iy }\r\n}\r\n\r\n/**\r\n * 諛곗튂媛 寃⑹옄 ?덉쓣 媛由ы궎?붽?. 渦븐? 遺?ш? 六쀫뒗 履쎌쑝濡???移????꾩슂?섍퀬,\r\n * ?쇻궎???먯젏 履?寃⑹옄?먯씠誘濡??묒そ?쇰줈 ??移몄뵫 ?⑥븘???쒕떎.\r\n */\r\nfunction withinGrid(placement: MemberPlacement, grid: Grid): boolean {\r\n  const nx = grid.xSpans.length + 1\r\n  const ny = grid.ySpans.length + 1\r\n  const lastIx =\r\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'X')\r\n      ? nx - 2\r\n      : nx - 1\r\n  const lastIy =\r\n    placement.role === '?쇻궎' || (placement.role === '渦? && placement.axis === 'Y')\r\n      ? ny - 2\r\n      : ny - 1\r\n\r\n  return (\r\n    placement.ix >= 0 &&\r\n    placement.ix <= lastIx &&\r\n    placement.iy >= 0 &&\r\n    placement.iy <= lastIy\r\n  )\r\n}\r\n\r\nexport function applyFramingPlan(\r\n  project: Project,\r\n  {\r\n    block,\r\n    storyId,\r\n    sectionStoryLabel,\r\n    discardOtherStories = false,\r\n  }: PlanApplyOptions,\r\n): PlanApplyResult {\r\n  if (!project.stories.some((story) => story.id === storyId)) {\r\n    return { project, applied: 0, skipped: [], refusal: '?롦쑋?뉐츣' }\r\n  }\r\n\r\n  const grid = gridOf(block)\r\n  const changesGrid = !sameGrid(project.grid, grid)\r\n  const otherStoryMembers = project.members.some(\r\n    (member) => member.storyId !== storyId,\r\n  )\r\n  // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽 遺?ш?\r\n  // 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫??뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠\r\n  // ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?대뒓 履쎌쓣 踰꾨┫吏???ъ슜?먭? ?뺥븳??\r\n  if (changesGrid && otherStoryMembers && !discardOtherStories) {\r\n    return {\r\n      project,\r\n      applied: 0,\r\n      skipped: [],\r\n      refusal: '餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??,\r\n    }\r\n  }\r\n\r\n  const sections = new Map<string, Section[]>()\r\n  for (const section of project.sections) {\r\n    const candidates = sections.get(section.mark)\r\n    if (candidates) candidates.push(section)\r\n    else sections.set(section.mark, [section])\r\n  }\r\n\r\n  const members: Member[] = []\r\n  const skipped: PlanApplyResult['skipped'] = []\r\n  for (const placement of block.placements) {\r\n    const allCandidates = sections.get(placement.mark) ?? []\r\n    const candidates =\r\n      sectionStoryLabel === undefined\r\n        ? allCandidates\r\n        : (() => {\r\n            const labeled = allCandidates.filter(\r\n              (section) => section.storyLabel === sectionStoryLabel,\r\n            )\r\n            return labeled.length > 0\r\n              ? labeled\r\n              : allCandidates.filter((section) => section.storyLabel === undefined)\r\n          })()\r\n    if (candidates.length === 0) {\r\n      skipped.push({ mark: placement.mark, reason: '??씊?ょ쇉?? })\r\n      continue\r\n    }\r\n    if (candidates.length > 1) {\r\n      skipped.push({ mark: placement.mark, reason: '??씊筽뉑빊屋꿨퐪' })\r\n      continue\r\n    }\r\n    const section = candidates[0]\r\n    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\r\n      skipped.push({ mark: placement.mark, reason: '?ⓩ쓲葉?닪?면걬' })\r\n      continue\r\n    }\r\n    if (!withinGrid(placement, grid)) {\r\n      skipped.push({ mark: placement.mark, reason: '?쇔춴鸚? })\r\n      continue\r\n    }\r\n\r\n    members.push({\r\n      // id???щ엺???쎈뒗 媛믪씠 ?꾨땲??異⑸룎留??쇳븯硫??쒕떎. 媛숈? ?먮━??媛숈? 寧?뤇??\r\n      // ??踰?諛섏쁺?대룄 ?섎굹濡??묓엳?꾨줉 ?먮━瑜?id???ｋ뒗??\r\n      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}${placement.role === '渦? ? `-${placement.axis}` : ''}`,\r\n      kind: section.kind,\r\n      memberClass: '翁?퐪',\r\n      sectionId: section.id,\r\n      storyId,\r\n      position: positionOf(placement),\r\n    })\r\n  }\r\n\r\n  const deduped = new Map<string, Member>()\r\n  for (const member of members) deduped.set(member.id, member)\r\n\r\n  return {\r\n    project: {\r\n      ...project,\r\n      grid,\r\n      // 痍⑥엯?섎뒗 痢듭? 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딆븘???섍퀬, ?꾨㈃?먯꽌\r\n      // ?щ씪吏?遺?ш? 旅덁뻑???⑥븘 ?덉쑝硫?洹멸쾬???뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠??\r\n      members: [\r\n        // ?듐굤??씠 諛붾뚮㈃ ?⑥? 遺?ъ쓽 index媛 ?ㅻⅨ ?먮━瑜?媛由ы궎寃??섎?濡?\r\n        // ?숈쓽瑜?諛쏆븯???뚮뒗 ?④린吏 ?딄퀬 ?꾨? 踰꾨┛????諛섏? ??꺼 ?볥뒓??鍮꾩슫??\r\n        ...(changesGrid && discardOtherStories\r\n          ? []\r\n          : project.members.filter((member) => member.storyId !== storyId)),\r\n        ...deduped.values(),\r\n      ],\r\n    },\r\n    applied: deduped.size,\r\n    skipped,\r\n  }\r\n}\r\n\r\nexport interface ElevationApplyOptions {\r\n  candidate: ElevationCandidate\r\n  /**\r\n   * ?롮쓽 寃쎄퀎濡????덈꺼??踰붿쐞. index??**?꾨㈃ ?쒖꽌**(?꾩뿉???꾨옒)??\r\n   * ????top)??理쒖긽?롮쓽 泥쒖옣, ?꾨옒 ??bottom)??理쒗븯?롮쓽 諛붾떏???쒕떎 ??\r\n   * ?묆꺀?싥긿??泥쒕떒?대굹 ?븀쨴訝뗧ク泥섎읆 ?롪? ?꾨땶 ?덈꺼? 踰붿쐞 諛뽰뿉 ?붾떎.\r\n   */\r\n  topLevelIndex: number\r\n  bottomLevelIndex: number\r\n  /** ?롫? 媛덈㈃ 遺?ш? 媛?怨녹쓣 ?껊뒗?? ?붾㈃? 嫄곕?瑜?蹂댁뿬以 ?ㅼ뿉留????좏깮吏瑜??몃떎 */\r\n  discardMembers?: boolean\r\n}\r\n\r\nexport interface ElevationApplyResult {\r\n  project: Project\r\n  /** 留뚮뱺 ????*/\r\n  applied: number\r\n  refusal?: ElevationApplyRefusal\r\n}\r\n\r\n/**\r\n * 邕며탡?녹뿉???쎌? ?믪씠瑜?旅덁뻑???롫줈 諛섏쁺?쒕떎 (ADR-030).\r\n *\r\n * ?뚯뼱???덈꺼???롮쓽 寃쎄퀎?멸??띾뒗 ?뚯꽌媛 ?뺥븯吏 ?딆쑝誘濡?FL쨌GL쨌?븀쨴訝뗧ク쨌RCL??\r\n * ?욎뿬 ?덈떎) ?ш린???ъ슜?먯쓽 ?좏깮??諛쏅뒗?? ?롮쓽 ?대쫫??吏?대궡吏 ?딄퀬 洹??롮쓽\r\n * **諛붾떏???섎뒗 ?덈꺼???먮Ц**??洹몃?濡??대떎 ??媛숈? ?믪씠???쇰꺼???섏씠硫?????\r\n * ?④릿???ㅻЪ???뚥릎鸚?짘1FL?띻낵 ?뚦읃繹뺾L?띿씠 洹몃젃??.\r\n */\r\nexport function applyElevation(\r\n  project: Project,\r\n  {\r\n    candidate,\r\n    topLevelIndex,\r\n    bottomLevelIndex,\r\n    discardMembers = false,\r\n  }: ElevationApplyOptions,\r\n): ElevationApplyResult {\r\n  const valid =\r\n    Number.isInteger(topLevelIndex) &&\r\n    Number.isInteger(bottomLevelIndex) &&\r\n    topLevelIndex >= 0 &&\r\n    bottomLevelIndex > topLevelIndex &&\r\n    bottomLevelIndex < candidate.levels.length\r\n  if (!valid) {\r\n    return { project, applied: 0, refusal: '?롧칱?꿜툖閭? }\r\n  }\r\n\r\n  // ?롫? 媛덈㈃ 遺?ъ쓽 storyId媛 媛由ы궎???롪? ?щ씪吏꾨떎. 遺遺?諛섏쁺?쇰줈 ?섏뼱媛硫?\r\n  // ?뚰?由?梨꾨줈 ?꾩꽦??寃껁띿씠 ?섎?濡??듭㎏濡?嫄곕??섍퀬, ?ъ슜?먭? ?뺥븳??\r\n  if (project.members.length > 0 && !discardMembers) {\r\n    return { project, applied: 0, refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖?? }\r\n  }\r\n\r\n  const stories: Story[] = []\r\n  // ?꾨㈃? ?꾩뿉???꾨옒, `Project.stories`???꾨옒?먯꽌 ?꾨떎 (columnEnds媛\r\n  // stories[level - 1]???뚯븘???롢띾줈 ?쎈뒗??\r\n  for (let i = bottomLevelIndex - 1; i >= topLevelIndex; i--) {\r\n    const floor = candidate.levels[i + 1]\r\n    const name =\r\n      floor.labels.length > 0\r\n        ? floor.labels.join('竊?)\r\n        : `${bottomLevelIndex - i}`\r\n    stories.push({\r\n      id: `story-${bottomLevelIndex - i}`,\r\n      name,\r\n      height: candidate.heightsMm[i],\r\n    })\r\n  }\r\n\r\n  return {\r\n    project: { ...project, stories, members: [] },\r\n    applied: stories.length,\r\n  }\r\n}\r\nimport type { TextItem } from '@/lib/import/types'\r\n\r\nexport interface TextSegment {\r\n  text: string\r\n  compact: string\r\n  /** ???멸렇癒쇳듃瑜??대， 臾몄옄??x ?ㅻ쫫李⑥닚). 遺숈뼱踰꾨┛ ?좏겙???ㅼ쥖?쒕줈 ?섍?瑜????대떎 */\r\n  items: TextItem[]\r\n  x: number\r\n  endX: number\r\n  centerX: number\r\n  /**\r\n   * ?멸렇癒쇳듃 ?먯떊??湲由ы봽留뚯쑝濡????몃줈 以묒떖(pt). row.y?팿ow.height(???꾩껜\r\n   * 吏묎퀎媛?瑜??곕㈃ 媛숈? ?됱뿉 ?ㅻⅨ 遙섅걬?퍈??湲?먭? ?욎??????닿툔?쒕떎 ????긽\r\n   * ???멸렇癒쇳듃??媛믪뿉??援ы븳?? y??踰좎씠?ㅻ씪??textitems.ts)?대?濡?湲???섎굹??\r\n   * [y-h, y] 援ш컙??李⑥??쒕떎 ???됯퇏 y?먯꽌 理쒕뙎媛?h???덈컲??鍮쇰뒗 ?덈쾿? ?쒕줈 ?ㅻⅨ\r\n   * 湲由ы봽???듦퀎(?됯퇏怨?理쒕뙎媛?瑜??욎뼱 ?ㅼ젣 諛붿슫??諛뺤뒪? ?닿툔?쒕떎. 洹몃옒??\r\n   * top(湲?먮뱾??y-h 以?理쒖넖媛??팦ottom(y??理쒕뙎媛???吏곸젒 ??洹?以묒젏???대떎.\r\n   */\r\n  centerY: number\r\n}\r\n\r\nexport interface TextRow {\r\n  y: number\r\n  height: number\r\n  items: TextItem[]\r\n  segments: TextSegment[]\r\n}\r\n\r\n/**\r\n * ?몃줈?곌린(rot=-90) 臾몄옄???섎굹. y??諛붿슫??諛뺤뒪???몃줈 以묒떖?대떎 ??\r\n * TextSegment.centerY? 媛숈? 洹쒖빟?대떎(ADR-031???뚯쥖??洹쒖빟? ??怨녹뿉??.\r\n * 湲???먯젏(y)?ㅼ쓽 ?⑥닚 ?됯퇏???꾨땲?? rot=-90?먯꽌 y??吏꾪뻾 諛⑺뼢(-y) 湲곗?\r\n * ?ㅼそ ???먯젏)?닿퀬, ?욎そ ?앹? ?먯떊??w(吏꾪뻾??留뚰겮 ???섍컙 y-w??\r\n * (textitems.ts: directionY=-1?대?濡??ㅼ쓬 湲?먯쓽 y????湲?먯쓽 y-w) ??\r\n * makeSegments??endX媛 x+w濡??욎そ ?앹쓣 援ы븯??寃껉낵 媛숈? ?덉씠?? ?먯젏留?\r\n * ?됯퇏 ?대㈃ 留덉?留?湲????쓽 ?덈컲留뚰겮 以묒떖????y媛 ??履?濡?移섏슦移쒕떎.\r\n * 怨꾩궛? flush() 李멸퀬.\r\n */\r\nexport interface VerticalRun {\r\n  text: string\r\n  x: number\r\n  y: number\r\n}\r\n\r\n// ?몃줈 ?걔룻뻾 蹂듭썝 ?대━?ㅽ떛?먯꽌 ?섑??대릺??由ы꽣???곸닔. ?⑹뼱???덉쑝硫?R10(?щ㎎\r\n// 而ㅻ쾭由ъ? ?뺣?)?먯꽌 ?대뒓 媛믪쓣 ?먮킄???섎뒗吏 ??怨녹뿉?