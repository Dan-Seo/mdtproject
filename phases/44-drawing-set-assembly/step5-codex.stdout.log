{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport json\nfrom pathlib import Path\npairs = {\n 'title': ('図面セット', '図面セット'),\n 'files': ('PDFを選択（複数可）', 'PDF 선택(복수 가능)'),\n 'reference': ('基準系列', '基準系列'),\n 'noRole': ('役割なし', '인식된 役割 없음'),\n 'automatic': ('自動', '자동'),\n 'blocking': ('反映不可', '반영 불가'),\n 'information': ('参考情報', '참고 정보'),\n 'unmapped': ('対応する階がありません', '대응하는 階가 없습니다'),\n}\nconflicts = {\n '通り芯不一致': ('通り芯不一致', '通り芯不一致'),\n '階高不一致': ('階高不一致', '階高不一致'),\n '階未収録レベル': ('階未収録レベル', '階 미수록 レベル'),\n '階重複ブロック': ('階重複ブロック', '階 중복 블록'),\n}\nrefusals = {\n '基準不一致': ('基準系列を選び直してください', '基準系列을 다시 선택하세요'),\n '通り芯未確定': ('通り芯未確定 — 面・ブロックの選択を確認してください', '通り芯 미확정 — 면·블록 선택을 확인하세요'),\n '階未確定': ('階未確定 — 基準系列を選んでください', '階 미확정 — 基準系列을 선택하세요'),\n '未解決の矛盾': ('未解決の矛盾 — ブロックの階対応を確認してください', '미해결 矛盾 — 블록의 階 대응을 확인하세요'),\n '階未対応ブロック': ('階未対応ブロック — 階を選ぶかブロックを除外してください', '階 미대응 블록 — 階를 선택하거나 블록을 제외하세요'),\n '階範囲不正': ('階範囲不正 — 上端・下端とブロックの階を選んでください', '階 범위 부적합 — 상단·하단과 블록의 階를 선택하세요'),\n}\nfor index, locale in enumerate(['ja','ko']):\n p=Path('src/locales')/(locale+'.json')\n data=json.loads(p.read_text(encoding='utf-8'))\n for key, values in pairs.items(): data['drawingSet.'+key]=values[index]\n for key, values in conflicts.items(): data['drawingSet.conflict.'+key]=values[index]\n for key, values in refusals.items(): data['drawingSet.refusal.'+key]=values[index]\n for role in ['断面リスト','伏図','軸組図']: data['drawingSet.role.'+role]=role\n p.write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\\\\n',encoding='utf-8')\n'@ | python -\n& 'C:/Program Files/Git/bin/bash.exe' -lc 'npx vitest run src/components/plan/PlanImport.drawing-set.test.tsx tests/drawing-set/apply.test.ts > phases/44-drawing-set-assembly/step5-targeted.log 2>&1'\nGet-Content -Encoding utf8 phases/44-drawing-set-assembly/step5-targeted.log -Tail 24\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
