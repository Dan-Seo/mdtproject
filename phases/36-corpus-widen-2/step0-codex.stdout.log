ument(pdfDocumentOptions(new Uint8Array(pageData), assetDir))\n  const document = await task.promise\n  try {\n    const page = await document.getPage(pageNumber)\n    try {\n      const viewport = page.getViewport({ scale: 1 })\n      const content = await page.getTextContent()\n      const items = toTextItems(content.items.filter((item): item is Extract<typeof item, { str: string }> => 'str' in item), viewport.transform)\n      const exclusion = exclusions[fixture]\n      const titleItems = items.filter(({ x, y }) => x >= exclusion.x && y >= exclusion.y)\n      const titleStart = titleItems.length === 0 ? null : {\n        x: Math.min(...titleItems.map(({ x }) => x)),\n        y: Math.min(...titleItems.map(({ y }) => y)),\n      }\n      const nearXItems = items.filter(({ x, y }) => x < exclusion.x && y >= exclusion.y - 30 && y <= exclusion.y + 30)\n      const nearYItems = items.filter(({ x, y }) => x >= exclusion.x - 30 && x <= exclusion.x + 30 && y < exclusion.y)\n      const maxX = nearXItems.length === 0 ? null : Math.max(...nearXItems.map(({ x, w }) => x + w))\n      const maxY = nearYItems.length === 0 ? null : Math.max(...nearYItems.map(({ y, h }) => y + h))\n      console.log(JSON.stringify({ fixture, titleStart, tableMaxXNearBoundary: maxX, tableMaxYNearBoundary: maxY }))\n    } finally { page.cleanup() }\n  } finally { await task.destroy() }\n}\n\n'@ | npx tsx -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
