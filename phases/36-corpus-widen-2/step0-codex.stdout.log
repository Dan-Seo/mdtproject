p(({ str }) => str).join(''),\n      minX: Math.min(...sorted.map(({ x }) => x)),\n      maxX: Math.max(...sorted.map(({ x, w }) => x + w)),\n      minY: y,\n      maxY: Math.max(...sorted.map(({ y, h }) => y + h)),\n    }\n  })\n}\n\nconst marker = /TEL|FAX|℡|電話|一級建築士|設計事務所|株式会社|共同体/u\nfor (const [cacheFile, pageNumber] of targets) {\n  const data = readFileSync(resolve(dir, cacheFile))\n  const task = getDocument(pdfDocumentOptions(new Uint8Array(data), assetDir))\n  const document = await task.promise\n  try {\n    const page = await document.getPage(pageNumber)\n    try {\n      const viewport = page.getViewport({ scale: 1 })\n      const content = await page.getTextContent()\n      const items = toTextItems(\n        content.items.filter((item): item is Extract<typeof item, { str: string }> => 'str' in item),\n        viewport.transform,\n      )\n      const rows = itemRows(items)\n      const lowerRight = rows.filter(({ minX, minY }) => minX >= viewport.width * 0.35 && minY >= viewport.height * 0.55)\n      const hits = lowerRight.filter(({ text }) => marker.test(text.normalize('NFKC')))\n      const region = lowerRight.filter(({ text }) => text.length > 0)\n      console.log(JSON.stringify({\n        cacheFile,\n        page: pageNumber,\n        width: viewport.width,\n        height: viewport.height,\n        markerRows: hits.map(({ text, minX, maxX, minY, maxY }) => ({ text, minX, maxX, minY, maxY })),\n        lowerRightBounds: region.length === 0 ? null : {\n          minX: Math.min(...region.map(({ minX }) => minX)),\n          maxX: Math.max(...region.map(({ maxX }) => maxX)),\n          minY: Math.min(...region.map(({ minY }) => minY)),\n          maxY: Math.max(...region.map(({ maxY }) => maxY)),\n        },\n      }))\n    } finally {\n      page.cleanup()\n    }\n  } finally {\n    await task.destroy()\n  }\n}\n\n'@ | npx tsx -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
