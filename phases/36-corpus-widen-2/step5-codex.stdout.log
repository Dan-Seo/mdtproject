{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"node --import tsx/esm -e @'\nimport { readFileSync, readdirSync } from 'node:fs'\nimport { join } from 'node:path'\nimport { parseSectionLists } from './src/lib/import/section-list/parse.ts'\nimport { parseFramingPlan } from './src/lib/import/framing-plan/parse.ts'\nimport { parseFrameElevations } from './src/lib/import/framing-plan/elevation.ts'\nimport { compact, recoverRows, verticalRuns } from './src/lib/import/runs.ts'\n\nconst sectionDir = 'tests/fixtures/section-import'\nconst planDir = 'tests/fixtures/plan-import'\nconst sectionFiles = readdirSync(join(sectionDir, 'textitems')).filter(f => f.endsWith('.json')).sort()\nconst load = (dir, file) => { const x = JSON.parse(readFileSync(join(dir, 'textitems', file), 'utf8')); return { ...x.page, items: x.items } }\nconst norm = value => compact(String(value)).replaceAll('*', '×')\nconst numberNorm = value => String(value).replaceAll(',', '')\nconst sourceSet = page => {\n  const strings = new Set(), numbers = new Set()\n  const add = value => {\n    const s = norm(value)\n    if (\"'!s) return\n    strings.add(s)\n    for (const match of s.matchAll(/'\"\\\\d[\\\\d,]*/g)) numbers.add(numberNorm(match[0]))\n  }\n  for (const item of page.items) add(item.str)\n  for (const row of recoverRows(page.items)) {\n    const segments = row.segments\n    for (let i = 0; i < segments.length; i++) {\n      for (let j = i; j < Math.min(segments.length, i + 16); j++) add(segments.slice(i, j + 1).map(segment => segment.compact).join(''))\n    }\n  }\n  for (const run of verticalRuns(page.items)) add(run.text)\n  return { strings, numbers }\n}\nconst missing = []\nconst addActual = (set, value, path) => {\n  if (value === undefined || value === null || value === '') return\n  if (typeof value === 'number') set.push({ value, path, number: true })\n  else if (typeof value === 'string') set.push({ value, path, number: false })\n}\nconst barValues = (list, value, path) => {\n  if (\"'!value || typeof value !== '\"'object') return\n  for (const [key, entry] of Object.entries(value)) addActual(list, entry, \"'`${path}.${key}`)\n  const size = value.size\n  const count = value.count ?? value.topCount ?? value.endTopCount\n  const pitch = value.pitchMm\n  if (size && count !== undefined) addActual(list, `${count}-${size}`, `${path}.composite`)\n  if (size && pitch !== undefined) {\n    addActual(list, `${size}@${pitch}`, `${path}.composite`)\n    addActual(list, `${size}-@${pitch}`, `${path}.composite`)\n  }\n}\nconst actualSectionValues = parsed => {\n  const values = []\n  for (const [li, list] of parsed.entries()) {\n    for (const [ci, candidate] of list.candidates.entries()) {\n      addActual(values, candidate.mark, `lists[${li}].candidates[${ci}].mark`)\n      addActual(values, candidate.storyLabel, `lists[${li}].candidates[${ci}].storyLabel`)\n      for (const key of ['\"'b', 'd', 'depth', 'thickness', 'cutoffFromSupportFaceMm']) addActual(values, candidate[key], \"'`lists[${li}].candidates[${ci}].${key}`)\n      for (const key of ['\"'main', 'hoop', 'stirrup', 'sideBar', 'widthTie', 'girderMain', 'girderMainAsymmetric', 'vertical', 'horizontal']) barValues(values, candidate[key], \"'`lists[${li}].candidates[${ci}].${key}`)\n    }\n  }\n  return values\n}\nconst actualPlanValues = parsed => {\n  const values = []\n  const grids = [...(parsed.grids ?? []), ...(parsed.blocks ?? []).flatMap(block => [block.xGrid, block.yGrid])]\n  for (const [i, grid] of grids.entries()) {\n    for (const [j, axis] of grid.axes.entries()) addActual(values, axis.label, `grids[${i}].axes[${j}].label`)\n    grid.spansMm.forEach((value, j) => addActual(values, value, `grids[${i}].spansMm[${j}]`))\n    if (grid.totalConfirmed) addActual(values, grid.spansMm.reduce((a, b) => a + b, 0), `grids[${i}].total`)\n  }\n  for (const [i, block] of (parsed.blocks ?? []).entries()) for (const [j, placement] of block.placements.entries()) addActual(values, placement.mark, `blocks[${i}].placements[${j}].mark`)\n  return values\n}\nconst actualElevationValues = parsed => {\n  const values = []\n  for (const [i, elevation] of parsed.elevations.entries()) {\n    for (const [j, title] of elevation.titles.entries()) addActual(values, title, `elevations[${i}].titles[${j}]`)\n    for (const [j, level] of elevation.levels.entries()) {\n      for (const [k, label] of level.labels.entries()) addActual(values, label, `elevations[${i}].levels[${j}].labels[${k}]`)\n      addActual(values, elevation.heightsMm[j], `elevations[${i}].heightsMm[${j}]`)\n    }\n  }\n  return values\n}\nconst compareValues = (pageFile, kind, values) => {\n  const source = sourceSet(load(sectionDir, pageFile))\n  for (const entry of values) {\n    const present = entry.number ? source.numbers.has(numberNorm(entry.value)) : source.strings.has(norm(entry.value)) || source.numbers.has(numberNorm(entry.value))\n    if (!present) missing.push({ pageFile, kind, path: entry.path, value: entry.value })\n  }\n}\nfor (const file of sectionFiles) {\n  const page = load(sectionDir, file)\n  compareValues(file, '\"'section', actualSectionValues(parseSectionLists(page)))\n  compareValues(file, 'grid', actualPlanValues(parseFramingPlan(page)))\n  compareValues(file, 'elevation', actualElevationValues(parseFrameElevations(page)))\n}\n\nconst expectedSectionMap = {\n  'karatsu-karayaku-s4-foundation-girders.json': 'karatsu-shousai-p1.json',\n  'ina-pump-p7-lists.json': 'ina-p7.json',\n  'saiki-fire-p1-girders.json': 'saiki-p1.json',\n  'saiki-fire-p2-columns.json': 'saiki-p2.json',\n  'fuji-kanritou-p20-lists.json': 'fuji-p20.json',\n}\nconst expectedPlanMap = Object.fromEntries([\n  ['fuji-kanritou-p17-grid.json', 'fuji-p17.json'],\n  ['hirosaki-kikyono-p21-grid.json', 'hirosaki-p21.json'],\n  ['hirosaki-kikyono-p25-elevation.json', 'hirosaki-p25.json'],\n  ['ina-pump-p6-grid.json', 'ina-p6.json'],\n  ['karatsu-fukuzu-p1-grid.json', 'karatsu-fukuzu-p1.json'],\n  ['karatsu-hashirashin-p1-grid.json', 'karatsu-hashirashin-p1.json'],\n  ['karatsu-jikugumi1-p1-elevation.json', 'karatsu-jikugumi1-p1.json'],\n  ['shibata-fire-p1-grid.json', 'shibata-p1.json'],\n  ['tsu-kanritou-p16-grid.json', 'tsu-p16.json'],\n  ['tsu-kanritou-p21-elevation.json', 'tsu-p21.json'],\n])\nconst expectedValues = (value, path = '', out = []) => {\n  if (value === undefined || value === null || value === '') return out\n  if (typeof value === 'number' || typeof value === 'string') { out.push({ value, path }); return out }\n  if (Array.isArray(value)) { value.forEach((entry, index) => expectedValues(entry, \"'`${path}[${index}]`, out)); return out }\n  for (const [key, entry] of Object.entries(value)) {\n    if (['\"'\"'$comment'\"', 'source', 'notes', 'transcribedAt', 'cacheFile', 'sha256', 'issuer', 'project', 'sheet', 'page'].includes(key)) continue\n    expectedValues(entry, path ? \"'`${path}.${key}` : key, out)\n  }\n  return out\n}\nconst expectedData = file => JSON.parse(readFileSync(join(sectionDir, '\"'expected', file), 'utf8'))\nfor (const [expectedFile, pageFile] of Object.entries(expectedSectionMap)) {\n  const page = load(sectionDir, pageFile), source = sourceSet(page)\n  for (const entry of expectedValues(expectedData(expectedFile))) {\n    const present = typeof entry.value === 'number'\n      ? source.numbers.has(numberNorm(entry.value))\n      : source.strings.has(norm(entry.value)) || source.numbers.has(numberNorm(entry.value))\n    if (\"'!present) missing.push({ expectedFile, pageFile, kind: '\"'transcription-section', path: entry.path, value: entry.value })\n  }\n}\nfor (const [expectedFile, pageFile] of Object.entries(expectedPlanMap)) {\n  const page = load(sectionDir, pageFile), source = sourceSet(page), data = JSON.parse(readFileSync(join(planDir, 'expected', expectedFile), 'utf8'))\n  const relevant = expectedFile.includes('elevation')\n    ? { elevations: data.elevations }\n    : { blocks: data.blocks }\n  for (const entry of expectedValues(relevant)) {\n    const present = typeof entry.value === 'number'\n      ? source.numbers.has(numberNorm(entry.value))\n      : source.strings.has(norm(entry.value)) || source.numbers.has(numberNorm(entry.value))\n    if (\"'!present) missing.push({ expectedFile, pageFile, kind: '\"'transcription-plan', path: entry.path, value: entry.value })\n  }\n}\n\nconst step0 = JSON.parse(readFileSync('phases/36-corpus-widen-2/step0-report.json', 'utf8'))\nconst snapshot = parsed => ({\n  lists: parsed.section.map(entry => ({ listKind: entry.listKind, cells: entry.candidates.length, issues: entry.issue ? [entry.issue] : [...new Set(entry.candidates.flatMap(candidate => candidate.issues))].sort() })),\n  grids: { candidates: parsed.grid.grids.map(grid => ({ direction: grid.direction, axes: grid.axes.map(axis => ({ label: axis.label, positionPt: axis.positionPt })), spansMm: grid.spansMm, totalConfirmed: grid.totalConfirmed })), issues: parsed.grid.issues },\n  elevations: { count: parsed.elevation.elevations.length, series: parsed.elevation.elevations.map(entry => ({ titles: entry.titles, heightsMm: entry.heightsMm })), issues: parsed.elevation.issues },\n})\nconst regressionMismatches = []\nfor (const file of sectionFiles) {\n  const page = load(sectionDir, file)\n  const actual = snapshot({ section: parseSectionLists(page), grid: parseFramingPlan(page), elevation: parseFrameElevations(page) })\n  if (JSON.stringify(actual) \"'!== JSON.stringify(step0.status_table[file])) regressionMismatches.push({ file, expected: step0.status_table[file], actual })\n}\n\nconst titlePattern = /TEL|FAX|℡|電話|一級建築士|設計事務所|株式会社|共同体/\nconst titleMatches = []\nfor (const file of sectionFiles) {\n  const page = load(sectionDir, file)\n  for (const item of page.items) if (titlePattern.test(item.str)) titleMatches.push({ file, str: item.str })\n}\nconst twoLayer = []\nfor (const file of ['\"'saiki-fire-p1-girders.json']) {\n  const data = expectedData(file)\n  for (const entry of data.entries) for (const [story, cell] of Object.entries(entry.stories)) for (const [position, text] of Object.entries(cell.上端筋 ?? {})) if (String(text).includes('/')) twoLayer.push({ file, mark: entry.mark, story, face: '上端筋', position, text })\n}\nconst ina = JSON.parse(readFileSync(join(sectionDir, 'expected', 'ina-pump-p7-lists.json'), 'utf8'))\nconst inaEmpty = ina.lists.flatMap(list => list.entries ?? []).filter(entry => entry.STP === '')\nconst inaDefaults = []\nconst inaParsed = parseSectionLists(load(sectionDir, 'ina-p7.json'))\nfor (const entry of ina.lists.flatMap(list => list.entries ?? []).filter(entry => entry.STP === '')) {\n  const list = inaParsed.find(candidateList => candidateList.listKind === ina.lists.find(spec => (spec.entries ?? []).includes(entry))?.listKind)\n  const candidate = list?.candidates.find(candidate => candidate.mark === entry.mark)\n  if (candidate?.stirrup) inaDefaults.push({ mark: entry.mark, parsed: candidate.stirrup })\n}\nconsole.log(JSON.stringify({\n  pageCount: sectionFiles.length,\n  fabrication: { holds: missing.some(entry => entry.kind === 'section' || entry.kind === 'grid' || entry.kind === 'elevation'), evidence: missing.filter(entry => ['section','grid','elevation'].includes(entry.kind)).slice(0, 30), missingCount: missing.filter(entry => ['section','grid','elevation'].includes(entry.kind)).length },\n  transcription: { holds: missing.some(entry => entry.kind.startsWith('transcription')), evidence: missing.filter(entry => entry.kind.startsWith('transcription')).slice(0, 30), missingCount: missing.filter(entry => entry.kind.startsWith('transcription')).length },\n  regression: { holds: regressionMismatches.length > 0, mismatchCount: regressionMismatches.length, evidence: regressionMismatches.slice(0, 2) },\n  titleBlock: { matches: titleMatches.length, evidence: titleMatches.slice(0, 10) },\n  twoLayerAndDefaults: { twoLayerExpected: twoLayer, inaEmptyCount: inaEmpty.length, inaDefaults, holds: inaDefaults.length > 0 },\n}, null, 2))\n'@\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
