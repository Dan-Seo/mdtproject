 separator = (y: number) => ({\\r\\n      str: '-',\\r\\n      x: lineX + 0.2,\\r\\n      y,\\r\\n      w: 10,\\r\\n      h: 10,\\r\\n      rot: -90,\\r\\n    })\\r\\n    const items = [\\r\\n      ...digits('03', 100),\\r\\n      separator(110),\\r\\n      ...digits('1234', 120),\\r\\n      separator(130),\\r\\n      ...digits('5678', 140),\\r\\n    ]\\r\\n\\r\\n    // ?ㅼ틪怨?媛숈? 洹쒖튃?쇰줈 蹂몃떎 ???묎린瑜?嫄대꼫?곕㈃ ?뚯씠?대텤??ㅳ띿? ?뚭구由곕떎?띻?\\r\\n    // ?ㅻⅨ 寃껋쓣 留먰븯寃??쒕떎\\r\\n    expect(\\r\\n      joinedColumns(items)\\r\\n        .map(normalizedForScan)\\r\\n        .some((text) => PHONE_PATTERN.test(text)),\\r\\n    ).toBe(true)\\r\\n  })\\r\\n})\\r\\n\\r\\n{\\r\\n  \\\"name\\\": \\\"kijun\\\",\\r\\n  \\\"version\\\": \\\"0.1.0\\\",\\r\\n  \\\"private\\\": true,\\r\\n  \\\"type\\\": \\\"module\\\",\\r\\n  \\\"scripts\\\": {\\r\\n    \\\"dev\\\": \\\"next dev\\\",\\r\\n    \\\"build\\\": \\\"next build\\\",\\r\\n    \\\"lint\\\": \\\"eslint .\\\",\\r\\n    \\\"typecheck\\\": \\\"tsc --noEmit\\\",\\r\\n    \\\"test\\\": \\\"vitest run\\\",\\r\\n    \\\"test:golden\\\": \\\"vitest run tests/golden\\\",\\r\\n    \\\"rulepack:review-sheet\\\": \\\"tsx scripts/rulepack/review-sheet.ts\\\",\\r\\n    \\\"lighthouse\\\": \\\"lhci autorun --config=lighthouserc.cjs\\\",\\r\\n    \\\"perf:measure\\\": \\\"rm -rf .lighthouseci; LHCI_RUNS=1 lhci autorun --config=lighthouserc.cjs; node scripts/perf/report.mjs\\\",\\r\\n    \\\"eval\\\": \\\"tsx --env-file-if-exists=.env evals/harness/run.ts\\\",\\r\\n    \\\"test:hooks\\\": \\\"bash scripts/hooks/tdd-guard.spec.sh\\\",\\r\\n    \\\"hooks:install\\\": \\\"git config core.hooksPath scripts/githooks\\\",\\r\\n    \\\"test:ci-scripts\\\": \\\"bash scripts/ci/scrub-secrets.spec.sh && bash scripts/ci/review-scope.spec.sh && bash scripts/ci/review-carryforward.spec.sh && bash scripts/ci/review-verdict.spec.sh && bash scripts/ci/distill-failure-log.spec.sh && node --test .claude/workflows/review-code.test.js scripts/perf/budget-report.test.mjs scripts