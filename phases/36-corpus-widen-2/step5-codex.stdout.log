5         Math.abs(left[along] - midpoint) - Math.abs(right[along] - midpoint),\\r\\n 616     )\\r\\n 617 }\\r\\n 618 \\r\\n 619 function median(values: number[]): number {\\r\\n 620   return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\\r\\n 621 }\\r\\n 622 \\r\\n 623 interface DimensionSolution {\\r\\n 624   spans: DimensionToken[]\\r\\n 625   scalePtPerMm: number\\r\\n 626   scaleValid: boolean\\r\\n 627 }\\r\\n 628 \\r\\n 629 /**\\r\\n 630  * 같은 중점에 여러 치수 열이 놓인 경우를 최근접 하나로 자르지 않는다. 각\\r\\n 631  * 조합을 축척 검증까지 통과시킨 뒤, 값 배열이 하나로 수렴할 때만 후보를\\r\\n 632  * 만든다. 이로써 Fuji의 벽면 열과 스팬 열을 구별하고, Hirosaki의 전체\\r\\n 633  * 치수가 한 인접 중점과 겹치는 경우에도 전체 치수를 스팬으로 소비하지 않는다.\\r\\n 634  */\\r\\n 635 function dimensionSolutions(\\r\\n 636   sequence: AxisSequence,\\r\\n 637   dimensions: DimensionToken[],\\r\\n 638 ): DimensionSolution[] {\\r\\n 639   const choices: DimensionToken[][] = []\\r\\n 640   for (let i = 0; i + 1 < sequence.axes.length; i++) {\\r\\n 641     const midpoint =\\r\\n 642       (sequence.axes[i].positionPt + sequence.axes[i + 1].positionPt) / 2\\r\\n 643     const candidates = dimensionCandidatesAt(\\r\\n 644       dimensions,\\r\\n 645       new Set(),\\r\\n 646       sequence.alongKey,\\r\\n 647       sequence.alongKey === 'y' ? 'x' : 'y',\\r\\n 648       midpoint,\\r\\n 649       sequence.axisAcross[i] ?? sequence.across,\\r\\n 650     )\\r\\n 651     if (candidates.length === 0) return []\\r\\n 652     choices.push(candidates)\\r\\n 653   }\\r\\n 654 \\r\\n 655   const solutions: DimensionSolution[] = []\\r\\n 656   const selected: DimensionToken[] = []\\r\\n 657   const used = new Set<DimensionToken>()\\r\\n 658 \\r\\n 659   const visit = (index: number) => {\\r\\n 660     if (solutions.length >= 4096) return\\r\\n 661     if (index === choices.length) {\\r\\n 662       const scales = selected.map(\\r\\n 663         (span, i) =>\\r\\n 664           (sequence.axes[i + 1].positionPt - sequence.axes[i].positionPt) /\\r\\n 665           span.valueMm,\\r\\n 666       )\\r\\n 667       const medianScale = median(scales)\\r\\n 668       solutions.push({\\r\\n 669         spans: [...selected],\\r\\n 670         scalePtPerMm: medianScale,\\r\\n 671         scaleValid: !scales.some(\\r\\n 672           (scale) => Math.abs(scale / medianScale - 1) > SCALE_TOLERANCE_RATIO,\\r\\n 673         ),\\r\\n 674       })\\r\\n 675       return\\r\\n 676     }\\r\\n 677 \\r\\n 678     for (const candidate of choices[index]) {\\r\\n 679       if (used.has(candidate)) continue\\r\\n 680       used.add(candidate)\\r\\n 681       selected.push(candidate)\\r\\n 682       visit(index + 1)\\r\\n 683       selected.pop()\\r\\n 684       used.delete(candidate)\\r\\n 685       if (solutions.length >= 4096) return\\r\\n 686     }\\r\\n 687   }\\r\\n 688 \\r\\n 689   visit(0)\\r\\n 690   if (process.env.DEBUG_PARSE === '1') {\\r\\n 691     console.error(\\r\\n 692       'solutions',\\r\\n 693       sequence.axes.map((axis) => axis.label).join(','),\\r\\n 694       solutions.map((solution) => ({\\r\\n 695         spans: solution.spans.map((span) => span.valueMm),\\r\\n 696         scaleValid: solution.scaleValid,\\r\\n 697       })),\\r\\n 698     )\\r\\n 699   }\\r\\n 700   const unique = new Map<string, DimensionSolution>()\\r\\n 701   for (const solution of solutions) {\\r\\n 702     const key = solution.spans.map((span) => span.valueMm).join(',')\\r\\n 703     if (!unique.has(key)) unique.set(key, solution)\\r\\n 704   }\\r\\n 705   return [...unique.values()]\\r\\n 706 }\\r\\n 707 \\r\\n 708 function totalCandidates(\\r\\n 709   sequence: AxisSequence,\\r\\n 710   dimensions: DimensionToken[],\\r\\n 711   used: Set<DimensionToken>,\\r\\n 712   firstIndex: number,\\r\\n 713   lastIndex: number,\\r\\n 714 ): DimensionToken[] {\\r\\n 715   const midpoint =\\r\\n 716     (sequence.axes[firstIndex].positionPt +\\r\\n 717       sequence.axes[lastIndex].positionPt) /\\r\\n 718     2\\r\\n 719   return dimensionCandidatesAt(\\r\\n 720     dimensions,\\r\\n 721     used,\\r\\n 722     sequence.alongKey,\\r\\n 723     sequence.alongKey === 'y' ? 'x' : 'y',\\r\\n 724     midpoint,\\r\\n 725     sequence.axisAcross[firstIndex] ?? sequence.across,\\r\\n 726   )\\r\\n 727 }\\r\\n 728 \\r\\n 729 interface PartialTotal {\\r\\n 730   firstIndex: number\\r\\n 731   lastIndex: number\\r\\n 732   token: DimensionToken\\r\\n 733 }\\r\\n 734 \\r\\n 735 /**\\r\\n 736  * Shibata처럼 축의 뒤쪽에 미확정 축이 남은 경우에만 부분 합을 쓴다. 전체\\r\\n 737  * 축에서 두 축 이상 벗어난 작은 부분합(예: Karatsu의 4,010·4,165)은\\r\\n 738  * 합계의 증거가 아니므로 무시한다. 앞·뒤 중 하나에서 시작하는 연속 구간만\\r\\n 739  * 살피며, 내부 구간은 부분합과 축을 혼동하기 쉽기 때문에 쓰지 않는다.\\r\\n 740  */\\r\\n 741 function partialTotal(\\r\\n 742   sequence: AxisSequence,\\r\\n 743   solution: DimensionSolution,\\r\\n 744   dimensions: DimensionToken[],\\r\\n 745 ): PartialTotal | undefined {\\r\\n 746   const spanCount = solution.spans.length\\r\\n 747   const minimumCoveredSpans = Math.max(1, spanCount - 2)\\r\\n 748   const used = new Set(solution.spans)\\r\\n 749 \\r\\n 750   for (let lastIndex = sequence.axes.length - 2; lastIndex >= 1; lastIndex--) {\\r\\n 751     const covered = solution.spans\\r\\n 752       .slice(0, lastIndex)\\r\\n 753       .reduce((sum, span) => sum + span.valueMm, 0)\\r\\n 754     if (lastIndex < minimumCoveredSpans) continue\\r\\n 755     const match = totalCandidates(\\r\\n 756       sequence,\\r\\n 757       dimensions,\\r\\n 758       used,\\r\\n 759       0,\\r\\n 760       lastIndex,\\r\\n 761     ).find((candidate) => candidate.valueMm === covered)\\r\\n 762     if (match) return { firstIndex: 0, lastIndex, token: match }\\r\\n 763   }\\r\\n 764 \\r\\n 765   for (let firstIndex = 1; firstIndex < sequence.axes.length - 1; firstIndex++) {\\r\\n 766     const covered = solution.spans\\r\\n 767       .slice(firstIndex)\\r\\n 768       .reduce((sum, span) => sum + span.valueMm, 0)\\r\\n 769     const coveredSpans = sequence.axes.length - 1 - firstIndex\\r\\n 770     if (coveredSpans < minimumCoveredSpans) continue\\r\\n 771     const match = totalCandidates(\\r\\n 772       sequence,\\r\\n 773       dimensions,\\r\\n 774       used,\\r\\n 775       firstIndex,\\r\\n 776       sequence.axes.length - 1,\\r\\n 777     ).find((candidate) => candidate.valueMm === covered)\\r\\n 778     if (match) {\\r\\n 779       return {\\r\\n 780         firstIndex,\\r\\n 781         lastIndex: sequence.axes.length - 1,\\r\\n 782         token: match,\\r\\n 783       }\\r\\n 784     }\\r\\n 785   }\\r\\n 786 \\r\\n 787   return undefined\\r\\n 788 }\\r\\n 789 \\r\\n 790 function validateSequence(\\r\\n 791   sequence: AxisSequence,\\r\\n 792   dimensions: DimensionToken[],\\r\\n 793   issue: (code: PlanGridIssue) => void,\\r\\n 794 ): ValidatedSequence | undefined {\\r\\n 795   if (sequence.letters.size > 1) {\\r\\n 796     issue('ラベル文字混在')\\r\\n 797     return undefined\\r\\n 798   }\\r\\n 799   const solutions = dimensionSolutions(sequence, dimensions)\\r\\n 800   if (solutions.length === 0) {\\r\\n 801     const hasEverySpanCandidate = sequence.axes\\r\\n 802       .slice(0, -1)\\r\\n 803       .every((axis, index) => {\\r\\n 804         const midpoint =\\r\\n 805           (axis.positionPt + sequence.axes[index + 1].positionPt) / 2\\r\\n 806         return (\\r\\n 807           dimensionCandidatesAt(\\r\\n 808             dimensions,\\r\\n 809             new Set(),\\r\\n 810             sequence.alongKey,\\r\\n 811             sequence.alongKey === 'y' ? 'x' : 'y',\\r\\n 812             midpoint,\\r\\n 813             sequence.across,\\r\\n 814           ).length > 0\\r\\n 815         )\\r\\n 816       })\\r\\n 817     issue(hasEverySpanCandidate ? '縮尺不整合' : '寸法欠落')\\r\\n 818     return undefined\\r\\n 819   }\\r\\n 820 \\r\\n 821   const fullTotals = solutions.map((solution) => {\\r\\n 822     const used = new Set(solution.spans)\\r\\n 823     const spanSum = solution.spans.reduce((sum, span) => sum + span.valueMm, 0)\\r\\n 824     const candidates =\\r\\n 825       sequence.axes.length >= 3\\r\\n 826         ? totalCandidates(\\r\\n 827             sequence,\\r\\n 828             dimensions,\\r\\n 829             used,\\r\\n 830             0,\\r\\n 831             sequence.axes.length - 1,\\r\\n 832           )\\r\\n 833         : []\\r\\n 834     return {\\r\\n 835       solution,\\r\\n 836       spanSum,\\r\\n 837       candidates,\\r\\n 838       matching: candidates.some((candidate) => candidate.valueMm === spanSum),\\r\\n 839     }\\r\\n 840   })\\r\\n 841   const matchingTotals = fullTotals.filter((candidate) => candidate.matching)\\r\\n 842   if (matchingTotals.length > 0) {\\r\\n 843     const unique = new Map<string, (typeof matchingTotals)[number]>()\\r\\n 844     for (const candidate of matchingTotals) {\\r\\n 845       const key = candidate.solution.spans.map((span) => span.valueMm).join(',')\\r\\n 846       if (!unique.has(key)) unique.set(key, candidate)\\r\\n 847     }\\r\\n 848     if (unique.size > 1) {\\r\\n 849       issue('寸法列曖昧')\\r\\n 850       return undefined\\r\\n 851     }\\r\\n 852     const selected = [...unique.values()][0]\\r\\n 853     return {\\r\\n 854       ...sequence,\\r\\n 855       direction: [...sequence.letters][0],\\r\\n 856       spansMm: selected.solution.spans.map((span) => span.valueMm),\\r\\n 857       scalePtPerMm: selected.solution.scalePtPerMm,\\r\\n 858       totalConfirmed: true,\\r\\n 859     }\\r\\n 860   }\\r\\n 861 \\r\\n 862   const scaleValidTotals = fullTotals.filter(\\r\\n 863     ({ solution }) => solution.scaleValid,\\r\\n 864   )\\r\\n 865   if (scaleValidTotals.length === 0) {\\r\\n 866     issue('縮尺不整合')\\r\\n 867     return undefined\\r\\n 868   }\\r\\n 869 \\r\\n 870   const maximumSpan = Math.max(\\r\\n 871     ...scaleValidTotals.flatMap((candidate) =>\\r\\n 872       candidate.solution.spans.map((span) => span.valueMm),\\r\\n 873     ),\\r\\n 874   )\\r\\n 875   const conflictingTotals = scaleValidTotals.some(({ candidates }) =>\\r\\n 876     candidates.some(\\r\\n 877       (candidate) =>\\r\\n 878         candidate.valueMm >= maximumSpan && candidate.valueMm !== fullTotals[0]?.spanSum,\\r\\n 879     ),\\r\\n 880   )\\r\\n 881   if (conflictingTotals) {\\r\\n 882     issue('合計不一致')\\r\\n 883     return undefined\\r\\n 884   }\\r\\n 885 \\r\\n 886   const partials = scaleValidTotals\\r\\n 887     .map(({ solution }) => partialTotal(sequence, solution, dimensions))\\r\\n 888     .filter((candidate): candidate is PartialTotal => candidate !== undefined)\\r\\n 889   if (partials.length > 0) {\\r\\n 890     const first = partials[0]\\r\\n 891     const same = partials.every(\\r\\n 892       (candidate) =>\\r\\n 893         candidate.firstIndex === first.firstIndex &&\\r\\n 894         candidate.lastIndex === first.lastIndex &&\\r\\n 895         candidate.token.valueMm === first.token.valueMm,\\r\\n 896     )\\r\\n 897     if (!same) {\\r\\n 898       issue('寸法列曖昧')\\r\\n 899       return undefined\\r\\n 900     }\\r\\n 901     const solution = scaleValidTotals[0]?.solution\\r\\n 902     if (!solution) return undefined\\r\\n 903     return {\\r\\n 904       ...sequence,\\r\\n 905       direction: [...sequence.letters][0],\\r\\n 906       axes: sequence.axes.slice(first.firstIndex, first.lastIndex + 1),\\r\\n 907       spansMm: solution.spans\\r\\n 908         .slice(first.firstIndex, first.lastIndex)\\r\\n 909         .map((span) => span.valueMm),\\r\\n 910       scalePtPerMm: solution.scalePtPerMm,\\r\\n 911       totalConfirmed: true,\\r\\n 912     }\\r\\n 913   }\\r\\n 914 \\r\\n 915   const unique = new Map<string, DimensionSolution>()\\r\\n 916   for (const solution of scaleValidTotals.map(({ solution }) => solution)) {\\r\\n 917     const key = solution.spans.map((span) => span.valueMm).join(',')\\r\\n 918     if (!unique.has(key)) unique.set(key, solution)\\r\\n 919   }\\r\\n 920   if (unique.size > 1) {\\r\\n 921     issue('寸法列曖昧')\\r\\n 922     return undefined\\r\\n 923   }\\r\\n 924   const selected = [...unique.values()][0]\\r\\n 925 \\r\\n 926   return {\\r\\n 927     ...sequence,\\r\\n 928     direction: [...sequence.letters][0],\\r\\n 929     spansMm: selected.spans.map((span) => span.valueMm),\\r\\n 930     scalePtPerMm: selected.scalePtPerMm,\\r\\n 931     totalConfirmed: false,\\r\\n 932   }\\r\\n 933 }\\r\\n 934 \\r\\n 935 /**\\r\\n 936  * 접두가 없는 라벨은 문자열만으로 X·Y를 결정할 수 없다. 같은 페이지의\\r\\n 937  * 서로 직교한 두 축이 모두 있으면, 두 축의 실측 총 길이가 긴 쪽을 X로\\r\\n 938  * 정한다. 축의 이름을 발주처 관행으로 추측하지 않고, 이미 검증한 치수와\\r\\n 939  * 기하만 사용한다. 한 축만 남은 경우에는 숫자/알파벳 표기의 관례를\\r\\n 940  * 보조적으로 사용하되, 기존처럼 두 축 후보를 모두 검사한 뒤에만 낸다.\\r\\n 941  */\\r\\n 942 function directSequences(\\r\\n 943   sequences: ValidatedSequence[],\\r\\n 944 ): DirectedSequence[] {\\r\\n 945   const directed = sequences.filter(\\r\\n 946     (sequence): sequence is DirectedSequence => sequence.direction !== undefined,\\r\\n 947   )\\r\\n 948   const undirected = sequences.filter(\\r\\n 949     (sequence) => sequence.direction === undefined,\\r\\n 950   )\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\nphases/36-corpus-widen-2\\step1-codex.stdout.log:41:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command '$OutputEncoding = [Console]::OutputEncoding = [Text.UTF8Encoding]::new(); $i=0; Get-Content -Encoding utf8 src/lib/import/framing-plan/parse.ts | ForEach-Object { $i++; if ($i -ge 950) { '\\\"'{0,4} {1}' -f \\\"'$i,$_ } }'\",\"aggregated_output\":\" 950   )\\r\\n 951   if (undirected.length === 0) return directed\\r\\n 952 \\r\\n 953   const alongX = undirected.filter((sequence) => sequence.alongKey === 'x')\\r\\n 954   const alongY = undirected.filter((sequence) => sequence.alongKey === 'y')\\r\\n 955 \\r\\n 956   // 같은 방향으로 놓인 숫자·알파벳 축은 숫자를 X, 알파벳을 Y로 읽는다.\\r\\n 957   // 이 판정은 단순한 표기 관례가 아니라 실제로 두 축이 서로 짝지어지는지\\r\\n 958   // 확인한 뒤에만 적용한다. Ina에서는 A·B 대역 하나가 숫자 1·2·3 대역의\\r\\n 959   // 옆에 있고, 다른 A·B 대역은 별도 표의 잡음이라 거리 검사가 그것을 고른다.\\r\\n 960   const numeric = undirected.filter((sequence) =>\\r\\n 961     sequence.simpleKinds.has('numeric'),\\r\\n 962   )\\r\\n 963   const alpha = undirected.filter((sequence) =>\\r\\n 964     sequence.simpleKinds.has('alpha'),\\r\\n 965   )\\r\\n 966   const hasPairedParallelAxes = numeric.some((numericSequence) =>\\r\\n 967     alpha.some(\\r\\n 968       (alphaSequence) =>\\r\\n 969         numericSequence.alongKey === alphaSequence.alongKey &&\\r\\n 970         distanceToRange(\\r\\n 971           alphaSequence.across,\\r\\n 972           extent(numericSequence.axes).min,\\r\\n 973           extent(numericSequence.axes).max,\\r\\n 974         ) <=\\r\\n 975           median(spanLengths(numericSequence.axes)) *\\r\\n 976             GRID_PAIRING_DISTANCE_RATIO,\\r\\n 977     ),\\r\\n 978   )\\r\\n 979   if (hasPairedParallelAxes) {\\r\\n 980     return [\\r\\n 981       ...directed,\\r\\n 982       ...undirected.map((sequence) => ({\\r\\n 983         ...sequence,\\r\\n 984         direction: (sequence.simpleKinds.has('numeric') ? 'X' : 'Y') as\\r\\n 985           | 'X'\\r\\n 986           | 'Y',\\r\\n 987       })),\\r\\n 988     ]\\r\\n 989   }\\r\\n 990 \\r\\n 991   if (alongX.length > 0 && alongY.length > 0) {\\r\\n 992     const sum = (sequence: ValidatedSequence) =>\\r\\n 993       sequence.spansMm.reduce((total, span) => total + span, 0)\\r\\n 994     const xLength = median(alongX.map(sum))\\r\\n 995     const yLength = median(alongY.map(sum))\\r\\n 996     const xAlong: 'x' | 'y' = xLength >= yLength ? 'x' : 'y'\\r\\n 997     return [\\r\\n 998       ...directed,\\r\\n 999       ...undirected.map((sequence) => ({\\r\\n1000         ...sequence,\\r\\n1001         direction: (sequence.alongKey === xAlong ? 'X' : 'Y') as 'X' | 'Y',\\r\\n1002       })),\\r\\n1003     ]\\r\\n1004   }\\r\\n1005 \\r\\n1006   return [\\r\\n1007     ...directed,\\r\\n1008     ...undirected.map((sequence) => ({\\r\\n1009       ...sequence,\\r\\n1010       direction: (sequence.simpleKinds.has('numeric') ? 'X' : 'Y') as 'X' | 'Y',\\r\\n1011     })),\\r\\n1012   ]\\r\\n1013 }\\r\\n1014 \\r\\n1015 function labelFamily(label: string): string {\\r\\n1016   return label.endsWith(\\\"'\\\") ? label.slice(0, -1) : label\\r\\n1017 }\\r\\n1018 \\r\\n1019 /**\\r\\n1020  * Some drawings print a vertical axis from the high-numbered end toward the\\r\\n1021  * low-numbered end.  Keep the measured positions in page order, but restore\\r\\n1022  * the logical label order expected by the framing-plan contract.  A plain\\r\\n1023  * Y1..Y3 band is deliberately left alone: that is the older corpus format and\\r\\n1024  * changing it would change the existing 14-page result.\\r\\n1025  */\\r\\n1026 function normalizeAxisOrientation(\\r\\n1027   sequences: DirectedSequence[],\\r\\n1028   labels: LabelToken[],\\r\\n1029 ): DirectedSequence[] {\\r\\n1030   return sequences.map((sequence) => {\\r\\n1031     if (sequence.direction !== 'Y') return sequence\\r\\n1032 \\r\\n1033     const names = sequence.axes.map((axis) => axis.label)\\r\\n1034     const namedY = names.every((label) => /^Y\\\\d+$/.test(label))\\r\\n1035     const simpleAlpha =\\r\\n1036       names.every((label) => /^[A-Z]'?$/.test(label))\\r\\n1037     if (!namedY && !simpleAlpha) return sequence\\r\\n1038 \\r\\n1039     const repeatedFamily = names.some((name) => {\\r\\n1040       const family = labelFamily(name)\\r\\n1041       return (\\r\\n1042         labels.filter((token) => labelFamily(token.label) === family).length > 1\\r\\n1043       )\\r\\n1044     })\\r\\n1045     const suffixes = names\\r\\n1046       .map((name) => /^.*Y(\\\\d+)$/.exec(name)?.[1])\\r\\n1047       .filter((suffix): suffix is string => suffix !== undefined)\\r\\n1048       .map(Number)\\r\\n1049     const hasZero = suffixes.includes(0)\\r\\n1050     const hasTwoDigitLabel = suffixes.some((suffix) => suffix >= 10)\\r\\n1051     const reverseLabels =\\r\\n1052       (namedY && (hasZero || repeatedFamily || hasTwoDigitLabel)) ||\\r\\n1053       simpleAlpha\\r\\n1054     if (!reverseLabels) return sequence\\r\\n1055 \\r\\n1056     const reversedNames = [...names].reverse()\\r\\n1057     const axes = sequence.axes.map((axis, index) => ({\\r\\n1058       ...axis,\\r\\n1059       label: reversedNames[index],\\r\\n1060     }))\\r\\n1061     const reverseSpans =\\r\\n1062       (namedY && (hasZero || repeatedFamily || hasTwoDigitLabel)) || simpleAlpha\\r\\n1063     return {\\r\\n1064       ...sequence,\\r\\n1065       axes,\\r\\n1066       spansMm: reverseSpans ? [...sequence.spansMm].reverse() : sequence.spansMm,\\r\\n1067     }\\r\\n1068   })\\r\\n1069 }\\r\\n1070 \\r\\n1071 function sameAxisTail(\\r\\n1072   candidate: AxisSequence,\\r\\n1073   other: AxisSequence,\\r\\n1074 ): boolean {\\r\\n1075   if (candidate === other || candidate.alongKey !== other.alongKey) return false\\r\\n1076   if (candidate.axes.length >= other.axes.length) return false\\r\\n1077   return candidate.axes.every((axis) =>\\r\\n1078     other.axes.some(\\r\\n1079       (otherAxis) =>\\r\\n1080         otherAxis.label === axis.label &&\\r\\n1081         Math.abs(otherAxis.positionPt - axis.positionPt) <=\\r\\n1082           MIDPOINT_TOLERANCE_PT,\\r\\n1083     ),\\r\\n1084   )\\r\\n1085 }\\r\\n1086 \\r\\n1087 function sameAxes(left: AxisCandidate[], right: AxisCandidate[]): boolean {\\r\\n1088   return (\\r\\n1089     left.length === right.length &&\\r\\n1090     left.every((axis, index) => {\\r\\n1091       const other = right[index]\\r\\n1092       return (\\r\\n1093         other !== undefined &&\\r\\n1094         axis.label === other.label &&\\r\\n1095         Math.abs(axis.positionPt - other.positionPt) <= MIDPOINT_TOLERANCE_PT\\r\\n1096       )\\r\\n1097     })\\r\\n1098   )\\r\\n1099 }\\r\\n1100 \\r\\n1101 /**\\r\\n1102  * A broken label band can expose the same run three times (for example\\r\\n1103  * E-D-C-B-A, D-C-B-A and C-B-A).  The middle run has no independent\\r\\n1104  * evidence: it is enclosed by two longer/shorter copies of the same tail.\\r\\n1105  * Keep the two boundary runs and discard only that redundant middle copy.\\r\\n1106  */\\r\\n1107 function suppressIntermediateSequences<T extends AxisSequence>(\\r\\n1108   sequences: T[],\\r\\n1109 ): T[] {\\r\\n1110   return sequences.filter((candidate) => {\\r\\n1111     const firstPosition = candidate.axes[0]?.positionPt\\r\\n1112     if (firstPosition === undefined) return true\\r\\n1113     const hasLongerPrefix = sequences.some((other) =>\\r\\n1114       sameAxisTail(candidate, other) &&\\r\\n1115       sameAxes(other.axes.slice(-candidate.axes.length), candidate.axes),\\r\\n1116     )\\r\\n1117     const hasShorterSuffix = sequences.some((other) =>\\r\\n1118       sameAxes(candidate.axes.slice(1), other.axes),\\r\\n1119     )\\r\\n1120     if (hasLongerPrefix && hasShorterSuffix) return false\\r\\n1121 \\r\\n1122     const matchingStarts = sequences\\r\\n1123       .filter((other) => sameAxisTail(candidate, other))\\r\\n1124       .map((other) => other.axes[0]?.positionPt)\\r\\n1125       .filter((position): position is number => position !== undefined)\\r\\n1126     return !(\\r\\n1127       matchingStarts.some((position) => position < firstPosition) &&\\r\\n1128       matchingStarts.some((position) => position > firstPosition)\\r\\n1129     )\\r\\n1130   })\\r\\n1131 }\\r\\n1132 \\r\\n1133 function extent(axes: AxisCandidate[]): { min: number; max: number } {\\r\\n1134   let min = Number.POSITIVE_INFINITY\\r\\n1135   let max = Number.NEGATIVE_INFINITY\\r\\n1136   for (const axis of axes) {\\r\\n1137     if (axis.positionPt < min) min = axis.positionPt\\r\\n1138     if (axis.positionPt > max) max = axis.positionPt\\r\\n1139   }\\r\\n1140   return { min, max }\\r\\n1141 }\\r\\n1142 \\r\\n1143 /** 점에서 구간까지의 거리. 구간 안이면 0 */\\r\\n1144 function distanceToRange(value: number, min: number, max: number): number {\\r\\n1145   if (value < min) return min - value\\r\\n1146   if (value > max) return value - max\\r\\n1147   return 0\\r\\n1148 }\\r\\n1149 \\r\\n1150 /**\\r\\n1151  * 부호가 붙는 자리를 만든다 — 격자점과 그 사이 중점이 번갈아 놓인 눈금이다.\\r\\n1152  * 짝수 index가 격자점(index/2), 홀수가 중점(사이 (index-1)/2).\\r\\n1153  */\\r\\n1154 function snapTargets(axes: AxisCandidate[]): number[] {\\r\\n1155   const targets: number[] = []\\r\\n1156   for (let i = 0; i < axes.length; i++) {\\r\\n1157     targets.push(axes[i].positionPt)\\r\\n1158     if (i + 1 < axes.length) {\\r\\n1159       targets.push((axes[i].positionPt + axes[i + 1].positionPt) / 2)\\r\\n1160     }\\r\\n1161   }\\r\\n1162   return targets\\r\\n1163 }\\r\\n1164 \\r\\n1165 function spanLengths(axes: AxisCandidate[]): number[] {\\r\\n1166   return axes\\r\\n1167     .slice(1)\\r\\n1168     .map((axis, i) => Math.abs(axis.positionPt - axes[i].positionPt))\\r\\n1169 }\\r\\n1170 \\r\\n1171 interface Snap {\\r\\n1172   index: number\\r\\n1173   onNode: boolean\\r\\n1174 }\\r\\n1175 \\r\\n1176 function snap(\\r\\n1177   value: number,\\r\\n1178   axes: AxisCandidate[],\\r\\n1179   limit: number,\\r\\n1180 ): Snap | undefined {\\r\\n1181   const targets = snapTargets(axes)\\r\\n1182   let best = -1\\r\\n1183   let bestDistance = Number.POSITIVE_INFINITY\\r\\n1184   for (let i = 0; i < targets.length; i++) {\\r\\n1185     const distance = Math.abs(targets[i] - value)\\r\\n1186     if (distance < bestDistance) {\\r\\n1187       best = i\\r\\n1188       bestDistance = distance\\r\\n1189     }\\r\\n1190   }\\r\\n1191   if (best < 0 || bestDistance > limit) return undefined\\r\\n1192   return { index: best >> 1, onNode: best % 2 === 0 }\\r\\n1193 }\\r\\n1194 \\r\\n1195 function placementFor(\\r\\n1196   mark: string,\\r\\n1197   x: Snap,\\r\\n1198   y: Snap,\\r\\n1199 ): MemberPlacement {\\r\\n1200   if (x.onNode && y.onNode) {\\r\\n1201     return { mark, role: '格子点', ix: x.index, iy: y.index }\\r\\n1202   }\\r\\n1203   if (!x.onNode && y.onNode) {\\r\\n1204     return { mark, role: '辺', ix: x.index, iy: y.index, axis: 'X' }\\r\\n1205   }\\r\\n1206   if (x.onNode && !y.onNode) {\\r\\n1207     return { mark, role: '辺', ix: x.index, iy: y.index, axis: 'Y' }\\r\\n1208   }\\r\\n1209   return { mark, role: 'ベイ', ix: x.index, iy: y.index }\\r\\n1210 }\\r\\n1211 \\r\\n1212 function gridCandidate(sequence: DirectedSequence): PlanGridCandidate {\\r\\n1213   return {\\r\\n1214     direction: sequence.direction,\\r\\n1215     axes: sequence.axes,\\r\\n1216     spansMm: sequence.spansMm,\\r\\n1217     scalePtPerMm: sequence.scalePtPerMm,\\r\\n1218     totalConfirmed: sequence.totalConfirmed,\\r\\n1219   }\\r\\n1220 }\\r\\n1221 \\r\\n1222 /**\\r\\n1223  * 블록을 짓는다 — X 열 하나와 **가장 가까운** Y 열 하나를 짝짓는다.\\r\\n1224  *\\r\\n1225  * 고정 여백으로 「포함」을 판정하지 않는 이유: 라벨은 도면 바깥에 놓이므로\\r\\n1226  * 여백이 필요한데(실물 156pt), 그 여백을 넓히면 옆 블록의 열까지 삼킨다.\\r\\n1227  * 최근접은 그 사이를 재지 않고도 옳은 짝을 고른다.\\r\\n1228  *\\r\\n1229  * 같은 블록의 위·아래 라벨 띠는 축 위치가 같으므로 그 자리에서 하나로 접힌다.\\r\\n1230  */\\r\\n1231 function buildBlocks(\\r\\n1232   xSequences: DirectedSequence[],\\r\\n1233   ySequences: DirectedSequence[],\\r\\n1234   marks: PositionedToken[],\\r\\n1235   titles: PositionedToken[],\\r\\n1236   issue: (code: PlanGridIssue) => void,\\r\\n1237 ): PlanBlock[] {\\r\\n1238   const blocks: PlanBlock[] = []\\r\\n1239   if (xSequences.length === 0 || ySequences.length === 0) return blocks\\r\\n1240 \\r\\n1241   const seen = new Set<string>()\\r\\n1242   const claimedY = new Map<ValidatedSequence, string>()\\r\\n1243   const enforceUniqueY = ySequences.length > 1\\r\\n1244 \\r\\n1245   for (const xSequence of xSequences) {\\r\\n1246     const sequenceExtent = extent(xSequence.axes)\\r\\n1247     const xKey = xSequence.axes\\r\\n1248       .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\\r\\n1249       .join(',')\\r\\n1250     const pairingLimit =\\r\\n1251       median(spanLengths(xSequence.axes)) * GRID_PAIRING_DISTANCE_RATIO\\r\\n1252     let paired: DirectedSequence | undefined\\r\\n1253     let pairedDistance = Number.POSITIVE_INFINITY\\r\\n1254     let tied = false\\r\\n1255     for (const ySequence of ySequences) {\\r\\n1256       const claimedBy = claimedY.get(ySequence)\\r\\n1257       if (enforceUniqueY && claimedBy !== undefined && claimedBy !== xKey) {\\r\\n1258         continue\\r\\n1259       }\\r\\n1260       const distance = distanceToRange(\\r\\n1261         ySequence.across,\\r\\n1262         sequenceExtent.min,\\r\\n1263         sequenceExtent.max,\\r\\n1264       )\\r\\n1265       if (distance < pairedDistance) {\\r\\n1266         paired = ySequence\\r\\n1267         pairedDistance = distance\\r\\n1268         tied = false\\r\\n1269       } else if (distance === pairedDistance) {\\r\\n1270         tied = true\\r\\n1271       }\\r\\n1272     }\\r\\n1273     if (!paired || tied || pairedDistance > pairingLimit) {\\r\\n1274       issue('通り芯対応不明')\\r\\n1275       continue\\r\\n1276     }\\r\\n1277     if (enforceUniqueY) claimedY.set(paired, xKey)\\r\\n1278 \\r\\n1279     const xGrid = gridCandidate(xSequence)\\r\\n1280     const yGrid = gridCandidate(paired)\\r\\n1281     const xAxes = xSequence.alongKey === 'x' ? xGrid.axes : yGrid.axes\\r\\n1282     const yAxes = xSequence.alongKey === 'y' ? xGrid.axes : yGrid.axes\\r\\n1283     const xExtent = extent(xAxes)\\r\\n1284     const yExtent = extent(yAxes)\\r\\n1285     const key = [xAxes, yAxes]\\r\\n1286       .map((axes) =>\\r\\n1287         axes\\r\\n1288           .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\\r\\n1289           .join(','),\\r\\n1290       )\\r\\n1291       .join('|')\\r\\n1292     if (seen.has(key)) continue\\r\\n1293     seen.add(key)\\r\\n1294 \\r\\n1295     const xLimit = median(spanLengths(xAxes)) * SNAP_RATIO\\r\\n1296     const yLimit = median(spanLengths(yAxes)) * SNAP_RATIO\\r\\n1297 \\r\\n1298     const placements: MemberPlacement[] = []\\r\\n1299     const unplacedMarks: string[] = []\\r\\n1300     for (const mark of marks) {\\r\\n1301       // 블록 밖의 부호는 아예 보지 않는다 — 같은 페이지의 断面リスト가 섞인다.\\r\\n1302       // 판정 여백을 스냅 허용과 같게 두어, 「블록 안인데 못 붙였다」와\\r\\n1303       // 「블록 밖이다」가 같은 자로 갈리게 한다\\r\\n1304       if (distanceToRange(mark.x, xExtent.min, xExtent.max) > xLimit) continue\\r\\n1305       if (distanceToRange(mark.y, yExtent.min, yExtent.max) > yLimit) continue\\r\\n1306 \\r\\n1307       const x = snap(mark.x, xAxes, xLimit)\\r\\n1308       const y = snap(mark.y, yAxes, yLimit)\\r\\n1309       if (!x || !y) {\\r\\n1310         if (!unplacedMarks.includes(mark.text)) unplacedMarks.push(mark.text)\\r\\n1311         continue\\r\\n1312       }\\r\\n1313       placements.push(placementFor(mark.text, x, y))\\r\\n1314     }\\r\\n1315 \\r\\n1316     // 제목은 블록의 가로 범위 안에 있는 것만 본다 — 나란히 선 두 伏図에서\\r\\n1317     // 세로 거리만으로 고르면 옆 블록의 제목이 붙는다\\r\\n1318     let title: string | undefined\\r\\n1319     let titleDistance = Number.POSITIVE_INFINITY\\r\\n1320     for (const candidate of titles) {\\r\\n1321       if (distanceToRange(candidate.x, xExtent.min, xExtent.max) > 0) continue\\r\\n1322       const distance = distanceToRange(candidate.y, yExtent.min, yExtent.max)\\r\\n1323       if (distance < titleDistance) {\\r\\n1324         title = candidate.text\\r\\n1325         titleDistance = distance\\r\\n1326       }\\r\\n1327     }\\r\\n1328 \\r\\n1329     blocks.push({\\r\\n1330       ...(title === undefined ? {} : { title }),\\r\\n1331       xGrid,\\r\\n1332       yGrid,\\r\\n1333       placements,\\r\\n1334       unplacedMarks,\\r\\n1335     })\\r\\n1336   }\\r\\n1337 \\r\\n1338   return blocks.sort(\\r\\n1339     (a, b) =>\\r\\n1340       extent(a.xGrid.axes).min - extent(b.xGrid.axes).min ||\\r\\n1341       extent(a.yGrid.axes).min - extent(b.yGrid.axes).min,\\r\\n1342   )\\r\\n1343 }\\r\\n1344 \\r\\n1345 export function parseFramingPlan(page: TextPage): ParsedFramingPlan {\\r\\n1346   const { labels, dimensions, marks, titles } = collectTokens(page)\\r\\n1347 \\r\\n1348   const issues: PlanGridIssue[] = []\\r\\n1349   const issue = (code: PlanGridIssue) => {\\r\\n1350     if (!issues.includes(code)) issues.push(code)\\r\\n1351   }\\r\\n1352 \\r\\n1353   if (labels.length === 0) {\\r\\n1354     return { grids: [], blocks: [], issues: ['通り芯ラベル未検出'] }\\r\\n1355   }\\r\\n1356 \\r\\n1357   // 라벨 문자열이 가로로 놓여도 밴드(축의 늘어선 방향)는 세로일 수 있다 —\\r\\n1358   // 두 방향 다 묶어 보고, 검증(중점 치수·축척)이 가짜 밴드를 걸러낸다.\\r\\n1359   const rawSequences = [\\r\\n1360     ...axisSequences(labels, 'x'),\\r\\n1361     ...axisSequences(labels, 'y'),\\r\\n1362   ]\\r\\n1363   if (process.env.DEBUG_PARSE === '1') {\\r\\n1364     console.error(\\r\\n1365       'raw',\\r\\n1366       JSON.stringify(\\r\\n1367         rawSequences.map((sequence) => ({\\r\\n1368           alongKey: sequence.alongKey,\\r\\n1369           axes: sequence.axes,\\r\\n1370           across: sequence.across,\\r\\n1371         })),\\r\\n1372       ),\\r\\n1373     )\\r\\n1374   }\\r\\n1375   const validated = rawSequences.flatMap((sequence) => {\\r\\n1376     const result = validateSequence(sequence, dimensions, issue)\\r\\n1377     if (process.env.DEBUG_PARSE === '1') {\\r\\n1378       console.error(\\r\\n1379         'validated',\\r\\n1380         sequence.axes.map((axis) => axis.label).join(','),\\r\\n1381         result?.spansMm,\\r\\n1382       )\\r\\n1383     }\\r\\n1384     return result ? [result] : []\\r\\n1385   })\\r\\n1386   const directed = normalizeAxisOrientation(\\r\\n1387     suppressIntermediateSequences(directSequences(validated)),\\r\\n1388     labels,\\r\\n1389   )\\r\\n1390   if (process.env.DEBUG_PARSE === '1') {\\r\\n1391     console.error(\\r\\n1392       JSON.stringify(directed.map((sequence) => ({\\r\\n1393         direction: sequence.direction,\\r\\n1394         alongKey: sequence.alongKey,\\r\\n1395         axes: sequence.axes.map((axis) => ({\\r\\n1396           label: axis.label,\\r\\n1397           positionPt: axis.positionPt,\\r\\n1398         })),\\r\\n1399         spans: sequence.spansMm,\\r\\n1400         total: sequence.totalConfirmed,\\r\\n1401       }))),\\r\\n1402     )\\r\\n1403   }\\r\\n1404 \\r\\n1405   const grids: PlanGridCandidate[] = []\\r\\n1406   const seen = new Set<string>()\\r\\n1407   for (const sequence of directed) {\\r\\n1408     const candidate = gridCandidate(sequence)\\r\\n1409     const key = [\\r\\n1410       candidate.direction,\\r\\n1411       candidate.axes.map((axis) => axis.label).join(','),\\r\\n1412       candidate.spansMm.join(','),\\r\\n1413     ].join('|')\\r\\n1414     if (seen.has(key)) continue\\r\\n1415     seen.add(key)\\r\\n1416     grids.push(candidate)\\r\\n1417   }\\r\\n1418   grids.sort(\\r\\n1419     (a, b) =>\\r\\n1420       a.direction.localeCompare(b.direction) ||\\r\\n1421       a.axes[0].positionPt - b.axes[0].positionPt,\\r\\n1422   )\\r\\n1423 \\r\\n1424   const blocks = buildBlocks(\\r\\n1425     directed.filter((sequence) => sequence.direction === 'X'),\\r\\n1426     directed.filter((sequence) => sequence.direction === 'Y'),\\r\\n1427     marks,\\r\\n1428     titles,\\r\\n1429     issue,\\r\\n1430   )\\r\\n1431   if (process.env.DEBUG_PARSE === '1') {\\r\\n1432     console.error('result', JSON.stringify({ blocks, issues }))\\r\\n1433   }\\r\\n1434 \\r\\n1435   return { grids, blocks, issues }\\r\\n1436 }\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\r\nphases/36-corpus-widen-2\\step1-codex.stdout.log:42:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command '$OutputEncoding = [Console]::OutputEncoding = [Text.UTF8Encoding]::new(); rg --files tests | rg '\\\"'plan-import|framing-plan|grid|golden'; rg -n \\\\\\\"parseFramingPlan|existing14|14면|kani-p38|yokohama-p\\\\\\\" tests --glob '*.ts' --glob '*.tsx'\\\"\",\"aggregated_output\":\"tests\\\\plan-import\\\\parse.test.ts\\r\\ntests\\\\plan-import\\\\elevation.test.ts\\r\\ntests\\\\plan-import\\\\corpus2.test.ts\\r\\ntests\\\\gol