ed = spans\\r\\n  165:         .filter((span) => span.start < end && span.end > start)\\r\\n  166:         .map((span) => span.item)\\r\\n  167:       if (owned.length === 0) return []\\r\\n  168: \\r\\n  169:       let minX = Number.POSITIVE_INFINITY\\r\\n  170:       let maxX = Number.NEGATIVE_INFINITY\\r\\n  171:       for (const item of owned) {\\r\\n  172:         if (item.x < minX) minX = item.x\\r\\n  173:         if (item.x + item.w > maxX) maxX = item.x + item.w\\r\\n  174:       }\\r\\n  175: \\r\\n  176:       tokens.push({\\r\\n  177:         label: match[0],\\r\\n  178:         letter: match[0].includes('X') ? 'X' : 'Y',\\r\\n  179:         x: (minX + maxX) / 2,\\r\\n  180:         y,\\r\\n  180:         y,\\r\\n  181:       })\\r\\n  182:     }\\r\\n  183:   }\\r\\n  184: \\r\\n  185:   if (tokens.length > 0) return tokens\\r\\n  186: \\r\\n  187:   const simple = compact(text)\\r\\n  188:   if (!SIMPLE_AXIS_LABEL_PATTERN.test(simple)) return []\\r\\n  189: \\r\\n  190:   // `56`泥섎읆 ?섎굹??pdf.js ?멸렇癒쇳듃????媛쒖쓽 ???먮━ ?쇰꺼??遺숇뒗 寃쎌슦留?  // ?ㅼ젣 臾몄옄 醫뚰몴濡??섍?瑜몃떎. 10쨌11 媛숈? ???먮━ ?쇰꺼? 二쇰????곗냽????  // ?먮━ ?쇰꺼???덉쓣 ?뚮쭔 履쇨컻誘濡? ?쇰컲 移섏닔 臾몄옄?댁쓣 異뺤쑝濡??ㅼ씤?섏? ?딅뒗??\\r\\n  191:   if (\\r\\n  192:     simple.length === 2 &&\\r\\n  193:     /^[0-9]{2}$/.test(simple) &&\\r\\n  194:     segment.items.length === 2 &&\\r\\n  195:     segment.items.every((item) => SIMPLE_NUMERIC_LABEL_PATTERN.test(compact(item.str)))\\r\\n  196:   ) {\\r\\n  197:     const nearbyNumbers = rowSegments\\r\\n  198:       .filter((candidate) => candidate !== segment)\\r\\n  199:       .map((candidate) => compact(candidate.text))\\r\\n  200:       .filter((candidate) => SIMPLE_NUMERIC_LABEL_PATTERN.test(candidate))\\r\\n  201:       .map((candidate) => Number(candidate))\\r\\n  202:     const first = Number(simple[0])\\r\\n  203:     const second = Number(simple[1])\\r\\n  204:     const min = Math.min(...nearbyNumbers)\\r\\n  205:     const max = Math.max(...nearbyNumbers)\\r\\n  206:     const fillsGap =\\r\\n  207:       nearbyNumbers.length > 0 &&\\r\\n  208:       first + 1 === second &&\\r\\n  209:       min < first &&\\r\\n  210:       max > second\\r\\n  211:     if (fillsGap) {\\r\\n  212:       return segment.items.map((item, index) => {\\r\\n  213:         const piece = compact(item.str)\\r\\n  214:         return {\\r\\n  215:           label: piece,\\r\\n  216:           simpleKind: 'numeric',\\r\\n  217:           x: item.x + item.w / 2,\\r\\n  218:           y,\\r\\n  219:         }\\r\\n  220:       })\\r\\n  221:     }\\r\\n  222:   }\\r\\n  223: \\r\\n  224:   return [\\r\\n  225:     {\\r\\n  226:       label: simple,\\r\\n  227:       simpleKind: /^[0-9]+$/.test(simple) ? 'numeric' : 'alpha',\\r\\n  228:       x: segment.centerX,\\r\\n  229:       y,\\r\\n  230:     },\\r\\n  231:   ]\\r\\n  232: }\\r\\n  233: \\r\\n  234: interface CollectedTokens {\\r\\n  235:   labels: LabelToken[]\\r\\n  236:   dimensions: DimensionToken[]\\r\\n  237:   marks: PositionedToken[]\\r\\n  238:   titles: PositionedToken[]\\r\\n  239: }\\r\\n  240: \\r\\n  241: /**\\r\\n  242:  * CMap??湲?먮쭏??蹂꾨룄 ?꾩씠?쒖쓣 留뚮뱺 ?몃줈 移섏닔瑜?蹂댁셿?쒕떎. `verticalRuns`?? * 怨듦컻 臾명꽦? 諛붽씀吏 ?딄퀬, 洹?寃곌낵媛 ??湲?먯뵫 ?⑥? 寃쎌슦?먮쭔 媛숈? ?댁쓽 ?몄젒\\r\\n  243:  * 議곌컖???ㅼ떆 ?댁뼱 遺숈씤?? 議곌컖 ?덉そ??理쒖냼 媛꾧꺽??湲곗??쇰줈 ?쇨퀬 湲곗〈 ?몃줈\\r\\n  244:  * ?곗쓽 諛곗닔(`VERTICAL_RUN_GAP_RATIO`)瑜?洹몃?濡??ъ슜?섎?濡? ?섏씠吏 ?ш린?? * 諛쒖＜泥섏뿉 醫낆냽???덈? 醫뚰몴 臾명꽦??留뚮뱾吏 ?딅뒗??\\r\\n  245:  */\\r\\n  246: function mergeVerticalFragments(items: TextItem[]): VerticalRun[] {\\r\\n  247:   const runs = verticalRuns(items)\\r\\n  248:   const columns = new Map<number, VerticalRun[]>()\\r\\n  249:   for (const run of runs) {\\r\\n  250:     const column = columns.get(run.x)\\r\\n  251:     if (column) column.push(run)\\r\\n  252:     else columns.set(run.x, [run])\\r\\n  253:   }\\r\\n  254: \\r\\n  255:   const merged: VerticalRun[] = []\\r\\n  256:   for (const column of columns.values()) {\\r\\n  257:     const ordered = [...column].sort((left, right) => right.y - left.y)\\r\\n  258:     const oneCharGaps = ordered\\r\\n  259:       .slice(1)\\r\\n  260:       .map((run, index) => ordered[index].y - run.y)\\r\\n  261:       .filter(\\r\\n  262:         (gap, index) =>\\r\\n  263:           gap > 0 &&\\r\\n  264:           ordered[index].text.length === 1 &&\\r\\n  265:           ordered[index + 1].text.length === 1,\\r\\n  266:       )\\r\\n  267:     const baseGap = Math.min(...oneCharGaps)\\r\\n  268:     if (!Number.isFinite(baseGap)) {\\r\\n  269:       merged.push(...ordered)\\r\\n  270:       continue\\r\\n  271:     }\\r\\n  272: \\r\\n  273:     let current: VerticalRun[] = []\\r\\n  274:     const flush = () => {\\r\\n  275:       if (current.length === 0) return\\r\\n  276:       merged.push({\\r\\n  277:         text: current.map((run) => run.text).join(''),\\r\\n  278:         x: current[0].x,\\r\\n  279:         y:\\r\\n  280:           current.reduce((total, run) => total + run.y, 0) / current.length,\\r\\n  281:       })\\r\\n  282:       current = []\\r\\n  283:     }\\r\\n  284: \\r\\n  285:     for (const run of ordered) {\\r\\n  286:       const previous = current.at(-1)\\r\\n  287:       const gap = previous ? previous.y - run.y : Number.POSITIVE_INFINITY\\r\\n  288:       const adjacent =\\r\\n  289:         previous !== undefined &&\\r\\n  290:         previous.text.length === 1 &&\\r\\n  291:         run.text.length === 1 &&\\r\\n  292:         gap <= baseGap * VERTICAL_RUN_GAP_RATIO\\r\\n  293:       if (!adjacent) flush()\\r\\n  294:       current.push(run)\\r\\n  295:     }\\r\\n  296:     flush()\\r\\n  297:   }\\r\\n  298: \\r\\n  299:   return merged\\r\\n  300: }\\r\\n  301: \\r\\n  302: function collectTokens(page: TextPage): CollectedTokens {\\r\\n  303:   const labels: LabelToken[] = []\\r\\n  304:   const dimensions: DimensionToken[] = []\\r\\n  305:   const marks: PositionedToken[] = []\\r\\n  306:   const titles: PositionedToken[] = []\\r\\n  307: \\r\\n  308:   const classify = (text: string, x: number, y: number) => {\\r\\n  309:     const normalizedText = compact(text)\\r\\n  310:     if (\\r\\n  311:       DIMENSION_PATTERN.test(normalizedText) &&\\r\\n  312:       !SIMPLE_AXIS_LABEL_PATTERN.test(normalizedText)\\r\\n  313:     ) {\\r\\n  314:       dimensions.push({\\r\\n  315:         valueMm: Number.parseInt(normalizedText.replaceAll(',', ''), 10),\\r\\n  316:         x,\\r\\n  317:         y,\\r\\n  318:       })\\r\\n  319:       return\\r\\n  320:     }\\r\\n  321:     if (MARK_PATTERN.test(normalizedText)) {\\r\\n  322:       marks.push({ text: normalizedText, x, y })\\r\\n  323:       return\\r\\n  324:     }\\r\\n  325:     if (BLOCK_TITLE_PATTERN.test(normalizedText)) {\\r\\n  326:       titles.push({ text: normalizedText, x, y })\\r\\n  327:     }\\r\\n  328:   }\\r\\n  329: \\r\\n  330:   for (const row of recoverRows(page.items)) {\\r\\n  331:     for (const segment of row.segments) {\\r\\n  332:       labels.push(...splitAxisLabels(segment, row.y, row.segments))\\r\\n  333:       classify(segment.compact, segment.centerX, row.y)\\r\\n  334:     }\\r\\n  335:   }\\r\\n  336: \\r\\n  337:   // ?몃줈?곌린??臾몄옄 醫뚰몴媛 ?몃줈濡??먮Ⅴ誘濡??섍?瑜닿린瑜?嫄몄? ?딅뒗?????ㅼ륫 肄뷀띁?ㅼ쓽\\r\\n  338:   // ?몃줈 ?곗? 移섏닔肉먯씠怨? ?몃줈 ?쇰꺼??遺숈뼱 ?섏삤???꾨㈃? 鍮??꾨낫濡??ㅽ뙣?쒕떎 (R10)\\r\\n  339:   for (const run of mergeVerticalFragments(page.items)) {\\r\\n  340:     const normalizedText = compact(run.text)\\r\\n  341:     if (/^[a-z]?[XY]\\\\d+$/.test(normalizedText)) {\\r\\n  342:       labels.push({\\r\\n  343:         label: normalizedText,\\r\\n  344:         letter: normalizedText.includes('X') ? 'X' : 'Y',\\r\\n  345:         x: run.x,\\r\\n  346:         y: run.y,\\r\\n  347:       })\\r\\n  348:       continue\\r\\n  349:     }\\r\\n  350:     classify(normalizedText, run.x, run.y)\\r\\n  351:   }\\r\\n  352: \\r\\n  353:   return { labels, dimensions, marks, titles }\\r\\n  354: }\\r\\n  355: \\r\\n  356: /**\\r\\n  357:  * ?쇰꺼?ㅼ쓣 怨좎젙 醫뚰몴媛 ?댁뼱吏??諛대뱶濡?臾띔퀬, 諛대뱶 ?덉뿉???꾩튂