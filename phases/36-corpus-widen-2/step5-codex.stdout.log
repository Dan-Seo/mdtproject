{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport fs from 'node:fs'\nimport { parseFramingPlan } from './src/lib/import/framing-plan/parse.ts'\nimport { recoverRows, verticalRuns } from './src/lib/import/runs.ts'\nconst dir='tests/fixtures/section-import/textitems'\nconst canon=(s)=>String(s).normalize('NFKC').replace(/[\\\\s,]/g,'')\nfunction sourceVariants(page){\n const out=[]\n for(const i of page.items) out.push(canon(i.str))\n for(const row of recoverRows(page.items)){\n  const segs=row.segments.map(s=>s.compact)\n  for(const s of segs)out.push(canon(s))\n  for(let i=0;i<segs.length;i++){let j='';for(let k=i;k<Math.min(segs.length,i+20);k++){j+=segs[k];out.push(canon(j))}}\n }\n for(const r of verticalRuns(page.items))out.push(canon(r.text))\n return out\n}\nfunction sourceHas(page,value){\n const n=canon(value)\n return sourceVariants(page).some(s=>s.includes(n))\n}\nfor(const f of ['fuji-p15.json','fuji-p17.json']){\n const page=JSON.parse(fs.readFileSync(dir+'/'+f,'utf8'))\n const parsed=parseFramingPlan(page)\n const values=[]\n for(const g of parsed.grids){for(const x of g.spansMm)values.push(x);if(g.totalConfirmed)values.push(g.spansMm.reduce((a,x)=>a+x,0))}\n console.log(JSON.stringify({file:f,grids:parsed.grids,issues:parsed.issues,sourcePresence:values.map(v=>({value:v,present:sourceHas(page,v)}))},null,2))\n}\n'@ | node --import tsx/esm -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
