add(values, grid.spansMm.reduce((a, b) => a + b, 0), `grids[${gi}].total`)\n  })\n  parsed.blocks.forEach((block, bi) => block.placements.forEach((placement, pi) => add(values, placement.mark, `blocks[${bi}].placements[${pi}].mark`)))\n  return values\n}\nfunction elevationValues(parsed) {\n  const values = []\n  parsed.elevations.forEach((elevation, ei) => {\n    elevation.titles.forEach((title, ti) => add(values, title, `elevations[${ei}].titles[${ti}]`))\n    elevation.levels.forEach((level, li) => {\n      level.labels.forEach((label, xi) => add(values, label, `elevations[${ei}].levels[${li}].labels[${xi}]`))\n      add(values, elevation.heightsMm[li], `elevations[${ei}].heightsMm[${li}]`)\n    })\n  })\n  return values\n}\nfor (const file of files) {\n  const page = pageOf(file), source = sourceSet(page)\n  const valueGroups = [\n    { kind: '\"'section', values: sectionValues(parseSectionLists(page)) },\n    { kind: 'grid', values: gridValues(parseFramingPlan(page)) },\n    { kind: 'elevation', values: elevationValues(parseFrameElevations(page)) },\n  ]\n  for (const group of valueGroups) for (const entry of group.values) {\n    const present = typeof entry.value === 'number' ? source.numbers.has(num(entry.value)) : textHas(source, entry.value)\n    if (\"'!present) actualMissing.push({ pageFile: file, kind: group.kind, path: entry.path, value: entry.value })\n  }\n}\nconst step0 = JSON.parse(readFileSync('\"'phases/36-corpus-widen-2/step0-report.json', 'utf8'))\nconst existing = ['kani-p38.json','kani-p39.json','kani-p40.json','kani-p41.json','ojkk-p2.json','ojkk-p3.json','ojkk-p4.json','yokohama-p13.json','yokohama-p14.json','yokohama-p15.json','yokohama-p6.json','yokohama-p7.json','yokohama-p8.json','yokohama-p9.json']\nfunction snapshot(page) {\n  const section = parseSectionLists(page), grid = parseFramingPlan(page), elevation = parseFrameElevations(page)\n  return { lists: section.map(entry => ({ listKind: entry.listKind, cells: entry.candidates.length, 