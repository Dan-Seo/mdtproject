blocks ?? []).entries()) for (const [j, placement] of block.placements.entries()) addActual(values, placement.mark, `blocks[${i}].placements[${j}].mark`)\n  return values\n}\nconst actualElevationValues = parsed => {\n  const values = []\n  for (const [i, elevation] of parsed.elevations.entries()) {\n    for (const [j, title] of elevation.titles.entries()) addActual(values, title, `elevations[${i}].titles[${j}]`)\n    for (const [j, level] of elevation.levels.entries()) {\n      for (const [k, label] of level.labels.entries()) addActual(values, label, `elevations[${i}].levels[${j}].labels[${k}]`)\n      addActual(values, elevation.heightsMm[j], `elevations[${i}].heightsMm[${j}]`)\n    }\n  }\n  return values\n}\nconst compareValues = (pageFile, kind, values) => {\n  const source = sourceSet(load(sectionDir, pageFile))\n  for (const entry of values) {\n    const present = entry.number ? source.numbers.has(numberNorm(entry.value)) : source.strings.has(norm(entry.value)) || source.numbers.has(numberNorm(entry.value))\n    if (!present) missing.push({ pageFile, kind, path: entry.path, value: entry.value })\n  }\n}\nfor (const file of sectionFiles) {\n  const page = load(sectionDir, file)\n  compareValues(file, '\"'section', actualSectionValues(parseSectionLists(page)))\n  compareValues(file, 'grid', actualPlanValues(parseFramingPlan(page)))\n  compareValues(file, 'elevation', actualElevationValues(parseFrameElevations(page)))\n}\n\nconst expectedSectionMap = {\n  'karatsu-karayaku-s4-foundation-girders.json': 'karatsu-shousai-p1.json',\n  'ina-pump-p7-lists.json': 'ina-p7.json',\n  'saiki-fire-p1-girders.json': 'saiki-p1.json',\n  'saiki-fire-p2-columns.json': 'saiki-p2.json',\n  'fuji-kanritou-p20-lists.json': 'fuji-p20.json',\n}\nconst expectedPlanMap = Object.fromEntries([\n  ['fuji-kanritou-p17-grid.json', 'fuji-p17.json'],\n  ['hirosaki-kikyono-p21-grid.json', 'hirosaki-p21.json'],\n  ['hirosaki-kikyono-p25-elevation.json', 'hirosaki-p25.json'],\n  ['ina-pump-p6-gr