{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Raw src/lib/import/framing-plan/elevation.ts; rg -n \"parseFrameElevations|elevation|levelsBottom|heightsBottomMm\" tests/plan-import src/lib/import/framing-plan tests/fixtures/plan-import phases/36-corpus-widen-2 -g \"*\" -g \"!*.log\"'","aggregated_output":"import { recoverRows, verticalRuns } from '../runs'\nimport type { TextPage } from '../section-list/types'\n\nimport type {\n  ElevationCandidate,\n  ElevationIssue,\n  ElevationLevel,\n  ParsedFrameElevations,\n} from './types'\n\n/**\n * 邕며탡?녹쓽 ?믪씠 諛⑺뼢???띿뒪???덉씠?대쭔?쇰줈 蹂듭썝?쒕떎 (ADR-030).\n *\n * 鴉뤷쎋? ?щ━ ?쇰꺼 諛대뱶瑜??듭빱濡??????녿떎 ???ㅻЪ yokohama p8???덈꺼 ?쇰꺼?\n * 醫뚮떒 x媛 108~198濡??⑹뼱吏怨?以묒떖 x??123~221濡??⑹뼱吏꾨떎(湲???섏뿉 ?곕씪\n * ?ㅼ뿬?곌린媛 ?щ씪吏꾨떎). ???移섏닔 ?댁? x媛 ??媛믪쑝濡?怨㏐쾶 ?좊떎.\n *\n * 洹몃옒???듭빱??移섏닔 ?댁씠怨? ?뚯튂?섎뒗 ?먭린媛 ?щ뒗 援ш컙??以묒젏???볦씤?ㅳ띾뒗\n * 愿怨꾨줈 異뺤쿃怨??덈꺼 ?꾩튂瑜??④퍡 ?쇰떎. ?몄젒 ??移섏닔 v0쨌v1??媛꾧꺽?\n * (v0+v1)/2 횞 異뺤쿃?대?濡? 異뺤쿃? ?꾨㈃ ?쒓린瑜?誘우? ?딄퀬 ?ш린???좊룄?쒕떎.\n */\n\nconst DIMENSION_PATTERN = /^(?:\\d{1,3}(?:,\\d{3})+|\\d{2,})$/\nconst ELEVATION_TITLE_PATTERN = /邕며탡/\n/** 移섏닔 ?대줈 蹂대뒗 x ?덉슜?ㅼ감(pt). ?ㅻЪ p8???댁? x媛 ??媛믪쑝濡?怨㏓떎 */\nconst COLUMN_TOLERANCE_PT = 4\n/** ?덈꺼 ?쇰꺼怨????덈꺼 ?꾩튂???닿툔???덉슜(pt). ?ㅻЪ 理쒕? 4.1pt */\nconst LEVEL_TOLERANCE_PT = 15\n/**\n * ?덈꺼 ?쇰꺼??李얜뒗 媛濡?李?pt) ??移섏닔 ??以묒떖?먯꽌??嫄곕━.\n *\n * **??李쎌씠 怨꾩뿴??寃利??μ튂??** 移섏닔 ??媛쒕쭔?쇰줈??異뺤쿃???좊룄???섎뒗 ?덉뼱?? * ?議고븷 ?섍? ?녿떎(?좊룄??異뺤쿃???먭린 ?먯떊怨??닿툔???섎뒗 ?녿떎). 怨꾩뿴???노떎?? * 利앷굅???뚰뫜 ?덈꺼 ?꾩튂???ㅼ젣濡??쇰꺼?????덈떎?띾뒗 ?낅┰???ъ떎 ?섎굹肉먯씠怨?\n * 李쎌씠 ?볦쑝硫?洹?利앷굅媛 媛吏쒓? ?쒕떎.\n *\n * ?ㅻЪ kani p40?먯꽌 洹??쇱씠 ?쇱뼱?щ떎 ???꽷룹븘????邕며탡?녹쓽 **?꾩껜 移섏닔**\n * 5,535 ?섏씠 ???대줈 ?댁뼱??異뺤쿃??3諛곕줈 ?섏솕?붾뜲, 李쎌씠 150pt?대뜕 ?숈븞?먮뒗\n * 128pt ?⑥뼱吏?**?싥굤???쇰꺼 `Y1`**???덈꺼 ?쇰꺼濡?二쇱썙 寃利앹쓣 ?듦낵?덈떎.\n *\n * ?ㅼ륫???쇰꺼 嫄곕━??yokohama p8??理쒕? 62pt, kani p40??理쒕? 67pt?? 80?\n * 洹??꾩씠怨?128 ?꾨옒?? ??踰뚯뼱吏???꾨㈃? 鍮??꾨낫濡??ㅽ뙣?쒕떎 (R10).\n */\nconst LABEL_WINDOW_PT = 80\n/** 怨꾩뿴???댁뼱吏?붿? 蹂대뒗 異뺤쿃 ?몄감. 鴉뤷쎋 ?뚯꽌? 媛숈? 媛믪씠??*/\nconst SCALE_TOLERANCE_RATIO = 0.03\n/** ?쇰꺼??遺숈? ?덈꺼???대낫???곸쑝硫?怨꾩뿴濡?蹂댁? ?딅뒗????遺遺?移섏닔 ?닿낵???좎씪??援щ텇 */\nconst MINIMUM_LABELLED_LEVELS = 2\n/**\n * 怨꾩뿴???섎젮硫?移섏닔媛 ?대쭔???덉뼱???쒕떎.\n *\n * **?섎줈??諛섏쬆?????쒕떎.** 移섏닔 ??媛쒕뒗 異뺤쿃???섎굹 ?좊룄?섎뒗?? ?좊룄??媛믪씠\n * ?먭린 ?먯떊怨??닿툔???섎뒗 ?놁쑝誘濡?異뺤쿃 ?쇨???寃?ш? 怨듯쉶?꾪븳?? 洹몃윭硫??⑤뒗\n * 利앷굅???쇰꺼 ?쇱튂肉먯씤?? 湲?먭? 鍮쎈뭣???꾨㈃?먯꽌??洹멸쾬??**?곗뿰??* 留욌뒗???? * ?ㅻЪ kani p40?먯꽌 ?꽷룹븘????邕며탡?녹쓽 媛숈? 移섏닔(5,535 ?? 75 ??媛 ???대줈\n * ?댁뼱??異뺤쿃??3諛걔?20諛곕줈 ?섏솕?붾뜲??怨꾩궛???덈꺼 ?먮━??留덉묠 湲?먭? ?덉뼱\n * ??踰????듦낵?덈떎.\n *\n * ?뗭씠硫?異뺤쿃?????좊룄?섏뼱 ?쒕줈瑜?諛섏쬆?????덇퀬, 洹?寃?ш? ????寃쎌슦瑜? * 紐⑤몢 ?〓뒗?? ?媛濡?移섏닔媛 ?섎퓧??邕며탡??3?덈꺼)???쎌? ?딅뒗????吏?대궡?? * 寃껊낫???ル떎 (R10).\n */\nconst MINIMUM_CHAIN_DIMENSIONS = 3\n\ninterface Token {\n  text: string\n  x: number\n  y: number\n}\n\ninterface DimensionToken extends Token {\n  valueMm: number\n}\n\nfunction tokens(page: TextPage): Token[] {\n  const collected: Token[] = []\n  for (const row of recoverRows(page.items)) {\n    for (const segment of row.segments) {\n      collected.push({ text: segment.compact, x: segment.centerX, y: row.y })\n    }\n  }\n  for (const run of verticalRuns(page.items)) {\n    collected.push({ text: run.text, x: run.x, y: run.y })\n  }\n  return collected\n}\n\nfunction median(values: number[]): number {\n  return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\n}\n\n/** 移섏닔瑜?x媛 怨㏐쾶 ???대줈 臾띕뒗??*/\nfunction dimensionColumns(dimensions: DimensionToken[]): DimensionToken[][] {\n  const sorted = [...dimensions].sort((a, b) => a.x - b.x || a.y - b.y)\n  const columns: DimensionToken[][] = []\n\n  for (const token of sorted) {\n    const column = columns.at(-1)\n    if (column && Math.abs(column[0].x - token.x) <= COLUMN_TOLERANCE_PT) {\n      column.push(token)\n    } else {\n      columns.push([token])\n    }\n  }\n\n  return columns.map((column) => [...column].sort((a, b) => a.y - b.y))\n}\n\n/**\n * ???댁쓣 異뺤쿃???댁뼱吏??理쒕? 援ш컙?쇰줈 ?섎늿?? 媛숈? ?댁뿉 ?꽷룹븘????邕며탡?녠?\n * ?ㅻ━硫??ㅻЪ p8) 洹??ъ씠?먯꽌 ?좊룄 異뺤쿃???ш쾶 ?꾨떎 ???댁쓣 ?듭㎏濡?踰꾨━吏 ?딄퀬\n * 洹??먮━?먯꽌 ?먮Ⅸ??\n */\nfunction chains(column: DimensionToken[]): DimensionToken[][] {\n  const result: DimensionToken[][] = []\n  let current: DimensionToken[] = []\n  let reference: number | undefined\n\n  for (let i = 0; i + 1 < column.length; i++) {\n    const scale =\n      (2 * (column[i + 1].y - column[i].y)) /\n      (column[i].valueMm + column[i + 1].valueMm)\n    const continues =\n      reference !== undefined &&\n      Math.abs(scale / reference - 1) <= SCALE_TOLERANCE_RATIO\n\n    if (continues) {\n      current.push(column[i + 1])\n    } else {\n      if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\n      current = [column[i], column[i + 1]]\n      reference = scale\n    }\n  }\n  if (current.length >= MINIMUM_CHAIN_DIMENSIONS) result.push(current)\n\n  return result\n}\n\nfunction levelsOf(\n  chain: DimensionToken[],\n  scale: number,\n): Array<{ positionPt: number }> {\n  const first = chain[0].y - (chain[0].valueMm * scale) / 2\n  const positions = [first]\n  for (const dimension of chain) {\n    positions.push(positions[positions.length - 1] + dimension.valueMm * scale)\n  }\n  return positions.map((positionPt) => ({ positionPt }))\n}\n\nfunction verticalExtent(elevation: ElevationCandidate): {\n  top: number\n  bottom: number\n} {\n  return {\n    top: elevation.levels[0].positionPt,\n    bottom: elevation.levels[elevation.levels.length - 1].positionPt,\n  }\n}\n\n/**\n * ?몃줈 踰붿쐞媛 寃뱀튂??怨꾩뿴? **媛숈? 援ш컙???쒕줈 ?ㅻⅨ ?쎄린**?????ㅻЪ p8?먯꽌?? * ?롩쳵 ??1400쨌4100쨌4480쨌2690) ?놁뿉 ?ⓨ늽 移섏닔 ??190쨌150쨌2350)???섎????쒓퀬,\n * 洹?遺遺??대룄 洹쇱쿂 ?쇰꺼 ?섏쓣 二쇱썙 怨꾩뿴??議곌굔??留뚯”?쒕떎. ?????대㈃ ?ъ슜?먯뿉寃? * ?쒕줈 ?닿툔?섎뒗 ?롩쳵媛 ?숈떆??蹂댁씤??\n *\n * 媛???볤쾶 ?쎌? 寃??섎굹留??④릿?? ?롩쳵 ?댁? 邕며탡?녹쓽 ?믪씠 ?꾩껜瑜??ш퀬\n * 遺遺??댁? 援?냼?곸씠?? ?몃줈 踰붿쐞媛 洹??섏쓣 媛???ш쾶 媛덈씪 ?볥뒗???ㅻЪ?먯꽌\n * 359pt ? 38쨌52pt). ?꾨㈃ ?뺤떇?????꾩젣瑜?源⑤㈃ 怨꾩뿴???섎굹 ?щ씪吏怨?\n * 媛믪쓣 吏?대궡??????ъ슜?먭? ?먯쑝濡??ｋ뒗??(R10).\n */\nfunction withoutOverlaps(\n  elevations: ElevationCandidate[],\n): ElevationCandidate[] {\n  const ranked = [...elevations].sort((a, b) => {\n    const left = verticalExtent(a)\n    const right = verticalExtent(b)\n    return (\n      right.bottom - right.top - (left.bottom - left.top) ||\n      b.levels.length - a.levels.length\n    )\n  })\n\n  const kept: ElevationCandidate[] = []\n  for (const elevation of ranked) {\n    const range = verticalExtent(elevation)\n    const overlaps = kept.some((accepted) => {\n      const other = verticalExtent(accepted)\n      return range.top <= other.bottom && other.top <= range.bottom\n    })\n    if (!overlaps) kept.push(elevation)\n  }\n\n  return kept\n}\n\nexport function parseFrameElevations(page: TextPage): ParsedFrameElevations {\n  const collected = tokens(page)\n\n  const dimensions: DimensionToken[] = []\n  const labels: Token[] = []\n  const titles: Token[] = []\n  for (const token of collected) {\n    if (DIMENSION_PATTERN.test(token.text)) {\n      dimensions.push({\n        ...token,\n        valueMm: Number.parseInt(token.text.replaceAll(',', ''), 10),\n      })\n      continue\n    }\n    if (ELEVATION_TITLE_PATTERN.test(token.text)) {\n      titles.push(token)\n      continue\n    }\n    labels.push(token)\n  }\n\n  const elevations: ElevationCandidate[] = []\n  for (const column of dimensionColumns(dimensions)) {\n    for (const chain of chains(column)) {\n      const scales = chain\n        .slice(1)\n        .map(\n          (dimension, i) =>\n            (2 * (dimension.y - chain[i].y)) /\n            (chain[i].valueMm + dimension.valueMm),\n        )\n      const scale = median(scales)\n      const positions = levelsOf(chain, scale)\n\n      // ?쇰꺼? 媛??媛源뚯슫 ?덈꺼 ?섎굹?먮쭔 遺숇뒗????痢듭씠 ?뺤쑝硫??덉슜 踰붿쐞媛\n      // 寃뱀튂?붾뜲, 寃뱀튂??留뚰겮 ?묒そ???ｌ쑝硫??녿뒗 ?쇰꺼???앷릿??      const levels: ElevationLevel[] = positions.map(({ positionPt }) => ({\n        labels: [],\n        positionPt,\n      }))\n      for (const label of labels) {\n        if (Math.abs(label.x - chain[0].x) > LABEL_WINDOW_PT) continue\n        let nearest = -1\n        let nearestDistance = Number.POSITIVE_INFINITY\n        for (let i = 0; i < levels.length; i++) {\n          const distance = Math.abs(levels[i].positionPt - label.y)\n          if (distance < nearestDistance) {\n            nearest = i\n            nearestDistance = distance\n          }\n        }\n        if (nearest < 0 || nearestDistance > LEVEL_TOLERANCE_PT) continue\n        levels[nearest].labels.push(label.text)\n      }\n\n      const labelled = levels.filter((level) => level.labels.length > 0).length\n      if (labelled < MINIMUM_LABELLED_LEVELS) continue\n\n      elevations.push({\n        titles: [],\n        levels,\n        heightsMm: chain.map((dimension) => dimension.valueMm),\n        scalePtPerMm: scale,\n      })\n    }\n  }\n\n  const overlapFree = withoutOverlaps(elevations)\n  overlapFree.sort((a, b) => a.levels[0].positionPt - b.levels[0].positionPt)\n\n  // ?쒕ぉ? 怨꾩뿴??遺숈씤??????怨꾩뿴???щ윭 ?싥굤??邕며탡?녹뿉 怨듯넻?쇰줈 嫄몃━誘濡?  // (?ㅻЪ p8? 醫뚮떒 移섏닔 ???섎굹??bY1쨌bY2쨌bY3 ???? 1:1???꾨땲??\n  //\n  // ?⑥닚 理쒓렐?묒씠 ?꾨땲??**?쒕ぉ ?꾩뿉 ?덈뒗 怨꾩뿴???곗꽑?쒕떎.** 邕며탡?녹쓽 罹≪뀡?\n  // 洹몃┝ ?꾨옒???곹엳?붾뜲(?ㅻЪ p8??6???꾨?), ??洹몃┝??罹≪뀡? ??洹몃┝???섎떒怨?  // ?꾨옒 洹몃┝???곷떒?먯꽌 嫄곗쓽 媛숈? 嫄곕━???볦씤??p8 ?ㅼ륫 170.4pt ? 167.7pt) ??  // ?⑥닚 理쒓렐?묒? ??移쇰걹?먯꽌 媛덈━怨? ?ㅼ젣濡?VerticalRun.y 洹쒖빟 ?뺤젙(?뭮/2)??  // 洹??먯젙???ㅼ쭛????怨꾩뿴???쒕ぉ 0?μ쑝濡??щ씪議뚮떎. ?꾩뿉 怨꾩뿴???섎굹???놁쓣\n  // ?뚮쭔(罹≪뀡??洹몃┝ ?꾩뿉 ?덈뒗 ?뺤떇) ?꾨옒?먯꽌 理쒓렐?묒쓣 李얜뒗??\n  for (const title of titles) {\n    let above: ElevationCandidate | undefined\n    let aboveDistance = Number.POSITIVE_INFINITY\n    let below: ElevationCandidate | undefined\n    let belowDistance = Number.POSITIVE_INFINITY\n    for (const elevation of overlapFree) {\n      const top = elevation.levels[0].positionPt\n      const bottom = elevation.levels[elevation.levels.length - 1].positionPt\n      if (title.y >= top) {\n        const distance = title.y > bottom ? title.y - bottom : 0\n        if (distance < aboveDi