{"type":"item.completed","item":{"id":"item_161","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"node -e \\\"const fs=require('fs'); const s=fs.readFileSync('src/lib/import/framing-plan/parse.ts','utf8'); const names=['fuji','hirosaki','ina','karatsu','shibata','tsu','yokohama','kani']; const hits=[]; for(const [i,line] of s.split(/\\\\\\\\r?\\\\\\\\n/).entries()){if(names.some(n=>line.toLowerCase().includes(n))){hits.push({line:i+1,text:line.trim()})}} console.log(hits);\\\"\"","aggregated_output":"[\n  {\n    line: 1,\n    text: 'import {\\n' +\n      '  compact,\\n' +\n      '  recoverRows,\\n' +\n      '  verticalRuns,\\n' +\n      '  VERTICAL_RUN_GAP_RATIO,\\n' +\n      '  type TextSegment,\\n' +\n      '  type VerticalRun,\\n' +\n      \"} from '../runs'\\n\" +\n      \"import type { TextItem } from '../types'\\r\\n\" +\n      \"import type { TextPage } from '../section-list/types'\\r\\n\" +\n      '\\r\\n' +\n      'import type {\\r\\n' +\n      '  AxisCandidate,\\r\\n' +\n      '  MemberPlacement,\\r\\n' +\n      '  ParsedFramingPlan,\\r\\n' +\n      '  PlanBlock,\\r\\n' +\n      '  PlanGridCandidate,\\r\\n' +\n      '  PlanGridIssue,\\r\\n' +\n      \"} from './types'\\r\\n\" +\n      '\\r\\n' +\n      '/**\\r\\n' +\n      ' * 伏図의 通り芯 그리드와 부재 배치를 텍스트 레이어만으로 복원한다 (ADR-030).\\r\\n' +\n      ' *\\r\\n' +\n      ' * 실측(2026-08-23 스파이크, yokohama p5–p7·kani p38)이 준 구조:\\r\\n' +\n      ' * 축 라벨은 한 밴드(같은 x 또는 같은 y)에 늘어서고, 스팬 치수 문자열은\\r\\n' +\n      ' * 인접 라벨 좌표의 **중점**에 놓인다(실측 오차 ≤8pt). 전체 치수가 있으면\\r\\n' +\n      ' * 첫-끝 중점에 놓여 합계 검증식이 된다. 부재 부호는 격자점(柱)·변의 중점\\r\\n' +\n      ' * (大梁)·칸 중앙(床板) 중 하나에 놓인다. 벡터 선분은 쓰지 않는다 —\\r\\n' +\n      ' * 一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다.\\r\\n' +\n      ' */\\r\\n' +\n      '\\r\\n' +\n      '/**\\r\\n' +\n      ' * 通り芯 라벨 하나. 소문자 접두(b·c ＝ 棟 구분)는 실측 범위다 — 미지 표기(bX2A의\\r\\n' +\n      ' * 「A」 같은 枝番)는 지어내지 않고 정직하게 놓친다 (R10).\\r\\n' +\n      ' *\\r\\n' +\n      ' * sticky 플래그는 「이 세그먼트가 라벨의 연속으로 남김없이 설명되는가」를 묻기\\r\\n' +\n      ' * 위한 것이다 — 부분 일치를 라벨로 받으면 枝番 축이 조용히 본번으로 둔갑한다.\\r\\n' +\n      ' */\\r\\n' +\n      'const AXIS_LABEL_PATTERN = /[a-z]?[XY]\\\\d+/y\\n' +\n      \"const SIMPLE_AXIS_LABEL_PATTERN = /^(?:[A-Z](?:')?|\\\\d{1,2})$/\\n\" +\n      'const SIMPLE_NUMERIC_LABEL_PATTERN = /^\\\\d$/\\n' +\n      '/** 치수 문자열 — 쉼표 구분(6,000)과 무구분(8700) 둘 다 실물에 있다 */\\r\\n' +\n      'export const DIMENSION_PATTERN = /^(?:\\\\d{1,3}(?:,\\\\d{3})+|\\\\d{2,})$/\\r\\n' +\n      '/**\\r\\n' +\n      ' * 부재 부호. 断面リスト의 것(section-list의 MARK_PATTERN)에 S(床板)를 더했다 —\\r\\n' +\n      ' * 伏図에는 스ラブ 부호가 나오고 리스트 표에는 나오지 않는다.\\r\\n' +\n      ' */\\r\\n' +\n      'const MARK_PATTERN = /^(?:C|G|FC|FG|B|CB|S|W)\\\\d+[A-Z]?$/\\r\\n' +\n      '/** 블록 제목. 「2階床伏図1/100」처럼 축척이 붙어 오므로 부분 일치로 본다 */\\r\\n' +\n      'const BLOCK_TITLE_PATTERN = /伏図|柱芯線図/\\n' +\n      '\\r\\n' +\n      '// 실측 기반 허용오차. 근거는 스파이크 실측값이고 ADR-030에 적었다.\\r\\n' +\n      '/** 라벨을 같은 밴드로 보는 고정 좌표 허용오차. 실측 편차는 1pt 미만이다 */\\r\\n' +\n      'const BAND_TOLERANCE_PT = 8\\r\\n' +\n      '/** 치수 열이 라벨 밴드에서 떨어질 수 있는 거리. 실측 최대 50pt(kani X) */\\r\\n' +\n      'const DIMENSION_WINDOW_PT = 60\\r\\n' +\n      '/** 치수 중심과 인접 축 중점의 어긋남 허용. 14면 sweep의 안전 창도 6pt 이상\\r\\n' +\n      ' *  30pt 미만이다. 4pt에서는 기존 치수가 빠져 寸法欠落, 30pt부터는 오탐이 들어와\\r\\n' +\n      ' *  合計不一致가 된다. 채택 최댓값은 5.803722pt, 合計 미확인 축의 최근접 미사용\\r\\n' +\n      ' *  경쟁 치수는 140.325470pt다. */\\r\\n' +\n      'const MIDPOINT_TOLERANCE_PT = 15\\r\\n' +\n      '/** 스팬별 실측 축척(pt/mm)의 중앙값 대비 허용 편차. 실측 최대 0.5% */\\r\\n' +\n      'const SCALE_TOLERANCE_RATIO = 0.03\\r\\n' +\n      '/**\\r\\n' +\n      ' * 부호를 격자점·중점에 붙이는 허용 거리 ＝ 그 방향 **중앙값 스팬**의 이 비율.\\r\\n' +\n      ' *\\r\\n' +\n      ' * 인접 스팬을 쓰지 않는 이유가 있다: 실물 yokohama p7의 bX3–cX1은 1200mm(34pt)\\r\\n' +\n      ' * 짜리 좁은 띠라, 인접 스팬 기준이면 허용이 8pt로 좁아져 引出線으로 20pt쯤\\r\\n' +\n      ' * 비켜 적힌 柱 부호가 통째로 떨어진다. 중앙값은 그 좁은 띠 하나에 흔들리지 않는다.\\r\\n' +\n      ' *\\r\\n' +\n      ' * 1/4을 넘길 수는 없다 — 격자점과 중점이 반 스팬 간격이므로 1/4이 「어느 쪽에도\\r\\n' +\n      ' * 붙일 수 있다」의 경계다. 그보다 크게 잡으면 어느 쪽인지 제품이 고르게 된다.\\r\\n' +\n      ' */\\r\\n' +\n      'const SNAP_RATIO = 0.25\\r\\n' +\n      '/**\\r\\n' +\n      ' * X·Y 열 짝지음 상한 ＝ X 通り芯의 중앙값 실측 스팬 × 이 비율.\\r\\n' +\n      ' * 페이지 축척에 따라 함께 변하고, Y 라벨 띠가 대표 스팬 1.5칸보다 멀면\\r\\n' +\n      ' * 같은 伏図이라는 기하 근거가 없으므로 블록을 내지 않는다.\\r\\n' +\n      ' */\\r\\n' +\n      'const GRID_PAIRING_DISTANCE_RATIO = 1.5\\r\\n' +\n      '\\r\\n' +\n      'interface LabelToken {\\n' +\n      '  label: string\\n' +\n      \"  letter?: 'X' | 'Y'\\n\" +\n      '  /** prefix가 없는 숫자·알파벳 라벨은 방향을 이름만으로 알 수 없다 */\\n' +\n      \"  simpleKind?: 'numeric' | 'alpha'\\n\" +\n      '  x: number\\n' +\n      '  y: number\\n' +\n      '}\\n' +\n      '\\r\\n' +\n      'interface PositionedToken {\\r\\n' +\n      '  text: string\\r\\n' +\n      '  x: number\\r\\n' +\n      '  y: number\\r\\n' +\n      '}\\r\\n' +\n      '\\r\\n' +\n      'interface DimensionToken {\\r\\n' +\n      '  valueMm: number\\r\\n' +\n      '  x: number\\r\\n' +\n      '  y: number\\r\\n' +\n      '}\\r\\n' +\n      '\\r\\n' +\n      'interface AxisSequence {\\n' +\n      \"  letters: Set<'X' | 'Y'>\\n\" +\n      \"  simpleKinds: Set<'numeric' | 'alpha'>\\n\" +\n      '  /** positionPt가 어느 좌표인가 — 치수 매칭이 같은 좌표를 봐야 한다 */\\r\\n' +\n      \"  alongKey: 'x' | 'y'\\r\\n\" +\n      '  /** 밴드의 고정 좌표(평균) — 치수 창의 기준 */\\n' +\n      '  across: number\\n' +\n      '  /** 밴드가 끊겨 같은 축을 이어 붙인 경우 구간별 원래 밴드 좌표 */\\n' +\n      '  axisAcross: number[]\\n' +\n      '  /** 같은 라벨이 여러 밴드에 있었을 때 치수 열을 시도할 좌표 */\\n' +\n      '  axisAcrossOptions: number[][]\\n' +\n      '  axes: AxisCandidate[]\\n' +\n      '}\\n' +\n      '\\r\\n' +\n      '/** 치수·축척까지 확인이 끝난 축 열. 그리드 정의와 블록이 둘 다 여기서 나온다 */\\r\\n' +\n      'interface ValidatedSequence extends AxisSequence {\\n' +\n      \"  direction?: 'X' | 'Y'\\n\" +\n      '  spansMm: number[]\\n' +\n      '  scalePtPerMm: number\\n' +\n      '  totalConfirmed: boolean\\n' +\n      '}\\n' +\n      '\\n' +\n      \"type DirectedSequence = ValidatedSequence & { direction: 'X' | 'Y' }\\n\" +\n      '\\r\\n' +\n      '/**\\r\\n' +\n      ' * 세그먼트 하나를 라벨의 연속으로 되가른다. `makeSegments`는 표의 칸을 묶으려고\\r\\n' +\n      ' * 만든 규칙이라 인접한 두 通り芯을 한 덩이로 붙인다 — 실물 yokohama p7에서\\r\\n' +\n      ' * `bX3`(34pt 간격)와 `cX1`이 「bX3cX1」이 됐다.\\r\\n' +\n      ' *\\r\\n' +\n      ' * 되가른 라벨의 좌표는 **그 라벨을 이룬 문자들에서** 다시 잰다. 등분·보간으로\\r\\n' +\n      ' * 만들면 도면에 없는 위치를 제품이 정하는 것이 되고, 그 위치가 그대로 스팬\\r\\n' +\n      ' * 치수의 중점 판정에 쓰인다.\\r\\n' +\n      ' *\\r\\n' +\n      ' * 세그먼트 전체가 라벨로 남김없이 설명될 때만 받는다.\\r\\n' +\n      ' */\\r\\n' +\n      'function splitAxisLabels(\\n' +\n      '  segment: TextSegment,\\n' +\n      '  y: number,\\n' +\n      '  rowSegments: TextSegment[],\\n' +\n      '): LabelToken[] {\\n' +\n      '  // NFKC가 한 글자를 여러 글자로 펴는 경우가 있으므로 1:1을 가정하지 않고\\r\\n' +\n      '  // 문자마다 텍스트상의 구간을 기록해 되찾는다\\r\\n' +\n      \"  let text = ''\\r\\n\" +\n      '  const spans: Array<{ start: number; end: number; item: TextItem }> = []\\r\\n' +\n      '  for (const item of segment.items) {\\r\\n' +\n      '    const piece = compact(item.str)\\r\\n' +\n      \"    if (piece === '') continue\\r\\n\" +\n      '    spans.push({ start: text.length, end: text.length + piece.length, item })\\r\\n' +\n      '    text += piece\\r\\n' +\n      '  }\\r\\n' +\n      \"  if (text === '') return []\\n\" +\n      '\\n' +\n      '  const tokens: LabelToken[] = []\\n' +\n      '  if (/^[a-z]?[XY]/.test(text)) {\\n' +\n      '    AXIS_LABEL_PATTERN.lastIndex = 0\\n' +\n      '    while (AXIS_LABEL_PATTERN.lastIndex < text.length) {\\n' +\n      '      const start = AXIS_LABEL_PATTERN.lastIndex\\n' +\n      '      const match = AXIS_LABEL_PATTERN.exec(text)\\n' +\n      '      if (!match) return []\\n' +\n      '      const end = AXIS_LABEL_PATTERN.lastIndex\\n' +\n      '\\n' +\n      '      const owned = spans\\n' +\n      '        .filter((span) => span.start < end && span.end > start)\\n' +\n      '        .map((span) => span.item)\\n' +\n      '      if (owned.length === 0) return []\\n' +\n      '\\n' +\n      '      let minX = Number.POSITIVE_INFINITY\\n' +\n      '      let maxX = Number.NEGATIVE_INFINITY\\n' +\n      '      for (const item of owned) {\\n' +\n      '        if (item.x < minX) minX = item.x\\n' +\n      '        if (item.x + item.w > maxX) maxX = item.x + item.w\\n' +\n      '      }\\n' +\n      '\\n' +\n      '      tokens.push({\\n' +\n      '        label: match[0],\\n' +\n      \"        letter: match[0].includes('X') ? 'X' : 'Y',\\n\" +\n      '        x: (minX + maxX) / 2,\\n' +\n      '        y,\\n' +\n      '      })\\n' +\n      '    }\\n' +\n      '  }\\n' +\n      '\\n' +\n      '  if (tokens.length > 0) return tokens\\n' +\n      '\\n' +\n      '  const simple = compact(text)\\n' +\n      '  if (!SIMPLE_AXIS_LABEL_PATTERN.test(simple)) return []\\n' +\n      '\\n' +\n      '  // `56`처럼 하나의 pdf.js 세그먼트에 두 개의 한 자리 라벨이 붙는 경우만\\n' +\n      '  // 실제 문자 좌표로 되가른다. 10·11 같은 두 자리 라벨은 주변에 연속된 한\\n' +\n      '  // 자리 라벨이 있을 때만 쪼개므로, 일반 치수 문자열을 축으로 오인하지 않는다.\\n' +\n      '  if (\\n' +\n      '    simple.length === 2 &&\\n' +\n      '    /^[0-9]{2}$/.test(simple) &&\\n' +\n      '    segment.items.length === 2 &&\\n' +\n      '    segment.items.every((item) => SIMPLE_NUMERIC_LABEL_PATTERN.test(compact(item.str)))\\n' +\n      '  ) {\\n' +\n      '    const nearbyNumbers = rowSegments\\n' +\n      '      .filter((candidate) => candidate !== segment)\\n' +\n      '      .map((candidate) => compact(candidate.text))\\n' +\n      '      .filter((candidate) => SIMPLE_NUMERIC_LABEL_PATTERN.test(candidate))\\n' +\n      '      .map((candidate) => Number(candidate))\\n' +\n      '    const first = Number(simple[0])\\n' +\n      '    const second = Number(simple[1])\\n' +\n      '    const min = Math.min(...nearbyNumbers)\\n' +\n      '    const max = Math.max(...nearbyNumbers)\\n' +\n      '    const fillsGap =\\n' +\n      '      nearbyNumbers.length > 0 &&\\n' +\n      '      first + 1 === second &&\\n' +\n      '      min < first &&\\n' +\n      '      max > second\\n' +\n      '    if (fillsGap) {\\n' +\n      '      return segment.items.map((item) => {\\n' +\n      '        const piece = compact(item.str)\\n' +\n      '        return {\\n' +\n      '          label: piece,\\n' +\n      \"          simpleKind: 'numeric',\\n\" +\n      '          x: item.x + item.w / 2,\\n' +\n      '          y,\\n' +\n      '        }\\n' +\n      '      })\\n' +\n      '    }\\n' +\n      '  }\\n' +\n      '\\n' +\n      '  return [\\n' +\n      '    {\\n' +\n      '      label: simple,\\n' +\n      \"      simpleKind: /^[0-9]+$/.test(simple) ? 'numeric' : 'alpha',\\n\" +\n      '      x: segment.centerX,\\n' +\n      '      y,\\n' +\n      '    },\\n' +\n      '  ]\\n' +\n      '}\\n' +\n      '\\r\\n' +\n      'interface CollectedTokens {\\n' +\n      '  labels: LabelToken[]\\r\\n' +\n      '  dimensions: DimensionToken[]\\r\\n' +\n      '  marks: PositionedToken[]\\r\\n' +\n      '  titles: PositionedToken[]\\r\\n' +\n      '}\\n' +\n      '\\n' +\n      '/**\\n' +\n      ' * CMap이 글자마다 별도 아이템을 만든 세로 치수를 보완한다. `verticalRuns`의\\n' +\n      ' * 공개 문턱은 바꾸지 않고, 그 결과가 한 글자씩 남은 경우에만 같은 열의 인접\\n' +\n      ' * 조각을 다시 이어 붙인다. 조각 안쪽의 최소 간격을 기준으로 삼고 기존 세로\\n' +\n      ' * 런의 배수(`VERTICAL_RUN_GAP_RATIO`)를 그대로 사용하므로, 페이지 크기나\\n' +\n      ' * 발주처에 종속된 절대 좌표 문턱을 만들지 않는다.\\n' +\n      ' */\\n' +\n      'function mergeVerticalFragments(items: TextItem[]): VerticalRun[] {\\n' +\n      '  const runs = verticalRuns(items)\\n' +\n      '  const columns = new Map<number, VerticalRun[]>()\\n' +\n      '  for (const run of runs) {\\n' +\n      '    const column = columns.get(run.x)\\n' +\n      '    if (column) column.push(run)\\n' +\n      '    else columns.set(run.x, [run])\\n' +\n      '  }\\n' +\n      '\\n' +\n      '  const merged: VerticalRun[] = []\\n' +\n      '  for (const column of columns.values()) {\\n' +\n      '    const ordered = [...column].sort((left, right) => right.y - left.y)\\n' +\n      '    const oneCharGaps = ordered\\n' +\n      '      .slice(1)\\n' +\n      '      .map((run, index) => ordered[index].y - run.y)\\n' +\n      '      .filter(\\n' +\n      '        (gap, index) =>\\n' +\n      '          gap > 0 &&\\n' +\n      '          ordered[index].text.length === 1 &&\\n' +\n      '          ordered[index + 1].text.length === 1,\\n' +\n      '      )\\n' +\n      '    const baseGap = Math.min(...oneCharGaps)\\n' +\n      '    if (!Number.isFinite(baseGap)) {\\n' +\n      '      merged.push(...ordered)\\n' +\n      '      continue\\n' +\n      '    }\\n' +\n      '\\n' +\n      '    let current: VerticalRun[] = []\\n' +\n      '    const flush = () => {\\n' +\n      '      if (current.length === 0) return\\n' +\n      '      merged.push({\\n' +\n      \"        text: current.map((run) => run.text).join(''),\\n\" +\n      '        x: current[0].x,\\n' +\n      '        y:\\n' +\n      '          current.reduce((total, run) => total + run.y, 0) / current.length,\\n' +\n      '      })\\n' +\n      '      current = []\\n' +\n      '    }\\n' +\n      '\\n' +\n      '    for (const run of ordered) {\\n' +\n      '      const previous = current.at(-1)\\n' +\n      '      const gap = previous ? previous.y - run.y : Number.POSITIVE_INFINITY\\n' +\n      '      const adjacent =\\n' +\n      '        previous !== undefined &&\\n' +\n      '        previous.text.length === 1 &&\\n' +\n      '        run.text.length === 1 &&\\n' +\n      '        gap <= baseGap * VERTICAL_RUN_GAP_RATIO\\n' +\n      '      if (!adjacent) flush()\\n' +\n      '      current.push(run)\\n' +\n      '    }\\n' +\n      '    flush()\\n' +\n      '  }\\n' +\n      '\\n' +\n      '  return merged\\n' +\n      '}\\n' +\n      '\\n' +\n      'function collectTokens(page: TextPage): CollectedTokens {\\n' +\n      '  const labels: LabelToken[] = []\\r\\n' +\n      '  const dimensions: DimensionToken[] = []\\r\\n' +\n      '  const m