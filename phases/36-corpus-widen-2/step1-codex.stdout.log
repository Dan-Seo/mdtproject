2690],\r\n    ])\r\n  })\r\n\r\n  it('寃쎄퀎 ?쇰꺼怨?媛?怨꾩뿴??邕며탡???쒕ぉ???먮Ц 洹몃?濡??ｋ뒗??, () => {\r\n    for (const elevation of parsed.elevations) {\r\n      expect(elevation.levels.map((level) => level.labels)).toEqual([\r\n        [],\r\n        ['訝?ㄾ汝웂CL(麗답툔)'],\r\n        ['2FL'],\r\n        ['訝?ㄾ汝?FL', '?뷸틬GL'],\r\n        ['?븀쨴訝뗧ク'],\r\n      ])\r\n    }\r\n    expect(parsed.elevations.map((entry) => entry.titles)).toEqual([\r\n      ['bX1?싥굤邕며탡??/100', 'bX2A?싥굤邕며탡??/100'],\r\n      ['bX2?싥굤邕며탡??/100', 'bX3?싥굤邕며탡??/100'],\r\n    ])\r\n  })\r\n})\r\n\r\nimport { readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport {\r\n  DIMENSION_PATTERN,\r\n  parseFramingPlan,\r\n} from '@/lib/import/framing-plan/parse'\r\nimport type { PlanGridCandidate } from '@/lib/import/framing-plan/types'\r\nimport type { TextPage } from '@/lib/import/section-list/types'\r\nimport { recoverRows, verticalRuns } from '@/lib/import/runs'\r\n\r\n// TextItem ?쎌뒪泥?肄뷀띁?ㅻ뒗 section-import? 怨듭쑀?쒕떎 ??醫뚰몴 洹쒖빟怨??쒖젣? ?쒖쇅瑜?\n// ???뚯씠?꾨씪??scripts/extract-textitems.mjs)??蹂댁쬆?섍린 ?뚮Ц?대떎.\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nconst DRAWING_FIXTURES = [\r\n  'kani-p38.json',\r\n  'kani-p39.json',\r\n  'kani-p40.json',\r\n  'kani-p41.json',\r\n  'ojkk-p2.json',\r\n  'ojkk-p3.json',\r\n  'ojkk-p4.json',\r\n  'yokohama-p13.json',\r\n  'yokohama-p14.json',\r\n  'yokohama-p15.json',\r\n  'yokohama-p6.json',\r\n  'yokohama-p7.json',\r\n  'yokohama-p8.json',\r\n  'yokohama-p9.json',\r\n]\r\n\r\nfunction dimensionCandidates(page: TextPage): string[] {\r\n  const horizontal = recoverRows(page.items).flatMap((row) =>\r\n    row.segments.map((segment) => segment.compact),\r\n  )\r\n  const vertical = verticalRuns(page.items).map((run) => run.text)\r\n  return [...horizontal, ...vertical].filter((text) =>\r\n    DIMENSION_PATTERN.test(text),\r\n  )\r\n}\r\n\r\nit('?ㅻ룄硫?14硫댁쓽 媛濡쑣룹꽭濡?移섏닔 ?꾨낫?먮뒗 0mm ?댄븯媛 ?녿떎', () => {\r\n  // ??媛?쒕뒗 ?뚯꽌 異쒕젰???꾨땲??runs.ts???멸렇癒쇳듃 臾명꽦 遺덈??앹씠??\r\n  // ?ㅼ륫??湲곕낯 臾명꽦?먯꽌??14硫?紐⑤몢 0嫄댁씠怨? gapRatio瑜?0.5濡???텛硫?\n  // yokohama-p14????50x1000?띿씠 650쨌x쨌1쨌000?쇰줈 媛덈씪??000??4嫄??섏삩??\r\n  // 0.8쨌0.7쨌0.6?먯꽌??移⑤У?섎?濡?珥섏킌??寃쎄퀎媛 ?꾨땶 援듭? ?몃┰??댁뼱??\r\n  // ?몃줈 `VERTICAL_RUN_GAP_RATIO`??媛濡쒖? 媛숈? 援듭? ?몃┰??댁뼱?? 14硫??꾩껜??媛숈?\r\n  // ???몄젒 1,697?띿뿉??`gap / max(w)` 理쒖넖媛믪? 1.000000?닿퀬, 1.5~2.0 援ш컙?\r\n  // yokohama-p7??1?띾퓧?댁뿀?? 1 誘몃쭔???띿? 0媛쒖???\n  // (6?먮━ 諛섏삱由?湲곗?; ?먯떆 理쒖넖媛믪? 遺?숈냼??ULP ?붿감濡?0.9999999999999634).\r\n  // 0.99쨌0.8쨌0.5쨌0.3?먯꽌??紐⑤뱺 ?곗씠 1湲?먮줈 媛덈씪??`DIMENSION_PATTERN`\r\n  // ?듦낵媛 0嫄댁씠?? 諛곗닔媛 ?뺥솗??1.0???뚮뒗 李?`(1w, 2w)`???섎떒 紐⑥꽌由ъ뿉??\n  // `00`쨌`000` 議곌컖???앷꺼 0mm 媛?쒓? ?몃ŉ, 湲곗〈 8硫댁쓽 40嫄댁쓣 ?ы븿??kani-p38 3嫄?쨌\r\n  // kani-p39 11嫄?쨌 ojkk-p3 21嫄?쨌 ojkk-p4 1嫄?쨌 yokohama-p6 12嫄?쨌 p7 13嫄?쨌\r\n  // p8 3嫄?쨌 p9 5嫄? ?⑷퀎 69嫄댁씠??\r\n  const measured = DRAWING_FIXTURES.map((file) => {\r\n    const candidates = dimensionCandidates(readPage(file))\r\n    return {\r\n      file,\r\n      nonPositive: candidates.filter(\r\n        (text) => Number.parseInt(text.replaceAll(',', ''), 10) <= 0,\r\n      ),\r\n    }\r\n  })\r\n\r\n  expect(measured).toEqual(\r\n    DRAWING_FIXTURES.map((file) => ({ file, nonPositive: [] })),\r\n  )\r\n})\r\n\r\n// ?????섏씠吏 以?異??쇰꺼 紐⑥뼇???멸렇癒쇳듃瑜?媛吏?寃껋? yokohama-p14 ?섎굹肉먯씠??\n// (12媛? `X2塋?쨌`X3塋?쨌`Y2塋?쨌`Y3塋?쨌`Y4塋?쨌`Y5塋???諛섎났). yokohama-p13쨌ojkk-p2쨌\r\n// ojkk-p3? 媛곴컖 0媛쒕씪 ?쇰꺼 ?꾨낫 ?먯껜媛 ?녿떎. ??援щ퀎? ?먯????먮낯 ?뚯뒪?몄뿉??\n// 紐낆떆???덉뿀怨? ?ㅼ륫 洹쇨굅??fa5ab24??tests/section-import/plan-grid.test.ts???⑥븘 ?덈떎.\r\n//\r\n// ??grid-parse??X2쨌X3瑜?癒쇱? ?쇰꺼濡?李얠? ?? ?ㅽ뙩 1蹂?異뺤? 寃?곗씠\r\n// 怨듯쉶?꾪븳?ㅻ뒗 ?댁쑀濡?`?븅뼋?겻툖擁??쇰줈 嫄곗젅?덈떎. framing-plan? 湲곗쟾??\n// ?ㅻⅤ?? ?ㅼ젣 ?멸렇癒쇳듃??`X2塋?쨌`Y4塋?泥섎읆 ?쇰꺼 ?ㅼ뿉 `塋???遺숈뼱 ?덇퀬,\r\n// sticky AXIS_LABEL_PATTERN? X2瑜?留ㅼ튂?????⑥? 塋?퉴吏 ?뚮퉬?섏? 紐삵븳??\r\n// splitAxisLabels媛 ?멸렇癒쇳듃 ?꾩껜瑜??ㅻ챸?섏? 紐삵븳 寃껋쑝濡?蹂닿퀬 鍮?諛곗뿴??\n// 諛섑솚?섎?濡? framing-plan? ?쇰꺼??李얘린 ???④퀎?먯꽌 `?싥굤??꺀?쇻꺂?ゆ쩂?????몃떎.\r\ndescribe('??씊?ゃ궧??pages do not produce framing grids', () => {\r\n  it('does not invent grids from axis-like section marks', () => {\r\n    const files = [\r\n      'yokohama-p14.json',\r\n      'yokohama-p13.json',\r\n      'ojkk-p2.json',\r\n      'ojkk-p3.json',\r\n    ]\r\n\r\n    expect(\r\n      files.map((file) => {\r\n        const parsed = parseFramingPlan(readPage(file))\r\n        return {\r\n          file,\r\n          grids: parsed.grids.length,\r\n          issues: parsed.issues,\r\n        }\r\n      }),\r\n    ).toEqual([\r\n      {\r\n        file: 'yokohama-p14.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n      {\r\n        file: 'yokohama-p13.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n      {\r\n        file: 'ojkk-p2.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n      {\r\n        file: 'ojkk-p3.json',\r\n        grids: 0,\r\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\r\n      },\r\n    ])\r\n  })\r\n})\r\n\r\nfunction grid(\r\n  candidates: PlanGridCandidate[],\r\n  direction: 'X' | 'Y',\r\n): PlanGridCandidate {\r\n  const found = candidates.find((entry) => entry.direction === direction)\r\n  expect(found, `missing ${direction} grid`).toBeDefined()\r\n  return found as PlanGridCandidate\r\n}\r\n\r\n// 湲곕?媛믪? ?꾨㈃?먯꽌 ?낅┰ ?꾩궗??媛믪씠??(?먮낯: tests/fixtures/section-import/SOURCES.md).\r\n// 異??꾩튂(pt)???꾨㈃ 醫뚰몴???ш린 諛뺤? ?딄퀬 ?⑥“ 利앷?留?蹂몃떎 ???꾨㈃??吏꾩떎?\r\n// ?쇰꺼 ?쒖꽌? ?ㅽ뙩 移섏닔(mm)??\r\n\r\ndescribe('yokohama p7 (2?롥틞鴉뤷쎋?팕?롥틞鴉뤷쎋)', () => {\r\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\r\n\r\n  it('??釉붾줉쨌?묐떒 以묐났???묓? X쨌Y 媛?1媛쒖쓽 ?꾨낫媛 ?⑤뒗??, () => {\r\n    expect(parsed.issues).toEqual([])\r\n    expect(parsed.grids).toHaveLength(2)\r\n  })\r\n\r\n  it('X: bX1?밷X3쨌cX1, ?ㅽ뙩 8700쨌8700쨌1200', () => {\r\n    const x = grid(parsed.grids, 'X')\r\n    expect(x.axes.map((axis) => axis.label)).toEqual([\r\n      'bX1',\r\n      'bX2',\r\n      'bX3',\r\n      'cX1',\r\n    ])\r\n    expect(x.spansMm).toEqual([8700, 8700, 1200])\r\n    expect(x.totalConfirmed).toBe(false)\r\n  })\r\n\r\n  it('Y: bY6?뭕Y1 (?꾨㈃ 洹몃?濡쒖쓽 ?쒖꽌), ?ㅽ뙩 5000쨌6000쨌10000쨌6000쨌5000', () => {\r\n    const y = grid(parsed.grids, 'Y')\r\n    expect(y.axes.map((axis) => axis.label)).toEqual([\r\n      'bY6',\r\n      'bY5',\r\n      'bY4',\r\n      'bY3',\r\n      'bY2',\r\n      'bY1',\r\n    ])\r\n    expect(y.spansMm).toEqual([5000, 6000, 10000, 6000, 5000])\r\n    expect(y.totalConfirmed).toBe(false)\r\n  })\r\n\r\n  it('異??꾩튂???⑥“ 利앷??섍퀬 ?ㅼ륫 異뺤쿃? 1/100 遺洹쇱씠??, () => {\r\n    for (const candidate of parsed.grids) {\r\n      const positions = candidate.axes.map((axis) => axis.positionPt)\r\n      expect([...positions].sort((a, b) => a - b)).toEqual(positions)\r\n      // 1/100 ?꾨㈃??pt/mm = 72 / 25.4 / 100 ??0.02835\r\n      expect(candidate.scalePtPerMm).toBeGreaterThan(0.027)\r\n      expect(candidate.scalePtPerMm).toBeLessThan(0.03)\r\n    }\r\n  })\r\n})\r\n\r\ndescribe('kani p38 (?븀쨴鴉뤷쎋)', () => {\r\n  const parsed = parseFramingPlan(readPage('kani-p38.json'))\r\n\r\n  it('X: X1?밲4, ?ㅽ뙩 6000쨌6000쨌8000 ???꾩껜 移섏닔 20,000?쇰줈 ?뺤씤?쒕떎', () => {\r\n    const x = grid(parsed.grids, 'X')\r\n    expect(x.axes.map((axis) => axis.label)).toEqual(['X1', 'X2', 'X3', 'X4'])\r\n    expect(x.spansMm).toEqual([6000, 6000, 8000])\r\n    expect(x.totalConfirmed).toBe(true)\r\n  })\r\n\r\n  it('Y: ?꾨㈃ 醫뚢넂?곌? Y3쨌Y2쨌Y1 ???ㅽ뙩 6000쨌10500, ?꾩껜 16,500?쇰줈 ?뺤씤?쒕떎', () => {\r\n    const y = grid(parsed.grids, 'Y')\r\n    expect(y.axes.map((axis) => axis.label)).toEqual(['Y3', 'Y2', 'Y1'])\r\n    expect(y.spansMm).toEqual([6000, 10500])\r\n  