.length - 1,\r\n 832           )\r\n 833         : []\r\n 834     return {\r\n 835       solution,\r\n 836       spanSum,\r\n 837       candidates,\r\n 838       matching: candidates.some((candidate) => candidate.valueMm === spanSum),\r\n 839     }\r\n 840   })\r\n 841   const matchingTotals = fullTotals.filter((candidate) => candidate.matching)\r\n 842   if (matchingTotals.length > 0) {\r\n 843     const unique = new Map<string, (typeof matchingTotals)[number]>()\r\n 844     for (const candidate of matchingTotals) {\r\n 845       const key = candidate.solution.spans.map((span) => span.valueMm).join(',')\r\n 846       if (!unique.has(key)) unique.set(key, candidate)\r\n 847     }\r\n 848     if (unique.size > 1) {\r\n 849       issue('寸法列曖昧')\r\n 850       return undefined\r\n 851     }\r\n 852     const selected = [...unique.values()][0]\r\n 853     return {\r\n 854       ...sequence,\r\n 855       direction: [...sequence.letters][0],\r\n 856       spansMm: selected.solution.spans.map((span) => span.valueMm),\r\n 857       scalePtPerMm: selected.solution.scalePtPerMm,\r\n 858       totalConfirmed: true,\r\n 859     }\r\n 860   }\r\n 861 \r\n 862   const scaleValidTotals = fullTotals.filter(\r\n 863     ({ solution }) => solution.scaleValid,\r\n 864   )\r\n 865   if (scaleValidTotals.length === 0) {\r\n 866     issue('縮尺不整合')\r\n 867     return undefined\r\n 868   }\r\n 869 \r\n 870   const maximumSpan = Math.max(\r\n 871     ...scaleValidTotals.flatMap((candidate) =>\r\n 872       candidate.solution.spans.map((span) => span.valueMm),\r\n 873     ),\r\n 874   )\r\n 875   const conflictingTotals = scaleValidTotals.some(({ candidates }) =>\r\n 876     candidates.some(\r\n 877       (candidate) =>\r\n 878         candidate.valueMm >= maximumSpan && candidate.valueMm !== fullTotals[0]?.spanSum,\r\n 879     ),\r\n 880   )\r\n 881   if (conflictingTotals) {\r\n 882     issue('合計不一致')\r\n 883     return undefined\r\n 884   }\r\n 885 \r\n 886   const partials = scaleValidTotals\r\n 887     .map(({ solution }) => partialTotal(sequence, solution, dimensions))\r\n 888     .filter((candidate): candidate is PartialTotal => candidate !== undefined)\r\n 889   if (partials.length > 0) {\r\n 890     const first = partials[0]\r\n 891     const same = partials.every(\r\n 892       (candidate) =>\r\n 893         candidate.firstIndex === first.firstIndex &&\r\n 894         candidate.lastIndex === first.lastIndex &&\r\n 895         candidate.token.valueMm === first.token.valueMm,\r\n 896     )\r\n 897     if (!same) {\r\n 898       issue('寸法列曖昧')\r\n 899       return undefined\r\n 900     }\r\n 901     const solution = scaleValidTotals[0]?.solution\r\n 902     if (!solution) return undefined\r\n 903     return {\r\n 904       ...sequence,\r\n 905       direction: [...sequence.letters][0],\r\n 906       axes: sequence.axes.slice(first.firstIndex, first.lastIndex + 1),\r\n 907       spansMm: solution.spans\r\n 908         .slice(first.firstIndex, first.lastIndex)\r\n 909         .map((span) => span.valueMm),\r\n 910       scalePtPerMm: solution.scalePtPerMm,\r\n 911       totalConfirmed: true,\r\n 912     }\r\n 913   }\r\n 914 \r\n 915   const unique = new Map<string, DimensionSolution>()\r\n 916   for (const solution of scaleValidTotals.map(({ solution }) => solution)) {\r\n 917     const key = solution.spans.map((span) => span.valueMm).join(',')\r\n 918     if (!unique.has(key)) unique.set(key, solution)\r\n 919   }\r\n 920   if (unique.size > 1) {\r\n 921     issue('寸法列曖昧')\r\n 922     return undefined\r\n 923   }\r\n 924   const selected = [...unique.values()][0]\r\n 925 \r\n 926   return {\r\n 927     ...sequence,\r\n 928     direction: [...sequence.letters][0],\r\n 929     spansMm: selected.spans.map((span) => span.valueMm),\r\n 930     scalePtPerMm: selected.scalePtPerMm,\r\n 931     totalConfirmed: false,\r\n 932   }\r\n 933 }\r\n 934 \r\n 935 /**\r\n 936  * 접두가 없는 라벨은 문자열만으로 X·Y를 결정할 수 없다. 같은 페이지의\r\n 937  * 서로 직교한 두 축이 모두 있으면, 두 축의 실측 총 길이가