:   for (let firstIndex = 1; firstIndex < sequence.axes.length - 1; firstIndex++) {\r\n  764:     const covered = solution.spans\r\n  765:       .slice(firstIndex)\r\n  766:       .reduce((sum, span) => sum + span.valueMm, 0)\r\n  767:     const coveredSpans = sequence.axes.length - 1 - firstIndex\r\n  768:     if (coveredSpans < minimumCoveredSpans) continue\r\n  769:     const match = totalCandidates(\r\n  770:       sequence,\r\n  771:       dimensions,\r\n  772:       used,\r\n  773:       firstIndex,\r\n  774:       sequence.axes.length - 1,\r\n  775:     ).find((candidate) => candidate.valueMm === covered)\r\n  776:     if (match) {\r\n  777:       return {\r\n  778:         firstIndex,\r\n  779:         lastIndex: sequence.axes.length - 1,\r\n  780:         token: match,\r\n  781:       }\r\n  782:     }\r\n  783:   }\r\n  784: \r\n  785:   return undefined\r\n  786: }\r\n  787: \r\n  788: function validateSequence(\r\n  789:   sequence: AxisSequence,\r\n  790:   dimensions: DimensionToken[],\r\n  791:   issue: (code: PlanGridIssue) => void,\r\n  792: ): ValidatedSequence | undefined {\r\n  793:   if (sequence.letters.size > 1) {\r\n  794:     issue('?⒲깧?ユ뻼耶쀦렁??)\r\n  795:     return undefined\r\n  796:   }\r\n  797:   const solutions = dimensionSolutions(sequence, dimensions)\r\n  798:   if (solutions.length === 0) {\r\n  799:     const hasEverySpanCandidate = sequence.axes\r\n  800:       .slice(0, -1)\r\n  801:       .every((axis, index) => {\r\n  802:         const midpoint =\r\n  803:           (axis.positionPt + sequence.axes[index + 1].positionPt) / 2\r\n  804:         return (\r\n  805:           dimensionCandidatesAtAcrossOptions(\r\n  806:             dimensions,\r\n  807:             new Set(),\r\n  808:             sequence.alongKey,\r\n  809:             sequence.alongKey === 'y' ? 'x' : 'y',\r\n  810:             midpoint,\r\n  811:             [\r\n  812:               ...(sequence.axisAcrossOptions[index] ?? []),\r\n  813:               ...(sequence.axisAcrossOptions[index + 1] ?? []),\r\n  814:             ],\r\n  815:           ).length > 0\r\n  816:         )\r\n  817:       })\r\n  818:     issue(hasEverySpanCandidate ? '潁?갰訝띷빐?? : '野멩퀡轝좄맼')\r\n  819:     return undefined\r\n  820:   }\r\n  821: \r\n  822:   const fullTotals = solutions.map((solution) => {\r\n  823:     const used = new Set(solution.spans)\r\n  824:     const spanSum = solution.spans.reduce((sum, span) => sum + span.valueMm, 0)\r\n  825:     const candidates =\r\n  826:       sequence.axes.length >= 3\r\n  827:         ? totalCandidates(\r\n  828:             sequence,\r\n  829:             dimensions,\r\n  830:             used,\r\n  831:             0,\r\n  832:             sequence.axes.length - 1,\r\n  833:           )\r\n  834:         : []\r\n  835:     return {\r\n  836:       solution,\r\n  837:       spanSum,\r\n  838:       candidates,\r\n  839:       matching: candidates.some((candidate) => candidate.valueMm === spanSum),\r\n  840:     }\r\n  841:   })\r\n  842:   const matchingTotals = fullTotals.filter((candidate) => candidate.matching)\r\n  843:   if (matchingTotals.length > 0) {\r\n  844:     const unique = new Map<string, (typeof matchingTotals)[number]>()\r\n  845:     for (const candidate of matchingTotals) {\r\n  846:       const key = candidate.solution.spans.map((span) => span.valueMm).join(',')\r\n  847:       if (!unique.has(key)) unique.set(key, candidate)\r\n  848:     }\r\n  849:     if (unique.size > 1) {\r\n  850:       issue('野멩퀡?쀦썣??)\r\n  851:       return undefined\r\n  852:     }\r\n  853:     const selected = [...unique.values()][0]\r\n  854:     return {\r\n  855:       ...sequence,\r\n  856:       direction: [...sequence.letters][0],\r\n  857:       spansMm: selected.solution.spans.map((span) => span.valueMm),\r\n  858:       scalePtPerMm: selected.solution.scalePtPerMm,\r\n  859:       totalConfirmed: true,\r\n  860:     }\r\n  861:   }\r\n  862: \r\n  863:   const scaleValidTotals = fullTotals.filter(\r\n  864:     ({ solution }) => solution.scaleValid,\r\n  865:   )\r\n  866:   if (scaleValidTotals.length === 0) {\r\n  867:     issue('潁?갰訝띷빐??)\r\n  868:     return undefined\r\n  869:   }\r\n  870: \r\n  871:   const maximumSpan = Math.max(\r\n  872:     ...scaleValidTotals.flatMap((candidate) =>\r\n  873:       candidate.solution.spans.map((span) => span.valueMm),\r\n  874:     ),\r\n  875:   )\r\n  876:   const conflictingTotals = scaleValidTotals.some(({ candidates }) =>\r\n  877:     candidates.some(\r\n  878:       (candidate) =>\r\n  879:         candidate.valueMm >= maximumSpan && candidate.valueMm !== fullTotals[0]?.spanSum,\r\n  880:     ),\r\n  881:   )\r\n  882:   if (conflictingTotals) {\r\n  883:     issue('?덅쮫訝띴???)\r\n  884:     return undefined\r\n  885:   }\r\n  886: \r\n  887:   const partials = scaleValidTotals\r\n  888:     .map(({ solution }) => partialTotal(sequence, solution, dimensions))\r\n  889:     .filter((candidate): candidate is PartialTotal => candidate !== undefined)\r\n  890:   if (partials.length > 0) {\r\n  891:     const first = partials[0]\r\n  892:     const same = partials.every(\r\n  893:       (candidate) =>\r\n  894:         candidate.firstIndex === first.firstIndex &&\r\n  895:         candidate.lastIndex === first.lastIndex &&\r\n  896:         candidate.token.valueMm === first.token.valueMm,\r\n  897:     )\r\n  898:     if (!same) {\r\n  899:       issue('野멩퀡?쀦썣??)\r\n  900:       return undefined\r\n  901:     }\r\n  902:     const solution = scaleValidTotals[0]?.solution\r\n  903:     if (!solution) return undefined\r\n  904:     return {\r\n  905:       ...sequence,\r\n  906:       direction: [...sequence.letters][0],\r\n  907:       axes: sequence.axes.slice(first.firstIndex, first.lastIndex + 1),\r\n  908:       spansMm: solution.spans\r\n  909:         .slice(first.firstIndex, first.lastIndex)\r\n  910:         .map((span) => span.valueMm),\r\n  911:       scalePtPerMm: solution.scalePtPerMm,\r\n  912:       totalConfirmed: true,\r\n  913:     }\r\n  914:   }\r\n  915: \r\n  916:   const unique = new Map<string, DimensionSolution>()\r\n  917:   for (const solution of scaleValidTotals.map(({ solution }) => solution)) {\r\n  918:     const key = solution.spans.map((span) => span.valueMm).join(',')\r\n  919:     if (!unique.has(key)) unique.set(key, solution)\r\n  920:   }\r\n  921:   if (unique.size > 1) {\r\n  922:     issue('野멩퀡?쀦썣??)\r\n  923:     return undefined\r\n  924:   }\r\n  925:   const selected = [...unique.values()][0]\r\n  926: \r\n  927:   return {\r\n  928:     ...sequence,\r\n  929:     direction: [...sequence.letters][0],\r\n  930:     spansMm: selected.spans.map((span) => span.valueMm),\r\n  931:     scalePtPerMm: selected.scalePtPerMm,\r\n  932:     totalConfirmed: false,\r\n  933:   }\r\n  934: }\r\n  935: \r\n  936: function dimensionCandidatesAtAcrossOptions(\r\n  937:   dimensions: DimensionToken[],\r\n  938:   used: Set<DimensionToken>,\r\n  939:   along: 'x' | 'y',\r\n  940:   across: 'x' | 'y',\r\n  941:   midpoint: number,\r\n  942:   acrossOptions: number[],\r\n  943: ): DimensionToken[] {\r\n  944:   const candidates = new Map<DimensionToken, number>()\r\n  945:   for (const bandAcross of acrossOptions) {\r\n  946:     for (const candidate of dimensionCandidatesAt(\r\n  947:       dimensions,\r\n  948:       used,\r\n  949:       along,\r\n  950:       across,\r\n  951:       midpoint,\r\n  952:       bandAcross,\r\n  953:     )) {\r\n  954:       const distance = Math.abs(candidate[along] - midpoint)\r\n  955:       const previous = candidates.get(candidate)\r\n  956:       if (previous === undefined || distance < previous) {\r\n  957:         candidates.set(candidate, distance)\r\n  958:       }\r\n  959:     }\r\n  960:   }\r\n  961:   return [...candidates.entries()]\r\n  962:     .sort((left, right) => left[1] - right[1])\r\n  963:     .map(([candidate]) => candidate)\r\n  964: }\r\n  965: \r\n  966: /**\r\n  967:  * ?묐몢媛 ?녿뒗 ?쇰꺼?