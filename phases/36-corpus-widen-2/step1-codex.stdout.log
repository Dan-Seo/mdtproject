{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$OutputEncoding = [Console]::OutputEncoding = [Text.UTF8Encoding]::new(); $i=0; Get-Content -Encoding utf8 src/lib/import/framing-plan/parse.ts | ForEach-Object { $i++; if ($i -ge 590 -and $i -le 950) { '\"'{0,4} {1}' -f \"'$i,$_ } }'","aggregated_output":" 590   }\r\n 591 \r\n 592   return merged\r\n 593 }\r\n 594 \r\n 595 /** 인접 축 쌍의 중점에서, 라벨 밴드의 치수 창 안에 있는 치수를 모은다 */\r\n 596 function dimensionCandidatesAt(\r\n 597   dimensions: DimensionToken[],\r\n 598   used: Set<DimensionToken>,\r\n 599   along: 'x' | 'y',\r\n 600   across: 'x' | 'y',\r\n 601   midpoint: number,\r\n 602   bandAcross: number,\r\n 603 ): DimensionToken[] {\r\n 604   return dimensions\r\n 605     .filter((token) => {\r\n 606       if (used.has(token)) return false\r\n 607     const alongDistance = Math.abs(token[along] - midpoint)\r\n 608       return (\r\n 609         alongDistance <= MIDPOINT_TOLERANCE_PT &&\r\n 610         Math.abs(token[across] - bandAcross) <= DIMENSION_WINDOW_PT\r\n 611       )\r\n 612     })\r\n 613     .sort(\r\n 614       (left, right) =>\r\n 615         Math.abs(left[along] - midpoint) - Math.abs(right[along] - midpoint),\r\n 616     )\r\n 617 }\r\n 618 \r\n 619 function median(values: number[]): number {\r\n 620   return [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\r\n 621 }\r\n 622 \r\n 623 interface DimensionSolution {\r\n 624   spans: DimensionToken[]\r\n 625   scalePtPerMm: number\r\n 626   scaleValid: boolean\r\n 627 }\r\n 628 \r\n 629 /**\r\n 630  * 같은 중점에 여러 치수 열이 놓인 경우를 최근접 하나로 자르지 않는다. 각\r\n 631  * 조합을 축척 검증까지 통과시킨 뒤, 값 배열이 하나로 수렴할 때만 후보를\r\n 632  * 만든다. 이로써 Fuji의 벽면 열과 스팬 열을 구별하고, Hirosaki의 전체\r\n 633  * 치수가 한 인접 중점과 겹치는 경우에도 전체 치수를 스팬으로 소비하지 않는다.\r\n 634  */\r\n 635 function dimensionSolutions(\r\n 636   sequence: AxisSequence,\r\n 637   dimensions: DimensionToken[],\r\n 638 ): DimensionSolution[] {\r\n 639   const choices: DimensionToken[][] = []\r\n 640   for (let i = 0; i + 1 < sequence.axes.length; i++) {\r\n 641     const midpoint =\r\n 642       (sequence.axes[i].positionPt + sequence.axes[i + 1].positionPt) / 2\r\n 643     const candidates = dimensionCandidatesAt(\r\n 644       dimensions,\r\n 645       new Set(),\r\n 646       sequence.alongKey,\r\n 647       sequence.alongKey === 'y' ? 'x' : 'y',\r\n 648       midpoint,\r\n 649       sequence.axisAcross[i] ?? sequence.across,\r\n 650     )\r\n 651     if (candidates.length === 0) return []\r\n 652     choices.push(candidates)\r\n 653   }\r\n 654 \r\n 655   const solutions: DimensionSolution[] = []\r\n 656   const selected: DimensionToken[] = []\r\n 657   const used = new Set<DimensionToken>()\r\n 658 \r\n 659   const visit = (index: number) => {\r\n 660     if (solutions.length >= 4096) return\r\n 661     if (index === choices.length) {\r\n 662       const scales = selected.map(\r\n 663         (span, i) =>\r\n 664           (sequence.axes[i + 1].positionPt - sequence.axes[i].positionPt) /\r\n 665           span.valueMm,\r\n 666       )\r\n 667       const medianScale = median(scales)\r\n 668       solutions.push({\r\n 669         spans: [...selected],\r\n 670         scalePtPerMm: medianScale,\r\n 671         scaleValid: !scales.some(\r\n 672           (scale) => Math.abs(scale / medianScale - 1) > SCALE_TOLERANCE_RATIO,\r\n 673         ),\r\n 674       })\r\n 675       return\r\n 676     }\r\n 677 \r\n 678     for (const candidate of choices[index]) {\r\n 679       if (used.has(candidate)) continue\r\n 680       used.add(candidate)\r\n 681       selected.push(candidate)\r\n 682       visit(index + 1)\r\n 683       selected.pop()\r\n 684       used.delete(candidate)\r\n 685       if (solutions.length >= 4096) return\r\n 686     }\r\n 687   }\r\n 688 \r\n 689   visit(0)\r\n 690   if (process.env.DEBUG_PARSE === '1') {\r\n 691     console.error(\r\n 692       'solutions',\r\n 693       sequence.axes.map((axis) => axis.label).join(','),\r\n 694       solutions.map((solution) => ({\r\n 695         spans: solution.spans.map((span) => span.valueMm),\r\n 696         scaleValid: solution.scaleValid,\r\n 697       })),\r\n 698     )\r\n 699   }\r\n 700   const unique = new Map<string, DimensionSolution>()\r\n 701   for (const solution of solutions) {\r\n 702     const key = solution.spans.map((span) => span.valueMm).join(',')\r\n 703     if (!unique.has(key)) unique.set(key, solution)\r\n 704   }\r\n 705   return [...unique.values()]\r\n 706 }\r\n 707 \r\n 708 function totalCandidates(\r\n 709   sequence: AxisSequence,\r\n 710   dimensions: DimensionToken[],\r\n 711   used: Set<DimensionToken>,\r\n 712   firstIndex: number,\r\n 713   lastIndex: number,\r\n 714 ): DimensionToken[] {\r\n 715   const midpoint =\r\n 716     (sequence.axes[firstIndex].positionPt +\r\n 717       sequence.axes[lastIndex].positionPt) /\r\n 718     2\r\n 719   return dimensionCandidatesAt(\r\n 720     dimensions,\r\n 721     used,\r\n 722     sequence.alongKey,\r\n 723     sequence.alongKey === 'y' ? 'x' : 'y',\r\n 724     midpoint,\r\n 725     sequence.axisAcross[firstIndex] ?? sequence.across,\r\n 726   )\r\n 727 }\r\n 728 \r\n 729 interface PartialTotal {\r\n 730   firstIndex: number\r\n 731   lastIndex: number\r\n 732   token: DimensionToken\r\n 733 }\r\n 734 \r\n 735 /**\r\n 736  * Shibata처럼 축의 뒤쪽에 미확정 축이 남은 경우에만 부분 합을 쓴다. 전체\r\n 737  * 축에서 두 축 이상 벗어난 작은 부분합(예: Karatsu의 4,010·4,165)은\r\n 738  * 합계의 증거가 아니므로 무시한다. 앞·뒤 중 하나에서 시작하는 연속 구간만\r\n 739  * 살피며, 내부 구간은 부분합과 축을 혼동하기 쉽기 때문에 쓰지 않는다.\r\n 740  */\r\n 741 function partialTotal(\r\n 742   sequence: AxisSequence,\r\n 743   solution: DimensionSolution,\r\n 744   dimensions: DimensionToken[],\r\n 745 ): PartialTotal | undefined {\r\n 746   const spanCount = solution.spans.length\r\n 747   const minimumCoveredSpans = Math.max(1, spanCount - 2)\r\n 748   const used = new Set(solution.spans)\r\n 749 \r\n 750   for (let lastIndex = sequence.axes.length - 2; lastIndex >= 1; lastIndex--) {\r\n 751     const covered = solution.spans\r\n 752       .slice(0, lastIndex)\r\n 753       .reduce((sum, span) => sum + span.valueMm, 0)\r\n 754     if (lastIndex < minimumCoveredSpans) continue\r\n 755     const match = totalCandidates(\r\n 756       sequence,\r\n 757       dimensions,\r\n 758       used,\r\n 759       0,\r\n 760       lastIndex,\r\n 761     ).find((candidate) => candidate.valueMm === covered)\r\n 762     if (match) return { firstIndex: 0, lastIndex, token: match }\r\n 763   }\r\n 764 \r\n 765   for (let firstIndex = 1; firstIndex < sequence.axes.length - 1; firstIndex++) {\r\n 766     const covered = solution.spans\r\n 767       .slice(firstIndex)\r\n 768       .reduce((sum, span) => sum + span.valueMm, 0)\r\n 769     const coveredSpans = sequence.axes.length - 1 - firstIndex\r\n 770     if (coveredSpans < minimumCoveredSpans) continue\r\n 771     const match = totalCandidates(\r\n 772       sequence,\r\n 773       dimensions,\r\n 774       used,\r\n 775       firstIndex,\r\n 776       sequence.axes.length - 1,\r\n 777     ).find((candidate) => candidate.valueMm === covered)\r\n 778     if (match) {\r\n 779       return {\r\n 780         firstIndex,\r\n 781         lastIndex: sequence.axes.length - 1,\r\n 782         token: match,\r\n 783       }\r\n 784     }\r\n 785   }\r\n 786 \r\n 787   return undefined\r\n 788 }\r\n 789 \r\n 790 function validateSequence(\r\n 791   sequence: AxisSequence,\r\n 792   dimensions: DimensionToken[],\r\n 793   issue: (code: PlanGridIssue) => void,\r\n 794 ): ValidatedSequence | undefined {\r\n 795   if (sequence.letters.size > 1) {\r\n 796     issue('ラベル文字混在')\r\n 797     return undefined\r\n 798   }\r\n 799   const solutions = dimensionSolutions(sequence, dimensions)\r\n 800   if (solutions.length === 0) {\r\n 801     const hasEverySpanCandidate = sequence.axes\r\n 802       .slice(0, -1)\r\n 803       .every((axis, index) => {\r\n 804         const midpoint =\r\n 805           (axis.positionPt + sequence.axes[index + 1].positionPt) / 2\r\n 806         return (\r\n 807           dimensionCandidatesAt(\r\n 808             dimensions,\r\n 809             new Set(),\r\n 810             sequence.alongKey,\r\n 811             sequence.alongKey === 'y' ? 'x' : 'y',\r\n 812             midpoint,\r\n 813             sequence.across,\r\n 814           ).length > 0\r\n 815         )\r\n 816       })\r\n 817     issue(hasEverySpanCandidate ? '縮尺不整合' : '寸法欠落')\r\n 818     return undefined\r\n 819   }\r\n 820 \r\n 821   const fullTotals = solutions.map((solution) => {\r\n 822     const used = new Set(solution.spans)\r\n 823     const spanSum = solution.spans.reduce((sum, span) => sum + span.valueMm, 0)\r\n 824     const candidates =\r\n 825       sequence.axes.length >= 3\r\n 826         ? totalCandidates(\r\n 827             sequence,\r\n 828             dimensions,\r\n 829             used,\r\n 830             0,\r\n 831             sequence.axes.length - 1,\r\n 832           )\r\n 833         : []\r\n 834     return {\r\n 835       solution,\r\n 836       spanSum,\r\n 837       candidates,\r\n 838       matching: candidates.some((candidate) => candidate.valueMm === spanSum),\r\n 839     }\r\n 840   })\r\n 841   const matchingTotals = fullTotals.filter((candidate) => candidate.matching)\r\n 842   if (matchingTotals.length > 0) {\r\n 843     const unique = new Map<string, (typeof matchingTotals)[number]>()\r\n 844     for (const candidate of matchingTotals) {\r\n 845       const key = candidate.solution.spans.map((span) => span.valueMm).join(',')\r\n 846       if (!unique.has(key)) unique.set(key, candidate)\r\n 847     }\r\n 848     if (unique.size > 1) {\r\n 849       issue('寸法列曖昧')\r\n 850       return undefined\r\n 851     }\r\n 852     const selected = [...unique.values()][0]\r\n 853     return {\r\n 854       ...sequence,\r\n 855       direction: [...sequence.letters][0],\r\n 856       spansMm: selected.solut