      \"totalMm\": 6650\n      },\n      \"y\": {\n        \"labels\": [\n          \"1\",\n          \"2\"\n        ],\n        \"spansMm\": [\n          5150\n        ],\n        \"totalMm\": null\n      },\n      \"notes\": [\n        \"屋根 블록은 C·B·A 세 축만 있다\"\n      ]\n    }\n  ],\n  \"notes\": [\n    \"축 라벨이 X·Y 접두 없는 라틴 대문자(E〜A)와 숫자(1·2)다. 블록 제목 원문은 확정하지 못했다\",\n    \"pdf.js CMap 없이는 텍스트 0건. 페이지 /Rotate 90\"\n  ]\n}\n\r\n--- hirosaki-kikyono-p21-grid.json\r\n{\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 150dpi 렌더링 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다. 스팬은 라벨 순서대로 인접 라벨 사이 mm이고 totalMm은 도면에 적힌 合計(없으면 null)다.\",\n  \"source\": {\n    \"cacheFile\": \"dwg-hirosaki-kikyono.pdf\",\n    \"sha256\": \"f4dfcfab190970d8df305ce53319b98efb17873b81e77462b112a89978135fa8\",\n    \"issuer\": \"青森県弘前市\",\n    \"project\": \"令和7年度 桔梗野小学校等複合施設新築工事(建築工事) 構造図1\",\n    \"sheet\": \"S-019 1階床梁伏図\",\n    \"page\": 21,\n    \"transcribedAt\": \"2026-09-03\"\n  },\n  \"blocks\": [\n    {\n      \"title\": \"1階床梁伏図\",\n      \"x\": {\n        \"labels\": [\n          \"X1\",\n          \"X2\",\n          \"X3\",\n          \"X4\",\n          \"X5\",\n          \"X6\",\n          \"X7\",\n          \"X8\",\n          \"X9\",\n          \"X10\",\n          \"X11\",\n          \"X12\"\n        ],\n        \"spansMm\": [\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          8000\n        ],\n        \"totalMm\": 88000\n      },\n      \"y\": {\n        \"labels\": [\n          \"Y1\",\n          \"Y2\",\n          \"Y3\",\n          \"Y4\",\n          \"Y5\",\n          \"Y6\",\n          \"Y7\",\n          \"Y8\",\n          \"Y9\",\n          \"Y10\"\n        ],\n        \"spansMm\": [\n          8000,\n          8000,\n          8000,\n          8000,\n          8000,\n          11000,\n          8000,\n          8000,\n          8000\n        ],\n        