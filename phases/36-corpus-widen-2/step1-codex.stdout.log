Number.POSITIVE_INFINITY\r\n1135   let max = Number.NEGATIVE_INFINITY\r\n1136   for (const axis of axes) {\r\n1137     if (axis.positionPt < min) min = axis.positionPt\r\n1138     if (axis.positionPt > max) max = axis.positionPt\r\n1139   }\r\n1140   return { min, max }\r\n1141 }\r\n1142 \r\n1143 /** 점에서 구간까지의 거리. 구간 안이면 0 */\r\n1144 function distanceToRange(value: number, min: number, max: number): number {\r\n1145   if (value < min) return min - value\r\n1146   if (value > max) return value - max\r\n1147   return 0\r\n1148 }\r\n1149 \r\n1150 /**\r\n1151  * 부호가 붙는 자리를 만든다 — 격자점과 그 사이 중점이 번갈아 놓인 눈금이다.\r\n1152  * 짝수 index가 격자점(index/2), 홀수가 중점(사이 (index-1)/2).\r\n1153  */\r\n1154 function snapTargets(axes: AxisCandidate[]): number[] {\r\n1155   const targets: number[] = []\r\n1156   for (let i = 0; i < axes.length; i++) {\r\n1157     targets.push(axes[i].positionPt)\r\n1158     if (i + 1 < axes.length) {\r\n1159       targets.push((axes[i].positionPt + axes[i + 1].positionPt) / 2)\r\n1160     }\r\n1161   }\r\n1162   return targets\r\n1163 }\r\n1164 \r\n1165 function spanLengths(axes: AxisCandidate[]): number[] {\r\n1166   return axes\r\n1167     .slice(1)\r\n1168     .map((axis, i) => Math.abs(axis.positionPt - axes[i].positionPt))\r\n1169 }\r\n1170 \r\n1171 interface Snap {\r\n1172   index: number\r\n1173   onNode: boolean\r\n1174 }\r\n1175 \r\n1176 function snap(\r\n1177   value: number,\r\n1178   axes: AxisCandidate[],\r\n1179   limit: number,\r\n1180 ): Snap | undefined {\r\n1181   const targets = snapTargets(axes)\r\n1182   let best = -1\r\n1183   let bestDistance = Number.POSITIVE_INFINITY\r\n1184   for (let i = 0; i < targets.length; i++) {\r\n1185     const distance = Math.abs(targets[i] - value)\r\n1186     if (distance < bestDistance) {\r\n1187       best = i\r\n1188       bestDistance = distance\r\n1189     }\r\n1190   }\r\n1191   if (best < 0 || bestDistance > limit) return undefined\r\n1192   return { index: best >> 1, onNode: best % 2 === 0 }\r\n1193 }\r\n1194 \r\n1195 function placementFor(\r\n1196   mark: string,\r\n1197   x: Snap,\r\n1198   y: Snap,\r\n1199 ): MemberPlacement {\r\n1200   if (x.onNode && y.onNode) {\r\n1201     return { mark, role: '格子点', ix: x.index, iy: y.index }\r\n1202   }\r\n1203   if (!x.onNode && y.onNode) {\r\n1204     return { mark, role: '辺', ix: x.index, iy: y.index, axis: 'X' }\r\n1205   }\r\n1206   if (x.onNode && !y.onNode) {\r\n1207     return { mark, role: '辺', ix: x.index, iy: y.index, axis: 'Y' }\r\n1208   }\r\n1209   return { mark, role: 'ベイ', ix: x.index, iy: y.index }\r\n1210 }\r\n1211 \r\n1212 function gridCandidate(sequence: DirectedSequence): PlanGridCandidate {\r\n1213   return {\r\n1214     direction: sequence.direction,\r\n1215     axes: sequence.axes,\r\n1216     spansMm: sequence.spansMm,\r\n1217     scalePtPerMm: sequence.scalePtPerMm,\r\n1218     totalConfirmed: sequence.totalConfirmed,\r\n1219   }\r\n1220 }\r\n1221 \r\n1222 /**\r\n1223  * 블록을 짓는다 — X 열 하나와 **가장 가까운** Y 열 하나를 짝짓는다.\r\n1224  *\r\n1225  * 고정 여백으로 「포함」을 판정하지 않는 이유: 라벨은 도면 바깥에 놓이므로\r\n1226  * 여백이 필요한데(실물 156pt), 그 여백을 넓히면 옆 블록의 열까지 삼킨다.\r\n1227  * 최근접은 그 사이를 재지 않고도 옳은 짝을 고른다.\r\n1228  *\r\n1229  * 같은 블록의 위·아래 라벨 띠는 축 위치가 같으므로 그 자리에서 하나로 접힌다.\r\n1230  */\r\n1231 function buildBlocks(\r\n1232   xSequences: DirectedSequence[],\r\n1233   ySequences: DirectedSequence[],\r\n1234   marks: PositionedToken[],\r\n1235   titles: PositionedToken[],\r\n1236   issue: (code: PlanGridIssue) => void,\r\n1237 ): PlanBlock[] {\r\n1238   const blocks: PlanBlock[] = []\r\n1239   if (xSequences.length === 0 || ySequences.length === 0) return blocks\r\n1240 \r\n1241   const seen = new Set<string>()\r\n1242   const claimedY = new Map<ValidatedSequence, string>()\r\n1243   const enforceUniqueY = ySequences.length > 1\r\n1244 \r\n1245   for (const xSequence of xSequences) {\r\n1246     const sequenceExtent = extent(xSequence.axes)\r\n1247     const xKey = xSequence.axes\r\n1248       .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\r\n1249       .join(',')\r\n1250     const pairingLimit =\r\n1251       median(spanLengths(xSequence.axes)) * GRID_PAIRING_DISTANCE_RATIO\r\n1252     let paired: DirectedSequence | undefined\r\n1253     let pairedDistance = Number.POSITIVE_INFINITY\r\n1254     let tied = false\r\n1255     for (const ySequence of ySequences) {\r\n1256       const claimedBy = claimedY.get(ySequence)\r\n1257       if (enforceUniqueY && claimedBy !== undefined && claimedBy !== xKey) {\r\n1258         continue\r\n1259       }\r\n1260       const distance = distanceToRange(\r\n1261         ySequence.across,\r\n1262         sequenceExtent.min,\r\n1263         sequenceExtent.max,\r\n1264       )\r\n1265       if (distance < pairedDistance) {\r\n1266         paired = ySequence\r\n1267         pairedDistance = distance\r\n1268         tied = false\r\n1269       } else if (distance === pairedDistance) {\r\n1270         tied = true\r\n1271       }\r\n1272     }\r\n1273     if (!paired || tied || pairedDistance > pairingLimit) {\r\n1274       issue('通り芯対応不明')\r\n1275       continue\r\n1276     }\r\n1277     if (enforceUniqueY) claimedY.set(paired, xKey)\r\n1278 \r\n1279     const xGrid = gridCandidate(xSequence)\r\n1280     const yGrid = gridCandidate(paired)\r\n1281     const xAxes = xSequence.alongKey === 'x' ? xGrid.axes : yGrid.axes\r\n1282     const yAxes = xSequence.alongKey === 'y' ? xGrid.axes : yGrid.axes\r\n1283     const xExtent = extent(xAxes)\r\n1284     const yExtent = extent(yAxes)\r\n1285     const key = [xAxes, yAxes]\r\n1286       .map((axes) =>\r\n1287         axes\r\n1288           .map((axis) => `${axis.label}@${Math.round(axis.positionPt)}`)\r\n1289           .join(','),\r\n1290       )\r\n1291       .join('|')\r\n1292     if (seen.has(key)) continue\r\n1293     seen.add(key)\r\n1294 \r\n1295     const xLimit = median(spanLengths(xAxes)) * SNAP_RATIO\r\n1296     const yLimit = median(spanLengths(yAxes)) * SNAP_RATIO\r\n1297 \r\n1298     const placements: MemberPlacement[] = []\r\n1299     const unplacedMarks: string[] = []\r\n1300     for (const mark of marks) {\r\n1301       // 블록 밖의 부호는 아예 보지 않는다 — 같은 페이지의 断面リスト가 섞인다.\r\n1302       // 판정 여백을 스냅 허용과 같게 두어, 「블록 안인데 못 붙였다」와\r\n1303       // 「블록 밖이다」가 같은 자로 갈리게 한다\r\n1304       if (distanceToRange(mark.x, xExtent.min, xExtent.max) > xLimit) continue\r\n1305       if (distanceToRange(mark.y, yExtent.min, yExtent.max) > yLimit) continue\r\n1306 \r\n1307       const x = snap(mark.x, xAxes, xLimit)\r\n1308       const y = snap(mark.y, yAxes, yLimit)\r\n1309       if (!x || !y) {\r\n1310         if (!unplacedMarks.includes(mark.text)) unplacedMarks.push(mark.text)\r\n1311         continue\r\n1312       }\r\n1313       placements.push(placementFor(mark.text, x, y))\r\n1314     }\r\n1315 \r\n1316     // 제목은 블록의 가로 범위 안에 있는 것만 본다 — 나란히 선 두 伏図에서\r\n1317     // 세로 거리만으로 고르면 옆 블록의 제목이 붙는다\r\n1318     let title: string | undefined\r\n1319     let titleDistance = Number.POSITIVE_INFINITY\r\n1320     for (const candidate of titles) {\r\n1321       if (distanceToRange(candidate.x, xExtent.min, xExtent.max) > 0) continue\r\n1322       const distance = distanceToRange(candidate.y, yExtent.min, yExtent.max)\r\n1323       if (distance < titleDistance) {\r\n1324         title = candidate.text\r\n1325         titleDistance = distance\r\n1326       }\r\n1327     }\r\n1328 \r\n1329     blocks.push({\r\n1330       ...(title === undefined ? {} : { title }),\r\n1331       xGrid,\r\n1332       yGrid,\r\n1333       placements,\r\n1334       unplacedMarks,\r\n1335     })\r\n1336   }\r\n1337 \r\n1338   return blocks.sort(\r\n1339     (a, b) =>\r\n1340       extent(a.xGrid.axes).min - extent(b.xGrid.axes).min ||\r\n1341       extent(a.yGrid.axes).min - extent(b.yGrid.axes).min,\r\n1342   )\r\n1343 }\r\n1344 \r\n1345 export function parseFramingPlan(page: TextPage): ParsedFramingPlan {\r\n1346   const { labels, dimensions, marks, titles } = collectTokens(page)\r\n1347 \r\n1348   const issues: PlanGridIssue[] = []\r\n1349   const issue = (code: PlanGridIssue) => {\r\n1350     if (!issues.includes(code)) issues.push(code)\r\n1351   }\r\n1352 \r\n1353   if (labels.length === 0) {\r\n1354     return { grids: [], blocks: [], issues: ['通り芯ラベル未検出'] }\r\n1355   }\r\n1356 \r\n1357   // 라벨 문자열이 가로로 놓여도 밴드(축의 늘어선 방향)는 세로일 수 있다 —\r\n1358   // 두 방향 다 묶어 보고, 검증(중점 치수·축척)이 가짜 밴드를 걸러낸다.\r\n1359   const rawSequences = [\r\n1360     ...axisSequences(labels, 'x'),\r\n1361     ...axisSequences(labels, 'y'),\r\n1362   ]\r\n1363   if (process.env.DEBUG_PARSE === '1') {\r\n1364     console.error(\r\n1365       'raw',\r\n1366       JSON.stringify(\r\n1367         rawSequences.map((sequence) => ({\r\n1368           alongKey: sequence.alongKey,\r\n1369           axes: sequence.axes,\r\n1370           across: sequence.across,\r\n1371         })),\r\n1372       ),\r\n1373     )\r\n1374   }\r\n1375   const validated = rawSequences.flatMap((sequence) => {\r\n1376     const result = validateSequence(sequence, dimensions, issue)\r\n1377     if (process.env.DEBUG_PARSE === '1') {\r\n1378       console.error(\r\n1379         'validated',\r\n1380         sequence.axes.map((axis) => axis.label).join(','),\r\n1381         result?.spansMm,\r\n1382       )\r\n1383     }\r\n1384     return result ? [result] : []\r\n1385   })\r\n1386   const directed = normalizeAxisOrientation(\r\n1387     suppressIntermediateSequences(directSequences(validated)),\r\n1388     labels,\r\n1389   )\r\n1390   if (process.env.DEBUG_PARSE === '1') {\r\n1391     console.error(\r\n1392       JSON.stringify(directed.map((sequence) => ({\r\n1393         direction: sequence.direction,\r\n1394         alongKey: sequence.alongKey,\r\n1395         axes: sequence.axes.map((axis) => ({\r\n1396           label: axis.label,\r\n1397           positionPt: axis.positionPt,\r\n1398         })),\r\n1399         spans: sequence.spansMm,\r\n1400         total: sequence.totalConfirmed,\r\n1401       }))),\r\n1402     )\r\n1403   }\r\n1404 \r\n1405   const grids: PlanGridCandidate[] = []\r\n1406   const seen = new Set<string>()\r\n1407   for (const sequence of directed) {\r\n1408     const candidate = gridCandidate(sequence)\r\n1409     const key = [\r\n1410       candidate.direction,\r\n1411       candidate.axes.map((axis) => axis.label).join(','),\r\n1412       candidate.spansMm.join(','),\r\n1413     ].join('|')\r\n1414     if (seen.has(key)) continue\r\n1415     seen.add(key)\r\n1416     grids.push(candidate)\r\n1417   }\r\n1418   grids.sort(\r\n1419     (a, b) =>\r\n1420       a.direction.localeCompare(b.direction) ||\r\n1421       a.axes[0].positionPt - b.axes[0].positionPt,\r\n1422   )\r\n1423 \r\n1424   const blocks = buildBlocks(\r\n1425     directed.filter((sequence) => sequence.direction === 'X'),\r\n1426     directed.filter((sequence) => sequence.direction === 'Y'),\r\n1427     marks,\r\n1428     titles,\r\n1429     issue,\r\n1430   )\r\n1431   if (process.env.DEBUG_PARSE === '1') {\r\n1432     console.error('result', JSON.stringify({ blocks, issues }))\r\n1433   }\r\n1434 \r\n1435   return { grids, blocks, issues }\r\n1436 }\r\n","exit_code":0,"status":"completed"}}
