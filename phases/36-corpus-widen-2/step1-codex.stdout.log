\r\n  658:       const scales = selected.map(\r\n  659:         (span, i) =>\r\n  660:           (sequence.axes[i + 1].positionPt - sequence.axes[i].positionPt) /\r\n  661:           span.valueMm,\r\n  662:       )\r\n  663:       const medianScale = median(scales)\r\n  664:       solutions.push({\r\n  665:         spans: [...selected],\r\n  666:         scalePtPerMm: medianScale,\r\n  667:         scaleValid: !scales.some(\r\n  668:           (scale) => Math.abs(scale / medianScale - 1) > SCALE_TOLERANCE_RATIO,\r\n  669:         ),\r\n  670:       })\r\n  671:       return\r\n  672:     }\r\n  673: \r\n  674:     for (const candidate of choices[index]) {\r\n  675:       if (used.has(candidate)) continue\r\n  676:       used.add(candidate)\r\n  677:       selected.push(candidate)\r\n  678:       visit(index + 1)\r\n  679:       selected.pop()\r\n  680:       used.delete(candidate)\r\n  681:       if (solutions.length >= 4096) return\r\n  682:     }\r\n  683:   }\r\n  684: \r\n  685:   visit(0)\r\n  686:   if (process.env.DEBUG_PARSE === '1') {\r\n  687:     console.error(\r\n  688:       'solutions',\r\n  689:       sequence.axes.map((axis) => axis.label).join(','),\r\n  690:       solutions.map((solution) => ({\r\n  691:         spans: solution.spans.map((span) => span.valueMm),\r\n  692:         scaleValid: solution.scaleValid,\r\n  693:       })),\r\n  694:     )\r\n  695:   }\r\n  696:   const unique = new Map<string, DimensionSolution>()\r\n  697:   for (const solution of solutions) {\r\n  698:     const key = solution.spans.map((span) => span.valueMm).join(',')\r\n  699:     if (!unique.has(key)) unique.set(key, solution)\r\n  700:   }\r\n  701:   return [...unique.values()]\r\n  702: }\r\n  703: \r\n  704: function totalCandidates(\r\n  705:   sequence: AxisSequence,\r\n  706:   dimensions: DimensionToken[],\r\n  707:   used: Set<DimensionToken>,\r\n  708:   firstIndex: number,\r\n  709:   lastIndex: number,\r\n  710: ): DimensionToken[] {\r\n  711:   const m