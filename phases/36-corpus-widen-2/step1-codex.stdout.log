     }\r\n  284: \r\n  285:     for (const run of ordered) {\r\n  286:       const previous = current.at(-1)\r\n  287:       const gap = previous ? previous.y - run.y : Number.POSITIVE_INFINITY\r\n  288:       const adjacent =\r\n  289:         previous !== undefined &&\r\n  290:         previous.text.length === 1 &&\r\n  291:         run.text.length === 1 &&\r\n  292:         gap <= baseGap * VERTICAL_RUN_GAP_RATIO\r\n  293:       if (!adjacent) flush()\r\n  294:       current.push(run)\r\n  295:     }\r\n  296:     flush()\r\n  297:   }\r\n  298: \r\n  299:   return merged\r\n  300: }\r\n  301: \r\n  302: function collectTokens(page: TextPage): CollectedTokens {\r\n  303:   const labels: LabelToken[] = []\r\n  304:   const dimensions: DimensionToken[] = []\r\n  305:   const marks: PositionedToken[] = []\r\n  306:   const titles: PositionedToken[] = []\r\n  307: \r\n  308:   const classify = (text: string, x: number, y: number) => {\r\n  309:     const normalizedText = compact(text)\r\n  310:     if (\r\n  311:       DIMENSION_PATTERN.test(normalizedText) &&\r\n  312:       !SIMPLE_AXIS_LABEL_PATTERN.test(normalizedText)\r\n  313:     ) {\r\n  314:       dimensions.push({\r\n  315:         valueMm: Number.parseInt(normalizedText.replaceAll(',', ''), 10),\r\n  316:         x,\r\n  317:         y,\r\n  318:       })\r\n  319:       return\r\n  320:     }\r\n  321:     if (MARK_PATTERN.test(normalizedText)) {\r\n  322:       marks.push({ text: normalizedText, x, y })\r\n  323:       return\r\n  324:     }\r\n  325:     if (BLOCK_TITLE_PATTERN.test(normalizedText)) {\r\n  326:       titles.push({ text: normalizedText, x, y })\r\n  327:     }\r\n  328:   }\r\n  329: \r\n  330:   for (const row of recoverRows(page.items)) {\r\n  331:     for (const segment of row.segments) {\r\n  332:       labels.push(...splitAxisLabels(segment, row.y, row.segments))\r\n  333:       classify(segment.compact, segment.centerX, row.y)\r\n  334:     }\r\n  335:   }\r\n  336: \r\n  337:   //