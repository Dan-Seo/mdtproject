 ),\r\n 1006:   )\r\n 1007:   if (hasPairedParallelAxes) {\r\n 1008:     return [\r\n 1009:       ...directed,\r\n 1010:       ...undirected.map((sequence) => ({\r\n 1011:         ...sequence,\r\n 1012:         direction: (sequence.simpleKinds.has('numeric') ? 'X' : 'Y') as\r\n 1013:           | 'X'\r\n 1014:           | 'Y',\r\n 1015:       })),\r\n 1016:     ]\r\n 1017:   }\r\n 1018: \r\n 1019:   if (alongX.length > 0 && alongY.length > 0) {\r\n 1020:     const sum = (sequence: ValidatedSequence) =>\r\n 1021:       sequence.spansMm.reduce((total, span) => total + span, 0)\r\n 1022:     const xLength = median(alongX.map(sum))\r\n 1023:     const yLength = median(alongY.map(sum))\r\n 1024:     const xAlong: 'x' | 'y' = xLength >= yLength ? 'x' : 'y'\r\n 1025:     return [\r\n 1026:       ...directed,\r\n 1027:       ...undirected.map((sequence) => ({\r\n 1028:         ...sequence,\r\n 1029:         direction: (sequence.alongKey === xAlong ? 'X' : 'Y') as 'X' | 'Y',\r\n 1030:       })),\r\n 1030:       })),\r\n 1031:     ]\r\n 1032:   }\r\n 1033: \r\n 1034:   return [\r\n 1035:     ...directed,\r\n 1036:     ...undirected.map((sequence) => ({\r\n 1037:       ...sequence,\r\n 1038:       direction: (sequence.simpleKinds.has('numeric') ? 'X' : 'Y') as 'X' | 'Y',\r\n 1039:     })),\r\n 1040:   ]\r\n 1041: }\r\n 1042: \r\n 1043: function labelFamily(label: string): string {\r\n 1044:   return label.endsWith(\"'\") ? label.slice(0, -1) : label\r\n 1045: }\r\n 1046: \r\n 1047: /**\r\n 1048:  * Some drawings print a vertical axis from the high-numbered end toward the\r\n 1049:  * low-numbered end.  Keep the measured positions in page order, but restore\r\n 1050:  * the logical label order expected by the framing-plan contract.  A plain\r\n 1051:  * Y1..Y3 band is deliberately left alone: that is the older corpus format and\r\n 1052:  * changing it would change the existing 14-page result.\r\n 1053:  */\r\n 1054: function normalizeAxisOrientation(\r\n 1055:   sequences: Dire