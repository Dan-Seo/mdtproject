=> left.x - right.x)[0]\r\n2761:     // 우측 경계는 이웃 표 제목의 시작점이다. 제목이 표의 중앙에 놓인 경우에는\r\n2762:     // 제목 사이 중점이 실제 열 경계보다 왼쪽으로 들어와 마지막 부호(ina の GA,\r\n2763:     // Fuji の B1C2)를 잘라낸다. 제목의 왼쪽 대역은 이미 xStart로 분리했으므로,\r\n2764:     // 오른쪽은 이웃 제목 자체만 제외하면 표의 마지막 열을 온전히 받을 수 있다.\r\n2765:     const xEnd = rightNeighbor ? rightNeighbor.x : Number.POSITIVE_INFINITY\r\n2766:     // 블록 끝은 이 x대역 안에서 아래에 오는 다음 타이틀\r\n2767:     const belowEnd = rightNeighbor\r\n2768:       ? (anchor.x + rightNeighbor.x) / 2\r\n2769:       : Number.POSITIVE_INFINITY\r\n2770:     const below = anchors\r\n2771:       .filter(\r\n2772:         (other) =>\r\n2773:           other.row.y - anchor.row.y > sameBand &&\r\n2774:           other.x >= xStart &&\r\n2775:           other.x < belowEnd,\r\n2776:       )\r\n2777:       .sort((left, right) => left.row.y - right.row.y)[0]\r\n2778:     const endY = below?.row.y ?? page.heightPt\r\n2779:     const result = parseTableRegion(\r\n2780:       rows,\r\n2781:       anchor,\r\n2782:       endY,\r\n2783:       xStart,\r\n2784:       xEnd,\r\n2785:       verticals,\r\n2786:     )\r\n2787:     if (result) parsed.push(result)\r\n2788:   })\r\n2789: \r\n2790:   return parsed\r\n2791: }\r\n--- test helpers and additions utf8 ---\r\n   1: import { readFileSync } from 'node:fs'\r\n   2: import { resolve } from 'node:path'\r\n   3: \r\n   4: import { describe, expect, it } from 'vitest'\r\n   5: \r\n   6: import { parseSectionLists } from '@/lib/import/section-list/parse'\r\n   7: import type {\r\n   8:   ParsedSectionList,\r\n   9:   SectionCandidate,\r\n  10:   TextPage,\r\n  11: } from '@/lib/import/section-list/types'\r\n  12: \r\n  13: type TextItemFixture = {\r\n  14:   page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  15:   items: TextPage['items']\r\n  16: }\r\n  17: \r\n  18: function readPage(file: string): TextPage {\r\n  19:   const fixturePath = resolve(\r\n  20:     process.cwd(),\r\n  21:     'tests/fixtures/section-import/textitems',\r\n  22:     file,\r\n