  const wrapped = raw !== undefined && raw.length > 0\r\n1124:     if (wrapped) candidate.raw[label] = cleanedRebarRaw(raw as string)\r\n1125:     candidate.raw[`${label}(${wrapped ? '折返し' : '無ラベル行'})`] =\r\n1126:       cleanedRebarRaw(folded)\r\n1127:     addIssue(candidate, wrapped ? '帯筋折返し' : '帯筋ラベル行外')\r\n1128:     return\r\n1129:   }\r\n1130:   if (!raw) return\r\n1131:   const parsed = parsePitch(raw)\r\n1132:   if (parsed) {\r\n1133:     const shape = decorationPrefix(raw)\r\n1134:     if (shape !== undefined) candidate.raw[`${label}形状`] = shape\r\n1135:     candidate[key] = parsed\r\n1136:     return\r\n1137:   }\r\n1138: \r\n1139:   candidate.raw[label] = cleanedRebarRaw(raw)\r\n1140:   addIssue(candidate, '帯筋解釈不能')\r\n1141: }\r\n1142: \r\n1143: function setSideBar(\r\n1144:   candidate: SectionCandidate,\r\n1145:   raw: string | undefined,\r\n1146: ): void {\r\n1147:   if (raw === undefined) return\r\n1148:   const value = compact(raw)\r\n1149:   // 空欄・横線は「その配筋がない」という正常な図面値であり、読取失敗ではない。\r\n1150:   if (value === '' || /^[-―]+$/.test(value)) return\r\n1151: \r\n1152:   // 主筋と同じ 本数-径 文法を使う。腹筋は高強度せん断補強筋を取らない。\r\n1153:   const parsed = parseBar(raw)\r\n1154:   if (parsed) {\r\n1155:     candidate.sideBar = parsed\r\n1156:     return\r\n1157:   }\r\n1158: \r\n1159:   candidate.raw['腹筋'] = cleanedRebarRaw(raw)\r\n1160:   addIssue(candidate, '腹筋解釈不能')\r\n1161: }\r\n1162: \r\n1163: function setWidthTie(\r\n1164:   candidate: SectionCandidate,\r\n1165:   label: string,\r\n1166:   raw: string | undefined,\r\n1167: ): void {\r\n1168:   if (raw === undefined) return\r\n1169:   const parsed = parsePitch(raw)\r\n1170:   if (parsed && barSizes.has(parsed.size as BarSize)) {\r\n1171:     candidate.widthTie = {\r\n1172:       size: parsed.size as BarSize,\r\n1173:       pitchMm: parsed.pitchMm,\r\n1174:     }\r\n1175:     return\r\n1176:   }\r\n1177:   candidate.raw[label] = cleanedRebarRaw(raw)\r\n1178:   addIssue(candidate, '幅止め筋解釈不能')\r\n1179: }\r\n1180: \r\n1181: interf