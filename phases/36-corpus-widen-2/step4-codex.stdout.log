tion storyRows(rows: TextRow[]): StoryRow[] {\n299: * 小梁·地中梁·基礎 리스트는 반영 대상이 아니다 (ADR-005). 캡처(listKind)는\r\n304:function isOutOfScopeList(titleText: string): boolean {\r\n308:function kindFromMark(mark: string, titleText: string): SectionCandidate['kind'] {\n317:function median(values: number[]): number {\r\n323:function positionColumns(row: TextRow, marks: MarkColumn[]): PositionColumn[] {\n325:  if (!label || marks.length === 0) return []\n345:  if (positions.length === 0) return []\r\n410:function dataSegments(row: TextRow, aliases: readonly string[]): TextSegment[] {\n412:  if (!label) return []\n420:    if (!alias) return []\n422:    return [{ source: segment, value: { ...segment, text: value, compact: value } }]\n424:  return [\n434:function isDimensionRow(\n457:function valuesAtTargets(\r\n493:function valuesByMark(\n513:function segmentsByMark(\r\n543:function valuesByPosition(\r\n572:function stripDecoration(value: string): string {\n576:function decorationPrefix(value: string): string | undefined {\n580:function isTwoLayerBar(value: string): boolean {\n585:function parseBar(value: string): ParsedBar | undefined {\r\n598:function parsePitch(\n625:function sequentialTitleItems(titleText: string): string[] {\r\n628:  if (firstMarker < 0) return [text]\r\n644:    if (item.length === 0 || nextStart >= text.length) return [text]\r\n652:function widthTieFromTitle(\r\n682:function inDimensionRange(b: number, depth: number): boolean {\r\n690:function parseCircularDimension(value: string): { diameter: number } | undefined {\r\n697:function parseDimension(value: string): { b: number; depth: number } | undefined {\n715:function pairedDimension(\r\n733:function cleanedRebarRaw(value: string): string {\r\n737:function addIssue(candidate: SectionCandidate, issue: CandidateIssue): void {\r\n741:function setDimension(\r\n785:function setColumnMain(\r\n827:function positionZone(label: string): '端部' | '中央' | undefined {\r\n834:function isThreePositionLayout(\r\n846:function 