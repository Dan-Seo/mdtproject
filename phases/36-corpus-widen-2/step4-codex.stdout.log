onList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from './types'\r\n\r\ninterface MarkColumn {\n  mark: string\n  centerX: number\n  /** 媛숈? ?먮Ц ??먯꽌 ?쇱퀜吏?遺?몃? 媛?諛곗젙 ???섎굹濡?臾띕뒗?? */\n  groupKey: string\n  rawCell: string\n}\n\r\ninterface PositionColumn {\r\n  label: string\r\n  rawLabel: string\r\n  centerX: number\r\n  mark: string\r\n}\r\n\r\ninterface StoryRow {\r\n  label: string\r\n  row: TextRow\r\n}\r\n\r\ninterface TitleAnchor {\r\n  listKind: string\r\n  /** 罹≪쿂媛 ?꾨땶 ??댄? ?멸렇癒쇳듃 ?먮Ц ??野얕괌鸚??먯젙? ?ш린瑜?蹂몃떎 */\r\n  titleText: string\r\n  row: TextRow\r\n  x: number\r\n}\r\n\r\ninterface ParsedBar {\r\n  size: BarSize\r\n  count: number\r\n}\r\n\r\nconst barSizes = new Set<BarSize>(BAR_SIZES)\r\n// 躍?춮?삠걗?겹굢嶺뗣걽?묆걣遙섇섭佯╉걵?볠뼪獒쒎섭嶺?(K13?팗13) ?믣룚?뚣굥?귚말嶺뗣겗 barSizes ??\n// ?녴걨?╉걚?뗣겗??곦말嶺뗣겓?γ굥?②〃5.3.4?삭〃5.3.2 ?ャ겒?꾢푶?믣폊?뤵걢?됥걽 (ADR-026)??\nconst shearBarSizes = new Set<ShearBarSize>(SHEAR_BAR_SIZES)\r\n\r\nconst TITLE_PATTERN =\r\n  /(?길뼪?㏂꺁?밤깉|鸚㎪쥈??씊?ゃ궧??弱뤸쥈??씊?ゃ궧??弱뤸쥈?ゃ궧???뉑똻歟곥꺁?밤깉|?뉑똻?밤꺀?뽧꺁?밤깉|?먨쑇?덀꺁?밤깉|鶯곥꺁?밤깉|?밤꺀?뽧꺁?밤깉|?겻릎歟곥꺁?밤깉|?긱꺁?밤깉|鸚㎪쥈?ゃ궧??歟곥꺁?밤깉)/\r\nconst STORY_PATTERN = /^(?:RF|R??\\d+F|\\d+???곈쉸)$/\nconst MARK_PATTERN = /^(?:(?:[A-Z]?\\d*)?(?:FCG|CG|EW|BW|FS|CS|FC|FG|FB|CB|C|G|B|S|W)(?:\\d+[A-Z]?|[A-Z])?|fg)$/i\n\r\n/** ?몃줈 ?곗쓣 痢??щ씪?댁뒪??諛곗젙???뚯쓽 嫄곕━ ?곹븳 = ?щ씪?댁뒪 ??횞 ??媛?\r\n *  諛곗젙 ?듭빱媛 痢??쇰꺼?대뜕 ?숈븞?먮뒗 ??寃?ш? 以묎컙 痢듭뿉????긽 李몄씠?덈떎 ??\n *  ?щ씪?댁뒪媛 留욌떯???덉뼱(endY[i] == startY[i+1]) ?쇰꺼 理쒓렐?묒쓽 蹂대줈?몄씠 寃쎄퀎媛\r\n *  span/2? ?뺥솗???쇱튂?덇린 ?뚮Ц?대떎. ?듭빱瑜??쒖쓽 ?됱쑝濡?諛붽퓭 ?곹븳???ㅼ젣濡?\n *  ?묐룞?섍쾶 ?먮떎 (#32?? verticalsBySlice 李멸퀬) */\r\nconst SLICE_DISTANCE_LIMIT_RATIO = 0.5\r\n\r\n/**\r\n * ?쒖젣?(?꾨㈃ ?고븯??釉붾줉)???녜씊?띸㎞ 移몄뿉??洹??꾨㈃???대쫫???ㅼ뼱媛꾨떎 ??\n * ?뚧쥈?ゃ궧?덀띿쿂??由ъ뒪????댄?怨?湲?먭? 媛숇떎. ?닿쾬???듭빱濡??≪쑝硫????쒓? 嫄곌린??\n * ?딄꺼 留덉?留?痢?釉붾줉???곗씠???됱씠 ?듭㎏濡??щ씪吏꾨떎: ?ㅻЪ ojkk p3?먯꽌 2F 7移몄씠\r\n * 議곗슜???놁뼱議뚭퀬(寧?뤇 ?됱? 寃쎄퀎 ?? ?곗씠???됱? 諛?, ?꾨낫 0媛쒖쭨由??좊졊 由ъ뒪?멸?\r\n * ?뚯씤??紐????쒓? ?덈떎?띾줈 ?쒖떆?먮떎.\r\n *\r\n * ?쇰꺼? 媛믨낵 ?곕줈 ?⑥뼱吏湲곕룄 ?섍퀬(ojkk: ?뚦쎋?℡릫燁겹??ㅼ쓬 ?멸렇癒쇳듃媛 ?뚧쥈?ゃ궧?덀?\r\n * ???⑹씠媛 ?섍린???쒕떎(yokohama: ?똀1=1/30?녜씊?띸㎞鸚㎪쥈??씊?ゃ궧?덀? ??????蹂몃떎.\r\n * ???꾩껜瑜?蹂댁????딅뒗?? ?쒖젣? ?좊뒗 ?꾨㈃ ??쓣 媛濡쒖?瑜대?濡?ojkk ?ㅼ륫 x=893~1150)\r\n * 媛숈? y???볦씤 吏꾩쭨 ??댄?源뚯? ?④퍡 吏?뚯쭊??\r\n */\r\nconst TITLE_BLOCK_LABELS = ['?녜씊?띸㎞', '?녜씊葉?닪'] as const\n\nfunction isTitleBlockField(\n  rows: TextRow[],\n  rowIndex: number,\n  segmentIndex: number,\n): boolean {\n  const row = rows[rowIndex]\n  const segment = row.segments[segmentIndex]\n  if (\n    TITLE_BLOCK_LABELS.some((label) => segment.compact.includes(label)) ||\n    row.segments[segmentIndex - 1]?.compact.endsWith('?녜씊?띸㎞') === true\n  ) {\n    return true\n  }\n\n  // ?쒖젣?? ?꾨㈃ ?뺤떇???곕씪 ?뚦쎋?℡릫燁겹띉룔뚦쎋?®Ŧ?γ??쇰꺼怨?媛믪씠 ?쒕줈 ?ㅻⅨ\n  // ?됱쑝濡?遺꾨━?쒕떎. 媛숈? y ?됰쭔 蹂대㈃ 媛??덉쓽 ?뚣궧?⒲깣?ゃ궧?덀띾? ?ㅼ젣 由ъ뒪??  // ??댄?濡??ㅼ씤?섎?濡? 諛붾줈 ?꾩쓽 媛源뚯슫 ?쇰꺼怨?媛숈? ?쒖젣? ?댁씤吏 ?뺤씤?쒕떎.\n  for (let index = rowIndex - 1; index >= 0; index -= 1) {\n    const labelRow = rows[index]\n    const distance = row.y - labelRow.y\n    const rowBand = Math.max(row.height, labelRow.height) * 3\n    if (distance > rowBand) break\n    if (\n      labelRow.segments.some(\n        (label) =>\n          TITLE_BLOCK_LABELS.includes(label.compact as (typeof TITLE_BLOCK_LABELS)[number]) &&\n          segment.x >= label.x,\n      )\n    ) {\n      return true\n    }\n  }\n  return false\n}\n\r\nfunction titleAnchors(rows: TextRow[]): TitleAnchor[] {\r\n  const anchors: TitleAnchor[] = []\r\n\r\n  // ???됱뿉 ??댄????щ윭 媛쒕㈃(醫뚯슦 蹂묒튂) ?꾨? ?듭빱濡??〓뒗??\n  for (const [rowIndex, row] of rows.entries()) {\n    for (const [index, segment] of row.segments.entries()) {\n      const match = segment.compact.match(TITLE_PATTERN)\n      if (!match || isTitleBlockField(rows, rowIndex, index)) continue\n      anchors.push({\r\n        listKind: match[1],\r\n        titleText: segment.compact,\r\n        row,\r\n        x: segment.x,\r\n      })\r\n    }\r\n  }\r\n\r\n  return anchors.sort(\r\n    (left, right) => left.row.y - right.row.y || left.x - right.x,\r\n  )\r\n}\r\n\r\nfunction exactLabel(row: TextRow, aliases: readonly string[]): TextSegment | undefined {\n  const normalizedAliases = aliases.map(compact)\n  const direct = row.segments.find((segment) =>\n    normalizedAliases.includes(segment.compact),\n  )\n  if (direct) return direct\n\n  // ???뺤떇???꾨땶 PDF?먯꽌???뚩끃嶺?-D10?띿쿂???쇰꺼怨?媛믪쓣 ???멸렇癒쇳듃??  // 遺숈뿬 異쒕젰?쒕떎. ?쇰꺼??紐?李얠븯?ㅺ퀬 ???꾩껜瑜?踰꾨━吏 ?딅룄濡??쇰꺼 ?묐몢留?  // ?몄떇?섍퀬, ?ㅼ젣 媛믪? dataSegments媛 ?묐?瑜??곕줈 留뚮뱺??\n  for (const segment of row.segments) {\n    const alias = normalizedAliases.find(\n      (candidate) =>\n        segment.compact.startsWith(candidate) &&\n        segment.compact.length > candidate.length,\n    )\n    if (alias) {\n      return {\n        ...segment,\n        text: segment.text.slice(alias.length),\n        compact: alias,\n        endX: segment.x,\n      }\n    }\n  }\n\n  // PDF留덈떎 ?뚨Е?룔띉룔뚨츋??띉룔똕TP.?띻? ?몄젒 湲由ы봽 ?멸렇癒쇳듃濡?媛덈씪吏꾨떎.\n  // ??蹂듭썝 ?④퀎?먯꽌 臾대━?섍쾶 遺숈씠硫??ㅻⅨ ?源뚯? ?⑹퀜吏????덉쑝誘濡? ?ш린?쒕쭔\n  // ?몄젒 ?멸렇癒쇳듃???쇰꺼 ?꾨낫瑜?議고빀?섍퀬 ?ㅼ젣 ? 媛믪쓽 諛곗젙? 湲곗〈 醫뚰몴瑜??대떎.\n  for (let start = 0; start < row.segments.length; start += 1) {\n    let value = ''\n    for (let end = start; end < row.segments.length; end += 1) {\n      value += row.segments[end].compact\n      if (normalizedAliases.includes(value)) {\n        const first = row.segments[start]\n        const last = row.segments[end]\n        return {\n          text: row.segments\n            .slice(start, end + 1)\n            .map((segment) => segment.text)\n            .join(''),\n          compact: value,\n          items: row.segments\n            .slice(start, end + 1)\n            .flatMap((segment) => segment.items),\n          x: first.x,\n          endX: last.endX,\n          centerX: (first.x + last.endX) / 2,\n          centerY: (first.centerY + last.centerY) / 2,\n        }\n      }\n      if (value.length >= Math.max(...normalizedAliases.map((alias) => alias.length))) {\n        break\n      }\n    }\n  }\n  return undefined\n}\n\r\nfunction canonicalMark(value: string): string | undefined {\n  const mark = compact(value)\n  if (!MARK_PATTERN.test(mark)) return undefined\n  return mark === 'fg' ? mark : mark.toUpperCase()\n}\n\nfunction markParts(value: string): string[] {\n  return compact(value)\n    .split(/[,??/u)\n    .map((part) => canonicalMark(part))\n    .filter((part): part is string => part !== undefined)\n}\n\nfunction markColumns(row: TextRow): MarkColumn[] {\n  const label = exactLabel(row, ['寧?뤇'])\n  if (!label) return []\n\n  return row.segments\n    .filter((segment) => segment.centerX > label.endX)\n    .flatMap((segment) => {\n      const marks = markParts(segment.text)\n      const groupKey = `${segment.x}:${segment.endX}`\n      return marks.map((mark) => ({\n        mark,\n        centerX: segment.centerX,\n        groupKey,\n        rawCell: segment.text,\n      }))\n    })\n}\n\r\nfunction storyFromRow(row: TextRow): string | undefined {\n  return row.segments\n    .map((segment) => segment.compact)\n    .find((value) => STORY_PATTERN.test(value))\n}\n\n/**\n * ?뚯쟾??由ъ뒪?몄뿉?쒕뒗 ?똓?띉룔??띿? ?뚪쉸?띻? 媛숈? ?됱씠 ?꾨땲??媛숈? ?댁쓽\n * ?곗냽 ?됱쑝濡?蹂듭썝?쒕떎. ??議곌컖???섎굹??story ?됱쑝濡쒕쭔 ?⑹튂怨? 洹?諛뽰쓽\n * ?レ옄쨌臾몄옄??痢듭쑝濡??밴꺽?섏? ?딅뒗?????쒖쓽 移섏닔??踰붾?瑜?痢듭쑝濡?留뚮뱾硫? * ?꾨옒 ?곗씠?곌? ?ㅻⅨ 痢듭뿉 議곗슜??洹?띾맂??\n */\nfunction storyRows(rows: TextRow[]): StoryRow[] {\n  const result: StoryRow[] = []\n  const seen = new Set<number>()\n\n  rows.forEach((row, index) => {\n    const direct = storyFromRow(row)\n    if (direct !== undefined) {\n      result.push({ label: direct, row })\n      seen.add(index)\n      return\n    }\n\n    const fragment = row.segments.find((segment) => /^(?:R|\\d+)$/.test(segment.compact))\n    // ?ㅼ?移섏? 二쇨린 ?띿뒪?멸? 媛숈? ???ъ씠???쇱뼱?? 媛숈? x ?댁뿉??媛??媛源뚯슫\n    // ?뚪쉸??議곌컖留?寃고빀?쒕떎. ?ㅼ쓬 ?됰쭔 蹂대뒗 諛⑹떇? saiki ?긱꺁?밤깉泥섎읆\n    // ?ε릦?ⓨ릭嶺떷룸쾾???쒓린媛 痢?議곌컖怨?suffix ?ъ씠???볦씤 ?뺤떇???볦튇??\n    const suffixIndex = rows.findIndex(\n      (candidate, candidateIndex) =>\n        candidateIndex > index &&\n        candidate.segments.some(\n          (segment) =>\n            segment.compact === '?? &&\n            fragment !== undefined &&\n            Math.abs(fragment.x - segment.x) <= 1,\n        ),\n    )\n    const suffix =\n      suffixIndex >= 0\n        ? rows[suffixIndex].segments.find((segment) => segment.compact === '??)\n        : undefined\n    if (\n      fragment === undefined ||\n      suffix === undefined ||\n      Math.abs(fragment.x - suffix.x) > 1\n    ) {\n      return\n    }\n\n    const label = `${fragment.compact}??\n    if (!STORY_PATTERN.test(label) || seen.has(suffixIndex)) return\n    result.push({ label, row })\n    seen.add(index)\n    seen.add(suffixIndex)\n  })\n\n  return result.sort((left, right) => left.row.y - right.row.y)\n}\n\r\n/**\r\n * 弱뤸쥈쨌?겻릎歟겶룟읃鹽?由ъ뒪?몃뒗 諛섏쁺 ??곸씠 ?꾨땲??(ADR-005). 罹≪쿂(listKind)??\n * ?뚦읃鹽롦쥈?ゃ궧?덀띿뿉???뚧쥈?ゃ궧?덀띾줈 ?섎━誘濡???댄? ?먮Ц??蹂몃떎.\r\n * ?꾨낫 遺꾨쪟? ?몄떇 ?ㅽ뙣 ?덈궡媛 媛숈? ?먯젙??遊먯빞 ?쒕떎 ???쒖そ留?怨좎튂硫?\n * ?뚰썑蹂대뒗 野얕괌鸚뽰씤???ㅽ뙣 ?덈궡???щ떎?띾줈 議곗슜??媛덈씪吏꾨떎\r\n */\r\nfunction isOutOfScopeList(titleText: string): boolean {\r\n  return /弱뤸쥈|?겻릎歟??븀쨴|?뉑똻歟??뉑똻?밤꺀???먨쑇??.test(titleText)\r\n}\r\n\r\nfunction kindFromMark(mark: string, titleText: string): SectionCandidate['kind'] {\n  if (isOutOfScopeList(titleText)) return '野얕괌鸚?\n  // C1 怨꾩뿴? 痢??묐몢(2C1, B1C1)源뚯? ?덉슜?섎릺, FC1 媛숈? ?븀쨴??遺?몃뒗\n  // 湲곗〈 踰붿쐞 ?먯젙泥섎읆 ?긷숃짒濡??밴꺽?섏? ?딅뒗??\n  if (/^(?:C\\d|\\d+C\\d|[A-EG-Z]\\d+C\\d)/i.test(mark)) return '??\n  if (/G\\d/i.test(mark) || /^G[A-Z]?$/i.test(mark)) return '鸚㎪쥈'\n  return '野얕괌鸚?\n}\n\r\nfunction median(values: number[]): number {\r\n  if (values.length === 0) return 1\r\n  const sorted = [...values].sort((left, right) => left - right)\r\n  return sorted[Math.floor(sorted.length / 2)]\r\n}\r\n\r\nfunction positionColumns(row: TextRow, marks: MarkColumn[]): PositionColumn[] {\n  const label = exactLabel(row, ['鵝띸쉰'])\n  if (!label || marks.length === 0) return []\n\n  // 寧?뤇?삠꺂?믦쨭?겹겗寧?뤇?멨콝?뗣걮?╉굚?곦퐤營?닓??돯壤볟뜕鵝띲겘?잍뻼?삠꺂??겲?얇?  // 6寧?뤇???쀣겦 DP ?ユ륫?쇻겏令뷴닓???ㅴ퐳?듽곩ㅳ굮 FG2/FG4/FB ?ャ걽?묈칱?쎼겍\n  // FG1/FG3 ??말嶺뗣굮?εㅳ겏?쀣겍?긱걝?잆굙?곩릪??groupKey ?믢??쀣겓?삠걲??  const markGroups = marks.filter(\n    (mark, index) =>\n      marks.findIndex((candidate) => candidate.groupKey === mark.groupKey) ===\n      index,\n  )\n\r\n  const positions = row.segments\r\n    .filter((segment) => segment.centerX > label.endX)\r\n    .map((segment) => ({\r\n      label: segment.compact,\r\n      rawLabel: segment.text,\r\n      centerX: segment.centerX,\r\n    }))\r\n    .filter((position) => position.label.length > 0)\r\n\r\n  if (positions.length === 0) return []\r\n\r\n  const spacings = positions\r\n    .slice(1)\r\n    .map((position, index) => position.centerX - positions[index].centerX)\r\n    .filter((spacing) => spacing > 0)\r\n  const emptyPenalty = Math.pow(median(spacings) * 0.75, 2)\r\n  const costs = Array.from({ length: markGroups.length + 1 }, () =>\n    Array<number>(positions.length + 1).fill(Number.POSITIVE_INFINITY),\n  )\n  const choices = Array.from({ length: markGroups.length + 1 }, () =>\n    Array<number>(positions.length + 1).fill(0),\n  )\n  costs[0][0] = 0\r\n\r\n  for (let markIndex = 0; markIndex < markGroups.length; markIndex += 1) {\n    for (let used = 0; used <= positions.length; used += 1) {\r\n      if (!Number.isFinite(costs[markIndex][used])) continue\r\n      for (let count = 0; used + count <= positions.length; count += 1) {\r\n        const group = positions.slice(used, used + count)\r\n        const mean =\r\n          count === 0\r\n            ? markGroups[markIndex].centerX\n            : group.reduce((total, position) => total + position.centerX, 0) /\r\n              count\r\n        const spread =\r\n          count === 0\r\n            ? 0\r\n            : group.reduce(\r\n                (total, position) => total + Math.pow(position.centerX - mean, 2),\r\n                0,\r\n              ) / count\r\n        const groupCost =\r\n          count === 0\r\n            ? emptyPenalty\r\n            : Math.pow(mean - markGroups[markIndex].centerX, 2) + spread * 0.1\n        const nextCost = costs[markIndex][used] + groupCost\r\n        if (nextCost < costs[markIndex + 1][used + count]) {\r\n          costs[markIndex + 1][used + count] = nextCost\r\n          choices[markIndex + 1][used + count] = count\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  const counts = Array<number>(markGroups.length).fill(0)\n  let used = positions.length\n  for (let markIndex = markGroups.length; markIndex > 0; markIndex -= 1) {\n    const count = choices[markIndex][used]\r\n    counts[markIndex - 1] = count\r\n    used -= count\r\n  }\r\n\r\n  const result: PositionColumn[] = []\r\n  let positionIndex = 0\r\n  counts.forEach((count, markIndex) => {\r\n    for (let index = 0; index < count; index += 1) {\r\n      const position = positions[positionIndex]\r\n      result.push({ ...position, mark: markGroups[markIndex].mark })\n      positionIndex += 1\r\n    }\r\n  })\r\n  return result\r\n}\r\n\r\nfunction dataSegments(row: TextRow, aliases: readonly string[]): TextSegment[] {\n  const label = exactLabel(row, aliases)\n  if (!label) return []\n  const normalizedAliases = aliases.map(compact)\n  const inlineSegments = row.segments.flatMap((segment) => {\n    const alias = normalizedAliases.find(\n      (candidate) =>\n        segment.compact.startsWith(candidate) &&\n        segment.compact.length > candidate.length,\n    )\n    if (!alias) return []\n    const value = segment.compact.slice(alias.length)\n    return [{ source: segment, value: { ...segment, text: value, compact: value } }]\n  })\n  return [\n    ...row.segments\n      .filter((segment) => segment.centerX > label.endX)\n      .filter(\n        (segment) => !inlineSegments.some(({ source }) => source === segment),\n      ),\n    ...inlineSegments.map(({ value }) => value),\n  ]\n}\n\nfunction isDimensionRow(\n  row: TextRow,\n  aliases: readonly string[],\n  marks: MarkColumn[],\n): boolean {\n  const label = exactLabel(row, aliases)\n  const cells = dataSegments(row, aliases)\n  if (label === undefined || cells.length === 0) return false\n\n  // ?뚧뼪?㏂띿? ?ㅼ?移섏쓽 ?쒕ぉ?쇰줈???곗씤?? ?ㅼ젣 ?⑤㈃ ?됱? 寧?뤇 ???섎쭔??  // ???媛吏吏留? ?ㅼ?移섏쓽 X/Y쨌?답벡歟??쒓린???쇰? ?留?媛吏誘濡?洹??됱쓣\n  // ??씊 ?곗씠?곕줈 ?몄? ?딅뒗?? 媛??먯껜媛 遺덈챸?뺥빐???먮Ц??raw濡?蹂댁〈?댁빞\n  // ?섎?濡? ???먯젙? 媛믪쓽 ?뚯떛 ?깃났 ?щ?? 遺꾨━?쒕떎.\n  if (label.compact !== '??씊') return true\n  return (\n    cells.some(\n      (cell) =>\n        parseDimension(cell.text) !== undefined ||\n        parseCircularDimension(cell.text) !== undefined,\n    ) || cells.length >= marks.length\n  )\n}\n\r\nfunction valuesAtTargets(\r\n  segments: TextSegment[],\r\n  targets: Array<{ id: string; centerX: number }>,\r\n): Map<string, string> {\r\n  const assigned = new Map<string, TextSegment[]>()\r\n  if (targets.length === 0) return new Map()\r\n  const bounded = boundedAnchors(targets)\r\n\r\n  for (const segment of segments) {\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    // ??媛꾧꺽???섏뼱 ?⑥뼱吏??멸렇癒쇳듃?????쒖쓽 移몄씠 ?꾨땲?? ?ㅻⅨ履????댁? ??\n    // 諛붽묑??湲?먮? ?꾨? ?쇳궓?????쒖젣????쒖? 媛숈? ?됱뿉 嫄몄튂硫???-D22?띻?\r\n    // ??-D22訝榮싧뻠影됧＋雅뗥떃??╉띻? ?섏뼱 ?뺤젙?대뜕 移몄씠 鰲ｉ뇠訝띹꺗?쇰줈 ?ㅼ쭛?뚮떎\r\n    // (?ㅻЪ ojkk p3 G5/2F). ?댁씠 ?섎굹肉먯씠硫??곹븳???녿떎(limit=Infinity)\r\n    if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n    const existing = assigned.get(target.id) ?? []\r\n    existing.push(segment)\r\n    assigned.set(target.id, existing)\r\n  }\r\n\r\n  return new Map(\r\n    [...assigned.entries()].map(([id, targetSegments]) => [\r\n      id,\r\n      targetSegments\r\n        .sort((left, right) => left.x - right.x)\r\n        .map((segment) => segment.text)\r\n        .join(''),\r\n    ]),\r\n  )\r\n}\r\n\r\nfunction valuesByMark(\n  row: TextRow,\n  aliases: readonly string[],\n  marks: MarkColumn[],\n): Map<string, string> {\n  const groups = [...new Map(\n    marks.map(({ groupKey, centerX }) => [groupKey, { id: groupKey, centerX }]),\n  ).values()]\n  const values = valuesAtTargets(\n    dataSegments(row, aliases),\n    groups,\n  )\n  return new Map(\n    marks.flatMap(({ mark, groupKey }) => {\n      const value = values.get(groupKey)\n      return value === undefined ? [] : [[mark, value] as const]\n    }),\n  )\n}\n\r\nfunction segmentsByMark(\r\n  segments: TextSegment[],\r\n  marks: MarkColumn[],\r\n): Map<string, TextSegment[]> {\r\n  const grouped = new Map<string, TextSegment[]>()\r\n  if (marks.length === 0) return grouped\r\n\r\n  for (const segment of segments) {\r\n    const target = marks.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    const existing = grouped.get(target.mark) ?? []\r\n    existing.push(segment)\r\n    grouped.set(target.mark, existing)\r\n  }\r\n  return grouped\r\n}\r\n\r\n/**\r\n * 鵝띸쉰蹂?? 媛믪쓣 鵝띸쉰 ?몃뜳?ㅻ줈 ?섎룎由곕떎. 鵝띸쉰 ?댁쓣 ?섎굹??諛곗젙諛쏆? 紐삵븳 寧?뤇????\r\n * 諛곗젙 ??곸뿉??類????洹몃?濡??먮㈃ 洹????理쒓렐??鵝띸쉰(??寧?뤇??????遺숈뼱 ?⑥쓽 媛믪쓣\r\n * ?ㅼ뿼?쒗궓?? 鍮좎쭊 寧?뤇? valuesByMark濡??곕줈 ?쎈뒗??\r\n *\r\n * 寧?뤇 ???쑝濡?癒쇱? 媛瑜댁????딅뒗?? ?ㅻЪ ?꾨㈃(yokohama G54)?먯꽌 寧?뤇 ?ㅻ뜑 以묒떖??\n * ??寃쎄퀎? ?닿툔???댁썐 ??媛믪씠 ????덉쑝濡??ㅼ뼱?ㅻ뒗 寃쎌슦媛 ?덉뼱, ????곗꽑 諛곗젙?\r\n * 鵝띸쉰瑜?媛吏?寧?뤇???源뚯? 萸됯컿??\r\n */\r\nfunction valuesByPosition(\r\n  row: TextRow,\r\n  aliases: readonly string[],\r\n  positions: PositionColumn[],\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  const positionless = new Set(\r\n    marks\r\n      .filter(({ mark }) => !positions.some((position) => position.mark === mark))\r\n      .map(({ mark }) => mark),\r\n  )\r\n  const segments = dataSegments(row, aliases)\r\n  const assignable =\r\n    positionless.size === 0\r\n      ? segments\r\n      : [...segmentsByMark(segments, marks)]\r\n          .filter(([mark]) => !positionless.has(mark))\r\n          .flatMap(([, group]) => group)\r\n\r\n  return valuesAtTargets(\r\n    assignable,\r\n    positions.map((position, index) => ({\r\n      id: String(index),\r\n      centerX: position.centerX,\r\n    })),\r\n  )\r\n}\r\n\r\n/** ?꾪봽 ?뺤긽 湲고샇(?≤룐뼡쨌?┑룐뼢)? ?댁쓬 ?섏씠????? 癒몃━???μ떇留?踰쀪릿?? */\nfunction stripDecoration(value: string): string {\n  return compact(value).replace(/^[-?△뼡?╈뼢?잂뒢]+/, '')\n}\n\nfunction decorationPrefix(value: string): string | undefined {\n  return compact(value).match(/^([?△뼡?╈뼢?잂뒢]+)/)?.[1]\n}\n\nfunction isTwoLayerBar(value: string): boolean {\n  const match = stripDecoration(value).match(/^\\d+\\/\\d+-?(D\\d+)$/i)\n  return match !== null && barSizes.has(match[1].toUpperCase() as BarSize)\n}\n\r\nfunction parseBar(value: string): ParsedBar | undefined {\r\n  // parsePitch? 媛숈? 洹쒖빟: ?μ떇??踰쀪릿 ? ?꾩껜媛 ?⑥씪 ?뚧쑍??孃꾠띿씪 ?뚮쭔 ?뺤젙?쒕떎 ??\n  // 蹂듭닔 ?쒓린(??-D25+2-D22???? ?〓Ц?먭? 遺숈? ??0016-D25?띾룄 鍮덉뭏+?먮Ц 寃쎈줈濡?蹂대궦??\n  const match = stripDecoration(value).match(/^(\\d+)-?(D\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[2].toUpperCase() as BarSize\r\n  if (!barSizes.has(size)) return undefined\r\n  const count = Number(match[1])\r\n  // ?ф빊 3?먮━???몄젒 移섏닔???レ옄媛 遺숈? ? 蹂묓빀 ?붿옱(??0016-D25???닿퀬,\r\n  // 0蹂몄? 臾쇰웾 0??遺?щ? 留뚮뱺?????대뒓 履쎈룄 ?뺤젙?섏? ?딅뒗??\n  return count > 99 || count <= 0 ? undefined : { count, size }\r\n}\r\n\r\nfunction parsePitch(\n  value: string,\n): { size: ShearBarSize; pitchMm: number } | undefined {\n  // ? ?꾩껜媛 ?⑥씪 ?뚦푶@?붵긿?곥띿씪 ?뚮쭔 梨꾪깮?쒕떎 ??遺遺?留ㅼ튂瑜??덉슜?섎㈃\r\n  // 永꾣빊 ?묐몢????-D13@100??媛 議곗슜???⑥뼱??1永꾨줈 ?덈컲 怨꾩긽?쒕떎.\r\n  // ?쇈겞?띿쓽 ?묐몢 ?곷Ц?먮? D濡??쒖젙?섏? ?딅뒗 寃껋? 遙섇섭佯╉걵?볠뼪獒쒎섭嶺??뚮Ц?닿퀬,\r\n  // 紐⑸줉???녿뒗 ?쇈겞?띿? ?꾨옒 吏묓빀 寃?ъ뿉??鍮덉뭏+?먮Ц?쇰줈 ?⑥뼱吏꾨떎 (R10)\r\n  const match = stripDecoration(value).match(\n    /^([A-Z]\\d+(?:\\.\\d+)?)(?:-?@([\\d,]+)|-?([\\d,]+)@)$/i,\n  )\n  if (!match) return undefined\n  const size = match[1].toUpperCase() as ShearBarSize\n  if (!shearBarSizes.has(size)) return undefined\n  const pitchText = match[2] ?? match[3]\n  const pitchMm = Number(pitchText.replace(/,/g, ''))\n  // ?쇳몴媛 ?덈뒗 ???먮━ ?쇱튂??紐낆떆?곸씤 ?먮┸??援щ텇(?? 1,000)?대떎. ?쇳몴 ?녿뒗\n  // ???먮━ 媛믪? 湲곗〈怨?媛숈씠 ?몄젒 ?멸렇癒쇳듃媛 遺숈? ?붿옱濡?蹂댁븘 ?뺤젙?섏? ?딅뒗??\n  if (pitchMm <= 0 || (pitchMm > 999 && !pitchText.includes(','))) return undefined\n  return { size, pitchMm }\n}\n\r\n/**\r\n * compact???배쮼瑜???.?띾????쒖감??踰덊샇?대줈 癒쇱? 媛瑜몃떎. ?レ옄媛 ?쇱튂??遺숈뼱\r\n * ??5002.?띻? ?섏뼱???ㅼ쓬 踰덊샇媛 2?쇰뒗 ?ъ떎???ㅻⅨ履?寃쎄퀎瑜?利앸챸?쒕떎.\r\n * 踰덊샇?댁씠 ?놁쑝硫??쒖젣 ?꾩껜媛 ????ぉ?대ŉ, 鍮???ぉ? 踰덊샇?댁쓽 利앸챸???꾨땲誘濡?\n * 遺꾨━?섏? ?딅뒗??\r\n */\r\nfunction sequentialTitleItems(titleText: string): string[] {\r\n  const text = compact(titleText)\r\n  const firstMarker = text.indexOf('1.')\r\n  if (firstMarker < 0) return [text]\r\n\r\n  const items: string[] = []\r\n  let itemStart = firstMarker + '1.'.length\r\n  let nextNumber = 2\r\n\r\n  while (true) {\r\n    const marker = `${nextNumber}.`\r\n    const boundary = text.indexOf(marker, itemStart)\r\n    if (boundary < 0) {\r\n      const lastItem = text.slice(itemStart)\r\n      return lastItem.length > 0 ? [...items, lastItem] : [text]\r\n    }\r\n\r\n    const item = text.slice(itemStart, boundary)\r\n    const nextStart = boundary + marker.length\r\n    if (item.length === 0 || nextStart >= text.length) return [text]\r\n\r\n    items.push(item)\r\n    itemStart = nextStart\r\n    nextNumber += 1\r\n  }\r\n}\r\n\r\nfunction widthTieFromTitle(\r\n  titleText: string,\r\n): { value?: SectionCandidate['widthTie']; raw?: string } | undefined {\r\n  const item = sequentialTitleItems(titleText).find((candidate) =>\r\n    /(?:亮?藥?閭??:???嶺?.test(candidate),\r\n  )\r\n  if (!item) return undefined\r\n\r\n  const label = item.match(/(?:亮?藥?閭??:???嶺?)\r\n  if (!label || label.index === undefined) return undefined\r\n\r\n  const raw = item.slice(label.index)\r\n  // ??ぉ 寃쎄퀎瑜?利앸챸???ㅼ뿉???먮┸?섎줈 ?쇱튂 ?앹쓣 異붿륫?섏? ?딅뒗?? 亮끾??곭춮 ??ぉ\r\n  // ?꾩껜媛 ??臾몃쾿???뚮쭔 ?뺤젙?섍퀬, ?ㅼ뿉 ?ㅻⅨ ?배쮼媛 遺숈쑝硫?raw 寃쎈줈濡?蹂대궦??\r\n  const match = raw.match(\r\n    /^(?:亮?藥?閭??:???嶺??:???([A-Z]\\d+(?:\\.\\d+)?)-?@(\\d+)(?:?ⓦ걲???[??]*$/i,\r\n  )\r\n  if (!match) return { raw }\r\n\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  if (!barSizes.has(size) || pitchMm <= 0) return { raw }\r\n\r\n  return {\r\n    value: { size, pitchMm },\r\n  }\r\n}\r\n\r\n// 4?먮━ 珥덇낵??? 蹂묓빀 ?붿옱, ???먮━???뚯닔 ?쒓린(??.8횞0.8?띯넂8횞0)???붿옱????\n// ?대뒓 履쎈룄 ?뺤젙?섏? ?딅뒗??\nfunction inDimensionRange(b: number, depth: number): boolean {\r\n  return b >= 10 && b <= 9999 && depth >= 10 && depth <= 9999\r\n}\r\n\r\n/**\r\n * ?녶숱??씊???00??띲궾녴꺕過?삠렂烏②쮼??굞?뚣걽?묆굮誤뗣굥 ???겼ㅳ겛?ⓦ겇?졼걨??\n * ?삠꺂竊덀궧?긱긿?곥겗野멩퀡渶싷펹??냶?②き?얇겒?꾠귞쎍孃꾥쮼?룔걣?귙굥?볝겏?뚧졊?졼겎?귙굥??\n */\r\nfunction parseCircularDimension(value: string): { diameter: number } | undefined {\r\n  const match = normalized(value).match(/^(\\d[\\d,]*)\\s*[?過]$|^[?過]\\s*(\\d[\\d,]*)$/)\r\n  if (!match) return undefined\r\n  const diameter = Number((match[1] ?? match[2]).replace(/,/g, ''))\r\n  return inDimensionRange(diameter, diameter) ? { diameter } : undefined\r\n}\r\n\r\nfunction parseDimension(value: string): { b: number; depth: number } | undefined {\n  // ?댁썐 ???遺숈? ??00횞800 900횞900?띿뿉??泥?留ㅼ튂瑜?痍⑦븯硫???踰덉㎏ 洹몃９??\n  // 怨듬갚 ?덈㉧ ?レ옄源뚯? ?쇱폒 b=800쨌depth=800900???쒕떎 ???ㅼ쨷 留ㅼ튂??嫄곕??쒕떎\r\n  const matches = [\r\n    ...normalized(value).matchAll(/[\\d,]+\\s*[x횞*]\\s*[\\d,]+/gi),\n  ]\n  if (matches.length !== 1) return undefined\n  const [bText, depthText] = matches[0][0].split(/[x횞*]/i)\n  const b = Number(bText.replace(/,/g, '').trim())\n  const depth = Number(depthText.replace(/,/g, '').trim())\n  return inDimensionRange(b, depth) ? { b, depth } : undefined\n}\n\r\n/**\r\n * ?ㅼ?移섏뿉 遺숈? 媛濡쑣룹꽭濡?移섏닔瑜?吏앹???b횞d瑜??쎈뒗?? ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖뿉?쒕뒗\r\n * ???섏씠 ?좎씪??洹쇨굅?? ?쒖そ留뚯쑝濡쒕뒗 ?뺤젙?섏? ?딅뒗?????⑤룆 ?レ옄瑜??뺤궗媛곹삎?쇰줈\r\n * ?밴꺽?섎뒗 寃껋? ?꾨㈃???녿뒗 媛믪쓣 留뚮뱶??寃껋씠??\r\n */\r\nfunction pairedDimension(\r\n  horizontal: string,\r\n  vertical: string,\r\n): { b: number; depth: number } | undefined {\r\n  if (!/^\\d+$/.test(horizontal) || !/^\\d+$/.test(vertical)) return undefined\r\n  const b = Number(horizontal)\r\n  const depth = Number(vertical)\r\n  return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n}\r\n\r\n/**\r\n * ?뺤젙?섏? 紐삵븳 ????④린???먮Ц 李멸퀬 ?쒖떆. 癒몃━???μ떇留?踰쀪린怨??섎㉧吏??洹몃?濡?\n * ?붾떎 ???좏겙留?戮묒븘 以꾩씠硫???-D13@100?띿쓽 @100泥섎읆 ?먮Ц ?뺣낫媛 ?щ씪吏꾨떎.\r\n *\r\n * ?μ떇留뚯쑝濡??대（?댁쭊 ?? 踰쀪린硫?鍮?臾몄옄?댁씠 ?섎?濡??섏궡由곕떎. ?뚢뺛띾뒗 ?뚰빐???놁쓬?띿쓣\r\n * ?삵븯??媛믪씤??yokohama p13 ?밭춮 ??, 鍮덉뭏?쇰줈 ?대낫?대㈃ ?붾㈃?먯꽌 ?뚯씫吏 紐삵븳 ??띻낵\r\n * 援щ퀎?섏? ?딅뒗??\r\n */\r\nfunction cleanedRebarRaw(value: string): string {\r\n  return stripDecoration(value) || compact(value)\r\n}\r\n\r\nfunction addIssue(candidate: SectionCandidate, issue: CandidateIssue): void {\r\n  if (!candidate.issues.includes(issue)) candidate.issues.push(issue)\r\n}\r\n\r\nfunction setDimension(\r\n  candidate: SectionCandidate,\r\n  value: string | undefined,\r\n  column: boolean,\r\n  vertical?: string,\r\n): void {\r\n  if (!value) {\r\n    // ?몃줈留??쏀엺 移몃룄 ?먮Ц???④릿????議곗슜??踰꾨━硫??ъ슜?먮뒗 ????씊??鍮꾩뿀?붿?\r\n    // ?????녿떎. ?뺤젙?섏? 紐삵븳 移몄? 鍮덉뭏+?먮Ц 李멸퀬媛 ???뚯꽌??洹쒖빟?대떎\r\n    if (vertical !== undefined) {\r\n      candidate.raw['??씊'] = compact(vertical)\r\n      addIssue(candidate, '??씊?⒴숱訝띷닇塋?)\r\n    }\r\n    return\r\n  }\r\n  // ?녶숱??윶?ャ걮?뗣겒?꾠귛ㄷ歟곥겗??씊轝꾠겓??뚧씎?잆굢?앫굦??き?욥걬?덀겒??겎閻뷴츣?쀣겒?꾠?\n  const circular = column ? parseCircularDimension(value) : undefined\r\n  if (circular) {\r\n    candidate.shape = '?녶숱'\r\n    candidate.b = circular.diameter\r\n    candidate.d = circular.diameter\r\n    return\r\n  }\r\n\r\n  const parsed =\r\n    parseDimension(value) ??\r\n    (vertical !== undefined ? pairedDimension(value, vertical) : undefined)\r\n  if (parsed) {\r\n    if (column) candidate.shape = '?⒴숱'\r\n    candidate.b = parsed.b\r\n    if (column) candidate.d = parsed.depth\r\n    else candidate.depth = parsed.depth\r\n    return\r\n  }\r\n\r\n  // ?⑤룆 ?レ옄??b횞d濡??뺤젙?????녿떎 ???ㅼ?移?移섏닔???レ옄瑜??뺤궗媛곹삎?쇰줈\r\n  // ?밴꺽?섎㈃ 媛믪쓣 吏?대궡??寃껋씠 ?쒕떎 (ADR-012 怨꾩뿴). 鍮덉뭏+?먮Ц?쇰줈 ?④릿??\r\n  // ?몃줈???쎌뿀?붾뜲 吏앹쭞湲?pairedDimension)媛 嫄곕???寃쎌슦, 媛濡쒕쭔 ?④린硫?\n  // ?먮Ц ?몃줈媛믪씠 議곗슜???щ씪吏꾨떎 ???④퍡 ?④릿??\n  candidate.raw['??씊'] = compact(value)\r\n  if (vertical !== undefined) candidate.raw['??씊(潁?'] = compact(vertical)\r\n  addIssue(candidate, '??씊?⒴숱訝띷닇塋?)\r\n}\r\n\r\nfunction setColumnMain(\r\n  candidate: SectionCandidate,\r\n  cells: Array<{ position?: string; raw: string }>,\r\n  expectedCellCount: number,\r\n): void {\r\n  if (cells.length === 0) return\r\n  const parsed = cells.map(({ raw }) => parseBar(raw))\r\n  const allParsed = parsed.every((entry): entry is ParsedBar => entry !== undefined)\r\n  const allEqual =\r\n    allParsed &&\r\n    parsed.every(\r\n      (entry) => entry.count === parsed[0].count && entry.size === parsed[0].size,\r\n    )\r\n  const complete =\r\n    expectedCellCount === 0 || cells.length === expectedCellCount\r\n\r\n  if (allEqual && complete) {\r\n    candidate.main = parsed[0]\r\n    return\r\n  }\r\n\r\n  for (const cell of cells) {\r\n    const key = cell.position ? `訝사춮(${cell.position})` : '訝사춮'\r\n    candidate.raw[key] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  addIssue(\n    candidate,\n    !allParsed\n      ? cells.some(({ raw }) => isTwoLayerBar(raw))\n        ? '2餘든춮?ゅ?恙?\n        : '訝사춮鰲ｉ뇠訝띹꺗'\n      : !complete\n        ? '訝사춮鵝띸쉰轝좄맼'\n        : '訝사춮鵝띸쉰?면걬',\n  )\n}\n\r\n/**\r\n * 鵝띸쉰轝꾠겗?⒲깧?ャ걣?뉎걲?븅뼋?귙똜3塋?띲뚦쨼塋?띲겗?덀걝?ラ싥굤??릫?꾢릲?띲걣餓섅걦烏ⓦ굚?귙굥?뚣?\n * ?ュ갼??뚨ク?띲걣塋?깿?믤뙁?쇻겗??뀻?싥걲?뗣귟き?곥겒?꾠꺀?쇻꺂??undefined ?ャ걮?╉?\n * 塋?깿?삡릎鸚?겓沃?겳?욍걟?ゃ걚 ??沃?겳?욍걟?뚣겙?녜씊?ャ겒?꾣뼪?㏂굮鵝쒌굥??\n */\r\nfunction positionZone(label: string): '塋?깿' | '訝?ㄾ' | undefined {\r\n  const normalizedLabel = compact(label)\r\n  if (normalizedLabel.includes('訝?ㄾ')) return '訝?ㄾ'\r\n  if (normalizedLabel.includes('塋?)) return '塋?깿'\r\n  return undefined\r\n}\r\n\r\nfunction isThreePositionLayout(\r\n  cells: Array<{ position: string }>,\r\n): boolean {\r\n  const zones = cells.map(({ position }) => positionZone(position))\r\n  return (\r\n    cells.length === 3 &&\r\n    zones[0] === '塋?깿' &&\r\n    zones[1] === '訝?ㄾ' &&\r\n    zones[2] === '塋?깿'\r\n  )\r\n}\r\n\r\nfunction uniqueCount(bars: ParsedBar[]): number | undefined {\r\n  const first = bars[0]\r\n  if (first === undefined) return undefined\r\n  return bars.every((bar) => bar.count === first.count)\r\n    ? first.count\r\n    : undefined\r\n}\r\n\r\n/**\r\n * 鵝띸쉰?㎪쑍?겹굮?녴걨?╉걚?뗨〃?믡곭ク?ⓩ쵂?ⓧ릎鸚?쵂????ⓦ걮??き???\n *\r\n * ?똜3塋?폀Y4塋?띲겗?덀걝?ヤ륫塋?걣?뺛걝訝됪쵂烏ⓦ겘?곦퐤營?꺀?쇻꺂?ⓨ랩?녈겗?ф빊??\n * ?앫겗?얇겲?숃짒?ヨ펹?쎼굥?귚틠轝꾠겗塋?깿?삡릎鸚?〃??풏?γ겑?듽굤?섆???ク?ⓩ쑍?겹겓\r\n * ?녈겳渦쇈??귛푶??뀲轝꾠겎訝?ㅳ겓?껁겂?╉걚?뗨〃?졼걨?믥▶若싥걲?뗣?\n */\r\nfunction positionalGirderMain(\r\n  cells: Array<{ position: string; rawPosition?: string }>,\r\n  top: ParsedBar[],\r\n  bottom: ParsedBar[],\r\n):\r\n  | { girderMain: NonNullable<SectionCandidate['girderMain']> }\r\n  | {\r\n      girderMainAsymmetric: NonNullable<\r\n        SectionCandidate['girderMainAsymmetric']\r\n      >\r\n    }\r\n  | { issue: CandidateIssue }\r\n  | undefined {\r\n  const zones = cells.map(({ position }) => positionZone(position))\r\n  if (zones.some((zone) => zone === undefined)) return undefined\r\n\r\n  // 藥?ク?삡릎鸚?꺕?녕ク??툒轝꾠겎?ゃ걚烏ⓦ겘?곩랩?녜씆野양㎞??ク?ⓦ겏?쀣겍?띹㎗?덀걮?ゃ걚??\n  // 塋?깿?삡릎鸚?겗雅뚧쵂??풏?γ겑?듽굤?곩뜕訝??ク?ⓩ쑍?겹겏?쀣겍?긱걝??\n  const asymmetricLayout = isThreePositionLayout(cells)\r\n  if (cells.length === 3 && !asymmetricLayout) return undefined\r\n\r\n  const pick = (bars: ParsedBar[], zone: '塋?깿' | '訝?ㄾ') =>\r\n    bars.filter((_, index) => zones[index] === zone)\r\n  const endTop = pick(top, '塋?깿')\r\n  const endBottom = pick(bottom, '塋?깿')\r\n  const centerTopCount = uniqueCount(pick(top, '訝?ㄾ'))\r\n  const centerBottomCount = uniqueCount(pick(bottom, '訝?ㄾ'))\r\n  if (\r\n    centerTopCount === undefined ||\r\n    centerBottomCount === undefined ||\r\n    endTop.length === 0 ||\r\n    endBottom.length === 0\r\n  ) {\r\n    if (\r\n      endTop.length > 0 &&\r\n      uniqueCount(endTop) === undefined &&\r\n      !asymmetricLayout\r\n    ) {\r\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\r\n    }\r\n    if (\r\n      endBottom.length > 0 &&\r\n      uniqueCount(endBottom) === undefined &&\r\n      !asymmetricLayout\r\n    ) {\r\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\r\n    }\r\n    return undefined\r\n  }\r\n\r\n  const size = top[0]?.size\r\n  if (size === undefined) return undefined\r\n  if (![...top, ...bottom].every((bar) => bar.size === size)) return undefined\r\n\r\n  if (!asymmetricLayout) {\r\n    const endTopCount = uniqueCount(endTop)\r\n    const endBottomCount = uniqueCount(endBottom)\r\n    if (endTopCount === undefined || endBottomCount === undefined) {\r\n      return { issue: '訝사춮塋?깿藥?뤂?면걬' }\r\n    }\r\n    return {\r\n      girderMain: {\r\n        size,\r\n        topCount: centerTopCount,\r\n        bottomCount: centerBottomCount,\r\n        endTopCount,\r\n        endBottomCount,\r\n      },\r\n    }\r\n  }\r\n\r\n  const endTopCounts = [top[0]?.count, top[2]?.count] as const\r\n  const endBottomCounts = [bottom[0]?.count, bottom[2]?.count] as const\r\n  if (\r\n    endTopCounts[0] === undefined ||\r\n    endTopCounts[1] === undefined ||\r\n    endBottomCounts[0] === undefined ||\r\n    endBottomCounts[1] === undefined\r\n  ) {\r\n    return undefined\r\n  }\r\n\r\n  const labels = [cells[0]?.position, cells[2]?.position] as const\r\n  if (labels[0] === undefined || labels[1] === undefined) return undefined\r\n\r\n  const asymmetric =\r\n    endTopCounts[0] !== endTopCounts[1] ||\r\n    endBottomCounts[0] !== endBottomCounts[1]\r\n  if (asymmetric) {\r\n    return {\r\n      girderMainAsymmetric: {\r\n        size,\r\n        labels: [labels[0], labels[1]],\r\n        topCounts: [endTopCounts[0], endTopCounts[1]],\r\n        bottomCounts: [endBottomCounts[0], endBottomCounts[1]],\r\n        topCenterCount: centerTopCount,\r\n        bottomCenterCount: centerBottomCount,\r\n      },\r\n    }\r\n  }\r\n\r\n  return {\r\n    girderMain: {\r\n      size,\r\n      topCount: centerTopCount,\r\n      bottomCount: centerBottomCount,\r\n      endTopCount: endTopCounts[0],\r\n      endBottomCount: endBottomCounts[0],\r\n    },\r\n  }\r\n}\r\n\r\nfunction setGirderMain(\r\n  candidate: SectionCandidate,\r\n  topLabel: string,\r\n  bottomLabel: string,\r\n  topCells: Array<{ position: string; rawPosition?: string; raw: string }>,\r\n  bottomCells: Array<{\r\n    position: string\r\n    rawPosition?: string\r\n    raw: string\r\n  }>,\r\n  expectedCellCount: number,\r\n): void {\r\n  if (topCells.length === 0 && bottomCells.length === 0) return\r\n  const top = topCells.map(({ raw }) => parseBar(raw))\r\n  const bottom = bottomCells.map(({ raw }) => parseBar(raw))\r\n  const allParsed = [...top, ...bottom].every(\r\n    (entry): entry is ParsedBar => entry !== undefined,\r\n  )\r\n  const complete =\r\n    top.length > 0 &&\r\n    bottom.length > 0 &&\r\n    (expectedCellCount === 0 ||\r\n      (top.length === expectedCellCount && bottom.length === expectedCellCount))\r\n  // 鵝띸쉰??洹좎씪?쒕뜲 訝듾툔 孃꾨쭔 ?ㅻⅨ(?ㅻТ?먯꽌 ?뷀븳) ????뚥퐤營?쎑?뺛띾줈 紐곕㈃\r\n  // ?ъ슜?먭? ?먯씤???ㅼ씤?쒕떎 ???꾩슜 ?ъ쑀 肄붾뱶濡?援щ텇?쒕떎\r\n  let sizeMismatch = false\r\n  let positionalIssue: CandidateIssue | undefined\r\n  if (complete && allParsed) {\r\n    const parsedTop = top as ParsedBar[]\r\n    const parsedBottom = bottom as ParsedBar[]\r\n    const firstTop = parsedTop[0]\r\n    const firstBottom = parsedBottom[0]\r\n    const topUniform =\r\n      firstTop !== undefined &&\r\n      parsedTop.every(\r\n        (entry) =>\r\n          entry.count === firstTop.count && entry.size === firstTop.size,\r\n      )\r\n    const bottomUniform =\r\n      firstBottom !== undefined &&\r\n      parsedBottom.every(\r\n        (entry) =>\r\n          entry.count === firstBottom.count && entry.size === firstBottom.size,\r\n      )\r\n\r\n    if (topUniform && bottomUniform && firstTop.size === firstBottom.size) {\r\n      candidate.girderMain = {\r\n        size: firstTop.size,\r\n        topCount: firstTop.count,\r\n        bottomCount: firstBottom.count,\r\n      }\r\n      return\r\n    }\r\n    sizeMismatch =\r\n      topUniform && bottomUniform && firstTop.size !== firstBottom.size\r\n\r\n    // 鵝띸쉰?㎪쑍?겹걣?녴걢?뚣걼烏ⓦ귚툓訝뗣겗鵝띸쉰轝꾠걣?껁겂?╉걚?뗨〃?졼걨?믣??ⓦ걮??き?\r\n    const aligned =\r\n      topCells.length === bottomCells.length &&\r\n      topCells.every(\r\n        (cell, index) => cell.position === bottomCells[index].position,\r\n      )\r\n    const positional = aligned\r\n      ? positionalGirderMain(topCells, parsedTop, parsedBottom)\r\n      : undefined\r\n    if (positional && 'girderMain' in positional) {\r\n      candidate.girderMain = positional.girderMain\r\n      return\r\n    }\r\n    if (positional && 'girderMainAsymmetric' in positional) {\r\n      candidate.girderMainAsymmetric = positional.girderMainAsymmetric\r\n      // step 2 ?꾩뿉?????꾨낫瑜?諛섏쁺?섏? ?딆?留? ?뺤젙???꾩튂蹂?媛믪쓣 ?붾㈃?먯꽌\r\n      // ?먮Ц怨??④퍡 ?議고븷 ???덉뼱???쒕떎. 媛??먯껜??蹂꾨룄 ?꾨뱶媛 ?뺣낯?대떎.\r\n      for (const cell of topCells) {\r\n        candidate.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n          cell.raw,\r\n        )\r\n      }\r\n      for (const cell of bottomCells) {\r\n        candidate.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n          cell.raw,\r\n        )\r\n      }\r\n      // 鍮꾨?移?媛믪? ???꾨뱶??蹂댁〈?덉?留? 諛⑺뼢???좏깮?섍린 ?꾩씤 ???④퀎?먯꽌??\n      // girderMain?쇰줈 諛섏쁺?????녿떎. 湲곗〈 痍⑥엯 ?붾㈃??李⑤떒 ?덈궡瑜??좎??쒕떎.\r\n      addIssue(candidate, '訝사춮塋?깿藥?뤂?면걬')\r\n      return\r\n    }\r\n    positionalIssue = positional?.issue\r\n  }\r\n\r\n  for (const cell of topCells) {\r\n    candidate.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(cell.raw)\r\n  }\r\n  for (const cell of bottomCells) {\n    candidate.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(cell.raw)\n  }\n  const twoLayerMain = [...topCells, ...bottomCells].some(({ raw }) =>\n    isTwoLayerBar(raw),\n  )\n  addIssue(\n    candidate,\n    positionalIssue ??\n      (sizeMismatch\r\n        ? '訝사춮訝듾툔孃꾤쎑??\r\n        : allParsed && complete\n          ? '訝사춮鵝띸쉰?면걬'\n          : !allParsed\n            ? twoLayerMain\n              ? '2餘든춮?ゅ?恙?\n              : '訝사춮鰲ｉ뇠訝띹꺗'\n            : '訝사춮鵝띸쉰轝좄맼'),\n  )\n}\n\r\nfunction setPitch(\r\n  candidate: SectionCandidate,\r\n  key: 'hoop' | 'stirrup',\r\n  label: string,\r\n  raw: string | undefined,\r\n  folded: string | undefined,\r\n): void {\r\n  // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????躍?춮 ?붵긿?곴? 以꾨쭏???ㅻⅤ硫??ф빊媛 ?由곕떎.\r\n  // 訝사춮怨?媛숈? 洹쒖빟?쇰줈 泥?以꾩씠 ?녿뒗 寃쎌슦瑜??섎늿?????묓옒 ?놁씠???댁븘?⑤뒗 寧?뤇??\n  // ?앷릿 ?ㅻ줈???뚯뾾???섏㎏ 以꾩쓣 李얠븘蹂대씪?띾뒗 ?덈궡媛 ?ㅼ젣濡??꾨떖?쒕떎\r\n  if (folded !== undefined) {\r\n    const wrapped = raw !== undefined && raw.length > 0\r\n    if (wrapped) candidate.raw[label] = cleanedRebarRaw(raw as string)\r\n    candidate.raw[`${label}(${wrapped ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`] =\r\n      cleanedRebarRaw(folded)\r\n    addIssue(candidate, wrapped ? '躍?춮?섋퓭?? : '躍?춮?⒲깧?ヨ죱鸚?)\r\n    return\r\n  }\r\n  if (!raw) return\r\n  const parsed = parsePitch(raw)\n  if (parsed) {\n    const shape = decorationPrefix(raw)\n    if (shape !== undefined) candidate.raw[`${label}壤®듁`] = shape\n    candidate[key] = parsed\n    return\n  }\n\r\n  candidate.raw[label] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '躍?춮鰲ｉ뇠訝띹꺗')\r\n}\r\n\r\nfunction setSideBar(\n  candidate: SectionCandidate,\n  raw: string | undefined,\n): void {\n  if (raw === undefined) return\r\n  const value = compact(raw)\r\n  // 令뷸쵂?삥Ø渶싥겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲겏?꾠걝閭ｅ만?ゅ쎋?℡ㅳ겎?귙굤?곮き?뽩ㅁ?쀣겎??겒?꾠?\n  if (value === '' || /^[-??+$/.test(value)) return\r\n\r\n  // 訝사춮?ⓨ릪???ф빊-孃??뉑퀡?믢슴?녴귟끃嶺뗣겘遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣굮?뽧굢?ゃ걚??\n  const parsed = parseBar(raw)\r\n  if (parsed) {\r\n    candidate.sideBar = parsed\r\n    return\r\n  }\r\n\r\n  candidate.raw['?밭춮'] = cleanedRebarRaw(raw)\r\n  addIssue(candidate, '?밭춮鰲ｉ뇠訝띹꺗')\n}\n\nfunction setWidthTie(\n  candidate: SectionCandidate,\n  label: string,\n  raw: string | undefined,\n): void {\n  if (raw === undefined) return\n  const parsed = parsePitch(raw)\n  if (parsed && barSizes.has(parsed.size as BarSize)) {\n    candidate.widthTie = {\n      size: parsed.size as BarSize,\n      pitchMm: parsed.pitchMm,\n    }\n    return\n  }\n  candidate.raw[label] = cleanedRebarRaw(raw)\n  addIssue(candidate, '亮끾??곭춮鰲ｉ뇠訝띹꺗')\n}\n\r\ninterface WallMarkGroup {\r\n  marks: string[]\r\n  centerX: number\r\n}\r\n\r\nconst WALL_MARK_PATTERN = /(?:EW\\d+[A-Z]?|W\\d+[A-Z]?)/gi\r\nconst SLAB_MARK_PATTERN = /^(?:S|FS|CS)\\d+[A-Z]?$/i\r\n\r\nfunction marksInText(value: string): string[] {\r\n  return [...value.matchAll(WALL_MARK_PATTERN)].map((match) =>\r\n    match[0].toUpperCase(),\r\n  )\r\n}\r\n\r\nfunction wallMarkGroups(row: TextRow): WallMarkGroup[] {\r\n  const labels = row.segments.filter((segment) => segment.compact === '寧?뤇')\r\n  for (const label of [...labels].reverse()) {\r\n    const groups = row.segments\r\n      .filter((segment) => segment.x > label.endX)\r\n      .flatMap((segment) => {\r\n        const marks = marksInText(segment.compact)\r\n        return marks.length > 0 ? [{ marks, centerX: segment.centerX }] : []\r\n      })\r\n    if (groups.length > 0) return groups\r\n  }\r\n  return []\r\n}\r\n\r\nfunction valuesForWallGroups(\r\n  row: TextRow,\r\n  labelText: string,\r\n  groups: WallMarkGroup[],\r\n  split: (text: string) => string[],\r\n  valueRow: TextRow = row,\r\n): Map<string, string> {\r\n  const label = [...row.segments]\r\n    .reverse()\r\n    .find((segment) => segment.compact === labelText)\r\n  if (!label) return new Map()\r\n\r\n  const values = valueRow.segments.filter((segment) =>\r\n    valueRow === row ? segment.x > label.endX : true,\r\n  )\r\n  const result = new Map<string, string>()\r\n  for (const segment of values) {\r\n    const covered = groups.filter(\r\n      (group) => group.centerX >= segment.x && group.centerX <= segment.endX,\r\n    )\r\n    if (covered.length === 0) continue\r\n    const parts = split(segment.text)\r\n    if (covered.length === parts.length) {\r\n      covered.forEach((group, index) => {\r\n        for (const mark of group.marks) result.set(mark, parts[index])\r\n      })\r\n      continue\r\n    }\r\n    if (covered.length === 1 && parts.length === covered[0].marks.length) {\r\n      covered[0].marks.forEach((mark, index) => result.set(mark, parts[index]))\r\n      continue\r\n    }\r\n    // A single mark with two thicknesses is ambiguous. Keep the complete cell\r\n    // for every mark in the group; the caller will leave the typed field empty.\r\n    for (const group of covered) {\r\n      for (const mark of group.marks) result.set(mark, segment.text)\r\n    }\r\n  }\r\n  return result\r\n}\r\n\r\nfunction wallThicknessParts(text: string): string[] {\r\n  return normalized(text)\r\n    .split(',')\r\n    .map((value) => value.trim())\r\n    .filter((value) => value.length > 0)\r\n}\r\n\r\nfunction wallBarParts(text: string): string[] {\r\n  const value = compact(text)\r\n  if (/[?삼쉈]/.test(value) || /[A-Z]\\d+[A-Z]\\d+/i.test(value)) return []\r\n  return value.match(/[A-Z]\\d+-?@\\d+(?:\\([^)]*\\))?/gi) ?? []\r\n}\r\n\r\nfunction parseWallBar(value: string):\r\n  | { size: BarSize; pitchMm: number; layers: 1 | 2 }\r\n  | undefined {\r\n  const match = compact(value).match(\r\n    /^([A-Z]\\d+)-?@(\\d+)(?:\\(([^)]*)\\))?$/i,\r\n  )\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  if (!barSizes.has(size) || pitchMm <= 0) return undefined\r\n  const note = match[3]\r\n  if (!note) return undefined\r\n  const layers = /??뽧꺂|絶絶욑풄絶욑풖/.test(normalized(note)) ? 2 : /?룔꺍?겹꺂/.test(note) ? 1 : undefined\r\n  return layers === undefined ? undefined : { size, pitchMm, layers }\r\n}\r\n\r\nfunction parseWallBlock(\r\n  rows: TextRow[],\r\n  titleText: string,\r\n  endY: number,\r\n): SectionCandidate[] {\r\n  const header = rows.find((row) => wallMarkGroups(row).length > 0)\r\n  if (!header) return []\r\n  const groups = wallMarkGroups(header)\r\n  const bodyRows = rows.filter((row) => row.y > header.y && row.y < endY)\r\n  const dimensionRow = bodyRows\r\n    .filter((row) =>\r\n      row.segments.some((segment) => segment.compact === '??씊'),\r\n    )\r\n    .at(-1)\r\n  const verticalRow = bodyRows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '潁?춮'),\r\n  )\r\n  const horizontalRow = bodyRows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '與ょ춮'),\r\n  )\r\n  if (!dimensionRow && !verticalRow && !horizontalRow) return []\r\n\r\n  const dimensionValueRow = dimensionRow\r\n    ? bodyRows.find(\r\n        (row) =>\r\n          row.y > dimensionRow.y &&\r\n          row.y < (verticalRow?.y ?? endY) &&\r\n          row.segments.some((segment) =>\r\n            groups.some(\r\n              (group) =>\r\n                group.centerX >= segment.x && group.centerX <= segment.endX,\r\n            ),\r\n          ),\r\n      )\r\n    : undefined\r\n  const thicknesses = dimensionRow\r\n    ? valuesForWallGroups(\r\n        dimensionRow,\r\n        '??씊',\r\n        groups,\r\n        wallThicknessParts,\r\n        dimensionValueRow,\r\n      )\r\n    : new Map<string, string>()\r\n  const verticals = verticalRow\r\n    ? valuesForWallGroups(verticalRow, '潁?춮', groups, wallBarParts)\r\n    : new Map<string, string>()\r\n  const horizontals = horizontalRow\r\n    ? valuesForWallGroups(horizontalRow, '與ょ춮', groups, wallBarParts)\r\n    : new Map<string, string>()\r\n\r\n  return groups.flatMap(({ marks }) =>\r\n    marks.map((mark): SectionCandidate => {\r\n      const candidate: SectionCandidate = {\r\n        kind: isOutOfScopeList(titleText) ? '野얕괌鸚? : '?먬쐡鶯?,\r\n        mark,\r\n        raw: {},\r\n        issues: [],\r\n      }\r\n      const thickness = thicknesses.get(mark)\r\n      if (thickness && /^\\d+$/.test(thickness)) {\r\n        candidate.thickness = Number(thickness)\r\n      } else if (thickness) {\r\n        candidate.raw['??씊'] = thickness\r\n        addIssue(candidate, '鶯곩럻?면걬')\r\n      }\r\n\r\n      const setBar = (\r\n        role: 'vertical' | 'horizontal',\r\n        value: string | undefined,\r\n      ) => {\r\n        if (value === undefined) return\r\n        const parsed = parseWallBar(value)\r\n        if (!parsed) {\r\n          candidate.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'] = value\r\n          addIssue(candidate, '鶯곭춮鰲ｉ뇠訝띹꺗')\r\n          return\r\n        }\r\n        if (candidate.layers !== undefined && candidate.layers !== parsed.layers) {\r\n          candidate.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'] = value\r\n          addIssue(candidate, '鶯곭춮鰲ｉ뇠訝띹꺗')\r\n          return\r\n        }\r\n        candidate[role] = { size: parsed.size, pitchMm: parsed.pitchMm }\r\n        candidate.layers = parsed.layers\r\n      }\r\n      setBar('vertical', verticals.get(mark))\r\n      setBar('horizontal', horizontals.get(mark))\r\n      return candidate\r\n    }),\r\n  )\r\n}\r\n\r\nfunction slabMark(row: TextRow): { mark: string; centerX: number } | undefined {\r\n  const segment = row.segments.find((candidate) =>\r\n    SLAB_MARK_PATTERN.test(candidate.compact),\r\n  )\r\n  return segment\r\n    ? { mark: segment.compact.toUpperCase(), centerX: segment.centerX }\r\n    : undefined\r\n}\r\n\r\nfunction slabBarCell(row: TextRow, centerX: number): TextSegment | undefined {\r\n  return row.segments\r\n    .filter((segment) => /@\\d+/.test(compact(segment.text)))\r\n    .sort(\r\n      (left, right) =>\r\n        Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n    )[0]\r\n}\r\n\r\nfunction parseSlabBar(value: string): { size: BarSize; pitchMm: number } | undefined {\r\n  const match = compact(value).match(/^([A-Z]\\d+)-?@(\\d+)$/i)\r\n  if (!match) return undefined\r\n  const size = match[1].toUpperCase() as BarSize\r\n  const pitchMm = Number(match[2])\r\n  return barSizes.has(size) && pitchMm > 0 ? { size, pitchMm } : undefined\r\n}\r\n\r\nfunction slabThickness(row: TextRow, centerX: number): number | undefined {\r\n  const value = row.segments\r\n    .filter((segment) => /^\\d[\\d,]*$/.test(compact(segment.text)))\r\n    .sort(\r\n      (left, right) =>\r\n        Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n    )[0]\r\n    ?.compact\r\n  return value === undefined ? undefined : Number(value.replace(/,/g, ''))\r\n}\r\n\r\nfunction nextHeaderY(rows: TextRow[], endY: number): number | undefined {\r\n  return rows.find(\r\n    (row) =>\r\n      row.y >= endY &&\r\n      row.segments.some((segment) => segment.compact.startsWith('寧?뤇')) &&\r\n      !row.segments.some((segment) =>\r\n        /??씌?밧릲|?룩씌?밧릲/.test(segment.compact),\r\n      ),\r\n  )?.y\r\n}\r\n\r\nfunction parseSlabBlock(\r\n  rows: TextRow[],\r\n  anchor: TitleAnchor,\r\n  endY: number,\r\n): SectionCandidate[] {\r\n  const directionHeader = rows.find((row) =>\r\n    row.segments.some((segment) => segment.compact === '??씌?밧릲') &&\r\n    row.segments.some((segment) => segment.compact === '?룩씌?밧릲'),\r\n  )\r\n  const shortX = directionHeader?.segments.find(\r\n    (segment) => segment.compact === '??씌?밧릲',\r\n  )?.centerX\r\n  const longX = directionHeader?.segments.find(\r\n    (segment) => segment.compact === '?룩씌?밧릲',\r\n  )?.centerX\r\n  if (shortX === undefined || longX === undefined) return []\r\n\r\n  const initialRows = rows.filter((row) => row.y > anchor.row.y)\r\n  const firstMark = initialRows.map(slabMark).find(\r\n    (mark): mark is { mark: string; centerX: number } => mark !== undefined,\r\n  )\r\n  if (!firstMark) return []\r\n  const markRows = initialRows\r\n    .map((row) => ({ row, mark: slabMark(row) }))\r\n    .filter(\r\n      (entry): entry is { row: TextRow; mark: { mark: string; centerX: number } } =>\r\n        entry.mark !== undefined &&\r\n        Math.abs(entry.mark.centerX - firstMark.centerX) <\r\n          Math.max(20, Math.abs(shortX - firstMark.centerX)),\r\n    )\r\n  const bridgeTitle = rows.find(\r\n    (row) =>\r\n      Math.abs(row.y - endY) < 0.01 &&\r\n      row.segments.some((segment) => /鶯곥꺁?밤깉/.test(segment.compact)),\r\n  )\r\n  const scanEnd = bridgeTitle ? nextHeaderY(rows, endY) ?? endY : endY\r\n  const candidates = markRows.filter(({ row }) => row.y < scanEnd)\r\n  if (candidates.length === 0) return []\r\n\r\n  const thicknessHeader = rows.find((row) =>\r\n    row.segments.some((segment) => /佯듿럻|?밤꺀?뽩럻/.test(segment.compact)),\r\n  )\r\n  const thicknessX =\r\n    thicknessHeader?.segments.find((segment) =>\r\n      /佯듿럻|?밤꺀?뽩럻/.test(segment.compact),\r\n    )?.centerX ?? firstMark.centerX\r\n  const outOfScope = isOutOfScopeList(anchor.titleText)\r\n\r\n  return candidates.map(({ row, mark }, index) => {\r\n    const nextY = candidates[index + 1]?.row.y ?? scanEnd\r\n    const cantilever =\r\n      mark.mark.startsWith('CS') &&\r\n      rows.some(\r\n        (candidateRow) =>\r\n          candidateRow.y >= row.y - 1 &&\r\n          candidateRow.y < nextY &&\r\n          candidateRow.segments.some((segment) =>\r\n            segment.compact.includes('?뉑똻?▲궧?⒲깣'),\r\n          ),\r\n      )\r\n    const candidate: SectionCandidate = {\r\n      kind: outOfScope || cantilever ? '野얕괌鸚? : '佯딀씮',\r\n      mark: mark.mark,\r\n      raw: {},\r\n      issues: [],\r\n    }\r\n    const sectionRows = rows.filter(\r\n      (candidateRow) => candidateRow.y > row.y - 20 && candidateRow.y < nextY,\r\n    )\r\n    const thickness = slabThickness(row, thicknessX)\r\n    if (!outOfScope && thickness !== undefined) candidate.thickness = thickness\r\n\r\n    if (outOfScope || cantilever) return candidate\r\n\r\n    const faceRows = new Map<'top' | 'bottom', TextRow>()\r\n    for (const face of ['top', 'bottom'] as const) {\r\n      const labels = face === 'top' ? ['訝딁ク嶺?, '訝딁춮'] : ['訝뗧ク嶺?, '訝뗧춮']\r\n      const faceRow = sectionRows\r\n        .filter((candidateRow) =>\r\n          candidateRow.segments.some((segment) =>\r\n            labels.includes(segment.compact),\r\n          ),\r\n        )\r\n        .sort((left, right) => Math.abs(left.y - row.y) - Math.abs(right.y - row.y))[0]\r\n      if (faceRow) faceRows.set(face, faceRow)\r\n    }\r\n\r\n    for (const [face, faceRow] of faceRows) {\r\n      for (const [axis, centerX] of [\r\n        ['??씌?밧릲', shortX],\r\n        ['?룩씌?밧릲', longX],\r\n      ] as const) {\r\n        const cell = slabBarCell(faceRow, centerX)\r\n        const key = axis === '??씌?밧릲' ? 'shortSide' : 'longSide'\r\n        const rawKey = `${axis}(${face})`\r\n        if (!cell) continue\r\n        const parsed = parseSlabBar(cell.text)\r\n        if (!parsed) {\r\n          candidate.raw[rawKey] = cell.text\r\n          addIssue(candidate, '佯딀씮嶺뗨㎗?덁툖??)\r\n          continue\r\n        }\r\n        candidate[key] = {\r\n          ...candidate[key],\r\n          [face]: parsed,\r\n        }\r\n      }\r\n    }\r\n    return candidate\r\n  })\r\n}\r\n\r\nfunction rowsBetween(rows: TextRow[], startY: number, endY: number): TextRow[] {\r\n  return rows.filter((row) => row.y > startY && row.y < endY)\r\n}\r\n\r\n// ?굿룟ㄷ歟?釉붾줉???뚮젮吏??쇰꺼 ???꾨? ???묓옒 媛먯????뚮떎???쇰꺼 ?됥??먯젙???대떎.\r\nconst ROW_LABELS = [\n  '訝사춮',\n  '躍?춮',\n  'HOOP',\n  '?뺛꺖??,\n  '?ε릦?ⓨ릭嶺?,\n  '??씊',\r\n  '鵝띸쉰',\r\n  '訝딁춮',\r\n  '訝딁ク嶺?,\r\n  '訝뗧춮',\r\n  '訝뗧ク嶺?,\r\n  'ST',\n  'STP',\n  'STP.',\n  '?귙겙?됬춮',\n  '?밤궭?쇈꺀?껁깤',\n  'B횞D',\n  'b횞D',\n  '壤®듁??씊',\n  '野멩퀡',\n  '?밭춮',\n  '亮끾?嶺?,\n  '藥얏?嶺?,\n  '亮끾??곭춮',\n  '?숃?,\n] as const\n\r\n/** ?ф빊-孃??좏겙(訝사춮 ?)怨?孃??붵긿???좏겙(躍?춮쨌?귙겙?됬춮 ?)??援щ텇???묓옒??李얜뒗?? */\r\nconst BAR_TOKEN = /\\d+-?D\\d+/i\r\n\r\nconst PITCH_TOKEN = /D\\d+-?@\\d+/i\r\n\r\n/**\r\n * ?쇰꺼 ?됯낵 ?ㅼ쓬 ?쇰꺼 ???ъ씠??臾대씪踰??됱뿉???꾤춮 ?좏겙??留덊겕蹂꾨줈 紐⑥???\r\n * ? ?댁슜??以꾨컮轅덉쑝濡??묓엳硫??섏㎏ 以꾩? 蹂꾨룄 ?됱씠 ?섏뼱 ?쇰꺼 ?됰쭔 ?쎈뒗 寃쎈줈?먯꽌\r\n * 議곗슜???щ씪吏꾨떎 ??泥?以꾨쭔?쇰줈 ?뺤젙?섎㈃ 2餘든춮 嫄곕? 諛⑹묠??以꾨컮轅?蹂?뺤뿉???뚮떎.\r\n */\r\nfunction barContinuationByMark(\r\n  dataRows: TextRow[],\r\n  labelRow: TextRow,\r\n  endY: number,\r\n  marks: MarkColumn[],\r\n  token: RegExp,\r\n): Map<string, string> {\r\n  const nextLabelY = dataRows\r\n    .filter((row) => row.y > labelRow.y && exactLabel(row, ROW_LABELS))\r\n    .reduce((min, row) => Math.min(min, row.y), endY)\r\n  const merged = new Map<string, string>()\r\n\r\n  for (const row of dataRows) {\r\n    if (row.y <= labelRow.y || row.y >= nextLabelY) continue\r\n    if (exactLabel(row, ROW_LABELS)) continue\r\n    const barSegments = row.segments.filter((segment) =>\r\n      token.test(segment.compact),\r\n    )\r\n    if (barSegments.length === 0) continue\r\n    const values = valuesAtTargets(\r\n      barSegments,\r\n      marks.map(({ mark, centerX }) => ({ id: mark, centerX })),\r\n    )\r\n    for (const [mark, value] of values) {\r\n      const existing = merged.get(mark)\r\n      merged.set(mark, existing ? `${existing}/${value}` : value)\r\n    }\r\n  }\r\n\r\n  return merged\r\n}\r\n\r\nfunction lastPositionRow(\r\n  rows: TextRow[],\r\n  headerY: number,\r\n  beforeY: number,\r\n): TextRow | undefined {\r\n  return rows\r\n    .filter(\r\n      (row) =>\r\n        row.y > headerY && row.y < beforeY && exactLabel(row, ['鵝띸쉰']),\r\n    )\r\n    .at(-1)\r\n}\r\n\r\n/**\r\n * ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖쓽 ?ㅼ?移?媛濡?移섏닔. 李쎌쓽 ?섑븳? ?몄떇???곗씠???쇰꺼 ??以?\n * 媛???꾨떎 ???쇰꺼 ?섎굹?먮쭔 留ㅼ뼱 ?먮㈃ 洹??쇰꺼??紐??쎌? ?쒖뿉??李쎌씠 ?щ씪?댁뒪 ?꾩껜濡?\n * ?대젮 ?꾨옒 ???숃??????⑤룆 ?レ옄媛 移섏닔濡??뺤젙?쒕떎. ?쇰꺼 ?됱쓣 ?섎굹???몄떇?섏?\r\n * 紐삵뻽?쇰㈃ 洹??쒖뿉???쎌? 寃껋씠 ?녿떎???살씠誘濡??대갚???뚮━吏 ?딅뒗??\r\n *\r\n * ?곹븳???щ씪?댁뒪??endY瑜???諛쏆? ?딅뒗????labelRows???꾨? rowsBetween(rows,\r\n * slice.startY, slice.endY)?먯꽌 ?섏삤誘濡???긽 y < slice.endY?? 洹?endY瑜??ㅼ떆\r\n * Math.min???ｌ뼱???덈? ?좏깮?????놁뼱 ?덉????딆? ?곹븳 蹂댄샇泥섎읆 ?쏀삍??(#35)\r\n */\r\nfunction sketchDimensions(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  labelRows: Array<TextRow | undefined>,\r\n  anchors: MarkColumn[],\r\n): Map<string, string> {\r\n  const labelYs = labelRows.flatMap((row) => (row ? [row.y] : []))\r\n  if (labelYs.length === 0) return new Map()\r\n  return scalarDimensions(rows, startY, Math.min(...labelYs), anchors)\r\n}\r\n\r\n/**\r\n * ?ㅼ?移?移섏닔瑜?諛곗젙?????듭빱. 鵝띸쉰 ?댁씠 ?덉쑝硫?洹멸쾬?대떎 ??寧?뤇 ?쇰꺼? 移?以묒븰??\n * ?볦씠吏留?移???? 遺?щ쭏???щ씪?? 以묒떖 ?ъ씠 以묒젏??寃쎄퀎濡??곕㈃ 醫곸? 移몄씠 ?볦? 移몄쓽\r\n * ?앹쓣 癒밸뒗?? ?ㅻЪ ojkk 鸚㎪쥈?먯꽌 G3(??85) ??G4(??42.5)媛 G3???몃줈 移섏닔瑜?\n * 媛?멸컮?? 鵝띸쉰 ?댁? 移몄쓣 ?ㅼ젣濡???쇰쭅?섎?濡???씠 ?ㅻⅨ ?댁썐怨?遺숈뼱???닿툔?섏? ?딅뒗??\r\n */\r\nfunction markAnchors(\n  marks: MarkColumn[],\n  positions: PositionColumn[],\n): MarkColumn[] {\n  const seenGroups = new Set<string>()\n  return marks.flatMap(({ mark, centerX, groupKey, rawCell }) => {\n    if (seenGroups.has(groupKey)) return []\n    seenGroups.add(groupKey)\n    const own = positions.filter((position) => position.mark === mark)\n    return own.length > 0\n      ? own.map((position) => ({ mark, centerX: position.centerX, groupKey, rawCell }))\n      : [{ mark, centerX, groupKey, rawCell }]\n  })\n}\n\n/** ?뚣걯寧?뤇?삠꺂?뗣굢 ?쇱튇 遺?몃뒗 ?ㅼ?移?移섏닔???섎굹???듭빱瑜?怨듭쑀?쒕떎. ?듭빱 ?⑥닔媛\n * 泥?遺???섎굹留?諛섑솚?섎?濡? 洹?寃곌낵瑜??ㅼ젣 ?꾨낫 ?꾨???蹂듭젣?쒕떎. ??????쎈뒗\n * valuesByMark???대? ???꾧컻瑜??섑뻾?섎?濡??ㅼ?移?寃쎈줈?먮쭔 ?곸슜?쒕떎.\n */\nfunction expandMarkGroups(\n  values: Map<string, string>,\n  marks: MarkColumn[],\n): Map<string, string> {\n  const firstByGroup = new Map<string, string>()\n  for (const { mark, groupKey } of marks) {\n    if (!firstByGroup.has(groupKey)) firstByGroup.set(groupKey, mark)\n  }\n  return new Map(\n    marks.flatMap(({ mark, groupKey }) => {\n      const first = firstByGroup.get(groupKey)\n      const value = first === undefined ? undefined : values.get(first)\n      return value === undefined ? [] : [[mark, value] as const]\n    }),\n  )\n}\n\r\n/**\r\n * ?듭빱蹂?嫄곕━ ?곹븳. 移?寃쎄퀎?????듭빱 ?ъ씠???덉쑝誘濡??듭빱?먯꽌 寃쎄퀎源뚯???嫄곕━??洹?\n * ?댁썐源뚯???媛꾧꺽蹂대떎 吏㏓떎 ???곹븳???댁썐 媛꾧꺽?쇰줈 ?〓뒗?? ?댁썐蹂꾨줈 ?щ뒗 ?댁쑀??移???씠\r\n * ?대쭏???щ씪?쒕떎: 媛꾧꺽??以묒븰媛믪쓣 ?곕㈃ ?먭린 移몄씠 ?⑤뱾蹂대떎 ?볦? ?댁뿉???ㅻЪ 媛믪씠\r\n * ?섎━怨?ojkk ??FC1? ?댁썐 媛꾧꺽 85.1???ㅼ륫 51.7), 醫뚯슦 以???履쎌쓣 ?곕㈃ 珥섏킌???댁씠\r\n * 諛섎???癒??댁쓽 ?곹븳??臾쇰젮諛쏆븘 ?????ъ씠 鍮????퉴吏 癒밸뒗??\r\n *\r\n * ?듭빱媛 ?섎굹肉먯씠硫?媛꾧꺽???놁뼱 ?곹븳??Infinity媛 ?쒕떎 ???몃줈 吏앹쭞湲곕뒗 寧?뤇 2媛?\n * ?댁긽???곕줈 ?붽뎄?섍퀬, 媛濡쒕뒗 ?쇰꺼 ?????쑝濡??대? 醫곹????덉쑝硫? ? 媛믪? ?댁씠\r\n * ?섎굹硫?洹??댁씠 ???꾩껜瑜?諛쏅뒗 寃껋씠 留욌떎.\r\n */\r\nfunction boundedAnchors<T extends { centerX: number }>(\r\n  anchors: T[],\r\n): Array<T & { limit: number }> {\r\n  const sorted = [...anchors].sort(\r\n    (left, right) => left.centerX - right.centerX,\r\n  )\r\n  return sorted.map((anchor, index) => {\r\n    const gaps = [\r\n      index > 0 ? anchor.centerX - sorted[index - 1].centerX : undefined,\r\n      index + 1 < sorted.length\r\n        ? sorted[index + 1].centerX - anchor.centerX\r\n        : undefined,\r\n    ].filter((gap): gap is number => gap !== undefined)\r\n    return { ...anchor, limit: Math.min(...gaps) }\r\n  })\r\n}\r\n\r\nfunction scalarDimensions(\r\n  rows: TextRow[],\r\n  startY: number,\r\n  endY: number,\r\n  marks: MarkColumn[],\r\n): Map<string, string> {\r\n  if (marks.length === 0) return new Map()\r\n  const numericSegments = rows\r\n    .filter((row) => row.y > startY && row.y < endY)\r\n    .flatMap((row) => row.segments)\r\n    .filter((segment) => /^\\d[\\d\\s,]*$/.test(normalized(segment.text)))\r\n\r\n  // ?대떦 ?レ옄 ?멸렇癒쇳듃媛 ?뺥솗??1媛쒖씪 ?뚮쭔 ?섍릿????2媛??댁긽???댁뼱遺숈씠硫?\n  // ??00????00?띿씠 700900mm媛 ?쒕떎. ?섍릿 媛믩룄 b횞d濡??뺤젙?섏????딄퀬\r\n  // setDimension?먯꽌 鍮덉뭏+?먮Ц 李멸퀬濡??⑤뒗??\r\n  const perMark = new Map<string, string[]>()\r\n  const bounded = boundedAnchors(marks)\r\n  for (const segment of numericSegments) {\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - segment.centerX) <\r\n      Math.abs(closest.centerX - segment.centerX)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    // ?몃줈 ?곌낵 媛숈? ?곹븳??嫄대떎 ???쒖そ留??곹븳???놁쑝硫??ㅼ?移????쓽 ?꾨Т ?レ옄??\n    // 理쒓렐???댁뿉 遺숈뼱 ?댁뒋 ?녿뒗 ?뺤젙 b媛 ?쒕떎\r\n    if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n    const existing = perMark.get(target.mark) ?? []\r\n    existing.push(segment.compact)\r\n    perMark.set(target.mark, existing)\r\n  }\r\n\r\n  // 肄ㅻ쭏???먮┸??援щ텇?대떎(parseDimension??踰쀪꺼 諛쏅뒗?? verticalsByMark? 媛숈? 洹쒖빟) ??\n  // ?ш린????,200?띿쓣 ?レ옄媛 ?꾨땲?쇨퀬 踰꾨━硫???1,000mm ?댁긽??遺?щ? ?볦튇??\n  return new Map(\r\n    [...perMark.entries()].flatMap(([mark, values]) => {\r\n      const text = values[0].replace(/,/g, '')\r\n      return values.length === 1 && /^\\d+$/.test(text)\r\n        ? [[mark, text] as const]\r\n        : []\r\n    }),\r\n  )\r\n}\r\n\r\n/**\r\n * ?몃줈 移섏닔瑜??대퀎濡?紐⑥??? scalarDimensions? 媛숈? 洹쒖빟 ???대떦 ?뺥솗??1媛쒖씪 ?뚮쭔\r\n * ?섍릿?? ??????몃줈 ?レ옄媛 ?섏씠硫??대뒓 履쎌씠 ??씊?몄? ?먯젙??洹쇨굅媛 ?녿떎.\r\n */\r\nfunction verticalsByMark(\n  runs: VerticalRun[],\n  anchors: MarkColumn[],\n): Map<string, string> {\n  // ?쇰꺼 ?됱뿉 留ㅼ씤 媛濡?媛믨낵 ?щ━ ?몃줈 ?곗? ???대뵒?먮굹 ?덉쓣 ???덉뼱, ?곹븳???놁쑝硫?\n  // ?⑥쓽 ???レ옄媛 ???댁쓽 d濡??뺤젙?쒕떎. 寧?뤇???섎굹硫???媛꾧꺽???????녿떎 ??\n  // ?곹븳???몄슱 洹쇨굅媛 ?놁쑝??吏앹쭞吏 ?딅뒗?? ?듭빱 ?섎줈 ?щ㈃ ???쒕떎: 鵝띸쉰 ?댁씠\r\n  // ??寧?뤇???щ윭 ?듭빱濡??섎━誘濡??⑥씪 寧?뤇 ?쒖뿉?쒕룄 ?듦낵?쒕떎\r\n  if (new Set(anchors.map(({ mark }) => mark)).size < 2) return new Map()\r\n  const bounded = boundedAnchors(anchors)\r\n  const perMark = new Map<string, string[]>()\r\n\r\n  for (const run of runs) {\r\n    // 肄ㅻ쭏???먮┸??援щ텇?대떎(parseDimension??踰쀪꺼 諛쏅뒗??. ?ш린????,200?띿쓣\r\n    // ?レ옄媛 ?꾨땲?쇨퀬 踰꾨━硫?移댁슫?몄뿉?쒕룄 鍮좎졇 ?뚯뿴???뺥솗??1媛쒌?諛⑹뼱媛 ?ル┛??\n    const text = run.text.replace(/,/g, '')\r\n    if (!/^\\d+$/.test(text)) continue\r\n    const target = bounded.reduce((closest, candidate) =>\r\n      Math.abs(candidate.centerX - run.x) < Math.abs(closest.centerX - run.x)\r\n        ? candidate\r\n        : closest,\r\n    )\r\n    if (Math.abs(target.centerX - run.x) > target.limit) continue\r\n    const bucket = perMark.get(target.mark)\r\n    if (bucket) bucket.push(text)\r\n    else perMark.set(target.mark, [text])\r\n  }\r\n\r\n  return new Map(\r\n    [...perMark.entries()].flatMap(([mark, values]) =>\r\n      values.length === 1 ? [[mark, values[0]] as const] : [],\r\n    ),\r\n  )\n}\n\n/**\n * ?뚦숱?뜻뼪?㏂띲걽?묆굮誤뗥눣?쀣겓?쀣걼?밤궞?껁긽?뗣겗?김〃?뗣굢?곫Ø?ヤ를??b 野멩퀡?믤떮?녴? * ?싧만??scalarDimensions ??꺀?쇻꺂烏뚣겏訝사춮?삠깢?쇈깤烏뚣겗?볝굮沃???잆굙?곩숱?뜻뼪?? * ?뚨떖塋뗣걮?잒죱?ャ걗?뗨〃?㎯겘野멩퀡?믤뜥?╉겍?쀣겲?녴귛ㅳ겘?꾤Е?룔겗?瓦묉렏?뗣겇?ｅ닓?? * 罌껆븣?끹겓?먦굤?곩릪?섇닓??닪野멩퀡?믧ｇ탳?쀣겒?꾠? */\nfunction sketchColumnHorizontalValues(\n  rows: TextRow[],\n  startY: number,\n  endY: number,\n  anchors: MarkColumn[],\n): Map<string, string> {\n  const numeric = rows\n    .filter((row) => row.y > startY && row.y <= endY)\n    .flatMap((row) => row.segments)\n    .filter((segment) => /^\\d[\\d,]*$/.test(normalized(segment.text)))\n\n  return new Map(\n    boundedAnchors(anchors).flatMap((anchor) => {\n      const candidates = numeric.filter(\n        (segment) => Math.abs(segment.centerX - anchor.centerX) <= anchor.limit,\n      )\n      const nearest = candidates.sort(\n        (left, right) =>\n          Math.abs(left.centerX - anchor.centerX) -\n          Math.abs(right.centerX - anchor.centerX),\n      )[0]\n      if (!nearest) return []\n      return [[anchor.mark, normalized(nearest.text).replace(/,/g, '')] as const]\n    }),\n  )\n}\n\n/**\n * Fuji ??윶?밤궞?껁긽??를野멩퀡?뚣뚦숱?뜻뼪?㏂띹죱??쎍訝듽겓塋뗣겇?귝Ø野멩퀡?ⓨ릪?섇닓?? * 營?걢?뚣걼?겼ㅳ겗?녴걾?곩숱?뜻뼪?㏂겓??귟퓩?꾣객亮녈꺀?녈걽?묆굮寧?뤇?멨?恙쒌걬?쎼굥?? * ?γ겗野멩퀡?쀣굮?뚣걯 d ?ヤ슴?뤵겒?꾠걼?곥걓 ???瓦묉렏?믣뀍?ュ쎓若싥걲?뗣? */\nfunction sketchColumnVerticalValues(\n  verticals: VerticalRun[],\n  shapeY: number,\n  anchors: MarkColumn[],\n): Map<string, string> {\n  const numeric = verticals.filter((run) => /^\\d[\\d,]*$/.test(run.text))\n  if (numeric.length === 0) return new Map()\n  const nearestDistance = Math.min(\n    ...numeric.map((run) => Math.abs(run.y - shapeY)),\n  )\n  const nearestRows = numeric.filter(\n    (run) => Math.abs(Math.abs(run.y - shapeY) - nearestDistance) < 0.01,\n  )\n\n  return new Map(\n    boundedAnchors(anchors).flatMap((anchor) => {\n      const candidates = nearestRows.filter(\n        (run) => Math.abs(run.x - anchor.centerX) <= anchor.limit,\n      )\n      const nearest = candidates.sort(\n        (left, right) =>\n          Math.abs(left.x - anchor.centerX) - Math.abs(right.x - anchor.centerX),\n      )[0]\n      if (!nearest) return []\n      return [[anchor.mark, nearest.text.replace(/,/g, '')] as const]\n    }),\n  )\n}\n\r\n/**\r\n * ?몃줈 移섏닔瑜?痢??щ씪?댁뒪??諛곗젙?쒕떎. ?ㅼ?移섏쓽 ?몃줈 移섏닔??痢??쇰꺼 ?됰낫???꾩뿉\r\n * ?볦씠湲곕룄 ?댁꽌 ?щ씪?댁뒪??y????쇰꺼 ??~ ?ㅼ쓬 ?쇰꺼 ???쇰줈 ?먮Ⅴ硫??듭㎏濡?鍮좎쭊??\r\n *\r\n * 諛곗젙 ?듭빱??**?쒖쓽 ??以??곗뿉 媛??媛源뚯슫 寃?*?닿퀬, 洹??됱씠 ???щ씪?댁뒪媛 ?꾩옄??\r\n * 痢??쇰꺼???듭빱濡??곕㈃ ?섏씠 ?④퍡 留앷?議뚮떎 (#32??:\r\n *   - ?щ씪?댁뒪媛 留욌떯???덉뼱(endY[i] == startY[i+1]) ?쇰꺼 理쒓렐?묒쓽 蹂대줈?몄씠 寃쎄퀎媛\r\n *     span/2? ?뺥솗???쇱튂?쒕떎 ???꾨옒 嫄곕━ ?곹븳??以묎컙 痢듭뿉????긽 李몄씠 ?먮떎.\r\n *   - ?먭린 痢??곗씠?????ъ씠???덈뒗 ?곗씠 ??媛源뚯슫 ?꾨옒 痢??쇰꺼濡??섏뼱媛, 洹?痢듭씠\r\n *     ?⑥쓽 移섏닔濡??뺤젙?먮떎.\r\n * ?됱쓣 ?듭빱濡??곕㈃ ?쇰꺼源뚯???嫄곕━媛 span/2瑜??섏쓣 ???덉뼱 ?곹븳???ㅼ젣濡??묐룞?쒕떎.\r\n *\r\n * rows????諛??됱쓣 ?섍린吏 留?寃????ㅻЪ ojkk p3??2F ?ㅼ?移섏뿉?쒕뒗 ?쒖젣???\n * ?녜씊?띸㎞ ?됱씠 ?몃줈 移섏닔?먯꽌 0.6pt 嫄곕━??痢??쇰꺼(12.3pt)蹂대떎 媛源앸떎.\r\n *\r\n * ?ㅻЪ 5硫?70嫄댁뿉????諛곗젙? 痢??쇰꺼 理쒓렐?묎낵 寃곌낵媛 媛숇떎(?꾩닔 ?議?. 諛붾뚮뒗 寃껋?\r\n * ?????ㅽ뙣肉먯씠??\r\n */\r\nfunction verticalsBySlice(\r\n  runs: VerticalRun[],\r\n  slices: Array<{ startY: number; endY: number }>,\r\n  rows: TextRow[],\r\n): VerticalRun[][] {\r\n  const buckets: VerticalRun[][] = slices.map(() => [])\r\n  if (slices.length === 0) return buckets\r\n\r\n  for (const run of runs) {\r\n    const anchorY =\r\n      rows.length > 0\r\n        ? rows.reduce((closest, row) =>\r\n            Math.abs(row.y - run.y) < Math.abs(closest.y - run.y) ? row : closest,\r\n          ).y\r\n        : run.y\r\n    // ?щ씪?댁뒪??留욌떯???뺣젹???덉쑝誘濡? startY媛 ?듭빱 ?댄븯??留덉?留??щ씪?댁뒪媛\r\n    // 洹??됱쓣 ?댁? ?щ씪?댁뒪?? 泥??щ씪?댁뒪蹂대떎 ??癒몃━????硫?泥??щ씪?댁뒪濡?蹂몃떎\r\n    let best = 0\r\n    slices.forEach((slice, index) => {\r\n      if (slice.startY <= anchorY) best = index\r\n    })\r\n    // ?먭린 釉붾줉??留덉?留??됰낫???꾨옒???덈뒗 ?곗? ?대뒓 痢듭쓽 寃껊룄 ?꾨땲?? 洹?\n    // 釉붾줉???댁슜? 嫄곌린???앸굹怨??ㅼ쓬 痢??쇰꺼源뚯???鍮덉뭏?몃뜲, ???쭔 蹂대㈃ 洹?\n    // 鍮덉뭏???꾩쭅 ???щ씪?댁뒪???꾨옒 嫄곕━媛 0???섏뼱 ?⑥쓽 移섏닔媛 議곗슜???뺤젙?쒕떎.\r\n    // ?ㅻЪ?먯꽌 ?몃줈 移섏닔??鍮덉뭏??**?꾨옒履?*, ?먭린 痢??쇰꺼 諛붾줈 ?꾩뿉 ?볦씠誘濡?\n    // (?ㅼ륫 7.68~13.46pt, 5硫?51嫄? ?먭린 釉붾줉??泥??됰낫?ㅻ룄 ?꾨떎 ????洹쒖튃??\n    // 嫄몃━吏 ?딅뒗?? 鍮덉뭏 ?꾩そ?????レ옄???꾩옄瑜?媛由?洹쇨굅媛 ?놁쑝???뺤젙?섏?\r\n    // ?딄퀬 ?먮Ц?쇰줈 ?④릿??(R10, PR #61 由щ럭 major)\r\n    // ?먭린 ?됱쓽 踰붿쐞??endY 媛 ?꾨땲??**?ㅼ쓬 ?щ씪?댁뒪??startY** 濡??딅뒗??\r\n    // ?몄텧遺媛 留덉?留??щ씪?댁뒪??endY 瑜?tableBottom(= ??諛붾떏 ???먯떊??y)?쇰줈\r\n    // ?먮Ⅴ誘濡? endY 瑜?諛고? ?곹븳?쇰줈 ?곕㈃ 洹??됱씠 鍮좎졇 理쒗븯痢듭뿉?쒕쭔 lastRowY 媛\r\n    // ?????꾨줈 諛由곕떎 (PR #61 由щ럭 major)\r\n    const bandEnd = slices[best + 1]?.startY ?? Number.POSITIVE_INFINITY\r\n    const lastRowY = rows.reduce(\r\n      (last, row) =>\r\n        row.y >= slices[best].startY && row.y < bandEnd && row.y > last\r\n          ? row.y\r\n          : last,\r\n      slices[best].startY,\r\n    )\r\n    if (run.y > lastRowY) continue\r\n\r\n    // ?먭린 痢??ㅼ?移섍? ?꾨땶 ?곗? 踰꾨┛?? 嫄곕━ ?쒗븳 ?놁씠 ?ｌ쑝硫??대뼡 ?レ옄???대뒓\r\n    // 痢듭뿏媛 遺숈뼱 ?댁뒋 ?녿뒗 ?뺤젙 d媛 ?쒕떎 ??誘몄? ?뺤떇?먯꽌???뺤젙?섏? ?딄퀬 ?먮Ц?쇰줈\r\n    // ?⑤뒗 履쎌씠 ?노떎 (R10)\r\n    //\r\n    // 嫄곕━???쇰꺼(startY) ???먯씠 ?꾨땲???щ씪?댁뒪 **???*源뚯?濡??곕떎. ?듭빱媛 ?됱씤??\n    // ?곹븳留??쇰꺼 湲곗??대㈃ ?꾩옄 ?щ씪?댁뒪媛 ?먭린 ?곗쓣 踰꾨┛????????섎컲遺???볦씤\r\n    // ?곗? ?녠쾶 諛곗젙?섍퀬??startY ?먯꽌 span/2 瑜??섏뼱 ?먭린?쒕떎 (PR #61 由щ럭 major)\r\n    const { startY, endY } = slices[best]\r\n    const span = endY - startY\r\n    const distance = Math.max(startY - run.y, run.y - endY, 0)\r\n    if (distance <= span * SLICE_DISTANCE_LIMIT_RATIO) buckets[best].push(run)\r\n  }\r\n\r\n  return buckets\r\n}\r\n\r\n/**\r\n * ?쒖쓽 ?ㅼ젣 諛붾떏 y瑜?援ы븳?? 留덉?留?釉붾줉??endY???ㅼ쓬 ??댄????놁쑝硫??섏씠吏\r\n * 諛붾떏源뚯? ?대젮 ?덉뼱, blockRows.at(-1)????諛??쒖젣? ?띿뒪???꾨㈃踰덊샇쨌異뺤쿃 ??媛\r\n * ?????덈떎 ??寧?뤇 ?댁쓽 x?????tableRight) ?덉뿉 ?멸렇癒쇳듃媛 ?덈뒗 ?됱쑝濡?癒쇱?\r\n * 醫곹?????諛??띿뒪?멸? ?섏쭛 李쎌쓣 諛?대궡吏 ?딅뒗??(#37, #33??遺?묒슜)\r\n */\r\nfunction tableBottomY(\r\n  blockRows: TextRow[],\r\n  marks: MarkColumn[],\r\n  endY: number,\r\n): number {\r\n  return rowsWithinTable(blockRows, marks).at(-1)?.y ?? endY\r\n}\r\n\r\n/**\r\n * ?????됰쭔 ?④릿????寧?뤇 ?댁쓽 x?????tableRight) ?덉뿉 ?멸렇癒쇳듃媛 ?덈뒗 ?됱씠??\r\n * ?쒖젣?(?녜씊?띸㎞쨌嶸←릤兩븀칹鶯???? ?쒖? 媛숈? y???뿉 嫄몄퀜 ?덉뼱 y濡쒕뒗 紐?媛瑜몃떎.\r\n */\r\nfunction rowsWithinTable(blockRows: TextRow[], marks: MarkColumn[]): TextRow[] {\r\n  const tableRight = Math.max(...marks.map(({ centerX }) => centerX))\r\n  return blockRows.filter((row) =>\r\n    row.segments.some((segment) => segment.centerX <= tableRight),\r\n  )\r\n}\r\n\r\nfunction parseColumnBlock(\r\n  rows: TextRow[],\r\n  headerIndex: number,\r\n  endY: number,\r\n  titleText: string,\r\n  verticals: VerticalRun[],\r\n): SectionCandidate[] {\r\n  const header = rows[headerIndex]\r\n  const marks = markColumns(header)\r\n  if (marks.length === 0) return []\r\n  const blockRows = rowsBetween(rows, header.y, endY)\r\n  const stories = storyRows(blockRows)\n  // 亮녑콏 ?????쇰꺼???녿뒗 ?쒕뒗 鸚㎪쥈 釉붾줉怨?媛숈? ?대갚?쇰줈 ???щ씪?댁뒪 泥섎━?쒕떎 ??\n  // 議곌린 諛섑솚?섎㈃ ?쒓? ?듭㎏濡??뚯씤??遺덇??띾줈 ?щ씪吏꾨떎\r\n  const slices: Array<{\r\n    storyLabel: string | undefined\r\n    startY: number\r\n    endY: number\r\n  }> =\r\n    stories.length > 0\r\n      ? stories.map((story, index) => ({\r\n          storyLabel: story.label,\r\n          startY: story.row.y,\r\n          endY: stories[index + 1]?.row.y ?? endY,\r\n        }))\r\n      : [{ storyLabel: undefined, startY: header.y, endY }]\r\n  // ?섏쭛 李쎌쓣 ?쒖쓽 ?ㅼ젣 ??踰붿쐞濡??ル뒗?? 媛濡?移섏닔???쇰꺼 ???ъ씠濡?醫곴쾶 ?섎━誘濡?\n  // 媛숈? ?몄텧???녿떎\r\n  const tableBottom = tableBottomY(blockRows, marks, endY)\r\n  const blockVerticals = verticalsBySlice(\r\n    verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n    // 留덉?留??щ씪?댁뒪??endY???쒖쓽 ?앹씠 ?꾨땲???ㅼ쓬 ??댄?쨌?섏씠吏 諛붾떏?대떎.\r\n    // 洹몃?濡??먮㈃ 洹?痢듭뿉?쒕쭔 嫄곕━ ?곹븳??痢?媛꾧꺽??紐?諛곕줈 踰뚯뼱吏꾨떎\r\n    slices.map((slice) => ({\r\n      startY: slice.startY,\r\n      endY: Math.min(slice.endY, tableBottom),\r\n    })),\r\n    rowsWithinTable(blockRows, marks),\r\n  )\r\n\r\n  const candidates: SectionCandidate[] = []\n  for (const [sliceIndex, slice] of slices.entries()) {\n    const dataRows = rowsBetween(rows, slice.startY, slice.endY)\n    const preSliceRows = rows.filter(\n      (row) => row.y > header.y && row.y < slice.startY,\n    )\n    const shapeRow =\n      preSliceRows\n        .filter((row) => exactLabel(row, ['壤®듁??씊']))\n        .at(-1) ??\n      dataRows.find((row) => exactLabel(row, ['壤®듁??씊']))\n    const mainRows = dataRows.filter((row) => exactLabel(row, ['訝사춮']))\n    const hoopRows = dataRows.filter((row) =>\n      exactLabel(row, ['躍?춮', 'HOOP', '?뺛꺖??]),\n    )\n    // ?쇰꺼 議댁옱留?蹂대㈃ 媛??멸렇癒쇳듃媛 ?녿뒗 ?쇰꺼 ?됱씠 scalarDimensions ?대갚源뚯?\r\n    // 留됱븘 ?먮Ц 李멸퀬 ?쒖떆媛 ?듭㎏濡??щ씪吏꾨떎 ??鸚㎪쥈 釉붾줉怨?媛숈? 議곌굔???대떎\r\n    const inSliceDimensionRows = dataRows.filter(\n      (row) => isDimensionRow(row, ['??씊', 'B횞D', 'b횞D'], marks),\n    )\n    // ?쇰? 諛쒖＜泥섎뒗 ???됰낫??癒쇱? 怨듯넻 ??씊 ?됱쓣 ?붾떎. ?대떦 ?됱쓣 ?볦튂硫?    // 3.5k ?섏튂留??⑥븘 b횞d媛 議곗슜???щ씪吏誘濡? ?щ씪?댁뒪 吏곸쟾??媛??媛源뚯슫\n    // ??씊 ?됱쓣 ?곕릺 ?댁쟾 痢듭쓽 ?됱쓣 ?щ윭 媛??욎뼱 ?뺤젙?섏? ?딅뒗??\n    const dimensionRows =\n      inSliceDimensionRows.length > 0\n        ? inSliceDimensionRows\n        : preSliceRows\n            .filter((row) => isDimensionRow(row, ['??씊', 'B횞D', 'b횞D'], marks))\n            .slice(-1)\n    // ???щ씪?댁뒪??媛숈? ?쇰꺼 ?됱씠 寃뱀쑝濡??덉쑝硫??щ윭 痢?釉붾줉???⑹퀜吏?寃껋씠????\n    // ???쇰꺼???섎굹???몄떇?섏? ?딆? ???뚥??ч쉸?????쇰?留??몄떇??????F???똁1F????\n    // 泥???媛믪쓣 ?뺤젙?섎㈃ ?섎㉧吏 痢?媛믪씠 ?ъ쑀???먮Ц???놁씠 ?щ씪吏꾨떎\r\n    const storyAmbiguous =\r\n      mainRows.length > 1 || hoopRows.length > 1 || dimensionRows.length > 1\r\n    const mainRow = storyAmbiguous ? undefined : mainRows[0]\r\n    const hoopRow = storyAmbiguous ? undefined : hoopRows[0]\r\n    const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n    const positionRow =\r\n      lastPositionRow(rows, header.y, slice.startY) ??\r\n      dataRows.find((row) => exactLabel(row, ['鵝띸쉰']))\r\n    const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n    const mainContinuations = mainRow\r\n      ? barContinuationByMark(dataRows, mainRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const hoopContinuations = hoopRow\r\n      ? barContinuationByMark(dataRows, hoopRow, slice.endY, marks, PITCH_TOKEN)\r\n      : new Map<string, string>()\r\n    // ?ㅼ?移?移섏닔??媛濡쑣룹꽭濡?紐⑤몢 媛숈? ???듭빱濡?諛곗젙?쒕떎 ???쒖そ留?寧?뤇 以묒떖?대㈃\r\n    // 洹몄そ?먯꽌留?醫곸? ?댁썐 移몄씠 媛믪쓣 媛?멸컙??\n    const anchors = markAnchors(marks, positions)\n    const rawDimensionValues = storyAmbiguous\n      ? new Map<string, string>()\n      : dimensionRow\n        ? valuesByMark(dimensionRow, ['??씊', 'B횞D', 'b횞D'], marks)\n        : shapeRow\n          ? sketchColumnHorizontalValues(\n              rows,\n              header.y,\n              shapeRow.y,\n              anchors,\n            )\n          : sketchDimensions(\n              rows,\n              slice.startY,\n              [mainRow, hoopRow],\n              anchors,\n            )\n    const dimensionValues = expandMarkGroups(rawDimensionValues, marks)\n    // ??씊 ?쇰꺼 ?됱씠 ?덉쑝硫??몃줈 移섏닔??蹂댁? ?딅뒗?????쇰꺼 ??媛믪씠 ???뺤떎??洹쇨굅??    const rawVerticalValues =\n      storyAmbiguous || dimensionRow\n        ? new Map<string, string>()\n        : shapeRow\n          ? sketchColumnVerticalValues(\n              verticals,\n              shapeRow.y,\n              anchors,\n            )\n          : verticalsByMark(blockVerticals[sliceIndex], anchors)\n    const verticalValues = expandMarkGroups(rawVerticalValues, marks)\n    const mainByPosition =\r\n      mainRow && positions.length > 0\r\n        ? valuesByPosition(mainRow, ['訝사춮'], positions, marks)\r\n        : new Map<string, string>()\r\n    // 鵝띸쉰 ?댁쓣 ?섎굹??諛곗젙諛쏆? 紐삵븳 寧?뤇(DP媛 ??寧?뤇??紐곗븘以 寃쎌슦)?먮룄 ?? ?덈떎 ??\n    // ?대갚 ?놁씠 ?먮㈃ 洹?寧?뤇??訝사춮???뺤젙???먮Ц???댁뒋???놁씠 ?щ씪吏꾨떎\r\n    const mainByMark = mainRow\r\n      ? valuesByMark(mainRow, ['訝사춮'], marks)\r\n      : new Map<string, string>()\r\n    const hoopLabel = hoopRow\r\n      ? exactLabel(hoopRow, ['躍?춮', 'HOOP', '?뺛꺖??])?.compact\n      : undefined\r\n    const hoopValues =\r\n      hoopRow && hoopLabel ? valuesByMark(hoopRow, [hoopLabel], marks) : new Map()\r\n\r\n    marks.forEach(({ mark, rawCell }) => {\n      if (storyAmbiguous) {\r\n        // 媛??놁씠 ?ъ쑀留??ㅼ? ?꾨낫瑜??④릿?????쒓? 議곗슜???щ씪吏硫??ъ슜?먮뒗\r\n        // ?몄떇 ?ㅽ뙣? 援щ텇?????녿떎. ?롫? 紐??쎌? 寃껉낵 ?롫뒗 ?쎌뿀?쇰굹 ?됱씠 寃뱀씤 寃껋?\r\n        // ?ъ슜?먭? ?먮룄?먯꽌 ?뺤씤??怨녹씠 ?ㅻⅤ誘濡??ъ쑀瑜??섎늿??\n        candidates.push({\r\n          kind: kindFromMark(mark, titleText),\r\n          mark,\n          storyLabel: slice.storyLabel,\n          raw: { 寧?뤇: rawCell },\n          issues: [slice.storyLabel === undefined ? '?롣툖?? : '?끿쎅烏뚪뇥筽?],\r\n        })\r\n        return\r\n      }\r\n      const markPositions = positions\r\n        .map((position, index) => ({ ...position, index }))\r\n        .filter((position) => position.mark === mark)\r\n      const mainCells =\r\n        markPositions.length > 0\r\n          ? markPositions\r\n              .map((position) => ({\r\n                position: position.label,\r\n                raw: mainByPosition.get(String(position.index)),\r\n              }))\r\n              .filter(\r\n                (cell): cell is { position: string; raw: string } =>\r\n                  cell.raw !== undefined,\r\n              )\r\n          : mainByMark.has(mark)\r\n            ? [{ raw: mainByMark.get(mark) as string }]\r\n            : []\r\n      const dimension = dimensionValues.get(mark)\r\n      const hoop = hoopValues.get(mark)\r\n      // ?묓옒 寃?щ낫??癒쇱? ?⑥뼱?⑤━硫? 媛믪씠 ?묓엺 ?섏㎏ 以꾩뿉留??덈뒗 寧?뤇??\n      // ?ъ쑀???먮Ц???놁씠 ?щ씪吏꾨떎 ???묓옒???뚯씫? 寃껋씠 ?덈떎?띿뿉 ?ｋ뒗??\n      if (\r\n        !dimension &&\r\n        mainCells.length === 0 &&\r\n        !hoop &&\r\n        !mainContinuations.has(mark) &&\r\n        !hoopContinuations.has(mark)\r\n      ) {\r\n        return\r\n      }\r\n\r\n      const result: SectionCandidate = {\r\n        kind: kindFromMark(mark, titleText),\r\n        mark,\n        storyLabel: slice.storyLabel,\n        raw: { 寧?뤇: rawCell },\n        issues: [],\r\n      }\r\n      setDimension(result, dimension, true, verticalValues.get(mark))\r\n      const continuation = mainContinuations.get(mark)\r\n      if (continuation !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗??????以꾩쓣 ?먮Ц 李멸퀬濡??④릿??\n        for (const cell of mainCells) {\r\n          const key =\r\n            'position' in cell ? `訝사춮(${cell.position})` : '訝사춮'\r\n          result.raw[key] = cleanedRebarRaw(cell.raw)\r\n        }\r\n        // 泥?以꾩씠 ?꾩삁 ?놁쑝硫??뚯젒? ?덈떎?띻? ?꾨땲?????녿뒗 ?묓옒???뚮━硫?\n        // ?ъ슜?먮뒗 ?먮룄?먯꽌 議댁옱?섏? ?딅뒗 ?섏㎏ 以꾩쓣 李얜뒗??\n        const folded = mainCells.length > 0\r\n        result.raw[folded ? '訝사춮(?섋퓭??' : '訝사춮(?▲꺀?쇻꺂烏?'] =\r\n          cleanedRebarRaw(continuation)\r\n        addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n      } else {\r\n        setColumnMain(result, mainCells, markPositions.length)\r\n      }\r\n      if (hoopLabel) {\r\n        setPitch(result, 'hoop', hoopLabel, hoop, hoopContinuations.get(mark))\r\n      }\r\n      candidates.push(result)\r\n    })\r\n  }\r\n\r\n  return candidates\r\n}\r\n\r\nfunction cellsForMark(\r\n  values: Map<string, string>,\r\n  positions: Array<PositionColumn & { index: number }>,\r\n  mark: string,\r\n): Array<{ position: string; rawPosition: string; raw: string }> {\r\n  return positions\r\n    .filter((position) => position.mark === mark)\r\n    .map((position) => ({\r\n      position: position.label,\r\n      rawPosition: position.rawLabel,\r\n      raw: values.get(String(position.index)),\r\n    }))\r\n    .filter(\r\n      (cell): cell is {\r\n        position: string\r\n        rawPosition: string\r\n        raw: string\r\n      } => cell.raw !== undefined,\r\n    )\r\n}\r\n\r\nfunction cutoffCellsByMark(\r\n  rows: TextRow[],\r\n  positions: PositionColumn[],\r\n  marks: MarkColumn[],\r\n): Map<string, Array<{ position?: string; raw: string }>> {\r\n  const result = new Map<\r\n    string,\r\n    Array<{ position?: string; raw: string }>\r\n  >()\r\n  const positionTargets = positions.map((position, index) => ({\r\n    id: String(index),\r\n    centerX: position.centerX,\r\n  }))\r\n  const markTargets = marks.map(({ mark, centerX }) => ({\r\n    id: mark,\r\n    centerX,\r\n  }))\r\n\r\n  for (const segment of rows.flatMap((row) => row.segments)) {\r\n    // NFKC濡??②쭜 竊삼섹瑜??딂쭜 []???묐릺, raw?먮뒗 ?먮Ц 湲?먮? 洹몃?濡??④릿??\r\n    // ?덉씠 鍮?烏③죱???뚳섶竊썲냵??╉띾뒗 ?レ옄 議곌굔???듦낵?섏? ?딅뒗??\r\n    if (!/^\\[\\d+\\]$/.test(compact(segment.text))) continue\r\n\r\n    const positionIndex = valuesAtTargets(\r\n      [segment],\r\n      positionTargets,\r\n    ).keys().next().value as string | undefined\r\n    const position =\r\n      positionIndex === undefined ? undefined : positions[Number(positionIndex)]\r\n    const mark =\r\n      position?.mark ??\r\n      (valuesAtTargets([segment], markTargets).keys().next().value as\r\n        | string\r\n        | undefined)\r\n    if (mark === undefined) continue\r\n\r\n    const cells = result.get(mark) ?? []\r\n    cells.push({ position: position?.label, raw: segment.text })\r\n    result.set(mark, cells)\r\n  }\r\n\r\n  return result\r\n}\r\n\r\nfunction cutoffFromSupportFace(\r\n  cells: Array<{ position?: string; raw: string }>,\r\n  positions: PositionColumn[],\r\n): number | undefined {\r\n  if (\r\n    cells.length === 0 ||\r\n    !isThreePositionLayout(positions.map(({ label }) => ({ position: label })))\r\n  ) {\r\n    return undefined\r\n  }\r\n\r\n  const leftLabel = positions[0]?.label\r\n  const rightLabel = positions[2]?.label\r\n  if (leftLabel === undefined || rightLabel === undefined) return undefined\r\n\r\n  const values: number[] = []\r\n  for (const cell of cells) {\r\n    if (cell.position !== leftLabel && cell.position !== rightLabel) {\r\n      return undefined\r\n    }\r\n    const match = compact(cell.raw).match(/^\\[(\\d+)\\]$/)\r\n    if (!match) return undefined\r\n    const value = Number(match[1])\r\n    if (!Number.isFinite(value)) return undefined\r\n    values.push(value)\r\n  }\r\n\r\n  const first = values[0]\r\n  return first !== undefined && values.every((value) => value === first)\r\n    ? first\r\n    : undefined\r\n}\r\n\r\nfunction parseGirderBlock(\r\n  rows: TextRow[],\r\n  headerIndex: number,\r\n  endY: number,\r\n  titleText: string,\r\n  verticals: VerticalRun[],\r\n): SectionCandidate[] {\r\n  const header = rows[headerIndex]\r\n  const marks = markColumns(header)\r\n  if (marks.length === 0) return []\r\n  const blockRows = rowsBetween(rows, header.y, endY)\r\n  const stories = storyRows(blockRows)\n  const slices =\r\n    stories.length > 0\r\n      ? stories.map((story, index) => ({\r\n          storyLabel: story.label,\r\n          startY: story.row.y,\r\n          endY: stories[index + 1]?.row.y ?? endY,\r\n        }))\r\n      : [{ storyLabel: undefined, startY: header.y, endY }]\r\n  // ??釉붾줉怨?媛숈? ?댁쑀濡??섏쭛 李쎄낵 ?щ씪?댁뒪 ?곹븳???쒖쓽 ?ㅼ젣 ??踰붿쐞濡??ル뒗??\n  const tableBottom = tableBottomY(blockRows, marks, endY)\r\n  const blockVerticals = verticalsBySlice(\r\n    verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n    slices.map((slice) => ({\r\n      startY: slice.startY,\r\n      endY: Math.min(slice.endY, tableBottom),\r\n    })),\r\n    rowsWithinTable(blockRows, marks),\r\n  )\r\n  const candidates: SectionCandidate[] = []\r\n\r\n  for (const [sliceIndex, slice] of slices.entries()) {\n    const dataRows = rowsBetween(rows, slice.startY, slice.endY)\n    const preSliceRows = rows.filter(\n      (row) => row.y > header.y && row.y < slice.startY,\n    )\n    const inSliceDimensionRows = dataRows.filter(\n      (row) => isDimensionRow(row, ['??씊', 'B횞D', 'b횞D', '野멩퀡'], marks),\n    )\n    const dimensionRows =\n      inSliceDimensionRows.length > 0\n        ? inSliceDimensionRows\n        : preSliceRows\n            .filter((row) =>\n              isDimensionRow(row, ['??씊', 'B횞D', 'b횞D', '野멩퀡'], marks),\n            )\n            .slice(-1)\n    const topRows = dataRows.filter((row) => exactLabel(row, ['訝딁춮', '訝딁ク嶺?]))\r\n    const bottomRows = dataRows.filter((row) =>\r\n      exactLabel(row, ['訝뗧춮', '訝뗧ク嶺?]),\r\n    )\r\n    const stirrupRows = dataRows.filter((row) =>\n      exactLabel(row, ['ST', 'STP', 'STP.', '?귙겙?됬춮', '?밤궭?쇈꺀?껁깤']),\n    )\n    const inSliceSideBarRows = dataRows.filter((row) =>\n      exactLabel(row, ['?밭춮']),\n    )\n    const sideBarRows =\n      inSliceSideBarRows.length > 0\n        ? inSliceSideBarRows\n        : preSliceRows\n            .filter((row) => exactLabel(row, ['?밭춮']))\n            .slice(-1)\n    const widthTieRows = dataRows.filter((row) =>\n      exactLabel(row, ['亮끾?嶺?, '藥얏?嶺?, '亮끾??곭춮']),\n    )\n    const remarkRows = dataRows.filter((row) => exactLabel(row, ['?숃?]))\n    // ??釉붾줉怨?媛숈? 諛⑹뼱 ???쇰꺼 ?됱씠 寃뱀씠硫??щ윭 痢?釉붾줉???⑹퀜吏?寃껋씠??\n    const storyAmbiguous =\r\n      topRows.length > 1 ||\r\n      bottomRows.length > 1 ||\r\n      stirrupRows.length > 1 ||\n      sideBarRows.length > 1 ||\n      widthTieRows.length > 1 ||\n      remarkRows.length > 1 ||\n      dimensionRows.length > 1\n    const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n    const topRow = storyAmbiguous ? undefined : topRows[0]\r\n    const bottomRow = storyAmbiguous ? undefined : bottomRows[0]\r\n    const stirrupRow = storyAmbiguous ? undefined : stirrupRows[0]\n    const sideBarRow = storyAmbiguous ? undefined : sideBarRows[0]\n    const widthTieRow = storyAmbiguous ? undefined : widthTieRows[0]\n    const remarkRow = storyAmbiguous ? undefined : remarkRows[0]\n    const positionRow =\r\n      lastPositionRow(rows, header.y, slice.startY) ??\r\n      dataRows.find((row) => exactLabel(row, ['鵝띸쉰']))\r\n    const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n    const indexedPositions = positions.map((position, index) => ({\r\n      ...position,\r\n      index,\r\n    }))\r\n    const cutoffCells = cutoffCellsByMark(dataRows, positions, marks)\r\n    const dimensionLabel = dimensionRow\n      ? exactLabel(dimensionRow, ['??씊', 'B횞D', 'b횞D', '野멩퀡'])?.compact\n      : undefined\r\n    // ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ??ojkk 鸚㎪쥈?ゃ궧????洹쇨굅???ㅼ?移?移섏닔肉먯씠??????釉붾줉怨?\n    // 媛숈? ?대갚?쇰줈 媛濡?移섏닔瑜?以띻퀬, ?몃줈(?뚯쟾 臾몄옄??? 吏앹??댁빞 b횞D媛 ?섏삩??\n    const anchors = markAnchors(marks, positions)\r\n    const rawDimensionValues = storyAmbiguous\n      ? new Map<string, string>()\n      : dimensionRow && dimensionLabel\r\n        ? valuesByMark(dimensionRow, [dimensionLabel], marks)\n        : sketchDimensions(\r\n            rows,\r\n            slice.startY,\r\n            [topRow, bottomRow, stirrupRow],\r\n            anchors,\n          )\n    const dimensionValues = expandMarkGroups(rawDimensionValues, marks)\n    // ??씊 ?쇰꺼 ?됱씠 ?덉쑝硫??몃줈 移섏닔??蹂댁? ?딅뒗?????쇰꺼 ??媛믪씠 ???뺤떎??洹쇨굅??\n    const rawVerticalValues =\n      storyAmbiguous || dimensionRow\n        ? new Map<string, string>()\n        : verticalsByMark(blockVerticals[sliceIndex], anchors)\n    const verticalValues = expandMarkGroups(rawVerticalValues, marks)\n    const topLabel = topRow\r\n      ? exactLabel(topRow, ['訝딁춮', '訝딁ク嶺?])?.compact\r\n      : undefined\r\n    const bottomLabel = bottomRow\r\n      ? exactLabel(bottomRow, ['訝뗧춮', '訝뗧ク嶺?])?.compact\r\n      : undefined\r\n    // ??釉붾줉怨?媛숈? ?대갚 ??鵝띸쉰 ?댁쓣 諛곗젙諛쏆? 紐삵븳 寧?뤇??????④릿??\n    const topByPosition =\r\n      topRow && topLabel && positions.length > 0\r\n        ? valuesByPosition(topRow, [topLabel], positions, marks)\r\n        : new Map<string, string>()\r\n    const topByMark =\n      topRow && topLabel\n        ? valuesByMark(topRow, [topLabel], marks)\n        : new Map<string, string>()\n    const bottomByPosition =\r\n      bottomRow && bottomLabel && positions.length > 0\r\n        ? valuesByPosition(bottomRow, [bottomLabel], positions, marks)\r\n        : new Map<string, string>()\r\n    const bottomByMark =\r\n      bottomRow && bottomLabel\r\n        ? valuesByMark(bottomRow, [bottomLabel], marks)\r\n        : new Map<string, string>()\r\n    const stirrupLabel = stirrupRow\n      ? exactLabel(stirrupRow, ['ST', 'STP', 'STP.', '?귙겙?됬춮', '?밤궭?쇈꺀?껁깤'])?.compact\n      : undefined\n    const stirrupValues =\r\n      stirrupRow && stirrupLabel\r\n        ? valuesByMark(stirrupRow, [stirrupLabel], marks)\r\n        : new Map<string, string>()\r\n    const sideBarValues = sideBarRow\n      ? valuesByMark(sideBarRow, ['?밭춮'], marks)\n      : new Map<string, string>()\n    const widthTieLabel = widthTieRow\n      ? exactLabel(widthTieRow, ['亮끾?嶺?, '藥얏?嶺?, '亮끾??곭춮'])?.compact\n      : undefined\n    const widthTieValues =\n      widthTieRow && widthTieLabel\n        ? valuesByMark(widthTieRow, [widthTieLabel], marks)\n        : new Map<string, string>()\n    const remarkValues = remarkRow\n      ? valuesByMark(remarkRow, ['?숃?], marks)\n      : new Map<string, string>()\n    // ?묓엺 ?(以꾨컮轅? 媛먯? ????釉붾줉怨?媛숈? 諛⑹뼱瑜?訝딁춮/訝뗧춮/?귙겙?됬춮?먮룄 嫄대떎\r\n    const topContinuations = topRow\r\n      ? barContinuationByMark(dataRows, topRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const bottomContinuations = bottomRow\r\n      ? barContinuationByMark(dataRows, bottomRow, slice.endY, marks, BAR_TOKEN)\r\n      : new Map<string, string>()\r\n    const stirrupContinuations = stirrupRow\r\n      ? barContinuationByMark(\r\n          dataRows,\r\n          stirrupRow,\r\n          slice.endY,\r\n          marks,\r\n          PITCH_TOKEN,\r\n        )\r\n      : new Map<string, string>()\r\n\r\n    for (const { mark, rawCell } of marks) {\n      if (storyAmbiguous) {\r\n        candidates.push({\r\n          kind: kindFromMark(mark, titleText),\r\n          mark,\n          storyLabel: slice.storyLabel,\n          raw: { 寧?뤇: rawCell },\n          issues: [slice.storyLabel === undefined ? '?롣툖?? : '?끿쎅烏뚪뇥筽?],\r\n        })\r\n        continue\r\n      }\r\n      const markPositions = indexedPositions.filter(\r\n        (position) => position.mark === mark,\r\n      )\r\n      const topCells =\r\n        markPositions.length > 0\r\n          ? cellsForMark(topByPosition, indexedPositions, mark)\r\n          : topByMark.has(mark)\r\n            ? [{ position: '?ⓩ뼪??, raw: topByMark.get(mark) as string }]\r\n            : []\r\n      const bottomCells =\r\n        markPositions.length > 0\r\n          ? cellsForMark(bottomByPosition, indexedPositions, mark)\r\n          : bottomByMark.has(mark)\r\n            ? [{ position: '?ⓩ뼪??, raw: bottomByMark.get(mark) as string }]\r\n            : []\r\n      const dimension = dimensionValues.get(mark)\r\n      const stirrup = stirrupValues.get(mark)\r\n      const sideBar = sideBarValues.get(mark)\r\n      // ??釉붾줉怨?媛숈? ?댁쑀 ???묓옒???뚯씫? 寃껋씠 ?덈떎?띿뿉 ?ｋ뒗??\n      if (\r\n        !dimension &&\r\n        topCells.length === 0 &&\r\n        bottomCells.length === 0 &&\r\n        !stirrup &&\r\n        sideBar === undefined &&\r\n        !cutoffCells.has(mark) &&\r\n        !topContinuations.has(mark) &&\r\n        !bottomContinuations.has(mark) &&\r\n        !stirrupContinuations.has(mark)\r\n      ) {\r\n        continue\r\n      }\r\n\r\n      const result: SectionCandidate = {\r\n        kind: kindFromMark(mark, titleText),\r\n        mark,\n        storyLabel: slice.storyLabel,\n        raw: { 寧?뤇: rawCell },\n        issues: [],\r\n      }\r\n      const cutoffMm = cutoffFromSupportFace(\r\n        cutoffCells.get(mark) ?? [],\r\n        markPositions,\r\n      )\r\n      setDimension(result, dimension, false, verticalValues.get(mark))\r\n      const topFold = topContinuations.get(mark)\r\n      const bottomFold = bottomContinuations.get(mark)\r\n      if (topFold !== undefined || bottomFold !== undefined) {\r\n        // ?묓엺 ?? 泥?以꾨쭔?쇰줈 ?뺤젙?섏? ?딅뒗????以꾨뱾???먮Ц 李멸퀬濡??④릿??\n        if (topLabel) {\r\n          for (const cell of topCells) {\r\n            result.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        if (bottomLabel) {\r\n          for (const cell of bottomCells) {\r\n            result.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n              cell.raw,\r\n            )\r\n          }\r\n        }\r\n        // 訝듾툔瑜????ㅼ뿉 紐곕㈃ ?묒そ???묓엺 ?쒖뿉??訝뗧춮 以꾩씠 訝딁춮 以꾩쓣 ??뒗??\r\n        // 躍?춮쨌ST? 媛숈? ?쇰꺼 洹쒖빟?????대뒓 ?됱씠 ?묓삍?붿????④릿??\r\n        // ??釉붾줉怨?媛숈? ?댁쑀濡?泥?以꾩씠 ?녿뒗 履쎌? ?묓옒?대씪 遺瑜댁? ?딅뒗??\n        if (topFold !== undefined) {\r\n          const folded = topCells.length > 0\r\n          result.raw[\r\n            `${topLabel ?? '訝딁춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(topFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n        if (bottomFold !== undefined) {\r\n          const folded = bottomCells.length > 0\r\n          result.raw[\r\n            `${bottomLabel ?? '訝뗧춮'}(${folded ? '?섋퓭?? : '?▲꺀?쇻꺂烏?})`\r\n          ] = cleanedRebarRaw(bottomFold)\r\n          addIssue(result, folded ? '訝사춮?섋퓭?? : '訝사춮?⒲깧?ヨ죱鸚?)\r\n        }\r\n      } else if (topLabel || bottomLabel) {\r\n        // ?쒖そ ?쇰꺼留??몄떇?쇰룄 ?쎌뼱???? ?④릿????setGirderMain??訝듾툔 ?묒そ??\n        // ?붽뎄?섎?濡??뚥말嶺뗤퐤營?쵟?썬띿씠 遺숆퀬, ?뺤젙 ?놁씠 ?먮Ц??蹂댁〈?쒕떎\r\n        setGirderMain(\r\n          result,\r\n          topLabel ?? '訝딁춮',\r\n          bottomLabel ?? '訝뗧춮',\r\n          topCells,\r\n          bottomCells,\r\n          markPositions.length,\r\n        )\r\n      }\r\n      if (cutoffMm !== undefined) result.cutoffFromSupportFaceMm = cutoffMm\r\n      if (stirrupLabel) {\n        setPitch(\r\n          result,\r\n          'stirrup',\r\n          stirrupLabel,\r\n          stirrup,\r\n          stirrupContinuations.get(mark),\r\n        )\r\n      }\n      setSideBar(result, sideBar)\n      setWidthTie(result, widthTieLabel ?? '亮끾?嶺?, widthTieValues.get(mark))\n      const remark = remarkValues.get(mark)\n      if (remark !== undefined) result.raw.?숃?= compact(remark)\n      for (const cell of cutoffCells.get(mark) ?? []) {\r\n        const key = cell.position\r\n          ? `?ャ긿?덀궕??${cell.position})`\r\n          : '?ャ긿?덀궕??\r\n        result.raw[key] = cell.raw\r\n      }\r\n      candidates.push(result)\r\n    }\r\n  }\r\n\r\n  return candidates\r\n}\r\n\r\nfunction parseTableRegion(\r\n  rows: TextRow[],\r\n  anchor: TitleAnchor,\r\n  endY: number,\r\n  xStart: number,\r\n  xEnd: number,\r\n  verticals: VerticalRun[],\r\n): ParsedSectionList | undefined {\r\n  const isSlabList = /?밤꺀?뽧꺁?밤깉|?먨쑇?덀꺁?밤깉/.test(anchor.listKind)\r\n  const isWallList = anchor.listKind === '鶯곥꺁?밤깉'\r\n  // ?곸뿭??y肉??꾨땲??x???쑝濡쒕룄 ?섎씪?몃떎 ??醫뚯슦濡??섎???由ъ뒪?몄뿉?????쒖쓽\r\n  // ?멸렇癒쇳듃媛 ?욎씠硫?寧?뤇쨌?쇰꺼 留ㅼ묶?????쒕? ?ㅼ뿼?쒗궓??\n  const tableRows = rows\r\n    .filter(\r\n      (row) =>\r\n        row.y >= anchor.row.y && (isSlabList || row.y < endY),\r\n    )\r\n    .map((row) => {\r\n      const items = row.items.filter(\r\n        (item) =>\r\n          isSlabList || isWallList || (item.x + item.w >= xStart && item.x < xEnd),\r\n      )\r\n      return items.length > 0\r\n        ? { ...row, items, segments: makeSegments(items) }\r\n        : undefined\r\n    })\r\n    .filter((row): row is TextRow => row !== undefined)\r\n  const headerIndexes = tableRows\n    .map((row, index) => ({ index, marks: markColumns(row) }))\r\n    .filter(({ marks }) => marks.length > 0)\n    .map(({ index }) => index)\n  // ??댄?怨??배쮼??媛숈? ?쒖젣 以꾩씠?대룄 湲???ш린쨌湲곗???李⑥씠濡??몄젒 蹂듭썝 ?됱씠 ????\n  // ?덈떎. 理쒖큹 寧?뤇 ???욊퉴吏留??⑹퀜 ?쒖쓽 ?곗씠???됱? 嫄대뱶由ъ? ?딅뒗??\r\n  const titleLineText = compact(\r\n    tableRows\r\n      .slice(0, headerIndexes[0] ?? tableRows.length)\r\n      .flatMap((row) => row.items)\r\n      .map((item) => item.str)\r\n      .join(''),\r\n  )\r\n  // ??곸씠 ?꾨땶 由ъ뒪?몃? 紐??쎌뿀?ㅺ퀬 ?뚮━硫??뺤긽 ?뚯떛???꾨㈃?먯꽌???ㅽ뙣 ?덈궡媛 ?щ떎\r\n  const outOfScope = isOutOfScopeList(anchor.titleText)\r\n  if (isWallList || isSlabList) {\r\n    const candidates =\r\n      isWallList\r\n        ? parseWallBlock(tableRows, anchor.titleText, endY)\r\n        : parseSlabBlock(tableRows, anchor, endY)\r\n    return {\r\n      listKind: anchor.listKind,\r\n      candidates,\r\n      ...(candidates.length === 0 && !outOfScope\r\n        ? { issue: '?끿쎅烏뚧쑋沃띹춼' as const }\r\n        : {}),\r\n    }\r\n  }\r\n  // ??댄?? ?몄떇?덈뒗??寧?뤇 ?됱쓣 紐??쎌? ?쒕? ?듭㎏濡?踰꾨━硫? ?붾㈃?먮뒗\r\n  // ?뚧뼪?㏂꺁?밤깉媛 ?녿떎?띾줈 蹂댁뿬 ?ъ슜?먭? ?몄떇 ?ㅽ뙣? 援щ텇?????녿떎.\r\n  // ?ъ쑀瑜?肄붾뱶濡??ㅼ뼱 蹂대궡怨?臾멸뎄???쒖떆遺媛 怨좊Ⅸ??(CandidateIssue? 媛숈? 洹쒖빟)\r\n  if (headerIndexes.length === 0) {\r\n    return outOfScope\r\n      ? undefined\r\n      : { listKind: anchor.listKind, candidates: [], issue: '寧?뤇烏뚧쑋沃띹춼' }\r\n  }\r\n\r\n  const candidates: SectionCandidate[] = []\r\n  // ?쒖쓽 x???諛??몃줈 臾몄옄?댁? ???쒖쓽 寃껋씠?????됯낵 媛숈? 寃쎄퀎濡??먮Ⅸ??\n  const tableVerticals = verticals.filter(\n    (run) => run.x >= xStart && run.x < xEnd,\n  )\n  headerIndexes.forEach((headerIndex, index) => {\n    const blockEnd = tableRows[headerIndexes[index + 1]]?.y ?? endY\n    const headerMarks = markColumns(tableRows[headerIndex])\n    const rightmostMark = Math.max(\n      ...headerMarks.map(({ centerX }) => centerX),\n    )\n    const sortedMarkCenters = headerMarks\n      .map(({ centerX }) => centerX)\n      .sort((left, right) => left - right)\n    const trailingGap =\n      sortedMarkCenters.length >= 2\n        ? sortedMarkCenters.at(-1)! - sortedMarkCenters.at(-2)!\n        : undefined\n    const inferredEnd =\n      trailingGap === undefined\n        ? xEnd\n        : rightmostMark + trailingGap / 2\n    const localEnd = Number.isFinite(xEnd)\n      ? Math.min(xEnd, (rightmostMark + xEnd) / 2)\n      : inferredEnd\n    const localRows = tableRows\n      .slice(headerIndex)\n      .map((row) => {\n        const items = row.items.filter(\n          (item) => item.x + item.w >= xStart && item.x < localEnd,\n        )\n        return items.length > 0\n          ? { ...row, items, segments: makeSegments(items) }\n          : undefined\n      })\n      .filter((row): row is TextRow => row !== undefined)\n    const localVerticals = tableVerticals.filter(\n      (run) => run.x < localEnd,\n    )\n    const parsed = anchor.listKind.includes('??)\n      ? parseColumnBlock(\n          localRows,\n          0,\n          blockEnd,\n          anchor.titleText,\n          localVerticals,\n        )\n      : parseGirderBlock(\n          localRows,\n          0,\n          blockEnd,\n          anchor.titleText,\n          localVerticals,\n        )\n    candidates.push(...parsed)\n  })\n\r\n  // 亮끾??곭춮??꺁?밤깉?ⓧ퐪??돶鼇섅겎?귙굤?곩릪?섇ㄷ歟곥꺁?밤깉??뀲?숃짒?ュ듅?뤵?\n  // ?긱꺕弱뤸쥈?㎯겘?볝겗?배쮼?や퐪?믦き?얇겒????1?싧뎴3) ???穩▲겓?긱겘?ゃ걦?곩컦歟곥겘影꾢쎊鸚뽧?\n  const hasGirder = candidates.some((candidate) => candidate.kind === '鸚㎪쥈')\r\n  const widthTie = hasGirder\r\n    ? widthTieFromTitle(titleLineText)\r\n    : undefined\r\n  if (widthTie) {\r\n    for (const candidate of candidates) {\r\n      if (candidate.kind !== '鸚㎪쥈') continue\r\n      if (widthTie.value) candidate.widthTie = { ...widthTie.value }\r\n      else if (widthTie.raw) {\r\n        candidate.raw['亮끾?嶺?] = widthTie.raw\r\n        addIssue(candidate, '亮끾??곭춮鰲ｉ뇠訝띹꺗')\r\n      }\r\n    }\r\n  }\r\n\r\n  // 寧?뤇? ?쎌뿀?쇰굹 ??ぉ ????씊쨌訝사춮쨌躍?춮)???섎굹??紐??쎌? ?????뚨Е?룹쓣 紐?\n  // ?쎌뿀?ㅳ띾줈 ?덈궡?섎㈃ ?ъ슜?먭? ?먮룄???됰슧??怨녹쓣 蹂몃떎\r\n  return {\r\n    listKind: anchor.listKind,\r\n    candidates,\r\n    ...(candidates.length === 0 && !outOfScope\r\n      ? { issue: '?끿쎅烏뚧쑋沃띹춼' as const }\r\n      : {}),\r\n  }\r\n}\r\n\r\nexport function parseSectionLists(page: TextPage): ParsedSectionList[] {\r\n  const rows = recoverRows(page.items)\r\n  const verticals = verticalRuns(page.items)\r\n  const anchors = titleAnchors(rows)\r\n  const parsed: ParsedSectionList[] = []\r\n\r\n  anchors.forEach((anchor) => {\r\n    // 媛숈? y???쓽 ?ㅻⅨ履???댄?? ?꾨옒 ?쒓? ?꾨땲?????쒕떎 ??x 寃쎄퀎媛 ?쒕떎\r\n    const sameBand = Math.max(anchor.row.height, 1) * PROXIMITY_MULTIPLIER\r\n    // 醫뚯륫 寃쎄퀎瑜???댄? x??0?쇰줈 怨좎젙?섎㈃ 以묒븰 ?뺣젹 ??댄? ?쒖쓽 ?쇱そ ?쇰꺼?댁씠\r\n    // ?섎┛????醫뚯륫 ?댁썐 ??댄?怨쇱쓽 以묒젏???곌퀬, ?댁썐???놁쑝硫??쇱そ???댁뼱 ?붾떎\r\n    const leftNeighbor = anchors\r\n      .filter(\r\n        (other) =>\r\n          other !== anchor &&\r\n          Math.abs(other.row.y - anchor.row.y) <= sameBand &&\r\n          other.x < anchor.x,\r\n      )\r\n      .sort((left, right) => right.x - left.x)[0]\r\n    const xStart = leftNeighbor\r\n      ? (leftNeighbor.x + anchor.x) / 2\r\n      : Number.NEGATIVE_INFINITY\r\n    const rightNeighbor = anchors\r\n      .filter(\r\n        (other) =>\r\n          other !== anchor &&\r\n          Math.abs(other.row.y - anchor.row.y) <= sameBand &&\r\n          other.x > anchor.x,\r\n      )\r\n      .sort((left, right) => left.x - right.x)[0]\r\n    // ?곗륫 寃쎄퀎???댁썐 ???쒕ぉ???쒖옉?먯씠?? ?쒕ぉ???쒖쓽 以묒븰???볦씤 寃쎌슦?먮뒗\n    // ?쒕ぉ ?ъ씠 以묒젏???ㅼ젣 ??寃쎄퀎蹂대떎 ?쇱そ?쇰줈 ?ㅼ뼱? 留덉?留?遺??ina ??GA,\n    // Fuji ??B1C2)瑜??섎씪?몃떎. ?쒕ぉ???쇱そ ???? ?대? xStart濡?遺꾨━?덉쑝誘濡?\n    // ?ㅻⅨ履쎌? ?댁썐 ?쒕ぉ ?먯껜留??쒖쇅?섎㈃ ?쒖쓽 留덉?留??댁쓣 ?⑥쟾??諛쏆쓣 ???덈떎.\n    const xEnd = rightNeighbor ? rightNeighbor.x : Number.POSITIVE_INFINITY\n    // 釉붾줉 ?앹? ??x????덉뿉???꾨옒???ㅻ뒗 ?ㅼ쓬 ??댄?\n    const belowEnd = rightNeighbor\n      ? (anchor.x + rightNeighbor.x) / 2\n      : Number.POSITIVE_INFINITY\n    const below = anchors\n      .filter(\n        (other) =>\n          other.row.y - anchor.row.y > sameBand &&\n          other.x >= xStart &&\n          other.x < belowEnd,\n      )\n      .sort((left, right) => left.row.y - right.row.y)[0]\r\n    const endY = below?.row.y ?? page.heightPt\r\n    const result = parseTableRegion(\r\n      rows,\r\n      anchor,\r\n      endY,\r\n      xStart,\r\n      xEnd,\r\n      verticals,\r\n    )\r\n    if (result) parsed.push(result)\r\n  })\r\n\r\n  return parsed\r\n}\r\n\r\n--- parser tests ---\r\nimport { readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport { parseSectionLists } from '@/lib/import/section-list/parse'\r\nimport type {\r\n  ParsedSectionList,\r\n  SectionCandidate,\r\n  TextPage,\r\n} from '@/lib/import/section-list/types'\r\n\r\ntype TextItemFixture = {\r\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\r\n  items: TextPage['items']\r\n}\r\n\r\nfunction readPage(file: string): TextPage {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/textitems',\r\n    file,\r\n  )\r\n  const fixture = JSON.parse(\r\n    readFileSync(fixturePath, 'utf8'),\r\n  ) as TextItemFixture\r\n\r\n  return { ...fixture.page, items: fixture.items }\r\n}\r\n\r\nfunction readExpected<T>(file: string): T {\r\n  const fixturePath = resolve(\r\n    process.cwd(),\r\n    'tests/fixtures/section-import/expected',\r\n    file,\r\n  )\r\n  return JSON.parse(readFileSync(fixturePath, 'utf8')) as T\r\n}\r\n\r\nfunction list(\r\n  parsed: ParsedSectionList[],\r\n  listKind: string,\r\n): ParsedSectionList {\r\n  const found = parsed.find((entry) => entry.listKind === listKind)\r\n  expect(found, `missing list: ${listKind}`).toBeDefined()\r\n  return found as ParsedSectionList\r\n}\r\n\r\nfunction candidate(\r\n  parsedList: ParsedSectionList,\r\n  mark: string,\r\n  storyLabel?: string,\r\n): SectionCandidate {\r\n  const found = parsedList.candidates.find(\r\n    (entry) => entry.mark === mark && entry.storyLabel === storyLabel,\r\n  )\r\n  expect(\r\n    found,\r\n    `missing candidate: ${parsedList.listKind} ${mark} ${storyLabel ?? ''}`,\r\n  ).toBeDefined()\r\n  return found as SectionCandidate\r\n}\r\n\r\nfunction expectMarksInclude(\r\n  parsedList: ParsedSectionList,\r\n  expectedMarks: readonly string[],\r\n): void {\r\n  const parsedMarks = new Set(parsedList.candidates.map(({ mark }) => mark))\r\n  for (const mark of expectedMarks) expect(parsedMarks.has(mark), mark).toBe(true)\r\n}\r\n\r\nfunction titlePage(title: string, mark: string): TextPage {\r\n  return {\r\n    widthPt: 300,\r\n    heightPt: 180,\r\n    items: [\r\n      { str: title, x: 10, y: 5, w: 260, h: 8 },\r\n      { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n      { str: mark, x: 140, y: 20, w: 12, h: 8 },\r\n      { str: '??씊', x: 10, y: 50, w: 20, h: 8 },\r\n      { str: '400횞600', x: 120, y: 50, w: 50, h: 8 },\r\n    ],\r\n  }\r\n}\r\n\r\ndescribe('parseSectionLists', () => {\r\n  it('parses the horizontal ojkk ?긱꺁?밤깉 without inventing unsupported hoop sizes', () => {\r\n    const parsed = parseSectionLists(readPage('ojkk-p2.json'))\r\n    const columns = list(parsed, '?긱꺁?밤깉')\r\n\r\n    expectMarksInclude(columns, ['C1', 'C2', 'C2A', 'FC1'])\r\n    // ???쒖뿉????씊 ?쇰꺼 ?됱씠 ?녿떎 ??洹쇨굅???ㅼ?移섏뿉 遺숈? 媛濡쑣룹꽭濡?移섏닔 ??媛쒕퓧?닿퀬,\r\n    // ?몃줈???뚯쟾 臾몄옄?댁씠????蹂듭썝?먯꽌 鍮좎쭊?? ?섏쓣 吏앹??댁빞 700횞700???섏삩??\r\n    const c1 = candidate(columns, 'C1', '6F')\r\n    expect(c1).toMatchObject({\r\n      kind: '??,\r\n      mark: 'C1',\r\n      shape: '?⒴숱',\r\n      storyLabel: '6F',\r\n      main: { count: 16, size: 'D25' },\r\n      hoop: { size: 'D13', pitchMm: 100 },\r\n    })\r\n    expect([c1.b, c1.d]).toEqual([700, 700])\r\n    expect(c1.raw['??씊']).toBeUndefined()\r\n    expect(c1.issues).toHaveLength(0)\r\n    expect(candidate(columns, 'C2A', '2F')).toMatchObject({\r\n      main: { count: 20, size: 'D29' },\r\n    })\r\n\r\n    // 遙섇섭佯╉걵?볠뼪獒쒎섭嶺?K13?귙깢?쇈깤??빊?뤵겘??씊?③빓?졼걨?㎪군?얇굥??겎\r\n    // 誤뤸틬?ャ겒?꾢ㅳ굮凉뺛걢?싥겓?뽧굤渦쇈굙??(ADR-026)\r\n    const c2aFirst = candidate(columns, 'C2A', '1F')\r\n    expect(c2aFirst.main).toEqual({ count: 22, size: 'D32' })\r\n    expect(c2aFirst.hoop).toEqual({ size: 'K13', pitchMm: 100 })\r\n    expect(c2aFirst.raw['躍?춮']).toBeUndefined()\r\n    expect(c2aFirst.issues).toHaveLength(0)\r\n\r\n    const c2First = candidate(columns, 'C2', '1F')\r\n    expect(c2First.hoop).toEqual({ size: 'K13', pitchMm: 100 })\r\n    expect(candidate(columns, 'FC1', '1F').kind).toBe('野얕괌鸚?)\r\n  })\r\n\r\n  it('detects the fifth TextItem fixture and its 鸚㎪쥈 list', () => {\r\n    const parsed = parseSectionLists(readPage('ojkk-p3.json'))\r\n    const girders = list(parsed, '鸚㎪쥈?ゃ궧??)\r\n\r\n    expectMarksInclude(girders, ['G1', 'G2', 'G3', 'G4', 'G5'])\r\n    expect(candidate(girders, 'G1', 'RF').kind).toBe('鸚㎪쥈')\r\n    expect(candidate(girders, 'G1', 'RF').sideBar).toEqual({\r\n      size: 'D10',\r\n      count: 2,\r\n    })\r\n    expect(girders.candidates).not.toHaveLength(0)\r\n    for (const parsedCandidate of girders.candidates) {\r\n      expect(parsedCandidate.widthTie).toEqual({\r\n        size: 'D10',\r\n        pitchMm: 1000,\r\n      })\r\n    }\r\n  })\r\n\r\n  it('parses yokohama ??and 弱뤸쥈 tables on the same page', () => {\r\n    const parsed = parseSectionLists(readPage('yokohama-p13.json'))\r\n    const columns = list(parsed, '?길뼪?㏂꺁?밤깉')\r\n    const smallGirders = list(parsed, '弱뤸쥈??씊?ゃ궧??)\r\n\r\n    expectMarksInclude(columns, [\r\n      'C51',\r\n      'C52',\r\n      'C53',\r\n      'C54',\r\n      'C55',\r\n      'C56',\r\n      'C57',\r\n      'C58',\r\n      'C58A',\r\n    ])\r\n    expect(candidate(columns, 'C51', '2??)).toMatchObject({\r\n      kind: '??,\r\n      b: 800,\r\n      d: 800,\r\n      main: { count: 18, size: 'D25' },\r\n      hoop: { size: 'D13', pitchMm: 100 },\r\n    })\r\n\r\n    const c51First = candidate(columns, 'C51', '1??)\r\n    expect(c51First.main).toEqual({ count: 22, size: 'D25' })\r\n    expect(c51First.hoop).toEqual({ size: 'S13', pitchMm: 100 })\r\n    expect(c51First.raw['HOOP']).toBeUndefined()\r\n    for (const parsedCandidate of columns.candidates) {\r\n      expect(parsedCandidate.widthTie).toBeUndefined()\r\n    }\r\n\r\n    // ?녶숱?긱귞쎍孃꾥쮼?룔걣?귙굥??겎 b횞d ?㎯겘?ゃ걦?닷푶?꿔겏?ㅳ겏?쀣겍閻뷴츣?쇻굥 (ADR-027)\r\n    const c56 = candidate(columns, 'C56', '2??)\r\n    expect(c56.main).toEqual({ count: 12, size: 'D22' })\r\n    expect(c56.shape).toBe('?녶숱')\r\n    expect(c56.b).toBe(600)\r\n    expect(c56.d).toBe(600)\r\n    expect(c56.raw['??씊']).toBeUndefined()\r\n    expect(c56.issues).toHaveLength(0)\r\n    expect(candidate(columns, 'C58A', '1??).main).toEqual({\r\n      count: 26,\r\n      size: 'D25',\r\n    })\r\n\r\n    expectMarksInclude(smallGirders, ['B51'])\r\n    expect(candidate(smallGirders, 'B51').kind).toBe('野얕괌鸚?)\r\n\r\n    // ?뚢뺛띲겘沃?룚鸚길븮?㎯겘?ゃ걦?곥걹??쵂?ラ뀓嶺뗣걣?ゃ걚?ⓦ걚?녶쎋?㏂겗?ㅳ겎?귙굥??\n    const b55 = candidate(smallGirders, 'B55')\r\n    expect(b55.sideBar).toBeUndefined()\r\n    expect(b55.issues).not.toContain('?밭춮鰲ｉ뇠訝띹꺗')\r\n    for (const parsedCandidate of smallGirders.candidates) {\r\n      expect(parsedCandidate.widthTie).toBeUndefined()\r\n    }\r\n  })\r\n\r\n  it('maps position-dependent 鸚㎪쥈 main bars, including asymmetric ends', () => {\r\n    const parsed = parseSectionLists(readPage('yokohama-p14.json'))\r\n    const girders = list(parsed, '鸚㎪쥈??씊?ゃ궧??)\r\n\r\n    expectMarksInclude(girders, ['G51', 'G54', 'G55', 'G55A'])\r\n\r\n    const g51Roof = candidate(girders, 'G51', 'R??)\r\n    expect(g51Roof).toMatchObject({\r\n      kind: '鸚㎪쥈',\r\n      b: 650,\r\n      depth: 800,\r\n      stirrup: { size: 'D13', pitchMm: 100 },\r\n    })\r\n    expect(g51Roof.girderMain).toBeUndefined()\r\n    expect(g51Roof.girderMainAsymmetric).toEqual({\r\n      size: 'D25',\r\n      labels: ['鸚뽫ク', '?끿ク'],\r\n      topCounts: [8, 13],\r\n      bottomCounts: [8, 11],\r\n      topCenterCount: 8,\r\n      bottomCenterCount: 8,\r\n    })\r\n    expect(g51Roof.cutoffFromSupportFaceMm).toBe(2500)\r\n    expect(g51Roof.sideBar).toEqual({ size: 'D10', count: 2 })\r\n\r\n    const cutoffEntries = girders.candidates.flatMap(({ raw }) =>\r\n      Object.entries(raw).filter(([key]) => key.startsWith('?ャ긿?덀궕??)),\r\n    )\r\n    expect(g51Roof.raw['?ャ긿?덀궕???끿ク)']?.normalize('NFKC')).toBe('[2500]')\r\n    expect(cutoffEntries).toHaveLength(6)\r\n    expect(\r\n      cutoffEntries.map(([, value]) => value.normalize('NFKC')).sort(),\r\n    ).toEqual(['[2500]', '[2700]', '[2700]', '[2700]', '[2700]', '[3000]'])\r\n\r\n    expect(candidate(girders, 'G52', 'R??).sideBar).toEqual({\r\n      size: 'D10',\r\n      count: 4,\r\n    })\r\n    expect(girders.candidates).not.toHaveLength(0)\r\n    for (const parsedCandidate of girders.candidates) {\r\n      expect(parsedCandidate.widthTie).toEqual({\r\n        size: 'D10',\r\n        pitchMm: 1000,\r\n      })\r\n    }\r\n\r\n    const g51Second = candidate(girders, 'G51', '2??)\r\n    expect(g51Second.stirrup).toEqual({ size: 'D13', pitchMm: 150 })\r\n    // 訝←ク?뚦릪?ㅳ겗烏ⓦ겘鵝띸쉰?γ겓閻뷴츣?쇻굥 ??訝듾툔?ⓦ굚訝?ㄾ 7?사ク??11\r\n    expect(g51Second.girderMain).toEqual({\r\n      size: 'D25',\r\n      topCount: 7,\r\n      bottomCount: 7,\r\n      endTopCount: 11,\r\n      endBottomCount: 11,\r\n    })\r\n\r\n    expect(candidate(girders, 'G54', 'R??).girderMain).toEqual({\r\n      size: 'D25',\r\n      topCount: 5,\r\n      bottomCount: 5,\r\n    })\r\n    expect(candidate(girders, 'G55A', 'R??)).toMatchObject({\r\n      b: 450,\r\n      depth: 700,\r\n      girderMain: { size: 'D22', topCount: 5, bottomCount: 4 },\r\n    })\r\n    expect(candidate(girders, 'G55', 'R??).girderMain).toBeUndefined()\r\n    expect(candidate(girders, 'G55', 'R??).girderMainAsymmetric).toEqual({\r\n      size: 'D25',\r\n      labels: ['Y2塋?, 'Y3塋?],\r\n      topCounts: [4, 8],\r\n      bottomCounts: [4, 5],\r\n      topCenterCount: 5,\r\n      bottomCenterCount: 5,\r\n    })\r\n  })\r\n\r\n  it('keeps a half-width cutoff raw without a position instead of inventing a candidate field', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 300,\r\n      heightPt: 180,\r\n      items: [\r\n        {\r\n          str: '鸚㎪쥈?ゃ궧?덄돶鼇?]?끹겘?ャ긿?덀궕?뺛겗?깁씊?뗣굢???力뺛굮鹽뷩걲??,\r\n          x: 10,\r\n          y: 5,\r\n          w: 220,\r\n          h: 8,\r\n        },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n        { str: '[1500]', x: 120, y: 40, w: 40, h: 8 },\r\n        { str: '??씊', x: 10, y: 60, w: 20, h: 8 },\r\n        { str: '400횞600', x: 120, y: 60, w: 50, h: 8 },\r\n      ],\r\n    })\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.raw['?ャ긿?덀궕??]).toBe('[1500]')\r\n    expect('cutoff' in g1).toBe(false)\r\n  })\r\n\r\n  it.each([\r\n    ['ojkk-p3.json', '鸚㎪쥈?ゃ궧??],\r\n    ['kani-p38.json', '?겻릎歟곥꺁?밤깉'],\r\n  ])('%s has no ?ャ긿?덀궕??raw values', (fixture, listKind) => {\r\n    const parsedList = list(parseSectionLists(readPage(fixture)), listKind)\r\n\r\n    for (const parsedCandidate of parsedList.candidates) {\r\n      expect(\r\n        Object.keys(parsedCandidate.raw).some((key) =>\r\n          key.startsWith('?ャ긿?덀궕??),\r\n        ),\r\n      ).toBe(false)\r\n    }\r\n  })\r\n\r\n  it('parses the vertical kani ?겻릎歟곥꺁?밤깉 and tolerates an empty ?밭춮 cell', () => {\r\n    const parsed = parseSectionLists(readPage('kani-p38.json'))\r\n    const foundationGirders = list(parsed, '?겻릎歟곥꺁?밤깉')\r\n\r\n    expectMarksInclude(foundationGirders, ['FG1'])\r\n    const fg1 = candidate(foundationGirders, 'FG1')\r\n    expect(fg1).toMatchObject({\r\n      kind: '野얕괌鸚?,\r\n      mark: 'FG1',\r\n      b: 300,\r\n      depth: 500,\r\n      girderMain: { size: 'D19', topCount: 3, bottomCount: 3 },\r\n      stirrup: { size: 'D10', pitchMm: 200 },\r\n    })\r\n    expect(fg1.sideBar).toBeUndefined()\r\n    expect(fg1.widthTie).toBeUndefined()\r\n    expect(fg1.issues).not.toContain('?밭춮鰲ｉ뇠訝띹꺗')\r\n    expect(fg1.raw['?밭춮']).toBeUndefined()\r\n  })\r\n\r\n  it('keeps an unexpected ?밭춮 cell raw instead of inventing a value', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 300,\r\n      heightPt: 180,\r\n      items: [\r\n        { str: '鸚㎪쥈?ゃ궧??, x: 10, y: 5, w: 60, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n        { str: '?밭춮', x: 10, y: 50, w: 20, h: 8 },\r\n        { str: '2-K13', x: 125, y: 50, w: 36, h: 8 },\r\n      ],\r\n    })\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.sideBar).toBeUndefined()\r\n    expect(g1.raw['?밭춮']).toBe('2-K13')\r\n    expect(g1.issues).toContain('?밭춮鰲ｉ뇠訝띹꺗')\r\n  })\r\n\r\n  it('separates a three-digit 亮끾??곭춮 pitch from the next numbered title item', () => {\r\n    const parsed = parseSectionLists(\r\n      titlePage(\r\n        '鸚㎪쥈?ゃ궧?덄돶鼇섅겒?띺솏??.藥얏?嶺딡10-@5002.訝?릨?딁춮?쀣걨嶺딡10-@1000',\r\n        'G1',\r\n      ),\r\n    )\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 500 })\r\n  })\r\n\r\n  it.each([\r\n    {\r\n      fixture: 'ojkk-p3',\r\n      title: '鸚㎪쥈?ゃ궧?댿삣퉭閭®춮?츯10@1000?ⓦ걲??,\r\n      listKind: '鸚㎪쥈?ゃ궧??,\r\n      mark: 'G1',\r\n      expected: { size: 'D10', pitchMm: 1000 },\r\n    },\r\n    {\r\n      fixture: 'yokohama-p14',\r\n      title:\r\n        '鸚㎪쥈??씊?ゃ궧?덄돶鼇섅겒?띺솏??.藥얏?嶺딡10-@10002.訝?릨?딁춮?쀣걨嶺딡10-@10003.竊삼섹?끹겘節띰쉴絶꾬슉絶뚣겗?깁씊?뗣굢???力뺛굮鹽뷩걲??,\r\n      listKind: '鸚㎪쥈??씊?ゃ궧??,\r\n      mark: 'G1',\r\n      expected: { size: 'D10', pitchMm: 1000 },\r\n    },\r\n    {\r\n      fixture: 'yokohama-p13 ??,\r\n      title:\r\n        '?길뼪?㏂꺁?밤깉1/30?배쮼?ゃ걤?먦굤1.藥얏?嶺딡10-@5002.S13?츺SS785?믥ㅊ?쇻?.HOOP???,\r\n      listKind: '?길뼪?㏂꺁?밤깉',\r\n      mark: 'C1',\r\n      expected: undefined,\r\n    },\r\n    {\r\n      fixture: 'yokohama-p13 弱뤸쥈',\r\n      title:\r\n        '弱뤸쥈??씊?ゃ궧??/30?배쮼?ゃ걤?먦굤1.藥얏?嶺딡10-@10002.訝?릨?딁춮?쀣걨嶺딡10-@1000',\r\n      listKind: '弱뤸쥈??씊?ゃ궧??,\r\n      mark: 'B1',\r\n      expected: undefined,\r\n    },\r\n  ])('reads the restored $fixture title without crossing item boundaries', ({\r\n    title,\r\n    listKind,\r\n    mark,\r\n    expected,\r\n  }) => {\r\n    const parsedCandidate = candidate(\r\n      list(parseSectionLists(titlePage(title, mark)), listKind),\r\n      mark,\r\n    )\r\n\r\n    expect(parsedCandidate.widthTie).toEqual(expected)\r\n  })\r\n\r\n  it('recognizes a two-digit next item number only after splitting sequential items', () => {\r\n    const title =\r\n      '鸚㎪쥈?ゃ궧?덄돶鼇섅겒?띺솏??.a2.b3.c4.d5.e6.f7.g8.h9.藥얏?嶺딡10-@50010.訝?릨?딁춮'\r\n    const g1 = candidate(\r\n      list(parseSectionLists(titlePage(title, 'G1')), '鸚㎪쥈?ゃ궧??),\r\n      'G1',\r\n    )\r\n\r\n    expect(g1.widthTie).toEqual({ size: 'D10', pitchMm: 500 })\r\n  })\r\n\r\n  it('keeps an unbounded 亮끾??곭춮 title item raw with an issue', () => {\r\n    const parsed = parseSectionLists(\r\n      titlePage(\r\n        '鸚㎪쥈?ゃ궧?덄돶鼇섇퉭閭㏂굙嶺딡10-@1000訝?릨?딁춮?쀣걨嶺딡13-@200',\r\n        'G1',\r\n      ),\r\n    )\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.widthTie).toBeUndefined()\r\n    expect(g1.raw['亮끾?嶺?]).toBe(\r\n      '亮끾??곭춮D10-@1000訝?릨?딁춮?쀣걨嶺딡13-@200',\r\n    )\r\n    expect(g1.issues).toContain('亮끾??곭춮鰲ｉ뇠訝띹꺗')\r\n  })\r\n\r\n  it('keeps the pre-phase-7 numeric pitch limit for table cells', () => {\r\n    const parsed = parseSectionLists({\r\n      widthPt: 300,\r\n      heightPt: 180,\r\n      items: [\r\n        { str: '鸚㎪쥈?ゃ궧??, x: 10, y: 5, w: 60, h: 8 },\r\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\r\n        { str: 'G1', x: 140, y: 20, w: 12, h: 8 },\r\n        { str: 'ST', x: 10, y: 40, w: 20, h: 8 },\r\n        { str: 'D13@0100', x: 120, y: 40, w: 50, h: 8 },\r\n      ],\r\n    })\r\n    const g1 = candidate(list(parsed, '鸚㎪쥈?ゃ궧??), 'G1')\r\n\r\n    expect(g1.stirrup).toEqual({ size: 'D13', pitchMm: 100 })\r\n  })\r\n\r\n})\r\n\r\n// ?? ?꾩궗 ?쎌뒪泥???? ?議?????????????????????????????????????????????????\r\n// expected/*.json? ?꾨㈃???덉쑝濡??쎌뼱 ?곸? ?먮Ц ?낅┰ ?꾩궗??(ADR-010).\r\n// 洹쒖튃: ?뚯꽌媛 ?뺤젙??媛믪? ?꾩궗? ?쇱튂?댁빞 ?섍퀬(吏?대궡湲?寃異?, ?뺤젙?섏? ?딆?\r\n// 移몄? raw ?먮Ц???꾩궗? 紐⑥닚?섎㈃ ???쒕떎. ?대뒓 移몄쓣 ?뺤젙?좎????뚯꽌 ?뺤콉?대?濡?\n// 媛믪씠 ?꾨땲???뺤젙 移??섎? ??쇰줈 諛뺤븘 ???誘명솗???뚭?瑜?留됰뒗??\r\n\r\ninterface ExpectedColumnCell {\r\n  b?: number\r\n  d?: number\r\n  /** ?녶숱??씊??쎍孃꾠괷?팪 ??빰?뤵굤?ャ걪?뚣굮?곥겇 (ADR-027) */\r\n  ?닷푶?: number\r\n  ??씊raw?: string\n  訝사춮: string | Record<string, string>\n  躍?춮?: string\n  躍?춮壤®듁?: string\n  HOOP?: string\n  HOOP壤®듁?: string\n}\r\n\r\ninterface ExpectedColumnsDoc {\r\n  entries: Array<{ mark: string; stories: Record<string, ExpectedColumnCell> }>\r\n}\r\n\r\n/** 烏??쇰꺼? ?꾨㈃留덈떎 ?ㅻⅤ?????꾩궗??洹??꾨㈃????留먯쓣 洹몃?濡??곷뒗??*/\r\ninterface GirderLabels {\r\n  top: string\r\n  bottom: string\r\n  stirrup: string\r\n}\r\n\r\ntype ExpectedGirderCell = Record<string, unknown> & {\r\n  b: number\r\n  depth: number\r\n}\r\n\r\ninterface ExpectedGirdersDoc {\r\n  entries: Array<{ mark: string; stories: Record<string, ExpectedGirderCell> }>\r\n}\r\n\r\ninterface ExpectedKaniEntry {\r\n  mark: string\r\n  b: number\r\n  depth: number\r\n  訝딁ク嶺? string\r\n  訝뗧ク嶺? string\r\n  STP: string\r\n}\r\n\r\ninterface ExpectedWallEntry {\r\n  mark: string\r\n  thickness?: number\r\n  ??씊raw?: string\r\n  潁?춮: string\r\n  與ょ춮: string\r\n}\r\n\r\ninterface ExpectedSlabEntry {\r\n  mark: string\r\n  thickness: number\r\n  訝딁ク嶺?: Record<string, string>\r\n  訝뗧ク嶺?: Record<string, string>\r\n  訝딁춮?: Record<string, string>\r\n  訝뗧춮?: Record<string, string>\r\n}\r\n\r\ninterface ExpectedList {\r\n  listKind: string\r\n  scope?: string\r\n  entries?: Array<{ mark: string }>\r\n  outOfScopeMarks?: string[]\r\n  marks?: string[]\r\n}\r\n\r\ninterface ExpectedWallSlabDoc {\r\n  lists: Array<ExpectedList & {\r\n    entries?: Array<ExpectedWallEntry | ExpectedSlabEntry>\r\n  }>\r\n}\r\n\r\n/** ?똃13-@100?띉룔똃10@200???쒓린 李⑤? ?≪닔?쒕떎 ???섏씠?덉? ?μ떇?대떎 */\r\nfunction normPitch(text: string): string {\n  const match = text.match(/^([A-Z]\\d+(?:\\.\\d+)?)(?:-?@([\\d,]+)|-?([\\d,]+)@)$/i)\n  if (!match) return text\n  return `${match[1].toUpperCase()}@${(match[2] ?? match[3]).replace(/,/g, '')}`\n}\r\n\r\nfunction sweepColumns(\r\n  pageFile: string,\r\n  expectedFile: string,\r\n  listKind: string,\r\n): { main: number; hoop: number; dimension: number } {\r\n  const doc = readExpected<ExpectedColumnsDoc>(expectedFile)\r\n  const columns = list(parseSectionLists(readPage(pageFile)), listKind)\r\n  const counts = { main: 0, hoop: 0, dimension: 0 }\r\n\r\n  for (const entry of doc.entries) {\r\n    for (const [story, cell] of Object.entries(entry.stories)) {\r\n      const c = candidate(columns, entry.mark, story)\r\n      const label = `${entry.mark}/${story}`\r\n\r\n      if (c.b !== undefined) {\r\n        // ?녶숱??b횞d ?㎯겘?ゃ걦?닷푶?꿔겏?ㅳ귟빪?쇿겢?귙?00??띲굮?닷푶 600 ?②き?\r\n        if (cell.?닷푶 !== undefined) {\r\n          expect(c.shape, label).toBe('?녶숱')\r\n          expect(c.b, label).toBe(cell.?닷푶)\r\n          expect(c.d, label).toBe(cell.?닷푶)\r\n        } else {\r\n          expect(c.shape, label).toBe('?⒴숱')\r\n          expect(c.b, label).toBe(cell.b)\r\n          expect(c.d, label).toBe(cell.d)\r\n        }\r\n        counts.dimension += 1\r\n      }\r\n      if (cell.??씊raw !== undefined && c.raw['??씊'] !== undefined) {\r\n        expect(c.raw['??씊'], label).toBe(cell.??씊raw)\r\n      }\r\n\r\n      const mainCells =\r\n        typeof cell.訝사춮 === 'string' ? { ?ⓩ뼪?? cell.訝사춮 } : cell.訝사춮\r\n      if (c.main) {\r\n        for (const text of Object.values(mainCells)) {\r\n          expect(`${c.main.count}-${c.main.size}`, label).toBe(text)\r\n        }\r\n        counts.main += 1\r\n      } else {\r\n        for (const [position, text] of Object.entries(mainCells)) {\r\n          const raw = c.raw[`訝사춮(${position})`] ?? c.raw['訝사춮']\r\n          if (raw !== undefined) expect(raw, label).toBe(text)\r\n        }\r\n      }\r\n\r\n      const hoopText = cell.躍?춮 ?? cell.HOOP\n      if (hoopText !== undefined) {\n        if (c.hoop) {\r\n          expect(`${c.hoop.size}@${c.hoop.pitchMm}`, label).toBe(\r\n            normPitch(hoopText),\r\n          )\r\n          counts.hoop += 1\r\n        } else {\r\n          const raw = c.raw['躍?춮'] ?? c.raw['HOOP']\r\n          if (raw !== undefined) {\r\n            expect(normPitch(raw), label).toBe(normPitch(hoopText))\r\n          }\n        }\n      }\n      const hoopShape = cell.躍?춮壤®듁 ?? cell.HOOP壤®듁\n      if (hoopShape !== undefined) {\n        const parsedShape = Object.entries(c.raw).find(([key]) =>\n          /(?:躍?춮|HOOP|?뺛꺖???밤궭?쇈꺀?껁깤)壤®듁/.test(key),\n        )?.[1]\n        // saiki TextItem ?꾩궗?먯꽌???쇰? ?꾪삎 湲由ы봽媛 ???띾줈 異붿텧?섏뼱\n        // ?쒓컖 ?꾩궗???읐룐뒢? 媛숇떎怨??⑥젙?????녿떎. ?ㅼ젣 湲고샇媛 ?띿뒪?몃줈\n        // ?ㅼ뼱??寃쎌슦?먮쭔 ?먮Ц shape瑜??議고븳?????녿뒗 shape瑜?吏?대궡吏 ?딅뒗??\n        if (parsedShape !== undefined) expect(parsedShape, label).toBe(hoopShape)\n      }\n    }\r\n  }\r\n\r\n  return counts\r\n}\r\n\r\n/**\r\n * 邕℡넍??꺖??퐤營?릫?귟〃??릎鸚?쵂?믢??ㅳ걮?뗦똻?잆겒?꾠겗?㎯곦릎鸚?겎?ゃ걨?뚣겙塋?깿?졼?\n * ?뚯꽌??遺꾨쪟湲곕? ?곗? ?딄퀬 ?뚯뒪?멸? ?곕줈 ?먯젙?쒕떎 (ADR-010).\r\n */\r\nfunction isCenterPosition(position: string): boolean {\r\n  return position.includes('訝?ㄾ')\r\n}\r\n\r\nfunction sweepGirders(\r\n  pageFile: string,\r\n  expectedFile: string,\r\n  listKind: string,\r\n  labels: GirderLabels,\r\n): { main: number; stirrup: number; dimension: number } {\r\n  const doc = readExpected<ExpectedGirdersDoc>(expectedFile)\r\n  const girders = list(parseSectionLists(readPage(pageFile)), listKind)\r\n  const counts = { main: 0, stirrup: 0, dimension: 0 }\r\n\r\n  for (const entry of doc.entries) {\r\n    for (const [story, cell] of Object.entries(entry.stories)) {\r\n      const c = candidate(girders, entry.mark, story)\r\n      const label = `${entry.mark}/${story}`\r\n      const topCellsRaw = cell[labels.top]\r\n      const bottomCellsRaw = cell[labels.bottom]\r\n      expect(topCellsRaw, `${label} ${labels.top} fixture key missing`).toBeDefined()\r\n      expect(\r\n        bottomCellsRaw,\r\n        `${label} ${labels.bottom} fixture key missing`,\r\n      ).toBeDefined()\r\n      const topCells = topCellsRaw as Record<string, string>\r\n      const bottomCells = bottomCellsRaw as Record<string, string>\r\n      const stirrupText = cell[labels.stirrup] as string\r\n\r\n      if (c.b !== undefined) {\r\n        expect(c.b, label).toBe(cell.b)\r\n        expect(c.depth, label).toBe(cell.depth)\r\n        counts.dimension += 1\r\n      }\r\n      if (c.girderMainAsymmetric) {\r\n        const {\r\n          size,\r\n          labels: endpointLabels,\r\n          topCounts,\r\n          bottomCounts,\r\n          topCenterCount,\r\n          bottomCenterCount,\r\n        } = c.girderMainAsymmetric\r\n        const endpointPositions = Object.keys(topCells).filter(\r\n          (position) => !isCenterPosition(position),\r\n        )\r\n        expect(endpointLabels, `${label} endpoint labels`).toEqual(\r\n          endpointPositions,\r\n        )\r\n        expect(topCounts, `${label} ${labels.top} endpoint counts`).toEqual(\r\n          endpointPositions.map((position) =>\r\n            Number(topCells[position]?.split('-')[0]),\r\n          ),\r\n        )\r\n        expect(\r\n          bottomCounts,\r\n          `${label} ${labels.bottom} endpoint counts`,\r\n        ).toEqual(\r\n          endpointPositions.map((position) =>\r\n            Number(bottomCells[position]?.split('-')[0]),\r\n          ),\r\n        )\r\n        for (const [position, text] of Object.entries(topCells)) {\r\n          const endIndex = endpointLabels.indexOf(position)\r\n          const count = isCenterPosition(position)\r\n            ? topCenterCount\r\n            : topCounts[endIndex]\r\n          expect(`${count}-${size}`, `${label} ${labels.top}(${position})`).toBe(\r\n            text,\r\n          )\r\n        }\r\n        for (const [position, text] of Object.entries(bottomCells)) {\r\n          const endIndex = endpointLabels.indexOf(position)\r\n          const count = isCenterPosition(position)\r\n            ? bottomCenterCount\r\n            : bottomCounts[endIndex]\r\n          expect(\r\n            `${count}-${size}`,\r\n            `${label} ${labels.bottom}(${position})`,\r\n          ).toBe(text)\r\n        }\r\n        counts.main += 1\r\n      } else if (c.girderMain) {\r\n        // 鵝띸쉰?γ겓閻뷴츣?쀣걼?숃짒??곦퐤營?걫?ⓦ겓邕℡넍?①챳?띶릦?뤵걵????塋?깿??ㅳ굮訝?ㄾ??\n        // ?γ굦?잌숃짒??뚨▶若싥걮?잆띲겲?얇걪?볝굮?싥겂?╉걮?얇걝\r\n        const { size, topCount, bottomCount, endTopCount, endBottomCount } =\r\n          c.girderMain\r\n        for (const [position, text] of Object.entries(topCells)) {\r\n          const count = isCenterPosition(position)\r\n            ? topCount\r\n            : (endTopCount ?? topCount)\r\n          expect(`${count}-${size}`, `${label} ${labels.top}(${position})`).toBe(\r\n            text,\r\n          )\r\n        }\r\n        for (const [position, text] of Object.entries(bottomCells)) {\r\n          const count = isCenterPosition(position)\r\n            ? bottomCount\r\n            : (endBottomCount ?? bottomCount)\r\n          expect(\r\n            `${count}-${size}`,\r\n            `${label} ${labels.bottom}(${position})`,\r\n          ).toBe(text)\r\n        }\r\n        counts.main += 1\r\n      } else {\n        const twoLayerMain = [\n          ...Object.values(topCells),\n          ...Object.values(bottomCells),\n        ].some((text) => text.includes('/'))\n        for (const [position, text] of Object.entries(topCells)) {\n          const raw = c.raw[`${labels.top}(${position})`]\r\n          expect(raw, `${label} ${labels.top}(${position}) ?먮Ц ?뚯떎`).toBeDefined()\r\n          expect(raw, label).toBe(text)\r\n        }\r\n        for (const [position, text] of Object.entries(bottomCells)) {\r\n          const raw = c.raw[`${labels.bottom}(${position})`]\r\n          expect(\r\n            raw,\r\n            `${label} ${labels.bottom}(${position}) ?먮Ц ?뚯떎`,\r\n          ).toBeDefined()\r\n          expect(raw, label).toBe(text)\n        }\n        if (twoLayerMain) {\n          expect(c.issues, `${label} 2餘든춮 issue`).toContain('2餘든춮?ゅ?恙?)\n          counts.main += 1\n        }\n      }\n      if (c.stirrup) {\n        expect(`${c.stirrup.size}@${c.stirrup.pitchMm}`, label).toBe(\r\n          normPitch(stirrupText),\r\n        )\r\n        counts.stirrup += 1\r\n      } else if (c.raw[labels.stirrup] !== undefined) {\r\n        expect(normPitch(c.raw[labels.stirrup]), label).toBe(\r\n          normPitch(stirrupText),\r\n        )\r\n      }\r\n    }\r\n  }\r\n\r\n  return counts\r\n}\r\n\r\ndescribe('?꾩궗 ?쎌뒪泥???? ?議?(ADR-010)', () => {\r\n  it('ojkk ?긱꺁?밤깉 ??19移?(鵝띸쉰 2?됀룟릭嶺뗭쓽 怨좉컯??K13 ?ы븿 ??移??뺤젙)', () => {\r\n    expect(\r\n      sweepColumns('ojkk-p2.json', 'ojkk-akamichi-p2-columns.json', '?긱꺁?밤깉'),\r\n      // K13 3移?C2 1F쨌C2A 2F쨌C2A 1F)??ADR-026濡??뺤젙?섏뼱 躍?춮????移?李쇰떎.\r\n      // ??씊? ?쇰꺼 ?됱씠 ?놁?留??ㅼ?移섏쓽 媛濡쑣룹꽭濡?移섏닔瑜?吏앹?????移??뺤젙 ??\n      // 媛믪? ?꾩궗(700횞700쨌FC1 600횞600)? ?議곕맂??\n    ).toEqual({ main: 19, hoop: 19, dimension: 19 })\r\n  })\r\n\r\n  it('yokohama ?길뼪?㏂꺁?밤깉 ??15移?(??씊 ?쇰꺼 ?됀룝퐤營??놁쓬쨌S13쨌600? ??移??뺤젙)', () => {\r\n    expect(\r\n      sweepColumns(\r\n        'yokohama-p13.json',\r\n        'yokohama-kanazawa-p13-columns.json',\r\n        '?길뼪?㏂꺁?밤깉',\r\n      ),\r\n      // S13 4移몄? ADR-026濡? 600?(C56)??ADR-027?쇰줈 ?뺤젙?섏뼱 ??移몄씠 李쇰떎\r\n    ).toEqual({ main: 15, hoop: 15, dimension: 15 })\r\n  })\r\n\r\n  it('yokohama 鸚㎪쥈??씊?ゃ궧?????꾩궗遺?5移?(鵝띸쉰蹂??곸씠 訝사춮 ?ы븿)', () => {\r\n    expect(\r\n      sweepGirders(\r\n        'yokohama-p14.json',\r\n        'yokohama-kanazawa-p14-girders.json',\r\n        '鸚㎪쥈??씊?ゃ궧??,\r\n        { top: '訝딁춮', bottom: '訝뗧춮', stirrup: 'ST' },\r\n      ),\r\n      // 塋?깿媛 醫뚯슦 ?숆컪??1移?G51 2??? 湲곗〈 ?移??꾨뱶濡? ?섎㉧吏 2移?\n      // (G51 R??鸚뽫ク8/?끿ク13, G55 R??? ?먮Ц ?쇰꺼怨?醫뚯슦 蹂몄닔瑜?\n      // girderMainAsymmetric濡??뺤젙?쒕떎. 諛⑺뼢 寃곗젙? ?ㅼ쓬 痍⑥엯 ?④퀎??梨낆엫?대떎\r\n    ).toEqual({ main: 5, stirrup: 5, dimension: 5 })\r\n  })\r\n\r\n  it('ojkk 鸚㎪쥈?ゃ궧????32移?(??씊 ?쇰꺼 ???놁쓬쨌2F?먮쭔 G1A쨌G2A)', () => {\r\n    expect(\r\n      sweepGirders(\r\n        'ojkk-p3.json',\r\n        'ojkk-akamichi-p3-girders.json',\r\n        '鸚㎪쥈?ゃ궧??,\r\n        { top: '訝딁ク嶺?, bottom: '訝뗧ク嶺?, stirrup: '?귙겙?됬춮' },\r\n      ),\r\n      // ??씊? ?쇰꺼 ?됱씠 ?놁?留??ㅼ?移섏쓽 媛濡?塋?깿 ?꾨옒)쨌?몃줈(訝?ㄾ ?ㅻⅨ履? 移섏닔瑜?\n      // 吏앹?????移??뺤젙 ???뺤궗媛곹삎???꾨땲??媛濡쒋넂b쨌?몃줈?뭗epth ??묎퉴吏 ?議곕맂??\r\n      // 訝사춮? 塋?깿? 訝?ㄾ???ㅻⅨ 17移몃룄 鵝띸쉰?λ줈 ?뺤젙????移몄씠 李쇰떎 ??\n      // ?쒓? 塋?깿/訝?ㄾ ???대쭔 ?곕?濡?醫뚯슦 諛⑺뼢???뺥븷 ?꾩슂媛 ?녿떎\r\n    ).toEqual({ main: 32, stirrup: 32, dimension: 32 })\r\n  })\r\n\r\n  it('kani ?겻릎歟곥꺁?밤깉 ???꾩궗 1移??꾨? ?뺤젙', () => {\n    const doc = readExpected<{ entries: ExpectedKaniEntry[] }>(\r\n      'kani-sakuragaoka-p38-foundation-girder.json',\r\n    )\r\n    const girders = list(\r\n      parseSectionLists(readPage('kani-p38.json')),\r\n      '?겻릎歟곥꺁?밤깉',\r\n    )\r\n\r\n    for (const entry of doc.entries) {\r\n      const c = candidate(girders, entry.mark)\r\n      expect(c.b, entry.mark).toBe(entry.b)\r\n      expect(c.depth, entry.mark).toBe(entry.depth)\r\n      expect(\r\n        c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`,\r\n        entry.mark,\r\n      ).toBe(entry.訝딁ク嶺?\r\n      expect(\r\n        c.girderMain && `${c.girderMain.bottomCount}-${c.girderMain.size}`,\r\n        entry.mark,\r\n      ).toBe(entry.訝뗧ク嶺?\r\n      expect(\r\n        c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`,\r\n        entry.mark,\r\n      ).toBe(normPitch(entry.STP))\r\n    }\n  })\n\n  it('saiki 鸚㎪쥈?ゃ궧????訝←ク쨌?밤궭?쇈꺀?껁깤쨌2餘든춮???꾩궗 ?議고븳??, () => {\n    expect(\n      sweepGirders(\n        'saiki-p1.json',\n        'saiki-fire-p1-girders.json',\n        '鸚㎪쥈?ゃ궧??,\n        { top: '訝딁ク嶺?, bottom: '訝뗧ク嶺?, stirrup: '?밤궭?쇈꺀?껁깤' },\n      ),\n    ).toEqual({ main: 24, stirrup: 24, dimension: 24 })\n  })\n\n  it('saiki ?긱꺁?밤깉 ??訝사춮쨌?뺛꺖?쀂룡뼪??쓣 ?꾩궗 ?議고븳??, () => {\n    expect(\n      sweepColumns(\n        'saiki-p2.json',\n        'saiki-fire-p2-columns.json',\n        '?긱꺁?밤깉',\n      ),\n    ).toEqual({ main: 10, hoop: 10, dimension: 10 })\n  })\n\n  it('ina 鸚㎪쥈쨌?겻릎歟겶룟컦歟겶룡윶?ゃ궧????異뺤쿃 ?쒕ぉ怨?鍮??????? ?議고븳??, () => {\n    const doc = readExpected<{\n      lists: Array<{\n        listKind: string\n        scopeOut?: boolean\n        form?: string\n        entries?: Array<Record<string, unknown>>\n      }>\n    }>('ina-pump-p7-lists.json')\n    const parsed = parseSectionLists(readPage('ina-p7.json'))\n\n    const girderList = list(parsed, '鸚㎪쥈?ゃ궧??)\n    const girderEntries = doc.lists.find(({ listKind }) => listKind === '鸚㎪쥈?ゃ궧??)!\n      .entries!\n    for (const entry of girderEntries) {\n      const c = candidate(girderList, entry.mark as string, entry.??as string)\n      expect(c.kind, entry.mark as string).toBe('鸚㎪쥈')\n      expect({ b: c.b, depth: c.depth }, entry.mark as string).toEqual({\n        b: entry.b,\n        depth: entry.depth,\n      })\n      expect(c.girderMain, entry.mark as string).toEqual({\n        size: 'D22',\n        topCount: 3,\n        bottomCount: 3,\n      })\n      // ??낏??뿢若싧ㅳ겘令뷩궩?ャ겦?▼룋?쀣겒?????배쮼?띷삝??닪??닩??겎?귙굥\n      expect(c.stirrup, entry.mark as string).toBeUndefined()\n      expect(c.sideBar, entry.mark as string).toBeUndefined()\n      expect(c.issues, entry.mark as string).toEqual([])\n    }\n\n    for (const listSpec of doc.lists.filter(({ scopeOut }) => scopeOut)) {\n      const parsedList = list(parsed, listSpec.listKind)\n      for (const entry of listSpec.entries ?? []) {\n        const mark = entry.mark as string\n        const c = candidate(parsedList, mark, entry.??as string | undefined)\n        expect(c.kind, mark).toBe('野얕괌鸚?)\n        expect({ b: c.b, depth: c.depth }, mark).toEqual({\n          b: entry.b,\n          depth: entry.depth,\n        })\n        expect(\n          c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`,\n          mark,\n        ).toBe(entry.訝딁ク嶺?\n        expect(\n          c.girderMain && `${c.girderMain.bottomCount}-${c.girderMain.size}`,\n          mark,\n        ).toBe(entry.訝뗧ク嶺?\n        if (entry.STP) {\n          expect(c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`, mark).toBe(\n            normPitch(entry.STP as string),\n          )\n        }\n      }\n    }\n\n    const columns = list(parsed, '?긱꺁?밤깉')\n    expect(columns.candidates, 'ina ?긱꺁?밤깉???ㅼ?移?二쇨린??).toEqual([])\n  })\n\n  it('fuji ?굿룡쥈?ゃ궧????痢??묐몢쨌??? ?ㅼ쨷 遺?맞룻뵾移??쒓린瑜???? ?議고븳??, () => {\n    const doc = readExpected<{\n      lists: Array<{\n        listKind: string\n        entries?: Array<Record<string, unknown>>\n      }>\n    }>('fuji-kanritou-p20-lists.json')\n    const parsed = parseSectionLists(readPage('fuji-p20.json'))\n\n    const columns = list(parsed, '?긱꺁?밤깉')\n    const columnEntries = doc.lists.find(({ listKind }) => listKind === '?긱꺁?밤깉')!\n      .entries!\n    for (const entry of columnEntries) {\n      const c = candidate(columns, entry.mark as string, entry.??as string)\n      expect(c.kind, entry.mark as string).toBe('??)\n      expect({ b: c.b, d: c.d }, entry.mark as string).toEqual({\n        b: entry.b,\n        d: entry.d,\n      })\n      expect(c.main && `${c.main.count}-${c.main.size}`, entry.mark as string).toBe(\n        entry.訝사춮,\n      )\n      expect(c.hoop && `${c.hoop.size}@${c.hoop.pitchMm}`, entry.mark as string).toBe(\n        normPitch(entry.?뺛꺖??as string),\n      )\n    }\n\n    const girders = list(parsed, '歟곥꺁?밤깉')\n    const girderEntries = doc.lists.find(({ listKind }) => listKind === '歟곥꺁?밤깉')!\n      .entries!\n    const mainEntry = girderEntries[0]\n    for (const mark of mainEntry.marks as string[]) {\n      const c = candidate(girders, mark)\n      expect(c.kind, mark).toBe('鸚㎪쥈')\n      expect({ b: c.b, depth: c.depth }, mark).toEqual({ b: 350, depth: 600 })\n      expect(c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`, mark).toBe(\n        mainEntry.訝딁ク嶺?\n      )\n      expect(c.girderMain && `${c.girderMain.bottomCount}-${c.girderMain.size}`, mark).toBe(\n        mainEntry.訝뗧ク嶺?\n      )\n      expect(c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`, mark).toBe(\n        normPitch(mainEntry.?밤궭?쇈꺀?껁깤 as string),\n      )\n      expect(c.sideBar, mark).toEqual({ size: 'D10', count: 2 })\n      expect(c.widthTie, mark).toEqual({ size: 'D10', pitchMm: 1000 })\n      expect(c.raw['寧?뤇']?.normalize('NFKC').replace(/\\s/g, ''), mark).toBe(\n        (mainEntry.headerCell as string).normalize('NFKC').replace(/\\s/g, ''),\n      )\n    }\n\n    for (const entry of girderEntries.slice(1)) {\n      const c = candidate(girders, entry.mark as string)\n      expect(c.kind, entry.mark as string).toBe('野얕괌鸚?)\n      expect({ b: c.b, depth: c.depth }, entry.mark as string).toEqual({\n        b: entry.b,\n        depth: entry.depth,\n      })\n      expect(\n        c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`,\n        entry.mark as string,\n      ).toBe(entry.訝딁ク嶺?\n      if (entry.?밤궭?쇈꺀?껁깤) {\n        expect(\n          c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`,\n          entry.mark as string,\n        ).toBe(normPitch(entry.?밤궭?쇈꺀?껁깤 as string))\n      } else {\n        expect(c.stirrup, entry.mark as string).toBeUndefined()\n      }\n    }\n  })\n\n  it('karatsu ?겻릎歟곥꺁?밤깉 ???몃줈?빧룸퀎??移섏닔쨌?ㅼ쨷 遺?몃? ??? ?議고븳??, () => {\n    const doc = readExpected<{\n      entries: Array<Record<string, unknown>>\n    }>('karatsu-karayaku-s4-foundation-girders.json')\n    const parsed = parseSectionLists(readPage('karatsu-shousai-p1.json'))\n    const girders = list(parsed, '?겻릎歟곥꺁?밤깉')\n\n    for (const entry of doc.entries) {\n      const mark = entry.mark as string\n      const c = candidate(girders, mark)\n      expect(c.kind, mark).toBe('野얕괌鸚?)\n      expect({ b: c.b, depth: c.depth }, mark).toEqual({\n        b: entry.b,\n        depth: entry.depth,\n      })\n      expect(c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`, mark).toBe(\n        entry.訝딁춮,\n      )\n      expect(c.girderMain && `${c.girderMain.bottomCount}-${c.girderMain.size}`, mark).toBe(\n        entry.訝뗧춮,\n      )\n      expect(c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`, mark).toBe(\n        normPitch(entry['STP.'] as string),\n      )\n      if (entry.?밭춮) {\n        expect(c.sideBar, mark).toEqual({ size: 'D13', count: 2 })\n      } else {\n        expect(c.sideBar, mark).toBeUndefined()\n      }\n      if (entry.?숃? expect(c.raw['?숃?], mark).toBe(entry.?숃?\n      expect(c.raw['寧?뤇']?.normalize('NFKC').replace(/\\s/g, ''), mark).toBe(\n        (entry.headerCell as string).normalize('NFKC').replace(/\\s/g, ''),\n      )\n    }\n  })\n\n  it('textual ?뺛꺖??shape瑜?raw濡?蹂댁〈?섎㈃???쇱튂留??뺢퇋?뷀븳??, () => {\n    const parsed = parseSectionLists({\n      widthPt: 300,\n      heightPt: 180,\n      items: [\n        { str: '?긱꺁?밤깉', x: 10, y: 5, w: 40, h: 8 },\n        { str: '寧?뤇', x: 10, y: 20, w: 20, h: 8 },\n        { str: 'C1', x: 120, y: 20, w: 12, h: 8 },\n        { str: '1F', x: 10, y: 32, w: 10, h: 8 },\n        { str: '?뺛꺖??, x: 10, y: 44, w: 20, h: 8 },\n        { str: '??D13@100', x: 100, y: 44, w: 48, h: 8 },\n      ],\n    })\n    const c1 = candidate(list(parsed, '?긱꺁?밤깉'), 'C1', '1F')\n\n    expect(c1.hoop).toEqual({ size: 'D13', pitchMm: 100 })\n    expect(c1.raw['?뺛꺖?쀥숱??]).toBe('??)\n  })\n\n  it('ojkk 鶯곥꺁?밤깉쨌?밤꺀?뽧꺁?밤깉 ??踰?5移멸낵 佯딀씮 6移몄쓣 ?꾩궗 ?議고븳??, () => {\n    const doc = readExpected<ExpectedWallSlabDoc>(\r\n      'ojkk-akamichi-p4-walls-slabs.json',\r\n    )\r\n    const parsed = parseSectionLists(readPage('ojkk-p4.json'))\r\n    const walls = list(parsed, '鶯곥꺁?밤깉')\r\n    const slabs = list(parsed, '?밤꺀?뽧꺁?밤깉')\r\n    const expectedListKinds = doc.lists\r\n      .filter(({ listKind }) => listKind !== '掠뗥냵?롦??삣콏鸚뽭쉸餘??띸춮??)\r\n      .map(({ listKind }) => listKind)\r\n      .sort()\r\n    expect(parsed.map(({ listKind }) => listKind).sort()).toEqual(expectedListKinds)\r\n    for (const listSpec of doc.lists.filter(\r\n      ({ listKind }) => listKind !== '掠뗥냵?롦??삣콏鸚뽭쉸餘??띸춮??,\r\n    )) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      const expectedMarks = [\r\n        ...(listSpec.entries ?? []).map(({ mark }) => mark),\r\n        ...(listSpec.outOfScopeMarks ?? []),\r\n        ...(listSpec.marks ?? []),\r\n      ].sort()\r\n      expect(parsedList.candidates.map(({ mark }) => mark).sort()).toEqual(expectedMarks)\r\n    }\r\n    const wallEntries = doc.lists.find(({ listKind }) => listKind === '鶯곥꺁?밤깉')!\r\n      .entries as ExpectedWallEntry[]\r\n    const slabEntries = doc.lists.find(({ listKind }) => listKind === '?밤꺀?뽧꺁?밤깉')!\r\n      .entries as ExpectedSlabEntry[]\r\n\r\n    const counts = { wallThickness: 0, wallVertical: 0, wallHorizontal: 0, slabThickness: 0, slabBars: 0 }\r\n    for (const entry of wallEntries) {\r\n      const c = candidate(walls, entry.mark)\r\n      expect(c.kind, entry.mark).toBe('?먬쐡鶯?)\r\n      if (entry.thickness !== undefined) {\r\n        expect(c.thickness, entry.mark).toBe(entry.thickness)\r\n        counts.wallThickness += 1\r\n      } else {\r\n        expect(c.thickness, entry.mark).toBeUndefined()\r\n        expect(c.raw['??씊'], entry.mark).toBe(entry['??씊raw'])\r\n      }\r\n      for (const [role, expected] of [['vertical', entry.潁?춮], ['horizontal', entry.與ょ춮]] as const) {\r\n        const parsedBar = c[role]\r\n        const match = expected.match(/^(D\\d+)@([0-9]+)\\((.+)\\)$/)\r\n        if (match) {\r\n          expect(parsedBar, `${entry.mark} ${role}`).toEqual({\r\n            size: match[1],\r\n            pitchMm: Number(match[2]),\r\n          })\r\n          expect(c.layers, `${entry.mark} ${role}`).toBe(\r\n            /??뽧꺂|絶絶욑풄絶욑풖|??뽧꺂?곥깋??.test(match[3]) ? 2 : 1,\r\n          )\r\n          counts[role === 'vertical' ? 'wallVertical' : 'wallHorizontal'] += 1\r\n        } else {\r\n          expect(parsedBar, `${entry.mark} ${role}`).toBeUndefined()\r\n          expect(c.raw[role === 'vertical' ? '潁?춮' : '與ょ춮'], `${entry.mark} ${role}`).toBe(expected)\r\n        }\r\n      }\r\n    }\r\n    expect(counts).toEqual({\r\n      wallThickness: 4,\r\n      wallVertical: 5,\r\n      wallHorizontal: 5,\r\n      slabThickness: 0,\r\n      slabBars: 0,\r\n    })\r\n\r\n    for (const entry of slabEntries) {\r\n      const c = candidate(slabs, entry.mark)\r\n      expect(c.kind, entry.mark).toBe('佯딀씮')\r\n      expect(c.thickness, entry.mark).toBe(entry.thickness)\r\n      counts.slabThickness += 1\r\n      const top = entry.訝딁ク嶺??? entry.訝딁춮!\r\n      const bottom = entry.訝뗧ク嶺??? entry.訝뗧춮!\r\n      for (const [face, values] of [['top', top], ['bottom', bottom] as const] as const) {\r\n        for (const [axis, expected] of Object.entries(values)) {\r\n          const key = axis === '??씌?밧릲' ? 'shortSide' : 'longSide'\r\n          const parsedBar = c[key]?.[face]\r\n          const match = expected.match(/^(D\\d+)-?@([0-9]+)$/)\r\n          if (match) {\r\n            expect(parsedBar, `${entry.mark} ${axis} ${face}`).toEqual({\r\n              size: match[1],\r\n              pitchMm: Number(match[2]),\r\n            })\r\n            counts.slabBars += 1\r\n          } else {\r\n            expect(parsedBar, `${entry.mark} ${axis} ${face}`).toBeUndefined()\r\n            expect(\r\n              c.raw[`${axis}(${face})`],\r\n              `${entry.mark} ${axis} ${face}`,\r\n            ).toBe(expected)\r\n          }\r\n        }\r\n      }\r\n    }\r\n    expect(counts.slabThickness).toBe(6)\r\n    expect(counts.slabBars).toBe(15)\r\n    expectMarksInclude(slabs, ['FS1', 'FS2', 'FS3', 'FS4'])\r\n    for (const mark of doc.lists.find(({ listKind }) => listKind === '?밤꺀?뽧꺁?밤깉')!.outOfScopeMarks!) {\r\n      expect(candidate(slabs, mark).kind, mark).toBe('野얕괌鸚?)\r\n    }\r\n\r\n    for (const listSpec of doc.lists.filter(\r\n      ({ scope, listKind }) =>\r\n        scope === '野얕괌鸚? &&\r\n        ['弱뤸쥈?ゃ궧??, '?뉑똻歟곥꺁?밤깉'].includes(listKind),\r\n    )) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      expect(parsedList.candidates.every(({ kind }) => kind === '野얕괌鸚?)).toBe(true)\r\n      for (const mark of listSpec.marks ?? []) expectMarksInclude(parsedList, [mark])\r\n    }\r\n  })\r\n\r\n  it('yokohama ?밤꺀?뽧꺁?밤깉 ??訝딁춮/訝뗧춮 蹂꾩묶怨?佯딀씮 ?ㅽ뙣 寃쎈줈瑜??議고븳??, () => {\r\n    const doc = readExpected<ExpectedWallSlabDoc>(\r\n      'yokohama-kanazawa-p15-slabs-walls.json',\r\n    )\r\n    const parsed = parseSectionLists(readPage('yokohama-p15.json'))\r\n    const slabs = list(parsed, '?밤꺀?뽧꺁?밤깉')\r\n    expect(parsed.map(({ listKind }) => listKind).sort()).toEqual(\r\n      doc.lists.map(({ listKind }) => listKind).sort(),\r\n    )\r\n    for (const listSpec of doc.lists) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      const expectedMarks =\r\n        listSpec.scope === '壤℡폀野얕괌鸚?\r\n          ? []\r\n          : [\r\n              ...(listSpec.entries ?? []).map(({ mark }) => mark),\r\n              ...(listSpec.marks ?? []),\r\n            ].sort()\r\n      expect(parsedList.candidates.map(({ mark }) => mark).sort()).toEqual(expectedMarks)\r\n    }\r\n    const entries = doc.lists.find(({ listKind }) => listKind === '?밤꺀?뽧꺁?밤깉')!\r\n      .entries as ExpectedSlabEntry[]\r\n    let thickness = 0\r\n    let bars = 0\r\n    for (const entry of entries) {\r\n      const c = candidate(slabs, entry.mark)\r\n      expect(c.kind).toBe('佯딀씮')\r\n      expect(c.thickness).toBe(entry.thickness)\r\n      thickness += 1\r\n      const top = entry.訝딁춮!\r\n      const bottom = entry.訝뗧춮!\r\n      for (const [face, values] of [['top', top], ['bottom', bottom] as const] as const) {\r\n        for (const [axis, expected] of Object.entries(values)) {\r\n          const key = axis === '??씌?밧릲' ? 'shortSide' : 'longSide'\r\n          const parsedBar = c[key]?.[face]\r\n          const match = expected.match(/^(D\\d+)-?@([0-9]+)$/)\r\n          if (match) {\r\n            expect(parsedBar).toEqual({ size: match[1], pitchMm: Number(match[2]) })\r\n            bars += 1\r\n          } else {\r\n            expect(parsedBar).toBeUndefined()\r\n            expect(c.raw[`${axis}(${face})`]).toBe(expected)\r\n          }\r\n        }\r\n      }\r\n    }\r\n    expect({ thickness, bars }).toEqual({ thickness: 6, bars: 19 })\r\n\r\n    for (const listSpec of doc.lists.filter(({ scope }) => scope === '野얕괌鸚?)) {\r\n      const parsedList = list(parsed, listSpec.listKind)\r\n      expect(parsedList.candidates.every(({ kind }) => kind === '野얕괌鸚?)).toBe(true)\r\n      for (const mark of listSpec.marks ?? []) expectMarksInclude(parsedList, [mark])\r\n    }\r\n    expect(list(parsed, '鶯곥꺁?밤깉').candidates).toHaveLength(0)\r\n  })\r\n})\r\n\r\n--- parser types ---\r\nimport type {\r\n  BarSize,\r\n  ColumnShape,\r\n  ShearBarSize,\r\n} from '@/domain/model/member'\r\n\r\nimport type { TextItem } from '@/lib/import/types'\r\n\r\nexport interface TextPage {\r\n  widthPt: number\r\n  heightPt: number\r\n  items: TextItem[]\r\n}\r\n\r\n/**\r\n * ???鍮덉뭏?쇰줈 ?④릿 ?ъ쑀 肄붾뱶. ?뚯꽌???꾩꽦 臾몄옣???꾨땲??肄붾뱶留??ｊ퀬,\r\n * ?쒖떆遺媛 `sectionImport.issue.*` ?ㅻ줈 踰덉뿭?쒕떎 (UnsupportedReason ?⑦꽩).\r\n */\r\nexport const CANDIDATE_ISSUES = [\n  '訝사춮鰲ｉ뇠訝띹꺗',\n  '2餘든춮?ゅ?恙?,\n  '訝사춮鵝띸쉰轝좄맼',\r\n  '訝사춮鵝띸쉰?면걬',\r\n  '訝사춮塋?깿藥?뤂?면걬',\r\n  '訝사춮訝듾툔孃꾤쎑??,\r\n  '訝사춮?섋퓭??,\r\n  '訝사춮?⒲깧?ヨ죱鸚?,\r\n  '??씊?⒴숱訝띷닇塋?,\r\n  '躍?춮鰲ｉ뇠訝띹꺗',\r\n  '躍?춮?섋퓭??,\r\n  '躍?춮?⒲깧?ヨ죱鸚?,\r\n  '?밭춮鰲ｉ뇠訝띹꺗',\r\n  '亮끾??곭춮鰲ｉ뇠訝띹꺗',\r\n  '?롣툖??,\r\n  '?끿쎅烏뚪뇥筽?,\r\n  '鶯곭춮鰲ｉ뇠訝띹꺗',\r\n  '鶯곩럻?면걬',\r\n  '佯딀씮嶺뗨㎗?덁툖??,\r\n] as const\r\n\r\nexport type CandidateIssue = (typeof CANDIDATE_ISSUES)[number]\r\n\r\n/** ?ゃ궧?덀걢?됭き?볝걽訝?ㅳ겗寧?뤇?삡??ㅳ겗?롢겗?숃짒?귞▶若잆겒?ㅳ걽?묆굮岳앮똻?쇻굥??*/\r\nexport interface SectionCandidate {\r\n  kind: '?? | '鸚㎪쥈' | '?먬쐡鶯? | '佯딀씮' | '野얕괌鸚?\r\n  mark: string\r\n  storyLabel?: string\r\n  /** ?긱겗??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗??(ADR-027)??*/\r\n  shape?: ColumnShape\r\n  b?: number\r\n  d?: number\r\n  main?: { size: BarSize; count: number }\r\n  hoop?: { size: ShearBarSize; pitchMm: number }\r\n  depth?: number\r\n  girderMain?: {\r\n    size: BarSize\r\n    /** 訝?ㄾ轝꾠겗?ф빊?귚퐤營?겎?녴걢?뚣겍?꾠겒?꾥〃?㎯겘?ⓩ뼪?㏂겗?ф빊 */\r\n    topCount: number\r\n    bottomCount: number\r\n    /**\r\n     * 塋?깿轝꾠겗?ф빊?귚퐤營?겎?ф빊?믣늽?묆겍?꾠굥烏ⓦ걽?묆걣?곥걾?곦륫塋?걣?뚦ㅳ겗?ⓦ걤??\n     * 鵝욍걝?귛랩?녈겎?겹겒?뗤툒轝꾥〃??girderMainAsymmetric ?ヨ펹?쎼굥??\n     */\r\n    endTopCount?: number\r\n    endBottomCount?: number\r\n  }\r\n  /**\r\n   * 藥?뤂??ク?ⓩ쑍?겹걣?겹겒?뗤툒轝꾥〃?굃abels ??〃??랩塋?꺕?녕ク??젂?㎯?\n   * compact() 孃뚣겗?녜씊?잍뻼?⒲깧?ャ굮岳앮똻?쇻굥?귛?燁겹겒?담굚?뚣걯?ф빊?믢틠?ㅶ똻?ㅳ?\n   */\r\n  girderMainAsymmetric?: {\r\n    size: BarSize\r\n    labels: [string, string]\r\n    topCounts: [number, number]\r\n    bottomCounts: [number, number]\r\n    topCenterCount: number\r\n    bottomCenterCount: number\r\n  }\r\n  /** 塋?깿??궖?껁깉?ゃ깢野멩퀡?귛랩?녈걣?겹겒?뗥졃?덀겘閻뷴츣?쎼걳 raw ?ユ츐?쇻?*/\r\n  cutoffFromSupportFaceMm?: number\r\n  stirrup?: { size: ShearBarSize; pitchMm: number }\r\n  /**\r\n   * 亮끾??곭춮?귙꺁?밤깉烏③죱??돶鼇섅걢?됭き? ??烏ⓦ겗?삠꺂?㎯겘?ゃ걚??\n   * ?ゅ츣獰⒲겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲굮?뤷뫑?쇻굥 (ADR-012)?귛ㄷ歟곥겓?졼걨雍됥굥\r\n   * (?곈뇧令띸츞?뷸틬 1?싧뎴3) ??닓?쇻겓?긱걣?ゃ걚)??\n   */\r\n  widthTie?: { size: BarSize; pitchMm: number }\r\n  /**\r\n   * ?밭춮?귛쎋?㏂걣??-D10?띲겏?멥걦?겹걹??굚????1?싧뎴7) ??돯餓섅겎??겒?꾠?\n   * ?ゅ츣獰⒲겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲굮?뤷뫑?쇻굥 (ADR-012)??\n   * 鵝숅빓 (extraLengthMm) ??쎋?㏂겓?▲걚 ???뽧굤渦쇈겳?담걣黎뷩굙??(R9????\n   */\r\n  sideBar?: { size: BarSize; count: number }\r\n  /** ?먬쐡鶯곥겗鶯곩럻 (mm)??*/\r\n  thickness?: number\r\n  /** ?먬쐡鶯곥겗?띸춮掠ㅶ빊?귛쎋?㏂겗?룔꺍?겹꺂/??뽧꺂烏②쮼?믡걹??겲?얍룛?묆굥??*/\r\n  layers?: 1 | 2\r\n  /** ?먬쐡鶯곥겗潁?춮?삥Ø嶺뗣?*/\r\n  vertical?: { size: BarSize; pitchMm: number }\r\n  horizontal?: { size: BarSize; pitchMm: number }\r\n  /** 佯딀씮??뼶?묆겘?곮뻗??군若싧뎺?ゃ겗?㎫윮渦뷩꺕?룩씌??겲?얌퓷?곥걲?뗣?*/\r\n  shortSide?: {\r\n    top?: { size: BarSize; pitchMm: number }\r\n    bottom?: { size: BarSize; pitchMm: number }\r\n  }\r\n  longSide?: {\r\n    top?: { size: BarSize; pitchMm: number }\r\n    bottom?: { size: BarSize; pitchMm: number }\r\n  }\r\n  /** 鰲ｉ뇠?㎯걤?싩㈉轝꾠겓?쀣걼?끿쎅??렅?뉎?*/\r\n  raw: Record<string, string>\r\n  issues: CandidateIssue[]\r\n}\r\n\r\n/**\r\n * ???섎굹媛 ?듭㎏濡??꾨낫瑜?紐????ъ쑀. ?꾨낫 諛곗뿴??鍮꾩뿀?ㅻ뒗 ?ъ떎留뚯쑝濡쒕뒗\r\n * ?뚨Е?룹쓣 紐??쎌뿀?ㅳ띿? ?뚨Е?룹? ?쎌뿀?붾뜲 ??ぉ ?됱쓣 紐??쎌뿀?ㅳ띻? 援щ텇?섏? ?딄퀬,\r\n * ?섏? ?ъ슜?먭? ?먮룄?먯꽌 蹂?怨녹씠 ?ㅻⅤ??\r\n */\r\nexport const LIST_ISSUES = ['寧?뤇烏뚧쑋沃띹춼', '?끿쎅烏뚧쑋沃띹춼'] as const\r\n\r\nexport type ListIssue = (typeof LIST_ISSUES)[number]\r\n\r\nexport interface ParsedSectionList {\r\n  listKind: string\r\n  candidates: SectionCandidate[]\r\n  issue?: ListIssue\r\n}\r\n\r\n--- real PDF test ---\r\nimport { createHash } from 'node:crypto'\r\nimport { existsSync, readFileSync } from 'node:fs'\r\nimport { resolve } from 'node:path'\r\n\r\nimport { getDocument } from 'pdfjs-dist/legacy/build/pdf.mjs'\nimport { describe, expect, it } from 'vitest'\n\nimport { pdfDocumentOptions } from '@/lib/import/pdf-text'\nimport { parseSectionLists } from '@/lib/import/section-list/parse'\nimport type { TextPage } from '@/lib/import/section-list/types'\r\nimport { toTextItems } from '@/lib/import/textitems'\r\n\r\n/**\r\n * 濡쒖뺄 ?꾩슜 ?듯빀 ?뚯뒪????寃利??꾨㈃ PDF??而ㅻ컠?섏? ?딆쑝誘濡?CI?먯꽌???듭㎏濡?\n * 嫄대꼫?대떎(`.cache/`媛 鍮꾩뼱 ?덈떎). 洹몃옒???ш린 ?덉뼱???섎뒗 ?댁쑀媛 ?덈떎:\r\n * 而ㅻ컠??TextItem ?쎌뒪泥섎뒗 媛쒖씤?뺣낫(愿由ш굔異뺤궗 ?ㅻ챸쨌?곕씫泥? ?뚮Ц??**?쒖젣????쇨퀬**\r\n * 留뚮뱾?댁쭊?? 洹몃옒???쒖젣????녜씊?띸㎞(?뚧쥈?ゃ궧?덀???由ъ뒪????댄?濡??ㅼ씤?섎뒗\r\n * ?ㅽ뙣瑜??쎌뒪泥?怨꾩링? ?먮━??蹂????녿떎 ???ㅻЪ?먯꽌??ojkk p3??2F 釉붾줉 7移몄씠\r\n * 議곗슜???щ씪議뚮떎(issue #33). 洹??덈㉫ 援ш컙????뒗 寃껋? ???뚯뒪?몃퓧?대떎.\r\n *\r\n * ?꾨㈃ 以鍮? tests/fixtures/section-import/SOURCES.md???낆닔泥섏뿉??諛쏆븘 `.cache/`???붾떎.\r\n */\r\n\r\nconst cacheDirectory = resolve(process.cwd(), '.cache')\nconst pdfjsAssetDirectory = `${resolve(process.cwd(), 'node_modules/pdfjs-dist')}/`\n\r\ninterface RealPage {\r\n  cacheFile: string\r\n  page: number\r\n  fixture: string\r\n  /** 洹??섏씠吏?먯꽌 ?쏀엳??由ъ뒪?몄? 移??????쒓? 以묎컙?먯꽌 ?섎━硫?以꾩뼱?좊떎 */\r\n  lists: Array<[string, number]>\r\n}\r\n\r\nconst pages: RealPage[] = [\r\n  {\r\n    cacheFile: 'dwg-ojkk-zumen6.pdf',\r\n    page: 2,\r\n    fixture: 'ojkk-p2.json',\r\n    lists: [['?긱꺁?밤깉', 19]],\r\n  },\r\n  {\r\n    // 32???덉쑝濡??꾩궗??expected/ojkk-akamichi-p3-girders.json??移??섎떎\r\n    cacheFile: 'dwg-ojkk-zumen6.pdf',\r\n    page: 3,\r\n    fixture: 'ojkk-p3.json',\r\n    lists: [['鸚㎪쥈?ゃ궧??, 32]],\r\n  },\r\n  {\r\n    cacheFile: 'dwg-yokohama.pdf',\r\n    page: 13,\r\n    fixture: 'yokohama-p13.json',\r\n    lists: [\r\n      ['?길뼪?㏂꺁?밤깉', 15],\r\n      ['弱뤸쥈??씊?ゃ궧??, 13],\r\n    ],\r\n  },\r\n  {\r\n    cacheFile: 'dwg-yokohama.pdf',\r\n    page: 14,\r\n    fixture: 'yokohama-p14.json',\r\n    lists: [['鸚㎪쥈??씊?ゃ궧??, 16]],\r\n  },\r\n  {\n    cacheFile: 'dwg-kani-kids.pdf',\n    page: 38,\n    fixture: 'kani-p38.json',\n    lists: [['?겻릎歟곥꺁?밤깉', 1]],\n  },\n  {\n    cacheFile: 'dwg-saiki-fire.pdf',\n    page: 1,\n    fixture: 'saiki-p1.json',\n    lists: [\n      ['鸚㎪쥈?ゃ궧??, 24],\n      ['弱뤸쥈?ゃ궧??, 4],\n      ['鸚㎪쥈?ゃ궧??, 0],\n    ],\n  },\n  {\n    cacheFile: 'dwg-saiki-fire.pdf',\n    page: 2,\n    fixture: 'saiki-p2.json',\n    lists: [\n      ['?긱꺁?밤깉', 10],\n      ['鶯곥꺁?밤깉', 9],\n      ['?밤꺀?뽧꺁?밤깉', 5],\n    ],\n  },\n]\n\r\nconst available = pages.filter(({ cacheFile }) =>\r\n  existsSync(resolve(cacheDirectory, cacheFile)),\r\n)\r\n\r\nfunction expectedSha256(cacheFile: string): string {\r\n  const sources = readFileSync(\r\n    resolve(process.cwd(), 'tests/fixtures/section-import/SOURCES.md'),\r\n    'utf8',\r\n  )\r\n  const row = sources\r\n    .split(/\\r?\\n/u)\r\n    .find((line) => line.includes(`\\`${cacheFile}\\``))\r\n  const sha256 = row?.match(/`([a-f\\d]{64})`/u)?.[1]\r\n\r\n  if (!sha256) throw new Error(`SHA-256 not found in SOURCES.md: ${cacheFile}`)\r\n  return sha256\r\n}\r\n\r\nasync function realTextPage(cacheFile: string, page: number): Promise<TextPage> {\r\n  const data = readFileSync(resolve(cacheDirectory, cacheFile))\r\n  // 濡쒖뺄 ?뚯씪??諛붾뚯뿀?붾뜲 ?뚯뒪?멸? ?듦낵?섎㈃ 臾댁뾿????붿? ?????녿떎\r\n  expect(createHash('sha256').update(data).digest('hex')).toBe(\r\n    expectedSha256(cacheFile),\r\n  )\r\n\r\n  const task = getDocument(\n    pdfDocumentOptions(new Uint8Array(data), pdfjsAssetDirectory),\n  )\n  const document = await task.promise\r\n\r\n  try {\r\n    const pdfPage = await document.getPage(page)\r\n    try {\r\n      const viewport = pdfPage.getViewport({ scale: 1 })\r\n      const content = await pdfPage.getTextContent()\r\n      return {\r\n        widthPt: viewport.width,\r\n        heightPt: viewport.height,\r\n        // 醫뚰몴 蹂?섏? ?꾨줈?뺤뀡 異붿텧湲곗? 怨듭쑀?쒕떎 (src/lib/import/pdf-text.ts)\r\n        items: toTextItems(\r\n          content.items.filter(\r\n            (item): item is Extract<typeof item, { str: string }> =>\r\n              'str' in item,\r\n          ),\r\n          viewport.transform,\r\n        ),\r\n      }\r\n    } finally {\r\n      pdfPage.cleanup()\r\n    }\r\n  } finally {\r\n    await task.destroy()\r\n  }\r\n}\r\n\r\nfunction fixtureTextPage(file: string): TextPage {\r\n  const fixture = JSON.parse(\r\n    readFileSync(\r\n      resolve(process.cwd(), 'tests/fixtures/section-import/textitems', file),\r\n      'utf8',\r\n    ),\r\n  ) as { page: { widthPt: number; heightPt: number }; items: TextPage['items'] }\r\n\r\n  return {\r\n    widthPt: fixture.page.widthPt,\r\n    heightPt: fixture.page.heightPt,\r\n    items: fixture.items,\r\n  }\r\n}\r\n\r\nfunction summary(page: TextPage) {\r\n  return parseSectionLists(page).map((parsed) => ({\r\n    listKind: parsed.listKind,\r\n    issue: parsed.issue,\r\n    marks: parsed.candidates.map(\r\n      ({ mark, storyLabel }) => `${mark}/${storyLabel ?? '-'}`,\r\n    ),\r\n    confirmed: parsed.candidates.filter(({ issues }) => issues.length === 0)\r\n      .length,\r\n  }))\r\n}\r\n\r\ndescribe.skipIf(available.length === 0)(\r\n  'section-import against the unredacted drawings (local only)',\r\n  () => {\r\n    it.each(available)(\r\n      '$cacheFile p$page reads the same lists as its redacted fixture',\r\n      async (spec) => {\r\n        // ?쒖젣????덇퀬 ?녾퀬濡?寃곌낵媛 媛덈━硫????쒕떎 ??媛덈━???쒓컙 ?ъ슜?먭? 蹂대뒗\r\n        // 寃??ㅻЪ)怨?CI媛 蹂대뒗 寃??쎌뒪泥????ㅻⅨ ?쒗뭹???쒕떎\r\n        expect(summary(await realTextPage(spec.cacheFile, spec.page))).toEqual(\r\n          summary(fixtureTextPage(spec.fixture)),\r\n        )\r\n      },\r\n      60_000,\r\n    )\r\n\r\n    it.each(available)(\r\n      '$cacheFile p$page reads every cell of every list',\r\n      async (spec) => {\r\n        // ???議곕뒗 ?묒そ???④퍡 ?댄뻾?섎㈃ ?듦낵?쒕떎 ???ㅼ륫 移??섎? ?곕줈 諛뺣뒗??\r\n        // ?쒖젣????쒕? ?딆쑝硫?由ъ뒪???섍? ?섍퀬 移??섍? 以꾩뼱 ?ш린??嫄몃┛??\n        const parsed = parseSectionLists(\r\n          await realTextPage(spec.cacheFile, spec.page),\r\n        )\r\n\r\n        expect(\r\n          parsed.map(({ listKind, candidates }) => [\r\n            listKind,\r\n            candidates.length,\r\n          ]),\r\n        ).toEqual(spec.lists)\r\n      },\r\n      60_000,\r\n    )\r\n  },\r\n)\r\n\r\n","exit_code":0,"status":"completed"}}
