ow.segments.filter((segment) => segment.compact === '符号')\r\n1197:   for (const label of [...labels].reverse()) {\r\n1198:     const groups = row.segments\r\n1199:       .filter((segment) => segment.x > label.endX)\r\n1200:       .flatMap((segment) => {\r\n1201:         const marks = marksInText(segment.compact)\r\n1202:         return marks.length > 0 ? [{ marks, centerX: segment.centerX }] : []\r\n1203:       })\r\n1204:     if (groups.length > 0) return groups\r\n1205:   }\r\n1206:   return []\r\n1207: }\r\n1208: \r\n1209: function valuesForWallGroups(\r\n1210:   row: TextRow,\r\n1211:   labelText: string,\r\n1212:   groups: WallMarkGroup[],\r\n1213:   split: (text: string) => string[],\r\n1214:   valueRow: TextRow = row,\r\n1215: ): Map<string, string> {\r\n1216:   const label = [...row.segments]\r\n1217:     .reverse()\r\n1218:     .find((segment) => segment.compact === labelText)\r\n1219:   if (!label) return new Map()\r\n1220: \r\n1221:   const values = valueRow.segments.filter((segment) =>\r\n1222:     valueRow === row ? segment.x > label.endX : true,\r\n1223:   )\r\n1224:   const result = new Map<string, string>()\r\n1225:   for (const segment of values) {\r\n1226:     const covered = groups.filter(\r\n1227:       (group) => group.centerX >= segment.x && group.centerX <= segment.endX,\r\n1228:     )\r\n1229:     if (covered.length === 0) continue\r\n1230:     const parts = split(segment.text)\r\n1231:     if (covered.length === parts.length) {\r\n1232:       covered.forEach((group, index) => {\r\n1233:         for (const mark of group.marks) result.set(mark, parts[index])\r\n1234:       })\r\n1235:       continue\r\n1236:     }\r\n1237:     if (covered.length === 1 && parts.length === covered[0].marks.length) {\r\n1238:       covered[0].marks.forEach((mark, index) => result.set(mark, parts[index]))\r\n1239:       continue\r\n1240:     }\r\n1241:     // A single mark with two thicknesses is ambiguous. Keep the complete cell\r\n1242:     // for every mark in the group; the caller will leave the typed field empty.\r\n1243:     for (const group of covered) {\r\n1244:       for (const mark of group.marks) result.set(mark, segment.text)\r\n1245:     }\r\n1246:   }\r\n1247:   return result\r\n1248: }\r\n1249: \r\n1250: function wallThicknessParts(text: string): string[] {\r\n1251:   return normalized(text)\r\n1252:     .split(',')\r\n1253:     .map((value) => value.trim())\r\n1254:     .filter((value) => value.length > 0)\r\n1255: }\r\n1256: \r\n1257: function wallBarParts(text: string): string[] {\r\n1258:   const value = compact(text)\r\n1259:   if (/[・･]/.test(value) || /[A-Z]\\d+[A-Z]\\d+/i.test(value)) return []\r\n1260:   return value.match(/[A-Z]\\d+-?@\\d+(?:\\([^)]*\\))?/gi) ?? []\r\n1261: }\r\n1262: \r\n1263: function parseWallBar(value: string):\r\n1264:   | { size: BarSize; pitchMm: number; layers: 1 | 2 }\r\n1265:   | undefined {\r\n1266:   const match = compact(value).match(\r\n1267:     /^([A-Z]\\d+)-?@(\\d+)(?:\\(([^)]*)\\))?$/i,\r\n1268:   )\r\n1269:   if (!match) return undefined\r\n1270:   const size = match[1].toUpperCase() as BarSize\r\n1271:   const pitchMm = Number(match[2])\r\n1272:   if (!barSizes.has(size) || pitchMm <= 0) return undefined\r\n1273:   const note = match[3]\r\n1274:   if (!note) return undefined\r\n1275:   const layers = /ダブル|ﾀﾞﾌﾞﾙ/.test(normalized(note)) ? 2 : /シングル/.test(note) ? 1 : undefined\r\n1276:   return layers === undefined ? undefined : { size, pitchMm, layers }\r\n1277: }\r\n1278: \r\n1279: function parseWallBlock(\r\n1280:   rows: TextRow[],\r\n1281:   titleText: string,\r\n1282:   endY: number,\r\n1283: ): SectionCandidate[] {\r\n1284:   const header = rows.find((row) => wallMarkGroups(row).length > 0)\r\n1285:   if (!header) return []\r\n1286:   const groups = wallMarkGroups(header)\r\n1287:   const bodyRows = rows.filter((row) => row.y > header.y && row.y < endY)\r\n1288:   const dimensionRow = bodyRows\r\n1289:     .filter((row) =>\r\n1290:       row.segments.some((segment) => segment.compact === '断面'),\r\n1291:     )\r\n1292:     .at(-1)\r\n1293:   const verticalRow = bodyRows.find((row) =>\r\n1294:     row.segments.some((segment) => segment.compact === '縦筋'),\r\n1295:   )\r\n1296:   const horizontalRow = bodyRows.find((row) =>\r\n1297:     row.segments.some((segment) => segment.compact === '横筋'),\r\n1298:   )\r\n1299:   if (!dimensionRow && !verticalRow && !horizontalRow) return []\r\n1300: \r\n1301:   const dimensionValueRow = dimensionRow\r\n1302:     ? bodyRows.find(\r\n1303:         (row) =>\r\n1304:           row.y > dimensionRow.y &&\r\n1305:           row.y < (verticalRow?.y ?? endY) &&\r\n1306:           row.segments.some((segment) =>\r\n1307:             groups.some(\r\n1308:               (group) =>\r\n1309:                 group.centerX >= segment.x && group.centerX <= segment.endX,\r\n1310:             ),\r\n1311:           ),\r\n1312:       )\r\n1313:     : undefined\r\n1314:   const thicknesses = dimensionRow\r\n1315:     ? valuesForWallGroups(\r\n1316:         dimensionRow,\r\n1317:         '断面',\r\n1318:         groups,\r\n1319:         wallThicknessParts,\r\n1320:         dimensionValueRow,\r\n1321:       )\r\n1322:     : new Map<string, string>()\r\n1323:   const verticals = verticalRow\r\n1324:     ? valuesForWallGroups(verticalRow, '縦筋', groups, wallBarParts)\r\n1325:     : new Map<string, string>()\r\n1326:   const horizontals = horizontalRow\r\n1327:     ? valuesForWallGroups(horizontalRow, '横筋', groups, wallBarParts)\r\n1328:     : new Map<string, string>()\r\n1329: \r\n1330:   return groups.flatMap(({ marks }) =>\r\n1331:     marks.map((mark): SectionCandidate => {\r\n1332:       const candidate: SectionCandidate = {\r\n1333:         kind: isOutOfScopeList(titleText) ? '対象外' : '耐震壁',\r\n1334:         mark,\r\n1335:         raw: {},\r\n1336:         issues: [],\r\n1337:       }\r\n1338:       const thickness = thicknesses.get(mark)\r\n1339:       if (thickness && /^\\d+$/.test(thickness)) {\r\n1340:         candidate.thickness = Number(thickness)\r\n1341:       } else if (thickness) {\r\n1342:         candidate.raw['断面'] = thickness\r\n1343:         addIssue(candidate, '壁厚相違')\r\n1344:       }\r\n1345: \r\n1346:       const setBar = (\r\n1347:         role: 'vertical' | 'horizontal',\r\n1348:         value: string | undefined,\r\n1349:       ) => {\r\n1350:         if (value === undefined) return\r\n1351:         const parsed = parseWallBar(value)\r\n1352:         if (!parsed) {\r\n1353:           candidate.raw[role === 'vertical' ? '縦筋' : '横筋'] = value\r\n1354:           addIssue(candidate, '壁筋解釈不能')\r\n1355:           return\r\n1356:         }\r\n1357:         if (candidate.layers !== undefined && candidate.layers !== parsed.layers) {\r\n1358:           candidate.raw[role === 'vertical' ? '縦筋' : '横筋'] = value\r\n1359:           addIssue(candidate, '壁筋解釈不能')\r\n1360:           return\r\n1361:         }\r\n1362:         candidate[role] = { size: parsed.size, pitchMm: parsed.pitchMm }\r\n1363:         candidate.layers = parsed.layers\r\n1364:       }\r\n1365:       setBar('vertical', verticals.get(mark))\r\n1366:       setBar('horizontal', horizontals.get(mark))\r\n1367:       return candidate\r\n1368:     }),\r\n1369:   )\r\n1370: }\r\n1371: \r\n1372: function slabMark(row: TextRow): { mark: string; centerX: number } | undefined {\r\n1373:   const segment = row.segments.find((candidate) =>\r\n1374:     SLAB_MARK_PATTERN.test(candidate.compact),\r\n1375:   )\r\n1376:   return segment\r\n1377:     ? { mark: segment.compact.toUpperCase(), centerX: segment.centerX }\r\n1378:     : undefined\r\n1379: }\r\n1380: \r\n1381: function slabBarCell(row: TextRow, centerX: number): TextSegment | undefined {\r\n1382:   return row.segments\r\n1383:     .filter((segment) => /@\\d+/.test(compact(segment.text)))\r\n1384:     .sort(\r\n1385:       (left, right) =>\r\n1386:         Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n1387:     )[0]\r\n1388: }\r\n1389: \r\n1390: function parseSlabBar(value: string): { size: BarSize; pitchMm: number } | undefined {\r\n1391:   const match = compact(value).match(/^([A-Z]\\d+)-?@(\\d+)$/i)\r\n1392:   if (!match) return undefined\r\n1393:   const size = match[1].toUpperCase() as BarSize\r\n1394:   const pitchMm = Number(match[2])\r\n1395:   return barSizes.has(size) && pitchMm > 0 ? { size, pitchMm } : undefined\r\n1396: }\r\n1397: \r\n1398: function slabThickness(row: TextRow, centerX: number): number | undefined {\r\n1399:   const value = row.segments\r\n1400:     .filter((segment) => /^\\d[\\d,]*$/.test(compact(segment.text)))\r\n1401:     .sort(\r\n1402:       (left, right) =>\r\n1403:         Math.abs(left.centerX - centerX) - Math.abs(right.centerX - centerX),\r\n1404:     )[0]\r\n1405:     ?.compact\r\n1406:   return value === undefined ? undefined : Number(value.replace(/,/g, ''))\r\n1407: }\r\n1408: \r\n1409: function nextHeaderY(rows: TextRow[], endY: number): number | undefined {\r\n1410:   return rows.find(\r\n1411:     (row) =>\r\n1412:       row.y >= endY &&\r\n1413:       row.segments.some((segment) => segment.compact.startsWith('符号')) &&\r\n1414:       !row.segments.some((segment) =>\r\n1415:         /短辺方向|長辺方向/.test(segment.compact),\r\n1416:       ),\r\n1417:   )?.y\r\n1418: }\r\n1419: \r\n1420: function parseSlabBlock(\r\n1421:   rows: TextRow[],\r\n1422:   anchor: TitleAnchor,\r\n1423:   endY: number,\r\n1424: ): SectionCandidate[] {\r\n1425:   const directionHeader = rows.find((row) =>\r\n1426:     row.segments.some((segment) => segment.compact === '短辺方向') &&\r\n1427:     row.segments.some((segment) => segment.compact === '長辺方向'),\r\n1428:   )\r\n1429:   const shortX = directionHeader?.segments.find(\r\n1430:     (segment) => segment.compact === '短辺方向',\r\n1431:   )?.centerX\r\n1432:   const longX = directionHeader?.segments.find(\r\n1433:     (segment) => segment.compact === '長辺方向',\r\n1434:   )?.centerX\r\n1435:   if (shortX === undefined || longX === undefined) return []\r\n1436: \r\n1437:   const initialRows = rows.filter((row) => row.y > anchor.row.y)\r\n1438:   const firstMark = initialRows.map(slabMark).find(\r\n1439:     (mark): mark is { mark: string; centerX: number } => mark !== undefined,\r\n1440:   )\r\n1441:   if (!firstMark) return []\r\n1442:   const markRows = initialRows\r\n1443:     .map((row) => ({ row, mark: slabMark(row) }))\r\n1444:     .filter(\r\n1445:       (entry): entry is { row: TextRow; mark: { mark: string; centerX: number } } =>\r\n1446:         entry.mark !== undefined &&\r\n1447:         Math.abs(entry.mark.centerX - firstMark.centerX) <\r\n1448:           Math.max(20, Math.abs(shortX - firstMark.centerX)),\r\n1449:     )\r\n1450:   const bridgeTitle = rows.find(\r\n1451:     (row) =>\r\n1452:       Math.abs(row.y - endY) < 0.01 &&\r\n1453:       row.segments.some((segment) => /壁リスト/.test(segment.compact)),\r\n1454:   )\r\n1455:   const scanEnd = bridgeTitle ? nextHeaderY(rows, endY) ?? endY : endY\r\n1456:   const candidates = markRows.filter(({ row }) => row.y < scanEnd)\r\n1457:   if (candidates.length === 0) return []\r\n1458: \r\n1459:   const thicknessHeader = rows.find((row) =>\r\n1460:     row.segments.some((segment) => /床厚|スラブ厚/.test(segment.compact)),\r\n1461:   )\r\n1462:   const thicknessX =\r\n1463:     thicknessHeader?.segments.find((segment) =>\r\n1464:       /床厚|スラブ厚/.test(segment.compact),\r\n1465:     )?.centerX ?? firstMark.centerX\r\n1466:   const outOfScope = isOutOfScopeList(anchor.titleText)\r\n1467: \r\n1468:   return candidates.map(({ row, mark }, index) => {\r\n1469:     const nextY = candidates[index + 1]?.row.y ?? scanEnd\r\n1470:     const cantilever =\r\n1471:       mark.mark.startsWith('CS') &&\r\n1472:       rows.some(\r\n1473:         (candidateRow) =>\r\n1474:           candidateRow.y >= row.y - 1 &&\r\n1475:           candidateRow.y < nextY &&\r\n1476:           candidateRow.segments.some((segment) =>\r\n1477:             segment.compact.includes('片持ちスラブ'),\r\n1478:           ),\r\n1479:       )\r\n1480:     const candidate: SectionCandidate = {\r\n1481:       kind: outOfScope || cantilever ? '対象外' : '床板',\r\n1482:       mark: mark.mark,\r\n1483:       raw: {},\r\n1484:       issues: [],\r\n1485:     }\r\n1486:     const sectionRows = rows.filter(\r\n1487:       (candidateRow) => candidateRow.y > row.y - 20 && candidateRow.y < nextY,\r\n1488:     )\r\n1489:     const thickness = slabThickness(row, thicknessX)\r\n1490:     if (!outOfScope && thickness !== undefined) candidate.thickness = thickness\r\n1491: \r\n1492:     if (outOfScope || cantilever) return candidate\r\n1493: \r\n1494:     const faceRows = new Map<'top' | 'bottom', TextRow>()\r\n1495:     for (const face of ['top', 'bottom'] as const) {\r\n1496:       const labels = face === 'top' ? ['上端筋', '上筋'] : ['下端筋', '下筋']\r\n1497:       const faceRow = sectionRows\r\n1498:         .filter((candidateRow) =>\r\n1499:           candidateRow.segments.some((segment) =>\r\n1500:             labels.includes(segment.compact),\r\n1501:           ),\r\n1502:         )\r\n1503:         .sort((left, right) => Math.abs(left.y - row.y) - Math.abs(right.y - row.y))[0]\r\n1504:       if (faceRow) faceRows.set(face, faceRow)\r\n1505:     }\r\n1506: \r\n1507:     for (const [face, faceRow] of faceRows) {\r\n1508:       for (const [axis, centerX] of [\r\n1509:         ['短辺方向', shortX],\r\n1510:         ['長辺方向', longX],\r\n1511:       ] as const) {\r\n1512:         const cell = slabBarCell(faceRow, centerX)\r\n1513:         const key = axis === '短辺方向' ? 'shortSide' : 'longSide'\r\n1514:         const rawKey = `${axis}(${face})`\r\n1515:         if (!cell) continue\r\n1516:         const parsed = parseSlabBar(cell.text)\r\n1517:         if (!parsed) {\r\n1518:           candidate.raw[rawKey] = cell.text\r\n1519:           addIssue(candidate, '床板筋解釈不能')\r\n1520:           continue\r\n1521:         }\r\n1522:         candidate[key] = {\r\n1523:           ...candidate[key],\r\n1524:           [face]: parsed,\r\n1525:         }\r\n1526:       }\r\n1527:     }\r\n1528:     return candidate\r\n1529:   })\r\n1530: }\r\n1531: \r\n1532: function rowsBetween(rows: TextRow[], startY: number, endY: number): TextRow[] {\r\n1533:   return rows.filter((row) => row.y > startY && row.y < endY)\r\n1534: }\r\n1535: \r\n1536: // 柱·大梁 블록의 알려진 라벨 행 전부 — 접힘 감지의 「다음 라벨 행」 판정에 쓴다.\r\n1537: const ROW_LABELS = [\r\n1538:   '主筋',\r\n1539:   '帯筋',\r\n1540:   'HOOP',\r\n1541:   'フープ',\r\n1542:   '接合部帯筋',\r\n1543:   '断面',\r\n1544:   '位置',\r\n1545:   '上筋',\r\n1546:   '上端筋',\r\n1547:   '下筋',\r\n1548:   '下端筋',\r\n1549:   'ST',\r\n1550:   'STP',\r\n1551:   'STP.',\r\n1552:   'あばら筋',\r\n1553:   'スターラップ',\r\n1554:   'B×D',\r\n1555:   'b×D',\r\n1556:   '形状断面',\r\n1557:   '寸法',\r\n1558:   '腹筋',\r\n1559:   '幅止筋',\r\n1560:   '巾止筋',\r\n1561:   '幅止め筋',\r\n1562:   '備考',\r\n1563: ] as const\r\n1564: \r\n1565: /** 本数-径 토큰(主筋 셀)과 径@ピッチ 토큰(帯筋·あばら筋 셀)을 구분해 접힘을 찾는다. */\r\n1566: const BAR_TOKEN = /\\d+-?D\\d+/i\r\n1567: \r\n1568: const PITCH_TOKEN = /D\\d+-?@\\d+/i\r\n1569: \r\n1570: /**\r\n1571:  * 라벨 행과 다음 라벨 행 사이의 무라벨 행에서 鉄筋 토큰을 마크별로 모은다.\r\n1572:  * 셀 내용이 줄바꿈으로 접히면 둘째 줄은 별도 행이 되어 라벨 행만 읽는 경로에서\r\n1573:  * 조용히 사라진다 — 첫 줄만으로 확정하면 2段筋 거부 방침이 줄바꿈 변형에서 샌다.\r\n1574:  */\r\n1575: function barContinuationByMark(\r\n1576:   dataRows: TextRow[],\r\n1577:   labelRow: TextRow,\r\n1578:   endY: number,\r\n1579:   marks: MarkColumn[],\r\n1580:   token: RegExp,\r\n1581: ): Map<string, string> {\r\n1582:   const nextLabelY = dataRows\r\n1583:     .filter((row) => row.y > labelRow.y && exactLabel(row, ROW_LABELS))\r\n1584:     .reduce((min, row) => Math.min(min, row.y), endY)\r\n1585:   const merged = new Map<string, string>()\r\n1586: \r\n1587:   for (const row of dataRows) {\r\n1588:     if (row.y <= labelRow.y || row.y >= nextLabelY) continue\r\n1589:     if (exactLabel(row, ROW_LABELS)) continue\r\n1590:     const barSegments = row.segments.filter((segment) =>\r\n1591:       token.test(segment.compact),\r\n1592:     )\r\n1593:     if (barSegments.length === 0) continue\r\n1594:     const values = valuesAtTargets(\r\n1595:       barSegments,\r\n1596:       marks.map(({ mark, centerX }) => ({ id: mark, centerX })),\r\n1597:     )\r\n1598:     for (const [mark, value] of values) {\r\n1599:       const existing = merged.get(mark)\r\n1600:       merged.set(mark, existing ? `${existing}/${value}` : value)\r\n1601:     }\r\n1602:   }\r\n1603: \r\n1604:   return merged\r\n1605: }\r\n1606: \r\n1607: function lastPositionRow(\r\n1608:   rows: TextRow[],\r\n1609:   headerY: number,\r\n1610:   beforeY: number,\r\n1611: ): TextRow | undefined {\r\n1612:   return rows\r\n1613:     .filter(\r\n1614:       (row) =>\r\n1615:         row.y > headerY && row.y < beforeY && exactLabel(row, ['位置']),\r\n1616:     )\r\n1617:     .at(-1)\r\n1618: }\r\n1619: \r\n1620: /**\r\n1621:  * 断面 라벨 행이 없는 표의 스케치 가로 치수. 창의 하한은 인식한 데이터 라벨 행 중\r\n1622:  * 가장 위다 — 라벨 하나에만 매어 두면 그 라벨을 못 읽은 표에서 창이 슬라이스 전체로\r\n1623:  * 열려 아래 행(備考 등)의 단독 숫자가 치수로 확정된다. 라벨 행을 하나도 인식하지\r\n1624:  * 못했으면 그 표에서 읽은 것이 없다는 뜻이므로 폴백을 돌리지 않는다.\r\n1625:  *\r\n1626:  * 상한에 슬라이스의 endY를 더 받지 않는다 — labelRows는 전부 rowsBetween(rows,\r\n1627:  * slice.startY, slice.endY)에서 나오므로 항상 y < slice.endY다. 그 endY를 다시\r\n1628:  * Math.min에 넣어도 절대 선택될 수 없어 있지도 않은 상한 보호처럼 읽혔다 (#35)\r\n1629:  */\r\n1630: function sketchDimensions(\r\n1631:   rows: TextRow[],\r\n1632:   startY: number,\r\n1633:   labelRows: Array<TextRow | undefined>,\r\n1634:   anchors: MarkColumn[],\r\n1635: ): Map<string, string> {\r\n1636:   const labelYs = labelRows.flatMap((row) => (row ? [row.y] : []))\r\n1637:   if (labelYs.length === 0) return new Map()\r\n1638:   return scalarDimensions(rows, startY, Math.min(...labelYs), anchors)\r\n1639: }\r\n1640: \r\n1641: /**\r\n1642:  * 스케치 치수를 배정할 열 앵커. 位置 열이 있으면 그것이다 — 符号 라벨은 칸 중앙에\r\n1643:  * 놓이지만 칸 폭은 부재마다 달라서, 중심 사이 중점을 경계로 쓰면 좁은 칸이 넓은 칸의\r\n1644:  * 끝을 먹는다. 실물 ojkk 大梁에서 G3(폭 85) 옆 G4(폭 42.5)가 G3의 세로 치수를\r\n1645:  * 가져갔다. 位置 열은 칸을 실제로 타일링하므로 폭이 다른 이웃과 붙어도 어긋나지 않는다.\r\n1646:  */\r\n1647: function markAnchors(\r\n1648:   marks: MarkColumn[],\r\n1649:   positions: PositionColumn[],\r\n1650: ): MarkColumn[] {\r\n1651:   const seenGroups = new Set<string>()\r\n1652:   return marks.flatMap(({ mark, centerX, groupKey, rawCell }) => {\r\n1653:     if (seenGroups.has(groupKey)) return []\r\n1654:     seenGroups.add(groupKey)\r\n1655:     const own = positions.filter((position) => position.mark === mark)\r\n1656:     return own.length > 0\r\n1657:       ? own.map((position) => ({ mark, centerX: position.centerX, groupKey, rawCell }))\r\n1658:       : [{ mark, centerX, groupKey, rawCell }]\r\n1659:   })\r\n1660: }\r\n1661: \r\n1662: /** 同じ符号セルから 펼친 부호는 스케치 치수의 하나의 앵커를 공유한다. 앵커 함수가\r\n1663:  * 첫 부호 하나만 반환하므로, 그 결과를 실제 후보 전부へ 복제한다. 표 셀을 읽는\r\n1664:  * valuesByMark는 이미 이 전개를 수행하므로 스케치 경로에만 적용한다.\r\n1665:  */\r\n1666: function expandMarkGroups(\r\n1667:   values: Map<string, string>,\r\n1668:   marks: MarkColumn[],\r\n1669: ): Map<string, string> {\r\n1670:   const firstByGroup = new Map<string, string>()\r\n1671:   for (const { mark, groupKey } of marks) {\r\n1672:     if (!firstByGroup.has(groupKey)) firstByGroup.set(groupKey, mark)\r\n1673:   }\r\n1674:   return new Map(\r\n1675:     marks.flatMap(({ mark, groupKey }) => {\r\n1676:       const first = firstByGroup.get(groupKey)\r\n1677:       const value = first === undefined ? undefined : values.get(first)\r\n1678:       return value === undefined ? [] : [[mark, value] as const]\r\n1679:     }),\r\n1680:   )\r\n1681: }\r\n1682: \r\n1683: /**\r\n1684:  * 앵커별 거리 상한. 칸 경계는 두 앵커 사이에 있으므로 앵커에서 경계까지의 거리는 그\r\n1685:  * 이웃까지의 간격보다 짧다 — 상한을 이웃 간격으로 잡는다. 이웃별로 재는 이유는 칸 폭이\r\n1686:  * 열마다 달라서다: 간격의 중앙값을 쓰면 자기 칸이 남들보다 넓은 열에서 실물 값이\r\n1687:  * 잘리고(ojkk 柱 FC1은 이웃 간격 85.1에 실측 51.7), 좌우 중 큰 쪽을 쓰면 촘촘한 열이\r\n1688:  * 반대편 먼 열의 상한을 물려받아 두 열 사이 빈 대역까지 먹는다.\r\n1689:  *\r\n1690:  * 앵커가 하나뿐이면 간격이 없어 상한이 Infinity가 된다 — 세로 짝짓기는 符号 2개\r\n1691:  * 이상을 따로 요구하고, 가로는 라벨 행 대역으로 이미 좁혀져 있으며, 셀 값은 열이\r\n1692:  * 하나면 그 열이 행 전체를 받는 것이 맞다.\r\n1693:  */\r\n1694: function boundedAnchors<T extends { centerX: number }>(\r\n1695:   anchors: T[],\r\n1696: ): Array<T & { limit: number }> {\r\n1697:   const sorted = [...anchors].sort(\r\n1698:     (left, right) => left.centerX - right.centerX,\r\n1699:   )\r\n1700:   return sorted.map((anchor, index) => {\r\n1701:     const gaps = [\r\n1702:       index > 0 ? anchor.centerX - sorted[index - 1].centerX : undefined,\r\n1703:       index + 1 < sorted.length\r\n1704:         ? sorted[index + 1].centerX - anchor.centerX\r\n1705:         : undefined,\r\n1706:     ].filter((gap): gap is number => gap !== undefined)\r\n1707:     return { ...anchor, limit: Math.min(...gaps) }\r\n1708:   })\r\n1709: }\r\n1710: \r\n1711: function scalarDimensions(\r\n1712:   rows: TextRow[],\r\n1713:   startY: number,\r\n1714:   endY: number,\r\n1715:   marks: MarkColumn[],\r\n1716: ): Map<string, string> {\r\n1717:   if (marks.length === 0) return new Map()\r\n1718:   const numericSegments = rows\r\n1719:     .filter((row) => row.y > startY && row.y < endY)\r\n1720:     .flatMap((row) => row.segments)\r\n1721:     .filter((segment) => /^\\d[\\d\\s,]*$/.test(normalized(segment.text)))\r\n1722: \r\n1723:   // 열당 숫자 세그먼트가 정확히 1개일 때만 넘긴다 — 2개 이상을 이어붙이면\r\n1724:   // 「700」+「900」이 700900mm가 된다. 넘긴 값도 b×d로 확정되지는 않고\r\n1725:   // setDimension에서 빈칸+원문 참고로 남는다.\r\n1726:   const perMark = new Map<string, string[]>()\r\n1727:   const bounded = boundedAnchors(marks)\r\n1728:   for (const segment of numericSegments) {\r\n1729:     const target = bounded.reduce((closest, candidate) =>\r\n1730:       Math.abs(candidate.centerX - segment.centerX) <\r\n1731:       Math.abs(closest.centerX - segment.centerX)\r\n1732:         ? candidate\r\n1733:         : closest,\r\n1734:     )\r\n1735:     // 세로 런과 같은 상한을 건다 — 한쪽만 상한이 없으면 스케치 대역의 아무 숫자나\r\n1736:     // 최근접 열에 붙어 이슈 없는 확정 b가 된다\r\n1737:     if (Math.abs(target.centerX - segment.centerX) > target.limit) continue\r\n1738:     const existing = perMark.get(target.mark) ?? []\r\n1739:     existing.push(segment.compact)\r\n1740:     perMark.set(target.mark, existing)\r\n1741:   }\r\n1742: \r\n1743:   // 콤마는 자릿수 구분이다(parseDimension도 벗겨 받는다, verticalsByMark와 같은 규약) —\r\n1744:   // 여기서 「1,200」을 숫자가 아니라고 버리면 폭 1,000mm 이상인 부재를 놓친다\r\n1745:   return new Map(\r\n1746:     [...perMark.entries()].flatMap(([mark, values]) => {\r\n1747:       const text = values[0].replace(/,/g, '')\r\n1748:       return values.length === 1 && /^\\d+$/.test(text)\r\n1749:         ? [[mark, text] as const]\r\n1750:         : []\r\n1751:     }),\r\n1752:   )\r\n1753: }\r\n1754: \r\n1755: /**\r\n1756:  * 세로 치수를 열별로 모은다. scalarDimensions와 같은 규약 — 열당 정확히 1개일 때만\r\n1757:  * 넘긴다. 한 셀에 세로 숫자가 둘이면 어느 쪽이 断面인지 판정할 근거가 없다.\r\n1758:  */\r\n1759: function verticalsByMark(\r\n1760:   runs: VerticalRun[],\r\n1761:   anchors: MarkColumn[],\r\n1762: ): Map<string, string> {\r\n1763:   // 라벨 행에 매인 가로 값과 달리 세로 런은 표 어디에나 있을 수 있어, 상한이 없으면\r\n1764:   // 남의 열 숫자가 이 열의 d로 확정된다. 符号이 하나면 열 간격을 잴 수 없다 —\r\n1765:   // 상한을 세울 근거가 없으니 짝짓지 않는다. 앵커 수로 재면 안 된다: 位置 열이\r\n1766:   // 한 符号을 여러 앵커로 늘리므로 단일 符号 표에서도 통과한다\r\n1767:   if (new Set(anchors.map(({ mark }) => mark)).size < 2) return new Map()\r\n1768:   const bounded = boundedAnchors(anchors)\r\n1769:   const perMark = new Map<string, string[]>()\r\n1770: \r\n1771:   for (const run of runs) {\r\n1772:     // 콤마는 자릿수 구분이다(parseDimension도 벗겨 받는다). 여기서 「1,200」을\r\n1773:     // 숫자가 아니라고 버리면 카운트에서도 빠져 「열당 정확히 1개」 방어가 뚫린다\r\n1774:     const text = run.text.replace(/,/g, '')\r\n1775:     if (!/^\\d+$/.test(text)) continue\r\n1776:     const target = bounded.reduce((closest, candidate) =>\r\n1777:       Math.abs(candidate.centerX - run.x) < Math.abs(closest.centerX - run.x)\r\n1778:         ? candidate\r\n1779:         : closest,\r\n1780:     )\r\n1781:     if (Math.abs(target.centerX - run.x) > target.limit) continue\r\n1782:     const bucket = perMark.get(target.mark)\r\n1783:     if (bucket) bucket.push(text)\r\n1784:     else perMark.set(target.mark, [text])\r\n1785:   }\r\n1786: \r\n1787:   return new Map(\r\n1788:     [...perMark.entries()].flatMap(([mark, values]) =>\r\n1789:       values.length === 1 ? [[mark, values[0]] as const] : [],\r\n1790:     ),\r\n1791:   )\r\n1792: }\r\n1793: \r\n1794: /**\r\n1795:  * 「形状断面」だけを見出しにしたスケッチ型の柱表から、横に並ぶ b 寸法を拾う。\r\n1796:  * 通常の scalarDimensions はラベル行と主筋・フープ行の間を読むため、形状断面\r\n1797:  * が独立した行にある表では寸法を捨ててしまう。値は各符号の最近接かつ隣列の\r\n1798:  * 境界内に限り、同じ列の別寸法を連結しない。\r\n1799:  */\r\n1800: function sketchColumnHorizontalValues(\r\n1801:   rows: TextRow[],\r\n1802:   startY: number,\r\n1803:   endY: number,\r\n1804:   anchors: MarkColumn[],\r\n1805: ): Map<string, string> {\r\n1806:   const numeric = rows\r\n1807:     .filter((row) => row.y > startY && row.y <= endY)\r\n1808:     .flatMap((row) => row.segments)\r\n1809:     .filter((segment) => /^\\d[\\d,]*$/.test(normalized(segment.text)))\r\n1810: \r\n1811:   return new Map(\r\n1812:     boundedAnchors(anchors).flatMap((anchor) => {\r\n1813:       const candidates = numeric.filter(\r\n1814:         (segment) => Math.abs(segment.centerX - anchor.centerX) <= anchor.limit,\r\n1815:       )\r\n1816:       const nearest = candidates.sort(\r\n1817:         (left, right) =>\r\n1818:           Math.abs(left.centerX - anchor.centerX) -\r\n1819:           Math.abs(right.centerX - anchor.centerX),\r\n1820:       )[0]\r\n1821:       if (!nearest) return []\r\n1822:       return [[anchor.mark, normalized(nearest.text).replace(/,/g, '')] as const]\r\n1823:     }),\r\n1824:   )\r\n1825: }\r\n1826: \r\n1827: /**\r\n1828:  * Fuji の柱スケッチは縦寸法が「形状断面」行の直上に立つ。横寸法と同じ列に\r\n1829:  * 置かれた数値のうち、形状断面に最も近い水平ランだけを符号へ対応させる。\r\n1830:  * 別の寸法列を同じ d に使わないため、y の最近接を先に固定する。\r\n1831:  */\r\n1832: function sketchColumnVerticalValues(\r\n1833:   verticals: VerticalRun[],\r\n1834:   shapeY: number,\r\n1835:   anchors: MarkColumn[],\r\n1836: ): Map<string, string> {\r\n1837:   const numeric = verticals.filter((run) => /^\\d[\\d,]*$/.test(run.text))\r\n1838:   if (numeric.length === 0) return new Map()\r\n1839:   const nearestDistance = Math.min(\r\n1840:     ...numeric.map((run) => Math.abs(run.y - shapeY)),\r\n1841:   )\r\n1842:   const nearestRows = numeric.filter(\r\n1843:     (run) => Math.abs(Math.abs(run.y - shapeY) - nearestDistance) < 0.01,\r\n1844:   )\r\n1845: \r\n1846:   return new Map(\r\n1847:     boundedAnchors(anchors).flatMap((anchor) => {\r\n1848:       const candidates = nearestRows.filter(\r\n1849:         (run) => Math.abs(run.x - anchor.centerX) <= anchor.limit,\r\n1850:       )\r\n1851:       const nearest = candidates.sort(\r\n1852:         (left, right) =>\r\n1853:           Math.abs(left.x - anchor.centerX) - Math.abs(right.x - anchor.centerX),\r\n1854:       )[0]\r\n1855:       if (!nearest) return []\r\n1856:       return [[anchor.mark, nearest.text.replace(/,/g, '')] as const]\r\n1857:     }),\r\n1858:   )\r\n1859: }\r\n1860: \r\n1861: /**\r\n1862:  * 세로 치수를 층 슬라이스에 배정한다. 스케치의 세로 치수는 층 라벨 행보다 위에\r\n1863:  * 놓이기도 해서 슬라이스의 y대역(라벨 행 ~ 다음 라벨 행)으로 자르면 통째로 빠진다.\r\n1864:  *\r\n1865:  * 배정 앵커는 **표의 행 중 런에 가장 가까운 것**이고, 그 행이 든 슬라이스가 임자다.\r\n1866:  * 층 라벨을 앵커로 쓰면 둘이 함께 망가졌다 (#32①):\r\n1867:  *   - 슬라이스가 맞닿아 있어(endY[i] == startY[i+1]) 라벨 최근접의 보로노이 경계가\r\n1868:  *     span/2와 정확히 일치한다 — 아래 거리 상한이 중간 층에서 항상 참이 됐다.\r\n1869:  *   - 자기 층 데이터 행 사이에 있는 런이 더 가까운 아래 층 라벨로 넘어가, 그 층이\r\n1870:  *     남의 치수로 확정됐다.\r\n1871:  * 행을 앵커로 쓰면 라벨까지의 거리가 span/2를 넘을 수 있어 상한이 실제로 작동한다.\r\n1872:  *\r\n1873:  * rows에 표 밖 행을 넘기지 말 것 — 실물 ojkk p3의 2F 스케치에서는 표제란의\r\n1874:  * 図面名称 행이 세로 치수에서 0.6pt 거리라 층 라벨(12.3pt)보다 가깝다.\r\n1875:  *\r\n1876:  * 실물 5면 70건에서 이 배정은 층 라벨 최근접과 결과가 같다(전수 대조). 바뀌는 것은\r\n1877:  * 위 두 실패뿐이다.\r\n1878:  */\r\n1879: function verticalsBySlice(\r\n1880:   runs: VerticalRun[],\r\n1881:   slices: Array<{ startY: number; endY: number }>,\r\n1882:   rows: TextRow[],\r\n1883: ): VerticalRun[][] {\r\n1884:   const buckets: VerticalRun[][] = slices.map(() => [])\r\n1885:   if (slices.length === 0) return buckets\r\n1886: \r\n1887:   for (const run of runs) {\r\n1888:     const anchorY =\r\n1889:       rows.length > 0\r\n1890:         ? rows.reduce((closest, row) =>\r\n1891:             Math.abs(row.y - run.y) < Math.abs(closest.y - run.y) ? row : closest,\r\n1892:           ).y\r\n1893:         : run.y\r\n1894:     // 슬라이스는 맞닿아 정렬돼 있으므로, startY가 앵커 이하인 마지막 슬라이스가\r\n1895:     // 그 행을 담은 슬라이스다. 첫 슬라이스보다 위(머리행 등)면 첫 슬라이스로 본다\r\n1896:     let best = 0\r\n1897:     slices.forEach((slice, index) => {\r\n1898:       if (slice.startY <= anchorY) best = index\r\n1899:     })\r\n1900:     // 자기 블록의 마지막 행보다 아래에 있는 런은 어느 층의 것도 아니다. 그\r\n1901:     // 블록의 내용은 거기서 끝나고 다음 층 라벨까지는 빈칸인데, 대역만 보면 그\r\n1902:     // 빈칸도 아직 이 슬라이스라 아래 거리가 0이 되어 남의 치수가 조용히 확정된다.\r\n1903:     // 실물에서 세로 치수는 빈칸의 **아래쪽**, 자기 층 라벨 바로 위에 놓이므로\r\n1904:     // (실측 7.68~13.46pt, 5면 51건) 자기 블록의 첫 행보다도 위다 — 이 규칙에\r\n1905:     // 걸리지 않는다. 빈칸 위쪽에 뜬 숫자는 임자를 가릴 근거가 없으니 확정하지\r\n1906:     // 않고 원문으로 남긴다 (R10, PR #61 리뷰 major)\r\n1907:     // 자기 행의 범위는 endY 가 아니라 **다음 슬라이스의 startY** 로 끊는다.\r\n1908:     // 호출부가 마지막 슬라이스의 endY 를 tableBottom(= 표 바닥 행 자신의 y)으로\r\n1909:     // 자르므로, endY 를 배타 상한으로 쓰면 그 행이 빠져 최하층에서만 lastRowY 가\r\n1910:     // 한 행 위로 밀린다 (PR #61 리뷰 major)\r\n1911:     const bandEnd = slices[best + 1]?.startY ?? Number.POSITIVE_INFINITY\r\n1912:     const lastRowY = rows.reduce(\r\n1913:       (last, row) =>\r\n1914:         row.y >= slices[best].startY && row.y < bandEnd && row.y > last\r\n1915:           ? row.y\r\n1916:           : last,\r\n1917:       slices[best].startY,\r\n1918:     )\r\n1919:     if (run.y > lastRowY) continue\r\n1920: \r\n1921:     // 자기 층 스케치가 아닌 런은 버린다. 거리 제한 없이 넣으면 어떤 숫자든 어느\r\n1922:     // 층엔가 붙어 이슈 없는 확정 d가 된다 — 미지 형식에서는 확정하지 않고 원문으로\r\n1923:     // 남는 쪽이 옳다 (R10)\r\n1924:     //\r\n1925:     // 거리는 라벨(startY) 한 점이 아니라 슬라이스 **대역**까지로 잰다. 앵커가 행인데\r\n1926:     // 상한만 라벨 기준이면 임자 슬라이스가 자기 런을 버린다 — 대역 하반부에 놓인\r\n1927:     // 런은 옳게 배정되고도 startY 에서 span/2 를 넘어 폐기된다 (PR #61 리뷰 major)\r\n1928:     const { startY, endY } = slices[best]\r\n1929:     const span = endY - startY\r\n1930:     const distance = Math.max(startY - run.y, run.y - endY, 0)\r\n1931:     if (distance <= span * SLICE_DISTANCE_LIMIT_RATIO) buckets[best].push(run)\r\n1932:   }\r\n1933: \r\n1934:   return buckets\r\n1935: }\r\n1936: \r\n1937: /**\r\n1938:  * 표의 실제 바닥 y를 구한다. 마지막 블록의 endY는 다음 타이틀이 없으면 페이지\r\n1939:  * 바닥까지 열려 있어, blockRows.at(-1)이 표 밖 표제란 텍스트(도면번호·축척 등)가\r\n1940:  * 될 수 있다 — 符号 열의 x대역(≤ tableRight) 안에 세그먼트가 있는 행으로 먼저\r\n1941:  * 좁혀야 표 밖 텍스트가 수집 창을 밀어내지 않는다 (#37, #33의 부작용)\r\n1942:  */\r\n1943: function tableBottomY(\r\n1944:   blockRows: TextRow[],\r\n1945:   marks: MarkColumn[],\r\n1946:   endY: number,\r\n1947: ): number {\r\n1948:   return rowsWithinTable(blockRows, marks).at(-1)?.y ?? endY\r\n1949: }\r\n1950: \r\n1951: /**\r\n1952:  * 표 안 행만 남긴다 — 符号 열의 x대역(≤ tableRight) 안에 세그먼트가 있는 행이다.\r\n1953:  * 표제란(図面名称·管理建築士 등)은 표와 같은 y대역에 걸쳐 있어 y로는 못 가른다.\r\n1954:  */\r\n1955: function rowsWithinTable(blockRows: TextRow[], marks: MarkColumn[]): TextRow[] {\r\n1956:   const tableRight = Math.max(...marks.map(({ centerX }) => centerX))\r\n1957:   return blockRows.filter((row) =>\r\n1958:     row.segments.some((segment) => segment.centerX <= tableRight),\r\n1959:   )\r\n1960: }\r\n1961: \r\n1962: function parseColumnBlock(\r\n1963:   rows: TextRow[],\r\n1964:   headerIndex: number,\r\n1965:   endY: number,\r\n1966:   titleText: string,\r\n1967:   verticals: VerticalRun[],\r\n1968: ): SectionCandidate[] {\r\n1969:   const header = rows[headerIndex]\r\n1970:   const marks = markColumns(header)\r\n1971:   if (marks.length === 0) return []\r\n1972:   const blockRows = rowsBetween(rows, header.y, endY)\r\n1973:   const stories = storyRows(blockRows)\r\n1974:   // 平屋 등 階 라벨이 없는 표는 大梁 블록과 같은 폴백으로 한 슬라이스 처리한다 —\r\n1975:   // 조기 반환하면 표가 통째로 「인식 불가」로 사라진다\r\n1976:   const slices: Array<{\r\n1977:     storyLabel: string | undefined\r\n1978:     startY: number\r\n1979:     endY: number\r\n1980:   }> =\r\n1981:     stories.length > 0\r\n1982:       ? stories.map((story, index) => ({\r\n1983:           storyLabel: story.label,\r\n1984:           startY: story.row.y,\r\n1985:           endY: stories[index + 1]?.row.y ?? endY,\r\n1986:         }))\r\n1987:       : [{ storyLabel: undefined, startY: header.y, endY }]\r\n1988:   // 수집 창을 표의 실제 행 범위로 닫는다. 가로 치수는 라벨 행 사이로 좁게 잘리므로\r\n1989:   // 같은 노출이 없다\r\n1990:   const tableBottom = tableBottomY(blockRows, marks, endY)\r\n1991:   const blockVerticals = verticalsBySlice(\r\n1992:     verticals.filter((run) => run.y > header.y && run.y < tableBottom),\r\n1993:     // 마지막 슬라이스의 endY는 표의 끝이 아니라 다음 타이틀·페이지 바닥이다.\r\n1994:     // 그대로 두면 그 층에서만 거리 상한이 층 간격의 몇 배로 벌어진다\r\n1995:     slices.map((slice) => ({\r\n1996:       startY: slice.startY,\r\n1997:       endY: Math.min(slice.endY, tableBottom),\r\n1998:     })),\r\n1999:     rowsWithinTable(blockRows, marks),\r\n2000:   )\r\n2001: \r\n2002:   const candidates: SectionCandidate[] = []\r\n2003:   for (const [sliceIndex, slice] of slices.entries()) {\r\n2004:     const dataRows = rowsBetween(rows, slice.startY, slice.endY)\r\n2005:     const preSliceRows = rows.filter(\r\n2006:       (row) => row.y > header.y && row.y < slice.startY,\r\n2007:     )\r\n2008:     const shapeRow =\r\n2009:       preSliceRows\r\n2010:         .filter((row) => exactLabel(row, ['形状断面']))\r\n2011:         .at(-1) ??\r\n2012:       dataRows.find((row) => exactLabel(row, ['形状断面']))\r\n2013:     const mainRows = dataRows.filter((row) => exactLabel(row, ['主筋']))\r\n2014:     const hoopRows = dataRows.filter((row) =>\r\n2015:       exactLabel(row, ['帯筋', 'HOOP', 'フープ']),\r\n2016:     )\r\n2017:     // 라벨 존재만 보면 값 세그먼트가 없는 라벨 행이 scalarDimensions 폴백까지\r\n2018:     // 막아 원문 참고 표시가 통째로 사라진다 — 大梁 블록과 같은 조건을 쓴다\r\n2019:     const inSliceDimensionRows = dataRows.filter(\r\n2020:       (row) => isDimensionRow(row, ['断面', 'B×D', 'b×D'], marks),\r\n2021:     )\r\n2022:     // 일부 발주처는 階 행보다 먼저 공통 断面 행을 둔다. 해당 행을 놓치면\r\n2023:     // 3.5k 수치만 남아 b×d가 조용히 사라지므로, 슬라이스 직전의 가장 가까운\r\n2024:     // 断面 행을 쓰되 이전 층의 행을 여러 개 섞어 확정하지 않는다.\r\n2025:     const dimensionRows =\r\n2026:       inSliceDimensionRows.length > 0\r\n2027:         ? inSliceDimensionRows\r\n2028:         : preSliceRows\r\n2029:             .filter((row) => isDimensionRow(row, ['断面', 'B×D', 'b×D'], marks))\r\n2030:             .slice(-1)\r\n2031:     // 한 슬라이스에 같은 라벨 행이 겹으로 있으면 여러 층 블록이 합쳐진 것이다 —\r\n2032:     // 階 라벨이 하나도 인식되지 않은 표(「一般階」)든 일부만 인식된 표(「1F」+「B1F」)든\r\n2033:     // 첫 행 값을 확정하면 나머지 층 값이 사유도 원문도 없이 사라진다\r\n2034:     const storyAmbiguous =\r\n2035:       mainRows.length > 1 || hoopRows.length > 1 || dimensionRows.length > 1\r\n2036:     const mainRow = storyAmbiguous ? undefined : mainRows[0]\r\n2037:     const hoopRow = storyAmbiguous ? undefined : hoopRows[0]\r\n2038:     const dimensionRow = storyAmbiguous ? undefined : dimensionRows[0]\r\n2039:     const positionRow =\r\n2040:       lastPositionRow(rows, header.y, slice.startY) ??\r\n2041:       dataRows.find((row) => exactLabel(row, ['位置']))\r\n2042:     const positions = positionRow ? positionColumns(positionRow, marks) : []\r\n2043:     const mainContinuations = mainRow\r\n2044:       ? barContinuationByMark(dataRows, mainRow, slice.endY, marks, BAR_TOKEN)\r\n2045:       : new Map<string, string>()\r\n2046:     const hoopContinuations = hoopRow\r\n2047:       ? barContinuationByMark(dataRows, hoopRow, slice.endY, marks, PITCH_TOKEN)\r\n2048:       : new Map<string, string>()\r\n2049:     // 스케치 치수는 가로·세로 모두 같은 열 앵커로 배정한다 — 한쪽만 符号 중심이면\r\n2050:     // 그쪽에서만 좁은 이웃 칸이 값을 가져간다\r\n2051:     const anchors = markAnchors(marks, positions)\r\n2052:     const rawDimensionValues = storyAmbiguous\r\n2053:       ? new Map<string, string>()\r\n2054:       : dimensionRow\r\n2055:         ? valuesByMark(dimensionRow, ['断面', 'B×D', 'b×D'], marks)\r\n2056:         : shapeRow\r\n2057:           ? sketchColumnHorizontalValues(\r\n2058: 