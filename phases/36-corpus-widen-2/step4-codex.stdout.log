チ」일 때만 채택한다 — 부분 매치를 허용하면\r\n 626:   // 組数 접두사(「2-D13@100」)가 조용히 떨어져 1組로 절반 계상된다.\r\n 627:   // 呼び名의 접두 영문자를 D로 한정하지 않는 것은 高強度せん断補強筋 때문이고,\r\n 628:   // 목록에 없는 呼び名은 아래 집합 검사에서 빈칸+원문으로 떨어진다 (R10)\r\n 629:   const match = stripDecoration(value).match(\r\n 630:     /^([A-Z]\\d+(?:\\.\\d+)?)(?:-?@([\\d,]+)|-?([\\d,]+)@)$/i,\r\n 631:   )\r\n 632:   if (!match) return undefined\r\n 633:   const size = match[1].toUpperCase() as ShearBarSize\r\n 634:   if (!shearBarSizes.has(size)) return undefined\r\n 635:   const pitchText = match[2] ?? match[3]\r\n 636:   const pitchMm = Number(pitchText.replace(/,/g, ''))\r\n 637:   // 쉼표가 있는 네 자리 피치는 명시적인 자릿수 구분(예: 1,000)이다. 쉼표 없는\r\n 638:   // 네 자리 값은 기존과 같이 인접 세그먼트가 붙은 잔재로 보아 확정하지 않는다.\r\n 639:   if (pitchMm <= 0 || (pitchMm > 999 && !pitchText.includes(','))) return undefined\r\n 640:   return { size, pitchMm }\r\n 641: }\r\n 642: \r\n 643: /**\r\n 644:  * compact된 特記를 「1.」부터 순차인 번호열로 먼저 가른다. 숫자가 피치에 붙어\r\n 645:  * 「@5002.」가 되어도 다음 번호가 2라는 사실이 오른쪽 경계를 증명한다.\r\n 646:  * 번호열이 없으면 표제 전체가 한 항목이며, 빈 항목은 번호열의 증명이 아니므로\r\n 647:  * 분리하지 않는다.\r\n 648:  */\r\n 649: function sequentialTitleItems(titleText: string): string[] {\r\n 650:   const text = compact(titleText)\r\n 651:   const firstMarker = text.indexOf('1.')\r\n 652:   if (firstMarker < 0) return [text]\r\n 653: \r\n 654:   const items: string[] = []\r\n 655:   let itemStart = firstMarker + '1.'.length\r\n 656:   let nextNumber = 2\r\n 657: \r\n 658:   while (true) {\r\n 659:     const marker = `${nextNumber}.`\r\n 660:     const boundary = text.indexOf(marker, itemStart)\r\n 661:     if (boundary < 0) {\r\n 662:       const lastItem = text.slice(itemStart)\r\n 663:       return lastItem.length > 0 ? [...items, lastItem] : [text]\r\n 664:     }\r\n 665: \r\n 666:     const item = text.slice(itemStart, boundary)\r\n 667:     const nextStart = boundary + marker.length\r\n 668:     if (item.length === 0 || nextStart >= text.length) return [text]\r\n 669: \r\n 670:     items.push(item)\r\n 671:     itemStart = nextStart\r\n 672:     nextNumber += 1\r\n 673:   }\r\n 674: }\r\n 675: \r\n 676: function widthTieFromTitle(\r\n 677:   titleText: string,\r\n 678: ): { value?: SectionCandidate['widthTie']; raw?: string } | undefined {\r\n 679:   const item = sequentialTitleItems(titleText).find((candidate) =>\r\n 680:     /(?:幅|巾)止(?:め)?筋/.test(candidate),\r\n 681:   )\r\n 682:   if (!item) return undefined\r\n 683: \r\n 684:   const label = item.match(/(?:幅|巾)止(?:め)?筋/)\r\n 685:   if (!label || label.index === undefined) return undefined\r\n 686: \r\n 687:   const raw = item.slice(label.index)\r\n 688:   // 항목 경계를 증명한 뒤에는 자릿수로 피치 끝을 추측하지 않는다. 幅止め筋 항목\r\n 689:   // 전체가 이 문법일 때만 확정하고, 뒤에 다른 特記가 붙으면 raw 경로로 보낸다.\r\n 690:   const match = raw.match(\r\n 691:     /^(?:幅|巾)止(?:め)?筋(?:は)?([A-Z]\\d+(?:\\.\\d+)?)-?@(\\d+)(?:とする)?[。.]*$/i,\r\n 692:   )\r\n 693:   if (!match) return { raw }\r\n 694: \r\n 695:   const size = match[1].toUpperCase() as BarSize\r\n 696:   const pitchMm = Number(match[2])\r\n 697:   if (!barSizes.has(size) || pitchMm <= 0) return { raw }\r\n 698: \r\n 699:   return {\r\n 700:     value: { size, pitchMm },\r\n 701:   }\r\n 702: }\r\n 703: \r\n 704: // 4자리 초과는 셀 병합 잔재, 한 자리는 소수 표기(「0.8×0.8」→8×0)의 잔재다 —\r\n 705: // 어느 쪽도 확정하지 않는다\r\n 706: function inDimensionRange(b: number, depth: number): boolean {\r\n 707:   return b >= 10 && b <= 9999 && depth >= 10 && depth <= 9999\r\n 708: }\r\n 709: \r\n 710: /**\r\n 711:  * 円形断面の「600φ」。φ・Φ・㎜表記のゆれだけを見る — 数値ひとつだけの\r\n 712:  * セル（スケッチの寸法線）は円と読まない。直径記号があることが根拠である。\r\n 713:  */\r\n 714: function parseCircularDimension(value: string): { diameter: number } | undefined {\r\n 715:   const match = normalized(value).match(/^(\\d[\\d,]*)\\s*[φΦ]$|^[φΦ]\\s*(\\d[\\d,]*)$/)\r\n 716:   if (!match) return undefined\r\n 717:   const diameter = Number((match[1] ?? match[2]).replace(/,/g, ''))\r\n 718:   return inDimensionRange(diameter, diameter) ? { diameter } : undefined\r\n 719: }\r\n 720: \r\n 721: function parseDimension(value: string): { b: number; depth: number } | undefined {\r\n 722:   // 이웃 셀이 붙은 「800×800 900×900」에서 첫 매치를 취하면 두 번째 그룹이\r\n 723:   // 공백 너머 숫자까지 삼켜 b=800·depth=800900이 된다 — 다중 매치는 거부한다\r\n 724:   const matches = [\r\n 725:     ...normalized(value).matchAll(/[\\d,]+\\s*[x×*]\\s*[\\d,]+/gi),\r\n 726:   ]\r\n 727:   if (matches.length !== 1) return undefined\r\n 728:   const [bText, depthText] = matches[0][0].split(/[x×*]/i)\r\n 729:   const b = Number(bText.replace(/,/g, '').trim())\r\n 730:   const depth = Number(depthText.replace(/,/g, '').trim())\r\n 731:   return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n 732: }\r\n 733: \r\n 734: /**\r\n 735:  * 스케치에 붙은 가로·세로 치수를 짝지어 b×d를 읽는다. 断面 라벨 행이 없는 표에서는\r\n 736:  * 이 둘이 유일한 근거다. 한쪽만으로는 확정하지 않는다 — 단독 숫자를 정사각형으로\r\n 737:  * 승격하는 것은 도면에 없는 값을 만드는 것이다.\r\n 738:  */\r\n 739: function pairedDimension(\r\n 740:   horizontal: string,\r\n 741:   vertical: string,\r\n 742: ): { b: number; depth: number } | undefined {\r\n 743:   if (!/^\\d+$/.test(horizontal) || !/^\\d+$/.test(vertical)) return undefined\r\n 744:   const b = Number(horizontal)\r\n 745:   const depth = Number(vertical)\r\n 746:   return inDimensionRange(b, depth) ? { b, depth } : undefined\r\n 747: }\r\n 748: \r\n 749: /**\r\n 750:  * 확정하지 못한 셀에 남기는 원문 참고 표시. 머리의 장식만 벗기고 나머지는 그대로\r\n 751:  * 둔다 — 토큰만 뽑아 줄이면 「2-D13@100」의 @100처럼 원문 정보가 사라진다.\r\n 752:  *\r\n 753:  * 장식만으로 이루어진 셀은 벗기면 빈 문자열이 되므로 되살린다. 「―」는 「해당 없음」을\r\n 754:  * 뜻하는 값인데(yokohama p13 腹筋 행), 빈칸으로 내보내면 화면에서 「읽지 못한 셀」과\r\n 755:  * 구별되지 않는다.\r\n 756:  */\r\n 757: function cleanedRebarRaw(value: string): string {\r\n 758:   return stripDecoration(value) || compact(value)\r\n 759: }\r\n 760: \r\n 761: function addIssue(candidate: SectionCandidate, issue: CandidateIssue): void {\r\n 762:   if (!candidate.issues.includes(issue)) candidate.issues.push(issue)\r\n 763: }\r\n 764: \r\n 765: function setDimension(\r\n 766:   candidate: SectionCandidate,\r\n 767:   value: string | undefined,\r\n 768:   column: boolean,\r\n 769:   vertical?: string,\r\n 770: ): void {\r\n 771:   if (!value) {\r\n 772:     // 세로만 읽힌 칸도 원문을 남긴다 — 조용히 버리면 사용자는 왜 断面이 비었는지\r\n 773:     // 알 수 없다. 확정하지 못한 칸은 빈칸+원문 참고가 이 파서의 규약이다\r\n 774:     if (vertical !== undefined) {\r\n 775:       candidate.raw['断面'] = compact(vertical)\r\n 776:       addIssue(candidate, '断面矩形不成立')\r\n 777:     }\r\n 778:     return\r\n 779:   }\r\n 780:   // 円形は柱にしかない。大梁の断面欄にφが来たらそれは読み違えなので確定しない。\r\n 781:   const circular = column ? parseCircularDimension(value) : undefined\r\n 782:   if (circular) {\r\n 783:     candidate.shape = '円形'\r\n 784:     candidate.b = circular.diameter\r\n 785:     candidate.d = circular.diameter\r\n 786:     return\r\n 787:   }\r\n 788: \r\n 789:   const parsed =\r\n 790:     parseDimension(value) ??\r\n 791:     (vertical !== undefined ? pairedDimension(value, vertical) : undefined)\r\n 792:   if (parsed) {\r\n 793:     if (column) candidate.shape = '矩形'\r\n 794:     candidate.b = parsed.b\r\n 795:     if (column) candidate.d = parsed.depth\r\n 796:     else candidate.depth = parsed.depth\r\n 797:     return\r\n 798:   }\r\n 799: \r\n 800:   // 단독 숫자는 b×d로 확정할 수 없다 — 스케치 치수선 숫자를 정사각형으로\r\n 801:   // 승격하면 값을 지어내는 것이 된다 (ADR-012 계열). 빈칸+원문으로 남긴다.\r\n 802:   // 세로도 읽었는데 짝짓기(pairedDimension)가 거부한 경우, 가로만 남기면\r\n 803:   // 원문 세로값이 조용히 사라진다 — 함께 남긴다\r\n 804:   candidate.raw['断面'] = compact(value)\r\n 805:   if (vertical !== undefined) candidate.raw['断面(縦)'] = compact(vertical)\r\n 806:   addIssue(candidate, '断面矩形不成立')\r\n 807: }\r\n 808: \r\n 809: function setColumnMain(\r\n 810:   candidate: SectionCandidate,\r\n 811:   cells: Array<{ position?: string; raw: string }>,\r\n 812:   expectedCellCount: number,\r\n 813: ): void {\r\n 814:   if (cells.length === 0) return\r\n 815:   const parsed = cells.map(({ raw }) => parseBar(raw))\r\n 816:   const allParsed = parsed.every((entry): entry is ParsedBar => entry !== undefined)\r\n 817:   const allEqual =\r\n 818:     allParsed &&\r\n 819:     parsed.every(\r\n 820:       (entry) => entry.count === parsed[0].count && entry.size === parsed[0].size,\r\n 821:     )\r\n 822:   const complete =\r\n 823:     expectedCellCount === 0 || cells.length === expectedCellCount\r\n 824: \r\n 825:   if (allEqual && complete) {\r\n 826:     candidate.main = parsed[0]\r\n 827:     return\r\n 828:   }\r\n 829: \r\n 830:   for (const cell of cells) {\r\n 831:     const key = cell.position ? `主筋(${cell.position})` : '主筋'\r\n 832:     candidate.raw[key] = cleanedRebarRaw(cell.raw)\r\n 833:   }\r\n 834:   addIssue(\r\n 835:     candidate,\r\n 836:     !allParsed\r\n 837:       ? cells.some(({ raw }) => isTwoLayerBar(raw))\r\n 838:         ? '2段筋未対応'\r\n 839:         : '主筋解釈不能'\r\n 840:       : !complete\r\n 841:         ? '主筋位置欠落'\r\n 842:         : '主筋位置相違',\r\n 843:   )\r\n 844: }\r\n 845: \r\n 846: /**\r\n 847:  * 位置欄のラベルが指す区間。「Y3端」「外端」のように通り芯名や向きが付く表もあるが、\r\n 848:  * 末尾の「端」が端部を指すのは共通する。読めないラベルは undefined にして、\r\n 849:  * 端部・中央に読み替えない — 読み替えれば図面にない断面を作る。\r\n 850:  */\r\n 851: function positionZone(label: string): '端部' | '中央' | undefined {\r\n 852:   const normalizedLabel = compact(label)\r\n 853:   if (normalizedLabel.includes('中央')) return '中央'\r\n 854:   if (normalizedLabel.includes('端')) return '端部'\r\n 855:   return undefined\r\n 856: }\r\n 857: \r\n 858: function isThreePositionLayout(\r\n 859:   cells: Array<{ position: string }>,\r\n 860: ): boolean {\r\n 861:   const zones = cells.map(({ position }) => positionZone(position))\r\n 862:   return (\r\n 863:     cells.length === 3 &&\r\n 864:     zones[0] === '端部' &&\r\n 865:     zones[1] === '中央' &&\r\n 866:     zones[2] === '端部'\r\n 867:   )\r\n 868: }\r\n 869: \r\n 870: function uniqueCount(bars: ParsedBar[]): number | undefined {\r\n 871:   const first = bars[0]\r\n 872:   if (first === undefined) return undefined\r\n 873:   return bars.every((bar) => bar.count === first.count)\r\n 874:     ? first.count\r\n 875:     : undefined\r\n 876: }\r\n 877: \r\n 878: /**\r\n 879:  * 位置で本数を分けている表を、端部欄と中央欄の対として読む。\r\n 880:  *\r\n 881:  * 「Y3端／Y4端」のように両端が違う三欄表は、位置ラベルと左右の本数を\r\n 882:  * そのまま候補に載せる。二欄の端部・中央表は従来どおり単一の端部本数に\r\n 883:  * 畳み込む。径は全欄で一つに揃っている表だけを確定する。\r\n 884:  */\r\n 885: function positionalGirderMain(\r\n 886:   cells: Array<{ position: string; rawPosition?: string }>,\r\n 887:   top: ParsedBar[],\r\n 888:   bottom: ParsedBar[],\r\n 889: ):\r\n 890:   | { girderMain: NonNullable<SectionCandidate['girderMain']> }\r\n 891:   | {\r\n 892:       girderMainAsymmetric: NonNullable<\r\n 893:         SectionCandidate['girderMainAsymmetric']\r\n 894:       >\r\n 895:     }\r\n 896:   | { issue: CandidateIssue }\r\n 897:   | undefined {\r\n 898:   const zones = cells.map(({ position }) => positionZone(position))\r\n 899:   if (zones.some((zone) => zone === undefined)) return undefined\r\n 900: \r\n 901:   // 左端・中央・右端の三欄でない表は、左右非対称の端部として再解釈しない。\r\n 902:   // 端部・中央の二欄は従来どおり、単一の端部本数として扱う。\r\n 903:   const asymmetricLayout = isThreePositionLayout(cells)\r\n 904:   if (cells.length === 3 && !asymmetricLayout) return undefined\r\n 905: \r\n 906:   const pick = (bars: ParsedBar[], zone: '端部' | '中央') =>\r\n 907:     bars.filter((_, index) => zones[index] === zone)\r\n 908:   const endTop = pick(top, '端部')\r\n 909:   const endBottom = pick(bottom, '端部')\r\n 910:   const centerTopCount = uniqueCount(pick(top, '中央'))\r\n 911:   const centerBottomCount = uniqueCount(pick(bottom, '中央'))\r\n 912:   if (\r\n 913:     centerTopCount === undefined ||\r\n 914:     centerBottomCount === undefined ||\r\n 915:     endTop.length === 0 ||\r\n 916:     endBottom.length === 0\r\n 917:   ) {\r\n 918:     if (\r\n 919:       endTop.length > 0 &&\r\n 920:       uniqueCount(endTop) === undefined &&\r\n 921:       !asymmetricLayout\r\n 922:     ) {\r\n 923:       return { issue: '主筋端部左右相違' }\r\n 924:     }\r\n 925:     if (\r\n 926:       endBottom.length > 0 &&\r\n 927:       uniqueCount(endBottom) === undefined &&\r\n 928:       !asymmetricLayout\r\n 929:     ) {\r\n 930:       return { issue: '主筋端部左右相違' }\r\n 931:     }\r\n 932:     return undefined\r\n 933:   }\r\n 934: \r\n 935:   const size = top[0]?.size\r\n 936:   if (size === undefined) return undefined\r\n 937:   if (![...top, ...bottom].every((bar) => bar.size === size)) return undefined\r\n 938: \r\n 939:   if (!asymmetricLayout) {\r\n 940:     const endTopCount = uniqueCount(endTop)\r\n 941:     const endBottomCount = uniqueCount(endBottom)\r\n 942:     if (endTopCount === undefined || endBottomCount === undefined) {\r\n 943:       return { issue: '主筋端部左右相違' }\r\n 944:     }\r\n 945:     return {\r\n 946:       girderMain: {\r\n 947:         size,\r\n 948:         topCount: centerTopCount,\r\n 949:         bottomCount: centerBottomCount,\r\n 950:         endTopCount,\r\n 951:         endBottomCount,\r\n 952:       },\r\n 953:     }\r\n 954:   }\r\n 955: \r\n 956:   const endTopCounts = [top[0]?.count, top[2]?.count] as const\r\n 957:   const endBottomCounts = [bottom[0]?.count, bottom[2]?.count] as const\r\n 958:   if (\r\n 959:     endTopCounts[0] === undefined ||\r\n 960:     endTopCounts[1] === undefined ||\r\n 961:     endBottomCounts[0] === undefined ||\r\n 962:     endBottomCounts[1] === undefined\r\n 963:   ) {\r\n 964:     return undefined\r\n 965:   }\r\n 966: \r\n 967:   const labels = [cells[0]?.position, cells[2]?.position] as const\r\n 968:   if (labels[0] === undefined || labels[1] === undefined) return undefined\r\n 969: \r\n 970:   const asymmetric =\r\n 971:     endTopCounts[0] !== endTopCounts[1] ||\r\n 972:     endBottomCounts[0] !== endBottomCounts[1]\r\n 973:   if (asymmetric) {\r\n 974:     return {\r\n 975:       girderMainAsymmetric: {\r\n 976:         size,\r\n 977:         labels: [labels[0], labels[1]],\r\n 978:         topCounts: [endTopCounts[0], endTopCounts[1]],\r\n 979:         bottomCounts: [endBottomCounts[0], endBottomCounts[1]],\r\n 980:         topCenterCount: centerTopCount,\r\n 981:         bottomCenterCount: centerBottomCount,\r\n 982:       },\r\n 983:     }\r\n 984:   }\r\n 985: \r\n 986:   return {\r\n 987:     girderMain: {\r\n 988:       size,\r\n 989:       topCount: centerTopCount,\r\n 990:       bottomCount: centerBottomCount,\r\n 991:       endTopCount: endTopCounts[0],\r\n 992:       endBottomCount: endBottomCounts[0],\r\n 993:     },\r\n 994:   }\r\n 995: }\r\n 996: \r\n 997: function setGirderMain(\r\n 998:   candidate: SectionCandidate,\r\n 999:   topLabel: string,\r\n1000:   bottomLabel: string,\r\n1001:   topCells: Array<{ position: string; rawPosition?: string; raw: string }>,\r\n1002:   bottomCells: Array<{\r\n1003:     position: string\r\n1004:     rawPosition?: string\r\n1005:     raw: string\r\n1006:   }>,\r\n1007:   expectedCellCount: number,\r\n1008: ): void {\r\n1009:   if (topCells.length === 0 && bottomCells.length === 0) return\r\n1010:   const top = topCells.map(({ raw }) => parseBar(raw))\r\n1011:   const bottom = bottomCells.map(({ raw }) => parseBar(raw))\r\n1012:   const allParsed = [...top, ...bottom].every(\r\n1013:     (entry): entry is ParsedBar => entry !== undefined,\r\n1014:   )\r\n1015:   const complete =\r\n1016:     top.length > 0 &&\r\n1017:     bottom.length > 0 &&\r\n1018:     (expectedCellCount === 0 ||\r\n1019:       (top.length === expectedCellCount && bottom.length === expectedCellCount))\r\n1020:   // 位置는 균일한데 上下 径만 다른(실무에서 흔한) 셀을 「位置相違」로 몰면\r\n1021:   // 사용자가 원인을 오인한다 — 전용 사유 코드로 구분한다\r\n1022:   let sizeMismatch = false\r\n1023:   let positionalIssue: CandidateIssue | undefined\r\n1024:   if (complete && allParsed) {\r\n1025:     const parsedTop = top as ParsedBar[]\r\n1026:     const parsedBottom = bottom as ParsedBar[]\r\n1027:     const firstTop = parsedTop[0]\r\n1028:     const firstBottom = parsedBottom[0]\r\n1029:     const topUniform =\r\n1030:       firstTop !== undefined &&\r\n1031:       parsedTop.every(\r\n1032:         (entry) =>\r\n1033:           entry.count === firstTop.count && entry.size === firstTop.size,\r\n1034:       )\r\n1035:     const bottomUniform =\r\n1036:       firstBottom !== undefined &&\r\n1037:       parsedBottom.every(\r\n1038:         (entry) =>\r\n1039:           entry.count === firstBottom.count && entry.size === firstBottom.size,\r\n1040:       )\r\n1041: \r\n1042:     if (topUniform && bottomUniform && firstTop.size === firstBottom.size) {\r\n1043:       candidate.girderMain = {\r\n1044:         size: firstTop.size,\r\n1045:         topCount: firstTop.count,\r\n1046:         bottomCount: firstBottom.count,\r\n1047:       }\r\n1048:       return\r\n1049:     }\r\n1050:     sizeMismatch =\r\n1051:       topUniform && bottomUniform && firstTop.size !== firstBottom.size\r\n1052: \r\n1053:     // 位置で本数が分かれた表。上下の位置欄が揃っている表だけを対として読む\r\n1054:     const aligned =\r\n1055:       topCells.length === bottomCells.length &&\r\n1056:       topCells.every(\r\n1057:         (cell, index) => cell.position === bottomCells[index].position,\r\n1058:       )\r\n1059:     const positional = aligned\r\n1060:       ? positionalGirderMain(topCells, parsedTop, parsedBottom)\r\n1061:       : undefined\r\n1062:     if (positional && 'girderMain' in positional) {\r\n1063:       candidate.girderMain = positional.girderMain\r\n1064:       return\r\n1065:     }\r\n1066:     if (positional && 'girderMainAsymmetric' in positional) {\r\n1067:       candidate.girderMainAsymmetric = positional.girderMainAsymmetric\r\n1068:       // step 2 전에는 이 후보를 반영하지 않지만, 확정한 위치별 값을 화면에서\r\n1069:       // 원문과 함께 대조할 수 있어야 한다. 값 자체는 별도 필드가 정본이다.\r\n1070:       for (const cell of topCells) {\r\n1071:         candidate.raw[`${topLabel}(${cell.position})`] = cleanedRebarRaw(\r\n1072:           cell.raw,\r\n1073:         )\r\n1074:       }\r\n1075:       for (const cell of bottomCells) {\r\n1076:         candidate.raw[`${bottomLabel}(${cell.position})`] = cleanedRebarRaw(\r\n1077:           cell.raw,\r\n1078:         )\r\n1079:       }\r\n1080:       // 비대칭 값은 새 필드에 보존했지만, 방향을 선택하기 전인 이 단계에서는\r\n1081:       // girder