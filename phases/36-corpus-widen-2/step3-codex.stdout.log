/内端13, G55 R階)은 원문 라벨과 좌우 본수를\r\n778:       // girderMainAsymmetric로 확정한다. 방향 결정은 다음 취입 단계의 책임이다\r\n779:     ).toEqual({ main: 5, stirrup: 5, dimension: 5 })\r\n780:   })\r\n781: \r\n782:   it('ojkk 大梁リスト — 32칸 (断面 라벨 행 없음·2F에만 G1A·G2A)', () => {\r\n783:     expect(\r\n784:       sweepGirders(\r\n785:         'ojkk-p3.json',\r\n786:         'ojkk-akamichi-p3-girders.json',\r\n787:         '大梁リスト',\r\n788:         { top: '上端筋', bottom: '下端筋', stirrup: 'あばら筋' },\r\n789:       ),\r\n790:       // 断面은 라벨 행이 없지만 스케치의 가로(端部 아래)·세로(中央 오른쪽) 치수를\r\n791:       // 짝지어 전 칸 확정 — 정사각형이 아니라 가로→b·세로→depth 대응까지 대조된다.\r\n792:       // 主筋은 端部와 中央이 다른 17칸도 位置別로 확정해 전 칸이 찼다 —\r\n793:       // 표가 端部/中央 두 열만 쓰므로 좌우 방향을 정할 필요가 없다\r\n794:     ).toEqual({ main: 32, stirrup: 32, dimension: 32 })\r\n795:   })\r\n796: \r\n797:   it('kani 地中梁リスト — 전사 1칸 전부 확정', () => {\r\n798:     const doc = readExpected<{ entries: ExpectedKaniEntry[] }>(\r\n799:       'kani-sakuragaoka-p38-foundation-girder.json',\r\n800:     )\r\n801:     const girders = list(\r\n802:       parseSectionLists(readPage('kani-p38.json')),\r\n803:       '地中梁リスト',\r\n804:     )\r\n805: \r\n806:     for (const entry of doc.entries) {\r\n807:       const c = candidate(girders, entry.mark)\r\n808:       expect(c.b, entry.mark).toBe(entry.b)\r\n809:       expect(c.depth, entry.mark).toBe(entry.depth)\r\n810:       expect(\r\n811:         c.girderMain && `${c.girderMain.topCount}-${c.girderMain.size}`,\r\n812:         entry.mark,\r\n813:       ).toBe(entry.上端筋)\r\n814:       expect(\r\n815:         c.girderMain && `${c.girderMain.bottomCount}-${c.girderMain.size}`,\r\n816:         entry.mark,\r\n817:       ).toBe(entry.下端筋)\r\n818:       expect(\r\n819:         c.stirrup && `${c.stirrup.size}@${c.stirrup.pitchMm}`,\r\n820:         entry.mark,\r\n821:       ).toBe(normPitch(entry.STP))\r\n822:     }\r\n823:   })\r\n824: \r\n825:   it('ojkk 壁リスト·スラブリスト — 벽 5칸과 床板 6칸을 전사 대조한다', () => {\r\n826:     const doc = readExpected<ExpectedWallSlabDoc>(\r\n827:       'ojkk-akamichi-p4-walls-slabs.json',\r\n828:     )\r\n829:     const parsed = parseSectionLists(readPage('ojkk-p4.json'))\r\n830:     const walls = list(parsed, '壁リスト')\r\n831:     const slabs = list(parsed, 'スラブリスト')\r\n832:     const expectedListKinds = doc.lists\r\n833:       .filter(({ listKind }) => listKind !== '屋内階段・屋外階段 配筋図')\r\n834:       .map(({ listKind }) => listKind)\r\n835:       .sort()\r\n836:     expect(parsed.map(({ listKind }) => listKind).sort()).toEqual(expectedListKinds)\r\n837:     for (const listSpec of doc.lists.filter(\r\n838:       ({ listKind }) => listKind !== '屋内階段・屋外階段 配筋図',\r\n839:     )) {\r\n840:       const parsedList = list(parsed, listSpec.listKind)\r\n","exit_code":0,"status":"completed"}}
