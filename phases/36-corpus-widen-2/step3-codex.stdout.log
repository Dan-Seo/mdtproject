sInText(value: string): string[] {\r\n981:function parseWallBar(value: string):\r\n997:function parseWallBlock(\r\n1108:function parseSlabBar(value: string): { size: BarSize; pitchMm: number } | undefined {\r\n1138:function parseSlabBlock(\r\n1265:  'ST',\r\n1266:  'STP',\r\n1280: * 조용히 사라진다 — 첫 줄만으로 확정하면 2段筋 거부 방침이 줄바꿈 변형에서 샌다.\r\n1354:function markAnchors(\r\n1547:    if (distance <= span * SLICE_DISTANCE_LIMIT_RATIO) buckets[best].push(run)\r\n1578:function parseColumnBlock(\r\n1586:  const marks = markColumns(header)\r\n1687:          kind: kindFromMark(mark, titleText),\r\n1727:        kind: kindFromMark(mark, titleText),\r\n1859:function parseGirderBlock(\r\n1867:  const marks = markColumns(header)\r\n1905:      exactLabel(row, ['ST', 'STP', 'あばら筋']),\r\n1974:      ? exactLabel(stirrupRow, ['ST', 'STP', 'あばら筋'])?.compact\r\n2003:          kind: kindFromMark(mark, titleText),\r\n2045:        kind: kindFromMark(mark, titleText),\r\n2075:        // 帯筋·ST와 같은 라벨 규약을 써 어느 행이 접혔는지도 남긴다.\r\n2127:function parseTableRegion(\r\n2155:    .map((row, index) => ({ index, marks: markColumns(row) }))\r\n2244:export function parseSectionLists(page: TextPage): ParsedSectionList[] {\r\n2247:  const anchors = titleAnchors(rows)\r\n{\r\n  \"$comment\": \"원문 독립 전사 (ADR-010 준용) — 도면 페이지를 150dpi로 렌더링한 전체와 300dpi 크롭을 눈으로 읽어 적었다. 파서 출력에서 유도하지 않았다(파서를 돌리기 전에 전 셀을 적었다). PyMuPDF 토큰 덤프로 숫자만 교차 대조했다. 전사 범위는 大梁リスト 전체 24칸(R階 12·2階 12 — 부호 15개 중 「—」 칸은 stories에서 뺐다).\",\r\n  \"source\": {\r\n    \"cacheFile\": \"dwg-saiki-fire.pdf\",\r\n    \"sha256\": \"0c74b592bf9c4bf20f196645596dc3c64c24cfa4ccce0e5ec8fe95b96710ce20\",\r\n    \"issuer\": \"大分県佐伯市\",\r\n    \"project\": \"令和2年度 佐伯市消防署東部分署建設(建築主体)工事\",\r\n    \"sheet\": \"S-11 大梁・小梁リスト\",\r\n    \"page\": 1,\r\n    \"transcribedAt\": \"2026-09-03\"\r\n  },\r\n  \"listKind\": \"大梁リスト\",\r\n  \"orientation\": \"horizontal\",\r\n  \"labels\": {\r\n    \"top\": \"上端筋\",\r\n    \"bottom\": \"下端筋\",\r\n    \"stirrup\": \"スターラップ\"\r\n  },\r\n  \"storyLabels\": [\r\n    \"R階\",\r\n    \"2階\"\r\n  ],\r\n  \"positionLabels\": [\r\n    \"両端\",\r\n    \"中央\",\r\n    \"全断面\"\r\n  ],\r\n  \"notes\": [\r\n    \"PDF가 모든 글자를 같은 자리에 최대 7번 겹쳐 그린다(太字 흉내). 페이지당 TextItem 16,289건이고 겹친 글자끼리 좌표 편차는 x·y 최대 0.48pt·w 0.017pt(실측) — 정확히 같은 좌표가 아니다. 파서 입력 전에 같은 문자·0.5pt 이내를 하나로 접어야 한다\",\r\n    \"位置 행은 「全断面」 하나이거나 「両端 | 中央」 둘로 갈린다 — 端部가 아니라 「両端」이다. 두 칸일 때 上端筋·下端筋도 두 값이다\",\r\n    \"主筋 「6/3-D25」는 1段/2段 본수(2段筋)다 — 슬래시 앞이 1段, 뒤가 2段. 제품 GirderMainRow에 2段이 없으므로 본수를 지어내지 말고 raw로 남겨야 한다\",\r\n    \"スターラップ 셀은 「□-D13@200」처럼 □ 기호가 앞에 붙는다. 여기서는 기호를 뺀 「D13@200」으로 적었다\",\r\n    \"頭注: 大梁の定着長は全て35d / 巾止筋 D10@1000\",\r\n    \"「—」 칸(그 階에 그 부호 없음): R階 G2·G6·G13, 2階 G1A·G4·G10A\",\r\n    \"小梁リスト(B1〜B4)는 스코프 밖 부재라 전사 생략. 페이지 /Rotate 90\"\r\n  ],\r\n  \"entries\": [\r\n    {\r\n      \"mark\": \"G1\",\r\n      \"stories\": {\r\n        \"R階\": {\r\n          \"b\": 450,\r\n          \"depth\": 700,\r\n          \"上端筋\": {\r\n            \"全断面\": \"4-D25\"\r\n          },\r\n          \"下端筋\": {\r\n            \"全断面\": \"4-D25\"\r\n          },\r\n          \"スターラップ\": \"D13@200\",\r\n          \"腹筋\": \"2-D10\"\r\n        },\r\n        \"2階\": {\r\n          \"b\": 450,\r\n          \"depth\": 700,\r\n          \"上端筋\": {\r\n            \"全断面\": \"4-D25\"\r\n          },\r\n          \"下端筋\": {\r\n            \"全断面\": \"4-D25\"\r\n          },\r\n          \"スターラップ\": \"D13@200\",\r\n          \"腹筋\": \"2-D10\"\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"mark\": \"G1A\",\r\n      \"stories\": {\r\n        \"R階\": {\r\n          \"b\": 450,\r\n          \"depth\": 800,\r\n          \"上端筋\": {\r\n            \"全断面\": \"4-D25\"\r\n          },\r\n          \"下端筋\": {\r\n            \"全断面\": \"4-D25\"\r\n          },\r\n          \"スターラップ\": \"D13@200\",\r\n          \"腹筋\": \"2-D10\"\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"mark\": \"G2\",\r\n      \"stories\": {\r\n        \"2階\": {\r\n          \"b\": 450,\r\n          \"depth\": 100