ined,\n    raw: { '断面': '(シングル)', '横筋': 'D10@100' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  },\n  {\n    m: 'W14',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: { '断面': '（シングル）（ダブルチドリ）（ダブルチドリ）（ダブル）', '横筋': 'D10@150' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  },\n  {\n    m: 'W15',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: { '断面': '（シングル）（ダブルチドリ）（ダブルチドリ）（ダブル）', '横筋': 'D10@200' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  },\n  {\n    m: 'EW15',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: { '断面': '（シングル）（ダブルチドリ）（ダブルチドリ）（ダブル）', '横筋': 'D10@200' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  },\n  {\n    m: 'W18',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: { '断面': '（シングル）（ダブルチドリ）（ダブルチドリ）（ダブル）', '横筋': 'D10@150' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  },\n  {\n    m: 'EW18',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: { '断面': '(ダブル)', '横筋': 'D10@150' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  },\n  {\n    m: 'W20',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: { '断面': '(ダブル)', '横筋': 'D13@200' },\n    issues: [ '壁厚相違', '壁筋解釈不能' ]\n  }\n]\nスラブリスト [\n  {\n    m: 'S1',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: {},\n    issues: []\n  },\n  {\n    m: 'S2',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: {},\n    issues: []\n  },\n  {\n    m: 'S3',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undefined,\n    d: undefined,\n    raw: {},\n    issues: []\n  },\n  {\n    m: 'S4',\n    s: undefined,\n    main: undefined,\n    hoop: undefined,\n    b: undef