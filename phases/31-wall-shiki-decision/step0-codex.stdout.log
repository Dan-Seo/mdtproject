an\r\n  tableLapRule: RuleHit\r\n  wallLapMinimumRule: RuleHit | undefined\r\n  spliceFactorRule: RuleHit\r\n  pack: RulePack\r\n}\r\n\r\n/**\r\n * 2竊덌폊竊됧즯1)????潁?춮?ⓩØ嶺뗣겎?겹걟?밤걣?녴걢?뚣굥?????씉?뉎겎?귙굥??\r\n * ?뚨를嶺뗣겗泳숁뎸??렅?뉎겏?쀣겍?꾦쉸?ワ폂?뗦??귙굥?귙겗?ⓦ걮?╈╉겲?잆곫Ø嶺뗣겗泳숁뎸???\r\n *  竊묌싧뎴竊뷂펹?ャ굠?뗣띲?\r\n */\r\nfunction resolveWallSplice(input: WallSpliceInput): RebarSplice {\r\n  const {\r\n    role,\r\n    section,\r\n    size,\r\n    measuredLengthMm,\r\n    lapMm,\r\n    deducted,\r\n    heightRestricted,\r\n    tableLapRule,\r\n    wallLapMinimumRule,\r\n    spliceFactorRule,\r\n    pack,\r\n  } = input\r\n\r\n  let countRule: RuleHit\r\n  let countPerBar: number\r\n  let countFormula: string\r\n\r\n  if (role === '潁?춮' && (deducted || heightRestricted)) {\r\n    // ?뗥룭?믤Ø?뉎굥潁?춮??쉸遙섇뀲鵝볝겓?뤵걼?됥걳?곲뼀?ｉ깿?겼즯?삣엩?뚦즯??를嶺뗣겓?ゃ굥??\r\n    // ?뚣걯?끹겗鵝녷쎑?뚣뚪뼀?ｉ깿?겼즯?곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗣띲겏若싥굙?뗣?\r\n    countRule = lookupRule(pack, 'measure.splice.wall.opening', {})\r\n    countPerBar = spliceCount(countRule)\r\n    countFormula = heightRestricted\r\n      ? `${countPerBar}?뗦?竊뉯DR-037??き?????ⓨ늽遙섅걬鶯곥겗潁?춮??쉸?믦껀?싥걮?ゃ걚?잆굙?? +\r\n        `2竊덌폊竊됧즯1)??鵝녷쎑??뼀?ｉ깿?겼즯嶺됥겏?뚣걯?뤹텤?뗣겒?쀯펹`\r\n      : `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)??鵝녷쎑 ??` +\r\n        `?뗥룭?②뀺鶯곥곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗰펹`\r\n  } else if (role === '潁?춮') {\r\n    countRule = lookupRule(pack, 'measure.splice.wall.vertical', {})\r\n    countPerBar = spliceCount(countRule)\r\n    countFormula = `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????潁?춮??텤?뗣겘?꾦쉸???뗦?竊?\r\n  } else {\r\n    countRule = lookupRule(pack, 'measure.splice.interval', { size })\r\n    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\r\n    countFormula =\r\n      `?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏 竊?${countPerBar}?뗦?` +\r\n      `竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????1?싧뎴4) ?ユ댗?숋펹`\r\n  }\r\n\r\n  const lengthMm = spliceLengthMm(countPerBar, lapMm, spliceFactorRule)\r\n  const rules: RuleHit[] = [countRule, spliceFactorRule]\r\n  if (lengthMm > 0) {\r\n    rules.push(tableLapRule)\r\n    if (wallLapMinimumRule) rules.push(wallLapMinimumRule)\r\n  }\r\n\r\n  const lapTerm =\r\n    lengthMm > 0\r\n      ? wallLapMinimumRule\r\n        ? `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 5.3.4(3)(節? ??` +\r\n          `烏?.3.2 ??${tableLapRule.value}d ?②먨뒟鶯곥겗訝뗩솏 ` +\r\n          `${wallLapMinimumRule.value}d ??ㄷ?띲걚?뱄펹竊?${lengthMm}`\r\n        : `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 烏?.3.2 ` +\r\n          `??${tableLapRule.value}d ??겳??.3.4(3)(節? ??먨뒟鶯곲솏若???` +\r\n          `?먨뒟鶯곦빳鸚뽧겘烏?.3.2??겳竊뉯DR-036??き?울펹竊됵폓 ${lengthMm}`\r\n      : `${countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\r\n\r\n  return {\r\n    method: section.spliceMethod,\r\n    countPerBar,\r\n    lengthMm,\r\n    rules,\r\n    formula:\r\n      `泳숁뎸嶸뉑???竊?${countFormula} 竊??밧폀 竊?${section.spliceMethod} 竊?` +\r\n      `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${lapTerm} 竊?` +\r\n      `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\r\n  }\r\n}\r\n/** BAR_SIZES ?ⓨ릪?섅걦?곩츪烏뚧셽?ユ쩂?곥굢?뚣굥?덀걝?띶닓?뗣굢?뗣굮壅룔걪?쇻?*/\r\nexport const MEMBER_KINDS = ['??, '鸚㎪쥈', '?먬쐡鶯?, '佯딀씮'] as const\r\n\r\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\r\n\r\nexport type MemberClass = '翁?퐪'\r\n\r\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\r\nexport const BAR_SIZES = [\r\n  'D10',\r\n  'D13',\r\n  'D16',\r\n  'D19',\r\n  'D22',\r\n  'D25',\r\n  'D29',\r\n  'D32',\r\n] as const\r\n\r\nexport type BarSize = (typeof BAR_SIZES)[number]\r\n\r\n/**\r\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\r\n *\r\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\r\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\r\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\r\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\r\n *\r\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\r\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\r\n *\r\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\r\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\r\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\r\n */\r\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\r\n\r\nexport type HighStrengthShearBarSize =\r\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\r\n\r\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\r\nexport const SHEAR_BAR_SIZES = [\r\n  ...BAR_SIZES,\r\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\r\n] as const\r\n\r\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\r\n\r\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\r\n\r\n/**\r\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯겗?ε뒟?㎯걗?ｃ겍獒썲뱚?뚧군?곥겒??(ADR-012)??\r\n *\r\n * ?곈뇧令띸츞?뷸틬 1?싧뎴4)??) ?뚦릫?뉎걲??겘?띲겖泳숁뎸?ⓦ궗?밧쑇?η텤?뗣걽?묆겒??겎??\r\n * 艅잍ː凉뤵꺕繹뜻렏??돮?꾠겘?ャ꺖?ャ깙?껁궚?담겎 `inferred` ??죱?ャ겒?????멥겧?뗣걣\r\n * ?ょ▶沃띲겏?쀣겍鈺?몜?뚥퍡??(ADR-015)??\r\n */\r\nexport const SPLICE_METHODS = [\r\n  '?띲겖泳숁뎸',\r\n  '?с궧?㎪렏',\r\n  '艅잍ː凉?,\r\n  '繹뜻렏',\r\n] as const\r\n\r\nexport type SpliceMethod = (typeof SPLICE_METHODS)[number]\r\n\r\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\r\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\r\n\r\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\r\n\r\n/**\r\n * ?긱겗??씊壤®듁??\r\n *\r\n * ?녶숱?긱겘 b?팪 ?믡겏?귙겓?닷푶?ャ걲?뗣귛ㄷ歟곥겗?끾퀡?룔걬??3D ??윶?㏂굚 b?팪 ?뗣굢\r\n * 黎뷩겲?뗣겗?㎯곩쨼?ε?力뺛겏?쀣겍?뚣걯?ㅳ굮營?걨?겼숱?뜰겗瓦썲뒥?뚩쮫歷ц쫸?뉎굮?뷩굢?뺛겒?꾠?\r\n * ?곈뇧?㎩숱?뜰굮誤뗣굥??겘 1?싧뎴2)?뚧뼪?㏂겗鼇?쮫野멩퀡?ャ굠?뗥뫅?룔띲걼?졽?嶸뉑??㎯?\r\n * ?녶숱??씊?㎯겘?앫겗?③빓?뚦냶?ⓦ겓?ゃ굥 ??獒썲뱚?뚧뼭?쀣걚?ㅳ굮鵝쒌굥?뤵걨?㎯겘?ゃ걚 (ADR-027)??\r\n *\r\n * ?밤깙?ㅳ꺀?ョ춮??돮?뤵겒?꾠귝쮽繹뽨퍞礪섉쎑 5.3.4(6)(節? ?뚣뚣궧?묆궎?⒲꺂嶺뗣겗泳숁뎸?듽겞若싩???\r\n * ??.3.5 ?ャ굠?뗣띲겏?녈겓冶붵겖?╉걡?듽곥걹??쎋??렅?뉎겎?삣깗??(烏?.3.3 ?ⓨ릪????\r\n * ??씊?ゃ궧?덀걣?똇OOP D13@100?띲겏?멥걚?╉걚?뚣겙?앫굦??깢?쇈깤?㎯걗?ｃ겍?곮＝?곥걣\r\n * ?밤깙?ㅳ꺀?ャ겏沃?겳?욍걟?뗣걪?ⓦ겘?쀣겒??(ADR-012)??\r\n */\r\nexport type ColumnShape = '?⒴숱' | '?녶숱'\r\n\r\nexport interface ColumnSection {\r\n  id: string\r\n  kind: '??\r\n  mark: string\r\n  /**\r\n   * ??씊?ゃ궧?덉뿉??痍⑥엯?????대뒓 ???됱뿉???붾뒗吏. 寧?뤇(mark)??遺숈씠硫??꾨㈃???녿뒗\r\n   * 寧?뤇???낁㉢?몄뿉 洹몃?濡??섍?怨??낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n   * ?쒗뭹??Story???鴉뤷쎋 痍⑥엯 ?붾㈃?먯꽌 ?뺥솗 ?쇱튂 ?먮룞 ?좏깮?쇰줈 ?뉖뒗??(ADR-035).\r\n   */\r\n  storyLabel?: string\r\n  /** ??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗?뗣?*/\r\n  shape: ColumnShape\r\n  b: number\r\n  d: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉???泳숁뎸嶸뉑??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 (令띸츞?뷸틬 1?싧뎴4)??)) */\r\n  spliceMethod: SpliceMethod\r\n  main: {\r\n    size: BarSize\r\n    count: number\r\n  }\r\n  hoop: {\r\n    size: ShearBarSize\r\n    pitch: number\r\n    /**\r\n     * ?띸쉰?븅뼋?????앸㈃?먯꽌 寧?쨌?永귛릭嶺뗭쓣 ?쇰쭏???꾩슦?붿?. 誤뤸틬??媛믪씠 ?녾퀬\r\n     * ?ф빊瑜?醫뚯슦?섎?濡??쒗뭹???뺥븯吏 ?딅뒗??????씊訝誤㏃쓽 ?낅젰?대떎 (ADR-012).\r\n     */\r\n    startOffsetMm: number\r\n  }\r\n}\r\n\r\n/** 鸚㎪쥈 訝사춮 1餘듸펷訝딁ク?얇걼??툔塋?펹??퐤營?닪?ф빊?귝뼪?㏂꺁?밤깉??ク?ⓦ꺕訝?ㄾ烏뚣겓野얍퓶?쇻굥??*/\r\nexport interface GirderMainRow {\r\n  /** 塋?깿竊덃뵱?밧겢竊됥겗?ф빊 */\r\n  endCount: number\r\n  /** 訝?ㄾ??쑍??*/\r\n  centerCount: number\r\n  /**\r\n   * 冶뗧ク?담겗?ф빊 ??藥?뤂?㏝걬?녴겏?띲걽?묉똻?ㅳ귞꽒?묆굦??endCount ?ⓨ릪?섓펷野양㎞竊됥?\r\n   * 冶뗧ク??꺀?녈꺆?쇈궖?ワ펷GirderRun.memberOffsetsMm ??0 ?댐펹??\r\n   */\r\n  startCount?: number\r\n}\r\n\r\n/**\r\n * 鸚㎪쥈訝사춮??퐤營?닪?ф빊?믡곲뇥?ゃ굤?믢퓷?ㅳ궛?ャ꺖?쀣겦?녻㎗?쇻굥??\r\n\r\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\r\n  storyLabel?: string\r\n  /** ?욕럻 (mm) */\r\n  thickness: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉뤵귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\r\n  spliceMethod: SpliceMethod\r\n  /** X?싥굤?밧릲竊늌邕멥겓亦욍겂?╊섯?녈굥竊됥겗訝사춮 */\r\n  x: { top: SlabBarRow; bottom: SlabBarRow }\r\n  /** Y?싥굤?밧릲??말嶺?*/\r\n  y: { top: SlabBarRow; bottom: SlabBarRow }\r\n}\r\n\r\nexport type Section =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\n/**\r\n * ?붾㈃ ?쒖떆쨌aria-label???대쫫. 媛숈? 寧?뤇???롫퀎濡??щ윭 ??씊???????덉쑝誘濡?\r\n * ?롫? ?ш린??遺숈씤??????λ릺??`mark`???꾨㈃??寧?뤇 洹몃?濡??붾떎.\r\n */\r\nexport function sectionMarkLabel(section: Section): string {\r\n  return section.storyLabel\r\n    ? `${section.mark}(${section.storyLabel})`\r\n    : section.mark\r\n}\r\n\r\nexport interface ColumnPosition {\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\nexport interface GirderPosition {\r\n  axis: 'X' | 'Y'\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗鵝띸쉰?귛ㄷ歟곥겏?뚣걯?뤻싥굤??겗1?밤깙?녑늽??씌?믣뜝?곥굥??겎壤㏂굚?뚣걯?㎯걗?뗣?\r\n *\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?곩닪?띲굮鵝쒌겂?╉굚?뗣겏?쀣겍??GirderPosition ??\r\n * ?뷴닪?뺛굦?ゃ걚 ???⒲걾?됥겎?귙굥?뗣굮黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼귚퐤營?걽?묆굮\r\n * 誤뗣겍?ⓩ쓲葉?닪?믣닩若싥걲?뗣궠?쇈깋?믤쎑?뗣겒?꾠걪?ⓦ?\r\n */\r\nexport type WallPosition = GirderPosition\r\n\r\n/**\r\n * 佯딀씮??퐤營????싥굤??겎?꿔겲?뚣걼1?쇻궎?믣뜝?곥굥??ix, iy) ??걹??깧?ㅳ겗?잏궧??\r\n * 竊늌?팢 ?ⓦ굚弱뤵걬?꾢겢竊됥겗?쇔춴?밤겎?곥깧?ㅳ겘 (ix, iy)??ix+1, iy+1) ?㎯걗?뗣?\r\n *\r\n * ?긱겗 ColumnPosition ?ⓨ숱??릪?섅걽?뚧뙁?쇻굚??걣?뺛걝竊덃졏耶먪궧?뗣깧?ㅳ걢竊됥?\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?뗣겎??뙷?γ걬?뚣겒?????⒲걾?됥겎?귙굥?뗣굮\r\n * 黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼?\r\n */\r\nexport type SlabPosition = ColumnPosition\r\n\r\n/** ??똻渦뷩걣1渦뷩걽?묆겗?뉑똻佯딀씮?굋rojection ??뵱?곮씌?뗣굢?ょ뵳塋?겲?㎯겗?끾퀡?룔걬??*/\r\nexport interface CantileverSlab {\r\n  /** ??똻渦뷩겓?답벡?쇻굥?싥굤??index ?뚦쥥?덀굥?묆걤?뚣뚧??띲?*/\r\n  side: '閭? | '縕?\r\n  projectionMm: number\r\n}\r\n\r\n/**\r\n * ?묈즯竊덅뀺鶯곥꺕訝뗣굤鶯곥꺕熬뽩즯竊됥겗?끾퀡影꾢쎊?귟Þ鼇덂쎋?멥걢?됥겗?ⓩ쓲?섆퐤??빪鼇섅겎?귙굤??\r\n * ?곭븼?쀣걼邕멥겘?ⓨ냵力뺛굮?뤷뫑?쇻굥?귞칱?꿔굮??씊?ョ쉰?뗣겒?꾠겗??곩릪?섊Е?룔겎?귡깿?먦걫??\r\n * ?ラ쳵?뺛꺕?룔걬?뚪걬?꾢풓?뗣걼?곥겎?귙굥 (ADR-037)??\r\n */\r\nexport interface WallExtent {\r\n  vertical?: {\r\n    anchor: '訝뗧ク' | '訝딁ク'\r\n    heightMm: number\r\n  }\r\n  horizontal?: {\r\n    anchor: '冶뗧ク' | '永귞ク'\r\n    lengthMm: number\r\n  }\r\n}\r\n\r\n/**\r\n * ?뗥룭??1?뗦? (?곈뇧令띸츞?뷸틬 1?싧뎴8))??\r\n *\r\n * ??씊?㎯겘?ゃ걦 **?ⓩ쓲** ?ヤ퍡?뤵귛릪?섊Е?룔겗鶯곥걣鵝뺞옔?귛뻠?ㅳ겗?ャ곭첆??걹???싥겓\r\n * ?뗣걚?╉걚?뗣걢?됥걽 ????씊?ユ똻?잆걵?뗣겏?녜씊?ャ겒?꾦뼀?ｃ굮獒썲뱚?뚥퍟??즯?ャ굚鵝쒌굥\r\n * ?볝겏?ャ겒??(ADR-004)??\r\n *\r\n * 佯㎪쮽??깿?먦겗掠?楹삠겎?곩렅?밤겘**?끾퀡?잆겗?잏궧**?㎯걗?뗣귟먬쐡鶯곥겒?됧쭓塋?겗?긱겗\r\n * ?끻겢?㏂꺕訝딃깿鸚㎪쥈??툔?㏂걢?됪릍?ｃ걼訝뗧ク?곩틞?욍겒?됥꺀?녈겗冶뗧ク??ㄷ歟곩냵?닻씊??\r\n * 掠? x?퍈 ??릲?띲겘?띸춮竊?Rebar.points`竊됥겏?뚣걯?ゃ겗?㎯곩즯?㎯겘 x ?뚦즯??빓?뺛?\r\n * y ?뚦즯??쳵?뺛곩틞?욍겎??x?퍈 ?뚣걹?뚣걻??X?싥굤?팢?싥굤?밧릲?ャ겒?뗣?\r\n *\r\n * 野멩퀡??뚦뻠?룬줊嶺됮뼀?ｉ깿??*?끾퀡野멩퀡**?띯??뚪쟿?뚣걹?녶츣?곥굥??\r\n */\r\nexport interface OpeningReinforcement {\r\n  size: BarSize\r\n  count: number\r\n  lengthMm: number\r\n}\r\n\r\nexport interface Opening {\r\n  id: string\r\n  /** ?끾퀡?잆겗?잏궧?뗣굢?뗥룭?얇겎???? x (mm) */\r\n  xMm: number\r\n  /** ?뚣걯?뤷?? y (mm) */\r\n  yMm: number\r\n  /** 掠? x ?밧릲??냵力뺝?力?(mm) */\r\n  widthMm: number\r\n  /** 掠? y ?밧릲??냵力뺝?力?(mm) */\r\n  heightMm: number\r\n  /** 1?싧뎴8) ?ゃ걡?멥걤?ュ읃?γ걦鼇?쮫?녔쎑邕?쮼??뼀?ｈ짒凉루춮 */\r\n  reinforcements?: OpeningReinforcement[]\r\n}\r\n\r\nexport interface Member {\r\n  id: string\r\n  kind: MemberKind\r\n  memberClass: MemberClass\r\n  sectionId: string\r\n  storyId: string\r\n  position: ColumnPosition | GirderPosition | WallPosition | SlabPosition\r\n  /** 佯딀씮??position ??GirderPosition ??겏?띲걽?묋㉠?뺛굦?뗧뎴?곫씉餓뜰?*/\r\n  cantilever?: CantileverSlab\r\n  /**\r\n   * ?볝겗?ⓩ쓲?ラ뼀?꾠겍?꾠굥?뗥룭??(1?싧뎴8))?귝쑋?뉐츣??뚪뼀?ｃ겒?쀣띲겎?귙겂??\r\n   * ?뚧쑋?ε뒟?띲겎??겒????獒썲뱚??뼀?ｃ겗?됬꽒?믤렓若싥걮?ゃ걚??겎?곩냵鼇녔쎑??뼀?ｈ짒凉루춮??\r\n   * 鼇덁툓?쀣겍?꾠겒?꾠걪?ⓦ굮躍멩셽?딁윥?쇻굥 (R14)?귝윶?삣ㄷ歟곥겘?쀣걨?뽧굢?ゃ걚竊싧릪?끹걣\r\n   * ?쇻걩?뗣겗??첆?삣눣?ε룭嶺됥겎?곥걹?뚣걣?뗣걦??겘鶯곥겏佯딀씮?졼걢?됥겎?귙굥??\r\n  */\r\n  openings?: Opening[]\r\n  /** 鼇?쮫?녔쎑?뗣굢邕?쮼?쀣걼鶯곥겗?끾퀡影꾢쎊?귝쑋?뉐츣??뻗??뀲?끾퀡 (ADR-037)??*/\r\n  wallExtent?: WallExtent\r\n}\r\nimport type { ShearBarSize, SpliceMethod } from './member'\r\nimport type { RuleHit } from '../rules/types'\r\n\r\nexport type RebarRole =\r\n  | '訝사춮'\r\n  | '躍?춮'\r\n  | '訝딁ク嶺?\r\n  | '訝뗧ク嶺?\r\n  /** 歟곥겗?③빓?ャ굩?잆굢?ゃ걚訝사춮?귚퐤營?닪?ф빊??량?뚣걪?뚣겓?ゃ굥 (令띸츞?뷸틬 2竊덌폆竊됪쥈1)) */\r\n  | '訝딁ク?ャ긿?덀궕?뺟춮'\r\n  | '訝뗧ク?ャ긿?덀궕?뺟춮'\r\n  | '?귙겙?됬춮'\r\n  | '亮끾??곭춮'\r\n  | '?밭춮'\r\n  /** ?먬쐡鶯곥겗潁?춮 ??訝듾툔??쥈?삣틞?욍겦若싩??쇻굥 (令띸츞?뷸틬 2竊덌폊竊됧즯1)?? */\r\n  | '潁?춮'\r\n  /** ?먬쐡鶯곥겗與ょ춮 ??訝▼겢??윶?멨츣??쇻굥 (?뚥툓) */\r\n  | '與ょ춮'\r\n  /**\r\n   * 佯딀씮??말嶺?(令띸츞?뷸틬 2竊덌폇竊됧틞??))?귝뼶?묆굮壤밧돯?ユ똻?잆걵?뗣겗??곩냵鼇녔쎑??\r\n   * X ??Y ??죱?뚩쫳?녴걨?됥굦?ゃ걦?ゃ굥?뗣굢????閭ｆ뼶壤㏂겗?쇻궎?㎯겘鼇?쮫?룔걬?귝쑍?겹굚\r\n   * 訝?담걲?뗣겗?㎯곩슝?꿔걣?뚣걯?졼겏雅뚪뇥?ョ쳦?ｃ걼烏뚣겗?덀걝?ヨ쫳?덀굥??\r\n   *\r\n   * ?잍뻼竊?竊덌폇竊됧틞?울펹??뼶?묆굮?뷴닪?쎼걳?뚥말嶺뗣띲겏?쇈겞?곫쮽繹뽨퍞礪섉쎑5塋졼겘\r\n   * ?뚥툓塋?춮?띲뚥툔塋?춮?띲겏?쇈겤?귝뼶?묆겗 X?팢 ??＝?곥겗?싥굤??겗?띲겎?귙겂?╉?\r\n   * 誤뤸틬??뵪沃욁겎??겒??(ADR-028)??