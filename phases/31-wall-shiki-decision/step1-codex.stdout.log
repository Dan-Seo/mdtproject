ndefined\n1878 undefined\n1879 undefined\n1880 undefined\n1881 undefined\n1882 undefined\n1883 undefined\n1884 undefined\n1885 undefined\n1886 undefined\n1887 undefined\n1888 undefined\n1889 undefined\n1890 undefined\n1891 undefined\n1892 undefined\n1893 undefined\n1894 undefined\n1895 undefined\n1896 undefined\n1897 undefined\n1898 undefined\n1899 undefined\n1900 undefined\n1901 undefined\n1902 undefined\n1903 undefined\n1904 undefined\n1905 undefined\n1906 undefined\n1907 undefined\n1908 undefined\n1909 undefined\n1910 undefined\n1911 undefined\n1912 undefined\n1913 undefined\n1914 undefined\n1915 undefined\n1916 undefined\n1917 undefined\n1918 undefined\n1919 undefined\n1920 undefined\n1921 undefined\n1922 undefined\n1923 undefined\n1924 undefined\n1925 undefined\n1926 undefined\n1927 undefined\n1928 undefined\n1929 undefined\n1930 undefined\n1931 undefined\n1932 undefined\n1933 undefined\n1934 undefined\n1935 undefined\n1936 undefined\n1937 undefined\n1938 undefined\n1939 undefined\n1940 undefined\n1941 undefined\n1942 undefined\n1943 undefined\n1944 undefined\n1945 undefined\n1946 undefined\n1947 undefined\n1948 undefined\n1949 undefined\n1950 undefined\n1951 undefined\n1952 undefined\n1953 undefined\n1954 undefined\n1955 undefined\n1956 undefined\n1957 undefined\n1958 undefined\n1959 undefined\n1960 undefined\n1961 undefined\n1962 undefined\n1963 undefined\n1964 undefined\n1965 undefined\n1966 undefined\n1967 undefined\n1968 undefined\n1969 undefined\n1970 undefined\n1971 undefined\n1972 undefined\n1973 undefined\n1974 undefined\n1975 undefined\n1976 undefined\n1977 undefined\n1978 undefined\n1979 undefined\n1980 undefined\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'\nnode -e \\\"const fs=require('fs'); for(const p of ['tests/golden/fixtures/quantity-r5-ch3.json','tests/golden/quantity-measurement.test.ts']){const lines=fs.readFileSync(p,'utf8').split(/\\\\\\\\r?\\\\\\\\n/); console.log(p,lines.length); console.log(lines.slice(-30).map((x,i)=>String(lines.length-29+i).padStart(4)+' '+x).join('\\\\\\\\n'));}\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'\nnode -e \\\"const fs=require('fs'); for(const p of ['tests/golden/fixtures/quantity-r5-ch3.json','tests/golden/quantity-measurement.test.ts']){const lines=fs.readFileSync(p,'utf8').split(/\\\\\\\\r?\\\\\\\\n/); console.log(p,lines.length); console.log(lines.slice(-30).map((x,i)=>String(lines.length-29+i).padStart(4)+' '+x).join('\\\\\\\\n'));}\\\"\"","aggregated_output":"tests/golden/fixtures/quantity-r5-ch3.json 1\n -28 {\r\n  \"source\": {\r\n    \"doc\": \"公共建築数量積算基準\",\r\n    \"edition\": \"令和5年3月29日改定（国営積第8号）\",\r\n    \"publisher\": \"国土交通省 大臣官房官庁営繕部\",\r\n    \"url\": \"https://www.mlit.go.jp/common/001178206.pdf\",\r\n    \"sha256\": \"801d7917e81369dd4eac551af76f00aba6fa7d7e8224703f162a0435b46d9a30\",\r\n    \"chapter\": \"第4編 躯体 第3章 鉄筋 第2節 鉄筋の計測・計算\",\r\n    \"chapterShort\": \"第4編第3章第2節\",\r\n    \"pageNote\": \"printedPage は紙面に印刷された頁番号、pdfPage は PDF の通し頁。この文書では pdfPage = printedPage + 5。ルールパックの source.page は printedPage で統一する。\"\r\n  },\r\n\r\n  \"definitions\": [\r\n    {\r\n      \"id\": \"第4編第1章第2節（２）柱\",\r\n      \"printedPage\": 10,\r\n      \"pdfPage\": 15,\r\n      \"quote\": \"基礎上面から屋上階床板上面までの部分を、下部から基礎柱、各階柱及び最上階柱に区分する。基礎柱は、独立基礎上面から基礎梁上面までとし、各階柱は各階床板上面間の柱とする。\",\r\n      \"usedFor\": \"1通則7) の「その部分の長さ」— 各階柱は階高（床板上面間）であって内法高さではない\"\r\n    },\r\n    {\r\n      \"id\": \"第4編第1章第2節（３）梁１）大梁\",\r\n      \"printedPage\": 10,\r\n      \"pdfPage\": 15,\r\n      \"quote\": \"大梁とは、柱に接する横架材の内法部分をいう。片持梁等もこれに準ずる。\",\r\n      \"usedFor\": \"1通則7) の「その部分の長さ」— 大梁は内法長さ\"\r\n    },\r\n    {\r\n      \"id\": \"第4編第1章第2節（４）床板（スラブ）\",\r\n      \"printedPage\": 11,\r\n      \"pdfPage\": 16,\r\n      \"quote\": \"床板とは、柱、梁等に接する水平材の内法部分をいう。ただし、壁式構造については、壁、壁梁等に接する水平材の内法部分をいう。片持床板等もこれらに準ずる。\",\r\n      \"usedFor\": \"2（４）床板1) の「床板の長さ」と 1通則7) の「その部分の長さ」— 床板は柱・梁に接する内法部分なので、長さは通り芯間ではなく両側の大梁の内側面の間である。大梁・柱と二重計上しないのはこの定義による（大梁が内法長さ、壁が内法部分なのと同じ形）。ただし書きの壁式構造は扱わない (ADR-025)\"\r\n    },\r\n    {\r\n      \"id\": \"第4編第1章第2節（５）壁\",\r\n      \"printedPage\": 11,\r\n      \"pdfPage\": 16,\r\n      \"quote\": \"壁とは、柱、梁、床板等に接する垂直材の内法部分をいい、開口部を除く。ただし、壁式構造については、基礎上面から屋上床板上面までの垂直材をいい、開口部を除く。袖壁、下り壁、腰壁等もこれらに準ずる。\",\r\n      \"usedFor\": \"2（５）壁1)① の「壁の高さ又は長さ」と 1通則7) の「その部分の長さ」— 壁式構造以外の壁は内法部分なので、高さは階高から上部大梁せいを引いた内法高さ、長さは両側の柱面間の内法長さである。柱・大梁と二重計上しないのはこの定義による（大梁が内法長さなのと同じ形）。「開口部を除く」は 1通則8) の欠除規定に対応する\"\r\n    }\r\n  ],\r\n\r\n  \"clauses\": [\r\n    {\r\n      \"id\": \"1通則 前文\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"鉄筋の数量は、各部分について規格、形状、寸法等ごとに、原則としてコンクリートの設計寸法に基づき、次の各項に定めるところに従い計測・計算した長さを設計長さとし、その設計長さに日本工業規格（以下「ＪＩＳ」という。）に定める単位質量を乗じた質量とする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"単位質量は JIS G 3112 に委任される — 規準自身は値を持たない。その JIS は有償規格で未確保のため、製品もルールパックに値を置かず Project.unitMass（利用者入力）として受け取り、未入力の径は kg を算出しない\"\r\n    },\r\n    {\r\n      \"id\": \"1通則1)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"基礎、柱、梁、床板、壁等の先端で止まる鉄筋は、コンクリートの設計寸法をその部分の鉄筋の長さとし、これに設計図書等で指定された場合はフックの長さを加える。斜筋もこれに準ずる。ただし、径１３㎜以下の鉄筋についてのフックはないものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"最上階柱主筋がこれに該当する（（２）柱1) が明示）。columnEnds はスタック上端（上に柱がない層）を ColumnEnds.top ＝ '先端' として返し、generateColumnRebar はその端に定着長さを加えない — ルールパック measure.tip.length.addition（value: 0）が出典を持つ（R9①解消）\"\r\n    },\r\n    {\r\n      \"id\": \"1通則2)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"フープ、スタラップの長さは、それぞれ柱、基礎梁、梁及び壁梁のコンクリートの断面の設計寸法による周長を鉄筋の長さとし、フックはないものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.hoop.length.addition ＋ hoopDesignLengthMm\"\r\n    },\r\n    {\r\n      \"id\": \"1通則3)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"幅止筋の長さは、基礎梁、梁、壁梁、壁のコンクリートの設計幅又は厚さとし、フックはないものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.width-tie.length.addition ＋ widthTieDesignLengthMm。設計長さは大梁のコンクリートの設計幅 b そのもので、フック余長を加えない。条文が挙げる部材は基礎梁・梁・壁梁・壁で柱を含まないので、幅止筋は大梁だけに生成する\"\r\n    },\r\n    {\r\n      \"id\": \"1通則4)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"重ね継手又はガス圧接継手について、この基準で別に定める場合を除き、計測・計算した鉄筋の長さについて、径１３㎜以下の鉄筋は６．０ｍごとに、径１６㎜以上の鉄筋は７．０ｍごとに継手があるものとして継手箇所数を求める。径の異なる鉄筋の重ね継手は小径による継手とする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.splice.interval（径ごと）＋ intervalSpliceCount。単独梁の通し筋がこれによる（連続梁は （３）梁2) が「かかわらず」で上書きする）。適用は主筋に限る — フープ・スタラップは冒頭の「この基準で別に定める場合」に当たり、（２）柱3) が「１通則２）及び７）による」、（３）梁3) が「１通則２）、３）及び７）による」と適用条項を数え上げていて４）を含めない。継手を持つ主筋は （２）柱2) が「主筋の継手は、１通則４）の規定による」と明示する\"\r\n    },\r\n    {\r\n      \"id\": \"1通則5)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"ガス圧接継手の加工のための鉄筋の長さの変化はないものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.splice.length.factor の { method: ガス圧接 } ＝ 0。重ね継手の算入倍率 1 はこの条文の反対解釈であって明文ではない — 同行は inferred\"\r\n    },\r\n    {\r\n      \"id\": \"1通則6)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"フック、定着、余長及び重ね継手の長さについて設計図書に記載のない場合は、日本建築学会、建築工事標準仕様書ＪＡＳＳ５鉄筋コンクリート工事の規定を準用し、小数点以下第３位を四捨五入し、小数点以下第２位とする。なお、径の異なる鉄筋の継手は小径による継手とする。\",\r\n      \"status\": \"deferred\",\r\n      \"reason\": \"JASS 5 は有料規格で未確保。本製品は定着・重ね継手長さを標準仕様書5章から取る（公共建築工事では標準仕様書が設計図書の一部なので「記載のない場合」に当たらないと解する）。この解釈自体が未検証 — R2。腹筋の余長はこの条項が唯一の根拠で、標準仕様書5章に腹筋の記述が一切ない（R7 全330頁で「腹筋」0件）ため値を取れない — ルールパックに載せず断面一覧の入力とする (ADR-012)\"\r\n    },\r\n    {\r\n      \"id\": \"1通則7)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"鉄筋の割付本数が設計図書に記載されていない場合は、その部分の長さを鉄筋の間隔で除し、小数点以下第１位を切り上げた整数（同一の部分で間隔の異なる場合はその整数の和）に１を加える。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.distribution.addition ＋ distributionCount\"\r\n    },\r\n    {\r\n      \"id\": \"1通則8)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"窓、出入口等の開口部による鉄筋の欠除は、原則として建具類等開口部の内法寸法による。ただし、１か所当たり内法面積０．５㎡以下の開口部による鉄筋の欠除は原則としてないものとする。なお、開口補強筋は設計図書により計測・計算する。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"欠除は開口部の内法寸法で計上する — 部材ごとに受け取った開口の内法寸法から、1通則7) の割付が置く鉄筋のうち開口を横切る本だけを、その開口の内法寸法だけ短くする（src/domain/rebar/opening.ts）。「1か所当たり内法面積0.5㎡以下」の境目はルールパック measure.opening.deduction.minimum.area が持つ。開口補強筋は「設計図書により計測・計算する」ので、径・本数・設計長さを設計図書から転記した入力として計上する — 2（３）梁1)・2（４）床板1) の「補強筋等は設計図書による」と同じ扱いで、値を製品が作らない (ADR-034)\"\r\n    },\r\n    {\r\n      \"id\": \"1通則9)\",\r\n      \"printedPage\": 15,\r\n      \"pdfPage\": 20,\r\n      \"quote\": \"鉄筋について、その所要数量を求めるときは、その設計数量の４％の割増を標準とする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック markup.rate（既存 quantity.json ゴールデン）\"\r\n    },\r\n    {\r\n      \"id\": \"2（２）柱1)\",\r\n      \"printedPage\": 16,\r\n      \"pdfPage\": 21,\r\n      \"quote\": \"主筋の長さは、柱の長さに定着長さ及び余長を加えたものとする。階の途中で終わり又は始まる主筋の長さは、設計図書により柱断面図に示された階に属するものとする。最上階柱の主筋については、１通則１）による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"柱主筋の柱長さ項が階高であること（最上階の扱いは 1通則1) 側で deferred）\"\r\n    },\r\n    {\r\n      \"id\": \"2（２）柱2)\",\r\n      \"printedPage\": 16,\r\n      \"pdfPage\": 21,\r\n      \"quote\": \"主筋の継手は、１通則４）の規定による。ただし、基礎柱については基礎柱部分の主筋の長さが３．０ｍ以上の場合は１か所、その他の階の各階柱の全長にわたる主筋については各階ごとに１か所の継手があるものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.splice.column ＝ 各階ごとに1か所。基礎柱の但書は対象外（ADR-005 — 基礎は扱わない）\"\r\n    },\r\n    {\r\n      \"id\": \"2（２）柱3)\",\r\n      \"printedPage\": 16,\r\n      \"pdfPage\": 21,\r\n      \"quote\": \"フープは各階ごとに１通則２）及び７）による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"帯筋の設計長さ・設計本数（各階ごと＝階高で割り付ける根拠）\"\r\n    },\r\n    {\r\n      \"id\": \"2（２）柱4)\",\r\n      \"printedPage\": 16,\r\n      \"pdfPage\": 21,\r\n      \"quote\": \"柱頭、柱脚等の補強筋は設計図書による。\",\r\n      \"status\": \"deferred\",\r\n      \"reason\": \"補強筋は設計図書由来で規準側に値がない — 対象外\"\r\n    },\r\n    {\r\n      \"id\": \"2（３）梁1)\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"梁の全長にわたる主筋の長さは、梁の長さにその定着長さを加えたものとする。トップ筋、ハンチ部分の主筋、補強筋等は設計図書による。ただし、同一の径の主筋が柱又は梁を通して連続する場合は、定着長さにかえて柱又は梁の幅の１／２を加えるものとし、異なる径の主筋が連続する場合はそれぞれ定着するものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"通し筋のラン芯長（中間柱を挟む2スパンで柱せい相当＝両側の柱幅1/2の和）\"\r\n    },\r\n    {\r\n      \"id\": \"2（３）梁2)\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"連続する梁の全長にわたる主筋の継手については、１通則４）の規定にかかわらず、梁の長さが、５．０ｍ未満は０．５か所、５．０ｍ以上１０．０ｍ未満は１か所、１０．０ｍ以上は２か所あるものとする。ただし、単独梁及び片持梁の主筋の継手は、１通則４）によるものとし、梁の全長にわたる主筋の径が異なる場合の継手の位置は設計図書による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.splice.girder.continuous（区分ごとの箇所数）＋ 同 .band.upper（区分の上限）。ランが2スパン以上なら連続梁、1スパンなら単独梁として 1通則4) に戻す\"\r\n    },\r\n    {\r\n      \"id\": \"2（３）梁3)\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"スタラップ及び幅止筋の長さ、本数は各梁ごとに１通則２）、３）及び７）による。また、腹筋の余長は、１通則６）による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"あばら筋・幅止筋の設計長さ・設計本数（各梁ごと＝内法長さで割り付ける根拠）。腹筋の余長は 1通則6) 側で deferred — JASS 5 未確保のため断面一覧の入力として受け取る\"\r\n    },\r\n    {\r\n      \"id\": \"2（４）床板1)\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"床板の全長にわたる主筋の長さは、床板の長さにその定着長さを加えたものとする。トップ筋、ハンチ部分の主筋、補強筋等は設計図書による。ただし、同一の径の主筋が梁、壁等を通して連続する場合は、定着長さにかえて接続する梁、壁等の幅の１／２を加えるものとし、異なる径の主筋が連続する場合はそれぞれ定着するものとする。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"床板主筋の設計長さ。連続する床板を1本のランとして測るので、ラン芯長 ＝ Σ内法長さ ＋ Σ中間大梁の幅（幅の1/2 が両側から来て1本分になる）で、定着はランの両端だけに付く — 2（３）梁1) と同じ形であり、中間支点で定着を二重に数えない根拠でもある。「トップ筋、ハンチ部分の主筋、補強筋等は設計図書による」ので、上端筋の本数・ピッチは断面一覧の入力であって規準側に値はない (ADR-012)\"\r\n    },\r\n    {\r\n      \"id\": \"2（４）床板2)\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"連続する床板の全長にわたる主筋の継手については、１通則４）の規定にかかわらず、床板の長さ４．５ｍ未満は０．５か所、４．５ｍ以上９．０ｍ未満は１か所、９．０ｍ以上１３．５ｍ未満は１．５か所あるものとする。ただし、単独床板及び片持床板の主筋の継手は、１通則４）による。重ね継手の長さは、１通則６）による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.splice.slab.continuous（区分ごとの箇所数）＋ 同 .band.upper（区分の上限）。ランが2ベイ以上なら連続床板、1ベイなら単独床板として 1通則4) に戻す — 2（３）梁2) と同じ形である。梁と違い**上限のない区分がない**: 条文は 13.5m 以上を定めていないので、そこは値を作らず MemberUnsupportedError で落とす\"\r\n    },\r\n    {\r\n      \"id\": \"2（４）床板3)\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"同一配筋の床板がある場合には、適切な計算法による統計値とすることができる。\",\r\n      \"status\": \"deferred\",\r\n      \"reason\": \"「することができる」— 許容であって要求ではない。製品は床板を1枚ずつ計測して合算するので統計値を用いない。2（５）壁1)③ と同じ趣旨である\"\r\n    },\r\n    {\r\n      \"id\": \"2（５）壁1)①\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"縦筋、横筋の長さは、接続する他の部分に定着するものとし、壁の高さ又は長さに定着長さを加えたものとする。補強筋は設計図書による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"耐震壁 縦筋・横筋の設計長さ。縦筋は壁の高さ、横筋は壁の長さを本体とし、それぞれ両端に定着長さを加える（「接続する他の部分に定着するものとし」— 縦筋は上下の梁へ、横筋は両側の柱へ）。定着は表5.3.4 の一般値 L1 で、同表に壁専用の列はない（L2 は小梁・L3 はスラブ限定）。「補強筋は設計図書による」ので開口補強筋等は断面一覧の入力に置き、製品は値を作らない\"\r\n    },\r\n    {\r\n      \"id\": \"2（５）壁1)②\",\r\n      \"printedPage\": 17,\r\n      \"pdfPage\": 22,\r\n      \"quote\": \"縦筋の継手は原則として各階に１か所あるものとし、開口部腰壁、手すり壁等の継手はないものとする。また、横筋の継手は、１通則４）による。\",\r\n      \"status\": \"covered\",\r\n      \"coveredBy\": \"ルールパック measure.splice.wall.vertical ＝ 各階に1か所。柱の 2（２）柱2) と値は同じだが条文が別なので行を分ける — 片方が改定されたときに巻き添えで動かないためである。横筋は条文が明示的に 1通則4) へ戻すので measure.splice.interval（径ごとの 6.0m/7.0m）で数える。「開口部腰壁、手すり壁等の継手はないものとする」の但書は measure.splice.wall.opening（0か所）が持ち、開口を横切って断たれた縦筋に効く (ADR-029)\"\r\n    },\r\n    {\r\n      \"id\": \"2（５）壁1)③\",\r\n      \"printedPage\": 18,\r\n      \"pdfPage\": 23,\r\n      \"quote\": \"同一配筋の壁がある場合には、適切な計算法による統計値とすることができる。\",\r\n      \"status\": \"deferred\",\r\n      \"reason\": \"「することができる」— 許容であって要求ではない。製品は壁を1枚ずつ計測して合算するので統計値を用いない。同じ趣旨の 2（４）床板3) も同じ理由で deferred である\"\r\n    }\r\n  ],\r\n\r\n  \"cases\": {\r\n    \"hoopDesignLength\": [\r\n      {\r\n        \"clause\": \"1通則2)\",\r\n        \"label\": \"柱 C1 800×800\",\r\n        \"memberKind\": \"柱\",\r\n        \"sectionWidthMm\": 800,\r\n        \"sectionDepthMm\": 800,\r\n        \"expectedMm\": 3200\r\n      },\r\n      {\r\n        \"clause\": \"1通則2)\",\r\n        \"label\": \"柱 C2 650×900\",\r\n        \"memberKind\": \"柱\",\r\n        \"sectionWidthMm\": 650,\r\n        \"sectionDepthMm\": 900,\r\n        \"expectedMm\": 3100\r\n      },\r\n      {\r\n        \"clause\": \"1通則2)\",\r\n        \"label\": \"大梁 G1 400×750\",\r\n        \"memberKind\": \"大梁\",\r\n        \"sectionWidthMm\": 400,\r\n        \"sectionDepthMm\": 750,\r\n        \"expectedMm\": 2300\r\n      },\r\n      {\r\n        \"clause\": \"1通則2)\",\r\n        \"label\": \"大梁 G2 350×700\",\r\n        \"memberKind\": \"大梁\",\r\n        \"sectionWidthMm\": 350,\r\n        \"sectionDepthMm\": 700,\r\n        \"expectedMm\": 2100\r\n      },\r\n      {\r\n        \"clause\": \"1通則2)\",\r\n        \"label\": \"円形柱 600φ\",\r\n        \"memberKind\": \"柱\",\r\n        \"diameterMm\": 600,\r\n        \"expectedMm\": 1884.9556,\r\n        \"note\": \"断面の設計寸法による周長 ＝ π×600 ＝ 1884.9556。条文は断面形状を矩形に限っていない — 「断面の設計寸法による周長」であって、円形断面ではそれが円周である。値は円周の定義から手で求めたもので、製品の出力からは導いていない (ADR-010)\"\r\n      }\r\n    ],\r\n    \"distributionCount\": [\r\n      {\r\n        \"clause\": \"1通則7)\",\r\n        \"label\": \"各階柱 階高4200 @100 — 割り切れる\",\r\n        \"partLengthMm\": 4200,\r\n        \"pitchMm\": 100,\r\n        \"expectedCount\": 43\r\n      },\r\n      {\r\n        \"clause\": \"1通則7)\",\r\n        \"label\": \"各階柱 階高3500 @150 — 端数切り上げ\",\r\n        \"partLengthMm\": 3500,\r\n        \"pitchMm\": 150,\r\n        \"expectedCount\": 25\r\n      },\r\n      {\r\n        \"clause\": \"1通則7)\",\r\n        \"label\": \"大梁 内法5200 @100 — 割り切れる\",\r\n        \"partLengthMm\": 5200,\r\n        \"pitchMm\": 100,\r\n        \"expectedCount\": 53\r\n      },\r\n      {\r\n        \"clause\": \"1通則7)\",\r\n        \"label\": \"大梁 内法4750 @200 — 端数切り上げ\",\r\n        \"partLengthMm\": 4750