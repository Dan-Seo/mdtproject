Keys: string[]\r\n    }\r\n    totalDesignKg: number\r\n    totalRequiredKg: number\r\n  }\r\n  handDerivation: string\r\n}\r\n\r\ntype WallClassFixture = {\r\n  clause: string\r\n  shared: {\r\n    mark: string\r\n    thicknessMm: number\r\n    fc: WallSection['fc']\r\n    grade: WallSection['grade']\r\n    exposure: WallSection['exposure']\r\n    finish: WallSection['finish']\r\n    spliceMethod: WallSection['spliceMethod']\r\n    layers: WallSection['layers']\r\n    vertical: {\r\n      size: BarSize\r\n      pitchMm: number\r\n      startOffsetMm: number\r\n    }\r\n    horizontal: {\r\n      size: BarSize\r\n      pitchMm: number\r\n      startOffsetMm: number\r\n    }\r\n    span: WallSpan\r\n    unitMassKgPerM: Partial<Record<ShearBarSize, number>>\r\n  }\r\n  cases: WallClassCase[]\r\n}\r\n\r\nconst wallClassFixture = fixture.cases.wallClass as WallClassFixture\r\n\r\ntype WallExtentCase = {\r\n  id: string\r\n  extent?: WallExtent\r\n  expected: {\r\n    span: {\r\n      clearLengthMm: number\r\n      clearHeightMm: number\r\n      freeEnds: Partial<{\r\n        vertical: '訝딁ク' | '訝뗧ク'\r\n        horizontal: '冶뗧ク' | '永귞ク'\r\n      }>\r\n      originOffsetMm: { along: number; height: number }\r\n    }\r\n    vertical: {\r\n      lengthMm: number\r\n      count: number\r\n      spliceCountPerBar: number\r\n      anchorageCount: number\r\n      designKg: number\r\n      requiredKg: number\r\n      ruleKeys: string[]\r\n--- existing wall tests ---\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { Member, WallSection } from '../model/member'\r\nimport type { WallSpan } from '../model/project'\r\nimport { lookupRule } from '../rules/lookup'\r\nimport { jpMlitRulePack } from '../../rulepack'\r\nimport { generateWallRebar, type WallRebarInput } from './wall'\r\n\r\nconst member: Member = {\r\n  id: '1F-W1-X1Y1-X',\r\n  kind: '?먬쐡鶯?,\r\n  memberClass: '翁?퐪',\r\n  sectionId: 'section-W1',\r\n  storyId: '1F',\r\n  position: { axis: 'X', ix: 0, iy: 0 },\r\n}\r\n\r\nconst section: WallSection = {\r\n  id: 'section-W1',\r\n  kind: '?먬쐡鶯?,\r\n  mark: 'W1',\r\n  thickness: 200,\r\n  fc: 24,\r\n  grade: 'SD345',\r\n  exposure: '掠뗥냵',\r\n  finish: '餓뺜툓?믡걗??,\r\n  spliceMethod: '?띲겖泳숁뎸',\r\n  layers: 2,\r\n  vertical: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n  horizontal: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n}\r\n\r\n// 6000 ?밤깙?녈꺕??800횞800 ??냵力?5200?곲쉸遙?4200 ?뗣굢鸚㎪쥈?쎼걚 750 ?믣폊?꾠걼?끾퀡 3450??\r\nconst span: WallSpan = {\r\n  axis: 'X',\r\n  clearLengthMm: 5200,\r\n  clearHeightMm: 3450,\r\n  startFaceOffsetMm: 400,\r\n  endFaceOffsetMm: 400,\r\n  girderDepthAboveMm: 750,\r\n}\r\n\r\nfunction input(overrides: Partial<WallRebarInput> = {}): WallRebarInput {\r\n  return { member, section, span, ...overrides }\r\n}\r\n\r\nconst diameter = 13\r\nconst conditions = { fc: section.fc, grade: section.grade, hook: false }\r\nconst anchorage =\r\n  lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * diameter\r\nconst tableLap =\r\n  lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * diameter\r\nconst wallLapMinimum =\r\n  lookupRule(jpMlitRulePack, 'lap.wall.minimum', {}).value * diameter\r\nconst lap = Math.max(tableLap, wallLapMinimum)\r\nconst distributionAddition = lookupRule(\r\n  jpMlitRulePack,\r\n  'measure.distribution.addition',\r\n  {},\r\n).value\r\n\r\nfunction byRole(\r\n  generated: ReturnType<typeof generateWallRebar>,\r\n  role: '潁?춮' | '與ょ춮',\r\n) {\r\n  const rebar = generated.find((candidate) => candidate.role === role)\r\n  expect(rebar, `${role} should be generated`).toBeDefined()\r\n  return rebar!\r\n}\r\n\r\ndescribe('generateWallRebar', () => {\r\n  it('generates 潁?춮 and 與ょ춮 only', () => {\r\n    // 亮끾?嶺뗣겘鵝쒌굢?ゃ걚 ??1?싧뎴3) ??빓?뺛굮鶯곥겓?귚툗?덀굥?뚣곫쑍?겹굮若싥굙?뗦씉?뉎겘\r\n    // 2竊덌폆竊됪쥈3) ?㎪쥈?쀣걢?띷뙁?뺛겒?꾠귝쑍?겹굮獒썲뱚?뚥퐳?됥겒?꾠겏鼇덁툓?㎯걤?ゃ걚??\r\n    expect(generateWallRebar(input(), jpMlitRulePack).map(({ role }) => role))\r\n      .toEqual(['潁?춮', '與ょ춮'])\r\n  })\r\n\r\n  describe('潁?춮 ??令띸츞?뷸틬 2竊덌폊竊됧즯1)??, () => {\r\n    it('measures ?끾퀡遙섅걬 plus 若싩? at both ends', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      // ?뚧렏泳싥걲?뗤퍟??깿?녴겓若싩??쇻굥?귙겗?ⓦ걮?곩즯??쳵?뺚╈╉겓若싩??룔걬?믣뒥?덀걼??\r\n      // 訝듽겘鸚㎪쥈?곦툔??틞?욍꺕鸚㎪쥈?멨츣??쇻굥??겎訝←ク?ヤ퍡?뤵?\r\n      expect(vertical.length).toBe(3450 + 2 * anchorage + lap)\r\n    })\r\n\r\n    it('counts 1?싧뎴7) over ?끾퀡?룔걬, doubled by ??뽧꺂?띸춮', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      const perLayer = Math.ceil(5200 / 200) + distributionAddition\r\n      expect(vertical.count).toBe(perLayer * 2)\r\n    })\r\n\r\n    it('halves the count for ?룔꺍?겹꺂?띸춮', () => {\r\n      const single = generateWallRebar(\r\n        input({ section: { ...section, layers: 1 } }),\r\n        jpMlitRulePack,\r\n      )\r\n      const perLayer = Math.ceil(5200 / 200) + distributionAddition\r\n\r\n      expect(byRole(single, '潁?춮').count).toBe(perLayer)\r\n    })\r\n\r\n    it('takes 泳숁뎸 as ?꾦쉸???뗦? (2竊덌폊竊됧즯1)??, not the 1?싧뎴4) interval', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      expect(vertical.splice?.countPerBar).toBe(1)\r\n      expect(vertical.splice?.rules.map(({ key }) => key)).toContain(\r\n        'measure.splice.wall.vertical',\r\n      )\r\n    })\r\n\r\n    it('draws 若싩? beyond both ends of the ?끾퀡 panel', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n      const [bottom, top] = vertical.points\r\n\r\n      expect(bottom[1]).toBe(-anchorage)\r\n      expect(top[1]).toBe(3450 + anchorage)\r\n    })\r\n  })\r\n\r\n  describe('與ょ춮 ??令띸츞?뷸틬 2竊덌폊竊됧즯1)??, () => {\r\n    it('measures ?끾퀡?룔걬 plus 若싩? at both ends', () => {\r\n      const horizontal = byRole(\r\n        generateWallRebar(input(), jpMlitRulePack),\r\n        '與ょ춮',\r\n      )\r\n      const beforeSplice = 5200 + 2 * anchorage\r\n      const interval = lookupRule(jpMlitRulePack, 'measure.splice.interval', {\r\n        size: 'D13',\r\n      }).value\r\n      const splices = Math.floor(beforeSplice / interval)\r\n\r\n      expect(horizontal.length).toBe(beforeSplice + splices * lap)\r\n    })\r\n\r\n    it('counts 1?싧뎴7) over ?끾퀡遙섅걬, doubled by ??뽧꺂?띸춮', () => {\r\n      const horizontal = byRole(\r\n        generateWallRebar(input(), jpMlitRulePack),\r\n        '與ょ춮',\r\n      )\r\n\r\n      const perLayer = Math.ceil(3450 / 200) + distributionAddition\r\n      expect(horizontal.count).toBe(perLayer * 2)\r\n    })\r\n\r\n    it('returns to 1?싧뎴4) for its 泳숁뎸, as 2竊덌폊竊됧즯1)??directs', () => {\r\n      const horizontal = byRole(\r\n        generateWallRebar(input(), jpMlitRulePack),\r\n        '與ょ춮',\r\n      )\r\n\r\n      expect(horizontal.splice?.rules.map(({ key }) => key)).toContain(\r\n        'measure.splice.interval',\r\n      )\r\n    })\r\n  })\r\n\r\n  describe('?먨뒟鶯곥겗?띲겖泳숁뎸?룔걬 ??與숁틬餓뺞쭣??5.3.4(3)(節?', () => {\r\n    it('takes the larger of 40d and 烏?.3.2', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      expect(vertical.splice?.lengthMm).toBe(lap)\r\n      expect(lap).toBeGreaterThanOrEqual(wallLapMinimum)\r\n      expect(lap).toBeGreaterThanOrEqual(tableLap)\r\n    })\r\n\r\n    it('cites 烏?.3.2 and the ?먨뒟鶯?lower bound together', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n      const keys = vertical.splice?.rules.map(({ key }) => key) ?? []\r\n\r\n      expect(keys).toContain('lap.L1')\r\n      expect(keys).toContain('lap.wall.minimum')\r\n    })\r\n  })\r\n\r\n  describe('?с궧?㎪렏 ??1?싧뎴5)', () => {\r\n    it('keeps the 嶸뉑???but adds no length', () => {\r\n      const generated = generateWallRebar(\r\n        input({ section: { ...section, spliceMethod: '?с궧?㎪렏' } }),\r\n        jpMlitRulePack,\r\n      )\r\n      const vertical = byRole(generated, '潁?춮')\r\n\r\n      expect(vertical.splice?.countPerBar).toBe(1)\r\n      expect(vertical.splice?.lengthMm).toBe(0)\r\n      expect(vertical.length).toBe(3450 + 2 * anchorage)\r\n    })\r\n  })\r\n\r\n  it('carries the ?뗣겤??and 若싩? rules it actually looked up', () => {\r\n    const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n    const keys = vertical.ruleHits.map(({ key }) => key)\r\n\r\n    expect(keys).toContain('cover.minimum')\r\n    expect(keys).toContain('anchorage.L1')\r\n  })\r\n})\r\n\r\ndescribe('generateWallRebar ???뗥룭獒쒎섭嶺뗣겗鼇?쮫?녔쎑邕?쮼 (1?싧뎴8) ?ゃ걡?멥걤', () => {\r\n  const reinforcementMember: Member = {\r\n    ...member,\r\n    openings: [\r\n      {\r\n        id: 'W1-op1',\r\n        xMm: 2000,\r\n        yMm: 900,\r\n        widthMm: 1800,\r\n        heightMm: 1200,\r\n        reinforcements: [\r\n          { size: 'D13', count: 4, lengthMm: 1800 },\r\n          { size: 'D10', count: 2, lengthMm: 1200 },\r\n        ],\r\n      },\r\n    ],\r\n  }\r\n\r\n  it('emits each transcribed value as a separate straight Rebar', () => {\r\n    const reinforcements = generateWallRebar(\r\n      input({ member: reinforcementMember }),\r\n      jpMlitRulePack,\r\n    ).filter(({ role }) => role === '?뗥룭獒쒎섭嶺?)\r\n\r\n    expect(reinforcements).toHaveLength(2)\r\n    expect(reinforcements).toMatchObject([\r\n      {\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: 'D13',\r\n        count: 4,\r\n        length: 1800,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [1800, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      },\r\n      {\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: 'D10',\r\n        count: 2,\r\n        length: 1200,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [1200, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      },\r\n    ])\r\n\r\n    for (const rebar of reinforcements) {\r\n      expect(rebar).not.toHaveProperty('zones')\r\n      expect(rebar).not.toHaveProperty('placement')\r\n      expect(rebar.formula).toContain('鼇?쮫?녔쎑邕?쮼')\r\n      expect(rebar.formula).toContain('1?싧뎴8)')\r\n      expect(rebar.formula).toContain(`${rebar.length}`)\r\n      expect(rebar.formula).toContain(`${rebar.count}`)\r\n    }\r\n  })\r\n\r\n  it('does not emit an untranscribed zero-length row', () => {\r\n    const reinforcements = generateWallRebar(\r\n      input({\r\n        member: {\r\n          ...reinforcementMember,\r\n          openings: [\r\n            {\r\n              ...reinforcementMember.openings![0],\r\n              reinforcements: [{ size: 'D13', count: 4, lengthMm: 0 }],\r\n            },\r\n          ],\r\n        },\r\n      }),\r\n      jpMlitRulePack,\r\n    ).filter(({ role }) => role === '?뗥룭獒쒎섭嶺?)\r\n\r\n    expect(reinforcements).toEqual([])\r\n  })\r\n})\r\n\r\ndescribe('generateWallRebar ???뗥룭?ⓦ겗轝좈솮 (?곈뇧令띸츞?뷸틬 1?싧뎴8))', () => {\r\n  // ?끾퀡 5200횞3450?곥깞?껁긽 200?귞를嶺?27?с꺕與ょ춮 19??(1?싧뎴7))??\r\n  // ?뗥룭 1800횞1200 ??(2000, 900) ?ョ쉰?뤵겏?곭를嶺뗣겘 x (2000,3800) ??냵??8?с걣\r\n  // 遙섅걬 1200 ?믡곫Ø嶺뗣겘 y (900,2100) ??냵??6?с걣 亮?1800 ?믤쵟?뤵?\r\n  const opening = {\r\n    id: 'W1-op1',\r\n    xMm: 2000,\r\n    yMm: 900,\r\n    widthMm: 1800,\r\n    heightMm: 1200,\r\n  }\r\n  const holed = { ...member, openings: [opening] }\r\n\r\n  function rows(role: '潁?춮' | '與ょ춮', member_: Member = holed) {\r\n    return generateWallRebar(input({ member: member_ }), jpMlitRulePack).filter(\r\n      (rebar) => rebar.role === role,\r\n    )\r\n  }\r\n\r\n  it('??쵟?ㅹ뇧?붵겏?ヨ죱?믣늽?묆굥 ???띷뻼?뚩쫸?쇈곩숱?뜰곩?力뺟춬?붵겏?ャ?, () => {\r\n    const vertical = rows('潁?춮')\r\n\r\n    expect(vertical).toHaveLength(2)\r\n    // 27?с겗?녴걾 8?с걣轝졼걨??9?с걣?앫겗?얇겲?귙겑?▲굢?귙??뽧꺂?띸춮??횞2??\r\n    expect(vertical.map(({ count }) => count)).toEqual([19 * 2, 8 * 2])\r\n  })\r\n\r\n  it('??뼀?ｃ굮與ゅ늾?뗦쑍?졼걨?믧뼀?ｃ겗?끾퀡野멩퀡?졼걨??걦?쇻굥', () => {\r\n    const [full, cut] = rows('潁?춮')\r\n\r\n    expect(full.length - cut.length).toBe(\r\n      // 轝좈솮 1200 ?ⓦ곭텤?뗣걣 1?뗦??뗣굢 0?뗦??ヨ맼?▲걼?녴?\r\n      1200 + lap,\r\n    )\r\n    expect(cut.length).toBe(3450 - 1200 + 2 * anchorage)\r\n  })\r\n\r\n  it('??뎔?뗥릲?띲겎轝졼걦野멩퀡?믣쨯?덀굥 ??與ょ춮??뼀?ｃ겗亮끹굮轝졼걦', () => {\r\n    const [full, cut] = rows('與ょ춮')\r\n\r\n    expect(full.count).toBe(13 * 2)\r\n    expect(cut.count).toBe(6 * 2)\r\n    expect(cut.length).toBe(\r\n      5200 - 1800 + 2 * anchorage + cut.splice!.lengthMm,\r\n    )\r\n  })\r\n\r\n  it('??뼀?ｃ겎??걼?뚣걼潁?춮??텤?뗣굮 0?뗦??ャ걲????2竊덌폊竊됧즯1)??鵝녷쎑', () => {\r\n    const [full, cut] = rows('潁?춮')\r\n\r\n    expect(full.splice?.countPerBar).toBe(1)\r\n    expect(full.splice?.rules.map(({ key }) => key)).toContain(\r\n      'measure.splice.wall.vertical',\r\n    )\r\n    expect(cut.splice?.countPerBar).toBe(0)\r\n    expect(cut.splice?.rules.map(({ key }) => key)).toContain(\r\n      'measure.splice.wall.opening',\r\n    )\r\n    expect(cut.splice?.formula).toContain('?뗥룭?②뀺鶯곥곫뎸?쇻굤鶯곭춬')\r\n  })\r\n\r\n  it('??Ø嶺뗣겗泳숁뎸?믤쵟?ㅵ풄??빓?뺛겎?겹걟????1?싧뎴4)?뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛?, () => {\r\n    const [full, cut] = rows('與ょ춮')\r\n\r\n    // 5200竊뗥츣? ??6.0m ?믦텏?덀굥?뚣?800 ?믤쵟?뤵겏擁듽걟?ゃ걚??\r\n    expect(full.splice?.countPerBar).toBe(1)\r\n    expect(cut.splice?.countPerBar).toBe(0)\r\n  })\r\n\r\n  it('??0.5?▽빳訝뗣겗?뗥룭?㎬죱?믣늽?묆걳?곫쵟?ㅳ걮?ゃ걢?ｃ걼?볝겏?믥츞?뷴폀?ユ쎑??, () => {\r\n    const small = {\r\n      ...member,\r\n      openings: [{ ...opening, widthMm: 700, heightMm: 700 }],\r\n    }\r\n    const vertical = rows('潁?춮', small)\r\n\r\n    expect(vertical).toHaveLength(1)\r\n    expect(vertical[0].count).toBe(27 * 2)\r\n    expect(vertical[0].formula).toContain('700횞700')\r\n    expect(vertical[0].formula).toContain('0.5?▽빳訝?)\r\n  })\r\n\r\n  it('??죱?붵겏??3D ??를?념퐤營?굮?녴걨?????뚣걯?닸??ヤ틠佯?룒?뗣겒??, () => {\r\n    const [full, cut] = rows('潁?춮')\r\n    const fullAt = full.placement?.positionsMm ?? []\r\n    const cutAt = cut.placement?.positionsMm ?? []\r\n\r\n    expect(cutAt).toEqual([2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600])\r\n    expect(fullAt).toHaveLength(19)\r\n    expect(new Set([...fullAt, ...cutAt]).size).toBe(27)\r\n    // positionCount ??빊?뤵겗?ф빊?㎯겘?ゃ걦?뤵걦?ф빊??(ADR-019)??\r\n    expect(full.placement?.positionCount).toBe(19)\r\n  })\r\n\r\n  it('??뼀?ｃ걣?ゃ걨?뚣겙訝╉겧?밤굮鸚됥걟?ゃ걚 ???앮쐿?ゃ깢?삠긿?덀겗?얇겲?㎯걗??, () => {\r\n    const vertical = rows('潁?춮', member)\r\n\r\n    expect(vertical).toHaveLength(1)\r\n    expect(vertical[0].placement?.positionsMm).toBeUndefined()\r\n    expect(vertical[0].placement?.startOffsetMm).toBe(100)\r\n  })\r\n\r\n  it('??쵟?ㅳ겗?뷴끂?믦죱??졊?졼겓雍됥걵??, () => {\r\n    const [, cut] = rows('潁?춮')\r\n\r\n    expect(cut.ruleHits.map(({ key }) => key)).toContain(\r\n      'measure.opening.deduction.minimum.area',\r\n    )\r\n    expect(cut.formula).toContain('1?싧뎴8)')\r\n  })\r\n\r\n  it('??3D 永뚩러?믤쵟?뗣걵?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝', () => {\r\n    const [, cut] = rows('潁?춮')\r\n\r\n    // points ??뼀?ｃ굮?γ굢?ゃ걚?③빓??탪瓮?겎?곮〃鹽븅깿??Member.openings ?㎩늾?뗣?\r\n    expect(cut.points[0]).toEqual([0, -anchorage, expect.any(Number)])\r\n    expect(cut.points[1]).toEqual([0, 3450 + anchorage, expect.any(Number)])\r\n  })\r\n})\r\n--- member model relevant ---\r\n/** BAR_SIZES ?ⓨ릪?섅걦?곩츪烏뚧셽?ユ쩂?곥굢?뚣굥?덀걝?띶닓?뗣굢?뗣굮壅룔걪?쇻?*/\r\nexport const MEMBER_KINDS = ['??, '鸚㎪쥈', '?먬쐡鶯?, '佯딀씮'] as const\r\n\r\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\r\n\r\nexport type MemberClass = '翁?퐪'\r\n\r\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\r\nexport const BAR_SIZES = [\r\n  'D10',\r\n  'D13',\r\n  'D16',\r\n  'D19',\r\n  'D22',\r\n  'D25',\r\n  'D29',\r\n  'D32',\r\n] as const\r\n\r\nexport type BarSize = (typeof BAR_SIZES)[number]\r\n\r\n/**\r\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\r\n *\r\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\r\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\r\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\r\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\r\n *\r\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\r\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\r\n *\r\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\r\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\r\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\r\n */\r\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\r\n\r\nexport type HighStrengthShearBarSize =\r\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\r\n\r\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\r\nexport const SHEAR_BAR_SIZES = [\r\n  ...BAR_SIZES,\r\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\r\n] as const\r\n\r\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\r\n\r\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\r\n\r\n/**\r\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯겗?ε뒟?㎯걗?ｃ겍獒썲뱚?뚧군?곥겒??(ADR-012)??\r\n *\r\n * ?곈뇧令띸츞?뷸틬 1?싧뎴4)??) ?뚦릫?뉎걲??겘?띲겖泳숁뎸?ⓦ궗?밧쑇?η텤?뗣걽?묆겒??겎??\r\n * 艅잍ː凉뤵꺕繹뜻렏??돮?꾠겘?ャ꺖?ャ깙?껁궚?담겎 `inferred` ??죱?ャ겒?????멥겧?뗣걣\r\n * ?ょ▶沃띲겏?쀣겍鈺?몜?뚥퍡??(ADR-015)??\r\n */\r\nexport const SPLICE_METHODS = [\r\n  '?띲겖泳숁뎸',\r\n  '?с궧?㎪렏',\r\n  '艅잍ː凉?,\r\n  '繹뜻렏',\r\n] as const\r\n\r\nexport type SpliceMethod = (typeof SPLICE_METHODS)[number]\r\n\r\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\r\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\r\n\r\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\r\n\r\n/**\r\n * ?긱겗??씊壤®듁??\r\n *\r\n * ?녶숱?긱겘 b?팪 ?믡겏?귙겓?닷푶?ャ걲?뗣귛ㄷ歟곥겗?끾퀡?룔걬??3D ??윶?㏂굚 b?팪 ?뗣굢\r\n * 黎뷩겲?뗣겗?㎯곩쨼?ε?力뺛겏?쀣겍?뚣걯?ㅳ굮營?걨?겼숱?뜰겗瓦썲뒥?뚩쮫歷ц쫸?뉎굮?뷩굢?뺛겒?꾠?\r\n * ?곈뇧?㎩숱?뜰굮誤뗣굥??겘 1?싧뎴2)?뚧뼪?㏂겗鼇?쮫野멩퀡?ャ굠?뗥뫅?룔띲걼?졽?嶸뉑??㎯?\r\n * ?녶숱??씊?㎯겘?앫겗?③빓?뚦냶?ⓦ겓?ゃ굥 ??獒썲뱚?뚧뼭?쀣걚?ㅳ굮鵝쒌굥?뤵걨?㎯겘?ゃ걚 (ADR-027)??\r\n *\r\n * ?밤깙?ㅳ꺀?ョ춮??돮?뤵겒?꾠귝쮽繹뽨퍞礪섉쎑 5.3.4(6)(節? ?뚣뚣궧?묆궎?⒲꺂嶺뗣겗泳숁뎸?듽겞若싩???\r\n  sideBar?: {\r\n    size: BarSize\r\n    count: number\r\n    /**\r\n     * 歟곥겗訝←ク?㎩냵力뺛굮擁듽걟?╊섯?녈굥鵝숅빓 (mm)?귝빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈3) ??\r\n     * ?볝굦??1?싧뎴6) ?ュ쭟??곩릪?끹겘鼇?쮫?녔쎑?ヨ쮼雍됥걣?ゃ걨?뚣겙 JASS 5 繹뽫뵪??\r\n     * ?쇻굥?괟ASS 5 ??쐣?숃쫸?쇈겎?ょ▶岳앫곫쮽繹뽨퍞礪섉쎑5塋졼겓??끃嶺뗣겗鼇섋염?뚥???\r\n     * ?ゃ걚?잆굙誤뤸틬?ㅳ굮?뽧굦?ゃ걚 ??鼇?쮫?녔쎑??ㅳ굮?ε뒟?ⓦ걮??룛?묈룚??(R9????\r\n     */\r\n    extraLengthMm: number