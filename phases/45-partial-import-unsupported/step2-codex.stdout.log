{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/lib/viewer/building.test.ts; Get-Content src/lib/import/framing-plan/apply.test.ts; Get-Content src/domain/model/sample-project.ts'","aggregated_output":"import { describe, expect, it } from 'vitest'\r\n\r\nimport type { GirderSection, Member } from '@/domain/model/member'\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport {\r\n  findSection,\r\n  girderRun,\r\n  girderSpan,\r\n  gridPoint,\r\n  gridPointCount,\r\n  slabRun,\r\n  storyElevation,\r\n  wallSpan,\r\n  type Project,\r\n} from '@/domain/model/project'\r\nimport type { Rebar } from '@/domain/model/rebar'\r\nimport { generateGirderRebar } from '@/domain/rebar/girder'\r\nimport { generateSlabRebar } from '@/domain/rebar/slab'\r\nimport { jpMlitRulePack } from '@/rulepack'\r\n\r\nimport {\r\n  buildingLayout,\r\n  groupInstancesByLayerAndRadius,\r\n  type RebarInstance,\r\n} from './building'\r\nimport { rebarRadius, rebarSegments } from './geometry'\r\n\r\nconst project = createSampleProject()\r\nconst noUnsupportedMembers = new Set<string>()\r\n\r\n// geometry.test.ts? 媛숈? ???諛곌렐 ?쎌뒪泥???memberId留?X2Y2(洹몃━??以묒븰)濡??〓뒗??\r\nconst main: Rebar = {\r\n  id: '1F-X2Y2|main',\r\n  memberId: '1F-X2Y2',\r\n  role: '訝사춮',\r\n  size: 'D25',\r\n  shape: 'straight',\r\n  points: [\r\n    [40, -875, 40],\r\n    [40, 5200, 40],\r\n  ],\r\n  closed: false,\r\n  length: 6080,\r\n  count: 12,\r\n  ruleHits: [],\r\n  formula: 'test',\r\n}\r\n\r\nconst hoop: Rebar = {\r\n  id: '1F-X2Y2|hoop',\r\n  memberId: '1F-X2Y2',\r\n  role: '躍?춮',\r\n  size: 'D13',\r\n  shape: 'hoop',\r\n  points: [\r\n    [40, 0, 40],\r\n    [760, 0, 40],\r\n    [760, 0, 760],\r\n    [40, 0, 760],\r\n  ],\r\n  closed: true,\r\n  length: 3040,\r\n  // 躍?춮 ?꾧컻???꾨찓??諛곗튂瑜??곕Ⅴ誘濡??ф빊? ?끾퀡???쒕줈 留욎븘???쒕떎\r\n  // (@100 횞 ?끾퀡 200 ??0쨌100쨌200??3蹂?.\r\n  count: 3,\r\n  placement: {\r\n    axis: 'y',\r\n    clearMm: 200,\r\n    pitchMm: 100,\r\n    startOffsetMm: 0,\r\n    lastGapMm: 100,\r\n    positionCount: 3,\r\n  },\r\n  ruleHits: [],\r\n  formula: 'test',\r\n}\r\n\r\nfunction girderFixture(\r\n  source: Project,\r\n  memberId: string,\r\n): { member: Member; section: GirderSection; rebars: Rebar[] } {\r\n  const member = source.members.find(({ id }) => id === memberId)\r\n  if (\r\n    member?.kind !== '鸚㎪쥈' ||\r\n    !('axis' in member.position)\r\n  ) {\r\n    throw new Error(`鸚㎪쥈 not found: ${memberId}`)\r\n  }\r\n\r\n  const section = findSection(source, member.sectionId)\r\n  if (section.kind !== '鸚㎪쥈') {\r\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${memberId}`)\r\n  }\r\n\r\n  return {\r\n    member,\r\n    section,\r\n    rebars: generateGirderRebar(\r\n      { run: girderRun(source, member), section },\r\n      jpMlitRulePack,\r\n    ),\r\n  }\r\n}\r\n\r\nfunction roleRebar(rebars: Rebar[], role: Rebar['role']): Rebar {\r\n  const rebar = rebars.find((candidate) => candidate.role === role)\r\n  if (!rebar) throw new Error(`${role} not found`)\r\n  return rebar\r\n}\r\n\r\ndescribe('buildingLayout', () => {\r\n  it('keeps a cantilever slab concrete box and rebar beyond its supported grid edge', () => {\r\n    const member: Member = {\r\n      id: '1F-S1-X1Y3-X-cantilever',\r\n      kind: '佯딀씮',\r\n      memberClass: '翁?퐪',\r\n      sectionId: 'section-S1',\r\n      storyId: '1F',\r\n      position: { axis: 'X', ix: 0, iy: 2 },\r\n      cantilever: { side: '閭?, projectionMm: 1800 },\r\n    }\r\n    const cantileverProject = {\r\n      ...project,\r\n      members: [...project.members, member],\r\n    }\r\n    const section = findSection(cantileverProject, member.sectionId)\r\n    if (section.kind !== '佯딀씮') throw new Error('佯딀씮 section not found')\r\n    const rebars = (['X', 'Y'] as const).flatMap((axis) =>\r\n      generateSlabRebar(\r\n        {\r\n          run: slabRun(cantileverProject, member, axis),\r\n          section,\r\n        },\r\n        jpMlitRulePack,\r\n      ),\r\n    )\r\n\r\n    const layout = buildingLayout(\r\n      cantileverProject,\r\n      rebars,\r\n      noUnsupportedMembers,\r\n    )\r\n    const box = layout.boxes.find(({ memberId }) => memberId === member.id)\r\n    const support = gridPoint(cantileverProject.grid, 0, 2)\r\n    const instances = layout.rebar.filter(\r\n      ({ memberId }) => memberId === member.id,\r\n    )\r\n\r\n    expect(box?.size[2]).toBe(1800)\r\n    expect(box?.center[2]).toBeGreaterThan(support.y)\r\n    expect(layout.bounds.max[2]).toBeGreaterThan(support.y)\r\n    expect(instances).not.toHaveLength(0)\r\n    expect(\r\n      instances.some(({ from, to }) =>\r\n        Math.max(from[2], to[2]) > support.y,\r\n      ),\r\n    ).toBe(true)\r\n  })\r\n\r\n  it('skips ?뗥룭獒쒎섭嶺?in the building view without failing the layout', () => {\r\n    const wall = project.members.find(({ kind }) => kind === '?먬쐡鶯?)!\r\n    const reinforcement: Rebar = {\r\n      id: `${wall.id}|opening-reinforcement`,\r\n      memberId: wall.id,\r\n      role: '?뗥룭獒쒎섭嶺?,\r\n      size: 'D13',\r\n      shape: 'straight',\r\n      points: [\r\n        [0, 0, 0],\r\n        [1800, 0, 0],\r\n      ],\r\n      closed: false,\r\n      length: 1800,\r\n      count: 4,\r\n      ruleHits: [],\r\n      formula: '鼇?쮫?녔쎑邕?쮼',\r\n    }\r\n\r\n    const layout = buildingLayout(\r\n      project,\r\n      [reinforcement],\r\n      noUnsupportedMembers,\r\n    )\r\n\r\n    expect(layout.rebar).toEqual([])\r\n    expect(layout.boxes.length).toBeGreaterThan(0)\r\n  })\r\n\r\n  it('creates one concrete box per member of the sample project', () => {\r\n    const layout = buildingLayout(project, [], noUnsupportedMembers)\r\n    const { nx, ny } = gridPointCount(project.grid)\r\n    const columnCount = nx * ny * project.stories.length\r\n    const girderCount =\r\n      ((nx - 1) * ny + nx * (ny - 1)) * project.stories.length\r\n    // 佯딀씮??싥굤??겎?꿔겲?뚣걼?쇻궎??빊?졼걨?귙굥 (ADR-028)??\r\n    const slabCount = (nx - 1) * (ny - 1) * project.stories.length\r\n    // ?먬쐡鶯곥겘?겹꺁?껁깋?뗣굢弱롢걨?ゃ걚 ???듐꺍?쀣꺂???롢걗?잆굤1?싥걽?묊쉰?꾠겍?꾠굥??겎\r\n    // (ADR-025)?곩츪?쎼겓營?걢?뚣걼?겹굮?겹걟?뗣?\r\n    const wallCount = project.members.filter(\r\n      ({ kind }) => kind === '?먬쐡鶯?,\r\n    ).length\r\n\r\n    expect(layout.boxes).toHaveLength(\r\n      columnCount + girderCount + wallCount + slabCount,\r\n    )\r\n    expect(layout.boxes.filter(({ kind }) => kind === '佯딀씮')).toHaveLength(\r\n      slabCount,\r\n    )\r\n    expect(layout.boxes.filter(({ kind }) => kind === '??)).toHaveLength(\r\n      columnCount,\r\n    )\r\n    expect(layout.boxes.filter(({ kind }) => kind === '鸚㎪쥈')).toHaveLength(\r\n      girderCount,\r\n    )\r\n    expect(layout.boxes.filter(({ kind }) => kind === '?먬쐡鶯?)).toHaveLength(\r\n      wallCount,\r\n    )\r\n  })\r\n\r\n  it('places a 2F column on the accumulated story elevation', () => {\r\n    const layout = buildingLayout(project, [], noUnsupportedMembers)\r\n    const box = layout.boxes.find(({ memberId }) => memberId === '2F-X1Y1')\r\n\r\n    // 1F ?믪씠 4200 ?꾩뿉 2F(?믪씠 3600)媛 ?됰뒗?? 洹몃━??援먯젏???⑤㈃ 以묒떖 ?뺣젹.\r\n    expect(box?.center).toEqual([0, 4200 + 3600 / 2, 0])\r\n    expect(box?.size).toEqual([800, 3600, 800])\r\n  })\r\n\r\n  it('aligns girder tops to the story ceiling and respects section depth', () => {\r\n    const layout = buildingLayout(project, [], noUnsupportedMembers)\r\n    const box = layout.boxes.find(\r\n      ({ memberId }) => memberId === '1F-G2-X1Y2-X',\r\n    )\r\n\r\n    // G2: depth 700, X異??ㅽ뙩 6000, y=2踰덉㎏ ?듐굤(6000). ?곷떒 = 1F 泥쒖옣 4200.\r\n    expect(box?.center).toEqual([3000, 4200 - 700 / 2, 6000])\r\n    expect(box?.size).toEqual([6000, 700, 400])\r\n  })\r\n\r\n  it('translates ??rebar segments to the member grid position', () => {\r\n    const layout = buildingLayout(\r\n      project,\r\n      [main, hoop],\r\n      noUnsupportedMembers,\r\n    )\r\n    const { x, y } = gridPoint(project.grid, 1, 1)\r\n    // ?⑤㈃ 以묒떖??援먯젏??留욎텛誘濡?濡쒖뺄 ?먯젏? 援먯젏 ???⑤㈃/2 濡??대룞?쒕떎.\r\n    const offsetX = x - 800 / 2\r\n    const offsetZ = y - 800 / 2\r\n\r\n    const mains = layout.rebar.filter(\r\n      ({ radius }) => radius === rebarRadius('D25'),\r\n    )\r\n    expect(mains).toHaveLength(12)\r\n    for (const instance of mains) {\r\n      expect(instance.memberId).toBe('1F-X2Y2')\r\n      expect(instance.from[0]).toBeGreaterThanOrEqual(offsetX)\r\n      expect(instance.from[0]).toBeLessThanOrEqual(offsetX + 800)\r\n      expect(instance.from[2]).toBeGreaterThanOrEqual(offsetZ)\r\n      expect(instance.from[2]).toBeLessThanOrEqual(offsetZ + 800)\r\n      // 訝사춮? 若싩?(??75)留뚰겮 痢?諛붾떏(?쒓퀬 0) ?꾨옒濡??뚯텧?쒕떎.\r\n      expect(instance.from[1]).toBe(-875)\r\n      expect(instance.to[1]).toBe(5200)\r\n    }\r\n\r\n    const hoops = layout.rebar.filter(\r\n      ({ radius }) => radius === rebarRadius('D13'),\r\n    )\r\n    // ?먰빀 4蹂 횞 3蹂?\r\n    expect(hoops).toHaveLength(12)\r\n    expect(hoops[0].from[0]).toBeCloseTo(offsetX + 40 + rebarRadius('D13'))\r\n    expect(hoops[0].from[2]).toBeCloseTo(offsetZ + 40 + rebarRadius('D13'))\r\n  })\r\n\r\n  it('includes both single-span and continuous-run 鸚㎪쥈 rebar', () => {\r\n    const supportedX = girderFixture(project, '1F-G1-X1Y1-X')\r\n    const continuousY = girderFixture(project, '1F-G1-X1Y1-Y')\r\n    const layout = buildingLayout(\r\n      project,\r\n      [...supportedX.rebars, ...continuousY.rebars],\r\n      noUnsupportedMembers,\r\n    )\r\n\r\n    expect(\r\n      layout.rebar.some(\r\n        ({ memberId }) => memberId === supportedX.member.id,\r\n      ),\r\n    ).toBe(true)\r\n    expect(\r\n      layout.rebar.some(\r\n        ({ memberId }) => memberId === continuousY.member.id,\r\n      ),\r\n    ).toBe(true)\r\n  })\r\n\r\n  it('maps an X-axis 鸚㎪쥈 訝딁ク嶺?from the start ??face into world coordinates', () => {\r\n    const fixture = girderFixture(project, '1F-G1-X1Y1-X')\r\n    const top = roleRebar(fixture.rebars, '訝딁ク嶺?)\r\n    const local = rebarSegments(top, fixture.section)[0]\r\n    const span = girderSpan(project, fixture.member)\r\n    const start = gridPoint(\r\n      project.grid,\r\n      fixture.member.position.ix,\r\n      fixture.member.position.iy,\r\n    )\r\n    const story = project.stories.find(\r\n      ({ id }) => id === fixture.member.storyId,\r\n    )!\r\n    const base =\r\n      storyElevation(project.stories, story.id) +\r\n      story.height -\r\n      fixture.section.depth\r\n    const expectedFrom = [\r\n      start.x + span.startFaceOffsetMm + local.from[0],\r\n      base + local.from[1],\r\n      start.y - fixture.section.b / 2 + local.from[2],\r\n    ]\r\n    const expectedTo = [\r\n      start.x + span.startFaceOffsetMm + local.to[0],\r\n      base + local.to[1],\r\n      start.y - fixture.section.b / 2 + local.to[2],\r\n    ]\r\n\r\n    expect(\r\n      buildingLayout(project, fixture.rebars, noUnsupportedMembers).rebar,\r\n    ).toContainEqual({\r\n      memberId: fixture.member.id,\r\n      from: expectedFrom,\r\n      to: expectedTo,\r\n      radius: local.radius,\r\n      size: 'D25',\r\n      role: top.role,\r\n      layer: 'main',\r\n    })\r\n  })\r\n\r\n  it('maps a supported Y-axis 鸚㎪쥈 訝딁ク嶺?with span along world Z', () => {\r\n    // 鸚㎪쥈???ф뒠?뤵겏?곥걹??ㄷ歟곥겎?쀣걨?╉걚?잌틞?욍겗?끾퀡?뚧군?얇굢?ゃ걦?ゃ굥 ??\r\n    // 佯딀씮?귚?渶믡겓鸚뽧걲?귛즯?ⓨ릪?섅걦?곩썪渦뷩겗鸚㎪쥈?뚧쵟?묆걼佯딀씮??뀯?쎼겗訝띷빐?덀걽??\r\n    const supportedYProject: Project = {\r\n      ...project,\r\n      members: project.members.filter(\r\n        ({ id, kind }) => id !== '1F-G1-X1Y2-Y' && kind !== '佯딀씮',\r\n      ),\r\n    }\r\n    const fixture = girderFixture(\r\n      supportedYProject,\r\n      '1F-G1-X1Y1-Y',\r\n    )\r\n    const top = roleRebar(fixture.rebars, '訝딁ク嶺?)\r\n    const local = rebarSegments(top, fixture.section)[0]\r\n    const span = girderSpan(supportedYProject, fixture.member)\r\n    const start = gridPoint(\r\n      supportedYProject.grid,\r\n      fixture.member.position.ix,\r\n      fixture.member.position.iy,\r\n    )\r\n    const story = supportedYProject.stories.find(\r\n      ({ id }) => id === fixture.member.storyId,\r\n    )!\r\n    const base =\r\n      storyElevation(supportedYProject.stories, story.id) +\r\n      story.height -\r\n      fixture.section.depth\r\n    const expectedFrom = [\r\n      start.x - fixture.section.b / 2 + local.from[2],\r\n      base + local.from[1],\r\n      start.y + span.startFaceOffsetMm + local.from[0],\r\n    ]\r\n    const expectedTo = [\r\n      start.x - fixture.section.b / 2 + local.to[2],\r\n      base + local.to[1],\r\n      start.y + span.startFaceOffsetMm + local.to[0],\r\n    ]\r\n\r\n    expect(\r\n      buildingLayout(\r\n        supportedYProject,\r\n        fixture.rebars,\r\n        noUnsupportedMembers,\r\n      ).rebar,\r\n    ).toContainEqual({\r\n      memberId: fixture.member.id,\r\n      from: expectedFrom,\r\n      to: expectedTo,\r\n      radius: local.radius,\r\n      size: 'D25',\r\n      role: top.role,\r\n      layer: 'main',\r\n    })\r\n  })\r\n\r\n  it('keeps every supported 鸚㎪쥈 segment inside the support ??exterior faces', () => {\r\n    const generated = project.members.flatMap((member) =>\r\n      member.kind === '鸚㎪쥈'\r\n        ? girderFixture(project, member.id).rebars\r\n        : [],\r\n    )\r\n    const layout = buildingLayout(project, generated, noUnsupportedMembers)\r\n\r\n    for (const instance of layout.rebar) {\r\n      const member = project.members.find(\r\n        ({ id }) => id === instance.memberId,\r\n      )!\r\n      if (member.kind !== '鸚㎪쥈' || !('axis' in member.position)) continue\r\n\r\n      const run = girderRun(project, member)\r\n      const startMember = run.members[0]\r\n      const endMember = run.members.at(-1)!\r\n      if (\r\n        !('axis' in startMember.position) ||\r\n        !('axis' in endMember.position)\r\n      ) {\r\n        throw new Error('GirderRun contains a non-girder position')\r\n      }\r\n      const startSpan = run.spans[0]\r\n      const endSpan = run.spans.at(-1)!\r\n      const start = gridPoint(\r\n        project.grid,\r\n        startMember.position.ix,\r\n        startMember.position.iy,\r\n      )\r\n      const end =\r\n        member.position.axis === 'X'\r\n          ? gridPoint(\r\n              project.grid,\r\n              endMember.position.ix + 1,\r\n              endMember.position.iy,\r\n            )\r\n          : gridPoint(\r\n              project.grid,\r\n              endMember.position.ix,\r\n              endMember.position.iy + 1,\r\n            )\r\n      const coordinate = member.position.axis === 'X' ? 0 : 2\r\n      const startCenter = member.position.axis === 'X' ? start.x : start.y\r\n      const endCenter = member.position.axis === 'X' ? end.x : end.y\r\n      const exteriorStart =\r\n        startCenter - startSpan.startSupportLengthAlongAxisMm / 2\r\n      const exteriorEnd =\r\n        endCenter + endSpan.endSupportLengthAlongAxisMm / 2\r\n\r\n      for (const point of [instance.from, instance.to]) {\r\n        expect(point[coordinate]).toBeGreaterThanOrEqual(exteriorStart)\r\n        expect(point[coordinate]).toBeLessThanOrEqual(exteriorEnd)\r\n      }\r\n    }\r\n  })\r\n\r\n  it('extends the bounds to cover rebar protruding beyond the boxes', () => {\r\n    const layout = buildingLayout(\r\n      project,\r\n      [main, hoop],\r\n      noUnsupportedMembers,\r\n    )\r\n\r\n    // 理쒖??? 訝사춮 ?섎떒 ??75 ???쒖떆 諛섍꼍. 理쒓퀬?? 2F 泥쒖옣 7800.\r\n    expect(layout.bounds.min[1]).toBeLessThanOrEqual(-875)\r\n    expect(layout.bounds.max[1]).toBeGreaterThanOrEqual(7800)\r\n    expect(layout.bounds.min[0]).toBeLessThanOrEqual(0)\r\n    expect(layout.bounds.max[0]).toBeGreaterThanOrEqual(\r\n      project.grid.xSpans.reduce((sum, span) => sum + span, 0),\r\n    )\r\n  })\r\n\r\n  it('throws when a rebar references an unknown member', () => {\r\n    const orphan: Rebar = { ...main, memberId: 'no-such-member' }\r\n\r\n    expect(() =>\r\n      buildingLayout(project, [orphan], noUnsupportedMembers),\r\n    ).toThrow(\r\n      'Member not found: no-such-member',\r\n    )\r\n  })\r\n\r\n  it('maps continuous-run main bars through the intermediate ??to the run end', () => {\r\n    const fixture = girderFixture(project, '1F-G1-X1Y1-Y')\r\n    const run = girderRun(project, fixture.member)\r\n    const startMember = run.members[0]\r\n    if (!('axis' in startMember.position)) {\r\n      throw new Error('GirderRun contains a non-girder position')\r\n    }\r\n\r\n    const start = gridPoint(\r\n      project.grid,\r\n      startMember.position.ix,\r\n      startMember.position.iy,\r\n    )\r\n    const endInteriorFace =\r\n      start.y + run.spans[0].startFaceOffsetMm + run.coreLengthMm\r\n    const layout = buildingLayout(\r\n      project,\r\n      fixture.rebars,\r\n      noUnsupportedMembers,\r\n    )\r\n    const mainInstances = layout.rebar.filter(\r\n      ({ memberId, layer }) =>\r\n        memberId === run.ownerId && layer === 'main',\r\n    )\r\n    const worldZ = mainInstances.flatMap(({ from, to }) => [from[2], to[2]])\r\n\r\n    expect(mainInstances.length).toBeGreaterThan(0)\r\n    expect(Math.min(...worldZ)).toBeLessThan(start.y)\r\n    expect(Math.max(...worldZ)).toBeGreaterThan(endInteriorFace)\r\n  })\r\n\r\n  it('keeps unsupported member concrete but filters all of its rebar instances', () => {\r\n    const fixture = girderFixture(project, '1F-G1-X1Y1-Y')\r\n    const run = girderRun(project, fixture.member)\r\n    const unsupportedMemberIds = new Set(\r\n      run.members.map(({ id }) => id),\r\n    )\r\n    const layout = buildingLayout(\r\n      project,\r\n      fixture.rebars,\r\n      unsupportedMemberIds,\r\n    )\r\n\r\n    expect(\r\n      layout.boxes.filter(({ memberId }) => unsupportedMemberIds.has(memberId)),\r\n    ).toHaveLength(run.members.length)\r\n    expect(\r\n      layout.rebar.some(({ memberId }) => unsupportedMemberIds.has(memberId)),\r\n    ).toBe(false)\r\n  })\r\n\r\n  it('places a partial wall box, opening, and range-local rebar at the extent origin', () => {\r\n    const wall = project.members.find(({ kind }) => kind === '?먬쐡鶯?)!\r\n    const extentProject: Project = {\r\n      ...project,\r\n      members: project.members.map((member) =>\r\n        member.id === wall.id\r\n          ? {\r\n              ...member,\r\n              wallExtent: {\r\n                horizontal: { anchor: '永귞ク', lengthMm: 2400 },\r\n                vertical: { anchor: '訝딁ク', heightMm: 900 },\r\n              },\r\n              openings: [\r\n                {\r\n                  id: 'extent-opening',\r\n                  xMm: 400,\r\n                  yMm: 200,\r\n                  widthMm: 800,\r\n                  heightMm: 400,\r\n                },\r\n              ],\r\n            }\r\n          : member,\r\n      ),\r\n    }\r\n    const span = wallSpan(extentProject, extentProject.members.find(({ id }) => id === wall.id)!)\r\n    const rangeLocalBar: Rebar = {\r\n      id: `${wall.id}|range-local-bar`,\r\n      memberId: wall.id,\r\n      role: '與ょ춮',\r\n      size: 'D13',\r\n      shape: 'straight',\r\n      points: [\r\n        [0, 0, 100],\r\n        [span.clearLengthMm, 0, 100],\r\n      ],\r\n      closed: false,\r\n      length: span.clearLengthMm,\r\n      count: 1,\r\n      placement: {\r\n        axis: 'y',\r\n        clearMm: span.clearHeightMm,\r\n        pitchMm: span.clearHeightMm,\r\n        startOffsetMm: 0,\r\n        lastGapMm: span.clearHeightMm,\r\n        positionCount: 1,\r\n        positionsMm: [0],\r\n      },\r\n      ruleHits: [],\r\n      formula: 'test',\r\n    }\r\n\r\n    const layout = buildingLayout(\r\n      extentProject,\r\n      [rangeLocalBar],\r\n      noUnsupportedMembers,\r\n    )\r\n    const wallBoxes = layout.boxes.filter(({ memberId }) => memberId === wall.id)\r\n\r\n    expect(wallBoxes).toHaveLength(4)\r\n    expect(wallBoxes.every(({ size }) => size[0] === 200)).toBe(true)\r\n    expect(Math.min(...wallBoxes.map(({ center, size }) => center[1] - size[1] / 2))).toBe(2550)\r\n    expect(Math.max(...wallBoxes.map(({ center, size }) => center[1] + size[1] / 2))).toBe(3450)\r\n    expect(Math.min(...wallBoxes.map(({ center, size }) => center[2] - size[2] / 2))).toBe(3200)\r\n    expect(Math.max(...wallBoxes.map(({ center, size }) => center[2] + size[2] / 2))).toBe(5600)\r\n\r\n    const bar = layout.rebar.find(({ memberId }) => memberId === wall.id)\r\n    expect(bar).toBeDefined()\r\n    expect(bar?.from[1]).toBe(2550)\r\n    expect(bar?.to[1]).toBe(2550)\r\n    expect([bar?.from[2], bar?.to[2]]).toEqual([3200, 5600])\r\n  })\r\n})\r\n\r\ndescribe('groupInstancesByLayerAndRadius', () => {\r\n  it('groups instances by display radius for instanced rendering', () => {\r\n    const layout = buildingLayout(\r\n      project,\r\n      [main, hoop],\r\n      noUnsupportedMembers,\r\n    )\r\n    const groups = groupInstancesByLayerAndRadius(layout.rebar)\r\n\r\n    expect(groups.size).toBe(2)\r\n    expect(groups.get(`${rebarRadius('D25')}|main`)).toHaveLength(12)\r\n    expect(groups.get(`${rebarRadius('D13')}|hoop`)).toHaveLength(12)\r\n  })\r\n\r\n  it('separates the same display radius by rebar layer', () => {\r\n    const radius = rebarRadius('D25')\r\n    const instances: RebarInstance[] = [\r\n      {\r\n        memberId: 'main',\r\n        from: [0, 0, 0],\r\n        to: [0, 1, 0],\r\n        radius,\r\n        size: 'D25',\r\n        role: '訝사춮',\r\n        layer: 'main',\r\n      },\r\n      {\r\n        memberId: 'hoop',\r\n        from: [0, 0, 0],\r\n        to: [1, 0, 0],\r\n        radius,\r\n        size: 'D25',\r\n        role: '躍?춮',\r\n        layer: 'hoop',\r\n      },\r\n    ]\r\n\r\n    const groups = groupInstancesByLayerAndRadius(instances)\r\n\r\n    expect([...groups.keys()]).toEqual([\r\n      `${radius}|main`,\r\n      `${radius}|hoop`,\r\n    ])\r\n  })\r\n})\r\n\r\ndescribe('RebarInstance.size', () => {\r\n  it('carries the ?쇈겞??so the exporter can use the real diameter', () => {\r\n    // ?삯씊??radius ??き?욍굜?쇻걬??걼?곥겓鸚ゃ굢?쎼걼烏①ㅊ?ㅳ걽 (rebarRadius)??\r\n    // ?멥걤?뷩걲與▼엹?㎯걹?뚣굮鵝욍걝??D10 ???22.4 ??짂?ⓦ걮??륫?뗣걪?ⓦ겓?ゃ굥??\r\n    const layout = buildingLayout(project, [main, hoop], noUnsupportedMembers)\r\n    const sizes = new Set(layout.rebar.map(({ size }) => size))\r\n\r\n    expect(sizes).toEqual(new Set(['D25', 'D13']))\r\n    expect(\r\n      layout.rebar.every(({ size, radius }) => radius === rebarRadius(size)),\r\n    ).toBe(true)\r\n  })\r\n})\r\nimport { describe, expect, it } from 'vitest'\r\n\r\nimport type { Section } from '@/domain/model/member'\r\nimport type { Project } from '@/domain/model/project'\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\n\r\nimport type { TextItem } from '../types'\r\nimport type { TextPage } from '../section-list/types'\r\n\r\nimport { applyElevation, applyFramingPlan } from './apply'\r\nimport { parseFramingPlan } from './parse'\r\nimport type {\r\n  ElevationCandidate,\r\n  PlanBlock,\r\n  PlanGridCandidate,\r\n} from './types'\r\n\r\n// ??씊? ?먯쑝濡?吏볦? ?딄퀬 ?섑뵆 旅덁뻑?먯꽌 鍮뚮┛?????먯쑝濡?吏?쇰㈃ ?ㅽ궎留덇? ?먮씪????\r\n// ???뚯뒪?몃쭔 ??紐⑥뼇?쇰줈 ?④퀬, 洹??ъ떎??vitest???뚮젮二쇱? ?딅뒗??(tsc媛 ?〓뒗??\r\nconst sample = createSampleProject()\r\n\r\nfunction sectionOf(kind: Section['kind'], mark: string): Section {\r\n  const source = sample.sections.find((section) => section.kind === kind)\r\n  if (!source) throw new Error(`sample has no ${kind} section`)\r\n  return { ...source, id: `sec-${mark}`, mark }\r\n}\r\n\r\nfunction sectionWithStory(\r\n  kind: Section['kind'],\r\n  mark: string,\r\n  storyLabel: string | undefined,\r\n  id = `sec-${mark}-${storyLabel ?? 'none'}`,\r\n): Section {\r\n  return { ...sectionOf(kind, mark), id, storyLabel }\r\n}\r\n\r\nconst columnSection = (mark: string) => sectionOf('??, mark)\r\nconst girderSection = (mark: string) => sectionOf('鸚㎪쥈', mark)\r\n\r\nfunction h(str: string, x: number, y: number): TextItem {\r\n  return { str, x, y, w: 0, h: 8 }\r\n}\r\n\r\nfunction v(str: string, x: number, y: number): TextItem {\r\n  return { str, x, y, w: 8, h: 0, rot: -90 }\r\n}\r\n\r\nfunction framingItems(\r\n  xSpanMm: number,\r\n  ySpanMm: number,\r\n  xOffsetPt = 0,\r\n): TextItem[] {\r\n  return [\r\n    h('X1', xOffsetPt, -40),\r\n    h('X2', xOffsetPt + 200, -40),\r\n    h(String(xSpanMm), xOffsetPt + 100, -20),\r\n    h('Y1', xOffsetPt - 40, 0),\r\n    h('Y2', xOffsetPt - 40, 200),\r\n    v(String(ySpanMm), xOffsetPt - 20, 100),\r\n  ]\r\n}\r\n\r\nfunction framingPage(xSpanMm: number, ySpanMm: number): TextPage {\r\n  return {\r\n    widthPt: 1000,\r\n    heightPt: 1000,\r\n    items: framingItems(xSpanMm, ySpanMm),\r\n  }\r\n}\r\n\r\nfunction project(overrides: Partial<Project> = {}): Project {\r\n  return {\r\n    schemaVersion: 11,\r\n    name: 'test',\r\n    grid: { xSpans: [6000], ySpans: [6000] },\r\n    stories: [{ id: 'story-1', name: '1F', height: 4000 }],\r\n    sections: [],\r\n    members: [],\r\n    ...overrides,\r\n  }\r\n}\r\n\r\nconst xGrid: PlanGridCandidate = {\r\n  direction: 'X',\r\n  axes: [\r\n    { label: 'X1', positionPt: 0 },\r\n    { label: 'X2', positionPt: 200 },\r\n    { label: 'X3', positionPt: 400 },\r\n  ],\r\n  spansMm: [7000, 7000],\r\n  scalePtPerMm: 200 / 7000,\r\n  totalConfirmed: false,\r\n}\r\n\r\nconst yGrid: PlanGridCandidate = {\r\n  direction: 'Y',\r\n  axes: [\r\n    { label: 'Y1', positionPt: 0 },\r\n    { label: 'Y2', positionPt: 200 },\r\n  ],\r\n  spansMm: [5000],\r\n  scalePtPerMm: 200 / 5000,\r\n  totalConfirmed: false,\r\n}\r\n\r\nfunction block(overrides: Partial<PlanBlock> = {}): PlanBlock {\r\n  return {\r\n    xGrid,\r\n    yGrid,\r\n    placements: [],\r\n    unplacedMarks: [],\r\n    ...overrides,\r\n  }\r\n}\r\n\r\ndescribe('applyFramingPlan', () => {\r\n  it('?뚣걯寧?뤇??뼪?㏂걣筽뉑빊?롢겓?귙굦?곈쉸?뉐츣?ゃ걮?㎩룏?졼걮?ゃ걚', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', '1??),\r\n          sectionWithStory('??, 'C1', '2??),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([\r\n      { mark: 'C1', reason: '??씊筽뉑빊屋꿨퐪' },\r\n    ])\r\n  })\r\n\r\n  it('??씊??쉸?⒲깧?ャ굮?녑칳?ユ뙁若싥걲?뚣겙屋꿨퐪?쇻굥??씊?졼걨?믣룏?졼걲??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', '1??),\r\n          sectionWithStory('??, 'C1', '2??),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(1)\r\n    expect(result.project.members[0]?.sectionId).toBe('sec-C1-2??)\r\n  })\r\n\r\n  it('?뉐츣?쀣걼?롢꺀?쇻꺂??뼪?㏂걣?ゃ걨?뚣겙?ょ쇉?꿔겏?쀣겍餘뗣걲', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [sectionWithStory('??, 'C1', '1??)],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '3??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '??씊?ょ쇉?? }])\r\n  })\r\n\r\n  it('?뚣걯寧?뤇?ⓨ릪?섌쉸?⒲깧?ャ겗?띹쨭??씊?귡겦?밤겒??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', '2??, 'sec-C1-2??a'),\r\n          sectionWithStory('??, 'C1', '2??, 'sec-C1-2??b'),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([\r\n      { mark: 'C1', reason: '??씊筽뉑빊屋꿨퐪' },\r\n    ])\r\n  })\r\n\r\n  it('?롢꺀?쇻꺂?믤?誤뤷뙑?쎼걳?잍뻼?⒲걡?듽겓驪붻펱?쇻굥', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [sectionWithStory('??, 'C1', '2??)],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2F',\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '??씊?ょ쇉?? }])\r\n  })\r\n\r\n  it('?롢꺀?쇻꺂???녿뒗 ?⑤㈃? 吏?뺣맂 痢듭쓽 ?꾨낫濡?痍④툒?섏? ?딅뒗??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('??, 'C1', undefined, 'sec-C1-no-story'),\r\n          sectionWithStory('??, 'C1', '2??),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(1)\r\n    expect(result.project.members[0]?.sectionId).toBe('sec-C1-2??)\r\n  })\r\n\r\n  it('?쇱튂?섎뒗 ???쇰꺼???놁쑝硫?臾대씪踰???씊?쇰줈 ?대갚?쒕떎', () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [sectionWithStory('?먬쐡鶯?, 'W1', undefined, 'sec-W1-no-story')],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'W1', role: '渦?, ix: 0, iy: 0, axis: 'X' }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(1)\r\n    expect(result.project.members[0]?.sectionId).toBe('sec-W1-no-story')\r\n  })\r\n\r\n  it('?쇱튂?섎뒗 ???쇰꺼???녾퀬 臾대씪踰???씊???щ윭 媛쒕㈃ ?좏깮?섏? ?딅뒗??, () => {\r\n    const result = applyFramingPlan(\r\n      project({\r\n        sections: [\r\n          sectionWithStory('?먬쐡鶯?, 'W1', undefined, 'sec-W1-no-story-a'),\r\n          sectionWithStory('?먬쐡鶯?, 'W1', undefined, 'sec-W1-no-story-b'),\r\n        ],\r\n      }),\r\n      {\r\n        block: block({\r\n          placements: [{ mark: 'W1', role: '渦?, ix: 0, iy: 0, axis: 'X' }],\r\n        }),\r\n        storyId: 'story-1',\r\n        sectionStoryLabel: '2??,\r\n      },\r\n    )\r\n\r\n    expect(result.applied).toBe(0)\r\n    expect(result.project.members).toEqual([])\r\n    expect(result.skipped).toEqual([{ mark: 'W1', reason: '??씊筽뉑빊屋꿨퐪' }])\r\n  })\r\n\r\n  it('?щ윭 鴉뤷쎋 以???踰덉㎏ 釉붾줉? ??踰덉㎏ ?꾨㈃??X쨌Y ?싥굤??쓣 援щ퀎??痍⑥엯?쒕떎', () => {\r\n    const plans = [framingPage(6000, 5000), framingPage(8000, 7000)].map(\r\n      parseFramingPlan,\r\n    )\r\n    const blocks = plans.flatMap((plan) => plan.blocks)\r\n    if (!blocks[1]) {\r\n      throw new Error('synthetic framing plans were not parsed')\r\n    }\r\n\r\n    const result = applyFramingPlan(project(), {\r\n      block: blocks[1],\r\n      storyId: 'story-1',\r\n    })\r\n\r\n    expect(result.project.grid.xSpans).toEqual([8000])\r\n    expect(result.project.grid.ySpans).toEqual([7000])\r\n    expect(result.refusal).toBeUndefined()\r\n    expect(result.skipped).toEqual([])\r\n  })\r\n\r\n  it('???섏씠吏???ㅽ뙩???ㅻⅨ 鴉뤷쎋 ???μ? 媛?釉붾줉??X쨌Y ?싥굤??쑝濡?痍⑥엯?쒕떎', () => {\r\n    const parsed = parseFramingPlan({\r\n      widthPt: 1400,\r\n      heightPt: 1000,\r\n      items: [\r\n        ...framingItems(6000, 5000),\r\n        ...framingItems(8000, 7000, 600),\r\n      ],\r\n    })\r\n\r\n    expect(parsed.blocks).toHaveLength(2)\r\n    expect(parsed.blocks.map((candidate) => candidate.xGrid.spansMm)).toEqual([\r\n      [6000],\r\n      [8000],\r\n    ])\r\n    expect(parsed.blocks.map((candidate) => candidate.yGrid.spansMm)).toEqual([\r\n      [5000],\r\n      [7000],\r\n    ])\r\n\r\n    const appliedGrids = parsed.blocks.map(\r\n      (candidate) =>\r\n        applyFramingPlan(project(), {\r\n          block: candidate,\r\n          storyId: 'story-1',\r\n        }).project.grid,\r\n    )\r\n    expect(appliedGrids).toEqual([\r\n      {\r\n        xSpans: [6000],\r\n        ySpans: [5000],\r\n        xLabels: ['X1', 'X2'],\r\n        yLabels: ['Y1', 'Y2'],\r\n      },\r\n      {\r\n        xSpans: [8000],\r\n        ySpans: [7000],\r\n        xLabels: ['X1', 'X2'],\r\n        yLabels: ['Y1', 'Y2'],\r\n      },\r\n    ])\r\n  })\r\n\r\n  it('?싥굤??쓣 ?꾨㈃???ㅽ뙩?쇰줈 諛붽씔??, () => {\r\n    const result = applyFramingPlan(project(), {\r\n      block: block(),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.grid).toEqual({\r\n      xSpans: [7000, 7000],\r\n      ySpans: [5000],\r\n      xLabels: ['X1', 'X2', 'X3'],\r\n      yLabels: ['Y1', 'Y2'],\r\n    })\r\n    expect(result.refusal).toBeUndefined()\r\n  })\r\n\r\n  it('?싥굤??쓽 ?대쫫???꾨㈃?먯꽌 ?쎌? ?먮Ц 洹몃?濡??ｋ뒗??, () => {\r\n    // ?닿쾬??R13(塋?깿 醫뚯슦 鍮꾨?移????좉껐 議곌굔?대떎 ???대쫫???덉뼱???꾨㈃??\r\n    // ?똜3塋?폀Y4塋?띿쓣 ?곗쓽 ?ㅼ젣 諛⑺뼢怨?留욎텧 ???덈떎\r\n    const result = applyFramingPlan(project(), {\r\n      block: block(),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\r\n    expect(result.project.grid.yLabels).toEqual(['Y1', 'Y2'])\r\n  })\r\n\r\n  it('?대쫫留??ㅻⅨ 洹몃━?쒕뒗 ?뚮컮?뚯뿀?ㅳ띾줈 蹂댁? ?딅뒗??, () => {\r\n    // ?쇰꺼? ?곈뇧??寃⑹옄 index??諛붽씀吏 ?딅뒗?????대쫫 ?뚮Ц???ㅻⅨ 痢듭쓣 踰꾨━?쇰뒗\r\n    // 臾쇱쓬???⑤㈃ ?ъ슜?먮뒗 ?댁쑀瑜??????녿떎\r\n    const base = project({\r\n      grid: { xSpans: [7000, 7000], ySpans: [5000] },\r\n      sections: [columnSection('C1')],\r\n      members: [\r\n        {\r\n          id: 'm1',\r\n          kind: '??,\r\n          memberClass: '翁?퐪',\r\n          sectionId: 'sec-C1',\r\n          storyId: 'story-2',\r\n          position: { ix: 1, iy: 1 },\r\n        },\r\n      ],\r\n      stories: [\r\n        { id: 'story-1', name: '1F', height: 4000 },\r\n        { id: 'story-2', name: '2F', height: 4000 },\r\n      ],\r\n    })\r\n\r\n    const result = applyFramingPlan(base, {\r\n      block: block(),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.refusal).toBeUndefined()\r\n    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\r\n    expect(result.project.members).toHaveLength(1)\r\n  })\r\n\r\n  it('?ㅻⅨ 痢듭뿉 遺?ш? ?덈뒗???싥굤??씠 諛붾뚮㈃ ?듭㎏濡?嫄곕??쒕떎', () => {\r\n    // 寃⑹옄 index???ㅽ뙩 諛곗뿴??留ㅼ뿬 ?덈떎 ???ㅽ뙩??諛붽씀硫??먮?吏 ?딆? 痢듭쓽\r\n    // 遺?ш? 議곗슜???ㅻⅨ ?먮━濡???꺼媛꾨떎. ???쒗뭹??紐?寃щ뵒???ㅽ뙣??\r\n    const existing = project({\r\n      sections: [columnSection('C1')],\r\n      members: [\r\n        {\r\n          id: 'm1',\r\n          kind: '??,\r\n          memberClass: '翁?퐪',\r\n          sectionId: 'sec-C1',\r\n          storyId: 'story-2',\r\n          position: { ix: 1, iy: 1 },\r\n        },\r\n      ],\r\n      stories: [\r\n        { id: 'story-1', name: '1F', height: 4000 },\r\n        { id: 'story-2', name: '2F', height: 4000 },\r\n      ],\r\n    })\r\n\r\n    const result = applyFramingPlan(existing, {\r\n      block: block(),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.refusal).toBe('餓뽭쉸?ⓩ쓲?귙굤?싥굤??쨯?답툖??)\r\n    expect(result.project).toBe(existing)\r\n  })\r\n\r\n  it('痍⑥엯?섎뒗 痢듭쓽 遺?щ뒗 媛덉븘 ?쇱슫??????踰??뚮윭??寃뱀튂吏 ?딅뒗??, () => {\r\n    const base = project({ sections: [columnSection('C1')] })\r\n    const options = {\r\n      block: block({\r\n        placements: [{ mark: 'C1', role: '?쇔춴?? as const, ix: 1, iy: 1 }],\r\n      }),\r\n      storyId: 'story-1',\r\n    }\r\n\r\n    const once = applyFramingPlan(base, options)\r\n    const twice = applyFramingPlan(once.project, options)\r\n    expect(once.project.members).toHaveLength(1)\r\n    expect(twice.project.members).toHaveLength(1)\r\n    expect(once.applied).toBe(1)\r\n  })\r\n\r\n  it('媛숈? 寃⑹옄?먯뿉??X쨌Y 諛⑺뼢?쇰줈 六쀫뒗 媛숈? 寧?뤇??鸚㎪쥈??紐⑤몢 ?④릿??, () => {\r\n    const result = applyFramingPlan(project({ sections: [girderSection('G1')] }), {\r\n      block: block({\r\n        placements: [\r\n          { mark: 'G1', role: '渦?, ix: 0, iy: 0, axis: 'X' },\r\n          { mark: 'G1', role: '渦?, ix: 0, iy: 0, axis: 'Y' },\r\n        ],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n\r\n    expect(result.applied).toBe(2)\r\n    expect(result.project.members.map((member) => member.position)).toEqual([\r\n      { axis: 'X', ix: 0, iy: 0 },\r\n      { axis: 'Y', ix: 0, iy: 0 },\r\n    ])\r\n  })\r\n\r\n  it('媛숈? 諛⑺뼢??媛숈? 鸚㎪쥈 諛곗튂媛 釉붾줉????踰??ㅼ뼱?ㅻ㈃ ?섎굹濡??묐뒗??, () => {\r\n    const placement = {\r\n      mark: 'G1',\r\n      role: '渦? as const,\r\n      ix: 0,\r\n      iy: 0,\r\n      axis: 'X' as const,\r\n    }\r\n    const result = applyFramingPlan(project({ sections: [girderSection('G1')] }), {\r\n      block: block({ placements: [placement, placement] }),\r\n      storyId: 'story-1',\r\n    })\r\n\r\n    expect(result.applied).toBe(1)\r\n    expect(result.project.members).toHaveLength(1)\r\n  })\r\n\r\n  it('?쇔춴?뱀쓽 ?깅? ColumnPosition?쇰줈 ?ｋ뒗??, () => {\r\n    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\r\n      block: block({\r\n        placements: [{ mark: 'C1', role: '?쇔춴??, ix: 2, iy: 1 }],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.members).toEqual([\r\n      {\r\n        id: 'story-1-C1-2-1',\r\n        kind: '??,\r\n        memberClass: '翁?퐪',\r\n        sectionId: 'sec-C1',\r\n        storyId: 'story-1',\r\n        position: { ix: 2, iy: 1 },\r\n      },\r\n    ])\r\n  })\r\n\r\n  it('渦븐쓽 鸚㎪쥈瑜?GirderPosition?쇰줈 ?ｋ뒗????axis瑜?洹몃?濡???릿??, () => {\r\n    const result = applyFramingPlan(project({ sections: [girderSection('G1')] }), {\r\n      block: block({\r\n        placements: [{ mark: 'G1', role: '渦?, ix: 0, iy: 1, axis: 'X' }],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.members[0]?.position).toEqual({\r\n      axis: 'X',\r\n      ix: 0,\r\n      iy: 1,\r\n    })\r\n  })\r\n\r\n  it('??씊訝誤㏃뿉 ?녿뒗 寧?뤇? ?ｌ? ?딄퀬 ?ъ쑀? ?④퍡 ?④릿??, () => {\r\n    const result = applyFramingPlan(project(), {\r\n      block: block({\r\n        placements: [{ mark: 'C9', role: '?쇔춴??, ix: 0, iy: 0 }],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.members).toEqual([])\r\n    expect(result.skipped).toEqual([{ mark: 'C9', reason: '??씊?ょ쇉?? }])\r\n  })\r\n\r\n  it('葉?닪怨??먮━媛 ?닿툔?섎㈃ ?ｌ? ?딅뒗?????깅? 渦븐뿉 ?볦? ?딅뒗??, () => {\r\n    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\r\n      block: block({\r\n        placements: [{ mark: 'C1', role: '渦?, ix: 0, iy: 0, axis: 'X' }],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.members).toEqual([])\r\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '?ⓩ쓲葉?닪?면걬' }])\r\n  })\r\n\r\n  it('寃⑹옄 諛뽰쓣 媛由ы궎??諛곗튂???ｌ? ?딅뒗??, () => {\r\n    // ?꾨㈃???싥굤???섏? 痍⑥엯?섎뒗 洹몃━?쒓? ?닿툔??寃쎌슦 ??吏?대궡吏 ?딅뒗??\r\n    const result = applyFramingPlan(project({ sections: [columnSection('C1')] }), {\r\n      block: block({\r\n        placements: [{ mark: 'C1', role: '?쇔춴??, ix: 3, iy: 0 }],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.members).toEqual([])\r\n    expect(result.skipped).toEqual([{ mark: 'C1', reason: '?쇔춴鸚? }])\r\n  })\r\n\r\n  it('Y?밧릲??渦븐씠 留덉?留?Y?쇔춴?뱀뿉??六쀬쑝硫??쇔춴鸚뽯줈 ?④릿??, () => {\r\n    const result = applyFramingPlan(project({ sections: [girderSection('G1')] }), {\r\n      block: block({\r\n        placements: [{ mark: 'G1', role: '渦?, ix: 0, iy: 1, axis: 'Y' }],\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.project.members).toEqual([])\r\n    expect(result.skipped).toEqual([{ mark: 'G1', reason: '?쇔춴鸚? }])\r\n  })\r\n\r\n  it('?녿뒗 痢듭쓣 媛由ы궎硫??듭㎏濡?嫄곕??쒕떎', () => {\r\n    const base = project()\r\n    const result = applyFramingPlan(base, {\r\n      block: block(),\r\n      storyId: 'story-9',\r\n    })\r\n    expect(result.refusal).toBe('?롦쑋?뉐츣')\r\n    expect(result.project).toBe(base)\r\n  })\r\n})\r\n\r\ndescribe('applyFramingPlan ???ㅻⅨ 痢듭쓣 踰꾨━???숈쓽', () => {\r\n  const existing = () =>\r\n    project({\r\n      sections: [columnSection('C1')],\r\n      members: [\r\n        {\r\n          id: 'm1',\r\n          kind: '??,\r\n          memberClass: '翁?퐪',\r\n          sectionId: 'sec-C1',\r\n          storyId: 'story-2',\r\n          position: { ix: 1, iy: 1 },\r\n        },\r\n      ],\r\n      stories: [\r\n        { id: 'story-1', name: '1F', height: 4000 },\r\n        { id: 'story-2', name: '2F', height: 4000 },\r\n      ],\r\n    })\r\n\r\n  it('?숈쓽?섎㈃ ?ㅻⅨ 痢?遺?щ? ?④린吏 ?딄퀬 ?듭㎏濡?踰꾨┛??, () => {\r\n    const result = applyFramingPlan(existing(), {\r\n      block: block({\r\n        placements: [{ mark: 'C1', role: '?쇔춴??, ix: 1, iy: 1 }],\r\n      }),\r\n      storyId: 'story-1',\r\n      discardOtherStories: true,\r\n    })\r\n    expect(result.refusal).toBeUndefined()\r\n    // 諛섏? ??꺼 ?볥뒓??鍮꾩슫?????④린硫?index媛 ?ㅻⅨ ?먮━瑜?媛由ы궓??\r\n    expect(result.project.members.map((member) => member.storyId)).toEqual([\r\n      'story-1',\r\n    ])\r\n  })\r\n\r\n  it('?싥굤??씠 洹몃?濡쒕㈃ ?숈쓽 ?놁씠???ㅻⅨ 痢듭쓣 嫄대뱶由ъ? ?딅뒗??, () => {\r\n    const base = existing()\r\n    const result = applyFramingPlan(base, {\r\n      block: block({\r\n        xGrid: { ...xGrid, spansMm: base.grid.xSpans },\r\n        yGrid: { ...yGrid, spansMm: base.grid.ySpans },\r\n      }),\r\n      storyId: 'story-1',\r\n    })\r\n    expect(result.refusal).toBeUndefined()\r\n    expect(result.project.members).toHaveLength(1)\r\n  })\r\n})\r\n\r\ndescribe('applyElevation', () => {\r\n  // ?꾨㈃ ?쒖꽌???꾩뿉???꾨옒?? ?ㅻЪ yokohama p8????紐⑥뼇?대떎 ??\r\n  // 留??꾨뒗 ?쇰꺼???녿뒗 ?묆꺀?싥긿??泥쒕떒?닿퀬, 洹??꾨옒濡?RCL쨌2FL쨌1FL쨌?븀쨴訝뗧ク?대떎.\r\n  const candidate: ElevationCandidate = {\r\n    titles: ['bY1?싥굤邕며탡??/100'],\r\n    levels: [\r\n      { labels: [], positionPt: 159 },\r\n      { labels: ['訝?ㄾ汝웂CL(麗답툔)'], positionPt: 199 },\r\n      { labels: ['2FL'], positionPt: 315 },\r\n      { labels: ['訝?ㄾ汝?FL', '?뷸틬GL'], positionPt: 442 },\r\n      { labels: ['?븀쨴訝뗧ク'], positionPt: 518 },\r\n    ],\r\n    heightsMm: [1400, 4100, 4480, 2690],\r\n    scalePtPerMm: 0.02835,\r\n  }\r\n\r\n  it('怨좊Ⅸ 踰붿쐞??媛꾧꺽留??롪? ?섍퀬, ?꾨옒?먯꽌 ?꾨줈 ?볦씤??, () => {\r\n    // 1FL(3)?먯꽌 RCL(1)源뚯? ??1??4480)? 2??4100). ?묆꺀?싥긿??1400)?\r\n    // ?븀쨴(2690)???롪? ?꾨땲誘濡?踰붿쐞 諛뽰씠??\r\n    const result = applyElevation(project(), {\r\n      candidate,\r\n      topLevelIndex: 1,\r\n      bottomLevelIndex: 3,\r\n    })\r\n    expect(result.refusal).toBeUndefined()\r\n    expect(result.project.stories.map((story) => story.height)).toEqual([\r\n      4480, 4100,\r\n    ])\r\n  })\r\n\r\n  it('?롮쓽 ?대쫫? 洹??롮쓽 諛붾떏???섎뒗 ?덈꺼???먮Ц?대떎', () => {\r\n    const result = applyElevation(project(), {\r\n      candidate,\r\n      topLevelIndex: 1,\r\n      bottomLevelIndex: 3,\r\n    })\r\n    // 媛숈? ?믪씠???쇰꺼???섏씠硫??????④릿?????섎굹瑜?怨좊Ⅴ吏 ?딅뒗??\r\n    expect(result.project.stories.map((story) => story.name)).toEqual([\r\n      '訝?ㄾ汝?FL竊뤷읃繹뺾L',\r\n      '2FL',\r\n    ])\r\n  })\r\n\r\n  it('?쇰꺼???녿뒗 ?덈꺼??諛붾떏?대㈃ ?대쫫??吏?대궡吏 ?딄퀬 踰덊샇濡??붾떎', () => {\r\n    const result = applyElevation(project(), {\r\n      candidate,\r\n      topLevelIndex: 0,\r\n      bottomLevelIndex: 1,\r\n    })\r\n    expect(result.project.stories.map((story) => story.name)).toEqual([\r\n      '訝?ㄾ汝웂CL(麗답툔)',\r\n    ])\r\n  })\r\n\r\n  it('踰붿쐞媛 ??移몃룄 ?놁쑝硫?嫄곕??쒕떎', () => {\r\n    const base = project()\r\n    const result = applyElevation(base, {\r\n      candidate,\r\n      topLevelIndex: 2,\r\n      bottomLevelIndex: 2,\r\n    })\r\n    expect(result.refusal).toBe('?롧칱?꿜툖閭?)\r\n    expect(result.project).toBe(base)\r\n  })\r\n\r\n  it('遺?ш? ?덉쑝硫??듭㎏濡?嫄곕??쒕떎 ???롫? 媛덈㈃ 遺?ш? 媛?怨녹쓣 ?껊뒗??, () => {\r\n    const base = project({\r\n      sections: [columnSection('C1')],\r\n      members: [\r\n        {\r\n          id: 'm1',\r\n          kind: '??,\r\n          memberClass: '翁?퐪',\r\n          sectionId: 'sec-C1',\r\n          storyId: 'story-1',\r\n          position: { ix: 0, iy: 0 },\r\n        },\r\n      ],\r\n    })\r\n    const result = applyElevation(base, {\r\n   