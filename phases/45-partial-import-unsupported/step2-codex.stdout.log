{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/lib/hooks/useTakeoff.ts; Get-Content src/lib/hooks/useTakeoff.test.tsx; Get-Content tests/drawing-set/apply.test.ts'","aggregated_output":"'use client'\r\n\r\nimport { useMemo } from 'react'\r\n\r\nimport type { Rebar } from '@/domain/model/rebar'\r\nimport {\r\n  beamDepthAbove,\r\n  columnEnds,\r\n  findSection,\r\n  girderRun,\r\n  slabRun,\r\n  storyNotFound,\r\n  wallSpan,\r\n  type GirderRun,\r\n  type Project,\r\n  type SlabRun,\r\n} from '@/domain/model/project'\r\nimport {\r\n  MemberUnsupportedError,\r\n  type UnsupportedReason,\r\n} from '@/domain/model/unsupported'\r\nimport {\r\n  aggregateQuantity,\r\n  hasUnverified as getHasUnverified,\r\n  inferredRules as getInferredRules,\r\n  unverifiedRules as getUnverifiedRules,\r\n  type QuantityLine,\r\n} from '@/domain/quantity'\r\nimport { generateColumnRebar } from '@/domain/rebar/column'\r\nimport { generateGirderRebar } from '@/domain/rebar/girder'\r\nimport { generateSlabRebar } from '@/domain/rebar/slab'\r\nimport { generateWallRebar } from '@/domain/rebar/wall'\r\nimport type { RuleHit } from '@/domain/rules/types'\r\nimport { useAppStore } from '@/lib/store'\r\nimport { jpMlitRulePack } from '@/rulepack'\r\n\r\nexport interface TakeoffResult {\r\n  rebars: Rebar[]\r\n  lines: QuantityLine[]\r\n  /** `stated` 媛 ?꾨땶 洹쇨굅媛 ?섎굹?쇰룄 ?덈뒗媛 ???뚰꽣留덊겕쨌寃쎄퀬???ㅼ쐞移?(ADR-015) */\r\n  hasUnverified: boolean\r\n  /** ?х쳦濾쒑쮱 ?湲곕텇源뚯? ?ы븿???꾨? */\r\n  unverifiedRules: RuleHit[]\r\n  /** 洹몄쨷 ?먮Ц??媛믪씠 ?꾩삁 ?녿뒗 寃껊쭔 ???붾젅硫뷀듃由ш? ?곕뒗 醫곸? 紐⑸줉 */\r\n  inferredRules: RuleHit[]\r\n  unsupportedMembers: UnsupportedMember[]\r\n}\r\n\r\nexport interface UnsupportedMember {\r\n  memberId: string\r\n  mark: string\r\n  storyName: string\r\n  reason: UnsupportedReason\r\n}\r\n\r\n/**\r\n * `Project`??媛깆떊???뚮쭏???듭㎏濡?援먯껜?섎?濡?李몄“媛 怨?踰꾩쟾?대떎. 吏곸쟾 寃곌낵 ?섎굹留?\r\n * ?ㅺ퀬 ?덉쑝硫?媛숈? 踰꾩쟾??蹂대뒗 紐⑤뱺 ?뚮퉬??TakeoffPane쨌TakeoffActions쨌Viewer3D)媛\r\n * ??踰덉쓽 怨꾩궛???섎닠 ?대떎. `useMemo`留뚯쑝濡쒕뒗 而댄룷?뚰듃留덈떎 ?곕줈 怨꾩궛?쒕떎.\r\n */\r\nlet lastComputed: { project: Project; result: TakeoffResult } | null = null\r\n\r\nfunction computeTakeoff(project: Project): TakeoffResult {\r\n  if (lastComputed !== null && lastComputed.project === project) {\r\n    return lastComputed.result\r\n  }\r\n\r\n  const result = buildTakeoff(project)\r\n  lastComputed = { project, result }\r\n  return result\r\n}\r\n\r\nexport function useTakeoff(): TakeoffResult {\r\n  const project = useAppStore(({ project }) => project)\r\n\r\n  return useMemo(() => computeTakeoff(project), [project])\r\n}\r\n\r\nfunction buildTakeoff(project: Project): TakeoffResult {\r\n  const rebars: Rebar[] = []\r\n  const unsupportedMembers: UnsupportedMember[] = []\r\n  const processedGirderMemberIds = new Set<string>()\r\n  // 佯딀씮??뼶?묆걫?ⓦ겓?γ겗?⒲꺍?믤똻????X ?㎩눇?녷툑?욍겎??Y ??걪?뚣걢?됥걽??\r\n  const processedSlabRunKeys = new Set<string>()\r\n\r\n  for (const member of project.members) {\r\n    if (\r\n      member.kind === '鸚㎪쥈' &&\r\n      processedGirderMemberIds.has(member.id)\r\n    ) {\r\n      continue\r\n    }\r\n\r\n    const section = findSection(project, member.sectionId)\r\n    const story = project.stories.find(({ id }) => id === member.storyId)\r\n    if (!story) {\r\n      throw storyNotFound(member.storyId)\r\n    }\r\n\r\n    if (member.kind === '??) {\r\n      if (section.kind !== '??) {\r\n        throw new Error(`??member references a non-??section: ${member.id}`)\r\n      }\r\n\r\n      // ?깅룄 鸚㎪쥈怨?媛숇떎 ???깅┰ 遺덇? ?뺤긽? 洹?遺?щ쭔 鍮쇨퀬 怨꾩냽?쒕떎.\r\n      try {\r\n        rebars.push(\r\n          ...generateColumnRebar(\r\n            {\r\n              member,\r\n              section,\r\n              story,\r\n              beamDepthAbove: beamDepthAbove(project, member),\r\n              ends: columnEnds(project, member),\r\n            },\r\n            jpMlitRulePack,\r\n          ),\r\n        )\r\n      } catch (error) {\r\n        if (!(error instanceof MemberUnsupportedError)) throw error\r\n\r\n        unsupportedMembers.push({\r\n          memberId: member.id,\r\n          mark: section.mark,\r\n          storyName: story.name,\r\n          reason: error.reason,\r\n        })\r\n      }\r\n      continue\r\n    }\r\n\r\n    if (member.kind === '佯딀씮') {\r\n      if (section.kind !== '佯딀씮') {\r\n        throw new Error(`佯딀씮 member references a non-佯딀씮 section: ${member.id}`)\r\n      }\r\n\r\n      // 佯딀씮??X?밧릲?팢?밧릲?㎩닪?끹겗?⒲꺍?ャ겒?뗣귛ㄷ歟곥겏?뚣걯?뤵꺀?녈걫?ⓦ겓1?욁걽??\r\n      // ?잍닇?쀣곫닇塋뗣걮?ゃ걚野멩퀡?삣츣???걹??꺀?녑뀲鵝볝굮?썬겏?쀣겍泳싥걨?뗣?\r\n      for (const axis of ['X', 'Y'] as const) {\r\n        if (processedSlabRunKeys.has(`${axis}|${member.id}`)) continue\r\n\r\n        let run: SlabRun | undefined\r\n        try {\r\n          run = slabRun(project, member, axis)\r\n          for (const runMember of run.members) {\r\n            processedSlabRunKeys.add(`${axis}|${runMember.id}`)\r\n          }\r\n\r\n          rebars.push(\r\n            ...generateSlabRebar({ run, section }, jpMlitRulePack),\r\n          )\r\n        } catch (error) {\r\n          if (!(error instanceof MemberUnsupportedError)) throw error\r\n\r\n          for (const runMember of run?.members ?? [member]) {\r\n            processedSlabRunKeys.add(`${axis}|${runMember.id}`)\r\n            unsupportedMembers.push({\r\n              memberId: runMember.id,\r\n              mark: section.mark,\r\n              storyName: story.name,\r\n              reason: error.reason,\r\n            })\r\n          }\r\n        }\r\n      }\r\n      continue\r\n    }\r\n\r\n    if (member.kind === '?먬쐡鶯?) {\r\n      if (section.kind !== '?먬쐡鶯?) {\r\n        throw new Error(\r\n          `?먬쐡鶯?member references a non-?먬쐡鶯?section: ${member.id}`,\r\n        )\r\n      }\r\n\r\n      // ?긱꺕鸚㎪쥈?ⓨ릪?섉돮?????먪쳦?쀣겒?꾢?力뺛겘?앫겗鶯곥걽?묋맼?ⓦ걮??텥?묆굥??\r\n      try {\r\n        rebars.push(\r\n          ...generateWallRebar(\r\n            { member, section, span: wallSpan(project, member) },\r\n            jpMlitRulePack,\r\n          ),\r\n        )\r\n      } catch (error) {\r\n        if (!(error instanceof MemberUnsupportedError)) throw error\r\n\r\n        unsupportedMembers.push({\r\n          memberId: member.id,\r\n          mark: section.mark,\r\n          storyName: story.name,\r\n          reason: error.reason,\r\n        })\r\n      }\r\n      continue\r\n    }\r\n\r\n    if (section.kind !== '鸚㎪쥈') {\r\n      throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${member.id}`)\r\n    }\r\n\r\n    // 鸚㎪쥈? ?곕쭏????踰덈쭔 ?앹꽦?쒕떎. ?깅┰ 遺덇? ?뺤긽(若싩?쨌野멩퀡)?대㈃ ??\r\n    // ?꾩껜瑜?鍮쇨퀬 ?섎㉧吏 ?곌낵 ???곗젙??怨꾩냽?쒕떎.\r\n    // MemberUnsupportedError留??〓뒗????猷고뙥 怨듬갚 媛숈? 寃고븿? 洹몃?濡??곗쭊??\r\n    let run: GirderRun | undefined\r\n    try {\r\n      run = girderRun(project, member)\r\n      for (const runMember of run.members) {\r\n        processedGirderMemberIds.add(runMember.id)\r\n      }\r\n\r\n      rebars.push(\r\n        ...generateGirderRebar(\r\n          { run, section },\r\n          jpMlitRulePack,\r\n        ),\r\n      )\r\n    } catch (error) {\r\n      if (!(error instanceof MemberUnsupportedError)) throw error\r\n\r\n      const unsupportedRunMembers = run?.members ?? [member]\r\n      for (const runMember of unsupportedRunMembers) {\r\n        processedGirderMemberIds.add(runMember.id)\r\n\r\n        const runSection = findSection(project, runMember.sectionId)\r\n        const runStory = project.stories.find(\r\n          ({ id }) => id === runMember.storyId,\r\n        )\r\n        if (runSection.kind !== '鸚㎪쥈') {\r\n          throw new Error(\r\n            `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${runMember.id}`,\r\n          )\r\n        }\r\n        if (!runStory) {\r\n          throw storyNotFound(runMember.storyId)\r\n        }\r\n\r\n        unsupportedMembers.push({\r\n          memberId: runMember.id,\r\n          mark: runSection.mark,\r\n          storyName: runStory.name,\r\n          reason: error.reason,\r\n        })\r\n      }\r\n    }\r\n  }\r\n\r\n  const lines = aggregateQuantity(project, rebars, jpMlitRulePack)\r\n\r\n  return {\r\n    rebars,\r\n    lines,\r\n    hasUnverified: getHasUnverified(lines),\r\n    unverifiedRules: getUnverifiedRules(lines),\r\n    inferredRules: getInferredRules(lines),\r\n    unsupportedMembers,\r\n  }\r\n}\r\nimport { renderHook } from '@testing-library/react'\r\nimport { beforeEach, describe, expect, it } from 'vitest'\r\n\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport { girderRun, gridPointCount } from '@/domain/model/project'\r\nimport { useAppStore } from '@/lib/store'\r\n\r\nimport { useTakeoff } from './useTakeoff'\r\n\r\ndescribe('useTakeoff', () => {\r\n  beforeEach(() => {\r\n    useAppStore.setState({ project: createSampleProject() })\r\n  })\r\n\r\n  it('derives one ?싥걮嶺?pair per run and ?귙겙?됬춮 per member', () => {\r\n    // 醫낆쟾 ?뚯뒪?몃뒗 ?ｇ텥?밤깙??Y鸚㎪쥈??誘몄???紐⑸줉???ㅼ뼱媛?붿? 蹂댁쬆?덈떎.\r\n    // ?댁젣 媛숈? ?섑뵆 ?뺤긽???좎???梨?Y諛⑺뼢 ?곕룄 ?싥걮嶺뗭쑝濡??곗젙?섍퀬,\r\n    // ?곗젙 ?⑥쐞媛 遺?ш? ?꾨땲???곗쑝濡?諛붾뚯뿀?뚯쓣 ???섎줈 蹂댁쬆?쒕떎.\r\n    const { result } = renderHook(() => useTakeoff())\r\n    const project = useAppStore.getState().project\r\n    const { nx, ny } = gridPointCount(project.grid)\r\n    const columnsPerStory = nx * ny\r\n    const xGirderIds = new Set(\r\n      project.members\r\n        .filter(\r\n          (member) =>\r\n            member.kind === '鸚㎪쥈' &&\r\n            'axis' in member.position &&\r\n            member.position.axis === 'X',\r\n        )\r\n        .map(({ id }) => id),\r\n    )\r\n    const girderLines = result.current.lines.filter(\r\n      ({ memberKind }) => memberKind === '鸚㎪쥈',\r\n    )\r\n    const firstStoryG1Lines = girderLines.filter(\r\n      ({ storyName, mark }) => storyName === '1?? && mark === 'G1',\r\n    )\r\n    const firstStoryGirderLines = girderLines.filter(\r\n      ({ storyName }) => storyName === '1??,\r\n    )\r\n    const firstStoryColumnLines = result.current.lines.filter(\r\n      ({ storyName, memberKind }) =>\r\n        storyName === '1?? && memberKind === '??,\r\n    )\r\n\r\n    expect(result.current.rebars.length).toBeGreaterThan(0)\r\n    expect(result.current.lines.length).toBeGreaterThan(0)\r\n    // ?섆? ?ㅽ뙩 ??2媛쒖? 2?ㅽ뙩 ??1媛쒓? 留뚮뱶????援ъ꽦??洹몃?濡?諛뺣뒗??\r\n    // ?귙겙?됬춮쨌亮끾??곭춮쨌?밭춮? X쨌Y ?ㅽ뙩 ?끾퀡??媛숈븘 媛곴컖 ???됱쑝濡?臾띠씠怨?\r\n    // places濡??몄뼱吏꾨떎 ??????遺??歟?留덈떎 ?앷린??諛곌렐?대씪 ?곗쑝濡?臾띠씠吏 ?딅뒗??\r\n    // 泳숁뎸 ??嶸뉑?)? ?섆? ?ㅽ뙩 ?곗뿉??遺숇뒗?????섊떖歟곸씠??1?싧뎴4)濡??뚯븘媛?붾뜲\r\n    // ?섉쎊?믣츣? ?③빓??5.3.4(5)(節?(a)??L1 ?섑븳??諛쏆쑝硫댁꽌 D25 ?싥걮嶺뗭씠 7.2m媛\r\n    // ?섏뼱 7.0m瑜??섍릿??1?뗦?). 2?ㅽ뙩 ?곗? ?ｇ텥歟곸씠??竊덌폆竊됪쥈2)??11.2m 竊?2?뗦?.\r\n    expect(firstStoryG1Lines.map(({ role, unit }) => `${role}/${unit}`)).toEqual([\r\n      '訝딁ク嶺?kg',\r\n      '訝딁ク嶺?嶸뉑?',\r\n      '訝뗧ク嶺?kg',\r\n      '訝뗧ク嶺?嶸뉑?',\r\n      '?귙겙?됬춮/kg',\r\n      '亮끾??곭춮/kg',\r\n      '?밭춮/kg',\r\n      '訝딁ク嶺?kg',\r\n      '訝딁ク嶺?嶸뉑?',\r\n      '訝뗧ク嶺?kg',\r\n      '訝뗧ク嶺?嶸뉑?',\r\n    ])\r\n    // ?섑뵆 1痢? X ?⑥씪 ?ㅽ뙩 ??3 + Y 2?ㅽ뙩 ??2 = 5??\r\n    // 媛숈? 湲몄씠쨌寧?뤇??QuantityLine ???됱쑝濡?臾띠씪 ???덉쑝誘濡?places ?⑹쑝濡?\r\n    // ?싥걮嶺뗭? ???? ?귙겙?됬춮? ?ㅼ젣 遺????3 + 2횞2 = 7)瑜?寃?고븳??\r\n    // 嶸뉑? ?됱? 媛숈? 壤밧돯濡??곕줈 ?쒕?濡?蘊ら뇧 ?됰쭔 ?몄뼱?????섍? ?쒕떎.\r\n    const firstStoryGirderMassLines = firstStoryGirderLines.filter(\r\n      ({ unit }) => unit === 'kg',\r\n    )\r\n    expect(\r\n      firstStoryGirderMassLines\r\n        .filter(({ role }) => role === '訝딁ク嶺?)\r\n        .reduce((sum, { places }) => sum + places, 0),\r\n    ).toBe(5)\r\n    expect(\r\n      firstStoryGirderMassLines\r\n        .filter(({ role }) => role === '訝뗧ク嶺?)\r\n        .reduce((sum, { places }) => sum + places, 0),\r\n    ).toBe(5)\r\n    expect(\r\n      firstStoryGirderMassLines\r\n        .filter(({ role }) => role === '?귙겙?됬춮')\r\n        .reduce((sum, { places }) => sum + places, 0),\r\n    ).toBe(7)\r\n    // ?긴말嶺뗭뿉??泳숁뎸 ?됱씠 遺숇뒗?ㅿ펷竊덌폃竊됪윶2) ?꾦쉸?붵겏???뗦?竊됤??ш린???몃젮??\r\n    // 寃껋? 遺???섏씠誘濡?蘊ら뇧 ?됰쭔 ?쇰떎.\r\n    const firstStoryColumnMassLines = firstStoryColumnLines.filter(\r\n      ({ unit }) => unit === 'kg',\r\n    )\r\n    expect(\r\n      firstStoryColumnMassLines\r\n        .filter(({ role }) => role === '訝사춮')\r\n        .reduce((sum, { places }) => sum + places, 0),\r\n    ).toBe(columnsPerStory)\r\n    expect(\r\n      firstStoryColumnMassLines\r\n        .filter(({ role }) => role === '躍?춮')\r\n        .reduce((sum, { places }) => sum + places, 0),\r\n    ).toBe(columnsPerStory)\r\n    const yOwner = project.members.find(\r\n      ({ id }) => id === '1F-G1-X1Y1-Y',\r\n    )!\r\n    const yRun = girderRun(project, yOwner)\r\n    expect(\r\n      result.current.rebars\r\n        .filter(({ memberId }) => memberId === yRun.ownerId)\r\n        .map(({ role }) => role),\r\n    ).toEqual(['訝딁ク嶺?, '訝뗧ク嶺?, '?귙겙?됬춮', '亮끾??곭춮', '?밭춮'])\r\n    expect(\r\n      yRun.members.every(({ id: memberId }) =>\r\n        result.current.rebars.some(\r\n          (rebar) => rebar.memberId === memberId && rebar.role === '?귙겙?됬춮',\r\n        ),\r\n      ),\r\n    ).toBe(true)\r\n    expect(\r\n      [...xGirderIds].every((memberId) =>\r\n        result.current.rebars.some((rebar) => rebar.memberId === memberId),\r\n      ),\r\n    ).toBe(true)\r\n    expect(result.current.hasUnverified).toBe(true)\r\n    expect(result.current.unverifiedRules.length).toBeGreaterThan(0)\r\n    // kg ?됱? 泳숁뎸 嶸쀥뀯?띸럤(measure.splice.length.factor ???띶?鰲ｉ뇠濡??몄슫 寃껋씠??\r\n    // ?잍뻼???롦뻼???녿떎)???誘濡?異붾줎 洹쇨굅媛 ?⑤뒗?? ?섆퐤蘊ら뇧? schema v6 ?먯꽌\r\n    // 猷고뙥???좊굹 Project.unitMass ?낅젰???먯쑝誘濡????댁긽 ?ш린 愿?ы븯吏 ?딅뒗??\r\n    expect(result.current.inferredRules.length).toBeGreaterThan(0)\r\n  })\r\n\r\n  it('reports every member of an unsupported run and keeps other runs and ??, () => {\r\n    const targetIds = ['1F-G1-X1Y1-Y', '1F-G1-X1Y2-Y']\r\n\r\n    // ??Y諛⑺뼢 2?ㅽ뙩 ?곗뿉留?蹂꾨룄 ?⑤㈃??遺숈뿬 ?귙겙?됬춮 諛곗튂援ш컙??遺덉꽦由쎌떆?⑤떎.\r\n    // 源⑥쭊 ?ㅽ뙩 ?섎굹媛 ?덉쑝硫??싥걮嶺뗪퉴吏 ?앹꽦?섏? ?딆쑝誘濡??곗쓽 ??遺?ш? 紐⑤몢\r\n    // 誘몄??먯씠?댁빞 ?섎ŉ, ?ㅻⅨ ?곌낵 ???곗젙? 怨꾩냽?섏뼱???쒕떎.\r\n    useAppStore.getState().updateProject((project) => {\r\n      const girderSection = project.sections.find(\r\n        ({ id }) => id === 'section-G1',\r\n      )\r\n      if (girderSection?.kind !== '鸚㎪쥈') {\r\n        throw new Error('expected section-G1')\r\n      }\r\n\r\n      return {\r\n        ...project,\r\n        sections: [\r\n          ...project.sections,\r\n          {\r\n            ...girderSection,\r\n            id: 'section-G1-unsupported',\r\n            stirrup: {\r\n              ...girderSection.stirrup,\r\n              startOffsetMm: 3000,\r\n            },\r\n          },\r\n        ],\r\n        members: project.members.map((member) =>\r\n          targetIds.includes(member.id)\r\n            ? { ...member, sectionId: 'section-G1-unsupported' }\r\n            : member,\r\n        ),\r\n      }\r\n    })\r\n\r\n    const { result } = renderHook(() => useTakeoff())\r\n\r\n    const unsupportedTargetIds = result.current.unsupportedMembers\r\n      .filter(\r\n        ({ storyName, reason }) =>\r\n          storyName === '1?? && reason === '野멩퀡訝띷닇塋?,\r\n      )\r\n      .map(({ memberId }) => memberId)\r\n\r\n    expect(unsupportedTargetIds).toEqual(targetIds)\r\n    expect(\r\n      result.current.rebars.some(\r\n        ({ memberId, role }) =>\r\n          memberId === '1F-G2-X2Y1-Y' && role === '訝딁ク嶺?,\r\n      ),\r\n    ).toBe(true)\r\n    expect(result.current.lines.some(({ role }) => role === '訝사춮')).toBe(true)\r\n  })\r\n\r\n  it('keeps a wall with no 訝딃깿鸚㎪쥈 as one unsupported member', () => {\r\n    const source = createSampleProject()\r\n    const wall = source.members.find(({ kind }) => kind === '?먬쐡鶯?)\r\n    const wallPosition = wall?.position\r\n    if (\r\n      wall === undefined ||\r\n      wallPosition === undefined ||\r\n      !('axis' in wallPosition)\r\n    ) {\r\n      throw new Error('sample must contain an edge ?먬쐡鶯?)\r\n    }\r\n\r\n    const missingGirderId = source.members.find(\r\n      (member) =>\r\n        member.kind === '鸚㎪쥈' &&\r\n        member.storyId === wall.storyId &&\r\n        'axis' in member.position &&\r\n        member.position.axis === wallPosition.axis &&\r\n        member.position.ix === wallPosition.ix &&\r\n        member.position.iy === wallPosition.iy,\r\n    )?.id\r\n    if (missingGirderId === undefined) {\r\n      throw new Error('sample must contain a wall-top 鸚㎪쥈')\r\n    }\r\n\r\n    useAppStore.setState({\r\n      project: {\r\n        ...source,\r\n        members: source.members.filter(({ id }) => id !== missingGirderId),\r\n      },\r\n    })\r\n\r\n    const { result } = renderHook(() => useTakeoff())\r\n\r\n    expect(result.current.unsupportedMembers).toContainEqual({\r\n      memberId: wall.id,\r\n      mark: 'W1',\r\n      storyName: '1??,\r\n      reason: '野멩퀡訝띷닇塋?,\r\n    })\r\n    expect(result.current.lines.some(({ memberKind }) => memberKind === '??)).toBe(\r\n      true,\r\n    )\r\n  })\r\n\r\n  it('keeps the other members when a ??turns out unbuildable', () => {\r\n    // 躍?춮 ?앮쐿?ゃ깢?삠긿?덉? ?댁젣 ??씊訝誤??낅젰?대씪 ?ъ슜?먭? 諛곗튂 援ш컙???섍만 ??\r\n    // ?덈떎. 鸚㎪쥈怨?媛숈씠 洹?遺?щ쭔 鍮좎졇???섍퀬, ?섏씤??二쎌쑝硫????쒕떎.\r\n    useAppStore.getState().updateProject((project) => ({\r\n      ...project,\r\n      sections: project.sections.map((section) =>\r\n        section.kind === '??\r\n          ? { ...section, hoop: { ...section.hoop, startOffsetMm: 5000 } }\r\n          : section,\r\n      ),\r\n    }))\r\n\r\n    const { result } = renderHook(() => useTakeoff())\r\n\r\n    expect(\r\n      result.current.unsupportedMembers.some(\r\n        ({ reason }) => reason === '野멩퀡訝띷닇塋?,\r\n      ),\r\n    ).toBe(true)\r\n    expect(result.current.lines.some(({ role }) => role === '訝딁ク嶺?)).toBe(\r\n      true,\r\n    )\r\n  })\r\n\r\n  it('lets a real defect through instead of hiding it as unsupported', () => {\r\n    // 猷고뙥 怨듬갚쨌????꾨컲源뚯? 誘몄??먯쑝濡??≪닔?섎㈃ 寃고븿???붾㈃?먯꽌 ?щ씪吏꾨떎.\r\n    useAppStore.getState().updateProject((project) => ({\r\n      ...project,\r\n      sections: project.sections.map((section) =>\r\n        section.kind === '鸚㎪쥈' ? { ...section, fc: 25 } : section,\r\n      ),\r\n    }))\r\n\r\n    expect(() => renderHook(() => useTakeoff())).toThrow(/not found/i)\r\n  })\r\n\r\n  it('shares one computation across every consumer of the same Project', () => {\r\n    // TakeoffPane 쨌 TakeoffActions 쨌 Viewer3D媛 媛곴컖 ?몄텧?쒕떎. 媛곸옄 怨꾩궛?섎㈃\r\n    // ?낅젰 ??湲?먯뿉 ?뚯씠?꾨씪?몄씠 ??踰??덈떎.\r\n    const first = renderHook(() => useTakeoff())\r\n    const second = renderHook(() => useTakeoff())\r\n\r\n    expect(second.result.current.lines).toBe(first.result.current.lines)\r\n    expect(second.result.current.rebars).toBe(first.result.current.rebars)\r\n  })\r\n\r\n  it('recomputes once the Project is replaced', () => {\r\n    const { result } = renderHook(() => useTakeoff())\r\n    const before = result.current.lines\r\n\r\n    useAppStore\r\n      .getState()\r\n      .updateProject((project) => ({ ...project, name: '?ζ죭餓? }))\r\n\r\n    const after = renderHook(() => useTakeoff()).result.current.lines\r\n\r\n    expect(after).not.toBe(before)\r\n    expect(after).toHaveLength(before.length)\r\n  })\r\n})\r\nimport { readFileSync } from 'node:fs'\r\nimport { describe, expect, it } from 'vitest'\r\nimport { createSampleProject } from '@/domain/model/sample-project'\r\nimport type { Section } from '@/domain/model/member'\r\nimport { applyElevation, applyFramingPlan } from '@/lib/import/framing-plan/apply'\r\nimport { assembleDrawingSet, reconcileAssessments } from '@/lib/import/drawing-set/reconcile'\r\nimport { resolveDrawingSetPlan, type DrawingSetChoices, type DrawingSetPlan } from '@/lib/import/drawing-set/plan'\r\nimport { applyDrawingSet } from '@/lib/import/drawing-set/apply'\r\nimport type { BlockRef, DrawingSetCandidate, DrawingSetPage, PageAssessment } from '@/lib/import/drawing-set/types'\r\n\r\nconst membership = { excludedPages: [], excludedBlocks: [] }\r\nconst key = (r: BlockRef) => `${r.source}#${r.pageNumber}#${r.index}`\r\nfunction pages(set: string): DrawingSetPage[] {\r\n  const g = JSON.parse(readFileSync(`tests/fixtures/drawing-set/expected/${set}.json`, 'utf8')) as { pages: { source: string; pageNumber: number; fixture: string }[] }\r\n  return g.pages.map(p => {\r\n    const f = JSON.parse(readFileSync(`tests/fixtures/section-import/textitems/${p.fixture}.json`, 'utf8'))\r\n    return { source: p.source, pageNumber: p.pageNumber, page: { ...f.page, items: f.items } }\r\n  })\r\n}\r\nfunction choices(c: DrawingSetCandidate): DrawingSetChoices {\r\n  return { reference: { ...c.stories!.reference }, topLevelIndex: 0, bottomLevelIndex: c.stories!.levels.length - 1, discardMembers: true }\r\n}\r\nfunction plan(c: DrawingSetCandidate, ch = choices(c)): DrawingSetPlan {\r\n  const r = resolveDrawingSetPlan(c, ch)\r\n  expect(r).toHaveProperty('plan')\r\n  if (!('plan' in r)) throw new Error(JSON.stringify(r))\r\n  return r.plan\r\n}\r\nfunction synthetic(labels = ['RFL', '2FL', '1FL', 'GL'], titles = ['1?롣폀??, '2?롣폀??]): DrawingSetCandidate {\r\n  const axis = (direction: 'X' | 'Y') => ({ direction, axes: [{ label: `${direction}1`, positionPt: 0 }, { label: `${direction}2`, positionPt: 100 }], spansMm: [4000], scalePtPerMm: 0.025, totalConfirmed: false })\r\n  const a: PageAssessment = { source: 'test.pdf', pageNumber: 1, roles: ['鴉뤷쎋', '邕며탡??], lists: [], grids: [], issues: { plan: [], elevation: [] }, blocks: titles.map(title => ({ title, xGrid: axis('X'), yGrid: axis('Y'), placements: [{ mark: 'C1', role: '?쇔춴??, ix: 0, iy: 0 }], unplacedMarks: [] })), elevations: [{ titles: ['frame'], levels: labels.map((s, positionPt) => ({ labels: [s], positionPt })), heightsMm: labels.slice(1).map(() => 3000), scalePtPerMm: 0.025 }] }\r\n  return reconcileAssessments([a], membership)\r\n}\r\nfunction tsu() {\r\n  const p = pages('tsu'); const all = assembleDrawingSet(p, membership)\r\n  // ??폀??has no story key. Keep p16 included and exclude only its block.\r\n  const excludedBlocks = all.blocks.filter(b => b.ref.pageNumber === 16 && b.block.title?.startsWith('??폀??)).map(b => b.ref)\r\n  expect(excludedBlocks).toHaveLength(1)\r\n  return assembleDrawingSet(p, { excludedPages: [], excludedBlocks })\r\n}\r\n\r\ndescribe('drawing-set plan and apply', () => {\r\n  it('composes the tsu set exactly, creates registered members, forwards section labels and is pure', () => {\r\n    const c = tsu(); const ch = choices(c)\r\n    ch.sectionStoryLabels = { 2: 'selected' }\r\n    const beforeResolve = structuredClone({ c, ch })\r\n    const p = plan(c, ch); const project = createSampleProject()\r\n    expect({ c, ch }).toEqual(beforeResolve)\r\n    const marks = new Map(c.blocks.flatMap(b => b.block.placements.map(m => [m.mark, m.role] as const)))\r\n    project.sections = [...marks].map(([mark, role], i): Section => ({ ...project.sections.find(s => s.kind === (role === '?쇔춴?? ? '?? : role === '渦? ? '鸚㎪쥈' : '佯딀씮'))!, id: `registered-${i}`, mark, storyLabel: 'selected' }))\r\n    // A competing label proves the selected label is actually forwarded.\r\n    project.sections.push(...project.sections.map(s => ({ ...s, id: `${s.id}-other`, storyLabel: 'other' })))\r\n    const before = structuredClone({ c, ch, project, p })\r\n    const result = applyDrawingSet(project, p)\r\n    let manual = applyElevation(project, { candidate: c.stories!.candidate, topLevelIndex: ch.topLevelIndex, bottomLevelIndex: ch.bottomLevelIndex, discardMembers: true }).project\r\n    const created = [...manual.stories]\r\n    for (let i = 0; i < created.length; i++) {\r\n      const levelIndex = ch.bottomLevelIndex - i\r\n      for (const b of p.perStory.filter(b => b.levelIndex === levelIndex)) manual = applyFramingPlan(manual, { block: b.block, storyId: created[i].id, sectionStoryLabel: ch.sectionStoryLabels?.[levelIndex], discardOtherStories: false }).project\r\n    }\r\n    expect(result.project).toEqual(manual)\r\n    expect(result.storiesApplied).toBe(5)\r\n    expect(p.perStory).toHaveLength(1)\r\n    expect(result.project.members.length).toBeGreaterThanOrEqual(1)\r\n    expect(result.project.members.length).toBe(result.perStory.reduce((n, s) => n + ('applied' in s ? s.applied : 0), 0))\r\n    expect(result.perStory.every(s => !('refusal' in s))).toBe(true)\r\n    expect({ c, ch, project, p }).toEqual(before)\r\n    expect(resolveDrawingSetPlan(c, ch)).toEqual({ plan: p })\r\n    expect({ c, ch, project, p }).toEqual(before)\r\n    console.log(JSON.stringify({ equivalence: { set: 'tsu', stories: result.storiesApplied, blocks: p.perStory.length, equal: true }, members_created: result.project.members.length }))\r\n  })\r\n  it('propagates elevation refusal with the original project reference', () => {\r\n    const c = synthetic(); const project = createSampleProject()\r\n    const r = applyDrawingSet(project, plan(c, { ...choices(c), discardMembers: false }))\r\n    expect(r).toEqual({ project, refusal: '?ⓩ쓲?귙굤?롧쉰?쎽툖??, storiesApplied: 0, perStory: [] })\r\n    expect(r.project).toBe(project)\r\n  })\r\n  it('checks missing grid and stories before reference and range', () => {\r\n    const c = synthetic(); const ch = choices(c)\r\n    expect(resolveDrawingSetPlan({ ...c, grid: null }, ch)).toMatchObject({ refusal: '?싥굤??쑋閻뷴츣' })\r\n    const kani = assembleDrawingSet(pages('kani'), membership)\r\n    expect(kani.stories).toBeNull(); expect(kani.grid).not.toBeNull()\r\n    for (const topLevelIndex of [0, -1, NaN]) expect(resolveDrawingSetPlan(kani, { ...ch, topLevelIndex })).toMatchObject({ refusal: '?롦쑋閻뷴츣' })\r\n  })\r\n  it('invalidates choices after an actual yokohama reference switch', () => {\r\n    const p = pages('yokohama')\r\n    const ref = (pageNumber: number) => ({ source: p.find(x => x.pageNumber === pageNumber)!.source, pageNumber, index: 0 })\r\n    const a = assembleDrawingSet(p, membership, ref(8)); const b = assembleDrawingSet(p, membership, ref(9))\r\n    expect(a.stories!.levels).toEqual(b.stories!.levels)\r\n    expect(a.stories!.heightsMm).not.toEqual(b.stories!.heightsMm)\r\n    expect(resolveDrawingSetPlan(b, choices(a))).toMatchObject({ refusal: '?뷸틬訝띴??? })\r\n  })\r\n  it('rejects invalid ranges and manual indices', () => {\r\n    const c = synthetic(); const ch = choices(c)\r\n    for (const [topLevelIndex, bottomLevelIndex] of [[-1, 3], [0, 4], [2, 2], [2, 1], [0.5, 3], [0, NaN]]) expect(resolveDrawingSetPlan(c, { ...ch, topLevelIndex, bottomLevelIndex })).toMatchObject({ refusal: '?롧칱?꿜툖閭? })\r\n    for (const index of [0, 4, 1.5, NaN]) expect(resolveDrawingSetPlan(c, { ...ch, blockStories: { [key(c.blocks[0].ref)]: index } })).toMatchObject({ refusal: '?롧칱?꿜툖閭? })\r\n  })\r\n  it('rejects unmatched blocks and final duplicates, but manual choices win', () => {\r\n    const c = synthetic(); const ch = choices(c)\r\n    const duplicate = resolveDrawingSetPlan(c, { ...ch, blockStories: { [key(c.blocks[1].ref)]: 2 } })\r\n    expect(duplicate).toMatchObject({ refusal: '?よ㎗黎뷩겗?쏁쎗', detail: { conflicts: [{ code: '?롩뇥筽뉎깣??긿??, payload: { levelIndex: 2 } }] } })\r\n    const swapped = plan(c, { ...ch, blockStories: { [key(c.blocks[0].ref)]: 1, [key(c.blocks[1].ref)]: 2 } })\r\n    expect(swapped.perStory.map(s => s.ref.index)).toEqual([1, 0])\r\n    const unknown = synthetic(undefined, ['unknown'])\r\n    expect(resolveDrawingSetPlan(unknown, choices(unknown))).toMatchObject({ refusal: '?롦쑋野얍퓶?뽧꺆?껁궚', detail: { blocks: [unknown.blocks[0].ref] } })\r\n  })\r\n  it('recalculates duplicates and unique matches after user selection', () => {\r\n    const c = synthetic(undefined, ['1?롣폀??, '1?롣폀??])\r\n    expect(c.conflicts[0].code).toBe('?롩뇥筽뉎깣??긿??)\r\n    expect(plan(c, { ...choices(c), blockStories: { [key(c.blocks[1].ref)]: 1 } }).conflicts).toEqual([])\r\n    const repeated = synthetic(['2FL', '1FL', '1FL', 'GL'], ['1?롣폀??])\r\n    expect(repeated.blocks[0].levelIndex).toBeUndefined()\r\n    expect(plan(repeated, { ...choices(repeated), topLevelIndex: 1, bottomLevelIndex: 3 }).perStory[0].levelIndex).toBe(2)\r\n  })\r\n  it('applies identically named stories by floor index, in floor order', () => {\r\n    const c = synthetic(['2FL', '1FL', '1FL', 'GL'], ['first', 'second'])\r\n    c.blocks[1].block.placements[0].ix = 1\r\n    const p = plan(c, { ...choices(c), blockStories: { [key(c.blocks[0].ref)]: 1, [key(c.blocks[1].ref)]: 2 } })\r\n    // Application order comes from actual floors, even if plan entries are shuffled.\r\n    p.perStory.reverse()\r\n    const r = applyDrawingSet(createSampleProject(), p)\r\n    expect(r.perStory).toMatchObject([{ levelIndex: 2, storyName: '1FL', storyId: 'story-2', applied: 1 }, { levelIndex: 1, storyName: '1FL', storyId: 'story-3', applied: 1 }])\r\n    expect(r.project.members.map(m => m.storyId)).toEqual(['story-2', 'story-3'])\r\n    expect(r.project.members.map(m => ({ storyId: m.storyId, ix: m.position.ix }))).toEqual([{ storyId: 'story-2', ix: 1 }, { storyId: 'story-3', ix: 0 }])\r\n    expect(r.perStory.map(s => s.ref.index)).toEqual([1, 0])\r\n  })\r\n  it('preserves information conflicts but refuses a membership grid conflict', () => {\r\n    const c = synthetic()\r\n    const info = { code: '?롦쑋?롩뙯?с깧?? as const, blocking: false as const, evidence: [{ source: 'test.pdf', pageNumber: 1 }], payload: { series: c.stories!.reference, level: 'unknown' } }\r\n    c.conflicts.push(info)\r\n    expect(plan(c).conflicts).toEqual([info])\r\n    c.conflicts.push({ code: '?싥굤??툖訝??, blocking: true, evidence: info.evidence, payload: { blocks: c.blocks.map(b => b.ref) } })\r\n    expect(resolveDrawingSetPlan(c, choices(c))).toMatchObject({ refusal: '?よ㎗黎뷩겗?쏁쎗' })\r\n  })\r\n  it('reports unmapped indices without inventing story IDs', () => {\r\n    const p = plan(synthetic()); p.perStory[0].levelIndex = 99\r\n    const r = applyDrawingSet(createSampleProject(), p)\r\n    expect(r.perStory).toContainEqual({ levelIndex: 99, storyName: p.perStory[0].storyName, ref: p.perStory[0].ref, unmapped: true })\r\n  })\r\n})\r\n","exit_code":0,"status":"completed"}}
