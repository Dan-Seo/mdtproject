m: Array.from({ length: count }, () => 6000), scalePtPerMm: 1 / 60, totalConfirmed: false })\r\n  const block: PlanBlock = { xGrid: axis('X', 2), yGrid: axis('Y', 1), unplacedMarks: [], placements: [\r\n    ...[0, 1, 2].map(ix => ({ mark: 'C1', role: '格子点' as const, ix, iy: 0 })),\r\n    { mark: 'G1', role: '辺', ix: 0, iy: 0, axis: 'X' },\r\n    { mark: 'G2', role: '辺', ix: 1, iy: 0, axis: 'X' },\r\n  ] }\r\n  const result = applyFramingPlan(sample, { block, storyId: sample.stories[0].id, discardOtherStories: true })\r\n  expect(result.refusal).toBeUndefined()\r\n  expect(result.applied).toBe(5)\r\n  expect(result.skipped).toEqual([])\r\n  const project = deserializeProject(JSON.stringify(result.project))\r\n  const girders = project.members.filter(m => m.kind === '大梁')\r\n  for (const member of girders) expect(girderSpan(project, member).clear).toBeGreaterThan(0)\r\n  for (const member of project.members.filter(m => m.kind === '柱')) expect(beamDepthAbove(project, member)).toBeGreaterThan(0)\r\n  const error = plainError(() => girderRun(project, girders[0]))\r\n  expect(error).toContain('大梁 run contains mixed sections:')\r\n  console.log('A1_RESULT ' + JSON.stringify({ error, project }))\r\n})\r\n\r\nit('A6: tsu set composition reaches the missing start support plain error', () => {\r\n  const golden = JSON.parse(readFileSync('tests/fixtures/drawing-set/expected/tsu.json', 'utf8'))\r\n  const pages: DrawingSetPage[] = golden.pages.map((p: { source: string; pageNumber: number; fixture: string }) => {\r\n    const f = JSON.parse(readFileSync(`tests/fixtures/section-import/textitems/${p.fixture}.json`, 'utf8'))\r\n    return { source: p.source, pageNumber: p.pageNumber, page: { ...f.page, items: f.items } }\r\n  })\r\n  const all = assembleDrawingSet(pages, { excludedPages: [], excludedBlocks: [] })\r\n  const excludedBlocks = all.blocks.filter(b => b.ref.pageNumber === 16 && b.block.title?.startsWith('杭伏図')).map(b => b.ref)\r\n  expect(excludedBlocks).toHaveLength(1)\