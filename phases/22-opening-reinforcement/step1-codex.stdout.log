 ${member.id}`)\r\n  }\r\n\r\n  const { ix, iy } = member.position\r\n  const slabAt = (\r\n    candidateIx: number,\r\n    candidateIy: number,\r\n  ): Member | undefined =>\r\n    project.members.find(\r\n      (candidate) =>\r\n        candidate.kind === '佯딀씮' &&\r\n        candidate.storyId === member.storyId &&\r\n        // ?뚥???씊?㎯걗?뗣걪?ⓦ굮?ｇ텥??씉餓뜰겓?쇻굥?귝씉?뉎겘?뚦릪訝??푶??말嶺뗣걣?띲겏\r\n        // 鼇?녴걣?곩푶?뚦릪?섅겎?귙깞?껁긽?뚪걬?덀겙?③깿??뎱嶺뗣걣?싥굥?뤵걨?㎯겘?ゃ걚 ??\r\n        // ??씊?뚦릪?섅걪?ⓦ겘?앫겗?곩늽?▽뻑?㎯걗?ｃ겍?곩쎋?㏂겓?ゃ걚?ｇ텥?믢퐳?됥겒?꾠?\r\n        candidate.sectionId === member.sectionId &&\r\n        isSlabPosition(candidate.position) &&\r\n        candidate.position.ix === candidateIx &&\r\n        candidate.position.iy === candidateIy,\r\n599:export interface SlabRun {\r\n600-  axis: 'X' | 'Y'\r\n601-  /** 軸方向の昇順。単独床板なら長さ1 */\r\n602-  members: Member[]\r\n603-  /** 通し筋を帰属させる部材 ＝ members[0].id */\r\n604-  ownerId: string\r\n605-  /** members と同じ順序 */\r\n606-  bays: SlabBay[]\r\n607-  /**\r\n608-   * ラン原点（始端の大梁の内側面）から各ベイの内法域の始まりまでの距離 (mm)。\r\n609-   * bays と同じ順序で [0] は 0 である。3D がランを1つの枠に描くとき、\r\n610-   * 各ベイの箱をここに置く — 描画側で足し直すと配筋とずれる。\r\n611-   */\r\n612-  memberOffsetsMm: number[]\r\n613-  /** ラン芯長 (mm) ＝ Σ内法長さ ＋ Σ中間大梁の幅 */\r\n614-  coreLengthMm: number\r\n615-  /** 割付方向（主筋と直交する向き）の内法長さ (mm) — ラン内で共通である */\r\n616-  distributionClearMm: number\r\n617-  /** 始端で定着していく大梁 */\r\n618-  startSupport: SlabEdgeSupport\r\n619-  /** 終端で定着していく大梁 */\r\n620-  endSupport: SlabEdgeSupport\r\n621-  /**\r\n622-   * ランに開いている開口部 (1通則8))、**ラン原点からの座標**に直したもの。\r\n623-   *\r\n624-   * 開口はベイ（＝部材）ごとに入力されるが、床板の鉄筋はランで測るので、\r\n625-   * 欠除も3Dの切り欠きもラン座標で見る。ここで一度だけ直しておかないと、\r\n626-   * 数量と表示が別々にベイのオフセットを足し直して食い違う (ADR-029)。\r\n627-   */\r\n628-  openings: Opening[]\r\n629-}\r\n630-\r\n631:export function slabRun(\r\n632-  project: Project,\r\n633-  member: Member,\r\n634-  axis: 'X' | 'Y',\r\n635-): SlabRun {\r\n636-  if (member.kind !== '床板' || !isSlabPosition(member.position)) {\r\n637-    throw new Error(`slabRun requires a