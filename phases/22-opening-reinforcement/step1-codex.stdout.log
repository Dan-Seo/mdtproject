la).toContain('?뗥룭?②뀺鶯곥곫뎸?쇻굤鶯곭춬')\r\n  })\r\n\r\n  it('??Ø嶺뗣겗泳숁뎸?믤쵟?ㅵ풄??빓?뺛겎?겹걟????1?싧뎴4)?뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛?, () => {\r\n    const [full, cut] = rows('與ょ춮')\r\n\r\n    // 5200竊뗥츣? ??6.0m ?믦텏?덀굥?뚣?800 ?믤쵟?뤵겏擁듽걟?ゃ걚??\r\n    expect(full.splice?.countPerBar).toBe(1)\r\n    expect(cut.splice?.countPerBar).toBe(0)\r\n  })\r\n\r\n  it('??0.5?▽빳訝뗣겗?뗥룭?㎬죱?믣늽?묆걳?곫쵟?ㅳ걮?ゃ걢?ｃ걼?볝겏?믥츞?뷴폀?ユ쎑??, () => {\r\n    const small = {\r\n      ...member,\r\n      openings: [{ ...opening, widthMm: 700, heightMm: 700 }],\r\n    }\r\n    const vertical = rows('潁?춮', small)\r\n\r\n    expect(vertical).toHaveLength(1)\r\n    expect(vertical[0].count).toBe(27 * 2)\r\n    expect(vertical[0].formula).toContain('700횞700')\r\n    expect(vertical[0].formula).toContain('0.5?▽빳訝?)\r\n  })\r\n\r\n  it('??죱?붵겏??3D ??를?념퐤營?굮?녴걨?????뚣걯?닸??ヤ틠佯?룒?뗣겒??, () => {\r\n    const [full, cut] = rows('潁?춮')\r\n    const fullAt = full.placement?.positionsMm ?? []\r\n    const cutAt = cut.placement?.positionsMm ?? []\r\n\r\n    expect(cutAt).toEqual([2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600])\r\n    expect(fullAt).toHaveLength(19)\r\n    expect(new Set([...fullAt, ...cutAt]).size).toBe(27)\r\n    // positionCount ??빊?뤵겗?ф빊?㎯겘?ゃ걦?뤵걦?ф빊??(ADR-019)??\r\n    expect(full.placement?.positionCount).toBe(19)\r\n  })\r\n\r\n  it('??뼀?ｃ걣?ゃ걨?뚣겙訝╉겧?밤굮鸚됥걟?ゃ걚 ???앮쐿?ゃ깢?삠긿?덀겗?얇겲?㎯걗??, () => {\r\n    const vertical = rows('潁?춮', member)\r\n\r\n    expect(vertical).toHaveLength(1)\r\n    expect(vertical[0].placement?.positionsMm).toBeUndefined()\r\n    expect(vertical[0].placement?.startOffsetMm).toBe(100)\r\n  })\r\n\r\n  it('??쵟?ㅳ겗?뷴끂?믦죱??졊?졼겓雍됥걵??, () => {\r\n    const [, cut] = rows('潁?춮')\r\n\r\n    expect(cut.ruleHits.map(({ key }) => key)).toContain(\r\n      'measure.opening.deduction.minimum.area',\r\n    )\r\n    expect(cut.formula).toContain('1?싧뎴8)')\r\n  })\r\n\r\n  it('??3D 永뚩러?믤쵟?뗣걵?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝', () => {\r\n    const [, cut] = rows('潁?춮')\r\n\r\n    // points ??뼀?ｃ굮?γ굢?ゃ걚?③빓??탪瓮?겎?곮〃鹽븅깿??Member.openi