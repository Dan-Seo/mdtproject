準 1通則4)・（２）柱2)・（３）梁2))。\r\n87- *\r\n88- * **位置は持たない。** 継手位置を定める表5.3.3 は原文で画像であり転写できていない\r\n89- * (docs/M0-FINDINGS.md) — 位置のない継手は数量にしか現れないので、3D は\r\n90- * `points` に継手を描かず、この値は設計長さと「箇所」の内訳行だけに効く。\r\n91- */\r\n92:export interface RebarSplice {\r\n93-  method: SpliceMethod\r\n94-  /** 1本あたりの継手箇所数。（３）梁2) に 0.5 か所があるので整数とは限らない */\r\n95-  countPerBar: number\r\n96-  /** この継手が設計長さに算入した長さ (mm)。ガス圧接なら 0 — 1通則5) */\r\n97-  lengthMm: number\r\n98-  /**\r\n99-   * 箇所数と算入長さを決めた行だけ。かぶり等まで載せると、算出式に現れない\r\n100-   * 行を継手行の根拠として示すことになる。\r\n101-   */\r\n102-  rules: RuleHit[]\r\n103-  formula: string\r\n104-}\r\n105-\r\n106:export interface Rebar {\r\n107-  id: string\r\n108-  memberId: string\r\n109-  role: RebarRole\r\n110-  /** せん断補強筋には高強度せん断補強筋 (K13・S13) が入る (ADR-026) */\r\n111-  size: ShearBarSize\r\n112-  shape: RebarShape\r\n113-  /** 加工形状. 3D 표시의 유일한 출처이며 `length`와 일치하지 않을 수 있다. */\r\n114-  points: [number, number, number][]\r\n115-  closed: boolean\r\n116-  /**\r\n117-   * 数量積算基準の**設計長さ** (mm) — 内訳書·kg 산출이 쓰는 값이다.\r\n118-   * フープ·スタラップ은 1通則2)가 「断面の設計寸法による周長、フックはない\r\n119-   * ものとする」로 정하므로 `points`가 그리는 加工長과 어긋난다 (ADR-019).\r\n120-   */\r\n121-  length: number\r\n122-  /**\r\n123-   * 数量積算基準の**設計本数** — 1通則7)의 割付本数다.\r\n124-   * 배치가 만드는 실제 개수는 `placement.positionCount`이며 다를 수 있다.\r\n125-   */\r\n126-  count: number\r\n127-  /** 대표 1본을 실제 本数만큼 전개할 때 필요한 도메인 배치 입력. */\r\n128-  placement?: RebarPlacement\r\n129-  /**\r\n130-   * 같은 형상의 대표 1본을 부재 로컬 x축의 어느 위치들에 두는지 (mm).\r\n131-   *\r\n132-   * カットオフ筋처럼 **한 내역 행이 떨어진 여러 곳에 서는** 철근을 위한 값이다.\r\n133-   * 数量은 `count`가 전부 담으므로(位置 수 × 1위치당 本数) 이 값은 3D 전개 전용이고,\r\n134-   * 없으면 `points`가 이미 부재 로컬 좌표라는 뜻이다.\r\n135-   */\r\n136-  axisOffsetsMm?: number[]\r\n137-  /**\r\n138-   * 大梁主筋の同一段で、この行が占める最初の枠番号。位置別本数を nesting\r\n139-   * 分解したとき、片側筋は stub の後ろの枠に入る — points と axisOffsetsMm\r\n140-   * だけではその段内の枠を復元できないため、導出結果として持たせる。\r\n141-   */\r\n142-  axisSlotStart?: number\r\n143-  /** 継手を持たない鉄筋（フープ・スタラップ）にはない */\r\n144-  splice?: RebarSplice\r\n145-  zones?: RebarZone[]\r\n146-  /** 이 철근을 산정하며 실제로 조회한 룰 행 그대로 — 키만 남기면 조회 조건을 잃는다 */\r\n147-  ruleHits: RuleHit[]\r\n148-  formula: string\r\n149-}\r\nimport type { SlabRun } from '../model/project'\r\nimport type { Rebar, RebarRole, RebarZone } from '../model/rebar'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { coverConditions, lookupRule, lookupRuleSeries } from '../rules/lookup'\r\nimport type { RuleHit, RulePack } from '../rules/types'\r\nimport {\r\n  bandedSpliceRule,\r\n  distributionCount,\r\n  intervalSpliceCount,\r\n  spliceCount,\r\n  spliceLengthMm,\r\n  type SpliceBand,\r\n} from './measurement'\r\nimport { openingDeduction } from './opening'\r\nimport { resolveSlabEnd, type SlabEndDetail } from './slab-ends'\r\nimport { stirrupPositions } from './stirrup-layout'\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됥겗?띸춮?귝빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞???㎪릍??(ADR-028)??\r\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲??\r\n * 麗닷뭄?먦겗?끾퀡?ⓨ늽?띲겏若싥굙?뗣겗?㎯곲빓?뺛겘?싥굤??뼋?㎯겘?ゃ걦訝▼겢??ㄷ歟곥겗?끻겢?㏂겗?볝겓\r\n * ?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\r\n *\r\n * 1?욁겗?쇈겞?뷩걮?뚦룛?묉똻?ㅳ겗??*1?ㅳ겗?⒲꺍???밧릲**?㎯곦툓塋?춮?ⓧ툔塋?춮???с굮瓦붵걲??\r\n * 佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥??겎?갲?밧릲?쮇?밧릲?㎩닪?끹겓?쇈겤??\r\n *\r\n * ??꺖?ャ꺂佯㎪쮽??x 竊?X?싥굤?밧릲?걓 竊?Y?싥굤?밧릲?걕 竊??쏁쎍竊덃씮??툔塋?걣 0竊됥?\r\n * ?졼걢??X?밧릲??뎱嶺뗣겘 x ?ヤ섯?녈겍 y ?멧를?녈갳?밧릲??뎱嶺뗣겘 y ?ヤ섯?녈겍 x ?멧를?뜰?\r\n *\r\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲?뗣귛틞?욍겗?뗥룭??쉸餘듐꺕鼇?굺??굚??겎?곭첆?ⓨ릪?섅걦?볝겗?끹겗\r\n * 野얕괌?????뚪쟿??깿?먦굮?먦겂?╉걚?ゃ걚?귡뼀?ｃ겘?쇻궎?붵겏?ュ뀯?쎼걬?뚣굥?뚪뎱嶺뗣겘?⒲꺍??\r\n * 歷с굥??겎??SlabRun.openings` ?뚣꺀?녑벨與쇻겓?담걮?잆굚??굮誤뗣굥?귞텤?뗣겘鶯곥겏?뺛겂??\r\n * 鵝녷쎑?뚣겒????2竊덌폇竊됧틞??) ??뙷?녴겘?뚦틞?욍겗?룔걬?띲겎凉뺛걦??겎?곲뼀?ｃ걣?귙겂?╉굚\r\n * ?ｇ텥佯딀씮??츋??겹겘鸚됥굩?됥겒?꾬펷?섊떖佯딀씮??1?싧뎴4) ?ゃ겗?㎪쵟?ㅵ풄??빓?뺛겎?겹걟?뗰펹??\r\n * ?뗥룭獒쒎섭嶺뗣겘?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겗?㎬＝?곥겘鵝쒌굢?ゃ걚 (ADR-029?팕14)??\r\n */\r\nexport interface SlabRebarInput {\r\n  run: SlabRun\r\n  section: SlabSection\r\n}\r\n\r\nfunction barDiameter(size: BarSize): number {\r\n  const diameter = Number(size.replace(/^D/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid BarSize: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\nfunction millimetres(rule: RuleHit, diameter?: number): number {\r\n  if (rule.unit === 'mm') return rule.value\r\n  if (rule.unit === 'd' && diameter !== undefined) {\r\n    return rule.value * diameter\r\n  }\r\n\r\n  throw new Error(\r\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\r\n  )\r\n}\r\n\r\nfunction uniqueRuleHits(rules: RuleHit[]): RuleHit[] {\r\n  return [...new Set(rules)]\r\n}\r\n\r\n/**\r\n * 2竊덌폇竊됧틞??) ??뙷?녻〃?귚퐬?뷴늽?귙굥?뗣겘?ャ꺖?ャ깙?껁궚?뚧군?곥굥??겎烏뚣굮?앫겗?얇겲沃????\r\n * 歟곥겗烏ⓦ겏?뺛걚訝딃솏?ゃ걮??뙷?녴걣?ゃ걚 ??13.5m 餓δ툓??렅?뉎겓若싥굙?뚣겒?뤵?\r\n * bandedSpliceRule ??MemberUnsupportedError ?㎬맼?ⓦ걲??\r\n */\r\nfunction continuousSlabBands(pack: RulePack): SpliceBand[] {\r\n  const counts = lookupRuleSeries(pack, 'measure.splice.slab.continuous', 'band')\r\n  const upperBounds = new Map(\r\n    lookupRuleSeries(\r\n      pack,\r\n      'measure.splice.slab.continuous.band.upper',\r\n      'band',\r\n    ).map((rule) => [rule.conditions.band, rule]),\r\n","exit_code":0,"status":"completed"}}
