t inside the support 柱 exterior faces', () => {\r\n314-    const generated = project.members.flatMap((member) =>\r\n315-      member.kind === '大梁'\r\n316-        ? girderFixture(project, member.id).rebars\r\n317-        : [],\r\n318-    )\r\n319:    const layout = buildingLayout(project, generated, noUnsupportedMembers)\r\n320-\r\n321-    for (const instance of layout.rebar) {\r\n322-      const member = project.members.find(\r\n323-        ({ id }) => id === instance.memberId,\r\n324-      )!\r\n325-      if (member.kind !== '大梁' || !('axis' in member.position)) continue\r\n326-\r\n327-      const run = girderRun(project, member)\r\n328-      const startMember = run.members[0]\r\n329-      const endMember = run.members.at(-1)!\r\n330-      if (\r\n331-        !('axis' in startMember.position) ||\r\n332-        !('axis' in endMember.position)\r\n333-      ) {\r\n334-        throw new Error('GirderRun contains a non-girder position')\r\n335-      }\r\n336-      const startSpan = run.spans[0]\r\n337-      const endSpan = run.spans.at(-1)!\r\n338-      const start = gridPoint(\r\n339-        project.grid,\r\n340-        startMember.position.ix,\r\n341-        startMember.position.iy,\r\n342-      )\r\n343-      const end =\r\n344-        member.position.axis === 'X'\r\n345-          ? gridPoint(\r\n346-              project.grid,\r\n347-              endMember.position.ix + 1,\r\n348-              endMember.position.iy,\r\n349-            )\r\n350-          : gridPoint(\r\n351-              project.grid,\r\n352-              endMember.position.ix,\r\n353-              endMember.position.iy + 1,\r\n","exit_code":0,"status":"completed"}}
