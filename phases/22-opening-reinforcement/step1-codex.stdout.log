x+1, iy+1) ??륫?밤굮凉뺛걦 ??壤㏂겘?긱겏?뚣걯?㎯굚?뤷뫑?뚪걬?녴?\r\n */\r\nconst POSITION_FIELDS: Record<\r\n  MemberKind,\r\n  Record<string, (field: unknown) => boolean>\r\n> = {\r\n  ?? { ix: isFiniteNumber, iy: isFiniteNumber },\r\n  鸚㎪쥈: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\r\n  ?먬쐡鶯? { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\r\n  佯딀씮: { ix: isFiniteNumber, iy: isFiniteNumber },\r\n}\r\n\r\nconst isOpening = shapedAs({\r\n  id: isString,\r\n  xMm: isFiniteNumber,\r\n  yMm: isFiniteNumber,\r\n  widthMm: isFiniteNumber,\r\n  heightMm: isFiniteNumber,\r\n})\r\n\r\nconst isMemberKind = (value: unknown): boolean =>\r\n  MEMBER_KINDS.includes(value as MemberKind)\r\n\r\n/**\r\n * 謠ⓩ졏?졼걨?믤쩂?곥굥?귛룚?딂씔?旅덁뻑??퍟雅뷩걣鵝쒌겂?잍뻼耶쀥닓?㎯걌chemaVersion ?쀣걢\r\n * 誤뗣걳?ラ싥걲?ⓨ숱??걬??JSON ??Project ?ⓦ걮??ⅴ?얇겎?γ굥 ???곈뇧??NaN ?ャ겒?뗣걢\r\n * ?삯씊?뚩맼?▲굥?뗣겎?곥겑?▲굢?귙뚩き?욤씔?곥겒?뗣겂?잆띲굠?딀궕?꾠?\r\n *\r\n * 濾쒌굙?뗣겗??＝?곥걣?쇻걧曆삣춻?믣폊?뤷졃? (stories?팵embers?퍀ections?팮rid) ?ⓦ?\r\n * ?낁㉢?멥겗?삠꺂?ャ걹??겲?얍눣?뗦뻼耶쀥닓?졼걨?졼귛ㅳ겗倻ε퐪??(孃꾠걣若잌쑉?쇻굥?뗣?\r\n * ?ф빊?뚧??? ??걪?볝겎??쫳?ゃ걚 ???앫굦??뼪?㏘?誤㎯겗?ε뒟濾쒏읅??똻?▼졃?㎯?\r\n * ?볝걪?㏛틠?띲겓?곥겇?②쫸繹뽧걣雅뚣걢??ュ늽?뗣굦?뗣?\r\n */\r\n/**\r\n * 壤㏂걽?묌싥겂?╊릎翁ャ겗?귞뀱?뚦늾?뚣겍?꾠굥鼇섌뙯?믣늾?뗣?\r\n *\r\n * ?볝걪?㎬쫳?ゃ걚?ⓦ곩풄?뗣굢?뤹뵽??붶릎?㎬맼?▲굥 ??useProjectPersistence ??\r\n * catch ??loadProject ?뚩㏄?ｃ걼? (??앫겗?? ?쀣걢誤뗣겒?꾠겗?㎯곩ㄷ歟곥겗??씊??\r\n * 轝졼걨?╉걚?뗨쮼?꿔겘?앫걪?믥킔?싥굤?쀣겍 PaneBoundary ?ュ눣?뗣?\r\n */\r\n        }) &&\r\n        // ?쎼걚?귡뀓嶺뗣겗?ε뒟?귞Ŧ?γ겎?듐걣?뺛걝?귛뀻?싥겗?닸??졼걨?㎪툑?얇걵?뗣겏??\r\n        // ?쎼걚 ??쵟?묆걼??씊?뚪싥겂??릭嶺뗣겗?졾램野멩퀡??NaN ??겲?얍냵鼇녔쎑??릦鼇덀겲??\r\n        // 役곥굦?걅ain/hoop/stirrup ??쵟?묆걼??씊??generateColumnRebar ??릎??\r\n        // TypeError ?ャ겒?뗢붵겑?▲굢?귙걪??뼟?겹걣閭㏂굙?잆걢?ｃ걼永먩옖?앫겗?귙겗?졼?\r\n        // ?앫굮?멥겧?뗣겗??툓?㎩닩?ε춴?믤쩂?곥겍?귙굥?뗣굢?졼?\r\n        hasShape(section, SECTION_FIELDS[(section as Section).kind]),\r\n    ) &&\r\n    Array.isArray(members) &&\r\n    members.every(\r\n      (member) =>\r\n        hasShape(member, {\r\n          id: isString,\r\n          kind: isMemberKind,\r\n          sectionId: isString,\r\n          storyId: isString,\r\n        }) &&\r\n        // position ?뚨꽒?묆굦??buildingLayout ??`'axis' in member.position` ??\r\n        // ?앫겗?담겎 TypeError ?ャ겒?뗣귟뻗??'X'/'Y' 餓ε쨼?믧싥걬?ゃ걚 ??\r\n        // 訝됮쟿轢붺츞耶먦겎 Y ?ヨ맼?▲겍?곩쎋?㏂겓?▲걚?묆걤??ㄷ歟곥굮容쇻겂?╊퐳?뗣?\r\n        hasShape(member, {\r\n          position: shapedAs(POSITION_FIELDS[(member as Member).kind]),\r\n        }) &&\r\n        // ?뗥룭??꽒?뤵겍?덀걚 (?뚪뼀?ｃ겒?쀣띲겗?? ?뚣곫쐣?뗣겒?됮뀓?쀣겎?ゃ걨?뚣겙\r\n        // ?ゃ굢?ゃ걚 ??openingDeduction ?뚥릎?믦き?볝겎轝좈솮?뤵굮?뷩걲?뗣굢?졼?\r\n        ((member as { openings?: unknown }).openings === undefined ||\r\n          (Array.isArray((member as { openings?: unknown }).openings) &&\r\n            ((member as { openings: unknown[] }).openings).every(isOpening))),\r\n    ) &&\r\n    (notes === undefined ||\r\n      (isRecord(notes) && Object.values(notes).every(isString))) &&\r\n    (unitMass === undefined ||\r\n      (isRecord(unitMass) && Object.values(unitMass).every(isFiniteNumber))) &&\r\n    // ?볝걪?얇겎??3 ?ㅳ겗?띶닓??숱?뚧툑?볝겎?꾠굥?귝츐?뗣겗??틨?꾠겗?뉎걮?덀걚?졼?\r\n    hasIntactReferences(\r\n      value.grid as Grid,\r\n      sections as { id: string; kind: MemberKind }[],\r\n      stories as { id: string }[],\r\n      members as {\r\n        kind: MemberKind\r\n        sectionId: string\r\n        storyId: string\r\n        position: ReferencedPosition\r\n      }[],\r\n    )\r\nimport type { BarSize, Member, WallSection } from '../model/member'\r\nimport type { WallSpan } from '../model/project'\r\nimport type { Rebar, RebarSplice, RebarZone } from '../model/rebar'\r\nimport { MemberUnsupportedError } from '../model/unsupported'\r\nimport { coverConditions, lookupRule } from '../rules/lookup'\r\nimport type { RuleHit, RulePack } from '../rules/types'\r\nimport {\r\n  distributionCount,\r\n  intervalSpliceCount,\r\n  spliceCount,\r\n  spliceLengthMm,\r\n} from './measurement'\r\nimport { openingDeduction } from './opening'\r\nimport { stirrupPositions } from './stirrup-layout'\r\n\r\n/**\r\n * ?먬쐡鶯곻펷?⒲꺖?▲꺍礪뗩졼겗鶯곻펹??뀓嶺뗣귝빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯**1)**?뚦즯凉뤸쭓?졽빳鸚뽧?\r\n * ?졼걨?믣츪獒끹걲????2)?뚦즯凉뤸쭓?졼띲겘塋?깿嶺뗣꺕鶯곫쥈嶺뗣겲?㎩뙷?녴걣罌쀣걟?뗥닪??씉?뉎겎?귙굥??\r\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬??\r\n * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲쳵?뺛겘?롩쳵?㎯겘?ゃ걦?끾퀡遙섅걬?곲빓?뺛겘\r\n * ?긷퓘?볝겎??겒?뤷냵力뺡빓?뺛겓?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\r\n *\r\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲????`Member.openings` ?뚦룛?묈룚?ｃ걼?끾퀡野멩퀡?졼걨??\r\n * ?앫겗?뗥룭?믤Ø?뉎굥?с굮??걦?쀣곫쵟?ㅹ뇧?붵겏?ュ냵鼇녈겗烏뚣굮?녴걨?뗣귡뼀?ｃ굮與ゅ늾?ｃ걼\r\n * 潁?춮??텤?뗣겘?뚣걯 2竊덌폊竊됧즯1)????퐜?멥겎 0?뗦??ャ겒?뗣귡뼀?ｈ짒凉루춮??릪?끹걣\r\n * ?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겏冶붶뻣?쇻굥??겎獒썲뱚??퐳?됥겒??(ADR-029?팕14)??\r\n */\r\nexport interface WallRebarInput {\r\n  member: Member\r\n  section: WallSection\r\n  span: WallSpan\r\n}\r\n\r\nfunction barDiameter(size: BarSize): number {\r\n  const diameter = Number(size.replace(/^D/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid BarSize: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\nfunction millimetres(rule: RuleHit, diameter?: number): number {\r\n  if (rule.unit === 'mm') return rule.value\r\n  if (rule.unit === 'd' && diameter !== undefined) {\r\n    return rule.value * diameter\r\n  }\r\n\r\n  throw new Error(\r\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\r\n  )\r\n}\r\n\r\nexport function generateWallRebar(\r\n  input: WallRebarInput,\r\n  pack: RulePack,\r\n): Rebar[] {\r\n  const { member, section, span } = input\r\n  const conditions = { fc: section.fc, grade: section.grade, hook: false }\r\n\r\n  const coverRule = lookupRule(pack, 'cover.minimum', coverConditions(section))\r\n  const fabricationCoverAdditionRule = lookupRule(\r\n    pack,\r\n    'cover.fabrication.addition',\r\n    {},\r\n  )\r\n  // 若싩???〃5.3.4 ????у?L1?귛릪烏ⓦ겓鶯곩컗?ⓦ겗?쀣겘?ゃ걦?갟2 ??컦歟곥꺕L3 ??궧?⒲깣??\r\n  // ?먦굢?뚣굥竊덅〃??걣?앫겗2?ㅳ걽?묆굮?띷뙁?숋펹??겎?곩즯嶺뗣겘訝?уㅳ굮凉뺛걦??\r\n  const anchorageRule = lookupRule(pack, 'anchorage.L1', conditions)\r\n  const tableLapRule = lookupRule(pack, 'lap.L1', conditions)\r\n  // 5.3.4(3)(節? ???먨뒟鶯곥걽?묆걣?곥겇訝뗩솏?귝윶?삥쥈??말嶺뗣겏?뺛걚烏?.3.2 ??ㅳ굮?앫겗?얇겲\r\n  // 鵝욍굩?싥?0d ?ⓩ캈?밤겍鸚㎯걤?꾣뼶?믣룚?뗣?\r\n  const wallLapMinimumRule = lookupRule(pack, 'lap.wall.minimum', {})\r\n  const spliceFactorRule = lookupRule(pack, 'measure.splice.length.factor', {\r\n    method: section.spliceMethod,\r\n  })\r\n  const distributionAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.distribution.addition',\r\n    {},\r\n  )\r\n\r\n  const minimumCover = millimetres(coverRule)\r\n  const fabricationCover =\r\n    minimumCover + millimetres(fabricationCoverAdditionRule)\r\n  const layerOffsets = wallLayerOffsets(member, section, fabricationCover)\r\n\r\n  const shared = {\r\n    member,\r\n    section,\r\n    span,\r\n    layerOffsets,\r\n    anchorageRule,\r\n    tableLapRule,\r\n    wallLapMinimumRule,\r\n    spliceFactorRule,\r\n    distributionAdditionRule,\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n    fabricationCover,\r\n    pack,\r\n  }\r\n\r\n  return [\r\n    ...buildWallBars({\r\n      ...shared,\r\n      role: '潁?춮',\r\n      size: section.vertical.size,\r\n      pitchMm: section.vertical.pitch,\r\n      startOffsetMm: section.vertical.startOffsetMm,\r\n      // 潁?춮??즯??쳵?뺛굮歷с굤?곩냵力뺡빓?뺛겓?꿔굤餓섅걨?뗣?\r\n      bodyLengthMm: span.clearHeightMm,\r\n      distributionOverMm: span.clearLengthMm,\r\n      bodyLabel: '?끾퀡遙섅걬',\r\n      distributionLabel: '?끾퀡?룔걬',\r\n      repeatAxis: 'x',\r\n      barAxis: 'y',\r\n    }),\r\n    ...buildWallBars({\r\n      ...shared,\r\n      role: '與ょ춮',\r\n      size: section.horizontal.size,\r\n      pitchMm: section.horizontal.pitch,\r\n      startOffsetMm: section.horizontal.startOffsetMm,\r\n      // 與ょ춮??즯??빓?뺛굮歷с굤?곩냵力뺡쳵?뺛겓?꿔굤餓섅걨?뗣?\r\n      bodyLengthMm: span.clearLengthMm,\r\n      distributionOverMm: span.clearHeightMm,\r\n      bodyLabel: '?끾퀡?룔걬',\r\n      distributionLabel: '?끾퀡遙섅걬',\r\n      repeatAxis: 'y',\r\n      barAxis: 'x',\r\n    }),\r\n  ]\r\n}\r\n\r\n/**\r\n * ?띸춮??광?뚦즯?싥겗?⒲걪?ョ쳦?ㅳ걢 (mm)?귙??뽧꺂??륫?㏂겗?뗣겤?듾퐤營?곥궥?녈궛?ャ겘\r\n * ?싥걬??릎鸚?겎?귙굥??D 壤®듁?ャ걮?뗥듅?뗣겒?????곈뇧??광?겹걽?묆굮誤뗣굥??\r\n */\r\nfunction wallLayerOffsets(\r\n  member: Member,\r\n  section: WallSection,\r\n  fabricationCover: number,\r\n      'measure.splice.slab.continuous.band.upper',\r\n      'band',\r\n    ).map((rule) => [rule.conditions.band, rule]),\r\n  )\r\n\r\n  return counts.map((countRule) => ({\r\n    countRule,\r\n    upperBoundRule: upperBounds.get(countRule.conditions.band) ?? null,\r\n  }))\r\n}\r\n\r\nexport function generateSlabRebar(\r\n  input: SlabRebarInput,\r\n  pack: RulePack,\r\n): Rebar[] {\r\n  const { run, section } = input\r\n  const coverRule = lookupRule(pack, 'cover.minimum', coverConditions(section))\r\n  const fabricationCoverAdditionRule = lookupRule(\r\n    pack,\r\n    'cover.fabrication.addition',\r\n    {},\r\n  )\r\n  const distributionAdditionRule = lookupRule(\r\n    pack,\r\n    'measure.distribution.addition',\r\n    {},\r\n  )\r\n  const fabricationCoverMm =\r\n    millimetres(coverRule) + millimetres(fabricationCoverAdditionRule)\r\n\r\n  // ?졾램?ⓦ걢?뜰굤횞2 ?뚧씮?싥굮擁끹걟?뗣겏訝딁ク嶺뗣겏訝뗧ク嶺뗣걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂??\r\n  // ?욍겓?ゃ굥?귡퍢?ｃ겍訝?ㄾ?ュ칱?쎼걳?곥걹??틞?욍걽?묋맼?ⓦ걲竊덅먬쐡鶯곥겗??뽧꺂?띸춮??\r\n  // 野멩퀡?с꺖?됥겏?뚣걯?긱걚竊됥?\r\n  if (section.thickness <= 2 * fabricationCoverMm) {\r\n    throw new MemberUnsupportedError(\r\n      '野멩퀡訝띷닇塋?,\r\n      `佯딀씮??툓塋?춮?ⓧ툔塋?춮?뚧씮?싥겓?γ굢?ゃ걚: ${run.ownerId} ` +\r\n        `(?욕럻 ${section.thickness} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCoverMm})`,\r\n    )\r\n  }\r\n\r\n  const shared = {\r\n    run,\r\n    section,\r\n    pack,\r\n    coverRule,\r\n    fabricationCoverAdditionRule,\r\n    distributionAdditionRule,\r\n    fabricationCoverMm,\r\n  }\r\n\r\n  // 訝뗧ク嶺뗣굮?덀겓?뷩걲?귝씮??툔?뗣굢?녴겓令띲??녶틣?뚣걹??겲?얍냵鼇녈겗訝╉겞?ャ겒?뗣?\r\n  return [\r\n    ...buildSlabBars({ ...shared, face: '訝뗧ク' }),\r\n    ...buildSlabBars({ ...shared, face: '訝딁ク' }),\r\n  ]\r\n}\r\n\r\ninterface SlabBarInput {\r\n  run: SlabRun\r\n  section: SlabSection\r\n  pack: RulePack\r\n  coverRule: RuleHit\r\n  fabricationCoverAdditionRule: RuleHit\r\n  distributionAdditionRule: RuleHit\r\n  fabricationCoverMm: number\r\n  face: '訝딁ク' | '訝뗧ク'\r\n}\r\n\r\nfunction roleOf(axis: 'X' | 'Y', face: '訝딁ク' | '訝뗧ク'): RebarRole {\r\n  if (axis === 'X') return face === '訝딁ク' ? 'X?밧릲訝딁ク嶺? : 'X?밧릲訝뗧ク嶺?\r\n  return face === '訝딁ク' ? 'Y?밧릲訝딁ク嶺? : 'Y?밧릲訝뗧ク嶺?\r\n}\r\n\r\nfunction buildSlabBars(input: SlabBarInput): Rebar[] {\r\n  position: Point3\r\n  target: Point3\r\n}\r\n\r\nexport const CAMERA_FOV_DEGREES = 38\r\nexport const CAMERA_FRAME_MARGIN = 1.08\r\nexport const CAMERA_DIRECTION: Point3 = [0.72, 0.34, 0.86]\r\n\r\nconst MINIMUM_DISPLAY_DIAMETER = 14\r\nconst DISPLAY_DIAMETER_SCALE = 1.6\r\n\r\nexport type RebarLayer = 'main' | 'hoop'\r\n\r\nexport function roleToLayer(role: RebarRole): RebarLayer {\r\n  switch (role) {\r\n    case '訝사춮':\r\n    case '訝딁ク嶺?:\r\n    case '訝뗧ク嶺?:\r\n    case '訝딁ク?ャ긿?덀궕?뺟춮':\r\n    case '訝뗧ク?ャ긿?덀궕?뺟춮':\r\n      return 'main'\r\n    case '躍?춮':\r\n    case '?귙겙?됬춮':\r\n    // 亮끾??곭춮? ?귙겙?됬춮??寃곗냽?섎뒗 媛濡?諛⑺뼢 蹂댁“洹쇱씠??媛숈? ?덉씠?댁뿉 ?붾떎.\r\n    case '亮끾??곭춮':\r\n      return 'hoop'\r\n    // ?밭춮? ?ㅽ뙩 諛⑺뼢?쇰줈 ?먮Ⅴ???몃줈洹쇱씠??訝사춮怨?媛숈? ?덉씠?대떎.\r\n    case '?밭춮':\r\n    // ?먬쐡鶯곸쓽 潁?춮? 遺?ъ텞???곕씪 ?먮Ⅴ???몃줈洹쇱씠??訝사춮怨?媛숇떎.\r\n    case '潁?춮':\r\n      return 'main'\r\n    // 與ょ춮? 洹??몃줈洹쇱쓣 媛濡쒖?瑜대뒗 諛곕젰洹쇱씠??躍?춮쨌?귙겙?됬춮怨?媛숈? ?덉씠?대떎.\r\n    case '與ょ춮':\r\n      return 'hoop'\r\n    // 佯딀씮??말嶺뗣걣2?밧릲?ヨ뎔?뗣걽?묆겎?⒲굦?귚말嶺뗣걽 ??訝듾툔??씊?믡꺃?ㅳ깶?쇈겎\r\n    // ?녴걨?ゃ걚?귛늽?묆굥?ⓦ뚥말嶺뗰폀躍?춮?띲겏?꾠걝?덀궛?ャ겗?뤷뫑?뚪깿?먦걫?ⓦ겓鸚됥굩?뗣?\r\n    case 'X?밧릲訝딁ク嶺?:\r\n    case 'X?밧릲訝뗧ク嶺?:\r\n    case 'Y?밧릲訝딁ク嶺?:\r\n    case 'Y?밧릲訝뗧ク嶺?:\r\n      return 'main'\r\n    default: {\r\n      const unsupported: never = role\r\n      throw new Error(`Unsupported RebarRole: ${unsupported}`)\r\n    }\r\n  }\r\n}\r\n\r\n// ?쇈겞?띲겗?긷춻?믦맼?ⓦ걲?ⓨ뫜?녑푶?뚧츐????D13 ?귡쳵凉룟벧?쎼굯??짒凉루춮??K13?팗13 ??\r\n// ?뚣걯誤뤹큵?㎯걗?ｃ겍?곥걪?볝겓?겹걮?꾣빊?ㅳ겘罌쀣걟?ゃ걚 (ADR-026)??\r\nexport function barDiameter(size: ShearBarSize): number {\r\n  const diameter = Number(size.replace(/^[A-Z]+/, ''))\r\n\r\n  if (!Number.isFinite(diameter) || diameter <= 0) {\r\n    throw new Error(`Invalid bar size: ${size}`)\r\n  }\r\n\r\n  return diameter\r\n}\r\n\r\nexport function rebarRadius(size: ShearBarSize): number {\r\n  return (\r\n      radius: segment.radius,\r\n    })\r\n  }\r\n\r\n  // 塋?걣?뗥룭??툈?ャ걾?뉎걝?⑵펹?뗣겏?룔걬0??졃?뉎걣?뷩굥?귝룒?꾠겍?귟쫳?덀겒?꾠걝?덀?\r\n  // three.js ??냶?긱궦?ゃ깳?덀꺁?뚦릲?띲굮黎뷩굙?됥굦?ゃ걚??\r\n  return pieces.filter(\r\n    ({ from, to }) =>\r\n      Math.hypot(to[0] - from[0], to[1] - from[1], to[2] - from[2]) > 1e-6,\r\n  )\r\n}\r\n\r\nexport function clipSegments(\r\n  segments: Segment[],\r\n  openings: Opening[],\r\n): Segment[] {\r\n  if (openings.length === 0) return segments\r\n  return segments.flatMap((segment) => clipSegment(segment, openings))\r\n}\r\n\r\nfunction rebarSegmentRuns(\r\n  rebar: Rebar,\r\n  section: Section,\r\n  radiusOf: RadiusOf = rebarRadius,\r\n  openings: Opening[] = [],\r\n): SegmentRun[] {\r\n  // 鶯곥겏佯딀씮?졼걨烏①ㅊ?듿푶?뚪깿?먨럻?ョ툤?됥굦?뗣귡뀓營?겏?뤹뵽?㎩닪?끹겗?듿푶?믢슴?녴겏??\r\n  // 屋겹굙?잆겘?싥겗掠ㅳ걣?뤵걦?ⓦ걤?ャ겲?잌ㄺ?ｃ겍繇잆걚渦쇈???\r\n  const radius =\r\n    section.kind === '?먬쐡鶯?\r\n      ? wallDisplayRadius(rebar.size, section, radiusOf)\r\n      : section.kind === '佯딀씮'\r\n        ? slabDisplayRadius(\r\n            rebar.size,\r\n            section,\r\n            slabCoverMm(slabCoverZ(rebar), section),\r\n            radiusOf,\r\n          )\r\n        : radiusOf(rebar.size)\r\n  const displayPoint = (point: Point3): Point3 =>\r\n    rebar.shape === 'hoop'\r\n      ? hoopDisplayPoint(point, rebar.points, radius, section)\r\n      : point\r\n  const placements = rebarPlacements(rebar, section, radiusOf)\r\n\r\n  return pathRuns(rebar).map(({ zone, segments }) => ({\r\n    zone,\r\n    // ?뗥룭?ⓦ겘 3D ?㎯걽?묌뎱嶺뗣굮??겇?귝빊?뤵겘 `Rebar.length` ?뚦닪?ユ똻?ｃ겍?꾠굥\r\n    // ??겎?곥걪?볝겎?뉎겂?╉굚?ф빊?삭나?뤵겘?뺛걢?ゃ걚 (ADR-029)??\r\n    segments: clipSegments(\r\n      placements.flatMap((offset) =>\r\n        segments.map(({ from, to }) => ({\r\n          from: translate(displayPoint(from), offset),\r\n          to: translate(displayPoint(to), offset),\r\n          radius,\r\n        })),\r\n      ),\r\n      openings,\r\n    ),\r\n  }))\r\n}\r\n\r\nexport function rebarSegments(\r\n  rebar: Rebar,\r\n  section: Section,\r\n  radiusOf: RadiusOf = rebarRadius,\r\n  openings: Opening[] = [],\r\n): Segment[] {\r\n  return rebarSegmentRuns(rebar, section, radiusOf, openings).flatMap(\r\n    ({ segments }) => segments,\r\n  )\r\n}\r\n\r\nexport interface RebarBatch {\r\n  rowId: string\r\n  layer: RebarLayer\r\n  zone: RebarZone['kind'] | null\r\n  segments: Segment[]\r\n}\r\n\r\n/**\r\n * 3D??媛뺤“ ?⑥쐞???댁뿭??**??*?대떎(DESIGN.md 짠3.2). zone ?됱쓣 蹂댁〈?섍린 ?꾪빐\r\n * ???덉뿉?쒕뒗 ?곗냽 寃쎈줈 run留덈떎 ?섎늻吏留? ?멸렇癒쇳듃留덈떎 硫붿떆瑜?留뚮뱾吏???딅뒗??\r\n * 媛숈? rowId瑜??좎??섎?濡??щ윭 zone 諛곗튂???섎굹???됱쑝濡??④퍡 媛뺤“?????덈떎.\r\n */\r\nfunction shiftAlongAxis(segments: Segment[], offsetMm: number): Segment[] {\r\n  if (offsetMm === 0) return segments\r\n\r\n  return segments.map(({ from, to, radius }) => ({\r\n    from: [from[0] + offsetMm, from[1], from[2]] as Point3,\r\n    to: [to[0] + offsetMm, to[1], to[2]] as Point3,\r\n    radius,\r\n  }))\r\n}\r\n\r\nexport function rebarBatches(\r\n  entries: {\r\n    rowId: string\r\n    rebar: Rebar\r\n    originOffsetMm?: number\r\n    /** ?볝겗?꾤춮????佯㎪쮽楹삠겓?담걮?잓뼀?ｉ깿 (1?싧뎴8))??D ?졼걨?뚣걪?뚣굮誤뗣굥 */\r\n    openings?: Opening[]\r\n  }[],\r\n  section: Section,\r\n): RebarBatch[] {\r\n  const batches = new Map<string, RebarBatch>()\r\n\r\n  for (const { rowId, rebar, originOffsetMm = 0, openings = [] } of entries) {\r\n    const layer = roleToLayer(rebar.role)\r\n\r\n    rebarSegmentRuns(rebar, section, rebarRadius, openings).forEach(\r\n      ({ zone, segments }, runIndex) => {\r\n      // 媛숈? row?????泥좉렐???щ윭 媛쒕㈃ ?숈씪 寃쎈줈 run?쇰━ ?⑹튂?? ?묐떒??媛숈?\r\n      // kind??zone???덉뼱???쒕줈 ?ㅻⅨ ?곗냽 援ш컙?대?濡?runIndex濡?遺꾨━?쒕떎.\r\n        const key = JSON.stringify([rowId, layer, runIndex, zone])\r\n        // ?ㅽ봽?뗭? **蹂묓빀 ?꾩뿉** 嫄대떎. ?ｇ텥?밤깙?녹뿉?????ㅽ뙩???귙겙?됬춮? 湲몄씠쨌?ф빊媛\r\n        // 媛숈븘 媛숈? rowId