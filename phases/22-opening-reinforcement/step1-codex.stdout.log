unt === undefined || isFiniteNumber(row.startCount)\r\n}\r\n\r\nconst isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\r\n\r\n/**\r\n * 葉?닪?붵겏?ャ?*?뽧굤渦쇈굯?좂쎍孃뚣겗鼇덄츞?뚩쫳若덀굤?ゃ걮?ュ뢿?㎯걲??*?담걽?묆굮訝╉겧?뗣?\r\n *\r\n * ?볝걪?ョ꽒?꾢졃 (fc?팮rade?팫xposure?퍀pliceMethod ?ゃ겑) ??곫쵟?묆겍?귙꺂?쇈꺂?묆긿??\r\n * 凉뺛걤?뚦릫?띲겗?귙굥堊뗥쨼?㎪??곥굥 ???⒲걪?㏛퐬?뚩떨?듽겒?꾠걢?뚨뵽?㏂겓?뷩굥??\r\n * ?멥굯?㎯걗?뗣겗??TypeError ?ャ겒?뗥졃 ???앫굦?졼걨?뚣뚥퐬?뚩돈?띲걼?뗨??덀겒?꾥맼?→뼶?띲굮?쇻굥??\r\n */\r\nconst isBarRow = shapedAs({\r\n  size: isString,\r\n  pitch: isFiniteNumber,\r\n  startOffsetMm: isFiniteNumber,\r\n})\r\n\r\n/**\r\n * 野멩퀡??뜷??Ŧ?γ겎?뺛걝?귝윶?삣ㄷ歟곥겘 b ?ⓦ걵?꾠걽?뚣곮먬쐡鶯곥꺕佯딀씮??thickness 訝??\r\n * ????翁?퐪??뙷?녴걣鶯곥굮?뚦냵力뺡깿?녴띲곩틞?욍굮?뚦냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲빓?뺛겘\r\n * 鵝띸쉰?③슔??깿?먦걢?됧눣??뼪?㏂겓??꽒??(ADR-025?틻DR-028)?귛뀻?싥겗?닸???b ??\r\n * 黎귙굙?뗣겏?곫??쀣걚鶯곥겗鼇섌뙯?뚦숱?뺛걚?ⓦ걮??센?뗣굦?뗣?\r\n */\r\nconst SECTION_FIELDS: Record<\r\n  MemberKind,\r\n  Record<string, (field: unknown) => boolean>\r\n> = {\r\n  ?? {\r\n    b: isFiniteNumber,\r\n    d: isFiniteNumber,\r\n  })\r\n\r\n  it('rejects a non-finite-shaped startCount when it is present', () => {\r\n    const project = createProject()\r\n    const validProject = {\r\n      ...project,\r\n      sections: [\r\n        columnSection,\r\n        {\r\n          ...shallowGirderSection,\r\n          main: {\r\n            ...shallowGirderSection.main,\r\n            top: { endCount: 8, centerCount: 5, startCount: 4 },\r\n          },\r\n        },\r\n      ],\r\n    }\r\n    const serialized = serializeProject(validProject).replace(\r\n      '\"startCount\":4',\r\n      '\"startCount\":null',\r\n    )\r\n\r\n    expect(() => deserializeProject(serialized)).toThrow(\r\n      'Project shape mismatch',\r\n    )\r\n  })\r\n})\r\n\r\ndescribe('Opening.reinforcements serialization validation', () => {\r\n  const opening = {\r\n    id: 'opening-1',\r\n    xMm: 1000,\r\n    yMm: 500,\r\n    widthMm: 1200,\r\n    heightMm: 800,\r\n  }\r\n\r\n  it('keeps an opening without reinforcements compatible with existing records', () => {\r\n    const project = createProject({\r\n      ...column,\r\n      openings: [opening],\r\n    })\r\n\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n\r\n  it('round-trips transcribed opening reinforcements without changing the schema version', () => {\r\n    const project = createProject({\r\n      ...column,\r\n      openings: [\r\n        {\r\n          ...opening,\r\n          reinforcements: [\r\n            { size: 'D13', count: 4, lengthMm: 1800 },\r\n            { size: 'D10', count: 2, lengthMm: 1200 },\r\n          ],\r\n        },\r\n      ],\r\n    })\r\n\r\n    expect(project.schemaVersion).toBe(PROJECT_SCHEMA_VERSION)\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n\r\n  it.each([\r\n    ['an unsupported bar size', { size: 'D99' }],\r\n    ['a high-strength shear bar size', { size: 'K13' }],\r\n    ['a zero count', { count: 0 }],\r\n    ['a fractional count', { count: 1.5 }],\r\n    ['a zero length', { lengthMm: 0 }],\r\n    ['a negative length', { lengthMm: -1 }],\r\n    ['a non-finite length', { lengthMm: Number.POSITIVE_INFINITY }],\r\n  ])('rejects %s in a reinforcement transcription', (_label, change) => {\r\n    const project = createProject({\r\n      ...column,\r\n      openings: [\r\n        {\r\n          ...opening,\r\n          reinforcements: [\r\n            {\r\n              size: 'D13',\r\n              count: 1,\r\n              lengthMm: 1000,\r\n              ...change,\r\n            },\r\n          ],\r\n        },\r\n      ],\r\n    })\r\n\r\n    expect(() => deserializeProject(serializeProject(project))).toThrow(\r\n      'Project shape mismatch',\r\n    )\r\n  })\r\n})\r\n\r\ndescribe('girderSpan', () => {\r\n  const rectangularColumnSection: ColumnSection = {\r\n    ...columnSection,\r\n    id: 'section-C-rectangular',\r\n    mark: 'C-rectangular',\r\n    b: 700,\r\n    d: 900,\r\n  }\r\n  const narrowColumnSection: ColumnSection = {\r\n    ...columnSection,\r\n    id: 'section-C-narrow',\r\n    mark: 'C-narrow',\r\n    b: 600,\r\n  }\r\n  const wideColumnSection: ColumnSection = {\r\n    ...columnSection,\r\n    id: 'section-C-wide',\r\n    mark: 'C-wide',\r\n    b: 1000,\r\n  }\r\n\r\n  function supportColumn(\r\n    id: string,\r\n    sectionId: string,\r\n    ix: number,\r\n    iy: number,\r\n  ): Member {\r\n    return {\r\n      id,\r\n  expected?: Array<{\r\n    role: string\r\n    designLengthMm: number\r\n    count: number\r\n    spliceCountPerBar: number\r\n    spliceTotalCount: number\r\n  }>\r\n  expectedErrorReason?: string\r\n  handDerivation: string\r\n}\r\n\r\nconst asymmetricGirderCases =\r\n  fixture.cases.asymmetricGirderMain as AsymmetricGirderCase[]\r\n\r\ntype OpeningReinforcementCase = {\r\n  id: string\r\n  label: string\r\n  memberKind: '?먬쐡鶯? | '佯딀씮'\r\n  reinforcements: Array<{\r\n    size: BarSize\r\n    count: number\r\n    lengthMm: number\r\n  }>\r\n  unitMassKgPerM: Partial<Record<ShearBarSize, number>>\r\n  expected: Array<{\r\n    size: BarSize\r\n    count: number\r\n    lengthMm: number\r\n    designKg: number | null\r\n    requiredKg: number | null\r\n  }>\r\n  handDerivation: string\r\n}\r\n\r\nconst openingReinforcementCases =\r\n  fixture.cases.openingReinforcement.cases as OpeningReinforcementCase[]\r\n\r\nconst STORY: Story = { id: '1F', name: '1??, height: 4200 }\r\n\r\nfunction columnSection(\r\n  overrides: Partial<ColumnSection> = {},\r\n): ColumnSection {\r\n  return {\r\n    id: 'section-C1',\r\n    kind: '??,\r\n    mark: 'C1',\r\n    shape: '?⒴숱',\r\n    b: 800,\r\n    d: 800,\r\n    fc: 24,\r\n    grade: 'SD345',\r\n    exposure: '掠뗥쨼',\r\n    finish: '餓뺜툓?믡겒??,\r\n    spliceMethod: '?띲겖泳숁뎸',\r\n    main: { size: 'D25', count: 12 },\r\n    hoop: { size: 'D13', pitch: 100, startOffsetMm: 0 },\r\n    ...overrides,\r\n  }\r\n}\r\n\r\nfunction girderSection(\r\n  overrides: Partial<GirderSection> = {},\r\n): GirderSection {\r\n  return {\r\n    id: 'section-G1',\r\n\r\n    return {\r\n      project,\r\n      rebars: generateWallRebar({ member, section, span }, jpMlitRulePack),\r\n    }\r\n  }\r\n\r\n  function slabInput(entry: OpeningReinforcementCase) {\r\n    const base = slabRunFor([6000], 'X', slabSection())\r\n    const original = base.project.members.find(({ kind }) => kind === '佯딀씮')!\r\n    const project: Project = {\r\n      ...base.project,\r\n      unitMass: entry.unitMassKgPerM,\r\n      members: base.project.members.map((member) =>\r\n        member.id === original.id\r\n          ? {\r\n              ...member,\r\n              openings: [\r\n                {\r\n                  id: `${entry.id}-opening`,\r\n                  xMm: 2400,\r\n                  yMm: 2400,\r\n                  widthMm: 1200,\r\n                  heightMm: 1200,\r\n                  reinforcements: entry.reinforcements,\r\n                },\r\n              ],\r\n            }\r\n          : member,\r\n      ),\r\n    }\r\n    const member = project.members.find(({ kind }) => kind === '佯딀씮')!\r\n\r\n    return {\r\n      project,\r\n      rebars: generateSlabRebar(\r\n        { run: slabRun(project, member, 'X'), section: slabSection() },\r\n        jpMlitRulePack,\r\n      ),\r\n    }\r\n  }\r\n\r\n  it.each(openingReinforcementCases)('$id ??$handDerivation', (entry) => {\r\n    const generated =\r\n      entry.memberKind === '?먬쐡鶯? ? wallInput(entry) : slabInput(entry)\r\n    const reinforcementRebars = generated.rebars.filter(\r\n      ({ role }) => role === '?뗥룭獒쒎섭嶺?,\r\n    )\r\n    const reinforcementLines = massLines(\r\n      aggregateQuantity(generated.project, generated.rebars, jpMlitRulePack),\r\n    ).filter(({ role }) => role === '?뗥룭獒쒎섭嶺?)\r\n\r\n    expect(reinforcementRebars).toHaveLength(entry.expected.length)\r\n    expect(reinforcementLines).toHaveLength(entry.expected.length)\r\n\r\n    for (const expected of entry.expected) {\r\n      const rebar = reinforcementRebars.find(\r\n        ({ size }) => size === expected.size,\r\n      )!\r\n      const line = reinforcementLines.find(\r\n        ({ size }) => size === expected.size,\r\n      )!\r\n\r\n      expect(rebar).toMatchObject({\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: expected.size,\r\n        count: expected.count,\r\n        length: expected.lengthMm,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [expected.lengthMm, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      })\r\n      expect(rebar).not.toHaveProperty('zones')\r\n      expect(rebar).not.toHaveProperty('placement')\r\n      expect(rebar.formula).toContain('鼇?쮫?녔쎑邕?쮼')\r\n      expect(rebar.formula).toContain('1?싧뎴8)')\r\n      expect(line.countPerMember).toBe(expected.count)\r\n      expect(line.lengthMm).toBe(expected.lengthMm)\r\n      expect(line.unitMassKgPerM).toBe(\r\n        entry.unitMassKgPerM[expected.size] ?? null,\r\n      )\r\n      expect(line.designKg, entry.handDerivation).toBe(expected.designKg)\r\n      expect(line.requiredKg, entry.handDerivation).toBe(expected.requiredKg)\r\n    }\r\n  })\r\n\r\n  it('does not add a rule-pack entry for transcribed reinforcement values', () => {\r\n    expect(\r\n      jpMlitRulePack.entries.filter(({ key }) =>\r\n        key.startsWith('measure.opening.reinforcement'),\r\n      ),\r\n","exit_code":0,"status":"completed"}}
