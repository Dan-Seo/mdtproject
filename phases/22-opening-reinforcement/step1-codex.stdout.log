ace Story {\\r\\n  id: string\\r\\n  name: string\\r\\n  height: number\\r\\n}\\r\\n\\r\\nexport interface Project {\\r\\n  schemaVersion: number\\r\\n  name: string\\r\\n  grid: Grid\\r\\n  stories: Story[]\\r\\n  sections: Section[]\\r\\n  members: Member[]\\r\\n  /** ?댁뿭???숃? QuantityLine.id瑜??ㅻ줈 ?대떎. 媛믪씠 ?녿뒗 ?됱? ???먯껜媛 ?녿떎. */\\r\\n  notes?: Record<string, string>\\r\\n  /**\\r\\n   * 孃꾨퀎 ?섆퐤蘊ら뇧 (kg/m) ???⑴뵪?끻뀯?? 誘몄엯??孃꾩? ?ㅺ? ?녿떎.\\r\\n   * 洹쒖???JIS???꾩엫??媛믪씠??猷고뙥???꾨땲???꾨줈?앺듃媛 ?ㅺ퀬 ?덈떎.\\r\\n   */\\r\\n  unitMass?: Partial<Record<ShearBarSize, number>>\\r\\n}\\r\\n\\r\\nexport function gridPointCount(grid: Grid): { nx: number; ny: number } {\\r\\n  return {\\r\\n    nx: grid.xSpans.length + 1,\\r\\n    ny: grid.ySpans.length + 1,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function gridPoint(\\r\\n  grid: Grid,\\r\\n  ix: number,\\r\\n  iy: number,\\r\\n): { x: number; y: number } {\\r\\n  const { nx, ny } = gridPointCount(grid)\\r\\n\\r\\n  if (\\r\\n    !Number.isInteger(ix) ||\\r\\n    !Number.isInteger(iy) ||\\r\\n    ix < 0 ||\\r\\n    ix >= nx ||\\r\\n    iy < 0 ||\\r\\n    iy >= ny\\r\\n  ) {\\r\\n    throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\\r\\n    y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * storyId??\\\"1F\\\" 媛숈? letter+digit ?쇰꺼?대씪 猷고뙥 ?곸닔(D25 ??? 媛믪쓽\\r\\n * 紐⑥뼇留뚯쑝濡?援щ텇?섏? ?딅뒗????telemetry.ts???ㅽ겕?щ쾭??letter+digit\\r\\n * ?좏겙???듭㎏濡??④린誘濡? 洹몃깷 蹂닿컙?섎㈃ ???쇰꺼??洹몃?濡??덉뼱 ?섍컙??9李?\\n * 由щ럭 critical). JSON 釉붾줉?쇰줈 媛먯떥硫??ㅽ겕?щ쾭??`{...}` 洹쒖튃??嫄몃┛??\\r\\n * ???щ㎎???⑥닔 ?섎굹濡?怨좎젙???ㅼ쓬 ?몄텧遺媛 洹쒖빟???먯쑝濡??ㅼ떆 踰좊겮吏\\r\\n * ?딄쾶 ?쒕떎(9李?由щ럭 minor).\\r\\n */\\r\\nexport function storyNotFound(storyId: string): Error {\\r\\n  return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\\r\\n}\\r\\n\\r\\n/** 痢?諛붾떏???꾩쟻 ?쒓퀬(mm). stories 諛곗뿴 ?쒖꽌?濡??꾨옒痢?height瑜??꾩쟻?쒕떎. */\\r\\nexport function storyElevation(stories: Story[], storyId: string): number {\\r\\n  const index = stories.findIndex(({ id }) => id === storyId)\\r\\n\\r\\n  if (index < 0) {\\r\\n    throw storyNotFound(storyId)\\r\\n  }\\r\\n\\r\\n  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\\r\\n}\\r\\n\\r\\nexport function findSection(project: Project, sectionId: string): Section {\\r\\n  const section = project.sections.find(({ id }) => id === sectionId)\\r\\n\\r\\n  if (!section) {\\r\\n    throw new Error(`Section not found: ${sectionId}`)\\r\\n  }\\r\\n\\r\\n  return section\\r\\n}\\r\\n\\r\\nexport function memberGroupKey(project: Project, member: Member): string {\\r\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\r\\n  if (!story) {\\r\\n    throw storyNotFound(member.storyId)\\r\\n  }\\r\\n\\r\\n  const section = findSection(project, member.sectionId)\\r\\n  if (section.kind !== member.kind) {\\r\\n    throw new Error(\\r\\n      `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const memberCode = MEMBER_GROUP_CODE[member.kind]\\r\\n  return `${story.name}|${memberCode}|${section.mark}`\\r\\n}\\r\\n\\r\\n/** ?낁㉢?멥겗?겹꺂?쇈깤?듐겓鵝욍걝?ⓩ쓲?녈꺖?됥귞Е??mark)?③쉸??뼋?ユ뙚?얇굥訝?뉐춻??*/\\r\\nconst MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\\r\\n  ?? 'C',\\r\\n  鸚㎪쥈: 'G',\\r\\n  ?먬쐡鶯? 'W',\\r\\n  佯딀씮: 'S',\\r\\n}\\r\\n\\r\\nfunction isColumnPosition(\\r\\n  position: ColumnPosition | GirderPosition,\\r\\n): position is ColumnPosition {\\r\\n  return !('axis' in position)\\r\\n}\\r\\n\\r\\nfunction isGirderPosition(\\r\\n  position: ColumnPosition | GirderPosition,\\r\\n): position is GirderPosition {\\r\\n  return 'axis' in position\\r\\n}\\r\\n\\r\\nfunction touchesColumn(\\r\\n  girder: GirderPosition,\\r\\n  column: ColumnPosition,\\r\\n): boolean {\\r\\n  if (girder.axis === 'X') {\\r\\n    return (\\r\\n      girder.iy === column.iy &&\\r\\n      (girder.ix === column.ix || girder.ix + 1 === column.ix)\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return (\\r\\n    girder.ix === column.ix &&\\r\\n    (girder.iy === column.iy || girder.iy + 1 === column.iy)\\r\\n  )\\r\\n}\\r\\n\\r\\nexport interface GirderSpan {\\r\\n  axis: 'X' | 'Y'\\r\\n  /** 洹몃━??援먯젏 媛?以묒떖 ?ㅽ뙩 (mm) */\\r\\n  centerSpan: number\\r\\n  /** ?끾퀡?룔걬 (mm) ???묐떒 ?깁씊 ?ъ씠 */\\r\\n  clear: number\\r\\n  /** ?쒖옉 ??以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\\r\\n  startFaceOffsetMm: number\\r\\n  /** ????以묒떖 ??鸚㎪쥈 ?댁륫 ?깁씊 ?ㅽ봽??(mm) */\\r\\n  endFaceOffsetMm: number\\r\\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ???쒖옉 ?깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\\r\\n  startSupportLengthAlongAxisMm: number\\r\\n  /** ?뺤갑 ?섏슜??寃?ъ슜 ?????깆쓽 異뺣갑???꾩껜 移섏닔 (mm) */\\r\\n  endSupportLengthAlongAxisMm: number\\r\\n  /** 吏???깆쓽 ?뗣겤??議고쉶 議곌굔 ??塋?깿?▽뻑? 鸚㎪쥈???꾨땲???깆쓽 ?뗣겤?딅줈 ?먯젙?쒕떎 */\\r\\n  startSupportCover: Record<string, string | boolean>\\r\\n  endSupportCover: Record<string, string | boolean>\\r\\n}\\r\\n\\r\\nexport function girderSupportSections(\\r\\n  project: Project,\\r\\n  member: Member,\\r\\n): { start: ColumnSection; end: ColumnSection } {\\r\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\r\\n    throw new Error(`girderSupportSections requires a 鸚㎪쥈: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const { axis, ix, iy } = member.position\\r\\n  const endIx = axis === 'X' ? ix + 1 : ix\\r\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\r\\n\\r\\n  return {\\r\\n    start: supportColumnSection(project, member, ix, iy, 'start'),\\r\\n    end: supportColumnSection(project, member, endIx, endIy, 'end'),\\r\\n  }\\r\\n}\\r\\n\\r\\nfunction supportColumnSection(\\r\\n  project: Project,\\r\\n  supported: Member,\\r\\n  ix: number,\\r\\n  iy: number,\\r\\n  end: 'start' | 'end',\\r\\n): ColumnSection {\\r\\n  const support = project.members.find(\\r\\n    (candidate) =>\\r\\n      candidate.kind === '?? &&\\r\\n      candidate.storyId === supported.storyId &&\\r\\n      isColumnPosition(candidate.position) &&\\r\\n      candidate.position.ix === ix &&\\r\\n      candidate.position.iy === iy,\\r\\n  )\\r\\n\\r\\n  if (!support) {\\r\\n    throw new Error(\\r\\n      `Missing ${end} support ??for ${supported.kind}: ${supported.id}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const section = findSection(project, support.sectionId)\\r\\n  if (section.kind !== '??) {\\r\\n    throw new Error(`??member references a non-??section: ${support.id}`)\\r\\n  }\\r\\n\\r\\n  return section\\r\\n}\\r\\n\\r\\nexport function girderSpan(project: Project, member: Member): GirderSpan {\\r\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\r\\n    throw new Error(`girderSpan requires a 鸚㎪쥈: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const { axis, ix, iy } = member.position\\r\\n  const endIx = axis === 'X' ? ix + 1 : ix\\r\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\r\\n  const startPoint = gridPoint(project.grid, ix, iy)\\r\\n  const endPoint = gridPoint(project.grid, endIx, endIy)\\r\\n  const { start: startSection, end: endSection } = girderSupportSections(\\r\\n    project,\\r\\n    member,\\r\\n  )\\r\\n  const centerSpan =\\r\\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\\r\\n  const startSupportLengthAlongAxisMm =\\r\\n    axis === 'X' ? startSection.b : startSection.d\\r\\n  const endSupportLengthAlongAxisMm =\\r\\n    axis === 'X' ? endSection.b : endSection.d\\r\\n  const startFaceOffsetMm = startSupportLengthAlongAxisMm / 2\\r\\n  const endFaceOffsetMm = endSupportLengthAlongAxisMm / 2\\r\\n  const clear = centerSpan - startFaceOffsetMm - endFaceOffsetMm\\r\\n\\r\\n  if (clear <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `鸚㎪쥈 ?끾퀡?룔걬 must be positive: ${member.id} (${clear} mm)`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    axis,\\r\\n    centerSpan,\\r\\n    clear,\\r\\n    startFaceOffsetMm,\\r\\n    endFaceOffsetMm,\\r\\n    startSupportLengthAlongAxisMm,\\r\\n    endSupportLengthAlongAxisMm,\\r\\n    startSupportCover: coverConditions(startSection),\\r\\n    endSupportCover: coverConditions(endSection),\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?먬쐡鶯곥겗?끾퀡野멩퀡?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬??\\n * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곩즯??쳵?뺛굚?룔걬?귚릎恙껈뼋?㎯겘?ゃ걦?끾퀡?㎯걗?뗣?\\n * ?긱꺕鸚㎪쥈?ⓧ틠?띹쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?앫겗?귙겗?㎯곩ㄷ歟곥걣?끾퀡?룔걬?ゃ겗?ⓨ릪?섇숱?졼?\\n */\\r\\nexport interface WallSpan {\\r\\n  axis: 'X' | 'Y'\\r\\n  /** ?끾퀡?룔걬 (mm) ??訝▼겢??윶??냵?닻씊??뼋 */\\r\\n  clearLengthMm: number\\r\\n  /** ?끾퀡遙섅걬 (mm) ???롩쳵 ??訝딃깿鸚㎪쥈?쎼걚 */\\r\\n  clearHeightMm: number\\r\\n  /** 冶뗧ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\\r\\n  startFaceOffsetMm: number\\r\\n  /** 永귞ク??윶訝?퓘 ??鶯곭ク竊덃윶?끻겢??펹?얇겎??궕?뺛궩?껁깉 (mm) */\\r\\n  endFaceOffsetMm: number\\r\\n  /** ?끾퀡遙섅걬?믤군?곥걼訝딃깿鸚㎪쥈??걵??(mm) */\\r\\n  girderDepthAboveMm: number\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鶯곥겗訝듽겓雍됥굥鸚㎪쥈??걵?꾠귛즯?ⓨ릪?섋씌竊덂릪?섌싥굤??꺕?뚣걯?밤깙?놂펹??ㄷ歟곥굮誤뗣굥 ??\\n * ?먬쐡鶯곥겘2?с겗?긱겗?볝겓塋뗣걾?곥걹??툓??ㄷ歟곥겎??굮閭㏂굙?됥굦?뗣걢?됥겎?귙굥??\\n *\\r\\n * 誤뗣겇?뗣굢?ゃ걨?뚣겙?ε뒟??툖?닷릦?ゃ겗?㏝퍢?ｃ겍?롩쳵?믢슴?뤵겒?꾠귛ㄷ歟곥겗?ゃ걚渦뷩겓鶯곥굮\\r\\n * 營?걦?ⓨ냵力뺡쳵?뺛걣黎뷩겲?됥걳?곲쉸遙섅겎餓ｇ뵪?쇻굦?겼ㄷ歟곥겏?띲겒?ｃ걼鶯곥굮鼇덁툓?쀣겍?쀣겲?녴?\\n */\\r\\nfunction girderDepthAboveWall(project: Project, wall: Member): number {\\r\\n  const position = wall.position\\r\\n  if (!isGirderPosition(position)) {\\r\\n    throw new Error(`girderDepthAboveWall requires an edge position: ${wall.id}`)\\r\\n  }\\r\\n\\r\\n  const girder = project.members.find(\\r\\n    (candidate) =>\\r\\n      candidate.kind === '鸚㎪쥈' &&\\r\\n      candidate.storyId === wall.storyId &&\\r\\n      isGirderPosition(candidate.position) &&\\r\\n      candidate.position.axis === position.axis &&\\r\\n      candidate.position.ix === position.ix &&\\r\\n      candidate.position.iy === position.iy,\\r\\n  )\\r\\n\\r\\n  if (!girder) {\\r\\n    throw new Error(`Missing 鸚㎪쥈 above ?먬쐡鶯? ${wall.id}`)\\r\\n  }\\r\\n\\r\\n  const section = findSection(project, girder.sectionId)\\r\\n  if (section.kind !== '鸚㎪쥈') {\\r\\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\\r\\n  }\\r\\n\\r\\n  return section.depth\\r\\n}\\r\\n\\r\\nexport function wallSpan(project: Project, member: Member): WallSpan {\\r\\n  if (member.kind !== '?먬쐡鶯? || !isGirderPosition(member.position)) {\\r\\n    throw new Error(`wallSpan requires a ?먬쐡鶯? ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const story = project.stories.find(({ id }) => id === member.storyId)\\r\\n  if (!story) {\\r\\n    throw storyNotFound(member.storyId)\\r\\n  }\\r\\n\\r\\n  const { axis, ix, iy } = member.position\\r\\n  const endIx = axis === 'X' ? ix + 1 : ix\\r\\n  const endIy = axis === 'Y' ? iy + 1 : iy\\r\\n  const startPoint = gridPoint(project.grid, ix, iy)\\r\\n  const endPoint = gridPoint(project.grid, endIx, endIy)\\r\\n  const startSection = supportColumnSection(project, member, ix, iy, 'start')\\r\\n  const endSection = supportColumnSection(project, member, endIx, endIy, 'end')\\r\\n\\r\\n  const centerSpan =\\r\\n    axis === 'X' ? endPoint.x - startPoint.x : endPoint.y - startPoint.y\\r\\n  const startFaceOffsetMm =\\r\\n    (axis === 'X' ? startSection.b : startSection.d) / 2\\r\\n  const endFaceOffsetMm = (axis === 'X' ? endSection.b : endSection.d) / 2\\r\\n  const clearLengthMm = centerSpan - startFaceOffsetMm - endFaceOffsetMm\\r\\n\\r\\n  if (clearLengthMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?먬쐡鶯??끾퀡?룔걬 must be positive: ${member.id} (${clearLengthMm} mm)`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const girderDepthAboveMm = girderDepthAboveWall(project, member)\\r\\n  const clearHeightMm = story.height - girderDepthAboveMm\\r\\n\\r\\n  if (clearHeightMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?먬쐡鶯??끾퀡遙섅걬 must be positive: ${member.id} ` +\\r\\n        `(?롩쳵 ${story.height} ??訝딃깿鸚㎪쥈?쎼걚 ${girderDepthAboveMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    axis,\\r\\n    clearLengthMm,\\r\\n    clearHeightMm,\\r\\n    startFaceOffsetMm,\\r\\n    endFaceOffsetMm,\\r\\n    girderDepthAboveMm,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * 佯딀씮竊덀궧?⒲깣竊??쇻궎??냵力뺝?力뺛겏?곩썪渦뷩겎?쀣걨?뗥ㄷ歟곥?\\n *\\r\\n * 翁?퐪??뙷?놅펷寧?渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲?뗦객亮녔쓲??냵力뺡깿?녴?\\n * ?ⓨ츣?곥굥??겎?곫릍?뗣겗??싥굤??뼋?㎯겘?ゃ걦鸚㎪쥈??냵?닻씊??뼋?㎯걗?뗣귝윶?삣ㄷ歟곥겏\\r\\n * 雅뚪뇥鼇덁툓?쀣겒?꾠겗??걪??츣獰⒲걹??굚??겎?곩ㄷ歟곥걣?끾퀡?룔걬?삣즯?뚦냵力뺡깿?녴겒??겏?뚣걯壤㏂걽??\\n */\\r\\nexport interface SlabBay {\\r\\n  /** ?싥굤??뼋?밤깙??(mm) */\\r\\n  centerSpanXMm: number\\r\\n  centerSpanYMm: number\\r\\n  /** ?끾퀡?룔걬 (mm) ??X?밧릲??륫?담겗 Y?싥굤鸚㎪쥈??냵?닻씊??뼋 */\\r\\n  clearXMm: number\\r\\n  clearYMm: number\\r\\n  /** ?쇻궎?잏궧??졏耶먪궧?뗣굢?끾퀡?잆겗?잏궧?얇겎??퇌??(mm) 竊??쀣걨?뗥ㄷ歟곩퉭??/2 */\\r\\n  startFaceOffsetXMm: number\\r\\n  startFaceOffsetYMm: number\\r\\n  /** ?쏂씌?㎩룛?묆굥鸚㎪쥈?괱?밧릲??냵力뺛굮黎뷩굙?뗣겗??minX?팵axX竊늍?싥굤鸚㎪쥈竊됥겎?귙굥 */\\r\\n  supports: {\\r\\n    minX: SlabEdgeSupport\\r\\n    maxX: SlabEdgeSupport\\r\\n    minY: SlabEdgeSupport\\r\\n    maxY: SlabEdgeSupport\\r\\n  }\\r\\n}\\r\\n\\r\\n/** 佯딀씮嶺뗣걣若싩??쀣겍?꾠걦?덀겗鸚㎪쥈1?с?*/\\r\\nexport interface SlabEdgeSupport {\\r\\n  memberId: string\\r\\n  /** 鸚㎪쥈??퉭 b (mm) ??佯딀씮嶺뗣겘?볝겗訝?겦若싩??쇻굥 */\\r\\n  widthMm: number\\r\\n  /** 若싩??뚨킀?얇굥?뗣겗?ㅵ츣??뵱?뱄펷鸚㎪쥈竊됥겗?뗣겤?듽겎烏뚣걝 ??佯딀씮??굚??겎??겒??*/\\r\\n  cover: Record<string, string | boolean>\\r\\n}\\r\\n\\r\\nfunction isSlabPosition(\\r\\n  position: ColumnPosition | GirderPosition,\\r\\n): position is SlabPosition {\\r\\n  return !('axis' in position)\\r\\n}\\r\\n\\r\\nfunction girderSectionAt(\\r\\n  project: Project,\\r\\n  storyId: string,\\r\\n  axis: 'X' | 'Y',\\r\\n  ix: number,\\r\\n  iy: number,\\r\\n  requestedBy: Member,\\r\\n): { member: Member; section: GirderSection } {\\r\\n  const girder = project.members.find(\\r\\n    (candidate) =>\\r\\n      candidate.kind === '鸚㎪쥈' &&\\r\\n      candidate.storyId === storyId &&\\r\\n      isGirderPosition(candidate.position) &&\\r\\n      candidate.position.axis === axis &&\\r\\n      candidate.position.ix === ix &&\\r\\n      candidate.position.iy === iy,\\r\\n  )\\r\\n\\r\\n  // ?쏂씌??겑?뚣걢?뚧쵟?묆굥?ⓨ냵力뺛걣黎뷩겲?됥겒?꾠귡싥굤??뼋?㏛빰?ⓦ걲?뚣겙鸚㎪쥈?③뇥?ゃ겂??\\n  // 佯딀씮?믦쮫訝듽걮?╉걮?얇걝??겎?곲퍢?ｃ겍?뗣굙?ゃ걚 ??鶯곥겗訝딃깿鸚㎪쥈?ⓨ릪?섉돮?꾠겎?귙굥??\\n  if (!girder) {\\r\\n    throw new Error(\\r\\n      `Missing ${axis}?싥굤鸚㎪쥈 beside 佯딀씮: ${requestedBy.id} (${ix}, ${iy})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const section = findSection(project, girder.sectionId)\\r\\n  if (section.kind !== '鸚㎪쥈') {\\r\\n    throw new Error(`鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`)\\r\\n  }\\r\\n\\r\\n  return { member: girder, section }\\r\\n}\\r\\n\\r\\nexport function slabBay(project: Project, member: Member): SlabBay {\\r\\n  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\\r\\n    throw new Error(`slabBay requires a 佯딀씮: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const { ix, iy } = member.position\\r\\n  const origin = gridPoint(project.grid, ix, iy)\\r\\n  const far = gridPoint(project.grid, ix + 1, iy + 1)\\r\\n\\r\\n  const edge = (\\r\\n    axis: 'X' | 'Y',\\r\\n    edgeIx: number,\\r\\n    edgeIy: number,\\r\\n  ): SlabEdgeSupport => {\\r\\n    const { member: girder, section } = girderSectionAt(\\r\\n      project,\\r\\n      member.storyId,\\r\\n      axis,\\r\\n      edgeIx,\\r\\n      edgeIy,\\r\\n      member,\\r\\n    )\\r\\n    return {\\r\\n      memberId: girder.id,\\r\\n      widthMm: section.b,\\r\\n      cover: coverConditions(section),\\r\\n    }\\r\\n  }\\r\\n\\r\\n  // X?밧릲??냵力뺛굮黎뷩굙?뗣겗??Y?싥굤竊덄를?ヨ뎔?뗰펹鸚㎪쥈??퉭?㎯걗????壅겹굥?묆걤??\\n  // 亮끹굮歷с굥?묆걤?뚨쎍雅ㅳ걲?뗣겗?㎯곥걪?볝굮?뽧굤?뺛걟?뗣겏?끾퀡?뚦뀯?뚧쎘?뤵굥??\\n  const supports = {\\r\\n    minX: edge('Y', ix, iy),\\r\\n    maxX: edge('Y', ix + 1, iy),\\r\\n    minY: edge('X', ix, iy),\\r\\n    maxY: edge('X', ix, iy + 1),\\r\\n  }\\r\\n\\r\\n  const centerSpanXMm = far.x - origin.x\\r\\n  const centerSpanYMm = far.y - origin.y\\r\\n  const startFaceOffsetXMm = supports.minX.widthMm / 2\\r\\n  const startFaceOffsetYMm = supports.minY.widthMm / 2\\r\\n  const clearXMm =\\r\\n    centerSpanXMm - startFaceOffsetXMm - supports.maxX.widthMm / 2\\r\\n  const clearYMm =\\r\\n    centerSpanYMm - startFaceOffsetYMm - supports.maxY.widthMm / 2\\r\\n\\r\\n  if (clearXMm <= 0 || clearYMm <= 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `佯딀씮 ?끾퀡?룔걬 must be positive: ${member.id} ` +\\r\\n        `(X ${clearXMm} mm, Y ${clearYMm} mm)`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    centerSpanXMm,\\r\\n    centerSpanYMm,\\r\\n    clearXMm,\\r\\n    clearYMm,\\r\\n    startFaceOffsetXMm,\\r\\n    startFaceOffsetYMm,\\r\\n    supports,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?뚥???씊??틞?욍걣鸚㎪쥈?믧싥걮??ｃ겒?뗧칱?????곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞??) ??\\n * ?뚦릪訝??푶??말嶺뗣걣歟곥곩즯嶺됥굮?싥걮??ｇ텥?쇻굥?닷릦?띲걣?볝굦?㎯걗?뗣?\\n *\\r\\n * 鸚㎪쥈??꺀??(girderRun) ?ⓨ릪?섇숱?졼??쇻궎?ゃ굢?룔걬1??꺀?녈겎?뚦뜕?у틞?욍띲?\\n * 2?쇻궎餓δ툓?ゃ굢?뚪ｇ텥?쇻굥佯딀씮?띲겓?ゃ굤?곭텤?뗧츋??겹겗?→뻼??2竊덌폇竊됧틞??) ??\\n * ?뉎굤?욍굩?뗣괱?밧릲?쮇?밧릲?㎩닪??꺀?녈굮?곥겇 ??佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥?뗣굢?졼?\\n */\\r\\nexport interface SlabRun {\\r\\n  axis: 'X' | 'Y'\\r\\n  /** 邕멩뼶?묆겗?뉔젂?귛뜕?у틞?욍겒?됮빓?? */\\r\\n  members: Member[]\\r\\n  /** ?싥걮嶺뗣굮躍겼콪?뺛걵?뗩깿??竊?members[0].id */\\r\\n  ownerId: string\\r\\n  /** members ?ⓨ릪?섌젂佯?*/\\r\\n  bays: SlabBay[]\\r\\n  /**\\r\\n   * ?⒲꺍?잏궧竊덂쭓塋?겗鸚㎪쥈??냵?닻씊竊됥걢?됧릢?쇻궎??냵力뺝윜??쭓?얇굤?얇겎??퇌??(mm)??\\n   * bays ?ⓨ릪?섌젂佯뤵겎 [0] ??0 ?㎯걗?뗣?D ?뚣꺀?녈굮1?ㅳ겗?졼겓?뤵걦?ⓦ걤??\\n   * ?꾠깧?ㅳ겗嶸긱굮?볝걪?ョ쉰?????뤹뵽?담겎擁녈걮?담걲?③뀓嶺뗣겏?싥굦?뗣?\\n   */\\r\\n  memberOffsetsMm: number[]\\r\\n  /** ?⒲꺍??빓 (mm) 竊?誇?끾퀡?룔걬 竊?誇訝?뼋鸚㎪쥈??퉭 */\\r\\n  coreLengthMm: number\\r\\n  /** ?꿜퍡?밧릲竊덁말嶺뗣겏?답벡?쇻굥?묆걤竊됥겗?끾퀡?룔걬 (mm) ???⒲꺍?끹겎?깁싥겎?귙굥 */\\r\\n  distributionClearMm: number\\r\\n  /** 冶뗧ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\\r\\n  startSupport: SlabEdgeSupport\\r\\n  /** 永귞ク?㎩츣??쀣겍?꾠걦鸚㎪쥈 */\\r\\n  endSupport: SlabEdgeSupport\\r\\n  /**\\r\\n   * ?⒲꺍?ラ뼀?꾠겍?꾠굥?뗥룭??(1?싧뎴8))??*?⒲꺍?잏궧?뗣굢??벨與?*?ョ쎍?쀣걼?귙겗??\\n   *\\r\\n   * ?뗥룭??깧?ㅿ펷竊앶깿?먲펹?붵겏?ュ뀯?쎼걬?뚣굥?뚣곩틞?욍겗?꾤춮??꺀?녈겎歷с굥??겎??\\n   * 轝좈솮??D??늾?딀쵟?띲굚?⒲꺍佯㎪쮽?㎬쫳?뗣귙걪?볝겎訝佯╉걽?묊쎍?쀣겍?듽걢?ゃ걚?ⓦ?\\n   * ?곈뇧?②〃鹽뷩걣?γ끹겓?쇻궎??궕?뺛궩?껁깉?믦떨?쀧쎍?쀣겍繇잆걚?뺛걝 (ADR-029)??\\n   */\\r\\n  openings: Opening[]\\r\\n}\\r\\n\\r\\nexport function slabRun(\\r\\n  project: Project,\\r\\n  member: Member,\\r\\n  axis: 'X' | 'Y',\\r\\n): SlabRun {\\r\\n  if (member.kind !== '佯딀씮' || !isSlabPosition(member.position)) {\\r\\n    throw new Error(`slabRun requires a 佯딀씮: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const { ix, iy } = member.position\\r\\n  const slabAt = (\\r\\n    candidateIx: number,\\r\\n    candidateIy: number,\\r\\n  ): Member | undefined =>\\r\\n    project.members.find(\\r\\n      (candidate) =>\\r\\n        candidate.kind === '佯딀씮' &&\\r\\n        candidate.storyId === member.storyId &&\\r\\n        // ?뚥???씊?㎯걗?뗣걪?ⓦ굮?ｇ텥??씉餓뜰겓?쇻굥?귝씉?뉎겘?뚦릪訝??푶??말嶺뗣걣?띲겏\\r\\n        // 鼇?녴걣?곩푶?뚦릪?섅겎?귙깞?껁긽?뚪걬?덀겙?③깿??뎱嶺뗣걣?싥굥?뤵걨?㎯겘?ゃ걚 ??\\n        // ??씊?뚦릪?섅걪?ⓦ겘?앫겗?곩늽?▽뻑?㎯걗?ｃ겍?곩쎋?㏂겓?ゃ걚?ｇ텥?믢퐳?됥겒?꾠?\\n        candidate.sectionId === member.sectionId &&\\r\\n        isSlabPosition(candidate.position) &&\\r\\n        candidate.position.ix === candidateIx &&\\r\\n        candidate.position.iy === candidateIy,\\r\\n    )\\r\\n\\r\\n  const step = (offset: number): [number, number] =>\\r\\n    axis === 'X' ? [ix + offset, iy] : [ix, iy + offset]\\r\\n\\r\\n  const members: Member[] = [member]\\r\\n  for (let offset = -1; ; offset -= 1) {\\r\\n    const previous = slabAt(...step(offset))\\r\\n    if (!previous) break\\r\\n    members.unshift(previous)\\r\\n  }\\r\\n  for (let offset = 1; ; offset += 1) {\\r\\n    const next = slabAt(...step(offset))\\r\\n    if (!next) break\\r\\n    members.push(next)\\r\\n  }\\r\\n\\r\\n  const bays = members.map((candidate) => slabBay(project, candidate))\\r\\n  const clearAlong = (bay: SlabBay): number =>\\r\\n    axis === 'X' ? bay.clearXMm : bay.clearYMm\\r\\n  const clearAcross = (bay: SlabBay): number =>\\r\\n    axis === 'X' ? bay.clearYMm : bay.clearXMm\\r\\n\\r\\n  // ?꿜퍡?ф빊??1?싧뎴7) ?뚣뚣걹??깿?녴겗?룔걬?띲굮?꾤춮??뼋?붵겎?ㅳ걮??콆?곥굥1?ㅳ겗?겹걽??\\n  // ?⒲꺍??붶릎?㎫쎍雅ㅶ뼶?묆겗?끾퀡?뚦쨯?뤵굦?겹곥걹???ㅳ겗?겹걣?⒲걾?됥겗?쇻궎?㎯굚閭ｃ걮??\\n  // ?ゃ굢?ゃ걚 ??訝?ⓦ걽?묌싥굥?꾤춮?믦＝?곥걣烏①뤎?㎯걤?ゃ걚??겎?곦퐳?됥걳?ヨ맼?ⓦ걲??\\n  const distributionClearMm = clearAcross(bays[0])\\r\\n  const uneven = bays.findIndex(\\r\\n    (bay) => clearAcross(bay) !== distributionClearMm,\\r\\n  )\\r\\n  if (uneven > 0) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `佯딀씮?⒲꺍?끹겎?꿜퍡?밧릲??냵力뺡빓?뺛걣?껁굩?ゃ걚: ${members[0].id} ` +\\r\\n        `(${distributionClearMm} mm) ??${members[uneven].id} ` +\\r\\n        `(${clearAcross(bays[uneven])} mm)`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  // 訝?뼋鸚㎪쥈??퉭??뚦퉭??/2?띲걣訝▼겢?뗣굢?γ겍1?у늽?ャ겒????2竊덌폇竊됧틞??) ??\\n  // 鵝녷쎑?뚣걹?녶츣?곥굥?귛ㄷ歟곥겗?⒲꺍??빓?뚥릎?볠윶?쎼걚?믦떨?쇻겗?ⓨ릪?섇숱?졼?\\n  // ?쇻궎??쭓?얇굤?믢?佯╉걽?묊눕令띲걮?곫?孃뚣겗?쇻궎??쭓?얇굤 竊??앫겗?끾퀡?믦뒸?룔겏?쇻굥 ??\\n  // 雅뚣겇?믣닪?끹겓?겹걟?뗣겏?쇻걧繇잆걚?뺛걝竊덂ㄷ歟곥겗?⒲꺍?ⓨ릪?섊큵?잞펹??\\n  const memberOffsetsMm: number[] = []\\r\\n  let offsetMm = 0\\r\\n  for (const bay of bays) {\\r\\n    memberOffsetsMm.push(offsetMm)\\r\\n    offsetMm +=\\r\\n      clearAlong(bay) +\\r\\n      (axis === 'X' ? bay.supports.maxX : bay.supports.maxY).widthMm\\r\\n  }\\r\\n  const coreLengthMm =\\r\\n    memberOffsetsMm[memberOffsetsMm.length - 1] +\\r\\n    clearAlong(bays[bays.length - 1])\\r\\n\\r\\n  const first = bays[0]\\r\\n  const last = bays[bays.length - 1]\\r\\n\\r\\n  // ?쇻궎掠???뼀?ｃ굮?⒲꺍佯㎪쮽?며㎉?쇻귟뎔?뗥릲?띲겓?졼걨?쇻궎??궕?뺛궩?껁깉?뚥퉿????\\n  // ?답벡?밧릲??냵力뺛겘?⒲꺍?끹겎?깁싥겒??겎竊덁툓?㎯걹?뚣굮濾쒏읅?쀣겍?꾠굥竊됥걹??겲?얇걽??\\n  const openings = members.flatMap((candidate, index) =>\\r\\n    (candidate.openings ?? []).map((opening) => ({\\r\\n      ...opening,\\r\\n      xMm: opening.xMm + (axis === 'X' ? memberOffsetsMm[index] : 0),\\r\\n      yMm: opening.yMm + (axis === 'Y' ? memberOffsetsMm[index] : 0),\\r\\n    })),\\r\\n  )\\r\\n\\r\\n  return {\\r\\n    axis,\\r\\n    members,\\r\\n    ownerId: members[0].id,\\r\\n    bays,\\r\\n    memberOffsetsMm,\\r\\n    coreLengthMm,\\r\\n    distributionClearMm,\\r\\n    startSupport: axis === 'X' ? first.supports.minX : first.supports.minY,\\r\\n    endSupport: axis === 'X' ? last.supports.maxX : last.supports.maxY,\\r\\n    openings,\\r\\n  }\\r\\n}\\r\\n\\r\\nexport interface GirderRun {\\r\\n  axis: 'X' | 'Y'\\r\\n  /** 異뺣갑???ㅻ쫫李⑥닚. ?⑥씪 ?ㅽ뙩?대㈃ 湲몄씠 1 */\\r\\n  members: Member[]\\r\\n  /** ?싥걮嶺뗭쓣 洹?띿떆??遺??= members[0].id */\\r\\n  ownerId: string\\r\\n  /** members? 媛숈? ?쒖꽌 */\\r\\n  spans: GirderSpan[]\\r\\n  /**\\r\\n   * ???먯젏(?쒖옉 ?긱겗?끻겢???먯꽌 媛??ㅽ뙩 ?쒖옉硫닿퉴吏??嫄곕━ (mm). members? 媛숈?\\r\\n   * ?쒖꽌?닿퀬 [0]? 0?대떎.\\r\\n   *\\r\\n   * ?싥걮嶺뗭? ???꾩껜瑜????꾨젅?꾩뿉 ???留??귙겙?됬춮? 媛?遺???먭린 ?ㅽ뙩 濡쒖뺄(0 湲곗?)\\r\\n   * ?대떎. ?곗쓣 ???꾨젅?꾩뿉 洹몃━??履쎌씠 ???ㅽ봽?뗭쓣 紐⑤Ⅴ硫?2踰덉㎏ ?댄썑 ?ㅽ뙩??\\n   * ?귙겙?됬춮??1踰덉㎏ ?ㅽ뙩 ?꾩뿉 寃뱀튇??\\r\\n   */\\r\\n  memberOffsetsMm: number[]\\r\\n  /** ?싥걮嶺?肄붿뼱 湲몄씠 (mm) = 誇?끾퀡 竊?誇訝?뼋?긱겗邕멩뼶?묆걵??*/\\r\\n  coreLengthMm: number\\r\\n}\\r\\n\\r\\nfunction girderAxisIndex(position: GirderPosition): number {\\r\\n  return position.axis === 'X' ? position.ix : position.iy\\r\\n}\\r\\n\\r\\nexport function girderRun(project: Project, member: Member): GirderRun {\\r\\n  if (member.kind !== '鸚㎪쥈' || !isGirderPosition(member.position)) {\\r\\n    throw new Error(`girderRun requires a 鸚㎪쥈: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const position = member.position\\r\\n  const candidates = project.members\\r\\n    .filter((candidate) => {\\r\\n      if (\\r\\n        candidate.kind !== '鸚㎪쥈' ||\\r\\n        candidate.storyId !== member.storyId ||\\r\\n        !isGirderPosition(candidate.position) ||\\r\\n        candidate.position.axis !== position.axis\\r\\n      ) {\\r\\n        return false\\r\\n      }\\r\\n\\r\\n      return position.axis === 'X'\\r\\n        ? candidate.position.iy === position.iy\\r\\n        : candidate.position.ix === position.ix\\r\\n    })\\r\\n    .sort((left, right) => {\\r\\n      if (!isGirderPosition(left.position) || !isGirderPosition(right.position)) {\\r\\n        throw new Error('鸚㎪쥈 run contains a non-girder position')\\r\\n      }\\r\\n      return girderAxisIndex(left.position) - girderAxisIndex(right.position)\\r\\n    })\\r\\n  const memberIndex = candidates.findIndex(({ id }) => id === member.id)\\r\\n\\r\\n  if (memberIndex < 0) {\\r\\n    throw new Error(`鸚㎪쥈 member not found in project: ${member.id}`)\\r\\n  }\\r\\n\\r\\n  let first = memberIndex\\r\\n  let last = memberIndex\\r\\n  while (\\r\\n    first > 0 &&\\r\\n    girderAxisIndex(candidates[first - 1].position as GirderPosition) ===\\r\\n      girderAxisIndex(candidates[first].position as GirderPosition) - 1\\r\\n  ) {\\r\\n    first -= 1\\r\\n  }\\r\\n  while (\\r\\n    last + 1 < candidates.length &&\\r\\n    girderAxisIndex(candidates[last + 1].position as GirderPosition) ===\\r\\n      girderAxisIndex(candidates[last].position as GirderPosition) + 1\\r\\n  ) {\\r\\n    last += 1\\r\\n  }\\r\\n\\r\\n  const members = candidates.slice(first, last + 1)\\r\\n  const sectionId = members[0].sectionId\\r\\n  if (members.some((candidate) => candidate.sectionId !== sectionId)) {\\r\\n    throw new Error(\\r\\n      `鸚㎪쥈 run contains mixed sections: ${members.map(({ id, sectionId: idOfSection }) => `${id}:${idOfSection}`).join(', ')}`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const spans = members.map((candidate) => girderSpan(project, candidate))\\r\\n  // ?ㅽ뙩 ?쒖옉硫대뱾???꾩쟻 ?꾩튂. 留덉?留??ㅽ뙩 ?쒖옉硫?竊?洹??끾퀡??肄붿뼱 湲몄씠????\\n  // ??媛믪쓣 ?곕줈 ?몃㈃ 怨??닿툔?섎?濡???踰덈쭔 ?꾩쟻?쒕떎.\\r\\n  const memberOffsetsMm: number[] = []\\r\\n  let offsetMm = 0\\r\\n  for (const span of spans) {\\r\\n    memberOffsetsMm.push(offsetMm)\\r\\n    offsetMm += span.clear + span.endSupportLengthAlongAxisMm\\r\\n  }\\r\\n  const lastSpan = spans[spans.length - 1]\\r\\n  const coreLengthMm =\\r\\n    memberOffsetsMm[memberOffsetsMm.length - 1] + lastSpan.clear\\r\\n\\r\\n  return {\\r\\n    axis: position.axis,\\r\\n    members,\\r\\n    ownerId: members[0].id,\\r\\n    spans,\\r\\n    memberOffsetsMm,\\r\\n    coreLengthMm,\\r\\n  }\\r\\n}\\r\\n\\r\\n/**\\r\\n * ?긴말嶺뗣겗塋?깿?▽뻑 (R7?졼꺕R9????\\n *\\r\\n * 若싩?(bottom)? ?ㅽ깮??**理쒗븯??*(湲곗큹)?먮쭔 遺숇뒗?? 訝?뼋 ?묓빀遺??泥좉렐??\\n * 洹몃?濡?吏?섍?誘濡??ゃ걮??\\r\\n *\\r\\n * top? 若싩???遺숈씠吏 ?딅뒗??????긽 ?ゃ걮(以묎컙 ?묓빀遺, ?꾩링?쇰줈 ?듦낵) ?꾨땲硫?\\n * ?덄ク(?ㅽ깮 理쒖긽?? ?꾩뿉 ?깃? ?놁쓬)?대떎. ?곈뇧令띸츞?뷸틬 1?싧뎴1)?뚦뀍塋?겎閭㏂겲??\\n * ?꾤춮??곥궠?녈궚?ゃ꺖?덀겗鼇?쮫野멩퀡?믡걹??깿?녴겗?꾤춮??빓?뺛겏?쇻굥?랃펻竊덌폃竊됪윶1)\\r\\n * 鵝녷쎑?뚧?訝딃쉸?긱겗訝사춮?ャ겇?꾠겍??곻폂?싧뎴竊묕펹?ャ굠?뗣띻? ?訝딃쉸?긴말嶺뗭쓣 紐낆떆?곸쑝濡?\\n * 1?싧뎴1)??嫄몄뼱?먮?濡? ?ㅽ깮 理쒖긽?⑥? 若싩? ?놁씠 肄섑겕由ы듃 ?ㅺ퀎 移섏닔源뚯?留?\\n * 媛꾨떎(R9??. ?댁쟾?먮뒗 ?ㅽ깮 理쒖긽?⑥뿉??若싩???遺숈??붾뜲, ?대뒗 議곕Ц怨??닿툔?щ떎.\\r\\n *\\r\\n * ?묓빀遺??**泳숁뎸???ш린???ㅻ（吏 ?딅뒗??** ?곈뇧令띸츞?뷸틬 2竊덌폃竊됪윶2)媛\\r\\n * ?뚦릢?롦윶??뀲?룔겓?뤵걼?뗤말嶺뗣겓?ㅳ걚?╉겘?꾦쉸?붵겏???뗦??띾줈 ?뺥븯誘濡?痢듬쭏??\\n * 議곕Ц?濡?1?뗦??닿퀬, 洹?諛곕텇???쒗뭹???뺥븷 ?ъ?媛 ?녿떎. ?덉쟾?먮뒗 ?묓빀遺??\\n * 泳숁뎸瑜??꾩링 遺?ъ뿉 洹?띿떆?ㅻ뒗 愿?됱쓣 肄붾뱶媛 ?ㅺ퀬 ?덉뿀?붾뜲(洹몃옒??理쒗븯痢듭?\\r\\n * 泳숁뎸媛 0?댁뿀??, 議곕Ц??洹??먮━瑜???좏븳??\\r\\n *\\r\\n * ?ㅽ깮 ?쒖꽌??`stories` 諛곗뿴 ?쒖꽌瑜?洹몃?濡??좊ː?쒕떎 ??Story???덈꺼 媛믪씠 ?녿떎.\\r\\n */\\r\\nexport interface ColumnEnds {\\r\\n  bottom: '若싩?' | '?ゃ걮'\\r\\n  top: '?ゃ걮' | '?덄ク'\\r\\n}\\r\\n\\r\\nexport function columnEnds(project: Project, member: Member): ColumnEnds {\\r\\n  const { position } = member\\r\\n\\r\\n  if (member.kind !== '?? || !isColumnPosition(position)) {\\r\\n    throw new Error(`columnEnds requires a ?? ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const level = project.stories.findIndex(({ id }) => id === member.storyId)\\r\\n  if (level < 0) {\\r\\n    throw storyNotFound(member.storyId)\\r\\n  }\\r\\n\\r\\n  const hasColumnAtLevel = (candidateLevel: number): boolean => {\\r\\n    const story = project.stories[candidateLevel]\\r\\n    if (story === undefined) return false\\r\\n\\r\\n    return project.members.some(\\r\\n      (candidate) =>\\r\\n        candidate.kind === '?? &&\\r\\n        candidate.storyId === story.id &&\\r\\n        isColumnPosition(candidate.position) &&\\r\\n        candidate.position.ix === position.ix &&\\r\\n        candidate.position.iy === position.iy,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return {\\r\\n    bottom: hasColumnAtLevel(level - 1) ? '?ゃ걮' : '若싩?',\\r\\n    top: hasColumnAtLevel(level + 1) ? '?ゃ걮' : '?덄ク',\\r\\n  }\\r\\n}\\r\\n\\r\\nexport function beamDepthAbove(project: Project, member: Member): number {\\r\\n  if (member.kind !== '?? || !isColumnPosition(member.position)) {\\r\\n    throw new Error(`beamDepthAbove requires a ?? ${member.id}`)\\r\\n  }\\r\\n\\r\\n  const depths = project.members\\r\\n    .filter(\\r\\n      (candidate) =>\\r\\n        candidate.kind === '鸚㎪쥈' &&\\r\\n        candidate.storyId === member.storyId &&\\r\\n        isGirderPosition(candidate.position) &&\\r\\n        touchesColumn(candidate.position, member.position),\\r\\n    )\\r\\n    .map((girder) => {\\r\\n      const section = findSection(project, girder.sectionId)\\r\\n      if (section.kind !== '鸚㎪쥈') {\\r\\n        throw new Error(\\r\\n          `鸚㎪쥈 member references a non-鸚㎪쥈 section: ${girder.id}`,\\r\\n        )\\r\\n      }\\r\\n      return section.depth\\r\\n    })\\r\\n\\r\\n  if (depths.length === 0) {\\r\\n    throw new Error(`No touching 鸚㎪쥈 found above ?? ${member.id}`)\\r\\n  }\\r\\n\\r\\n  return Math.max(...depths)\\r\\n}\\r\\n\\r\\nexport function setNote(\\r\\n  project: Project,\\r\\n  lineId: string,\\r\\n  note: string,\\r\\n): Project {\\r\\n  const notes = { ...project.notes }\\r\\n\\r\\n  if (note === '') delete notes[lineId]\\r\\n  else notes[lineId] = note\\r\\n\\r\\n  return { ...project, notes }\\r\\n}\\r\\n\\r\\n/** 鍮??낅젰? ?ㅻ? 吏?대떎 ??0 kg/m???낅젰???꾨땲???녿뒗 媛믪씠?? */\\r\\nexport function setUnitMass(\\r\\n  project: Project,\\r\\n  size: ShearBarSize,\\r\\n  value: number | null,\\r\\n): Project {\\r\\n  const unitMass = { ...project.unitMass }\\r\\n\\r\\n  if (value === null) delete unitMass[size]\\r\\n  else unitMass[size] = value\\r\\n\\r\\n  return { ...project, unitMass }\\r\\n}\\r\\n\\r\\nexport function serializeProject(project: Project): string {\\r\\n  return JSON.stringify(project)\\r\\n}\\r\\n\\r\\nconst isString = (value: unknown): boolean => typeof value === 'string'\\r\\n\\r\\nconst isFiniteNumber = (value: unknown): boolean =>\\r\\n  typeof value === 'number' && Number.isFinite(value)\\r\\n\\r\\nfunction isRecord(value: unknown): value is Record<string, unknown> {\\r\\n  return typeof value === 'object' && value !== null && !Array.isArray(value)\\r\\n}\\r\\n\\r\\nfunction hasShape(\\r\\n  value: unknown,\\r\\n  fields: Record<string, (field: unknown) => boolean>,\\r\\n): boolean {\\r\\n  return (\\r\\n    isRecord(value) &&\\r\\n    Object.entries(fields).every(([key, check]) => check(value[key]))\\r\\n  )\\r\\n}\\r\\n\\r\\nconst isNumberArray = (value: unknown): boolean =>\\r\\n  Array.isArray(value) && value.every(isFiniteNumber)\\r\\n\\r\\n/** ?쇈겞?랃펻?ф빊??굠?녴겒弱뤵걬?ょ탡?믤쩂?곥굥??*/\\r\\nconst shapedAs =\\r\\n  (fields: Record<string, (field: unknown) => boolean>) =>\\r\\n  (value: unknown): boolean =>\\r\\n    hasShape(value, fields)\\r\\n\\r\\nconst isMainRow = (value: unknown): boolean => {\\r\\n  if (\\r\\n    !hasShape(value, {\\r\\n      endCount: isFiniteNumber,\\r\\n      centerCount: isFiniteNumber,\\r\\n    })\\r\\n  ) {\\r\\n    return false\\r\\n  }\\r\\n\\r\\n  const row = value as Record<string, unknown>\\r\\n  return row.startCount === undefined || isFiniteNumber(row.startCount)\\r\\n}\\r\\n\\r\\nconst isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\\r\\n\\r\\n/**\\r\\n * 葉?닪?붵겏?ャ?*?뽧굤渦쇈굯?좂쎍孃뚣겗鼇덄츞?뚩쫳若덀굤?ゃ걮?ュ뢿?㎯걲??*?담걽?묆굮訝╉겧?뗣?\\n *\\r\\n * ?볝걪?ョ꽒?꾢졃 (fc?팮rade?팫xposure?퍀pliceMethod ?ゃ겑) ??곫쵟?묆겍?귙꺂?쇈꺂?묆긿??\\n * 凉뺛걤?뚦릫?띲겗?귙굥堊뗥쨼?㎪??곥굥 ???⒲걪?㏛퐬?뚩떨?듽겒?꾠걢?뚨뵽?㏂겓?뷩굥??\\n * ?멥굯?㎯걗?뗣겗??TypeError ?ャ겒?뗥졃 ???앫굦?졼걨?뚣뚥퐬?뚩돈?띲걼?뗨??덀겒?꾥맼?→뼶?띲굮?쇻굥??\\n */\\r\\nconst isBarRow = shapedAs({\\r\\n  size: isString,\\r\\n  pitch: isFiniteNumber,\\r\\n  startOffsetMm: isFiniteNumber,\\r\\n})\\r\\n\\r\\n/**\\r\\n * 野멩퀡??뜷??Ŧ?γ겎?뺛걝?귝윶?삣ㄷ歟곥겘 b ?ⓦ걵?꾠걽?뚣곮먬쐡鶯곥꺕佯딀씮??thickness 訝??\\n * ????翁?퐪??뙷?녴걣鶯곥굮?뚦냵力뺡깿?녴띲곩틞?욍굮?뚦냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲빓?뺛겘\\r\\n * 鵝띸쉰?③슔??깿?먦걢?됧눣??뼪?㏂겓??꽒??(ADR-025?틻DR-028)?귛뀻?싥겗?닸???b ??\\n * 黎귙굙?뗣겏?곫??쀣걚鶯곥겗鼇섌뙯?뚦숱?뺛걚?ⓦ걮??센?뗣굦?뗣?\\n */\\r\\nconst SECTION_FIELDS: Record<\\r\\n  MemberKind,\\r\\n  Record<string, (field: unknown) => boolean>\\r\\n> = {\\r\\n  ?? {\\r\\n    b: isFiniteNumber,\\r\\n    d: isFiniteNumber,\\r\\n    main: shapedAs({ size: isString, count: isFiniteNumber }),\\r\\n    hoop: isBarRow,\\r\\n  },\\r\\n  鸚㎪쥈: {\\r\\n    b: isFiniteNumber,\\r\\n    depth: isFiniteNumber,\\r\\n    main: shapedAs({\\r\\n      size: isString,\\r\\n      top: isMainRow,\\r\\n      bottom: isMainRow,\\r\\n      cutoffFromSupportFaceMm: isFiniteNumber,\\r\\n    }),\\r\\n    stirrup: isBarRow,\\r\\n  },\\r\\n  ?먬쐡鶯? {\\r\\n    thickness: isFiniteNumber,\\r\\n    // 掠ㅶ빊??걹??겲?얏쑍?겹겗?띸럤?졼귝쵟?묆굥?①를嶺뗣꺕與ょ춮??쑍?겹걣 NaN ?ャ겒?뗣?\\n    layers: isFiniteNumber,\\r\\n    vertical: isBarRow,\\r\\n    horizontal: isBarRow,\\r\\n  },\\r\\n  佯딀씮: {\\r\\n    thickness: isFiniteNumber,\\r\\n    x: shapedAs({ top: isBarRow, bottom: isBarRow }),\\r\\n    y: shapedAs({ top: isBarRow, bottom: isBarRow }),\\r\\n  },\\r\\n}\\r\\n\\r\\n/**\\r\\n * 鵝띸쉰??숱?귞Ŧ?γ겎?뺛걝?귛틞?욍겘?쇔춴?밤겎??겒??*?쇻궎**?믤뙁?쇻겗??(ix, iy) ??\\n * (ix+1, iy+1) ??륫?밤굮凉뺛걦 ??壤㏂겘?긱겏?뚣걯?㎯굚?뤷뫑?뚪걬?녴?\\n */\\r\\nconst POSITION_FIELDS: Record<\\r\\n  MemberKind,\\r\\n  Record<string, (field: unknown) => boolean>\\r\\n> = {\\r\\n  ?? { ix: isFiniteNumber, iy: isFiniteNumber },\\r\\n  鸚㎪쥈: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\\r\\n  ?먬쐡鶯? { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\\r\\n  佯딀씮: { ix: isFiniteNumber, iy: isFiniteNumber },\\r\\n}\\r\\n\\r\\nconst isOpening = shapedAs({\\r\\n  id: isString,\\r\\n  xMm: isFiniteNumber,\\r\\n  yMm: isFiniteNumber,\\r\\n  widthMm: isFiniteNumber,\\r\\n  heightMm: isFiniteNumber,\\r\\n})\\r\\n\\r\\nconst isMemberKind = (value: unknown): boolean =>\\r\\n  MEMBER_KINDS.includes(value as MemberKind)\\r\\n\\r\\n/**\\r\\n * 謠ⓩ졏?졼걨?믤쩂?곥굥?귛룚?딂씔?旅덁뻑??퍟雅뷩걣鵝쒌겂?잍뻼耶쀥닓?㎯걌chemaVersion ?쀣걢\\r\\n * 誤뗣걳?ラ싥걲?ⓨ숱??걬??JSON ??Project ?ⓦ걮??ⅴ?얇겎?γ굥 ???곈뇧??NaN ?ャ겒?뗣걢\\r\\n * ?삯씊?뚩맼?▲굥?뗣겎?곥겑?▲굢?귙뚩き?욤씔?곥겒?뗣겂?잆띲굠?딀궕?꾠?\\n *\\r\\n * 濾쒌굙?뗣겗??＝?곥걣?쇻걧曆삣춻?믣폊?뤷졃? (stories?팵embers?퍀ections?팮rid) ?ⓦ?\\n * ?낁㉢?멥겗?삠꺂?ャ걹??겲?얍눣?뗦뻼耶쀥닓?졼걨?졼귛ㅳ겗倻ε퐪??(孃꾠걣若잌쑉?쇻굥?뗣?\\n * ?ф빊?뚧??? ??걪?볝겎??쫳?ゃ걚 ???앫굦??뼪?㏘?誤㎯겗?ε뒟濾쒏읅??똻?▼졃?㎯?\\n * ?볝걪?㏛틠?띲겓?곥겇?②쫸繹뽧걣雅뚣걢??ュ늽?뗣굦?뗣?\\n */\\r\\n/**\\r\\n * 壤㏂걽?묌싥겂?╊릎翁ャ겗?귞뀱?뚦늾?뚣겍?꾠굥鼇섌뙯?믣늾?뗣?\\n *\\r\\n * ?볝걪?㎬쫳?ゃ걚?ⓦ곩풄?뗣굢?뤹뵽??붶릎?㎬맼?▲굥 ??useProjectPersistence ??\\n * catch ??loadProject ?뚩㏄?ｃ걼? (??앫겗?? ?쀣걢誤뗣겒?꾠겗?㎯곩ㄷ歟곥겗??씊??\\n * 轝졼걨?╉걚?뗨쮼?꿔겘?앫걪?믥킔?싥굤?쀣겍 PaneBoundary ?ュ눣?뗣?\\n */\\r\\ninterface ReferencedPosition {\\r\\n  axis?: 'X' | 'Y'\\r\\n  ix: number\\r\\n  iy: number\\r\\n}\\r\\n\\r\\nfunction hasIntactReferences(\\r\\n  grid: Grid,\\r\\n  sections: { id: string; kind: MemberKind }[],\\r\\n  stories: { id: string }[],\\r\\n  members: {\\r\\n    kind: MemberKind\\r\\n    sectionId: string\\r\\n    storyId: string\\r\\n    position: ReferencedPosition\\r\\n  }[],\\r\\n): boolean {\\r\\n  const sectionKinds = new Map(sections.map(({ id, kind }) => [id, kind]))\\r\\n  const storyIds = new Set(stories.map(({ id }) => id))\\r\\n  const { nx, ny } = gridPointCount(grid)\\r\\n\\r\\n  // 鸚㎪쥈?삭먬쐡鶯곥겘?ｃ겗雅ㅷ궧?얇겎鴉멥겞?뗣겗?㎯곥걹??뻗?졼걨訝?ㅶ뎸?띲겲?㎯걽?귛틞?욍겘\\r\\n  // ?쇻궎?ゃ겗?㏛륫邕멥겏?귚??ㅶ뎸????slabBay ??(ix+1, iy+1) ?믣폊?뤵?\\n  const inGrid = (\\r\\n    kind: MemberKind,\\r\\n    { axis, ix, iy }: ReferencedPosition,\\r\\n  ): boolean => {\\r\\n    const spansX = kind === '佯딀씮' || axis === 'X'\\r\\n    const spansY = kind === '佯딀씮' || axis === 'Y'\\r\\n\\r\\n    return (\\r\\n      Number.isInteger(ix) &&\\r\\n      Number.isInteger(iy) &&\\r\\n      ix >= 0 &&\\r\\n      iy >= 0 &&\\r\\n      ix < nx - (spansX ? 1 : 0) &&\\r\\n      iy < ny - (spansY ? 1 : 0)\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return members.every(\\r\\n    (member) =>\\r\\n      // 葉?닪?뺛걚?귛늾?뗣귛ㄷ歟곥걣?긱겗??씊?믤뙁?쇻겏 buildingLayout ?뚧뒘?믡굥??\\n      sectionKinds.get(member.sectionId) === member.kind &&\\r\\n      storyIds.has(member.storyId) &&\\r\\n      // ?겹꺁?껁깋??쨼?믤뙁?쇾퐤營?겘 gridPoint ??RangeError ?㎪뒘?믡곩뀲?싥궎?녈걣?썬걾?뗣?\\n      // ?앫겗旅덁뻑?믦눎?뺜퓷耶섅걣?멥걦??겎?곫А??Ø?뤵겎?귛릪?섉??㎬맼?▲굥??\\n      inGrid(member.kind, member.position),\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction hasGridLabels(grid: unknown): boolean {\\r\\n  if (!isRecord(grid)) return false\\r\\n  const { xSpans, ySpans, xLabels, yLabels } = grid\\r\\n  if (!Array.isArray(xSpans) || !Array.isArray(ySpans)) return false\\r\\n\\r\\n  return (\\r\\n    (xLabels === undefined || isGridLabels(xLabels, xSpans.length)) &&\\r\\n    (yLabels === undefined || isGridLabels(yLabels, ySpans.length))\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction isProjectShape(value: unknown): boolean {\\r\\n  if (!isRecord(value)) return false\\r\\n\\r\\n  const { stories, sections, members, notes, unitMass } = value\\r\\n\\r\\n  return (\\r\\n    isString(value.name) &&\\r\\n    hasShape(value.grid, { xSpans: isNumberArray, ySpans: isNumberArray }) &&\\r\\n    // ?쇰꺼? ?놁뼱???섏?留? ?덉쑝硫?異뺤쓽 蹂몄닔? 留욎븘???쒕떎 ???닿툔??諛곗뿴?\\r\\n    // ?뚯뼱???싥굤??쓽 ?대쫫?멸??띾? ?껋? 湲곕줉?닿퀬, 洹몃?濡??먮㈃ ?붾㈃???됰슧??\\n    // 異뺤뿉 ?대쫫??遺숈씤??\\n    hasGridLabels(value.grid) &&\\r\\n    // 令뷩겗 stories ??뚪쉸?뚨꽒?꾣죭餓뜰띲겎??겒?뤷즸?뚣걼鼇섌뙯?졼귟＝?곥겘?녈굥???\\n    // stories[0] ?믤뿢若싧ㅳ겓鵝욍걝??\\n    Array.isArray(stories) &&\\r\\n    stories.length > 0 &&\\r\\n    stories.every((story) =>\\r\\n      hasShape(story, { id: isString, name: isString, height: isFiniteNumber }),\\r\\n    ) &&\\r\\n    Array.isArray(sections) &&\\r\\n    sections.every(\\r\\n      (section) =>\\r\\n        hasShape(section, {\\r\\n          id: isString,\\r\\n          // ?ㅵ닪耶먦겘?밧닪?졼귙걪?볝걣 union ??쨼??ㅳ걽?ⓦ곩숱??싥겂?잆겲??\\n          // ??씊??옗?녴걢?뚣걣?멥겧?싥곭츞若싥겗?붶릎?㎬맼?▲굥??\\n          kind: isMemberKind,\\r\\n          mark: isString,\\r\\n        }) &&\\r\\n        // ?쎼걚?귡뀓嶺뗣겗?ε뒟?귞Ŧ?γ겎?듐걣?뺛걝?귛뀻?싥겗?닸??졼걨?㎪툑?얇걵?뗣겏??\\n        // ?쎼걚 ??쵟?묆걼??씊?뚪싥겂??릭嶺뗣겗?졾램野멩퀡??NaN ??겲?얍냵鼇녔쎑??릦鼇덀겲??\\n        // 役곥굦?걅ain/hoop/stirrup ??쵟?묆걼??씊??generateColumnRebar ??릎??\\n        // TypeError ?ャ겒?뗢붵겑?▲굢?귙걪??뼟?겹걣閭㏂굙?잆걢?ｃ걼永먩옖?앫겗?귙겗?졼?\\n        // ?앫굮?멥겧?뗣겗??툓?㎩닩?ε춴?믤쩂?곥겍?귙굥?뗣굢?졼?\\n        hasShape(section, SECTION_FIELDS[(section as Section).kind]),\\r\\n    ) &&\\r\\n    Array.isArray(members) &&\\r\\n    members.every(\\r\\n      (member) =>\\r\\n        hasShape(member, {\\r\\n          i