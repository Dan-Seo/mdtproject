{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -Path 'src/domain/rebar/wall.test.ts' | Select-Object -Skip 1 -First 110; Get-Content -Path 'src/domain/rebar/wall.test.ts' | Select-Object -Skip 180 -First 140; Get-Content -Path 'src/domain/rebar/wall.test.ts' | Select-Object -Last 100\"","aggregated_output":"\r\nimport type { Member, WallSection } from '../model/member'\r\nimport type { WallSpan } from '../model/project'\r\nimport { lookupRule } from '../rules/lookup'\r\nimport { jpMlitRulePack } from '../../rulepack'\r\nimport { generateWallRebar, type WallRebarInput } from './wall'\r\n\r\nconst member: Member = {\r\n  id: '1F-W1-X1Y1-X',\r\n  kind: '?먬쐡鶯?,\r\n  memberClass: '翁?퐪',\r\n  sectionId: 'section-W1',\r\n  storyId: '1F',\r\n  position: { axis: 'X', ix: 0, iy: 0 },\r\n}\r\n\r\nconst section: WallSection = {\r\n  id: 'section-W1',\r\n  kind: '?먬쐡鶯?,\r\n  mark: 'W1',\r\n  thickness: 200,\r\n  fc: 24,\r\n  grade: 'SD345',\r\n  exposure: '掠뗥냵',\r\n  finish: '餓뺜툓?믡걗??,\r\n  spliceMethod: '?띲겖泳숁뎸',\r\n  layers: 2,\r\n  vertical: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n  horizontal: { size: 'D13', pitch: 200, startOffsetMm: 100 },\r\n}\r\n\r\n// 6000 ?밤깙?녈꺕??800횞800 ??냵力?5200?곲쉸遙?4200 ?뗣굢鸚㎪쥈?쎼걚 750 ?믣폊?꾠걼?끾퀡 3450??\r\nconst span: WallSpan = {\r\n  axis: 'X',\r\n  clearLengthMm: 5200,\r\n  clearHeightMm: 3450,\r\n  startFaceOffsetMm: 400,\r\n  endFaceOffsetMm: 400,\r\n  girderDepthAboveMm: 750,\r\n}\r\n\r\nfunction input(overrides: Partial<WallRebarInput> = {}): WallRebarInput {\r\n  return { member, section, span, ...overrides }\r\n}\r\n\r\nconst diameter = 13\r\nconst conditions = { fc: section.fc, grade: section.grade, hook: false }\r\nconst anchorage =\r\n  lookupRule(jpMlitRulePack, 'anchorage.L1', conditions).value * diameter\r\nconst tableLap =\r\n  lookupRule(jpMlitRulePack, 'lap.L1', conditions).value * diameter\r\nconst wallLapMinimum =\r\n  lookupRule(jpMlitRulePack, 'lap.wall.minimum', {}).value * diameter\r\nconst lap = Math.max(tableLap, wallLapMinimum)\r\nconst distributionAddition = lookupRule(\r\n  jpMlitRulePack,\r\n  'measure.distribution.addition',\r\n  {},\r\n).value\r\n\r\nfunction byRole(\r\n  generated: ReturnType<typeof generateWallRebar>,\r\n  role: '潁?춮' | '與ょ춮',\r\n) {\r\n  const rebar = generated.find((candidate) => candidate.role === role)\r\n  expect(rebar, `${role} should be generated`).toBeDefined()\r\n  return rebar!\r\n}\r\n\r\ndescribe('generateWallRebar', () => {\r\n  it('generates 潁?춮 and 與ょ춮 only', () => {\r\n    // 亮끾?嶺뗣겘鵝쒌굢?ゃ걚 ??1?싧뎴3) ??빓?뺛굮鶯곥겓?귚툗?덀굥?뚣곫쑍?겹굮若싥굙?뗦씉?뉎겘\r\n    // 2竊덌폆竊됪쥈3) ?㎪쥈?쀣걢?띷뙁?뺛겒?꾠귝쑍?겹굮獒썲뱚?뚥퐳?됥겒?꾠겏鼇덁툓?㎯걤?ゃ걚??\r\n    expect(generateWallRebar(input(), jpMlitRulePack).map(({ role }) => role))\r\n      .toEqual(['潁?춮', '與ょ춮'])\r\n  })\r\n\r\n  describe('潁?춮 ??令띸츞?뷸틬 2竊덌폊竊됧즯1)??, () => {\r\n    it('measures ?끾퀡遙섅걬 plus 若싩? at both ends', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      // ?뚧렏泳싥걲?뗤퍟??깿?녴겓若싩??쇻굥?귙겗?ⓦ걮?곩즯??쳵?뺚╈╉겓若싩??룔걬?믣뒥?덀걼??\r\n      // 訝듽겘鸚㎪쥈?곦툔??틞?욍꺕鸚㎪쥈?멨츣??쇻굥??겎訝←ク?ヤ퍡?뤵?\r\n      expect(vertical.length).toBe(3450 + 2 * anchorage + lap)\r\n    })\r\n\r\n    it('counts 1?싧뎴7) over ?끾퀡?룔걬, doubled by ??뽧꺂?띸춮', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      const perLayer = Math.ceil(5200 / 200) + distributionAddition\r\n      expect(vertical.count).toBe(perLayer * 2)\r\n    })\r\n\r\n    it('halves the count for ?룔꺍?겹꺂?띸춮', () => {\r\n      const single = generateWallRebar(\r\n        input({ section: { ...section, layers: 1 } }),\r\n        jpMlitRulePack,\r\n      )\r\n      const perLayer = Math.ceil(5200 / 200) + distributionAddition\r\n\r\n      expect(byRole(single, '潁?춮').count).toBe(perLayer)\r\n    })\r\n\r\n    it('takes 泳숁뎸 as ?꾦쉸???뗦? (2竊덌폊竊됧즯1)??, not the 1?싧뎴4) interval', () => {\r\n      const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n\r\n      expect(vertical.splice?.countPerBar).toBe(1)\r\n      expect(vertical.splice?.rules.map(({ key }) => key)).toContain(\r\n        'measure.splice.wall.vertical',\r\n      )\r\n        input({ section: { ...section, spliceMethod: '?с궧?㎪렏' } }),\r\n        jpMlitRulePack,\r\n      )\r\n      const vertical = byRole(generated, '潁?춮')\r\n\r\n      expect(vertical.splice?.countPerBar).toBe(1)\r\n      expect(vertical.splice?.lengthMm).toBe(0)\r\n      expect(vertical.length).toBe(3450 + 2 * anchorage)\r\n    })\r\n  })\r\n\r\n  it('carries the ?뗣겤??and 若싩? rules it actually looked up', () => {\r\n    const vertical = byRole(generateWallRebar(input(), jpMlitRulePack), '潁?춮')\r\n    const keys = vertical.ruleHits.map(({ key }) => key)\r\n\r\n    expect(keys).toContain('cover.minimum')\r\n    expect(keys).toContain('anchorage.L1')\r\n  })\r\n})\r\n\r\ndescribe('generateWallRebar ???뗥룭獒쒎섭嶺뗣겗鼇?쮫?녔쎑邕?쮼 (1?싧뎴8) ?ゃ걡?멥걤', () => {\r\n  const reinforcementMember: Member = {\r\n    ...member,\r\n    openings: [\r\n      {\r\n        id: 'W1-op1',\r\n        xMm: 2000,\r\n        yMm: 900,\r\n        widthMm: 1800,\r\n        heightMm: 1200,\r\n        reinforcements: [\r\n          { size: 'D13', count: 4, lengthMm: 1800 },\r\n          { size: 'D10', count: 2, lengthMm: 1200 },\r\n        ],\r\n      },\r\n    ],\r\n  }\r\n\r\n  it('emits each transcribed value as a separate straight Rebar', () => {\r\n    const reinforcements = generateWallRebar(\r\n      input({ member: reinforcementMember }),\r\n      jpMlitRulePack,\r\n    ).filter(({ role }) => role === '?뗥룭獒쒎섭嶺?)\r\n\r\n    expect(reinforcements).toHaveLength(2)\r\n    expect(reinforcements).toMatchObject([\r\n      {\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: 'D13',\r\n        count: 4,\r\n        length: 1800,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [1800, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      },\r\n      {\r\n        role: '?뗥룭獒쒎섭嶺?,\r\n        size: 'D10',\r\n        count: 2,\r\n        length: 1200,\r\n        shape: 'straight',\r\n        points: [\r\n          [0, 0, 0],\r\n          [1200, 0, 0],\r\n        ],\r\n        closed: false,\r\n        ruleHits: [],\r\n      },\r\n    ])\r\n\r\n    for (const rebar of reinforcements) {\r\n      expect(rebar).not.toHaveProperty('zones')\r\n      expect(rebar).not.toHaveProperty('placement')\r\n      expect(rebar.formula).toContain('鼇?쮫?녔쎑邕?쮼')\r\n      expect(rebar.formula).toContain('1?싧뎴8)')\r\n      expect(rebar.formula).toContain(`${rebar.length}`)\r\n      expect(rebar.formula).toContain(`${rebar.count}`)\r\n    }\r\n  })\r\n})\r\n\r\ndescribe('generateWallRebar ???뗥룭?ⓦ겗轝좈솮 (?곈뇧令띸츞?뷸틬 1?싧뎴8))', () => {\r\n  // ?끾퀡 5200횞3450?곥깞?껁긽 200?귞를嶺?27?с꺕與ょ춮 19??(1?싧뎴7))??\r\n  // ?뗥룭 1800횞1200 ??(2000, 900) ?ョ쉰?뤵겏?곭를嶺뗣겘 x (2000,3800) ??냵??8?с걣\r\n  // 遙섅걬 1200 ?믡곫Ø嶺뗣겘 y (900,2100) ??냵??6?с걣 亮?1800 ?믤쵟?뤵?\r\n  const opening = {\r\n    id: 'W1-op1',\r\n    xMm: 2000,\r\n    yMm: 900,\r\n    widthMm: 1800,\r\n    heightMm: 1200,\r\n  }\r\n  const holed = { ...member, openings: [opening] }\r\n\r\n  function rows(role: '潁?춮' | '與ょ춮', member_: Member = holed) {\r\n    return generateWallRebar(input({ member: member_ }), jpMlitRulePack).filter(\r\n      (rebar) => rebar.role === role,\r\n    )\r\n  }\r\n\r\n  it('??쵟?ㅹ뇧?붵겏?ヨ죱?믣늽?묆굥 ???띷뻼?뚩쫸?쇈곩숱?뜰곩?力뺟춬?붵겏?ャ?, () => {\r\n    const vertical = rows('潁?춮')\r\n\r\n    expect(vertical).toHaveLength(2)\r\n    // 27?с겗?녴걾 8?с걣轝졼걨??9?с걣?앫겗?얇겲?귙겑?▲굢?귙??뽧꺂?띸춮??횞2??\r\n    expect(vertical.map(({ count }) => count)).toEqual([19 * 2, 8 * 2])\r\n  })\r\n\r\n  it('??뼀?ｃ굮與ゅ늾?뗦쑍?졼걨?믧뼀?ｃ겗?끾퀡野멩퀡?졼걨??걦?쇻굥', () => {\r\n    const [full, cut] = rows('潁?춮')\r\n\r\n    expect(full.length - cut.length).toBe(\r\n      // 轝좈솮 1200 ?ⓦ곭텤?뗣걣 1?뗦??뗣굢 0?뗦??ヨ맼?▲걼?녴?\r\n      1200 + lap,\r\n    )\r\n    expect(cut.length).toBe(3450 - 1