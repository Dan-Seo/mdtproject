r\n          ▲ {t(locale, 'takeoff.cutoffAnchorage')}\r\n        </p>\r\n      )}\r\n      {hasOpeningRisk && (\r\n        <p\r\n          className={styles.splicePositionNotice}\r\n          role=\"note\"\r\n          data-testid=\"wall-opening-notice\"\r\n        >\r\n          ▲ {t(locale, 'takeoff.wallOpening')}\r\n        </p>\r\n      )}\r\n      {unsupportedMembers.length > 0 && (\r\n        <div\r\n          className={styles.unsupportedNotice}\r\n          role=\"note\"\r\n          data-testid=\"unsupported-notice\"\r\n        >\r\n          <strong>\r\n            {t(locale, 'takeoff.unsupported.title')}{' '}\r\n            {unsupportedMembers.length}\r\n            {t(locale, 'takeoff.unsupported.count')}\r\n          </strong>\r\n          <ul className={styles.unsupportedList}>\r\n  })\r\n  })\r\n\r\n  it('always says how 開口部 are counted and what is still missing', () => {\r\n    // 欠除（1通則8)）は計上するが、開口補強筋は同項が設計図書に委任するので\r\n    // 製品が作らない — その分は過小計上だ。出しておいて黙っていると\r\n    // 「빠진 것」ではなく「틀린 채로 완성된 것」になる (R14)。\r\n    render(<TakeoffPane />)\r\n\r\n    const notice = screen.getByTestId('wall-opening-notice')\r\n    expect(notice).toHaveTextContent('1通則8)')\r\n    expect(notice).toHaveTextContent('0.5㎡')\r\n    expect(notice).toHaveTextContent('開口補強筋')\r\n    expect(notice).toHaveTextContent('床板')\r\n  })\r\n\r\n  it('does not show the 開口部 notice without 耐震壁 or 床板', () => {\r\n    const project = createSampleProject()\r\n    useAppStore.setState({\r\n      project: {\r\n        ...project,\r\n        members: project.members.filter(\r\n          ({ kind }) => kind !== '耐震壁' && kind !== '床板',\r\n        ),\r\n      },\r\n    })\r\n\r\n    render(<TakeoffPane />)\r\n\r\n    expect(screen.queryByTestId('wall-opening-notice')).not.toBeInTheDocument()\r\n  })\r\n\r\n  it('does not show the 継手位置 notice when nothing carries a 継手', () => {\r\n    useAppStore.setState({\r\n      project: { ...createSampleProject(), members: [] },\r\n    })\r\n\r\n    render(<TakeoffPan