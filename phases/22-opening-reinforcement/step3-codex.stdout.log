ctions.find(({ kind }) => kind === '??)\r\n    const girder = project.members.find(({ kind }) => kind === '鸚㎪쥈')\r\n    expect(column).toBeDefined()\r\n    expect(girder).toBeDefined()\r\n\r\n    const crossed = {\r\n      ...project,\r\n      members: project.members.map((member) =>\r\n        member.id === girder!.id\r\n          ? { ...member, sectionId: column!.id }\r\n          : member,\r\n      ),\r\n    }\r\n\r\n    expect(() => deserializeProject(JSON.stringify(crossed))).toThrow()\r\n  })\r\n\r\n  it('accepts a project without the optional ?숃껁꺕?섆퐤蘊ら뇧', () => {\r\n    const project = createProject()\r\n\r\n    expect(() =>\r\n      deserializeProject(JSON.stringify(project)),\r\n    ).not.toThrow()\r\n  })\r\n\r\n  it('round-trips ?숃?notes', () => {\r\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\r\n\r\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\r\n  })\r\n})\r\n\r\ndescribe('columnEnds', () => {\r\n  function stackColumn(storyId: string, ix: number, iy: number): Member {\r\n    return {\r\n      id: `${storyId}-X${ix + 1}Y${iy + 1}`,\r\n      kind: '??,\r\n      memberClass: '翁?퐪',\r\n      sectionId: 'section-C1',\r\n      storyId,\r\n      position: { ix, iy },\r\n    }\r\n  }\r\n\r\n  function stackProject(members: Member[]): Project {\r\n    return {\r\n      ...createProject(members),\r\n      stories: [\r\n        { id: '1F', name: '1??, height: 4200 },\r\n        { id: '2F', name: '2??, height: 3600 },\r\n      ],\r\n    }\r\n  }\r\n\r\n  const twoStories = [\r\n    stackColumn('1F', 1, 1),\r\n    stackColumn('2F', 1, 1),\r\n  ]\r\n\r\n  it('anchors into the foundation at the lowest story and passes through the joint', () => {\r\n    const project = stackProject(twoStories)\r\n\r\n    expect(columnEnds(project, twoStories[0])).toEqual({\r\n      bottom: '若싩?',\r\n      top: '?ゃ걮',\r\n    })\r\n  })\r\n\r\n  it('leaves the joint bare on the upper column and stops at the roof without anchoring (R9??', () => {\r\n    // ?묓빀遺?먮뒗 若싩???遺숈? ?딅뒗?? 洹??먮━??泳숁뎸??塋?깿?▽뻑???꾨땲??\n    // 令띸츞?뷸틬 2竊덌폃竊됪윶2)???뚦릢?롢걫?ⓦ겓1?뗦??띻? ?뺥븳?? 掠뗤툓(?꾩뿉 ?깃? ?놁쓬)??\n    // 若싩???遺숈씠吏 ?딅뒗????1?싧뎴1)竊뗰펷竊믭펹??) 鵝녷쎑媛 ?訝딃쉸?긴말嶺뗭쓣 ?뚦뀍塋?겎\r\n    // 閭㏂겲?뗩뎱嶺뗣띿쑝濡??ㅻ쨪 ?녈꺍??꺁?쇈깉??Þ鼇덂?力뺢퉴吏留?媛꾨떎.\r\n    const project = stackProject(twoStories)\r\n\r\n    expect(columnEnds(project, twoStories[1])).toEqual({\r\n      bottom: '?ゃ걮',\r\n      top: '?덄ク',\r\n    })\r\n  })\r\n\r\n  it('anchors only the base and stops at the roof (?덄ク) when the column stands alone in its stack', () => {\r\n    const project = stackProject([twoStories[0]])\r\n\r\n    expect(columnEnds(project, twoStories[0])).toEqual({\r\n      bottom: '若싩?',\r\n      top: '?덄ク',\r\n    })\r\n  })\r\n\r\n  it('ignores a column that sits on a different grid point', () => {\r\n    const project = stackProject([\r\n      stackColumn('1F', 1, 1),\r\n      stackColumn('2F', 0, 0),\r\n    ])\r\n\r\n    expect(columnEnds(project, stackColumn('1F', 1, 1))).toEqual({\r\n      bottom: '若싩?',\r\n      top: '?덄ク',\r\n    })\r\n  })\r\n\r\n  it('reads the stack order from the stories array', () => {\r\n    const reversed: Project = {\r\n      ...stackProject(twoStories),\r\n      stories: [\r\n        { id: '2F', name: '2??, height: 3600 },\r\n        { id: '1F', name: '1??, height: 4200 },\r\n      ],\r\n    }\r\n\r\n    // 諛곗뿴???ㅼ쭛?덈㈃ 2F媛 理쒗븯痢듭쑝濡??댁꽍?쒕떎 ???쒖꽌媛 怨??ㅽ깮?대떎.\r\n    expect(columnEnds(reversed, twoStories[1]).bottom).toBe('若싩?')\r\n    expect(columnEnds(reversed, twoStories[0]).bottom).toBe('?ゃ걮')\r\n  })\r\n\r\n  it('rejects a member that is not a ??, () => {\r\n    const beam: Member = {\r\n      id: '1F-G1-X1Y1-X',\r\n      kind: '鸚㎪쥈',\r\n      memberClass: '翁?퐪',\r\n      sectionId: shallowGirderSection.id,\r\n      storyId: '1F',\r\n      position: { axis: 'X', ix: 0, iy: 0 },\r\n    }\r\n\r\n    expect(() => columnEnds(stackProject(twoStories), beam)).toThrow()\r\n  })\r\n})\r\n\r\ndescribe('setNote', () => {\r\n  it('stores a note