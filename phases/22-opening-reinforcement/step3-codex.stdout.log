    sections: [\\r\\n          {\\r\\n            id: 'x',\\r\\n            kind: '鸚㎪쥈',\\r\\n            mark: 'G1',\\r\\n            b: 400,\\r\\n            depth: 800,\\r\\n            main: {\\r\\n              size: 'D25',\\r\\n              top: { endCount: 4, centerCount: 2 },\\r\\n              bottom: { endCount: 2, centerCount: 4 },\\r\\n              cutoffFromSupportFaceMm: 1000,\\r\\n            },\\r\\n          },\\r\\n        ],\\r\\n      },\\r\\n    ],\\r\\n    [\\r\\n      '鸚㎪쥈訝사춮??툓塋?죱?뚨꽒??,\\r\\n      {\\r\\n        sections: [\\r\\n          {\\r\\n            id: 'x',\\r\\n            kind: '鸚㎪쥈',\\r\\n            mark: 'G1',\\r\\n            b: 400,\\r\\n            depth: 800,\\r\\n            main: { size: 'D25', cutoffFromSupportFaceMm: 1000 },\\r\\n            stirrup: { size: 'D13', pitch: 200, startOffsetMm: 50 },\\r\\n          },\\r\\n        ],\\r\\n      },\\r\\n    ],\\r\\n    // position ?뚨꽒?묆굦??buildingLayout ??`'axis' in member.position` ?뚩맼?▲굥??\\n    [\\r\\n      '?ⓩ쓲?ヤ퐤營?걣?▲걚',\\r\\n      { members: [{ id: 'm', kind: '??, sectionId: 's', storyId: '1F' }] },\\r\\n    ],\\r\\n    // 邕멥굮渶⒲걦?뽧굥?ⓧ툒?끾폇嶸쀥춴??Y ?ヨ맼?▲곩쎋?㏂겓?▲걚?묆걤??ㄷ歟곥걣?㎯걤?뗣?\\n    [\\r\\n      '鸚㎪쥈??뻗??X?팢 ?㎯겒??,\\r\\n      {\\r\\n        members: [\\r\\n          {\\r\\n            id: 'm',\\r\\n            kind: '鸚㎪쥈',\\r\\n            sectionId: 's',\\r\\n            storyId: '1F',\\r\\n            position: { axis: 'Z', ix: 0, iy: 0 },\\r\\n          },\\r\\n        ],\\r\\n      },\\r\\n    ],\\r\\n    ['?ⓩ쓲??kind ?뚨꽒??, { members: [{ id: 'm', sectionId: 's', storyId: '1F' }] }],\\r\\n    ['?ⓩ쓲??쉸 id ?뚨꽒??, { members: [{ id: 'm', kind: '??, sectionId: 's' }] }],\\r\\n    ['?숃껁겗?ㅳ걣?뉐춻?쀣겎?ゃ걚', { notes: { row: 3 } }],\\r\\n    ['?섆퐤蘊ら뇧?뚧빊?㎯겒??, { unitMass: { D13: '0.995' } }],\\r\\n  ])('rejects a project whose shape is broken: %s', (_label, broken) => {\\r\\n    const project = createProject()\\r\\n\\r\\n    expect(() =>\\r\\n      deserializeProject(JSON.stringify({ ...project, ...broken })),\\r\\n    ).toThrow()\\r\\n  })\\r\\n\\r\\n  // 壤㏂걽?묌싥겂??뢿?㎯걣?뉎굦?╉걚?뗨쮼?꿔겘?곫룒?삠겗?붶릎?㎩닜?곥겍?썬걾????\\n  // ?앫겗?껁겓??굚??store ?ュ뀯?ｃ겍?꾠굥??겎?곥뚣궢?녈깤?ャ겓?삠굥?띲걣?밤걢?ゃ걚??\\n  it.each([\\r\\n    ['?ⓩ쓲?뚦츪?ⓦ걮?ゃ걚??씊?믤뙁??, 'sectionId'],\\r\\n    ['?ⓩ쓲?뚦츪?ⓦ걮?ゃ걚?롢굮?뉎걲', 'storyId'],\\r\\n  ])('rejects a project whose references are broken: %s', (_label, field) => {\\r\\n    const project = createProject()\\r\\n    const broken = {\\r\\n      ...project,\\r\\n      members: project.members.map((member, index) =>\\r\\n        index === project.members.length - 1\\r\\n          ? { ...member, [field]: 'nowhere' }\\r\\n          : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(broken))).toThrow()\\r\\n  })\\r\\n\\r\\n  it.each([\\r\\n    ['?긱걣?겹꺁?껁깋??쨼?믤뙁??, { ix: 99, iy: 0 }],\\r\\n    ['?겹꺁?껁깋曆삣춻?뚧빐?겹겎?ゃ걚', { ix: 0.5, iy: 0 }],\\r\\n    ['?겹꺁?껁깋曆삣춻?뚩쿋', { ix: -1, iy: 0 }],\\r\\n  ])('rejects a project whose grid index is out of range: %s', (_l, position) => {\\r\\n    // gridPoint ??RangeError ?믤뒘?믡곩뀲?싥궎?녈걣?썬걾?뗣귙걮?뗣굚?앫겗旅덁뻑??\\n    // ?ゅ땿岳앭춼?뚧쎑?뤵겗?㎯곫А??Ø?뤵겎?귛릪?섉??㎬맼?▲굥??\\n    const project = createProject()\\r\\n    const broken = {\\r\\n      ...project,\\r\\n      members: project.members.map((member, index) =>\\r\\n        index === 0 ? { ...member, position } : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(broken))).toThrow()\\r\\n  })\\r\\n\\r\\n  it('rejects a 鸚㎪쥈 that starts on the last ?겹꺁?껁깋 line of its axis', () => {\\r\\n    // 鸚㎪쥈??슔??벡?밤겲?㏛섯?녈굥??겎?곥걹??뻗?졼걨訝?ㅶ뎸?띲겲?㎯걽??\\n    const project = createSampleProject()\\r\\n    const girder = project.members.find(\\r\\n      (member) => member.kind === '鸚㎪쥈' && 'axis' in member.position,\\r\\n    )\\r\\n    expect(girder).toBeDefined()\\r\\n    const { nx } = gridPointCount(project.grid)\\r\\n\\r\\n    const broken = {\\r\\n      ...project,\\r\\n      members: project.members.map((member) =>\\r\\n        member.id === girder!.id\\r\\n          ? { ...member, position: { axis: 'X', ix: nx - 1, iy: 0 } }\\r\\n          : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(broken))).toThrow()\\r\\n  })\\r\\n\\r\\n  it('rejects a 鸚㎪쥈 that points at a ????씊', () => {\\r\\n    // 葉?닪?뺛걚??buildingLayout ?뚧뒘?믡굥 ??壤㏂겗濾쒏읅?㎪??곥굥?밤걣?⒲걚??\\n    const project = createSampleProject()\\r\\n    const column = project.sections.find(({ kind }) => kind === '??)\\r\\n    const girder = project.members.find(({ kind }) => kind === '鸚㎪쥈')\\r\\n    expect(column).toBeDefined()\\r\\n    expect(girder).toBeDefined()\\r\\n\\r\\n    const crossed = {\\r\\n      ...project,\\r\\n      members: project.members.map((member) =>\\r\\n        member.id === girder!.id\\r\\n          ? { ...member, sectionId: column!.id }\\r\\n          : member,\\r\\n      ),\\r\\n    }\\r\\n\\r\\n    expect(() => deserializeProject(JSON.stringify(crossed))).toThrow()\\r\\n  })\\r\\n\\r\\n  it('accepts a project without the optional ?숃껁꺕?섆퐤蘊ら뇧', () => {\\r\\n    const project = createProject()\\r\\n\\r\\n    expect(() =>\\r\\n      deserializeProject(JSON.stringify(project)),\\r\\n    ).not.toThrow()\\r\\n  })\\r\\n\\r\\n  it('round-trips ?숃?notes', () => {\\r\\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\\r\\n\\r\\n    expect(deserializeProject(serializeProject(project))).toEqual(project)\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('columnEnds', () => {\\r\\n  function stackColumn(storyId: string, ix: number, iy: number): Member {\\r\\n    return {\\r\\n      id: `${storyId}-X${ix + 1}Y${iy + 1}`,\\r\\n      kind: '??,\\r\\n      memberClass: '翁?퐪',\\r\\n      sectionId: 'section-C1',\\r\\n      storyId,\\r\\n      position: { ix, iy },\\r\\n    }\\r\\n  }\\r\\n\\r\\n  function stackProject(members: Member[]): Project {\\r\\n    return {\\r\\n      ...createProject(members),\\r\\n      stories: [\\r\\n        { id: '1F', name: '1??, height: 4200 },\\r\\n        { id: '2F', name: '2??, height: 3600 },\\r\\n      ],\\r\\n    }\\r\\n  }\\r\\n\\r\\n  const twoStories = [\\r\\n    stackColumn('1F', 1, 1),\\r\\n    stackColumn('2F', 1, 1),\\r\\n  ]\\r\\n\\r\\n  it('anchors into the foundation at the lowest story and passes through the joint', () => {\\r\\n    const project = stackProject(twoStories)\\r\\n\\r\\n    expect(columnEnds(project, twoStories[0])).toEqual({\\r\\n      bottom: '若싩?',\\r\\n      top: '?ゃ걮',\\r\\n    })\\r\\n  })\\r\\n\\r\\n  it('leaves the joint bare on the upper column and stops at the roof without anchoring (R9??', () => {\\r\\n    // ?묓빀遺?먮뒗 若싩???遺숈? ?딅뒗?? 洹??먮━??泳숁뎸??塋?깿?▽뻑???꾨땲??\\n    // 令띸츞?뷸틬 2竊덌폃竊됪윶2)???뚦릢?롢걫?ⓦ겓1?뗦??띻? ?뺥븳?? 掠뗤툓(?꾩뿉 ?깃? ?놁쓬)??\\n    // 若싩???遺숈씠吏 ?딅뒗????1?싧뎴1)竊뗰펷竊믭펹??) 鵝녷쎑媛 ?訝딃쉸?긴말嶺뗭쓣 ?뚦뀍塋?겎\\r\\n    // 閭㏂겲?뗩뎱嶺뗣띿쑝濡??ㅻ쨪 ?녈꺍??꺁?쇈깉??Þ鼇덂?力뺢퉴吏留?媛꾨떎.\\r\\n    const project = stackProject(twoStories)\\r\\n\\r\\n    expect(columnEnds(project, twoStories[1])).toEqual({\\r\\n      bottom: '?ゃ걮',\\r\\n      top: '?덄ク',\\r\\n    })\\r\\n  })\\r\\n\\r\\n  it('anchors only the base and stops at the roof (?덄ク) when the column stands alone in its stack', () => {\\r\\n    const project = stackProject([twoStories[0]])\\r\\n\\r\\n    expect(columnEnds(project, twoStories[0])).toEqual({\\r\\n      bottom: '若싩?',\\r\\n      top: '?덄ク',\\r\\n    })\\r\\n  })\\r\\n\\r\\n  it('ignores a column that sits on a different grid point', () => {\\r\\n    const project = stackProject([\\r\\n      stackColumn('1F', 1, 1),\\r\\n      stackColumn('2F', 0, 0),\\r\\n    ])\\r\\n\\r\\n    expect(columnEnds(project, stackColumn('1F', 1, 1))).toEqual({\\r\\n      bottom: '若싩?',\\r\\n      top: '?덄ク',\\r\\n    })\\r\\n  })\\r\\n\\r\\n  it('reads the stack order from the stories array', () => {\\r\\n    const reversed: Project = {\\r\\n      ...stackProject(twoStories),\\r\\n      stories: [\\r\\n        { id: '2F', name: '2??, height: 3600 },\\r\\n        { id: '1F', name: '1??, height: 4200 },\\r\\n      ],\\r\\n    }\\r\\n\\r\\n    // 諛곗뿴???ㅼ쭛?덈㈃ 2F媛 理쒗븯痢듭쑝濡??댁꽍?쒕떎 ???쒖꽌媛 怨??ㅽ깮?대떎.\\r\\n    expect(columnEnds(reversed, twoStories[1]).bottom).toBe('若싩?')\\r\\n    expect(columnEnds(reversed, twoStories[0]).bottom).toBe('?ゃ걮')\\r\\n  })\\r\\n\\r\\n  it('rejects a member that is not a ??, () => {\\r\\n    const beam: Member = {\\r\\n      id: '1F-G1-X1Y1-X',\\r\\n      kind: '鸚㎪쥈',\\r\\n      memberClass: '翁?퐪',\\r\\n      sectionId: shallowGirderSection.id,\\r\\n      storyId: '1F',\\r\\n      position: { axis: 'X', ix: 0, iy: 0 },\\r\\n    }\\r\\n\\r\\n    expect(() => columnEnds(stackProject(twoStories), beam)).toThrow()\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('setNote', () => {\\r\\n  it('stores a note without mutating the original Project', () => {\\r\\n    const project = createProject()\\r\\n    const next = setNote(project, '1??C|C1|訝사춮', '誤곭▶沃?)\\r\\n\\r\\n    expect(next.notes).toEqual({ '1??C|C1|訝사춮': '誤곭▶沃? })\\r\\n    expect(project.notes).toBeUndefined()\\r\\n  })\\r\\n\\r\\n  it('replaces an existing note for the same line', () => {\\r\\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\\r\\n    const next = setNote(project, '1??C|C1|訝사춮', '閻븃첀歷?)\\r\\n\\r\\n    expect(next.notes).toEqual({ '1??C|C1|訝사춮': '閻븃첀歷? })\\r\\n  })\\r\\n\\r\\n  it('drops the key when the note is cleared so empty strings do not pile up', () => {\\r\\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\\r\\n    const next = setNote(project, '1??C|C1|訝사춮', '')\\r\\n\\r\\n    expect(next.notes).toEqual({})\\r\\n  })\\r\\n\\r\\n  it('keeps notes for other lines untouched', () => {\\r\\n    const project = setNote(createProject(), '1??C|C1|訝사춮', '誤곭▶沃?)\\r\\n    const next = setNote(project, '1??C|C1|躍?춮', '?붵긿?곭▶沃?)\\r\\n\\r\\n    expect(next.notes).toEqual({\\r\\n      '1??C|C1|訝사춮': '誤곭▶沃?,\\r\\n      '1??C|C1|躍?춮': '?붵긿?곭▶沃?,\\r\\n    })\\r\\n  })\\r\\n})\\r\\n\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'Get-Content -Raw src/components/plan/PlanEditor.tsx'\",\"aggregated_output\":\"'use client'\\n\\nimport { useRef, type KeyboardEvent } from 'react'\\n\\nimport {\\n  BAR_SIZES,\\n  type BarSize,\\n  type Member,\\n  type Opening,\\n  type OpeningReinforcement,\\n} from '@/domain/model/member'\\nimport {\\n  findSection,\\n  gridPoint,\\n  slabBay,\\n  storyNotFound,\\n  wallSpan,\\n  type Project,\\n} from '@/domain/model/project'\\nimport { lookupRule } from '@/domain/rules/lookup'\\nimport { jpMlitRulePack } from '@/rulepack'\\nimport { t } from '@/lib/i18n'\\nimport { useAppStore } from '@/lib/store'\\nimport { capture } from '@/lib/telemetry'\\n\\nimport { spanCoordinates, updateProjectSpans, type SpanAxis } from './grid'\\nimport styles from './PlanEditor.module.css'\\n\\n// 鶯곥겗?®퇉?믧싥굤??걢?됥겑?뚣걽?묌썴?쇻걢 (px)?귛ㄷ歟곥겗?믡긿?덆젞?잆걣?뉐겢 9px\\n// (girderHitArea ??stroke-width 18) ?ゃ겗?㎯곥걹??쨼?ュ눣?뺛겒?꾠겏鶯곥굮?멥겧?ゃ걚??const wallFaceOffset = 12\\n\\n// 佯딀씮??죿?듽굮?싥굤??걢?됥겑?뚣걽?묈폊?ｈ씔?곥굥??(px)?귛즯??씊渶싥겗?믡긿?덆젞?잆걣\\n// ?싥굤??걢?됬뎴??12竊? 竊?20px ?얇겎掠듽걦??겎?곥걹??쨼?뗣굢櫻쀣굤冶뗣굙?ゃ걚??// 佯딀씮?뚥툓?ヨ펹?ｃ겍鸚㎪쥈?귛즯?귡겦?밤겒?뤵겒?뗣?const slabEdgeInset = 22\\n\\nconst viewWidth = 640\\nconst viewHeight = 420\\nconst plotLeft = 96\\nconst plotTop = 56\\nconst plotWidth = 476\\nconst plotHeight = 282\\n\\ninterface DrawingTransform {\\n  x(value: number): number\\n  y(value: number): number\\n}\\n\\nfunction drawingTransform(project: Project): DrawingTransform {\\n  const xCoordinates = spanCoordinates(project.grid.xSpans)\\n  const yCoordinates = spanCoordinates(project.grid.ySpans)\\n  const totalX = xCoordinates[xCoordinates.length - 1]\\n  const totalY = yCoordinates[yCoordinates.length - 1]\\n  const scale = Math.min(plotWidth / totalX, plotHeight / totalY)\\n  const drawingWidth = totalX * scale\\n  const drawingHeight = totalY * scale\\n  const offsetX = plotLeft + (plotWidth - drawingWidth) / 2\\n  const offsetY = plotTop + (plotHeight - drawingHeight) / 2\\n\\n  return {\\n    x: (value) => offsetX + value * scale,\\n    y: (value) => offsetY + drawingHeight - value * scale,\\n  }\\n}\\n\\nfunction activateMember(\\n  event: KeyboardEvent<SVGGElement>,\\n  select: () => void,\\n): void {\\n  if (event.key !== 'Enter' && event.key !== ' ') return\\n  event.preventDefault()\\n  select()\\n}\\n\\nexport function StoryTabs() {\\n  const stories = useAppStore(({ project }) => project.stories)\\n  const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\\n  const locale = useAppStore(({ locale }) => locale)\\n  const setActiveStory = useAppStore(({ setActiveStory }) => setActiveStory)\\n\\n  return (\\n    <div\\n      className={styles.storyTabs}\\n      role=\\\"tablist\\\"\\n      aria-label={t(locale, 'plan.storyTabs')}\\n    >\\n      {stories.map((story) => {\\n        const selected = story.id === activeStoryId\\n        return (\\n          <button\\n            key={story.id}\\n            type=\\\"button\\\"\\n            role=\\\"tab\\\"\\n            className={`${styles.storyTab} ${\\n              selected ? styles.storyTabActive : ''\\n            }`}\\n            aria-selected={selected}\\n            onClick={() => {\\n              setActiveStory(story.id)\\n              // ViewerTabs쨌member_selected? 媛숈? 湲곗? ???대? ?쒖꽦??痢듭쓣\\n              // ?ㅼ떆 ?뚮윭???꾪솚???꾨땲??(10李?由щ럭 minor).\\n              if (!selected) capture('story_selected')\\n            }}\\n          >\\n            {story.name}\\n          </button>\\n        )\\n      })}\\n    </div>\\n  )\\n}\\n\\nfunction PlanMember({\\n  member,\\n  project,\\n  transform,\\n}: {\\n  member: Member\\n  project: Project\\n  transform: DrawingTransform\\n}) {\\n  const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\\n  const selectMember = useAppStore(({ selectMember }) => selectMember)\\n  const section = findSection(project, member.sectionId)\\n  const selected = selectedMemberId === member.id\\n  // 遺??id??洹몃━??醫뚰몴瑜??닿퀬 ?덉뼱 蹂대궡吏 ?딅뒗?????대뒓 ?섏씤?먯꽌 怨⑤옄?붿?留??④릿??\\n  // ?대? ?좏깮??遺?щ? ?ㅼ떆 ?대┃?대룄 ?щ컻?뷀븯吏 ?딅뒗????SectionTable쨌TakeoffPane怨?  // 媛숈? ?먯젙?대씪 source蹂??좏깮 ??鍮꾧탳媛 ?대뒓 ?쒖そ?쇰줈 遺?吏 ?딅뒗??\\n  const select = () => {\\n    selectMember(member.id)\\n    if (!selected) capture('member_selected', { source: 'plan' })\\n  }\\n\\n  if (member.kind === '?? && !('axis' in member.position)) {\\n    const point = gridPoint(\\n      project.grid,\\n      member.position.ix,\\n      member.position.iy,\\n    )\\n    const x = transform.x(point.x)\\n    const y = transform.y(point.y)\\n\\n    // ?쇰꺼? 洹몃９ 諛뽰뿉 ?붾떎 ???덉뿉 ?덉쑝硫?洹몃９ bbox媛 ?쇰꺼源뚯? 媛먯떥\\n    // ?대┃ 以묒떖??留덉빱瑜?踰쀬뼱??鸚㎪쥈 ?덊듃?곸뿭?쇰줈 諛由곕떎.\\n    return (\\n      <>\\n        <g\\n          className={`${styles.member} ${\\n            selected ? styles.memberSelected : ''\\n          }`}\\n          role=\\\"button\\\"\\n          tabIndex={0}\\n          aria-label={`${section.mark} ${member.id}`}\\n          aria-pressed={selected}\\n          onClick={select}\\n          onKeyDown={(event) => activateMember(event, select)}\\n        >\\n          <rect\\n            className={styles.column}\\n            x={x - 7}\\n            y={y - 7}\\n            width=\\\"14\\\"\\n            height=\\\"14\\\"\\n            rx=\\\"2\\\"\\n          />\\n        </g>\\n        <text className={styles.memberLabel} x={x + 10} y={y - 9}>\\n          {section.mark}\\n        </text>\\n      </>\\n    )\\n  }\\n\\n  if (member.kind === '佯딀씮' && !('axis' in member.position)) {\\n    const { ix, iy } = member.position\\n    const origin = gridPoint(project.grid, ix, iy)\\n    const far = gridPoint(project.grid, ix + 1, iy + 1)\\n    const left = Math.min(transform.x(origin.x), transform.x(far.x))\\n    const right = Math.max(transform.x(origin.x), transform.x(far.x))\\n    const top = Math.min(transform.y(origin.y), transform.y(far.y))\\n    const bottom = Math.max(transform.y(origin.y), transform.y(far.y))\\n    const width = right - left - 2 * slabEdgeInset\\n    const height = bottom - top - 2 * slabEdgeInset\\n\\n    // ?쇻궎?뚦컦?뺛걲?롢겍櫻쀣굥?닸??뚧츐?됥겒?꾠겒?됪룒?뗣겒?꾠귝쉼?뚣걼?⒴숱?믥쉰?뤵겏\\n    // 誤뗣걟?ゃ걚?믡긿?덆젞?잆걽?묆걣餘뗣굥??    if (width <= 0 || height <= 0) return null\\n\\n    return (\\n      <g\\n        className={`${styles.member} ${selected ? styles.memberSelected : ''}`}\\n        role=\\\"button\\\"\\n        tabIndex={0}\\n        aria-label={`${section.mark} ${member.id}`}\\n        aria-pressed={selected}\\n        onClick={select}\\n        onKeyDown={(event) => activateMember(event, select)}\\n      >\\n        <rect\\n          className={styles.slab}\\n          x={left + slabEdgeInset}\\n          y={top + slabEdgeInset}\\n          width={width}\\n          height={height}\\n          rx=\\\"3\\\"\\n        />\\n        {slabOpeningRects(project, member, transform).map(\\n          ({ id, x, y, width: openingWidth, height: openingHeight }) => (\\n            <rect\\n              key={id}\\n              className={styles.opening}\\n              x={x}\\n              y={y}\\n              width={openingWidth}\\n              height={openingHeight}\\n            />\\n          ),\\n        )}\\n      </g>\\n    )\\n  }\\n\\n  if (member.kind === '?먬쐡鶯? && 'axis' in member.position) {\\n    const { axis, ix, iy } = member.position\\n    const start = gridPoint(project.grid, ix, iy)\\n    const end = gridPoint(\\n      project.grid,\\n      axis === 'X' ? ix + 1 : ix,\\n      axis === 'Y' ? iy + 1 : iy,\\n    )\\n    const x1 = transform.x(start.x)\\n    const y1 = transform.y(start.y)\\n    const x2 = transform.x(end.x)\\n    const y2 = transform.y(end.y)\\n\\n    // 鶯곥겘鸚㎪쥈?ⓨ릪?섋씌?ョ쳦?ㅳ귡싥굤??겗訝듽겓?띲겖???с겎?뤵걦?ⓦ곩ㄷ歟곥겗?믡긿?덆젞?잆걣\\n    // 訝듽겓雍됥겂??*鶯곥굮?멥겧?ゃ걦?ゃ굥**竊덂츪?뽧꺀?╉궣濾쒑㉫?㎩닩?롳펹?귛뭄?℡쎋??뀭?ⓦ겑?듽굤\\n    // 訝▼겢??씊渶??с겎?뤵걤?곩ㄷ歟곥겗渶싥겗鸚뽩겢?ュ눣?쇻걪?ⓦ겎?⒲걾?됥굚?멥겧?뗣굠?녴겓?쇻굥??    // ?싥굤??겓野얇걮???燁겹겒??겎?곩즯?뚩뒸訝듽겓?귙굥?ⓦ걚?녵틟若잆굚?꿔걩?╉걚?ゃ걚??    const faceOffset = wallFaceOffset\\n    const faces =\\n      axis === 'X'\\n        ? [\\n            { x1, y1: y1 - faceOffset, x2, y2: y2 - faceOffset },\\n            { x1, y1: y1 + faceOffset, x2, y2: y2 + faceOffset },\\n          ]\\n        : [\\n            { x1: x1 - faceOffset, y1, x2: x2 - faceOffset, y2 },\\n            { x1: x1 + faceOffset, y1, x2: x2 + faceOffset, y2 },\\n          ]\\n\\n    return (\\n      <g\\n        className={`${styles.member} ${selected ? styles.memberSelected : ''}`}\\n        role=\\\"button\\\"\\n        tabIndex={0}\\n        aria-label={`${section.mark} ${member.id}`}\\n        aria-pressed={selected}\\n        onClick={select}\\n        onKeyDown={(event) => activateMember(event, select)}\\n      >\\n        {faces.map((face, index) => (\\n          <line\\n            key={`hit-${index}`}\\n            className={styles.wallHitArea}\\n            x1={face.x1}\\n            y1={face.y1}\\n            x2={face.x2}\\n            y2={face.y2}\\n          />\\n        ))}\\n        {faces.map((face, index) => (\\n          <line\\n            key={`face-${index}`}\\n            className={styles.wall}\\n            x1={face.x1}\\n            y1={face.y1}\\n            x2={face.x2}\\n            y2={face.y2}\\n          />\\n        ))}\\n        <text\\n          className={styles.memberLabel}\\n          x={(x1 + x2) / 2 + (axis === 'Y' ? faceOffset + 12 : 0)}\\n          y={(y1 + y2) / 2 + (axis === 'X' ? faceOffset + 14 : 0)}\\n          textAnchor=\\\"middle\\\"\\n        >\\n          {section.mark}\\n        </text>\\n      </g>\\n    )\\n  }\\n\\n  if (member.kind === '鸚㎪쥈' && 'axis' in member.position) {\\n    const { axis, ix, iy } = member.position\\n    const start = gridPoint(project.grid, ix, iy)\\n    const end = gridPoint(\\n      project.grid,\\n      axis === 'X' ? ix + 1 : ix,\\n      axis === 'Y' ? iy + 1 : iy,\\n    )\\n    const x1 = transform.x(start.x)\\n    const y1 = transform.y(start.y)\\n    const x2 = transform.x(end.x)\\n    const y2 = transform.y(end.y)\\n\\n    return (\\n      <g\\n        className={`${styles.member} ${\\n          selected ? styles.memberSelected : ''\\n        }`}\\n        role=\\\"button\\\"\\n        tabIndex={0}\\n        aria-label={`${section.mark} ${member.id}`}\\n        aria-pressed={selected}\\n        onClick={select}\\n        onKeyDown={(event) => activateMember(event, select)}\\n      >\\n        <line\\n          className={styles.girderHitArea}\\n          x1={x1}\\n          y1={y1}\\n          x2={x2}\\n          y2={y2}\\n        />\\n        <line\\n          className={styles.girder}\\n          x1={x1}\\n          y1={y1}\\n          x2={x2}\\n          y2={y2}\\n        />\\n        <text\\n          className={styles.memberLabel}\\n          x={(x1 + x2) / 2}\\n          y={(y1 + y2) / 2 - 6}\\n          textAnchor=\\\"middle\\\"\\n        >\\n          {section.mark}\\n        </text>\\n      </g>\\n    )\\n  }\\n\\n  return null\\n}\\n\\n/**\\n * 佯딀씮??뼀?ｉ깿?믣뭄?㏂겗 px ?ュ넍??(?곈뇧令띸츞?뷸틬 1?싧뎴8))?귛벨與쇻겘?쇻궎掠??ゃ겗?㎯? * ?끾퀡?잆겗?잏궧竊덂룛?묆굥鸚㎪쥈??냵?닻씊竊됥굮?싥굤??걢?됥겗若잌??㎬떨?쀣겍?뗣굢?쇻걲 ?? * 櫻쀣굤??`slabEdgeInset` ??ㄷ歟곥꺕鶯곥굮?담굙?뗣굠?녴겓?쇻굥?잆굙??쫳?잏쎅??껁걩?㎯걗?ｃ겍\\n * ?끾퀡?㎯겘?ゃ걚??겎?곥걹?뚣굮?뷸틬?ャ걲?뗣겏?뗥룭?뚦츪野멥걢?됥걳?뚣굥?? *\\n * ?끾퀡?뚧군?얇굢?ゃ걚?쇻궎竊덂룛?묆굥鸚㎪쥈?뚧쵟?묆겍?꾠굥竊됥겎??퐬?귝룒?뗣겒?꾠귙걹??깿?먦겘\\n * ?앫굚?앫굚?곈뇧?ュ눣?╉걚?ゃ걚?? */\\nfunction slabOpeningRects(\\n  project: Project,\\n  member: Member,\\n  transform: DrawingTransform,\\n): { id: string; x: number; y: number; width: number; height: number }[] {\\n  const openings = member.openings ?? []\\n  if (openings.length === 0 || 'axis' in member.position) return []\\n\\n  let bay\\n  try {\\n    bay = slabBay(project, member)\\n  } catch {\\n    return []\\n  }\\n\\n  const origin = gridPoint(\\n    project.grid,\\n    member.position.ix,\\n    member.position.iy,\\n  )\\n  const originXMm = origin.x + bay.startFaceOffsetXMm\\n  const originYMm = origin.y + bay.startFaceOffsetYMm\\n\\n  return openings.map((opening) => {\\n    const left = transform.x(originXMm + opening.xMm)\\n    const right = transform.x(originXMm + opening.xMm + opening.widthMm)\\n    // y ??툓訝뗣걣?띹빪?쀣겍?꾠굥竊늯ransform.y ?뚥툔?뗣굢訝듽겦?겹걟?뗰펹??    const bottom = transform.y(originYMm + opening.yMm)\\n    const top = transform.y(originYMm + opening.yMm + opening.heightMm)\\n\\n    return {\\n      id: opening.id,\\n      x: Math.min(left, right),\\n      y: Math.min(top, bottom),\\n      width: Math.abs(right - left),\\n      height: Math.abs(bottom - top),\\n    }\\n  })\\n}\\n\\nfunction SpanEditor({ axis }: { axis: SpanAxis }) {\\n  const project = useAppStore(({ project }) => project)\\n  const locale = useAppStore(({ locale }) => locale)\\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\\n  const spans = axis === 'x' ? project.grid.xSpans : project.grid.ySpans\\n  // ?꾨㈃?먯꽌 ?쎌? ?싥굤???대쫫. ?놁쑝硫??대쫫 ?놁씠 踰덊샇留?蹂댁씤????index濡?  // ?대쫫??吏?대궡吏 ?딅뒗??(ADR-030)\\n  const labels = axis === 'x' ? project.grid.xLabels : project.grid.yLabels\\n  const spanName = (index: number) =>\\n    labels === undefined\\n      ? `${axisLabel}?밤깙??${index + 1}`\\n      : `${labels[index]}-${labels[index + 1]}`\\n  const axisLabel = axis.toUpperCase()\\n  const editReported = useRef(false)\\n\\n  const commit = (nextSpans: number[]) => {\\n    updateProject((current) =>\\n      updateProjectSpans(current, axis, nextSpans),\\n    )\\n\\n    // number input??onChange??\\\"6000\\\"??移섎㈃ ??踰??ㅼ뼱?⑤떎. 異뺣쭏????踰덉쑝濡??⑹퀜\\n    // ?대깽?멸? ??댄븨 ?띾룄媛 ?꾨땲???몄쭛 ?щ?瑜??멸쾶 ?쒕떎.\\n    if (editReported.current) return\\n    editReported.current = true\\n    capture('grid_edited', { axis })\\n  }\\n\\n  return (\\n    <fieldset className={styles.spanFieldset}>\\n      <legend className={styles.spanLegend}>{axisLabel} ?밤깙??/legend>\\n      <div className={styles.spanList}>\\n        {spans.map((span, index) => (\\n          <div className={styles.spanItem} key={`${axis}-${index}`}>\\n            <input\\n              className={styles.spanInput}\\n              type=\\\"number\\\"\\n              min=\\\"1\\\"\\n              step=\\\"1\\\"\\n              value={span}\\n              // ?대쫫? ?꾨㈃?먯꽌 ?ㅻ㈃ 諛붾먮떎 ???먮룞 寃利앹씠 媛믪쓣 吏묐뒗 ?먮━??              // ?대쫫???꾨땲??異뺢낵 ?쒕쾲?댁뼱???쒕떎\\n              data-testid={`span-${axis}-${index}`}\\n              aria-label={spanName(index)}\\n              onChange={(event) => {\\n                const value = Number(event.currentTarget.value)\\n                if (!Number.isFinite(value) || value <= 0) return\\n                commit(\\n                  spans.map((current, spanIndex) =>\\n                    spanIndex === index ? value : current,\\n                  ),\\n                )\\n              }}\\n            />\\n            <span className={styles.unit}>mm</span>\\n            <button\\n              type=\\\"button\\\"\\n              className={styles.removeButton}\\n              aria-label={`${spanName(index)}${t(\\n                locale,\\n                'plan.removeSpan',\\n              )}`}\\n              disabled={spans.length === 1}\\n              onClick={() =>\\n                commit(spans.filter((_, spanIndex) => spanIndex !== index))\\n              }\\n            >\\n              ??            </button>\\n          </div>\\n        ))}\\n      </div>\\n      <button\\n        type=\\\"button\\\"\\n        className={styles.addButton}\\n        onClick={() => commit([...spans, spans[spans.length - 1]])}\\n      >\\n        {axisLabel}\\n        {t(locale, 'plan.addSpan')}\\n      </button>\\n    </fieldset>\\n  )\\n}\\n\\n/**\\n * ?ⓩ쓲??냵力뺝윜??ㄷ?띲걬 (mm)?귡뼀?ｉ깿??걪??릎?ュ룑?얇굢?ゃ걨?뚣겙?ゃ굢?ゃ걚\\n * 竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??뚦냵力뺝?力뺛띲겘?ⓩ쓲??냵力뺛겗訝?겗屋긱걽竊됥? *\\n * 黎귙굙?됥굦?ゃ걚?ⓩ쓲??null ?믦퓭?????쀣걨?뗥ㄷ歟곥굜?긱걣轝졼걨?╉걚?뗣겏?끾퀡?뚧군?얇굢?싥? * ?앫겗?ⓩ쓲??걹?귙걹?귝빊?뤵겓?뷩겍?꾠겒?꾠귡뼀?ｃ굮擁녈걵?뗥졃??㎯겘?ゃ걚?? */\\nfunction memberClearSize(\\n  project: Project,\\n  member: Member,\\n): { xMm: number; yMm: number } | null {\\n  try {\\n    if (member.kind === '?먬쐡鶯?) {\\n      const span = wallSpan(project, member)\\n      return { xMm: span.clearLengthMm, yMm: span.clearHeightMm }\\n    }\\n    if (member.kind === '佯딀씮') {\\n      const bay = slabBay(project, member)\\n      return { xMm: bay.clearXMm, yMm: bay.clearYMm }\\n    }\\n  } catch {\\n    return null\\n  }\\n  return null\\n}\\n\\nfunction replaceOpenings(\\n  project: Project,\\n  memberId: string,\\n  openings: Opening[],\\n): Project {\\n  return {\\n    ...project,\\n    members: project.members.map((member) => {\\n      if (member.id !== memberId) return member\\n      // 令븅뀓?쀣겘?뚪뼀?ｃ겒?쀣띯???꺖?믤츐?쇻겏岳앭춼?쀣걼 JSON ?ユ꼷?녈겗?ゃ걚?띶닓?뚥를?뜰?      if (openings.length === 0) {\\n        const next = { ...member }\\n        delete next.openings\\n        return next\\n      }\\n      return { ...member, openings }\\n    }),\\n  }\\n}\\n\\nfunction replaceOpeningReinforcements(\\n  project: Project,\\n  memberId: string,\\n  openingId: string,\\n  reinforcements: OpeningReinforcement[],\\n): Project {\\n  return {\\n    ...project,\\n    members: project.members.map((member) => {\\n      if (member.id !== memberId || member.openings === undefined) {\\n        return member\\n      }\\n\\n      return {\\n        ...member,\\n        openings: member.openings.map((opening) => {\\n          if (opening.id !== openingId) return opening\\n\\n          // 令븅뀓?쀣겘?뚪뼀?ｈ짒凉루춮??빪鼇섅겒?쀣띯???꺖?믤츐?쇻겏?곫쑋邕?쮼?①㈉??          // ?띶닓?믣닪??듁?뗣겏?쀣겍岳앭춼?쇻굥?볝겏?ャ겒?뗣굊penings ?や퐪?ⓨ릪?섋쫸榮꾠?          if (reinforcements.length === 0) {\\n            const next = { ...opening }\\n            delete next.reinforcements\\n            return next\\n          }\\n\\n          return { ...opening, reinforcements }\\n        }),\\n      }\\n    }),\\n  }\\n}\\n\\nconst openingFields = [\\n  { key: 'xMm', label: 'plan.openings.x' },\\n  { key: 'yMm', label: 'plan.openings.y' },\\n  { key: 'widthMm', label: 'plan.openings.width' },\\n  { key: 'heightMm', label: 'plan.openings.height' },\\n] as const\\n\\n/**\\n * ?뗥룭?ⓦ겗?ε뒟 (?곈뇧令띸츞?뷸틬 1?싧뎴8))?귝뼪?㏘?誤㎯겎??겒?뤷뭄?㏂겓營?걦??겘?곲뼀?ｃ걣\\n * ??씊竊덄Е?뤄펹?㎯겘?ゃ걦**?앫겗1?싥겗?ⓩ쓲**?ュ콪?쇻굥?뗣굢?????뚣걯寧?뤇??즯?뚥퐬?싥굚\\n * 兩뷩겇??겓囹볝겘?앫겗1?싥겓?뗣걚?╉걚??(ADR-004?틻DR-029)?? */\\nfunction OpeningEditor() {\\n  const project = useAppStore(({ project }) => project)\\n  const locale = useAppStore(({ locale }) => locale)\\n  const selectedMemberId = useAppStore(({ sel }) => sel.memberId)\\n  const updateProject = useAppStore(({ updateProject }) => updateProject)\\n  const editReported = useRef(false)\\n\\n  const member = project.members.find(({ id }) => id === selectedMemberId)\\n  const clear = member === undefined ? null : memberClearSize(project, member)\\n\\n  if (!member || clear === null) {\\n    return (\\n      <p className={styles.openingHint} data-testid=\\\"opening-editor-hint\\\">\\n        {t(locale, 'plan.openings.select')}\\n      </p>\\n    )\\n  }\\n\\n  const section = findSection(project, member.sectionId)\\n  const openings = member.openings ?? []\\n  const minimumAreaMm2 =\\n    lookupRule(jpMlitRulePack, 'measure.opening.deduction.minimum.area', {})\\n      .value * 1_000_000\\n\\n  const reportEdit = () => {\\n    if (editReported.current) return\\n    editReported.current = true\\n    capture('opening_edited', { memberKind: member.kind })\\n  }\\n\\n  const commit = (next: Opening[]) => {\\n    updateProject((current) => replaceOpenings(current, member.id, next))\\n    reportEdit()\\n  }\\n\\n  const commitReinforcements = (\\n    openingId: string,\\n    reinforcements: OpeningReinforcement[],\\n  ) => {\\n    updateProject((current) =>\\n      replaceOpeningReinforcements(\\n        current,\\n        member.id,\\n        openingId,\\n        reinforcements,\\n      ),\\n    )\\n    reportEdit()\\n  }\\n\\n  const add = () => {\\n    // ?℡츣?ㅳ겘?끾퀡??릎鸚?겓1/3??ㄷ?띲걬?귙겑?볝겒?ⓩ쓲?㎯굚恙끹걳?롢겲?뗥ㄷ?띲걬?뗣굢\\n    // 冶뗣굙?뚣겙?곭쉰?꾠걼?ч뼋?ャ뚦냵力뺛굮??겳?뷩걲?띲겎?ⓩ쓲?붵겏?썬걾?뗣걪?ⓦ걣?ゃ걚??    const widthMm = Math.max(1, Math.round(clear.xMm / 3))\\n    const heightMm = Math.max(1, Math.round(clear.yMm / 3))\\n    commit([\\n      ...openings,\\n      {\\n        id: `${member.id}|op${openings.length + 1}`,\\n        xMm: Math.round((clear.xMm - widthMm) / 2),\\n        yMm: Math.round((clear.yMm - heightMm) / 2),\\n        widthMm,\\n        heightMm,\\n      },\\n    ])\\n  }\\n\\n  const addReinforcement = (opening: Opening) => {\\n    commitReinforcements(opening.id, [\\n      ...(opening.reinforcements ?? []),\\n      // 孃꾠겘?멩뒢?㏂겗?덆젺?믢뺍營?걤?쇻굥?귟Þ鼇덆빓?뺛겘誤뤸틬?뗣굢鵝쒌굢?싥곮Þ鼇덂쎋?멥겗\\n      // 邕?쮼?ㅳ굮?⑴뵪?끹걣?ε뒟?쇻굥?얇겎 0 ??겲?얇겓?쀣겍?곮＝?곥걣?ㅳ굮?뷸삇?쀣겒?꾠?      { size: BAR_SIZES[0], count: 1, lengthMm: 0 },\\n    ])\\n  }\\n\\n  return (\\n    <fieldset className={styles.openingFieldset} data-testid=\\\"opening-editor\\\">\\n      <legend className={styles.spanLegend}>\\n        {t(locale, 'plan.openings.title')} ??{section.mark}竊덂냵力?{clear.xMm}횞\\n        {clear.yMm}竊?      </legend>\\n      <p className={styles.openingHint}>{t(locale, 'plan.openings.hint')}</p>\\n      {openings.length === 0 ? (\\n        <p className={styles.openingHint}>{t(locale, 'plan.openings.empty')}</p>\\n      ) : (\\n        <ul className={styles.openingList}>\\n          {openings.map((opening, index) => {\\n            const outside =\\n              opening.xMm < 0 ||\\n              opening.yMm < 0 ||\\n              opening.xMm + opening.widthMm > clear.xMm ||\\n              opening.yMm + opening.heightMm > clear.yMm\\n            const ignored =\\n              opening.widthMm * opening.heightMm <= minimumAreaMm2\\n\\n            return (\\n              <li className={styles.openingItem} key={opening.id}>\\n                {openingFields.map(({ key, label }) => (\\n                  <label className={styles.openingField} key={key}>\\n                    <span className={styles.openingFieldLabel}>\\n                      {t(locale, label)}\\n                    </span>\\n                    <input\\n                      className={styles.spanInput}\\n                      type=\\\"number\\\"\\n                      min=\\\"0\\\"\\n                      step=\\\"10\\\"\\n                      value={opening[key]}\\n                      aria-label={`${section.mark} ${member.id} ${index + 1} ${t(\\n                        locale,\\n                        label,\\n                      )}`}\\n                      onChange={(event) => {\\n                        const value = Number(event.currentTarget.value)\\n                        if (!Number.isFinite(value) || value < 0) return\\n                        commit(\\n                          openings.map((current, position) =>\\n                            position === index\\n                              ? { ...current, [key]: value }\\n                              : current,\\n                          ),\\n                        )\\n                      }}\\n                    />\\n                  </label>\\n                ))}\\n                <button\\n                  type=\\\"button\\\"\\n                  className={styles.removeButton}\\n                  aria-label={`${section.mark} ${member.id} ${index + 1} ${t(\\n                    locale,\\n                    'plan.openings.remove',\\n                  )}`}\\n                  onClick={() =>\\n                    commit(openings.filter((_, position) => position !== index))\\n                  }\\n                >\\n                  ??                </button>\\n                {ignored && (\\n                  <span className={styles.openingNote}>\\n                    {t(locale, 'plan.openings.ignored')}\\n                  </span>\\n                )}\\n                {outside && (\\n                  <span\\n                    className={styles.openingWarning}\\n                    data-testid=\\\"opening-outside\\\"\\n                  >\\n                    ???끾퀡?믡겘?욕눣?쀣겍?꾠겲??                  </span>\\n                )}\\n                <div\\n                  className={styles.reinforcementEditor}\\n                  data-testid={`opening-reinforcements-${opening.id}`}\\n                >\\n                  <span className={styles.openingFieldLabel}>\\n                    {t(locale, 'plan.openings.reinforcements.title')}\\n                  </span>\\n                  <p className={styles.openingHint}>\\n                    {t(locale, 'plan.openings.reinforcements.hint')}\\n                  </p>\\n                  {(opening.reinforcements ?? []).length === 0 ? (\\n                    <p\\n                      className={styles.openingHint}\\n                      data-testid={`opening-reinforcements-empty-${opening.id}`}\\n                    >\\n                      {t(locale, 'plan.openings.reinforcements.empty')}\\n                    </p>\\n                  ) : (\\n                    <ul className={styles.reinforcementList}>\\n                      {(opening.reinforcements ?? []).map(\\n                        (reinforcement, reinforcementIndex) => {\\n                          const labelPrefix = `${section.mark} ${member.id} ${\\n                            index + 1\\n                          } ${t(\\n                            locale,\\n                            'plan.openings.reinforcements.title',\\n                          )} ${reinforcementIndex + 1}`\\n\\n                          return (\\n                            <li\\n                              className={styles.reinforcementItem}\\n                              data-testid={`opening-reinforcement-${opening.id}-${reinforcementIndex}`}\\n                              key={`${opening.id}-reinforcement-${reinforcementIndex}`}\\n                            >\\n                              <label className={styles.openingField}>\\n                                <span className={styles.openingFieldLabel}>\\n                                  {t(\\n                                    locale,\\n                                    'plan.openings.reinforcements.size',\\n                                  )}\\n                                </span>\\n                                <select\\n                                  className={styles.spanInput}\\n                                  value={reinforcement.size}\\n                                  aria-label={`${labelPrefix} ${t(\\n                                    locale,\\n                                    'plan.openings.reinforcements.size',\\n                                  )}`}\\n                                  onChange={(event) => {\\n                                    const size = event.currentTarget\\n                                      .value as BarSize\\n                                    commitReinforcements(\\n                                      opening.id,\\n                                      (opening.reinforcements ?? []).map(\\n                                        (current, position) =>\\n                                          position === reinforcementIndex\\n                                            ? { ...current, size }\\n                                            : current,\\n                                      ),\\n                                    )\\n                                  }}\\n                                >\\n                                  {BAR_SIZES.map((size) => (\\n                                    <option key={size} value={size}>\\n                                      {size}\\n                                    </option>\\n                                  ))}\\n                                </select>\\n                              </label>\\n                              <label className={styles.openingField}>\\n                                <span className={styles.openingFieldLabel}>\\n                                  {t(\\n                                    locale,\\n                                    'plan.openings.reinforcements.count',\\n                                  )}\\n                                </span>\\n                                <input\\n                                  className={styles.spanInput}\\n                                  type=\\\"number\\\"\\n                                  min=\\\"1\\\"\\n                                  step=\\\"1\\\"\\n                                  value={reinforcement.count}\\n                                  aria-label={`${labelPrefix} ${t(\\n                                    locale,\\n                                    'plan.openings.reinforcements.count',\\n                                  )}`}\\n                                  onChange={(event) => {\\n                                    const count = Number(\\n                                      event.currentTarget.value,\\n                                    )\\n                                    if (\\n                                      !Number.isInteger(count) ||\\n                                      count < 1\\n                                    ) {\\n                                      return\\n                                    }\\n                                    commitReinforcements(\\n                                      opening.id,\\n                                      (opening.reinforcements ?? []).map(\\n                                        (current, position) =>\\n                                          position === reinforcementIndex\\n                                            ? { ...current, count }\\n                                            : current,\\n                                      ),\\n                                    )\\n                                  }}\\n                                />\\n                              </label>\\n                              <label className={styles.openingField}>\\n                                <span className={styles.openingFieldLabel}>\\n                                  {t(\\n                                    locale,\\n                                    'plan.openings.reinforcements.length',\\n                                  )}\\n                                </span>\\n                                <input\\n                                  className={styles.spanInput}\\n                                  type=\\\"number\\\"\\n                                  min=\\\"0\\\"\\n                                  step=\\\"10\\\"\\n                                  value={reinforcement.lengthMm}\\n                                  aria-label={`${labelPrefix} ${t(\\n                                    locale,\\n                                    'plan.openings.reinforcements.length',\\n                                  )}`}\\n                                  onChange={(event) => {\\n                                    const lengthMm = Number(\\n                                      event.currentTarget.value,\\n                                    )\\n                                    if (\\n                                      !Number.isFinite(lengthMm) ||\\n                                      lengthMm < 0\\n                                    ) {\\n                                      return\\n                                    }\\n                                    commitReinforcements(\\n                                      opening.id,\\n                                      (opening.reinforcements ?? []).map(\\n                                        (current, position) =>\\n                                          position === reinforcementIndex\\n                                            ? { ...current, lengthMm }\\n                                            : current,\\n                                      ),\\n                                    )\\n                                  }}\\n                                />\\n                              </label>\\n                              <button\\n                                type=\\\"button\\\"\\n                                className={styles.removeButton}\\n                                aria-label={`${labelPrefix} ${t(\\n                                  locale,\\n                                  'plan.openings.reinforcements.remove',\\n                                )}`}\\n                                onClick={() =>\\n                                  commitReinforcements(\\n                                    opening.id,\\n                                    (opening.reinforcements ?? []).filter(\\n                                      (_, position) =>\\n                                        position !== reinforcementIndex,\\n                                    ),\\n                                  )\\n                                }\\n                              >\\n                                ??                              </button>\\n                            </li>\\n                          )\\n                        },\\n                      )}\\n                    </ul>\\n                  )}\\n                  <button\\n                    type=\\\"button\\\"\\n                    className={styles.addButton}\\n                    onClick={() => addReinforcement(opening)}\\n                  >\\n                    {t(locale, 'plan.openings.reinforcements.add')}\\n                  </button>\\n                </div>\\n              </li>\\n            )\\n          })}\\n        </ul>\\n      )}\\n      <button type=\\\"button\\\" className={styles.addButton} onClick={add}>\\n        {t(locale, 'plan.openings.add')}\\n      </button>\\n    </fieldset>\\n  )\\n}\\n\\nexport function PlanEditor() {\\n  const project = useAppStore(({ project }) => project)\\n  const activeStoryId = useAppStore(({ activeStoryId }) => activeStoryId)\\n  const story = project.stories.find(({ id }) => id === activeStoryId)\\n  const transform = drawingTransform(project)\\n  const xCoordinates = spanCoordinates(project.grid.xSpans)\\n  const yCoordinates = spanCoordinates(project.grid.ySpans)\\n  const members = project.members.filter(\\n    ({ storyId }) => storyId === activeStoryId,\\n  )\\n\\n  if (!story) {\\n    throw storyNotFound(activeStoryId)\\n  }\\n\\n  return (\\n    <div className={styles.editor}>\\n      <div className={styles.spanEditors}>\\n        <SpanEditor axis=\\\"x\\\" />\\n        <SpanEditor axis=\\\"y\\\" />\\n      </div>\\n      <OpeningEditor />\\n      <div className={styles.drawingFrame}>\\n        <svg\\n          className={styles.drawing}\\n          viewBox={`0 0 ${viewWidth} ${viewHeight}`}\\n          role=\\\"img\\\"\\n          aria-label={`${story.name} 亮녜씊`}\\n        >\\n          {members\\n            .filter(({ kind }) => kind === '佯딀씮')\\n            .map((member) => (\\n              <PlanMember\\n                key={member.id}\\n                member={member}\\n                project={project}\\n                transform={transform}\\n              />\\n            ))}\\n          {members\\n            .filter(({ kind }) => kind === '?먬쐡鶯?)\\n            .map((member) => (\\n              <PlanMember\\n                key={member.id}\\n                member={member}\\n                project={project}\\n                transform={transform}\\n              />\\n            ))}\\n          {members\\n            .filter(({ kind }) => kind === '鸚㎪쥈')\\n            .map((member) => (\\n              <PlanMember\\n                key={member.id}\\n                member={member}\\n                project={project}\\n                transform={transform}\\n              />\\n            ))}\\n          {members\\n            .filter(({ kind }) => kind === '??)\\n            .map((member) => (\\n              <PlanMember\\n                key={member.id}\\n                member={member}\\n                project={project}\\n                transform={transform}\\n              />\\n            ))}\\n\\n          {xCoordinates.map((x, index) => (\\n            <text\\n              className={styles.axisLabel}\\n              key={`x-axis-${index}`}\\n              x={transform.x(x)}\\n              y={plotTop - 18}\\n              textAnchor=\\\"middle\\\"\\n            >\\n              X{index + 1}\\n            </text>\\n          ))}\\n          {yCoordinates.map((y, index) => (\\n            <text\\n              className={styles.axisLabel}\\n              key={`y-axis-${index}`}\\n              x={plotLeft - 30}\\n              y={transform.y(y) + 4}\\n              textAnchor=\\\"end\\\"\\n            >\\n              Y{index + 1}\\n            </text>\\n          ))}\\n          {project.grid.xSpans.map((span, index) => {\\n            const start = transform.x(xCoordinates[index])\\n            const end = transform.x(xCoordinates[index + 1])\\n            return (\\n              <text\\n                className={styles.dimension}\\n                key={`x-span-${index}`}\\n                x={(start + end) / 2}\\n                y={plotTop + plotHeight + 48}\\n                textAnchor=\\\"middle\\\"\\n              >\\n                {span}\\n              </text>\\n            )\\n          })}\\n          {project.grid.ySpans.map((span, index) => {\\n            const start = transform.y(yCoordinates[index])\\n            const end = transform.y(yCoordinates[index + 1])\\n            return (\\n              <text\\n                className={styles.dimension}\\n                key={`y-span-${index}`}\\n                x={plotLeft - 42}\\n                y={(start + end) / 2 + 4}\\n                textAnchor=\\\"end\\\"\\n              >\\n                {span}\\n              </text>\\n            )\\n          })}\\n        </svg>\\n      </div>\\n    </div>\\n  )\\n}\\n\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command 'Get-Content -Raw src/domain/rebar/wall.ts; Get-Content -Raw src/domain/rebar/slab.ts'\",\"aggregated_output\":\"import type { BarSize, Member, WallSection } from '../model/member'\\r\\nimport type { WallSpan } from '../model/project'\\r\\nimport type { Rebar, RebarSplice, RebarZone } from '../model/rebar'\\r\\nimport { MemberUnsupportedError } from '../model/unsupported'\\r\\nimport { coverConditions, lookupRule } from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\nimport {\\r\\n  distributionCount,\\r\\n  intervalSpliceCount,\\r\\n  spliceCount,\\r\\n  spliceLengthMm,\\r\\n} from './measurement'\\r\\nimport { openingDeduction } from './opening'\\r\\nimport { stirrupPositions } from './stirrup-layout'\\r\\n\\r\\n/**\\r\\n * ?먬쐡鶯곻펷?⒲꺖?▲꺍礪뗩졼겗鶯곻펹??뀓嶺뗣귝빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯**1)**?뚦즯凉뤸쭓?졽빳鸚뽧?\\n * ?졼걨?믣츪獒끹걲????2)?뚦즯凉뤸쭓?졼띲겘塋?깿嶺뗣꺕鶯곫쥈嶺뗣겲?㎩뙷?녴걣罌쀣걟?뗥닪??씉?뉎겎?귙굥??\\n *\\r\\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폊竊됧즯竊됥걣鶯곥굮?뚧윶?곫쥈?곩틞?욜춬??\\n * ?γ걲?뗥엩?닸쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲쳵?뺛겘?롩쳵?㎯겘?ゃ걦?끾퀡遙섅걬?곲빓?뺛겘\\r\\n * ?긷퓘?볝겎??겒?뤷냵力뺡빓?뺛겓?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\\n *\\r\\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲????`Member.openings` ?뚦룛?묈룚?ｃ걼?끾퀡野멩퀡?졼걨??\\n * ?앫겗?뗥룭?믤Ø?뉎굥?с굮??걦?쀣곫쵟?ㅹ뇧?붵겏?ュ냵鼇녈겗烏뚣굮?녴걨?뗣귡뼀?ｃ굮與ゅ늾?ｃ걼\\r\\n * 潁?춮??텤?뗣겘?뚣걯 2竊덌폊竊됧즯1)????퐜?멥겎 0?뗦??ャ겒?뗣귡뼀?ｈ짒凉루춮??릪?끹걣\\r\\n * ?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겏冶붶뻣?쇻굥??겎獒썲뱚??퐳?됥겒??(ADR-029?팕14)??\\n */\\r\\nexport interface WallRebarInput {\\r\\n  member: Member\\r\\n  section: WallSection\\r\\n  span: WallSpan\\r\\n}\\r\\n\\r\\nfunction barDiameter(size: BarSize): number {\\r\\n  const diameter = Number(size.replace(/^D/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid BarSize: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\r\\n  if (rule.unit === 'mm') return rule.value\\r\\n  if (rule.unit === 'd' && diameter !== undefined) {\\r\\n    return rule.value * diameter\\r\\n  }\\r\\n\\r\\n  throw new Error(\\r\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\r\\n  )\\r\\n}\\r\\n\\r\\nexport function generateWallRebar(\\r\\n  input: WallRebarInput,\\r\\n  pack: RulePack,\\r\\n): Rebar[] {\\r\\n  const { member, section, span } = input\\r\\n  const conditions = { fc: section.fc, grade: section.grade, hook: false }\\r\\n\\r\\n  const coverRule = lookupRule(pack, 'cover.minimum', coverConditions(section))\\r\\n  const fabricationCoverAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.fabrication.addition',\\r\\n    {},\\r\\n  )\\r\\n  // 若싩???〃5.3.4 ????у?L1?귛릪烏ⓦ겓鶯곩컗?ⓦ겗?쀣겘?ゃ걦?갟2 ??컦歟곥꺕L3 ??궧?⒲깣??\\n  // ?먦굢?뚣굥竊덅〃??걣?앫겗2?ㅳ걽?묆굮?띷뙁?숋펹??겎?곩즯嶺뗣겘訝?уㅳ굮凉뺛걦??\\n  const anchorageRule = lookupRule(pack, 'anchorage.L1', conditions)\\r\\n  const tableLapRule = lookupRule(pack, 'lap.L1', conditions)\\r\\n  // 5.3.4(3)(節? ???먨뒟鶯곥걽?묆걣?곥겇訝뗩솏?귝윶?삥쥈??말嶺뗣겏?뺛걚烏?.3.2 ??ㅳ굮?앫겗?얇겲\\r\\n  // 鵝욍굩?싥?0d ?ⓩ캈?밤겍鸚㎯걤?꾣뼶?믣룚?뗣?\\n  const wallLapMinimumRule = lookupRule(pack, 'lap.wall.minimum', {})\\r\\n  const spliceFactorRule = lookupRule(pack, 'measure.splice.length.factor', {\\r\\n    method: section.spliceMethod,\\r\\n  })\\r\\n  const distributionAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'measure.distribution.addition',\\r\\n    {},\\r\\n  )\\r\\n\\r\\n  const minimumCover = millimetres(coverRule)\\r\\n  const fabricationCover =\\r\\n    minimumCover + millimetres(fabricationCoverAdditionRule)\\r\\n  const layerOffsets = wallLayerOffsets(member, section, fabricationCover)\\r\\n\\r\\n  const shared = {\\r\\n    member,\\r\\n    section,\\r\\n    span,\\r\\n    layerOffsets,\\r\\n    anchorageRule,\\r\\n    tableLapRule,\\r\\n    wallLapMinimumRule,\\r\\n    spliceFactorRule,\\r\\n    distributionAdditionRule,\\r\\n    coverRule,\\r\\n    fabricationCoverAdditionRule,\\r\\n    fabricationCover,\\r\\n    pack,\\r\\n  }\\r\\n\\r\\n  return [\\r\\n    ...buildWallBars({\\r\\n      ...shared,\\r\\n      role: '潁?춮',\\r\\n      size: section.vertical.size,\\r\\n      pitchMm: section.vertical.pitch,\\r\\n      startOffsetMm: section.vertical.startOffsetMm,\\r\\n      // 潁?춮??즯??쳵?뺛굮歷с굤?곩냵力뺡빓?뺛겓?꿔굤餓섅걨?뗣?\\n      bodyLengthMm: span.clearHeightMm,\\r\\n      distributionOverMm: span.clearLengthMm,\\r\\n      bodyLabel: '?끾퀡遙섅걬',\\r\\n      distributionLabel: '?끾퀡?룔걬',\\r\\n      repeatAxis: 'x',\\r\\n      barAxis: 'y',\\r\\n    }),\\r\\n    ...buildWallBars({\\r\\n      ...shared,\\r\\n      role: '與ょ춮',\\r\\n      size: section.horizontal.size,\\r\\n      pitchMm: section.horizontal.pitch,\\r\\n      startOffsetMm: section.horizontal.startOffsetMm,\\r\\n      // 與ょ춮??즯??빓?뺛굮歷с굤?곩냵力뺡쳵?뺛겓?꿔굤餓섅걨?뗣?\\n      bodyLengthMm: span.clearLengthMm,\\r\\n      distributionOverMm: span.clearHeightMm,\\r\\n      bodyLabel: '?끾퀡?룔걬',\\r\\n      distributionLabel: '?끾퀡遙섅걬',\\r\\n      repeatAxis: 'y',\\n      barAxis: 'x',\\n    }),\\n    ...openingReinforcementRebars(member),\\n  ]\\n}\\n\\nfunction openingReinforcementRebars(member: Member): Rebar[] {\\n  return (member.openings ?? []).flatMap((opening) =>\\n    (opening.reinforcements ?? []).map(\\n      (reinforcement, index): Rebar => ({\\n        id: `${member.id}|opening-${opening.id}|reinforcement-${index}`,\\n        memberId: member.id,\\n        role: '?뗥룭獒쒎섭嶺?,\\n        size: reinforcement.size,\\n        count: reinforcement.count,\\n        length: reinforcement.lengthMm,\\n        shape: 'straight',\\n        points: [\\n          [0, 0, 0],\\n          [reinforcement.lengthMm, 0, 0],\\n        ],\\n        closed: false,\\n        formula:\\n          `鼇?쮫?룔걬 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.lengthMm}mm 竊?` +\\n          `?ф빊 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.count}??竊?孃?竊?${reinforcement.size} ` +\\n          `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ?ゃ걡?멥걤 ???뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑?ャ굠?딂쮫歷с꺕鼇덄츞竊?,\\n        ruleHits: [],\\n      }),\\n    ),\\n  )\\n}\\n\\n/**\\n * ?띸춮??광?뚦즯?싥겗?⒲걪?ョ쳦?ㅳ걢 (mm)?귙??뽧꺂??륫?㏂겗?뗣겤?듾퐤營?곥궥?녈궛?ャ겘\\r\\n * ?싥걬??릎鸚?겎?귙굥??D 壤®듁?ャ걮?뗥듅?뗣겒?????곈뇧??광?겹걽?묆굮誤뗣굥??\\n */\\r\\nfunction wallLayerOffsets(\\r\\n  member: Member,\\r\\n  section: WallSection,\\r\\n  fabricationCover: number,\\r\\n): number[] {\\r\\n  if (section.layers === 1) return [section.thickness / 2]\\r\\n\\r\\n  const inner = section.thickness - fabricationCover\\r\\n\\r\\n  // ?졾램?ⓦ걢?뜰굤횞2 ?뚦즯?싥굮擁끹걟?뗣겏2掠ㅳ걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂?잌즯?ャ겒?뗣?\\n  // 容쇻겂?╊릎鸚?겓野꾠걵?싥곥걹??깿?먦걽?묋맼?ⓦ걲竊덃윶??뒥藥ε?力뺛궗?쇈깋?ⓨ릪?섉돮?꾬펹??\\n  if (inner <= fabricationCover) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `?먬쐡鶯???뽧꺂?띸춮 must fit the 鶯곩럻: ${member.id} ` +\\r\\n        `(鶯곩럻 ${section.thickness} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCover})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  return [fabricationCover, inner]\\r\\n}\\r\\n\\r\\ninterface WallBarInput {\\r\\n  member: Member\\r\\n  section: WallSection\\r\\n  span: WallSpan\\r\\n  role: '潁?춮' | '與ょ춮'\\r\\n  size: BarSize\\r\\n  pitchMm: number\\r\\n  startOffsetMm: number\\r\\n  bodyLengthMm: number\\r\\n  distributionOverMm: number\\r\\n  bodyLabel: string\\r\\n  distributionLabel: string\\r\\n  repeatAxis: 'x' | 'y'\\r\\n  /** ?꾤춮?뚩뎔?뗥릲????濚겹굤瓦붵걮邕멥겏?답벡?쇻굥?귡뼀?ｉ깿??쵟?ㅳ걣?볝굦?믦쫳??*/\\r\\n  barAxis: 'x' | 'y'\\r\\n  layerOffsets: number[]\\r\\n  anchorageRule: RuleHit\\r\\n  tableLapRule: RuleHit\\r\\n  wallLapMinimumRule: RuleHit\\r\\n  spliceFactorRule: RuleHit\\r\\n  distributionAdditionRule: RuleHit\\r\\n  coverRule: RuleHit\\r\\n  fabricationCoverAdditionRule: RuleHit\\r\\n  fabricationCover: number\\r\\n  pack: RulePack\\r\\n}\\r\\n\\r\\nfunction buildWallBars(input: WallBarInput): Rebar[] {\\r\\n  const {\\r\\n    member,\\r\\n    section,\\r\\n    span,\\r\\n    role,\\r\\n    size,\\r\\n    pitchMm,\\r\\n    startOffsetMm,\\r\\n    bodyLengthMm,\\r\\n    distributionOverMm,\\r\\n    bodyLabel,\\r\\n    distributionLabel,\\r\\n    repeatAxis,\\r\\n    barAxis,\\r\\n    layerOffsets,\\r\\n    anchorageRule,\\r\\n    tableLapRule,\\r\\n    wallLapMinimumRule,\\r\\n    spliceFactorRule,\\r\\n    distributionAdditionRule,\\r\\n    coverRule,\\r\\n    fabricationCoverAdditionRule,\\r\\n    fabricationCover,\\r\\n    pack,\\r\\n  } = input\\r\\n\\r\\n  const diameter = barDiameter(size)\\r\\n  const anchorageMm = millimetres(anchorageRule, diameter)\\r\\n  const tableLapMm = millimetres(tableLapRule, diameter)\\r\\n  const wallLapMinimumMm = millimetres(wallLapMinimumRule, diameter)\\r\\n  const lapMm = Math.max(tableLapMm, wallLapMinimumMm)\\r\\n\\r\\n  // 1?싧뎴7) ??돯餓섉쑍?겹겘1掠ㅵ늽?졼귛광?곤펷?룔꺍?겹꺂竊뤵??뽧꺂竊됥겘誤뤸틬?㎯겘?ゃ걦\\r\\n  // 鶯곥꺁?밤깉??쮼雍됥겎?귙굤?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)??\\n  const perLayerCount = distributionCount(\\r\\n    distributionOverMm,\\r\\n    pitchMm,\\r\\n    distributionAdditionRule,\\r\\n  )\\r\\n  const layout = stirrupPositions(distributionOverMm, pitchMm, startOffsetMm)\\r\\n\\r\\n  // 1?싧뎴8) ???뗥룭?ⓦ굮與ゅ늾?뗦쑍?졼걨?뚪뼀?ｃ겗?끾퀡野멩퀡?졼걨??걦?ゃ굥?귝쵟?ㅹ뇧?붵겏??\\n  // ?낁㉢??죱?뚦늽?뗣굦?뗰펷1?싧뎴 ?띷뻼?뚩쫸?쇈곩숱?뜰곩?力뺟춬?붵겏?ャ랃펹??\\n  const deduction = openingDeduction(\\r\\n    {\\r\\n      openings: member.openings ?? [],\\r\\n      clearXMm: span.clearLengthMm,\\r\\n      clearYMm: span.clearHeightMm,\\r\\n      barAxis,\\r\\n      pitchMm,\\r\\n      totalCount: perLayerCount,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  const openingLayout = deduction.layout\\r\\n  const ignoredTerm =\\r\\n    deduction.ignored.length === 0\\r\\n      ? ''\\r\\n      : ` 竊?轝좈솮?쀣겒?꾦뼀??${deduction.ignored\\r\\n          .map(({ widthMm, heightMm }) => `${widthMm}횞${heightMm}`)\\r\\n          .join('??)}竊??싧뎴8) 鵝녷쎑 ??1?뗦?壤볝걼?듿냵力뺡씊令?.5?▽빳訝뗰펹`\\r\\n\\r\\n  // 3D ?ユ룒?뗣굦?뗧탪瓮?귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?ゃ걚竊덅〃5.3.3 ?뚦렅?뉎겎?삣깗竊됥?\\n  // ?뗥룭??쵟?묆굚?볝걪?ャ겘?얇굦?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝??겎?곮〃鹽븅깿??\\n  // `Member.openings` ?㎩늾??(ADR-029)??\\n  const pathLengthMm = bodyLengthMm + 2 * anchorageMm\\r\\n\\r\\n  const anchorageTarget = role === '潁?춮' ? '訝듾툔??ㄷ歟곥꺕佯딀씮' : '訝▼겢??윶'\\r\\n  const layerTerm =\\r\\n    section.layers === 1 ? '?룔꺍?겹꺂?띸춮 횞1' : `??뽧꺂?띸춮 횞${section.layers}`\\r\\n  const roleKey = role === '潁?춮' ? 'vertical' : 'horizontal'\\r\\n\\r\\n  const zones: RebarZone[] = [\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: anchorageRule.key,\\r\\n      pathFromMm: 0,\\r\\n      pathToMm: anchorageMm,\\r\\n    },\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: anchorageRule.key,\\r\\n      pathFromMm: pathLengthMm - anchorageMm,\\r\\n      pathToMm: pathLengthMm,\\r\\n    },\\r\\n  ]\\r\\n\\r\\n  // 餓ｈ〃1?с겘濚겹굤瓦붵걮邕멥겗?잏궧?ョ쉰????若잓슋??퐤營?겘 placement ?뚥툗?덀굥??\\n  // 躍?춮?삠걗?겹굢嶺뗣겏?뚣걯榮꾣씇?㎯곮〃鹽븅깿?뚧뼪?㏂걢?됥깞?껁긽?믤떮?꾤쎍?뺛겒?꾠걼?곥겎?귙굥??\\n  const z = layerOffsets[0]\\r\\n  const points: [number, number, number][] =\\r\\n    role === '潁?춮'\\r\\n      ? [\\r\\n          [0, -anchorageMm, z],\\r\\n          [0, bodyLengthMm + anchorageMm, z],\\r\\n        ]\\r\\n      : [\\r\\n          [-anchorageMm, 0, z],\\r\\n          [bodyLengthMm + anchorageMm, 0, z],\\r\\n        ]\\r\\n\\r\\n  return deduction.groups.map(({ deductionMm, count: groupCount }) => {\\r\\n    // 1?싧뎴4) ?뚨텤?뗧츋??겹굮黎귙굙?뗣뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띲겘轝좈솮孃뚣겗?룔걬?졼?\\n    const measuredLengthMm = bodyLengthMm - deductionMm + 2 * anchorageMm\\r\\n\\r\\n    const splice = resolveWallSplice({\\r\\n      role,\\r\\n      section,\\r\\n      size,\\r\\n      measuredLengthMm,\\r\\n      lapMm,\\r\\n      deducted: deductionMm > 0,\\r\\n      tableLapRule,\\r\\n      wallLapMinimumRule,\\r\\n      spliceFactorRule,\\r\\n      pack,\\r\\n    })\\r\\n\\r\\n    const designLengthMm = measuredLengthMm + splice.lengthMm\\r\\n    const count = groupCount * section.layers\\r\\n    const positionsMm = openingLayout\\r\\n      ? openingLayout.positionsMm.filter(\\r\\n          (_, index) => openingLayout.deductionsMm[index] === deductionMm,\\r\\n        )\\r\\n      : null\\r\\n\\r\\n    const deductionTerm =\\r\\n      deductionMm === 0\\r\\n        ? ''\\r\\n        : ` ???뗥룭?ⓦ겗轝좈솮 ${deductionMm}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??兩뷴끁窈욅춬` +\\r\\n          `?뗥룭?ⓦ겗?끾퀡野멩퀡?ャ굠?뗰펹`\\r\\n    const splitTerm =\\r\\n      deduction.groups.length === 1\\r\\n        ? ''\\r\\n        : ` ??걝??{\\r\\n            deductionMm === 0 ? '?뗥룭?믤Ø?뉎굢?ゃ걚' : `${deductionMm}?믤쵟??\\r\\n          } ${groupCount}??\\r\\n\\r\\n    return {\\r\\n      id: `${member.id}|${roleKey}${\\r\\n        deductionMm === 0 ? '' : `|轝좈솮${deductionMm}`\\r\\n      }`,\\r\\n      memberId: member.id,\\r\\n      role,\\r\\n      size,\\r\\n      shape: 'straight' as const,\\r\\n      points,\\r\\n      closed: false,\\r\\n      length: designLengthMm,\\r\\n      count,\\r\\n      placement: {\\r\\n        axis: repeatAxis,\\r\\n        clearMm: distributionOverMm,\\r\\n        pitchMm,\\r\\n        startOffsetMm,\\r\\n        lastGapMm: layout.lastGapMm,\\r\\n        positionCount: positionsMm\\r\\n          ? positionsMm.length\\r\\n          : layout.positionsMm.length,\\r\\n        ...(positionsMm ? { positionsMm } : {}),\\r\\n      },\\r\\n      splice,\\r\\n      zones,\\r\\n      ruleHits: [\\r\\n        coverRule,\\r\\n        fabricationCoverAdditionRule,\\r\\n        anchorageRule,\\r\\n        distributionAdditionRule,\\r\\n        ...deduction.rules,\\r\\n        ...splice.rules,\\r\\n      ],\\r\\n      formula:\\r\\n        `鼇?쮫?룔걬 竊?${bodyLabel} ${bodyLengthMm}${deductionTerm} 竊?若싩? L1 ` +\\r\\n        `${anchorageRule.value}d(${anchorageMm}) 횞 2竊덁륫塋???${anchorageTarget}?멨츣?竊? +\\r\\n        ` 竊?泳숁뎸 ${splice.formula} 竊?${designLengthMm} 竊?` +\\r\\n        `?ф빊 竊???{distributionLabel} ${distributionOverMm} 첨 ?붵긿??${pitchMm}??` +\\r\\n        `竊?${distributionAdditionRule.value}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴7)竊됵폓 ${perLayerCount}` +\\r\\n        `${splitTerm} 횞 ${layerTerm} 竊?${count} 竊?` +\\r\\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊??좂츞 ` +\\r\\n        `${fabricationCoverAdditionRule.value} 竊?${fabricationCover}竊?竊?` +\\r\\n        `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚竊덃룒?뗣굦?뗩빓??` +\\r\\n        `${pathLengthMm} ??Þ鼇덆빓?뺛겏訝?담걮?ゃ걚?삥빊?뤵겓??뵪?꾠겒?꾬펹${ignoredTerm}`,\\r\\n    }\\r\\n  })\\r\\n}\\r\\n\\r\\ninterface WallSpliceInput {\\r\\n  role: '潁?춮' | '與ょ춮'\\r\\n  section: WallSection\\r\\n  size: BarSize\\r\\n  /** 1?싧뎴4) ?뚩??녴뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띯??뗥룭?ⓦ겗轝좈솮?믣폊?꾠걼孃뚣겎?귙굥 */\\r\\n  measuredLengthMm: number\\r\\n  lapMm: number\\r\\n  /** ?볝겗獰ㅳ걣?뗥룭?ⓦ굮與ゅ늾?ｃ겍??걼?뚣겍?꾠굥??(2竊덌폊竊됧즯1)??鵝녷쎑) */\\r\\n  deducted: boolean\\r\\n  tableLapRule: RuleHit\\r\\n  wallLapMinimumRule: RuleHit\\r\\n  spliceFactorRule: RuleHit\\r\\n  pack: RulePack\\r\\n}\\r\\n\\r\\n/**\\r\\n * 2竊덌폊竊됧즯1)????潁?춮?ⓩØ嶺뗣겎?겹걟?밤걣?녴걢?뚣굥?????씉?뉎겎?귙굥??\\n * ?뚨를嶺뗣겗泳숁뎸??렅?뉎겏?쀣겍?꾦쉸?ワ폂?뗦??귙굥?귙겗?ⓦ걮?╈╉겲?잆곫Ø嶺뗣겗泳숁뎸???\\n *  竊묌싧뎴竊뷂펹?ャ굠?뗣띲?\\n */\\r\\nfunction resolveWallSplice(input: WallSpliceInput): RebarSplice {\\r\\n  const {\\r\\n    role,\\r\\n    section,\\r\\n    size,\\r\\n    measuredLengthMm,\\r\\n    lapMm,\\r\\n    deducted,\\r\\n    tableLapRule,\\r\\n    wallLapMinimumRule,\\r\\n    spliceFactorRule,\\r\\n    pack,\\r\\n  } = input\\r\\n\\r\\n  let countRule: RuleHit\\r\\n  let countPerBar: number\\r\\n  let countFormula: string\\r\\n\\r\\n  if (role === '潁?춮' && deducted) {\\r\\n    // ?뗥룭?믤Ø?뉎굥潁?춮??쉸遙섇뀲鵝볝겓?뤵걼?됥걳?곲뼀?ｉ깿?겼즯?삣엩?뚦즯??를嶺뗣겓?ゃ굥??\\n    // ?뚣걯?끹겗鵝녷쎑?뚣뚪뼀?ｉ깿?겼즯?곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗣띲겏若싥굙?뗣?\\n    countRule = lookupRule(pack, 'measure.splice.wall.opening', {})\\r\\n    countPerBar = spliceCount(countRule)\\r\\n    countFormula =\\r\\n      `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)??鵝녷쎑 ??` +\\r\\n      `?뗥룭?②뀺鶯곥곫뎸?쇻굤鶯곭춬??텤?뗣겘?ゃ걚?귙겗?ⓦ걲?뗰펹`\\r\\n  } else if (role === '潁?춮') {\\r\\n    countRule = lookupRule(pack, 'measure.splice.wall.vertical', {})\\r\\n    countPerBar = spliceCount(countRule)\\r\\n    countFormula = `${countPerBar}?뗦?竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????潁?춮??텤?뗣겘?꾦쉸???뗦?竊?\\r\\n  } else {\\r\\n    countRule = lookupRule(pack, 'measure.splice.interval', { size })\\r\\n    countPerBar = intervalSpliceCount(measuredLengthMm, countRule)\\r\\n    countFormula =\\r\\n      `?꾤춮??빓??${measuredLengthMm} 첨 ${countRule.value}mm ?붵겏 竊?${countPerBar}?뗦?` +\\r\\n      `竊덃빊?뤹찉嶸쀥읃繹?2竊덌폊竊됧즯1)????1?싧뎴4) ?ユ댗?숋펹`\\r\\n  }\\r\\n\\r\\n  const lengthMm = spliceLengthMm(countPerBar, lapMm, spliceFactorRule)\\r\\n  const rules: RuleHit[] = [countRule, spliceFactorRule]\\r\\n  if (lengthMm > 0) rules.push(tableLapRule, wallLapMinimumRule)\\r\\n\\r\\n  const lapTerm =\\r\\n    lengthMm > 0\\r\\n      ? `${countPerBar}?뗦? 횞 ?띲겖泳숁뎸?룔걬 ${lapMm}竊덃쮽繹뽨퍞礪섉쎑 5.3.4(3)(節? ??` +\\r\\n        `烏?.3.2 ??${tableLapRule.value}d ?②먨뒟鶯곥겗訝뗩솏 ` +\\r\\n        `${wallLapMinimumRule.value}d ??ㄷ?띲걚?뱄펹竊?${lengthMm}`\\r\\n      : `${countPerBar}?뗦? ??${section.spliceMethod}??빓?뺛겗鸚됧뙑?ゃ걮 0`\\r\\n\\r\\n  return {\\r\\n    method: section.spliceMethod,\\r\\n    countPerBar,\\r\\n    lengthMm,\\r\\n    rules,\\r\\n    formula:\\r\\n      `泳숁뎸嶸뉑???竊?${countFormula} 竊??밧폀 竊?${section.spliceMethod} 竊?` +\\r\\n      `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${lapTerm} 竊?` +\\r\\n      `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\\r\\n  }\\r\\n}\\r\\n\\r\\nimport type { BarSize, SlabSection } from '../model/member'\\r\\nimport type { SlabRun } from '../model/project'\\r\\nimport type { Rebar, RebarRole, RebarZone } from '../model/rebar'\\r\\nimport { MemberUnsupportedError } from '../model/unsupported'\\r\\nimport { coverConditions, lookupRule, lookupRuleSeries } from '../rules/lookup'\\r\\nimport type { RuleHit, RulePack } from '../rules/types'\\r\\nimport {\\r\\n  bandedSpliceRule,\\r\\n  distributionCount,\\r\\n  intervalSpliceCount,\\r\\n  spliceCount,\\r\\n  spliceLengthMm,\\r\\n  type SpliceBand,\\r\\n} from './measurement'\\r\\nimport { openingDeduction } from './opening'\\r\\nimport { resolveSlabEnd, type SlabEndDetail } from './slab-ends'\\r\\nimport { stirrupPositions } from './stirrup-layout'\\r\\n\\r\\n/**\\r\\n * 佯딀씮竊덀궧?⒲깣竊됥겗?띸춮?귝빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞???㎪릍??(ADR-028)??\\n *\\r\\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓?γ걲??\\n * 麗닷뭄?먦겗?끾퀡?ⓨ늽?띲겏若싥굙?뗣겗?㎯곲빓?뺛겘?싥굤??뼋?㎯겘?ゃ걦訝▼겢??ㄷ歟곥겗?끻겢?㏂겗?볝겓\\r\\n * ?ゃ굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠?뗣?\\n *\\r\\n * 1?욁겗?쇈겞?뷩걮?뚦룛?묉똻?ㅳ겗??*1?ㅳ겗?⒲꺍???밧릲**?㎯곦툓塋?춮?ⓧ툔塋?춮???с굮瓦붵걲??\\n * 佯딀씮???밧릲?ヤ말嶺뗣걣壅겹굥??겎?갲?밧릲?쮇?밧릲?㎩닪?끹겓?쇈겤??\\n *\\r\\n * ??꺖?ャ꺂佯㎪쮽??x 竊?X?싥굤?밧릲?걓 竊?Y?싥굤?밧릲?걕 竊??쏁쎍竊덃씮??툔塋?걣 0竊됥?\\n * ?졼걢??X?밧릲??뎱嶺뗣겘 x ?ヤ섯?녈겍 y ?멧를?녈갳?밧릲??뎱嶺뗣겘 y ?ヤ섯?녈겍 x ?멧를?뜰?\\n *\\r\\n * ?뗥룭?ⓦ겘 1?싧뎴8) ?㎪쵟?ㅳ걲?뗣귛틞?욍겗?뗥룭??쉸餘듐꺕鼇?굺??굚??겎?곭첆?ⓨ릪?섅걦?볝겗?끹겗\\r\\n * 野얕괌?????뚪쟿??깿?먦굮?먦겂?╉걚?ゃ걚?귡뼀?ｃ겘?쇻궎?붵겏?ュ뀯?쎼걬?뚣굥?뚪뎱嶺뗣겘?⒲꺍??\\n * 歷с굥??겎??SlabRun.openings` ?뚣꺀?녑벨與쇻겓?담걮?잆굚??굮誤뗣굥?귞텤?뗣겘鶯곥겏?뺛겂??\\n * 鵝녷쎑?뚣겒????2竊덌폇竊됧틞??) ??뙷?녴겘?뚦틞?욍겗?룔걬?띲겎凉뺛걦??겎?곲뼀?ｃ걣?귙겂?╉굚\\r\\n * ?ｇ텥佯딀씮??츋??겹겘鸚됥굩?됥겒?꾬펷?섊떖佯딀씮??1?싧뎴4) ?ゃ겗?㎪쵟?ㅵ풄??빓?뺛겎?겹걟?뗰펹??\\n * ?뗥룭獒쒎섭嶺뗣겘?뚩Þ鼇덂쎋?멥겓?덀굤鼇덃릍?삭쮫嶸쀣걲?뗣띲겗?㎬＝?곥겘鵝쒌굢?ゃ걚 (ADR-029?팕14)??\\n */\\r\\nexport interface SlabRebarInput {\\r\\n  run: SlabRun\\r\\n  section: SlabSection\\r\\n}\\r\\n\\r\\nfunction barDiameter(size: BarSize): number {\\r\\n  const diameter = Number(size.replace(/^D/, ''))\\r\\n\\r\\n  if (!Number.isFinite(diameter) || diameter <= 0) {\\r\\n    throw new Error(`Invalid BarSize: ${size}`)\\r\\n  }\\r\\n\\r\\n  return diameter\\r\\n}\\r\\n\\r\\nfunction millimetres(rule: RuleHit, diameter?: number): number {\\r\\n  if (rule.unit === 'mm') return rule.value\\r\\n  if (rule.unit === 'd' && diameter !== undefined) {\\r\\n    return rule.value * diameter\\r\\n  }\\r\\n\\r\\n  throw new Error(\\r\\n    `Rule ${rule.key} must use mm or use d with a supplied bar diameter`,\\r\\n  )\\r\\n}\\r\\n\\r\\nfunction uniqueRuleHits(rules: RuleHit[]): RuleHit[] {\\r\\n  return [...new Set(rules)]\\r\\n}\\r\\n\\r\\n/**\\r\\n * 2竊덌폇竊됧틞??) ??뙷?녻〃?귚퐬?뷴늽?귙굥?뗣겘?ャ꺖?ャ깙?껁궚?뚧군?곥굥??겎烏뚣굮?앫겗?얇겲沃????\\n * 歟곥겗烏ⓦ겏?뺛걚訝딃솏?ゃ걮??뙷?녴걣?ゃ걚 ??13.5m 餓δ툓??렅?뉎겓若싥굙?뚣겒?뤵?\\n * bandedSpliceRule ??MemberUnsupportedError ?㎬맼?ⓦ걲??\\n */\\r\\nfunction continuousSlabBands(pack: RulePack): SpliceBand[] {\\r\\n  const counts = lookupRuleSeries(pack, 'measure.splice.slab.continuous', 'band')\\r\\n  const upperBounds = new Map(\\r\\n    lookupRuleSeries(\\r\\n      pack,\\r\\n      'measure.splice.slab.continuous.band.upper',\\r\\n      'band',\\r\\n    ).map((rule) => [rule.conditions.band, rule]),\\r\\n  )\\r\\n\\r\\n  return counts.map((countRule) => ({\\r\\n    countRule,\\r\\n    upperBoundRule: upperBounds.get(countRule.conditions.band) ?? null,\\r\\n  }))\\r\\n}\\r\\n\\r\\nexport function generateSlabRebar(\\r\\n  input: SlabRebarInput,\\r\\n  pack: RulePack,\\r\\n): Rebar[] {\\r\\n  const { run, section } = input\\r\\n  const coverRule = lookupRule(pack, 'cover.minimum', coverConditions(section))\\r\\n  const fabricationCoverAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'cover.fabrication.addition',\\r\\n    {},\\r\\n  )\\r\\n  const distributionAdditionRule = lookupRule(\\r\\n    pack,\\r\\n    'measure.distribution.addition',\\r\\n    {},\\r\\n  )\\r\\n  const fabricationCoverMm =\\r\\n    millimetres(coverRule) + millimetres(fabricationCoverAdditionRule)\\r\\n\\r\\n  // ?졾램?ⓦ걢?뜰굤횞2 ?뚧씮?싥굮擁끹걟?뗣겏訝딁ク嶺뗣겏訝뗧ク嶺뗣걣?γ굦?욍굩?듽?D ?㎬즽瓦붵겂??\\n  // ?욍겓?ゃ굥?귡퍢?ｃ겍訝?ㄾ?ュ칱?쎼걳?곥걹??틞?욍걽?묋맼?ⓦ걲竊덅먬쐡鶯곥겗??뽧꺂?띸춮??\\n  // 野멩퀡?с꺖?됥겏?뚣걯?긱걚竊됥?\\n  if (section.thickness <= 2 * fabricationCoverMm) {\\r\\n    throw new MemberUnsupportedError(\\r\\n      '野멩퀡訝띷닇塋?,\\r\\n      `佯딀씮??툓塋?춮?ⓧ툔塋?춮?뚧씮?싥겓?γ굢?ゃ걚: ${run.ownerId} ` +\\r\\n        `(?욕럻 ${section.thickness} ??2횞?졾램?ⓦ걢?뜰굤 ${fabricationCoverMm})`,\\r\\n    )\\r\\n  }\\r\\n\\r\\n  const shared = {\\r\\n    run,\\r\\n    section,\\r\\n    pack,\\r\\n    coverRule,\\r\\n    fabricationCoverAdditionRule,\\r\\n    distributionAdditionRule,\\r\\n    fabricationCoverMm,\\r\\n  }\\r\\n\\r\\n  // 訝뗧ク嶺뗣굮?덀겓?뷩걲?귝씮??툔?뗣굢?녴겓令띲??녶틣?뚣걹??겲?얍냵鼇녈겗訝╉겞?ャ겒?뗣?\\n  return [\\n    ...buildSlabBars({ ...shared, face: '訝뗧ク' }),\\n    ...buildSlabBars({ ...shared, face: '訝딁ク' }),\\n    ...openingReinforcementRebars(run),\\n  ]\\n}\\n\\nfunction openingReinforcementRebars(run: SlabRun): Rebar[] {\\n  return run.openings.flatMap((opening) =>\\n    (opening.reinforcements ?? []).map(\\n      (reinforcement, index): Rebar => ({\\n        id: `${run.ownerId}|opening-${opening.id}|reinforcement-${index}`,\\n        memberId: run.ownerId,\\n        role: '?뗥룭獒쒎섭嶺?,\\n        size: reinforcement.size,\\n        count: reinforcement.count,\\n        length: reinforcement.lengthMm,\\n        shape: 'straight',\\n        points: [\\n          [0, 0, 0],\\n          [reinforcement.lengthMm, 0, 0],\\n        ],\\n        closed: false,\\n        formula:\\n          `鼇?쮫?룔걬 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.lengthMm}mm 竊?` +\\n          `?ф빊 竊?鼇?쮫?녔쎑邕?쮼 ${reinforcement.count}??竊?孃?竊?${reinforcement.size} ` +\\n          `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ?ゃ걡?멥걤 ???뗥룭獒쒎섭嶺뗣겘鼇?쮫?녔쎑?ャ굠?딂쮫歷с꺕鼇덄츞竊?,\\n        ruleHits: [],\\n      }),\\n    ),\\n  )\\n}\\n\\ninterface SlabBarInput {\\n  run: SlabRun\\r\\n  section: SlabSection\\r\\n  pack: RulePack\\r\\n  coverRule: RuleHit\\r\\n  fabricationCoverAdditionRule: RuleHit\\r\\n  distributionAdditionRule: RuleHit\\r\\n  fabricationCoverMm: number\\r\\n  face: '訝딁ク' | '訝뗧ク'\\r\\n}\\r\\n\\r\\nfunction roleOf(axis: 'X' | 'Y', face: '訝딁ク' | '訝뗧ク'): RebarRole {\\r\\n  if (axis === 'X') return face === '訝딁ク' ? 'X?밧릲訝딁ク嶺? : 'X?밧릲訝뗧ク嶺?\\r\\n  return face === '訝딁ク' ? 'Y?밧릲訝딁ク嶺? : 'Y?밧릲訝뗧ク嶺?\\r\\n}\\r\\n\\r\\nfunction buildSlabBars(input: SlabBarInput): Rebar[] {\\r\\n  const {\\r\\n    run,\\r\\n    section,\\r\\n    pack,\\r\\n    coverRule,\\r\\n    fabricationCoverAdditionRule,\\r\\n    distributionAdditionRule,\\r\\n    fabricationCoverMm,\\r\\n    face,\\r\\n  } = input\\r\\n\\r\\n  const row = (run.axis === 'X' ? section.x : section.y)[\\r\\n    face === '訝딁ク' ? 'top' : 'bottom'\\r\\n  ]\\r\\n  const diameter = barDiameter(row.size)\\r\\n  const endInput = {\\r\\n    barSize: row.size,\\r\\n    fc: section.fc,\\r\\n    grade: section.grade,\\r\\n    face,\\r\\n  }\\r\\n  const start = resolveSlabEnd(\\r\\n    {\\r\\n      ...endInput,\\r\\n      supportWidthMm: run.startSupport.widthMm,\\r\\n      supportCover: run.startSupport.cover,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  const end = resolveSlabEnd(\\r\\n    {\\r\\n      ...endInput,\\r\\n      supportWidthMm: run.endSupport.widthMm,\\r\\n      supportCover: run.endSupport.cover,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n\\r\\n  // 3D ?ユ룒?뗣굦?뗩빓?뺛귞텤?뗣겘鵝띸쉰?뚧군?얇굢?ゃ걚??겎?뤵걢?싥곮Þ鼇덆빓?뺛겓?졼걨?γ굥??\\n  // ?뗥룭??쵟?묆굚?볝걪?ャ겘?얇굦?ゃ걚 ??轝졼걨?뗤퐤營?겘?с걫?ⓦ겓?뺛걝??겎?곮〃鹽븅깿??\\n  // `SlabRun.openings` ?㎩늾??(ADR-029)??\\n  const drawnLengthMm = run.coreLengthMm + start.lengthMm + end.lengthMm\\r\\n  const lapRule = lookupRule(pack, 'lap.L1', {\\r\\n    fc: section.fc,\\r\\n    grade: section.grade,\\r\\n    hook: false,\\r\\n  })\\r\\n  const lapLengthMm = millimetres(lapRule, diameter)\\r\\n\\r\\n  const count = distributionCount(\\r\\n    run.distributionClearMm,\\r\\n    row.pitch,\\r\\n    distributionAdditionRule,\\r\\n  )\\r\\n  const layout = stirrupPositions(\\r\\n    run.distributionClearMm,\\r\\n    row.pitch,\\r\\n    row.startOffsetMm,\\r\\n  )\\r\\n\\r\\n  // 1?싧뎴8) ???뗥룭?믤Ø?뉎굥?с걽?묆걣?뗥룭??냵力뺝?力뺛걽?묊윮?뤵겒?뗣괱?밧릲??뎱嶺뗣겘\\r\\n  // x ?ヨ뎔?뗣겗?㏝뼀?ｃ겗 x 野멩퀡?믤쵟?띲갳?밧릲??걹??녴겎?귙굥??\\n  const deduction = openingDeduction(\\r\\n    {\\r\\n      openings: run.openings,\\r\\n      clearXMm:\\r\\n        run.axis === 'X' ? run.coreLengthMm : run.distributionClearMm,\\r\\n      clearYMm:\\r\\n        run.axis === 'X' ? run.distributionClearMm : run.coreLengthMm,\\r\\n      barAxis: run.axis === 'X' ? 'x' : 'y',\\r\\n      pitchMm: row.pitch,\\r\\n      totalCount: count,\\r\\n    },\\r\\n    pack,\\r\\n  )\\r\\n  const openingLayout = deduction.layout\\r\\n  const ignoredTerm =\\r\\n    deduction.ignored.length === 0\\r\\n      ? ''\\r\\n      : ` 竊?轝좈솮?쀣겒?꾦뼀??${deduction.ignored\\r\\n          .map(({ widthMm, heightMm }) => `${widthMm}횞${heightMm}`)\\r\\n          .join('??)}竊??싧뎴8) 鵝녷쎑 ??1?뗦?壤볝걼?듿냵力뺡씊令?.5?▽빳訝뗰펹`\\r\\n\\r\\n  // ?욕럻??겑?볝겓塋뗣겇?뗣귚툔塋?춮??씮??툔?뗣굢?곦툓塋?춮??씮??툓?뗣굢?졾램?ⓦ걢?뜰굤??\\n  const barZ =\\r\\n    face === '訝딁ク' ? section.thickness - fabricationCoverMm : fabricationCoverMm\\r\\n\\r\\n  const zones: RebarZone[] = [\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: start.lengthRule,\\r\\n      pathFromMm: 0,\\r\\n      pathToMm: start.lengthMm,\\r\\n    },\\r\\n    {\\r\\n      kind: '若싩?',\\r\\n      ruleKey: end.lengthRule,\\r\\n      pathFromMm: drawnLengthMm - end.lengthMm,\\r\\n      pathToMm: drawnLengthMm,\\r\\n    },\\r\\n  ]\\r\\n\\r\\n  const bent = start.kind === '?섉쎊?믣츣?' || end.kind === '?섉쎊?믣츣?'\\r\\n  const points = slabPoints(run.axis, run.coreLengthMm, barZ, start, end)\\r\\n  const faceKey = face === '訝딁ク' ? 'top' : 'bottom'\\r\\n\\r\\n  return deduction.groups.map(({ deductionMm, count: groupCount }) => {\\r\\n    // 1?싧뎴4) ?뚨텤?뗧츋??겹굮黎귙굙?뗣뚩쮫歷с꺕鼇덄츞?쀣걼?꾤춮??빓?뺛띲겘轝좈솮孃뚣겗?룔걬?졼?\\n    // ?ｇ텥佯딀씮??뙷?녻〃??뚦틞?욍겗?룔걬?띲겎凉뺛걦??겎轝좈솮??쉽?욍굮?쀣걨?ゃ걚??\\n    const measuredLengthMm = drawnLengthMm - deductionMm\\r\\n    const splice = resolveSplice({\\r\\n      run,\\r\\n      section,\\r\\n      size: row.size,\\r\\n      measuredLengthMm,\\r\\n      lapRule,\\r\\n      lapLengthMm,\\r\\n      pack,\\r\\n    })\\r\\n    const lengthMm = measuredLengthMm + splice.lengthMm\\r\\n    const positionsMm = openingLayout\\r\\n      ? openingLayout.positionsMm.filter(\\r\\n          (_, index) => openingLayout.deductionsMm[index] === deductionMm,\\r\\n        )\\r\\n      : null\\r\\n\\r\\n    const deductionTerm =\\r\\n      deductionMm === 0\\r\\n        ? ''\\r\\n        : ` ???뗥룭?ⓦ겗轝좈솮 ${deductionMm}竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴8) ??兩뷴끁窈욅춬` +\\r\\n          `?뗥룭?ⓦ겗?끾퀡野멩퀡?ャ굠?뗰펹`\\r\\n    const splitTerm =\\r\\n      deduction.groups.length === 1\\r\\n        ? ''\\r\\n        : ` ??걝??{\\r\\n            deductionMm === 0 ? '?뗥룭?믤Ø?뉎굢?ゃ걚' : `${deductionMm}?믤쵟??\\r\\n          } ${groupCount}??\\r\\n\\r\\n    return {\\r\\n      id:\\r\\n        `${run.ownerId}|slab-${run.axis}-${faceKey}` +\\r\\n        `${deductionMm === 0 ? '' : `|轝좈솮${deductionMm}`}`,\\r\\n      memberId: run.ownerId,\\r\\n      role: roleOf(run.axis, face),\\r\\n      size: row.size,\\r\\n      shape: (bent ? 'hook90' : 'straight') as Rebar['shape'],\\r\\n      points,\\r\\n      closed: false,\\r\\n      length: lengthMm,\\r\\n      count: groupCount,\\r\\n      // X?밧릲??뎱嶺뗣겘 x ?ヤ섯?녈굥??겎 y ?멧를?녈갳?밧릲??걹??녴겎?귙굥??\\n      placement: {\\r\\n        axis: (run.axis === 'X' ? 'y' : 'x') as 'x' | 'y',\\r\\n        clearMm: run.distributionClearMm,\\r\\n        pitchMm: row.pitch,\\r\\n        startOffsetMm: row.startOffsetMm,\\r\\n        lastGapMm: layout.lastGapMm,\\r\\n        positionCount: positionsMm\\r\\n          ? positionsMm.length\\r\\n          : layout.positionsMm.length,\\r\\n        ...(positionsMm ? { positionsMm } : {}),\\r\\n      },\\r\\n      splice: {\\r\\n        method: section.spliceMethod,\\r\\n        countPerBar: splice.countPerBar,\\r\\n        lengthMm: splice.lengthMm,\\r\\n        rules: splice.rules,\\r\\n        formula:\\r\\n          `泳숁뎸嶸뉑???竊?${face}嶺??с걗?잆굤 ${splice.countPerBar}?뗦?` +\\r\\n          `竊?{splice.basis}竊?竊??밧폀 竊?${section.spliceMethod} 竊?` +\\r\\n          `鼇?쮫?룔걬?멥겗嶸쀥뀯 竊?${spliceLengthTerm(splice, section, lapRule, lapLengthMm)} 竊?` +\\r\\n          `鵝띸쉰 竊??ょ▶若싷펷烏?.3.3 ?뚦렅?뉎겎?삣깗 ??3D ?ャ겘?뤵걢?ゃ걚竊?,\\r\\n      },\\r\\n      zones,\\r\\n      ruleHits: uniqueRuleHits([\\r\\n        coverRule,\\r\\n        fabricationCoverAdditionRule,\\r\\n        distributionAdditionRule,\\r\\n        ...start.usedRules,\\r\\n        ...end.usedRules,\\r\\n        ...deduction.rules,\\r\\n        ...splice.rules,\\r\\n      ]),\\r\\n      formula:\\r\\n        `鼇?쮫?룔걬 竊?${runCoreFormula(run)}${deductionTerm} 竊?${endFormula('冶뗧ク', start)} ` +\\r\\n        `竊?${endFormula('永귞ク', end)} 竊?泳숁뎸 ` +\\r\\n        `${spliceLengthTerm(splice, section, lapRule, lapLengthMm)} 竊?${lengthMm} 竊?` +\\r\\n        `?ф빊 竊??덂돯餓섉뼶?묆겗?끾퀡?룔걬 ${run.distributionClearMm} 첨 ?붵긿??` +\\r\\n        `${row.pitch}??竊?${distributionAdditionRule.value}` +\\r\\n        `竊덃빊?뤹찉嶸쀥읃繹?1?싧뎴7)竊됵폓 ${count}${splitTerm} 竊?` +\\r\\n        `?띸쉰?뷸틬 竊??졾램?ⓦ걢?뜰굤?싥걬竊덃?弱뤵걢?뜰굤 ${coverRule.value} 竊??좂츞 ` +\\r\\n        `${fabricationCoverAdditionRule.value} 竊?${fabricationCoverMm}?? +\\r\\n        `烏?.3.6?뚣궧?⒲깣?곮먨뒟鶯곦빳鸚뽧겗鶯곥랃펹 竊?` +\\r\\n        `3D 壤®듁 竊?泳숁뎸鵝띸쉰?뚧쑋閻뷴츣?ゃ겗?㎫텤?뗣굮?뤵걢?ゃ걚竊덃룒