= row\r\n        closestDistance = distance\r\n      }\r\n    }\r\n\r\n    if (closest) {\r\n      closest.items.push(item)\r\n      closest.y =\r\n        closest.items.reduce((total, rowItem) => total + rowItem.y, 0) /\r\n        closest.items.length\r\n      closest.height = Math.max(closest.height, item.h)\r\n    } else {\r\n      rows.push({ y: item.y, height: item.h, items: [item] })\r\n    }\r\n  }\r\n\r\n  return rows\r\n    .sort((left, right) => left.y - right.y)\r\n    .map((row) => ({ ...row, segments: makeSegments(row.items, gapRatio) }))\r\n}\r\n\r\n/**\r\n * ?몃줈?곌린 臾몄옄?댁쓣 蹂듭썝?쒕떎. `recoverRows`???뚯쟾 ?꾩씠?쒖쓣 踰꾨┛????媛濡???蹂듭썝??\r\n * ?욎씠硫??됱씠 ?ㅼ뿼?섍린 ?뚮Ц?대떎. 洹?寃곌낵 ?ㅼ?移??놁뿉 ?몃줈濡??곹엺 移섏닔媛 ?듭㎏濡?蹂댁씠吏\r\n * ?딅뒗?? ??씊 ?쇰꺼 ?됱씠 ?녿뒗 ?쒖뿉?쒕뒗 洹멸쾬??d???좎씪??洹쇨굅??(ojkk ?긱꺁?밤깉).\r\n *\r\n * rot=-90留?諛쏅뒗?? ?쎄린 ?쒖꽌媛 y ?대┝李⑥닚??寃껋? ?ㅻЪ?먯꽌 ?뺤씤??媛믪씠怨? ?ㅻⅨ\r\n * ?뚯쟾媛곸? ?쒖꽌媛 ?ㅼ쭛?????덈떎 ????00?띿씠 ??07?띿씠 ?섎㈃ 議곗슜???由?媛믪씠 ?쒕떎.\r\n * ?뚯쟾 ?띿뒪?몄뿉??w??媛濡???씠 ?꾨땲??湲??吏꾪뻾?됱씠誘濡??몃줈 媛꾧꺽?쇰줈 ?대떎.\r\n *\r\n * `originGapRatio`???몄젒 ?먯젙 諛곗닔?댁?留?**makeSegments??`gapRatio`? ?щ뒗 ??곸씠\r\n * ?ㅻⅤ??*: makeSegments??吏꾪뻾?됱쓣 類 ?щ갚(`x - (previous.x + w)`)??怨깊븯怨? ?ш린?쒕뒗\r\n * ?먯젏 ?ъ씠 嫄곕━(`previous.y - y`)??怨깊븳?? 洹몃옒??媛숈? ?섎? ?ｌ뼱??媛숈? ?살씠 ?꾨땲怨?\r\n * ???좏겙 ?대? 媛꾧꺽??媛濡쒖뿉?쒕뒗 嫄곗쓽 0?몃뜲 ?몃줈?먯꽌???뺥솗??1w?????몃줈 諛곗닔??1??\r\n * ?섏뼱???쒕떎. ?대쫫???뚦렅?백뼋?붿쓽 諛곗닔?띾씪怨??щ뒗 ??곸쓣 ?닿퀬 ?덈뒗 ?댁쑀媛 ?닿쾬?대떎:\r\n * ????`gapRatio: number`?대㈃ ?몄텧遺媛 0.5? 1.5瑜?留욌컮轅??ｌ뼱????낆씠 留됱? 紐삵븳??\r\n *\r\n * **??異뺤씠 ?쒕줈 ?ㅻⅤ寃??먯뒯?덈뜕 寃껋씠 ?꾨땲??** ?몃줈 議곌굔??媛濡쒖쓽 泥숇룄濡???린硫?\r\n * `?щ갚 ??w쨌(諛곗닔??)`?닿퀬, 諛곗닔 2쨌w??.5h(?쎌뒪泥?5遺???レ옄 湲由ы봽 ?ㅼ륫 w/h??\r\n * 0.4977~0.5226)?먯꽌 洹?媛믪? 0.5h ??鴉뤷쎋 ?뚯꽌媛 ?곕뒗 媛濡?臾명꽦(`min(h)쨌0.5`)怨?\r\n * **媛숇떎**. ??湲곕낯媛?2??寃고븿? ?먯뒯?⑥씠 ?꾨땲??寃쎄퀎媛 ?ㅼ륫媛믨낵 ?뺥솗??寃뱀튇 寃껋씠??\r\n * (`VERTICAL_RUN_GAP_RATIO` 李멸퀬).\r\n */\r\nexport function verticalRuns(\r\n  items: TextItem[],\r\n  originGapRatio: number = VERTICAL_RUN_GAP_RATIO,\r\n): VerticalRun[] {\r\n  const rotated = items\r\n    .filter(\r\n      (item) =>\r\n        item.s