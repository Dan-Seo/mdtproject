ng, x: number, y: number): TextItem {\\r\\n  return { str, x, y, w: 8, h: 0, rot: -90 }\\r\\n}\\r\\n\\r\\nfunction page(items: TextItem[]): TextPage {\\r\\n  return { widthPt: 1000, heightPt: 1000, items }\\r\\n}\\r\\n\\r\\ndescribe('parseFramingPlan — 通り芯グリッド', () => {\\r\\n  it('라벨이 하나도 없으면 通り芯ラベル未検出', () => {\\r\\n    const parsed = parseFramingPlan(page([h('8700', 200, 80)]))\\r\\n    expect(parsed.grids).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['通り芯ラベル未検出'])\\r\\n  })\\r\\n\\r\\n  it('가로 밴드: 라벨 2본 + 중점 치수 → X 후보', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([h('X1', 100, 50), h('X2', 300, 50), h('6000', 200, 80)]),\\r\\n    )\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.grids).toEqual([\\r\\n      {\\r\\n        direction: 'X',\\r\\n        axes: [\\r\\n          { label: 'X1', positionPt: 100 },\\r\\n          { label: 'X2', positionPt: 300 },\\r\\n        ],\\r\\n        spansMm: [6000],\\r\\n        scalePtPerMm: 200 / 6000,\\r\\n        totalConfirmed: false,\\r\\n      },\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('세로 밴드: 위치는 y, 치수는 rot=-90 런에서 온다', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([h('bY1', 50, 100), h('bY2', 50, 300), v('4500', 80, 200)]),\\r\\n    )\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.grids).toEqual([\\r\\n      {\\r\\n        direction: 'Y',\\r\\n        axes: [\\r\\n          { label: 'bY1', positionPt: 100 },\\r\\n          { label: 'bY2', positionPt: 300 },\\r\\n        ],\\r\\n        spansMm: [4500],\\r\\n        scalePtPerMm: 200 / 4500,\\r\\n        totalConfirmed: false,\\r\\n      },\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('쉼표 치수(6,000)를 mm 정수로 읽는다', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([h('X1', 100, 50), h('X2', 300, 50), h('6,000', 200, 80)]),\\r\\n    )\\r\\n    expect(parsed.grids[0]?.spansMm).toEqual([6000])\\r\\n  })\\r\\n\\r\\n  it('인접 쌍의 중점에 치수가 없으면 寸法欠落 — 후보를 내지 않는다', () => {\\r\\n    const cases: TextItem[][] = [\\r\\n      // 치수 자체가 없다\\r\\n      [h('X1', 100, 50), h('X2', 300, 50)],\\r\\n      // 중점에서 20pt 벗어났다 (허용 15pt)\\r\\n      [h('X1', 100, 50), h('X2', 300, 50), h('6000', 220, 80)],\\r\\n      // 라벨 밴드에서 70pt 떨어진 다른 열의 숫자다 (창 60pt)\\r\\n      [h('X1', 100, 50), h('X2', 300, 50), h('6000', 200, 120)],\\r\\n    ]\\r\\n    for (const items of cases) {\\r\\n      const parsed = parseFramingPlan(page(items))\\r\\n      expect(parsed.grids).toEqual([])\\r\\n      expect(parsed.issues).toEqual(['寸法欠落'])\\r\\n    }\\r\\n  })\\r\\n\\r\\n  it('스팬별 실측 축척이 3%를 넘게 갈리면 縮尺不整合', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([\\r\\n        h('X1', 100, 50),\\r\\n        h('X2', 300, 50),\\r\\n        h('X3', 500, 50),\\r\\n        h('6000', 200, 80),\\r\\n        h('3000', 400, 80), // 같은 200pt인데 3000mm — 축척이 2배 갈린다\\r\\n      ]),\\r\\n    )\\r\\n    expect(parsed.grids).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['縮尺不整合'])\\r\\n  })\\r\\n\\r\\n  it('전체 치수가 스팬 합과 일치하면 totalConfirmed', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([\\r\\n        h('X1', 100, 50),\\r\\n        h('X2', 300, 50),\\r\\n        h('X3', 500, 50),\\r\\n        h('6000', 200, 80),\\r\\n        h('6000', 400, 80),\\r\\n        h('12000', 300, 110), // 첫-끝 중점. 인접 중점(200·400)과는 100pt 떨어져 있다\\r\\n      ]),\\r\\n    )\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.grids[0]?.totalConfirmed).toBe(true)\\r\\n  })\\r\\n\\r\\n  it('전체 치수가 스팬 합과 다르면 合計不一致 — 오독 신호이므로 후보를 내지 않는다', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([\\r\\n        h('X1', 100, 50),\\r\\n        h('X2', 300, 50),\\r\\n        h('X3', 500, 50),\\r\\n        h('6000', 200, 80),\\r\\n        h('6000', 400, 80),\\r\\n        h('11000', 300, 110),\\r\\n      ]),\\r\\n    )\\r\\n    expect(parsed.grids).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['合計不一致'])\\r\\n  })\\r\\n\\r\\n  it('같은 밴드에서 라벨이 반복되면 블록 경계로 갈라 읽고, 동일 결과는 하나로 접는다', () => {\\r\\n    // 한 페이지에 같은 그리드의 伏図가 두 블록 — 실물 p7의 배치다\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([\\r\\n        h('X1', 100, 50),\\r\\n        h('X2', 300, 50),\\r\\n        h('X1', 700, 50),\\r\\n        h('X2', 900, 50),\\r\\n        h('6000', 200, 80),\\r\\n        h('6000', 800, 80),\\r\\n      ]),\\r\\n    )\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.grids).toHaveLength(1)\\r\\n    expect(parsed.grids[0]?.axes.map((axis) => axis.label)).toEqual([\\r\\n      'X1',\\r\\n      'X2',\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('한 밴드에 X와 Y 라벨이 섞이면 ラベル文字混在 — 방향을 지어내지 않는다', () => {\\r\\n    const parsed = parseFramingPlan(\\r\\n      page([h('X1', 50, 100), h('Y2', 50, 300), v('4500', 80, 200)]),\\r\\n    )\\r\\n    expect(parsed.grids).toEqual([])\\r\\n    expect(parsed.issues).toEqual(['ラベル文字混在'])\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('parseFramingPlan — 부재 배치', () => {\\r\\n})\\r\\n\\r\\nfunction grid(\\r\\n  candidates: PlanGridCandidate[],\\r\\n  direction: 'X' | 'Y',\\r\\n): PlanGridCandidate {\\r\\n  const found = candidates.find((entry) => entry.direction === direction)\\r\\n  expect(found, `missing ${direction} grid`).toBeDefined()\\r\\n  return found as PlanGridCandidate\\r\\n}\\r\\n\\r\\n// 기대값은 도면에서 독립 전사한 값이다 (원본: tests/fixtures/section-import/SOURCES.md).\\r\\n// 축 위치(pt)는 도면 좌표라 여기 박지 않고 단조 증가만 본다 — 도면의 진실은\\r\\n// 라벨 순서와 스팬 치수(mm)다.\\r\\n\\r\\ndescribe('yokohama p7 (2階床伏図・R階床伏図)', () => {\\r\\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\\r\\n\\r\\n  it('두 블록·양단 중복이 접혀 X·Y 각 1개의 후보가 남는다', () => {\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.grids).toHaveLength(2)\\r\\n  })\\r\\n\\r\\n  it('X: bX1–bX3·cX1, 스팬 8700·8700·1200', () => {\\r\\n    const x = grid(parsed.grids, 'X')\\r\\n    expect(x.axes.map((axis) => axis.label)).toEqual([\\r\\n      'bX1',\\r\\n      'bX2',\\r\\n      'bX3',\\r\\n      'cX1',\\r\\n    ])\\r\\n    expect(x.spansMm).toEqual([8700, 8700, 1200])\\r\\n    expect(x.totalConfirmed).toBe(false)\\r\\n  })\\r\\n\\r\\n  it('Y: bY6→bY1 (도면 그대로의 순서), 스팬 5000·6000·10000·6000·5000', () => {\\r\\n    const y = grid(parsed.grids, 'Y')\\r\\n    expect(y.axes.map((axis) => axis.label)).toEqual([\\r\\n      'bY6',\\r\\n      'bY5',\\r\\n      'bY4',\\r\\n      'bY3',\\r\\n      'bY2',\\r\\n      'bY1',\\r\\n    ])\\r\\n    expect(y.spansMm).toEqual([5000, 6000, 10000, 6000, 5000])\\r\\n    expect(y.totalConfirmed).toBe(false)\\r\\n  })\\r\\n\\r\\n  it('축 위치는 단조 증가하고 실측 축척은 1/100 부근이다', () => {\\r\\n    for (const candidate of parsed.grids) {\\r\\n      const positions = candidate.axes.map((axis) => axis.positionPt)\\r\\n      expect([...positions].sort((a, b) => a - b)).toEqual(positions)\\r\\n      // 1/100 도면의 pt/mm = 72 / 25.4 / 100 ≈ 0.02835\\r\\n      expect(candidate.scalePtPerMm).toBeGreaterThan(0.027)\\r\\n      expect(candidate.scalePtPerMm).toBeLessThan(0.03)\\r\\n    }\\r\\n  })\\r\\n})\\r\\n\\r\\ndescribe('kani p38 (基礎伏図)', () => {\\r\\n  const parsed = parseFramingPlan(readPage('kani-p38.json'))\\r\\n\\r\\n  it('X: X1–X4, 스팬 6000·6000·8000 — 전체 치수 20,000으로 확인된다', () => {\\r\\n    const x = grid(parsed.grids, 'X')\\r\\n    expect(x.axes.map((axis) => axis.label)).toEqual(['X1', 'X2', 'X3', 'X4'])\\r\\n    expect(x.spansMm).toEqual([6000, 6000, 8000])\\r\\n    expect(x.totalConfirmed).toBe(true)\\r\\n  })\\r\\n\\r\\n  it('Y: 도면 좌→우가 Y3·Y2·Y1 — 스팬 6000·10500, 전체 16,500으로 확인된다', () => {\\r\\n    const y = grid(parsed.grids, 'Y')\\r\\n    expect(y.axes.map((axis) => axis.label)).toEqual(['Y3', 'Y2', 'Y1'])\\r\\n    expect(y.spansMm).toEqual([6000, 10500])\\r\\n    expect(y.totalConfirmed).toBe(true)\\r\\n  })\\r\\n\\r\\n  it('세부 치수 연쇄(2,800+3,200 등)는 중점 매칭이 배제한다', () => {\\r\\n    expect(parsed.issues).toEqual([])\\r\\n    expect(parsed.grids).toHaveLength(2)\\r\\n  })\\r\\n})\\r\\n\\r\\n// 아래 배치 기대값은 픽스처 좌표를 손으로 검산해 얻었다 (파서 출력에서 유도하지\\r\\n// 않는다 — ADR-010). 검산 근거: 좌블록의 通り芯 실좌표는 bX1=510·bX2=757·\\r\\n// bX3=1003·cX1=1037(x), bY6=216·bY5=358·bY4=528·bY3=812·bY2=982·bY1=1123(y)이다.\\r\\n//   C51@(528,207)  → x는 bX1(510)에서 18pt, y는 bY6(216)에서 9pt        → 格子点(0,0)\\r\\n//   G51@(880,335)  → x는 bX2–bX3 중점(880)에 정확히, y는 bY5(358)에서 23 → 辺 X(1,1)\\r\\n//   C53@(528,519)  → bX1(18) · bY4(9)                                    → 格子点(0,2)\\r\\n//   CB52@(476,669) → bX1(34) · bY4–bY3 중점(670)에서 1pt                 → 辺 Y(0,2)\\r\\ndescribe('yokohama p7 — 부재 배치', () => {\\r\\n  const parsed = parseFramingPlan(readPage('yokohama-p7.json'))\\r\\n\\r\\n  it('두 장의 伏図가 각각 블록이 되고 제목을 원문대로 갖는다', () => {\\r\\n    expect(parsed.blocks.map((block) => block.title)).toEqual([\\r\\n      '2階床伏図1/100',\\r\\n      'R階床伏図1/100',\\r\\n    ])\\r\\n  })\\r\\n\\r\\n  it('블록마다 자기 위치의 通り芯을 갖는다 — 라벨은 같고 좌표는 다르다', () => {\\r\\n    const [left, right] = parsed.blocks\\r\\n    expect(left.xGrid.axes.map((axis) => axis.label)).toEqual(\\r\\n      right.xGrid.axes.map((axis) => axis.label),\\r\\n    )\\r\\n    expect(left.xGrid.axes[0].positionPt).toBeLessThan(\\r\\n      right.xGrid.axes[0].positionPt,\\r\\n    )\\r\\n    expect(left.yGrid.axes.map((axis) => axis.label)).toEqual([\\r\\n      'bY6',\\r\\n      'bY5',\\r\\n      'bY4',\\r\\n      'bY3',\\r\\n      'bY2',\\r\\n      'bY1',\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nphases/16-span1-record\\step1-codex.stdout.log-42-{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -NoProfile -Command 'git diff -- phases/16-span1-record/index.json; git diff --stat'\",\"aggregated_output\":\"diff --git a/phases/16-span1-record/index.json b/phases/16-span1-record/index.json\\nindex 9b3eee9..079b4ec 100644\\n--- a/phases/16-span1-record/index.json\\n+++ b/phases/16-span1-record/index.json\\n@@ -14,7 +14,8 @@\\n       \\\"step\\\": 1,\\n       \\\"name\\\": \\\"verify-tightening-cost\\\",\\n       \\\"kind\\\": \\\"verify\\\",\\n-      \\\"status\\\": \\\"pending\\\"\\n+      \\\"status\\\": \\\"pending\\\",\\n+      \\\"started_at\\\": \\\"2026-08-26T08:38:38+0900\\\"\\n     },\\n     {\\n       \\\"step\\\": 2,\\n@@ -23,4 +24,4 @@\\n     }\\n   ],\\n   \\\"created_at\\\": \\\"2026-08-25T23:34:28+0900\\\"\\n-}\\n+}\\n\\\\ No newline at end of file\\n phases/16-span1-record/index.json | 5 +++--\\n 1 file changed, 3 insertions(+), 2 deletions(-)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nphases/16-span1-record\\step1-codex.stdout.log-43-{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -NoProfile -Command 'rg -n \\\"区間数不足|通り芯ラベル未検出|PLAN_GRID_ISSUES|validateSequence\\\" src/lib/import/framing-plan docs/ADR.md docs/RISKS.md tests --glob \\\"*.ts\\\" --glob \\\"*.json\\\" | Select-Object -First 160'\",\"aggregated_output\":\"docs/ADR.md:414:**트랙 정리 (2026-08-25)**: 伏図 트랙은 `src/lib/import/framing-plan/` 하나로 정리했고, 경쟁 구현이었던 ADR-031은 폐지했다. 그 대가로 framing-plan은 合計를 선택적 검산으로 사용한다(`totalConfirmed`). 단, 合計가 있으면 스팬 합과 대조하고 어긋날 때 `合計不一致`로 후보를 거절한다. 따라서 合計가 없는 도면도 위치 정합과 축척 일관성이 성립하면 그리드 후보를 낸다 — ADR-031이 合計 없는 도면을 막던 자리가 열려 있다는 사실을 남긴다. ADR-031 ③-2의 관측, 즉 스팬 1본 축에서는 「스팬의 합 ＝ 合計」가 원리상 아무것도 배제하지 못한다는 점은 framing-plan에도 그대로 성립한다. 다만 옛 `grid-parse`는 合計 검산이 유일한 장치라 1본 축을 통째로 `区間数不足`으로 거절할 수밖에 없었고, framing-plan에는 중점 매칭(±15pt)과 축척 일관성이 있어 1본에서도 확인하는 것이 남는다. 축척 일관성은 스팬이 하나면 대조 상대가 없으므로, 1본 축에서 실제로 남는 검증은 중점 매칭 하나다. `断面リスト` 페이지가 격자를 내지 않는 이유도 스팬 수가 아니라 세그먼트 전체를 설명하지 못하는 sticky 라벨 패턴(`X2端` 등) 때문이다. 근거 없이 문턱을 조이는 변경은 이 결정의 범위가 아니다.\\r\\ndocs/ADR.md:445:**③-2 (2026-08-25 정정): 「별개의 한 본」 요구만으로는 스팬 1본 축을 못 막는다 — 그 축은 애초에 값을 내지 않는다.** 위 문단은 `writtenAsTotal > 1`(合計로 쓰는 값이 그 축 어딘가에 한 번 더 있어야 한다는 조건)이 이 구멍을 닫았다고 적었는데, 독립 리뷰가 그 판정이 틀렸음을 보였다 — 두 사람이 각각 다른 경로로 재현했다(리뷰어는 yokohama-p14의 `900` 글리프를 페이지 다른 곳에 하나 더 복제해서, 컨트롤러는 합성 입력으로). 스팬이 1본인 축에서 「합 ＝ 合計」는 그 1본 자신을 合計로 읽으면 **언제나** 성립하는 정의이지, 무언가를 확인하는 증거가 아니다 — `writtenAsTotal > 1`은 그 축 위 **어딘가**에 같은 값이 한 번 더 있는지만 보는데, 그것은 이 스팬과 무관한 우연일 수 있다(인스턴스 동일성으로도 안 닫힌다: 「다른 900」을 合計로 잡아도 자기 자신과의 대조인 것은 같다). yokohama-p14가 지금까지 버틴 것은 그 페이지의 X 값 풀에서 `900`이 유일값이었던 **우연**이고, kani-p38이 반대 방향(`20000`이 유일값)으로 버틴 것도 같은 우연이다. 그래서 술어를 수리하는 대신 **라벨이 정확히 2개(스팬 1본)인 축은 데이터를 보기도 전에 값을 내지 않는다**로 바꿨다 — 검산이 원리상 아무것도 배제할 수 없는 자리에서 「우연히 통과했다」를 정답으로 치지 않는다는 뜻이다. 새 `GridIssue`는 `区間数不足`이고(라벨 부족＝스팬 0개인 `通り芯ラベル不足`과 대구를 이룬다), yokohama-p14의 X・Y 둘 다(라벨 2개씩) 이 이유로 통일된다.\\r\\ntests\\\\plan-import\\\\parse.test.ts:85:// 공회전한다는 이유로 `区間数不足`으로 거절했다. framing-plan은 기전이\\r\\ntests\\\\plan-import\\\\parse.test.ts:89:// 반환하므로, framing-plan은 라벨을 찾기 전 단계에서 `通り芯ラベル未検出`을 낸다.\\r\\ntests\\\\plan-import\\\\parse.test.ts:112:        issues: ['通り芯ラベル未検出'],\\r\\ntests\\\\plan-import\\\\parse.test.ts:117:        issues: ['通り芯ラベル未検出'],\\r\\ntests\\\\plan-import\\\\parse.test.ts:122:        issues: ['通り芯ラベル未検出'],\\r\\ntests\\\\plan-import\\\\parse.test.ts:127:        issues: ['通り芯ラベル未検出'],\\r\\nsrc/lib/import/framing-plan\\\\parse.test.ts:26:  it('라벨이 하나도 없으면 通り芯ラベル未検出', () => {\\r\\nsrc/lib/import/framing-plan\\\\parse.test.ts:29:    expect(parsed.issues).toEqual(['通り芯ラベル未検出'])\\r\\nsrc/lib/import/framing-plan\\\\parse.ts:306:function validateSequence(\\r\\nsrc/lib/import/framing-plan\\\\parse.ts:596:    return { grids: [], blocks: [], issues: ['通り芯ラベル未検出'] }\\r\\nsrc/lib/import/framing-plan\\\\parse.ts:605:    const result = validateSequence(sequence, dimensions, issue)\\r\\nsrc/lib/import/framing-plan\\\\types.ts:5:export const PLAN_GRID_ISSUES = [\\r\\nsrc/lib/import/framing-plan\\\\types.ts:6:  '通り芯ラベル未検出',\\r\\nsrc/lib/import/framing-plan\\\\types.ts:14:export type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\\r\\nsrc/lib/import/framing-plan\\\\types.test.ts:10:  PLAN_GRID_ISSUES,\\r\\nsrc/lib/import/framing-plan\\\\types.test.ts:20:    expect(PLAN_GRID_ISSUES).toContain(issue)\\r\\nsrc/lib/import/framing-plan\\\\types.test.ts:25:    const mis