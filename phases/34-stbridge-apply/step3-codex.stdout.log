RAL', 'ROOF', 'PENTHOUSE'])\r\n\r\nfunction addIssue(issues: StbIssue[], issue: StbIssue): void {\r\n  if (!issues.includes(issue)) issues.push(issue)\r\n}\r\n\r\nfunction unsupportedItems(document: StbDocument): { name: string; count: number }[] {\r\n  return [...document.unsupportedAxisKinds, ...document.unreadElements]\r\n}\r\n\r\nfunction normalizedAngle(angle: string | undefined):\r\n  | { direction: AxisDirection; radians: number }\r\n  | undefined {\r\n  const value = Number(angle)\r\n  if (!Number.isFinite(value)) return undefined\r\n\r\n  const normalized = ((value % 360) + 360) % 360\r\n  const quadrant = Math.round(normalized / 90)\r\n  if (Math.abs(normalized - quadrant * 90) > 0.001) return undefined\r\n\r\n  const quadrantInCycle = quadrant % 4\r\n  return {\r\n    direction:\r\n--- section import complete relevant render ---\r\n        type=\"button\"\r\n        className={styles.openButton}\r\n        onClick={() => {\r\n          if (pages) setOpen(true)\r\n          else inputRef.current?.click()\r\n        }}\r\n      >\r\n        {t(locale, 'sectionImport.open')}\r\n      </button>\r\n      <input\r\n        ref={inputRef}\r\n        className={styles.fileInput}\r\n        data-testid=\"section-import-file\"\r\n        type=\"file\"\r\n        accept=\"application/pdf\"\r\n        aria-label={t(locale, 'sectionImport.file')}\r\n        onChange={(event) => void selectFile(event)}\r\n      />\r\n      {open ? (\r\n        <section\r\n          className={styles.panel}\r\n          role=\"dialog\"\r\n          aria-modal=\"false\"\r\n          aria-labelledby=\"section-import-title\"\r\n        >\r\n          <header className={styles.panelHeader}>\r\n            <h3 id=\"section-import-title\">\r\n              {t(locale, 'sectionImport.title')}\r\n            </h3>\r\n            <div className={styles.panelActions}>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.chooseButton}\r\n                onClick={() => inputRef.current?.click()}\r\n              >\r\n                {t(locale, 'sectionImport.chooseAnother')}\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                className={styles.closeButton}\r\n                onClick={() => setOpen(false)}\r\n              >\r\n                {t(locale, 'sectionImport.close')}\r\n              </button>\r\n            </div>\r\n          </header>\r\n          <div className={styles.panelBody}>\r\n            {loading ? (\r\n              <p role=\"status\">{t(locale, 'sectionImport.loading')}</p>\r\n            ) : failed ? (\r\n              <p role=\"alert\">{t(locale, 'sectionImport.error')}</p>\r\n            ) : pages && rows.length === 0 && listIssues.length === 0 ? (\r\n              <p>{t(locale, 'sectionImport.empty')}</p>\r\n            ) : (\r\n              <>\r\n                {listIssues.map(([issue, kinds]) => (\r\n                  <p key={issue} className={styles.listIssue}>\r\n                    {`${t(locale, `sectionImport.listIssue.${issue}`)}（${kinds.join('・')}）`}\r\n                  </p>\r\n                ))}\r\n                <ul className={styles.candidateList}>\r\n                  {supported.map((row) => (\r\n                    <Candidate\r\n                      key={row.id}\r\n                      row={row}\r\n                      ignored={ignored.has(row.id)}\r\n                      slabDirection={slabDirections[row.id]}\r\n                      girderDirection={girderDirections[row.id]}\r\n                      onIgnore={() =>\r\n                        setIgnored((current) => new Set(current).add(row.id))\r\n                      }\r\n                      onSlabDirectionChange={(direction) =>\r\n                        setSlabDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onGirderDirectionChange={(direction) =>\r\n                        setGirderDirections((current) => {\r\n                          const next = { ...current }\r\n                          if (direction === undefined) delete next[row.id]\r\n                          else next[row.id] = direction\r\n                          return next\r\n                        })\r\n                      }\r\n                      onApply={() =>\r\n                        updateProject((project) =>\r\n                          applyCandidate(\r\n                            project,\r\n                            row.candidate,\r\n                            slabDirections[row.id],\r\n                            girderDirections[row.id],\r\n                          ),\r\n                        )\r\n                      }\r\n                    />\r\n                  ))}\r\n                </ul>\r\n                {outOfScope.length > 0 ? (\r\n                  <details\r\n                    className={styles.outOfScope}\r\n                    data-testid=\"section-import-out-of-scope\"\r\n                  >\r\n                    <summary>\r\n                      {t(locale, 'sectionImport.outOfScope')} ({outOfScope.length})\r\n                    </summary>\r\n                    <ul className={styles.candidateList}>\r\n                      {outOfScope.map((row) => (\r\n                        <li\r\n                          key={row.id}\r\n                          className={styles.candidate}\r\n                          data-testid={`section-import-candidate-${row.candidate.mark}-${row.candidate.storyLabel ?? 'none'}`}\r\n                        >\r\n                          <div className={styles.candidateHeading}>\r\n                            <strong>{row.candidate.mark}</strong>\r\n                            <span>\r\n                              {row.candidate.storyLabel ??\r\n                                t(locale, 'sectionImport.noStory')}\r\n                            </span>\r\n                          </div>\r\n                          <p>\r\n                            {candidateFields(row.candidate, locale).join(' / ') ||\r\n                              '—'}\r\n                          </p>\r\n                        </li>\r\n                      ))}\r\n                    </ul>\r\n                  </details>\r\n                ) : null}\r\n              </>\r\n            )}\r\n          </div>\r\n        </section>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n--- plan css full ---\r\n.control {\n  display: inline-flex;\n}\n\n.fileInput {\n  display: none;\n}\n\n.openButton,\n.chooseButton,\n.closeButton,\n.applyButton {\n  min-height: 28px;\n  padding: 0 var(--space-xs);\n  border: var(--border-hairline);\n  border-radius: var(--radius-xs);\n  background: var(--surface-card);\n  color: var(--text-body);\n  cursor: pointer;\n  font: inherit;\n  font-size: var(--type-caption-size);\n}\n\n.panel {\n  position: absolute;\n  z-index: 20;\n  right: var(--space-sm);\n  width: min(560px, calc(100vw - 2 * var(--space-sm)));\n  max-height: 70vh;\n  overflow-y: auto;\n  border: var(--border-hairline);\n  border-radius: var(--radius-sm);\n  background: var(--surface-card);\n  box-shadow: var(--shadow-panel, 0 8px 24px rgb(0 0 0 / 18%));\n}\n\n.panelHeader {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-xs);\n  padding: var(--space-xs) var(--space-sm);\n  border-bottom: var(--border-hairline);\n}\n\n.panelActions {\n  display: inline-flex;\n  gap: var(--space-2xs, 4px);\n}\n\n.panelBody {\n  display: grid;\n  gap: var(--space-sm);\n  padding: var(--space-sm);\n  font-size: var(--type-caption-size);\n}\n\n.group {\n  display: grid;\n  gap: var(--space-2xs, 4px);\n}\n\n.groupTitle {\n  margin: 0;\n  font-size: var(--type-caption-size);\n  font-weight: 600;\n}\n\n.axes {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2xs, 4px);\n  align-items: baseline;\n  margin: 0;\n  font-variant-numeric: tabular-nums;\n}\n\n.axis {\n  font-weight: 600;\n}\n\n.span {\n  color: var(--text-muted);\n}\n\n.block,\n.elevation {\n  display: grid;\n  gap: var(--space-2xs, 4px);\n  padding: var(--space-xs);\n  border: var(--border-hairline);\n  border-radius: var(--radius-xs);\n}\n\n.blockHeading {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--space-xs);\n}\n\n.muted {\n  margin: 0;\n  color: var(--text-muted);\n}\n\n.issues {\n  display: grid;\n  gap: 2px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  color: var(--text-warning, var(--text-muted));\n}\n\n.storyPicker {\n  display: inline-flex;\n  gap: var(--space-2xs, 4px);\n  align-items: center;\n}\n\r\n--- locale tail ---\r\n  \"planImport.blockUntitled\": \"（図面名称なし）\",\r\n  \"planImport.elevationUntitled\": \"（軸組図名称なし）\",\r\n  \"planImport.discardOtherStories\": \"他の階の部材を破棄して通り芯を置き換える\",\r\n  \"planImport.applyStories\": \"階に反映\",\r\n  \"planImport.appliedStories\": \"作った階\",\r\n  \"planImport.topLevel\": \"最上階の天端\",\r\n  \"planImport.bottomLevel\": \"最下階の床\",\r\n  \"planImport.levelUnlabelled\": \"（名称なし）\",\r\n  \"planImport.discardMembers\": \"部材を破棄して階を置き換える\",\r\n  \"planImport.elevationRefusal.階範囲不正\": \"階になる区間がありません\",\r\n  \"planImport.elevationRefusal.部材あり階置換不可\": \"部材があるため階を置き換えられません\",\r\n  \"stbImport.issue.対応外バージョン\": \"対応していない ST-Bridge バージョンです\",\r\n  \"stbImport.issue.未対応エンコーディング\": \"対応していないエンコーディングです\",\r\n  \"stbImport.issue.XML解析不能\": \"XMLを解析できませんでした\",\r\n  \"stbImport.issue.ST-Bridge形式でない\": \"ST-Bridge形式ではありません\",\r\n  \"stbImport.issue.非直交通り芯\": \"直交しない通り芯です\",\r\n  \"stbImport.issue.未対応通り芯種別\": \"対応していない通り芯種別です\",\r\n  \"stbImport.issue.通り芯グループ数不一致\": \"通り芯グループ数が一致しません\",\r\n  \"stbImport.issue.通り芯方向不明\": \"通り芯の方向を判定できません\",\r\n  \"stbImport.issue.通り芯距離解釈不能\": \"通り芯の距離