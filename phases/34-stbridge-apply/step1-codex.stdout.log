ected/hoaryfox-sample.json\\\",\\n    \\\"tests/fixtures/stb-import/expected/diffchecker-mini210.json\\\",\\n    \\\"tests/stb-import/candidates.test.ts\\\",\\n    \\\"phases/33-stbridge-skeleton-import/step3-report.json\\\"\\n  ],\\n  \\\"grid_rules\\\": [\\n    {\\n      \\\"rule\\\": \\\"axisGroups가 비어 있음\\\",\\n      \\\"test\\\": \\\"rejects missing or non-pair axis groups without inventing a grid\\\",\\n      \\\"expected_issue\\\": \\\"通り芯未検出\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"axisGroups가 2개가 아님\\\",\\n      \\\"test\\\": \\\"rejects missing or non-pair axis groups without inventing a grid\\\",\\n      \\\"expected_issue\\\": \\\"通り芯グループ数不一致\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"Arc/Radial 축\\\",\\n      \\\"test\\\": \\\"rejects parallel axes and arc/radial axes, but ignores drawing axes while continuing\\\",\\n      \\\"expected_issue\\\": \\\"非直交通り芯\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"Drawing 축\\\",\\n      \\\"test\\\": \\\"rejects parallel axes and arc/radial axes, but ignores drawing axes while continuing\\\",\\n      \\\"expected_issue\\\": \\\"未対応通り芯種別; 평행축 후보는 계속 출력\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"허용오차 밖의 angle 또는 숫자가 아님\\\",\\n      \\\"test\\\": \\\"rejects the whole grid when either group is non-orthogonal and recovers when fixed\\\",\\n      \\\"expected_issue\\\": \\\"非直交通り芯\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"두 축군이 같은 방향\\\",\\n      \\\"test\\\": \\\"rejects parallel axes and arc/radial axes, but ignores drawing axes while continuing\\\",\\n      \\\"expected_issue\\\": \\\"通り芯方向不明\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"distance 해석 불능\\\",\\n      \\\"test\\\": \\\"rejects invalid, missing, duplicate, and insufficient axis positions without inventing labels; deduplicates issue codes when both axis groups fail the same rule\\\",\\n      \\\"expected_issue\\\": \\\"通り芯距離解釈不能\\\"\\n    },\\n    {\\n      \\\"rule\\\": \\\"name 누락\\\",\\n      \\\"test\\\": \\\"rejects invalid, miss