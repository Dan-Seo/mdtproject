는다**는 단언이 있다 (ADR-044 결정 4). 이 단언이 없으면 AC 미달이다.\nphases/34-stbridge-apply\\step3.md:38:3. `unsupported`가 비어 있지 않은 후보에서 그 목록이 건수와 함께 보인다.\nsrc\\domain\\rebar\\opening.test.ts:4:import { MemberUnsupportedError } from '../model/unsupported'\r\nsrc\\domain\\rebar\\opening.test.ts:132:      MemberUnsupportedError,\r\nsrc\\domain\\rebar\\opening.test.ts:135:      MemberUnsupportedError,\r\nsrc\\domain\\rebar\\opening.test.ts:138:      MemberUnsupportedError,\r\nsrc\\domain\\rebar\\opening.test.ts:144:      MemberUnsupportedError,\r\nsrc\\domain\\rebar\\opening.test.ts:151:      MemberUnsupportedError,\r\nsrc\\domain\\rebar\\measurement.test.ts:3:import { MemberUnsupportedError } from '../model/unsupported'\r\nsrc\\domain\\rebar\\measurement.test.ts:229:      MemberUnsupportedError,\r\nsrc\\components\\quantity\\TakeoffPane.module.css:276:.unsupportedNotice {\r\nsrc\\components\\quantity\\TakeoffPane.module.css:284:.unsupportedNotice strong {\r\nsrc\\components\\quantity\\TakeoffPane.module.css:299:.unsupportedList {\r\nsrc\\domain\\rebar\\measurement.ts:14:import { MemberUnsupportedError } from '../model/unsupported'\r\nsrc\\domain\\rebar\\measurement.ts:182:  throw new MemberUnsupportedError(\r\nsrc\\components\\plan\\PlanImport.tsx:220:      {result?.refusal === '部材あり階置換不可' ? (\r\nsrc\\components\\plan\\PlanImport.tsx:236:          {result.refusal\r\nsrc\\components\\plan\\PlanImport.tsx:237:            ? t(locale, `planImport.elevationRefusal.${result.refusal}`)\r\nsrc\\components\\plan\\PlanImport.tsx:315:  const issues = [...new Set(plans.flatMap((plan) => plan.issues))]\r\nsrc\\components\\plan\\PlanImport.tsx:453:                {issues.length > 0 ? (\r\nsrc\\components\\plan\\PlanImport.tsx:454:                  <ul className={styles.issues} data-testid=\"plan-import-issues\">\r\nsrc\\components\\plan\\PlanImport.tsx:455:                    {issues.map((issue) => (\r\nsrc\\components\\plan\\PlanImport.tsx:603:                {result?.refusal === '他階部材あり通り芯変更不可' ? 