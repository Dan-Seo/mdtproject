n  const discardOffered = await page.evaluate(\\n    (testId) => document.querySelector(`[data-testid='${testId}']`) !== null,\\n    discardTestId,\\n  );\\n  if (discardOffered) {\\n    await page.click(`[data-testid='${discardTestId}']`);\\n    await page.click(`[data-testid='${buttonTestId}']`);\\n  }\\n};\\n\\nawait approve(\\n  \\\"stb-import-apply-grid\\\",\\n  \\\"stb-import-discard-grid\\\",\\n  \\\"stb-import-grid-result\\\",\\n);\\nawait page.waitForFunction(\\n  () =>\\n    document.querySelectorAll(\\\"[data-testid^='span-x-']\\\").length === 2 &&\\n    document.querySelectorAll(\\\"[data-testid^='span-y-']\\\").length === 1 &&\\n    [...document.querySelectorAll(\\\"[data-testid^='span-x-']\\\")].every((input) =>\\n      input.getAttribute(\\\"aria-label\\\")?.includes(\\\"X\\\"),\\n    ),\\n);\\n\\nconst appliedGrid = await page.evaluate(() => ({\\n  xSpans: [...document.querySelectorAll(\\\"[data-testid^='span-x-']\\\")].map(\\n    (input) => input.value,\\n  ),\\n  ySpans: [...document.querySelectorAll(\\\"[data-testid^='span-y-']\\\")].map(\\n    (input) => input.value,\\n  ),\\n  xLabels: [...document.querySelectorAll(\\\"[data-testid^='span-x-']\\\")].map(\\n    (input) => input.getAttribute(\\\"aria-label\\\"),\\n  ),\\n  yLabels: [...document.querySelectorAll(\\\"[data-testid^='span-y-']\\\")].map(\\n    (input) => input.getAttribute(\\\"aria-label\\\"),\\n  ),\\n}));\\n\\nawait approve(\\n  \\\"stb-import-apply-stories\\\",\\n  \\\"stb-import-discard-stories\\\",\\n  \\\"stb-import-stories-result\\\",\\n);\\nawait page.waitForFunction(\\n  () =>\\n    [...document.querySelectorAll(\\\"[role='tablist']\\\")].some((list) => {\\n      const labels = [...list.querySelectorAll(\\\"[role='tab']\\\")].map((tab) =>\\n        tab.textContent.trim(),\\n      );\\n      return labels.length === 2 && labels.includes(\\\"1FL\\\") && labels.includes(\\\"2FL\\\");\\n    }),\\n);\\n\\nconst applied = await page.evaluate(() => {\\n  const storyTabs = [...document.querySelectorAll(\\\"[role='tablist']\\\")]\\n    .map((list) => [...list.querySelectorAll(\\\"[role='tab']\\\")].map((tab) => tab.textContent.trim()))\\n    .find((labels) => labels.length === 2 && labels.includes(\\\"1FL\\\") && labels.includes(\\\"2FL\\\"));\\n  return {\\n    storyTabs: storyTabs ?? [],\\n    unsupportedVisible:\\n      document.querySelector(\\\"[data-testid='stb-import-unsupported']\\\") !== null,\\n    issuesVisible:\\n      document.querySelector(\\\"[data-testid='stb-import-issues']\\\") !== null,\\n  };\\n});\\n\\nconst checks = {\\n  candidateVisible: candidateChecks.gridXLabels && candidateChecks.gridYLabels,\\n  candidateStoriesVisible: candidateChecks.storyNames,\\n  unsupportedSlotVisible: candidateChecks.unsupportedSlot && applied.unsupportedVisible,\\n  gridIsThreeByTwo:\\n    appliedGrid.xSpans.length === 2 &&\\n    appliedGrid.ySpans.length === 1 &&\\n    appliedGrid.xLabels.join(\\\",\\\") === \\\"X1-X2,X2-X3\\\" &&\\n    appliedGrid.yLabels.join(\\\",\\\") === \\\"Y1-Y2\\\",\\n  storiesApplied: applied.storyTabs.join(\\\",\\\") === \\\"1FL,2FL\\\",\\n  noticesRemainVisible: applied.issuesVisible || applied.unsupportedVisible,\\n};\\n\\nconsole.log(JSON.stringify({ candidate, appliedGrid, applied, checks }, null, 2));\\nconsole.log(\\\"SHOT \\\" + (await saveScreenshot(await page.screenshot(), \\\"uc23-stb-import.png\\\")));\\n\\nconst failed = Object.entries(checks)\\n  .filter(([, ok]) => !ok)\\n  .map(([name]) => name);\\nif (failed.length) throw new Error(\\\"FAILED CHECKS: \\\" + failed.join(\\\", \\\"));\\nconsole.log(\\\"ALL CHECKS PASSED\\\");\\n\\r\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nphases/34-stbridge-apply\\step6.md:8:step 0~5의 `completed`와 summary는 **자기 보고**다. AC가 통과했다는 것도 실행자가 한 말이다. 이 스텝은 그 말을 믿지 않고 직접 대조한다. phase 33의 같은 스텝에서 「전 AC를 통과한 채로 남은 구멍」이 실제로 발견된 적이 있다.\nphases/34-stbridge-apply\\step5.md:1:# Step 5: 대장에 ST-Bridge 트랙을 올린다 (손갱신 대장이 코드보다 뒤처져 있다)\nphases/34-stbridge-apply\\step5.md:6:`docs/MILESTONES.md`·`docs/RISKS.md`·`CLAUDE.md`의 마일스톤 표는 **손으로 갱신하는 대장**이라 코드보다 뒤처진다. 지금 그 셋 어디에도 ST-Bridge 트랙 행이 없다 — phase 33·34가 통째로 대장 밖에 있다. 대장이 모르는 트랙은 다음 세션이 이어받지 못한다.\nphases/34-stbridge-apply\\step5.md:11:1. **`docs/MILESTONES.md`** — 「도면 인식(로컬)」 항목과 나란히 **ST-Bridge 트랙 항목 한 줄**을 더하라. 형식은 step 0 기록 항목 10이 적은 그 파일의 기존 형식을 따른다. 담을 것:\nphases/34-stbridge-apply\\step5.md:12:   - 착수일(2026-08-28)과 근거 ADR(ADR-043·ADR-044), phase 33·34.\nphases/34-stbridge-apply\\step5.md:18:   - 내용: ST-Bridge 코퍼스가 **오픈소스 프로젝트의 테스트 픽스처**이고 사용자에게서 온 파일이 0건이며, RC 배근을 담은 파일은 ver 2.0.1 하나뿐이고 ver 2.1 계열의 현실 규모 파일을 찾지 못했다(GitHub 코드검색 `total_count` 9건이 전부 토이 파일과 생성기). R3(일본 사용자 접점 0)과 결합된 리스크다. 상태는 **열림**.\nphases/34-stbridge-apply\\step5.md:20:3. **`CLAUDE.md`** 마일스톤 표에 행을 더하라 — 「도면 인식(로컬)」 아래에 「ST-Bridge 취입」 행. 상태와 「남은 것」 한 줄. 형식은 기존 행과 같게.\nphases/34-stbridge-apply\\step5.md:25:2. `docs/MILESTONES.md`에 ST-Bridge 트랙 한 줄이 있고, 그 줄의 모든 숫자에 대해 **어떻게 셌는지**를 보고서에 적었다.\nphases/34-stbridge-apply\\step5.md:35:- 마일스톤의 상태를 「완료」로 올리지 마라 — M2가 미완이므로 산출값은 아직 정식 물량이 아니고, ST-Bridge 트랙도 코퍼스 한계가 열려 있다.\nphases/34-stbridge-apply\\step5-codex.stdout.log:5:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"agent_message\",\"text\":\"이번 스텝은 문서 네 파일만 갱신하겠습니다. 먼저 실제 HEAD·step 4 상태·기존 R 번호·동기화 테스트·ST-Bridge 소스/픽스처 수치를 함께 확인한 뒤, 요구된 네 파일만 수정하고 전체 테스트와 diff 범위를 검증하겠습니다.\"}}\nphases/34-stbridge-apply\\step5-codex.stdout.log:6:{\"type\":\"item.started\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"\\\"C:\\\\\\\\WINDOWS\\\\\\\\System32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe\\\" -Command \\\"git log --oneline -3; git status --short; Get-Content phases/34-stbridge-apply/index.json -Raw; Write-Output '--- relevant ADR ---'; Select-String -Path docs/ADR.md -Pattern 'ADR-043|ADR-044' -Context 0,12; Write-Output '--- milestone/risks headers ---'; Select-String -Path docs/MILESTONES.md,docs/RISKS.md,CLAUDE.md,AGENTS.md -Pattern '도면 인식\\\\\\\\(로컬\\\\\\\\)|ST-Bridge|\\\"