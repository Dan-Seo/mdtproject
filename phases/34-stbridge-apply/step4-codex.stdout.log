.name,\n    height: story.heightMm,\n  }))\n\n  if (project.members.length === 0 && sameStories(project.stories, stories)) {\n    return { project, applied: false }\n  }\n\n  return {\n    project: {\n      ...project,\n      stories,\n      members: [],\n    },\n    applied: true,\n  }\n}\n\r\n--- types candidate ---\r\nimport type { Project } from '@/domain/model/project'\n\nexport type StbEncoding = 'utf-8' | 'shift_jis'\n\r\n// ST-Bridge 痍⑥엯 媛??④퀎媛 ?대뒗 ?ъ쑀 肄붾뱶????紐⑸줉?쇰줈留??쒗쁽?쒕떎.\r\nexport const STB_ISSUES = [\r\n  '野얍퓶鸚뽧깘?쇈궦?㎯꺍',\r\n  '?ゅ?恙쒌궓?녈궠?쇈깈?ｃ꺍??,\r\n  'XML鰲ｆ옄訝띹꺗',\r\n  'ST-Bridge壤℡폀?㎯겒??,\r\n  '?욅쎍雅ㅹ싥굤??,\r\n  '?ゅ?恙쒒싥굤??Ŧ??,\r\n  '?싥굤??궛?ャ꺖?쀦빊訝띴???,\r\n  '?싥굤??뼶?묇툖??,\r\n  '?싥굤??퇌??㎗?덁툖??,\r\n  '?싥굤??퐤營?뇥筽?,\r\n  '?싥굤??꺀?쇻꺂轝좄맼',\r\n  '?싥굤??쑋濾쒎눣',\r\n  '?싥굤??퐤營?겏影?밤겗訝띴???,\r\n  '?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗',\r\n  '?롢꺃?쇻꺂?띹쨭',\r\n  '?겻툔?с깧?ユ쑋野얍퓶',\r\n  '野얍퓶鸚뽧겗?롧Ŧ??,\r\n  '?롣툖擁?,\r\n] as const\r\n\r\nexport type StbIssue = (typeof STB_ISSUES)[number]\r\n\r\nexport interface StbAxisRaw {\r\n  id?: string\r\n  name?: string\r\n  distance?: string\r\n  nodeIds: string[]\r\n}\r\n\r\nexport interface StbAxisGroupRaw {\r\n  groupName?: string\r\n  angle?: string\r\n  originX?: string\r\n  originY?: string\r\n  axes: StbAxisRaw[]\r\n}\r\n\r\nexport interface StbStoryRaw {\r\n  id?: string\r\n  name?: string\r\n  height?: string\r\n  kind?: string\r\n}\r\n\r\nexport interface StbNodeRaw {\r\n  id?: string\r\n  x?: string\r\n  y?: string\r\n  z?: string\r\n  kind?: string\r\n}\r\n\r\nexport interface StbDocument {\r\n  version: string\r\n  projectName?: string\r\n  encoding: StbEncoding\r\n  axisGroups: StbAxisGroupRaw[]\r\n  stories: StbStoryRaw[]\r\n  nodes: StbNodeRaw[]\r\n  unsupportedAxisKinds: { name: string; count: number }[]\r\n  unreadElements: { name: string; count: number }[]\r\n  issues: StbIssue[]\r\n}\r\n\r\nexport interface StbAxisCandidate {\r\n  label: string\r\n}\r\n\r\nexport interface StbGridCandidate {\r\n  direction: 'X' | 'Y'\r\n  groupName?: string\r\n 