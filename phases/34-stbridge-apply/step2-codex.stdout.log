\n      '?섉쎊',\r\n      '?뗣겤??,\r\n      'depth_cover',\r\n      'anchorage',\r\n      'cut_off',\r\n      'center_',\r\n      'StbSec',\r\n      'StbApply',\r\n      'StbColumn',\r\n      'StbGirder',\r\n      'StbBeam',\r\n      'StbWall',\r\n      'StbSlab',\r\n      'StbBrace',\r\n      'StbPile',\r\n      'StbFooting',\r\n      'fetch',\r\n      'XMLHttpRequest',\r\n      'WebSocket',\r\n      'sendBeacon',\r\n      'applyFramingPlan',\r\n      'applyElevation',\r\n      'updateProject',\r\n      'loadProject',\r\n      'useAppStore',\r\n      'zustand',\r\n      'createSampleProject',\r\n    ]\r\n\r\n    for (const { file, source } of scannedFiles) {\r\n      for (const term of forbidden) {\r\n        expect(source, `${file} contains forbidden term ${term}`).not.toContain(\r\n          term,\r\n        )\r\n      }\r\n    }\r\n  })\r\n})\r\n\r\n","exit_code":0,"status":"completed"}}
