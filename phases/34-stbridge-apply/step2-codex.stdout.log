\n\r\nexport type MemberKind = (typeof MEMBER_KINDS)[number]\r\n\r\nexport type MemberClass = '翁?퐪'\r\n\r\n/** ?덉슜 泥좉렐 寃쎌쓽 ?⑥씪 異쒖쿂 ??UI ??됲듃쨌??씊?ゃ궧???뚯꽌媛 ?ш린???뚯깮?쒕떎. */\r\nexport const BAR_SIZES = [\r\n  'D10',\r\n  'D13',\r\n  'D16',\r\n  'D19',\r\n  'D22',\r\n  'D25',\r\n  'D29',\r\n  'D32',\r\n] as const\r\n\r\nexport type BarSize = (typeof BAR_SIZES)[number]\r\n\r\n/**\r\n * 遙섇섭佯╉걵?볠뼪獒쒎섭嶺뗣겗?쇈겞?띲귙깢?쇈깤?삠궧?욍꺀?껁깤弱귞뵪?㎯걗?뗣?\n *\r\n * 訝▼렅?뉎겓訝佯╉굚?얇굦?ゃ걚 ???뚪쳵凉룟벧?띲뚦ㄷ?ｈ첀若싥띲겏?귙겓與숁틬餓뺞쭣??R7 ??30?곥꺕\r\n * ?곈뇧令띸츞?뷸틬 ??4?곥겎 0 餓뜰걽?귟쫸繹뽧걣若싥굙?뗩뎱嶺뗣겎??겒?뤷ㄷ?ｈ첀若싧뱚?졼걢?됥겎?귙굥??\n * ?앫굦?㎯굚?곈뇧?믣눣?쎼굥??겘?곥깢?쇈깤?삠궧?욍꺀?껁깤??Þ鼇덆빓?뺛굮 1?싧뎴2) ?뚧뼪?℡뫅?룔겏\r\n * 若싥굙?╉걚?╉곩푶?㎩폊?뤵꺂?쇈꺂?묆긿??죱?뚥??ㅳ굚?ゃ걚?뗣굢??(ADR-026)??\n *\r\n * 訝사춮?ャ겘鵝욍걟?ゃ걚?귚말嶺뗣겘若싩? (烏?.3.4)?삯뇥??텤??(烏?.3.2) ?믣푶?③뎱嶺뗣겗葉?줊??\n * 凉뺛걦?뚣곥걹??〃?ラ쳵凉룟벧?쎼굯??짒凉루춮??죱??겒?????뗣걣?앫굦?믥쫨?섅굥??\n *\r\n * 訝誤㎯겘?롩썓?쀣걼若잌쎋?㏂걣?멥걚?잌뫜?녑릫?앫겗?귙겗?㎯걗?ｃ겍?곮＝?곥궖?욍꺆?겹겗泳꿰푷?㎯겘\r\n * ?ゃ걚?괡13 ??쿀潁꾤쐧鵝뤷츉堊쏁덱?хㅎ?갨13 ??Ø役쒎툊??쎋?㏂겓?귙굥 (?⒲걾?됥굚 KSS785)??\n * ?ょ윥??뫜?녑릫??ㅳ굮鵝쒌굢?싩㈉轝꾠겓?썬걾??????씊?ゃ궧?덊뙆?쒌겏?뚣걯?긱걚??(R10)??\n */\r\nexport const HIGH_STRENGTH_SHEAR_BAR_SIZES = ['K13', 'S13'] as const\r\n\r\nexport type HighStrengthShearBarSize =\r\n  (typeof HIGH_STRENGTH_SHEAR_BAR_SIZES)[number]\r\n\r\n/** ?쎼굯??짒凉루춮 (躍?춮?삠걗?겹굢嶺? ?ュ뀯?뚣굢?뚣굥?쇈겞?띲겗?ⓧ퐪??*/\r\nexport const SHEAR_BAR_SIZES = [\r\n  ...BAR_SIZES,\r\n  ...HIGH_STRENGTH_SHEAR_BAR_SIZES,\r\n] as const\r\n\r\nexport type ShearBarSize = BarSize | HighStrengthShearBarSize\r\n\r\nexport type SteelGrade = 'SD295' | 'SD345' | 'SD390'\r\n\r\n/**\r\n * 訝사춮??텤?뗦뼶凉뤵귝뼪?㏘?誤㎯겗?ε뒟?㎯걗?ｃ겍獒썲뱚?뚧군?곥겒??(ADR-012)??\n *\r\n * ?곈뇧令띸츞?뷸틬 1?싧뎴4)??) ?뚦릫?뉎걲??겘?띲겖泳숁뎸?ⓦ궗?밧쑇?η텤?뗣걽?묆겒??겎??\n * 艅잍ː凉뤵꺕繹뜻렏??돮?꾠겘?ャ꺖?ャ깙?껁궚?담겎 `inferred` ??죱?ャ겒?????멥겧?뗣걣\r\n * ?ょ▶沃띲겏?쀣겍鈺?몜?뚥퍡??(ADR-015)??\n */\r\nexport const SPLICE_METHODS = [\r\n  '?띲겖泳숁뎸',\r\n  '?с궧?㎪렏',\r\n  '艅잍ː凉?,\r\n  '繹뜻렏',\r\n] as const\r\n\r\nexport type SpliceMethod = (typeof SPLICE_METHODS)[number]\r\n\r\n/** 烏?.3.6 ??걢?뜰굤?싥걬?삠꺂?믥돶若싥걲?뗥뀯??(掠뗥냵?삣콏鸚?횞 餓뺜툓?믡겗?됬꽒)??*/\r\nexport type Exposure = '掠뗥냵' | '掠뗥쨼'\r\n\r\nexport type Finish = '餓뺜툓?믡걗?? | '餓뺜툓?믡겒??\r\n\r\n/**\r\n * ?긱겗??씊壤®듁??\n *\r\n * ?녶숱?긱겘 b?팪 ?믡겏?귙겓?닷푶?ャ걲?뗣귛ㄷ歟곥겗?끾퀡?룔걬??3D ??윶?㏂굚 b?팪 ?뗣굢\r\n * 黎뷩겲?뗣겗?㎯곩쨼?ε?力뺛겏?쀣겍?뚣걯?ㅳ굮營?걨?겼숱?뜰겗瓦썲뒥?뚩쮫歷ц쫸?뉎굮?뷩굢?뺛겒?꾠?\n * ?곈뇧?㎩숱?뜰굮誤뗣굥??겘 1?싧뎴2)?뚧뼪?㏂겗鼇?쮫野멩퀡?ャ굠?뗥뫅?룔띲걼?졽?嶸뉑??㎯?\n * ?녶숱??씊?㎯겘?앫겗?③빓?뚦냶?ⓦ겓?ゃ굥 ??獒썲뱚?뚧뼭?쀣걚?ㅳ굮鵝쒌굥?뤵걨?㎯겘?ゃ걚 (ADR-027)??\n *\r\n * ?밤깙?ㅳ꺀?ョ춮??돮?뤵겒?꾠귝쮽繹뽨퍞礪섉쎑 5.3.4(6)(節? ?뚣뚣궧?묆궎?⒲꺂嶺뗣겗泳숁뎸?듽겞若싩???\n * ??.3.5 ?ャ굠?뗣띲겏?녈겓冶붵겖?╉걡?듽곥걹??쎋??렅?뉎겎?삣깗??(烏?.3.3 ?ⓨ릪????\n * ??씊?ゃ궧?덀걣?똇OOP D13@100?띲겏?멥걚?╉걚?뚣겙?앫굦??깢?쇈깤?㎯걗?ｃ겍?곮＝?곥걣\r\n * ?밤깙?ㅳ꺀?ャ겏沃?겳?욍걟?뗣걪?ⓦ겘?쀣겒??(ADR-012)??\n */\r\nexport type ColumnShape = '?⒴숱' | '?녶숱'\r\n\r\nexport interface ColumnSection {\r\n  id: string\r\n  kind: '??\r\n  mark: string\r\n  /**\r\n   * ??씊?ゃ궧?덉뿉??痍⑥엯?????대뒓 ???됱뿉???붾뒗吏. 寧?뤇(mark)??遺숈씠硫??꾨㈃???녿뒗\r\n   * 寧?뤇???낁㉢?몄뿉 洹몃?濡??섍?怨??낁㉢?몃뒗 ?대? ?롫퀎濡?臾띠뿬 ?덉뼱 ?롪? ??踰??쒖떆?쒕떎.\r\n   * ?쒗뭹??Story???鴉뤷쎋 痍⑥엯 ?붾㈃?먯꽌 ?뺥솗 ?쇱튂 ?먮룞 ?좏깮?쇰줈 ?뉖뒗??(ADR-035).\r\n   */\r\n  storyLabel?: string\r\n  /** ??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗?뗣?*/\r\n  shape: ColumnShape\r\n  b: number\r\n  d: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉???泳숁뎸嶸뉑??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 (令띸츞?뷸틬 1?싧뎴4)??)) */\r\n  spliceMethod: SpliceMethod\r\n  main: {\r\n    size: BarSize\r\n    count: number\r\n  }\r\n  hoop: {\r\n    size: ShearBarSize\r\n    pitch: number\r\n    /**\r\n     * ?띸쉰?븅뼋?????앸㈃?먯꽌 寧?쨌?永귛릭嶺뗭쓣 ?쇰쭏???꾩슦?붿?. 誤뤸틬??媛믪씠 ?녾퀬\r\n     * ?ф빊瑜?醫뚯슦?섎?濡??쒗뭹???뺥븯吏 ?딅뒗??????씊訝誤㏃쓽 ?낅젰?대떎 (ADR-012).\r\n     */\r\n    startOffsetMm: number\r\n  }\r\n}\r\n\r\n/** 鸚㎪쥈 訝사춮 1餘듸펷訝딁ク?얇걼??툔塋?펹??퐤營?닪?ф빊?귝뼪?㏂꺁?밤깉??ク?ⓦ꺕訝?ㄾ烏뚣겓野얍퓶?쇻굥??*/\r\nexport interface GirderMainRow {\r\n  /** 塋?깿竊덃뵱?밧겢竊됥겗?ф빊 */\r\n  endCount: number\r\n  /** 訝?ㄾ??쑍??*/\r\n  centerCount: number\r\n  /**\r\n   * 冶뗧ク?담겗?ф빊 ??藥?뤂?㏝걬?녴겏?띲걽?묉똻?ㅳ귞꽒?묆굦??endCount ?ⓨ릪?섓펷野양㎞竊됥?\n   * 冶뗧ク??꺀?녈꺆?쇈궖?ワ펷GirderRun.memberOffsetsMm ??0 ?댐펹??\n   */\r\n  startCount?: number\r\n}\r\n\r\n/**\r\n * 鸚㎪쥈訝사춮??퐤營?닪?ф빊?믡곲뇥?ゃ굤?믢퓷?ㅳ궛?ャ꺖?쀣겦?녻㎗?쇻굥??\n *\r\n * ?ф빊??눕令띺썓?덀겏?쀣겍鰲ｉ뇠?쇻굥?귡싥걮嶺뗣꺕冶뗧ク/永귞ク stub?삡릎鸚?춮?ュ뒥?덀겍??\n * 訝?밤겗??궧?졼걨?㎩츣??쇻굥 ?몄륫洹쇈굮瓦붵걲?귛쭓塋?겏永귞ク??륫?밤겓若싩??쇻굥 ?몄륫洹쇈겘\r\n * ?뚧셽?ユ닇塋뗣걮?ゃ걚?잆굙??oneSidedAnchor` ????밤걽?묆굮?곥겇 (ADR-032)??\n */\r\nexport interface GirderMainDecomposition {\r\n  throughCount: number\r\n  startStubCount: number\r\n  endStubCount: number\r\n  centerOnlyCount: number\r\n  oneSidedCount: number\r\n  oneSidedAnchor?: '冶뗧ク' | '永귞ク'\r\n}\r\n\r\nexport function decomposeGirderMainRow(\r\n  row: GirderMainRow,\r\n): GirderMainDecomposition {\r\n  const startCount = row.startCount ?? row.endCount\r\n  const throughCount = Math.min(startCount, row.centerCount, row.endCount)\r\n  const startStubCount = Math.max(0, startCount - row.centerCount)\r\n  const endStubCount = Math.max(0, row.endCount - row.centerCount)\r\n  const centerOnlyCount = Math.max(\r\n    0,\r\n    row.centerCount - Math.max(startCount, row.endCount),\r\n  )\r\n  const oneSidedStartCount = Math.max(\r\n    0,\r\n    Math.min(startCount, row.centerCount) - row.endCount,\r\n  )\r\n  const oneSidedEndCount = Math.max(\r\n    0,\r\n    Math.min(row.centerCount, row.endCount) - startCount,\r\n  )\r\n\r\n  if (oneSidedStartCount > 0) {\r\n    return {\r\n      throughCount,\r\n      startStubCount,\r\n      endStubCount,\r\n      centerOnlyCount,\r\n      oneSidedCount: oneSidedStartCount,\r\n      oneSidedAnchor: '冶뗧ク',\r\n    }\r\n  }\r\n\r\n  if (oneSidedEndCount > 0) {\r\n    return {\r\n      throughCount,\r\n      startStubCount,\r\n      endStubCount,\r\n      centerOnlyCount,\r\n      oneSidedCount: oneSidedEndCount,\r\n      oneSidedAnchor: '永귞ク',\r\n    }\r\n  }\r\n\r\n  return {\r\n    throughCount,\r\n    startStubCount,\r\n    endStubCount,\r\n    centerOnlyCount,\r\n    oneSidedCount: 0,\r\n  }\r\n}\r\n\r\nexport interface GirderSection {\r\n  id: string\r\n  kind: '鸚㎪쥈'\r\n  mark: string\r\n  /** ColumnSection.storyLabel怨?媛숇떎. */\r\n  storyLabel?: string\r\n  b: number\r\n  depth: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** ColumnSection.spliceMethod ?ⓨ릪?섅귡싥걮嶺뗣겗泳숁뎸嶸뉑??겹겓?밤걦 */\r\n  spliceMethod: SpliceMethod\r\n  main: {\r\n    size: BarSize\r\n    /** 訝딁ク嶺뗣겗鵝띸쉰?ζ쑍??????씊?ゃ궧?덀겗塋?깿?삡릎鸚?죱?뚣걹??겲?얍뀯??*/\r\n    top: GirderMainRow\r\n    /** 訝뗧ク嶺뗣겗鵝띸쉰?ζ쑍??*/\r\n    bottom: GirderMainRow\r\n    /**\r\n     * ?ャ긿?덀궕?뺟춮?믤윶?㏂걢?됪쥈??냵?담겦鵝?mm ?㎩늾?딀??곥굥?뗣?\n     *\r\n     * ?곈뇧令띸츞?뷸틬 2竊덌폆竊됪쥈1) ?뚣뚣깉?껁깤嶺뗣곥깗?녈긽?ⓨ늽??말嶺뗣곮짒凉루춮嶺됥겘鼇?쮫?녔쎑\r\n     * ?ャ굠?뗣띲겏冶붵겖?뗣겗?㎬쫸繹뽩겢?ュㅳ걣?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012)??\n     * 塋?깿?ⓧ릎鸚?걣?뚧빊竊덀궖?껁깉?ゃ깢嶺뗣걣?ゃ걚竊됪뼪?㏂겎??슴?뤵굦?ゃ걚??\n     */\r\n    cutoffFromSupportFaceMm: number\r\n  }\r\n  stirrup: {\r\n    size: ShearBarSize\r\n    pitch: number\r\n    /** 訝←ク??윶?㏂걢?됬К1?삥?永귙걗?겹굢嶺뗣굮?⒲굦?졼걨?㏂걲?뗣귟쫸繹뽧겓?ㅳ겘?ゃ걚 ????씊訝誤㎯겗?ε뒟?㎯걗??(ADR-012) */\r\n    startOffsetMm: number\r\n  }\r\n  /**\r\n   * 亮끾??곭춮?귝뼪?㏘?誤㎯겓鼇섋펹??겒?꾣쥈?ャ겘?▲걚?띸춮?ゃ겗?㏛뻣?뤻쟿??겏?쀣?\n   * `undefined` ??뚪뀓嶺뗣겒?쀣띲굮?뤷뫑?쇻굥 ??獒썲뱚?뚦떇?뗣겓擁녈걬?ゃ걚 (ADR-012)??\n   * 鼇?쮫?룔걬??빊?뤹찉嶸쀥읃繹?1?싧뎴3) ?뚧뼪?㏂겗鼇?쮫亮끹겏若싥굙?뗣겗?㎩뀯?쎼겘孃꾠겏?붵긿?곥걽?묆?\n   */\r\n  widthTie?: {\r\n    size: BarSize\r\n    pitch: number\r\n  }\r\n  /**\r\n   * ?밭춮??undefined` ??뚪뀓嶺뗣겒?쀣띲귝쑍?겹겘?녜씊?뚣?-D10?띲겏鼇섋펹?쇻굥?겹걹??굚??\n   * ?ゃ겗??1?싧뎴7) ??돯餓섅겎??겒?꾠?\n   */\r\n  sideBar?: {\r\n    size: BarSize\r\n    count: number\r\n    /**\r\n     * 歟곥겗訝←ク?㎩냵力뺛굮擁듽걟?╊섯?녈굥鵝숅빓 (mm)?귝빊?뤹찉嶸쀥읃繹?2竊덌폆竊됪쥈3) ??\n     * ?볝굦??1?싧뎴6) ?ュ쭟??곩릪?끹겘鼇?쮫?녔쎑?ヨ쮼雍됥걣?ゃ걨?뚣겙 JASS 5 繹뽫뵪??\n     * ?쇻굥?괟ASS 5 ??쐣?숃쫸?쇈겎?ょ▶岳앫곫쮽繹뽨퍞礪섉쎑5塋졼겓??끃嶺뗣겗鼇섋염?뚥???\n     * ?ゃ걚?잆굙誤뤸틬?ㅳ굮?뽧굦?ゃ걚 ??鼇?쮫?녔쎑??ㅳ굮?ε뒟?ⓦ걮??룛?묈룚??(R9????\n     */\r\n    extraLengthMm: number\r\n  }\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯????⒲꺖?▲꺍礪뗩졼겗鶯곥겎?귙굥?귛즯凉뤸쭓?졼겗鶯곥겎??겒?꾠?\n *\r\n * ?곈뇧令띸츞?뷸틬 2竊덌폊竊됧즯 ??1)?뚦즯凉뤸쭓?졽빳鸚뽧띲겏 2)?뚦즯凉뤸쭓?졼띲굮?ζ씉?뉎겎?긱걚??\n * 孃뚩끹겘塋?깿嶺뗣꺕潁?춮?삣즯歟곭춮?삥Ø嶺뗣꺕獒쒎섭嶺뗣겗5?뷴늽?ュ늽?뗣굦??씉?뉎겗?뤵걣?얇굥?㏝걬?녴?\n * ?볝걪?뚦츪獒끹걲?뗣겗??1) ?졼걨?㎯곩즯凉뤸쭓?졼겘?긱굩?ゃ걚??\n *\r\n * 亮끾?嶺뗣굮?곥걼?ゃ걚??겘?뤷쎋?꾠걽???싧뎴3) ??빓?뺧펷竊앭즯?싷펹?믣즯?ャ굚訝롢걟?뗣걣??\n * ?ф빊?믣츣?곥굥?→뻼??2竊덌폆竊됪쥈3) ?㎪쥈?쀣걢?띷뙁?쀣겍?듽굢?싥?竊덌폊竊됧즯 ?ュ퉭閭®춮??\n * 鼇섋염????뉎겒?꾠귝쑍?겹굮獒썲뱚?뚥퐳?됥겒?꾠겏鼇덁툓?㎯걤?ゃ걚 ??鵝쒌굢?ゃ걚 (ADR-022 ??끃嶺뗣겏?뚣걯?ㅶ뼪)??\n */\r\nexport interface WallSection {\r\n  id: string\r\n  kind: '?먬쐡鶯?\r\n  mark: string\r\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\r\n  storyLabel?: string\r\n  /**\r\n   * 鼇?쮫?녔쎑?㎩닩??걮?잌즯??뙷?녴귡썞鶯곥겘?γ겗 MemberKind ?㎯겘?ゃ걦?곩즯??\n   * ?뗣겤?듽겏?띲겖泳숁뎸訝뗩솏?졼걨?믣늽?묆굥?귞쐛?γ겘?℡춼旅덁뻑?ⓦ겗雅믤룢??걼??\n   * ?먨뒟鶯곥겏?쀣겍?긱걝 (ADR-036)??\n   */\r\n  wallClass?: '?먨뒟鶯? | '?먨뒟鶯곦빳鸚?\r\n  /** 鶯곩럻 (mm) */\r\n  thickness: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  exposure: Exposure\r\n  finish: Finish\r\n  /** 潁?춮?삥Ø嶺뗣겗泳숁뎸?밧폀?귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\r\n  spliceMethod: SpliceMethod\r\n  /**\r\n   * ?띸춮??광?????룔꺍?겹꺂(1) ????뽧꺂(2) ?뗣귝쑍?겹걣?앫겗?얇겲?띺걬?녴걣??\n   * ?볝굦?믤군?곥굥?→뻼??쫸繹뽧겓?ゃ걚?귛즯?ゃ궧?덀겗?똃13@200 ??뽧꺂?띲겏?꾠걝鼇섋펹\r\n   * ?앫겗?귙겗?㎯걗?듽곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)??\n   */\r\n  layers: 1 | 2\r\n  /** 潁?춮 ??訝듾툔??쥈?삣틞?욍겦若싩??쇻굥 */\r\n  vertical: {\r\n    size: BarSize\r\n    pitch: number\r\n    /**\r\n     * ?끾퀡塋?걢?됬К1?삥?永귙겗潁?춮?믡겑?뚣걽?묌썴?쇻걢?귝윶??hoop?삣ㄷ歟곥겗 stirrup ??\n     * ?뚣걯?녺뵳?㎬쫸繹뽧겓?ㅳ걣?ゃ걦?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)???싧뎴7) ??\n     * ?앮쐿?ゃ깢?삠긿?덀굮誤뗣겒?꾠겗?㎪빊?뤵겓??듅?뗣겒????3D 壤®듁?졼걨??ㅳ겎?귙굥??\n     */\r\n    startOffsetMm: number\r\n  }\r\n  /** 與ょ춮 ??訝▼겢??윶?멨츣??쇻굥 */\r\n  horizontal: {\r\n    size: BarSize\r\n    pitch: number\r\n    /** 潁?춮??startOffsetMm ?ⓨ릪?섅귙걪?▲굢??냵力뺡쳵?뺛겗訝뗧ク?뗣굢??퇌?㏂겎?귙굥??*/\r\n    startOffsetMm: number\r\n  }\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됥겗1?밧릲???㏂겗訝사춮??\n *\r\n * 孃꾠굚?붵긿?곥굚??씊?ゃ궧?덀겗?ε뒟?㎯걗?뗣귝빊?뤹찉嶸쀥읃繹?2竊덌폇竊됧틞??) ?뚣뚣깉?껁깤嶺뗣?\n * ?뤵꺍?곲깿?녴겗訝사춮?곮짒凉루춮嶺됥겘鼇?쮫?녔쎑?ャ굠?뗣띲겏冶붵겖?곮쫸繹뽩겢?ユ쑍?겹굮若싥굙??\n * ?→뻼?뚣겒??(ADR-012)?귙걪?볝걣誤뤸틬?뗣굢凉뺛걦??겘若싩??룔걬?졼걨?졼?\n */\r\nexport interface SlabBarRow {\r\n  size: BarSize\r\n  pitch: number\r\n  /**\r\n   * ?끾퀡塋?걢?됬К1?삥?永귙겗?꾤춮?믡겑?뚣걽?묌썴?쇻걢?귝윶??릭嶺뗣꺕鸚㎪쥈??걗?겹굢嶺뗣겏\r\n   * ?뚣걯?녺뵳?㎬쫸繹뽧겓?ㅳ걣?ゃ걦?곫뼪?㏘?誤㎯겗?ε뒟?㎯걗??(ADR-012)???싧뎴7) ??\n   * ?앮쐿?ゃ깢?삠긿?덀굮誤뗣겒?꾠겗?㎪빊?뤵겓??듅?뗣겒????3D 壤®듁?졼걨??ㅳ겎?귙굥??\n   */\r\n  startOffsetMm: number\r\n}\r\n\r\n/**\r\n * 佯딀씮竊덀궧?⒲깣竊됤??곈뇧令띸츞?뷸틬 2竊덌폇竊됧틞???㎪릍?뗣?\n *\r\n * 歷с굥野얕괌??냵力뺛걽?귟변鵝볝겗?뷴늽竊덄К4渶①К1塋좂К2影竊덌폇竊됵펹?뚦틞?욍굮?뚧윶?곫쥈嶺됥겓\r\n * ?γ걲?뗦객亮녔쓲??냵力뺡깿?녴띲겏若싥굙?뗣겗?㎯곲빓?뺛겘?싥굤??뼋?㎯겘?ゃ걦訝▼겢??ㄷ歟곥겗\r\n * ?끻겢?㏂겗?볝겎?귙굥?귝윶?삣ㄷ歟곥겏雅뚪뇥?ヨ쮫訝듽걮?ゃ걚??겘?볝겗若싩쑴?ャ굠??(ADR-028)??\n *\r\n * `exposure` ?믤똻?잆겒?꾠겗??〃5.3.6 ??쭓?졼걹??굚??걽?귛릪烏ⓦ겗?뚣궧?⒲깣?곮먨뒟鶯?\n * 餓ε쨼??즯?띹죱??퍞訝듽걩??쐣?▲걽?묆겎?녴걢?뚣곩콏?끹꺕掠뗥쨼??뙷?γ굮**?곥걼?ゃ걚** ??\n * ?뚧윶?곫쥈?곮먨뒟鶯곥띹죱?③걬?녴귛뀯?쎼겓營?걦?①뵽?㏂겓?밤걢?ゃ걚?ㅳ겲?욍걣訝╉겤??\n *\r\n * 亮끾?嶺뗣굮?곥걼?ゃ걚??겘?먬쐡鶯곥겏?뚣걯?녺뵳?㎯걗?뗣??싧뎴3) ?뚪빓?뺛굮訝롢걟?뗩깿?먦겗\r\n * ?쀦뙔??뚦읃鹽롦쥈?곫쥈?곩즯歟곥곩즯?띲겎佯딀씮?뚣겒?뤵곫쑍?겹굮若싥굙?뗦씉?뉎굚?ゃ걚??\n */\r\nexport interface SlabSection {\r\n  id: string\r\n  kind: '佯딀씮'\r\n  mark: string\r\n  /** ColumnSection.storyLabel ?ⓨ릪?섅?*/\r\n  storyLabel?: string\r\n  /** ?욕럻 (mm) */\r\n  thickness: number\r\n  fc: number\r\n  grade: SteelGrade\r\n  finish: Finish\r\n  /** 訝사춮??텤?뗦뼶凉뤵귞텤?뗧츋??겹겏鼇?쮫?룔걬?멥겗嶸쀥뀯?믤군?곥굥 */\r\n  spliceMethod: SpliceMethod\r\n  /** X?싥굤?밧릲竊늌邕멥겓亦욍겂?╊섯?녈굥竊됥겗訝사춮 */\r\n  x: { top: SlabBarRow; bottom: SlabBarRow }\r\n  /** Y?싥굤?밧릲??말嶺?*/\r\n  y: { top: SlabBarRow; bottom: SlabBarRow }\r\n}\r\n\r\nexport type Section =\r\n  | ColumnSection\r\n  | GirderSection\r\n  | WallSection\r\n  | SlabSection\r\n\r\n/**\r\n * ?붾㈃ ?쒖떆쨌aria-label???대쫫. 媛숈? 寧?뤇???롫퀎濡??щ윭 ??씊???????덉쑝誘濡?\n * ?롫? ?ш린??遺숈씤??????λ릺??`mark`???꾨㈃??寧?뤇 洹몃?濡??붾떎.\r\n */\r\nexport function sectionMarkLabel(section: Section): string {\r\n  return section.storyLabel\r\n    ? `${section.mark}(${section.storyLabel})`\r\n    : section.mark\r\n}\r\n\r\nexport interface ColumnPosition {\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\nexport interface GirderPosition {\r\n  axis: 'X' | 'Y'\r\n  ix: number\r\n  iy: number\r\n}\r\n\r\n/**\r\n * ?먬쐡鶯곥겗鵝띸쉰?귛ㄷ歟곥겏?뚣걯?뤻싥굤??겗1?밤깙?녑늽??씌?믣뜝?곥굥??겎壤㏂굚?뚣걯?㎯걗?뗣?\n *\r\n * TypeScript ??쭓?좂쉪?뗤퍡?묆겒??겎?곩닪?띲굮鵝쒌겂?╉굚?뗣겏?쀣겍??GirderPosition ??\n * ?뷴닪?뺛굦?ゃ걚 ???⒲걾?됥겎?귙굥?뗣굮黎뷩굙?뗣겗??만??`Member.kind` ??뼶?졼귚퐤營?걽?묆굮\r\n * 誤뗣겍?ⓩ쓲葉?닪?믣닩若싥걲?뗣궠?쇈깋?믤쎑?뗣겒?꾠걪?ⓦ?\n */\r\nexport type WallPosition = GirderPosition\r\n\r\n/**\r\n * 佯딀씮??퐤營????싥굤??겎?꿔겲?뚣걼1?쇻궎?믣뜝?곥굥??ix, iy) ??걹??깧?ㅳ겗?잏궧??\n * 竊늌?팢 