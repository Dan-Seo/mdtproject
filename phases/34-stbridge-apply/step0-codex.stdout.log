사용자가 정한다\r\n131:  if (changesGrid && otherStoryMembers && !discardOtherStories) {\r\n132:    return {\r\n133:      project,\r\n134:      applied: 0,\r\n135:      skipped: [],\r\n136:      refusal: '他階部材あり通り芯変更不可',\r\n137:    }\r\n138:  }\r\n139:\r\n140:  const sections = new Map<string, Section[]>()\r\n141:  for (const section of project.sections) {\r\n142:    const candidates = sections.get(section.mark)\r\n143:    if (candidates) candidates.push(section)\r\n144:    else sections.set(section.mark, [section])\r\n145:  }\r\n146:\r\n147:  const members: Member[] = []\r\n148:  const skipped: PlanApplyResult['skipped'] = []\r\n149:  for (const placement of block.placements) {\r\n150:    const allCandidates = sections.get(placement.mark) ?? []\r\n151:    const candidates =\r\n152:      sectionStoryLabel === undefined\r\n153:        ? allCandidates\r\n154:        : (() => {\r\n155:            const labeled = allCandidates.filter(\r\n156:              (section) => section.storyLabel === sectionStoryLabel,\r\n157:            )\r\n158:            return labeled.length > 0\r\n159:              ? labeled\r\n160:              : allCandidates.filter((section) => section.storyLabel === undefined)\r\n161:          })()\r\n162:    if (candidates.length === 0) {\r\n163:      skipped.push({ mark: placement.mark, reason: '断面未登録' })\r\n164:      continue\r\n165:    }\r\n166:    if (candidates.length > 1) {\r\n167:      skipped.push({ mark: placement.mark, reason: '断面複数該当' })\r\n168:      continue\r\n169:    }\r\n170:    const section = candidates[0]\r\n171:    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\r\n172:      skipped.push({ mark: placement.mark, reason: '部材種別相違' })\r\n173:      continue\r\n174:    }\r\n175:    if (!withinGrid(placement, grid)) {\r\n176:      skipped.push({ mark: placement.mark, reason: '格子外' })\r\n177:      continue\r\n178:    }\r\n179:\r\n180:    members.push({\r\n181:      // id는 사람이 읽는 값이 아니라 충돌만 피하면 된다. 같은 자리에 같은 符号을\r\n182:      // 두 번 반영해도 하나로 접히도록 자리를 id에 넣는다\r\n183:      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}${placement.role === '辺' ? `-${placement.axis}` : ''}`,\r\n184:      kind: section.kind,\r\n185:      memberClass: '躯体',\r\n186:      sectionId: section.id,\r\n187:      storyId,\r\n188:      position: positionOf(placement),\r\n189:    })\r\n190:  }\r\n191:\r\n192:  const deduped = new Map<string, Member>()\r\n193:  for (const member of members) deduped.set(member.id, member)\r\n194:\r\n195:  return {\r\n196:    project: {\r\n197:      ...project,\r\n198:      grid,\r\n199:      // 취입하는 층은 갈아 끼운다 — 두 번 눌러도 겹치지 않아야 하고, 도면에서\r\n200:      // 사라진 부재가 案件에 남아 있으면 그것도 「틀린 채로 완성된 것」이다\r\n201:      members: [\r\n202:        // 통り芯이 바뀌면 남은 부재의 index가 다른 자리를 가리키게 되므로,\r\n203:        // 동의를 받았을 때는 남기지 않고 전부 버린다 — 반쯤 옮겨 놓느니 비운다\r\n204:        ...(changesGrid && discardOtherStories\r\n205:          ? []\r\n206:          : project.members.filter((member) => member.storyId !== storyId)),\r\n207:        ...deduped.values(),\r\n208:      ],\r\n209:    },\r\n210:    applied: deduped.size,\r\n211:    skipped,\r\n212:  }\r\n213:}\r\n214:\r\n215:export interface ElevationApplyOptions {\r\n216:  candidate: ElevationCandidate\r\n217:  /**\r\n218:   * 階의 경계로 쓸 레벨의 범위. index는 **도면 순서**(위에서 아래)다.\r\n219:   * 위 끝(top)이 최상階의 천장, 아래 끝(bottom)이 최하階의 바닥이 된다 —\r\n220:   * パラペット 천단이나 基礎下端처럼 階가 아닌 레벨은 범위 밖에 둔다.\r\n221:   */\r\n222:  topLevelIndex: number\r\n223:  bottomLevelIndex: number\r\n224:  /** 階를 갈면 부재가 갈 곳을 잃는다. 화면은 거부를 보여준 뒤에만 이 선택지를 낸다 */\r\n225:  discardMembers?: boolean\r\n226:}\r\n227:\r\n228:export interface ElevationApplyResult {\r\n229:  project: Project\r\n230:  /** 만든 階 수 */\r\n231:  applied: number\r\n232:  refusal?: ElevationApplyRefusal\r\n233:}\r\n234:\r\n235:/**\r\n236: * 軸組図에서 읽은 높이를 案件의 階로 반영한다 (ADR-030).\r\n237: *\r\n238: * 「어느 레벨이 階의 경계인가」는 파서가 정하지 않으므로(FL·GL·基礎下端·RCL이\r\n239: * 섞여 있다) 여기서 사용자의 선택을 받는다. 階의 이름도 지어내지 않고 그 階의\r\n240: * **바닥이 되는 레벨의 원문**을 그대로 쓴다 — 같은 높이에 라벨이 둘이면 둘 다\r\n241: * 남긴다(실물의 「中央棟1FL」과 「基準GL」이 그렇다).\r\n242: */\r\n243:export function applyElevation(\r\n244:  project: Project,\r\n245:  {\r\n246:    candidate,\r\n247:    topLevelIndex,\r\n248:    bottomLevelIndex,\r\n249:    discardMembers = false,\r\n250:  }: ElevationApplyOptions,\r\n251:): ElevationApplyResult {\r\n252:  const valid =\r\n253:    Number.isInteger(topLevelIndex) &&\r\n254:    Number.isInteger(bottomLevelIndex) &&\r\n255:    topLevelIndex >= 0 &&\r\n256:    bottomLevelIndex > topLevelIndex &&\r\n257:    bottomLevelIndex < candidate.levels.length\r\n258:  if (!valid) {\r\n259:    return { project, applied: 0, refusal: '階範囲不正' }\r\n260:  }\r\n261:\r\n262:  // 階를 갈면 부재의 storyId가 가리키던 階가 사라진다. 부분 반영으로 넘어가면\r\n263:  // 「틀린 채로 완성된 것」이 되므로 통째로 거부하고, 사용자가 정한다\r\n264:  if (project.members.length > 0 && !discardMembers) {\r\n265:    return { project, applied: 0, refusal: '部材あり階置換不可' }\r\n266:  }\r\n267:\r\n268:  const stories: Story[] = []\r\n269:  // 도면은 위에서 아래, `Project.stories`는 아래에서 위다 (columnEnds가\r\n270:  // stories[level - 1]을 「아래 階」로 읽는다)\r\n271:  for (let i = bottomLevelIndex - 1; i >= topLevelIndex; i--) {\r\n272:    const floor = candidate.levels[i + 1]\r\n273:    const name =\r\n274:      floor.labels.length > 0\r\n275:        ? floor.labels.join('／')\r\n276:        : `${bottomLevelIndex - i}`\r\n277:    stories.push({\r\n278:      id: `story-${bottomLevelIndex - i}`,\r\n279:      name,\r\n280:      height: candidate.heightsMm[i],\r\n281:    })\r\n282:  }\r\n283:\r\n284:  return {\r\n285:    project: { ...project, stories, members: [] },\r\n286:    applied: stories.length,\r\n287:  }\r\n288:}\r\n--- src/lib/import/framing-plan/types.ts:1-220 ---\r\n1:/**\r\n2: * 셀을 빈칸으로 남긴 사유 코드 (section-list의 CANDIDATE_ISSUES 패턴).\r\n3: * 파서는 코드만 싣고 표시부가 번역한다.\r\n4: */\r\n5:export const PLAN_GRID_ISSUES = [\r\n6:  '通り芯ラベル未検出',\r\n7:  '寸法欠落',\r\n8:  '縮尺不整合',\r\n9:  '合計不一致',\r\n10:  'ラベル文字混在',\r\n11:  '通り芯対応不明',\r\n12:] as const\r\n13:\r\n14:export type PlanGridIssue = (typeof PLAN_GRID_ISSUES)[number]\r\n15:\r\n16:/** 伏図에서 읽은 通り芯 한 본. positionPt는 도면 좌표(pt) — 부재 스냅의 기준. */\r\n17:export interface AxisCandidate {\r\n18:  label: string\r\n19:  positionPt: number\r\n20:}\r\n21:\r\n22:/** 한 방향(X 또는 Y)의 通り芯 열 후보. 승인 전에는 형상이 되지 않는다 (ADR-030). */\r\n23:export interface PlanGridCandidate {\r\n24:  /** 라벨의 축 문자 — 밴드의 기하 방향이 아니라 도면이 붙인 이름을 따른다 */\r\n25:  direction: 'X' | 'Y'\r\n26:  /** 위치 오름차순 */\r\n27:  axes: AxisCandidate[]\r\n28:  /** 인접 축 사이 치수(mm). 길이는 axes.length - 1 */\r\n29:  spansMm: number[]\r\n30:  /** 실측 축척(pt/mm) — 전 스팬 실측의 중앙값. 표기 축척은 용지 의존이라 믿지 않는다 */\r\n31:  scalePtPerMm: number\r\n32:  /** 도면에 전체 치수가 명기돼 있고 스팬 합과 일치했다 */\r\n33:  totalConfirmed: boolean\r\n34:}\r\n35:\r\n36:/**\r\n37: * 부호가 그리드의 어디에 놓였는가 — 도면에서 잰 **기하**만 말한다.\r\n38: *\r\n39: * 「C면 柱」처럼 부호 접두로 부재 종별을 정하지 않는다. 종별은 断面リスト가\r\n40: * 이미 갖고 있으므로(ADR-018), 취입이 그 종별과 이 기하를 맞춰 본다 —\r\n41: * 어긋나면 사람이 판단할 일이지 파서가 고를 일이 아니다.\r\n42: */\r\n43:export const PLAN_PLACEMENT_ROLES = ['格子点', '辺', 'ベイ'] as const\r\n44:\r\n45:export type PlanPlacementRole = (typeof PLAN_PLACEMENT_ROLES)[number]\r\n46:\r\n47:export type MemberPlacement =\r\n48:  | { mark: string; role: '格子点' | 'ベイ'; ix: number; iy: number }\r\n49:  | {\r\n50:      mark: string\r\n51:      role: '辺'\r\n52:      /** 부재가 시작하는 격자점 */\r\n53:      ix: number\r\n54:      iy: number\r\n55:      /** 부재가 뻗는 방향 (GirderPosition.axis와 같은 뜻) */\r\n56:      axis: 'X' | 'Y'\r\n57:    }\r\n58:\r\n59:/**\r\n60: * 도면 위의 伏図 한 장. 한 페이지에 여러 장이 실리므로(실물 yokohama p7은\r\n61: * 2階床伏図와 R階床伏図 두 장) 通り芯 정의가 같아도 **위치가 다르다** —\r\n62: * 그리드 정의는 접히지만 블록은 접히지 않는다.\r\n63: */\r\n64:export interface PlanBlock {\r\n65:  /** 블록 제목 원문(「2階床伏図1/100」). 어느 Story인지는 사람이 정한다 */\r\n66:  title?: string\r\n67:  /** 이 블록과 짝지어진 X·Y 通り芯 정의. 취입은 반드시 이 둘을 쓴다 */\r\n68:  xGrid: PlanGridCandidate\r\n69:  yGrid: PlanGridCandidate\r\n70:  placements: MemberPlacement[]\r\n71:  /** 블록 안에 있으나 스냅하지 못한 부호(중복 없음, 원문 순) — 지어내지 않는다 */\r\n72:  unplacedMarks: string[]\r\n73:}\r\n74:\r\n75:export interface ParsedFramingPlan {\r\n76:  /** 通り芯 정의 — 같은 그리드가 여러 블록에 반복되면 하나로 접힌다 */\r\n77:  grids: PlanGridCandidate[]\r\n78:  blocks: PlanBlock[]\r\n79:  /** 후보를 못 낸 사유 — 첫 등장 순, 중복 없음 */\r\n80:  issues: PlanGridIssue[]\r\n81:}\r\n82:\r\n83:/** 軸組図에서 계열을 못 낸 사유. 파서는 코드만 싣고 표시부가 번역한다 */\r\n84:export const ELEVATION_ISSUES = ['寸法列未検出'] as const\r\n85:\r\n86:export type ElevationIssue = (typeof ELEVATION_ISSUES)[number]\r\n87:\r\n88:export interface ElevationLevel {\r\n89:  /** 그 높이에 적힌 라벨 원문 전부. 없으면 빈 배열 — 지어내지 않는다 */\r\n90:  labels: string[]\r\n91:  positionPt: number\r\n92:}\r\n93:\r\n94:/**\r\n95: * 軸組図 한 계열의 높이 방향 읽기. 「어느 레벨이 Story의 경계인가」는 정하지\r\n96: * 않는다 — 원문에는 FL·GL·基礎下端·RCL이 섞여 있고, 그중 무엇이 階인지는\r\n97: * 조문이 아니라 설계 의도라 사람이 읽을 일이다 (ADR-030).\r\n98: *\r\n99: * 通り芯과 달리 라벨의 좌우 정렬이 일정하지 않아(실물 p8의 좌단 x는 108~198로\r\n100: * 흩어진다) 라벨 밴드를 앵커로 쓸 수 없다. 앵커는 **치수 열**이고, 치수가 자기\r\n101: * 구간의 중점에 놓인다는 관계로 축척과 레벨 위치를 함께 푼다.\r\n102: */\r\n103:export interface ElevationCandidate {\r\n104:  /** 이 계열이 걸리는 軸組図 제목들(원문). 한 계열이 여러 通り에 공통으로 걸린다 */\r\n105:  titles: string[]\r\n106:  /** 도면 좌표 순 — 위에서 아래로 */\r\n107:  levels: ElevationLevel[]\r\n108:  /** 인접 레벨 사이 치수(mm). 길이는 levels.length - 1 */\r\n109:  heightsMm: number[]\r\n110:  scalePtPerMm: number\r\n111:}\r\n112:\r\n113:export interface ParsedFrameElevations {\r\n114:  elevations: ElevationCandidate[]\r\n115:  issues: ElevationIssue[]\r\n116:}\r\n117:\r\n118:/** 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\n119:export const PLAN_APPLY_REFUSALS = [\r\n120:  '階未指定',\r\n121:  '他階部材あり通り芯変更不可',\r\n122:] as const\r\n123:\r\n124:export type PlanApplyRefusal = (typeof PLAN_APPLY_REFUSALS)[number]\r\n125:\r\n126:/** 부호 하나를 넣지 못한 사유. 지어내는 대신 이 코드로 남긴다 */\r\n127:export const PLAN_APPLY_SKIPS = [\r\n128:  '断面未登録',\r\n129:  '部材種別相違',\r\n130:  '格子外',\r\n131:  '断面複数該当',\r\n132:] as const\r\n133:\r\n134:export type PlanApplySkip = (typeof PLAN_APPLY_SKIPS)[number]\r\n135:\r\n136:/** 階高 취입을 통째로 거부한 사유. 이때 案件은 손대지 않은 원본 그대로다 */\r\n137:export const ELEVATION_APPLY_REFUSALS = [\r\n138:  '階範囲不正',\r\n139:  '部材あり階置換不可',\r\n140:] as const\r\n141:\r\n142:export type ElevationApplyRefusal =\r\n143:  (typeof ELEVATION_APPLY_REFUSALS)[number]\r\n--- src/components/plan/PlanImport.tsx:1-360 ---\r\n1:'use client'\r\n2:\r\n3:import {\r\n4:  useEffect,\r\n5:  useMemo,\r\n6:  useRef,\r\n7:  useState,\r\n8:  type ChangeEvent,\r\n9:} from 'react'\r\n10:\r\n11:import {\r\n12:  applyElevation,\r\n13:  applyFramingPlan,\r\n14:  type ElevationApplyResult,\r\n15:  type PlanApplyResult,\r\n16:} from '@/lib/import/framing-plan/apply'\r\n17:import { parseFrameElevations } from '@/lib/import/framing-plan/elevation'\r\n18:import { parseFramingPlan } from '@/lib/import/framing-plan/parse'\r\n19:import type {\r\n20:  ElevationCandidate,\r\n21:  PlanBlock,\r\n22:  PlanGridCandidate,\r\n23:} from '@/lib/import/framing-plan/types'\r\n24:import { extractTextPages } from '@/lib/import/pdf-text'\r\n25:import type { TextPage } from '@/lib/import/section-list/types'\r\n26:import { useAppStore } from '@/lib/store'\r\n27:import { t } from '@/lib/i18n'\r\n28:import { storyKey, storyLabelFromTitle } from '@/lib/import/story-label'\r\n29:\r\n30:import styles from './PlanImport.module.css'\r\n31:\r\n32:/**\r\n33: * 伏図·軸組図에서 읽은 형상을 **후보로** 보여주고, 사용자가 승인하면 案件에\r\n34: * 넣는다 (ADR-030). 断面リスト 취입(ADR-018)과 같은 규약이다 — 승인 전에는\r\n35: * 형상이 되지 않고, 못 읽은 것은 지어내지 않고 사유를 말한다.\r\n36: *\r\n37: * 간이 평면 에디터를 대체하지 않는다. 래스터 도면·미지 형식에서는 이 화면이\r\n38: * 빈 후보로 정직하게 실패하고, 그때 형상을 넣는 길은 손입력뿐이다 (ADR-004).\r\n39: */\r\n40:\r\n41:interface PlanImportProps {\r\n42:  /** 테스트에서 PDF 추출을 건너뛰고 페이지를 직접 넣는다 */\r\n43:  initialPages?: TextPage[]\r\n44:  extractPages?: (file: File) => Promise<TextPage[]>\r\n45:}\r\n46:\r\n47:interface SelectionEvidence {\r\n48:  title: string\r\n49:  target: string\r\n50:}\r\n51:\r\n52:interface AutomaticSelections {\r\n53:  storyId?: string\r\n54:  story?: SelectionEvidence\r\n55:  sectionStoryLabel?: string\r\n56:  section?: SelectionEvidence\r\n57:}\r\n58:\r\n59:function automaticSelections(\r\n60:  block: PlanBlock,\r\n61:  stories: Array<{ id: string; name: string }>,\r\n62:  sectionStoryLabels: string[],\r\n63:): AutomaticSelections {\r\n64:  if (!block.title) return {}\r\n65:\r\n66:  const titleLabel = storyLabelFromTitle(block.title)\r\n67:  const titleKey = titleLabel ? storyKey(titleLabel) : undefined\r\n68:  if (titleKey === undefined) return {}\r\n69:\r\n70:  const matchingStories = stories.filter(\r\n71:    (story) =>\r\n72:      storyKey(story.id) === titleKey || storyKey(story.name) === titleKey,\r\n73:  )\r\n74:  const story = matchingStories.length === 1 ? matchingStories[0] : undefined\r\n75:\r\n76:  const matchingSectionLabels = sectionStoryLabels.filter(\r\n77:    (label) => storyKey(label) === titleKey,\r\n78:  )\r\n79:  const sectionStoryLabel =\r\n80:    matchingSectionLabels.length === 1 ? matchingSectionLabels[0] : undefined\r\n81:\r\n82:  return {\r\n83:    ...(story\r\n84:      ? {\r\n85:          storyId: story.id,\r\n86:          story: { title: block.title, target: story.name },\r\n87:        }\r\n88:      : {}),\r\n89:    ...(sectionStoryLabel\r\n90:      ? {\r\n91:          sectionStoryLabel,\r\n92:          section: { title: block.title, target: sectionStoryLabel },\r\n93:        }\r\n94:      : {}),\r\n95:  }\r\n96:}\r\n97:\r\n98:function Axes({\r\n99:  candidate,\r\n100:  label,\r\n101:  testId,\r\n102:}: {\r\n103:  candidate: PlanGridCandidate\r\n104:  label: string\r\n105:  testId: string\r\n106:}) {\r\n107:  return (\r\n108:    <div className={styles.group} data-testid={testId}>\r\n109:      <h4 className={styles.groupTitle}>{label}</h4>\r\n110:      <p className={styles.axes}>\r\n111:        {candidate.axes.map((axis, index) => (\r\n112:          <span key={`${axis.label}-${index}`}>\r\n113:            <span className={styles.axis}>{axis.label}</span>\r\n114:            {index < candidate.spansMm.length ? (\r\n115:              <span className={styles.span}>\r\n116:                {` — ${candidate.spansMm[index]} — `}\r\n117:              </span>\r\n118:            ) : null}\r\n119:          </span>\r\n120:        ))}\r\n121:      </p>\r\n122:    </div>\r\n123:  )\r\n124:}\r\n125:\r\n126:function Elevation({\r\n127:  candidate,\r\n128:  index,\r\n129:  locale,\r\n130:  onApply,\r\n131:  result,\r\n132:  discardMembers,\r\n133:  onDiscardMembersChange,\r\n134:}: {\r\n135:  candidate: ElevationCandidate\r\n136:  index: number\r\n137:  locale: 'ja' | 'ko'\r\n138:  onApply: (topLevelIndex: number, bottomLevelIndex: number) => void\r\n139:  result: ElevationApplyResult | null\r\n140:  discardMembers: boolean\r\n141:  onDiscardMembersChange: (next: boolean) => void\r\n142:}) {\r\n143:  // 「어느 레벨이 階의 경계인가」는 조문이 아니라 설계 의도라 사람이 고른다\r\n144:  // (ADR-030). 기본값은 양 끝 — 제품은 パラペット이나 基礎를 알아볼 수 없으므로\r\n145:  // 가장 넓게 잡아 두고 사용자가 좁힌다\r\n146:  const [top, setTop] = useState(0)\r\n147:  const [bottom, setBottom] = useState(candidate.levels.length - 1)\r\n148:\r\n149:  const levelLabel = (levelIndex: number) => {\r\n150:    const level = candidate.levels[levelIndex]\r\n151:    return level.labels.length > 0\r\n152:      ? level.labels.join('／')\r\n153:      : t(locale, 'planImport.levelUnlabelled')\r\n154:  }\r\n155:\r\n156:  return (\r\n157:    <div\r\n158:      className={styles.elevation}\r\n159:      data-testid={`plan-import-elevation-${index}`}\r\n160:    >\r\n161:      <div className={styles.blockHeading}>\r\n162:        <strong>\r\n163:          {candidate.titles.join('・') ||\r\n164:            t(locale, 'planImport.elevationUntitled')}\r\n165:        </strong>\r\n166:        <button\r\n167:          type=\"button\"\r\n168:          className={styles.applyButton}\r\n169:          data-testid={`plan-import-apply-elevation-${index}`}\r\n170:          onClick={() => onApply(top, bottom)}\r\n171:        >\r\n172:          {t(locale, 'planImport.applyStories')}\r\n173:        </button>\r\n174:      </div>\r\n175:      <p className={styles.axes}>\r\n176:        {candidate.levels.map((level, levelIndex) => (\r\n177:          <span key={levelIndex}>\r\n178:            <span className={styles.axis}>\r\n179:              {level.labels.join('／') || '—'}\r\n180:            </span>\r\n181:            {levelIndex < candidate.heightsMm.length ? (\r\n182:              <span className={styles.span}>\r\n183:                {` — ${candidate.heightsMm[levelIndex]} — `}\r\n184:              </span>\r\n185:            ) : null}\r\n186:          </span>\r\n187:        ))}\r\n188:      </p>\r\n189:      <div className={styles.storyPicker}>\r\n190:        <label className={styles.storyPicker}>\r\n191:          {t(locale, 'planImport.topLevel')}\r\n192:          <select\r\n193:            data-testid={`plan-import-level-top-${index}`}\r\n194:            value={top}\r\n195:            onChange={(event) => setTop(Number(event.target.value))}\r\n196:          >\r\n197:            {candidate.levels.map((level, levelIndex) => (\r\n198:              <option key={levelIndex} value={levelIndex}>\r\n199:                {levelLabel(levelIndex)}\r\n200:              </option>\r\n201:            ))}\r\n202:          </select>\r\n203:        </label>\r\n204:        <label className={styles.storyPicker}>\r\n205:          {t(locale, 'planImport.bottomLevel')}\r\n206:          <select\r\n207:            data-testid={`plan-import-level-bottom-${index}`}\r\n208:            value={bottom}\r\n209:            onChange={(event) => setBottom(Number(event.target.value))}\r\n210:          >\r\n211:            {candidate.levels.map((level, levelIndex) => (\r\n212:              <option key={levelIndex} value={levelIndex}>\r\n213:                {levelLabel(levelIndex)}\r\n214:              </option>\r\n215:            ))}\r\n216:          </select>\r\n217:        </label>\r\n218:      </div>\r\n219:      {/* 동의는 거부를 한 번 본 뒤에만 물어본다 */}\r\n220:      {result?.refusal === '部材あり階置換不可' ? (\r\n221:        <label className={styles.storyPicker}>\r\n222:          <input\r\n223:            type=\"checkbox\"\r\n224:            data-testid={`plan-import-discard-members-${index}`}\r\n225:            checked={discardMembers}\r\n226:            onChange={(event) => onDiscardMembersChange(event.target.checked)}\r\n227:          />\r\n228:          {t(locale, 'planImport.discardMembers')}\r\n229:        </label>\r\n230:      ) : null}\r\n231:      {result ? (\r\n232:        <p\r\n233:          className={styles.muted}\r\n234:          data-testid={`plan-import-elevation-result-${index}`}\r\n235:        >\r\n236:          {result.refusal\r\n237:            ? t(locale, `planImport.elevationRefusal.${result.refusal}`)\r\n238:            : `${t(locale, 'planImport.appliedStories')}: ${result.applied}`}\r\n239:        </p>\r\n240:      ) : null}\r\n241:    </div>\r\n242:  )\r\n243:}\r\n244:\r\n245:export function PlanImport({\r\n246:  initialPages,\r\n247:  extractPages = extractTextPages,\r\n248:}: PlanImportProps) {\r\n249:  const locale = useAppStore(({ locale }) => locale)\r\n250:  const stories = useAppStore(({ project }) => project.stories)\r\n251:  const sections = useAppStore(({ project }) => project.sections)\r\n252:  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n253:  const inputRef = useRef<HTMLInputElement>(null)\r\n254:  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\r\n255:  const [open, setOpen] = useState(initialPages !== undefined)\r\n256:  const [loading, setLoading] = useState(false)\r\n257:  const [failed, setFailed] = useState(false)\r\n258:  const [storyId, setStoryId] = useState('')\r\n259:  const [storySelectionWasManual, setStorySelectionWasManual] = useState(false)\r\n260:  const [sectionStoryLabel, setSectionStoryLabel] = useState<\r\n261:    string | undefined\r\n262:  >(undefined)\r\n263:  const [sectionSelectionWasManual, setSectionSelectionWasManual] =\r\n264:    useState(false)\r\n265:  const [storyEvidence, setStoryEvidence] = useState<\r\n266:    SelectionEvidence | undefined\r\n267:  >(undefined)\r\n268:  const [sectionEvidence, setSectionEvidence] = useState<\r\n269:    SelectionEvidence | undefined\r\n270:  >(undefined)\r\n271:  const [result, setResult] = useState<PlanApplyResult | null>(null)\r\n272:  const [discardOtherStories, setDiscardOtherStories] = useState(false)\r\n273:  const [discardMembers, setDiscardMembers] = useState(false)\r\n274:  const [elevationResults, setElevationResults] = useState<\r\n275:    Record<number, ElevationApplyResult>\r\n276:  >({})\r\n277:  // 연속 선택 시 늦게 끝난 이전 파일의 결과가 최신 결과를 덮지 않게 한다\r\n278:  const requestRef = useRef(0)\r\n279:\r\n280:  const plans = useMemo(\r\n281:    () => (pages ?? []).map((page) => parseFramingPlan(page)),\r\n282:    [pages],\r\n283:  )\r\n284:  const elevations = useMemo(\r\n285:    () => (pages ?? []).flatMap((page) => parseFrameElevations(page).elevations),\r\n286:    [pages],\r\n287:  )\r\n288:  const grids = plans.flatMap((plan) => plan.grids)\r\n289:  const gridIndexes = { X: 0, Y: 0 }\r\n290:  const displayedGrids = grids.map((candidate) => ({\r\n291:    candidate,\r\n292:    index: gridIndexes[candidate.direction]++,\r\n293:  }))\r\n294:  const blocks: PlanBlock[] = plans.flatMap((plan) => plan.blocks)\r\n295:  const sectionStoryLabels = useMemo(() => {\r\n296:    const labels: string[] = []\r\n297:    const seen = new Set<string>()\r\n298:    for (const section of sections) {\r\n299:      if (!section.storyLabel || seen.has(section.storyLabel)) continue\r\n300:      seen.add(section.storyLabel)\r\n301:      labels.push(section.storyLabel)\r\n302:    }\r\n303:    return labels\r\n304:  }, [sections])\r\n305:\r\n306:  useEffect(() => {\r\n307:    if (storyId === '' || stories.some((story) => story.id === storyId)) return\r\n308:\r\n309:    setStoryId('')\r\n310:    setStorySelectionWasManual(false)\r\n311:    setStoryEvidence(undefined)\r\n312:  }, [stories, storyId])\r\n313:\r\n314:  // 사유는 페이지마다 나오므로 접는다 — 같은 말이 페이지 수만큼 늘어서면 읽히지 않는다\r\n315:  const iss