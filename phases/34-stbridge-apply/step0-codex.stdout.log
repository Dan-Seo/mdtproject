{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$p='\"'src/app/page.tsx'; \"'$lines=Get-Content -Encoding UTF8 $p; for($i=24-1;$i -lt 55;$i++){ '\"'{0}:{1}' -f (\"'$i+1),$lines[$i] }; $p='\"'src/domain/model/project.ts'; \"'$lines=Get-Content -Encoding UTF8 $p; for($i=65-1;$i -lt 100;$i++){ '\"'{0}:{1}' -f (\"'$i+1),$lines[$i] }; for($i=157-1;$i -lt 169;$i++){ '\"'{0}:{1}' -f (\"'$i+1),$lines[$i] }'","aggregated_output":"24:\r\n25:export default function Home() {\r\n26:  // 前回の案件を戻し、以後の編集を自動保存する (docs/UX.md §4 段階5)。\r\n27:  // 復元中も画面はサンプル案件で動く — 待たせない (§4.2)。\r\n28:  useProjectPersistence()\r\n29:\r\n30:  return (\r\n31:    <AppShell\r\n32:      plan={<PlanEditor />}\r\n33:      planActions={\r\n34:        <>\r\n35:          <StoryTabs />\r\n36:          <PlanImport />\r\n37:        </>\r\n38:      }\r\n39:      section={<SectionTable />}\r\n40:      sectionActions={<SectionImport />}\r\n41:      viewer={<Viewer3D />}\r\n42:      viewerActions={\r\n43:        <>\r\n44:          <ViewerTabs />\r\n45:          <ViewerExportButton />\r\n46:        </>\r\n47:      }\r\n48:      takeoff={<TakeoffPane />}\r\n49:      takeoffActions={<TakeoffActions />}\r\n50:    />\r\n51:  )\r\n52:}\r\n53:\r\n54:\r\n55:\r\n65:export const PROJECT_SCHEMA_VERSION = 11\r\n66:\r\n67:export interface Grid {\r\n68:  xSpans: number[]\r\n69:  ySpans: number[]\r\n70:  /**\r\n71:   * 通り芯의 이름 (「bX1」「Y3」). 伏図에서 읽은 원문 그대로이고 길이는\r\n72:   * spans.length + 1이다. 미지정은 「도면에서 읽은 이름이 없다」는 뜻이며,\r\n73:   * 제품이 index로 이름을 지어내지 않는다 (ADR-004·ADR-030).\r\n74:   *\r\n75:   * schemaVersion을 올리지 않는다 — 이 필드는 数量을 바꾸지 않는다. 版을\r\n76:   * 올리는 기준은 「같은 案件의 数量이 달라지는가」다 (v11 주석 참조).\r\n77:   */\r\n78:  xLabels?: string[]\r\n79:  yLabels?: string[]\r\n80:}\r\n81:\r\n82:/** 라벨 배열이 스팬 수와 맞는가. 어긋나면 어느 축의 이름인지 알 수 없다 */\r\n83:export function isGridLabels(\r\n84:  labels: unknown,\r\n85:  spanCount: number,\r\n86:): labels is string[] {\r\n87:  return (\r\n88:    Array.isArray(labels) &&\r\n89:    labels.length === spanCount + 1 &&\r\n90:    labels.every((label) => typeof label === 'string')\r\n91:  )\r\n92:}\r\n93:\r\n94:export interface Story {\r\n95:  id: string\r\n96:  name: string\r\n97:  height: number\r\n98:}\r\n99:\r\n100:export interface Project {\r\n157:}\r\n158:\r\n159:/** 층 바닥의 누적 표고(mm). stories 배열 순서대로 아래층 height를 누적한다. */\r\n160:export function storyElevation(stories: Story[], storyId: string): number {\r\n161:  const index = stories.findIndex(({ id }) => id === storyId)\r\n162:\r\n163:  if (index < 0) {\r\n164:    throw storyNotFound(storyId)\r\n165:  }\r\n166:\r\n167:  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\r\n168:}\r\n169:\r\n","exit_code":0,"status":"completed"}}
