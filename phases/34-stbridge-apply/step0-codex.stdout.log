{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$p='\"'src/lib/import/framing-plan/apply.ts'; \"'$lines=Get-Content -Encoding UTF8 $p; foreach($r in @(@(243,290),@(55,80),@(119,140),@(188,214))){'\"'---'; for(\"'$i=$r[0]-1;$i -lt $r[1];$i++){ '\"'{0}:{1}' -f (\"'$i+1),$lines[$i] }}; $p='\"'src/lib/import/framing-plan/apply.test.ts'; \"'$lines=Get-Content -Encoding UTF8 $p; for($i=620-1;$i -lt 729;$i++){ '\"'{0}:{1}' -f (\"'$i+1),$lines[$i] }'","aggregated_output":"---\r\n243:export function applyElevation(\r\n244:  project: Project,\r\n245:  {\r\n246:    candidate,\r\n247:    topLevelIndex,\r\n248:    bottomLevelIndex,\r\n249:    discardMembers = false,\r\n250:  }: ElevationApplyOptions,\r\n251:): ElevationApplyResult {\r\n252:  const valid =\r\n253:    Number.isInteger(topLevelIndex) &&\r\n254:    Number.isInteger(bottomLevelIndex) &&\r\n255:    topLevelIndex >= 0 &&\r\n256:    bottomLevelIndex > topLevelIndex &&\r\n257:    bottomLevelIndex < candidate.levels.length\r\n258:  if (!valid) {\r\n259:    return { project, applied: 0, refusal: '階範囲不正' }\r\n260:  }\r\n261:\r\n262:  // 階를 갈면 부재의 storyId가 가리키던 階가 사라진다. 부분 반영으로 넘어가면\r\n263:  // 「틀린 채로 완성된 것」이 되므로 통째로 거부하고, 사용자가 정한다\r\n264:  if (project.members.length > 0 && !discardMembers) {\r\n265:    return { project, applied: 0, refusal: '部材あり階置換不可' }\r\n266:  }\r\n267:\r\n268:  const stories: Story[] = []\r\n269:  // 도면은 위에서 아래, `Project.stories`는 아래에서 위다 (columnEnds가\r\n270:  // stories[level - 1]을 「아래 階」로 읽는다)\r\n271:  for (let i = bottomLevelIndex - 1; i >= topLevelIndex; i--) {\r\n272:    const floor = candidate.levels[i + 1]\r\n273:    const name =\r\n274:      floor.labels.length > 0\r\n275:        ? floor.labels.join('／')\r\n276:        : `${bottomLevelIndex - i}`\r\n277:    stories.push({\r\n278:      id: `story-${bottomLevelIndex - i}`,\r\n279:      name,\r\n280:      height: candidate.heightsMm[i],\r\n281:    })\r\n282:  }\r\n283:\r\n284:  return {\r\n285:    project: { ...project, stories, members: [] },\r\n286:    applied: stories.length,\r\n287:  }\r\n288:}\r\n289:\r\n290:\r\n---\r\n55:function gridOf(block: PlanBlock): Grid {\r\n56:  const { xGrid, yGrid } = block\r\n57:  return {\r\n58:    xSpans: [...xGrid.spansMm],\r\n59:    ySpans: [...yGrid.spansMm],\r\n60:    // 通り芯의 이름은 도면에 있는 것이고, 이것이 있어야 「Y3端／Y4端」처럼\r\n61:    // 좌우가 다른 断面リスト를 런의 실제 방향과 맞출 수 있다 (R13의 선결 조건)\r\n62:    xLabels: xGrid.axes.map((axis) => axis.label),\r\n63:    yLabels: yGrid.axes.map((axis) => axis.label),\r\n64:  }\r\n65:}\r\n66:\r\n67:/**\r\n68: * 스팬만 본다 — 라벨은 数量도 격자 index도 바꾸지 않으므로, 이름만 달라진\r\n69: * 그리드를 「바뀌었다」로 보면 다른 층의 부재를 버리라는 물음이 이유 없이 뜬다.\r\n70: */\r\n71:function sameGrid(left: Grid, right: Grid): boolean {\r\n72:  return (\r\n73:    left.xSpans.length === right.xSpans.length &&\r\n74:    left.ySpans.length === right.ySpans.length &&\r\n75:    left.xSpans.every((span, i) => span === right.xSpans[i]) &&\r\n76:    left.ySpans.every((span, i) => span === right.ySpans[i])\r\n77:  )\r\n78:}\r\n79:\r\n80:function positionOf(placement: MemberPlacement) {\r\n---\r\n119:  if (!project.stories.some((story) => story.id === storyId)) {\r\n120:    return { project, applied: 0, skipped: [], refusal: '階未指定' }\r\n121:  }\r\n122:\r\n123:  const grid = gridOf(block)\r\n124:  const changesGrid = !sameGrid(project.grid, grid)\r\n125:  const otherStoryMembers = project.members.some(\r\n126:    (member) => member.storyId !== storyId,\r\n127:  )\r\n128:  // 격자 index는 스팬 배열에 매여 있다 — 스팬을 바꾸면 손대지 않은 층의 부재가\r\n129:  // 조용히 다른 자리로 옮겨간다. 부분 반영으로 넘어가면 「틀린 채로 완성된 것」이\r\n130:  // 되므로 통째로 거부하고, 어느 쪽을 버릴지는 사용자가 정한다\r\n131:  if (changesGrid && otherStoryMembers && !discardOtherStories) {\r\n132:    return {\r\n133:      project,\r\n134:      applied: 0,\r\n135:      skipped: [],\r\n136:      refusal: '他階部材あり通り芯変更不可',\r\n137:    }\r\n138:  }\r\n139:\r\n140:  const sections = new Map<string, Section[]>()\r\n---\r\n188:      position: positionOf(placement),\r\n189:    })\r\n190:  }\r\n191:\r\n192:  const deduped = new Map<string, Member>()\r\n193:  for (const member of members) deduped.set(member.id, member)\r\n194:\r\n195:  return {\r\n196:    project: {\r\n197:      ...project,\r\n198:      grid,\r\n199:      // 취입하는 층은 갈아 끼운다 — 두 번 눌러도 겹치지 않아야 하고, 도면에서\r\n200:      // 사라진 부재가 案件에 남아 있으면 그것도 「틀린 채로 완성된 것」이다\r\n201:      members: [\r\n202:        // 통り芯이 바뀌면 남은 부재의 index가 다른 자리를 가리키게 되므로,\r\n203:        // 동의를 받았을 때는 남기지 않고 전부 버린다 — 반쯤 옮겨 놓느니 비운다\r\n204:        ...(changesGrid && discardOtherStories\r\n205:          ? []\r\n206:          : project.members.filter((member) => member.storyId !== storyId)),\r\n207:        ...deduped.values(),\r\n208:      ],\r\n209:    },\r\n210:    applied: deduped.size,\r\n211:    skipped,\r\n212:  }\r\n213:}\r\n214:\r\n620:  const candidate: ElevationCandidate = {\r\n621:    titles: ['bY1通り軸組図1/100'],\r\n622:    levels: [\r\n623:      { labels: [], positionPt: 159 },\r\n624:      { labels: ['中央棟RCL(水下)'], positionPt: 199 },\r\n625:      { labels: ['2FL'], positionPt: 315 },\r\n626:      { labels: ['中央棟1FL', '基準GL'], positionPt: 442 },\r\n627:      { labels: ['基礎下端'], positionPt: 518 },\r\n628:    ],\r\n629:    heightsMm: [1400, 4100, 4480, 2690],\r\n630:    scalePtPerMm: 0.02835,\r\n631:  }\r\n632:\r\n633:  it('고른 범위의 간격만 階가 되고, 아래에서 위로 쌓인다', () => {\r\n634:    // 1FL(3)에서 RCL(1)까지 → 1階(4480)와 2階(4100). パラペット(1400)와\r\n635:    // 基礎(2690)는 階가 아니므로 범위 밖이다\r\n636:    const result = applyElevation(project(), {\r\n637:      candidate,\r\n638:      topLevelIndex: 1,\r\n639:      bottomLevelIndex: 3,\r\n640:    })\r\n641:    expect(result.refusal).toBeUndefined()\r\n642:    expect(result.project.stories.map((story) => story.height)).toEqual([\r\n643:      4480, 4100,\r\n644:    ])\r\n645:  })\r\n646:\r\n647:  it('階의 이름은 그 階의 바닥이 되는 레벨의 원문이다', () => {\r\n648:    const result = applyElevation(project(), {\r\n649:      candidate,\r\n650:      topLevelIndex: 1,\r\n651:      bottomLevelIndex: 3,\r\n652:    })\r\n653:    // 같은 높이에 라벨이 둘이면 둘 다 남긴다 — 하나를 고르지 않는다\r\n654:    expect(result.project.stories.map((story) => story.name)).toEqual([\r\n655:      '中央棟1FL／基準GL',\r\n656:      '2FL',\r\n657:    ])\r\n658:  })\r\n659:\r\n660:  it('라벨이 없는 레벨이 바닥이면 이름을 지어내지 않고 번호로 둔다', () => {\r\n661:    const result = applyElevation(project(), {\r\n662:      candidate,\r\n663:      topLevelIndex: 0,\r\n664:      bottomLevelIndex: 1,\r\n665:    })\r\n666:    expect(result.project.stories.map((story) => story.name)).toEqual([\r\n667:      '中央棟RCL(水下)',\r\n668:    ])\r\n669:  })\r\n670:\r\n671:  it('범위가 한 칸도 없으면 거부한다', () => {\r\n672:    const base = project()\r\n673:    const result = applyElevation(base, {\r\n674:      candidate,\r\n675:      topLevelIndex: 2,\r\n676:      bottomLevelIndex: 2,\r\n677:    })\r\n678:    expect(result.refusal).toBe('階範囲不正')\r\n679:    expect(result.project).toBe(base)\r\n680:  })\r\n681:\r\n682:  it('부재가 있으면 통째로 거부한다 — 階를 갈면 부재가 갈 곳을 잃는다', () => {\r\n683:    const base = project({\r\n684:      sections: [columnSection('C1')],\r\n685:      members: [\r\n686:        {\r\n687:          id: 'm1',\r\n688:          kind: '柱',\r\n689:          memberClass: '躯体',\r\n690:          sectionId: 'sec-C1',\r\n691:          storyId: 'story-1',\r\n692:          position: { ix: 0, iy: 0 },\r\n693:        },\r\n694:      ],\r\n695:    })\r\n696:    const result = applyElevation(base, {\r\n697:      candidate,\r\n698:      topLevelIndex: 1,\r\n699:      bottomLevelIndex: 3,\r\n700:    })\r\n701:    expect(result.refusal).toBe('部材あり階置換不可')\r\n702:    expect(result.project).toBe(base)\r\n703:  })\r\n704:\r\n705:  it('동의하면 부재를 버리고 階를 갈아 끼운다', () => {\r\n706:    const base = project({\r\n707:      sections: [columnSection('C1')],\r\n708:      members: [\r\n709:        {\r\n710:          id: 'm1',\r\n711:          kind: '柱',\r\n712:          memberClass: '躯体',\r\n713:          sectionId: 'sec-C1',\r\n714:          