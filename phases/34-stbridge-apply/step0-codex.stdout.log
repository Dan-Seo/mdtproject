0:                      </span>\r\n511:                    ) : null}\r\n512:                  </div>\r\n513:                ) : null}\r\n514:\r\n515:                {blocks.length > 0 ? (\r\n516:                  <div className={styles.storyPicker}>\r\n517:                    <label className={styles.storyPicker}>\r\n518:                      {t(locale, 'planImport.story')}\r\n519:                      <select\r\n520:                        data-testid=\"plan-import-story\"\r\n521:                        value={storyId}\r\n522:                        onChange={(event) => {\r\n523:                          setStoryId(event.target.value)\r\n524:                          setStorySelectionWasManual(true)\r\n525:                          setStoryEvidence(undefined)\r\n526:                        }}\r\n527:                      >\r\n528:                        <option value=\"\">\r\n529:                          {t(locale, 'planImport.storyAny')}\r\n530:                        </option>\r\n531:                        {stories.map((story) => (\r\n532:                          <option key={story.id} value={story.id}>\r\n533:                            {story.name}\r\n534:                          </option>\r\n535:                        ))}\r\n536:                      </select>\r\n537:                    </label>\r\n538:                    {storyEvidence ? (\r\n539:                      <span\r\n540:                        className={styles.muted}\r\n541:                        data-testid=\"plan-import-story-evidence\"\r\n542:                      >\r\n543:                        {`${t(locale, 'planImport.autoSelection')}: ${storyEvidence.title} → ${storyEvidence.target}`}\r\n544:                      </span>\r\n545:                    ) : null}\r\n546:                  </div>\r\n547:                ) : null}\r\n548:\r\n549:                {blocks.map((block, index) => (\r\n550:                  <div\r\n551:                    key={`${block.title ?? 'block'}-${index}`}\r\n552:                    className={styles.block}\r\n553:                  >\r\n554:                    <div className={styles.blockHeading}>\r\n555:                      <strong>\r\n556:                        {block.title ?? t(locale, 'planImport.blockUntitled')}\r\n557:                      </strong>\r\n558:                      <button\r\n559:                        type=\"button\"\r\n560:                        className={styles.applyButton}\r\n561:                        data-testid={`plan-import-apply-${index}`}\r\n562:                        onClick={() => apply(block)}\r\n563:                      >\r\n564:                        {t(locale, 'planImport.apply')}\r\n565:                      </button>\r\n566:                    </div>\r\n567:                    <p className={styles.muted}>\r\n568:                      {`${t(locale, 'planImport.placements')}: ${block.placements.length}`}\r\n569:                      {block.unplacedMarks.length > 0\r\n570:                        ? ` / ${t(locale, 'planImport.unplaced')}: ${block.unplacedMarks.join('・')}`\r\n571:                        : ''}\r\n572:                    </p>\r\n573:                    <Axes\r\n574:                      candidate={block.xGrid}\r\n575:                      label={t(locale, 'planImport.gridX')}\r\n576:                      testId={`plan-import-block-grid-${index}-X`}\r\n577:                    />\r\n578:                    <Axes\r\n579:                      candidate={block.yGrid}\r\n580:                      label={t(locale, 'planImport.gridY')}\r\n581:                      testId={`plan-import-block-grid-${index}-Y`}\r\n582:                    />\r\n583:                  </div>\r\n584:                ))}\r\n585:\r\n586:                {elevations.map((candidate, index) => (\r\n587:                  <Elevation\r\n588:                    key={index}\r\n589:                    candidate={candidate}\r\n590:                    index={index}\r\n591:                    locale={locale}\r\n592:                    result={elevationResults[index] ?? null}\r\n593:                    discardMembers={discardMembers}\r\n594:                    onDiscardMembersChange={setDiscardMembers}\r\n595:                    onApply={(topLevel, bottomLevel) =>\r\n596:                      applyStories(candidate, index, topLevel, bottomLevel)\r\n597:                    }\r\n598:                  />\r\n599:                ))}\r\n600:\r\n601:                {/* 동의는 거부를 한 번 본 뒤에만 물어본다 — 처음부터 내놓으면\r\n602:                    「무슨 뜻인지 모른 채 켜 두는 칸」이 된다 */}\r\n603:                {result?.refusal === '他階部材あり通り芯変更不可' ? (\r\n604:                  <label className={styles.storyPicker}>\r\n605:                    <input\r\n606:                      type=\"checkbox\"\r\n607:                      data-testid=\"plan-import-discard\"\r\n608:                      checked={discardOtherStories}\r\n609:                      onChange={(event) =>\r\n610:                        setDiscardOtherStories(event.target.checked)\r\n611:                      }\r\n612:                    />\r\n613:                    {t(locale, 'planImport.discardOtherStories')}\r\n614:                  </label>\r\n615:                ) : null}\r\n616:\r\n617:                {result ? (\r\n618:                  <p className={styles.muted} data-testid=\"plan-import-result\">\r\n619:                    {result.refusal\r\n620:                      ? t(locale, `planImport.refusal.${result.refusal}`)\r\n621:                      : `${t(locale, 'planImport.applied')}: ${result.applied}`}\r\n622:                    {result.skipped.length > 0\r\n623:                      ? ` / ${result.skipped\r\n624:                          .map(\r\n625:                            ({ mark, reason }) =>\r\n626:                              `${mark}(${t(locale, `planImport.skip.${reason}`)})`,\r\n627:                          )\r\n628:                          .join('、')}`\r\n629:                      : ''}\r\n630:                  </p>\r\n631:                ) : null}\r\n632:              </>\r\n633:            )}\r\n634:          </div>\r\n635:        </section>\r\n636:      ) : null}\r\n637:    </div>\r\n638:  )\r\n639:}\r\n--- src/domain/model/project.ts:1-120 ---\r\n1:import {\r\n2:  BAR_SIZES,\r\n3:  MEMBER_KINDS,\r\n4:  type BarSize,\r\n5:  type CantileverSlab,\r\n6:  type ColumnSection,\r\n7:  type ColumnPosition,\r\n8:  type GirderPosition,\r\n9:  type GirderSection,\r\n10:  type Member,\r\n11:  type MemberKind,\r\n12:  type Opening,\r\n13:  type Section,\r\n14:  type ShearBarSize,\r\n15:  type SlabPosition,\r\n16:  type WallExtent,\r\n17:} from './member'\r\n18:import { MemberUnsupportedError } from './unsupported'\r\n19:import { coverConditions } from '../rules/lookup'\r\n20:\r\n21:// v2 (2026-08-12): Section에 필수 필드 exposure·finish 추가 — v1 JSON은\r\n22:// deserializeProject의 버전 게이트에서 명시적으로 거부된다 (영속 v1 데이터 없음).\r\n23:// v3 (2026-08-12): GirderSection.stirrup에 필수 필드 startOffsetMm 추가. 規準에\r\n24:// 없는 배치값을 룰팩에 가짜 출처로 넣는 대신 입력으로 받는다 (ADR-012).\r\n25:// v4 (2026-08-12): ColumnSection.hoop에도 같은 이유로 startOffsetMm 추가.\r\n26:// 이 값이 帯筋 本数(=물량)를 좌우하므로 제품 상수로 두지 않는다.\r\n27:// v5 (2026-08-14): Section에 필수 필드 spliceMethod 추가. 継手箇所数와 설계길이\r\n28:// 산입이 방식마다 다른데(積算基準 1通則4)·5)) 규준에 기본 방식이 없으므로\r\n29:// 조용한 기본값 대신 입력으로 받는다.\r\n30:// v6 (2026-08-20): Project에 선택 필드 unitMass 추가. 数量積算基準 1通則 前文은\r\n31:// 質量을 「設計長さ × JIS G 3112 の単位質量」으로 정의할 뿐 값 자체는 JIS에\r\n32:// 위임한다. JIS는 유료 규격이라 확보하지 못했고, 읽지 않은 문헌을 룰팩의\r\n33:// 出典에 세울 수는 없으므로(ADR-003) 값을 입력으로 받는다. 미입력 径은 키가\r\n34:// 없고, 그 径의 kg은 산출하지 않는다.\r\n35:// v7 (2026-08-21): GirderSection에 두 갈래 변경이 함께 들어갔다 — 둘 다\r\n36:// 영속 데이터가 없는 상태에서 같은 판으로 나가므로 버전은 하나다.\r\n37://   ① (M3b) main の topCount·bottomCount を位置別 (端部·中央) の GirderMainRow に\r\n38://      置き換え、カットオフ位置を必須入力にした。積算基準 2（３）梁1) が定めるのは\r\n39://      「梁の全長にわたる主筋」だけで、トップ筋等は設計図書に委ねられる —\r\n40://      位置別本数がないと通し筋とカットオフ筋を分けられない。\r\n41://   ② (M3c) 任意 필드 widthTie·sideBar 추가. 둘 다 「断面一覧에 없으면 그 배근이\r\n42://      없다」를 뜻하는 optional이다 — 있는지 없는지를 제품이 정하지 않는다.\r\n43://      腹筋의 余長은 積算基準 1通則6)이 JASS 5에 위임하는데 그 규격이 미확보라\r\n44://      룰팩 행이 아니라 입력으로 받는다 (R9②).\r\n45:// v8 (2026-08-22): 耐震壁を部材として受け取る。MemberKind に '耐震壁'、Section に\r\n46://   WallSection が加わり、Member.position は大梁と同じ辺の位置を使う。数量積算基準\r\n47://   2（５）壁1)（壁式構造以外）と、躯体の区分（５）壁「柱、梁、床板等に接する垂直材の\r\n48://   内法部分」に対応する — 壁式構造の壁（2）は扱わない (ADR-025)。\r\n49:// v9 (2026-08-22): ColumnSection に必須フィールド shape を追加。円形柱は b・d を\r\n50://   ともに直径にする。数量で形状を見るのは 1通則2)「断面の設計寸法による周長」\r\n51://   だけで、円形断面ではそれが円周になる — 省略可能にすると「記載なし＝矩形」と\r\n52://   いう黙った既定値になるので必須にする (ADR-027)。\r\n53:// v10 (2026-08-22): 床板（スラブ）を部材として受け取る。MemberKind に '床板'、\r\n54://   Section に SlabSection が加わり、Member.position はベイ（通り芯で囲まれた\r\n55://   1区画）の原点側格子点を指す。数量積算基準 2（４）床板 と、躯体の区分（４）\r\n56://   「柱、梁等に接する水平材の内法部分」に対応する (ADR-028)。SlabSection が\r\n57://   exposure を持たないのは表5.3.6 の「スラブ、耐力壁以外の壁」行に屋内・屋外の\r\n58://   区別がないからで、省略ではなく原文の構造である。\r\n59:// v11 (2026-08-22): Member に任意フィールド openings を追加。数量積算基準 1通則8)\r\n60://   「窓、出入口等の開口部による鉄筋の欠除は……建具類等開口部の内法寸法による」\r\n61://   に対応する。断面ではなく部材に付くのは、同じ符号の壁が何枚も建つのに窓は\r\n62://   その1枚に開いているからだ。未指定は「開口なし」で、それが v10 までの JSON の\r\n63://   意味とも一致する — それでも版を上げるのは、開口を受け取れる版とそうでない版で\r\n64://   同じ案件の数量が変わるからである (ADR-029・R14)。\r\n65:export const PROJECT_SCHEMA_VERSION = 11\r\n66:\r\n67:export interface Grid {\r\n68:  xSpans: number[]\r\n69:  ySpans: number[]\r\n70:  /**\r\n71:   * 通り芯의 이름 (「bX1」「Y3」). 伏図에서 읽은 원문 그대로이고 길이는\r\n72:   * spans.length + 1이다. 미지정은 「도면에서 읽은 이름이 없다」는 뜻이며,\r\n73:   * 제품이 index로 이름을 지어내지 않는다 (ADR-004·ADR-030).\r\n74:   *\r\n75:   * schemaVersion을 올리지 않는다 — 이 필드는 数量을 바꾸지 않는다. 版을\r\n76:   * 올리는 기준은 「같은 案件의 数量이 달라지는가」다 (v11 주석 참조).\r\n77:   */\r\n78:  xLabels?: string[]\r\n79:  yLabels?: string[]\r\n80:}\r\n81:\r\n82:/** 라벨 배열이 스팬 수와 맞는가. 어긋나면 어느 축의 이름인지 알 수 없다 */\r\n83:export function isGridLabels(\r\n84:  labels: unknown,\r\n85:  spanCount: number,\r\n86:): labels is string[] {\r\n87:  return (\r\n88:    Array.isArray(labels) &&\r\n89:    labels.length === spanCount + 1 &&\r\n90:    labels.every((label) => typeof label === 'string')\r\n91:  )\r\n92:}\r\n93:\r\n94:export interface Story {\r\n95:  id: string\r\n96:  name: string\r\n97:  height: number\r\n98:}\r\n99:\r\n100:export interface Project {\r\n101:  schemaVersion: number\r\n102:  name: string\r\n103:  grid: Grid\r\n104:  stories: Story[]\r\n105:  sections: Section[]\r\n106:  members: Member[]\r\n107:  /** 내역서 備考. QuantityLine.id를 키로 쓴다. 값이 없는 행은 키 자체가 없다. */\r\n108:  notes?: Record<string, string>\r\n109:  /**\r\n110:   * 径별 単位質量 (kg/m) — 利用者入力. 미입력 径은 키가 없다.\r\n111:   * 규준이 JIS에 위임한 값이라 룰팩이 아니라 프로젝트가 들고 있다.\r\n112:   */\r\n113:  unitMass?: Partial<Record<ShearBarSize, number>>\r\n114:}\r\n115:\r\n116:export function gridPointCount(grid: Grid): { nx: number; ny: number } {\r\n117:  return {\r\n118:    nx: grid.xSpans.length + 1,\r\n119:    ny: grid.ySpans.length + 1,\r\n120:  }\r\n--- src/domain/model/project.ts:1450-3149 ---\r\n1450:  }\r\n1451:  const lastSpan = spans[spans.length - 1]\r\n1452:  const coreLengthMm =\r\n1453:    memberOffsetsMm[memberOffsetsMm.length - 1] + lastSpan.clear\r\n1454:\r\n1455:  return {\r\n1456:    axis: position.axis,\r\n1457:    members,\r\n1458:    ownerId: members[0].id,\r\n1459:    spans,\r\n1460:    memberOffsetsMm,\r\n1461:    coreLengthMm,\r\n1462:  }\r\n1463:}\r\n1464:\r\n1465:/**\r\n1466: * 柱主筋の端部条件 (R7①・R9①)。\r\n1467: *\r\n1468: * 定着(bottom)은 스택의 **최하단**(기초)에만 붙는다. 中間 접합부는 철근이\r\n1469: * 그대로 지나가므로 なし다.\r\n1470: *\r\n1471: * top은 定着을 붙이지 않는다 — 항상 なし(중간 접합부, 위층으로 통과) 아니면\r\n1472: * 先端(스택 최상단, 위에 柱가 없음)이다. 数量積算基準 1通則1)「先端で止まる\r\n1473: * 鉄筋は、コンクリートの設計寸法をその部分の鉄筋の長さとする」＋（２）柱1)\r\n1474: * 但書「最上階柱の主筋については、１通則１）による」가 最上階柱主筋을 명시적으로\r\n1475: * 1通則1)에 걸어두므로, 스택 최상단은 定着 없이 콘크리트 설계 치수까지만\r\n1476: * 간다(R9①). 이전에는 스택 최상단에도 定着을 붙였는데, 이는 조문과 어긋났다.\r\n1477: *\r\n1478: * 접합부의 **継手는 여기서 다루지 않는다.** 数量積算基準 2（２）柱2)가\r\n1479: * 「各階柱の全長にわたる主筋については各階ごとに1か所」로 정하므로 층마다\r\n1480: * 조문대로 1か所이고, 그 배분을 제품이 정할 여지가 없다. 예전에는 접합부의\r\n1481: * 継手를 위층 부재에 귀속시키는 관행을 코드가 들고 있었는데(그래서 최하층은\r\n1482: * 継手가 0이었다), 조문이 그 자리를 대신한다.\r\n1483: *\r\n1484: * 스택 순서는 `stories` 배열 순서를 그대로 신뢰한다 — Story에 레벨 값이 없다.\r\n1485: */\r\n1486:export interface ColumnEnds {\r\n1487:  bottom: '定着' | 'なし'\r\n1488:  top: 'なし' | '先端'\r\n1489:}\r\n1490:\r\n1491:export function columnEnds(project: Project, member: Member): ColumnEnds {\r\n1492:  const { position } = member\r\n1493:\r\n1494:  if (member.kind !== '柱' || !isColumnPosition(position)) {\r\n1495:    throw new Error(`columnEnds requires a 柱: ${member.id}`)\r\n1496:  }\r\n1497:\r\n1498:  const level = project.stories.findIndex(({ id }) => id === member.storyId)\r\n1499:  if (level < 0) {\r\n1500:    throw storyNotFound(member.storyId)\r\n1501:  }\r\n1502:\r\n1503:  const hasColumnAtLevel = (candidateLevel: number): boolean => {\r\n1504:    const story = project.stories[candidateLevel]\r\n1505:    if (story === undefined) return false\r\n1506:\r\n1507:    return project.members.some(\r\n1508:      (candidate) =>\r\n1509:        candidate.kind === '柱' &&\r\n1510:        candidate.storyId === story.id &&\r\n1511:        isColumnPosition(candidate.position) &&\r\n1512:        candidate.position.ix === position.ix &&\r\n1513:        candidate.position.iy === position.iy,\r\n1514:    )\r\n1515:  }\r\n1516:\r\n1517:  return {\r\n1518:    bottom: hasColumnAtLevel(level - 1) ? 'なし' : '定着',\r\n1519:    top: hasColumnAtLevel(level + 1) ? 'なし' : '先端',\r\n1520:  }\r\n1521:}\r\n1522:\r\n1523:export function beamDepthAbove(project: Project, member: Member): number {\r\n1524:  if (member.kind !== '柱' || !isColumnPosition(member.position)) {\r\n1525:    throw new Error(`beamDepthAbove requires a 柱: ${member.id}`)\r\n1526:  }\r\n1527:\r\n1528:  const depths = project.members\r\n1529:    .filter(\r\n1530:      (candidate) =>\r\n1531:        candidate.kind === '大梁' &&\r\n1532:        candidate.storyId === member.storyId &&\r\n1533:        isGirderPosition(candidate.position) &&\r\n1534:        touchesColumn(candidate.position, member.position),\r\n1535:    )\r\n1536:    .map((girder) => {\r\n1537:      const section = findSection(project, girder.sectionId)\r\n1538:      if (section.kind !== '大梁') {\r\n1539:        throw new Error(\r\n1540:          `大梁 member references a non-大梁 section: ${girder.id}`,\r\n1541:        )\r\n1542:      }\r\n1543:      return section.depth\r\n1544:    })\r\n1545:\r\n1546:  if (depths.length === 0) {\r\n1547:    throw new Error(`No touching 大梁 found above 柱: ${member.id}`)\r\n1548:  }\r\n1549:\r\n1550:  return Math.max(...depths)\r\n1551:}\r\n1552:\r\n1553:export function setNote(\r\n1554:  project: Project,\r\n1555:  lineId: string,\r\n1556:  note: string,\r\n1557:): Project {\r\n1558:  const notes = { ...project.notes }\r\n1559:\r\n1560:  if (note === '') delete notes[lineId]\r\n1561:  else notes[lineId] = note\r\n1562:\r\n1563:  return { ...project, notes }\r\n1564:}\r\n1565:\r\n1566:/** 빈 입력은 키를 지운다 — 0 kg/m는 입력이 아니라 없는 값이다. */\r\n1567:export function setUnitMass(\r\n1568:  project: Project,\r\n1569:  size: ShearBarSize,\r\n1570:  value: number | null,\r\n1571:): Project {\r\n1572:  const unitMass = { ...project.unitMass }\r\n1573:\r\n1574:  if (value === null) delete unitMass[size]\r\n1575:  else unitMass[size] = value\r\n1576:\r\n1577:  return { ...project, unitMass }\r\n1578:}\r\n1579:\r\n1580:export function serializeProject(project: Project): string {\r\n1581:  return JSON.stringify(project)\r\n1582:}\r\n1583:\r\n1584:const isString = (value: unknown): boolean => typeof value === 'string'\r\n1585:\r\n1586:const isFiniteNumber = (value: unknown): boolean =>\r\n1587:  typeof value === 'number' && Number.isFinite(value)\r\n1588:\r\n1589:const isPositiveFiniteNumber = (value: unknown): boolean =>\r\n1590:  isFiniteNumber(value) && (value as number) > 0\r\n1591:\r\n1592:function isRecord(value: unknown): value is Record<string, unknown> {\r\n1593:  return typeof value === 'object' && value !== null && !Array.isArray(value)\r\n1594:}\r\n1595:\r\n1596:function hasShape(\r\n1597:  value: unknown,\r\n1598:  fields: Record<string, (field: unknown) => boolean>,\r\n1599:): boolean {\r\n1600:  return (\r\n1601:    isRecord(value) &&\r\n1602:    Object.entries(fields).every(([key, check]) => check(value[key]))\r\n1603:  )\r\n1604:}\r\n1605:\r\n1606:const isNumberArray = (value: unknown): boolean =>\r\n1607:  Array.isArray(value) && value.every(isFiniteNumber)\r\n1608:\r\n1609:/** 呼び名＋本数のような小さな組を検める。 */\r\n1610:const shapedAs =\r\n1611:  (fields: Record<string, (field: unknown) => boolean>) =>\r\n1612:  (value: unknown): boolean =>\r\n1613:    hasShape(value, fields)\r\n1614:\r\n1615:const isMainRow = (value: unknown): boolean => {\r\n1616:  if (\r\n1617:    !hasShape(value, {\r\n1618:      endCount: isFiniteNumber,\r\n1619:      centerCount: isFiniteNumber,\r\n1620:    })\r\n1621:  ) {\r\n1622:    return false\r\n1623:  }\r\n1624:\r\n1625:  const row = value as Record<string, unknown>\r\n1626:  return row.startCount === undefined || isFiniteNumber(row.startCount)\r\n1627:}\r\n1628:\r\n1629:const isAxis = (value: unknown): boolean => value === 'X' || value === 'Y'\r\n1630:\r\n1631:/**\r\n1632: * 種別ごとに、**取り込んだ直後の計算が見守りなしに参照する**場だけを並べる。\r\n1633: *\r\n1634: * ここに無い場 (fc・grade・exposure・spliceMethod など) は、欠けてもルールパック\r\n1635: * 引きが名前のある例外で止める — どこで何が足りないかが画面に出る。\r\n1636: * 選んであるのは TypeError になる場 — それだけが「何が起きたか言えない落ち方」をする。\r\n1637: */\r\n1638:const isBarRow = shapedAs({\r\n1639:  size: isString,\r\n1640:  pitch: isFiniteNumber,\r\n1641:  startOffsetMm: isFiniteNumber,\r\n1642:})\r\n1643:\r\n1644:/**\r\n1645: * 寸法の鍵は種別で違う。柱・大梁は b とせいだが、耐震壁・床板は thickness 一つ\r\n1646: * だ — 躯体の区分が壁を「内法部分」、床板を「内法部分」と定めるので、長さは\r\n1647: * 位置と隣の部材から出て断面には無い (ADR-025・ADR-028)。共通の場所で b を\r\n1648: * 求めると、正しい壁の記録が形違いとして弾かれる。\r\n1649: */\r\n1650:const SECTION_FIELDS: Record<\r\n1651:  MemberKind,\r\n1652:  Record<string, (field: unknown) => boolean>\r\n1653:> = {\r\n1654:  柱: {\r\n1655:    b: isFiniteNumber,\r\n1656:    d: isFiniteNumber,\r\n1657:    main: shapedAs({ size: isString, count: isFiniteNumber }),\r\n1658:    hoop: isBarRow,\r\n1659:  },\r\n1660:  大梁: {\r\n1661:    b: isFiniteNumber,\r\n1662:    depth: isFiniteNumber,\r\n1663:    main: shapedAs({\r\n1664:      size: isString,\r\n1665:      top: isMainRow,\r\n1666:      bottom: isMainRow,\r\n1667:      cutoffFromSupportFaceMm: isFiniteNumber,\r\n1668:    }),\r\n1669:    stirrup: isBarRow,\r\n1670:  },\r\n1671:  耐震壁: {\r\n1672:    thickness: isFiniteNumber,\r\n1673:    // 雑壁 여부는 설계도서에서 사용자가 전사한 구분이다. optional은 기존\r\n1674:    // 레코드의 생략을 耐力壁로 해석하기 위한 것이며, 다른 값을 조용히\r\n1675:    // 통과시키면 cover/lap 분기가 정의되지 않은 채 계산된다 (ADR-036).\r\n1676:    wallClass: (value) =>\r\n1677:      value === undefined || value === '耐力壁' || value === '耐力壁以外',\r\n1678:    // 層数はそのまま本数の倍率だ。欠けると縦筋・横筋の本数が NaN になる。\r\n1679:    layers: isFiniteNumber,\r\n1680:    vertical: isBarRow,\r\n1681:    horizontal: isBarRow,\r\n1682:  },\r\n1683:  床板: {\r\n1684:    thickness: isFiniteNumber,\r\n1685:    x: shapedAs({ top: isBarRow, bottom: isBarRow }),\r\n1686:    y: shapedAs({ top: isBarRow, bottom: isBarRow }),\r\n1687:  },\r\n1688:}\r\n1689:\r\n1690:/**\r\n1691: * 位置の形も種別で違う。床板は格子点ではなく**ベイ**を指すので (ix, iy) と\r\n1692: * (ix+1, iy+1) の両方を引く — 形は柱と同じでも意味が違う。\r\n1693: */\r\n1694:const POSITION_FIELDS: Record<\r\n1695:  MemberKind,\r\n1696:  Record<string, (field: unknown) => boolean>\r\n1697:> = {\r\n1698:  柱: { ix: isFiniteNumber, iy: isFiniteNumber },\r\n1699:  大梁: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\r\n1700:  耐震壁: { axis: isAxis, ix: isFiniteNumber, iy: isFiniteNumber },\r\n1701:  床板: {\r\n1702:    ix: isFiniteNumber,\r\n1703:    iy: isFiniteNumber,\r\n1704:    // 通常の床板はベイ、片持床板は支持辺の GirderPosition を取る。\r\n1705:    axis: (value) => value === undefined || isAxis(value),\r\n1706:  },\r\n1707:}\r\n1708:\r\n1709:const isOpening = shapedAs({\r\n1710:  id: isString,\r\n1711:  xMm: isFiniteNumber,\r\n1712:  yMm: isFiniteNumber,\r\n1713:  widthMm: isFiniteNumber,\r\n1714:  heightMm: isFiniteNumber,\r\n1715:})\r\n1716:\r\n1717:const isBarSize = (value: unknown): value is BarSize =>\r\n1718:  BAR_SIZES.includes(value as BarSize)\r\n1719:\r\n1720:const isPositiveInteger = (value: unknown): boolean =>\r\n1721:  typeof value === 'number' && Number.isInteger(value) && value > 0\r\n1722:\r\n1723:const isNonNegativeFiniteNumber = (value: unknown): boolean =>\r\n1724:  typeof value === 'number' && Number.isFinite(value) && value >= 0\r\n1725:\r\n1726:const isOpeningReinforcement = shapedAs({\r\n1727:  size: isBarSize,\r\n1728:  count: isPositiveInteger,\r\n1729:  // 0 is the persisted 未転記 state. The rebar generators omit it until the\r\n1730:  // design-document transcription supplies a length.\r\n1731:  lengthMm: isNonNegativeFiniteNumber,\r\n1732:})\r\n1733:\r\n1734:const isOpeningWithReinforcements = (value: unknown): boolean => {\r\n1735:  if (!isOpening(value)) return false\r\n1736:\r\n1737:  const reinforcements = (value as { reinforcements?: unknown }).reinforcements\r\n1738:  return (\r\n1739:    reinforcements === undefined ||\r\n1740:    (Array.isArray(reinforcements) &&\r\n1741:      reinforcements.every(isOpeningReinforcement))\r\n1742:  )\r\n1743:}\r\n1744:\r\n1745:const isWallExtent = (value: unknown): value is WallExtent =>\r\n1746:  isRecord(value) &&\r\n1747:  (value.vertical === undefined ||\r\n1748:    hasShape(value.vertical, {\r\n1749:      anchor: (anchor) => anchor === '下端' || anchor === '上端',\r\n1750:      heightMm: isPositiveFiniteNumber,\r\n1751:    })) &&\r\n1752:  (value.horizontal === undefined ||\r\n1753:    hasShape(value.horizontal, {\r\n1754:      anchor: (anchor) => anchor === '始端' || anchor === '終端',\r\n1755:      lengthMm: isPositiveFiniteNumber,\r\n1756:    }))\r\n1757:\r\n1758:const isValidMemberWallExtent = (member: unknown): boolean => {\r\n1759:  if (!isRecord(member)) return false\r\n1760:\r\n1761:  const extent = member.wallExtent\r\n1762:  if (extent === undefined) return true\r\n1763:\r\n1764:  return member.kind === '耐震壁' && isWallExtent(extent)\r\n1765:}\r\n1766:\r\n1767:const isValidMemberCantilever = (member: unknown): boolean => {\r\n1768:  if (!isRecord(member)) return false\r\n1769:\r\n1770:  const position = member.position\r\n1771:  const hasGirderPosition = isRecord(position) && isAxis(position.axis)\r\n1772:  const cantilever = member.cantilever\r\n1773:\r\n1774:  if (cantilever === undefined) {\r\n1775:    // 床板の辺位置は片持条件がないと意味を持たない。ほかの部材の\r\n1776:    // position はこの下の POSITION_FIELDS で別途検める。\r\n1777:    return member.kind !== '床板' || !hasGirderPosition\r\n1778:  }\r\n1779:\r\n1780:  return (\r\n1781:    member.kind === '床板' &&\r\n1782:    hasGirderPosition &&\r\n1783:    isRecord(cantilever) &&\r\n1784:    (cantilever.side === '正' || cantilever.side === '負') &&\r\n1785:    isPositiveFiniteNumber(cantilever.projectionMm)\r\n1786:  )\r\n1787:}\r\n1788:\r\n1789:const isMemberKind = (value: unknown): boolean =>\r\n1790:  MEMBER_KINDS.includes(value as MemberKind)\r\n1791:\r\n1792:/**\r\n1793: * 骨格だけを検める。取り込む案件は他人が作った文字列で、schemaVersion しか\r\n1794: * 見ずに通すと形の違う JSON が Project として奥まで入る — 数量が NaN になるか\r\n1795: * 画面が落ちるかで、どちらも「読み込めなかった」より悪い。\r\n1796: *\r\n1797: * 検めるのは製品がすぐ添字を引く場所 (stories・members・sections・grid) と、\r\n1798: * 内訳書のセルにそのまま出る文字列だけだ。値の妥当性 (径が実在するか、\r\n1799: * 本数が正か) はここでは見ない — それは断面一覧の入力検査の持ち場で、\r\n1800: * ここで二重に持つと規準が二か所に分かれる。\r\n1801: */\r\n1802:/**\r\n1803: * 形だけ通って中身の参照が切れている記録を切る。\r\n1804: *\r\n1805: * ここで見ないと、後から描画の途中で落ちる — useProjectPersistence の\r\n1806: * catch は loadProject が触った所 (最初の柱) しか見ないので、大梁の断面が\r\n1807: * 欠けている記録はそこを素通りして PaneBoundary に出る。\r\n1808: */\r\n1809:interface ReferencedPosition {\r\n1810:  axis?: 'X' | 'Y'\r\n1811:  ix: number\r\n1812:  iy: number\r\n1813:}\r\n1814:\r\n1815:function hasIntactReferences(\r\n1816:  grid: Grid,\r\n1817:  sections: { id: string; kind: MemberKind }[],\r\n1818:  stories: { id: string }[],\r\n1819:  members: {\r\n1820:    kind: MemberKind\r\n1821:    sectionId: string\r\n1822:    storyId: string\r\n1823:    position: ReferencedPosition\r\n1824:    cantilever?: { projectionMm: number }\r\n1825:  }[],\r\n1826:): boolean {\r\n1827:  const sectionKinds = new Map(sections.map(({ id, kind }) => [id, kind]))\r\n1828:  const storyIds = new Set(stories.map(({ id }) => id))\r\n1829:  const { nx, ny } = gridPointCount(grid)\r\n1830:\r\n1831:  // 大梁・耐震壁は隣の交点まで伸びるので、その軸だけ一つ手前までだ。床板は\r\n1832:  // ベイなので両軸とも一つ手前 — slabBay が (ix+1, iy+1) を引く。\r\n1833:  const inGrid = (member: {\r\n1834:    kind: MemberKind\r\n1835:    position: ReferencedPosition\r\n1836:    cantilever?: { projectionMm: number }\r\n1837:  }): boolean => {\r\n1838:    const { kind, position } = member\r\n1839:    const { axis, ix, iy } = position\r\n1840:    // 片持床板の position は支持辺 — 大梁と同じ GirderPosition なので、\r\n1841:    // 一つ手前までなのはその軸だけだ。projection はグリッド座標ではなく\r\n1842:    // mm なので、直交軸は交点そのものでよい（外周の辺がまさにそれである）。\r\n1843:    const isCantilever = kind === '床板' && member.cantilever !== undefined\r\n1844:    const spansX = isCantilever ? axis === 'X' : kind === '床板' || axis === 'X'\r\n1845:    const spansY = isCantilever ? axis === 'Y' : kind === '床板' || axis === 'Y'\r\n1846:\r\n1847:    return (\r\n1848:      Number.isInteger(ix) &&\r\n1849:      Number.isInteger(iy) &&\r\n1850:      ix >= 0 &&\r\n1851:      iy >= 0 &&\r\n1852:      ix < nx - (spansX ? 1 : 0) &&\r\n1853:      iy < ny - (spansY ? 1 : 0)\r\n1854:    )\r\n1855:  }\r\n1856:\r\n1857:  return members.every(\r\n1858:    (member) =>\r\n1859:      // 種別違いも切る。大梁が柱の断面を指すと buildingLayout が投げる。\r\n1860:      sectionKinds.get(member.sectionId) === member.kind &&\r\n1861:      storyIds.has(member.storyId) &&\r\n1862:      // グリッドの外を指す位置は gridPoint が RangeError で投げ、全ペインが落ちる。\r\n1863:      // その案件を自動保存が書くので、次の訪問でも同じ所で落ちる。\r\n1864:      inGrid(member),\r\n1865:  )\r\n1866:}\r\n1867:\r\n1868:function hasGridLabels(grid: unknown): boolean {\r\n1869:  if (!isRecord(grid)) return false\r\n1870:  const { xSpans, ySpans, xLabels, yLabels } = grid\r\n1871:  if (!Array.isArray(xSpans) || !Array.isArray(ySpans)) return false\r\n1872:\r\n1873:  return (\r\n1874:    (xLabels === undefined || isGridLabels(xLabels, xSpans.length)) &&\r\n1875:    (yLabels === undefined || isGridLabels(yLabels, ySpans.length))\r\n1876:  )\r\n1877:}\r\n1878:\r\n1879:function isProjectShape(value: unknown): boolean {\r\n1880:  if (!isRecord(value)) return false\r\n1881:\r\n1882:  const { stories, sections, members, notes, unitMass } = value\r\n1883:\r\n1884:  return (\r\n1885:    isString(value.name) &&\r\n1886:    hasShape(value.grid, { xSpans: isNumberArray, ySpans: isNumberArray }) &&\r\n1887:    // 라벨은 없어도 되지만, 있으면 축의 본수와 맞아야 한다 — 어긋난 배열은\r\n1888:    // 「어느 通り芯의 이름인가」를 잃은 기록이고, 그대로 두면 화면이 엉뚱한\r\n1889:    // 축에 이름을 붙인다\r\n1890:    hasGridLabels(value.grid) &&\r\n1891:    // 空の stories は「階が無い案件」ではなく壊れた記録だ。製品は至る所で\r\n1892:    // stories[0] を既定値に使う。\r\n1893:    Array.isArray(stories) &&\r\n1894:    stories.length > 0 &&\r\n1895:    stories.every((story) =>\r\n1896:      hasShape(story, { id: isString, name: isString, height: isFiniteNumber }),\r\n1897:    ) &&\r\n1898:    Array.isArray(sections) &&\r\n1899:    sections.every(\r\n1900:      (section) =>\r\n1901:        hasShape(section, {\r\n1902:          id: isString,\r\n1903:          // 判別子は特別だ。ここが union の外の値だと、形は通ったまま\r\n1904:          // 断面の枝分かれが選べず、算定の途中で落ちる。\r\n1905:          kind: isMemberKind,\r\n1906:          mark: isString,\r\n1907:        }) &&\r\n1908:        // せいも配筋の入力も種別で鍵が違う。共通の場所だけで済ませると、\r\n1909:        // せい の欠けた断面が通って帯筋の加工寸法が NaN のまま内訳書の合計まで\r\n1910:        // 流れ、main/hoop/stirrup の欠けた断面は generateColumnRebar の中で\r\n1911:        // TypeError になる—どちらもこの関数が止めたかった結果そのものだ。\r\n1912:        // 枝を選べるのは上で判別子を検めてあるからだ。\r\n1913:        hasShape(section, SECTION_FIELDS[(section as Section).kind]),\r\n1914:    ) &&\r\n1915:    Array.isArray(members) &&\r\n1916:    members.every(\r\n1917:      (member) =>\r\n1918:        hasShape(member, {\r\n1919:          id: isString,\r\n1920:          kind: isMemberKind,\r\