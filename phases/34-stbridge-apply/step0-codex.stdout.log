{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nfrom pathlib import Path\nimport json, xml.etree.ElementTree as ET\nroot=Path('.')\n\ndef unique_diffs(values):\n    vals=[]\n    for v in sorted(float(x) for x in values):\n        if not vals or abs(v-vals[-1])>1e-6: vals.append(v)\n    return [round(vals[i+1]-vals[i],6) for i in range(len(vals)-1)]\n\ndef sub(h,n):\n    h=[float(x) for x in h]; n=[float(x) for x in n]\n    return any(all(abs(h[i+j]-n[j])<=1e-5 for j in range(len(n))) for i in range(len(h)-len(n)+1))\n\ndef doc_values(d): return {c: unique_diffs(n[c] for n in d['nodes']) for c in ('x','y')}\ndef xml_values(p):\n    raw=p.read_bytes(); txt=None\n    for enc in ('utf-8','cp932'):\n        try: txt=raw.decode(enc); break\n        except UnicodeDecodeError: pass\n    r=ET.fromstring(txt)\n    return {c: unique_diffs(float(e.attrib[c.upper()]) for e in r.iter() if e.tag.rsplit('}',1)[-1]=='StbNode') for c in ('x','y')}\n\nout=[]\nfor ep in sorted((root/'tests/fixtures/stb-import/expected').glob('*.json')):\n    e=json.loads(ep.read_text(encoding='utf-8')); name=ep.stem+'.stb'\n    d=json.loads((root/'tests/fixtures/stb-import/document'/ep.name).read_text(encoding='utf-8'))\n    dv=doc_values(d)\n    item={'file':name,'document':{},'original':{}}\n    for g in e.get('grids',[]):\n        direction=g['direction']; c=direction.lower(); other='y' if c=='x' else 'x'; spans=g['spansMm']\n        item['document'][direction]={'spans':spans,'on_measured_axis':sub(dv[c],spans),'on_opposite_axis':sub(dv[other],spans)}\n    cp=root/'.cache/stb'/name\n    if cp.exists():\n        ov=xml_values(cp)\n        for g in e.get('grids',[]):\n            direction=g['direction']; c=direction.lower(); other='y' if c=='x' else 'x'; spans=g['spansMm']\n            item['original'][direction]={'on_measured_axis':sub(ov[c],spans),'on_opposite_axis':sub(ov[other],spans)}\n    out.append(item)\nprint(json.dumps(out,ensure_ascii=False,indent=2))\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
