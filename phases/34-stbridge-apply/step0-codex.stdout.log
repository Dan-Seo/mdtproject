{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nfrom pathlib import Path\nimport json, xml.etree.ElementTree as ET\n\nroot = Path('.')\nexp_dir = root / 'tests/fixtures/stb-import/expected'\ndoc_dir = root / 'tests/fixtures/stb-import/document'\nphase = json.loads((root / 'phases/33-stbridge-skeleton-import/step0-report.json').read_text(encoding='utf-8'))\nphase_stories = {entry['file']: entry for entry in phase.get('stories', [])}\nphase_axes = {entry['file']: entry for entry in phase.get('axes', [])}\n\n\ndef diffs(values):\n    unique = []\n    for value in sorted(float(v) for v in values):\n        if not unique or abs(value - unique[-1]) > 1e-6:\n            unique.append(value)\n    return [round(unique[i+1] - unique[i], 6) for i in range(len(unique)-1)]\n\n\ndef contains_subsequence(haystack, needle):\n    h = [round(float(v), 6) for v in haystack]\n    n = [round(float(v), 6) for v in needle]\n    for i in range(len(h)-len(n)+1):\n        if all(abs(h[i+j]-n[j]) <= 1e-5 for j in range(len(n))):\n            return True\n    return False\n\n\ndef document_axis_audit(doc):\n    out = {}\n    for direction, coordinate in [('X', 'x'), ('Y', 'y')]:\n        out[direction] = {\n            'coordinate': coordinate,\n            'unique_coordinates': sorted({float(node[coordinate]) for node in doc['nodes']}),\n            'adjacent_diffs': diffs(node[coordinate] for node in doc['nodes']),\n        }\n    return out\n\n\ndef xml_axis_audit(path):\n    data = path.read_bytes()\n    root_xml = ET.fromstring(data)\n    nodes = {}\n    groups = []\n    for element in root_xml.iter():\n        if element.tag.rsplit('}', 1)[-1] == 'StbNode':\n            nodes[element.attrib['id']] = {k.lower(): float(element.attrib[k]) for k in ('X','Y','Z')}\n    for group in root_xml.iter():\n        if group.tag.rsplit('}', 1)[-1] \"'!= '\"'StbParallelAxes':\n            continue\n        angle = float(group.attrib.get('angle', 'nan'))\n        coordinate = 'y' if angle % 180 == 0 else 'x' if angle % 180 == 90 else None\n        axes = []\n        for axis in group:\n            if axis.tag.rsplit('}', 1)[-1] \"'!= '\"'StbParallelAxis':\n                continue\n            ids = [node.attrib['id'] for node in axis.iter() if node.tag.rsplit('}', 1)[-1] == 'StbNodeId']\n            axes.append({\n                'name': axis.attrib.get('name'),\n                'distance': float(axis.attrib['distance']),\n                'node_coordinates': [nodes[node_id] for node_id in ids],\n            })\n        groups.append({'group_name': group.attrib.get('group_name'), 'angle': angle, 'coordinate': coordinate, 'axes': axes})\n    return groups\n\nresults = {'height': [], 'labels': [], 'directions': [], 'originals': []}\nfor path in sorted(exp_dir.glob('*.json')):\n    expected = json.loads(path.read_text(encoding='utf-8'))\n    file = path.stem + '.stb'\n    stories = expected.get('stories', [])\n    if stories:\n        phase_entry = phase_stories.get(file)\n        if phase_entry is None:\n            results['height'].append({'file': file, 'excluded': True, 'reason': 'expected stories is non-empty but phase33 report has no same-file stories entry'})\n        else:\n            expected_heights = [float(s['heightMm']) for s in stories]\n            actual_diffs = [float(v) for v in phase_entry['adjacent_diffs']]\n            levels_count = len(phase_entry['levels'])\n            results['height'].append({\n                'file': file,\n                'expected_heightMm': expected_heights,\n                'phase33_adjacent_diffs': actual_diffs,\n                'heights_match': expected_heights == actual_diffs,\n                'story_count': len(stories),\n                'levels_minus_one': levels_count - 1,\n                'count_matches': len(stories) == levels_count - 1,\n                'all_positive': all(value > 0 for value in expected_heights),\n            })\n    for grid in expected.get('grids', []):\n        axes = grid.get('axes', [])\n        spans = grid.get('spansMm', [])\n        results['labels'].append({\n            'file': file,\n            'direction': grid.get('direction'),\n            'axis_count': len(axes),\n            'span_count': len(spans),\n            'arity_ok': len(axes) == len(spans) + 1,\n            'labels': [axis.get('label') for axis in axes],\n            'spansMm': spans,\n        })\n    doc = json.loads((doc_dir / path.name).read_text(encoding='utf-8'))\n    doc_audit = document_axis_audit(doc)\n    for grid in expected.get('grids', []):\n        direction = grid['direction']\n        spans = grid.get('spansMm', [])\n        coordinate = 'x' if direction == 'X' else 'y'\n        results['directions'].append({\n            'file': file,\n            'direction': direction,\n            'measured_coordinate': coordinate,\n            'spansMm': spans,\n            'document_adjacent_diffs': doc_audit[direction]['adjacent_diffs'],\n            'measured_axis_subsequence': contains_subsequence(doc_audit[direction]['adjacent_diffs'], spans),\n            'opposite_axis_subsequence': contains_subsequence(doc_audit['Y' if direction == 'X' else 'X']['adjacent_diffs'], spans),\n        })\n    cache = root / '.cache/stb' / file\n    if cache.exists():\n        results['originals'].append({'file': file, 'source': str(cache), 'axes': xml_axis_audit(cache)})\n\nprint(json.dumps(results, ensure_ascii=False, indent=2))\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
