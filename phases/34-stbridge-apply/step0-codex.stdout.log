ring\r\n97:  height: number\r\n98:}\r\n99:\r\n100:export interface Project {\r\n101:  schemaVersion: number\r\n102:  name: string\r\n103:  grid: Grid\r\n104:  stories: Story[]\r\n105:  sections: Section[]\r\n106:  members: Member[]\r\n107:  /** ?댁뿭???숃? QuantityLine.id瑜??ㅻ줈 ?대떎. 媛믪씠 ?녿뒗 ?됱? ???먯껜媛 ?녿떎. */\r\n108:  notes?: Record<string, string>\r\n109:  /**\r\n110:   * 孃꾨퀎 ?섆퐤蘊ら뇧 (kg/m) ???⑴뵪?끻뀯?? 誘몄엯??孃꾩? ?ㅺ? ?녿떎.\r\n111:   * 洹쒖???JIS???꾩엫??媛믪씠??猷고뙥???꾨땲???꾨줈?앺듃媛 ?ㅺ퀬 ?덈떎.\r\n112:   */\r\n113:  unitMass?: Partial<Record<ShearBarSize, number>>\r\n114:}\r\n115:\r\n116:export function gridPointCount(grid: Grid): { nx: number; ny: number } {\r\n117:  return {\r\n118:    nx: grid.xSpans.length + 1,\r\n119:    ny: grid.ySpans.length + 1,\r\n120:  }\r\n121:}\r\n122:\r\n123:export function gridPoint(\r\n124:  grid: Grid,\r\n125:  ix: number,\r\n126:  iy: number,\r\n127:): { x: number; y: number } {\r\n128:  const { nx, ny } = gridPointCount(grid)\r\n129:\r\n130:  if (\r\n131:    !Number.isInteger(ix) ||\r\n132:    !Number.isInteger(iy) ||\r\n133:    ix < 0 ||\r\n134:    ix >= nx ||\r\n135:    iy < 0 ||\r\n136:    iy >= ny\r\n137:  ) {\r\n138:    throw new RangeError(`Grid point index out of range: (${ix}, ${iy})`)\r\n139:  }\r\n140:\r\n141:  return {\r\n142:    x: grid.xSpans.slice(0, ix).reduce((sum, span) => sum + span, 0),\r\n143:    y: grid.ySpans.slice(0, iy).reduce((sum, span) => sum + span, 0),\r\n144:  }\r\n145:}\r\n146:\r\n147:/**\r\n148: * storyId??\"1F\" 媛숈? letter+digit ?쇰꺼?대씪 猷고뙥 ?곸닔(D25 ??? 媛믪쓽\r\n149: * 紐⑥뼇留뚯쑝濡?援щ텇?섏? ?딅뒗????telemetry.ts???ㅽ겕?щ쾭??letter+digit\r\n150: * ?좏겙???듭㎏濡??④린誘濡? 洹몃깷 蹂닿컙?섎㈃ ???쇰꺼??洹몃?濡??덉뼱 ?섍컙??9李?\r\n151: * 由щ럭 critical). JSON 釉붾줉?쇰줈 媛먯떥硫??ㅽ겕?щ쾭??`{...}` 洹쒖튃??嫄몃┛??\r\n152: * ???щ㎎???⑥닔 ?섎굹濡?怨좎젙???ㅼ쓬 ?몄텧遺媛 洹쒖빟???먯쑝濡??ㅼ떆 踰좊겮吏\r\n153: * ?딄쾶 ?쒕떎(9李?由щ럭 minor).\r\n154: */\r\n155:export function storyNotFound(storyId: string): Error {\r\n156:  return new Error(`Story not found: ${JSON.stringify({ storyId })}`)\r\n157:}\r\n158:\r\n159:/** 痢?諛붾떏???꾩쟻 ?쒓퀬(mm). stories 諛곗뿴 ?쒖꽌?濡??꾨옒痢?height瑜??꾩쟻?쒕떎. */\r\n160:export function storyElevation(stories: Story[], storyId: string): number {\r\n161:  const index = stories.findIndex(({ id }) => id === storyId)\r\n162:\r\n163:  if (index < 0) {\r\n164:    throw storyNotFound(storyId)\r\n165:  }\r\n166:\r\n167:  return stories.slice(0, index).reduce((sum, story) => sum + story.height, 0)\r\n168:}\r\n169:\r\n170:export function findSection(project: Project, sectionId: string): Section {\r\n171:  const section = project.sections.find(({ id }) => id === sectionId)\r\n172:\r\n173:  if (!section) {\r\n174:    throw new Error(`Section not found: ${sectionId}`)\r\n175:  }\r\n176:\r\n177:  return section\r\n178:}\r\n179:\r\n180:export function memberGroupKey(project: Project, member: Member): string {\r\n181:  const story = project.stories.find(({ id }) => id === member.storyId)\r\n182:  if (!story) {\r\n183:    throw storyNotFound(member.storyId)\r\n184:  }\r\n185:\r\n186:  const section = findSection(project, member.sectionId)\r\n187:  if (section.kind !== member.kind) {\r\n188:    throw new Error(\r\n189:      `Member and section kinds do not match: ${member.id} (${member.kind}/${section.kind})`,\r\n190:    )\r\n191:  }\r\n192:\r\n193:  const memberCode = MEMBER_GROUP_CODE[member.kind]\r\n194:  return `${story.name}|${memberCode}|${section.mark}`\r\n195:}\r\n196:\r\n197:/** ?낁㉢?멥겗?겹꺂?쇈깤?듐겓鵝욍걝?ⓩ쓲?녈꺖?됥귞Е??mark)?③쉸??뼋?ユ뙚?얇굥訝?뉐춻??*/\r\n198:const MEMBER_GROUP_CODE: Record<Member['kind'], string> = {\r\n199:  ?? 'C',\r\n200:  鸚㎪쥈: 'G',\r\n201:  ?먬쐡鶯? 'W',\r\n202:  佯딀씮: 'S',\r\n203:}\r\n204:\r\n205:function isColumnPosition(\r\n206:  position: ColumnPosition | GirderPosition,\r\n207:): position is ColumnPosition {\r\n208:  return !('axis' in position)\r\n209:}\r\n210:\r\n211:function isGirderPosition(\r\n212:  position: ColumnPosition | GirderPosition,\r\n213:): position is GirderPosition {\r\n214:  return 'axis' in position\r\n215:}\r\n216:\r\n217:function isGridEdgePosition(\r\n218:  grid: Grid,\r\n219:  position: GirderPosition,\r\n220:): boolean {\r\n221:  const { nx, ny } = gridPointCount(grid)\r\n222:\r\n223:  if (position.axis !== 'X' && position.axis !== 'Y') return false\r\n224:\r\n225:  return (\r\n226:    Number.isInteger(position.ix) &&\r\n227:    Number.isInteger(position.iy) &&\r\n228:    position.ix >= 0 &&\r\n229:    position.iy >= 0 &&\r\n230:    (position.axis === 'X'\r\n231:      ? position.ix < nx - 1 && position.iy < ny\r\n232:      : position.ix < nx && position.iy < ny - 1)\r\n233:  )\r\n234:}\r\n235:\r\n236:function columnAt(\r\n237:  project: Project,\r\n238:  storyId: string,\r\n239:  ix: number,\r\n240:  iy: number,\r\n241:): Member | undefined {\r\n242:  return project.members.find(\r\n243:    (candidate) =>\r\n244:      candidate.kind === '?? &&\r\n245:      candidate.storyId === storyId &&\r\n246:      isColumnPosition(candidate.position) &&\r\n247:      candidate.position.ix === ix &&\r\n248:      candidate.position.iy === iy,\r\n249:  )\r\n250:}\r\n251:\r\n252:function girderAt(\r\n253:  project: Project,\r\n254:  storyId: string,\r\n255:  position: GirderPosition,\r\n256:): Member | undefined {\r\n257:  return project.members.find(\r\n258:    (candidate) =>\r\n259:      candidate.kind === '鸚㎪쥈' &&\r\n260:      candidate.storyId === storyId &&\r\n261:      isGirderPosition(candidate.position) &&\r\n262:      candidate.position.axis === position.axis &&\r\n263:      candidate.position.ix === position.ix &&\r\n264:      candidate.position.iy === position.iy,\r\n265:  )\r\n266:}\r\n267:\r\n268:function sectionHasKind(\r\n269:  project: Project,\r\n270:  member: Member | undefined,\r\n271:  kind: MemberKind,\r\n272:): boolean {\r\n273:  if (member === undefined) return false\r\n274:  return project.sections.some(\r\n275:    (section) => section.id === member.sectionId && section.kind === kind,\r\n276:  )\r\n277:}\r\n278:\r\n279:/**\r\n280: * 鶯곥굮營?걚?잆겏?띲겓 wallSpan ?뚦냵力뺛굮黎뷩굙?됥굦?뗣걢?믣닩若싥걲?뗣?\r\n--- src/l