n        \\\"kind\\\": \\\"ON_GRID\\\"\\n      },\\n      {\\n        \\\"id\\\": \\\"69\\\",\\n        \\\"x\\\": 3500,\\n        \\\"y\\\": 20200,\\n        \\\"z\\\": 12700,\\n        \\\"kind\\\": \\\"ON_GRID\\\"\\n      },\\n      {\\n        \\\"id\\\": \\\"73\\\",\\n        \\\"x\\\": 3500,\\n        \\\"y\\\": 13800,\\n        \\\"z\\\": 16500,\\n        \\\"kind\\\": \\\"ON_GRID\\\"\\n      },\\n      {\\n        \\\"id\\\": \\\"75\\\",\\n        \\\"x\\\": 3500,\\n        \\\"y\\\": 20200,\\n        \\\"z\\\": 16500,\\n        \\\"kind\\\": \\\"ON_GRID\\\"\\n      }\\n    ]\\n  }\\n]\\n{\\n  \\\"real_decode\\\": [\\n    {\\n      \\\"file\\\": \\\"dotnet-sample1.stb\\\",\\n      \\\"encoding\\\": \\\"utf-8\\\",\\n      \\\"replacement_chars\\\": 1,\\n      \\\"skipped\\\": false,\\n      \\\"sha256_verified\\\": true\\n    },\\n    {\\n      \\\"file\\\": \\\"diffchecker-filea.stb\\\",\\n      \\\"encoding\\\": \\\"shift_jis\\\",\\n      \\\"replacement_chars\\\": 0,\\n      \\\"skipped\\\": false,\\n      \\\"sha256_verified\\\": true\\n    },\\n    {\\n      \\\"file\\\": \\\"hoaryfox-sample.stb\\\",\\n      \\\"encoding\\\": \\\"utf-8\\\",\\n      \\\"replacement_chars\\\": 0,\\n      \\\"skipped\\\": false,\\n      \\\"sha256_verified\\\": true\\n    },\\n    {\\n      \\\"file\\\": \\\"diffchecker-mini210.stb\\\",\\n      \\\"encoding\\\": \\\"utf-8\\\",\\n      \\\"replacement_chars\\\": 0,\\n      \\\"skipped\\\": false,\\n      \\\"sha256_verified\\\": true\\n    }\\n  ],\\n  \\\"cache_absent_run\\\": {\\n    \\\"command\\\": \\\"npm test -- --reporter=verbose\\\",\\n    \\\"passed\\\": true,\\n    \\\"test_files_passed\\\": 88,\\n    \\\"test_files_skipped\\\": 1,\\n    \\\"tests_passed\\\": 1615,\\n    \\\"tests_skipped\\\": 4,\\n    \\\"skipped_test_names\\\": [\\n      \\\"real-decode: .cache/stb の実物 .stb（ローカル限定） > diffchecker-filea.stb uses declared Shift_JIS without replacement characters\\\",\\n      \\\"real-decode: .cache/stb の実物 .stb（ローカル