사람이 고른다.\r\n34:   * undefined는 「고르지 않았다」이지 「storyLabel이 없는 断面」이 아니다.\r\n35:   */\r\n36:  sectionStoryLabel?: string\r\n37:  /**\r\n38:   * 通り芯이 바뀔 때 다른 층의 부재를 버리고 진행한다. 기본은 false이고,\r\n39:   * 화면은 거부를 한 번 보여준 뒤에만 이 선택지를 낸다 — 조용한 기본값으로\r\n40:   * 두면 사용자가 모르는 사이에 다른 층이 사라진다\r\n41:   */\r\n42:  discardOtherStories?: boolean\r\n43:}\r\n44:\r\n45:export interface PlanApplyResult {\r\n46:  project: Project\r\n47:  /** 반영한 부재 수 */\r\n48:  applied: number\r\n49:  /** 반영하지 못한 부호와 사유 — 원문 순, 같은 부호가 여러 번 걸리면 여러 번 */\r\n50:  skipped: Array<{ mark: string; reason: PlanApplySkip }>\r\n51:  /** 통째로 거부한 사유. 있으면 project는 손대지 않은 원본 그대로다 */\r\n52:  refusal?: PlanApplyRefusal\r\n53:}\r\n54:\r\n55:function gridOf(block: PlanBlock): Grid {\r\n56:  const { xGrid, yGrid } = block\r\n57:  return {\r\n58:    xSpans: [...xGrid.spansMm],\r\n59:    ySpans: [...yGrid.spansMm],\r\n60:    // 通り芯의 이름은 도면에 있는 것이고, 이것이 있어야 「Y3端／Y4端」처럼\r\n61:    // 좌우가 다른 断面リスト를 런의 실제 방향과 맞출 수 있다 (R13의 선결 조건)\r\n62:    xLabels: xGrid.axes.map((axis) => axis.label),\r\n63:    yLabels: yGrid.axes.map((axis) => axis.label),\r\n64:  }\r\n65:}\r\n66:\r\n67:/**\r\n68: * 스팬만 본다 — 라벨은 数量도 격자 index도 바꾸지 않으므로, 이름만 달라진\r\n69: * 그리드를 「바뀌었다」로 보면 다른 층의 부재를 버리라는 물음이 이유 없이 뜬다.\r\n70: */\r\n71:function sameGrid(left: Grid, right: Grid): boolean {\r\n72:  return (\r\n73:    left.xSpans.length === right.xSpans.length &&\r\n74:    left.ySpans.length === right.ySpans.length &&\r\n75:    left.xSpans.every((span, i) => span === right.xSpans[i]) &&\r\n76:    left.ySpans.every((span, i) => span === right.ySpans[i])\r\n77:  )\r\n78:}\r\n79:\r\n80:function positionOf(placement: MemberPlacement) {\r\n81:  return placement.role === '辺'\r\n82:    ? { axis: placement.axis, ix: placement.ix, iy: placement.iy }\r\n83:    : { ix: placement.ix, iy: placement.iy }\r\n84:}\r\n85:\r\n86:/**\r\n87: * 배치가 격자 안을 가리키는가. 辺은 부재가 뻗는 쪽으로 한 칸 더 필요하고,\r\n88: * ベイ는 원점 쪽 격자점이므로 양쪽으로 한 칸씩 남아야 한다.\r\n89: */\r\n90:function withinGrid(placement: MemberPlacement, grid: Grid): boolean {\r\n91:  const nx = grid.xSpans.length + 1\r\n92:  const ny = grid.ySpans.length + 1\r\n93:  const lastIx =\r\n94:    placement.role === 'ベイ' || (placement.role === '辺' && placement.axis === 'X')\r\n95:      ? nx - 2\r\n96:      : nx - 1\r\n97:  const lastIy =\r\n98:    placement.role === 'ベイ' || (placement.role === '辺' && placement.axis === 'Y')\r\n99:      ? ny - 2\r\n100:      : ny - 1\r\n101:\r\n102:  return (\r\n103:    placement.ix >= 0 &&\r\n104:    placement.ix <= lastIx &&\r\n105:    placement.iy >= 0 &&\r\n106:    placement.iy <= lastIy\r\n107:  )\r\n108:}\r\n109:\r\n110:export function applyFramingPlan(\r\n111:  project: Project,\r\n112:  {\r\n113:    block,\r\n114:    storyId,\r\n115:    sectionStoryLabel,\r\n116:    discardOtherStories = false,\r\n117:  }: PlanApplyOptions,\r\n118:): PlanApplyResult {\r\n119:  if (!project.stories.some((story) => story.id === storyId)) {\r\n120:    return { project, applied: 0, skipped: [], refusal: '階未指定' }\r\n121:  }\r\n122:\r\n123:  const grid = gridOf(block)\r\n124:  const changesGrid = !sameGrid(project.grid, grid)\r\n125:  const otherStoryMembers = project.members.some(\r\n126:    (member) => member.storyId !== storyId,\r\n127:  )\r\n128:  // 격자 index는 스팬 배열에 매여 있다 — 스팬을 바꾸면 손대지 않은 층의 부재가\r\n129:  // 조용히 다른 자리로 옮겨간다. 부분 반영으로 넘어가면 「틀린 채로 완성된 것」이\r\n130:  // 되므로 통째로 거부하고, 어느 쪽을 버릴지는 사용자가 정한다\r\n131:  if (changesGrid && otherStoryMembers && !discardOtherStories) {\r\n132:    return {\r\n133:      project,\r\n134:      applied: 0,\r\n135:      skipped: [],\r\n136:      refusal: '他階部材あり通り芯変更不可',\r\n137:    }\r\n138:  }\r\n139:\r\n140:  const sections = new Map<string, Section[]>()\r\n141:  for (const section of project.sections) {\r\n142:    const candidates = sections.get(section.mark)\r\n143:    if (candidates) candidates.push(section)\r\n144:    else sections.set(section.mark, [section])\r\n145:  }\r\n146:\r\n147:  const members: Member[] = []\r\n148:  const skipped: PlanApplyResult['skipped'] = []\r\n149:  for (const placement of block.placements) {\r\n150:    const allCandidates = sections.get(placement.mark) ?? []\r\n151:    const candidates =\r\n152:      sectionStoryLabel === undefined\r\n153:        ? allCandidates\r\n154:        : (() => {\r\n155:            const labeled = allCandidates.filter(\r\n156:              (section) => section.storyLabel === sectionStoryLabel,\r\n157:            )\r\n158:            return labeled.length > 0\r\n159:              ? labeled\r\n160:              : allCandidates.filter((section) => section.storyLabel === undefined)\r\n161:          })()\r\n162:    if (candidates.length === 0) {\r\n163:      skipped.push({ mark: placement.mark, reason: '断面未登録' })\r\n164:      continue\r\n165:    }\r\n166:    if (candidates.length > 1) {\r\n167:      skipped.push({ mark: placement.mark, reason: '断面複数該当' })\r\n168:      continue\r\n169:    }\r\n170:    const section = candidates[0]\r\n171:    if (ROLE_FOR_KIND[section.kind] !== placement.role) {\r\n172:      skipped.push({ mark: placement.mark, reason: '部材種別相違' })\r\n173:      continue\r\n174:    }\r\n175:    if (!withinGrid(placement, grid)) {\r\n176:      skipped.push({ mark: placement.mark, reason: '格子外' })\r\n177:      continue\r\n178:    }\r\n179:\r\n180:    members.push({\r\n181:      // id는 사람이 읽는 값이 아니라 충돌만 피하면 된다. 같은 자리에 같은 符号을\r\n182:      // 두 번 반영해도 하나로 접히도록 자리를 id에 넣는다\r\n183:      id: `${storyId}-${placement.mark}-${placement.ix}-${placement.iy}${placement.role === '辺' ? `-${placement.axis}` : ''}`,\r\n184:      kind: section.kind,\r\n185:      memberClass: '躯体',\r\n186:      sectionId: section.id,\r\n187:      storyId,\r\n188:      position: positionOf(placement),\r\n189:    })\r\n190:  }\r\n191:\r\n192:  const deduped = new Map<string, Member>()\r\n193:  for (const member of members) deduped.set(member.id, member)\r\n194:\r\n195:  return {\r\n196:    project: {\r\n197:      ...project,\r\n198:      grid,\r\n199:      // 취입하는 층은 갈아 끼운다 — 두 번 눌러도 겹치지 않아야 하고, 도면에서\r\n200:      // 사라진 부재가 案件에 남아 있으면 그것도 「틀린 채로 완성된 것」이다\r\n201:      members: [\r\n202:        // 통り芯이 바뀌면 남은 부재의 index가 다른 자리를 가리키게 되므로,\r\n203:        // 동의를 받았을 때는 남기지 않고 전부 버린다 — 반쯤 옮겨 놓느니 비운다\r\n204:        ...(changesGrid && discardOtherStories\r\n205:          ? []\r\n206:          : project.members.filter((member) => member.storyId !== storyId)),\r\n207:        ...deduped.values(),\r\n208:      ],\r\n209:    },\r\n210:    applied: deduped.size,\r\n211:    skipped,\r\n212:  }\r\n213:}\r\n214:\r\n215:export interface ElevationApplyOptions {\r\n216:  candidate: ElevationCandidate\r\n217:  /**\r\n218:   * 階의 경계로 쓸 레벨의 범위. index는 **도면 순서**(위에서 아래)다.\r\n219:   * 위 끝(top)이 최상階의 천장, 아래 끝(bottom)이 최하階의 바닥이 된다 —\r\n220:   * パラペット 천단이나 基礎下端처럼 階가 아닌 레벨은 범위 밖에 둔다.\r\n221:   */\r\n222:  topLevelIndex: number\r\n223:  bottomLevelIndex: number\r\n224:  /** 階를 갈면 부재가 갈 곳을 잃는다. 화면은 거부를 보여준 뒤에만 이 선택지를 낸다 */\r\n225:  discardMembers?: boolean\r\n226:}\r\n227:\r\n228:export interface ElevationApplyResult {\r\n229:  project: Project\r\n230:  /** 만든 階 수 */\r\n231:  applied: number\r\n232:  refusal?: ElevationApplyRefusal\r\n233:}\r\n234:\r\n235:/**\r\n236: * 軸組図에서 읽은 높이를 案件의 階로 반영한다 (ADR-030).\r\n237: *\r\n238: * 「어느 레벨이 階의 경계인가」는 파서가 정하지 않으므로(FL·GL·基礎下端·RCL이\r\n239: * 섞여 있다) 여기서 사용자의 선택을 받는다. 階의 이름도 지어내지 않고 그 階의\r\n240: * **바닥이 되는 레벨의 원문**을 그대로 쓴다 — 같은 높이에 라벨이 둘이면 둘 다\r\n241: * 남긴다(실물의 「中央棟1FL」과 「基準GL」이 그렇다).\r\n242: */\r\n243:export function applyElevation(\r\n244:  project: Project,\r\n245:  {\r\n246:    candidate,\r\n247:    topLevelIndex,\r\n248:    bottomLevelIndex,\r\n249:    discardMembers = false,\r\n250:  }: ElevationApplyOptions,\r\n251:): ElevationApplyResult {\r\n252:  const valid =\r\n253:    Number.isInteger(topLevelIndex) &&\r\n254:    Number.isInteger(bottomLevelIndex) &&\r\n255:    topLevelIndex >= 0 &&\r\n256:    bottomLevelIndex > topLevelIndex &&\r\n257:    bottomLevelIndex < candidate.levels.length\r\n258:  if (!valid) {\r\n259:    return { project, applied: 0, refusal: '階範囲不正' }\r\n260:  }\r\n261:\r\n262:  // 階를 갈면 부재의 storyId가 가리키던 階가 사라진다. 부분 반영으로 넘어가면\r\n263:  // 「틀린 채로 완성된 것」이 되므로 통째로 거부하고, 사용자가 정한다\r\n264:  if (project.members.length > 0 && !discardMembers) {\r\n265:    return { project, applied: 0, refusal: '部材あり階置換不可' }\r\n266:  }\r\n267:\r\n268:  const stories: Story[] = []\r\n269:  // 도면은 위에서 아래, `Project.stories`는 아래에서 위다 (columnEnds가\r\n270:  // stories[level - 1]을 「아래 階」로 읽는다)\r\n271:  for (let i = bottomLevelIndex - 1; i >= topLevelIndex; i--) {\r\n272:    const floor = candidate.levels[i + 1]\r\n273:    const name =\r\n274:      floor.labels.length > 0\r\n275:        ? floor.labels.join('／')\r\n276:        : `${bottomLevelIndex - i}`\r\n277:    stories.push({\r\n278:      id: `story-${bottomLevelIndex - i}`,\r\n279:      name,\r\n280:      height: candidate.heightsMm[i],\r\n281:    })\r\n282:  }\r\n283:\r\n284:  return {\r\n285:    project: { ...project, stories, members: [] },\r\n286:    applied: stories.length,\r\n287:  }\r\n288:}\r\n--- src/lib/import/framing-plan/apply.test.ts:1-420 ---\r\n1:import { describe, expect, it } from 'vitest'\r\n2:\r\n3:import type { Section } from '@/domain/model/member'\r\n4:import type { Project } from '@/domain/model/project'\r\n5:import { createSampleProject } from '@/domain/model/sample-project'\r\n6:\r\n7:import type { TextItem } from '../types'\r\n8:import type { TextPage } from '../section-list/types'\r\n9:\r\n10:import { applyElevation, applyFramingPlan } from './apply'\r\n11:import { parseFramingPlan } from './parse'\r\n12:import type {\r\n13:  ElevationCandidate,\r\n14:  PlanBlock,\r\n15:  PlanGridCandidate,\r\n16:} from './types'\r\n17:\r\n18:// 断面은 손으로 짓지 않고 샘플 案件에서 빌린다 — 손으로 지으면 스키마가 자라날 때\r\n19:// 이 테스트만 옛 모양으로 남고, 그 사실을 vitest는 알려주지 않는다 (tsc가 잡는다)\r\n20:const sample = createSampleProject()\r\n21:\r\n22:function sectionOf(kind: Section['kind'], mark: string): Section {\r\n23:  const source = sample.sections.find((section) => section.kind === kind)\r\n24:  if (!source) throw new Error(`sample has no ${kind} section`)\r\n25:  return { ...source, id: `sec-${mark}`, mark }\r\n26:}\r\n27:\r\n28:function sectionWithStory(\r\n29:  kind: Section['kind'],\r\n30:  mark: string,\r\n31:  storyLabel: string | undefined,\r\n32:  id = `sec-${mark}-${storyLabel ?? 'none'}`,\r\n33:): Section {\r\n34:  return { ...sectionOf(kind, mark), id, storyLabel }\r\n35:}\r\n36:\r\n37:const columnSection = (mark: string) => sectionOf('柱', mark)\r\n38:const girderSection = (mark: string) => sectionOf('大梁', mark)\r\n39:\r\n40:function h(str: string, x: number, y: number): TextItem {\r\n41:  return { str, x, y, w: 0, h: 8 }\r\n42:}\r\n43:\r\n44:function v(str: string, x: number, y: number): TextItem {\r\n45:  return { str, x, y, w: 8, h: 0, rot: -90 }\r\n46:}\r\n47:\r\n48:function framingItems(\r\n49:  xSpanMm: number,\r\n50:  ySpanMm: number,\r\n51:  xOffsetPt = 0,\r\n52:): TextItem[] {\r\n53:  return [\r\n54:    h('X1', xOffsetPt, -40),\r\n55:    h('X2', xOffsetPt + 200, -40),\r\n56:    h(String(xSpanMm), xOffsetPt + 100, -20),\r\n57:    h('Y1', xOffsetPt - 40, 0),\r\n58:    h('Y2', xOffsetPt - 40, 200),\r\n59:    v(String(ySpanMm), xOffsetPt - 20, 100),\r\n60:  ]\r\n61:}\r\n62:\r\n63:function framingPage(xSpanMm: number, ySpanMm: number): TextPage {\r\n64:  return {\r\n65:    widthPt: 1000,\r\n66:    heightPt: 1000,\r\n67:    items: framingItems(xSpanMm, ySpanMm),\r\n68:  }\r\n69:}\r\n70:\r\n71:function project(overrides: Partial<Project> = {}): Project {\r\n72:  return {\r\n73:    schemaVersion: 11,\r\n74:    name: 'test',\r\n75:    grid: { xSpans: [6000], ySpans: [6000] },\r\n76:    stories: [{ id: 'story-1', name: '1F', height: 4000 }],\r\n77:    sections: [],\r\n78:    members: [],\r\n79:    ...overrides,\r\n80:  }\r\n81:}\r\n82:\r\n83:const xGrid: PlanGridCandidate = {\r\n84:  direction: 'X',\r\n85:  axes: [\r\n86:    { label: 'X1', positionPt: 0 },\r\n87:    { label: 'X2', positionPt: 200 },\r\n88:    { label: 'X3', positionPt: 400 },\r\n89:  ],\r\n90:  spansMm: [7000, 7000],\r\n91:  scalePtPerMm: 200 / 7000,\r\n92:  totalConfirmed: false,\r\n93:}\r\n94:\r\n95:const yGrid: PlanGridCandidate = {\r\n96:  direction: 'Y',\r\n97:  axes: [\r\n98:    { label: 'Y1', positionPt: 0 },\r\n99:    { label: 'Y2', positionPt: 200 },\r\n100:  ],\r\n101:  spansMm: [5000],\r\n102:  scalePtPerMm: 200 / 5000,\r\n103:  totalConfirmed: false,\r\n104:}\r\n105:\r\n106:function block(overrides: Partial<PlanBlock> = {}): PlanBlock {\r\n107:  return {\r\n108:    xGrid,\r\n109:    yGrid,\r\n110:    placements: [],\r\n111:    unplacedMarks: [],\r\n112:    ...overrides,\r\n113:  }\r\n114:}\r\n115:\r\n116:describe('applyFramingPlan', () => {\r\n117:  it('同じ符号の断面が複数階にあれば階指定なしで反映しない', () => {\r\n118:    const result = applyFramingPlan(\r\n119:      project({\r\n120:        sections: [\r\n121:          sectionWithStory('柱', 'C1', '1階'),\r\n122:          sectionWithStory('柱', 'C1', '2階'),\r\n123:        ],\r\n124:      }),\r\n125:      {\r\n126:        block: block({\r\n127:          placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n128:        }),\r\n129:        storyId: 'story-1',\r\n130:      },\r\n131:    )\r\n132:\r\n133:    expect(result.applied).toBe(0)\r\n134:    expect(result.skipped).toEqual([\r\n135:      { mark: 'C1', reason: '断面複数該当' },\r\n136:    ])\r\n137:  })\r\n138:\r\n139:  it('断面の階ラベルを厳密に指定すれば該当する断面だけを反映する', () => {\r\n140:    const result = applyFramingPlan(\r\n141:      project({\r\n142:        sections: [\r\n143:          sectionWithStory('柱', 'C1', '1階'),\r\n144:          sectionWithStory('柱', 'C1', '2階'),\r\n145:        ],\r\n146:      }),\r\n147:      {\r\n148:        block: block({\r\n149:          placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n150:        }),\r\n151:        storyId: 'story-1',\r\n152:        sectionStoryLabel: '2階',\r\n153:      },\r\n154:    )\r\n155:\r\n156:    expect(result.applied).toBe(1)\r\n157:    expect(result.project.members[0]?.sectionId).toBe('sec-C1-2階')\r\n158:  })\r\n159:\r\n160:  it('指定した階ラベルの断面がなければ未登録として残す', () => {\r\n161:    const result = applyFramingPlan(\r\n162:      project({\r\n163:        sections: [sectionWithStory('柱', 'C1', '1階')],\r\n164:      }),\r\n165:      {\r\n166:        block: block({\r\n167:          placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n168:        }),\r\n169:        storyId: 'story-1',\r\n170:        sectionStoryLabel: '3階',\r\n171:      },\r\n172:    )\r\n173:\r\n174:    expect(result.applied).toBe(0)\r\n175:    expect(result.skipped).toEqual([{ mark: 'C1', reason: '断面未登録' }])\r\n176:  })\r\n177:\r\n178:  it('同じ符号と同じ階ラベルの重複断面も選べない', () => {\r\n179:    const result = applyFramingPlan(\r\n180:      project({\r\n181:        sections: [\r\n182:          sectionWithStory('柱', 'C1', '2階', 'sec-C1-2階-a'),\r\n183:          sectionWithStory('柱', 'C1', '2階', 'sec-C1-2階-b'),\r\n184:        ],\r\n185:      }),\r\n186:      {\r\n187:        block: block({\r\n188:          placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n189:        }),\r\n190:        storyId: 'story-1',\r\n191:        sectionStoryLabel: '2階',\r\n192:      },\r\n193:    )\r\n194:\r\n195:    expect(result.applied).toBe(0)\r\n196:    expect(result.skipped).toEqual([\r\n197:      { mark: 'C1', reason: '断面複数該当' },\r\n198:    ])\r\n199:  })\r\n200:\r\n201:  it('階ラベルを正規化せず原文どおりに比較する', () => {\r\n202:    const result = applyFramingPlan(\r\n203:      project({\r\n204:        sections: [sectionWithStory('柱', 'C1', '2階')],\r\n205:      }),\r\n206:      {\r\n207:        block: block({\r\n208:          placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n209:        }),\r\n210:        storyId: 'story-1',\r\n211:        sectionStoryLabel: '2F',\r\n212:      },\r\n213:    )\r\n214:\r\n215:    expect(result.applied).toBe(0)\r\n216:    expect(result.skipped).toEqual([{ mark: 'C1', reason: '断面未登録' }])\r\n217:  })\r\n218:\r\n219:  it('階ラベル이 없는 단면은 지정된 층의 후보로 취급하지 않는다', () => {\r\n220:    const result = applyFramingPlan(\r\n221:      project({\r\n222:        sections: [\r\n223:          sectionWithStory('柱', 'C1', undefined, 'sec-C1-no-story'),\r\n224:          sectionWithStory('柱', 'C1', '2階'),\r\n225:        ],\r\n226:      }),\r\n227:      {\r\n228:        block: block({\r\n229:          placements: [{ mark: 'C1', role: '格子点', ix: 1, iy: 1 }],\r\n230:        }),\r\n231:        storyId: 'story-1',\r\n232:        sectionStoryLabel: '2階',\r\n233:      },\r\n234:    )\r\n235:\r\n236:    expect(result.applied).toBe(1)\r\n237:    expect(result.project.members[0]?.sectionId).toBe('sec-C1-2階')\r\n238:  })\r\n239:\r\n240:  it('일치하는 階 라벨이 없으면 무라벨 断面으로 폴백한다', () => {\r\n241:    const result = applyFramingPlan(\r\n242:      project({\r\n243:        sections: [sectionWithStory('耐震壁', 'W1', undefined, 'sec-W1-no-story')],\r\n244:      }),\r\n245:      {\r\n246:        block: block({\r\n247:          placements: [{ mark: 'W1', role: '辺', ix: 0, iy: 0, axis: 'X' }],\r\n248:        }),\r\n249:        storyId: 'story-1',\r\n250:        sectionStoryLabel: '2階',\r\n251:      },\r\n252:    )\r\n253:\r\n254:    expect(result.applied).toBe(1)\r\n255:    expect(result.project.members[0]?.sectionId).toBe('sec-W1-no-story')\r\n256:  })\r\n257:\r\n258:  it('일치하는 階 라벨이 없고 무라벨 断面이 여러 개면 선택하지 않는다', () => {\r\n259:    const result = applyFramingPlan(\r\n260:      project({\r\n261:        sections: [\r\n262:          sectionWithStory('耐震壁', 'W1', undefined, 'sec-W1-no-story-a'),\r\n263:          sectionWithStory('耐震壁', 'W1', undefined, 'sec-W1-no-story-b'),\r\n264:        ],\r\n265:      }),\r\n266:      {\r\n267:        block: block({\r\n268:          placements: [{ mark: 'W1', role: '辺', ix: 0, iy: 0, axis: 'X' }],\r\n269:        }),\r\n270:        storyId: 'story-1',\r\n271:        sectionStoryLabel: '2階',\r\n272:      },\r\n273:    )\r\n274:\r\n275:    expect(result.applied).toBe(0)\r\n276:    expect(result.project.members).toEqual([])\r\n277:    expect(result.skipped).toEqual([{ mark: 'W1', reason: '断面複数該当' }])\r\n278:  })\r\n279:\r\n280:  it('여러 伏図 중 두 번째 블록은 두 번째 도면의 X·Y 通り芯을 구별해 취입한다', () => {\r\n281:    const plans = [framingPage(6000, 5000), framingPage(8000, 7000)].map(\r\n282:      parseFramingPlan,\r\n283:    )\r\n284:    const blocks = plans.flatMap((plan) => plan.blocks)\r\n285:    if (!blocks[1]) {\r\n286:      throw new Error('synthetic framing plans were not parsed')\r\n287:    }\r\n288:\r\n289:    const result = applyFramingPlan(project(), {\r\n290:      block: blocks[1],\r\n291:      storyId: 'story-1',\r\n292:    })\r\n293:\r\n294:    expect(result.project.grid.xSpans).toEqual([8000])\r\n295:    expect(result.project.grid.ySpans).toEqual([7000])\r\n296:    expect(result.refusal).toBeUndefined()\r\n297:    expect(result.skipped).toEqual([])\r\n298:  })\r\n299:\r\n300:  it('한 페이지의 스팬이 다른 伏図 두 장은 각 블록의 X·Y 通り芯으로 취입한다', () => {\r\n301:    const parsed = parseFramingPlan({\r\n302:      widthPt: 1400,\r\n303:      heightPt: 1000,\r\n304:      items: [\r\n305:        ...framingItems(6000, 5000),\r\n306:        ...framingItems(8000, 7000, 600),\r\n307:      ],\r\n308:    })\r\n309:\r\n310:    expect(parsed.blocks).toHaveLength(2)\r\n311:    expect(parsed.blocks.map((candidate) => candidate.xGrid.spansMm)).toEqual([\r\n312:      [6000],\r\n313:      [8000],\r\n314:    ])\r\n315:    expect(parsed.blocks.map((candidate) => candidate.yGrid.spansMm)).toEqual([\r\n316:      [5000],\r\n317:      [7000],\r\n318:    ])\r\n319:\r\n320:    const appliedGrids = parsed.blocks.map(\r\n321:      (candidate) =>\r\n322:        applyFramingPlan(project(), {\r\n323:          block: candidate,\r\n324:          storyId: 'story-1',\r\n325:        }).project.grid,\r\n326:    )\r\n327:    expect(appliedGrids).toEqual([\r\n328:      {\r\n329:        xSpans: [6000],\r\n330:        ySpans: [5000],\r\n331:        xLabels: ['X1', 'X2'],\r\n332:        yLabels: ['Y1', 'Y2'],\r\n333:      },\r\n334:      {\r\n335:        xSpans: [8000],\r\n336:        ySpans: [7000],\r\n337:        xLabels: ['X1', 'X2'],\r\n338:        yLabels: ['Y1', 'Y2'],\r\n339:      },\r\n340:    ])\r\n341:  })\r\n342:\r\n343:  it('通り芯을 도면의 스팬으로 바꾼다', () => {\r\n344:    const result = applyFramingPlan(project(), {\r\n345:      block: block(),\r\n346:      storyId: 'story-1',\r\n347:    })\r\n348:    expect(result.project.grid).toEqual({\r\n349:      xSpans: [7000, 7000],\r\n350:      ySpans: [5000],\r\n351:      xLabels: ['X1', 'X2', 'X3'],\r\n352:      yLabels: ['Y1', 'Y2'],\r\n353:    })\r\n354:    expect(result.refusal).toBeUndefined()\r\n355:  })\r\n356:\r\n357:  it('通り芯의 이름을 도면에서 읽은 원문 그대로 싣는다', () => {\r\n358:    // 이것이 R13(端部 좌우 비대칭)의 선결 조건이다 — 이름이 있어야 도면의\r\n359:    // 「Y3端／Y4端」을 런의 실제 방향과 맞출 수 있다\r\n360:    const result = applyFramingPlan(project(), {\r\n361:      block: block(),\r\n362:      storyId: 'story-1',\r\n363:    })\r\n364:    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\r\n365:    expect(result.project.grid.yLabels).toEqual(['Y1', 'Y2'])\r\n366:  })\r\n367:\r\n368:  it('이름만 다른 그리드는 「바뀌었다」로 보지 않는다', () => {\r\n369:    // 라벨은 数量도 격자 index도 바꾸지 않는다 — 이름 때문에 다른 층을 버리라는\r\n370:    // 물음이 뜨면 사용자는 이유를 알 수 없다\r\n371:    const base = project({\r\n372:      grid: { xSpans: [7000, 7000], ySpans: [5000] },\r\n373:      sections: [columnSection('C1')],\r\n374:      members: [\r\n375:        {\r\n376:          id: 'm1',\r\n377:          kind: '柱',\r\n378:          memberClass: '躯体',\r\n379:          sectionId: 'sec-C1',\r\n380:          storyId: 'story-2',\r\n381:          position: { ix: 1, iy: 1 },\r\n382:        },\r\n383:      ],\r\n384:      stories: [\r\n385:        { id: 'story-1', name: '1F', height: 4000 },\r\n386:        { id: 'story-2', name: '2F', height: 4000 },\r\n387:      ],\r\n388:    })\r\n389:\r\n390:    const result = applyFramingPlan(base, {\r\n391:      block: block(),\r\n392:      storyId: 'story-1',\r\n393:    })\r\n394:    expect(result.refusal).toBeUndefined()\r\n395:    expect(result.project.grid.xLabels).toEqual(['X1', 'X2', 'X3'])\r\n396:    expect(result.project.members).toHaveLength(1)\r\n397:  })\r\n398:\r\n399:  it('다른 층에 부재가 있는데 通り芯이 바뀌면 통째로 거부한다', () => {\r\n400:    // 격자 index는 스팬 배열에 매여 있다 — 스팬을 바꾸면 손대지 않은 층의\r\n401:    // 부재가 조용히 다른 자리로 옮겨간다. 이 제품이 못 견디는 실패다\r\n402:    const existing = project({\r\n403:      sections: [columnSection('C1')],\r\n404:      members: [\r\n405:        {\r\n406:          id: 'm1',\r\n407:          kind: '柱',\r\n408:          memberClass: '躯体',\r\n409:          sectionId: 'sec-C1',\r\n410:          storyId: 'story-2',\r\n411:          position: { ix: 1, iy: 1 },\r\n412:        },\r\n413:      ],\r\n414:      stories: [\r\n415:        { id: 'story-1', name: '1F', height: 4000 },\r\n416:        { id: 'story-2', name: '2F', height: 4000 },\r\n417:      ],\r\n418:    })\r\n419:\r\n420:    const result = applyFramingPlan(existing, {\r\n--- src/components/plan/PlanImport.tsx:245-764 ---\r\n245:export function PlanImport({\r\n246:  initialPages,\r\n247:  extractPages = extractTextPages,\r\n248:}: PlanImportProps) {\r\n249:  const locale = useAppStore(({ locale }) => locale)\r\n250:  const stories = useAppStore(({ project }) => project.stories)\r\n251:  const sections = useAppStore(({ project }) => project.sections)\r\n252:  const updateProject = useAppStore(({ updateProject }) => updateProject)\r\n253:  const inputRef = useRef<HTMLInputElement>(null)\r\n254:  const [pages, setPages] = useState<TextPage[] | null>(initialPages ?? null)\r\n255:  const [open, setOpen] = useState(initialPages !== undefined)\r\n256:  const [loading, setLoading] = useState(false)\r\n257:  const [failed, setFailed] = useState(false)\r\n258:  const [storyId, setStoryId] = useState('')\r\n259:  const [storySelectionWasManual, setStorySelectionWasManual] = useState(false)\r\n260:  const [sectionStoryLabel, setSectionStoryLabel] = useState<\r\n261:    string | undefined\r\n262:  >(undefined)\r\n263:  const [sectionSelectionWasManual, setSectionSelectionWasManual] =\r\n264:    useState(false)\r\n265:  const [storyEvidence, setStoryEvidence] = useState<\r\n266:    SelectionEvidence | undefined\r\n267:  >(undefined)\r\n268:  const [sectionEvidence, setSectionEvidence] = useState<\r\n269:    SelectionEvidence | undefined\r\n270:  >(undefined)\r\n271:  const [result, setResult] = useState<PlanApplyResult | null>(null)\r\n272:  const [discardOtherStories, setDiscardOtherStories] = useState(false)\r\n273:  const [discardMembers, setDiscardMembers] = useState(false)\r\n274:  const [elevationResults, setElevationResults] = useState<\r\n275:    Record<number, ElevationApplyResult>\r\n276:  >({})\r\n277:  // 연속 선택 시 늦게 끝난 이전 파일의 결과가 최신 결과를 덮지 않게 한다\r\n278:  const requestRef = useRef(0)\r\n279:\r\n280:  const plans = useMemo(\r\n281:    () => (pages ?? []).map((page) => parseFramingPlan(page)),\r\n282:    [pages],\r\n283:  )\r\n284:  const elevations = useMemo(\r\n285:    () => (pages ?? []).flatMap((page) => parseFrameElevations(page).elevations),\r\n286:    [pages],\r\n287:  )\r\n288:  const grids = plans.flatMap((plan) => plan.grids)\r\n289:  const gridIndexes = { X: 0, Y: 0 }\r\n290:  const displayedGrids = grids.map((candidate) => ({\r\n291:    candidate,\r\n292:    index: gridIndexes[candidate.direction]++,\r\n293:  }))\r\n294:  const blocks: PlanBlock[] = plans.flatMap((plan) => plan.blocks)\r\n295:  const sectionStoryLabels = useMemo(() => {\r\n296:    const labels: string[] = []\r\n297:    const seen = new Set<string>()\r\n298:    for (const section of sections) {\r\n299:      if (!section.storyLabel || seen.has(section.storyLabel)) continue\r\n300:      seen.add(section.storyLabel)\r\n301:      labels.push(section.storyLabel)\r\n302:    }\r\n303:    return labels\r\n304:  }, [sections])\r\n305:\r\n306:  useEffect(() => {\r\n307:    if (storyId === '' || stories.some((story) => story.id === storyId)) return\r\n308:\r\n309:    setStoryId('')\r\n310:    setStorySelectionWasManual(false)\r\n311:    setStoryEvidence(undefined)\r\n312:  }, [stories, storyId])\r\n313:\r\n314:  // 사유는 페이지마다 나오므로 접는다 — 같은 말이 페이지 수만큼 늘어서면 읽히지 않는다\r\n315:  const issues = [...new Set(plans.flatMap((plan) => plan.issues))]\r\n316:\r\n317:  const selectFile = async (event: ChangeEvent<HTMLInputElement>) => {\r\n318:    const input = event.currentTarget\r\n319:    const file = input.files?.[0]\r\n320:    if (!file) return\r\n321:\r\n322:    const requestId = ++requestRef.current\r\n323:    setOpen(true)\r\n324:    setLoading(true)\r\n325:    setFailed(false)\r\n326:    setResult(null)\r\n327:    setElevationResults({})\r\n328:    try {\r\n329:      const next = await extractPages(file)\r\n330:      if (requestRef.current !== requestId) return\r\n331:      setPages(next)\r\n332:    } catch {\r\n333:      if (requestRef.current !== requestId) return\r\n334:      setPages(null)\r\n335:      setFailed(true)\r\n336:    } finally {\r\n337:      if (requestRef.current === requestId) setLoading(false)\r\n338:      input.value = ''\r\n339:    }\r\n340:  }\r\n341:\r\n342:  const apply = (block: PlanBlock) => {\r\n343:    const automatic = automaticSelections(block, stories, sectionStoryLabels)\r\n344:    const nextStoryId = storySelectionWasManual\r\n345:      ? storyId\r\n346:      : automatic.storyId ?? ''\r\n347:    const nextSectionStoryLabel = sectionSelectionWasManual\r\n348:      ? sectionStoryLabel\r\n349:      : automatic.sectionStoryLabel\r\n350:\r\n351:    if (!storySelectionWasManual && automatic.story) {\r\n352:      setStoryId(nextStoryId)\r\n353:      setStoryEvidence(automatic.story)\r\n354:    } else {\r\n355:      setStoryEvidence(undefined)\r\n356:    }\r\n357:    if (!sectionSelectionWasManual && automatic.section) {\r\n358:      setSectionStoryLabel(nextSectionStoryLabel)\r\n359:      setSectionEvidence(automatic.section)\r\n360:    } else {\r\n361:      setSectionEvidence(undefined)\r\n362:    }\r\n363:\r\n364:    let applied: PlanApplyResult | undefined\r\n365:    updateProject((project) => {\r\n366:      applied = applyFramingPlan(project, {\r\n367:        block,\r\n368:        storyId: nextStoryId,\r\n369:        sectionStoryLabel: nextSectionStoryLabel,\r\n370:        discardOtherStories,\r\n371:      })\r\n372:      return applied.project\r\n373:    })\r\n374:    if (applied) setResult(applied)\r\n375:  }\r\n376:\r\n377:  const applyStories = (\r\n378:    candidate: ElevationCandidate,\r\n379:    index: number,\r\n380:    topLevelIndex: number,\r\n381:    bottomLevelIndex: number,\r\n382:  ) => {\r\n383:    let applied: ElevationApplyResult | undefined\r\n384:    updateProject((project) => {\r\n385:      applied = applyElevation(project, {\r\n386:        candidate,\r\n387:        topLevelIndex,\r\n388:        bottomLevelIndex,\r\n389:        discardMembers,\r\n390:      })\r\n391:      return applied.project\r\n392:    })\r\n393:    if (applied) {\r\n394:      const next = applied\r\n395:      setElevationResults((current) => ({ ...current, [index]: next }))\r\n396:    }\r\n397:  }\r\n398:\r\n399:  return (\r\n400:    <div className={styles.control}>\r\n401:      <button\r\n402:        type=\"button\"\r\n403:        className={styles.openButton}\r\n404:        onClick={() => {\r\n405:          if (pages) setOpen(true)\r\n406:          else inputRef.current?.click()\r\n407:        }}\r\n408:      >\r\n409:        {t(locale, 'planImport.open')}\r\n410:      </button>\r\n411:      <input\r\n412:        ref={inputRef}\r\n413:        className={styles.fileInput}\r\n414:        data-testid=\"plan-import-file\"\r\n415:        type=\"file\"\r\n416:        accept=\"application/pdf\"\r\n417:        aria-label={t(locale, 'planImport.file')}\r\n418:        onChange={(event) => void selectFile(event)}\r\n419:      />\r\n420:      {open ? (\r\n421:        <section\r\n422:          className={styles.panel}\r\n423:          role=\"dialog\"\r\n424:          aria-modal=\"false\"\r\n425:          aria-labelledby=\"plan-import-title\"\r\n426:        >\r\n427:          <header className={styles.panelHeader}>\r\n428:            <h3 id=\"plan-import-title\">{t(locale, 'planImport.title')}</h3>\r\n429:            <div className={styles.panelActions}>\r\n430:              <button\r\n431:                type=\"button\"\r\n432:                className={styles.chooseButton}\r\n433:                onClick={() => inputRef.current?.click()}\r\n434:              >\r\n435:                {t(locale, 'planImport.chooseAnother')}\r\n436:              </button>\r\n437:              <button\r\n438:                type=\"button\"\r\n439:                className={styles.closeButton}\r\n440:                onClick={() => setOpen(false)}\r\n441:              >\r\n442:                {t(locale, 'planImport.close')}\r\n443:              </button>\r\n444:            </div>\r\n445:          </header>\r\n446:          <div className={styles.panelBody}>\r\n447:            {loading ? (\r\n448:              <p role=\"status\">{t(locale, 'planImport.loading')}</p>\r\n449:            ) : failed ? (\r\n450:              <p role=\"alert\">{t(locale, 'planImport.error')}</p>\r\n451:            ) : (\r\n452:              <>\r\n453:                {issues.length > 0 ? (\r\n454:                  <ul className={styles.issues} data-testid=\"plan-import-issues\">\r\n455:                    {issues.map((issue) => (\r\n456:                      <li key={issue}>\r\n457:                        {t(locale, `planImport.issue.${issue}`)}\r\n458:                      </li>\r\n459:                    ))}\r\n460:                  </ul>\r\n461:                ) : null}\r\n462:\r\n463:                {displayedGrids.map(({ candidate, index }) => (\r\n464:                  <Axes\r\n465:                    key={`${candidate.direction}-${index}`}\r\n466:                    candidate={candidate}\r\n467:                    label={t(\r\n468:                      locale,\r\n469:                      candidate.direction === 'X'\r\n470:                        ? 'planImport.gridX'\r\n471:                        : 'planImport.gridY',\r\