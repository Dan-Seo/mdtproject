ort type {\\\\\\\\r\\\\\\\\n  BarSize,\\\\\\\\r\\\\\\\\n  ColumnShape,\\\\\\\\r\\\\\\\\n  ShearBarSize,\\\\\\\\r\\\\\\\\n} from '@/domain/model/member'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport type { TextItem } from '@/lib/import/types'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport interface TextPage {\\\\\\\\r\\\\\\\\n  widthPt: number\\\\\\\\r\\\\\\\\n  heightPt: number\\\\\\\\r\\\\\\\\n  items: TextItem[]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ???鍮덉뭏?쇰줈 ?④릿 ?ъ쑀 肄붾뱶. ?뚯꽌???꾩꽦 臾몄옣???꾨땲??肄붾뱶留??ｊ퀬,\\\\\\\\r\\\\\\\\n * ?쒖떆遺媛 `sectionImport.issue.*` ?ㅻ줈 踰덉뿭?쒕떎 (UnsupportedReason ?⑦꽩).\\\\\\\\r\\\\\\\\n */\\\\\\\\r\\\\\\\\nexport const CANDIDATE_ISSUES = [\\\\\\\\r\\\\\\\\n  '訝사춮鰲ｉ뇠訝띹꺗',\\\\\\\\r\\\\\\\\n  '訝사춮鵝띸쉰轝좄맼',\\\\\\\\r\\\\\\\\n  '訝사춮鵝띸쉰?면걬',\\\\\\\\r\\\\\\\\n  '訝사춮塋?깿藥?뤂?면걬',\\\\\\\\r\\\\\\\\n  '訝사춮訝듾툔孃꾤쎑??,\\\\\\\\r\\\\\\\\n  '訝사춮?섋퓭??,\\\\\\\\r\\\\\\\\n  '訝사춮?⒲깧?ヨ죱鸚?,\\\\\\\\r\\\\\\\\n  '??씊?⒴숱訝띷닇塋?,\\\\\\\\r\\\\\\\\n  '躍?춮鰲ｉ뇠訝띹꺗',\\\\\\\\r\\\\\\\\n  '躍?춮?섋퓭??,\\\\\\\\r\\\\\\\\n  '躍?춮?⒲깧?ヨ죱鸚?,\\\\\\\\r\\\\\\\\n  '?밭춮鰲ｉ뇠訝띹꺗',\\\\\\\\r\\\\\\\\n  '亮끾??곭춮鰲ｉ뇠訝띹꺗',\\\\\\\\r\\\\\\\\n  '?롣툖??,\\\\\\\\r\\\\\\\\n  '?끿쎅烏뚪뇥筽?,\\\\\\\\r\\\\\\\\n] as const\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport type CandidateIssue = (typeof CANDIDATE_ISSUES)[number]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/** ?ゃ궧?덀걢?됭き?볝걽訝?ㅳ겗寧?뤇?삡??ㅳ겗?롢겗?숃짒?귞▶若잆겒?ㅳ걽?묆굮岳앮똻?쇻굥??*/\\\\\\\\r\\\\\\\\nexport interface SectionCandidate {\\\\\\\\r\\\\\\\\n  kind: '?? | '鸚㎪쥈' | '野얕괌鸚?\\\\\\\\r\\\\\\\\n  mark: string\\\\\\\\r\\\\\\\\n  storyLabel?: string\\\\\\\\r\\\\\\\\n  /** ?긱겗??씊壤®듁???녶숱' ??겏??b?팪 ??겏?귙겓?닷푶?㎯걗??(ADR-027)??*/\\\\\\\\r\\\\\\\\n  shape?: ColumnShape\\\\\\\\r\\\\\\\\n  b?: number\\\\\\\\r\\\\\\\\n  d?: number\\\\\\\\r\\\\\\\\n  main?: { size: BarSize; count: number }\\\\\\\\r\\\\\\\\n  hoop?: { size: ShearBarSize; pitchMm: number }\\\\\\\\r\\\\\\\\n  depth?: number\\\\\\\\r\\\\\\\\n  girderMain?: {\\\\\\\\r\\\\\\\\n    size: BarSize\\\\\\\\r\\\\\\\\n    /** 訝?ㄾ轝꾠겗?ф빊?귚퐤營?겎?녴걢?뚣겍?꾠겒?꾥〃?㎯겘?ⓩ뼪?㏂겗?ф빊 */\\\\\\\\r\\\\\\\\n    topCount: number\\\\\\\\r\\\\\\\\n    bottomCount: number\\\\\\\\r\\\\\\\\n    /**\\\\\\\\r\\\\\\\\n     * 塋?깿轝꾠겗?ф빊?귚퐤營?겎?ф빊?믣늽?묆겍?꾠굥烏ⓦ걽?묆걣?곥걾?곦륫塋?걣?뚦ㅳ겗?ⓦ걤?쀣걢\\\\\\\\r\\\\\\\\n     * ?뗣굙?ゃ걚 ??藥?뤂?㏝걬?녻〃??겑?▲굢?뚦쭓塋?걢?믤군?곥굢?뚣겒??(訝사춮塋?깿藥?뤂?면걬)??\\\\\\\\r\\\\\\\\n     */\\\\\\\\r\\\\\\\\n    endTopCount?: number\\\\\\\\r\\\\\\\\n    endBottomCount?: number\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n  stirrup?: { size: ShearBarSize; pitchMm: number }\\\\\\\\r\\\\\\\\n  /**\\\\\\\\r\\\\\\\\n   * 亮끾??곭춮?귙꺁?밤깉烏③죱??돶鼇섅걢?됭き? ??烏ⓦ겗?삠꺂?㎯겘?ゃ걚??\\\\\\\\r\\\\\\\\n   * ?ゅ츣獰⒲겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲굮?뤷뫑?쇻굥 (ADR-012)?귛ㄷ歟곥겓?졼걨雍됥굥\\\\\\\\r\\\\\\\\n   * (?곈뇧令띸츞?뷸틬 1?싧뎴3) ??닓?쇻겓?긱걣?ゃ걚)??\\\\\\\\r\\\\\\\\n   */\\\\\\\\r\\\\\\\\n  widthTie?: { size: BarSize; pitchMm: number }\\\\\\\\r\\\\\\\\n  /**\\\\\\\\r\\\\\\\\n   * ?밭춮?귛쎋?㏂걣??-D10?띲겏?멥걦?겹걹??굚????1?싧뎴7) ??돯餓섅겎??겒?꾠?\\\\\\\\r\\\\\\\\n   * ?ゅ츣獰⒲겘?뚣걹??뀓嶺뗣걣?ゃ걚?띲굮?뤷뫑?쇻굥 (ADR-012)??\\\\\\\\r\\\\\\\\n   * 鵝숅빓 (extraLengthMm) ??쎋?㏂겓?▲걚 ???뽧굤渦쇈겳?담걣黎뷩굙??(R9????\\\\\\\\r\\\\\\\\n   */\\\\\\\\r\\\\\\\\n  sideBar?: { size: BarSize; count: number }\\\\\\\\r\\\\\\\\n  /** 鰲ｉ뇠?㎯걤?싩㈉轝꾠겓?쀣걼?끿쎅??렅?뉎?*/\\\\\\\\r\\\\\\\\n  raw: Record<string, string>\\\\\\\\r\\\\\\\\n  issues: CandidateIssue[]\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n/**\\\\\\\\r\\\\\\\\n * ???섎굹媛 ?듭㎏濡??꾨낫瑜?紐????ъ쑀. ?꾨낫 諛곗뿴??鍮꾩뿀?ㅻ뒗 ?ъ떎留뚯쑝濡쒕뒗\\\\\\\\r\\\\\\\\n * ?뚨Е?룹쓣 紐??쎌뿀?ㅳ띿? ?뚨Е?룹? ?쎌뿀?붾뜲 ??ぉ ?됱쓣 紐??쎌뿀?ㅳ띻? 援щ텇?섏? ?딄퀬,\\\\\\\\r\\\\\\\\n * ?섏? ?ъ슜?먭? ?먮룄?먯꽌 蹂?怨녹씠 ?ㅻⅤ??\\\\\\\\r\\\\\\\\n */\\\\\\\\r\\\\\\\\nexport const LIST_ISSUES = ['寧?뤇烏뚧쑋沃띹춼', '?끿쎅烏뚧쑋沃띹춼'] as const\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport type ListIssue = (typeof LIST_ISSUES)[number]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport interface ParsedSectionList {\\\\\\\\r\\\\\\\\n  listKind: string\\\\\\\\r\\\\\\\\n  candidates: SectionCandidate[]\\\\\\\\r\\\\\\\\n  issue?: ListIssue\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n--- framing parse tail ---\\\\\\\\r\\\\\\\\n    let titleDistance = Number.POSITIVE_INFINITY\\\\\\\\r\\\\\\\\n    for (const candidate of titles) {\\\\\\\\r\\\\\\\\n      if (distanceToRange(candidate.x, xExtent.min, xExtent.max) > 0) continue\\\\\\\\r\\\\\\\\n      const distance = distanceToRange(candidate.y, yExtent.min, yExtent.max)\\\\\\\\r\\\\\\\\n      if (distance < titleDistance) {\\\\\\\\r\\\\\\\\n        title = candidate.text\\\\\\\\r\\\\\\\\n        titleDistance = distance\\\\\\\\r\\\\\\\\n      }\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    blocks.push({\\\\\\\\r\\\\\\\\n      ...(title === undefined ? {} : { title }),\\\\\\\\r\\\\\\\\n      xGrid,\\\\\\\\r\\\\\\\\n      yGrid,\\\\\\\\r\\\\\\\\n      placements,\\\\\\\\r\\\\\\\\n      unplacedMarks,\\\\\\\\r\\\\\\\\n    })\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return blocks.sort(\\\\\\\\r\\\\\\\\n    (a, b) =>\\\\\\\\r\\\\\\\\n      a.xGrid.axes[0].positionPt - b.xGrid.axes[0].positionPt ||\\\\\\\\r\\\\\\\\n      a.yGrid.axes[0].positionPt - b.yGrid.axes[0].positionPt,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nexport function parseFramingPlan(page: TextPage): ParsedFramingPlan {\\\\\\\\r\\\\\\\\n  const { labels, dimensions, marks, titles } = collectTokens(page)\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const issues: PlanGridIssue[] = []\\\\\\\\r\\\\\\\\n  const issue = (code: PlanGridIssue) => {\\\\\\\\r\\\\\\\\n    if (!issues.includes(code)) issues.push(code)\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  if (labels.length === 0) {\\\\\\\\r\\\\\\\\n    return { grids: [], blocks: [], issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??] }\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  // ?쇰꺼 臾몄옄?댁씠 媛濡쒕줈 ?볦뿬??諛대뱶(異뺤쓽 ?섏뼱??諛⑺뼢)???몃줈?????덈떎 ??\\\\\\\\r\\\\\\\\n  // ??諛⑺뼢 ??臾띠뼱 蹂닿퀬, 寃利?以묒젏 移섏닔쨌異뺤쿃)??媛吏?諛대뱶瑜?嫄몃윭?몃떎.\\\\\\\\r\\\\\\\\n  const validated = [\\\\\\\\r\\\\\\\\n    ...axisSequences(labels, 'x'),\\\\\\\\r\\\\\\\\n    ...axisSequences(labels, 'y'),\\\\\\\\r\\\\\\\\n  ].flatMap((sequence) => {\\\\\\\\r\\\\\\\\n    const result = validateSequence(sequence, dimensions, issue)\\\\\\\\r\\\\\\\\n    return result ? [result] : []\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const grids: PlanGridCandidate[] = []\\\\\\\\r\\\\\\\\n  const seen = new Set<string>()\\\\\\\\r\\\\\\\\n  for (const sequence of validated) {\\\\\\\\r\\\\\\\\n    const candidate = gridCandidate(sequence)\\\\\\\\r\\\\\\\\n    const key = [\\\\\\\\r\\\\\\\\n      candidate.direction,\\\\\\\\r\\\\\\\\n      candidate.axes.map((axis) => axis.label).join(','),\\\\\\\\r\\\\\\\\n      candidate.spansMm.join(','),\\\\\\\\r\\\\\\\\n    ].join('|')\\\\\\\\r\\\\\\\\n    if (seen.has(key)) continue\\\\\\\\r\\\\\\\\n    seen.add(key)\\\\\\\\r\\\\\\\\n    grids.push(candidate)\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n  grids.sort(\\\\\\\\r\\\\\\\\n    (a, b) =>\\\\\\\\r\\\\\\\\n      a.direction.localeCompare(b.direction) ||\\\\\\\\r\\\\\\\\n      a.axes[0].positionPt - b.axes[0].positionPt,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  const blocks = buildBlocks(\\\\\\\\r\\\\\\\\n    validated.filter((sequence) => sequence.direction === 'X'),\\\\\\\\r\\\\\\\\n    validated.filter((sequence) => sequence.direction === 'Y'),\\\\\\\\r\\\\\\\\n    marks,\\\\\\\\r\\\\\\\\n    titles,\\\\\\\\r\\\\\\\\n    issue,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return { grids, blocks, issues }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n--- test corpus setup ---\\\\\\\\r\\\\\\\\nimport { readFileSync } from 'node:fs'\\\\\\\\r\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport { describe, expect, it } from 'vitest'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nimport {\\\\\\\\r\\\\\\\\n  DIMENSION_PATTERN,\\\\\\\\r\\\\\\\\n  parseFramingPlan,\\\\\\\\r\\\\\\\\n} from '@/lib/import/framing-plan/parse'\\\\\\\\r\\\\\\\\nimport type { PlanGridCandidate } from '@/lib/import/framing-plan/types'\\\\\\\\r\\\\\\\\nimport type { TextPage } from '@/lib/import/section-list/types'\\\\\\\\r\\\\\\\\nimport { recoverRows, verticalRuns } from '@/lib/import/runs'\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n// TextItem ?쎌뒪泥?肄뷀띁?ㅻ뒗 section-import? 怨듭쑀?쒕떎 ??醫뚰몴 洹쒖빟怨??쒖젣? ?쒖쇅瑜?\\\\\\\\r\\\\\\\\n// ???뚯씠?꾨씪??scripts/extract-textitems.mjs)??蹂댁쬆?섍린 ?뚮Ц?대떎.\\\\\\\\r\\\\\\\\ntype TextItemFixture = {\\\\\\\\r\\\\\\\\n  page: Pick<TextPage, 'widthPt' | 'heightPt'>\\\\\\\\r\\\\\\\\n  items: TextPage['items']\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction readPage(file: string): TextPage {\\\\\\\\r\\\\\\\\n  const fixturePath = resolve(\\\\\\\\r\\\\\\\\n    process.cwd(),\\\\\\\\r\\\\\\\\n    'tests/fixtures/section-import/textitems',\\\\\\\\r\\\\\\\\n    file,\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  const fixture = JSON.parse(\\\\\\\\r\\\\\\\\n    readFileSync(fixturePath, 'utf8'),\\\\\\\\r\\\\\\\\n  ) as TextItemFixture\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  return { ...fixture.page, items: fixture.items }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nconst DRAWING_FIXTURES = [\\\\\\\\r\\\\\\\\n  'kani-p38.json',\\\\\\\\r\\\\\\\\n  'kani-p40.json',\\\\\\\\r\\\\\\\\n  'ojkk-p2.json',\\\\\\\\r\\\\\\\\n  'ojkk-p3.json',\\\\\\\\r\\\\\\\\n  'yokohama-p13.json',\\\\\\\\r\\\\\\\\n  'yokohama-p14.json',\\\\\\\\r\\\\\\\\n  'yokohama-p7.json',\\\\\\\\r\\\\\\\\n  'yokohama-p8.json',\\\\\\\\r\\\\\\\\n]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nfunction dimensionCandidates(page: TextPage): string[] {\\\\\\\\r\\\\\\\\n  const horizontal = recoverRows(page.items).flatMap((row) =>\\\\\\\\r\\\\\\\\n    row.segments.map((segment) => segment.compact),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n  const vertical = verticalRuns(page.items).map((run) => run.text)\\\\\\\\r\\\\\\\\n  return [...horizontal, ...vertical].filter((text) =>\\\\\\\\r\\\\\\\\n    DIMENSION_PATTERN.test(text),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nit('?ㅻ룄硫?8遺??媛濡쑣룹꽭濡?移섏닔 ?꾨낫?먮뒗 0mm ?댄븯媛 ?녿떎', () => {\\\\\\\\r\\\\\\\\n  // ??媛?쒕뒗 ?뚯꽌 異쒕젰???꾨땲??runs.ts???멸렇癒쇳듃 臾명꽦 遺덈??앹씠??\\\\\\\\r\\\\\\\\n  // ?ㅼ륫??湲곕낯 臾명꽦?먯꽌??8遺 紐⑤몢 0嫄댁씠怨? gapRatio瑜?0.5濡???텛硫?\\\\\\\\r\\\\\\\\n  // yokohama-p14????50x1000?띿씠 650쨌x쨌1쨌000?쇰줈 媛덈씪??000??4嫄??섏삩??\\\\\\\\r\\\\\\\\n  // 0.8쨌0.7쨌0.6?먯꽌??移⑤У?섎?濡?珥섏킌??寃쎄퀎媛 ?꾨땶 援듭? ?몃┰??댁뼱??\\\\\\\\r\\\\\\\\n  // ?몃줈 `VERTICAL_RUN_GAP_RATIO`??媛濡쒖? 媛숈? 援듭? ?몃┰??댁뼱?? 8遺 ?꾩껜??媛숈?\\\\\\\\r\\\\\\\\n  // ???몄젒?띿뿉??`gap / max(w)` 理쒖넖媛믪? 1.000000?닿퀬, 1 誘몃쭔???띿? 0媛쒖???\\\\\\\\r\\\\\\\\n  // (6?먮━ 諛섏삱由?湲곗?; ?먯떆 理쒖넖媛믪? 遺?숈냼??ULP ?붿감濡?0.9999999999999634).\\\\\\\\r\\\\\\\\n  // 0.99쨌0.8쨌0.5쨌0.3?먯꽌??紐⑤뱺 ?곗씠 1湲?먮줈 媛덈씪??`DIMENSION_PATTERN`\\\\\\\\r\\\\\\\\n  // ?듦낵媛 0嫄댁씠?? 諛곗닔媛 ?뺥솗??1.0???뚮뒗 李?`(1w, 2w)`???섎떒 紐⑥꽌由ъ뿉??\\\\\\\\r\\\\\\\\n  // `00`쨌`000` 議곌컖???앷꺼 0mm 媛?쒓? ?몃ŉ, kani-p38 3嫄?쨌 ojkk-p3 21嫄?쨌\\\\\\\\r\\\\\\\\n  // yokohama-p7 13嫄?쨌 yokohama-p8 3嫄댁씠??\\\\\\\\r\\\\\\\\n  const measured = DRAWING_FIXTURES.map((file) => {\\\\\\\\r\\\\\\\\n    const candidates = dimensionCandidates(readPage(file))\\\\\\\\r\\\\\\\\n    return {\\\\\\\\r\\\\\\\\n      file,\\\\\\\\r\\\\\\\\n      nonPositive: candidates.filter(\\\\\\\\r\\\\\\\\n        (text) => Number.parseInt(text.replaceAll(',', ''), 10) <= 0,\\\\\\\\r\\\\\\\\n      ),\\\\\\\\r\\\\\\\\n    }\\\\\\\\r\\\\\\\\n  })\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n  expect(measured).toEqual(\\\\\\\\r\\\\\\\\n    DRAWING_FIXTURES.map((file) => ({ file, nonPositive: [] })),\\\\\\\\r\\\\\\\\n  )\\\\\\\\r\\\\\\\\n})\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n// ?????섏씠吏 以?異??쇰꺼 紐⑥뼇???멸렇癒쇳듃瑜?媛吏?寃껋? yokohama-p14 ?섎굹肉먯씠??\\\\\\\\r\\\\\\\\n// (12媛? `X2塋?쨌`X3塋?쨌`Y2塋?쨌`Y3塋?쨌`Y4塋?쨌`Y5塋???諛섎났). yokohama-p13쨌ojkk-p2쨌\\\\\\\\r\\\\\\\\n// ojkk-p3? 媛곴컖 0媛쒕씪 ?쇰꺼 ?꾨낫 ?먯껜媛 ?녿떎. ??援щ퀎? ?먯????먮낯 ?뚯뒪?몄뿉??\\\\\\\\r\\\\\\\\n// 紐낆떆???덉뿀怨? ?ㅼ륫 洹쇨굅??fa5ab24??tests/section-import/plan-grid.test.ts???⑥븘 ?덈떎.\\\\\\\\r\\\\\\\\n//\\\\\\\\r\\\\\\\\n// ??grid-parse??X2쨌X3瑜?癒쇱? ?쇰꺼濡?李얠? ?? ?ㅽ뙩 1蹂?異뺤? 寃?곗씠\\\\\\\\r\\\\\\\\n// 怨듯쉶?꾪븳?ㅻ뒗 ?댁쑀濡?`?븅뼋?겻툖擁??쇰줈 嫄곗젅?덈떎. framing-plan? 湲곗쟾??\\\\\\\\r\\\\\\\\n// ?ㅻⅤ?? ?ㅼ젣 ?멸렇癒쇳듃??`X2塋?쨌`Y4塋?泥섎읆 ?쇰꺼 ?ㅼ뿉 `塋???遺숈뼱 ?덇퀬,\\\\\\\\r\\\\\\\\n// sticky AXIS_LABEL_PATTERN? X2瑜?留ㅼ튂?????⑥? 塋?퉴吏 ?뚮퉬?섏? 紐삵븳??\\\\\\\\r\\\\\\\\n// splitAxisLabels媛 ?멸렇癒쇳듃 ?꾩껜瑜??ㅻ챸?섏? 紐삵븳 寃껋쑝濡?蹂닿퀬 鍮?諛곗뿴??\\\\\\\\r\\\\\\\\n// 諛섑솚?섎?濡? framing-plan? ?쇰꺼??李얘린 ???④퀎?먯꽌 `?싥굤??꺀?쇻꺂?ゆ쩂?????몃떎.\\\\\\\\r\\\\\\\\ndescribe('??씊?ゃ궧??pages do not produce framing grids', () => {\\\\\\\\r\\\\\\\\n  it('does not invent grids from axis-like section marks', () => {\\\\\\\\r\\\\\\\\n    const files = [\\\\\\\\r\\\\\\\\n      'yokohama-p14.json',\\\\\\\\r\\\\\\\\n      'yokohama-p13.json',\\\\\\\\r\\\\\\\\n      'ojkk-p2.json',\\\\\\\\r\\\\\\\\n      'ojkk-p3.json',\\\\\\\\r\\\\\\\\n    ]\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n    expect(\\\\\\\\r\\\\\\\\n      files.map((file) => {\\\\\\\\r\\\\\\\\n        const parsed = parseFramingPlan(readPage(file))\\\\\\\\r\\\\\\\\n        return {\\\\\\\\r\\\\\\\\n          file,\\\\\\\\r\\\\\\\\n          grids: parsed.grids.length,\\\\\\\\r\\\\\\\\n          issues: parsed.issues,\\\\\\\\r\\\\\\\\n        }\\\\\\\\r\\\\\\\\n      }),\\\\\\\\r\\\\\\\\n    ).toEqual([\\\\\\\\r\\\\\\\\n      {\\\\\\\\r\\\\\\\\n        file: 'yokohama-p14.json',\\\\\\\\r\\\\\\\\n        grids: 0,\\\\\\\\r\\\\\\\\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\\\\\\\\r\\\\\\\\n      },\\\\\\\\r\\\\\\\\n      {\\\\\\\\r\\\\\\\\n        file: 'yokohama-p13.json',\\\\\\\\r\\\\\\\\n        grids: 0,\\\\\\\\r\\\\\\\\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\\\\\\\\r\\\\\\\\n      },\\\\\\\\r\\\\\\\\n      {\\\\\\\\r\\\\\\\\n        file: 'ojkk-p2.json',\\\\\\\\r\\\\\\\\n        grids: 0,\\\\\\\\r\\\\\\\\n        issues: ['?싥굤??꺀?쇻꺂?ゆ쩂??],\\\\\\\\r\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\r\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_8\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"현재 작업 트리에는 이전 step의 phase index·로그가 이미 남아 있고, 구현 소스에는 `MIDPOINT_TOLERANCE_PT = 15`가 그대로입니다. 이제 파일을 건드리지 않는 in-memory 번들 실험으로 문턱별 파싱을 반복해 대상 원복을 보장하겠습니다.\\\\\\\"}}\\\\r\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_9\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\"@'\\\\\\\\nimport { build } from 'esbuild'\\\\\\\\nimport { createRequire } from 'node:module'\\\\\\\\nimport { readFile } from 'node:fs/promises'\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\n\\\\\\\\nconst require = createRequire(import.meta.url)\\\\\\\\nconst root = process.cwd()\\\\\\\\nconst parsePath = resolve(root, 'src/lib/import/framing-plan/parse.ts')\\\\\\\\nconst fixtureDir = resolve(root, 'tests/fixtures/section-import/textitems')\\\\\\\\nconst files = [\\\\\\\\n  'kani-p38.json', 'kani-p40.json', 'ojkk-p2.json', 'ojkk-p3.json',\\\\\\\\n  'yokohama-p13.json', 'yokohama-p14.json', 'yokohama-p7.json', 'yokohama-p8.json',\\\\\\\\n]\\\\\\\\nconst tolerances = [4, 8, 15, 30, 60, 150, 400]\\\\\\\\n\\\\\\\\nasync function loadModule(tolerance) {\\\\\\\\n  const result = await build({\\\\\\\\n    entryPoints: [parsePath],\\\\\\\\n    bundle: true,\\\\\\\\n    platform: 'node',\\\\\\\\n    format: 'cjs',\\\\\\\\n    write: false,\\\\\\\\n    plugins: [{\\\\\\\\n      name: 'in-memory-tolerance',\\\\\\\\n      setup(pluginBuild) {\\\\\\\\n        pluginBuild.onLoad({ filter: /[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/]framing-plan[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/]parse\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.ts\\\\\\\\\\\\\\\"'$/ }, async (args) => {\\\\\\\\n          let contents = await readFile(args.path, '\\\\\\\\\\\\\\\"'utf8')\\\\\\\\n          contents = contents.replace(\\\\\\\\n            'const MIDPOINT_TOLERANCE_PT = 15',\\\\\\\\n            \\\\\\\\\\\\\\\"'`const MIDPOINT_TOLERANCE_PT = ${tolerance}`,\\\\\\\\n          )\\\\\\\\n          return { contents, loader: '\\\\\\\\\\\\\\\"'ts' }\\\\\\\\n        })\\\\\\\\n      },\\\\\\\\n    }],\\\\\\\\n  })\\\\\\\\n  const module = { exports: {} }\\\\\\\\n  const execute = new Function('require', 'module', 'exports', result.outputFiles[0].text)\\\\\\\\n  execute(require, module, module.exports)\\\\\\\\n  return module.exports\\\\\\\\n}\\\\\\\\n\\\\\\\\nconst output = {}\\\\\\\\nfor (const tolerance of tolerances) {\\\\\\\\n  const parser = await loadModule(tolerance)\\\\\\\\n  output[tolerance] = {}\\\\\\\\n  for (const file of files) {\\\\\\\\n    const fixture = JSON.parse(await readFile(resolve(fixtureDir, file), 'utf8'))\\\\\\\\n    const parsed = parser.parseFramingPlan({ ...fixture.page, items: fixture.items })\\\\\\\\n    output[tolerance][file] = {\\\\\\\\n      grids: parsed.grids.map((grid) => ({\\\\\\\\n        direction: grid.direction,\\\\\\\\n        axes: grid.axes.length,\\\\\\\\n        spansMm: grid.spansMm,\\\\\\\\n        totalConfirmed: grid.totalConfirmed,\\\\\\\\n      })),\\\\\\\\n      issues: parsed.issues,\\\\\\\\n    }\\\\\\\\n  }\\\\\\\\n}\\\\\\\\nconsole.log(JSON.stringify(output, null, 2))\\\\\\\\n'@ | node --input-type=module -\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\r\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_9\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\"@'\\\\\\\\nimport { build } from 'esbuild'\\\\\\\\nimport { createRequire } from 'node:module'\\\\\\\\nimport { readFile } from 'node:fs/promises'\\\\\\\\nimport { resolve } from 'node:path'\\\\\\\\n\\\\\\\\nconst require = createRequire(import.meta.url)\\\\\\\\nconst root = process.cwd()\\\\\\\\nconst parsePath = resolve(root, 'src/lib/import/framing-plan/parse.ts')\\\\\\\\nconst fixtureDir = resolve(root, 'tests/fixtures/section-import/textitems')\\\\\\\\nconst files = [\\\\\\\\n  'kani-p38.json', 'kani-p40.json', 'ojkk-p2.json', 'ojkk-p3.json',\\\\\\\\n  'yokohama-p13.json', 'yokohama-p14.json', 'yokohama-p7.json', 'yokohama-p8.json',\\\\\\\\n]\\\\\\\\nconst tolerances = [4, 8, 15, 30, 60, 150, 400]\\\\\\\\n\\\\\\\\nasync function loadModule(tolerance) {\\\\\\\\n  const result = await build({\\\\\\\\n    entryPoints: [parsePath],\\\\\\\\n    bundle: true,\\\\\\\\n    platform: 'node',\\\\\\\\n    format: 'cjs',\\\\\\\\n    write: false,\\\\\\\\n    plugins: [{\\\\\\\\n      name: 'in-memory-tolerance',\\\\\\\\n      setup(pluginBuild) {\\\\\\\\n        pluginBuild.onLoad({ filter: /[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/]framing-plan[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/]parse\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.ts\\\\\\\\\\\\\\\"'$/ }, async (args) => {\\\\\\\\n          let contents = await readFile(args.path, '\\\\\\\\\\\\\\\"'utf8')\\\\\\\\n          contents = contents.replace(\\\\\\\\n            'const MIDPOINT_TOLERANCE_PT = 15',\\\\\\\\n            \\\\\\\\\\\\\\\"'`const MIDPOINT_TOLERANCE_PT = ${tolerance}`,\\\\\\\\n          )\\\\\\\\n          return { contents, loader: '\\\\\\\\\\\\\\\"'ts' }\\\\\\\\n        })\\\\\\\\n      },\\\\\\\\n    }],\\\\\\\\n  })\\\\\\\\n  const module = { exports: {} }\\\\\\\\n  const execute = new Function('require', 'module', 'exports', result.outputFiles[0].text)\\\\\\\\n  execute(require, module, module.exports)\\\\\\\\n  return module.exports\\\\\\\\n}\\\\\\\\n\\\\\\\\nconst output = {}\\\\\\\\nfor (const tolerance of tolerances) {\\\\\\\\n  const parser = await loadModule(tolerance)\\\\\\\\n  output[tolerance] = {}\\\\\\\\n  for (const file of files) {\\\\\\\\n    const fixture = JSON.parse(await readFile(resolve(fixtureDir, file), 'utf8'))\\\\\\\\n    const parsed = parser.parseFramingPlan({ ...fixture.page, items: fixture.items })\\\\\\\\n    output[tolerance][file] = {\\\\\\\\n      grids: parsed.grids.map((grid) => ({\\\\\\\\n        direction: grid.direction,\\\\\\\\n        axes: grid.axes.length,\\\\\\\\n        spansMm: grid.spansMm,\\\\\\\\n        totalConfirmed: grid.totalConfirmed,\\\\\\\\n      })),\\\\\\\\n      issues: parsed.issues,\\\\\\\\n    }\\\\\\\\n  }\\\\\\\\n}\\\\\\\\nconsole.log(JSON.stringify(output, null, 2))\\\\\\\\n'@ | node --input-type=module -\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"{\\\\\\\\n  \\\\\\\\\\\\\\\"4\\\\\\\\\\\\\\\": {\\\\\\\\n    \\\\\\\\\\\\\\\"kani-p38.json\\\\\\\\\\\\\\\": {\\\\\\\\n      \\\\\\\\\\\\\\\"grids\\\\\\\\\\\\\\\": [\\\\\\\\n        {\\\\\\\\n          \\\\\\\\\\\\\\\"direction\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"X\\\\\\\\\\\\\\\",\\\\\\\\n          \\\\\\\\\\\\\\\"axes\\\\\\\\\\\\\\\": 4,\\\\\\\\n          \\\\\\\\\\\\\\\"spansMm\\\\\\\\\\\\\\\": [\\\\\\\\n            6000,\\\\\\\\n            6000,\\\\\\\\n            8000\\\\\\\\n          ],\\\\\\\\n          \\\\\\\\\\\\\\\"totalConfirmed\\\\\\\\\\\\\\\": true\\\\\\\\n        },\\\\\\\\n        {\\\\\\\\n          \\\\\\\\\\\\\\\"direction\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Y\\\\\\\\\\\\\\\",\\\\\\\\n          \\\\\\\\\\\\\\\"axes\\\\\\\\\\\\\\\": 3,\\\\\\\\n          \\\\\\\\\\\\\\\"spansMm\\\\\\\\\\\\\\\": [\\\\\\\\n            6000,\\\\\\\\n            10500\\\\\\\\n          ],\\\\\\\\n          \\\\\\\\\\\\\\\"totalConfirmed\\\\\\\\\\\\\\\": true\\\\\\