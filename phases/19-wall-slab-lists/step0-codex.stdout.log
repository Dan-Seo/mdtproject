ocs/RISKS.md')]:\\\\\\\\n    original = lines[headings[idx]+1:headings[idx+1]]\\\\\\\\n    current = pathlib.Path(path).read_text(encoding='utf-8').splitlines()[4:]\\\\\\\\n    print('SECTION', label, 'original_lines', len(original), 'current_body_lines', len(current))\\\\\\\\n    only_original = [(i, line) for i,line in enumerate(original,1) if line not in current]\\\\\\\\n    print('original_only_count', len(only_original))\\\\\\\\n    for i,line in only_original:\\\\\\\\n        print('ONLY', i, repr(line))\\\\\\\\n    print('current_only_count', sum(1 for line in current if line not in original))\\\\\\\\n'@ | python -\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"SECTION milestone original_lines 13 current_body_lines 13\\\\\\\\r\\\\\\\\noriginal_only_count 0\\\\\\\\r\\\\\\\\ncurrent_only_count 0\\\\\\\\r\\\\\\\\nSECTION risk original_lines 15 current_body_lines 15\\\\\\\\r\\\\\\\\noriginal_only_count 0\\\\\\\\r\\\\\\\\ncurrent_only_count 0\\\\\\\\r\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_9\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\"python -c \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"import subprocess; t=subprocess.check_output(['git','show','41a117c:CLAUDE.md']).decode('utf-8'); ls=t.splitlines(); heads=[i for i,x in enumerate(ls) if x.startswith('## ')]; print('HEADINGS',[(i,ls[j]) for i,j in enumerate(heads)]); print('---milestone summary---'); print('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n'.join(ls[heads[3]:heads[4]])); print('---risk summary---'); print('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n'.join(ls[heads[4]:heads[5]]))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_9\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\"python -c \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"import subprocess; t=subprocess.check_output(['git','show','41a117c:CLAUDE.md']).decode('utf-8'); ls=t.splitlines(); heads=[i for i,x in enumerate(ls) if x.startswith('## ')]; print('HEADINGS',[(i,ls[j]) for i,j in enumerate(heads)]); print('---milestone summary---'); print('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n'.join(ls[heads[3]:heads[4]])); print('---risk summary---'); print('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n'.join(ls[heads[4]:heads[5]]))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"HEADINGS [(0, '## 기술 스택'), (1, '## 아키텍처 규칙'), (2, '## 개발 프로세스'), (3, '## 마일스톤 현황'), (4, '## 열린 리스크'), (5, '## 명령어')]\\\\\\\\r\\\\\\\\n---milestone summary---\\\\\\\\r\\\\\\\\n## 마일스톤 현황\\\\\\\\\\\\\\\\n경위·수치·완료 내역은 **`docs/MILESTONES.md`**에 있다. 아래는 상태 대장이다 — 값을 인용하려면 그 문서를 읽고, 그 문서도 손갱신이므로 코드로 대조할 것.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n| | 상태 | 남은 것 |\\\\\\\\\\\\\\\\n|---|---|---|\\\\\\\\\\\\\\\\n| M0 스파이크 | 완료 | — |\\\\\\\\\\\\\\\\n| M1 워킹 스켈레톤 | 완료 | — |\\\\\\\\\\\\\\\\n| M2 룰팩 | **진행 중** | 標準仕様書 5章의 `stated` 승격. **사람의 독립 검토**라 에이전트가 코드로 닫을 수 없다 (R6) |\\\\\\\\\\\\\\\\n| M3a 단일 스팬 大梁·뷰어 | 완료 | — |\\\\\\\\\\\\\\\\n| M3b 다스팬·継手 | 완료 | — |\\\\\\\\\\\\\\\\n| M3c 고유 상세 | **진행 중** | 幅止め筋·腹筋 완료. パネルゾーン帯筋·溶接閉鎖フープ는 두 원문 0건이라 만들지 않는다 |\\\\\\\\\\\\\\\\n| 도면 인식(로컬) | **진행 중** | 断面リスト 트랙(값)과 형상 트랙(伏図·軸組図) 둘. ADR-018·ADR-030 |\\\\\\\\\\\\\\\\n| 부재 확장(耐震壁·床板) | **진행 중** | 開口補強筋 입력, 壁リスト·スラブリスト 파서, 片持床板 |\\\\\\\\\\\\\\\\n| 일본 고유 형태·제품 | **진행 중** | 高強度せん断補強筋·円形柱 완료. 남은 것은 雑壁·壁式構造の壁 |\\\\\\\\\\\\\\\\n| M4 재방문·내역서·PDF·glTF | 완료 | — |\\\\\\\\\\\\\\\\n| M5 한국 실무자 UX 리뷰 | 미착수 | — |\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n마일스톤 순서를 건너뛰지 말 것. 도면 인식은 M3a 이후 병행 가능한 별도 트랙이다 (ADR-018).\\\\\\\\\\\\\\\\n**M2가 미완이므로 산출값은 아직 정식 물량이 아니다.**\\\\\\\\\\\\\\\\n\\\\\\\\r\\\\\\\\n---risk summary---\\\\\\\\r\\\\\\\\n## 열린 리스크\\\\\\\\\\\\\\\\n근거·경위·수치는 **`docs/RISKS.md`**에 있다. 아래는 「무엇이 열려 있는가」 대장이다.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n| | 상태 | 한 줄 |\\\\\\\\\\\\\\\\n|---|---|---|\\\\\\\\\\\\\\\\n| R1 | 종결 | `標準詳細図`에 구조 배근 상세가 없다 → 근거는 `標準仕様書 5章`이 유일 |\\\\\\\\\\\\\\\\n| R2 | 열림 | 조문에 없는 관행(暗黙知)은 영구 미검증 → `confidence: inferred`로 축적 |\\\\\\\\\\\\\\\\n| R3 | 열림 | 일본 사용자 접점 0 |\\\\\\\\\\\\\\\\n| R4 | 해소 | 층당 1만 개 규모를 `InstancedMesh`가 견딘다(5층 45,885 실측). 계측 조건에 함정 둘 |\\\\\\\\\\\\\\\\n| R5 | 열림 | 근거가 공공건축 기준이라 민간 관행과 다를 수 있다 → UI 하단 고지 (ADR-003) |\\\\\\\\\\\\\\\\n| R6 | **열림** | 룰팩 `stated` 0행. 전사자＝승인자라 **사람의 독립 검토**가 있어야 닫힌다 |\\\\\\\\\\\\\\\\n| R7 | 대부분 해소 | 端部条件 ①②③·③-1 닫힘. **③-2 남음** — 直線 L1 실패 시 곧장 折曲げ로 가는 분기가 조문이 아닌 판단 |\\\\\\\\\\\\\\\\n| R8 | 해소 | 継手箇所수를 조문대로 센다. 継手位置는 表5.3.3이 이미지라 3D에 그리지 않는다 |\\\\\\\\\\\\\\\\n| R9 | 부분 | ① 해소. **② 열림** — 1通則6)의 JASS 5 준용 해석이 미검증(유료·미확보) |\\\\\\\\\\\\\\\\n| R10 | 열림 | 断面リスト 파서가 실물 3부 형식에 과적합. 형상 트랙에도 걸린다 |\\\\\\\\\\\\\\\\n| R11 | 조건부 | 리뷰 게이트가 자기를 못 지킨다. 두 번째 writer가 생기는 시점의 과제 |\\\\\\\\\\\\\\\\n| R12 | 열림 | 帯筋·あばら筋 `points`에 135°フック이 없다. **数量은 무영향**, 3D 형상만 |\\\\\\\\\\\\\\\\n| R13 | 열림 | 端部 좌우 비대칭 미지원. 선결(通り芯 라벨)은 닫혔고 `GirderMainRow` 모델 제약이 남았다 — 마일스톤급 별건 |\\\\\\\\\\\\\\\\n| R14 | 해소 | 開口部 欠除 구현. **잔여** — 開口補強筋 미계상이라 개구 있는 부재는 과소 계상 |\\\\\\\\\\\\\\\\n\\\\\\\\r\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_10\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\"rg -n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"남은 것|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*남은|R7|R9|R14|M3c|도면 인식|부재 확장|일본 고유 형태\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" docs/MILESTONES.md docs/RISKS.md\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_10\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command \\\\\\\\\\\\\\\"rg -n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"남은 것|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\*남은|R7|R9|R14|M3c|도면 인식|부재 확장|일본 고유 형태\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" docs/MILESTONES.md docs/RISKS.md\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"docs/RISKS.md:10:- **R6 (열림 — 다만 크기가 재어졌다)** 전사자＝승인자이므로 독립 검토가 아니다. **2026-08-21에 라벨과 검증층을 정리했다(ADR-023)**: `confidence`가 `stated`(원문 명시＋독립 검토) / `transcribed`(원문 명시·검토 1인) / `inferred`(원문에 값 없음) 3단계가 됐다. 예전에는 원문 명시값 178행이 `inferred`로 표시돼 **전 행에 ▲가 붙었고 ▲가 아무것도 가리키지 못했다** — 지금은 198행이 `transcribed`(△), 3행만 `inferred`(▲)다(継手 算入倍率 ＝ 반대해석. JIS 単位質量 8행은 그 뒤 룰팩을 떠나 `Project.unitMass` 입력이 됐다). **`stated`는 0행이고 그게 R6의 잔량이다.** 검증은 3층이고 층마다 잡는 오류가 다르다(변이 테스트로 실측) — 룰팩↔픽스처 대조는 두 전사물의 불일치를, `tests/golden/rulepack-invariants.test.ts`의 구조 불변식 37건은 표 구조를 깨는 오독(칸 밀림·열 뒤바뀜)을, 원문 재대조는 앞의 둘을 통과하는 공통 오독을 잡는다. `La`처럼 짝 표가 없고 여유가 큰 열은 불변식으로 못 잡히므로 픽스처 대조가 유일한 방어다. 표5.3.2·5.3.4·5.3.5의 77칸은 원문 PDF에서 재대조해 전 칸 일치를 확인했고 (`spec-r7-ch5.json`의 `source.verifications`), 그 과정에서 실제로 버그를 하나 잡았다(R7③-1). **닫으려면 전사자와 다른 인격(사람)의 검토가 필요하다** — `src/rulepack/index.test.ts`가 「`stated`는 0행」을 고정하고 있어 조용히 승급되지 않는다\\\\\\\\ndocs/RISKS.md:11:- **R7 (端部条件 대장)** 부재 단부의 定着·継手 규칙 미확정이 이중 계상과 불성립 형상을 만든다. 定着 키는 一般値 L1/L1h를 쓴다 — 表5.3.4 注1이 L1을 기본값으로 정의하고, L2/L2h는 割裂破壊のおそれのない箇所 한정(注2)인데 그 판정 재료가 제품에 없다. **①(해소, 2026-08-19 R9①로 재검토 완료)** 柱 층간 접합부: 예전에는 전 층이 `階高 + 定着 + 継手`를 받아 접합부가 아래층 継手와 위층 定着으로 두 번 계상됐다. `columnEnds`(project.ts)는 定着을 스택 **최하단(기초)에만** 붙이고 중간 접합부는 `'なし'`로 통과시킨다 — 최상단은 처음엔 이 자리에서 定着으로 두었으나 R9①에서 조문(1通則1)) 위반임이 드러나 `'先端'`으로 바뀌었다(정착 없음). 접합부의 継手는 端部条件이 아니라 `数量積算基準` 2（２）柱2)「各階ごとに1か所」가 층마다 계상한다 — 継手를 위층 부재에 귀속시키던 관행 전제는 **조문으로 대체돼 폐기됐다**(그 관행에서는 최하층 継手가 0이었다). 따라서 R2(미검증 관행) 꼬리표도 붙지 않는다. **②(해소)** 大梁 연속 스팬: 스팬별 독립 계산은 중간 柱 접합부 定着을 두 번 잡았다. M3b의 通し筋이 접합부를 관통하므로 중간 定着은 두 번이 아니라 **0번**이다 — 이것이 옳은 답이다. **③(해소)** 大梁 직선 정착: 一般定着 L1이 「지점 치수 − 반대면 加工用かぶり」를 넘으면 성립하지 않는다(샘플 G1 D25: L1 40d=1000 > 柱 800). `src/domain/rebar/girder-ends.ts`가 直線이 들어가면 直線, 아니면 折曲げ, 折曲げ의 필요 투영마저 못 들어가면 `MemberUnsupportedError('定着不成立')`로 끊는다 — 조용한 기본값 없이 셋 중 하나로 판정한다. **①②③이 모두 닫혔으므로 加工長 골든 픽스처의 선결 조건(단부 조건 확정)은 풀렸다.** **③-1(해소, 2026-08-21)**: 折曲げ定着의 全長 하한에 `L1h`를 쓰고 있었는데 조문은 `L1`이다. 5.3.4(5)(ｲ)는 (a)「全長は、表5.3.4 の**直線定着**の長さ以上」·(b)「余長は8d以上」·(c)「投影は表5.3.5、ただし柱せいの3/4以上」 셋을 다 걸고, `L1h`는 같은 조의 **적용 조건**(「フックありの定着の長さを確保できない場合」)이지 하한이 아니다. `L1 > L1h`이므로 결과는 과소 계상이었다 — 샘플 G1 D25에서 단부당 200mm, 본당 400mm(약 5.9%). 원인은 값 오전사가 아니라 **픽스처에 (a)가 없던 것**이라, 비수치 조문을 담는 `spec-r7-ch5.json`의 `constraints`에 (a)를 넣고 골든테스트가 (a)(b)(c)를 절대값으로 박는다. 이 수정으로 샘플 通し筋이 7.2m가 되어 1通則4)의 7.0m를 넘기면서 単一 스팬에도 継手 1か所가 새로 계상된다. **③-2(남음)**: 제품은 「L1이 안 들어가면 곧장 折曲げ定着」으로 분기하는데, 조문 (ｱ)는 直線 L1과 フックあり L1h 둘을 주므로 원래는 L1h가 들어가는지 먼저 볼 여지가 있다. 지금 분기는 더 길게(안전측으로) 잡지만 조문이 아닌 판단이다 — `inferred` (R2)\\\\\\\\ndocs/RISKS.md:12:- **R8 (해소 — 継手箇所数 계상)** 2026-08-18까지는 通し筋에 重ね継手를 한 개도 계상하지 않아 大梁 kg이 과소 계상됐다. `QuantityLine`을 kg·箇所 판별 유니온으로 넓히고 룰팩 `splice.yaml`을 실어 조문대로 세면서 닫혔다 — 런이 2스팬 이상이면 連続梁로 （３）梁2), 1스팬이면 単独梁로 1通則4)에 돌아간다(（３）梁2) 단서). 0か所인 철근은 행을 만들지 않는다. **남은 잔여 하나**: 継手位置는 表5.3.3이 원문에서 이미지라 미확정이라 3D에 그리지 않는다(고지로 상시 표시). 継手方式을 断面一覧에서 고를 수 없던 건은 2026-08-21에 닫혔다 — 입력 칸이 생겨 `重ね継手` 고정이 아니다. **개소수 근거는 있다** — `公共建築数量積算基準` 1通則4)가 「径13㎜以下は6.0mごと、径16㎜以上は7.0mごと」로, 같은 기준 （３）梁2)가 연속 梁을 길이별로 「5.0m未満 0.5か所／5.0以上10.0未満 1か所／10.0m以上 2か所」로, （２）柱2)가 柱을 「各階ごとに1か所」로 정한다(紙面 p.15~17, `tests/golden/fixtures/quantity-r5-ch3.json`에 전사). 2026-08-12 이전에 이 대장은 「근거 없음」이라고 적었는데 **틀렸다** — 継手箇所数는 배근 상세가 아니라 수량 산정 문제라서 `標準仕様書 5章`이 아니라 積算基準에 있었고, 5章만 뒤진 채 단정한 것이었다. 미계상의 실제 이유는 근거가 아니라 **구현**이었다: `QuantityLine`의 단위가 kg 하나뿐이라 「箇所」를 담을 자리가 없었다. 定尺長さ를 断面一覧 입력으로 두려던 이전 설계는 **철회한다** — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(`stated`). 継手位置는 M0에서 이미지에 갇힌 4개 값이라 `inferred`로 남는다\\\\\\\\ndocs/RISKS.md:13:- **R9 (数量 계측 규칙 미적용분)** `数量積算基準` 第4編第3章을 전사해 対照한 결과(`tests/golden/quantity-measurement.test.ts`), 1通則2)(周長·フックなし)와 7)(割付本数)는 적용했고 나머지는 미적용으로 남았다. 픽스처의 `status: deferred`가 대장이다. **①(해소)** 1通則1)「先端で止まる鉄筋はコンクリートの設計寸法」에 （２）柱1)가 최상층 柱主筋을 명시적으로 걸어두었는데, 예전 `columnEnds`는 스택 최상단에도 定着을 붙였다 — 조문과 어긋났다. `ColumnEnds.top`을 `'定着' | 'なし'`에서 `'なし' | '先端'`으로 바꿔(定着 값을 제거) 위에 柱가 없는 스택 최상단을 `'先端'`으로 판정하고, `generateColumnRebar`는 그 끝에 定着長さ를 더하지 않는다 — 룰팩 `measure.tip.length.addition`(value: 0, source: 1通則1))이 그 사실의 출처를 갖는다. R7①에 있던 \\\\\\\\\\\\\\\"定着은 스택 양 끝(기초·최상단)에\\\\\\\\\\\\\\\" 서술은 이 재검토로 정정됐다 — 定着은 이제 스택 **최하단(기초)에만** 붙는다. `tests/golden/fixtures/quantity-r5-ch3.json`의 1通則1) 항목도 `deferred`에서 `covered`로 옮겼다. **②** 1通則6)은 定着·重ね継手 길이가 設計図書에 없으면 **JASS 5 준용**이라고 한다(標準仕様書가 아니다). 公共建築工事에서는 標準仕様書가 設計図書의 일부이므로 「기재 없음」에 해당하지 않는다고 해석해 5章 값을 쓰고 있으나, 이 해석 자체가 미검증이고 JASS 5는 유료라 미확보다 (R2). **2026-08-21 추가**: 같은 조항이 `腹筋の余長`의 유일한 근거인데, 여기서는 標準仕様書 5章에도 대체값이 없다 — 「腹筋」이 R7 전 330쪽에 0건이라 해석으로도 메울 수 없다. 그래서 余長은 룰팩이 아니라 `断面一覧` 입력이고, 미입력이면 0으로 계상된다(과소 계상이지만 算出式에 그 사실이 적힌다). JASS 5를 확보하면 룰팩 행으로 옮길 수 있다 (ADR-021)\\\\\\\\ndocs/RISKS.md:16:- **R13 (端部 左右 비대칭 断面リスト 미지원)** 「Y3端／Y4端」·「外端／内端」처럼 좌우 端部의 主筋 本数가 다른 표는 취입하지 않는다. 제품의 `Grid`가 通り芯 라벨을 갖지 않아 어느 쪽이 런의 始端인지 결정할 수 없고, 결정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004·ADR-021). 파서는 값을 지어내지 않고 `主筋端部左右相違`로 빈칸+원문에 남기며, 사용자는 断面一覧에서 직접 채울 수 있다 — 다만 모델의 `GirderMainRow`도 양단 동값만 담으므로 **비대칭은 손으로도 입력할 수 없다.** 실측 3부 중 8칸(전부 yokohama)이 여기 걸리고, 이는 도면 인식 미반영 16칸의 최대 항목이다. 닫으려면 `Grid`에 通り芯 라벨을 넣고 런의 방향을 도면과 맞추는 별건이 선결이다 (2026-08-22 식별). **2026-08-23: 선결 조건이 닫혔다.** `Grid.xLabels`·`yLabels`(둘 다 optional ＝ 「도면에서 읽은 이름이 없다」)가 들어갔고, 伏図 취입이 도면의 원문을 그대로 싣는다(실측 `bX1·bX2·bX3·cX1`). schemaVersion은 올리지 않았다 — 版을 올리는 기준은 「같은 案件의 数量이 달라지는가」인데(v11 주석) 이름은 数量을 바꾸지 않고, 올리면 기존 기록이 전부 버려진다. 平面 에디터의 스팬은 이제 `bX1-bX2`로 불린다(이름이 없으면 `Xスパン 1`로 — index로 이름을 지어내지 않는다). **R13 자체는 여전히 열려 있다**: 남은 것은 `GirderMainRow`가 양단 동값만 담는다는 모델 제약이고, 그것을 푸는 일은 端部별 카ットオフ筋을 산정·物量·3D·加工長 골든에 걸쳐 바꾸는 **마일스톤급**이라 별건이다\\\\\\\\ndocs/RISKS.md:17:- **R14 (해소 — 開口部 欠除)** `数量積算基準` 1通則8)은 開口部에 의한 鉄筋의 欠除를 「建具類等開口部の内法寸法による、ただし1か所当たり内法面積0.5㎡以下は欠除なし」로 정하고 開口補強筋은 「設計図書により計測・計算する」로 위임한다. 2026-08-22까지는 開口의 위치·치수를 받는 입력이 없어 개구가 있는 벽·床板이 **과대 계상**됐다 — 이 프로젝트가 못 견디는 실패(「틀린 채로 완성된 것」)의 첫 자리라 빈칸으로 두지 않고 内訳書에 상시 고지를 세워 두었다. **`Member.openings` 입력과 `openingDeduction`으로 닫혔다 (ADR-029)** — 픽스처의 `1通則8)`이 `deferred`에서 `covered`로 넘어갔고, 고지는 지우지 않고 **문면을 뒤집었다**. **잔여 하나**: 開口補強筋을 계상하지 않으므로 개구가 있는 부재는 이제 **과소** 계상이다. 조문이 값을 주지 않고 設計図書에 위임하므로 제품이 지어낼 수 없고(2（３）梁1)·2（４）床板1)의 「補強筋等は設計図書による」와 같은 취급), 닫으려면 도면에서 읽은 補強筋을 그대로 옮겨 적는 입력이 필요하다. **판정에 남은 읽기**: 「어느 본이 欠けるか」를 원문이 말하지 않아 1通則7)의 割付을 위치로 읽었다 — 세는 시작 끝이 정해져 있지 않아 개구가 부재 중앙에 없을 때 1본 차가 날 수 있다 (R2)\\\\\\\\ndocs/MILESTONES.md:5:- [x] **M0** — 완료 (2026-08-09). 標準仕様書 R7 5章에서 MVP 관련 텍스트 수치 ~92개, 이미지 수치 8개(フック余長 4·継手位置 4)를 특정. 標準詳細図에는 구조 배근 상세가 없음을 확인 — 배근 근거는 5章이 유일하다 (docs/M0-FINDINGS.md)\\\\\\\\ndocs/MILESTONES.md:7:- [ ] **M2** — 룰팩 정식화 + 골든테스트 전 셀 통과. 골든 기대값은 원문 독립 전사(lookupRule 유도 금지, ADR-010). **M2a 착수분(2026-08-12)**: `数量積算基準` 第4編第3章을 전사해 `tests/golden/fixtures/quantity-r5-ch3.json`에 박고, 数量의 길이·본수를 1通則2)·7)에 맞췄다 — フープ/スタラップ 길이가 かぶり 공제+フック에서 **断面周長**으로 바뀌어 한 본당 244mm 늘었다(ADR-019). 미적용 조항은 R9. **추가 완료**(2026-08-20): 단위질량을 룰팩에서 빼고 **프로젝트 입력**(`Project.unitMass`)으로 받는다. 積算基準 1通則 前文은 質量을 「設計長さ × JIS G 3112 の単位質量」으로 정의할 뿐 값을 JIS에 위임하는데, JIS는 유료라 미확보다 — 읽지 않은 문헌을 出典에 세울 수 없으므로(ADR-003) `unit-mass.yaml`(inferred 8행)과 `sources.yaml`의 `jis` 항목을 지웠다. 미입력 径은 line·小計·合計의 kg이 전부 `null`이고 内訳書·Excel에 「—」로 나간다(0으로 두면 합계에 섞여 과소 계상으로 보인다). **추가 완료**(2026-08-21, 加工長 골든): 선결 조건이던 R7 端部条件 ①②③이 전부 닫혀 착수 가능해졌다 — `tests/golden/fixtures/fabrication-length.json`에 表5.3.4(L1)·表5.3.5(La)·5.3.4(5)(ｲ)(a)(b)(c)·表5.3.6·5.3.5(2)·表5.3.1(hook135, 이미지 판독) + `数量積算基準` 1通則1)(tipNoAddition)을 전사하고, 그 항들만으로 손유도한 加工長을 9케이스에 박았다(柱主筋 定着/통과, 柱帯筋, 大梁 折曲げ 全長下限支配/折曲げ 余長下限支配/直線/2스팬 通し筋, あばら筋, 定着不成立 throw). 재는 값은 `Rebar.length`가 아니라 **`points`가 그리는 折れ線 실장**이다 — 設計長さ를 읽으면 数量 골든과 중복되고 3D 형상은 아무도 고정하지 않는 채로 남는다(ADR-019). 근거 문서가 둘이라 `sources`는 배열이고 각 항이 `sourceId`로 어느 문서인지 가리킨다. 어느 케이스도 구속하지 않는 항은 `terms`에 남지 못한다 — 실제로 L1h가 그랬다. 뮤테이션으로 감도 확인함(cover 加算·余長下限·L1·中間柱せい 누적을 각각 흔들면 해당 케이스만 실패). **2026-08-21 재점검**: 예전에 적어둔 잔여 4개 중 셋은 이미 끝나 있었다 — 加工用かぶり는 `cover.fabrication.addition`으로 분리돼 골든 대조 중이고, 근거 없는 `rounding.length`는 룰팩에 없으며, 선결 조건이던 R7③(端部条件)도 `girder-ends.ts`가 直線↔折曲げ 분기와 `定着不成立` 판정으로 처리한다. 같은 날 折曲げ定着 全長의 하한이 조문(L1)이 아니라 L1h였던 것을 고쳤다(R7③-1) — 그 결과 (a)가 지배할 때 折曲げ와 直線의 全長이 같아지고, (b) 余長下限이 이기는 사례는 D13·柱560 하나로 좁혀졌다. **남은 것은 하나다**: 標準仕様書 5章 수치의 `stated` 승격 — 라벨은 `transcribed`로 정리됐고 검증 3층도 깔렸으므로 남은 건 **사람의 독립 검토**다(R6·ADR-023). 전 행에 `note: LLM転写 — 独立検討待ち`가 붙어 있고 ADR-015상 추출자＝승인자는 독립 검토가 아니므로 **에이전트가 코드로 닫을 수 없다.** 사람 검토자가 원문 PDF와 대조해야 하며, 그 대조를 싸게 만드는 표별 대조 시트가 이 항목의 실제 작업이다. 대조 단위는 룰팩 178행이 아니라 **원문 94칸·8곳**이다(원문 표가 帯 구조라 룰팩이 fc·径으로 전개해 둔 것이고, 帯 내부 전개 불일치는 0으로 확인됐다)\\\\\\\\ndocs/MILESTONES.md:9:- [x] **M3b** — 완료 (2026-08-21). **다스팬 通し筋**(2026-08-12): 산정 단위가 부재에서 **런**(같은 通り芯 위 인접 大梁의 최대 연쇄)으로 바뀌었고 단일 스팬은 길이 1인 런이다. 通し筋은 중간 접합부를 관통해 定着이 양 끝에만 붙는다 → R7② 해소. `girderSupport`와 `UnsupportedReason`의 `'連続スパン'`은 함께 제거됐다. **継手箇所数 계상과 수량 단위 유니온(kg·箇所)**(2026-08-18) → R8 해소. **カットオフ筋과 継手方式 입력**(2026-08-21): 大梁 主筋을 位置別(端部·中央)로 받고 差를 カットオフ筋으로 낸다 — 外側支点은 定着＋切り止め位置, 中間支点은 位置×2＋中間柱せい(관통), 中央은 内法−位置×2다. 근거는 積算基準 2（３）梁1)「トップ筋、ハンチ部分の主筋、補強筋等は設計図書による」이고 切り止め位置는 그래서 입력이다(ADR-021). 継手方式은 断面一覧에서 고른다 — 이제 `重ね継手` 고정이 아니다. 실검증 `tests/e2e/uc11-continuous-girder.js`·`uc13-cutoff-splice.js`. **넘긴 것**: 継手位置는 表5.3.3이 원문에서 이미지라 미확정이라 3D에 그리지 않고 고지로 상시 표시한다(M0에서 닫힌 사실이라 M3b가 풀 수 없다). あばら筋의 位置別 피치(端部@100/中央@200)는 主筋과 달리 아직 단일 값이다 — M3c 이후. **M2가 미완이므로 大梁 산출값은 아직 정식 물량이 아니다**\\\\\\\\ndocs/MILESTONES.md:10:- [ ] **M3c** — 진행 중. 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다\\\\\\\\ndocs/MILESTONES.md:11:- [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `主筋端部左右相違`로 빈칸에 남긴다(R13). 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 남은 8칸은 전부 좌우 상이(R13)다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 좌우 상이 8칸(R13), 고강도 전단보강근·円形柱 표현, 階 라벨과 제품 Story 대응, `カットオフ` 값 반영(R13 본체가 선결이며 현재는 원문 `raw` 보존까지). `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\\\\\\\\ndocs/MILESTONES.md:12:  - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — R13의 선결 조건(아래 R13 항 참조). ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조)\\\\\\\\ndocs/MILESTONES.md:13:- [ ] **부재 확장(耐震壁·床板)** — 진행 중 (2026-08-22 착수, ADR-025·ADR-028). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **남은 것**: 開口補強筋 입력(1通則8)이 設計図書에 위임 — 지금은 계상하지 않아 개구가 있는 부재가 과소 계상되고 内訳書가 상시 고지한다), 断面リスト 파서의 壁リスト·スラブリスト 대응(현재 손입력 전용), 平面 뷰에서 벽·床板을 놓고 지우는 입력(지금은 표시만), 片持床板(형상 입력이 선결)\\\\\\\\ndocs/MILESTONES.md:14:- [ ] **일본 고유 형태·제품 확장** — 진행 중 (2026-08-22 착수). 후보를 두 원문 전수 검색으로 재고 4개를 골랐다. **끝난 것**: ① **高強度せん断補強筋**(K13·S13, ADR-026) — `帯筋`·`あばら筋` 전용 呼び名이다. 두 원문에 「高強度」·「大臣認定」이 **0건**인데도 만들 수 있는 이유는 1通則2)가 フープ 長さ를 断面周長으로 정해 **径으로 引는 룰팩 행이 帯筋에 하나도 없기** 때문이다 — 룰팩 신규 행 0. 主筋·壁筋은 定着·重ね継手를 径으로 引으므로 타입(`ShearBarSize`)이 막는다. 断面リスト 파서도 읽는다. ② **円形柱**(ADR-027) — 1通則2)의 「断面の設計寸法による周長」이 円形에서는 원주 π×直径이다. 조문이 형상을 矩形으로 한정하지 않으므로 여기서도 룰팩 신규 행이 0이다. `ColumnSection.shape`(스키마 v9)로 받고 b·d를 둘 다 直径으로 둔다 — 大梁 内法·3D 柱面·平面 히트영역이 전부 b·d에서 나오므로 外接寸法을 그대로 두면 형상 추가가 계측을 흔들지 않는다. 3D는 円柱와 円形フープ(24각형 作図規則)다. `600φ`도 파싱한다. **スパイラル筋은 만들지 않는다** — 継手·定着이 図5.3.5＝이미지다. **남은 것**: ③ 雑壁(腰壁·垂れ壁·袖壁), ④ 壁式構造の壁(積算基準 2（５）壁**2)**의 端部筋·縦筋·壁梁筋·横筋·補強筋 5구분). **만들지 않는 것**: `免震`(0건, ADR-025)·スパイラル筋의 継手·定着(図5.3.5＝**이미지**라 表5.3.3과 같은 함정)·機械式定着(標準仕様書 5.3.4(ｳ)가 전부 「特記による」라 제품이 가질 값이 없다). `ガス圧接`·`機械式継手`는 M3b에서 이미 끝났다\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_11\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"A(무손실)는 원문 섹션의 줄 단위 대조에서 통과했습니다. B는 요약표의 “남은 것”을 상세 대장과 대조 중이며, 특히 도면 인식·부재 확장 행에서 누락 여부를 별도로 판정하겠습니다.\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_12\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"\\\\\\\\\\\\\\\"C:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\powershell.exe\\\\\\\\\\\\\\\" -Command 'rg -n -F \\\\\\\\\\\\\\\"10,682\\\\\\\\\\\\\\\" docs/reports/TOKEN-AUDIT-2026-08-25.md; rg -n -F \\\\\\\\\\\\\\\"10,681\\\\\\\\\\\\\\\" docs/reports/TOKEN-AUDIT-2026-08-25.md; rg -n -F \\\\\\\\\\\\\\\"$0.18\\\\\\\\\\\\\\\" docs/reports/TOKEN-AUDIT-2026-08-25.