ems.test.ts:151:    sha256: '6d4b0f806b429a0103facf10189f75ef87568303459759fbc2826988fc037c8f',\r\ntests\\section-import\\textitems.test.ts:199:  return JSON.parse(readFileSync(fixturePath, 'utf8')) as TextItemFixture\r\ntests\\section-import\\textitems.test.ts:387:      sha256: spec.sha256,\r\ntests\\rulepack\\review-sheet.test.ts:3:import { describe, expect, it } from 'vitest'\r\ntests\\rulepack\\review-sheet.test.ts:106:    const snapshot = readFileSync(\r\ntests\\golden\\fabrication-length.test.ts:1:import { describe, expect, it } from 'vitest'\r\ntests\\section-import\\real-pdf.test.ts:6:import { describe, expect, it } from 'vitest'\r\ntests\\section-import\\real-pdf.test.ts:75:  const sources = readFileSync(\r\ntests\\section-import\\real-pdf.test.ts:82:  const sha256 = row?.match(/`([a-f\\d]{64})`/u)?.[1]\r\ntests\\section-import\\real-pdf.test.ts:84:  if (!sha256) throw new Error(`SHA-256 not found in SOURCES.md: ${cacheFile}`)\r\ntests\\section-import\\real-pdf.test.ts:85:  return sha256\r\ntests\\section-import\\real-pdf.test.ts:89:  const data = readFileSync(resolve(cacheDirectory, cacheFile))\r\ntests\\section-import\\real-pdf.test.ts:91:  expect(createHash('sha256').update(data).digest('hex')).toBe(\r\ntests\\section-import\\real-pdf.test.ts:125:    readFileSync(\r\ntests\\section-import\\real-pdf.test.ts:150:describe.skipIf(available.length === 0)(\r\ntests\\scaffold.test.ts:4:import { describe, expect, it } from 'vitest'\r\ntests\\scaffold.test.ts:7:  JSON.parse(readFileSync(resolve(process.cwd(), path), 'utf8'))\r\ntests\\section-import\\parse.test.ts:4:import { describe, expect, it } from 'vitest'\r\ntests\\section-import\\parse.test.ts:25:    readFileSync(fixturePath, 'utf8'),\r\ntests\\section-import\\parse.test.ts:37:  return JSON.parse(readFileSync(fixturePath, 'utf8')) as T\r\ntests\\golden\\spec-tables.test.ts:1:import { describe, expect, it } from 'vitest'\r\nsrc\\instrumentation-client.test.ts:3:import { afterEach, beforeEach, describe, expe