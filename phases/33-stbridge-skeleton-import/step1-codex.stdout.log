\"9\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"3\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\"],[\\\\\\\"2\\\\\\\",\\\\\\\"6\\\\\\\",\\\\\\\"9\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"8\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"8\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"6\\\\\\\",\\\\\\\"9\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"3\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"9\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"3\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"9\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"3\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"8\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"4\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"3\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"9\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"2\\\\\\\",\\\\\\\"3\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"5\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"1\\\\\\\",\\\\\\\"0\\\\\\\",\\\\\\\"0\\\\\\\"]]\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_28\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"npx tsx -e \\\\\\\\\\\\\\\"import {readFileSync} from 'node:fs'; import {verticalRuns} from './src/lib/import/runs.ts'; const files=['kani-p38.json','kani-p40.json','ojkk-p2.json','ojkk-p3.json','yokohama-p13.json','yokohama-p14.json','yokohama-p7.json','yokohama-p8.json']; const page=(f)=>JSON.parse(readFileSync('tests/fixtures/section-import/textitems/'+f,'utf8')).items; const ratios=[1.5,0.8,0.5,0.3]; for(const f of files){const outs=ratios.map(r=>verticalRuns(page(f),r).map(x=>x.text).filter(x=>/\\\\\\\"'^[0-9,]+$/.test(x))); console.log(f, outs.map(x=>x.length+'\\\\\\\"':'+x.filter(y=>Number.parseInt(y.replaceAll(',',''),10)<=0).length).join(' | '));}\\\\\\\\\\\\\\\"\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"kani-p38.json 60:0 | 243:110 | 243:110 | 243:110\\\\nkani-p40.json 28:0 | 136:28 | 136:28 | 136:28\\\\nojkk-p2.json 19:0 | 57:38 | 57:38 | 57:38\\\\nojkk-p3.json 32:0 | 96:57 | 96:57 | 96:57\\\\nyokohama-p13.json 0:0 | 0:0 | 0:0 | 0:0\\\\nyokohama-p14.json 0:0 | 0:0 | 0:0 | 0:0\\\\nyokohama-p7.json 13:0 | 257:55 | 257:55 | 257:55\\\\nyokohama-p8.json 25:0 | 80:33 | 80:33 | 80:33\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_29\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"측정 결과를 확인했습니다. `[XY]숫자`를 포함한 세그먼트는 `yokohama-p14` 12개, `yokohama-p13`·`ojkk-p2`·`ojkk-p3` 각 0개입니다. 세로 문턱은 1.5/0.8/0.5/0.3 모두 0mm 후보 0건이지만, 0.8 이하에서는 회전 런이 문자 단위로 갈라져 2자리 이상을 요구하는 `DIMENSION_PATTERN`에서 탈락하는 현상까지 확인했습니다. 따라서 세로 가드는 민감도를 증명한 것이 아니라 관측하지 못한 것입니다.\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_30\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\tests\\\\\\\\plan-import\\\\\\\\parse.test.ts\\\",\\\"kind\\\":\\\"update\\\"}],\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_30\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\tests\\\\\\\\plan-import\\\\\\\\parse.test.ts\\\",\\\"kind\\\":\\\"update\\\"}],\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_31\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\docs\\\\\\\\ADR.md\\\",\\\"kind\\\":\\\"update\\\"}],\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_31\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\docs\\\\\\\\ADR.md\\\",\\\"kind\\\":\\\"update\\\"}],\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_32\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'Get-Content -Encoding utf8 docs/RISKS.md | Select-Object -Last 4'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_33\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Get-Content -Encoding utf8 docs/RISKS.md | Select-String -Pattern '\\\\\\\"'^'\\\\\\\"\\\\\\\\\\\\\\\\- \\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\*R11' | ForEach-Object { \\\\\\\"'$_.Line }'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_34\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Get-Content -Encoding utf8 docs/ADR.md | Select-String -Pattern '트랙 정리|스팬 1본 축의 실태|근거 없이 문턱' | ForEach-Object { '{0}: {1}' -f \\\\\\\"'$_.LineNumber, $_.Line }'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_32\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command 'Get-Content -Encoding utf8 docs/RISKS.md | Select-Object -Last 4'\\\",\\\"aggregated_output\\\":\\\"- **R13 (端部 左右 비대칭 断面リスト 미지원)** 「Y3端／Y4端」·「外端／内端」처럼 좌우 端部의 主筋 本数가 다른 표는 취입하지 않는다. 제품의 `Grid`가 通り芯 라벨을 갖지 않아 어느 쪽이 런의 始端인지 결정할 수 없고, 결정하면 도면에 없는 방향을 제품이 만드는 것이다(ADR-004·ADR-021). 파서는 값을 지어내지 않고 `主筋端部左右相違`로 빈칸+원문에 남기며, 사용자는 断面一覧에서 직접 채울 수 있다 — 다만 모델의 `GirderMainRow`도 양단 동값만 담으므로 **비대칭은 손으로도 입력할 수 없다.** 실측 3부 중 8칸(전부 yokohama)이 여기 걸리고, 이는 도면 인식 미반영 16칸의 최대 항목이다. 닫으려면 `Grid`에 通り芯 라벨을 넣고 런의 방향을 도면과 맞추는 별건이 선결이다 (2026-08-22 식별). **2026-08-23: 선결 조건이 닫혔다.** `Grid.xLabels`·`yLabels`(둘 다 optional ＝ 「도면에서 읽은 이름이 없다」)가 들어갔고, 伏図 취입이 도면의 원문을 그대로 싣는다(실측 `bX1·bX2·bX3·cX1`). schemaVersion은 올리지 않았다 — 版을 올리는 기준은 「같은 案件의 数量이 달라지는가」인데(v11 주석) 이름은 数量을 바꾸지 않고, 올리면 기존 기록이 전부 버려진다. 平面 에디터의 스팬은 이제 `bX1-bX2`로 불린다(이름이 없으면 `Xスパン 1`로 — index로 이름을 지어내지 않는다). **R13 자체는 여전히 열려 있다**: 남은 것은 `GirderMainRow`가 양단 동값만 담는다는 모델 제약이고, 그것을 푸는 일은 端部별 카ットオフ筋을 산정·物量·3D·加工長 골든에 걸쳐 바꾸는 **마일스톤급**이라 별건이다\\\\r\\\\n- **R14 (해소 — 開口部 欠除)** `数量積算基準` 1通則8)은 開口部에 의한 鉄筋의 欠除를 「建具類等開口部の内法寸法による、ただし1か所当たり内法面積0.5㎡以下は欠除なし」로 정하고 開口補強筋은 「設計図書により計測・計算する」로 위임한다. 2026-08-22까지는 開口의 위치·치수를 받는 입력이 없어 개구가 있는 벽·床板이 **과대 계상**됐다 — 이 프로젝트가 못 견디는 실패(「틀린 채로 완성된 것」)의 첫 자리라 빈칸으로 두지 않고 内訳書에 상시 고지를 세워 두었다. **`Member.openings` 입력과 `openingDeduction`으로 닫혔다 (ADR-029)** — 픽스처의 `1通則8)`이 `deferred`에서 `covered`로 넘어갔고, 고지는 지우지 않고 **문면을 뒤집었다**. **잔여 하나**: 開口補強筋을 계상하지 않으므로 개구가 있는 부재는 이제 **과소** 계상이다. 조문이 값을 주지 않고 設計図書에 위임하므로 제품이 지어낼 수 없고(2（３）梁1)·2（４）床板1)의 「補強筋等は設計図書による」와 같은 취급), 닫으려면 도면에서 읽은 補強筋을 그대로 옮겨 적는 입력이 필요하다. **판정에 남은 읽기**: 「어느 본이 欠けるか」를 원문이 말하지 않아 1通則7)의 割付을 위치로 읽었다 — 세는 시작 끝이 정해져 있지 않아 개구가 부재 중앙에 없을 때 1본 차가 날 수 있다 (R2)\\\\r\\\\n- **R11 (리뷰 게이트가 자기를 못 지킨다)** `pull_request` 워크플로는 PR 브랜치 판으로 실행되므로 `.github/workflows/review.yml` 과 `scripts/ci/*` 를 고치는 PR 은 자기 게이트를 무력화해 무리뷰 자동 머지를 낼 수 있다. **워크플로 안의 수정으로는 닫히지 않는다** — `ref: base.sha` 든 `git checkout base -- scripts/ci/` 든 그 줄 자체가 PR 통제 파일에 있다. 실질 방어는 단독 writer 라는 사실 하나뿐이다(포크 PR 은 읽기 전용 토큰이라 무해). main 브랜치 보호에 `required_pull_request_reviews` 는 걸려 있지 않고 `enforce_admins: false` 다. 닫으려면 gate 와 scope 를 **함께** `workflow_run` 으로 옮겨 기본 브랜치 판 고정 실행해야 한다 — gate 만 옮기면 PR 이 통제하는 scope 잡이 봇 명의·같은 커밋의 위조 마커를 게시해 `review-verdict.sh` 의 작성자·커밋 검사를 그대로 통과한다. **두 번째 writer 가 생기는 시점의 조건부 과제**로 둔다 (2026-08-19 판단)\\\\r\\\\n\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_34\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Get-Content -Encoding utf8 docs/ADR.md | Select-String -Pattern '트랙 정리|스팬 1본 축의 실태|근거 없이 문턱' | ForEach-Object { '{0}: {1}' -f \\\\\\\"'$_.LineNumber, $_.Line }'\\\",\\\"aggregated_output\\\":\\\"414: **트랙 정리 (2026-08-25)**: 伏図 트랙은 `src/lib/import/framing-plan/` 하나로 정리했고, 경쟁 구현이었던 ADR-031은 폐지했다. 그 대가로 framing-plan은 合計를 선택적 검산으로 사용한다(`totalConfirmed`). 단, 合計가 있으면 스팬 합과 대조하고 어긋날 때 `合計不一致`로 후보를 거절한다. 따라서 合計가 없는 도면도 위치 정합과 축척 일관성이 성립하면 그리드 후보를 낸다 — ADR-031이 合計 없는 도면을 막던 자리가 열려 있다는 사실을 남긴다.\\\\r\\\\n416: **스팬 1본 축의 실태**: ADR-031 ③-2의 관측, 즉 스팬 1본 축에서는 「스팬의 합 ＝ 合計」가 원리상 아무것도 배제하지 못한다는 점은 framing-plan에도 그대로 성립한다. 다만 옛 `grid-parse`는 合計 검산이 유일한 장치라 1본 축을 통째로 `区間数不足`으로 거절할 수밖에 없었고, framing-plan에는 중점 매칭(±15pt)과 축척 일관성이 있어 1본에서도 확인하는 것이 남는다. 축척 일관성은 스팬이 하나면 대조 상대가 없으므로, 1본 축에서 실제로 남는 검증은 중점 매칭 하나다. `断面リスト` 페이지가 격자를 내지 않는 이유도 스팬 수가 아니라 세그먼트 전체를 설명하지 못하는 sticky 라벨 패턴(`X2端` 등) 때문이다.\\\\r\\\\n418: 근거 없이 문턱을 조이는 변경은 이 결정의 범위가 아니다.\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_33\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\WINDOWS\\\\\\\\\\\\\\\\System32\\\\\\\\\\\\\\\\WindowsPowerShell\\\\\\\\\\\\\\\\v1.0\\\\\\\\\\\\\\\\powershell.exe\\\\\\\" -Command \\\\\\\"Get-Content -Encoding utf8 docs/RISKS.md | Select-String -Pattern '\\\\\\\"'^'\\\\\\\"\\\\\\\\\\\\\\\\- \\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\*R11' | ForEach-Object { \\\\\\\"'$_.Line }'\\\",\\\"aggregated_output\\\":\\\"- **R11 (리뷰 게이트가 자기를 못 지킨다)** `pull_request` 워크플로는 PR 브랜치 판으로 실행되므로 `.github/workflows/review.yml` 과 `scripts/ci/*` 를 고치는 PR 은 자기 게이트를 무력화해 무리뷰 자동 머지를 낼 수 있다. **워크플로 안의 수정으로는 닫히지 않는다** — `ref: base.sha` 든 `git checkout base -- scripts/ci/` 든 그 줄 자체가 PR 통제 파일에 있다. 실질 방어는 단독 writer 라는 사실 하나뿐이다(포크 PR 은 읽기 전용 토큰이라 무해). main 브랜치 보호에 `required_pull_request_reviews` 는 걸려 있지 않고 `enforce_admins: false` 다. 닫으려면 gate 와 scope 를 **함께** `workflow_run` 으로 옮겨 기본 브랜치 판 고정 실행해야 한다 — gate 만 옮기면 PR 이 통제하는 scope 잡이 봇 명의·같은 커밋의 위조 마커를 게시해 `review-verdict.sh` 의 작성자·커밋 검사를 그대로 통과한다. **두 번째 writer 가 생기는 시점의 조건부 과제**로 둔다 (2026-08-19 판단)\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_35\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"C:\\\\\\\\Users\\\\\\\\emper\\\\\\\\mdtproject\\\\\\\\docs\\\\\\\\RISKS.md\\\",\\\"kind\\\":\\\"update\\\"}],\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_35\\\",\\\"type\\\":\\\"fil