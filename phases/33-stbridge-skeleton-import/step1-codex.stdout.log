제 7건 중 7건 upheld·0건 refuted; 반증 id 없음. 4개 .stb의 축·階 실측과 원점·노드 불일치·빈 NodeIdList·전 요소 인구조사를 모두 기록했다.\"\r\n                  },\r\n                  {\r\n                      \"step\":  1,\r\n                      \"name\":  \"stb-corpus-and-decode\",\r\n                      \"status\":  \"pending\",\r\n                      \"started_at\":  \"2026-08-28T12:21:59+0900\"\r\n                  },\r\n                  {\r\n                      \"step\":  2,\r\n                      \"name\":  \"stb-document-ir\",\r\n                      \"status\":  \"pending\"\r\n                  },\r\n                  {\r\n                      \"step\":  3,\r\n                      \"name\":  \"stb-skeleton-candidates\",\r\n                      \"status\":  \"pending\"\r\n                  },\r\n                  {\r\n                      \"step\":  4,\r\n                      \"name\":  \"refute-stb-skeleton\",\r\n                      \"kind\":  \"verify\",\r\n                      \"gate\":  true,\r\n                      \"status\":  \"pending\"\r\n                  },\r\n                  {\r\n                      \"step\":  5,\r\n                      \"name\":  \"record-corpus-limits\",\r\n                      \"status\":  \"pending\"\r\n                  }\r\n              ],\r\n    \"created_at\":  \"2026-08-28T12:07:46+0900\"\r\n}\r\n{\r\n    \"keys\":  \"premises,corpus,xsd,skeleton_attr_sets,skeleton_attr_sets_all_declared,encoding_probe,environment_probe,axis_groups,element_census,axes,axis_node_mismatch,empty_node_list_axes,stories,nodes,unsupported_axis_kinds,files_without_stb_axes,next_phase_facts,gh_search,verdict,summary\",\r\n    \"sources\":  {\r\n\r\n                },\r\n    \"skeleton_attr_sets\":  \"{\\r\\n    \\\"2.0.1\\\":  {\\r\\n                  \\\"StbCommon\\\":  [\\r\\n                                    \\\"project_name\\\"\\r\\n                                ],\\r\\n                  \\\"StbNode\\\":  [\\r\\n                                  