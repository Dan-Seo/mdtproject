] {\\\\n708-  const gradeBands = [...new Set(BEND_CELL_SPECS.map((spec) => spec.gradeLabel))]\\\\n709-  return [\\\\n710-    '| 鉄筋種類帯 \\\\\\\\\\\\\\\\ 径帯 | D16以下 | D19〜D38 |',\\\\n711-    '|---|---:|---:|',\\\\n--\\\\n727-    }),\\\\n728-  ]\\\\n729-}\\\\n730-\\\\n731:function renderMemberGroup(group: FoldedGroup): string[] {\\\\n732-  return [\\\\n733-    '| 원문 부재帯 | 나머지 조건 | 값 |',\\\\n734-    '|---|---|---:|',\\\\n735-    ...group.cells.map(\\\\n--\\\\n738-    ),\\\\n739-  ]\\\\n740-}\\\\n741-\\\\n742:function renderGenericGroup(group: FoldedGroup): string[] {\\\\n743-  return [\\\\n744-    '| 조건 | 값 |',\\\\n745-    '|---|---:|',\\\\n746-    ...group.cells.map(\\\\n--\\\\n749-    ),\\\\n750-  ]\\\\n751-}\\\\n752-\\\\n753:function renderGroup(group: FoldedGroup): string[] {\\\\n754-  const lines = [\\\\n755-    `### ${group.tableName} — \\\\\\\\`${group.key}\\\\\\\\``,\\\\n756-    '',\\\\n757-    sourceLine(group),\\\\n758-    `룰팩 전개 행: ${group.originalCount} / 대조 시트 셀: ${group.foldedCount}`,\\\\n759-    '',\\\\n760-  ]\\\\n761:  if (group.kind === 'fc-band') lines.push(...renderFcGroup(group))\\\\n762:  else if (group.kind === 'size-band') lines.push(...renderSizeGroup(group))\\\\n763:  else if (group.key === 'bend.inside-diameter') lines.push(...renderBendGroup(group))\\\\n764:  else if (group.kind === 'member-kind') lines.push(...renderMemberGroup(group))\\\\n765:  else lines.push(...renderGenericGroup(group))\\\\n766-  lines.push('', replyLine())\\\\n767-  if (group.missingCells.length > 0) {\\\\n768-    lines.push(`결번: ${group.missingCells.join(' / ')}`)\\\\n769-  }\\\\n770-  lines.push('')\\\\n771-  return lines\\\\n772-}\\\\n773-\\\\n774:export function renderReviewSheet(pack: RulePack): string {\\\\n775-  const sheet = foldRulePack(pack)\\\\n776-  const lines = [\\\\n777-    '# 룰팩 원문 표 단위 대조 시트',\\\\n778-    '',\\\\n--\\\\n783-    `- 룰팩 전체 행: ${sheet.originalRowCount}`,\\\\n784-    `- 되접은 검토 셀: ${sheet.foldedRowCount}`,\\\\n785-    `- 표·조항 단위: ${sheet.tableCount}`,\\\\n786-    `- 단발항: ${sheet.singletonCount}`,\\\\n787:    `- 기존 재대조 표식: ${sheet.verification.reviewCellCount}칸`,\\\\n788:    `- ${sheet.verification.note}`,\\\\n789-    '',\\\\n790-    '## 검토 순서',\\\\n791-    '',\\\\n792-    '1. `表5.3.2`와 `表5.3.4`의 L1·L1h가 한 칸도 빠짐없이 같은지 확인한다. 원문이 정말 같은지, 전사 때 복사됐는지에 따라 다수 행이 한꺼번에 좌우된다.',\\\\n--\\\\n797-    '',\\\\n798-  ]\\\\n799-\\\\n800-  for (const group of sheet.groups.filter(isTableLike)) {\\\\n801:    lines.push(...renderGroup(group))\\\\n802-  }\\\\n803-\\\\n804-  lines.push('## 단발항', '', '표·조항帯로 되접지 않는 항은 한 줄씩 검토한다.', '')\\\\n805-  for (const group of sheet.groups.filter((candidate) => candidate.kind === 'single')) {\\\\n806-    const cell = group.cells[0]\\\\n807-    if (!cell) continue\\\\n808-    lines.push(\\\\n809:      `- \\\\\\\\`${group.key}\\\\\\\\` — ${formatValue(cell.representative)} / 조건 ${formatConditions(cell.representative.conditions)} / ${sourceLine(group)}${cell.verification ? ' / ※既存再対照（agent・独立検討ではない）' : ''}`,\\\\n810-    )\\\\n811-  }\\\\n812-  lines.push('', replyLine(), '')\\\\n813-\\\\n--\\\\n827-    name: 'rulepack-yaml-raw',\\\\n828-    load(id: string): string | null {\\\\n829-      const path = id.split('?', 1)[0]\\\\n830-      if (!path.endsWith('.yaml')) return null\\\\n831:      return `export default ${JSON.stringify(readFileSync(path, 'utf8'))}`\\\\n832-    },\\\\n833-  }\\\\n834-  const server = await createServer({\\\\n835-    root: process.cwd(),\\\\n--\\\\n840-  try {\\\\n841-    const rulepackModule = await server.ssrLoadModule('/src/rulepack/index.ts') as {\\\\n842-      jpMlitRulePack: RulePack\\\\n843-    }\\\\n844:    process.stdout.write(renderReviewSheet(rulepackModule.jpMlitRulePack))\\\\n845-  } finally {\\\\n846-    await server.close()\\\\n847-  }\\\\n848-}\\\\n--- milestone M2 lines ---\\\\r\\\\nCLAUDE.md-18-- CRITICAL: **사용자 도면 데이터를 서버로 보내지 말 것.** 모든 계산은 브라우저에서. 서버 저장·전송 코드를 만들지 않는다. 예외는 둘이며 둘 다 도면 데이터와 무관하다 — 운영 알림 수신 라우트 `src/app/api/oncall/alert`(ADR-017)와 브라우저 텔레메트리 `src/lib/telemetry.ts`(ADR-020, `before_send`가 허용목록으로 동작해 예외 메시지 자체를 싣지 않는다).\\\\r\\\\nCLAUDE.md-19-- CRITICAL: **출처 표시는 법적 의무다.** 근거 자료는 PDL1.0 준거로 출처 표시와 개변 사실 표시가 요구된다. UI 하단 고지와 룰팩 `source` 필드를 제거하지 말 것.\\\\r\\\\nCLAUDE.md-20-- 도메인 용어는 일본어 원어를 그대로 쓴다: `柱`, `大梁`, `主筋`, `帯筋`, `あばら筋`, `定着`, `重ね継手`, `かぶり厚さ`, `SD345`, `Fc24`, `D13`. 한국어로 번역하지 말 것 (ADR-008).\\\\r\\\\nCLAUDE.md:21:- 부재는 `柱`·`大梁`·`耐震壁`·`床板` 넷. `耐震壁`은 `数量積算基準` 2（５）壁 **1)「壁式構造以外」**만이고 縦筋·横筋 둘뿐이다 — 壁의 幅止め筋(本数 조문 없음)·`壁式構造の壁`(2))은 만들지 않았다 (ADR-025). `床板`은 2（４）床板으로 재고 X·Y 방향의 上端筋·下端筋 넷을 낸다 — 片持床板은 ADR-039(phase 27)로 들어왔고, 두 원문에서 0건인 것은 `配力筋`뿐이다. **開口部는 두 부재 모두 1通則8)로 欠除한다** — `Member.openings` 입력이고, 開口補強筋만 「設計図書により計測・計算する」라 만들지 않는다 (ADR-029). `基礎`·`小梁`·`雑壁` 코드는 여전히 미리 만들지 말 것. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다 (ADR-005·ADR-025·ADR-028).\\\\r\\\\nCLAUDE.md-22-- 할증률 조회는 부재 구분을 인자로 받는다. 躯体 4%이고 흙막이벽·말뚝은 3%이므로, 범위 밖이 들어오면 기본값 4%를 주지 말고 실패시킬 것 (ADR-014).\\\\r\\\\nCLAUDE.md-23-- 파생 상태(`Rebar[]`, `QuantityLine[]`)를 스토어에 저장하지 말 것. `Project`에서 계산한다.\\\\r\\\\nCLAUDE.md-24-- `Project`는 순수 JSON으로 직렬화 가능해야 한다. 클래스 인스턴스·함수·Date 객체를 넣지 말 것.\\\\r\\\\n--\\\\nCLAUDE.md-29-- CRITICAL: **검증은 교차로 한다 — 만든 쪽이 자기 것을 승인하지 않는다.** 룰팩의 `stated` 승격이 「전사자＝승인자는 독립 검토가 아니다」로 막혀 있는 것(ADR-015·ADR-023)과 같은 원리를 코드에도 적용한다. ① **codex가 구현한 것은 Claude가 검증한다** — `index.json`의 `completed`와 스텝 summary는 **자기 보고**다. AC가 통과했다는 말도 codex가 한 말이다. Claude는 phase 브랜치의 diff를 직접 읽고 「사양의 금지사항을 어겼는가 / 사양에 없는 것을 만들었는가 / 테스트가 반증 가능한가(구현을 흔들면 실패하는가)」 셋을 대조한 뒤에야 main에 넣는다. ② **Claude가 직접 쓴 것은 codex가 검증한다** — 문서·사양·인계 편집분은 다음 phase의 **검증 전용 스텝**으로 넘긴다. 고치라고 하지 말고 **반증하라**고 한다(어긋나면 `error`로 두고 무엇이 어긋났는지 적게 한다). 고치게 하면 검증자가 다시 구현자가 되어 교차가 무너진다. ③ 어느 쪽이든 「돌려봤다」·「통과했다」는 검증이 아니다. 검증 항목은 **틀렸을 때 실패하는 것**이어야 한다. 2026-08-23 phase 7이 전 AC를 통과한 채로 값을 지어내는 경로를 하나 남겼고, 그것을 잡은 것은 AC가 아니라 Claude가 따로 돌린 반례였다.\\\\r\\\\nCLAUDE.md-30-- CRITICAL: 새 기능 구현 시 반드시 테스트를 먼저 작성하고, 테스트가 통과하는 구현을 작성할 것 (TDD)\\\\r\\\\nCLAUDE.md-31-- CRITICAL: 규준 관련 기능은 **골든테스트 먼저**. `標準仕様書`·`수량적산기준`의 표 값을 `tests/golden/`에 픽스처로 박고, 엔진 출력이 한 칸이라도 다르면 실패하게 한다. 픽스처에는 출처 쪽·표를 함께 적을 것 — 사후 대조의 유일한 단서다.\\\\r\\\\nCLAUDE.md:32:- 마일스톤 순서를 건너뛰지 말 것. M0(스파이크) → M1(워킹 스켈레톤) → M2(룰팩) → M3a(단일 스팬 大梁·뷰어) → M3b(다스팬·継手) → M3c(고유 상세) → M4(확장) → M5(UX 리뷰). 도면 인식(로컬)은 M3a 이후 병행 가능한 별도 트랙 — 입력 파이프라인이라 산정 로직 마일스톤과 코드 영역이 겹치지 않는다 (ADR-018)\\\\r\\\\nCLAUDE.md-33-- 마일스톤 현황(`docs/MILESTONES.md`)·열린 리스크(`docs/RISKS.md`)의 **수치는 손으로 갱신하므로 코드보다 뒤처진다.** 인용하기 전에 코드로 대조할 것 — 여러 세션·worktree 가 같은 main 을 밀고 있어 컨텍스트에 들어온 사본이 디스크보다 오래된 경우도 있다(`git log --oneline -3` 로 실제 HEAD 확인)\\\\r\\\\nCLAUDE.md-34-- 커밋 메시지는 conventional commits 형식을 따를 것 (feat:, fix:, docs:, refactor:)\\\\r\\\\nCLAUDE.md-35-- CRITICAL: **의존 관계가 없는 툴 호출은 한 메시지에 묶을 것.** 세션 로그 실측에서 툴 호출 메시지 10,682건 중 10,681건(100.0%)이 단일 호출이었다 — 호출 한 번의 값은 명령의 길이가 아니라 그 시점의 컨텍스트 크기가 정하므로(실측 회당 $0.18) 읽기 둘을 따로 보내면 값이 두 배다. `git log`·`grep`·`cat`처럼 서로 읽지 않는 명령은 한 번에 보낸다. 앞 결과가 뒤 명령의 인자를 정하는 경우만 나눈다. 근거는 `docs/reports/TOKEN-AUDIT-2026-08-25.md`\\\\r\\\\n--\\\\nCLAUDE.md-48-|---|---|---|\\\\r\\\\nCLAUDE.md-49-| M0 스파이크 | 완료 | — |\\\\r\\\\nCLAUDE.md-50-| M1 워킹 스켈레톤 | 완료 | — |\\\\r\\\\nCLAUDE.md:51:| M2 룰팩 | **진행 중** | 標準仕様書 5章의 `stated` 승격. **사람의 독립 검토**라 에이전트가 코드로 닫을 수 없다 (R6) |\\\\r\\\\nCLAUDE.md-52-| M3a 단일 스팬 大梁·뷰어 | 완료 | — |\\\\r\\\\nCLAUDE.md-53-| M3b 다스팬·継手 | 완료 | — |\\\\r\\\\nCLAUDE.md-54-| M3c 고유 상세 | **진행 중** | 幅止め筋·腹筋 완료. パネルゾーン帯筋·溶接閉鎖フープ는 두 원문 0건이라 만들지 않는다 |\\\\r\\\\n--\\\\nCLAUDE.md-59-| M5 한국 실무자 UX 리뷰 | 미착수 | — |\\\\r\\\\nCLAUDE.md-60-\\\\r\\\\nCLAUDE.md-61-마일스톤 순서를 건너뛰지 말 것. 도면 인식은 M3a 이후 병행 가능한 별도 트랙이다 (ADR-018).\\\\r\\\\nCLAUDE.md:62:**M2가 미완이므로 산출값은 아직 정식 물량이 아니다.**\\\\r\\\\nCLAUDE.md-63-\\\\r\\\\nCLAUDE.md-64-## 열린 리스크\\\\r\\\\nCLAUDE.md-65-근거·경위·수치는 **`docs/RISKS.md`**에 있다. 아래는 「무엇이 열려 있는가」 대장이다.\\\\r\\\\nCLAUDE.md-66-\\\\r\\\\nCLAUDE.md-67-| | 상태 | 한 줄 |\\\\r\\\\nCLAUDE.md-68-|---|---|---|\\\\r\\\\nCLAUDE.md:69:| R1 | 종결 | `標準詳細図`에 구조 배근 상세가 없다 → 근거는 `標準仕様書 5章`이 유일 |\\\\r\\\\nCLAUDE.md-70-| R2 | 열림 | 조문에 없는 관행(暗黙知)은 영구 미검증 → `confidence: inferred`로 축적 |\\\\r\\\\nCLAUDE.md-71-| R3 | 열림 | 일본 사용자 접점 0 |\\\\r\\\\nCLAUDE.md-72-| R4 | 해소 | 층당 1만 개 규모를 `InstancedMesh`가 견딘다(5층 45,885 실측). 계측 조건에 함정 둘 |\\\\r\\\\n--\\\\nAGENTS.md-21-- CRITICAL: **사용자 도면 데이터를 서버로 보내지 말 것.** 모든 계산은 브라우저에서. 서버 저장·전송 코드를 만들지 않는다. 예외는 둘이며 둘 다 도면 데이터와 무관하다 — 운영 알림 수신 라우트 `src/app/api/oncall/alert`(ADR-017)와 브라우저 텔레메트리 `src/lib/telemetry.ts`(ADR-020, `before_send`가 허용목록으로 동작해 예외 메시지 자체를 싣지 않는다).\\\\r\\\\nAGENTS.md-22-- CRITICAL: **출처 표시는 법적 의무다.** 근거 자료는 PDL1.0 준거로 출처 표시와 개변 사실 표시가 요구된다. UI 하단 고지와 룰팩 `source` 필드를 제거하지 말 것.\\\\r\\\\nAGENTS.md-23-- 도메인 용어는 일본어 원어를 그대로 쓴다: `柱`, `大梁`, `主筋`, `帯筋`, `あばら筋`, `定着`, `重ね継手`, `かぶり厚さ`, `SD345`, `Fc24`, `D13`. 한국어로 번역하지 말 것 (ADR-008).\\\\r\\\\nAGENTS.md:24:- 부재는 `柱`·`大梁`·`耐震壁`·`床板` 넷. `耐震壁`은 `数量積算基準` 2（５）壁 **1)「壁式構造以外」**만이고 縦筋·横筋 둘뿐이다 — 壁의 幅止め筋(本数 조문 없음)·`壁式構造の壁`(2))은 만들지 않았다 (ADR-025). `床板`은 2（４）床板으로 재고 X·Y 방향의 上端筋·下端筋 넷을 낸다 — 片持床板은 ADR-039(phase 27)로 들어왔고, 두 원문에서 0건인 것은 `配力筋`뿐이다. **開口部는 두 부재 모두 1通則8)로 欠除한다** — `Member.openings` 입력이고, 開口補強筋만 「設計図書により計測・計算する」라 만들지 않는다 (ADR-029). `基礎`·`小梁`·`雑壁` 코드는 여전히 미리 만들지 말 것. 콘크리트·거푸집 물량도 내지 않는다 — 철근만이다 (ADR-005·ADR-025·ADR-028).\\\\r\\\\nAGENTS.md-25-- 할증률 조회는 부재 구분을 인자로 받는다. 躯体 4%이고 흙막이벽·말뚝은 3%이므로, 범위 밖이 들어오면 기본값 4%를 주지 말고 실패시킬 것 (ADR-014).\\\\r\\\\nAGENTS.md-26-- 파생 상태(`Rebar[]`, `QuantityLine[]`)를 스토어에 저장하지 말 것. `Project`에서 계산한다.\\\\r\\\\nAGENTS.md-27-- `Project`는 순수 JSON으로 직렬화 가능해야 한다. 클래스 인스턴스·함수·Date 객체를 넣지 말 것.\\\\r\\\\n--\\\\nAGENTS.md-32-- CRITICAL: **검증은 교차로 한다 — 만든 쪽이 자기 것을 승인하지 않는다.** 룰팩의 `stated` 승격이 「전사자＝승인자는 독립 검토가 아니다」로 막혀 있는 것(ADR-015·ADR-023)과 같은 원리를 코드에도 적용한다. ① **codex가 구현한 것은 Claude가 검증한다** — `index.json`의 `completed`와 스텝 summary는 **자기 보고**다. AC가 통과했다는 말도 codex가 한 말이다. Claude는 phase 브랜치의 diff를 직접 읽고 「사양의 금지사항을 어겼는가 / 사양에 없는 것을 만들었는가 / 테스트가 반증 가능한가(구현을 흔들면 실패하는가)」 셋을 대조한 뒤에야 main에 넣는다. ② **Claude가 직접 쓴 것은 codex가 검증한다** — 문서·사양·인계 편집분은 다음 phase의 **검증 전용 스텝**으로 넘긴다. 고치라고 하지 말고 **반증하라**고 한다(어긋나면 `error`로 두고 무엇이 어긋났는지 적게 한다). 고치게 하면 검증자가 다시 구현자가 되어 교차가 무너진다. ③ 어느 쪽이든 「돌려봤다」·「통과했다」는 검증이 아니다. 검증 항목은 **틀렸을 때 실패하는 것**이어야 한다. 2026-08-23 phase 7이 전 AC를 통과한 채로 값을 지어내는 경로를 하나 남겼고, 그것을 잡은 것은 AC가 아니라 Claude가 따로 돌린 반례였다.\\\\r\\\\nAGENTS.md-33-- CRITICAL: 새 기능 구현 시 반드시 테스트를 먼저 작성하고, 테스트가 통과하는 구현을 작성할 것 (TDD)\\\\r\\\\nAGENTS.md-34-- CRITICAL: 규준 관련 기능은 **골든테스트 먼저**. `標準仕様書`·`수량적산기준`의 표 값을 `tests/golden/`에 픽스처로 박고, 엔진 출력이 한 칸이라도 다르면 실패하게 한다. 픽스처에는 출처 쪽·표를 함께 적을 것 — 사후 대조의 유일한 단서다.\\\\r\\\\nAGENTS.md:35:- 마일스톤 순서를 건너뛰지 말 것. M0(스파이크) → M1(워킹 스켈레톤) → M2(룰팩) → M3a(단일 스팬 大梁·뷰어) → M3b(다스팬·継手) → M3c(고유 상세) → M4(확장) → M5(UX 리뷰). 도면 인식(로컬)은 M3a 이후 병행 가능한 별도 트랙 — 입력 파이프라인이라 산정 로직 마일스톤과 코드 영역이 겹치지 않는다 (ADR-018)\\\\r\\\\nAGENTS.md-36-- 마일스톤 현황(`docs/MILESTONES.md`)·열린 리스크(`docs/RISKS.md`)의 **수치는 손으로 갱신하므로 코드보다 뒤처진다.** 인용하기 전에 코드로 대조할 것 — 여러 세션·worktree 가 같은 main 을 밀고 있어 컨텍스트에 들어온 사본이 디스크보다 오래된 경우도 있다(`git log --oneline -3` 로 실제 HEAD 확인)\\\\r\\\\nAGENTS.md-37-- 커밋 메시지는 conventional commits 형식을 따를 것 (feat:, fix:, docs:, refactor:)\\\\r\\\\nAGENTS.md-38-- CRITICAL: **의존 관계가 없는 툴 호출은 한 메시지에 묶을 것.** 세션 로그 실측에서 툴 호출 메시지 10,682건 중 10,681건(100.0%)이 단일 호출이었다 — 호출 한 번의 값은 명령의 길이가 아니라 그 시점의 컨텍스트 크기가 정하므로(실측 회당 $0.18) 읽기 둘을 따로 보내면 값이 두 배다. `git log`·`grep`·`cat`처럼 서로 읽지 않는 명령은 한 번에 보낸다. 앞 결과가 뒤 명령의 인자를 정하는 경우만 나눈다. 근거는 `docs/reports/TOKEN-AUDIT-2026-08-25.md`\\\\r\\\\n--\\\\nAGENTS.md-51-|---|---|---|\\\\r\\\\nAGENTS.md-52-| M0 스파이크 | 완료 | — |\\\\r\\\\nAGENTS.md-53-| M1 워킹 스켈레톤 | 완료 | — |\\\\r\\\\nAGENTS.md:54:| M2 룰팩 | **진행 중** | 標準仕様書 5章의 `stated` 승격. **사람의 독립 검토**라 에이전트가 코드로 닫을 수 없다 (R6) |\\\\r\\\\nAGENTS.md-55-| M3a 단일 스팬 大梁·뷰어 | 완료 | — |\\\\r\\\\nAGENTS.md-56-| M3b 다스팬·継手 | 완료 | — |\\\\r\\\\nAGENTS.md-57-| M3c 고유 상세 | **진행 중** | 幅止め筋·腹筋 완료. パネルゾーン帯筋·溶接閉鎖フープ는 두 원문 0건이라 만들지 않는다 |\\\\r\\\\n--\\\\nAGENTS.md-62-| M5 한국 실무자 UX 리뷰 | 미착수 | — |\\\\r\\\\nAGENTS.md-63-\\\\r\\\\nAGENTS.md-64-마일스톤 순서를 건너뛰지 말 것. 도면 인식은 M3a 이후 병행 가능한 별도 트랙이다 (ADR-018).\\\\r\\\\nAGENTS.md:65:**M2가 미완이므로 산출값은 아직 정식 물량이 아니다.**\\\\r\\\\nAGENTS.md-66-\\\\r\\\\nAGENTS.md-67-## 열린 리스크\\\\r\\\\nAGENTS.md-68-근거·경위·수치는 **`docs/RISKS.md`**에 있다. 아래는 「무엇이 열려 있는가」 대장이다.\\\\r\\\\nAGENTS.md-69-\\\\r\\\\nAGENTS.md-70-| | 상태 | 한 줄 |\\\\r\\\\nAGENTS.md-71-|---|---|---|\\\\r\\\\nAGENTS.md:72:| R1 | 종결 | `標準詳細図`에 구조 배근 상세가 없다 → 근거는 `標準仕様書 5章`이 유일 |\\\\r\\\\nAGENTS.md-73-| R2 | 열림 | 조문에 없는 관행(暗黙知)은 영구 미검증 → `confidence: inferred`로 축적 |\\\\r\\\\nAGENTS.md-74-| R3 | 열림 | 일본 사용자 접점 0 |\\\\r\\\\nAGENTS.md-75-| R4 | 해소 | 층당 1만 개 규모를 `InstancedMesh`가 견딘다(5층 45,885 실측). 계측 조건에 함정 둘 |\\\\r\\\\n--\\\\ndocs/MILESTONES.md-2-\\\\r\\\\ndocs/MILESTONES.md-3-> `CLAUDE.md`에서 옮겨온 절이다. **수치는 손으로 갱신하므로 코드보다 뒤처진다** — 인용 전에 `git log --oneline -3`으로 실제 HEAD를 확인하고 코드로 대조할 것.\\\\ndocs/MILESTONES.md-4-\\\\ndocs/MILESTONES.md:5:- **M2 보강 (2026-08-27, phase 30 step 2)**: 룰팩 243행(`transcribed` 240행, `inferred` 3행)을 8개 표＋17개 단발항＝25개 대조 단위·135칸으로 확인한다. 생성은 `npm run rulepack:review-sheet`; 검토는 ①表5.3.2·5.3.4 L1/L1h ②表5.3.6 柱＝大梁 ③단발항·결번 순이다. 사람이 단위별 전 칸 일치를 회신한 뒤 해당 행의 `confidence`를 `stated`로 올리고 `note`의 「独立検討待ち」를 지우며, `src/rulepack/index.test.ts`의 「`stated`는 0행」 고정을 같은 커밋에서 함께 고친다. 그 전까지 `stated` 0행이며 M2와 R6은 각각 진행 중·열림이다. 아래 기존 M2 항목의 이전 대조 수치 「198행」·「원문 94칸·8곳」은 이 수치로 대체한다.\\\\ndocs/MILESTONES.md-6-\\\\r\\\\ndocs/MILESTONES.md-7-- **M3c 보충 (2026-08-27, phase 28 step 3)**: `表5.3.1 注1`의 「片持ちスラブ先端、壁筋の自由端側の先端で90°フック又は135°フックを用いる場合には、余長は4d 以上とする。」를 `spec-r7-ch5.json`에 `transcribed` 전사했다(인쇄 28쪽). 이는 설계도서 조건이므로 片持床板 선단과 壁 자유단의 훅을 추정하지 않는 골든 회귀를 추가했고, 룰팩 행은 만들지 않았다. 加工長 대장은 `bendRadius`만 남도록 정리했으며 R12는 부분 상태를 유지한다.\\\\r\\\\ndocs/MILESTONES.md-8-\\\\r\\\\ndocs/MILESTONES.md-9-- [x] **M0** — 완료 (2026-08-09). 標準仕様書 R7 5章에서 MVP 관련 텍스트 수치 ~92개, 이미지 수치 8개(フック余長 4·継手位置 4)를 특정. 標準詳細図에는 구조 배근 상세가 없음을 확인 — 배근 근거는 5章이 유일하다 (docs/M0-FINDINGS.md)\\\\r\\\\ndocs/MILESTONES.md:10:- [x] **M1** — 완료. 워킹 스켈레톤: 柱 1종 + 플레이스홀더 룰로 입력→철근→물량→3D→Excel 관통. 전 룰이 inferred이므로 M2 전 산출값은 정식 물량이 아니다\\\\r\\\\ndocs/MILESTONES.md:11:- [ ] **M2** — 룰팩 정식화 + 골든테스트 전 셀 통과. 골든 기대값은 원문 독립 전사(lookupRule 유도 금지, ADR-010). **M2a 착수분(2026-08-12)**: `数量積算基準` 第4編第3章을 전사해 `tests/golden/fixtures/quantity-r5-ch3.json`에 박고, 数量의 길이·본수를 1通則2)·7)에 맞췄다 — フープ/スタラップ 길이가 かぶり 공제+フック에서 **断面周長**으로 바뀌어 한 본당 244mm 늘었다(ADR-019). 미적용 조항은 R9. **추가 완료**(2026-08-20): 단위질량을 룰팩에서 빼고 **프로젝트 입력**(`Project.unitMass`)으로 받는다. 積算基準 1通則 前文은 質量을 「設計長さ × JIS G 3112 の単位質量」으로 정의할 뿐 값을 JIS에 위임하는데, JIS는 유료라 미확보다 — 읽지 않은 문헌을 出典에 세울 수 없으므로(ADR-003) `unit-mass.yaml`(inferred 8행)과 `sources.yaml`의 `jis` 항목을 지웠다. 미입력 径은 line·小計·合計의 kg이 전부 `null`이고 内訳書·Excel에 「—」로 나간다(0으로 두면 합계에 섞여 과소 계상으로 보인다). **추가 완료**(2026-08-21, 加工長 골든): 선결 조건이던 R7 端部条件 ①②③이 전부 닫혀 착수 가능해졌다 — `tests/golden/fixtures/fabrication-length.json`에 表5.3.4(L1)·表5.3.5(La)·5.3.4(5)(ｲ)(a)(b)(c)·表5.3.6·5.3.5(2)·表5.3.1(hook135, 이미지 판독) + `数量積算基準` 1通則1)(tipNoAddition)을 전사하고, 그 항들만으로 손유도한 加工長을 9케이스에 박았다(柱主筋 定着/통과, 柱帯筋, 大梁 折曲げ 全長下限支配/折曲げ 余長下限支配/直線/2스팬 通し筋, あばら筋, 定着不成立 throw). 재는 값은 `Rebar.length`가 아니라 **`points`가 그리는 折れ線 실장**이다 — 設計長さ를 읽으면 数量 골든과 중복되고 3D 형상은 아무도 고정하지 않는 채로 남는다(ADR-019). 근거 문서가 둘이라 `sources`는 배열이고 각 항이 `sourceId`로 어느 문서인지 가리킨다. 어느 케이스도 구속하지 않는 항은 `terms`에 남지 못한다 — 실제로 L1h가 그랬다. 뮤테이션으로 감도 확인함(cover 加算·余長下限·L1·中間柱せい 누적을 각각 흔들면 해당 케이스만 실패). **2026-08-21 재점검**: 예전에 적어둔 잔여 4개 중 셋은 이미 끝나 있었다 — 加工用かぶり는 `cover.fabrication.addition`으로 분리돼 골든 대조 중이고, 근거 없는 `rounding.length`는 룰팩에 없으며, 선결 조건이던 R7③(端部条件)도 `girder-ends.ts`가 直線↔折曲げ 분기와 `定着不成立` 판정으로 처리한다. 같은 날 折曲げ定着 全長의 하한이 조문(L1)이 아니라 L1h였던 것을 고쳤다(R7③-1) — 그 결과 (a)가 지배할 때 折曲げ와 直線의 全長이 같아지고, (b) 余長下限이 이기는 사례는 D13·柱560 하나로 좁혀졌다. **남은 것은 하나다**: 標準仕様書 5章 수치의 `stated` 승격 — 라벨은 `transcribed`로 정리됐고 검증 3층도 깔렸으므로 남은 건 **사람의 독립 검토**다(R6·ADR-023). 전 행에 `note: LLM転写 — 独立検討待ち`가 붙어 있고 ADR-015상 추출자＝승인자는 독립 검토가 아니므로 **에이전트가 코드로 닫을 수 없다.** 사람 검토자가 원문 PDF와 대조해야 하며, 그 대조를 싸게 만드는 표별 대조 시트가 이 항목의 실제 작업이다. 대조 단위는 룰팩 178행이 아니라 **원문 94칸·8곳**이다(원문 표가 帯 구조라 룰팩이 fc·径으로 전개해 둔 것이고, 帯 내부 전개 불일치는 0으로 확인됐다)\\\\r\\\\ndocs/MILESTONES.md:12:- [x] **M3a** — 완료 (2026-08-12). 단일 스팬 大梁: girderSpan·단부 조건(직선/折曲げ定着 수용성 검사)·あばら筋 위치 배열 생성기 + 部材/建物 뷰 표시 + 뷰어 기능 4종(레이어 토글·단면 컷·호버 툴팁·정착 범례). 브라우저 실검증은 `tests/e2e/uc10-viewer-features.js`. **M2가 미완이므로 大梁 산출값도 아직 정식 물량이 아니다**\\\\r\\\\ndocs/MILESTONES.md:13:- [x] **M3b** — 완료 (2026-08-21). **다스팬 通し筋**(2026-08-12): 산정 단위가 부재에서 **런**(같은 通り芯 위 인접 大梁의 최대 연쇄)으로 바뀌었고 단일 스팬은 길이 1인 런이다. 通し筋은 중간 접합부를 관통해 定着이 양 끝에만 붙는다 → R7② 해소. `girderSupport`와 `UnsupportedReason`의 `'連続スパン'`은 함께 제거됐다. **継手箇所数 계상과 수량 단위 유니온(kg·箇所)**(2026-08-18) → R8 해소. **カットオフ筋과 継手方式 입력**(2026-08-21): 大梁 主筋을 位置別(端部·中央)로 받고 差를 カットオフ筋으로 낸다 — 外側支点은 定着＋切り止め位置, 中間支点은 位置×2＋中間柱せい(관통), 中央은 内法−位置×2다. 근거는 積算基準 2（３）梁1)「トップ筋、ハンチ部分の主筋、補強筋等は設計図書による」이고 切り止め位置는 그래서 입력이다(ADR-021). 継手方式은 断面一覧에서 고른다 — 이제 `重ね継手` 고정이 아니다. 실검증 `tests/e2e/uc11-continuous-girder.js`·`uc13-cutoff-splice.js`. **넘긴 것**: 継手位置는 表5.3.3이 원문에서 이미지라 미확정이라 3D에 그리지 않고 고지로 상시 표시한다(M0에서 닫힌 사실이라 M3b가 풀 수 없다). あばら筋의 位置別 피치(端部@100/中央@200)는 主筋과 달리 아직 단일 값이다 — M3c 이후. **M2가 미완이므로 大梁 산출값은 아직 정식 물량이 아니다**\\\\r\\\\ndocs/MILESTONES.md:14:- [ ] **M3c** — 진행 중. 4항목의 근거를 두 원문 전수 검색으로 재고 셋으로 갈랐다 (ADR-022). **끝난 것**(2026-08-21): ① **幅止め筋** — 設計長さ는 `数量積算基準` 1通則3)의 「コンクリートの設計幅、フックはないものとする」, 本数는 2（３）梁3)이 1通則7)에 걸어 둘 다 조문에 있다. 룰팩 `measure.width-tie.length.addition`(`transcribed`)로 싣고 **大梁에만** 붙인다(1通則3)의 열거에 柱가 없다). 径·ピッチ는 `断面一覧` 입력. 픽스처 `1通則3)`이 deferred→covered로 넘어갔다. ② **腹筋** — 2（３）梁3)이 余長을 1通則6)에 위임하고 그 조항은 JASS 5 준용인데 유료·미확보이며 `標準仕様書 R7` 전 330쪽에 「腹筋」이 **0건**이다. 룰팩 행을 두지 않고 余長·本数를 `断面一覧` 입력으로 받는다 — 그래서 `腹筋` 철근의 `ruleHits`는 비어 있다. 設計長さ ＝ 内法長さ ＋ 余長×2. **만들지 않기로 한 것**: **パネルゾーン帯筋**(두 원문 0건, 2（２）柱4)가 設計図書에 위임)과 **溶接閉鎖フープ**(0건. 게다가 1通則2)가 フープ 長さ를 제작방식과 무관하게 断面 周長으로 정해 **数量이 변하지 않는다**). 3D 참고 표현도 두지 않는다 — 그리려면 형상·本数를 제품이 지어내야 한다. 스키마 v6(GirderSection.widthTie·sideBar, 둘 다 optional ＝ 「그 배근 없음」). **도면 인식 연계 완료**(2026-08-23): `腹筋: 2-D10`·`※幅止筋はD10@1000`을 후보로 읽고 승인 시 `sideBar`·`widthTie`에 반영한다. 腹筋 余長은 기존 입력을 유지하고 신규면 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다\\\\r\\\\ndocs/MILESTONES.md-15-- [ ] **도면 인식(로컬)** — 진행 중 (2026-08-12 착수, ADR-018·ADR-030·phase 6-section-import). **断面リスト 트랙**(값)과 **伏図·軸組図 트랙**(형상) 둘이다. 형상은 2026-08-23까지 수동 입력만이었고(ADR-004), 그 기각 사유 중 데이터 전제는 ADR-018이·기술 전제는 ADR-030의 스파이크가 뒤집었다. 수동 입력은 없어지지 않는다 — 래스터·미지 형식에서는 그것이 유일한 길이다. **끝난 것**(2026-08-13): TextItem 픽스처 5부(발주처 상이 3부)·PDF→TextItem과 TextItem→후보의 2단 파서·부재 행 단위 反映/無視 취입 패널. 실검증 `tests/e2e/uc12-section-import.js`. **끝난 것**(2026-08-14): 断面 라벨 행이 없는 표의 b×D. 근거는 스케치의 가로·세로 치수 둘인데 세로가 회전 문자열(rot=-90)이라 `recoverRows`가 버리고 있었다 — `verticalRuns`로 따로 복원해 짝지어 柱 19/19·大梁 32/32을 전사와 대조 확정(ojkk). 열 배정 앵커는 符号 중심이 아니라 **位置 열**이다(칸 폭이 부재마다 달라 중심 사이 중점이 실제 칸 경계와 어긋난다). **끝난 것**(2026-08-14): 표제란의 図面名称 칸이 리스트 타이틀로 잡혀 실물 PDF에서 마지막 층 블록이 잘리던 것(ojkk p3 25→32칸)과 유령 리스트 3건. 픽스처는 개인정보 때문에 표제란을 떼고 만들어져 이 실패를 원리상 못 본다 — 실물 PDF를 그대로 파싱하는 **로컬 전용 통합 테스트**(`tests/section-import/real-pdf.test.ts`, `.cache/`가 비면 스킵)가 그 눈먼 구간을 덮는다. **끝난 것**(2026-08-22): 位置별 상이값 흡수. 端部欄·中央欄으로 나뉜 표를 위치별로 읽어 후보의 `endTopCount`·`endBottomCount`에 싣고, 取入은 그것을 ADR-021의 `top`/`bottom.endCount`에 넣는다(端部欄이 없는 표는 中央 값을 그대로 端部에도 쓴다 — 全長 동일 본수라는 뜻이다). 좌우가 다른 표(「Y3端／Y4端」)는 `girderMainAsymmetric` 후보로 보존하고 phase 21에서 Grid 축 순서 자동 또는 사용자 선택으로 始端/終端에 반영한다. 실측 3부 대조에서 **反映 가능 44/81 → 65/81칸**(ojkk 大梁 15→32, yokohama 大梁 0→8). **끝난 것**(2026-08-22): 고강도 전단보강근 7칸 — 帯筋 셀의 `K13`·`S13`을 값으로 읽는다(ADR-026). **反映 가능 65/81 → 72/81칸**. 이어서 円形柱 1칸도 `600φ`로 읽어(ADR-027) **73/81칸**이 됐고, 좌우 상이 8칸은 방향 미선택을 기본으로 유지한 비대칭 후보로 반영 단계에 넘겼다. 실검증은 `tests/e2e/uc12-section-import.js`에 좌우 상이 거부 2항을 더했다. **끝난 것**(2026-08-23, phase 8-title-boundary): 표제에서 읽는 幅止め筋 피치의 **오른쪽 경계**를 자릿수가 아니라 特記의 순차 번호(`1. 2. 3.`)로 정한다. 자릿수 캡은 「@500」과 다음 항목 번호 「2.」를 못 갈라 5002를 지어냈다 — 픽스처가 못 잡은 이유는 大梁에 걸리는 표제 둘이 우연히 `@1000`이었기 때문이고, `@500` 표기 자체는 yokohama-p13 柱리스트에 이미 있다. 항목으로 가른 뒤에도 그 항목 전체가 `幅止筋+径+@피치` 문법이 아니면 값을 내지 않고 `raw`＋`幅止め筋解釈不能`으로 남긴다. **상한은 두지 않는다** — 幅止め筋 피치는 규준값이 아니라 입력이라 근거 없는 상한을 지어낼 수 없다(그래서 표제가 숫자로 끝나면 그 숫자를 그대로 읽는다). 이 결함은 phase 7의 전 AC를 통과한 채로 남아 있었고 교차검증이 잡았다. **끝난 것**(2026-08-23, phase 7-section-fields): `腹筋: 2-D10`과 표제 특기의 `※幅止筋はD10@1000`을 후보로 읽고, 부재 행 승인 때 `GirderSection.sideBar`·`widthTie`에 반영한다. 후보의 `undefined`는 기존 수기값을 유지하고, 腹筋 余長은 기존값 유지·신규 0(규준값이 아니라 JASS 5 미확보에 따른 미입력)이다. **남은 것**: 표 형식 커버리지 확대(수집 계속), 고강도 전단보강근·円形柱 표현, `カットオフ` 값 반영 — 位置 열이 있는 3란 표는 phase 21에서 취입까지 닫혔고, 위치 없는 반폭 표기는 원문 `raw` 보존까지. `継手方式`은 전사 픽스처 4부에 `圧接`·`機械式`·`継手` 문자열이 0건이라 이번 phase에서 제외했다 — 없는 것을 못 읽는 것은 파서 결함이 아니다. 定尺長さ 파싱은 철회됐다 — 6.0/7.0m는 積算基準이 정한 값이므로 입력이 아니라 룰팩 행이다(R8)\\\\r\\\\ndocs/MILESTONES.md-16-   - **형상 트랙**(伏図·軸組図, 2026-08-23, ADR-030). **끝난 것**: ① 스파이크로 실현 가능성 실측 — 축 라벨이 한 밴드에 늘어서고 스팬 치수가 **인접 라벨의 중점**에 놓이며, 부재 부호는 격자점(柱)·변의 중점(大梁)·칸 중앙(床板)에 스냅된다. 벡터 선분은 안 쓴다(一点鎖線이 짧은 조각으로 분해돼 있고 텍스트만으로 복원이 완결된다). ② 通り芯 그리드 파서 — 스팬별 실측 축척이 갈리면 `縮尺不整合`, 전체 치수가 스팬 합과 다르면 `合計不一致`로 후보를 **버린다**(조용한 그리드를 내느니 실패한다). 축척은 도면 표기(용지 의존)가 아니라 실측에서 유도한다. ③ 부재 배치 — **기하만** 읽고 종별은 정하지 않는다(「C면 柱」로 접두를 읽지 않는다; 종별은 断面リスト가 갖고 있다). 스냅 허용은 **중앙값 스팬의 1/4**이다(인접 기준이면 1200mm 띠에서 8pt로 좁아져 引出線으로 비켜 적힌 부호가 떨어진다). 한 페이지의 伏図 여러 장은 블록으로 나눈다 — 그리드 **정의**는 접혀도 좌표는 안 접힌다. ④ 階高 — 軸組図는 라벨 정렬이 일정하지 않아(좌단 x가 108~198로 흩어진다) 앵커가 **치수 열**이고, 「치수는 자기 구간의 중점에 놓인다」는 관계로 축척과 레벨을 함께 푼다. 어느 레벨이 階의 경계인지는 정하지 않고(FL·GL·基礎下端·RCL이 섞여 있다) 같은 높이의 라벨 둘은 둘 다 남긴다. ⑤ 취입 화면 — 断面リスト와 같은 승인 규약이되 **가드가 하나 더** 있다: 격자 index가 스팬 배열에 매여 있어 通り芯을 바꾸면 손대지 않은 층의 부재가 조용히 옮겨가므로, 다른 층에 부재가 있으면 통째로 거부하고 거부를 본 뒤에만 「다른 층을 버린다」 동의 칸을 낸다. 픽스처는 yokohama p7(伏図)·p8(軸組図) 신규 2부. 실검증 `tests/e2e/uc22-plan-import.js`. **남은 것**: 실측이 발주처 2부라 R10이 형상에도 걸린다 — kani p40(軸組図)은 픽스처로 들어왔으나 **읽지 못한다**: 階高 열의 450과 150이 글자 간격 5.6pt로 붙어(숫자 안쪽 4.3pt) 「150450」 한 덩이가 되고, 그 1.3pt로 가르면 도면 하나에 맞춘 것이 되므로 가르지 않는다. 「읽지 못한다」를 테스트로 고정해 두었다, 未配置 부호의 대부분은 小梁으로 잘게 나뉜 칸 안의 것이라 제품이 小梁을 모델링하기 전에는 붙일 자리가 없다(ADR-005), 부호 枝番(`bX2A`)·좌우 비대칭 그리드. **끝난 것**(2026-08-23 추가): ⑥ 階高 → Story 취입 — 최상階의 천단과 최하階의 바닥을 사람이 고르면 그 사이 칸이 階가 된다(실물 1FL→RCL이면 4480·4100이고 パラペット 1400·基礎 2690은 범위 밖). 階의 이름은 그 階의 바닥이 되는 레벨의 원문이고 같은 높이의 라벨 둘은 둘 다 남는다. 도면은 위→아래, `Project.stories`는 아래→위라 뒤집어 쌓는다. ⑦ `Grid` 通り芯 라벨 — 断面リスト 취입에서 좌우 비대칭 主筋의 始端/終端 대응에 사용한다. ⑧ kani p40(軸組図) 픽스처로 형식 커버리지를 넓히다가 파서가 **없는 층을 두 번 지어내는** 것을 잡았다(R10 항 참조). **끝난 것**(2026-08-26, ADR-035·phase 23): 階 라벨↔`Story` 대응 — 伏図 제목과 `Story`/断面의 정확 일치 자동 선택, 미일치 시 사용자 선택, stale `storyId` 리셋을 고정했다.\\\\r\\\\ndocs/MILESTONES.md:17:- [x] **부재 확장(耐震壁·床板)** — 완료 (2026-08-27, ADR-025·ADR-028·ADR-039). 산정 로직 마일스톤과 별개 트랙이다. **끝난 것**: 근거 전수 재측정(`免震`·`制震`·`制振`은 두 원문 **0건** → 만들지 않음, `ブレース`는 積算基準 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `壁`은 조문 충분 → 산정), 골든 픽스처에 `2（５）壁1)①②③`과 躯体の区分 `（５）壁` 전사, 룰팩 2종(`cover.minimum`의 `memberKind: 耐震壁` 5행 ＝ 表5.3.6 「柱、梁、耐力壁」 같은 칸, `lap.wall.minimum` 40d ＝ 5.3.4(3)(ｱ)의 耐力壁 전용 하한), 도메인 `wall.ts`(縦筋·横筋·継手·層数), 3D(建物 뷰·部材 뷰·平面 뷰), 断面一覧 입력(壁厚·縦筋·横筋·配筋層数). 측정 단위는 **内法**이다 — 躯体の区分（５）壁이 壁을 「柱、梁、床板等に接する垂直材の内法部分」으로 정의하므로 縦筋은 `階高 − 上部大梁せい`, 横筋은 両側柱面間이고, 柱·大梁와 이중 계상되지 않는 근거가 이것 하나다. **끝난 것**(床板, 2026-08-22, ADR-028): 근거 전수 재측정(`配力筋`·`合成スラブ`·`ボイド`는 두 원문 **0건**, `デッキ`의 積算基準 3쪽은 **第4編第4章 鉄骨**이라 축이 다름 → 별건, `床板`은 조문 완비 → 산정), 골든 픽스처에 躯体の区分（４）과 2（４）床板1)2)3) 전사, 룰팩 4종(`anchorage.L3` 10d ＋ `anchorage.L3.minimum` 150mm ＝ 表5.3.4 注3의 「10d かつ150mm以上」, `anchorage.Lb` ＝ 表5.3.5 注2의 小梁·スラブ 上端筋 投影, `cover.minimum`의 `memberKind: 床板` 2행 ＝ 表5.3.6 「スラブ、耐力壁以外の壁」, `measure.splice.slab.continuous` 3행＋상한 3행), 도메인 `slab.ts`·`slab-ends.ts`·`slabBay`·`slabRun`, 3D(部材·建物·平面), 断面一覧 입력(板厚·X/Y 방향 上端·下端). 측정 단위는 **内法**이고(躯体の区分（４）「柱、梁等に接する水平材の内法部分」) 連続する床板은 大梁와 같은 **런**으로 잰다 — 中間大梁의 幅이 「幅の1/2 × 2」로 한 본 들어가고 定着은 런 양 끝에만 붙는다. **継手 区分表는 13.5m에서 끝나 위가 열려 있지 않다** — 梁의 표를 흉내 내지 않고 `継手箇所数不明`으로 그 床板을 떨어뜨린다. 실검증 `tests/e2e/uc20-slab.js`. 스키마 v10. **끝난 것**(開口部, 2026-08-22, ADR-029): 두 부재에 공통으로 걸리는 `数量積算基準` 1通則8)을 구현해 R14를 닫았다. 開口는 断面이 아니라 **部材**에 붙고(`Member.openings`, 스키마 v11) 입력 자리는 平面 페인이다 — 같은 符号의 벽이 여러 장 서는데 창은 그중 한 장에만 뚫린다(ADR-004). 「어느 본이 欠けるか」는 조문에 없으므로 1通則7)의 割付을 위치로 읽어 정하고(개구 안쪽에 들어온 본만, 경계에 얹힌 본은 제외), 欠除量마다 内訳의 행이 갈린다(前文 「規格、形状、寸法等ごとに」). 継手는 부재마다 다르게 반응한다 — 耐震壁 縦筋은 2（５）壁1)② **但書**로 0か所(`measure.splice.wall.opening`), 横筋·単独床板은 1通則4)가 欠除 후 길이로 세고, 連続床板은 区分表가 「床板の長さ」로 引으므로 그대로다. 룰팩 신규는 2행(`measure.opening.deduction.minimum.area` 0.5㎡, `measure.splice.wall.opening` 0箇所). 3D는 표시부가 세그먼트를 자르고(`clipSegments`) 콘크리트 상자를 도려낸다(`carveBox`) — `points`는 개구를 모르는 全長 경로 그대로다. 실검증 `tests/e2e/uc21-opening.js`. **끝난 것**(開口補強筋 전사 입력, 2026-08-26, ADR-034·phase 22): 開口마다 `径・本数・設計長さ(mm)`를 설계도서에서 전사해 입력하고, 내역서에는 `開口補強筋`으로 계상한다. 3D는 위치·형상을 제품이 만들지 않도록 해당 role을 건물·부재 뷰에서 건너뛴다. 미전사 開口의 과소 계상은 상시 고지가 안내한다. **끝난 것**(片持床板, 2026-08-27, ADR-039): `数量積算基準` 躯体の区分（４）床板의 「片持床板等もこれらに準ずる。」, 같은 기준 2（４）床板2) 但書의 「単独床板及び片持床板の主筋の継手は、1通則4)による。」, `標準仕様書` 表5.3.4 L3의 「片持スラブの場合は25d」 예외(150mm 하한은 적용하지 않음), 表5.3.5 注1·2의 La·Lb(「片持スラブを含む」·「片持スラブを除く」)를 근거로 지원을 완료했다. 平面 뷰의 壁·床板 배치·삭제 입력은 phase 26(ADR-038)에서 완료\\\\r\\\\ndocs/MILESTONES.md-18-- [ ] **일본 고유 형태·제품 확장** — 진행 중 (2026-08-22 착수). 후보를 두 원문 전수 검색으로 재고 4개를 골랐다. **끝난 것**: ① **高強度せん断補強筋**(K13·S13, ADR-026) — `帯筋`·`あばら筋` 전용 呼び名이다. 두 원문에 「高強度」·「大臣認定」이 **0건**인데도 만들 수 있는 이유는 1通則2)가 フープ 長さ를 断面周長으로 정해 **径으로 引는 룰팩 행이 帯筋에 하나도 없기** 때문이다 — 룰팩 신규 행 0. 主筋·壁筋은 定着·重ね継手를 径으로 引으므로 타입(`ShearBarSize`)이 막는다. 断面リスト 파서도 읽는다. ② **円形柱**(ADR-027) — 1通則2)의 「断面の設計寸法による周長」이 円形에서는 원주 π×直径이다. 조문이 형상을 矩形으로 한정하지 않으므로 여기서도 룰팩 신규 행이 0이다. `ColumnSection.shape`(스키마 v9)로 받고 b·d를 둘 다 直径으로 둔다 — 大梁 内法·3D 柱面·平面 히트영역이 전부 b·d에서 나오므로 外接寸法을 그대로 두면 형상 추가가 계측을 흔들지 않는다. 3D는 円柱와 円形フープ(24각형 作図規則)다. `600φ`도 파싱한다. **スパイラル筋은 만들지 않는다** — 継手·定着이 図5.3.5＝이미지다. **끝난 것**: ③ **雑壁** — 区分(`wallClass`)·かぶり·40d 하한은 phase 24(ADR-036)로 완료. 부분 높이·부분 길이 형상은 phase 25(ADR-037)로 완료. **남은 것**: ④ **壁式構造の壁**(積算基準 2（５）壁**2)**의 端部筋·縦筋·壁梁筋·横筋·補強筋 5구분). **만들지 않는 것**: `免震`(0건, ADR-025)·スパイラル筋의 継手·定着(図5.3.5＝**이미지**라 表5.3.3과 같은 함정)·機械式定着(標準仕様書 5.3.4(ｳ)가 전부 「特記による」라 제품이 가질 값이 없다). `ガス圧接`·`機械式継手`는 M3b에서 이미 끝났다\\\\r\\\\ndocs/MILESTONES.md-19-- [x] **M4** — 완료 (2026-08-22). 네 갈래다. ① **재방문 경로**: `src/lib/persist/`(IndexedDB 자동저장 500ms 디바운스 ＋ 案件 JSON 저장/불러오기)와 `useProjectPersistence`. 복원 불가한 기록(옛 schemaVersion·끊긴 문자열)은 조용히 버리고 샘플로 착지한다 — 기동 경로라 던지면 지울 방법 없이 화면이 하얘진다. 반대로 사용자가 고른 파일이 안 읽히면 **말한다**(지금 案件은 남긴 채). ② **내역서 양식**: xlsx에 층별 小計 행과 `径別集計` 시트를 넣었다(`sizeSubtotals`는 径마다 독립해서 null이 된다 — 「어느 径이 아직 発注 불가인가」가 이 표의 용도라 欠損이 다른 径을 물들이면 안 된다). ③ **PDF**: 라이브러리 대신 브라우저 인쇄 경로(`@media print` ＋ `window.print()`). 종이도 같은 `WorkbookSpec`에서 나오고, 出典·算出式 두 열은 열 정의의 `printed` 플래그로 뺀다(PDL1.0 의무는 算出根拠 블록이 진다). ④ **glTF(glb)**: `EXT_mesh_gpu_instancing`으로 案件 전체를 낸다. **화면의 표시 반경이 아니라 実寸이다** — `rebarRadius`는 가독성용으로 최소 ⌀14·1.6배로 부풀린 값이라 그대로 내면 D25가 ⌀40으로 실측된다(ADR-024). 스트레스는 `tests/stress/multi-story.test.ts`(5층 45,885 인스턴스)와 실브라우저 `tests/e2e/uc17-stress-building.js`로 잰다. glb에도 出典·改変·ADR-015 경고가 `scene.userData`(＝extras)로 실린다 — 書き出し 경로마다 표시 의무가 면제되지 않는다. **3D를 쓰는 코드는 押した時에 받는다**: 헤더 상주 釦이 `gltf.ts`를 정적 import하면 three가 `/`의 차단 경로로 돌아오는데, Lighthouse 예산은 이것을 통과시킨다(뷰어가 어차피 three를 받으므로 총량이 안 변한다). 확인은 `.next/app-build-manifest.json`의 `pages['/page']`로 한다\\\\r\\\\ndocs/MILESTONES.md-20-- [ ] **M5** — 한국 실무자 UX 리뷰 반영\\\\r\\\\n--- reports ---\\\\r\\\\n[phases/30-rulepack-review-sheet/step1-report.json]\\\\r\\\\n{\\\\r\\\\n  \\\\\\\"step\\\\\\\": 1,\\\\r\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"review-sheet-generator\\\\\\\",\\\\r\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"completed\\\\\\\",\\\\r\\\\n  \\\\\\\"folded_result\\\\\\\": {\\\\r\\\\n    \\\\\\\"total_rulepack_rows\\\\\\\": 243,\\\\r\\\\n    \\\\\\\"folded_review_cells\\\\\\\": 135,\\\\r\\\\n    \\\\\\\"table_count\\\\\\\": 8,\\\\r\\\\n    \\\\\\\"singleton_count\\\\\\\": 17,\\\\r\\\\n    \\\\\\\"verification_marked_cells\\\\\\\": 77,\\\\r\\\\n    \\\\\\\"by_key\\\\\\\": {\\\\r\\\\n      \\\\\\\"anchorage.L1\\\\\\\": { \\\\\\\"before\\\\\\\": 20, \\\\\\\"after\\\\\\\": 11 },\\\\r\\\\n      \\\\\\\"anchorage.L2\\\\\\\": { \\\\\\\"before\\\\\\\": 20, \\\\\\\"after\\\\\\\": 11 },\\\\r\\\\n      \\\\\\\"anchorage.L1h\\\\\\\": { \\\\\\\"before\\\\\\\": 20, \\\\\\\"after\\\\\\\": 11 },\\\\r\\\\n      \\\\\\\"anchorage.L2h\\\\\\\": { \\\\\\\"before\\\\\\\": 20, \\\\\\\"after\\\\\\\": 11 },\\\\r\\\\n      \\\\\\\"anchorage.La\\\\\\\": { \\\\\\\"before\\\\\\\": 20, \\\\\\\"after\\\\\\\": 11 },\\\\r\\\\n      \\\\\\\"anchorage.L3\\\\\\\": { \\\\\\\"before\\\\\\\": 2, \\\\\\\"after\\\\\\\": 2 },\\\\r