  \"cache_commit_count_command\": \"git log main..HEAD --stat | grep -c '^ .cache/'\",\n    \"cache_commit_count\": 0\n  },\n  \"verification\": {\n    \"npm_test\": \"passed: 89 files, 1619 tests\",\n    \"tsc\": \"passed\",\n    \"lint\": \"passed with one pre-existing warning in src/app/api/oncall/alert/route.test.ts:161\",\n    \"targeted_real_decode\": \"passed: 1 file, 4 tests\"\n  },\n  \"summary\": \"肄뷀띁??4嫄댁쓣 SOURCES.md???깅줉?섍퀬 ?몄퐫???먯젙???몄썱?? Shift_JIS ?쎌뒪泥섍? ?ㅼ젣 CP932 諛붿씠?몄엫??諛붿씠???⑥뼵?쇰줈 怨좎젙?덇퀬, ?몄퐫??遺꾧린瑜??붾뱾硫??ㅽ뙣?⑥쓣 ?뺤씤?덈떎.\"\n}\n\r\n--- types.ts ---\r\nexport type StbEncoding = 'utf-8' | 'shift_jis'\n\n// ST-Bridge 痍⑥엯 媛??④퀎媛 ?대뒗 ?ъ쑀 肄붾뱶????紐⑸줉?쇰줈留??쒗쁽?쒕떎.\nexport const STB_ISSUES = [\n  '野얍퓶鸚뽧깘?쇈궦?㎯꺍',\n  '?ゅ?恙쒌궓?녈궠?쇈깈?ｃ꺍??,\n  'XML鰲ｆ옄訝띹꺗',\n  'ST-Bridge壤℡폀?㎯겒??,\n  '?욅쎍雅ㅹ싥굤??,\n  '?ゅ?恙쒒싥굤??Ŧ??,\n  '?싥굤??궛?ャ꺖?쀦빊訝띴???,\n  '?싥굤??뼶?묇툖??,\n  '?싥굤??퇌??㎗?덁툖??,\n  '?싥굤??퐤營?뇥筽?,\n  '?싥굤??꺀?쇻꺂轝좄맼',\n  '?싥굤??쑋濾쒎눣',\n  '?싥굤??퐤營?겏影?밤겗訝띴???,\n  '?롢꺃?쇻꺂鰲ｉ뇠訝띹꺗',\n  '?롢꺃?쇻꺂?띹쨭',\n  '?겻툔?с깧?ユ쑋野얍퓶',\n  '野얍퓶鸚뽧겗?롧Ŧ??,\n  '?롣툖擁?,\n] as const\n\nexport type StbIssue = (typeof STB_ISSUES)[number]\n\r\n--- decode.ts ---\r\nimport type { StbEncoding } from './types'\n\nexport type StbDecodeResult =\n  | { ok: true; text: string; encoding: StbEncoding }\n  | {\n      ok: false\n      issue: '?ゅ?恙쒌궓?녈궠?쇈깈?ｃ꺍??\n      declared: string\n    }\n\nfunction declaredEncoding(bytes: ArrayBuffer): string | undefined {\n  const prefix = new TextDecoder('latin1').decode(\n    new Uint8Array(bytes, 0, Math.min(bytes.byteLength, 512)),\n  )\n  const declaration = prefix.match(/<\\?xml\\b[^?]*?\\?>/iu)?.[0]\n  return declaration?.match(/\\bencoding\\s*=\\s*[\"']([^\"']+)[\"']/iu)?.[1]\n}\n\nfunction normalizeEncoding(label: string | undefined): StbEncoding | undefined {\n  if (!label) return 'utf-8'\n\n  switch (label.trim().toLowerCase()) {\n    case 'utf8':\n    case 'utf-8':\n      return 'utf-8'\n    case 'shift_jis':\n    case 'shift-jis':\n    case 'sjis':\n    case 'windows-31j':\n      return 'shift_jis'\n    default:\n      return undefined\n  }\n}\n\nexport function decodeStbBytes(bytes: ArrayBuffer): StbDecodeResult {\n  const declared = declaredEncoding(bytes)\n  const encoding = normalizeEncoding(declared)\n\n  if (!encoding) {\n    return {\n      ok: false,\n      issue: '?ゅ?恙쒌궓?녈궠?쇈깈?ｃ꺍??,\n      declared: declared ?? '',\n    }\n  }\n\n  return {\n    ok: true,\n    text: new TextDecoder(encoding).decode(new Uint8Array(bytes)),\n    encoding,\n  }\n}\n\r\n--- decode tests ---\r\nimport { readFileSync } from 'node:fs'\nimport { resolve } from 'node:path'\n\nimport { describe, expect, it } from 'vitest'\n\nimport { decodeStbBytes } from './decode'\n\nconst fixtureDirectory = resolve(\n  process.cwd(),\n  'tests/fixtures/stb-import/synthetic',\n)\n\nfunction fixtureBytes(file: string): ArrayBuffer {\n  const source = readFileSync(resolve(fixtureDirectory, file))\n  const bytes = new Uint8Array(source.byteLength)\n  bytes.set(source)\n  return bytes.buffer\n}\n\nfunction textBytes(text: string): ArrayBuffer {\n  return new TextEncoder().encode(text).buffer\n}\n\nfunction successful(result: ReturnType<typeof decodeStbBytes>) {\n  expect(result.ok).toBe(true)\n  if (!result.ok) throw new Error('expected a successful decode')\n  return result\n}\n\nfunction withoutEncodingLabel(text: string): string {\n  return text.replace(\n    /(<\\?xml\\b[^?]*?\\bencoding\\s*=\\s*[\"'])[^\"']+([\"'])/iu,\n    '$1<normalized>$2',\n  )\n}\n\ndescribe('decodeStbBytes', () => {\n  it('decodes the real CP932 bytes in the Shift_JIS fixture', () => {\n    const result = successful(decodeStbBytes(fixtureBytes('mini-sjis.stb')))\n\n    expect(result.encoding).toBe('shift_jis')\n    expect(result.text).toContain('?뷸틬?롢궢?녈깤??)\n  })\n\n  it('decodes the UTF-8 fixture to the same text', () => {\n    const sjis = successful(decodeStbBytes(fixtureBytes('mini-sjis.stb')))\n    const utf8 = successful(decodeStbBytes(fixtureBytes('mini-utf8.stb')))\n\n    expect(utf8.encoding).toBe('utf-8')\n    expect(utf8.text).toContain('?뷸틬?롢궢?녈깤??)\n    expect(withoutEncodingLabel(utf8.text)).toBe(\n      withoutEncodingLabel(sjis.text),\n    )\n  })\n\n  it('does not treat the Shift_JIS bytes as UTF-8', () => {\n    const bytes = new Uint8Array(fixtureBytes('mini-sjis.stb'))\n    const forcedUtf8 = new TextDecoder('utf-8').decode(bytes)\n\n    expect(forcedUtf8).not.toContain('?뷸틬?롢궢?녈깤??)\n  })\n\n  it('defaults to UTF-8 when the XML declaration is absent', () => {\n    const result = successful(\n      decodeStbBytes(textBytes('<ST_BRIDGE version=\"2.0.2\" />')),\n    )\n\n    expect(result.encoding).toBe('utf-8')\n  })\n\n  it('defaults to UTF-8 when the declaration has no encoding attribute', () => {\n    const result = successful(\n      decodeStbBytes(textBytes('<?xml version=\"1.0\"?><ST_BRIDGE />')),\n    )\n\n    expect(result.encoding).toBe('utf-8')\n  })\n\n  it('normalizes all supported UTF-8 and Shift_JIS labels', () => {\n    const labels: Array<[string, 'utf-8' | 'shift_jis']> = [\n      ['utf8', 'utf-8'],\n      ['utf-8', 'utf-8'],\n      ['Shift_JIS', 'shift_jis'],\n      ['shift-jis', 'shift_jis'],\n      ['sjis', 'shift_jis'],\n      ['windows-31j', 'shift_jis'],\n    ]\n\n    for (const [label, expected] of labels) {\n      const result = successful(\n        decodeStbBytes(\n          textBytes(`<?xml version=\"1.0\" encoding=\"${label}\"?><ST_BRIDGE />`),\n        ),\n      )\n\n      expect(result.encoding).toBe(expected)\n    }\n  })\n\n  it('returns an issue for an unsupported declaration without throwing', () => {\n    expect(\n      decodeStbBytes(\n        textBytes(\n          '<?xml version=\"1.0\" encoding=\"EUC-JP\"?><ST_BRIDGE />',\n        ),\n      ),\n    ).toEqual({\n      ok: false,\n      issue: '?ゅ?恙쒌궓?녈궠?쇈깈?ｃ꺍??,\n      declared: 'EUC-JP',\n    })\n  })\n})\n\r\n--- vitest config ---\r\nimport { readFileSync } from 'node:fs'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nimport react from '@vitejs/plugin-react'\r\nimport { defineConfig } from 'vitest/config'\r\n\r\nconst yamlRawPlugin = {\r\n  name: 'yaml-raw',\r\n  load(id: string) {\r\n    const path = id.split('?', 1)[0]\r\n    if (!path.endsWith('.yaml')) return null\r\n    return `export default ${JSON.stringify(readFileSync(path, 'utf8'))}`\r\n  },\r\n}\r\n\r\nconst aliases = {\r\n  '@': fileURLToPath(new URL('./src', import.meta.url)),\r\n}\r\n\r\nexport default defineConfig({\r\n  resolve: {\r\n    alias: aliases,\r\n  },\r\n  test: {\r\n    projects: [\r\n      {\r\n        plugins: [yamlRawPlugin],\r\n        resolve: { alias: aliases },\r\n        test: {\r\n          name: 'domain',\r\n          environment: 'node',\r\n          include: [\r\n            'src/domain/**/*.test.ts',\r\n            'src/rulepack/**/*.test.ts',\r\n            'src/app/api/**/*.test.ts', // API ?쇱슦?몃뒗 node ?섍꼍 (oncall alert ?몃뱾??\r\n            'tests/**/*.test.ts',\r\n            'evals/harness/**/*.test.ts',\r\n          ],\r\n        },\r\n      },\r\n      {\r\n        plugins: [react(), yamlRawPlugin],\r\n        resolve: { alias: aliases },\r\n        test: {\r\n          name: 'ui',\r\n          environment: 'jsdom',\r\n          setupFiles: ['./vitest.ui.setup.test.ts'],\r\n          include: [\r\n            'src/instrumentation-client.test.ts',\r\n            'src/components/**/*.test.ts',\r\n            'src/components/**/*.test.tsx',\r\n            'src/app/**/*.test.tsx',\r\n            'src/lib/**/*.test.ts',\r\n            'src/lib/**/*.test.tsx',\r\n          ],\r\n        },\r\n      },\r\n    ],\r\n  },\r\n})\r\n\r\n--- tsconfig ---\r\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2017\",\n    \"lib\": [\"dom\", \"dom.iterable\", \"esnext\"],\n    \"allowJs\": false,\n    \"skipLibCheck\": true,\n    \"strict\": true,\n    \"noEmit\": true,\n    \"esModuleInterop\": true,\n    \"module\": \"esnext\",\n    \"moduleResolution\": \"bundler\",\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"jsx\": \"preserve\",\n    \"incremental\": true,\n    \"plugins\": [{ \"name\": \"next\" }],\n    \"paths\": {\n      \"@/*\": [\"./src/*\"]\n    }\n  },\n  \"include\": [\n    \"next-env.d.ts\",\n    \"**/*.ts\",\n    \"**/*.tsx\",\n    \".next/types/**/*.ts\"\n  ],\n  \"exclude\": [\"node_modules\"]\n}\n\r\n","exit_code":0,"status":"completed"}}
