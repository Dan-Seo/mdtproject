 \"name\": \"StbGirders\", \"count\": 1 },\n    { \"name\": \"StbGirder\", \"count\": 192 },\n    { \"name\": \"StbBraces\", \"count\": 1 },\n    { \"name\": \"StbBrace\", \"count\": 10 },\n    { \"name\": \"StbSections\", \"count\": 1 },\n    { \"name\": \"StbSecColumn_S\", \"count\": 26 },\n    { \"name\": \"StbSecSteelFigureColumn_S\", \"count\": 26 },\n    { \"name\": \"StbSecSteelColumn_S_Same\", \"count\": 26 },\n    { \"name\": \"StbSecBeam_RC\", \"count\": 1 },\n    { \"name\": \"StbSecFigureBeam_RC\", \"count\": 1 },\n    { \"name\": \"StbSecBeam_RC_Straight\", \"count\": 1 },\n    { \"name\": \"StbSecBeam_S\", \"count\": 27 },\n    { \"name\": \"StbSecSteelFigureBeam_S\", \"count\": 27 },\n    { \"name\": \"StbSecSteelBeam_S_Straight\", \"count\": 27 },\n    { \"name\": \"StbSecBrace_S\", \"count\": 6 },\n    { \"name\": \"StbSecSteelFigureBrace_S\", \"count\": 6 },\n    { \"name\": \"StbSecSteelBrace_S_Same\", \"count\": 6 },\n    { \"name\": \"StbSecSteel\", \"count\": 1 },\n    { \"name\": \"StbSecRoll-H\", \"count\": 33 },\n    { \"name\": \"StbSecRoll-BOX\", \"count\": 26 },\n    { \"name\": \"StbJoints\", \"count\": 1 },\n    { \"name\": \"StbCalData\", \"count\": 1 },\n    { \"name\": \"StbAnaModels\", \"count\": 1 }\n  ],\n  \"issues\": []\n}\n\r\nFILE C:\\Users\\emper\\mdtproject\\tests\\fixtures\\stb-import\\expected\\mini.json\r\n{\n  \"_derivedFrom\": \"phases/33-stbridge-skeleton-import/step0-report.json\",\n  \"version\": \"2.0.2\",\n  \"projectName\": \"基準階サンプル\",\n  \"grids\": [\n    { \"direction\": \"X\", \"groupName\": \"X\", \"axes\": [{ \"label\": \"X1\" }, { \"label\": \"X2\" }, { \"label\": \"X3\" }], \"spansMm\": [6000, 6000] },\n    { \"direction\": \"Y\", \"groupName\": \"Y\", \"axes\": [{ \"label\": \"Y1\" }, { \"label\": \"Y2\" }], \"spansMm\": [5000] }\n  ],\n  \"stories\": [\n    { \"name\": \"1FL\", \"heightMm\": 4000 },\n    { \"name\": \"2FL\", \"heightMm\": 3500 }\n  ],\n  \"unsupported\": [],\n  \"issues\": [\"通り芯位置と節点の不一致\"]\n}\n\r\nFIXTURE_SOURCES\r\n# ST-Bridge 취입 코퍼스\n\n**원본 `.stb`·`.xsd`는 커밋하지 않는다.** 원본은 `.cache/stb/`에만 두고, 이 문서에는 출처 URL과 SHA-256만 기록한다. 커밋하는 합성 픽스처와 step 2의 중간표현 JSON은 이 원본에서 파생된다.\n\n## 실물 `.stb`\n\n| 저장 파일명 | 출처 repo | 커밋 고정 URL | SHA-256 | bytes | ST-Bridge 버전 | 선언 인코딩 |\n|---|---|---|---:|---:|---|---|\n| `dotnet-sample1.stb` | `hrntsm/STBDotNet` | https://raw.githubusercontent.com/hrntsm/STBDotNet/2e742685700456ac10a3ed326ca99be75acd6b33/TestStbFiles/ver2/Sample1.stb | `50df079abaf5514d88129b7e0ad194fb959d6bd2757126baebab650072ff391a` | 63177 | 2.0.1 | UTF-8 |\n| `diffchecker-filea.stb` | `NS-NS/STB-DiffChecker` | https://raw.githubusercontent.com/NS-NS/STB-DiffChecker/bd9a6eb09d82e58f033e3ee542bf6874196ae924/TestData/FileA.stb | `fb350d0efcec007219ccc73d975175f4f694f422619dbc416ba133b18433ebe2` | 117138 | 2.0.2 | Shift_JIS |\n| `hoaryfox-sample.stb` | `hrntsm/HoaryFox` | https://raw.githubusercontent.com/hrntsm/HoaryFox/f991f97df99e307c449c4c0bc0cb85b514cc5e8c/Samples/SampleBuilding.stb | `83d35a8eeb57177d409766804e36288ff325d141d05a7cba4b58fff221257629` | 83288 | 2.0.2 | utf-8 |\n| `diffchecker-mini210.stb` | `NS-NS/STB-DiffChecker` | https://raw.githubusercontent.com/NS-NS/STB-DiffChecker/bd9a6eb09d82e58f033e3ee542bf6874196ae924/TestData/Mini210_FileA.stb | `9bf2b7b628d801f87d6d348b53b7628dfc0cc8a05989ace7787e727c697e80c5` | 1606 | 2.1.0 | utf-8 |\n\n## 공식 XSD\n\n| ST-Bridge 버전 | zip URL | zip SHA-256 | XSD 파일명 | XSD SHA-256 | bytes |\n|---|---|---|---|---|---:|\n| 2.0.1 | https://www.building-smart.or.jp/wp-content/uploads/2022/03/ST-Bridge_v201_20220316.zip | `e9294763477a18f0bc0e19aab629be4d8b1ea7ade085a688766a94dcfa5e4913` | `ST-Bridge_v201_20220316.xsd` | `3eac9a71b08c6be02fcc514b821937d24305fe0662500047108316c88a98005b` | 201033 |\n| 2.0.2 | https://www.building-smart.or.jp/wp-content/uploads/2026/04/ST-Bridge_v202.zip | `f69d4ee1c4b162f50a1a05ba13c948996d743924f1eeebd7016de866a5b4da8d` | `ST-Bridge_v202.xsd` | `56cc1b80062c2385c15f8ab0745f4e96ac5b9400a4743307031e813d0253a1fa` | 331047 |\n| 2.1.0 | https://www.building-smart.or.jp/wp-content/uploads/2023/05/ST-Bridge210.zip | `b694b2675001b1ac6d894cac66b7e0f357d611fb793f6dedd3d90b6aab07771e` | `ST-Bridge210.xsd` | `9f2038b7b308f411b6397e6cd2d1b0fe82169dd20c1e98cbf7d478a9d7b3583c` | 556507 |\n| 2.1.1 | https://www.building-smart.or.jp/wp-content/uploads/2026/07/ST-Bridge_v211.zip | `e4690298e3233e77049633a26a05de3633b7272b5220447f60446591c4cb17fd` | `ST-Bridge_v211.xsd` | `73ab69075c2b8d5d480b40aa34f3b62d34a3d3f3099792afd34a71274343a089` | 558066 |\n\n## 라이선스\n\n`hrntsm/STBDotNet`, `hrntsm/HoaryFox`, `NS-NS/STB-DiffChecker`의 고정 커밋에는 모두 MIT License가 있다. 각 저장소 `LICENSE`의 저작권 표기는 다음과 같다.\n\n- `hrntsm/STBDotNet`: `Copyright (c) 2020 hrntsm`\n- `hrntsm/HoaryFox`: `Copyright (c) 2019 hrntsm`\n- `NS-NS/STB-DiffChecker`: `Copyright (c) 2020 NS-NS`\n\n커밋하는 합성 `.stb`와 이후 중간표현 JSON은 위 원본에서 파생된 저작물이다. 원본 파일 자체는 재배포하지 않는다.\n\n## 이 코퍼스가 대표하지 못하는 것\n\nstep 5에서 실측으로 채운다.\n\n## 재현 절차\n\n```sh\nmkdir -p .cache/stb\ncurl -L --fail 'https://raw.githubusercontent.com/hrntsm/STBDotNet/2e742685700456ac10a3ed326ca99be75acd6b33/TestStbFiles/ver2/Sample1.stb' -o .cache/stb/dotnet-sample1.stb\ncurl -L --fail 'https://raw.githubusercontent.com/NS-NS/STB-DiffChecker/bd9a6eb09d82e58f033e3ee542bf6874196ae924/TestData/FileA.stb' -o .cache/stb/diffchecker-filea.stb\ncurl -L --fail 'https://raw.githubusercontent.com/hrntsm/HoaryFox/f991f97df99e307c449c4c0bc0cb85b514cc5e8c/Samples/SampleBuilding.stb' -o .cache/stb/hoaryfox-sample.stb\ncurl -L --fail 'https://raw.githubusercontent.com/NS-NS/STB-DiffChecker/bd9a6eb09d82e58f033e3ee542bf6874196ae924/TestData/Mini210_FileA.stb' -o .cache/stb/diffchecker-mini210.stb\nsha256sum .cache/stb/dotnet-sample1.stb .cache/stb/diffchecker-filea.stb .cache/stb/hoaryfox-sample.stb .cache/stb/diffchecker-mini210.stb\n```\n\n공식 XSD zip도 표의 zip URL을 `curl -L --fail <url> -o .cache/stb/<zip 파일명>`으로 내려받은 뒤, zip과 압축 해제한 XSD에 각각 `sha256sum`을 실행해 표와 대조한다.\n\r\nADR043\r\n### ADR-043: ST-Bridge(.stb)의 通り芯·階만을 브라우저 로컬로 「후보」로 읽는다 (ADR-004 재검토·ADR-018·ADR-030 확장)\n\n**맥락**: ADR-004의 결정문은 두 가지를 한 줄에 묶었다 — 「DWG/DXF 도면 인식」과 「IFC 업로드」. 앞의 절반은 ADR-018·ADR-030이 실측을 붙여 좁혔지만, **뒤의 절반에는 논거가 붙은 적이 없다**. ADR-004의 이유절과 트레이드오프절(`docs/ADR.md:38-39`)에 `IFC`는 0회 등장하고, 두 절의 논증은 전부 도면 인식에 관한 것이다. 레포에서 IFC가 나오는 나머지 한 곳인 `docs/PRD.md:43`의 사유(「Revit/Navisworks 호환성을 검증할 방법이 없음」)도 취입이 아니라 **내보내기**에 대한 것이다. 그러므로 이 항은 기존 결정을 뒤집는 항이 아니라, **논증이 없던 절반에 처음 답하는 항**이다.\n\n그리고 ST-Bridge는 IFC가 아니다. buildingSMART Japan 構造設計小委員会의 일본 구조 전용 XML이며, 도면이 아니라 一貫構造計算 소프트의 출력이다. 인식할 픽셀도 좌표 추정도 없다 — 通り芯이 `StbParallelAxis@distance`로, 階가 `StbStory@height`로 명시돼 있다.\n\n**실측** (2026-08-28. 원본은 `.cache/stb/`에 두고 커밋하지 않으며 URL·SHA-256은 `tests/fixtures/stb-import/SOURCES.md`에 적는다)\n\n1. **스키마는 공개돼 있다.** ver 2.0.2 / 2.1.0 / 2.1.1 XSD가 로그인 없이 받아진다(각각 331,047 B / 556,507 B / 558,066 B). 최신은 **2.1.1**(2026-07-29)이고 2.1.0과의 차이는 철자 수정뿐이다 — 요소 808개 동일, 개명 4·속성 개명 6·삭제 3·추가 1이며 **전부 S造 補剛材·杭·柱脚이고 RC 범위 변경은 0건**이다.\n2. **ST-Bridge는 定着長さ·重ね継手長さ를 숫자로 담지 않는다.** RC 범위(柱·大梁·壁·スラブ)에서 `anchorage_rule`(5곳)·`cut_off_rule`(4곳)·`allocation_rule_stirrup`(4곳)이 전부 `xs:string`, 즉 길이가 아니라 **룰 이름**이다. `stb:length` 타입의 정착 관련 속성은 杭 전용 `length_lap_bar` 2건과 S造 앵커볼트뿐이다. 사양서 §3.2.3.1.1은 「鉄筋の加工・組立、定着長等をあたえることを想定している」「次のバージョン以降に実情を反映して詳細定義を行う」라고 적었지만, 그 문장의 대상은 `StbApply_RC_General`·`_Pile`·`_Foundation` **셋뿐**이다 — `StbApply_RC_Column`은 속성 21개, `_Girder`는 24개를 가진다. 즉 **Kijun의 값이 시작되는 자리가 이 포맷이 끝나는 자리다.**\n3. **그러나 かぶり厚さ는 숫자로 담는다.** 2.1은 `StbApply_RC_*@depth_cover_*`, 2.0.x는 `StbSecBarArrangementColumn_RC@depth_cover_*`. 巾止筋의 径·ピッチ, 帯筋의 割り付けルール도 같은 자리에 있다. 「버전을 골라 충돌을 피했다」는 성립하지 않는다.\n4. **현실 샘플은 있으나 버전이 어긋난다.** 공개 .stb 4건(전부 MIT)을 확보했다 — `STBDotNet/Sample1`(2.0.1), `STB-DiffChecker/FileA`(2.0.2, **Shift_JIS**, NASCA 출력), `HoaryFox/SampleBuilding`(2.0.2), `STB-DiffChecker/Mini210_FileA`(2.1.0, 1,606 B 토이). ver 2.1 계열의 현실 규모 파일은 **세상에 없다** — 코드검색 `\"ST_BRIDGE version=\\\"2.1.0\\\"\"`·`StbSecBarColumnRectSameSimple extension:stb` 둘 다 0건이고, 가장 활발한 구현(Rust `Squid-n`)조차 「書き出しは 2.0.2 標準スキーマ準拠の 1 形式だけ」다.\n5. **그런데 이 항이 여는 범위에는 그 결손이 닿지 않는다.** 2.0.2 → 2.1.0은 파괴적 개명이고(공통 462 / 202 전용 119 / 210 전용 346), Kijun이 断面을 읽으려 했다면 `StbSecBarColumn_RC_RectSame`(2.0.x) ↔ `StbSecBarColumnRectSameSimple`(2.1.x)로 갈라져 파서가 둘이 된다. 반면 **골격 요소** — `StbParallelAxes`·`StbParallelAxis`·`StbStory`·`StbNode`·`StbNodeIdList` — 는 네 버전에서 같다. 그래서 이 항은 골격만 연다.\n6. **인코딩은 조용히 고장난다.** 사양서 §1.2가 「当面、\"UTF-8\"、\"Shift_JIS\" を適用対象とする」이고 실물 `FileA.stb`가 실제로 Shift_JIS다. UTF-8로 읽어도 **XML 파싱은 성공하고 문자열만 깨진다** — 「`curl`은 200을 돌려준다」와 같은 구조의 함정이다. `TextDecoder('shift_jis')`가 WHATWG 필수 레이블이라 브라우저·Node 양쪽에서 라이브러리 없이 처리된다.\n7. **브라우저 로컬로 성립한다는 것은 제3자가 이미 증명했다.** `key-o/stb-diff-viewer`(MIT·JavaScript·three.js·완전 브라우저·2.1.1 XSD 보유). 참고 구현으로만 쓰고 코드는 옮기지 않는다.\n8. **제품 타입이 담을 수 없는 것이 실재한다.** `Grid`(`src/domain/model/project.ts:67-80`)에 회전각·원점·원호·방사축 필드가 없고, `Story`(:94-98)에 `kind`도 GL 기준 절대 표고도 없다(표고는 `storyElevation()`이 배열 순서로 누적해 만들므로 음의 표고를 만들 수 없다). XSD에는 `StbArcAxes`·`StbRadialAxes`·`StbDrawingAxes`가, `StbStory@kind`에는 `BASEMENT`·`ISOLATION`·`DEPENDENCE`가 실재한다.\n\n**결정**\n\n1. **.stb에서 通り芯 그리드와 階 레벨 스택만을 「후보」로 읽는다.** 전부 브라우저 로컬이며 서버 왕복이 없다(ADR-006·ADR-017 예외 없음). 파일 → 중간표현(`DOMParser`) → 후보(순수 TS)의 2단 분리는 ADR-018의 그것과 같다.\n2. **후보는 사람 승인을 거쳐야만 입력이 된다.** .stb가 사람이 만든 확정 데이터이므로 자동 반영해도 된다는 반론이 있으나 채택하지 않는다 — 그러면 ADR-015의 승인자가 「Kijun 사용자」에서 「.stb를 만든 제3자 構造設計者」로 바뀌고, 사용자는 자기가 승인하지 않은 값으로 物量을 내게 된다. 승인 단위는 블록이다.\n3. **ADR-004의 핵심 문장을 다시 좁힌다.** ADR-030이 「도면에서 형상을 인식하지 않는다」를 「도면에서 읽은 형상을 확인 없이 쓰지 않는다」로 좁힌 것과 같은 방향으로, 「외부 형식을 취입하지 않는다」는 **「외부 형식에서 읽은 값을 확인 없이 쓰지 않는다」로 좁혀진다.** ADR-004 본문은 고치지 않는다.\n4. **定着·重ね継手·折曲げ·かぶり厚さは 계속 `src/rulepack/`의 YAML이 정한다.** ST-Bridge가 `depth_cover_*`를 숫자로 담는다는 사실(실측 3)에도 불구하고 **읽지 않기로 결정한다** — 버전을 내려서 충돌을 피한 것이 아니다. `StbApply_*`·`StbSec*` 계열 전부가 이 항의 범위 밖이다.\n5. **담을 수 없는 것은 근사하지 않고 사유 코드와 함께 거부한다.** 비직교·원호·방사 通り芯과 `BASEMENT`·`ISOLATION`·`DEPENDENCE` 階가 대상이다. 특히 **미대응 階를 부분 제거하지 않고 층 스택을 통짜로 거부한다** — 중간 레벨을 빼고 인접 차분을 하면 그 아래층이 빠진 구간을 흡수해 階高가 조용히 부풀고, 사유 코드는 「그 층을 못 읽었다」로만 읽혀 사용자가 오염을 알 수 없다(`FileA`에서 `RFL`이 `PENTHOUSE`이며, 그것만 빼면 3FL이 4000이 아니라 7800이 된다).\n6. **ADR-035 §6과의 관계**: §6은 「階 라벨을 근거로 한 Story 신규 생성·개명·정렬은 하지 않는다」인데, .stb의 `StbStory@height`는 **라벨 근거의 추정이 아니라 명시적 레벨 데이터**이므로 §6의 사정 밖이다. 다만 이 항이 여는 것은 후보 생성까지이고, `Project.stories`를 만드는 것은 이 항의 범위가 아니다.\n7. **마일스톤 위치**: ST-Bridge 취입은 断面リスト(ADR-018)·伏図(ADR-030) 트랙과 코드 영역이 겹치지 않는(공용층 `textitems`·`runs`·`pdf-text`를 하나도 쓰지 않는) 또 하나의 입력 파이프라인 트랙이며, M2·M3c의 잔여와 병행한다.\n8. **하지 않는 것**: 断面(`StbSec*`)·배근·부재 배치·開口·かぶり·定着을 읽지 않는다 / 芯(중심선) 모델을 볼륨으로 해석하지 않는다(`StbMemberOffsetList` 미대응) / `kind_structure=\"LOAD\"`(壁式構造の壁)는 ADR-025·ADR-042대로 후보를 내지 않고 미대응으로 표시한다 / 버전 어댑터·요소 매핑 테이블·룰 DSL을 만들지 않는다(ADR-002) / .stb 원본과 XSD를 커밋하지 않고 런타임에 받지도 않는다 / 基礎·小梁·雑壁·杭 코드를 만들지 않는다(ADR-005) / .stb 쓰기(export)를 하지 않는다 / 재취입·차분 갱신을 하지 않는다(`Member.id`가 (階,符号,격자자리)뿐이라 매칭 키가 없다) / XML 파서·인코딩 변환 라이브러리를 추가하지 않는다.\n\n**판정 장치**: 이 취입의 출력이 맞았는지는 **제3자 MIT 실물 .stb 4건의 通り芯·階를 파서와 무관한 수단(python 정규식)으로 재계산한 값과 CI가 상시 대조하는 것**이 판정한다. 기대값은 파서 출력이 아니라 `phases/33-stbridge-skeleton-import/step0-report.json`의 실측에서 유도한다.\n\n**트레이드오프**: 확보한 코퍼스가 오픈소스 프로젝트의 테스트 픽스처이고 **사용자에게서 온 파일이 0건**이다 — ADR-018이 열린 근거(실도면 3부 확보)보다 약하다. 그리고 실물 2건이 S造라 RC 배근을 담은 파일은 ver 2.0.1 하나뿐이므로, **断面 트랙을 여는 것은 이 항의 근거로 정당화되지 않는다.** 이 한계는 `tests/fixtures/stb-import/SOURCES.md`의 「이 코퍼스가 대표하지 못하는 것」 절에 실측으로 남긴다. 또 .stb로 만든 案件은 開口 정보가 없어 欠除이 반영되지 않고 과대 계상된다(ADR-029의 상시 고지가 그대로 적용된다).\n\n**전제는 `phases/33-stbridge-skeleton-import/step0`에서 검증 중이다.** 반증되면 이 항에 정정을 추기한다.\r\nSTEP0_KEY_DATA\r\n{\r\n    \"axis_groups\":  [\r\n                        {\r\n                            \"file\":  \"dotnet-sample1.stb\",\r\n                            \"group_name\":  \"Y\",\r\n                            \"angle\":  \"0.0\",\r\n                            \"origin_x\":  \"0.0\",\r\n                            \"origin_y\":  \"0.0\",\r\n                            \"axis_count\":  3\r\n                        },\r\n                        {\r\n                            \"file\":  \"dotnet-sample1.stb\",\r\n                            \"group_name\":  \"X\",\r\n                            \"angle\":  \"270.0\",\r\n                            \"origin_x\":  \"0.0\",\r\n                            \"origin_y\":  \"0.0\",\r\n                            \"axis_count\":  3\r\n                        },\r\n                        {\r\n                            \"file\":  \"diffchecker-filea.stb\",\r\n                            \"group_name\":  \"Y\",\r\n                            \"angle\":  \"0.0\",\r\n                            \"origin_x\":  \"0.0\",\r\n                            \"origin_y\":  \"0.0\",\r\n                            \"axis_count\":  9\r\n                        },\r\n                        {\r\n                            \"file\":  \"diffchecker-filea.stb\",\r\n                            \"group_name\":  \"X\",\r\n                            \"angle\":  \"270.0\",\r\n                            \"origin_x\":  \"0.0\",\r\n                            \"origin_y\":  \"0.0\",\r\n                            \"axis_count\":  7\r\n                        },\r\n                        {\r\n                            \"file\":  \"hoaryfox-sample.stb\",\r\n                            \"group_name\":  \"X\",\r\n                            \"angle\":  \"270\",\r\n                            \"origin_x\":  \"0\",\r\n                            \"origin_y\":  \"0\",\r\n                            \"axis_count\":  7\r\n                        },\r\n                        {\r\n                            \"file\":  \"hoaryfox-sample.stb\",\r\n                            \"group_name\":  \"Y\",\r\n                            \"angle\":  \"0\",\r\n                            \"origin_x\":  \"0\",\r\n                            \"origin_y\":  \"0\",\r\n                            \"axis_count\":  3\r\n                        }\r\n                    ],\r\n    \"story_levels\":  null,\r\n    \"story_stacks\":  null,\r\n    \"corpus_facts\":  null,\r\n    \"next_phase_facts\":  [\r\n                             {\r\n                                 \"file\":  \"dotnet-sample1.stb\",\r\n                                 \"column_kind_structure\":  {\r\n                                                               \"RC\":  17\r\n                                                           },\r\n                                 \"column_names\":  [\r\n                                                      \"1C1\",\r\n                                                      \"1C2\",\r\n                                                      \"2C1\",\r\n                                                      \"2C2\"\r\n                                                  ],\r\n                                 \"sec_column_rc_names\":  [\r\n                                                             \"C1\",\r\n                                                             \"C2\"\r\n                                                         ],\r\n                                 \"element_counts\":  {\r\n                                                        \"StbColumn\":  17,\r\n                                                        \"StbSecColumn_RC\":  4,\r\n                                                        \"StbSecColumn_S\":  0,\r\n                                                        \"StbSecBarColumn_RC_RectSame\":  4,\r\n                                                        \"StbSecBarColumnRectSameSimple\":  0,\r\n                                                        \"StbSecBarBeam_RC_Same\":  3,\r\n                                                        \"StbSecBarBeam_RC_ThreeTypes\":  12,\r\n                                                        \"StbWall\":  6,\r\n                                                        \"StbSlab\":  27,\r\n                                                        \"StbBeam\":  11,\r\n             